 151: 		}
 152: 		cpu->cd.m88k.dmt[1] &= ~((0x1f) << DMT_DREGSHIFT);
 153: 		cpu->cd.m88k.dmt[1] |= dreg << DMT_DREGSHIFT;
 154: 	}
 155: #endif
 156: #endif
 157: 
 158: 
 159: #ifdef LS_USR
 160: 	if (!(cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_MODE)) {
 161: 		/*  Cause a privilege violation exception:  */
 162: 		m88k_exception(cpu, M88K_EXCEPTION_PRIVILEGE_VIOLATION, 0);
 163: 		return;
 164: 	}
 165: #endif
 166: 
 167: #ifndef LS_1
 168: 	/*  Check alignment:  */
 169: 	if (addr & (LS_SIZE - 1)) {
 170: #if 1
 171: 		/*  Cause an address alignment exception:  */
 172: 		m88k_exception(cpu, M88K_EXCEPTION_MISALIGNED_ACCESS, 0);
 173: #else
 174: 		fatal("{ m88k dyntrans alignment exception, size = %i,"
 175: 		    " addr = %08" PRIx32", pc = %08" PRIx32" }\n", LS_SIZE,
 176: 		    (uint32_t) addr, (uint32_t) cpu->pc);
 177: 
 178: 		cpu->running = 0;
 179: 		cpu->cd.m88k.next_ic = &nothing_call;
 180: 
 181: 		if (cpu->delay_slot)
 182: 			cpu->delay_slot |= EXCEPTION_IN_DELAY_SLOT;
 183: #endif
 184: 		return;
 185: 	}
 186: #endif
 187: 
 188: #ifdef LS_LOAD
 189: 	if (!cpu->memory_rw(cpu, cpu->mem, addr, data, sizeof(data),
 190: 	    MEM_READ, memory_rw_flags)) {
 191: 		/*  Exception or aborted execution.  */
 192: 		if (!cpu->running)
 193: 			cpu->cd.m88k.next_ic = &nothing_call;
 194: 		return;
 195: 	}
 196: 	x = memory_readmax64(cpu, data, LS_SIZE);
 197: #ifdef LS_8
 198: 	if (cpu->byte_order == EMUL_BIG_ENDIAN) {
 199: 		reg(ic->arg[0]) = x >> 32;
 200: 		reg(ic->arg[0] + 4) = x;
 201: 	} else {
 202: 		reg(ic->arg[0]) = x;
 203: 		reg(ic->arg[0] + 4) = x >> 32;
 204: 	}
 205: #else
 206: #ifdef LS_SIGNED
 207: #ifdef LS_1
 208: 	x = (int8_t)x;
 209: #endif
 210: #ifdef LS_2
 211: 	x = (int16_t)x;
 212: #endif
 213: #ifdef LS_4
 214: 	x = (int32_t)x;
 215: #endif
 216: #endif
 217: 	reg(ic->arg[0]) = x;
 218: #endif
 219: 
 220: #else	/*  LS_STORE:  */
 221: 
 222: #ifdef LS_8
 223: 	if (cpu->byte_order == EMUL_BIG_ENDIAN)
 224: 		x = ((uint64_t)reg(ic->arg[0]) << 32) + reg(ic->arg[0] + 4);
 225: 	else
 226: 		x = ((uint64_t)reg(ic->arg[0] + 4) << 32) + reg(ic->arg[0]);
 227: 	cpu->cd.m88k.dmd[0] = reg(ic->arg[0]);
 228: 	cpu->cd.m88k.dmd[1] = reg(ic->arg[0] + 4);
 229: #else
 230: 	x = reg(ic->arg[0]);
 231: 	cpu->cd.m88k.dmd[0] = x;
 232: #endif
 233: 	memory_writemax64(cpu, data, LS_SIZE, x);
 234: 	if (!cpu->memory_rw(cpu, cpu->mem, addr, data, sizeof(data),
 235: 	    MEM_WRITE, memory_rw_flags)) {
 236: 		/*  Exception or aborted execution.  */
 237: 		if (!cpu->running)
 238: 			cpu->cd.m88k.next_ic = &nothing_call;
 239: 		return;
 240: 	}
 241: #endif
 242: }
 243: #endif	/*  LS_INCLUDE_GENERIC  */
