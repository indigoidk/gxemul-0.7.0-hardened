 245: 
 246: void LS_N(struct cpu *cpu, struct m88k_instr_call *ic)
 247: {
 248: 	uint32_t addr = reg(ic->arg[1]) +
 249: #ifdef LS_REGOFS
 250: #ifdef LS_SCALED
 251: 	    LS_SIZE *
 252: #endif
 253: 	    reg(ic->arg[2]);
 254: #else
 255: 	    ic->arg[2];
 256: #endif
 257: 
 258: #ifdef LS_USR
 259: #ifdef LS_LOAD
 260: 	uint8_t *p = cpu->cd.m88k.host_load_usr[addr >> 12];
 261: #else
 262: 	uint8_t *p = cpu->cd.m88k.host_store_usr[addr >> 12];
 263: #endif
 264: #else
 265: #ifdef LS_LOAD
 266: 	uint8_t *p = cpu->cd.m88k.host_load[addr >> 12];
 267: #else
 268: 	uint8_t *p = cpu->cd.m88k.host_store[addr >> 12];
 269: #endif
 270: #endif
 271: 
 272: 	/*
 273: 	 *  Call the generic function, if things become too complicated:
 274: 	 *
 275: 	 *  1)  .usr used in non-supervisor mode
 276: 	 *  2)  the page pointer is NULL
 277: 	 *  3)  unaligned access
 278: 	 */
 279: 	if (unlikely(
 280: #ifdef LS_USR
 281: 	    !(cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_MODE) ||
 282: #endif
 283: 
 284: 	    p == NULL
 285: #ifndef LS_1
 286: 	    || addr & (LS_SIZE - 1)
 287: #endif
 288: 	    )) {
 289: 		LS_GENERIC_N(cpu, ic);
 290: 		return;
 291: 	}
 292: 
 293: 	addr &= 0xfff;
 294: 
 295: #ifdef LS_LOAD
 296: 	/*  Load:  */
 297: 
 298: #ifdef LS_1
 299: 	reg(ic->arg[0]) =
 300: #ifdef LS_SIGNED
 301: 	    (int8_t)
 302: #endif
 303: 	    p[addr];
 304: #endif	/*  LS_1  */
 305: 
 306: #ifdef LS_2
 307: 	reg(ic->arg[0]) =
 308: #ifdef LS_SIGNED
 309: 	    (int16_t)
 310: #endif
 311: #ifdef LS_BE
 312: #ifdef HOST_BIG_ENDIAN
 313: 	    ( *(uint16_t *)(p + addr) );
 314: #else
 315: 	    ((p[addr]<<8) + p[addr+1]);
 316: #endif
 317: #else
 318: #ifdef HOST_LITTLE_ENDIAN
 319: 	    ( *(uint16_t *)(p + addr) );
 320: #else
 321: 	    (p[addr] + (p[addr+1]<<8));
 322: #endif
 323: #endif
 324: #endif	/*  LS_2  */
 325: 
 326: #ifdef LS_4
 327: 	reg(ic->arg[0]) =
 328: #ifdef LS_SIGNED
 329: 	    (int32_t)
 330: #else
 331: 	    (uint32_t)
 332: #endif
 333: #ifdef LS_BE
 334: #ifdef HOST_BIG_ENDIAN
 335: 	    ( *(uint32_t *)(p + addr) );
 336: #else
 337: 	    ((p[addr]<<24) + (p[addr+1]<<16) + (p[addr+2]<<8) + p[addr+3]);
 338: #endif
 339: #else
 340: #ifdef HOST_LITTLE_ENDIAN
 341: 	    ( *(uint32_t *)(p + addr) );
 342: #else
 343: 	    (p[addr] + (p[addr+1]<<8) + (p[addr+2]<<16) + (p[addr+3]<<24));
 344: #endif
 345: #endif
 346: #endif	/*  LS_4  */
 347: 
 348: #ifdef LS_8
 349: 
 350: 	/*  Load first word in pair:  */
 351: 	reg(ic->arg[0]) =
 352: #ifdef LS_BE
 353: #ifdef HOST_BIG_ENDIAN
 354: 	    ( *(uint32_t *)(p + addr) );
 355: #else
 356: 	    ((p[addr]<<24) + (p[addr+1]<<16) + (p[addr+2]<<8) + p[addr+3]);
 357: #endif
 358: #else
 359: #ifdef HOST_LITTLE_ENDIAN
 360: 	    ( *(uint32_t *)(p + addr + 4) );
 361: #else
 362: 	    (p[addr+4] + (p[addr+5]<<8) + (p[addr+6]<<16) + (p[addr+7]<<24));
 363: #endif
 364: #endif
 365: 
 366: 	/*  Load second word in pair:  */
 367: 	reg(ic->arg[0] + 4) =
 368: #ifdef LS_BE
 369: #ifdef HOST_BIG_ENDIAN
 370: 	    ( *(uint32_t *)(p + addr + 4) );
 371: #else
 372: 	    ((p[addr+4]<<24) + (p[addr+5]<<16) + (p[addr+6]<<8) + p[addr+7]);
 373: #endif
 374: #else
 375: #ifdef HOST_LITTLE_ENDIAN
 376: 	    ( *(uint32_t *)(p + addr) );
 377: #else
 378: 	    (p[addr] + (p[addr+1]<<8) + (p[addr+2]<<16) + (p[addr+3]<<24));
 379: #endif
 380: #endif
 381: 
 382: #endif	/*  LS_8  */
 383: 
 384: #else
 385: 	/*  Store: */
 386: 
 387: #ifdef LS_1
 388: 	p[addr] = reg(ic->arg[0]);
 389: #endif
 390: #ifdef LS_2
 391: 	{ uint32_t x = reg(ic->arg[0]);
 392: #ifdef LS_BE
 393: #ifdef HOST_BIG_ENDIAN
 394: 	*((uint16_t *)(p+addr)) = x; }
 395: #else
 396: 	p[addr] = x >> 8; p[addr+1] = x; }
 397: #endif
 398: #else
 399: #ifdef HOST_LITTLE_ENDIAN
 400: 	*((uint16_t *)(p+addr)) = x; }
 401: #else
 402: 	p[addr] = x; p[addr+1] = x >> 8; }
 403: #endif
 404: #endif
 405: #endif  /*  LS_2  */
 406: #ifdef LS_4
 407: 	{ uint32_t x = reg(ic->arg[0]);
 408: #ifdef LS_BE
 409: #ifdef HOST_BIG_ENDIAN
 410: 	*((uint32_t *)(p+addr)) = x; }
 411: #else
 412: 	p[addr] = x >> 24; p[addr+1] = x >> 16; 
 413: 	p[addr+2] = x >> 8; p[addr+3] = x; }
 414: #endif
 415: #else
 416: #ifdef HOST_LITTLE_ENDIAN
 417: 	*((uint32_t *)(p+addr)) = x; }
 418: #else
 419: 	p[addr] = x; p[addr+1] = x >> 8; 
 420: 	p[addr+2] = x >> 16; p[addr+3] = x >> 24; }
 421: #endif
 422: #endif
 423: #endif  /*  LS_4  */
 424: #ifdef LS_8
 425: 
 426: 	/*  First word in pair:  */
 427: 	{ uint32_t x = reg(ic->arg[0]);
 428: #ifdef LS_BE
 429: #ifdef HOST_BIG_ENDIAN
 430: 	*((uint32_t *)(p+addr)) = x; }
 431: #else
 432: 	p[addr]   = x >> 24; p[addr+1] = x >> 16;
 433: 	p[addr+2] = x >> 8;  p[addr+3] = x; }
 434: #endif
 435: #else
 436: #ifdef HOST_LITTLE_ENDIAN
 437: 	*((uint32_t *)(p+addr+4)) = x; }
 438: #else
 439: 	p[addr  +4] = x;        p[addr+1+4] = x >> 8;
 440: 	p[addr+2+4] = x >> 16;  p[addr+3+4] = x >> 24; }
 441: #endif
 442: #endif
 443: 
 444: 	/*  Second word in pair:  */
 445: 	{ uint32_t x = reg(ic->arg[0] + 4);
 446: #ifdef LS_BE
 447: #ifdef HOST_BIG_ENDIAN
 448: 	*((uint32_t *)(p+addr+4)) = x; }
 449: #else
 450: 	p[addr  +4] = x >> 24; p[addr+1+4] = x >> 16;
 451: 	p[addr+2+4] = x >> 8;  p[addr+3+4] = x; }
 452: #endif
 453: #else
 454: #ifdef HOST_LITTLE_ENDIAN
 455: 	*((uint32_t *)(p+addr)) = x; }
 456: #else
 457: 	p[addr  ] = x;        p[addr+1] = x >> 8;
 458: 	p[addr+2] = x >> 16;  p[addr+3] = x >> 24; }
 459: #endif
 460: #endif
 461: 
 462: #endif	/*  LS_8  */
 463: 
 464: #endif	/*  store  */
 465: }
