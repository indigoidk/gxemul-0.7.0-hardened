  79: # check <description> <actual> <expected>
  80: check() {
  81:     _checks=$((_checks+1))
  82:     if [ "$2" = "$3" ]; then
  83:         printf "  ${C_OK}ok${C_OFF}   %-52s %s\n" "$1" "$2"
  84:     else
  85:         printf "  ${C_BAD}FAIL${C_OFF} %-52s got=%s want=%s\n" "$1" "$2" "$3"
  86:         _fails=$((_fails+1))
  87:     fi
  88: }
  89: 
  90: # check_min <description> <actual> <minimum>
  91: check_min() {
  92:     _checks=$((_checks+1))
  93:     if [ "$2" -ge "$3" ] 2>/dev/null; then
  94:         printf "  ${C_OK}ok${C_OFF}   %-52s %s (>= %s)\n" "$1" "$2" "$3"
  95:     else
  96:         printf "  ${C_BAD}FAIL${C_OFF} %-52s got=%s want>=%s\n" "$1" "$2" "$3"
  97:         _fails=$((_fails+1))
  98:     fi
  99: }
 100: 
 101: note() { printf "  --   %s\n" "$*"; }
 102: 
 103: # A gate may declare that part of its coverage did not run (a rig whose image is absent,
 104: # say). That must not be absorbed into a PASS: it downgrades the whole gate to SKIP, so a
 105: # missing input can never be reported as evidence of correctness.
 106: _degraded=0
 107: degrade() { _degraded=1; printf "  ${C_SKIP}skip${C_OFF} %s\n" "$*"; }
 108: 
 109: gate_end() {
 110:     echo
 111:     if [ "$_checks" = 0 ]; then
 112:         echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} (no checks ran)"; return $EXIT_SKIP
 113:     elif [ "$_fails" != 0 ]; then
 114:         echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks)"; return 1
 115:     elif [ "$_degraded" != 0 ]; then
 116:         echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} ($_checks checks passed, but part of the gate could not run)"
 117:         return $EXIT_SKIP
 118:     else
 119:         echo "${C_OK}$GATE_NAME: PASS${C_OFF} ($_checks checks)"; return 0
 120:     fi
 121: }
 122: 
 123: #  #371: gate_skip() exits with the SKIP code, which run.sh maps to
 124: #  REGRESS_PASS_WITH_GAPS -- a green-ish verdict. It never consulted the running
 125: #  failure counter, so a gate that had ALREADY recorded red checks and then hit a
 126: #  gate_skip (a probe that produced no result line, a missing rig image) reported
 127: #  those reds as a skip and they vanished from the battery. Measured on a
 128: #  synthetic gate: one FAIL then gate_skip exited 77, PASS_WITH_GAPS. This is the
 129: #  same "a green row means nothing" class the gate rows themselves guard against,
 130: #  in the harness's own control flow.
 131: #
 132: #  So a gate_skip AFTER failures is a FAIL, not a skip: the skip cannot un-record
 133: #  what already failed. A gate_skip with a clean slate stays a genuine skip (a
 134: #  preflight that could not run at all -- need_file/need_exec). degrade() was
 135: #  already correct: gate_end() tests _fails before _degraded, so a degraded gate
 136: #  with recorded failures already reports FAIL. Nothing there to change.
 137: gate_skip() {
 138:     echo
 139:     if [ "${_fails:-0}" != 0 ]; then
 140:         echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks failed" \
 141:              "before this section could not run: $*)"
 142:         exit 1
 143:     fi
 144:     echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} -- $*"; exit $EXIT_SKIP
 145: }
 146: 
 147: need_file() {
 148:     for f in "$@"; do
 149:         [ -e "$f" ] || gate_skip "missing required input: $f"
 150:     done
 151: }
 152: 
 153: need_exec() {
 154:     for f in "$@"; do
 155:         [ -x "$f" ] || gate_skip "missing or non-executable binary: $f"
 156:     done
1936: fi
1937: 
1938: # ---- #406: the autodev.c generator ----------------------------------------------
1939: # A prose mention of "DEVINIT" in a comment used to reach the generated C. It cost
1940: # 358 compiler errors, no binary, gate 1 red and eleven gates skipped -- from one
1941: # comment line, which is still in the tree DELIBERATELY (rewording it would have
1942: # made the hardening deletable in silence).
1943: #
1944: # The driver runs the REAL generator in a scratch copy, so it cannot drift from
1945: # what ships, and it carries its own mutant lane. The load-bearing row is the
1946: # ORDERED NAME LIST, not a character check: measured, the half-fix that keeps
1947: # noglob but drops the anchor emits 27 extra names of which 26 are DOTLESS --
1948: # valid C identifiers that a "no bad characters" row waves straight through, and
1949: # that fail at link time instead of parse time.
1950: AGLOG=$LOGDIR/diff_autodev_gen.log
1951: if [ ! -x "$HERE/diff_autodev_gen.sh" ]; then
1952:     check "autodev generator: driver is executable" "no" "yes"
1953: else
1954:     "$HERE/diff_autodev_gen.sh" > "$AGLOG" 2>&1
1955:     sed 's/^/       /' "$AGLOG"
1956:     check     "autodev generator: row failures" \
1957:               "$(grep -oE '[0-9]+ failures' "$AGLOG" | grep -oE '^[0-9]+')" "0"
1958:     check_min "autodev generator: rows actually run" \
1959:               "$(grep -oE '^[0-9]+ rows' "$AGLOG" | grep -oE '^[0-9]+')" 8
1960:     check     "autodev generator: offline verdict" \
1961:               "$(grep -c 'AUTODEV_GEN_PASS' "$AGLOG")" "1"
1962:     #  Named rows. The two mutants are what make the ordered-list assertion
1963:     #  load-bearing rather than decorative, so deleting either must be loud.
1964:     check     "autodev generator: the ordered devinit list is asserted" \
1965:               "$(grep -c 'devinit names == the .DEVINIT( declarations, in order' "$AGLOG")" "1"
1966:     check     "autodev generator: the full-revert mutant is present" \
1967:               "$(grep -c 'MUTANT killed: full revert' "$AGLOG")" "1"
1968:     check     "autodev generator: the HALF-FIX mutant is present" \
1969:               "$(grep -c 'MUTANT killed: noglob only' "$AGLOG")" "1"
1970:     #  If somebody rewords dev_rs5c313.c:144 the mutant lane stops proving
1971:     #  anything, so the driver asserts that live input still exists and this row
1972:     #  makes that assertion visible at gate level too.
1973:     check     "autodev generator: a live off-anchor mention still exists" \
1974:               "$(grep -c 'a live off-anchor DEVINIT mention still exists' "$AGLOG")" "1"
1975:     #  No mutant may SURVIVE. Named separately from the failure count because a
1976:     #  survivor is a statement about the DETECTOR, not about the generator.
1977:     check     "autodev generator: no mutant survives" \
1978:               "$(grep -c 'SURVIVES' "$AGLOG")" "0"
1979: fi
