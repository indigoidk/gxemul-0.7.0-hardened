codex
The table repair holds up, but the regression plan needs changes: it must check both fresh generator output and the committed table, anchor checks to exact handler names, and include a halfword accept check. I also found a separate, unmeasured `xmem` register-aliasing concern to report under Q4.

exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$sourceLines = Get-Content -LiteralPath '"'GXEMUL-SEC\\regress\\diff_autodev_gen.sh'; for ("'$lineNumber=0; $lineNumber -lt 155; $lineNumber++) { '"'{0,4}: {1}' -f ("'$lineNumber+1), $sourceLines[$lineNumber] }' in C:\DocumentNoSnc\CC\GXEMUL
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$sourceLines = Get-Content -LiteralPath '"'GXEMUL-SEC\\regress\\lib.sh'; for ("'$lineNumber=75; $lineNumber -lt 156; $lineNumber++) { '"'{0,4}: {1}' -f ("'$lineNumber+1), $sourceLines[$lineNumber] }; $gateLines = Get-Content -LiteralPath '"'GXEMUL-SEC\\regress\\gate_offline.sh'; for ("'$lineNumber=1935; $lineNumber -lt 1980; $lineNumber++) { '"'{0,4}: {1}' -f ("'$lineNumber+1), $gateLines[$lineNumber] }' in C:\DocumentNoSnc\CC\GXEMUL
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$manualLines = Get-Content -LiteralPath '"'_scratchpad\\mc88100.txt'; foreach ("'$span in @(@(6434,6471),@(8181,8191),@(13050,13063))) { for ($lineNumber=$span[0]-1; $lineNumber -lt $span[1]; $lineNumber++) { '"'{0,5}: {1}' -f ("'$lineNumber+1), $manualLines[$lineNumber] } }' in C:\DocumentNoSnc\CC\GXEMUL
 succeeded in 93ms:
   1: #!/bin/sh
   2: #
   3: #  #406: does makeautodev.sh build the device table from the DECLARATIONS, and
   4: #  from nothing else?
   5: #
   6: #  WHY THIS EXISTS.  A prose mention of "DEVINIT" in a comment used to reach the
   7: #  generated C.  dev_rs5c313.c:144 is such a line, and it produced 319
   8: #  declarations instead of 77 -- 358 compiler errors, no binary, gate 1 red, and
   9: #  eleven downstream gates skipped for want of a published binary.
  10: #
  11: #  *** THAT COMMENT IS STILL IN THE TREE, DELIBERATELY.  It was not reworded. ***
  12: #  Rewording it would have made the hardening deletable in silence: revert the
  13: #  generator and everything stays green.  Left in place, the live tree IS the
  14: #  hostile input, so the mutant lane below genuinely fails when the anchor goes.
  15: #  The planted cases exist so this detector does not DEPEND on that one comment
  16: #  surviving a future edit.
  17: #
  18: #  THE ASSERTION IS THE EXACT NAME LIST, NOT "no bad characters", and that is the
  19: #  design.  The corruption had TWO sources: 229 names containing a `.`
  20: #  (Makefile.skel, bus_isa.o, even the generator's own in-flight temp file),
  21: #  which are syntax errors -- and 14 names that are perfectly valid C
  22: #  identifiers (Makefile, README, fonts, plus the comment's own words: gmtime,
  23: #  being, the, right, choice ...), which fail at LINK time instead.  A row
  24: #  asserting "no identifier contains a dot" PASSES a generator that still emits
  25: #  those 14.  Mutant 2 below is exactly that half-fix, carried as a named case.
  26: #
  27: #  Offline: no compiler, no guest, no build tree.  Wired into gate 2.
  28: set -u
  29: 
  30: HERE=$(cd "$(dirname "$0")" && pwd)
  31: SEC=$(cd "$HERE/.." && pwd)
  32: DEV="$SEC/src/devices"
  33: GEN="$DEV/makeautodev.sh"
  34: 
  35: WORK=${TMPDIR:-/tmp}/gxsec-autodevgen.$$
  36: trap 'rm -rf "$WORK"' 0 1 2 3 15
  37: rm -rf "$WORK"; mkdir -p "$WORK"
  38: 
  39: rows=0
  40: failures=0
  41: ok()   { rows=$((rows + 1)); printf '  ok   %-48s %s\n' "$1" "$2"; }
  42: bad()  { rows=$((rows + 1)); failures=$((failures + 1))
  43:          printf '  FAIL %-48s %s\n' "$1" "$2"; }
  44: note() { printf '  --   %s\n' "$1"; }
  45: 
  46: #  A pristine copy of everything the generator reads.  NEVER run it in the repo:
  47: #  it writes autodev.c and .index, and both are TRACKED.
  48: mkdir -p "$WORK/t"
  49: cp "$DEV"/*.c "$WORK/t/"
  50: 
  51: #  What the generator SHOULD emit, derived from the declarations themselves.
  52: #  Deliberately not taken from the committed autodev.c -- a tracked generated
  53: #  file is not evidence about its own generator.  `grep dev_*.c` walks the files
  54: #  in the same glob order the generator's `for a in dev_*.c` uses, so this is an
  55: #  ORDERED expectation, not just a set.
  56: ( cd "$WORK/t" && grep -h '^DEVINIT(' dev_*.c |
  57:     sed 's/^DEVINIT(\([^)]*\)).*/\1/' ) > "$WORK/want_dev"
  58: ( cd "$WORK/t" && grep -h '^PCIINIT(' bus_pci.c |
  59:     sed 's/^PCIINIT(\([^)]*\)).*/\1/' ) > "$WORK/want_pci"
  60: n_dev=$(grep -c . "$WORK/want_dev")
  61: n_pci=$(grep -c . "$WORK/want_pci")
  62: 
  63: names_of()    { sed -n 's/^int devinit_\(.*\)(struct devinit \*);$/\1/p' "$1"; }
  64: pcinames_of() { sed -n 's/^void pciinit_\([^(]*\)(struct machine \*.*$/\1/p' "$1"; }
  65: 
  66: #  Run a generator variant over a source tree.  $1=script $2=srcdir $3=tag.
  67: #  Returns 0 and leaves autodev.c in $WORK/run_$3; returns 2 if it produced
  68: #  nothing at all, which is a FAULT and must never be scored as a detection.
  69: run_gen() {
  70:     rm -rf "$WORK/run_$3"
  71:     cp -r "$2" "$WORK/run_$3"
  72:     cp "$1" "$WORK/run_$3/makeautodev.sh"
  73:     chmod +x "$WORK/run_$3/makeautodev.sh"
  74:     ( cd "$WORK/run_$3" && ./makeautodev.sh ) > "$WORK/gen_$3.log" 2>&1
  75:     [ -f "$WORK/run_$3/autodev.c" ] || return 2
  76:     return 0
  77: }
  78: 
  79: # ------------------------------------------------------------ the committed tree
  80: if ! run_gen "$GEN" "$WORK/t" base; then
  81:     bad "generator runs on the committed tree" "no autodev.c -- see gen_base.log"
  82:     printf '\n%d rows, %d failures\nAUTODEV_GEN_FAIL\n' "$rows" "$failures"
  83:     exit 1
  84: fi
  85: ok "generator runs on the committed tree" "autodev.c produced"
  86: BASE="$WORK/run_base/autodev.c"
  87: 
  88: names_of    "$BASE" > "$WORK/got_dev"
  89: pcinames_of "$BASE" > "$WORK/got_pci"
  90: 
  91: #  THE LOAD-BEARING ROW.  Exact list, in order.  Order is not pedantry:
  92: #  device_register() order is the order devices are offered to a machine, so a
  93: #  reordering is a behavioural change even when the set is unchanged.
  94: if cmp -s "$WORK/want_dev" "$WORK/got_dev"; then
  95:     ok "devinit names == the ^DEVINIT( declarations, in order" "$n_dev names"
  96: else
  97:     bad "devinit names == the ^DEVINIT( declarations, in order" "differs:"
  98:     diff "$WORK/want_dev" "$WORK/got_dev" | head -12 | sed 's/^/         /'
  99: fi
 100: 
 101: if cmp -s "$WORK/want_pci" "$WORK/got_pci"; then
 102:     ok "pciinit names == the ^PCIINIT( declarations, in order" "$n_pci names"
 103: else
 104:     bad "pciinit names == the ^PCIINIT( declarations, in order" "differs:"
 105:     diff "$WORK/want_pci" "$WORK/got_pci" | head -12 | sed 's/^/         /'
 106: fi
 107: 
 108: #  A fast legible tripwire, kept only as that.  The list comparison above is what
 109: #  actually guards the table -- see mutant 2, which this row does NOT catch.
 110: #  Digits are legal: dev_8253.c and dev_8259.c name devices starting with one.
 111: junk=$(grep -c '^int devinit_[A-Za-z0-9_]*[^A-Za-z0-9_(]' "$BASE" || true)
 112: if [ "$junk" = 0 ]; then
 113:     ok "no emitted identifier holds a stray character" "0"
 114: else
 115:     bad "no emitted identifier holds a stray character" "$junk line(s)"
 116: fi
 117: 
 118: #  The live off-anchor mention is what keeps the mutant lane honest.  If somebody
 119: #  rewords it, say so out loud rather than letting the lane become unfalsifiable.
 120: live=$(grep -c 'DEVINIT' "$WORK/t/dev_rs5c313.c" || true)
 121: anch=$(grep -c '^DEVINIT(' "$WORK/t/dev_rs5c313.c" || true)
 122: if [ "$live" -gt "$anch" ]; then
 123:     ok "a live off-anchor DEVINIT mention still exists" "dev_rs5c313.c"
 124: else
 125:     bad "a live off-anchor DEVINIT mention still exists" \
 126:         "GONE -- mutant 1/2 no longer prove anything; plant one or fix this row"
 127: fi
 128: 
 129: # ------------------------------------------------------- planted hostile inputs
 130: #  Do not rely on one comment surviving.  Plant a worse pair: prose DEVINIT and
 131: #  prose PCIINIT, each on a line that BEGINS with the glob character that did the
 132: #  damage.  A correct generator must be byte-for-byte unmoved by both.
 133: cp -r "$WORK/t" "$WORK/t2"
 134: cat >> "$WORK/t2/dev_cons.c" <<'PLANT'
 135: /*
 136:  *  #406 planted input.  A DEVINIT mention in prose, on a line starting with a
 137:  *  glob character, is exactly the shape that expanded to the whole directory.
 138:  */
 139: PLANT
 140: cat >> "$WORK/t2/bus_pci.c" <<'PLANT'
 141: /*
 142:  *  #406 planted input: a PCIINIT mention in prose, same shape.
 143:  */
 144: PLANT
 145: 
 146: if run_gen "$GEN" "$WORK/t2" plant; then
 147:     if cmp -s "$BASE" "$WORK/run_plant/autodev.c"; then
 148:         ok "planted DEVINIT + PCIINIT prose changes nothing" "byte-identical"
 149:     else
 150:         bad "planted DEVINIT + PCIINIT prose changes nothing" "output differs:"
 151:         diff "$BASE" "$WORK/run_plant/autodev.c" | head -10 | sed 's/^/         /'
 152:     fi
 153: else
 154:     bad "planted DEVINIT + PCIINIT prose changes nothing" "generator produced nothing"
 155: fi

