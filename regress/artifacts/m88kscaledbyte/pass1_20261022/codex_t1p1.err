  25:  *  SUCH DAMAGE.
  26:  *
  27:  *
  28:  *  M88K load/store instructions; the following args are used:
  29:  *  
  30:  *  arg[0] = pointer to the register to load to or store from (d)
  31:  *  arg[1] = pointer to the base register (s1)
  32:  *  arg[2] = pointer to the offset register (s2), or an uint32_t offset
  33:  *
  34:  *  The GENERIC function always checks for alignment, and supports both big
  35:  *  and little endian byte order.
  36:  *
  37:  *  The quick function is included twice (big/little endian) for each
  38:  *  GENERIC function.
  39:  *
  40:  *
  41:  *  Defines:
  42:  *	LS_LOAD or LS_STORE (only one)
  43:  *	LS_INCLUDE_GENERIC (to generate the generic function)
  44:  *	LS_GENERIC_N is defined as the name of the generic function
  45:  *	LS_NO_PC_SYNC is defined to skip Program Counter sync in the generic function
  46:  *	LS_N is defined as the name of the fast function
  47:  *	LS_1, LS_2, LS_4, or LS_8 (only one)
  48:  *	LS_SIZE is defined to 1, 2, 4, or 8
  49:  *	LS_SIGNED is defined for signed loads
  50:  *	LS_LE or LS_BE (only one)
  51:  *	LS_SCALED for scaled accesses
  52:  *	LS_USR for usr accesses
  53:  *	LS_REGOFS is defined when arg[2] is a register pointer
  54:  */
  55: 
  56: 
  57: #ifdef LS_INCLUDE_GENERIC
  58: void LS_GENERIC_N(struct cpu *cpu, struct m88k_instr_call *ic)
  59: {
  60: #ifdef LS_USR
  61: 	const int memory_rw_flags = CACHE_DATA | MEMORY_USER_ACCESS;
  62: #else
  63: 	const int memory_rw_flags = CACHE_DATA;
  64: #endif
  65: 	uint32_t addr = reg(ic->arg[1]) +
  66: #ifdef LS_REGOFS
  67: #ifdef LS_SCALED
  68: 	    LS_SIZE *
  69: #endif
  70: 	    reg(ic->arg[2]);
  71: #else
  72: 	    ic->arg[2];
  73: #endif
  74: 	uint8_t data[LS_SIZE];
  75: 	uint64_t x;
  76: 
  77: #ifndef LS_NO_PC_SYNC
  78: 	/*  Synchronize the PC:  */
  79: 	int low_pc = ((size_t)ic - (size_t)cpu->cd.m88k.cur_ic_page)
  80: 	    / sizeof(struct m88k_instr_call);
  81: 	cpu->pc &= ~((M88K_IC_ENTRIES_PER_PAGE-1)<<M88K_INSTR_ALIGNMENT_SHIFT);
  82: 	cpu->pc += (low_pc << M88K_INSTR_ALIGNMENT_SHIFT);
  83: #endif
  84: 
  85: 	/*
  86: 	 *  Update the memory transaction registers:
  87: 	 */
  88: 	cpu->cd.m88k.dmt[1] = 0;
  89: 
  90: 	cpu->cd.m88k.dmt[0] = DMT_VALID;
  91: #ifdef LS_STORE
  92: 	cpu->cd.m88k.dmt[0] |= DMT_WRITE;
  93: #else
  94: 	{
  95: 		int dreg = (((uint32_t *)ic->arg[0]) - &cpu->cd.m88k.r[0]);
  96: 		if (dreg < 1 || dreg > 31) {
  97: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k load/store",
  98: 			    VERBOSITY_ERROR,
  99: 			    "HUH? dreg = %i in cpu_m88k_instr_loadstore.c."
 100: 			    " Internal error.", dreg);
 101: 			cpu->running = 0;
 102: 			cpu->cd.m88k.next_ic = &nothing_call;
 103: 			return;
 104: 		}
 105: 		cpu->cd.m88k.dmt[0] |= dreg << DMT_DREGSHIFT;
 106: 	}
 107: #ifdef LS_SIGNED
 108: 	cpu->cd.m88k.dmt[0] |= DMT_SIGNED;
 109: #endif
 110: #endif
 111: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
 112: 		cpu->cd.m88k.dmt[0] |= DMT_BO;
 113: 
 114: #ifndef LS_USR
 115: 	if (cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_MODE)
 116: 		cpu->cd.m88k.dmt[0] |= DMT_DAS;		/*  supervisor  */
 117: #endif
 118: 
 119: 	/*  EN bits:  */
 120: #ifdef LS_1
 121: 	/*  TODO: Is the EN offset only valid for Big-Endian?  */
 122: 	cpu->cd.m88k.dmt[0] |= 1 << DMT_ENSHIFT << (3 - (addr & 3));
 123: #else
 124: #ifdef LS_2
 125: 	cpu->cd.m88k.dmt[0] |= 3 << DMT_ENSHIFT << (2 - (addr & 2));
 126: #else
 127: 	cpu->cd.m88k.dmt[0] |= 0xf << DMT_ENSHIFT;
 128: #endif
 129: #endif
 130: 
 131: 	cpu->cd.m88k.dma[0] = addr & ~0x3;
 132: 	cpu->cd.m88k.dmd[0] = 0;
 133: 
 134: #ifdef LS_8
 135: 	cpu->cd.m88k.dmt[1] = cpu->cd.m88k.dmt[0];
 136: 	cpu->cd.m88k.dmt[0] |= DMT_DOUB1;
 137: 	cpu->cd.m88k.dma[1] = cpu->cd.m88k.dma[0] + sizeof(uint32_t);
 138: 	cpu->cd.m88k.dmd[1] = 0;
 139: #ifdef LS_LOAD
 140: 	{
 141: 		int dreg = (((uint32_t *)ic->arg[0]) - &cpu->cd.m88k.r[0]);
 142: 		dreg ++;
 143: 		if (dreg < 1 || dreg > 31) {
 144: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k load/store",
 145: 			    VERBOSITY_ERROR,
 146: 			    "HUH? dreg = %i in cpu_m88k_instr_loadstore.c."
