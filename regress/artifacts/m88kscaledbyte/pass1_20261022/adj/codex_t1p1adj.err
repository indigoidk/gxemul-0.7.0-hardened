252: #endif
253: 	    reg(ic->arg[2]);
254: #else
255: 	    ic->arg[2];
256: #endif
257: 
258: #ifdef LS_USR
259: #ifdef LS_LOAD
260: 	uint8_t *p = cpu->cd.m88k.host_load_usr[addr >> 12];
261: #else
262: 	uint8_t *p = cpu->cd.m88k.host_store_usr[addr >> 12];
263: #endif
264: #else
265: #ifdef LS_LOAD
266: 	uint8_t *p = cpu->cd.m88k.host_load[addr >> 12];
267: #else
268: 	uint8_t *p = cpu->cd.m88k.host_store[addr >> 12];
269: #endif
270: #endif
271: 
272: 	/*
273: 	 *  Call the generic function, if things become too complicated:
274: 	 *
275: 	 *  1)  .usr used in non-supervisor mode
276: 	 *  2)  the page pointer is NULL
277: 	 *  3)  unaligned access
278: 	 */
279: 	if (unlikely(
280: #ifdef LS_USR
281: 	    !(cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_MODE) ||
282: #endif
283: 
284: 	    p == NULL
285: #ifndef LS_1
286: 	    || addr & (LS_SIZE - 1)
287: #endif
288: 	    )) {
289: 		LS_GENERIC_N(cpu, ic);
290: 		return;
291: 	}
292: 
293: 	addr &= 0xfff;
294: 
295: #ifdef LS_LOAD
296: 	/*  Load:  */
297: 
298: #ifdef LS_1
299: 	reg(ic->arg[0]) =
300: #ifdef LS_SIGNED
301: 	    (int8_t)
302: #endif
303: 	    p[addr];
