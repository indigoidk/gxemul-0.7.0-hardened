180: EOF
181: 
182: #  The #375 reader (gate_offline.sh's ls_entry), parametrized by file, array
183: #  name and size, and run ONCE per artifact: every entry of the FIRST
184: #  `(*<array>[<size>])(...) = {` initializer, one per line, in index order.
185: #  This table ends `<last entry> };` on the entry's own line, so the end test is
186: #  "the line holds the closing brace" rather than ls_entry's `^};`.
187: #  Prints "<initializers> <entries> <NULL entries>".
188: parse() {   # $1 file  $2 array  $3 size  $4 entries-out
189:     : > "$4"
190:     if [ ! -f "$1" ]; then echo "0 0 0"; return; fi
191:     awk -v arr="$2" -v size="$3" -v out="$4" '
192:         index($0, "(*" arr "[" size "])") && /= *[{]/ {
193:             inits++; if (inits == 1) f = 1; next }
194:         f { last = ($0 ~ /[}]/); gsub(/[ \t,};]/, "")
195:             if ($0 != "") { n++; print > out; if ($0 == "NULL") nul++ }
196:             if (last) f = 0 }
197:         END { printf "%d %d %d\n", inits, n, nul }' "$1"
198: }
199: ent() { sed -n "$(($2 + 1))p" "$1"; }   # $1 entries file  $2 index
200: 
201: #  Every row is emitted on every run -- a missing artifact turns its rows RED,
202: #  it never removes them -- so the row count is constant and gate 2 pins it.
203: artifact_rows() {   # $1 label  $2 file
204:     lbl=$1; file=$2
205:     counts=$(parse "$file" m88k_loadstore 512 "$WORK/$lbl.ent")
206:     #  The trailing zeros keep $1..$3 set (set -u) if the parse printed nothing.
207:     set -- $counts 0 0 0
208:     if [ ! -f "$file" ]; then present=absent
209:     elif [ "$1" -ge 1 ]; then present=yes
210:     else present="no m88k_loadstore[512] initializer"; fi
211:     row "${lbl}_present" "present and parseable" "$present" "yes"
212:     row "${lbl}_inits" "m88k_loadstore[512] initializers" "$1" "1"
213:     row "${lbl}_entries" "initializer entries" "$2" "512"
214:     row "${lbl}_nulls" "NULL entries (supplementary)" "$3" "272"
215:     if [ -f "$file" ]; then nls=$(grep -c '^#define LS_N ' "$file"); else nls=absent; fi
216:     row "${lbl}_lsn" "#define LS_N blocks (suppression count)" "$nls" "198"
217:     while read -r i c name desc; do
218:         case $c in
219:         R) id=${lbl}_pin$i; d="repair $desc (consumer)" ;;
220:         N) id=${lbl}_pin$i; d="repair $desc (no consumer)" ;;
221:         A) id=${lbl}_acc$i; d="accept $desc" ;;
222:         *) id=${lbl}_cp$i;  d="counterpart $desc" ;;
223:         esac
224:         row "$id" "$d" "$(ent "$WORK/$lbl.ent" "$i")" "$name"
225:     done < "$WORK/spec"
226: }
227: 
228: # ------------------------------------------------- the generator, run for real
229: compiled=no
230: if [ ! -f "$GEN" ]; then
231:     gres="no -- source absent"
232: elif ! cp "$GEN" "$WORK/generate_m88k_loadstore.c" 2>/dev/null; then
233:     gres="no -- source unreadable"
234: elif ( cd "$WORK" && $CC -o generate_m88k_loadstore generate_m88k_loadstore.c ) \
235:         > "$WORK/cc.log" 2>&1 && [ -x "$WORK/generate_m88k_loadstore" ]; then
236:     gres=yes; compiled=yes
237: else
238:     gres="no -- the compile or link failed"
239: fi
240: row gen_compiles "generator: compiles and links" "$gres" "yes"
241: if [ "$compiled" != yes ] && [ -s "$WORK/cc.log" ]; then
242:     sed -e "s|$WORK/||g" -e 's/^/  --   cc: /' "$WORK/cc.log" | head -6
243: fi
244: 
245: #  EXECUTION is its own pair of rows: a generator that compiles and then exits
246: #  non-zero, or prints nothing, is red here and not only downstream.
247: if [ "$compiled" = yes ]; then
248:     ( cd "$WORK" && ./generate_m88k_loadstore > fresh.c 2> gen.err ); grc=$?
249: else
250:     grc="not run"
251: fi
252: row gen_exit "generator: exit status" "$grc" "0"
253: if [ "$compiled" != yes ]; then sres="not run"
254: elif [ -s "$WORK/fresh.c" ]; then sres=yes
255: else sres="no -- stdout empty"; fi
256: row gen_stdout "generator: stdout non-empty" "$sres" "yes"
257: if [ -f "$WORK/gen.err" ]; then
258:     gf=$(sed -n 's/^.*: generated_functions = \([0-9][0-9]*\)$/\1/p' "$WORK/gen.err" | head -1)
259:     [ -n "$gf" ] || gf="not reported"
260: else
261:     gf=absent
262: fi
263: row gen_count "generator: stderr generated_functions" "$gf" "198"
264: 
265: # ---------------------------------------------------- both artifacts, same rows
266: artifact_rows fresh "$WORK/fresh.c"
267: artifact_rows committed "$TABLE"
268: 
269: if [ ! -f "$WORK/fresh.c" ]; then cres="fresh output absent"
270: elif [ ! -f "$TABLE" ]; then cres="committed table absent"
271: elif cmp -s "$WORK/fresh.c" "$TABLE"; then cres=identical
272: else cres=differ; fi
273: row cmp_fresh_committed "fresh == committed, byte for byte (cmp)" "$cres" "identical"
274: if [ "$cres" = differ ]; then
275:     diff "$WORK/fresh.c" "$TABLE" | head -8 | sed 's/^/  --   diff: /'
276: fi
277: 
278: printf '\nROWS=%d FAIL=%d\n' "$rows" "$fails"
279: printf 'M88KLS_DONE\n'
280: if [ "$fails" = 0 ]; then exit 0; else exit 1; fi

