  73| 
  74| # ---- #569: the m88k load/store dispatch-table generator --------------------------
  75| # generate_m88k_loadstore.c printed NULL for the 24 scaled-byte slots of
  76| # m88k_loadstore[512], which cpu_m88k_instr.c indexes with no NULL check
  77| # (xmem_slow() calls the slot; the register-form ld/st decoder installs it as
  78| # ic->f). The fix deletes that NULL arm, so the slots name the unscaled byte
  79| # handlers. The driver compiles and runs the REAL generator in a scratch copy and
  80| # reads the COMMITTED table separately -- each alone stays green when only the
  81| # other is reverted -- against names hard-coded in the driver, never read from
  82| # either artifact. GEN and TABLE are cleared so this always tests the committed
  83| # files. A missing or non-compiling generator, one that fails to run, and a
  84| # missing table are each a red row inside the driver, never a skip.
  85| MLSLOG=$LOGDIR/diff_m88k_loadstore_gen.log
  86| if [ ! -x "$HERE/diff_m88k_loadstore_gen.sh" ]; then
  87|     check "m88k loadstore generator: driver is executable" "no" "yes"
  88| else
  89|     GEN= TABLE= "$HERE/diff_m88k_loadstore_gen.sh" > "$MLSLOG" 2>&1
  90|     sed 's/^/       /' "$MLSLOG"
  91|     check     "m88k loadstore generator: row failures" \
  92|               "$(sed -n 's/^ROWS=[0-9]* FAIL=\([0-9]*\)$/\1/p' "$MLSLOG")" "0"
  93|     check     "m88k loadstore generator: rows run (the denominator is the pin)" \
  94|               "$(sed -n 's/^ROWS=\([0-9]*\) FAIL=[0-9]*$/\1/p' "$MLSLOG")" "123"
  95|     check     "m88k loadstore generator: completion sentinel" \
  96|               "$(grep -c '^M88KLS_DONE$' "$MLSLOG")" "1"
  97|     #  EVERY ROW BY IDENTITY, each exactly once, from lists held HERE and not read
  98|     #  from the driver: a deleted, renamed or duplicated row is red by name, which
  99|     #  the total alone cannot say.  The lists are the driver's contract -- the 24
 100|     #  repaired slots; the 6 further accepts plus the 3 counterparts that are also
 101|     #  accepts; the other 21 counterparts -- in both artifacts, plus the generator
 102|     #  status rows and the cmp row: 4 + 2 x (5 + 24 + 9 + 21) + 1 = 123.
 103|     _mls_pin="160 164 168 176 180 184 224 228 232 240 244 248 416 420 424 432 436 440 480 484 488 496 500 504"
 104|     _mls_acc="161 177 418 422 434 438 144 400 404"
 105|     _mls_cp="128 132 136 148 152 192 196 200 208 212 216 384 388 392 408 448 452 456 464 468 472"
 106|     _mls_ids="gen_compiles gen_exit gen_stdout gen_count cmp_fresh_committed"
 107|     for _a in fresh committed; do
 108|         _mls_ids="$_mls_ids ${_a}_present ${_a}_inits ${_a}_entries ${_a}_nulls ${_a}_lsn"
 109|         for _i in $_mls_pin; do _mls_ids="$_mls_ids ${_a}_pin$_i"; done
 110|         for _i in $_mls_acc; do _mls_ids="$_mls_ids ${_a}_acc$_i"; done
 111|         for _i in $_mls_cp;  do _mls_ids="$_mls_ids ${_a}_cp$_i"; done
 112|     done
 113|     for _id in $_mls_ids; do
 114|         check "m88k loadstore generator: row $_id, exactly once" \
 115|               "$(grep -ow -- "$_id" "$MLSLOG" | wc -l | tr -d ' ')" "1"
 116|     done
 117| fi
 118| 
 119| #  b1w: the pty record parser's selftest, and a POSITIVE CONTROL that proves the selftest can
 120| #  still catch something.  Placed BEFORE the compiler check on purpose: it needs only python3,
 121| #  and a machine without cc must not silently lose parser coverage as well as the
 122| #  differentials.  A measured census (absorb_census.py, 22 mutants) is what set the row floor;
 123| #  the shipped selftest before this round killed 17 of those 22 while reporting every row
 124| #  green, because its rows compared body+tail and a mutant that only MOVES text between the
 125| #  halves preserves the sum.
 221| #  THAT NAMED ROW and not from some unrelated collapse.
 222| check_min "absorb control: the kill is by the named row" \
 223|           "$(grep -c 'FAIL  lands in BODY' "$ACDIR/run.log")" 1
 224| #  KEEP THE LOGS WHEN THE CONTROL FAILS.  Removing them unconditionally deleted the only
 225| #  evidence at exactly the moment it was needed.
 226| [ "$ACRC" -ne 0 ] && grep -q SELFTEST_ABSORB_FAIL "$ACDIR/run.log" && rm -rf "$ACDIR"
 227| 
 228| command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 || \
 229|     gate_skip "no C compiler on PATH"
 230| CC=$(command -v cc || command -v gcc)
 231| need_file "$HERE/diff_ieee_store.c" "$SEC/src/$SRC"
 232| 
 233| # Pick a configured tree: it must have the generated config.h AND the header directory.
 234| TREE=""
 235| for t in "$ROOT/build" /tmp/gxsec-build; do
 236|     [ -f "$t/config.h" ] && [ -f "$t/src/include/float_emul.h" ] && { TREE=$t; break; }
 237| done
 238| [ -n "$TREE" ] || gate_skip "no configured tree (run gate_build.sh first)"
 239| note "compiling against configured tree: $TREE"
 240| 
 241| # THE HONESTY LINK. Without this the gate tests whatever happens to be in a scratch
 242| # directory, which may lag the repository by any amount.
 243| if cmp -s "$TREE/src/$SRC" "$SEC/src/$SRC"; then
 244|     check "compiled float_emul.c is the committed one" "identical" "identical"
 245| else
 246|     check "compiled float_emul.c is the committed one" "DIFFERS" "identical"
 247|     note "the configured tree is stale -- run gate_build.sh to re-sync"

