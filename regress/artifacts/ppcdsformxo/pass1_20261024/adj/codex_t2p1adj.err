 155: # ----------------------------------------------------------------- architecture
 156: def sext(v, bits):
 157:     """The two's-complement value of the low `bits' bits of v."""
 158:     v &= (1 << bits) - 1
 159:     return v - (1 << bits) if v >> (bits - 1) else v
 160: 
 161: 
 162: def exts64(v, bits):
 163:     """EXTS to 64 bits, as the unsigned image a 64-bit register holds."""
 164:     return sext(v, bits) & M64
