3589: def domain(regress):
3590:     """The .py artefacts this check governs, and (mode, why) describing how it decided.
3591: 
3592:     *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
3593:     first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
3594:     round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
3595:     check went red -- correctly identifying a real unwired detector, but firing at a
3596:     file its author had not yet offered for commit, in someone else's working tree.
3597: 
3598:     `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
3599:     add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
3600:     precisely when the author is present to classify it.  A scratch probe that is never
3601:     staged defends nothing in a fresh clone either, so it is honestly out of scope.
3602: 
3603:     FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
3604:     git cannot answer, and a fallback that quietly changes what a check governs is the
3605:     kind of silent scope change this harness keeps being bitten by.  So the mode is
3606:     printed on the summary line.
3607:     """
3608:     try:
3609:         p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
3610:                            capture_output=True, text=True)
3611:         if p.returncode == 0:
3612:             #  #471: NO `"/" not in f` FILTER.  Its docstring always claimed "every
3613:             #  committed DETECTOR under regress/", and the filter made that false --
3614:             #  the checker could not see below top level, which is exactly where
3615:             #  #465 shipped a detector that no gate ran.
3616:             #
3617:             #  `git ls-files` yields paths RELATIVE to regress/, so a top-level file
3618:             #  still arrives as a bare basename and every existing MANIFEST key keeps
3619:             #  matching unchanged.  Only nested files gain a path key.
3620:             files = sorted(f for f in p.stdout.split()
3621:                            if f.endswith(".py")
3622:                            and os.path.isfile(os.path.join(regress, f)))
3623:             if files:
3624:                 return files, "tracked-or-staged"
3625:     except OSError:
3626:         pass
3627:     #  #471: the FALLBACK must descend too.  Leaving it flat would re-create the blind

