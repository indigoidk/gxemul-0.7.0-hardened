 338:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", seg):
 339:             regs[int(m.group(1))] = int(m.group(2), 16)
 340:         m = re.search(r"\bpc  = (0x[0-9a-fA-F]+)", seg)
 341:         pc = int(m.group(1), 16) if m else None
 342:         m = re.search(r"\bmsr = (0x[0-9a-fA-F]+)", seg)
