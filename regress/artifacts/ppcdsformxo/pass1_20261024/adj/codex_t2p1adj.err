4095| #else
4096| 	{
4097| 		const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
4098| 		const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
4099| 		const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
