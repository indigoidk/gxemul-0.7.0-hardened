4101| 		uint32_t x2 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
4102| 		uint32_t x3 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N-
4103| 		    DYNTRANS_L3N)) & mask3;
