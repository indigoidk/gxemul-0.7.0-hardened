4083| 	/*  Figure out the (virtual) address of the instruction:  */
4084| 	low_pc = ((size_t)ic - (size_t)cpu->cd.ppc.cur_ic_page)
4085| 	    / sizeof(struct ppc_instr_call);
4086| 	addr = cpu->pc & ~((PPC_IC_ENTRIES_PER_PAGE-1)
4087| 	    << PPC_INSTR_ALIGNMENT_SHIFT);
4088| 	addr += (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);
4089| 	cpu->pc = addr;
4090| 	addr &= ~((1 << PPC_INSTR_ALIGNMENT_SHIFT) - 1);
4091| 
4092| 	/*  Read the instruction word from memory:  */
4093| #ifdef MODE32
