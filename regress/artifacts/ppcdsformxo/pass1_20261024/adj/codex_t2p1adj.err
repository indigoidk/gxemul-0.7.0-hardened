 324:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
 325:                            stderr=subprocess.STDOUT, timeout=timeout)
 326:         raw = p.stdout.decode("latin-1", "replace")
 327:         rc = p.returncode
 328:         how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
 329:     except subprocess.TimeoutExpired as e:
 330:         raw = (e.output or b"").decode("latin-1", "replace")
 331:         how = "TIMEOUT"
 332:     ncr = raw.count("\r")
