**8.7 The load/store handler template, WHOLE** (`src/cpus/cpu_ppc_instr_loadstore.c`; `LS_GENERIC_N` is the generic
handler, `LS_N` the fast path; the generator includes the file once per flag combination):
~~~~
 31|  *  Load/store instructions have the following arguments:
 32|  *
 33|  *  arg[0] = pointer to the register to load to or store from
 34|  *  arg[1] = pointer to the base register
 35|  *
 36|  *  arg[2] = offset (as an int32_t)
 37|  *	     (or, for Indexed load/stores: pointer to index register)
 38|  */
 39| 
 40| 
 41| #ifndef LS_IGNOREOFS
 42| void LS_GENERIC_N(struct cpu *cpu, struct ppc_instr_call *ic)
 43| {
 44| #ifdef MODE32
 45| 	uint32_t addr =
 46| #else
 47| 	uint64_t addr =
 48| #endif
 49| 	    reg(ic->arg[1]) +
 50| #ifdef LS_INDEXED
 51| 	    reg(ic->arg[2]);
 52| #else
 53| 	    (int32_t)ic->arg[2];
 54| #endif
 55| 	unsigned char data[LS_SIZE];
 56| 
 57| 	/*  Synchronize the PC:  */
 58| 	int low_pc = ((size_t)ic - (size_t)cpu->cd.ppc.cur_ic_page)
 59| 	    / sizeof(struct ppc_instr_call);
 60| 	cpu->pc &= ~((PPC_IC_ENTRIES_PER_PAGE-1) << PPC_INSTR_ALIGNMENT_SHIFT);
 61| 	cpu->pc += (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);
 62| 
 63| 	/*
 64| 	 *  #431: the page-crossing HALT is gone, because #430 made the thing it was
 65| 	 *  standing in for actually work.
 66| 	 *
 67| 	 *  What was here: an access whose bytes crossed a page boundary printed a TODO and
 68| 	 *  set cpu->running = false -- legal guest code STOPPED THE EMULATOR.  The fast path
 69| 	 *  guarantees it was reached: LS_N punts every unaligned non-byte access to
 70| 	 *  LS_GENERIC_N before any page test, so a warm translation was no protection.
 71| 	 *
 72| 	 *  It is DELETED rather than replaced with a split here, because a PPC-local split
 73| 	 *  would leave the other producers of straddling accesses untouched -- lvx/stvx,
 74| 	 *  lwarx/stwcx. and the ARM arm_pop path all call cpu->memory_rw DIRECTLY and never
 75| 	 *  passed through this function, so this halt never covered them.  memory_rw is the
 76| 	 *  choke point and #430 fixes it once.
 77| 	 *
 78| 	 *  Checked before deleting, because a loud stub can be load-bearing: no gate, probe,
 79| 	 *  CHANGELOG entry or OUTSTANDING_BUGS entry mentions this message or LS_GENERIC_N
 80| 	 *  (gate_ppc_halt.sh is an FP-encoding sweep reaching `goto bad`, a different
 81| 	 *  mechanism).  And there is no PPC alignment exception in this tree to fall back to:
 82| 	 *  cpu_ppc.h defines DSI/ISI/EI/FPU/DEC/SC and no alignment vector at all.  What real
 83| 	 *  601-versus-later silicon does on an unaligned page-crossing access is UNKNOWN --
 84| 	 *  there is no PowerPC manual in this project and none is reconstructed here.
 85| 	 */
 86| 
 87| #ifdef LS_LOAD
 88| 	if (!cpu->memory_rw(cpu, cpu->mem, addr, data, sizeof(data),
 89| 	    MEM_READ, CACHE_DATA)) {
 90| 		/*  Exception.  */
 91| 		if (!cpu->running)
 92| 			cpu->cd.ppc.next_ic = &nothing_call;
 93| 		return;
 94| 	}
 95| #ifdef LS_B
 96| 	reg(ic->arg[0]) =
 97| #ifndef LS_ZERO
 98| 	    (int8_t)
 99| #endif
100| 	    data[0];
101| #endif
102| #ifdef LS_H
103| 	reg(ic->arg[0]) =
104| #ifdef LS_BYTEREVERSE
105| 	    ((data[1] << 8) + data[0]);
106| #else
107| #ifndef LS_ZERO
108| 	    (int16_t)
109| #endif
110| 	    ((data[0] << 8) + data[1]);
111| #endif /*  !BYTEREVERSE  */
112| #endif
113| #ifdef LS_W
114| 	reg(ic->arg[0]) =
115| #ifdef LS_BYTEREVERSE
116| 	    ((data[3] << 24) + (data[2] << 16) +
117| 	    (data[1] << 8) + data[0]);
118| #else  /* !LS_BYTEREVERSE  */
119| #ifndef LS_ZERO
120| 	    (int32_t)
121| #else
122| 	    (uint32_t)
123| #endif
124| 	    ((data[0] << 24) + (data[1] << 16) +
125| 	    (data[2] << 8) + data[3]);
126| #endif /* !LS_BYTEREVERSE */
127| #endif
128| #ifdef LS_D
129| 	(*(uint64_t *)(ic->arg[0])) =
130| 	    ((uint64_t)data[0] << 56) + ((uint64_t)data[1] << 48) +
131| 	    ((uint64_t)data[2] << 40) + ((uint64_t)data[3] << 32) +
132| 	    ((uint64_t)data[4] << 24) + (data[5] << 16) +
133| 	    (data[6] << 8) + data[7];
134| #endif
135| 
136| #else	/*  store:  */
137| 
138| #ifdef LS_B
139| 	data[0] = reg(ic->arg[0]);
140| #endif
141| #ifdef LS_H
142| #ifdef LS_BYTEREVERSE
143| 	data[0] = reg(ic->arg[0]);
144| 	data[1] = reg(ic->arg[0]) >> 8;
145| #else
146| 	data[0] = reg(ic->arg[0]) >> 8;
147| 	data[1] = reg(ic->arg[0]);
148| #endif
149| #endif
150| #ifdef LS_W
151| #ifdef LS_BYTEREVERSE
152| 	data[0] = reg(ic->arg[0]);
153| 	data[1] = reg(ic->arg[0]) >> 8;
154| 	data[2] = reg(ic->arg[0]) >> 16;
155| 	data[3] = reg(ic->arg[0]) >> 24;
156| #else
157| 	data[0] = reg(ic->arg[0]) >> 24;
158| 	data[1] = reg(ic->arg[0]) >> 16;
159| 	data[2] = reg(ic->arg[0]) >> 8;
160| 	data[3] = reg(ic->arg[0]);
161| #endif /* !LS_BYTEREVERSE */
162| #endif
163| #ifdef LS_D
164| 	{ uint64_t x = *(uint64_t *)(ic->arg[0]);
165| 	data[0] = x >> 56;
166| 	data[1] = x >> 48;
167| 	data[2] = x >> 40;
168| 	data[3] = x >> 32;
169| 	data[4] = x >> 24;
170| 	data[5] = x >> 16;
171| 	data[6] = x >> 8;
172| 	data[7] = x; }
173| #endif
174| 	if (!cpu->memory_rw(cpu, cpu->mem, addr, data, sizeof(data),
175| 	    MEM_WRITE, CACHE_DATA)) {
176| 		/*  Exception.  */
177| 		if (!cpu->running)
178| 			cpu->cd.ppc.next_ic = &nothing_call;
179| 		return;
180| 	}
181| #endif
182| 
183| #ifdef LS_UPDATE
184| 	reg(ic->arg[1]) = addr;
185| #endif
186| }
187| #endif
188| 
189| 
190| void LS_N(struct cpu *cpu, struct ppc_instr_call *ic)
191| {
192| #ifndef MODE32
193| 	/************************************************************/
194| 	/* For now, 64-bit access is done using the slow fallback.  */
195| 	if (!cpu->is_32bit) {
196| 		LS_GENERIC_N(cpu, ic);
197| 		return;
198| 	}
199| #endif
200| 
201| 
202| #ifdef MODE32
203| 	uint32_t addr =
204| #else
205| 	uint64_t addr =
206| #endif
207| 	    reg(ic->arg[1])
208| #ifdef LS_INDEXED
209| 	    + reg(ic->arg[2])
210| #else
211| #ifndef LS_IGNOREOFS
212| 	    + (int32_t)ic->arg[2]
213| #endif
214| #endif
215| 	    ;
216| 
217| 	unsigned char *page = cpu->cd.ppc.
218| #ifdef LS_LOAD
219| 	    host_load
220| #else
221| 	    host_store
222| #endif
223| 	    [addr >> 12];
224| #ifdef LS_UPDATE
225| 	uint32_t new_addr = addr;
226| #endif
227| 
228| #ifndef LS_B
229| 	if (addr & (LS_SIZE-1)) {
230| 		LS_GENERIC_N(cpu, ic);
231| 		return;
232| 	}
233| #endif
234| 
235| 	if (page == NULL) {
236| 		LS_GENERIC_N(cpu, ic);
237| 		return;
238| 	} else {
239| 		addr &= 4095;
240| #ifdef LS_LOAD
241| 		/*  Load:  */
242| #ifdef LS_B
243| 		reg(ic->arg[0]) =
244| #ifndef LS_ZERO
245| 		    (int8_t)
246| #endif
247| 		    page[addr];
248| #endif	/*  LS_B  */
249| #ifdef LS_H
250| 		reg(ic->arg[0]) =
251| #ifdef LS_BYTEREVERSE
252| 		    ((page[addr+1] << 8) + page[addr]);
253| #else
254| #ifndef LS_ZERO
255| 		    (int16_t)
256| #endif
257| 		    ((page[addr] << 8) + page[addr+1]);
258| #endif /* !BYTEREVERSE */
259| #endif	/*  LS_H  */
260| #ifdef LS_W
261| 		reg(ic->arg[0]) =
262| #ifdef LS_BYTEREVERSE
263| 		    ((page[addr+3] << 24) + (page[addr+2] << 16) +
264| 		    (page[addr+1] << 8) + page[addr]);
265| #else  /*  !LS_BYTEREVERSE  */
266| #ifndef LS_ZERO
267| 		    (int32_t)
268| #else
269| 		    (uint32_t)
270| #endif
271| 		    ((page[addr] << 24) + (page[addr+1] << 16) +
272| 		    (page[addr+2] << 8) + page[addr+3]);
273| #endif  /*  !LS_BYTEREVERSE  */
274| #endif	/*  LS_W  */
275| #ifdef LS_D
276| 		(*(uint64_t *)(ic->arg[0])) =
277| 		    ((uint64_t)page[addr+0] << 56) +
278| 		    ((uint64_t)page[addr+1] << 48) +
279| 		    ((uint64_t)page[addr+2] << 40) +
280| 		    ((uint64_t)page[addr+3] << 32) +
281| 		    ((uint64_t)page[addr+4] << 24) + (page[addr+5] << 16) +
282| 		    (page[addr+6] << 8) + page[addr+7];
283| #endif	/*  LS_D  */
284| 
285| #else	/*  !LS_LOAD  */
286| 
287| 		/*  Store:  */
288| #ifdef LS_B
289| 		page[addr] = reg(ic->arg[0]);
290| #endif
291| #ifdef LS_H
292| #ifdef LS_BYTEREVERSE
293| 		page[addr]   = reg(ic->arg[0]);
294| 		page[addr+1] = reg(ic->arg[0]) >> 8;
295| #else
296| 		page[addr]   = reg(ic->arg[0]) >> 8;
297| 		page[addr+1] = reg(ic->arg[0]);
298| #endif /* !BYTEREVERSE */
299| #endif
300| #ifdef LS_W
301| #ifdef LS_BYTEREVERSE
302| 		page[addr]   = reg(ic->arg[0]);
303| 		page[addr+1] = reg(ic->arg[0]) >> 8;
304| 		page[addr+2] = reg(ic->arg[0]) >> 16;
305| 		page[addr+3] = reg(ic->arg[0]) >> 24;
306| #else
307| 		page[addr]   = reg(ic->arg[0]) >> 24;
308| 		page[addr+1] = reg(ic->arg[0]) >> 16;
309| 		page[addr+2] = reg(ic->arg[0]) >> 8;
310| 		page[addr+3] = reg(ic->arg[0]);
311| #endif /* !LS_BYTEREVERSE  */
312| #endif
313| #ifdef LS_D
314| 		{ uint64_t x = *(uint64_t *)(ic->arg[0]);
315| 		page[addr]   = x >> 56;
316| 		page[addr+1] = x >> 48;
317| 		page[addr+2] = x >> 40;
318| 		page[addr+3] = x >> 32;
319| 		page[addr+4] = x >> 24;
320| 		page[addr+5] = x >> 16;
321| 		page[addr+6] = x >> 8;
322| 		page[addr+7] = x; }
323| #endif
324| #endif	/*  !LS_LOAD  */
325| 	}
326| 
327| #ifdef LS_UPDATE
328| 	reg(ic->arg[1]) = new_addr;
329| #endif
330| }
331| 
~~~~

**8.8 The table -- generated, committed, and what it holds.**  `src/cpus/generate_ppc_loadstore.c` (its loop order
fixes the index weights -- update 32, ignoreofs 16, load 8, zero 4, size 1 -- and `load && !zero && size == 3` is the
`invalid` slot):
~~~~
36| void do_it(int mode)
37| {
38| 	int n, load, size, zero, ignoreofs, update;
39| 
40| 	n = 0;
41| 	for (update=0; update<=1; update++)
42| 	  for (ignoreofs=0; ignoreofs<=1; ignoreofs++)
43| 	    for (load=0; load<=1; load++)
44| 		for (zero=0; zero<=1; zero++)
45| 		    for (size=0; size<4; size++) {
46| 			if (!zero && !load)
47| 				continue;
48| 			if (load && !zero && size == 3)
49| 				continue;
  ...
205| 	/*  Lookup tables for loads/stores:  */
206| 	printf("\n\nvoid (*ppc%s_loadstore[64])(struct cpu *, struct "
207| 	    "ppc_instr_call *) = {\n", modes[mode]);
208| 	n = 0;
209| 	for (update=0; update<=1; update++)
210| 	  for (ignoreofs=0; ignoreofs<=1; ignoreofs++)
211| 	    for (load=0; load<=1; load++)
212| 		for (zero=0; zero<=1; zero++)
213| 		    for (size=0; size<4; size++) {
214| 			printf("\tppc%s_instr_", modes[mode]);
215| 
216| 			if (load && !zero && size == 3) {
217| 				printf("invalid");
218| 				goto cont;
219| 			}
220| 
221| 			if (load)
222| 				printf("l");
223| 			else
224| 				printf("st");
225| 			printf("%s", sizechar[size]);
226| 			if (load && size < 3) {
227| 				if (zero)
228| 					printf("z");
229| 				else
230| 					printf("a");
231| 			}
232| 			if (update)
233| 				printf("u");
234| 			if (ignoreofs)
235| 				printf("_0");
236| cont:
237| 			if (++n < 64)
238| 				printf(",");
239| 			printf("\n");
240| 		    }
241| 
242| 	printf("};\n\n");
~~~~
