 318: def session(cmds, machine="bareppc", timeout=120):
 319:     """The piped cold-debugger session -- regress/ppc_rldicl_probe.py's idiom.
 320:        Returns (regs, pc, msr, unassemble lines, transcript, how, argv, CRs removed)."""
 321:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64", "0x%x:%s" % (CODE, DUMMY)]
