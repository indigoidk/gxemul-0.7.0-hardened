4105| 		struct DYNTRANS_L3_64_TABLE *l3 = l2->l3[x2];
4106| 		page = l3->host_load[x3];
4107| 	}
4108| #endif
4109| 
4110| 	if (page != NULL) {
4111| 		/*  fatal("TRANSLATION HIT!\n");  */
4112| 		memcpy(ib, page + (addr & 0xfff), sizeof(ib));
4113| 	} else {
4114| 		/*  fatal("TRANSLATION MISS!\n");  */
4115| 		if (!cpu->memory_rw(cpu, cpu->mem, addr, ib,
4116| 		    sizeof(ib), MEM_READ, CACHE_INSTRUCTION)) {
4117| 			fatal("PPC to_be_translated(): "
4118| 			    "read failed: TODO\n");
4119| 			exit(1);
4120| 			/*  goto bad;  */
4121| 		}
4122| 	}
4123| 
4124| 	{
4125| 		uint32_t *p = (uint32_t *) ib;
4126| 		iword = *p;
4127| 		iword = BE32_TO_HOST(iword);
4128| 	}
4129| 
4130| #define DYNTRANS_TO_BE_TRANSLATED_HEAD
4131| #include "cpu_dyntrans.c"
4132| #undef  DYNTRANS_TO_BE_TRANSLATED_HEAD
