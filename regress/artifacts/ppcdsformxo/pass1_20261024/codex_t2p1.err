1896| 		    addr & (DYNTRANS_PAGESIZE - 1));
1897| 	}
1898| 
1899| 	cpu->cd.DYNTRANS_ARCH.combination_check = NULL;
1900| 
1901| 	/*  An additional check, to catch some bugs:  */
