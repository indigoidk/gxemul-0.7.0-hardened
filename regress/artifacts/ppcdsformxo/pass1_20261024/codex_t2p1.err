**8.9 The disassembler -- its head, its load/store arm WHOLE, its common tail** (`src/cpus/cpu_ppc.c`; anchors
`mnem = "ld"; break;`, `mnem = "std"; break;`):
~~~~
599| int ppc_cpu_disassemble_instr(struct cpu *cpu, unsigned char *instr,
600| 	int running, uint64_t dumpaddr)
601| {
602| 	int hi6, xo, lev, rt, rs, ra, rb, imm, sh, me, rc, l_bit; //, oe_bit;
603| 	int spr, aa_bit, lk_bit, bf, bh, bi, bo, mb, nb, bt, ba, bb, fpreg;
604| 	int bfa, to, load, wlen, no_rb = 0;
605| 	uint64_t offset, addr;
606| 	uint32_t iword;
607| 	const char *symbol, *mnem = "ERROR";
608| 	int power = cpu->cd.ppc.mode == MODE_POWER;
609| 
610| 	if (running)
611| 		dumpaddr = cpu->pc;
612| 
613| 	symbol = get_symbol_name(&cpu->machine->symbol_context,
614| 	    dumpaddr, &offset);
615| 	if (symbol != NULL && offset==0)
616| 		debug("<%s>\n", symbol);
617| 
618| 	if (cpu->machine->ncpus > 1 && running)
619| 		debug("cpu%i: ", cpu->cpu_id);
620| 
621| 	if (cpu->cd.ppc.bits == 32)
622| 		debug("%08" PRIx32, (uint32_t) dumpaddr);
623| 	else
624| 		debug("%016" PRIx64, (uint64_t) dumpaddr);
625| 
626| 	/*  NOTE: Fixed to big-endian.  */
627| 	iword = ((uint32_t)instr[0] << 24) + (instr[1] << 16) + (instr[2] << 8)
628| 	    + instr[3];
629| 
630| 	debug(": %08" PRIx32, iword);
631| 
632| 	cpu_print_pc_indicator_in_disassembly(cpu, running, dumpaddr);
633| 
634| 
635| 	/*
636| 	 *  Decode the instruction:
637| 	 */
638| 
639| 	hi6 = iword >> 26;
640| 
641| 	switch (hi6) {
  ...
