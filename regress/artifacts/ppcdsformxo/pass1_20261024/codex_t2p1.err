4975| 			case PPC_31_STFDUX:size=3; fp=1; update=1;
4976| 					   ic->f = instr(stfdux); break;	/*  #310  */
4977| 			case PPC_31_STFSX: size=2; fp=1;
4978| 					   ic->f = instr(stfsx); break;
4979| 			case PPC_31_STFSUX:size=2; fp=1; update=1;
4980| 					   ic->f = instr(stfsux); break;	/*  #310  */
4981| 			}
4982| 			if (fp)
4983| 				ic->arg[0] = (size_t)(&cpu->cd.ppc.fpr[rs]);
4984| 			else
4985| 				ic->arg[0] = (size_t)(&cpu->cd.ppc.gpr[rs]);
4986| 			if (!byterev && ic->f == NULL) {
4987| 				ic->f =
4988| #ifdef MODE32
4989| 				    ppc32_loadstore_indexed
4990| #else
4991| 				    ppc_loadstore_indexed
4992| #endif
4993| 				    [size + 4*zero + 8*load + 16*update];
4994| 			}
4995| 			if (ra == 0 && update) {
4996| 				if (!cpu->translation_readahead)
4997| 					fatal("TODO: ra=0 && update?\n");
4998| 				goto bad;
4999| 			}
5000| 			break;
~~~~

**8.5 The tree's 32-bit idiom for a 64-bit-only instruction -- `rld*` (opcode 30):**
~~~~
4590| 		xo = (iword >> 2) & 7;
4591| 		switch (xo) {
4592| 
4593| 		case PPC_30_RLDICL:
4594| 		case PPC_30_RLDICR:
4595| 		case PPC_30_RLDIMI:
4596| 			switch (xo) {
4597| 			case PPC_30_RLDICL: ic->f = instr(rldicl); break;
4598| 			case PPC_30_RLDICR: ic->f = instr(rldicr); break;
4599| 			case PPC_30_RLDIMI: ic->f = instr(rldimi); break;
4600| 			}
4601| 			ic->arg[0] = iword;
4602| 			if (cpu->cd.ppc.bits == 32) {
4603| 				if (!cpu->translation_readahead)
4604| 					fatal("TODO: rld* in 32-bit mode?\n");
4605| 				goto bad;
4606| 			}
4607| 			break;
4608| 
4609| 		default:goto bad;
4610| 		}
~~~~

