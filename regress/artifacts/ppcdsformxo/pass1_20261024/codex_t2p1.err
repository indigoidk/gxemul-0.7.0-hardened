199| #endif
200| 
201| 
202| #ifdef MODE32
203| 	uint32_t addr =
204| #else
205| 	uint64_t addr =
206| #endif
207| 	    reg(ic->arg[1])
208| #ifdef LS_INDEXED
209| 	    + reg(ic->arg[2])
210| #else
211| #ifndef LS_IGNOREOFS
212| 	    + (int32_t)ic->arg[2]
213| #endif
214| #endif
215| 	    ;
216| 
217| 	unsigned char *page = cpu->cd.ppc.
218| #ifdef LS_LOAD
219| 	    host_load
220| #else
221| 	    host_store
222| #endif
223| 	    [addr >> 12];
224| #ifdef LS_UPDATE
225| 	uint32_t new_addr = addr;
226| #endif
227| 
228| #ifndef LS_B
229| 	if (addr & (LS_SIZE-1)) {
230| 		LS_GENERIC_N(cpu, ic);
231| 		return;
232| 	}
233| #endif
234| 
235| 	if (page == NULL) {
236| 		LS_GENERIC_N(cpu, ic);
237| 		return;
238| 	} else {
239| 		addr &= 4095;
240| #ifdef LS_LOAD
241| 		/*  Load:  */
242| #ifdef LS_B
243| 		reg(ic->arg[0]) =
244| #ifndef LS_ZERO
245| 		    (int8_t)
246| #endif
247| 		    page[addr];
248| #endif	/*  LS_B  */
249| #ifdef LS_H
250| 		reg(ic->arg[0]) =
251| #ifdef LS_BYTEREVERSE
252| 		    ((page[addr+1] << 8) + page[addr]);
253| #else
254| #ifndef LS_ZERO
255| 		    (int16_t)
256| #endif
257| 		    ((page[addr] << 8) + page[addr+1]);
258| #endif /* !BYTEREVERSE */
259| #endif	/*  LS_H  */
260| #ifdef LS_W
261| 		reg(ic->arg[0]) =
262| #ifdef LS_BYTEREVERSE
263| 		    ((page[addr+3] << 24) + (page[addr+2] << 16) +
264| 		    (page[addr+1] << 8) + page[addr]);
265| #else  /*  !LS_BYTEREVERSE  */
266| #ifndef LS_ZERO
267| 		    (int32_t)
268| #else
269| 		    (uint32_t)
270| #endif
271| 		    ((page[addr] << 24) + (page[addr+1] << 16) +
272| 		    (page[addr+2] << 8) + page[addr+3]);
273| #endif  /*  !LS_BYTEREVERSE  */
274| #endif	/*  LS_W  */
275| #ifdef LS_D
276| 		(*(uint64_t *)(ic->arg[0])) =
277| 		    ((uint64_t)page[addr+0] << 56) +
278| 		    ((uint64_t)page[addr+1] << 48) +
279| 		    ((uint64_t)page[addr+2] << 40) +
280| 		    ((uint64_t)page[addr+3] << 32) +
281| 		    ((uint64_t)page[addr+4] << 24) + (page[addr+5] << 16) +
282| 		    (page[addr+6] << 8) + page[addr+7];
283| #endif	/*  LS_D  */
284| 
285| #else	/*  !LS_LOAD  */
286| 
287| 		/*  Store:  */
288| #ifdef LS_B
289| 		page[addr] = reg(ic->arg[0]);
290| #endif
291| #ifdef LS_H
292| #ifdef LS_BYTEREVERSE
293| 		page[addr]   = reg(ic->arg[0]);
294| 		page[addr+1] = reg(ic->arg[0]) >> 8;
295| #else
296| 		page[addr]   = reg(ic->arg[0]) >> 8;
297| 		page[addr+1] = reg(ic->arg[0]);
298| #endif /* !BYTEREVERSE */
299| #endif
300| #ifdef LS_W
301| #ifdef LS_BYTEREVERSE
302| 		page[addr]   = reg(ic->arg[0]);
303| 		page[addr+1] = reg(ic->arg[0]) >> 8;
304| 		page[addr+2] = reg(ic->arg[0]) >> 16;
305| 		page[addr+3] = reg(ic->arg[0]) >> 24;
306| #else
307| 		page[addr]   = reg(ic->arg[0]) >> 24;
308| 		page[addr+1] = reg(ic->arg[0]) >> 16;
309| 		page[addr+2] = reg(ic->arg[0]) >> 8;
310| 		page[addr+3] = reg(ic->arg[0]);
311| #endif /* !LS_BYTEREVERSE  */
312| #endif
313| #ifdef LS_D
314| 		{ uint64_t x = *(uint64_t *)(ic->arg[0]);
315| 		page[addr]   = x >> 56;
316| 		page[addr+1] = x >> 48;
