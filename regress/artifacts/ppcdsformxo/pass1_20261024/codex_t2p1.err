360| def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
361|     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs.
362|        Returns (regs dict, disasm list, transcript, how)."""
363|     cmds = list(setup)
364|     for i, w in enumerate(insns):
365|         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
366|     if insns:
367|         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
368|     cmds.append("pc=0x%x" % CODE)
369|     if insns:
370|         cmds.append("step %d" % len(insns))
371|     cmds.append("reg")
372|     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
373|     if cpu:
374|         argv += ["-C", cpu]
375|     argv += ["0x%x:%s" % (CODE, DUMMY)]
376|     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
377|     try:
  ...
486| # The decoder sends rld* to `bad' when bits == 32.  Same session, same encoding,
487| # a 32-bit CPU: the instruction must NOT execute as rldicl.
488| b32regs, _, b32T, b32how = session(
489|     seed([(SRC, RS_VAL), (4, SENT), (9, SENT)]),
490|     [LI(9, 0x1234), RLDICL(4, SRC, 0, 32)], timeout=60, machine="bareppc",
491|     cpu="PPC603")
492| open("/tmp/ppc_rldicl_32.txt", "w").write(b32T)
493| row("bits32 live", hex(b32regs.get(9, -1)), hex(0x1234),
494|     "PPC603 (32-bit): the guest still runs -- li executes")
495| row("bits32 rld bad", "TODO" if "TODO: rld" in b32T else "no-msg", "TODO",
496|     "decoder prints `TODO: rld* in 32-bit mode?' and goes to bad -- unreachable")
~~~~

**9.6 The witness probe's `row()`: the `%-16s` column and the 15-character assert keep a gate's `^name  ` match
unambiguous** (`regress/artifacts/ppcdsformxo/witness_20261024/ppc_dsform_probe.py`):
~~~~
141| def row(name, got, want, note=""):
142|     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
143|     assert len(name) <= 15, name
144|     ok = (got == want)
145|     rows.append((name, ok))
146|     print("%-16s %-20s %-20s %-52s %s" % (name, str(got), str(want), note,
147|                                           "ok" if ok else "FAIL"))
148|     return ok
~~~~

