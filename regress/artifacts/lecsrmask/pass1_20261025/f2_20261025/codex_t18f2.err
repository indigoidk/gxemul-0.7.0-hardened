361: def build_rows(sess):
362:     """Return rows as (label, kind, got, want_head, want_fix, mode); mode 'eq' only."""
363:     rows = []
364:     for name, _ in SESSION_ORDER:
365:         g = sess.get(name, {}).get("ram")
366:         rows.append(("ram:%s" % name, "control", g, RAM_MAGIC, RAM_MAGIC, "eq"))
367:     c0 = sess.get("csr0", {})
368:     rows.append(("csr0 reset", "control", c0.get("reset"), 0x0004, 0x0004, "eq"))
369:     rows.append(("rap mask", "control", c0.get("rapmask"), 0x0003, 0x0003, "eq"))
370:     c3 = sess.get("csr3", {})
371:     rows.append(("csr3 all", "symptom", c3.get("all"), 0xffff, 0x0007, "eq"))
372:     rows.append(("csr3 bits", "control", c3.get("acc0"), 0x0005, 0x0005, "eq"))
373:     c2 = sess.get("csr2", {})
374:     rows.append(("csr2 all", "symptom", c2.get("all"), 0xffff, 0x00ff, "eq"))
375:     rows.append(("csr2 lo", "control", c2.get("acc0"), 0x00a5, 0x00a5, "eq"))
376:     c1 = sess.get("csr1", {})
377:     rows.append(("csr1 all", "symptom", c1.get("all"), 0xffff, 0xfffe, "eq"))
378:     rows.append(("csr1 odd", "symptom", c1.get("acc0"), 0x1235, 0x1234, "eq"))
379:     rows.append(("csr1 even", "control", c1.get("acc1"), 0x1236, 0x1236, "eq"))
380:     rows.append(("csr1 top", "control", c1.get("acc2"), 0x8000, 0x8000, "eq"))
381:     #  the last RDP value read a second time must equal the first read (a device that answers
382:     #  differently on two consecutive reads is not the stable register this probe assumes)
383:     for name, _ in SESSION_ORDER:
384:         s = sess.get(name, {})
385:         first = s.get("reset") if name == "csr0" else s.get("all")
386:         rows.append(("stable:%s" % name, "control", s.get("stable"), first, first, "eq"))
387:     return rows
