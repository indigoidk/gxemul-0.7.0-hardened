390: def row_ok(mode, got, want, column="HEAD"):
391:     if got is None or want is None:
392:         return False
393:     return got == want
394: 
395: 
396: def run_leg(leg, binary, column, out):
397:     out("-" * 86)
398:     out("LEG %s -- %s build, judged against the %s column" % (leg, leg, column))
399:     out("-" * 86)
400:     sess = {}
401:     enc_all = hit_all = True
402:     for name, builder in SESSION_ORDER:
403:         prog_list, halt_addr, regmap = builder()
404:         got, enc_ok, hit = run_session(binary, prog_list, halt_addr,
405:                                        os.path.join(RAWDIR, "%s_%s.bin" % (leg, name)),
406:                                        regmap, "%s_%s" % (leg, name), out)
407:         sess[name] = got
408:         enc_all = enc_all and enc_ok
409:         hit_all = hit_all and hit
410:     out("")
411:     out("  %-12s %-10s %-10s %-10s" % ("row", "got", "head", "fix"))
412:     npass = nfail = 0
413:     ctrl_ok = True
414:     for label, kind, got, wh, wf, mode in build_rows(sess):
415:         want = wh if column == "HEAD" else wf
416:         ok = row_ok(mode, got, want, column)
417:         npass += ok
418:         nfail += (not ok)
419:         if kind == "control" and not ok:
420:             ctrl_ok = False
421:         if kind == "symptom":
422:             out("  %-12s %-10s head %-8s fix %-8s [%s] %s"
423:                 % (label, show(got), show(wh), show(wf), column, "ok" if ok else "FAIL"))
424:         else:
425:             out("  %-12s %-10s want %-10s %s" % (label, show(got), show(want), "ok" if ok else "FAIL"))
426:     ntot = npass + nfail
427:     leg_ctrl = ctrl_ok and enc_all and hit_all
428:     out("")
429:     out("  %d/%d passed" % (npass, ntot))
430:     out("  CONTROL=%s" % ("PASS" if leg_ctrl else "FAIL"))

