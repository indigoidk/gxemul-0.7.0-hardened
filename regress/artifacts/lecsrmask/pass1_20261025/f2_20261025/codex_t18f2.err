835:  *  le_register_write():
836:  *
837:  *  This function is called when the value 'x' is written to register 'r'.
838:  */
839: void le_register_write(struct le_data *d, int r, uint32_t x)
840: {
841: 	switch (r) {
842: 	case 0:	/*  CSR0:  */
843: 		/*  Some bits are write-one-to-clear:  */
844: 		if (x & LE_BABL)
845: 			d->reg[r] &= ~LE_BABL;
846: 		if (x & LE_CERR)
847: 			d->reg[r] &= ~LE_CERR;
848: 		if (x & LE_MISS)
849: 			d->reg[r] &= ~LE_MISS;
850: 		if (x & LE_MERR)
851: 			d->reg[r] &= ~LE_MERR;
852: 		if (x & LE_RINT)
853: 			d->reg[r] &= ~LE_RINT;
854: 		if (x & LE_TINT)
855: 			d->reg[r] &= ~LE_TINT;
856: 		if (x & LE_IDON)
857: 			d->reg[r] &= ~LE_IDON;
858: 
859: 		/*  Some bits are write-only settable, not clearable:  */
860: 		if (x & LE_TDMD)
861: 			d->reg[r] |= LE_TDMD;
862: 		if (x & LE_STRT) {
863: 			d->reg[r] |= LE_STRT;
864: 			d->reg[r] &= ~LE_STOP;
865: 		}
866: 		if (x & LE_INIT) {
867: 			if (!(d->reg[r] & LE_STOP))
868: 				debugmsg(d->subsys, "register write", VERBOSITY_WARNING,
869: 				    "attempt to INIT before STOPped!");
870: 			d->reg[r] |= LE_INIT;
871: 			d->reg[r] &= ~LE_STOP;
872: 		}
873: 		if (x & LE_STOP) {
874: 			d->reg[r] |= LE_STOP;
875: 			/*  STOP takes precedence over STRT and INIT:  */
876: 			d->reg[r] &= ~(LE_STRT | LE_INIT);
877: 		}
878: 
879: 		/*  Some bits get through, both settable and clearable:  */
880: 		d->reg[r] &= ~LE_INEA;
881: 		d->reg[r] |= (x & LE_INEA);
882: 		break;
883: 
884: 	default:
885: 		/*  CSR1, CSR2, and CSR3:  */
886: 		d->reg[r] = x;
887: 	}
888: }
