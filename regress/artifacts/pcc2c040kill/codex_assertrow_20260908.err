   65| // #define	debug fatal
   66| 
   67| /*  pcc2widthkills: TWELVE width-guard blocks in DEVICE_ACCESS(pcc2) -- TEN of them
   68|     `fatal(); exit(1)' kills that ended the host on a guest-chosen access width, and
   69|     two (IPL, MASK) #119 warn-once latches that declined it process-globally -- an ordinary aligned halfword load of a documented
   70|     register.  Same class as #337 (dev_wdc.c) and #497 (dev_sgi_re.c).
   71| 
   72|     THE TREE ALREADY KNEW THE WIDTH IS LEGAL: mvme_pcctworeg.h says the PCCchip2
   73|     registers "can be accessed as bytes (8 bits), two-bytes (16 bits), or four-bytes
   74|     (32 bits)".  So this is not a fault to model; it is an access the model declines
   75|     to IMPLEMENT on one side and already implements on the other:
   76| 
   77|       READS   are served BEFORE the switch by memcpy(data, pcctwo_reg + addr, len),
   78|               raw bytes in address order -- width-correct by construction.  The old
   79|               guard discarded a correct answer.  Now: ACCEPT (fall through).
   80|       WRITES  ten of the twelve arms use `idata', the composed value (SCCERR stores a
   81|               constant and IPL ignores it; both decline too -- a wide write's other
   82|               lanes have no home), and `idata' is "the addressed
   83|               byte" ONLY at len == 1: memory_readmax64 composes big-endian, so
   84|               (uint8_t) idata is the HIGHEST-address lane.  Deleting the guard would
   85|               store the neighbour's byte -- st.h 0xAABB to GENCTL would set GENCTL to
   86|               0xBB, VECBASE's lane.  And eight arms mask, read-modify-write or clear
   87|               on write, and seven of the twelve blocks call reassert_interrupts()
   88|               (five of those eight; a seat measured the earlier "six" wrong).  Now: DECLINE +
   89|               latched announce.  Per-lane composition through each arm (COMPOSE) is
   90|               the faithful upgrade and is FILED as pcc2widecompose; not taken here
   91|               because the hardware's lane semantics are not on disk and no driver
   92|               MEASUREMENT exists either way: the only consumer is mvme187, no mvme187
   93|               boot runs in this harness, and the one OS source in the tree (OpenBSD
   94|               2.2) declares these registers `volatile u_char' and byte-accesses them
   95|               -- a reading, not a measurement.
   96| 
   97|     ONE BIT PER BLOCK, twelve, per instance: a driver bringing up the chip touches
   98|     several of these in one pass, and one latch would announce the first and silence
   99|     the rest (#497's own reasoning).  Auto-incremented rather than `1 << N' literals,
  100|     which this fork records as collision-prone; PCC2_W_NBITS names the count, and the
  101|     typedef after the enum makes the build fail if it ever exceeds the 32-bit field.
  102| 
  103|     REACHABILITY, verified: every non-byte m88k access is alignment-checked BEFORE
  104|     memory_rw, and `relative_addr %= PCC2_SIZE' keeps parity, so only the SIX
  105|     EVEN-offset blocks (GENCTL, TxCTL, TxICR, SCCERR, SCCTX, IPL) are GUEST-reachable
  106|     (this said "five" until pass 2; IPL at 0x3e is even, and a seat counted); the
  107|     eight odd OFFSETS -- the six odd-only blocks VECBASE, PSCALEADJ, SCCICR, SCCRX,
  108|     SCSIICR, MASK, plus the T1CTL/T1ICR labels of the shared TxCTL/TxICR blocks --
  109|     are OPERATOR-reachable -- the debugger's `put h' warns on a
  110|     misaligned address and stores anyway, MEASURED (artifacts/pcc2widthkills/
  111|     operator_reach_20260903.out: `put h 0xfff42003' ended the host).  All twelve are
  112|     converted; the detector reaches the odd ones through that path.
  113| 
  114|     NOT FIXED HERE, cited so "twelve kills removed" is not read as "file clean":
  115|     pcc2c040kill (a LEGAL byte write of 0x04 to GENCTL still ends the host in
  116|     reassert_interrupts).  pcc2defaultkill -- an unlisted offset ended it -- was
  117|     fixed by #501 (the default: arm below); this sentence said "still ends it"
  118|     until #501's pass 4 (Opus).  */
  119| enum {
  120| 	PCC2_W_GENCTL_LEN,
  121| 	PCC2_W_VECBASE_LEN,
  122| 	PCC2_W_PSCALEADJ_LEN,
  123| 	PCC2_W_TXCTL_LEN,	/*  one block serves T1CTL and T2CTL  */
  124| 	PCC2_W_TXICR_LEN,	/*  one block serves T1ICR and T2ICR  */
  125| 	PCC2_W_SCCERR_LEN,
  126| 	PCC2_W_SCCICR_LEN,
  127| 	PCC2_W_SCCTX_LEN,
  128| 	PCC2_W_SCCRX_LEN,
  129| 	PCC2_W_SCSIICR_LEN,
  130| 	PCC2_W_IPL_LEN,		/*  was a #119 function-static: process-global  */
  131| 	PCC2_W_MASK_LEN,	/*  was a #119 function-static: process-global  */
  132| 	PCC2_W_C040,		/*  #512: not a _LEN -- the C040 delivery decline  */
  133| 	PCC2_W_NBITS
  134| };
  135| 
  136| struct pcc2_data {
  137| 	struct interrupt	cpu_irq;
  138| 
  139| 	uint8_t			pcctwo_reg[PCC2_SIZE];
  140| 
  141| 	/*  pcc2widthkills: one bit per width-guard block, see the enum.  Zeroed by
  142| 	    the init memset, so every instance starts with every announce armed.  */
  143| 	uint32_t		warned;
  144| 	/*  #501: one bit per BYTE OFFSET (0..0x3f) for the default: arm's announce;
  145| 	    relative_addr is folded to PCC2_SIZE above the switch, so the shift is
  146| 	    always defined.  Zeroed by the same memset.  */
  147| 	uint64_t		warned_unimpl;
  148| 
  149| 	uint8_t			cur_int_vec[8];
  150| 
  151| 	/*  Timers:  */
  152| 	struct timer		*timer;
  153| 	int			pending_timer1_interrupts;
  154| 	int			pending_timer2_interrupts;
  155| };
  156| /*  pcc2widthkills: the enum must fit the field.  A seat pointed out that a bare
  157|     `<= 32' tested a literal, not the field, so narrowing `warned' would compile
  158|     silently; this is dev_dreamcast_gdrom.c's own form.  Negative array size is a
  159|     compile-time error, C99, no assert.h.  */
  160| typedef char pcc2_w_fits_in_warned[(PCC2_W_NBITS <= 8 * sizeof(((struct pcc2_data *)0)->warned)
  161|     && PCC2_W_NBITS <= 8 * sizeof(1u)) ? 1 : -1];
  162| 
  163| 
  164| static uint32_t read32(unsigned char *p)
  165| {
  166| 	uint32_t x = 0;
  167| 	size_t i;
  168| 
  169| 	for (i=0; i<sizeof(x); i++) {
  170| 		x <<= 8;
  171| 		x |= p[i];
  172| 	}
  173| 
  174| 	return x;
  175| }
  176| 
  177| 
  178| static void write32(unsigned char *p, uint32_t x)
  179| {
  180| 	size_t i;
  181| 
  182| 	for (i=0; i<sizeof(x); i++) {
  183| 		p[sizeof(x) - 1 - i] = x;
  184| 		x >>= 8;
  185| 	}
  186| }
  187| 
  188| 
  189| static void pcc_timer_tick(struct timer *t, void *extra)
  190| {
  191| 	struct pcc2_data *d = (struct pcc2_data *) extra;
  192| 
  193| 	/*  The PCC2 timers run at 1 MHz.  */
  194| 	int steps = (int) (1000000.0 / PCC_TIMER_TICK_HZ);
  195| 
  196| 	uint32_t count1, count2, compare1, compare2;
  197| 	int interrupt1 = 0, interrupt2 = 0;
  198| 
  199| 	/*  Read values:  */
  200| 	count1 = read32(&d->pcctwo_reg[PCCTWO_T1COUNT]);
  201| 	count2 = read32(&d->pcctwo_reg[PCCTWO_T2COUNT]);
  202| 	compare1 = read32(&d->pcctwo_reg[PCCTWO_T1CMP]);
  203| 	compare2 = read32(&d->pcctwo_reg[PCCTWO_T2CMP]);
  204| 
  205| 	/*  Timer enabled? Then count...  */
  206| 	if (d->pcctwo_reg[PCCTWO_T1CTL] & PCC2_TCTL_CEN) {
  207| 		uint32_t old_count1 = count1;
  208| 		count1 += steps;
  209| 
  210| 		/*  Did we pass the compare value?  */
  211| 		if ((old_count1 < compare1 && count1 >= compare1) ||
  212| 		    (old_count1 < compare1 && count1 < old_count1)) {
  213| 			interrupt1 = 1;
  214| 
  215| 			if (d->pcctwo_reg[PCCTWO_T1CTL] & PCC2_TCTL_COC) {
  216| 				while (count1 >= compare1) {
  217| 					count1 -= compare1;
  218| 					interrupt1 ++;
  219| 				}
  220| 				interrupt1 --;
  221| 			}
  222| 		}
  223| 
  224| 		/*  Overflow?  */
  225| 		if ((int32_t) old_count1 >= 0 && (int32_t) count1 < 0) {
  226| 			int oc = 1 + (d->pcctwo_reg[PCCTWO_T1CTL] >> 4);
  227| 			d->pcctwo_reg[PCCTWO_T1CTL] &= ~PCC2_TCTL_OVF;
  228| 			d->pcctwo_reg[PCCTWO_T1CTL] |= (oc << 4);
  229| 		}
  230| 	}
  231| 
  232| 	/*  ... and the same for timer 2:  */
  233| 	if (d->pcctwo_reg[PCCTWO_T2CTL] & PCC2_TCTL_CEN) {
  234| 		uint32_t old_count2 = count2;
  235| 		count2 += steps;
  236| 
  237| 		if ((old_count2 < compare2 && count2 >= compare2) ||
  238| 		    (old_count2 < compare2 && count2 < old_count2)) {
  239| 			interrupt2 = 1;
  240| 			if (d->pcctwo_reg[PCCTWO_T2CTL] & PCC2_TCTL_COC) {
  241| 				while (count2 >= compare2) {
  242| 					count2 -= compare2;
  243| 					interrupt2 ++;
  244| 				}
  245| 				interrupt2 --;
  246| 			}
  247| 		}
  248| 
  249| 		if ((int32_t) old_count2 >= 0 && (int32_t) count2 < 0) {
  250| 			int oc = 1 + (d->pcctwo_reg[PCCTWO_T2CTL] >> 4);
  251| 			d->pcctwo_reg[PCCTWO_T2CTL] &= ~PCC2_TCTL_OVF;
  252| 			d->pcctwo_reg[PCCTWO_T2CTL] |= (oc << 4);
  253| 		}
  254| 	}
  255| 
  256| 	/*  Should we cause interrupts?  */
  257| 	if (interrupt1 && d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_IEN)
  258| 		d->pending_timer1_interrupts += interrupt1;
  259| 	if (interrupt2 && d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_IEN)
  260| 		d->pending_timer2_interrupts += interrupt2;
  261| 
  262| 	/*  Write back values:  */
  263| 	write32(&d->pcctwo_reg[PCCTWO_T1COUNT], count1);
  264| 	write32(&d->pcctwo_reg[PCCTWO_T2COUNT], count2);
  265| }
  266| 
  267| 
  268| static void reassert_interrupts(struct pcc2_data *d)
  269| {
  270| 	int assert = 0;
  271| 
  272| 	/*  #512: the C040 test used to sit HERE and was a fatal()+exit(1), so one
  273| 	    legal guest byte write of 0x04 to GENCTL ended the host.  It now lives
  274| 	    beside the MIEN test at the foot of this function, where declining to
  275| 	    assert does not skip the recalculation below.  */
  276| 
  277| 	/*
  278| 	 *  Recalculate current interrupt level:
  279| 	 */
  280| 	d->pcctwo_reg[PCCTWO_IPL] = 0;
  281| 
  282| 	/*  Timer interrupts?  */
  283| 	if (d->pending_timer1_interrupts > 0 &&
  284| 	    d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_IEN)
  285| 		d->pcctwo_reg[PCCTWO_T1ICR] |= PCC2_TTIRQ_INT;
  286| 	if (d->pending_timer2_interrupts > 0 &&
  287| 	    d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_IEN)
  288| 		d->pcctwo_reg[PCCTWO_T2ICR] |= PCC2_TTIRQ_INT;
  289| 
  290| 	if (d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_INT) {
  291| 		int intlevel = d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_IL;
  292| 		d->cur_int_vec[intlevel] = PCC2V_TIMER1;
  293| 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
  294| 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
  295| 	}
  296| 	if (d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_INT) {
  297| 		int intlevel = d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_IL;
  298| 		d->cur_int_vec[intlevel] = PCC2V_TIMER2;
  299| 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
  300| 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
  301| 	}
  302| 
  303| 	if (d->pcctwo_reg[PCCTWO_SCCTX] & PCC2_IRQ_IEN &&
  304| 	    d->pcctwo_reg[PCCTWO_SCCTX] & PCC2_IRQ_INT) {
  305| 		int intlevel = d->pcctwo_reg[PCCTWO_SCCTX] & PCC2_IRQ_IPL;
  306| 		d->cur_int_vec[intlevel] = PCC2V_SCC_TX;
  307| 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
  308| 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
  309| 	}
  310| 
  311| 	if (d->pcctwo_reg[PCCTWO_SCCRX] & PCC2_IRQ_IEN &&
  312| 	    d->pcctwo_reg[PCCTWO_SCCRX] & PCC2_IRQ_INT) {
  313| 		int intlevel = d->pcctwo_reg[PCCTWO_SCCRX] & PCC2_IRQ_IPL;
  314| 		d->cur_int_vec[intlevel] = PCC2V_SCC_RX;
  315| 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
  316| 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
  317| 	}
  318| 
  319| 	if (d->pcctwo_reg[PCCTWO_SCSIICR] & PCC2_IRQ_IEN &&
  320| 	    d->pcctwo_reg[PCCTWO_SCSIICR] & PCC2_IRQ_INT) {
  321| 		int intlevel = d->pcctwo_reg[PCCTWO_SCSIICR] & PCC2_IRQ_IPL;
  322| 		d->cur_int_vec[intlevel] = PCC2V_SCSI;
  323| 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
  324| 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
  325| 	}
  363| 	    ... in the SCSI Interrupt Control Register"; the Interrupt Priority  364| 	    Level Register page adds that IPL2-IPL0 "always reflect the encoded
  365| 	    request level".  So C040 selects the DELIVERY PIN and not the level,
  366| 	    which is why the recalculation above must stay.  MIEN, by contrast,
  367| 	    disables "both the EIPL* pins and the INT pin" -- so the two tests are
  368| 	    siblings gating one output, not a nest.  */
  369| 	if (d->pcctwo_reg[PCCTWO_GENCTL] & PCC2_C040) {
  370| 		if (!(d->warned & (1u << PCC2_W_C040))) {
  371| 			d->warned |= (1u << PCC2_W_C040);
  372| 			fatal("[ pcc2: C040 (MC68040 EIPL) interrupt delivery not "
  373| 			    "implemented; assertion suppressed  (once) ]\n");
  374| 		}
  375| 		assert = 0;
  376| 	}
  377| 
  378| 	if (assert)
  379| 		INTERRUPT_ASSERT(d->cpu_irq);
  380| 	else
  381| 		INTERRUPT_DEASSERT(d->cpu_irq);
  382| }
  383| 
  384| 
  385| void pcctwo_interrupt_common(struct interrupt *interrupt, int assert)
  386| {
  387| 	struct pcc2_data *d = (struct pcc2_data *) interrupt->extra;
  388| 
  389| 	switch (interrupt->line) {
  390| 
  391| 	case PCC2V_SCSI:
  392| 		if (assert)
  393| 			d->pcctwo_reg[PCCTWO_SCSIICR] |= PCC2_IRQ_INT;
  394| 		else
  395| 			d->pcctwo_reg[PCCTWO_SCSIICR] &= ~PCC2_IRQ_INT;
  396| 		break;
  397| 
  398| 	case PCC2V_SCC_TX:
  399| 		if (assert)
  400| 			d->pcctwo_reg[PCCTWO_SCCTX] |= PCC2_IRQ_INT;
  401| 		else
  402| 			d->pcctwo_reg[PCCTWO_SCCTX] &= ~PCC2_IRQ_INT;
  403| 		break;
  404| 
  405| 	case PCC2V_SCC_RX:
  406| 		if (assert)
  407| 			d->pcctwo_reg[PCCTWO_SCCRX] |= PCC2_IRQ_INT;
  408| 		else
  409| 			d->pcctwo_reg[PCCTWO_SCCRX] &= ~PCC2_IRQ_INT;
  410| 		break;
  411| 
  412| 	default:fatal("[ pcctwo_interrupt_common: TODO: line = %i ]\n",
  413| 		    interrupt->line);
  414| 		exit(1);
  415| 	}
  416| 
  417| 	reassert_interrupts(d);
  418| }
  419| 
  420| 
  421| static void pcctwo_interrupt_assert(struct interrupt *interrupt)
  422| {
  423| 	pcctwo_interrupt_common(interrupt, 1);
  424| }
  425| static void pcctwo_interrupt_deassert(struct interrupt *interrupt)
  426| {
  427| 	pcctwo_interrupt_common(interrupt, 0);
  428| }
  429| 
  430| 
  431| DEVICE_TICK(pcc2)
  432| {
  433| 	struct pcc2_data *d = (struct pcc2_data *) extra;
  434| 	reassert_interrupts(d);
  435| }
  436| 
  437| 
  438| /*  pcc2widthkills: decline a wide WRITE to a byte register, announcing once per
  439|     block per instance.  The caller `break's after this; the read side of the same
  440|     block never reaches here.  */
  441| static void pcc2_width_decline(struct pcc2_data *d, int bit, const char *name, int len)
  442| {
  443| 	if (!(d->warned & (1u << bit))) {
  444| 		d->warned |= (1u << bit);
  445| 		fatal("[ pcc2: unimplemented len=%i write to %s -- declined."
  446| 		    "  (once) ]\n", len, name);
  447| 	}
  448| }
  449| 
  450| DEVICE_ACCESS(pcc2)
  451| {
  452| 	uint64_t idata = 0;
  453| 	struct pcc2_data *d = (struct pcc2_data *) extra;
  454| 
  455| 	/*  0xfff42000..0xfff42fff, but only 0x40 unique registers:  */
  456| 	relative_addr %= PCC2_SIZE;
  457| 
  458| 	if (writeflag == MEM_WRITE)
  459| 		idata = memory_readmax64(cpu, data, len);
  460| 
  461| 	if (writeflag == MEM_READ) {
  462| 		if (relative_addr + len <= PCC2_SIZE)	/* OB-11: end-span */
  463| 			memcpy(data, d->pcctwo_reg + relative_addr, len);
  464| 		else {
  465| 			static int warned = 0;	/* #119: loud-once (course-correction) */
  466| 			if (!warned) {
  467| 				fatal("[ pcc2: read 0x%x+%i beyond reg space 0x%x; "
  468| 				    "zero-filled ]\n", (int)relative_addr, (int)len,
  469| 				    (int)PCC2_SIZE);
  470| 				warned = 1;
  471| 			}
  472| 			memset(data, 0, len);	/* OB-11b: don't leak uninit host memory */
  473| 		}
  474| 	}
  475| 
  476| 	switch (relative_addr) {
  477| 
  478| 	case PCCTWO_CHIPID:
  479| 	case PCCTWO_CHIPREV:
  480| 		if (writeflag == MEM_WRITE) {
  481| 			fatal("[ IGNORING write to read-only PCCTWO_CHIPID/"
  482| 			    "CHIPREV register ]\n");
  483| 		}
  484| 		break;
  485| 
  486| 	case PCCTWO_GENCTL:
  487| 		if (len != 1 && writeflag == MEM_WRITE) {
  488| 			pcc2_width_decline(d, PCC2_W_GENCTL_LEN, "PCCTWO_GENCTL", len);
  489| 			break;
  490| 		}

