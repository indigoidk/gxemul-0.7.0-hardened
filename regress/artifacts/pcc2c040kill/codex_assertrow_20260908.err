    1| #!/usr/bin/env python3
    2| #
    3| #  pcc2c040kill -- RUNG-3 WITNESS: ONE legal guest byte store ends the host.
    4| #
    5| #  THE DEFECT.  `dev_pcc2.c', in `reassert_interrupts()':
    6| #
    7| #      fatal("pcc2: C040 interrupt assertions... TODO\n");        (:275)
    8| #      exit(1);
    9| #
   10| #  The C040 test is the FIRST thing in that helper.  `PCCTWO_GENCTL' is offset 0x02, `PCC2_C040'
   11| #  is 0x04, `pcctwo_reg[]' is `uint8_t[]', and the register resets to 0x00.  **The GENCTL byte-write
   12| #  arm stores `idata' UNMASKED and then calls the helper in the same access** -- so a single legal
   13| #  `st.b' of 0x04 terminates the emulator on the spot.  No second access, no driver, no interrupt.
   14| #
   15| #  *** THAT ONE-ACCESS READING IS A CORRECTION, NOT THE ORIGINAL FINDING. ***  This row was filed
   16| #  around a longer road -- an SCCRXIACK load running the same helper, reachable from OpenBSD's `cl.c'
   17| #  console driver -- and a codex pass-1 audit found the short one: *"the GENCTL write itself
   18| #  immediately calls the terminating helper.  Arming and termination occur within that access;
   19| #  subsequent SCC traffic is unnecessary."*  The long road is real and SUPERFLUOUS; nobody had
   20| #  noticed the short one because the long one was interesting.
   21| #
   22| #  ---------------------------------------------------------------------------------------------
   23| #  DESIGN REVIEWED BY grok (regress/artifacts/pcc2c040kill/grok_witness_20260907.txt), which
   24| #  REFUSED the first proposal: *"A guest `st.b' of 0x04 at GENCTL is a sound CORE of a rung-3
   25| #  witness of this kill.  Survival-only, in `pcc2_width_probe.py', with no same-decode preset and no
   26| #  site-attribution, is not.  That is the same class as the design you asked me to assume: the
   27| #  observation is either destroyed by the defect, or it reports success while measuring nothing."*
   28| #
   29| #  All three of its requirements are built in:
   30| #
   31| #    1.  A SAME-DECODE PRESET that must SURVIVE.  grok supplied it: *"`acc all' already writes 0x10
   32| #        to GENCTL and survives.  That is the negative control.  It is not the witness."*  So the
   33| #        control writes 0x10 through the identical instruction, register and width.
   34| #    2.  SITE ATTRIBUTION.  The kill text is unique in the tree, so a death here cannot be confused
   35| #        with a death anywhere else.
   36| #    3.  NOT bolted into `pcc2_width_probe.py'.  That is a 113 KB SHIPPED detector whose scores are
   37| #        recorded; adding rows perturbs them.  Separate file, scaffolding COPIED.
   38| #
   39| #  *** THE session() BELOW IS COPIED VERBATIM AND MUST NOT BE REIMPLEMENTED. ***  grok's pitfall #8,
   40| #  measured on this exact machine: *"Hand-rolled prompt wait -- death reads as SURVIVED."*  The
   41| #  copied version reaps the child and reports `how' (exit1 / sigN), which is what makes "died" a
   42| #  measurement rather than a timeout.
   43| #
   44| #  OTHER PITFALLS IT ENUMERATED, all avoided here:
   45| #    *  a debugger `put b' does NOT reproduce this -- the store must be a GUEST `st.b' (S2);
   46| #    *  `-e 187' is not the subtype: everything dies and survival-only would score the defect on a
   47| #       machine that never constructed.  The subtype is `mvme187';
   48| #    *  CHIPREV (0x01) and VECBASE (0x03) have no C040 path, so an off-by-one in the offset silently
   49| #       tests nothing;
   50| #    *  a post-fix GENCTL readback of 0 proves nothing: unmapped reads are also 0.
   51| #
   52| #  *** CONTRACT. ***  This witnesses THIS `exit(1)' and is NOT a detector of the repair: the
   53| #  adjudicated disposition is DECLINE + LATCHED ANNOUNCE, and "host survives" would green for a
   54| #  silent decline, a latched one, and a real C040 implementation alike.  A fix round owes a row that
   55| #  discriminates them -- for the latched form, the announce text and its once-only property are the
   56| #  available channel.
   57| #
   58| #  Usage:  pcc2_c040_probe.py <gxemul-binary> [label]
   59| import os, pty, re, select, sys, time
   60| BIN = sys.argv[1] if len(sys.argv) > 1 else "build/gxemul"
   61| LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
   62| DUMMY = "/tmp/pcc2_c040_dummy.bin"      #  own name: never share a scratch path with the
   63| open(DUMMY, "wb").write(bytes(4))       #  shipped width probe.  bytes(4), not an
   64|                                         #  escape: this line cooked once already.
   65| 
   66| CODE = 0x00010000
   67| SCRATCH = 0x00020000
   68| PCC2 = 0xfff42000
   69| GENCTL, T2CTL, T2ICR, SCCERR, SCCTX = 0x02, 0x16, 0x1a, 0x1c, 0x1e
   70| def enc(op26, rd, rs1, imm):
   71|     return (op26 << 26) | (rd << 21) | (rs1 << 16) | (imm & 0xffff)
   72| 
   73| 
   74| #  r2 = PCC2 base, r3 = scratch, r4 = load target, r5 = store source, r6 = second source
   75| #  ld.b / ld.h (0x07 / 0x06) SIGN-EXTEND: 0x82 would print as 0xffffff82.  Every row that
   76| #  asserts a VALUE uses the unsigned forms ld.bu / ld.hu (0x03 / 0x02); the survival rows
   77| #  only check exit status and keep the signed forms.
   78| def LD_B(rd, off): return enc(0x07, rd, 2, off)
   79| def LD_H(rd, off): return enc(0x06, rd, 2, off)
   80| def LD_BU(rd, off): return enc(0x03, rd, 2, off)
   81| def LD_HU(rd, off): return enc(0x02, rd, 2, off)
   82| def LD_W(rd, off): return enc(0x05, rd, 2, off)
   83| def ST_B(rs, off): return enc(0x0b, rs, 2, off)
   84| def ST_H(rs, off): return enc(0x0a, rs, 2, off)
   85| def ST_W(rs, off): return enc(0x09, rs, 2, off)
   86| I_ST_SCR = enc(0x09, 5, 3, 0)          # st  r5,r3,0   scratch word
   87| I_LD_SCR = enc(0x05, 4, 3, 0)          # ld  r4,r3,0
   88| I_BR_SELF = 0xc0000000
   89| SENTINEL = 0xdeadbeef
   90| rows = []
   91| 
   92| def row(name, got, want, note=""):
   93|     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
   94|     assert len(name) <= 15, name    # load-bearing for gate_arm.sh: `%-16s' plus a literal space keep its `^$v  .*ok$' pattern satisfiable (pass 9, Opus)
   95|     ok = (got == want)
   96|     rows.append((name, ok))
   97|     print("%-16s %-12s %-12s %-46s %s" % (name, str(got), str(want), note,
   98|                                           "ok" if ok else "FAIL"))
   99|     return ok
  100| 
  101| def session(cmds, settle=1.5, spin=1.2):
  102|     pid, fd = pty.fork()
  103|     if pid == 0:
  104|         os.execv(BIN, [BIN, "-V", "-x", "-E", "mvme88k", "-e", "mvme187", "-M", "64",
  105|                        "0x10000:" + DUMMY])
  106|         os._exit(127)
  107|     buf = ""
  108| 
  109|     def rd(t, until=None):
  110|         #  drain the pty for t seconds; with `until', return as soon as that text has
  111|         #  arrived (pass 7: a fixed drain after `continue' could send the next command to a
  112|         #  guest that had not reached its breakpoint yet).
  113|         nonlocal buf
  114|         end = time.time() + t
  115|         while time.time() < end:
  116|             if until is not None and until in buf:
  117|                 return True
  118|             r, _, _ = select.select([fd], [], [], 0.1)
  119|             if not r:
  120|                 continue
  121|             try:
  122|                 d = os.read(fd, 65536)
  123|                 if not d:
  124|                     return False
  125|                 buf += d.decode("latin-1", "replace")
  126|             except OSError:
  127|                 return False
  128|         if until is not None and until in buf:    # pass 9 (codex): the token may land in the last read
  129|             return True
  130|         return "timeout" if until is not None else True
  131| 
  132|     alive = rd(settle)
  133|     how = "nostatus"
  134|     for i, c in enumerate(cmds):
  135|         w = spin if i == len(cmds) - 1 else 0.25
  136|         until = None
  137|         if isinstance(c, tuple):    # (cmd, wait[, until]): `continue' waits for its breakpoint
  138|             until = c[2] if len(c) > 2 else None    # read the tuple BEFORE unpacking it
  139|             c, w = c[0], c[1]
  140|         try:
  141|             #  the one unbounded call left (pass 9, Opus): it blocks only if the pty input buffer fills
  142|             #  while the guest free-runs -- tens of bytes per command against a kilobyte buffer.
  143|             os.write(fd, (c + "\n").encode("latin-1"))
  144|         except OSError:
  145|             alive = False
  146|             break
  147|         r = rd(w, until)
  148|         if r is False:
  149|             alive = False
  150|             break
  151|         if r == "timeout":
  152|             #  pass 8 (codex, grok): the guest never reached its breakpoint -- send it nothing
  153|             #  more, and let every row of this session say so through cval().
  154|             how = "no-breakpoint"
  155|             break
  156|     try:
  157|         os.write(fd, b"quit\n")
  158|         rd(0.4)
  159|     except OSError:
  160|         pass
  161|     try:
  162|         os.close(fd)
  163|     except OSError:
  164|         pass
  165|     how = how if how == "no-breakpoint" else "nostatus"
  166|     #  pass 7: a guest still running (no breakpoint reached) would block waitpid forever;
  167|     #  give it a moment after the pty closed, then kill it -- the row says so, the gate
  168|     #  does not hang.
  169|     stat = None
  170|     reaped = False
  171|     for _ in range(30):
  172|         try:
  173|             p, stat = os.waitpid(pid, os.WNOHANG)
  174|         except OSError:
  175|             p, stat = pid, None
  176|         if p:
  177|             reaped = True
  178|             break
  179|         time.sleep(0.1)
  180|     if not reaped:
  181|         try:
  182|             os.kill(pid, 9)
  183|         except OSError:
  184|             pass
  185|         how = how if how == "no-breakpoint" else "killed"
  186|         for _ in range(30):    # pass 8 (Opus F2): reap the killed child, bounded
  187|             try:
  188|                 p, stat = os.waitpid(pid, os.WNOHANG)
  189|             except OSError:
  190|                 p, stat = pid, None
  191|             if p:
  192|                 reaped = True
  193|                 break
  194|             time.sleep(0.1)
  195|         if not reaped:
  196|             how = how if how == "no-breakpoint" else "unreaped"
  197|     try:
  198|         if stat is None or not reaped or how in ("no-breakpoint", "unreaped", "killed"):
  199|             pass
  200|         elif os.WIFSIGNALED(stat):
  201|             how = "sig%d" % os.WTERMSIG(stat)
  202|         elif os.WIFEXITED(stat):
  203|             how = "exit%d" % os.WEXITSTATUS(stat)
  204|     except OSError:
  205|         pass
  206|     return buf.replace("\r", ""), alive, how
  207| def program(insns, at=CODE):
  208|     #  `at' lets a session run TWO programs: a second sequence at the SAME address finds
  209|     #  pc already there and the assignment is skipped (the Addr hazard, designed out in
  210|     #  the sgi probes with Addr.take()).  Callers needing two pass at=CODE + 0x100.
  211|     words = list(insns) + [I_BR_SELF, 0]
  212|     cmds = ["put w 0x%x, 0x%08x" % (at + 4 * i, w) for i, w in enumerate(words)]
  213|     return cmds + ["pc=0x%x" % at, "step %d" % len(insns)]
  214| 
  215| 
  216| def setup(r5="0x5a5a5a5a", r6="0x0"):
  217|     return ["r2=0x%x" % PCC2, "r3=0x%x" % SCRATCH, "r5=%s" % r5, "r6=%s" % r6,
  218|             "r4=0x%x" % SENTINEL]
  219| 
  220| print("pcc2_c040_probe -- binary=%s label=%s machine=mvme88k/mvme187" % (BIN, LABEL))
  221| print("%-14s %-22s %-22s %-50s %s" % ("row", "got", "want", "note", ""))
  222| 
  223| C040 = 0x04            #  PCC2_C040
  224| BENIGN = 0x10          #  grok: `acc all' already writes this to GENCTL and survives
  225| 
  226| #  ---- CONTROL: the identical instruction, register and width, with a benign value ---------------
  227| t, alive, how = session(setup(r5="0x%x" % BENIGN) + program([ST_B(5, GENCTL)]))
  228| row("genctl ctl", "alive" if alive else "died(%s)" % how, "alive",
  229|     "CONTROL: same st.b, same GENCTL, benign value -- must survive")
  230| 
  231| ctl_saw_c040 = ("C040 interrupt assertions" in t)
  232| row("genctl ctlq", "no" if not ctl_saw_c040 else "yes", "no",
  233|     "CONTROL: the benign write must NOT reach the C040 arm")
  234| 
  235| #  ---- THE DEFECT ROW ---------------------------------------------------------------------------
  236| #  ORACLE POLARITY is the ladder's: assert the CORRECT behaviour, so this is RED pre-fix and GREEN
  237| #  post-fix with the SAME script.
  238| t2, alive2, how2 = session(setup(r5="0x%x" % C040) + program([ST_B(5, GENCTL)]))
  239| row("c040 kill", "alive" if alive2 else "died(%s)" % how2, "alive",
  240|     "one legal guest st.b of 0x04 to GENCTL must NOT end the host")
  241| 
  242| #  ---- ATTRIBUTION: if it died, it died HERE ----------------------------------------------------
  243| #  Green in both directions by construction; RED only if the host dies WITHOUT this arm's text.
  244| sig = ("C040 interrupt assertions" in t2)
  245| row("c040 attrib", "yes" if (alive2 or sig) else "died-elsewhere", "yes",
  246|     "ATTRIBUTION: a death here must carry the C040 arm's unique diagnostic")
  247| 
  248| for _l in t2.split(chr(10)):
  249|     if "C040" in _l:
  250|         print("  EVIDENCE: %s" % _l.strip())
  251| 
  252| #  ================================================================================================
  253| #  #512 DISCRIMINATING ROWS.  The four rows above are the WITNESS and their oracle is `alive' --
  254| #  which, as this file's own contract says, greens for a silent decline, a latched decline and a
  255| #  real C040 implementation alike.  The pass-1 panel named the two mutants that survive it:
  256| #
  257| #    deepseek  "a text-matching row that only checks for the announce after a SINGLE C040 write is
  258| #               insufficient ... the once-only check is essential; presence alone is not enough."
  259| #    minimax   the NON-SUPPRESSING mutant -- announce correctly, then forget `assert = 0'.
  260| #
  261| #  The four rows above are LEFT BYTE-FOR-BYTE ALONE.  They were measured 3/4 RED on the committed
  262| #  build and 4/4 GREEN on the fix with the SAME script (artifacts witness_HEAD_ and witness_FIX512_),
  263| #  which is witness clause (i); re-keying them onto the new text would destroy that evidence.
  264| #  ================================================================================================
  265| 
  266| #  The announce's own distinctive substring.  Deliberately NOT the whole sentence: a row that
  267| #  matches the full text also fails on a harmless rewording, which makes it a spelling test.
  268| SAYS = "C040 (MC68040 EIPL)"
  269| 
  270| #  ---- kills: SILENT DECLINE (delete the announce, keep `assert = 0').  channel: the text --------
  271| row("c040 says", "yes" if SAYS in t2 else "no", "yes",
  272|     "the decline must ANNOUNCE -- a silent decline is a different disposition")
  273| 
  274| #  ---- kills: NON-LATCHING (drop the `warned' test, or clear the bit).  channel: the COUNT -------
  275| #  Two C040 writes in ONE session.  The house idiom is N=1 PER DEVICE INSTANCE, so the second write
  276| #  must be silent.  A mutant that announces every call scores 2 here and is invisible to `c040 says'.
  277| t3, alive3, how3 = session(setup(r5="0x%x" % C040)
  278|                            + program([ST_B(5, GENCTL), ST_B(5, GENCTL)]))
  279| n_says = t3.count(SAYS)
  280| row("c040 once", ("%d" % n_says) if alive3 else "died(%s)" % how3, "1",
  281|     "TWO C040 writes must announce EXACTLY ONCE -- the (once) latch, not just presence")
  282| 
  283| #  ---- kills: LATCH-BIT COLLISION.  channel: the text SURVIVING earlier warn traffic -------------
  284| #  `d->warned' is shared: PCC2_W_C040 is one bit of a field whose other bits are set by ordinary
  285| #  guest register traffic.  A mutant using a bit some other arm already sets would be SILENCED by
  286| #  benign traffic and would still pass `c040 says' on a fresh instance.  So dirty a DIFFERENT bit
  287| #  first (a wide store to GENCTL trips the width decline, PCC2_W_GENCTL_LEN) and require the
  288| #  announce anyway.  #490 measured exactly this collision shape in this file.
  289| #  *** ST_H, NOT ST_W.  MEASURED: a WORD store to GENCTL (offset 0x02) is misaligned and the m88k
  290| #  core raises `exception MISALIGNED_ACCESS' BEFORE memory_rw, so the pre-dirty never reaches the
  291| #  device and this row reddened on a correct fix.  A HALFWORD store at an even offset is aligned,
  292| #  reaches the handler, and trips the width decline because len != 1.  ***
  293| t4, alive4, how4 = session(setup(r5="0x%x" % C040)
  294|                            + program([ST_H(5, GENCTL), ST_B(5, GENCTL)]))
  295| row("c040 predirty", ("yes" if SAYS in t4 else "no") if alive4 else "died(%s)" % how4, "yes",
  296|     "a DIFFERENT warned bit set first must not silence the C040 announce (bit-collision mutant)")
  297| 
  298| #  ---- OWED, NOT SHIPPED -- and named so the gap does not read as coverage ------------------------
  299| #  minimax's NON-SUPPRESSING mutant (announce correctly, then forget `assert = 0') is NOT covered
  300| #  by any row here.
  301| #
  302| #  *** DO NOT USE THE `IPL ... => ASSERT' debug LINE AS THE ORACLE.  It is the obvious candidate and
  303| #  it is WRONG, for a reason that has nothing to do with visibility. ***
  304| #
  305| #  `debug("[ pcc2: IPL = %i, MASK = %i => %s ]")' sits at the FOOT of reassert_interrupts() but
  306| #  EXECUTES BEFORE BOTH SUPPRESSIONS -- the MIEN test and the C040 test are BELOW it, and only the
  307| #  INTERRUPT_ASSERT/DEASSERT pair after them reflects the real line state.  Verified by line order.
  308| #  So the message reports the PRE-SUPPRESSION value of `assert' and is green under the very mutant it
  309| #  would be chosen to catch.  *Named by the codex seat on pass 1: "do not use the existing
  310| #  `IPL ... => ASSERT' debug message as the line-state oracle: it executes before MIEN suppression
  311| #  and before the proposed C040 suppression.  Observe the interrupt callback/state."*
  312| #
  313| #  (Two earlier drafts of this paragraph were wrong in two different ways.  The first said the line
  314| #  was ABSENT at default verbosity -- false; it prints while single-stepping, and the "0 occurrences"
  315| #  came from grepping the probe's own STDOUT ARTIFACT instead of the captured pty text.  The second
  316| #  then proposed it as the oracle.  **Visibility was never the question; POSITION was.**)
  317| #
  318| #  *** WHAT ACTUALLY BLOCKS THE ROW IS THAT ITS CHANNEL CANNOT VARY, AND THAT IS A SOURCE FACT. ***
  319| #  For the tail to print ASSERT at all, some interrupt must be pending above the mask -- i.e. an
  320| #  INT bit set in one of the ICRs.  MEASURED by reading every guest-writable arm: TxICR keeps only
  321| #  `idata & 0x17' and SCCICR only `idata & 0x1f', so PCC2_IRQ_INT (0x20) is MASKED OUT OF EVERY
  322| #  WRITABLE ARM.  The bit's only producer is reassert_interrupts() itself, from
  323| #  pending_timerN_interrupts, which are incremented by the TIMER TICK -- and a stepped probe cannot
  324| #  run one, because the debugger stops host-timer callbacks for the duration of `step'.
  325| #
  326| #  So this is the accept-row failability rule one level up: a NEVER-SET-BY-GUEST bit cannot carry
  327| #  the row, and no amount of verbosity changes that.  The row needs a FREE-RUNNING probe shape.
  328| #
  329| #  *** AND IT IS A MEASURED ESCAPE, NOT A PREDICTED ONE.  KILL TABLE, 2026-09-08, artifacts in
  330| #  regress/artifacts/pcc2c040kill/killtable_20260907/: ***
  331| #
  332| #      BASE                                   7/7
  333| #      M_b_reinstate   the verbatim exit(1)   3/7   floor (b) -- KILLED
  334| #      M_d2_silent     announce deleted       4/7   floor (d) -- KILLED
  335| #      M_d3_nolatch    announce every call    6/7   floor (d) -- KILLED (c040 once, scores 2)
  336| #      M_d4_collide    latch bit reused       6/7   floor (d) -- KILLED (c040 predirty)
  337| #      M_d1_noassert   `assert = 0' removed   7/7   *** ESCAPES -- CLEAN SWEEP ***
  338| #
  339| #  *** THIS IS A FLOOR BREACH UNDER CLAUSE (d), AND THIS FILE DOES NOT PRETEND OTHERWISE. ***
  340| #  `assert = 0' IS the repair's effect, so removing it is (d)'s canonical "keep the guard, null the
  341| #  repair" -- inside the DEPENDS-ON closure, not outside it.  Calling it clause-(e) contract debt
  342| #  would be using the contract as an escape hatch, which is the one thing clause (e) must not become.
  343| #
  344| #  THE CONTRACT, stated honestly: this detector catches REINSTATEMENT of the host kill, a SILENT
  345| #  decline, a NON-LATCHING announce and a COLLIDING latch bit -- all four MEASURED.  It does NOT
  346| #  catch a fix that announces correctly and fails to suppress the assertion.  The repair for that is
  347| #  a free-running probe (breakpoint + `continue', so host-timer callbacks run and a timer interrupt
  348| #  can go pending), which is a different probe shape rather than another row here.
  349| 
  350| ok = sum(1 for _, o in rows if o)
  351| print("")
  352| print("PCC2C040_RESULT=%d/%d" % (ok, len(rows)))
  353| print("PCC2C040_WITNESS=%s" % ("PASS" if ok == len(rows) else "FAIL"))
  354| print("PCC2C040_DONE")

