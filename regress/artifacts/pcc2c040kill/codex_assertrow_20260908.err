session = next(node for node in module.body if isinstance(node, ast.FunctionDef) and node.name == 'session')
reader = next(node for node in session.body if isinstance(node, ast.FunctionDef) and node.name == 'rd')
reader.body = [node for node in reader.body if not isinstance(node, ast.Nonlocal)]
class NeverRead:
    calls = 0
    def select(self, *args):
        self.calls += 1
        raise AssertionError('unexpected IO')
probe_select = NeverRead()
env = {'buf': 'prior setup output\\nGXemul> ', 'time': time, 'select': probe_select, 'fd': 999}
exec(compile(ast.fix_missing_locations(ast.Module(body=[reader], type_ignores=[])), str(path), 'exec'), env)
result = env['rd'](0.2, 'GXemul>')
