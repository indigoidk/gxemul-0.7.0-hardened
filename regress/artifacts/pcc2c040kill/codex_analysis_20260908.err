 421: static void pcctwo_interrupt_assert(struct interrupt *interrupt)
 422: {
 423: 	pcctwo_interrupt_common(interrupt, 1);
 424: }
 425: static void pcctwo_interrupt_deassert(struct interrupt *interrupt)
 426: {
 427: 	pcctwo_interrupt_common(interrupt, 0);
 428: }
