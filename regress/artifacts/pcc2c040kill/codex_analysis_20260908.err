 438: /*  pcc2widthkills: decline a wide WRITE to a byte register, announcing once per
 439:     block per instance.  The caller `break's after this; the read side of the same
 440:     block never reaches here.  */
 441: static void pcc2_width_decline(struct pcc2_data *d, int bit, const char *name, int len)
 442: {
 443: 	if (!(d->warned & (1u << bit))) {
 444: 		d->warned |= (1u << bit);
 445: 		fatal("[ pcc2: unimplemented len=%i write to %s -- declined."
 446: 		    "  (once) ]\n", len, name);
 447: 	}
 450: DEVICE_ACCESS(pcc2)
 451: {
 452: 	uint64_t idata = 0;
 453: 	struct pcc2_data *d = (struct pcc2_data *) extra;
 454: 
 455: 	/*  0xfff42000..0xfff42fff, but only 0x40 unique registers:  */
 456: 	relative_addr %= PCC2_SIZE;
 457: 
 458: 	if (writeflag == MEM_WRITE)
 459: 		idata = memory_readmax64(cpu, data, len);
 460: 
 461: 	if (writeflag == MEM_READ) {
 462: 		if (relative_addr + len <= PCC2_SIZE)	/* OB-11: end-span */
 463: 			memcpy(data, d->pcctwo_reg + relative_addr, len);
 464: 		else {
 465: 			static int warned = 0;	/* #119: loud-once (course-correction) */
 466: 			if (!warned) {
 467: 				fatal("[ pcc2: read 0x%x+%i beyond reg space 0x%x; "
 468: 				    "zero-filled ]\n", (int)relative_addr, (int)len,
 469: 				    (int)PCC2_SIZE);
 470: 				warned = 1;
 471: 			}
 472: 			memset(data, 0, len);	/* OB-11b: don't leak uninit host memory */
 473: 		}
 474: 	}
 475: 
 476: 	switch (relative_addr) {
 477: 
 478: 	case PCCTWO_CHIPID:
 479: 	case PCCTWO_CHIPREV:
 480: 		if (writeflag == MEM_WRITE) {
 481: 			fatal("[ IGNORING write to read-only PCCTWO_CHIPID/"
 482: 			    "CHIPREV register ]\n");
 483: 		}
 484: 		break;
 485: 
 486: 	case PCCTWO_GENCTL:
 487: 		if (len != 1 && writeflag == MEM_WRITE) {
 488: 			pcc2_width_decline(d, PCC2_W_GENCTL_LEN, "PCCTWO_GENCTL", len);
 489: 			break;
 490: 		}
 491: 		if (writeflag == MEM_WRITE) {
 492: 			d->pcctwo_reg[relative_addr] = idata;
 493: 			reassert_interrupts(d);
 494: 		}
 495: 		break;
 496: 
 497: 	case PCCTWO_VECBASE:
 498: 		if (len != 1 && writeflag == MEM_WRITE) {
 499: 			pcc2_width_decline(d, PCC2_W_VECBASE_LEN, "PCCTWO_VECBASE", len);
 500: 			break;
 501: 		}
 502: 		if (writeflag == MEM_WRITE) {
 503: 			d->pcctwo_reg[relative_addr] = idata & 0xf0;
 504: 			if (idata & ~0xf0)
 505: 				fatal("[ pcc2: HUH? write to PCCTWO_VECBASE"
 506: 				    " with value 0x%02x. ]\n", (int) idata);
 507: 		}
 508: 		break;
