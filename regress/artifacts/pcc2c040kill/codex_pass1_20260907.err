 succeeded in 387ms:
   1: /*  81:               constant and IPL ignores it; both decline too -- a wide write's other  93:               boot runs in this harness, and the one OS source in the tree (OpenBSD
  94:               2.2) declares these registers `volatile u_char' and byte-accesses them
  95:               -- a reading, not a measurement.
  96: 
  97:     ONE BIT PER BLOCK, twelve, per instance: a driver bringing up the chip touches
  98:     several of these in one pass, and one latch would announce the first and silence
  99:     the rest (#497's own reasoning).  Auto-incremented rather than `1 << N' literals,
 100:     which this fork records as collision-prone; PCC2_W_NBITS names the count, and the
 101:     typedef after the enum makes the build fail if it ever exceeds the 32-bit field.
 102: 
 103:     REACHABILITY, verified: every non-byte m88k access is alignment-checked BEFORE
 104:     memory_rw, and `relative_addr %= PCC2_SIZE' keeps parity, so only the SIX
 105:     EVEN-offset blocks (GENCTL, TxCTL, TxICR, SCCERR, SCCTX, IPL) are GUEST-reachable
 106:     (this said "five" until pass 2; IPL at 0x3e is even, and a seat counted); the
 107:     eight odd OFFSETS -- the six odd-only blocks VECBASE, PSCALEADJ, SCCICR, SCCRX,
 108:     SCSIICR, MASK, plus the T1CTL/T1ICR labels of the shared TxCTL/TxICR blocks --
 109:     are OPERATOR-reachable -- the debugger's `put h' warns on a
 110:     misaligned address and stores anyway, MEASURED (artifacts/pcc2widthkills/
 111:     operator_reach_20260903.out: `put h 0xfff42003' ended the host).  All twelve are
 112:     converted; the detector reaches the odd ones through that path.
 113: 
 114:     NOT FIXED HERE, cited so "twelve kills removed" is not read as "file clean":
 115:     pcc2c040kill (a LEGAL byte write of 0x04 to GENCTL still ends the host in
 116:     reassert_interrupts).  pcc2defaultkill -- an unlisted offset ended it -- was
 117:     fixed by #501 (the default: arm below); this sentence said "still ends it"
 118:     until #501's pass 4 (Opus).  */
 119: enum {
 120: 	PCC2_W_GENCTL_LEN,
 121: 	PCC2_W_VECBASE_LEN,
 122: 	PCC2_W_PSCALEADJ_LEN,
 123: 	PCC2_W_TXCTL_LEN,	/*  one block serves T1CTL and T2CTL  */
 124: 	PCC2_W_TXICR_LEN,	/*  one block serves T1ICR and T2ICR  */
 125: 	PCC2_W_SCCERR_LEN,
 126: 	PCC2_W_SCCICR_LEN,
 127: 	PCC2_W_SCCTX_LEN,
 128: 	PCC2_W_SCCRX_LEN,
 129: 	PCC2_W_SCSIICR_LEN,
 130: 	PCC2_W_IPL_LEN,		/*  was a #119 function-static: process-global  */
 131: 	PCC2_W_MASK_LEN,	/*  was a #119 function-static: process-global  */
 132: 	PCC2_W_NBITS
 133: };
 134: 
 135: struct pcc2_data {
 136: 	struct interrupt	cpu_irq;
 137: 
 138: 	uint8_t			pcctwo_reg[PCC2_SIZE];
 139: 
 140: 	/*  pcc2widthkills: one bit per width-guard block, see the enum.  Zeroed by
 141: 	    the init memset, so every instance starts with every announce armed.  */
 142: 	uint32_t		warned;
 143: 	/*  #501: one bit per BYTE OFFSET (0..0x3f) for the default: arm's announce;
 144: 	    relative_addr is folded to PCC2_SIZE above the switch, so the shift is
 145: 	    always defined.  Zeroed by the same memset.  */
 146: 	uint64_t		warned_unimpl;
 147: 
 148: 	uint8_t			cur_int_vec[8];
 149: 
 150: 	/*  Timers:  */
 151: 	struct timer		*timer;
 152: 	int			pending_timer1_interrupts;
 153: 	int			pending_timer2_interrupts;
 154: };
 155: /*  pcc2widthkills: the enum must fit the field.  A seat pointed out that a bare
 156:     `<= 32' tested a literal, not the field, so narrowing `warned' would compile
 157:     silently; this is dev_dreamcast_gdrom.c's own form.  Negative array size is a
 158:     compile-time error, C99, no assert.h.  */
 159: typedef char pcc2_w_fits_in_warned[(PCC2_W_NBITS <= 8 * sizeof(((struct pcc2_data *)0)->warned)
 160:     && PCC2_W_NBITS <= 8 * sizeof(1u)) ? 1 : -1];
 161: 
 162: 
 163: static uint32_t read32(unsigned char *p)
 164: {
 165: 	uint32_t x = 0;
 166: 	size_t i;
 167: 
 168: 	for (i=0; i<sizeof(x); i++) {
 169: 		x <<= 8;
 170: 		x |= p[i];
 171: 	}
 172: 
 173: 	return x;
 174: }
 175: 
 176: 
 177: static void write32(unsigned char *p, uint32_t x)
 178: {
 179: 	size_t i;
 180: 
 181: 	for (i=0; i<sizeof(x); i++) {
 182: 		p[sizeof(x) - 1 - i] = x;
 183: 		x >>= 8;
 184: 	}
 185: }
 186: 
 187: 
 188: static void pcc_timer_tick(struct timer *t, void *extra)
 189: {
 190: 	struct pcc2_data *d = (struct pcc2_data *) extra;
 191: 
 192: 	/*  The PCC2 timers run at 1 MHz.  */
 193: 	int steps = (int) (1000000.0 / PCC_TIMER_TICK_HZ);
 194: 
 195: 	uint32_t count1, count2, compare1, compare2;
 196: 	int interrupt1 = 0, interrupt2 = 0;
 197: 
 198: 	/*  Read values:  */
 199: 	count1 = read32(&d->pcctwo_reg[PCCTWO_T1COUNT]);
 200: 	count2 = read32(&d->pcctwo_reg[PCCTWO_T2COUNT]);
 201: 	compare1 = read32(&d->pcctwo_reg[PCCTWO_T1CMP]);
 202: 	compare2 = read32(&d->pcctwo_reg[PCCTWO_T2CMP]);
 203: 
 204: 	/*  Timer enabled? Then count...  */
 205: 	if (d->pcctwo_reg[PCCTWO_T1CTL] & PCC2_TCTL_CEN) {
 206: 		uint32_t old_count1 = count1;
 207: 		count1 += steps;
 208: 
 209: 		/*  Did we pass the compare value?  */
 210: 		if ((old_count1 < compare1 && count1 >= compare1) ||
 211: 		    (old_count1 < compare1 && count1 < old_count1)) {
 212: 			interrupt1 = 1;
 213: 
 214: 			if (d->pcctwo_reg[PCCTWO_T1CTL] & PCC2_TCTL_COC) {
 215: 				while (count1 >= compare1) {
 216: 					count1 -= compare1;
 217: 					interrupt1 ++;
 218: 				}
 219: 				interrupt1 --;
 220: 			}
 221: 		}
 222: 
 223: 		/*  Overflow?  */
 224: 		if ((int32_t) old_count1 >= 0 && (int32_t) count1 < 0) {
 225: 			int oc = 1 + (d->pcctwo_reg[PCCTWO_T1CTL] >> 4);
 226: 			d->pcctwo_reg[PCCTWO_T1CTL] &= ~PCC2_TCTL_OVF;
 227: 			d->pcctwo_reg[PCCTWO_T1CTL] |= (oc << 4);
 228: 		}
 229: 	}
 230: 
 231: 	/*  ... and the same for timer 2:  */
 232: 	if (d->pcctwo_reg[PCCTWO_T2CTL] & PCC2_TCTL_CEN) {
 233: 		uint32_t old_count2 = count2;
 234: 		count2 += steps;
 235: 
 236: 		if ((old_count2 < compare2 && count2 >= compare2) ||
 237: 		    (old_count2 < compare2 && count2 < old_count2)) {
 238: 			interrupt2 = 1;
 239: 			if (d->pcctwo_reg[PCCTWO_T2CTL] & PCC2_TCTL_COC) {
 240: 				while (count2 >= compare2) {
 241: 					count2 -= compare2;
 242: 					interrupt2 ++;
 243: 				}
 244: 				interrupt2 --;
 245: 			}
 246: 		}
 247: 
 248: 		if ((int32_t) old_count2 >= 0 && (int32_t) count2 < 0) {
 249: 			int oc = 1 + (d->pcctwo_reg[PCCTWO_T2CTL] >> 4);
 250: 			d->pcctwo_reg[PCCTWO_T2CTL] &= ~PCC2_TCTL_OVF;
 251: 			d->pcctwo_reg[PCCTWO_T2CTL] |= (oc << 4);
 252: 		}
 253: 	}
 254: 
 255: 	/*  Should we cause interrupts?  */
 256: 	if (interrupt1 && d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_IEN)
 257: 		d->pending_timer1_interrupts += interrupt1;
 258: 	if (interrupt2 && d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_IEN)
 259: 		d->pending_timer2_interrupts += interrupt2;
 260: 
 261: 	/*  Write back values:  */
 262: 	write32(&d->pcctwo_reg[PCCTWO_T1COUNT], count1);
 263: 	write32(&d->pcctwo_reg[PCCTWO_T2COUNT], count2);
 264: }
 265: 
 266: 
 267: static void reassert_interrupts(struct pcc2_data *d)
 268: {
 269: 	int assert = 0;
 270: 
 271: 	if (d->pcctwo_reg[PCCTWO_GENCTL] & PCC2_C040) {
 272: 		/*  The M68000 interrupt mechanism involves outputting
 273: 		    interrupt level on pins EIPL<2..0>. Not implemented
 274: 		    yet.  */
 275: 		fatal("pcc2: C040 interrupt assertions... TODO\n");
 276: 		exit(1);
 277: 	}
 278: 
 279: 	/*
 280: 	 *  Recalculate current interrupt level:
 281: 	 */
 282: 	d->pcctwo_reg[PCCTWO_IPL] = 0;
 283: 
 284: 	/*  Timer interrupts?  */
 285: 	if (d->pending_timer1_interrupts > 0 &&
 286: 	    d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_IEN)
 287: 		d->pcctwo_reg[PCCTWO_T1ICR] |= PCC2_TTIRQ_INT;
 288: 	if (d->pending_timer2_interrupts > 0 &&
 289: 	    d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_IEN)
 290: 		d->pcctwo_reg[PCCTWO_T2ICR] |= PCC2_TTIRQ_INT;
 291: 
 292: 	if (d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_INT) {
 293: 		int intlevel = d->pcctwo_reg[PCCTWO_T1ICR] & PCC2_TTIRQ_IL;
 294: 		d->cur_int_vec[intlevel] = PCC2V_TIMER1;
 295: 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
 296: 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
 297: 	}
 298: 	if (d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_INT) {
 299: 		int intlevel = d->pcctwo_reg[PCCTWO_T2ICR] & PCC2_TTIRQ_IL;
 300: 		d->cur_int_vec[intlevel] = PCC2V_TIMER2;
 301: 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
 302: 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
 303: 	}
 304: 
 305: 	if (d->pcctwo_reg[PCCTWO_SCCTX] & PCC2_IRQ_IEN &&
 306: 	    d->pcctwo_reg[PCCTWO_SCCTX] & PCC2_IRQ_INT) {
 307: 		int intlevel = d->pcctwo_reg[PCCTWO_SCCTX] & PCC2_IRQ_IPL;
 308: 		d->cur_int_vec[intlevel] = PCC2V_SCC_TX;
 309: 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
 310: 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
 311: 	}
 312: 
 313: 	if (d->pcctwo_reg[PCCTWO_SCCRX] & PCC2_IRQ_IEN &&
 314: 	    d->pcctwo_reg[PCCTWO_SCCRX] & PCC2_IRQ_INT) {
 315: 		int intlevel = d->pcctwo_reg[PCCTWO_SCCRX] & PCC2_IRQ_IPL;
 316: 		d->cur_int_vec[intlevel] = PCC2V_SCC_RX;
 317: 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
 318: 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
 319: 	}
 320: 
 321: 	if (d->pcctwo_reg[PCCTWO_SCSIICR] & PCC2_IRQ_IEN &&
 322: 	    d->pcctwo_reg[PCCTWO_SCSIICR] & PCC2_IRQ_INT) {
 323: 		int intlevel = d->pcctwo_reg[PCCTWO_SCSIICR] & PCC2_IRQ_IPL;
 324: 		d->cur_int_vec[intlevel] = PCC2V_SCSI;
 325: 		if (d->pcctwo_reg[PCCTWO_IPL] < intlevel)
 326: 			d->pcctwo_reg[PCCTWO_IPL] = intlevel;
 327: 	}
 328: 
 329: 	/*  TODO: Other interrupt sources.  */
 330: 
 331: 	/*  Assert interrupt on the CPU if the IPL is higher than the mask:  */
 332: 	if ((d->pcctwo_reg[PCCTWO_IPL] & INTERRUPT_LEVEL_MASK) >
 333: 	    (d->pcctwo_reg[PCCTWO_MASK] & INTERRUPT_LEVEL_MASK))
 334: 		assert = 1;
 335: 
 336: 	debug("[ pcc2: IPL = %i, MASK = %i => %s ]\n", d->pcctwo_reg[PCCTWO_IPL]& INTERRUPT_LEVEL_MASK,
 337: 		d->pcctwo_reg[PCCTWO_MASK] & INTERRUPT_LEVEL_MASK,
 338: 		assert ? "ASSERT" : "no assert");
 339: 
 340: 	/*  ... but only allow interrupts if Master Interrupt Enable is on:  */
 341: 	if (!(d->pcctwo_reg[PCCTWO_GENCTL] & PCC2_MIEN))
 342: 		assert = 0;
 343: 
 344: 	if (assert)
 345: 		INTERRUPT_ASSERT(d->cpu_irq);
 346: 	else
 347: 		INTERRUPT_DEASSERT(d->cpu_irq);
 348: }
 349: 
 350: 
 351: void pcctwo_interrupt_common(struct interrupt *interrupt, int assert)
 352: {
 353: 	struct pcc2_data *d = (struct pcc2_data *) interrupt->extra;
 354: 
 355: 	switch (interrupt->line) {
 356: 
 357: 	case PCC2V_SCSI:
 358: 		if (assert)
 359: 			d->pcctwo_reg[PCCTWO_SCSIICR] |= PCC2_IRQ_INT;
 360: 		else
 361: 			d->pcctwo_reg[PCCTWO_SCSIICR] &= ~PCC2_IRQ_INT;
 362: 		break;
 363: 
 364: 	case PCC2V_SCC_TX:
 365: 		if (assert)
 366: 			d->pcctwo_reg[PCCTWO_SCCTX] |= PCC2_IRQ_INT;
 367: 		else
 368: 			d->pcctwo_reg[PCCTWO_SCCTX] &= ~PCC2_IRQ_INT;
 369: 		break;
 370: 
 371: 	case PCC2V_SCC_RX:
 372: 		if (assert)
 373: 			d->pcctwo_reg[PCCTWO_SCCRX] |= PCC2_IRQ_INT;
 374: 		else
 375: 			d->pcctwo_reg[PCCTWO_SCCRX] &= ~PCC2_IRQ_INT;
 376: 		break;
 377: 
 378: 	default:fatal("[ pcctwo_interrupt_common: TODO: line = %i ]\n",
 379: 		    interrupt->line);
 380: 		exit(1);
 381: 	}
 382: 
 383: 	reassert_interrupts(d);
 384: }
 385: 
 386: 
 387: static void pcctwo_interrupt_assert(struct interrupt *interrupt)
 388: {
 389: 	pcctwo_interrupt_common(interrupt, 1);
 390: }
 391: static void pcctwo_interrupt_deassert(struct interrupt *interrupt)
 392: {
 393: 	pcctwo_interrupt_common(interrupt, 0);
 394: }
 395: 
 396: 
 397: DEVICE_TICK(pcc2)
 398: {
 399: 	struct pcc2_data *d = (struct pcc2_data *) extra;
 400: 	reassert_interrupts(d);
 401: }
 402: 
 403: 
 404: /*  pcc2widthkills: decline a wide WRITE to a byte register, announcing once per
 405:     block per instance.  The caller `break's after this; the read side of the same
 406:     block never reaches here.  */
 407: static void pcc2_width_decline(struct pcc2_data *d, int bit, const char *name, int len)
 408: {
 409: 	if (!(d->warned & (1u << bit))) {
 410: 		d->warned |= (1u << bit);
 411: 		fatal("[ pcc2: unimplemented len=%i write to %s -- declined."
 412: 		    "  (once) ]\n", len, name);
 413: 	}
 414: }
 415: 
 416: DEVICE_ACCESS(pcc2)
 417: {
 418: 	uint64_t idata = 0;
 419: 	struct pcc2_data *d = (struct pcc2_data *) extra;
 420: 
 421: 	/*  0xfff42000..0xfff42fff, but only 0x40 unique registers:  */
 422: 	relative_addr %= PCC2_SIZE;
 423: 
 424: 	if (writeflag == MEM_WRITE)
 425: 		idata = memory_readmax64(cpu, data, len);
 426: 
 427: 	if (writeflag == MEM_READ) {
 428: 		if (relative_addr + len <= PCC2_SIZE)	/* OB-11: end-span */
 429: 			memcpy(data, d->pcctwo_reg + relative_addr, len);
 430: 		else {
 431: 			static int warned = 0;	/* #119: loud-once (course-correction) */
 432: 			if (!warned) {
 433: 				fatal("[ pcc2: read 0x%x+%i beyond reg space 0x%x; "
 434: 				    "zero-filled ]\n", (int)relative_addr, (int)len,
 435: 				    (int)PCC2_SIZE);
 436: 				warned = 1;
 437: 			}
 438: 			memset(data, 0, len);	/* OB-11b: don't leak uninit host memory */
 439: 		}
 440: 	}
 441: 
 442: 	switch (relative_addr) {
 443: 
 444: 	case PCCTWO_CHIPID:
 445: 	case PCCTWO_CHIPREV:
 446: 		if (writeflag == MEM_WRITE) {
 447: 			fatal("[ IGNORING write to read-only PCCTWO_CHIPID/"
 448: 			    "CHIPREV register ]\n");
 449: 		}
 450: 		break;
 451: 
 452: 	case PCCTWO_GENCTL:
 453: 		if (len != 1 && writeflag == MEM_WRITE) {
 454: 			pcc2_width_decline(d, PCC2_W_GENCTL_LEN, "PCCTWO_GENCTL", len);
 455: 			break;
 456: 		}
 457: 		if (writeflag == MEM_WRITE) {
 458: 			d->pcctwo_reg[relative_addr] = idata;
 459: 			reassert_interrupts(d);
 460: 		}
 461: 		break;
 462: 
 463: 	case PCCTWO_VECBASE:
 464: 		if (len != 1 && writeflag == MEM_WRITE) {
 465: 			pcc2_width_decline(d, PCC2_W_VECBASE_LEN, "PCCTWO_VECBASE", len);
 466: 			break;
 467: 		}
 468: 		if (writeflag == MEM_WRITE) {
 469: 			d->pcctwo_reg[relative_addr] = idata & 0xf0;
 470: 			if (idata & ~0xf0)
 471: 				fatal("[ pcc2: HUH? write to PCCTWO_VECBASE"
 472: 				    " with value 0x%02x. ]\n", (int) idata);
 473: 		}
 474: 		break;
 475: 
 476: 	case PCCTWO_T1CMP:
 477: 	case PCCTWO_T2CMP:
 478: 	case PCCTWO_T1COUNT:
 479: 	case PCCTWO_T2COUNT:
 480: 		if (writeflag == MEM_WRITE &&
 481: 		    relative_addr + len <= PCC2_SIZE)	/* OB-11: end-span */
 482: 			memcpy(d->pcctwo_reg + relative_addr, data, len);
 483: 		break;
 484: 
 485: 	case PCCTWO_PSCALEADJ:
 486: 		if (len != 1 && writeflag == MEM_WRITE) {
 487: 			pcc2_width_decline(d, PCC2_W_PSCALEADJ_LEN, "PCCTWO_PSCALEADJ", len);
 488: 			break;
 489: 		}
 490: 		if (writeflag == MEM_WRITE) {
 491: 			fatal("[ pcc2: write to PSCALEADJ ignored (value "
 492: 			    "0x%02x) ]\n", (int)idata);
 493: 		}
 494: 		break;
 495: 
 496: 	case PCCTWO_T2CTL:
 497: 	case PCCTWO_T1CTL:
 498: 		if (len != 1 && writeflag == MEM_WRITE) {
 499: 			pcc2_width_decline(d, PCC2_W_TXCTL_LEN, "PCCTWO_TxCTL", len);
 500: 			break;
 501: 		}
 502: 		if (writeflag == MEM_WRITE) {
 503: 			/*  PCC2_TCTL_CEN and PCC2_TCTL_COC:  */
 504: 			d->pcctwo_reg[relative_addr] &= 0xfc;
 505: 			d->pcctwo_reg[relative_addr] |= (idata & 3);
 506: 
 507: 			if (idata & PCC2_TCTL_COVF)
 508: 				d->pcctwo_reg[relative_addr] &=
 509: 				    ~(PCC2_TCTL_OVF | PCC2_TCTL_COVF);
 510: 
 511: 			if (idata & ~7)
 512: 				fatal("[ pcc2: HUH? write to PCCTWO_TxCTL"
 513: 				    " with value 0x%02x. ]\n", (int) idata);
 514: 		}
 515: 		break;
 516: 
 517: 	case PCCTWO_T2ICR:
 518: 	case PCCTWO_T1ICR:
 519: 		if (len != 1 && writeflag == MEM_WRITE) {
 520: 			pcc2_width_decline(d, PCC2_W_TXICR_LEN, "PCCTWO_TxICR", len);
 521: 			break;
 522: 		}
 523: 		if (writeflag == MEM_WRITE) {
 524: 			d->pcctwo_reg[relative_addr] &= ~0x17;
 525: 			d->pcctwo_reg[relative_addr] |= (idata & 0x17);
 526: 
 527: 			if (relative_addr == PCCTWO_T1ICR &&
 528: 			    !(idata & PCC2_TTIRQ_IEN))
 529: 				d->pending_timer1_interrupts = 0;
 530: 			if (relative_addr == PCCTWO_T2ICR &&
 531: 			    !(idata & PCC2_TTIRQ_IEN))
 532: 				d->pending_timer2_interrupts = 0;
 533: 
 534: 			if (relative_addr == PCCTWO_T1ICR && (idata & PCC2_TTIRQ_ICLR)
 535: 			    && d->pcctwo_reg[relative_addr] & PCC2_TTIRQ_INT
 536: 			    && d->pending_timer1_interrupts > 0)
 537: 				d->pending_timer1_interrupts --;
 538: 
 539: 			if (relative_addr == PCCTWO_T2ICR && (idata & PCC2_TTIRQ_ICLR)
 540: 			    && d->pcctwo_reg[relative_addr] & PCC2_TTIRQ_INT
 541: 			    && d->pending_timer2_interrupts > 0)
 542: 				d->pending_timer2_interrupts --;
 543: 
 544: 			if (idata & PCC2_TTIRQ_ICLR)
 545: 				d->pcctwo_reg[relative_addr] &= ~PCC2_TTIRQ_INT;
 546: 
 547: 			if (idata & 0xe0)
 548: 				fatal("[ pcc2: HUH? write to PCCTWO_TxICR"
 549: 				    " with value 0x%02x. ]\n", (int) idata);
 550: 
 551: 			reassert_interrupts(d);
 552: 		}
 553: 		break;
 554: 
 555: 	case PCCTWO_SCCERR:
 556: 		if (len != 1 && writeflag == MEM_WRITE) {
 557: 			pcc2_width_decline(d, PCC2_W_SCCERR_LEN, "PCCTWO_SCCERR", len);
 558: 			break;
 559: 		}
 560: 		if (writeflag == MEM_WRITE)
 561: 			d->pcctwo_reg[relative_addr] = 0;	/*  clear  */
 562: 		break;
 563: 
 564: 	case PCCTWO_SCCICR:
 565: 		if (len != 1 && writeflag == MEM_WRITE) {
 566: 			pcc2_width_decline(d, PCC2_W_SCCICR_LEN, "PCCTWO_SCCICR", len);
 567: 			break;
 568: 		}
 569: 		if (writeflag == MEM_WRITE) {
 570: 			d->pcctwo_reg[relative_addr] = idata & 0x1f;
 571: 			if (idata & ~0x1f)
 572: 				fatal("[ pcc2: HUH? write to PCCTWO_SCCICR"
 573: 				    " with value 0x%02x. ]\n", (int) idata);
 574: 			reassert_interrupts(d);
 575: 		}
 576: 		break;
 577: 
 578: 	case PCCTWO_SCCTX:
 579: 		if (len != 1 && writeflag == MEM_WRITE) {
 580: 			pcc2_width_decline(d, PCC2_W_SCCTX_LEN, "PCCTWO_SCCTX", len);
 581: 			break;
 582: 		}
 583: 		if (writeflag == MEM_WRITE) {
 584: 			d->pcctwo_reg[relative_addr] = idata & 0x1f;
 585: 			if (idata & ~0x1f)
 586: 				fatal("[ pcc2: HUH? write to PCCTWO_SCCTX"
 587: 				    " with value 0x%02x. ]\n", (int) idata);
 588: 			reassert_interrupts(d);
 589: 		}
 590: 		break;
 591: 
 592: 	case PCCTWO_SCCRX:
 593: 		if (len != 1 && writeflag == MEM_WRITE) {
 594: 			pcc2_width_decline(d, PCC2_W_SCCRX_LEN, "PCCTWO_SCCRX", len);
 595: 			break;
 596: 		}
 597: 		if (writeflag == MEM_WRITE) {
 598: 			d->pcctwo_reg[relative_addr] = idata & 0xdf;
 599: 			if (idata & ~0xdf)
 600: 				fatal("[ pcc2: HUH? write to PCCTWO_SCCRX"
 601: 				    " with value 0x%02x. ]\n", (int) idata);
 602: 			reassert_interrupts(d);
 603: 		}
 604: 		break;
 605: 
 606: 	case PCCTWO_SCCRXIACK:
 607: 		/*  TODO. Hm. Is this enough?  */
 608: 		d->pcctwo_reg[PCCTWO_SCCRX] &= ~PCC2_IRQ_INT;
 609: 		reassert_interrupts(d);
 610: 		break;
 611: 
 612: 	case PCCTWO_SCSIICR:
 613: 		if (len != 1 && writeflag == MEM_WRITE) {
 614: 			pcc2_width_decline(d, PCC2_W_SCSIICR_LEN, "PCCTWO_SCSIICR", len);
 615: 			break;
 616: 		}
 617: 		if (writeflag == MEM_WRITE) {
 618: 			d->pcctwo_reg[relative_addr] = idata & 0xdf;
 619: 			if (idata & ~0xdf)
 620: 				fatal("[ pcc2: HUH? write to PCCTWO_SCSIICR"
 621: 				    " with value 0x%02x. ]\n", (int) idata);
 622: 			reassert_interrupts(d);
 623: 		}
 624: 		break;
 625: 
 626: 	case PCCTWO_IPL:
 627: 		/*  pcc2widthkills: was a #119 `static int w' -- process-global, and it
 628: 		    said "ignored" about a READ the memcpy above had already served.
 629: 		    Now per-instance, write-only, like the ten blocks above -- that is
 630: 		    the WIDTH latch; the body's own #119 `static int w' below stays
 631: 		    process-global (pcc2pscaleflood's family; not this round's).  */
 632: 		if (len != 1 && writeflag == MEM_WRITE) {
 633: 			pcc2_width_decline(d, PCC2_W_IPL_LEN, "PCCTWO_IPL", len);
 634: 			break;
 635: 		}
 636: 		if (writeflag == MEM_WRITE) {
 637: 			static int w = 0;	/* #119: was exit(1) (IPL is read-only) */
 638: 			if (!w) { fatal("[ pcc2: write to read-only PCCTWO_IPL; "
 639: 			    "ignored ]\n"); w = 1; }
 640: 		} else {
 641: 			if (d->pcctwo_reg[PCCTWO_IPL] == 0) {
 642: 				static int w = 0;	/* #119: was exit(1) */
 643: 				if (!w) { fatal("[ pcc2: IPL == 0 on read ]\n");
 644: 				    w = 1; }
 645: 			}
 646: 		}
 647: 		break;
 648: 
 649: 	case PCCTWO_MASK:
 650: 		/*  pcc2widthkills: was a #119 `static int w' -- process-global, and it
 651: 		    said "ignored" about a READ the memcpy above had already served.
 652: 		    Now per-instance, write-only, like the ten blocks above -- that is
 653: 		    the WIDTH latch.  (pcc2widthkills pass 7: this comment once claimed a
 654: 		    #119 static of MASK's own "below" -- there is none; the body stores
 655: 		    the byte and reasserts.  The static belongs to IPL's arm above.)  */
 656: 		if (len != 1 && writeflag == MEM_WRITE) {
 657: 			pcc2_width_decline(d, PCC2_W_MASK_LEN, "PCCTWO_MASK", len);
 658: 			break;
 659: 		}
 660: 		if (writeflag == MEM_WRITE) {
 661: 			d->pcctwo_reg[relative_addr] = idata;
 662: 			reassert_interrupts(d);
 663: 		}
 664: 		break;
 665: 
 666: 	default:
 667: 		/*  #501 (pcc2defaultkill): this arm ended the host with exit(1) on ANY
 668: 		    access to an offset with no case -- 43 of the 0x40 byte offsets:
 669: 		    eighteen documented registers the model does not implement (IEICR,
 670: 		    IEERR, IEBERR, GPIO, SCSIERR, the printer block, SPEED, the *IACKs),
 671: 		    the bytes inside the four counter/compare words, and the unnamed
 672: 		    ones -- READS included, though the memcpy above the switch had
 673: 		    already served them.  A guest ld.bu or st.b at any of them was a host
 674: 		    kill (rung-3 witness).  Now: a READ keeps the served byte (the array's
 675: 		    current byte, said so -- inside a running COUNT word that is the
 676: 		    tick's value, not a default); a WRITE is DECLINED.  Not a
 677: 		    backed store: the cased siblings contradict one (SCCERR clears on
 678: 		    write, the ICRs mask and reassert, PSCALECNT/SPEED/the IACKs are
 679: 		    read-only), no inspected OpenBSD driver path reaches them (if_ie never
 680: 		    attaches: unreadable sits at its 82596 address), and a store from the
 681: 		    one arm 43 offsets reach would add a bounded-write surface.  One
 682: 		    latched fatal() per offset per instance, the house `(once)' shape --
 683: 		    unlike PSCALEADJ's UNLATCHED print above (pcc2pscaleflood).  The
 684: 		    IACK offsets 0x23/0x25 are declined like the rest: modelling them (on
 685: 		    the SCCRXIACK shape) would open two new entries into the C040 path,
 686: 		    so pcc2c040kill goes first.  The %= fold above IS the real part's:
 687: 		    Motorola VMESBCP2 Table 6-1 lists $FFF42040-$FFF42FFF as repeated
 688: 		    PCCchip2 registers.  */
 689: 		if (!(d->warned_unimpl & (1ULL << relative_addr))) {
 690: 			d->warned_unimpl |= 1ULL << relative_addr;
 691: 			if (writeflag == MEM_WRITE)
 692: 				fatal("[ pcc2: unimplemented write to offset "
 693: 				    "0x%x (len %d): 0x%x -- declined.  (once) ]\n",
 694: 				    (int) relative_addr, (int) len, (int) idata);
 695: 			else
 696: 				/*  data[0] is the byte actually SERVED; a reload of the
 697: 				    array could differ: on the end-span path (zero-filled,
 698: 				    the array byte kept) and inside a running COUNT word,
 699: 				    whose SIGALRM-driven tick (timer.c) can land between
 700: 				    the copy and this line.  A wide read is labelled.  */
 701: 				fatal("[ pcc2: unimplemented read from offset "
 702: 				    "0x%x (len %d) -- served 0x%02x.  (once) ]\n",
 703: 				    (int) relative_addr, (int) len, data[0]);
 704: 		}
 705: 		break;
 706: 	}
 707: 
 708: 	return 1;
 709: }
 710: 
 711: 
 712: DEVICE_ACCESS(mvme187_iack)
 713: {
 714: 	uint64_t odata = 0;
 715: 	struct pcc2_data *d = (struct pcc2_data *) extra;
 716: 
 717: 	if (writeflag == MEM_WRITE) {
 718: 		fatal("[ pcc2: write to mvme187_iack? ]\n");
 719: 	} else {
 720: 		odata = d->pcctwo_reg[PCCTWO_VECBASE] + d->cur_int_vec[
 721: 		    (relative_addr >> 2) & INTERRUPT_LEVEL_MASK];
 722: 		debug("[ pcc2: mvme187_iack level %i => vector 0x%02x ]\n",
 723: 		    (int)(relative_addr >> 2), (int)odata);
 724: 
 725: 		memory_writemax64(cpu, data, len, odata);
 726: 	}
 727: 
 728: 	return 1;
 729: }
 730: 
 731: 
 732: DEVINIT(pcc2)
 733: {
 734: 	struct pcc2_data *d;
 735: 	int i;
 736: 
 737: 	CHECK_ALLOCATION(d = (struct pcc2_data *) malloc(sizeof(struct pcc2_data)));
 738: 	memset(d, 0, sizeof(struct pcc2_data));
 739: 
 740: 	/*
 741: 	 *  Initial values, according to the manual:
 742: 	 *
 743: 	 *  VECBASE is 0x0f after a reset, although the lowest four bits
 744: 	 *  cannot be manually written to after startup.
 745: 	 */
 746: 	d->pcctwo_reg[PCCTWO_CHIPID] = PCC2_ID;
 747: 	d->pcctwo_reg[PCCTWO_CHIPREV] = 0x00;
 748: 	d->pcctwo_reg[PCCTWO_GENCTL] = 0x00;
 749: 	d->pcctwo_reg[PCCTWO_VECBASE] = 0x0f;
 750: 	d->pcctwo_reg[PCCTWO_PSCALEADJ] = 256 - 33;	// 256 - MHz (fake)
 751: 
 752: 	/*  Connect to the CPU's interrupt pin:  */
 753: 	INTERRUPT_CONNECT(devinit->interrupt_path, d->cpu_irq);
 754: 
 755: 	/*
 756: 	 *  Register the 16 PCC2 interrupt vectors:
 757: 	 */
 758: 	for (i=0; i<16; i++) {
 759: 		struct interrupt templ;
 760: 		char n[300];
 761: 		snprintf(n, sizeof(n), "%s.pcc2.%i",
 762: 		    devinit->interrupt_path, i);
 763: 
 764: 		memset(&templ, 0, sizeof(templ));
 765: 		templ.line = i;
 766: 		templ.name = n;
 767: 		templ.extra = d;
 768: 		templ.interrupt_assert = pcctwo_interrupt_assert;
 769: 		templ.interrupt_deassert = pcctwo_interrupt_deassert;
 770: 
 771: 		interrupt_handler_register(&templ);
 772: 	}
 773: 
 774: 	memory_device_register(devinit->machine->memory, "pcc2",
 775: 	    devinit->addr, 4096, dev_pcc2_access, (void *)d,
 776: 	    DM_DEFAULT, NULL);
 777: 
 778: 	memory_device_register(devinit->machine->memory, "mvme187_iack",
 779: 	    M187_IACK, 32, dev_mvme187_iack_access, (void *)d,
 780: 	    DM_DEFAULT, NULL);
 781: 
 782: 	d->timer = timer_add(PCC_TIMER_TICK_HZ, pcc_timer_tick, d);
 783: 
 784: 	machine_add_tickfunction(devinit->machine,
 785: 	    dev_pcc2_tick, d, DEV_PCC2_TICK_SHIFT);
 786: 
 787: 	return 1;
 788: }
