 293: def run_arm(label, prog, emul="cats", quit_leg=False):
 294:     """Plant `prog`, step it one instruction at a time, report registers and liveness.
 295:     #545: `emul` is the -E name (leg H1 passes an unknown one and expects NO prompt); `quit_leg`
 296:     runs leg H2 after the register read -- quit, then one more ordinary interaction, observed
 297:     BEFORE teardown."""
 298:     pid, fd = pty.fork()
 299:     if pid == 0:
 300:         os.execvp(BIN, [BIN, "-V", "-T", "-E", emul, "-M", "32",
 301:                         "0x%x:%s" % (CODE, STUB)])
 302:         os._exit(127)
 303:     buf = ""
 304:     dead = [False]
 305: 
 306:     def rd(t=0.4):
 307:         nonlocal buf
 308:         r, _, _ = select.select([fd], [], [], t)
 309:         if fd not in r:
 310:             return True
 311:         try:
 312:             d = os.read(fd, 65536)
 313:         except OSError:
 314:             dead[0] = True
 315:             return False
 316:         if not d:
 317:             dead[0] = True
 318:             return False
 319:         buf += d.decode("latin1", "replace")
 320:         return True
 321: 
 322:     #  Signature order is not free choice: gate_hygiene.sh pins the CANONICAL #392 call form
 323:     #  as a literal `return wait(mark=_mark, echo=<x> if <x> else None)`, tightened three
 324:     #  times because every looser prefix was a substring of the broken form too.  Written any
 325:     #  other way, a probe is simply not covered by that ratchet -- which is worse than failing
 326:     #  it.  So timeout goes last, and send() ends on the pinned form.  (#545: send() now also
 327:     #  forwards its timeout -- `..., echo=x if x else None, timeout=timeout)`; the census at
 328:     #  gate_hygiene.sh's conv_mark accepts `,` or `)` after the echo expression, so the forwarded
 329:     #  form is still counted.  Before #545 this send() silently dropped its timeout argument.)
 330:     def wait(mark=0, echo=None, timeout=60):
 331:         t = time.time()
 332:         while time.time() - t < timeout:
 333:             if not rd():
 334:                 return False
 335:             resp = buf[mark:]
 336:             if echo is not None and echo not in resp:
 337:                 continue
 338:             if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
 339:                 return True
 340:         return False
 341: 
 342:     def send(x, timeout=60):
 343:         b = (x + "\n").encode("latin1")
 344:         _mark = len(buf)
 345:         n = 0
 346:         try:
 347:             while n < len(b):
 348:                 n += os.write(fd, b[n:])
 349:         except OSError:
 350:             dead[0] = True
 351:             return False
 352:         return wait(mark=_mark, echo=x if x else None, timeout=timeout)
