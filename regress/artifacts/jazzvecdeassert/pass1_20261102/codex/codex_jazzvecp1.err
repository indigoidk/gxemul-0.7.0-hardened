1643-/*
1644- *  #258:  FCSR decoded: fcc byte (bit 23 = FCC0, bits 31..25 = FCC7..1),
1645: *  FS (flush-to-zero), cause/enables/flags groups (E=unimpl, V=invalid,
1646: *  Z=div0, O=overflow, U=underflow, I=inexact; only cause has E), and RM.
1647- */
1648-static void mips_cpu_dump_fcsr(struct cpu *cpu, uint32_t f)
1649-{
1650-	static const char *rmnames[4] = { "RN", "RZ", "RP", "RM" };
1651-	static const char letters[] = "EVZOUI";
1652:	char causes[7], enab[6], flags[6];
1653-	int j;
1654-
1655-	for (j=0; j<6; j++)
1656:		causes[j] = f & (MIPS_FPU_EXCEPTION_INEXACT << (5-j))?
1657-		    letters[j] : '-';
1658-	for (j=0; j<5; j++) {
1659-		enab[j] = f & (MIPS_FPU_ENABLE_INEXACT << (4-j))?
1660-		    letters[j+1] : '-';
1661-		flags[j] = f & (MIPS_FPU_STICKY_INEXACT << (4-j))?
1662-		    letters[j+1] : '-';
1663-	}
1664:	causes[6] = enab[5] = flags[5] = '\0';
1665-
1666:	debug("cpu%i:   fcsr:  fcc=0x%02x%s cause=%s enables=%s flags=%s"
1667-	    " rm=%s\n", cpu->cpu_id,
1668-	    (int) (((f >> MIPS_FCSR_FCC0_SHIFT) & 1) |
1669-	    ((f >> (MIPS_FCSR_FCC1_SHIFT - 1)) & 0xfe)),
1670-	    f & MIPS_FPU_FLUSH_BIT? " fs" : "",
1671:	    causes, enab, flags, rmnames[f & MIPS_FPU_ROUNDING_BITS]);
1672-}
