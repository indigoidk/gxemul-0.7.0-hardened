+    note "jazz_vector probe produced no completion sentinel; last lines follow"
     tail -5 "$JVLOG" | sed 's/^/       /'
     check "jazz_vector probe completed" "no" "yes"
 else
     grep -E " ok$| FAIL$" "$JVLOG" | sed 's/^/       /'
