PSR_INDCLR = 0x80000000                          # MODE only, IND CLEAR: the indclr row's pre-fault PSR -- every other row starts with IND
                                                 #   already set, so `| M88K_PSR_IND' in the exception-path PSR write was unobservable (grok, codex, pass 3)
