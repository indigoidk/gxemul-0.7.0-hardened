The discriminator is POSITION, the same one `panel.sh:509-511` and this file's own `:384-388` already use for walls: a refusal is a diagnostic that TERMINATES the transcript (only the `codex exec` epilogue may follow); a quotation has prose after it. Census over all 5,387 seat-shaped files on disk (`v3/census_*.txt`): 100 carry the sentence, 46 carry it as a line-start diagnostic (ANSI-tolerant), 42 of those are terminal, and the 4 non-terminal ones are exactly the quoters -- `codex_adv544p1.txt`, `codex_ded544p2.txt`, `panel_20260919_015846/kimi.txt`, `panel_20260919_085144/kimi_refire.txt`. (grep reported `panel_20260923_184642/codex.txt` as "Binary file", a NUL byte; the Python harness reads it as terminal.) Astra's "92 / 44 / 48" counted a narrower file set; the units differ, the conclusion is the same.
"""Run every classifier variant over every panel-shaped directory on disk and diff the classes.

Writes nothing into any project tree: the variants' RECOVERED write is disabled by build_variants.py.
usage: population_run.py <variants dir> <out dir>
"""
import collections, contextlib, importlib.util, io, os, re, sys

VDIR, OUT = sys.argv[1], sys.argv[2]
ROOTS = ["C:/DocumentNoSnc/cc/GXEMUL/_scratchpad", "C:/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC/regress/artifacts"]
SEATFILES = ("codex.txt", "agy.txt", "grok.txt", "kimi.txt", "ollama_glm.txt", "ollama_deepseek.txt",
             "ollama_minimax.txt", "ollama_kimi.txt")


def population():
    dirs = set()
    # scratchpad: panel_* at depth 1 only (the rest of _scratchpad is not panel-shaped)
    sp = ROOTS[0]
    for name in os.listdir(sp):
        if name.startswith("panel_") and os.path.isdir(os.path.join(sp, name)):
            d = os.path.join(sp, name)
            if any(os.path.exists(os.path.join(d, f)) for f in SEATFILES):
                dirs.add(d)
    for root, subdirs, files in os.walk(ROOTS[1]):
        if any(f in files for f in SEATFILES):
            dirs.add(root.replace(os.sep, "/"))
    return sorted(dirs)


def load(name):
    spec = importlib.util.spec_from_file_location(name, os.path.join(VDIR, name + ".py"))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def run(mod, d):
    buf = io.StringIO()
    sys.argv = ["seat_verdicts.py", d]
    with contextlib.redirect_stdout(buf):
        mod.main()
    rows = {}
    for line in buf.getvalue().splitlines():
        if line.startswith("ROW\t"):
            _, seat, nbytes, novel, verdict, state = line.split("\t", 5)
            rows[seat] = (int(nbytes), verdict, state)
    return rows


def cls(state):
    s = state
    if s.startswith("answered, NO VERDICT"): return "format-miss"
    if s == "answered": return "answered"
    if "SEAT REFUSED" in s: return "refused"
    if "WALLED MID-ANSWER" in s: return "walled-mid"
    if "WALLED" in s: return "walled"
    if "SEAT DOWN" in s: return "down"
    if "RECOVERED" in s: return "recovered"
    if "ECHO ONLY" in s: return "echo-only"
    if "NOT CREATED" in s: return "absent"
    return "other:" + s[:30]


dirs = population()
print("population: %d directories" % len(dirs))
variants = ["sv_head", "sv_v3", "sv_v3b"]
results = {}
for v in variants:
    mod = load(v)
    res = {}
    for d in dirs:
        try:
            for seat, (nb, verdict, state) in run(mod, d).items():
                res[(d, seat)] = (nb, verdict, state)
        except Exception as ex:
            res[(d, "ERROR")] = (0, "-", "harness error: %r" % (ex,))
    results[v] = res
    with io.open(os.path.join(OUT, "classes_%s.tsv" % v), "w", encoding="utf-8", newline="\n") as f:
        for (d, seat), (nb, verdict, state) in sorted(res.items()):
            f.write("%s\t%s\t%d\t%s\t%s\n" % (d, seat, nb, verdict, state))
    c = collections.Counter(cls(st) for (_, _, st) in res.values())
    print("%-9s class counts: %s" % (v, dict(sorted(c.items()))))

head = results["sv_head"]


def anchored_lines(path):
    try:
        t = io.open(path, encoding="utf-8", errors="replace").read()
    except Exception:
        return "unreadable", []
    lines = t.splitlines()
    anc = [i + 1 for i, l in enumerate(lines) if re.match(r"^ERROR: (?:This content was flagged|.*Trusted Access for Cyber)", l)]
    last_codex = max([i + 1 for i, l in enumerate(lines) if l.strip() == "codex"] or [0])
    content = [l for l in lines if l.strip()]
    tail = " || ".join(l.strip()[:90] for l in content[-3:])
    return "lines=%d lastcodex=%d anchoredERROR=%s tail=[%s]" % (len(lines), last_codex, anc[:6], tail), anc


for v in ["sv_v3", "sv_v3b"]:
    res = results[v]
    chg = []
    vchg = []
    for key in sorted(set(head) | set(res)):
        h = head.get(key); r = res.get(key)
        if h is None or r is None:
            chg.append((key, "MISSING", h, r)); continue
        if cls(h[2]) != cls(r[2]):
            chg.append((key, "CLASS", h, r))
        elif h[1] != r[1]:
            vchg.append((key, h, r))
    with io.open(os.path.join(OUT, "changes_head_to_%s.txt" % v), "w", encoding="utf-8", newline="\n") as f:
        f.write("HEAD -> %s: %d class changes, %d verdict-only changes, over %d (dir,seat) rows\n" % (v, len(chg), len(vchg), len(head)))
        for key, kind, h, r in chg:
            d, seat = key
            info, _ = anchored_lines(os.path.join(d, seat + ".txt"))
            f.write("CLASS %s/%s: %s [%s] -> %s [%s]  %s\n" % (d.replace("C:/DocumentNoSnc/cc/GXEMUL/", ""), seat, cls(h[2]), h[1], cls(r[2]), r[1], info))
        for key, h, r in vchg:
            d, seat = key
            f.write("VERDICT %s/%s: %s -> %s\n" % (d.replace("C:/DocumentNoSnc/cc/GXEMUL/", ""), seat, h[1], r[1]))
    print("%-9s HEAD->: %d class changes, %d verdict-only changes" % (v, len(chg), len(vchg)))
print("done")

