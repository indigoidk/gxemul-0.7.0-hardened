            if [ "$rc" = 8 ]; then
                secs=$(grep -o 'AGY_RESET_SECONDS=[0-9]*' "$ARTS/$art/$id/agy_$id.launch.log" | tail -1 | cut -d= -f2)
                WALL_UNTIL=$(( $(date +%s) + ${secs:-3600} + 90 )); RETRY[$id]=1
                echo "WALLED on $id -- the seat says it resets in ${secs:-?} s; launching nothing until $(date -d @$WALL_UNTIL '+%F %H:%M:%S'); $id is retried then" | tee -a "$LOG"
            fi
            if [ "$rc" = 5 ]; then echo "SEAT FAILURE on $id (bad model/effort name) -- STOP written; fix the launcher and re-run" | tee -a "$LOG"; touch "$P/STOP"; fi
        fi
    done
}

