import json, sys, io, subprocess
REPO = "C:/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC"
HEAD = "e483d931"
def show(path):
    r = subprocess.run(["git", "-C", REPO, "show", "%s:%s" % (HEAD, path)], capture_output=True)
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None
def wt(path):
    try:
        return io.open(REPO + "/" + path, encoding="utf-8", errors="replace").read()
    except Exception:
        return None
def lineof(txt, needle):
    i = txt.find(needle)
    return txt[:i].count("\n") + 1 if i >= 0 else None
d560 = json.load(io.open(sys.argv[1], encoding="utf-8"))
d561 = json.load(io.open(sys.argv[2], encoding="utf-8"))
# 560: held = src/ comment edits + regress/diff_ieee_store.c edits (per 3d7c61bb's Held: 20) -- list every non-CHANGELOG/OUTSTANDING edit so the 20 can be identified
held560 = [e for e in d560["edits"] if e["path"].startswith("src/") or e["path"].startswith("regress/diff_ieee_store.c")]
others560 = [e for e in d560["edits"] if e not in held560 and not e["path"].startswith(("CHANGELOG.md", "OUTSTANDING_BUGS.md"))]
print("EDITS_560: %d edits; src/+diff_ieee_store = %d; other non-doc = %d" % (len(d560["edits"]), len(held560), len(others560)))
print("  other non-doc targets (are these among the 20 held?):")
for e in others560:
    t = show(e["path"]); w = wt(e["path"])
    old_in = (e["old"] in t) if t else None
    new_in = (e["new"] in t) if t else None
    print("    %-52s %-42s HEAD: old=%s new=%s   WT: old=%s new=%s" % (e["id"][:52], e["path"][:42], old_in, new_in, (e["old"] in w) if w else None, (e["new"] in w) if w else None))
def table(label, entries):
    print("==== %s (%d) ====" % (label, len(entries)))
    for e in entries:
        t = show(e["path"]); w = wt(e["path"])
        if t is None:
            print("  %-48s %-40s FILE ABSENT AT HEAD" % (e["id"][:48], e["path"][:40])); continue
        oc = t.count(e["old"]); nc = t.count(e["new"])
        woc = w.count(e["old"]) if w else -1; wnc = w.count(e["new"]) if w else -1
        if oc == 1 and nc == 0: st = "STILL APPLIES"
        elif oc == 0 and nc >= 1: st = "ALREADY APPLIED"
        elif oc == 0 and nc == 0: st = "MOOT/TEXT GONE"
        else: st = "AMBIGUOUS old=%d new=%d" % (oc, nc)
        ln = lineof(t, e["old"]) if oc else None
        print("  %-48s %-40s %-16s HEAD line %-6s | WT old=%d new=%d | kind=%s" % (e["id"][:48], e["path"][:40], st, ln, woc, wnc, e.get("kind")))
table("EDITS_560 src/ + diff_ieee_store.c (candidate held)", held560)
table("EDITS_561 held", d561["held"])
print("EDITS_561 edits (applied by 3d7c61bb?):")
for e in d561["edits"]:
    t = show(e["path"])
    if t is None: print("   %-48s %-40s ABSENT" % (e["id"][:48], e["path"][:40])); continue
    print("   %-48s %-40s HEAD old=%d new=%d" % (e["id"][:48], e["path"][:40], t.count(e["old"]), t.count(e["new"])))

import json, sys, io, subprocess
REPO = "C:/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC"; HEAD = "e483d931"
def show(path):
    r = subprocess.run(["git", "-C", REPO, "show", "%s:%s" % (HEAD, path)], capture_output=True)
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None
def wt(path):
    try: return io.open(REPO + "/" + path, encoding="utf-8", errors="replace").read()
    except Exception: return None
d = json.load(io.open(sys.argv[1], encoding="utf-8"))
print("held[0] keys:", list(d["held"][0].keys()))
print("edits[0] keys:", list(d["edits"][0].keys()))
for e in d["held"]:
    path = e.get("path") or e.get("file")
    old = e.get("old") or e.get("find") or e.get("from") or ""
    new = e.get("new") or e.get("replace") or e.get("to") or ""
    t = show(path); w = wt(path)
    if t is None: print("  %-36s %-36s ABSENT AT HEAD" % (e.get("id"), path)); continue
    oc, nc = t.count(old), t.count(new)
    st = "STILL APPLIES" if (oc == 1 and nc == 0) else ("ALREADY APPLIED" if (oc == 0 and nc >= 1) else ("MOOT/TEXT GONE" if oc == 0 else "AMBIGUOUS old=%d new=%d" % (oc, nc)))
    ln = t[:t.find(old)].count("\n") + 1 if oc else None
    print("  %-36s %-36s %-16s HEAD line %-6s | WT old=%d new=%d | why=%s" % (e.get("id"), path, st, ln, w.count(old) if w else -1, w.count(new) if w else -1, str(e.get("why",""))[:90]))
print("--- EDITS_561 edits (the 21 applied?) ---")
for e in d["edits"]:
    t = show(e["path"])
    if t is None: print("   %-40s %-40s ABSENT" % (e["id"][:40], e["path"][:40])); continue
    print("   %-40s %-40s HEAD old=%d new=%d" % (e["id"][:40], e["path"][:40], t.count(e["old"]), t.count(e["new"])))
print("--- EDITS_561 no_edit:", len(d.get("no_edit", [])))


