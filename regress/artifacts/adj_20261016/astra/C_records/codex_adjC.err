#!/bin/bash
#  agylaunch.sh <brief> <out-dir> <tag>  -- ONE agy seat job for the standalone agy pack (owner 2026-10-01: "Tons of
#  Agy credit; is there standalone package that Agy can do?").  gemini-3.8-flash-high at --effort high (owner directive
#  2026-08-13; `agy models` is the authority on names), --add-dir on GXEMUL-SEC so the seat can read the committed
#  tree, a short READ-ONLY prompt pointing at the brief file (agy has no stdin prompt mode).  Writes
#      <out-dir>/agy_<tag>.txt   the answer (agy writes NOTHING until it finishes -- a 0-byte file with a live
#                                 process is the normal mid-run state; never judge it by size)
#      <out-dir>/agy_<tag>.err   stderr -- where a QUOTA WALL lands: `Error: Individual quota reached ... Resets in
#                                 1h56m37s.` (111 bytes, immediate exit; measured 2026-08-30)
#  and prints ONE classification line, by CONTENT never size:
#      seat answered            VERDICT line present                                   exit 0
#      answered, NO VERDICT     real text, format miss -- read it                      exit 0
#      SEAT WALLED              quota text; also prints AGY_RESET_SECONDS=<n>          exit 8
#      SEAT FAILURE             bad model / effort name                               exit 5
#      EMPTY                    no stdout, no recognised error                         exit 6
#  AGY_BIN overrides the binary ONLY so the classification can be controlled with a stub (both directions).
set -u
BRIEF="$1"; OUT="$2"; TAG="$3"
AGY="${AGY_BIN:-$HOME/AppData/Local/agy/bin/agy}"
SEC=/c/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC
MODEL="${AGY_MODEL:-gemini-3.8-flash-high}"
EFFORT="${AGY_EFFORT:-high}"
mkdir -p "$OUT"
TXT="$OUT/agy_${TAG}.txt"; ERR="$OUT/agy_${TAG}.err"
echo "brief bytes: $(wc -c < "$BRIEF")   tag: $TAG   model: $MODEL/$EFFORT   $(date '+%F %T')"
PROMPT="You are one seat of a review panel for a C emulator fork (GXemul, hardened). READ-ONLY, always: write no file, run nothing, build nothing, change nothing anywhere -- your only output is the text you print. Read the brief at $(cygpath -w "$BRIEF") and answer it exactly as its own sections direct: its opening token and VERDICT line first, in its format, then every section it asks for, every claim cited path:line at the commit it names (read committed files with git show, never the working tree, never any other src/ copy under the project root). Print the whole answer to stdout; do not ask questions; do not stop early."
#  22:5x v2.4 pre-flight: a model name absent from `agy models` is a SEAT FAILURE before any quota is spent (C6/C7).
agy models 2>/dev/null | cut -f1 | grep -qxF "$MODEL" || { echo "  *** SEAT FAILURE: model '$MODEL' is not in \`agy models\`"; exit 5; }
"$AGY" --dangerously-skip-permissions --add-dir "$(cygpath -w "$SEC")" --print-timeout 45m \
    --model "$MODEL" --effort "$EFFORT" --print "$PROMPT" < /dev/null > "$TXT" 2> "$ERR"
rc=$?
body=$(wc -c < "$TXT")
echo "agy rc=$rc   stdout=$body b   stderr=$(wc -c < "$ERR") b   $(date '+%F %T')"
#  2026-10-13: stderr in FULL, the answer only in its FIRST THREE LINES -- a bad-model error precedes any answer, while a
#  real answer opens with the liveness token.  The old form grepped the whole answer and scored the cxlaunch_quota job
#  (an answer QUOTING panel.sh's seat-check regex) as a bad model name, and the runner STOPPED the pack on it: the
#  quoted-marker-re-arms-the-tool class (carrier), on this launcher.  Controlled both ways at the fix (HARVEST.md).
#  22:1x refinement (Fable 5.1 records adjudication, control C4): a FULL answer whose first lines quote the pattern must
#  not fail either, so the answer is consulted only when it is THIN (< 800 b, the size a real answer never has).
#  22:5x v2.4 (Fable 5.1 records reconciliation, measured on seven fixtures): STDERR ONLY -- agy's diagnostics land on
#  stderr (a quota wall is 408 b stderr / 0 b stdout) and an 84-byte healthy answer quoting the pattern is still an answer.
#  The thin-stdout clause and its control C3 are WITHDRAWN; the bad-model case is caught BEFORE launch by the pre-flight
#  below.  Receipt: regress/artifacts/agypack_20261013/launcher_controls_20261013_v2.txt
if grep -qiE 'unknown model|invalid model|unknown effort|invalid effort|model .* not found' "$ERR"; then
    echo "  *** SEAT FAILURE: bad model or effort name -- run \`agy models\`"; exit 5
fi
if grep -qiE 'quota reached|quota exceeded|rate limit|resource.?exhausted|429' "$ERR"; then
    reset=$(grep -oiE 'Resets in [0-9hms ]+' "$ERR" | head -1)
    secs=0
    h=$(echo "$reset" | grep -oE '[0-9]+h' | tr -d h); m=$(echo "$reset" | grep -oE '[0-9]+m' | tr -d m); s=$(echo "$reset" | grep -oE '[0-9]+s' | tr -d s)
    secs=$(( ${h:-0} * 3600 + ${m:-0} * 60 + ${s:-0} ))
    [ "$secs" -eq 0 ] && secs=3600
    echo "  *** SEAT WALLED (agy quota): $(tr -d '\r\n' < "$ERR" | cut -c1-160)"
    echo "AGY_RESET_SECONDS=$secs"
    exit 8
fi
if [ "$body" -eq 0 ]; then
    echo "  *** EMPTY STDOUT, cause not established (stderr: $(tr -d '\r\n' < "$ERR" | cut -c1-160))"; exit 6
fi
if grep -qi 'VERDICT' "$TXT"; then echo "  seat answered (VERDICT line present; answered by: $MODEL)."; else echo "  seat answered, NO VERDICT LINE (format miss) -- read it (answered by: $MODEL)."; fi
exit 0


 succeeded in 1348ms:
 *  -- the MIPS/SH bit order. The m88k gate pins both defences: its
 *  direction-pinned positive rows catch a straight missing swap (the
 *  same operands under 0x8000 and 0xc000 must land on opposite sides),
 *  and its sign-ASYMMETRIC rows additionally catch any sign-dependent
 *  mis-mapping a symmetric suite cannot see. The missing-swap mutant
 *  was built and run for real: 13 of 20, failing exactly those rows.
 *
 *  KNOWN-DIVERGENT band, pinned in gate 11 (a panel seat's find): the
 *  arms below compute in host double before the store, so a residue
 *  finer than 2^-53 collapses before a directed mode can see it --
 *  hardware's sticky bit would round 1.0 + 2^-60 UP under toward-+Inf
 *  (MC88100UM: sticky is the OR of ALL infinitely-precise result bits)
 *  where this model stores 1.0. Add/sub only; fmul's product is exact
 *  in double and a nonzero fdiv residue always survives; RN and RZ are
 *  unaffected. The remedy is the shared round-to-odd helper of the
 *  next round, not a rider here.
 *
 *  tmp_m88k_tail.c includes this file twice, but the second include
 *  sits under DYNTRANS_DUALMODE_32, which cpu_m88k.c never defines --
 *  so there is exactly ONE live inclusion today and this guard is
 *  future-proofing, same as the cpu_sh_instr.c helper.
 */
static int m88k_fp_rm(struct cpu *cpu)
{
	switch ((cpu->cd.m88k.fcr[M88K_FCR_FPCR] & M88K_FPCR_RM_MASK)
	    >> M88K_FPCR_RM_SHIFT) {
	case 1:  return IEEE_RM_RZ;
	case 2:  return IEEE_RM_RM;	/*  toward -Inf: the swap  */
	case 3:  return IEEE_RM_RP;	/*  toward +Inf: the swap  */
	default: return IEEE_RM_RN;
	}
}
#endif

X(fadd_sss)
{
	struct ieee_float_value f1;
	struct ieee_float_value f2;
	uint32_t d;
	uint32_t s2 = reg(ic->arg[2]);
	uint32_t s1 = reg(ic->arg[1]);

	if (cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_SFD1) {
		SYNCH_PC;
		cpu->cd.m88k.fcr[M88K_FPCR_FPECR] = M88K_FPECR_FUNIMP;
		m88k_exception(cpu, M88K_EXCEPTION_SFU1_PRECISE, 0);
		return;
	}

	ieee_interpret_float_value(s1, &f1, IEEE_FMT_S);
	ieee_interpret_float_value(s2, &f2, IEEE_FMT_S);

	/*  #299: sum via round-to-odd so the store rounds correctly in every
	    mode -- this is the row gate 11 pinned as known-divergent, now
	    fixed (see float_emul.c).  */
	d = ieee_store_float_value_rm(
	    ieee_sum_round_to_odd(f1.f, f2.f, m88k_fp_rm(cpu)),
	    IEEE_FMT_S, m88k_fp_rm(cpu));

	reg(ic->arg[0]) = d;
}
X(fadd_dss)
{
	struct ieee_float_value f1;
	struct ieee_float_value f2;
		case REGIMM_TEQI:
		case REGIMM_TNEI:
			switch (rt) {
			case REGIMM_TGEI:	ic->f = instr(tgei); break;
			case REGIMM_TGEIU:	ic->f = instr(tgeiu); break;
			case REGIMM_TLTI:	ic->f = instr(tlti); break;
			case REGIMM_TLTIU:	ic->f = instr(tltiu); break;
			case REGIMM_TEQI:	ic->f = instr(teqi); break;
			case REGIMM_TNEI:	ic->f = instr(tnei); break;
			}
			ic->arg[0] = (size_t)&cpu->cd.mips.gpr[rs];
			ic->arg[2] = (int64_t)(int16_t)imm;

			if (cpu->cd.mips.cpu_type.isa_level < 32) {
				static int warning = 0;
				if (!warning && !cpu->translation_readahead) {
					fatal("[ WARNING! Trap opcode used, but"
					    " the %s processor does not implement "
					    "such instructions. Only printing this "
					    "warning once. ]\n",
					    cpu->cd.mips.cpu_type.name);
					warning = 1;
				}
				ic->f = instr(reserved);
			}
			break;

		default:/*
			 *  #309: an unimplemented REGIMM sub-opcode is a
			 *  RESERVED INSTRUCTION, not a reason to stop the
			 *  machine.  `goto bad` reaches the shared label in
			 *  cpu_dyntrans.c, which sets cpu->running = 0 -- so
			 *  before this, a guest executing any rt outside the
			 *  implemented set (4-7, 0xd, 0xf, 0x14-0x17,
			 *  0x1a-0x1e) halted the emulator instead of taking
			 *  the exception real silicon takes.  Reproduced on
			 *  both rigs with rt=0x15; the same encoding now
			 *  raises RI and the guest kernel decides what to do.
			 *
			 *  The shape is the tree's own, two arms above: the
			 *  trap opcodes on a pre-MIPS32 CPU already resolve to
			 *  instr(reserved) behind a latched warning.  Upstream
			 *  reached the same conclusion independently in the
			 *  0.7.1 line it never released.
			 *
			 *  The warning is latched rather than verbosity-gated
			 *  because it reports a DEFICIENCY of the emulator
			 *  (an opcode nobody implemented), which #279 argues
			 *  should survive into a quiet run exactly once --
			 *  unlike #276's guest-answered diagnostics, which are
			 *  gated.  translation_readahead still takes the old
			 *  path: speculative decoding must not warn at all.
			 */
			if (cpu->translation_readahead)
				goto bad;
			else {
				static int warned_regimm = 0;
				if (!warned_regimm) {
					warned_regimm = 1;
					debugmsg_cpu(cpu, SUBSYS_CPU, "opcode",
					    VERBOSITY_WARNING,
					    "unimplemented REGIMM rt=%i -- "
					    "raising Reserved Instruction. "
					    "Only printing this once.", rt);
				}
				ic->f = instr(reserved);
			}
			break;
		}
		break;
#define	DEV_SGI_IP30_LENGTH		0x80000

/*
 *  #531: warn-once latches, ONE BIT PER DISTINCT MESSAGE.  The struct is
 *  memset(0) at DEVINIT (as dev_pcc2.c and dev_wdc.c do), so these start clear.
 *
 *  SIX announce paths share TWO bits, and that is deliberate: IP30_W_ISR covers
 *  FIVE (0x10020 write and read, 0x10028 write and read, 0x10030 write), which
 *  all print the SAME string byte for byte.
 *
 *  THE INVARIANT IS THAT LATCH GRANULARITY MATCHES THE MARKER'S QUALIFICATION.
 *  Both messages end in an UNQUALIFIED "(once)", which claims exactly one
 *  emission per device instance -- so one bit apiece is what makes the marker
 *  true.  Reporting each offset separately would be a different promise: it
 *  would need the qualified spelling this tree also uses ("(once per offset per
 *  direction)") and five bits on the ISR side.  Do not add bits without
 *  changing the strings; do not qualify the strings without adding bits.
 *
 *  TWO BITS RATHER THAN ONE, AND THE REASON IS MEASURABLE: a single shared bit
 *  would let an ordinary guest write to Set-ISR silence the TIMER diagnostic
 *  forever, because the first ISR-side announce would consume it.  The two are
 *  different messages reached by unrelated guest actions, and must latch apart.
 */
#define	IP30_W_TICK	(1 << 0)	/*  #531: DEVICE_TICK delivery  */
