        if ! kill -0 "${PID[$id]}" 2>/dev/null; then
            wait "${PID[$id]}"; rc=$?
            art=${ARTOF[$id]}
            unset "PID[$id]"; unset "ARTOF[$id]"
            printf '%s\t%s\t%s\trc=%s\t%s b\t%s\n' "$(date '+%F %H:%M:%S')" "$art" "$id" "$rc" \
