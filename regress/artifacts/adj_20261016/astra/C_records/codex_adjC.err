        [ -f "$ARTS/$art/briefs/$id.md" ] || { [ "$pass" = 1 ] && echo "MISSING BRIEF: $ARTS/$art/briefs/$id.md -- skipped" | tee -a "$LOG"; continue; }
        while :; do
