1168: DEVICE_ACCESS(wdc)
1169: {
1170: 	struct wdc_data *d = (struct wdc_data *) extra;
1171: 	uint64_t idata = 0, odata = 0;
1172: 	int i;
1173: 
1174: 	relative_addr /= d->addr_mult;
1175: 
1176: 	if (!d->io_enabled)
1177: 		goto ret;
1178: 
1179: 	if (writeflag == MEM_WRITE) {
1180: 		if (relative_addr == wd_data)
1181: 			idata = memory_readmax64(cpu, data, len);
1182: 		else {
1183: 			/*  #464: latch the announcement; `idata = data[0]`
1184: 			    is the repair and stays outside the guard.  */
1185: 			if (len != 1 && !d->warned_nonbyte_write) {
1186: 				d->warned_nonbyte_write = 1;
1187: 				fatal("[ wdc: WARNING! non-8-bit access on "
1188: 				    "WRITE! ]\n");
1189: 			}
1190: 			idata = data[0];
1191: 		}
1192: 	}
1193: 
1194: 	switch (relative_addr) {
1195: 
1196: 	case wd_data:	/*  0: data  */
1197: 		if (writeflag == MEM_READ) {
1198: 			odata = wdc_get_inbuf(d);
1199: 
1200: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1201: 				if (len >= 2)
1202: 					odata += (wdc_get_inbuf(d) << 8);
1203: 				if (len == 4) {
1204: 					odata += (wdc_get_inbuf(d) << 16);
1205: 					odata += (wdc_get_inbuf(d) << 24);
1206: 				}
1207: 			} else {
1208: 				if (len >= 2)
1209: 					odata = (odata << 8) + wdc_get_inbuf(d);
1210: 				if (len == 4) {
1211: 					odata = (odata << 8) + wdc_get_inbuf(d);
1212: 					odata = (odata << 8) + wdc_get_inbuf(d);
1213: 				}
1214: 			}
1215: 
1216: 			if (d->data_debug) {
1217: 				const char *s = "0x%04" PRIx64" ]\n";
1218: 				if (len == 1)
1219: 					s = "0x%02" PRIx64" ]\n";
1220: 				if (len == 4)
1221: 					s = "0x%08" PRIx64" ]\n";
1222: 				if (len == 8)
1223: 					s = "0x%016" PRIx64" ]\n";
1224: 				debug("[ wdc: read from DATA: ");
1225: 				debug(s, (uint64_t) odata);
1226: 			}
1227: 
1228: 			if (d->atapi_cmd_in_progress) {
1229: 				/*  #341: account for what was actually CONSUMED
1230: 				    from the buffer, not for what the guest
1231: 				    asked for. The reads above take one byte,
1232: 				    two if len >= 2, four only if len == 4 --
1233: 				    so a 3- or 8-byte access consumes 2 (widths
1234: 				    1..8 ATTEMPT 1, 2, 2, 4, 2, 2, 2, 2 pops --
1235: 				    those are CALL counts, and the pops succeed
1236: 				    only while bytes remain: wdc_get_inbuf()
1237: 				    returns (uint64_t) -1 on an empty ring
1238: 				    WITHOUT advancing the tail, so with q bytes
1239: 				    queued a width-w access pops min(q, calls).
1240: 				    "1 or 2" until 2026-09-05; the unqualified
1241: 				    pop counts until 2026-09-06, when a pass-2
1242: 				    seat read the helper instead of this
1243: 				    comment.  NOTE `consumed' below is computed
1244: 				    from `len' alone and so counts ATTEMPTS
1245: 				    too -- row wdcconsumedattempts)
1246: 				    while `len` says 3 or 8. Subtracting the
1247: 				    requested length let atapi_len step PAST
1248: 				    zero, which its `== 0` test then never
1249: 				    catches, so PHASE_COMPLETED never fires and
1250: 				    the guest is told a transfer is further
1251: 				    along than the bytes it received. Same
1252: 				    truthfulness defect as #283 in the ASC and
1253: 				    #338 in the mb89352: the count reported has
1254: 				    to be the count that happened.  */
1255: 				int consumed = len == 4 ? 4 : (len >= 2 ? 2 : 1);
1256: 				/*  #475: clamp to what REMAINS, not just to what was popped.
1257: 				    #341 fixed `consumed` to count the POPS rather than the
1258: 				    requested length; it did not stop the subtraction STEPPING
1259: 				    PAST ZERO.  With an odd remainder -- and the length is a
1260: 				    guest-chosen allocation byte -- a 4-byte read of an odd
1261: 				    remainder drove atapi_len NEGATIVE, so `== 0` never fired
1262: 				    again and the command never completed, while atapi_received
1263: 				    claimed more bytes than the transfer holds.  Two distinct
1264: 				    numbers, and conflating them is easy: the 3-byte fixture
1265: 				    lands on -1; the worked INQUIRY-37 path lands on -3 (nine
1266: 				    4-byte reads leave 1, the tenth takes 4).
1267: 
1268: 				    CLAMPING `consumed` RATHER THAN SATURATING atapi_len,
1269: 				    because atapi_received has two live MID-TRANSFER consumers:
1270: 				    the re-arm's length, and the refill's source offset
1271: 				    data_in[atapi_received + j].  Saturating repairs completion
1272: 				    and leaves those two reading a skewed offset, permanently
1273: 				    skipping up to 3 real bytes -- #283's defect shape,
1274: 				    re-created.
1275: 
1276: 				    A NEARBY PRECEDENT, cited narrowly on purpose: dev_asc.c
1277: 				    clamps a step to a remainder before its move.  An earlier
1278: 				    draft of this comment called that #283 and called it
1279: 				    'exactly this shape'; a panel seat refuted both.  #283 tags
1280: 				    the RESIDUAL REPORTING there (`programmed`/`moved`) -- its
1281: 				    own comment says it snapshots the count 'before the clamps
1282: 				    below rewrite len2', so the clamp is untagged upstream code.
1283: 				    And the shapes differ: dev_asc clamps the TRANSFER before
1284: 				    the move, while this clamps the ACCOUNTING and lets the pop
1285: 				    happen at full width.  The in-tree precedent for clamping
1286: 				    the transfer is a DIFFERENT option, which this round
1287: 				    considered and did not take.
1288: 
1289: 				    The warrant that survives is the one above: the cursor.  */
1290: 				if (consumed > d->atapi_len)
1291: 					consumed = d->atapi_len;
1292: 
1293: 				d->atapi_len -= consumed;
1294: 				d->atapi_received += consumed;
