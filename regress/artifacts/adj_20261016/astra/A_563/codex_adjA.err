397: 		stub_res_nodata_hits ++;	/*  REPAIR2: names the branch  */
398: 		return 1;
399: 	}
400: 	if (stub_res_dataout)
401: 		return 2;
402: 	if (stub_datain_len <= 0)
403: 		return 0;
404: 
405: 	/*  One DATA-IN transfer, marked so the caller can tell WHICH bytes
406: 	    survived: byte 0 alone carries 0x5a, everything else 0xc3 -- or stub_pat(i)
407: 	    while stub_datain_pattern is set (#563).  A ring
408: 	    overrun wraps block 514 onto block 0, so the first byte popped
409: 	    becomes 0xc3 and the marker is destroyed.  */
410: 	xferp->data_in = (unsigned char *) malloc(stub_datain_len + STUB_SLACK);
411: 	if (xferp->data_in == NULL)
412: 		return 0;
413: 	for (i = 0; i < (size_t) stub_datain_len; i++)
414: 		xferp->data_in[i] = stub_datain_pattern ? stub_pat(i) : 0xc3;
415: 	memset(xferp->data_in + stub_datain_len, 0xee, STUB_SLACK);
416: 	xferp->data_in[0] = 0x5a;
417: 	xferp->data_in_len = stub_datain_len;
418: 	return 1;
6628: static void dispatch_result_case(const char *name, int mode)
6629: {
6630: 	struct wdc_data d;
6631: 	struct scsi_transfer *stale = NULL;
6632: 	unsigned char *stale_buf = NULL, buf[4];
6633: 	int ireason, lo, hi, occ, ok, irq, hits = 0, status = 0, irq2 = 0, ireason2 = 0, status2 = 0, ph1;
6634: 	size_t k;
6635: 
6636: 	rep_fresh(&d);
6637: 	if (d.inbuf == NULL) { printf("  SETUP %s inbuf failed\n", name); return; }
6638: 	d.atapi_len = 100;		/*  an abandoned transfer's count; the dispatch must zero it  */
6639: 	if (mode == DR_NODATA || mode == DR_DATAOUT) {
6640: 		/*  REPAIR3: ...and the abandoned transfer itself, which the dispatch must FREE, not reuse  */
6641: 		stale = scsi_transfer_alloc();
6642: 		stale_buf = (unsigned char *) malloc(200 + STUB_SLACK);
6643: 		if (stale == NULL || stale_buf == NULL) {
6644: 			printf("  SETUP %s stale transfer failed\n", name);
6645: 			free(stale); free(stale_buf); rep_free(&d); return;
6646: 		}
6647: 		for (k = 0; k < 200; k++)
6648: 			stale_buf[k] = stub_pat(k);
6649: 		memset(stale_buf + 200, 0xee, STUB_SLACK);
6650: 		stale->data_in = stale_buf;
6651: 		stale->data_in_len = 200;
6652: 		d.atapi_st = stale;
6653: 		d.atapi_received = 100;
6654: 	}
6655: 	stub_res_nodata = mode == DR_NODATA;
6656: 	stub_res_dataout = mode == DR_DATAOUT;
6657: 	stub_res_reject = mode == DR_REJECT;
6658: 	stub_res_zerolen = mode == DR_ZEROLEN;
6659: 	stub_res_nodata_hits = stub_res_reject_hits = stub_res_zerolen_hits = 0;
6660: 	rep_dispatch(&d);		/*  resets rep_asserts before the 12th CDB byte  */
6661: 	irq = rep_asserts;		/*  sampled before any register read  */
6662: 	ph1 = d.atapi_phase;
6663: 	if (mode == DR_NODATA)
6664: 		hits = stub_res_nodata_hits;
6665: 	else if (mode == DR_REJECT)
6666: 		hits = stub_res_reject_hits;
6667: 	else if (mode == DR_ZEROLEN)
6668: 		hits = stub_res_zerolen_hits;
6669: 	stub_res_nodata = stub_res_dataout = stub_res_reject = stub_res_zerolen = 0;
6670: 	occ = rep_occ(&d);
6671: 	ireason = rep_reg(&d, wd_seccnt);
6672: 	lo = rep_reg(&d, wd_cyl_lo);
6673: 	hi = rep_reg(&d, wd_cyl_hi);
6674: 	if (mode == DR_ZEROLEN) {
6675: 		status = rep_reg(&d, wd_command);	/*  last: a STATUS read acknowledges the interrupt  */
6676: 		rep_asserts = 0;
6677: 		memset(buf, 0, sizeof(buf));
6678: 		dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_READ, &d);	/*  width 2  */
6679: 		irq2 = rep_asserts;
6680: 		ireason2 = rep_reg(&d, wd_seccnt);
6681: 		status2 = rep_reg(&d, wd_command);
6682: 	}
6683: 	if (mode == DR_NODATA)
6684: 		ok = ireason == (WDCI_CMD | WDCI_IN) && d.atapi_phase == PHASE_COMPLETED &&
6685: 		    lo == 0 && hi == 0 && occ == 0 && irq == 1 && hits == 1 && d.warned_atapi_err == 0;
6686: 	else if (mode == DR_REJECT)
6687: 		ok = ireason == (WDCI_CMD | WDCI_IN) && d.atapi_phase == PHASE_COMPLETED &&
6688: 		    lo == 0 && hi == 0 && occ == 0 && irq == 1 && hits == 1 && d.warned_atapi_err == 1;
6689: 	else if (mode == DR_ZEROLEN)
6690: 		ok = ph1 == PHASE_DATAIN && ireason == WDCI_IN && (status & WDCS_DRQ) != 0 &&
6691: 		    lo == 0 && hi == 0 && occ == 0 && irq == 1 && hits == 1 && d.atapi_phase == PHASE_COMPLETED &&
6692: 		    ireason2 == (WDCI_CMD | WDCI_IN) && (status2 & WDCS_DRQ) == 0 && irq2 == 1;
6693: 	else
6694: 		ok = ireason == 0 && d.atapi_phase == PHASE_DATAOUT && occ == 0 && irq == 1;
6695: 	rows ++;
6696: 	if (!ok) {
6697: 		printf("  FAIL %-38s phase 0x%x ireason 0x%02x count 0x%02x%02x occ %i irq %i stub-hits %i"
6698: 		    " latch %i status 0x%02x / then phase 0x%x 0x%02x 0x%02x irq %i\n",
6699: 		    name, ph1, ireason, hi, lo, occ, irq, hits, d.warned_atapi_err, status,
6700: 		    d.atapi_phase, ireason2, status2, irq2);
6701: 		failures ++;
6702: 	} else {
6703: 		printf("  ok   %-38s 0x%02x\n", name, ireason);
6704: 	}
6705: 	/*  the stale buffer: freed here unless the device kept the transfer that carries it  */
6706: 	if (stale_buf != NULL && (d.atapi_st == NULL || d.atapi_st->data_in != stale_buf))
6707: 		free(stale_buf);
6708: 	rep_free(&d);
6709: }
