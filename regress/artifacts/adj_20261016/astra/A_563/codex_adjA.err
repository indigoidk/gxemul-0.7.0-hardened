6937: static void row_io_disabled(void)
6938: {
6939: 	struct wdc_data d;
6940: 	unsigned char buf[4];
6941: 	int old_on, old_off, c_off, o_off, irq_off, ir_off, len_off, occ_off, v_off;
6942: 	int c_on, o_on, len_on, occ_on, v_on;
6943: 
6944: 	rep_fresh(&d);
6945: 	if (d.inbuf == NULL) { printf("  SETUP io inbuf failed\n"); return; }
6946: 	cdb_cmdout(&d, 10);
6947: 	d.seccnt = 0x5a;			/*  what SECCNT holds; a disabled read must not return it  */
6948: 	stub_datain_len = 64;			/*  the dispatch, when it happens, arms 64 bytes  */
6949: 	stub_scsi_cmds = 0;
6950: 	old_on = wdc_set_io_enabled(&d, 0);
6951: 	d.int_assert = 1;			/*  an interrupt pending: a disabled access must not tick it  */
6952: 	rep_asserts = 0;
6953: 	memset(buf, 0, sizeof(buf));
6954: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_WRITE, &d);	/*  refused  */
6955: 	c_off = stub_scsi_cmds;
6956: 	o_off = rep_occ(&d);
6957: 	memset(buf, 0xa5, sizeof(buf));
6958: 	dev_wdc_access(fake_cpu(), NULL, wd_seccnt, buf, 1, MEM_READ, &d);	/*  refused: the tail writes 0  */
6959: 	ir_off = buf[0];
6960: 	irq_off = rep_asserts;			/*  over both disabled accesses: neither may tick  */
6961: 	old_off = wdc_set_io_enabled(&d, 1);
6962: 	d.int_assert = 0;
6963: 	memset(buf, 0, sizeof(buf));
6964: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_WRITE, &d);	/*  -> 12: dispatch  */
6965: 	c_on = stub_scsi_cmds;
6966: 	o_on = rep_occ(&d);
6967: 	stub_datain_len = 0;
6968: 	wdc_set_io_enabled(&d, 0);
6969: 	memset(buf, 0xa5, sizeof(buf));
6970: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_READ, &d);	/*  refused: the tail writes 0  */
6971: 	len_off = d.atapi_len;
6972: 	occ_off = rep_occ(&d);
6973: 	v_off = buf[0] | (buf[1] << 8);
6974: 	wdc_set_io_enabled(&d, 1);
6975: 	memset(buf, 0, sizeof(buf));
6976: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_READ, &d);	/*  width 2: 0x5a 0xc3  */
6977: 	len_on = d.atapi_len;
6978: 	occ_on = rep_occ(&d);
6979: 	v_on = buf[0] | (buf[1] << 8);
6980: 	rows ++;
6981: 	if (old_on != 1 || c_off != 0 || o_off != 10 || irq_off != 0 || ir_off != 0 || len_off != 64 ||
6982: 	    occ_off != 64 || v_off != 0 || old_off != 0 || c_on != 1 || o_on != 64 || len_on != 62 ||
6983: 	    occ_on != 62 || v_on != 0x5ac3) {
6984: 		printf("  FAIL %-38s off: sent %i occ %i irq %i seccnt 0x%02x len %i occ %i read 0x%04x;"
6985: 		    " on: sent %i occ %i len %i occ %i read 0x%04x\n",
6986: 		    "io_enabled: refused off, lands on", c_off, o_off, irq_off, ir_off, len_off, occ_off, v_off,
6987: 		    c_on, o_on, len_on, occ_on, v_on);
6988: 		failures ++;
6989: 	} else {
6990: 		printf("  ok   %-38s %i %i\n", "io_enabled: refused off, lands on", len_off, len_on);
6991: 	}
6992: 	rep_free(&d);
7008: static void row_rearm_guard_edge(void)
7009: {
7010: 	struct wdc_data d;
7011: 	unsigned char buf[4];
7012: 	int irq, occ, ireason, len;
7013: 
7014: 	rep_fresh(&d);
7015: 	if (d.inbuf == NULL) { printf("  SETUP guard-edge inbuf failed\n"); return; }
7016: 	stub_datain_len = 5;
7017: 	rep_dispatch(&d);			/*  arms 5 bytes  */
7018: 	stub_datain_len = 0;
7019: 	(void) rep_reg(&d, wd_command);		/*  STATUS: the dispatch's interrupt acknowledged  */
7020: 	rep_asserts = 0;
7021: 	memset(buf, 0, sizeof(buf));
7022: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 4, MEM_READ, &d);	/*  width 4: one byte left  */
7023: 	irq = rep_asserts;			/*  before any register read  */
7024: 	len = d.atapi_len;
7025: 	occ = rep_occ(&d);
7026: 	ireason = rep_reg(&d, wd_seccnt);
7027: 	rows ++;
7028: 	if (len != 1 || occ != 1 || irq != 0 || d.atapi_phase != PHASE_DATAIN || ireason != WDCI_IN) {
7029: 		printf("  FAIL %-38s len %i occ %i irq %i phase 0x%x ireason 0x%02x, want 1/1/0/DATAIN/0x02\n",
7030: 		    "re-arm guard: 1 left does not fire", len, occ, irq, d.atapi_phase, ireason);
7031: 		failures ++;
7032: 	} else {
7033: 		printf("  ok   %-38s %i\n", "re-arm guard: 1 left does not fire", occ);
7034: 	}
7035: 	rep_free(&d);
7036: }
7037: 
7038: /*  #563 REPAIR3: THE READ ARM'S OTHER BRANCH.  `if (d->atapi_cmd_in_progress)' dominates the re-arm, and
7039:     `if (1)' passed all 150 rows of REPAIR2 (P1): no row read PIO data through the handler.  Its other
7040:     arm is guest-visible -- after each data read it asserts the per-sector interrupt when one sector has
7041:     been drained and another waits (`tail != head && (tail - head) % 512 == 0').  Two sectors queued as an
7042:     ATA READ leaves them, with the flag CLEAR; 256 2-byte reads drain the first: no interrupt before the
7043:     256th, exactly one at it, 512 bytes left, and no ATAPI no-transfer latch.  Under `if (1)' every read
7044:     takes the ATAPI accounting with atapi_len 0 and no transfer: the no-transfer latch fires and the
7045:     sector interrupt is lost.  (With ONE sector queued the boundary interrupt never fires -- the ring is
7046:     empty at the 256th read -- so the row queues two.)  Graded FLOOR by the 2026-10-13 adjudication (an
7047:     `if' whose arms both set guest-visible state owes its branch partition), (e) under GPT-6 Astra's split
7048:     of P1/P2/P6: rowed either way, both gradings on the record until the owner rules.  */
7049: static void row_pio_sector_irq(void)
7050: {
7051: 	struct wdc_data d;
7052: 	unsigned char buf[4];
7053: 	int i, a255, a256, occ;
7054: 
7055: 	rep_fresh(&d);
7056: 	if (d.inbuf == NULL) { printf("  SETUP pio inbuf failed\n"); return; }
7057: 	for (i = 0; i < 1024; i++)		/*  two sectors; atapi_cmd_in_progress is 0  */
7058: 		wdc_addtoinbuf(&d, i & 0xff);
7059: 	rep_asserts = 0;
7060: 	for (i = 0; i < 255; i++) {
7061: 		memset(buf, 0, sizeof(buf));
7062: 		dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_READ, &d);	/*  width 2  */
7063: 	}
7064: 	a255 = rep_asserts;
7065: 	memset(buf, 0, sizeof(buf));
7066: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_READ, &d);	/*  the 256th: sector 1 drained  */
7067: 	a256 = rep_asserts;
7068: 	occ = rep_occ(&d);
7069: 	rows ++;
7070: 	if (a255 != 0 || a256 != 1 || occ != 512 || d.warned_null_xfer) {
7071: 		printf("  FAIL %-38s irq %i before, %i at the boundary; occ %i; no-transfer latch %i\n",
7072: 		    "PIO read: one sector interrupt", a255, a256, occ, d.warned_null_xfer);
7073: 		failures ++;
7074: 	} else {
7075: 		printf("  ok   %-38s %i\n", "PIO read: one sector interrupt", a256);
7076: 	}
7077: 	rep_free(&d);
7078: }
7138: static void write_route_case(const char *name, int w, int byte_order, int fill)
7139: {
7140: 	struct wdc_data d;
7141: 	unsigned char buf[8];
7142: 	int i, occ, first;
7143: 
7144: 	memset(&d, 0, sizeof(d));
7145: 	d.addr_mult  = 1;
7146: 	d.io_enabled = 1;
7147: 	d.inbuf = (unsigned char *) calloc(1, WDC_INBUF_SIZE);
7148: 	d.irq.interrupt_assert = arm_sink;
7149: 	if (d.inbuf == NULL) { printf("  SETUP %s inbuf failed\n", name); return; }
7150: 	stub_byte_order = byte_order;
7151: 	d.cur_command = ATAPI_PKT_CMD;
7152: 	d.atapi_cmd_in_progress = 1;
7153: 	d.atapi_phase = PHASE_CMDOUT;
7154: 	for (i = 0; i < 10; i++)
7155: 		wdc_addtoinbuf(&d, 0x00);
7156: 	stub_datain_len = 65536;
7157: 	memset(buf, 0, sizeof(buf));
7158: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, 2, MEM_WRITE, &d);
7159: 	stub_datain_len = 0;
7160: 	for (i = 0; i < (32768 - w) / w; i++)	/*  chunk 1 down to its last w bytes, read at width w  */
7161: 		dev_wdc_access(fake_cpu(), NULL, wd_data, buf, w, MEM_READ, &d);
7162: 	memset(buf, fill, sizeof(buf));		/*  the out-of-protocol store  */
7163: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, w, MEM_WRITE, &d);
7164: 	dev_wdc_access(fake_cpu(), NULL, wd_data, buf, w, MEM_READ, &d);	/*  -> re-arm  */
7165: 	stub_byte_order = 0;
7166: 	occ = d.inbuf_head - d.inbuf_tail;
7167: 	while (occ < 0)
7168: 		occ += WDC_INBUF_SIZE;
7169: 	first = d.inbuf[d.inbuf_tail];
7170: 	rows ++;
7171: 	if (occ != 32768 || first != 0xc3) {
7172: 		printf("  FAIL %-38s occ %i first 0x%02x, want 32768 / c3\n", name, occ, first);
7173: 		failures ++;
7174: 	} else {
7175: 		printf("  ok   %-38s %i 0x%02x\n", name, occ, first);
7176: 	}
7177: 	if (d.atapi_st != NULL) {
7178: 		free(d.atapi_st->data_in);
7179: 		free(d.atapi_st->cmd);
7180: 		free(d.atapi_st);
7181: 	}
7182: 	free(d.inbuf);
7183: }
