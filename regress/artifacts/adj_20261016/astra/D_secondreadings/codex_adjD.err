#include <stdio.h>
#include <stdlib.h>
#include <errno.h>
#include <string.h>
#include <sys/types.h>
int main(void) {
	void *p0 = malloc(0);
	printf("malloc(0) -> %s\n", p0 ? "non-NULL" : "NULL");
	void *p = malloc(16);
	errno = 0;
	void *r = realloc(p, 0);
	printf("realloc(p,0) -> %s (errno=%d)\n", r ? "non-NULL" : "NULL", errno);
	FILE *f = tmpfile();
