--- a/regress/gate_asan_sweep.sh
+++ b/regress/gate_asan_sweep.sh
@@ -88,6 +88,48 @@
 set -u
 HERE=$(cd "$(dirname "$0")" && pwd)
 . "$HERE/lib.sh"
+
+#  asanexit1subtype. diedby() maps exit 1 to ok because the dummy ELF exits 1
+#  AFTER construction. A subtype that exits 1 with no cpu:/memory: lines is a
+#  different event, and :410-418 is satisfied by any sibling that did construct.
+#  Bare forms ("-") stay out of this set: they legitimately refuse without -e.
+#  Lines are: type subtype rc built. subtype "-" is the bare row.
+classify_exit1_hidden() {
+    local t s rc b built_types="" unbuilt="" key hidden=""
+    while read -r t s rc b; do
+        [ -n "${t:-}" ] || continue
+        if [ "$b" = yes ]; then
+            case " $built_types " in *" $t "*) ;; *) built_types="$built_types $t" ;; esac
+        fi
+        if [ "$rc" = 1 ] && [ "$b" != yes ] && [ -n "$s" ] && [ "$s" != "-" ]; then
+            unbuilt="$unbuilt $t/$s"
+        fi
+    done
+    for key in $unbuilt; do
+        t=${key%%/*}
+        case " $built_types " in *" $t "*) hidden="$hidden $key" ;; esac
+    done
+    printf '%s' "${hidden# }"
+}
+
+if [ "${1-}" = --classify ]; then
+    hidden=$(classify_exit1_hidden)
+    if [ -n "$hidden" ]; then
+        printf 'FAIL exit-1 subtype hidden by a constructing sibling: %s\n' "$hidden"
+        exit 1
+    fi
+    printf 'ok exit-1 subtype hidden by a constructing sibling: none\n'
+    exit 0
+fi
 
 ASAN_HEAD=/tmp/gx-asan-head/gxemul
 ASAN_PRI=/tmp/gx-asan-pristine/gxemul
@@ -334,6 +376,7 @@
