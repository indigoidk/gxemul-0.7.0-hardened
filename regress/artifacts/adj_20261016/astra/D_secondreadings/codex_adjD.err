#!/usr/bin/env bash
# Emits the panel/round reminder as hook JSON. $1 = session | task
# Wired from .claude/settings.local.json for SessionStart and TaskCompleted.
case "${1:-session}" in
session)
  cat <<'JSON'
{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"GXemul hardened fork: the NINE-seat review panel is MANDATORY on every task, research task, and review -- pass 1 on the design brief BEFORE editing, pass 2 on the diff AFTER. Invoke it as `bash GXEMUL-SEC/tools/panel.sh <ABSOLUTE brief path>`, NEVER ./panel.sh -- the session cwd drifts and a relative launch dies silently with zero seats, which looks like a completed run. It fires the scriptable seats -- codex, kimi, grok and the Ollama cloud thinking models (never send those a num_predict cap) -- and agy ONLY when PANEL_FIRE_AGY is set: the owner's directive of 2026-09-15 is to set it on every launch (PANEL_FIRE_AGY=1 bash GXEMUL-SEC/tools/panel.sh <ABSOLUTE brief path>), and with it the scriptable seats plus the two Agent seats make the nine; the kimi CLI and its Ollama substitute are two transports for ONE seat. THIS TEXT NAMES NO MODEL OR EFFORT ON PURPOSE: it once named three that had since changed. Read them from the tool: grep -nE '^(CODEX_EFFORT|GROK_MODEL|AGY_MODEL|OLLAMA[0-9])=|exec .* -m ' GXEMUL-SEC/tools/panel.sh. Launch two more in the SAME turn via the Agent tool: model opus (the compile-and-measure seat) and model fable. THE OWNER'S NEWEST SEAT RULINGS OVERRIDE THIS ROSTER -- read the `Owner rulings` entries of the memory index before convening, and record a seat the owner told you not to fire as DELIBERATELY NOT FIRED, never as a failure or as agreement. Fable also ADJUDICATES the panel's task suggestions in its main-loop role. For diff-review passes INLINE the diff into the brief -- the cloud seats cannot read files. Resolve disagreements by MEASUREMENT, never by vote. VERIFY EACH SEAT ANSWERED BY CONTENT, NEVER BY SIZE -- a thinking burn returns an empty response wrapped in 100+ KB of hidden reasoning and a size check scores it the best answer in the panel. Full workflow + the self-sustaining monitor loop in CLAUDE.md; run a whole round with /round."}}
JSON
  ;;
task)
  cat <<'JSON'
{"systemMessage":"Task completed -> monitor cycle: (1) panel-review the finished work AND ask it for new tasks; (2) Fable adjudicates each suggestion, adds the worthwhile ones; (3) hand parallel read-only scoping to subagents; (4) claim the next task. Do not stop.","hookSpecificOutput":{"hookEventName":"TaskCompleted","additionalContext":"A task was just marked completed. Run the self-sustaining monitor cycle (see CLAUDE.md 'The self-sustaining monitor loop'), do NOT stop: (1) convene the full NINE-seat panel (PANEL_FIRE_AGY=1 bash GXEMUL-SEC/tools/panel.sh <ABSOLUTE brief path> for the scriptable seats -- never ./panel.sh -- plus the opus and fable seats via the Agent tool; the owner's newest seat rulings in the memory index override this roster) to review the completed work AND surface new tasks -- residual defects, sibling bugs, instrument gaps; after-panel findings have repeatedly become the next rounds. (2) Fable (you, the main model) ADJUDICATES each suggested task -- worth adding? real/reachable/in-scope/test-first-able vs noise/duplicate -- add the worthwhile ones with TaskCreate, drop the rest with a one-line reason. (3) For each added task decide whether a subagent can start it NOW in parallel: read-only scoping/idiom/reachability investigation and brief-drafting parallelize freely (spawn a background subagent to de-risk before the panel convenes); builds/probes/gates are serial behind the single tree/rig/gate writer. (4) Claim the next task and run reproduce -> panel pass 1 -> implement -> panel pass 2 -> single clean gate -> commit. Never two gate/harness runs at once."}}
JSON
  ;;
wakeup)
  # Fires from PostToolUse on ScheduleWakeup, so the stamp is written by the
  # HARNESS rather than by anyone remembering to write it. That is the whole
  # point: the stop check below can then tell "about to stall" from "armed and
  # legitimately waiting", which it could not do before and which made it nag on
  # every stop -- four in a row, each time when a wakeup was in fact armed.
  BASE="${CLAUDE_PROJECT_DIR:-${TMPDIR:-/tmp}}"
  [ -d "$BASE/.claude" ] || BASE="${TMPDIR:-/tmp}"
  { date +%s > "$BASE/.loop_wakeup_stamp"; } 2>/dev/null
  exit 0
  ;;
stop)
  # Fires when the main loop stops. This exists because the loop once stalled
  # for exactly one reason: a turn ended without re-arming the wakeup, and no
  # hook watched that event. SessionStart and TaskCompleted could not catch it.
  #
  # Rate-limited to at most one nudge per 90s via a stamp file, deliberately:
  # a Stop hook that always blocks can wedge a session, so a genuine stop
  # succeeds on the immediately following attempt. One nudge, then it yields.
  # FAIL OPEN. If the stamp cannot be written the rate limit never advances,
  # which would block every stop and wedge the session -- the exact hazard this
  # design is guarding against. Caught while testing with CLAUDE_PROJECT_DIR
  # unset, where the path resolved to /.claude/... and the write failed
  # silently. So: pick a writable base, and if the write does not land, do not
  # block at all.
  BASE="${CLAUDE_PROJECT_DIR:-${TMPDIR:-/tmp}}"
  [ -d "$BASE/.claude" ] || BASE="${TMPDIR:-/tmp}"

  # If a wakeup was armed in the last 15 minutes the loop is NOT stalling, it is
  # waiting -- so say nothing and let the turn end. Without this the nudge fired
  # on every stop regardless, which is noise rather than a safeguard: a check
  # that always fires carries no information, the same defect this project keeps
  # finding in rows that always pass.
  WSTAMP="$BASE/.loop_wakeup_stamp"
  if [ -f "$WSTAMP" ]; then
    WLAST=$(cat "$WSTAMP" 2>/dev/null || echo 0)
    case "$WLAST" in ''|*[!0-9]*) WLAST=0 ;; esac
    if [ $(( $(date +%s) - WLAST )) -lt 900 ]; then
      exit 0
    fi
  fi

  STAMP="$BASE/.loop_stop_stamp"
  NOW=$(date +%s)
  LAST=0
  [ -f "$STAMP" ] && LAST=$(cat "$STAMP" 2>/dev/null || echo 0)
  case "$LAST" in ''|*[!0-9]*) LAST=0 ;; esac
  #  The redirect is inside the group so the SHELL's own "No such file"
  #  message is suppressed too -- putting 2>/dev/null on printf alone leaves it
  #  on stderr, which would surface as hook noise on every stop.
  if [ $((NOW - LAST)) -gt 90 ] && { printf '%s' "$NOW" > "$STAMP"; } 2>/dev/null; then
    cat <<'JSON'
{"decision":"block","reason":"LOOP CONTINUITY CHECK before stopping. The queue is worked as a continuous loop, so stopping is only correct when the queue is empty or a human decision is genuinely required (a destructive action or a real scope change). Check, in order: (1) Is a wakeup armed? If this turn handled a task-notification and the loop should continue, ScheduleWakeup must be re-armed with the same /loop prompt -- dropping it is what stalled the loop before, and it is the single most common failure here. (2) Is the in-flight task actually blocked, or merely waiting? If a panel, gate or battery is running, that is WAITING, not blocked -- do non-contending work (docs, queue triage, read-only scoping) instead of stopping. (3) If the in-flight task IS genuinely blocked -- it needs a build tree another process holds, or a measurement that has not returned -- then FORK: claim a different pending task and work that instead. Blocked on one item is not blocked on the queue. (4) Only if none of those apply, stop again and this will let you through."}
JSON
  fi
  ;;
esac
}

# count <logfile> <pattern>   -- number of matching lines, 0 if the file is absent.
#
# NOT `[ -f x ] && grep -ac ... || echo 0`. On zero matches grep prints "0" AND exits 1,
# so the || arm fires too and the function emits TWO lines ("0\n0"). Measured: 3 bytes,
# 2 lines. That silently corrupted every marker string built from it, and made gate 6's
# one deliberate expected-negative assertion impossible to satisfy.
count() {
    [ -f "$1" ] || { echo 0; return; }
    local c
    c=$(grep -ac -- "$2" "$1" 2>/dev/null)
    echo "${c:-0}"
}
    #  DENOMINATOR, SUMMED ARITHMETICALLY.  Two rows, not one: a single "22 ok" check
    #  cannot tell a LOST row from a FAILING one, and those need different responses.
    #  The sum is arithmetic rather than a string join -- concatenating two counts and
    #  comparing to "220" is satisfied by (22 ok, 0 FAIL) AND by (2 ok, 20 FAIL), which
    #  is a defect this gate has already shipped once.
    check "sgi_de rows emitted" \
          "$(( $(count "$DEWLOG" " ok$") + $(count "$DEWLOG" " FAIL$") ))" "30"
    check "sgi_de rows green" "$(count "$DEWLOG" " ok$")" "30"
fi

SGILOG=$LOGDIR/sgi_re_width.log
python3 sgi_re_width_probe.py "$PMAX" gate > "$SGILOG" 2>&1 || true


 exited 1 in 397ms:
 *  was dropped.
 */
static int dec21143_rx_drop_packet(struct net *net, struct dec21143_data *d)
{
	/* Only implement filtering if using a tap device. */
	if (net->tapdev == NULL)
		return 0;

	/*
	 * We might have told the network layer that we're promiscuous
	 * due to the chosen filtering mode, so check the truth here.
	 */
	if (d->promiscuous)
		return 0;

	/*
	 * If the guest wants all multicast (either all the bits are
	 * set or the OPMODE_PM bit is set), then check to see if we
	 * can short-circuit the checks.
	 */
	if (d->allmulti && net_ether_multicast(d->cur_rx_buf))
		return 0;

	/*
	 * Note that if we haven't gotten a setup packet yet, then
	 * d->drop_packet will be NULL.  If this happens, we always
	 * drop.  This is akin to the real hardware defaulting to
	 * Perfect filtering mode but not having any valid addresses
	 * in the list to match against.
	 */
	if (d->drop_packet == NULL || d->drop_packet(net, d)) {
		/* Not for us; drop the packet. */
		free(d->cur_rx_buf);
		d->cur_rx_buf = NULL;
		d->cur_rx_buf_len = 0;
		return 1;
	}

	return 0;
 *  arrived ones. If the current packet couldn't be fully transfered the
 *  last time, then continue on that packet.)
 */
int dec21143_rx(struct cpu *cpu, struct dec21143_data *d)
{
	uint32_t addr = d->cur_rx_addr, bufaddr;
	unsigned char descr[16];
	uint32_t rdes0, rdes1, rdes2, rdes3;
	int bufsize, buf1_size, buf2_size, i, writeback_len = 4, to_xfer;

	/*  No current packet? Then check for new ones.  */
	while (d->cur_rx_buf == NULL) {
		/*  Nothing available? Then abort.  */
		if (!net_ethernet_rx_avail(d->nic.net, &d->nic))
			return 0;

		/*  Get the next packet into our buffer:  */
		net_ethernet_rx(d->nic.net, &d->nic,
		    &d->cur_rx_buf, &d->cur_rx_buf_len);

		if (dec21143_rx_drop_packet(d->nic.net, d))
			continue;

		/*  Append a 4 byte CRC:  */
		d->cur_rx_buf_len += 4;
		CHECK_ALLOCATION(d->cur_rx_buf = (unsigned char *) realloc(d->cur_rx_buf,
		    d->cur_rx_buf_len));

		/*  Well... the CRC is just zeros, for now.  */
		memset(d->cur_rx_buf + d->cur_rx_buf_len - 4, 0, 4);

#  The header's ban on the survival channel was written too broadly.  Reinstating `exit(1)`
#  after the fatal() PRINTS THE DIAGNOSTIC AND THEN DIES: the message count is 1, the byte
#  is right, and a presence-only row is GREEN on a verbatim reinstatement of the very defect
#  this round removed.  The witness measured exactly that shape pre-fix -- `a88 says` = 1
#  AND `a88 kill` = exit1, in the same session.
#
#  THE CORRECT RULE: survival is a dead channel for rows pinning the ACCEPT side, because
#  the fix makes accepted values survive either way.  On the DECLINE side it is the ONLY
#  channel that sees clause (b).  So a decline row asserts BOTH -- announced, and survived.
A = Addr(CODE)
t, alive, how = session(store16(GDROM_UNK88, 0x0000, A))
m = A88_RE.search(t)
row("R1 a88 says", "%d|%s|%s" % (t.count(A88_TEXT), m.group(1) if m else "absent", how),
    "1|00|exit0", "site A declines, announces the byte, and SURVIVES")

#  R1b -- and the byte TRACKS.  A second, DIFFERENT declined value is what separates a
#  format that prints idata from one that prints a constant, and it is what reddens under
#  the 0x%02x -> 0x%02d fidelity mutant (0xaa would report as "70").
#  [#556, 2026-10-02 -- a records correction; the text above is kept as it was written] the 0x%02x -> 0x%02d
#  fidelity mutant (0xaa formats as 170, leaving m absent).  (hgdromcondprobe:F11:
#  regress/artifacts/astraretro_harness_20260926/HARNESS_DISPOSITIONS.md)
A = Addr(CODE)
t, alive, how = session(store16(GDROM_UNK88, 0x00aa, A))
m = A88_RE.search(t)
row("R1b a88 trk", m.group(1) if m else "absent", "aa",
    "and it tracks the datum, so the predicate saw it")

#  R3 -- the LATCH.  Three bad writes in ONE session must announce exactly once.
A = Addr(CODE)
t, alive, how = session(store16(GDROM_UNK88, 0x0000, A)
                        + store16(GDROM_UNK88, 0x0055, A)
                        + store16(GDROM_UNK88, 0x00aa, A))
row("R3 a88 x3", "%d" % t.count(A88_TEXT), "1",
    "three bad writes at A, ONE diagnostic")

#  R10 -- site A's accepted value is a NO-OP.  If a future edit gives 0x0b an effect, the
#  three device-state bytes stop agreeing with a fresh device.
#  *** R10 READS COND AND BUSY, NOT STAT, AND THE STAT VERSION WAS HOLLOW. ***
#  PRETABLE prescribed "stat/busy/cond unchanged"; the first build read STAT alone -- and
t, alive, how = session(store16(GDROM_COND, 0x0055, A))
m = COND_RE.search(t)
row("R2 cond says", "%s|%s" % (m.group(1) if m else "absent", how), "55|exit0",
    "site B declines, announces the byte, and SURVIVES")

A = Addr(CODE)
t, alive, how = session(store16(GDROM_COND, 0x0001, A))
m = COND_RE.search(t)
row("R2b cond trk", m.group(1) if m else "absent", "01",
    "and it tracks the datum, so the predicate saw it")

#  R4 -- the LATCH at site B.
A = Addr(CODE)
t, alive, how = session(store16(GDROM_COND, 0x0055, A)
                        + store16(GDROM_COND, 0x0056, A)
                        + store16(GDROM_COND, 0x0057, A))
row("R4 cond x3", "%d" % len(COND_RE.findall(t)), "1",
    "three bad writes at B, ONE diagnostic")

# ------------------------------------------------------------------ R5  *** THE KEYSTONE
#  *** ANCHORED, AND THE ANCHOR IS THE WHOLE POINT (clause f). ***
#  A fresh device has cond == 0.  So the naive row -- "write 0x55, read back 0" -- is
