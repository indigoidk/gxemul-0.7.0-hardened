225:    #  *** POLL, NEVER SAMPLE ONCE.  MEASURED 2026-09-17, and the first run of this probe
226:    #  reported `alive' for a process that SIGABRT'd 0.6 s later. ***
227:    #  `rd()' RETURNS IMMEDIATELY ON EOF rather than waiting out its timeout, so `spin' --
228:    #  which exists precisely to give a dying child time to die -- is SKIPPED EXACTLY WHEN THE
229:    #  CHILD DIES.  A single waitpid(WNOHANG) then lands ~0 s after EOF while the kernel is
230:    #  still writing a 6 MB core, reports "still running", and THE KILL ROW GOES GREEN ON A
231:    #  LIVE HOST DEATH.  That is the false-green this probe exists to refuse.
232:    alive = True
233:    deadline = time.time() + 12.0
234:    while time.time() < deadline:
235:        try:
236:            wpid, status = os.waitpid(pid, os.WNOHANG)
237:        except ChildProcessError:
238:            alive = False
239:            break
240:        if wpid == pid:
241:            alive = False
242:            break
243:        time.sleep(0.05)
244:    if alive:
245:        try:
246:            os.kill(pid, signal.SIGKILL)
247:            os.waitpid(pid, 0)
248:        except OSError:
249:            pass
250:    try:
251:        os.close(fd)
252:    except OSError:
253:        pass
254:    return buf, alive
