 succeeded in 321ms:
   1: #!/usr/bin/env python3
   2: """reflow.py <block.md> -- reflow every paragraph and numbered item of a correction block to 120 columns: an item's first
   3: line keeps its "N. " prefix and its continuation lines get three spaces; a code span (`...`) never breaks; a two-space
   4: sentence break survives, including one that fell at a line end; headings and blank lines stay."""
   5: import io, re, sys, textwrap
   6: p = sys.argv[1]
   7: t = io.open(p, encoding="utf-8", newline="").read()
   8: SPAN = re.compile(r"`[^`\n]*`")
   9: KEEP = "\x01"      # glued to a sentence's last word, it becomes the second space after wrapping
  10: HARD = "\x00"      # a space inside a code span
  11: END = re.compile(r"[.?!:][)*\"'`\]]*$")
  12: START = re.compile(r"^[A-Z(*`\"']")
  13: 
  14: def join(lines):
  15:     out = lines[0].strip()
  16:     for l in lines[1:]:
  17:         l = l.strip()
  18:         out += (KEEP + " " if END.search(out) and START.match(l) else " ") + l
  19:     return out
  20: 
  21: def wrap(first, rest, text, width=120):
  22:     text = re.sub(r"(?<=\S)  +(?=\S)", KEEP + " ", text)
  23:     text = SPAN.sub(lambda m: m.group(0).replace(" ", HARD), text)
  24:     out = textwrap.wrap(text, width - 1, initial_indent=first, subsequent_indent=rest,
  25:                         break_long_words=False, break_on_hyphens=False)
  26:     return "\n".join(l.replace(HARD, " ").replace(KEEP, " ").rstrip() for l in out)
  27: 
  28: paras, cur = [], []
  29: for line in t.split("\n"):
  30:     if line.startswith("#") or line.strip() == "":
  31:         if cur: paras.append(cur); cur = []
  32:         paras.append([line])
  33:     elif re.match(r"^\d+\. ", line):
  34:         if cur: paras.append(cur)
  35:         cur = [line]
  36:     else:
  37:         cur.append(line)
  38: if cur: paras.append(cur)
  39: res = []
  40: for para in paras:
  41:     if len(para) == 1 and (para[0].startswith("#") or para[0].strip() == ""):
  42:         res.append(para[0]); continue
  43:     text = join(para)
  44:     m = re.match(r"^(\d+\. )(.*)$", text, re.S)
  45:     res.append(wrap(m.group(1), "   ", m.group(2)) if m else wrap("", "", text))
  46: io.open(p, "w", encoding="utf-8", newline="").write("\n".join(res))
  47: print("reflowed %s, max width %d" % (p, max(len(l) for l in "\n".join(res).split("\n"))))

