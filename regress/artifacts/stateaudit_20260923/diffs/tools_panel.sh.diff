-"$KIMI" -p "$KIMI_ARG" -m kimi-code/k3 > "$OUT/kimi.txt" 2>&1 &
-P_KIMI=$!
+#  *** OWNER DIRECTIVE 2026-09-17: THE KIMI SEAT COMES FROM OLLAMA, NOT THE CLI. ***
+#  The CLI is 403-walled on a WEEKLY (7-day) window -- re-fired by hand on 2026-09-17 per the
+#  wall rule and it walled again -- so firing it costs a launch and writes a multi-megabyte
+#  file that ENDS in a quota notice.  That file is the worst shape this project knows: huge,
+#  98% novel, invisible to any size check, and scored as the best answer in the panel by a
+#  naive census.  The seat is COVERED by OLLAMA4 (kimi-k3:cloud), which is reachable and
+#  answered in every panel today.
+#
+#  NOTE THE CLASS CHANGES WITH THE TRANSPORT: the CLI is FILE-READING, the substitute is
+#  PACKET-FED.  A kimi answer arriving now cannot settle a repo fact, and crediting one as a
+#  reading is the conflation the doctrine forbids.  Record it BY TRANSPORT.
+#
+#  Set PANEL_KIMI_CLI=1 to fire the CLI again once the weekly window resets.  Default is OFF.
+if [ -n "${PANEL_KIMI_CLI:-}" ]; then
+    "$KIMI" -p "$KIMI_ARG" -m kimi-code/k3 > "$OUT/kimi.txt" 2>&1 &
+    P_KIMI=$!
+else
+    echo "kimi CLI: NOT FIRED (weekly 403 wall; seat covered by OLLAMA4=$OLLAMA4).  PANEL_KIMI_CLI=1 to re-enable." \n        > "$OUT/kimi.SKIPPED.txt"
+    P_KIMI=""
+fi
 
 #  GROK 4.6 -- added 2026-08-13 by user directive. Note what it does DIFFERENTLY
 #  from every other CLI seat, because it is the reason this seat is wired the way
@@ -361,7 +383,8 @@ P_KIMI=$!
 #  --permission-mode plan keeps it READ-ONLY (verified: it read a repo file and
 #  answered correctly without prompting or hanging), and --cwd lets it consult
 #  the source the way Codex and agy do, rather than only the brief.
-#  `grok models` is the authority on model IDs; today it lists exactly one.
+#  `grok models` is the authority on model IDs -- run it, never transcribe it: on
+#  2026-09-21 it lists four (grok-4.7 default, grok-4.7-build-fast, grok-4.6, grok-4.5).
 "$GROK" --prompt-file "$BRIEF_ABS" -m "$GROK_MODEL" --effort "$GROK_EFFORT" \
     --permission-mode plan --cwd "$PROJ" \
     </dev/null > "$OUT/grok.txt" 2>&1 &
