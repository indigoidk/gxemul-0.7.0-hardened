  79: BIN = sys.argv[1]
  80: CODE = 0x8000
  81: WARM = 0x10000
  82: COLD = 0x20000
  83: 
  84: #  Build r1 = 0x11223344 with immediates (mov + 3 orr), verified via unassemble.
