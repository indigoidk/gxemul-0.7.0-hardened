 164: def str_base_prog():
 165:     """R1: str r4,[pc,#0x40] at CODE+0x10; read BOTH candidate words.
 166: 
 167:     The +8 candidate is 0x8058 and the +12 candidate 0x805c, so one ldr pair
 168:     covers both and the WRONG candidate is asserted to hold its sentinel --
 169:     a row that only checked the right address would pass a store-to-both.
 170:     """
 171:     return (list(BUILD_R4) + [STR_R4_PC_40, MOV_R3_8000, ORR_R3_58,
 172:                               LDR_R5_R3, LDR_R6_R3_4, SPIN])
 173: 
 174: 
 175: def str_data_prog():
 176:     """R2: str pc,[r7] -- the DATA role, with an ordinary base register.
 177: 
 178:     Must read instruction+12 BEFORE and AFTER the fix.  This is the row that
 179:     catches a role-aware guard written without an else: that leaves the scratch
 180:     word holding whatever the previous PC-relative instruction left in it.
 181:     """
 182:     return [MOV_R7_20000, STR_PC_R7, LDR_R5_R7, SPIN]
