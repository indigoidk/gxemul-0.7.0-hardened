 185: def str_bothpc_prog():
 186:     """R3: str pc,[pc,#0x40] -- both roles at once, the load-bearing row.
 187: 
 188:     Needs base = instruction+8 AND stored value = instruction+12 SIMULTANEOUSLY.
 189:     Checking the VALUE at the +8 address is what separates the two-word fix from
 190:     a blanket +8, which puts the right address there carrying the wrong word.
 191:     """
 192:     return [STR_PC_PC_40, MOV_R3_8000, ORR_R3_48, LDR_R5_R3, SPIN]
