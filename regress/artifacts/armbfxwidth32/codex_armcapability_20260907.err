 218: 
 219: def band(v, lo, hi):
 220:     return "in[%d,%d]" % (lo, hi) if (v is not None and lo <= v <= hi) \
 221:         else ("%s" % v)
 222: 
 223: 
 224: #  ---- control: -J must fold nothing, so the genuine walk yields a real
 225: #  ---- NCYCLES delta and ends exactly at the NUL. Nothing below is believable
 226: #  ---- if this reference is wrong.
 227: _j = session(PROG_WALK, ["-J"], 3, 8.0, True)
 228: #  The control deliberately does NOT test the end address: that is the
 229: #  `-J end addr` row's job, and a control that already required it would make
 230: #  the row unfailable -- the mirror of the rule this file commits to.
 231: ctrl_ok = (_j is not None and (_j[1] - _j[0]) > 0)
 232: print("STRLEN_CONTROL=%s" % ("OK" if ctrl_ok else "DEAD"))
 233: if not ctrl_ok:
 234:     print("STRLEN_RESULT=0/0")
 235:     sys.exit(0)
 236: 
 237: #  These two restate what STRLEN_CONTROL already required, so whenever they
 238: #  print they pass -- they are decorative in the pass direction and exist to put
 239: #  the reference numbers in the log beside the folded ones. The real protection
 240: #  is the control itself: if either condition fails, control goes DEAD, the
 241: #  probe prints 0/0, and the gate fails loudly on both the control check and
 242: #  `rows run`.
 243: row("A strlen -J ref", "PIN", band(_j[1] - _j[0], 30000, 60000),
 244:     "in[30000,60000]")
 245: row("A strlen -J end addr", "PIN", "0x%05x" % _j[2],
 246:     "0x%05x" % (STRBASE + STRLEN))
 247: 
 248: #  ---- #356: the folded walk must ALSO show a real delta -- i.e. it left the
 249: #  ---- dispatch at least once. Pre-fix this read 0: the whole 16 KB walk
 250: #  ---- happened inside one dispatch.
 251: _f = session(PROG_WALK, [], 3, 8.0, True)
 252: #  These two rows read ONE datum between them -- `yields` is its lower bound,
 253: #  `bill band` its upper. The LOWER bound is what discriminates: pre-fix it read
 254: #  0 (the walk never left the dispatch), and an add-clamp-only counterfeit --
 255: #  one that trims the billing while the walk still completes in a single
 256: #  dispatch -- also reads far below it. The UPPER bound only catches a fix that
 257: #  bills wildly too much.
 258: row("A strlen yields", "DISC",
 259:     band((_f[1] - _f[0]) if _f else None, 30001, 10 ** 9), "in[30001,1000000000]")
 260: row("A strlen bill band", "DISC",
 261:     band((_f[1] - _f[0]) if _f else None, 30000, 90000), "in[30000,90000]")
 262: #  ...and bounded above: an add-clamp-only "fix" (no loop bound) reads far
 263: #  lower because the walk still completes in one dispatch and only the
 264: #  BILLING is trimmed.
 265: row("A strlen end addr", "PIN",
 266:     ("0x%05x" % _f[2]) if _f else "dead", "0x%05x" % (STRBASE + STRLEN))
 267: 
 268: #  ---- #355: the aliased loop must NOT be folded, so it must not exit. The
 269: #  ---- sentinel must be absent AND r3 must have moved off its seed -- the
 270: #  ---- second half is the forward-progress assertion, so a program that never
 271: #  ---- armed or never ran cannot masquerade as "still looping".
 272: #  -T (halt on a non-existent memory access) is REQUIRED here, and #355 is what
 273: #  made it so: post-fix the aliased loop no longer exits, so it marches off the
 274: #  end of RAM and every subsequent byte logs a WARNING. Measured without it:
 275: #  164,668 lines / 12.0 MB into the pty in ~0.94 s, accumulated in `buf` and
 276: #  re-sliced on every poll, with r3 host-speed-dependent (console-throttled ~3x
 277: #  slower than free-running). With -T: 1 warning, 132 bytes, r3 deterministic at
 278: #  0x0403FFFF, and the discrimination is untouched -- pre-fix still exits with
 279: #  the sentinel at 0x55 and r3 at 0x9103. (-q cannot be used: main.c ignores it
 280: #  whenever -V is given.)
 281: _ar = session(PROG_ALIAS, ["-T"], 2, 3.0, False, read_r3=True)
 282: _a, _ar3 = _ar if _ar else (None, None)
 283: row("A strlen alias exits", "DISC",
 284:     ("0x%08x" % _a[0]) if _a else "dead", "0xdeadbeef")
 285: #  DISC, not PIN: pre-fix the fold EXITED after three bytes, so r3 sat at
 286: #  0x9103 and this reads "no". Post-fix the guest walks on for millions of
 287: #  bytes. It doubles as the forward-progress guard -- a program that never
 288: #  armed, or never ran at all, cannot masquerade as "still looping".
 289: #  #363: an UNREAD register must not read as "no". The old form folded
 290: #  `_ar3 is None` into the same "no" the pre-fix defect produces, so a lost
 291: #  readback was byte-identical to a real regression -- the one row in this
 292: #  suite that failed to a value indistinguishable from the defect it guards,
 293: #  and the inverse of the corrosive-red-row problem: it would have taught the
 294: #  reader to BELIEVE a phantom regression. Verdict-preserving on every
 295: #  successful read, since `_ar3 is not None` was already required for "moved".
 296: #  Same shape as `A fold scanc notbl`, whose comment states the principle.
 297: row("A strlen alias moved", "DISC",
 298:     ("unread" if _ar3 is None else
 299:      ("moved" if _ar3 > ALIAS_STR + 16 else "no")),
 300:     "moved")
