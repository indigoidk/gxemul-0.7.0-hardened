 678:     "A wb rot word cold plus1": 1,
 679:     "A wb rot word cold plus2": 1,
 680:     "A wb rot word cold plus3": 1,
 681:     "A wb word cold pre4 unal": 1,
 682:     "A wb word ldrt post4 unal": 1,
 683: }
 684: 
 685: ngot = 0
 686: control = "FAIL"
 687: lsgot = 0
 688: lswant = 0
 689: for name, kind, prog, reg, buggy, arch in ROWS:
 690:     got = run(prog, [reg])
 691:     if got is None or reg not in got:
 692:         print("%-32s  %-6s DEAD  FAIL" % (name, kind))
 693:         continue
 694:     v = got[reg]
 695:     ok = (v == arch)
 696:     ngot += ok
 697:     if name == "A wb algn load data" and v == 0x11223344:
 698:         control = "OK"
 699:     print("%-32s  %-6s %s=0x%08x want 0x%08x (buggy 0x%08x)  %s"
