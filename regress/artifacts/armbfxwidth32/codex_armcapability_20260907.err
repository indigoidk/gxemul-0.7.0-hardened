 252: def sw(h):
 253:     return int.from_bytes(bytes.fromhex(h), "little")
 254: 
 255: 
 256: def dumpw(flat, i):
 257:     return sw(flat[i]) if flat and len(flat) > i else None
 258: 
 259: 
 260: def nzcv_from_reg(regtxt):
 261:     m = re.search(r"cpsr = ([NnZzCcVv]{4})", regtxt or "")
 262:     if not m:
 263:         return None
 264:     f = m.group(1)
 265:     return sum(1 << (3 - i) for i, ch in enumerate(f) if ch.isupper())
