 228: #  #389: LDRD/STRD. Encodings verified by the round's RED reproduction (the
 229: #  committed build produced the exact predicted buggy values, impossible for
 230: #  a wrong or UNDEFINED word). The pair register is IMPLICIT R(d+1) -- mode-3
 231: #  has no Rt2 field; bit 22 = 1 is the IMMEDIATE form; LDRD sits in the L=0
 232: #  half of the extra-loads space (S/H distinguish it).
 233: LDRD_R4_R3 = 0xE1C340D0        # ldrd r4,[r3]  (loads r4 AND r5)
 234: STRD_R4_R3 = 0xE1C340F0        # strd r4,[r3]  (stores r4 AND r5)
 235: MOV_R4_0 = 0xE3A04000          # mov r4,#0  (dead-LDRD sentinel)
 236: MOV_R5_0 = 0xE3A05000          # mov r5,#0
 237: BUILD_R4 = [0xE3A04411,        # mov r4,#0x11000000
 238:             0xE3844822,        # orr r4,r4,#0x00220000
 239:             0xE3844C33,        # orr r4,r4,#0x00003300
 240:             0xE3844044]        # orr r4,r4,#0x44      -> r4 = 0x11223344
 241: BUILD_R5 = [0xE3A05455,        # mov r5,#0x55000000
 242:             0xE3855866,        # orr r5,r5,#0x00660000
 243:             0xE3855C77,        # orr r5,r5,#0x00007700
 244:             0xE3855088]        # orr r5,r5,#0x88      -> r5 = 0x55667788
 245: 
 246: 
 247: def ldrd_prog():
 248:     return [MOV_R4_0, MOV_R5_0, MOV_R3_COLD, LDRD_R4_R3, SPIN]
 249: 
 250: 
 251: def strd_prog():
 252:     #  The STRD page is fully UNSEEDED (no access of any kind -- unseeded RAM
 253:     #  is zero), so a dead STRD reads sentinel 0 through the ladder.
 254:     return (BUILD_R4 + BUILD_R5 + [MOV_R3_COLD, STRD_R4_R3]
 255:             + list(LDRB8_R3) + [SPIN])
