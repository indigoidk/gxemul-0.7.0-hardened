  89: MOV_R0_COLD = 0xE3A00802        # mov r0,#0x20000
  90: MOV_R3_WARM = 0xE3A03801        # mov r3,#0x10000
  91: MOV_R3_COLD = 0xE3A03802        # mov r3,#0x20000
  92: STR_R1_R0 = 0xE5801000          # str  r1,[r0]
  93: LDR_R2_R0 = 0xE5902000          # ldr  r2,[r0]
  94: LDRB = (0xE5D03000, 0xE5D04001, 0xE5D05002, 0xE5D06003)  # ldrb r3..r6,[r0,#0..3]
  95: #  #378: stmia/ldmia r3,{r1,r2} (W=0 so r3 survives as the readback base) and
  96: #  an 8-byte ldrb ladder BASED ON R3 into r4..r11 (never clobbering r1/r2/r3).
  97: STMIA_R3 = 0xE8830006           # stmia r3,{r1,r2}
  98: LDMIA_R3 = 0xE8930006           # ldmia r3,{r1,r2}
  99: LDRB8_R3 = (0xE5D34000, 0xE5D35001, 0xE5D36002, 0xE5D37003,
