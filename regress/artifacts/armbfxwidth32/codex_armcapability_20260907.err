 471:         ("swp be unal b2", "r5", 0x77, 0x77, "CTRL"),
 472:         ("swp be unal b3", "r6", 0x88, 0x66, "DISC"),
 473:         ("swp be unal sent", "r7", 0x99, 0x55, "DISC"),
 474:     ]),
 475:     ("386 le swp unal", "testarm", swp_unal_prog(), swp_unal_seeds(), [
 476:         ("swp le unal r2", "r2", 0x11443322, 0x99443322, "DISC"),
 477:         ("swp le unal b0", "r3", 0x88, 0x11, "DISC"),
 478:         ("swp le unal b1", "r4", 0x77, 0x88, "DISC"),
 479:         ("swp le unal b2", "r5", 0x66, 0x77, "DISC"),
 480:         ("swp le unal b3", "r6", 0x55, 0x66, "DISC"),
 481:         ("swp le unal sent", "r7", 0x99, 0x55, "DISC"),
 482:     ]),
 483:     #  ---- #387 rows: the +2 offset. The +1 groups above cannot distinguish
 484:     #  the shipped `8*(addr&3)` / `if(rot_sh)` / `addr&=~3` from three wrong
 485:     #  forms that AGREE at +1 -- `8*(addr&1)`, a guard of `if(addr&1)`, and a
 486:     #  mask of `~1` (the fold-marker probe's three-offsets rule, its :437).
 487:     #  At +2 all three diverge: the &1 amount gives 0, the &1 guard skips the
 488:     #  rotate entirely, and the ~1 mask leaves the access at P+2. Every +2 row
 489:     #  is DISC -- the +1 b2 by-construction collision does not recur (buggy at
