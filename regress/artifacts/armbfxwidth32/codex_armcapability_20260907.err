 1676: /*
 1677:  *  debugger_cmd_step():
 1678:  *
 1679:  *  With no argument (or a number n), single-step 1 (or n) instruction(s).
 1680:  *
 1681:  *  With the argument "call" (which may be abbreviated), single-step until
 1682:  *  the next function call or function return is traced, with function
 1683:  *  call trace output ("trace") implicitly turned on while stepping.
 1684:  */
 1685: static void debugger_cmd_step(struct machine *m, char *args)
 1686: {
 1687: 	int n = 1;
 1688: 
 1689: 	if (args[0] != '\0' && !isdigit((int)args[0])) {
 1690: 		size_t wordlen = 0;
 1691: 		while (args[wordlen] != '\0' && args[wordlen] != ' ')
 1692: 			wordlen ++;
 1693: 
 1694: 		if (strncasecmp(args, "call", wordlen) == 0 &&
 1695: 		    args[wordlen] == '\0') {
 1696: 			int i;
 1697: 
 1698: 			/*  Single-step until a function call or return is
 1699: 			    traced. Function call trace is implicitly turned
 1700: 			    on while stepping (this takes effect immediately,
 1701: 			    since all translations were cleared when the
 1702: 			    debugger was entered). Clear any stale per-cpu
 1703: 			    transition flags first:  */
 1704: 			debugger_old_show_trace_tree = m->show_trace_tree;
 1705: 			m->show_trace_tree = 1;
 1706: 
 1707: 			for (i=0; i<m->ncpus; i++)
 1708: 				m->cpus[i]->last_was_function_transition = 0;
 1709: 
 1710: 			ctrl_c = 0;
 1711: 			debugger_stepping_until_function_transition = 1;
 1712: 			debugger_n_steps_left_before_interaction = 0;
 1713: 
 1714: 			/*  Special hack, see the main debugger() loop.  */
 1715: 			exit_debugger = true;
 1716: 			exit_debugger_to_continue_single_stepping = true;
 1717: 
 1718: 			strlcpy(repeat_cmd, "step call", MAX_CMD_BUFLEN);
 1719: 			return;
 1720: 		}
 1721: 
 1722: 		printf("syntax: step [n | call]\n");
 1723: 		return;
 1724: 	}
 1725: 
 1726: 	if (args[0] != '\0') {
 1727: 		n = strtoull(args, NULL, 0);
 1728: 		if (n < 1) {
 1729: 			printf("invalid nr of steps\n");
 1730: 			return;
 1731: 		}
 1732: 	}
 1733: 
 1734: 	debugger_n_steps_left_before_interaction = n - 1;
 1735: 
 1736: 	/*  Special hack, see the main debugger() loop for more info.  */
 1737: 	exit_debugger = true;
 1738: 	exit_debugger_to_continue_single_stepping = true;
 1739: 
 1740: 	strlcpy(repeat_cmd, "step", MAX_CMD_BUFLEN);
 1741: }
