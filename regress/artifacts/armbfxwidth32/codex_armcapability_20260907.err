 1399: 		printf("   w    word        (32 bits)\n");
 1400: 		printf("   d    doubleword  (64 bits)\n");
 1401: 		printf("   q    quad-word   (128 bits)\n");
 1402: 		printf("   s    string (without terminating nul)\n");
