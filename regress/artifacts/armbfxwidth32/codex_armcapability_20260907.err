   1: #!/usr/bin/env python3
   2: """Gate 14's netbsd_idle instrument (#351/#352/#353), read-ahead install path.
   3: 
   4: Prints one line per row:  <name> <got> <want> ok|FAIL
   5: then IDLE_CONTROL=OK|DEAD and IDLE_RESULT=<passed>/<total>.
   6: gate_arm.sh does the asserting.
   7: 
   8: Why this is a SEPARATE probe from arm_flags_probe.py
   9: ----------------------------------------------------
  10: arm_flags_probe.py drives every combiner row with a debugger `breakpoint`, and
  11: that is a blind spot a round-100 review seat found by compiling: translation
  12: read-ahead is gated on `cpu->machine->breakpoints.n == 0` (cpu_dyntrans.c:1939),
  13: so a breakpoint turns read-ahead OFF and the fold is only ever installed by the
  14: two-pass EXECUTE path. Real guests set no breakpoint, so they take the
  15: read-ahead path -- where COMBINE(beq_etc) installs netbsd_idle BEFORE the ldr
  16: runs, and the very first fold execution reads a destination register the loop
  17: has not yet written. netbsd_idle's register-alias defect (c) is invisible to a
  18: breakpoint-driven probe because the two-pass install pre-writes that register.
  19: 
  20: So every row here runs with NO breakpoint (read-ahead ON) and one straight-line
  21: pass. The architectural reference for the flag/dest rows is the SAME program run
  22: with `-J` (instruction combining disabled), so nothing folds -- measured, not
  23: derived.
  24: 
  25: The four netbsd_idle defects (all measured live on committed 704036e)
  26: --------------------------------------------------------------------
  27:   (a) the fold never wrote the load destination -> stale register.
  28:   (b) the fold never wrote the flags -> stale N/Z though two teqs executed.
  29:   (c) a loop whose second teqs ALIASES the load dest exited where the
  30:       architecture idles (the matcher pins rZ != rY but not rZ != dest; the
  31:       fold read the stale dest). #351 subsumes it by writing the dest before
  32:       the teqs delegation reads it.
  33:   (d) a FORWARD beq matched the loop and HUNG the guest (the matcher never
  34:       pinned the branch target). #353 pins ic[0].arg[0] == &ic[-4].
  35: """
  36: import os
  37: import pty
  38: import re
  39: import select
  40: import sys
  41: import time
  42: 
  43: BIN = sys.argv[1]
  44: STUB = sys.argv[2]
  45: 
  46: CODE = 0x8000
  47: DEST = 0x9000
  48: MEM = 0x9100
  49: 
  50: 
  51: def bcond(cond, frm, to):
  52:     """B<cond> from program word `frm` to word `to` (target = frm+8+imm*4)."""
  53:     return (cond << 28) | 0x0A000000 | ((to - frm - 2) & 0xFFFFFF)
  54: 
  55: 
  56: #  ldr r2,[r0] / teqs / bne->X / teqs rZ / beq->L, then ic[5] and X.
  57: def prog_exit(rz_reg, flag_seed):
  58:     """rZ != 0 exit path (rz_reg seeded 0x80000000). Publishes dest (r2) and
  59:     the post-loop cpsr, both via stores on the fold's exit path (ic[5..])."""
  60:     return [
  61:         0xE3A07C90,             # 0 mov r7,#0x9000
  62:         0xE3A09001,             # 1 mov r9,#1
  63:         0xE3A00C91,             # 2 mov r0,#0x9100     rY
  64:         0xE3A02077,             # 3 mov r2,#0x77       dest seed
  65:         0xE3A04102,             # 4 mov r4,#0x80000000 rZ seed (bit31)
  66:         flag_seed,              # 5 cmp r9,#imm        flag preset
  67:         0xE5902000,             # 6 L: ldr r2,[r0]
  68:         0xE3320000,             # 7 teqs r2,#0
  69:         bcond(1, 8, 14),        # 8 bne -> X
  70:         0xE3300000 | (rz_reg << 16),   # 9 teqs rZ,#0
  71:         bcond(0, 10, 6),        # 10 beq -> L
  72:         0xE10F3000,             # 11 ic[5]: mrs r3,cpsr
  73:         0xE5872000,             # 12 str r2,[r7]
  74:         0xE5873004,             # 13 str r3,[r7,#4]
  75:         0xEAFFFFFE,             # 14 X: b .
  76:     ]
  77: 
  78: 
  79: def prog_idle(flag_seed):
  80:     """rZ == 0 idle path. The guest IDLES on both builds (rZ genuinely 0), so
  81:     this row discriminates on the published dest and flags, not control flow.
  82:     The flag seed is chosen with Z CLEAR so the owed Z=1 differs from it."""
  83:     p = prog_exit(4, flag_seed)
  84:     p[4] = 0xE3A04000           # mov r4,#0  -> rZ = 0 -> idle path
  85:     return p
  86: 
  87: 
  88: PROG_ALIAS = [                  # (c): second teqs tests r2, the load dest
  89:     0xE3A07C90,   # 0 mov r7,#0x9000
  90:     0xE3A00C91,   # 1 mov r0,#0x9100
  91:     0xE3A02077,   # 2 mov r2,#0x77     dest == rZ, seeded nonzero
  92:     0xE3A05055,   # 3 mov r5,#0x55     sentinel
  93:     0xE5902000,   # 4 L: ldr r2,[r0]
  94:     0xE3320000,   # 5 teqs r2,#0
  95:     bcond(1, 6, 10),   # 6 bne -> X
  96:     0xE3320000,   # 7 teqs r2,#0        rZ aliases the dest
  97:     bcond(0, 8, 4),    # 8 beq -> L
  98:     0xE5875000,   # 9 ic[5]: str r5,[r7]   <- fold's WRONG exit
  99:     0xEAFFFFFE,   # 10 X: b .
 100: ]
 101: 
 102: PROG_TARGET = [                 # (d): the beq targets FORWARD, not the ldr
 103:     0xE3A07C90,   # 0 mov r7,#0x9000
 104:     0xE3A00C91,   # 1 mov r0,#0x9100
 105:     0xE3A02077,   # 2 mov r2,#0x77
 106:     0xE3A05055,   # 3 mov r5,#0x55
 107:     0xE5902000,   # 4 L: ldr r2,[r0]
 108:     0xE3320000,   # 5 teqs r2,#0
 109:     bcond(1, 6, 10),   # 6 bne -> X
 110:     0xE3340000,   # 7 teqs r4,#0        r4=0 -> beq taken
 111:     bcond(0, 8, 11),   # 8 beq -> B (FORWARD, word 11) -- not a loop
 112:     0xEAFFFFFE,   # 9 b .
 113:     0xEAFFFFFE,   # 10 X: b .
 114:     0xE5875000,   # 11 B: str r5,[r7]   arch reaches here
 115:     0xEAFFFFFE,   # 12 b .
 116: ]
