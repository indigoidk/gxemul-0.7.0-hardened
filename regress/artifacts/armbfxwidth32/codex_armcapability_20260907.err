  207:  *  debugger_assignment():
  208:  *
  209:  *  cmd contains something like "pc=0x80001000", or "r31=memcpy+0x40".
  210:  */
  211: void debugger_assignment(struct machine *m, char *cmd)
  212: {
  213: 	char *left, *right;
  214: 	int res_left, res_right;
  215: 	uint64_t tmp;
