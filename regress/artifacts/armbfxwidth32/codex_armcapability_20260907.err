  614:  *  arm_exception():
  615:  */
  616: void arm_exception(struct cpu *cpu, int exception_nr)
  617: {
  618: 	int oldmode, newmode;
  619: 	uint32_t retaddr;
  620: 
  621: 	if (exception_nr < 0 || exception_nr >= N_ARM_EXCEPTIONS) {
  622: 		fatal("arm_exception(): exception_nr = %i\n", exception_nr);
  623: 		exit(1);
  624: 	}
  625: 
  626: 	retaddr = cpu->pc;
  627: 
  628: 	if (!quiet_mode) {
  629: 		debug("[ arm_exception(): ");
  630: 		switch (exception_nr) {
  631: 		case ARM_EXCEPTION_RESET:
  632: 			fatal("RESET: TODO");
  633: 			break;
  634: 		case ARM_EXCEPTION_UND:
  635: 			debug("UNDEFINED");
  636: 			break;
  637: 		case ARM_EXCEPTION_SWI:
  638: 			debug("SWI");
  639: 			break;
  640: 		case ARM_EXCEPTION_PREF_ABT:
  641: 			debug("PREFETCH ABORT");
  642: 			break;
  643: 		case ARM_EXCEPTION_IRQ:
  644: 			debug("IRQ");
  645: 			break;
  646: 		case ARM_EXCEPTION_FIQ:
  647: 			debug("FIQ");
  648: 			break;
  649: 		case ARM_EXCEPTION_DATA_ABT:
  650: 			debug("DATA ABORT, far=0x%08x fsr=0x%02x",
  651: 			    cpu->cd.arm.far, cpu->cd.arm.fsr);
  652: 			break;
  653: 		}
  654: 		debug(" ]\n");
  655: 	}
  656: 
  657: 	switch (exception_nr) {
  658: 	case ARM_EXCEPTION_RESET:
  659: 		cpu->running = 0;
  660: 		fatal("ARM RESET: TODO");
  661: 		exit(1);
  662: 	case ARM_EXCEPTION_DATA_ABT:
  663: 		retaddr += 4;
  664: 		break;
  665: 	}
  666: 
  667: 	retaddr += (cpu->cd.arm.cpsr & ARM_FLAG_T ? 2 : 4);
  668: 
  669: 	arm_save_register_bank(cpu);
  670: 
  671: 	cpu->cd.arm.cpsr &= 0x0fffffff;
  672: 	cpu->cd.arm.cpsr |= (cpu->cd.arm.flags << 28);
  673: 
  674: 	switch (arm_exception_to_mode[exception_nr]) {
  675: 	case ARM_MODE_SVC32:
  676: 		cpu->cd.arm.spsr_svc = cpu->cd.arm.cpsr; break;
  677: 	case ARM_MODE_ABT32:
  678: 		cpu->cd.arm.spsr_abt = cpu->cd.arm.cpsr; break;
  679: 	case ARM_MODE_UND32:
  680: 		cpu->cd.arm.spsr_und = cpu->cd.arm.cpsr; break;
  681: 	case ARM_MODE_IRQ32:
  682: 		cpu->cd.arm.spsr_irq = cpu->cd.arm.cpsr; break;
  683: 	case ARM_MODE_FIQ32:
  684: 		cpu->cd.arm.spsr_fiq = cpu->cd.arm.cpsr; break;
  685: 	default:fatal("arm_exception(): unimplemented exception nr\n");
  686: 		exit(1);
  687: 	}
  688: 
  689: 	/*
  690: 	 *  Disable Thumb mode (because exception handlers always execute
  691: 	 *  in ARM mode), set the exception mode, and disable interrupts:
  692: 	 */
  693: 	cpu->cd.arm.cpsr &= ~ARM_FLAG_T;
  694: 
  695: 	oldmode = cpu->cd.arm.cpsr & ARM_FLAG_MODE;
  696: 
  697: 	cpu->cd.arm.cpsr &= ~ARM_FLAG_MODE;
  698: 	cpu->cd.arm.cpsr |= arm_exception_to_mode[exception_nr];
  699: 
  700: 	/*
  701: 	 *  Usually, an exception should change modes (so that saved status
  702: 	 *  bits don't get lost). However, Linux on ARM seems to use floating
  703: 	 *  point instructions in the kernel (!), and it emulates those using
  704: 	 *  its own fp emulation code. This leads to a situation where we
  705: 	 *  sometimes change from SVC32 to SVC32.
  706: 	 */
  707: 	newmode = cpu->cd.arm.cpsr & ARM_FLAG_MODE;
  708: 	if (oldmode == newmode && oldmode != ARM_MODE_SVC32) {
  709: 		fatal("[ WARNING! Exception caused no mode change? "
  710: 		    "mode 0x%02x (pc=0x%x) ]\n", newmode, (int)cpu->pc);
  711: 		/*  exit(1);  */
  712: 	}
  713: 
  714: 	cpu->cd.arm.cpsr |= ARM_FLAG_I;
  715: 	if (exception_nr == ARM_EXCEPTION_RESET ||
  716: 	    exception_nr == ARM_EXCEPTION_FIQ)
  717: 		cpu->cd.arm.cpsr |= ARM_FLAG_F;
  718: 
  719: 	/*  Load the new register bank, if we switched:  */
  720: 	arm_load_register_bank(cpu);
  721: 
  722: 	/*
  723: 	 *  Set the return address and new PC.
  724: 	 *
  725: 	 *  NOTE: r[ARM_PC] is also set; see cpu_arm_instr_loadstore.c for
  726: 	 *  details. (If an exception occurs during a load into the pc
  727: 	 *  register, the code in that file assumes that the r[ARM_PC]
  728: 	 *  was changed to the address of the exception handler.)
  729: 	 */
  730: 	cpu->cd.arm.r[ARM_LR] = retaddr;
  731: 	cpu->pc = cpu->cd.arm.r[ARM_PC] = exception_nr * 4 +
  732: 	    ((cpu->cd.arm.control & ARM_CONTROL_V)? 0xffff0000 : 0);
  733: 	quick_pc_to_pointers(cpu);
  734: }
