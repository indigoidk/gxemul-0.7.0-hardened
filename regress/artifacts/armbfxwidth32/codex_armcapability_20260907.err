  218: 	CHECK_ALLOCATION(left = (char *) malloc(MAX_CMD_BUFLEN));
  219: 	strlcpy(left, cmd, MAX_CMD_BUFLEN);
  220: 	right = strchr(left, '=');
  221: 	if (right == NULL) {
  222: 		fprintf(stderr, "internal error in the debugger\n");
  223: 		exit(1);
  224: 	}
  225: 	*right = '\0';
  226: 
  227: 	/*  Remove trailing spaces in left:  */
  228: 	while (strlen(left) >= 1 && left[strlen(left)-1] == ' ')
  229: 		left[strlen(left)-1] = '\0';
  230: 
  231: 	/*  Remove leading spaces in right:  */
  232: 	right++;
  233: 	while (*right == ' ' && *right != '\0')
  234: 		right++;
  235: 
  236: 	/*  printf("left  = '%s'\nright = '%s'\n", left, right);  */
  237: 
  238: 	res_right = debugger_parse_expression(m, right, 0, &tmp);
  239: 	switch (res_right) {
  240: 	case PARSE_NOMATCH:
  241: 		printf("No match for the right-hand side of the assignment.\n");
  242: 		break;
  243: 	case PARSE_MULTIPLE:
  244: 		printf("Multiple matches for the right-hand side of the "
  245: 		    "assignment.\n");
  246: 		break;
  247: 	default:
  248: 		res_left = debugger_parse_expression(m, left, 1, &tmp);
  249: 		switch (res_left) {
  250: 		case PARSE_NOMATCH:
  251: 			printf("No match for the left-hand side of the "
  252: 			    "assignment.\n");
  253: 			break;
  254: 		case PARSE_MULTIPLE:
  255: 			printf("Multiple matches for the left-hand side "
  256: 			    "of the assignment.\n");
  257: 			break;
  258: 		default:
  259: 			debugger_cmd_print(m, left);
  260: 		}
  261: 	}
  262: 
  263: 	/*
  264: 	 *  If the PC has changed, then release any breakpoint we were
  265: 	 *  currently stopped at.
  266: 	 *
  267: 	 *  TODO: multiple cpus?
  268: 	 */
  269: 	if (old_pc != m->cpus[0]->pc)
  270: 		single_step_breakpoint = 0;
  271: 
  272: 	free(left);
  273: }
