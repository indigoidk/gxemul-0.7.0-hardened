 383:     ]),
 384:     ("372 be cold", "barearm", store_prog(MOV_R0_COLD), SEED_WARM_W, [
 385:         ("be cold word", "r2", 0x11223344, 0x44332211, "DISC"),
 386:         ("be cold byte0", "r3", 0x11, 0x44, "DISC"),
 387:         ("be cold byte1", "r4", 0x22, 0x33, "DISC"),
 388:         ("be cold byte2", "r5", 0x33, 0x22, "DISC"),
 389:         ("be cold byte3", "r6", 0x44, 0x11, "DISC"),
