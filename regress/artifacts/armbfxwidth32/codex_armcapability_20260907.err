 216:     #  Free-run with NO breakpoint (read-ahead ON). The (d) row hangs by
 217:     #  design, so continue may never return; grace-then-^C, and if the prompt
 218:     #  does not come back, terminate rather than queue dump/reg into a live
 219:     #  session (which would time out ~60 s each).
 220:     cmark = len(buf)
 221:     os.write(fd, b"continue\n")
 222:     t = time.time()
 223:     while time.time() - t < grace:
 224:         rd(0.3)
 225:     if not (len(buf) > cmark and buf[cmark:].rstrip().endswith("GXemul>")):
 226:         os.write(fd, b"\x03")
