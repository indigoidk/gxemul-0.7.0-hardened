 195: def ldrd_pc_prog():
 196:     """R4: ldrd r0,[pc,#0x40] with three distinct words planted.
 197: 
 198:     r0/r1 identify WHICH pair was read, so a base that is four bytes high is
 199:     distinguishable from a correct one rather than merely 'not the sentinel'.
