 393:     ]),
 394:     ("372 le cold", "testarm", store_prog(MOV_R0_COLD), SEED_WARM_W, [
 395:         ("le cold word", "r2", 0x11223344, 0x11223344, "CTRL"),
 396:         ("le cold byte0", "r3", 0x44, 0x44, "CTRL"),
 397:         ("le cold byte1", "r4", 0x33, 0x33, "CTRL"),
 398:         ("le cold byte2", "r5", 0x22, 0x22, "CTRL"),
 399:         ("le cold byte3", "r6", 0x11, 0x11, "CTRL"),
