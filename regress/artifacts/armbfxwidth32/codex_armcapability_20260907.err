 425:         ("be ldm cold r2", "r2", 0x55667788, 0x55667788, "CTRL"),
 426:     ]),
 427:     ("378 le stm warm", "testarm", stm_prog(MOV_R3_WARM), SEED_WARM_W, [
 428:         ("le stm warm b0", "r4", 0x44, 0x44, "CTRL"),
 429:         ("le stm warm b1", "r5", 0x33, 0x33, "CTRL"),
 430:         ("le stm warm b2", "r6", 0x22, 0x22, "CTRL"),
 431:         ("le stm warm b3", "r7", 0x11, 0x11, "CTRL"),
 432:     ]),
 433:     ("378 le ldm warm", "testarm", ldm_prog(MOV_R3_WARM),
 434:      SEED_WARM_W + seed_bytes(WARM), [
 435:         ("le ldm warm r1", "r1", 0x44332211, 0x44332211, "CTRL"),
 436:         ("le ldm warm r2", "r2", 0x88776655, 0x88776655, "CTRL"),
 437:     ]),
 438:     #  ---- #386 rows: X(swp) was LE-only on BOTH its load-assemble and its
 439:     #  store-emit, and used the RAW address with no rotate (DDI 0100I A4.1.108
