  270: def run(machine, prog, seeds, regs):
  271:     #  A raw stub just makes the machine construct. barearm lays no LE halt stub
  272:     #  of its own (unlike testarm), so nothing decodes as garbage post-flip.
  273:     stub = "/tmp/gx_endian_%s.bin" % machine
  274:     order = ">I" if machine == "barearm" else "<I"
  275:     import struct
  276:     with open(stub, "wb") as f:
  277:         f.write(struct.pack(order, 0xE1A00000))
  278:     pid, fd = pty.fork()
  279:     if pid == 0:
  280:         os.execvp(BIN, [BIN, "-V", "-A", "-E", machine, "-M", "64",
  281:                         "0x%x:%s" % (CODE, stub)])
  282:         os._exit(127)
  283:     buf = ""
  284: 
  285:     def rd(t=0.4):
  286:         nonlocal buf
  287:         r, _, _ = select.select([fd], [], [], t)
  288:         if fd not in r:
  289:             return True
  290:         try:
  291:             d = os.read(fd, 65536)
  292:         except OSError:
  293:             return False
  294:         if not d:
  295:             return False
  296:         buf += d.decode("latin1", "replace")
  297:         return True
  298: 
  299:     def wait_from(mark, timeout=30):
  300:         t = time.time()
  301:         while time.time() - t < timeout:
  302:             if not rd():
  303:                 return False
  304:             if len(buf) > mark and buf[mark:].rstrip().endswith("GXemul>"):
  305:                 return True
  306:         return False
  307: 
  308:     #  #391: send() used to DISCARD wait_from()'s verdict and return the slice
  309:     #  regardless.  That is a FALSE PASS in the one place this probe says it
  310:     #  must never allow one (see the #379 comment below): on a wait TIMEOUT the
  311:     #  slice is EMPTY, `"FAILED" in ""` is False, so a `put` that never landed
  312:     #  scored as landed, PUT_STATUS printed OK, and gate 14's "endian puts all
  313:     #  landed" check asserted OK on evidence it never received.  The timeout is
  314:     #  now recorded out-of-band, so send()'s return contract is unchanged and
  315:     #  every existing caller keeps working.
  316:     timeouts = []
  317: 
  318:     def send(sx):
  319:         mark = len(buf)
  320:         b = (sx + "\n").encode("latin1")
  321:         n = 0
  322:         while n < len(b):
  323:             n += os.write(fd, b[n:])
  324:         if not wait_from(mark):
  325:             timeouts.append(sx)
  326:         return buf[mark:]
  327: 
  328:     if not wait_from(0, 60):
  329:         try:
  330:             os.kill(pid, 9); os.waitpid(pid, 0)
  331:         except Exception:
  332:             pass
  333:         return None
  334: 
  335:     #  #379: every seed/program `put` is CHECKED for the debugger's "FAILED"
  336:     #  echo. The ten warm DISC rows depend on `put w` having warmed the page;
  337:     #  a silently failing put would leave it cold, route the transfer through
  338:     #  bdt_*, and turn every DISC row architecturally green ON A BUGGY BUILD --
  339:     #  a false pass, the one direction a control must never allow.
  340:     #  #391: a put is "landed" only if BOTH hold -- the debugger did not echo
  341:     #  FAILED, AND the command actually completed.  Checking only the echo
  342:     #  meant a timed-out put, whose slice is empty, scored as success.  A put
  343:     #  that never completed is exactly the silently-cold-page case the comment
  344:     #  above says must never pass.
  345:     put_ok = True
  346:     n_timeouts_before = len(timeouts)
  347:     for s in seeds:
  348:         if "FAILED" in send(s):
  349:             put_ok = False
  350:     for i, iw in enumerate(prog):
  351:         if "FAILED" in send("put w 0x%x, 0x%08x" % (CODE + 4 * i, iw)):
  352:             put_ok = False
  353:     if len(timeouts) != n_timeouts_before:
  354:         put_ok = False
  355:     send("pc=0x%x" % CODE)
  356:     send("step %d" % (len(prog) - 1))    # straight-line, ends at the spin
  357: 
  358:     out = {"__put_ok": put_ok}
  359:     for rn in regs:
  360:         mark = len(buf)
  361:         send("print %s" % rn)
  362:         m = re.search(r"(?m)^0x([0-9a-fA-F]+)\s*$", buf[mark:])
