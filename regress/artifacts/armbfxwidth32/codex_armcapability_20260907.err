  47:         0xE3A0E0EE,             # 6  mov lr,#0xee
  48:         0xE8B15018,             # 7  L: ldmia r1!,{r3,r4,ip,lr}
  49:         0xE8A05018,             # 8  stmia r0!,{r3,r4,ip,lr}
  50:         0xE8B15018,             # 9  ldmia r1!,{r3,r4,ip,lr}
