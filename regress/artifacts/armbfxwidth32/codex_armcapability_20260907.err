 1313: static void debugger_cmd_print(struct machine *m, char *args)
 1314: {
 1315: 	int res;
 1316: 	uint64_t tmp;
 1317: 
 1318: 	while (args[0] != '\0' && args[0] == ' ')
 1319: 		args ++;
 1320: 
 1321: 	if (args[0] == '\0') {
 1322: 		printf("syntax: print expr\n");
 1323: 		return;
 1324: 	}
 1325: 
 1326: 	res = debugger_parse_expression(m, args, 0, &tmp);
 1327: 	switch (res) {
 1328: 	case PARSE_NOMATCH:
 1329: 		printf("No match.\n");
 1330: 		break;
 1331: 	case PARSE_MULTIPLE:
 1332: 		printf("Multiple matches. Try prefixing with %%, $, or @.\n");
 1333: 		break;
 1334: 	case PARSE_SETTINGS:
 1335: 		printf("%s = 0x%" PRIx64"\n", args, (uint64_t)tmp);
 1336: 		break;
 1337: 	case PARSE_SYMBOL:
 1338: 		if (m->cpus[0]->is_32bit)
 1339: 			printf("%s = 0x%08" PRIx32"\n", args, (uint32_t)tmp);
 1340: 		else
 1341: 			printf("%s = 0x%016" PRIx64"\n", args,(uint64_t)tmp);
 1342: 		break;
 1343: 	case PARSE_NUMBER:
 1344: 		printf("0x%" PRIx64"\n", (uint64_t) tmp);
 1345: 		break;
 1346: 	}
 1347: }
