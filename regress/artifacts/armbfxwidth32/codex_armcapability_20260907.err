 220: #  #386 unaligned seeds: the P+4 sentinel byte must NOT be 0x55 -- the buggy
 221: #  raw store's last byte (LE emit of 0x55667788) lands 0x55 at P+4, so a 0x55
 222: #  seed would make survival and corruption indistinguishable. 0x99 is disjoint
 223: #  from every seed and store byte.
 224: def swp_unal_seeds():
 225:     return seed_bytes(COLD)[:4] + ["put b 0x%x, 0x99" % (COLD + 4)]
