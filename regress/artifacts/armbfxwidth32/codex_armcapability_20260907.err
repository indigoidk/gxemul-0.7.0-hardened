 212: def swp_unal_prog():
 213:     #  r0 = P+1 for the swp only; the ladder re-bases at the aligned P and adds
 214:     #  the P+4 sentinel read. Pre-fix the swp reads/writes 4 RAW bytes at P+1;
 215:     #  post-fix both accesses use P and the load rotates (DDI 0100I A4.1.108).
 216:     return (BUILD_R1_5567 + [MOV_R0_COLD, ADD_R0_1, SWP_R2_R1_R0, SUB_R0_1]
 217:             + list(LDRB) + [LDRB_R7_R0_4, SPIN])
