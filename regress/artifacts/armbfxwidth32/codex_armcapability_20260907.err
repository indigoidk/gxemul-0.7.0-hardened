 257: 
 258: #  #387: the +2 groups seed P+5 explicitly (0xAA, disjoint from everything)
 259: #  so the buggy raw P+2..P+5 read has a defined fourth byte that does not
 260: #  lean on the unseeded-RAM-is-zero assumption.
 261: def swp_un2_prog():
 262:     return (BUILD_R1_5567 + [MOV_R0_COLD, ADD_R0_2, SWP_R2_R1_R0, SUB_R0_2]
 263:             + list(LDRB) + [LDRB_R7_R0_4, SPIN])
 264: 
 265: 
 266: def swp_un2_seeds():
 267:     return swp_unal_seeds() + ["put b 0x%x, 0xaa" % (COLD + 5)]
