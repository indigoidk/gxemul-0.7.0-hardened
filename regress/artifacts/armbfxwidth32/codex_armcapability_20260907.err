 1005: 			} else {
 1006: 				debugmsg(SUBSYS_EMUL, "idle", VERBOSITY_DEBUG, "idling the host processor...");
 1007: 
 1008: 				// Attempt to "idle the host", by sleeping for a short while.
 1009: 				// usleep() may return EINTR, if a signal was just delivered.
 1010: 				// In that case, naively try again once.
 1011: 				if (usleep(500) != 0) {
 1012: 					debugmsg(SUBSYS_EMUL, "idle", VERBOSITY_DEBUG, "usleep() interrupted once. retrying.");
 1013: 					if (usleep(500) != 0)
 1014: 						debugmsg(SUBSYS_EMUL, "idle", VERBOSITY_DEBUG, "usleep() interrupted twice! not retrying.");
 1015: 				}
 1016: 			}
 1017: 		}
 1018: 
 1019: 		/*  Flush X11 and serial console output every now and then:  */
 1020: 		if (bootcpu->ninstrs > bootcpu->ninstrs_flush + (1<<19)) {
 1021: 			x11_check_event(emul);
 1022: 			console_flush();
 1023: 			bootcpu->ninstrs_flush = bootcpu->ninstrs;
 1024: 		}
 1025: 
 1026: 		if (bootcpu->ninstrs > bootcpu->ninstrs_show + (1<<25)) {
 1027: 			bootcpu->ninstrs_since_gettimeofday +=
 1028: 			    (bootcpu->ninstrs - bootcpu->ninstrs_show);
 1029: 			cpu_show_cycles(emul->machines[0], false);
 1030: 			bootcpu->ninstrs_show = bootcpu->ninstrs;
 1031: 		}
 1032: 		
 1033: 		if (about_to_enter_single_step) {
 1034: 			single_step = true;
 1035: 			about_to_enter_single_step = false;
 1036: 		}
 1037: 
 1038: 		if (single_step)
 1039: 			debugger();
 1040: 
 1041: 		if (emul_shutdown)
 1042: 			break;
 1043: 
 1044: 		emul_executing = true;
 1045: 
 1046: 		bool any_machine_still_running = false;
 1047: 		for (int i = 0; i < emul->n_machines; i++)
 1048: 			any_machine_still_running |= machine_run(emul->machines[i]);
 1049: 
 1050: 		emul_executing = false;
 1051: 
 1052: 		if (!any_machine_still_running) {
 1053: 			if (debugger_enter_at_end_of_run) {
 1054: 				debugmsg(SUBSYS_EMUL, NULL, VERBOSITY_WARNING, "All machines stopped.");
 1055: 				debugger_reset();
 1056: 				single_step = true;
 1057: 			} else {
 1058: 				break;
 1059: 			}
 1060: 		}
 1061: 	}
 1062: 
 1063: 
 1064: 	/*  Stop any running timers:  */
 1065: 	timer_stop();
 1066: 
 1067: 	/*  Deinitialize all CPUs in all machines:  */
 1068: 	for (int j = 0; j <emul->n_machines; j++)
 1069: 		cpu_run_deinit(emul->machines[j]);
 1070: 
 1071: 	console_deinit_main();
 1072: }
