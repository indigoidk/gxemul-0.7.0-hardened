 140: #  #390: `str rX,[pc,#imm]` used a base of instruction+12 where A5.2.2 (and
 141: #  A5.2.3/A5.2.4, and A5.3.2/A5.3.3 for mode 3) define R15-as-Rn to be the
 142: #  address of the instruction PLUS EIGHT.  One scratch word was serving two
 143: #  roles -- the BASE when Rn == PC, and the DATA when Rd == PC -- and the store
 144: #  arm set it to +12 for both.  LDRD was caught in it too: mode 3 encodes LDRD
 145: #  with L == 0, so the generator never defines A__L for it and it takes the
 146: #  store arm despite being a load.
 147: #
 148: #  Readback is ALWAYS through a register base, never a pc-relative load: the
 149: #  decoder folds pc-relative LOADS into a constant MOV at TRANSLATE time, so
 150: #  such a load reports the bytes as they were BEFORE the store under test.
 151: STR_R4_PC_40  = 0xE58F4040      # str r4,[pc,#0x40]
 152: STR_PC_R7     = 0xE587F000      # str pc,[r7]
 153: STR_PC_PC_40  = 0xE58FF040      # str pc,[pc,#0x40]
 154: LDRD_R0_PC_40 = 0xE1CF04D0      # ldrd r0,[pc,#0x40]
 155: MOV_R7_20000  = 0xE3A07802      # mov r7,#0x20000
 156: MOV_R3_8000   = 0xE3A03C80      # mov r3,#0x8000   (0x80 ror 24)
 157: ORR_R3_58     = 0xE3833058      # orr r3,r3,#0x58  -> r3 = 0x8058
 158: ORR_R3_48     = 0xE3833048      # orr r3,r3,#0x48  -> r3 = 0x8048
 159: LDR_R5_R3     = 0xE5935000      # ldr r5,[r3]
 160: LDR_R6_R3_4   = 0xE5936004      # ldr r6,[r3,#4]
 161: LDR_R5_R7     = 0xE5975000      # ldr r5,[r7]
