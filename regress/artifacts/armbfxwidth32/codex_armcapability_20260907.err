codex
The answer to the main question is yes: `arm_flags_probe.py`, `arm_endian_probe.py`, and `footbridge_sites_probe.py` explicitly plant instruction words with `put w`, set `pc`, and step them. Several other ARM probes plant programs and use `continue`. I’m checking cache invalidation and unsupported-instruction handling to establish the limits of that capability.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "rg -n '"'^void debugger_cmd_(put|print|step)|''^int debugger_parse|''^int debugger|invalidate|CPU_ARM|ARM_PC|register_match|single_step|settings_set'"' GXEMUL-SEC/src/debugger/debugger_cmds.c GXEMUL-SEC/src/debugger/debugger_expr.c GXEMUL-SEC/src/debugger/debugger.c
rg -n 'ARM_REG_NAMES|CPU_NEW|arm_cpu_new|register_match|register.*settings|settings_add|\"pc\"|\"cpsr\"|\"spsr\"|byte_order|memory_rw|translate_v2p' GXEMUL-SEC/src/cpus/cpu_arm.c GXEMUL-SEC/src/include/cpu_arm.h
rg -n 'barearm|testarm|physical_ram_in_mb|dev_ram_init\\(|memory_offset_in_mb|ram_offset' GXEMUL-SEC/src/core/machine.c GXEMUL-SEC/src/core/emul.c GXEMUL-SEC/src/machines/machine_test.c
rg -n 'store_32bit_word|invalidate_code_translation|INVALIDATE_ALL|INVALIDATE_VADDR|invalidate_translation_caches' GXEMUL-SEC/src/memory GXEMUL-SEC/src/cpus/cpu_dyntrans.c GXEMUL-SEC/src/cpus/tmp_arm_head.c GXEMUL-SEC/src/cpus/tmp_arm_tail.c" in C:\DocumentNoSnc\CC\GXEMUL
