 280:     rows.append(ok)
 281:     g = ("0x%08x" % got) if isinstance(got, int) else str(got)
 282:     w = ("0x%08x" % want) if isinstance(want, int) else str(want)
 283:     print("%-26s %-12s %-12s %s %s" % (name, g, w, kind, "ok" if ok else "FAIL"))
 284: 
 285: 
 286: #  ---- control: the rig must execute guest code, and -J must fold nothing ----
 287: #  If the -J architectural reference for the exit path is not dest=0/NZCV=0xA,
 288: #  the probe has measured nothing and no row may be believed.
 289: _flat, _reg, _ = session(prog_exit(4, 0xE3590001), ["-J"])
 290: _ctrl_dest = dumpw(_flat, 0)
 291: _ctrl_nzcv = (dumpw(_flat, 1) >> 28) & 0xF if dumpw(_flat, 1) is not None else None
 292: control = "OK" if (_ctrl_dest == 0 and _ctrl_nzcv == 0xA) else "DEAD"
 293: print("IDLE_CONTROL=%s" % control)
 294: if control != "OK":
 295:     print("IDLE_RESULT=0/0")
 296:     sys.exit(0)
 297: 
 298: #  ---- (a)/(b) exit path: dest and flags, read-ahead ON ----------------------
 299: #  flag seed cmp r9,#1 -> 0x6 (Z=1,C=1); owed after teqs(0x80000000) is
 300: #  N=1 Z=0 C=1 V=0 = 0xA -- every N/Z bit moves off the seed.
 301: _flat, _reg, _ = session(prog_exit(4, 0xE3590001), [])
 302: row("A idle exit dest", "DISC", dumpw(_flat, 0), 0)
 303: row("A idle exit flags", "DISC",
 304:     (dumpw(_flat, 1) >> 28) & 0xF if dumpw(_flat, 1) is not None else None, 0xA)
 305: 
 306: #  ---- idle path: rZ = 0, distinct flag seed with Z CLEAR --------------------
 307: #  cmp r9,#2 (r9=1) -> 1-2 = N=1 Z=0 C=0 V=0 = 0x8; owed idle flags are
 308: #  Z=1 N=0 C=0 (C preserved from the seed) = 0x4. Guest idles on both builds.
 309: _flat, _reg, _ = session(prog_idle(0xE3590002), [])
 310: row("A idle path dest", "DISC", reg(_reg, "r2"), 0)
 311: row("A idle path flags", "DISC", nzcv_from_reg(_reg), 0x4)
 312: 
 313: #  ---- (c) register-alias: fixed IDLES, buggy EXITS (sentinel 0x55) ----------
 314: #  want == 0xdeadbeef is the DEST prefill, i.e. "the exit store never ran", not
 315: #  a self-evidently-non-seed value -- so this row's anti-vacuity rests on the
 316: #  IDLE_CONTROL bail and the `alias -J ref` PIN below (which fix the program's
 317: #  architectural answer as idle). Pre-fix it measures 0x55; keep it beside those
 318: #  two guards (Opus's round-100 note).
 319: _flat, _reg, _ = session(PROG_ALIAS, [])
 320: row("A idle alias exits", "DISC", dumpw(_flat, 0), 0xdeadbeef)   # deadbeef = idled
 321: 
 322: #  ---- (d) forward beq: fixed REACHES B (0x55), buggy HANGS (deadbeef) -------
 323: _flat, _reg, _ = session(PROG_TARGET, [])
 324: row("A idle target reached", "DISC", dumpw(_flat, 0), 0x55)
 325: 
 326: #  ---- #352 marker: fires on the exit path under verbosity, quiet by default -
 327: _flat, _reg, vbuf = session(prog_exit(4, 0xE3590001), [], verbose=True)
 328: fires = ("yes" if MARK.search(vbuf or "") else "no") \
 329:     if "3: DEBUG" in (vbuf or "") else "no-verb"
 330: row("A idle fires", "DISC", fires, "yes")
 331: _flat, _reg, qbuf = session(prog_exit(4, 0xE3590001), [])
 332: row("A idle quiet", "PIN", "%d" % (len(MARK.findall(qbuf or ""))), "0")
 333: 
 334: #  ---- architectural reference: the alias program under -J (combining OFF) must
 335: #  idle, so the `alias exits` DISC above attributes its buggy 0x55 to the FOLD
 336: #  and not to the program being wrong. This is a reference PIN, not a proof of
 337: #  the read-ahead-install mechanism -- the straight-line `fires` row is that
 338: #  proof (a marker on a single forward pass can only appear if the fold was
 339: #  installed ahead of execution).  -----------------------------------------
 340: _flat, _reg, _ = session(PROG_ALIAS, ["-J"])
 341: row("A idle alias -J ref", "PIN", dumpw(_flat, 0), 0xdeadbeef)
 342: 
 343: print("IDLE_RESULT=%d/%d" % (sum(1 for r in rows if r), len(rows)))
GXEMUL-SEC\regress\arm_fold_marker_probe.py
   1: #!/usr/bin/env python3
   2: """#358: fold-fired markers for netbsd_copyin / netbsd_copyout.
   3: 
   4: WHY THESE TWO FOLDS AND WHY NOW. Both replace six user-mode transfers with one C
   5: function whose registers, read/written addresses and instruction billing are
   6: IDENTICAL to the instructions they replace, so a row asserting their result
   7: passes whether or not the fold ever fires. Until #357 there was exactly one
   8: witness: the load/store template masked its base writeback while these folds did
   9: not, so an unaligned base gave r0 = 0x10019 folded against 0x10018 genuine.
  10: #357 corrected the template -- the folds were right all along -- and that
  11: one-bit detector disappeared with it. These two folds also had NO harness rows of
  12: any kind, so #358 adds the marker and this probe adds the first rows.
  13: 
  14: THE ROWS ARE FREE-RUNNING, AND THAT IS NOT A STYLE CHOICE. Three measured facts,
  15: each of which independently breaks a plausible-looking row:
  16: 
  17:   - STEPPING UN-FOLDS THE SLOT. A `step` onto a fold slot re-translates it
  18:     UNCOMBINED, so the step executes a plain instruction and no marker appears.
  19:     A row driven with `step` therefore measures the genuine sequence while
  20:     believing it measured the fold. (This is also why an earlier pc-stride
  21:     experiment here read pc + 4: not "a breakpoint suppresses the fold", which
  22:     was the first guess, but stepping destroying the thing it would measure.)
  23:   - A BREAKPOINT INSIDE THE LOOP GIVES ZERO FOLDS ON A HEALTHY BINARY. Measured
  24:     over 8 passes: breakpoint after the sequence gives 1 matcher install and 7
  25:     folds; breakpoint inside gives 8 installs and 0 folds, because the block is
  26:     re-translated every pass. That row would read exactly like a dead fold, and
  27:     the signature is invisible without instrumenting the matcher.
  28:   - A BREAKPOINT ANYWHERE DISABLES READ-AHEAD, so the combiner installs only
  29:     AFTER the entry slot has already dispatched once, making the fold count
  30:     `passes - 1` rather than `passes`. Any row's expected count must be a number
  31:     derived from that rule, never "greater than zero".
  32: 
  33: A breakpoint ON the entry slot is worse still: that path re-marks its own slot
  34: for retranslation and the matchers test ic[i].f, so a fold can never install
  35: there at all.
  36: 
  37: TWO PASSES ARE REQUIRED. The folds gate on is_userpage, which only an access
  38: carrying the user-access flag sets -- and that access is the general handler the
  39: fold's own bail-out delegates to. So pass 1 always runs genuinely and sets the
  40: bit; only pass 2 and later can fold.
  41: 
  42: PAGE LAYOUT IS LOAD-BEARING. The user page must differ from the code page,
  43: because instruction translation updates the code page's entry WITHOUT the user
  44: flag and the translation layer clears the bit before re-setting it. Code 0x8000,
  45: user data 0x10000 (loads) / 0x11000 (stores), and nothing is published to memory.
  46: Measured deterministic: 5 consecutive runs gave identical results.
  47: 
  48: EACH FOLD GETS A PAIR, so neither row can be vacuous in either direction:
  49:   fires (DISC) -- combining on, marker present, AND the verbosity echo present.
  50:                   The echo matters: a session whose verbosity raise silently
  51:                   failed would report zero markers and look exactly like a dead
  52:                   fold, so a row that only counted markers could pass for the
  53:                   wrong reason. It also asserts the six transferred values, so
  54:                   the row proves the work happened, not merely that a line was
  55:                   printed.
  56:   quiet (PIN)  -- default verbosity, zero markers. Must use continue/free-run,
  57:                   NEVER `step`: single-step BYPASSES the verbosity gate, so a
  58:                   stepped session prints markers at default verbosity and this
  59:                   row would fail for a reason that has nothing to do with the
  60:                   fold.
  61: 
  62: Proven non-vacuous before shipping, on a scratch tree built from this exact
  63: source with ONLY this fold's arming line removed and combining otherwise
  64: enabled: markers 0 with the arming gone, 1 with it present, verbosity confirmed
  65: raised in both. That isolates the fold's own arming rather than all combining,
  66: which `-J` alone would not.
  67: """
  68: import os
  69: import pty
  70: import re
  71: import select
  72: import sys
  73: import time
  74: 
  75: BIN = sys.argv[1]
  76: CODE = 0x8000
  77: LOADSRC = 0x10000          # user page read by copyin
  78: STOREDST = 0x11000         # user page written by copyout
  79: 
  80: #  Every encoding below was confirmed through the emulator's own `unassemble`
  81: #  before use. The six-transfer register ORDER is fixed by the matchers, which
  82: #  pin each transfer's register, and by the arming iword of the sixth.
  83: #    copyin : ldrt sl,fp,r6,r7,r8,r9 from [r0],#4   arming 0xe4b09004
  84: #    copyout: strt r8,r9,sl,fp,r6,r7 to  [r1],#4    arming 0xe4a17004
  85: COPYIN = [
  86:     0xE3A03001,   # mov  r3,#1            two passes
  87:     0xE3A00801,   # L: mov r0,#0x10000    user page, distinct from code
  88:     0xE4B0A004,   # ldrt sl,[r0],#4       <- fold entry slot
  89:     0xE4B0B004,   # ldrt fp,[r0],#4
  90:     0xE4B06004,   # ldrt r6,[r0],#4
  91:     0xE4B07004,   # ldrt r7,[r0],#4
  92:     0xE4B08004,   # ldrt r8,[r0],#4
  93:     0xE4B09004,   # ldrt r9,[r0],#4       arms COMBINE(netbsd_copyin)
  94:     0xE2533001,   # subs r3,r3,#1
  95:     0x5AFFFFF6,   # bpl -> word 1
  96:     0xEAFFFFFE,   # b .
  97: ]
  98: 
  99: COPYOUT = [
 100:     0xE3A03001,   # mov  r3,#1
 101:     0xE3A01A11,   # L: mov r1,#0x11000    user page for the stores
 102:     0xE4A18004,   # strt r8,[r1],#4       <- fold entry slot
 103:     0xE4A19004,   # strt r9,[r1],#4
 104:     0xE4A1A004,   # strt sl,[r1],#4
 105:     0xE4A1B004,   # strt fp,[r1],#4
 106:     0xE4A16004,   # strt r6,[r1],#4
 107:     0xE4A17004,   # strt r7,[r1],#4       arms COMBINE(netbsd_copyout)
 108:     0xE2533001,   # subs r3,r3,#1
 109:     0x5AFFFFF6,   # bpl -> word 1
 110:     0xEAFFFFFE,   # b .
 111: ]
 112: 
 113: 
 114: def session(prog, verbose, seed_regs=None, extra=None, bseed=None,
 115:             machine="testarm", loadsrc_be=False, dump_raw=False):
 116:     """Free-running two-pass session. Returns (marker_count, verb_took, regs).
 117: 
 118:     #383: `machine` selects the rig. `barearm` sets EMUL_BIG_ENDIAN outright
 119:     (machine_test.c) -- the same BE rig arm_endian_probe.py uses -- and is how
 120:     the copyin/copyout folds' byte-order handling is put on the test surface;
 121:     the folds install and fire on BE exactly as on testarm (their matchers gate
 122:     on HOST endianness, not guest). The stub is packed in guest order so its
 123:     fetch decodes. loadsrc_be seeds LOADSRC with `put b` in architectural
 124:     big-endian byte order (11 22 33 44 ...), so every BE expectation traces to
 125:     DDI 0100I Table A2-2 alone rather than to trusting `put w`'s own swap.
 126:     """
 127:     stub = "/tmp/r104f_stub_%s.bin" % machine
 128:     order = "big" if machine == "barearm" else "little"
 129:     with open(stub, "wb") as f:
 130:         f.write((0xE1A00000).to_bytes(4, order))
 131:     pid, fd = pty.fork()
 132:     if pid == 0:
 133:         os.execvp(BIN, [BIN, "-V", "-A"] + (extra or []) +
 134:                   ["-E", machine, "-M", "64", "0x%x:%s" % (CODE, stub)])
 135:         os._exit(127)
 136:     buf = ""
 137: 
 138:     def rd(t=0.4):
 139:         nonlocal buf
 140:         r, _, _ = select.select([fd], [], [], t)
 141:         if fd not in r:
 142:             return True
 143:         try:
 144:             d = os.read(fd, 65536)
 145:         except OSError:
 146:             return False
 147:         if not d:
 148:             return False
 149:         buf += d.decode("latin1", "replace")
 150:         return True
 151: 
 152:     def wait_from(mark, timeout=30):
 153:         t = time.time()
 154:         while time.time() - t < timeout:
 155:             if not rd():
 156:                 return False
 157:             if len(buf) > mark and buf[mark:].rstrip().endswith("GXemul>"):
 158:                 return True
 159:         return False
 160: 
 161:     def send(sx, timeout=30):
 162:         mark = len(buf)
 163:         b = (sx + "\n").encode("latin1")
 164:         n = 0
 165:         while n < len(b):
 166:             n += os.write(fd, b[n:])
 167:         wait_from(mark, timeout)
 168:         return buf[mark:]
 169: 
 170:     if not wait_from(0, 60):
 171:         os.kill(pid, 9); os.waitpid(pid, 0)
 172:         return None
 173: 
 174:     put_failed = False
 175:     if loadsrc_be:
 176:         #  #383: architectural big-endian bytes, laid one at a time with `put b`
 177:         #  (order-free: CACHE_NONE|NO_EXCEPTIONS, so no emulator byte_order code
 178:         #  touches the seed). Word k = 0x11223344+k -> bytes 11 22 33 (44+k).
 179:         for i in range(8):
 180:             w = 0x11223344 + i
 181:             for b in range(4):
 182:                 if "FAILED" in send("put b 0x%x, 0x%x"
 183:                                     % (LOADSRC + 4 * i + b,
 184:                                        (w >> (8 * (3 - b))) & 0xff)):
 185:                     put_failed = True
 186:     else:
 187:         for i in range(8):
 188:             send("put w 0x%x, 0x%08x" % (LOADSRC + 4 * i, 0x11223344 + i))
 189:     #  #361: BYTE seeding, deliberately. `put b` goes through memory_rw with
 190:     #  CACHE_NONE | NO_EXCEPTIONS, so unlike `put w` it does NOT warm the
 191:     #  translation mapping -- measured. The scanc rows warm explicitly with a
 192:     #  guest load through an unpinned base instead, so they do not depend on a
 193:     #  side effect of the seeding width either way.
 194:     for a, v in (bseed or []):
 195:         send("put b 0x%x, 0x%x" % (a, v))
 196:     for r, v in (seed_regs or {}).items():
 197:         send("%s=0x%x" % (r, v))
 198:     for i, iw in enumerate(prog):
 199:         send("put w 0x%x, 0x%08x" % (CODE + 4 * i, iw))
 200:     send("pc=0x%x" % CODE)
 201:     if verbose:
 202:         send("verbosity cpu 3")
 203: 
 204:     #  The program parks in `b .`, so `continue` never returns a prompt on its
 205:     #  own and every later command would sit out its own timeout -- the first
 206:     #  revision of this probe took minutes per session and had to be killed.
 207:     #  Let it free-run briefly (both passes finish in microseconds; the fold
 208:     #  needs pass 2, so this must NOT be a breakpoint stop), then interrupt.
 209:     cmark = len(buf)
 210:     os.write(fd, b"continue\n")
 211:     t = time.time()
 212:     while time.time() - t < 2.0:
 213:         rd(0.3)
 214:     if not (len(buf) > cmark and buf[cmark:].rstrip().endswith("GXemul>")):
 215:         os.write(fd, b"\x03")
 216:         wait_from(cmark, 15)
 217: 
 218:     regs = {"__put_failed": put_failed}   # #383: BE rows assert this (#379 PUT_STATUS)
 219:     #  r3 and r5 are read for the #361 scanc rows: r3 is that fold's three-way
 220:     #  value witness and r5 its run-to-the-end sentinel. Omitting them was a
 221:     #  probe defect that reported r3 = 0 and the sentinel absent while the marker
 222:     #  counts were already correct -- i.e. it looked like the guest had not run
 223:     #  when in fact only the readback was missing.
 224:     for rn in ("sl", "fp", "r6", "r7", "r8", "r9", "r0", "r1", "r3", "r5"):
 225:         mark = len(buf)
 226:         send("print %s" % rn)
 227:         m = re.search(r"(?m)^0x([0-9a-fA-F]+)\s*$", buf[mark:])
 228:         if m:
 229:             regs[rn] = int(m.group(1), 16)
 230:     mem = []
 231:     if prog is COPYOUT or dump_raw:
 232:         mark = len(buf)
 233:         send("dump 0x%x 0x%x" % (STOREDST, STOREDST + 24))
 234:         w = re.findall(r"0x0*[0-9a-f]+\s+((?:[0-9a-f]{8}\s+){1,4})", buf[mark:])
 235:         hexwords = "".join(w).split()[:6]
 236:         if dump_raw:
 237:             #  #383: return the RAW 24 memory bytes in address order. `dump`
 238:             #  renders bytes in memory order; the committed path below then
 239:             #  reassembles them LITTLE-endian, which would INVERT a BE row
 240:             #  (green on the broken build, red on the fixed one). A BE copyout
 241:             #  row compares the byte sequence itself against the architectural
 242:             #  layout, with no assembly-order assumption.
 243:             regs["__dstbytes"] = b"".join(bytes.fromhex(x) for x in hexwords)
 244:         else:
 245:             mem = [int.from_bytes(bytes.fromhex(x), "little")
 246:                    for x in hexwords]
 247:     try:
 248:         os.write(fd, b"quit\n"); time.sleep(0.2)
 249:         os.kill(pid, 9); os.waitpid(pid, 0)
 250:     except Exception:
 251:         pass
 252:     return buf, regs, mem
 253: 
 254: 
 255: def count(buf, name):
 256:     return len([l for l in buf.splitlines() if "%s: combined" % name in l])
 257: 
 258: 
 259: def declined(buf, name):
 260:     return len([l for l in buf.splitlines() if "%s: declined" % name in l])
 261: 
 262: 
 263: def installed(buf, name):
 264:     return len([l for l in buf.splitlines() if "%s: installed" % name in l])
 265: 
 266: 
 267: #  #360: the A/B pair. The `quiet` rows above assert the marker is ABSENT at
 268: #  default verbosity, which tests the verbosity gate rather than the fold. These
 269: #  test the fold: two programs differing by ONE instruction, where the cold arm
 270: #  must produce a DECLINE rather than merely a silence.
 271: #
 272: #  Why "reads zero" is not a control, measured: with verbosity off the guest ran
 273: #  perfectly -- full six-transfer advance -- and reported zero fires AND zero
 274: #  installs, so an install marker does not rescue it either; and a program whose
 275: #  pc never reaches the block also reads zero. Both are indistinguishable from a
 276: #  dead fold if the row only counts absences. So every arm below asserts the
 277: #  verbosity echo, a positive execution witness (the six transferred values,
 278: #  which are identical folded or not and therefore prove the program ran without
 279: #  presuming the fold), and the exact decline count.
 280: #
 281: #  The cold arm replaces the warm-up with a NOP rather than deleting it, so the
 282: #  two programs have identical layout and no address-derived expectation shifts.
 283: NOP = 0xE1A00000            # mov r0,r0
 284: WARM_LDRT = 0xE4B05004      # ldrt r5,[r0],#4   -- sets the user bit for the page
 285: WARM_STRT = 0xE4A15004      # strt r5,[r1],#4   -- copyout warms with a STORE
 286:                             # because that sets host_store under ANY config.
 287:                             # (#382: the older reason "a load leaves host_store
 288:                             # NULL" holds only MMU-on + read-only page; MMU-off
 289:                             # here, a load sets host_store too -- ok-1==1. The
 290:                             # store warm-up is the robust choice, not the only
 291:                             # one -- the corrected fact lives at cpu_arm_instr.c
 292:                             # X(netbsd_copyout) and arm_endian_probe.py:60.)
 293: 
 294: 
 295: def ab_prog(fold, warm):
 296:     """Straight-line single-pass program. No loop, no branch, no breakpoint."""
 297:     if fold == "copyin":
 298:         return ([0xE3A00801,            # mov r0,#0x10000
 299:                  warm and WARM_LDRT or NOP,
 300:                  0xE3A00801,            # mov r0,#0x10000  (re-seed)
 301:                  0xE4B0A004, 0xE4B0B004, 0xE4B06004,
 302:                  0xE4B07004, 0xE4B08004, 0xE4B09004,
 303:                  0xEAFFFFFE])           # b .
 304:     return ([0xE3A01A11,                # mov r1,#0x11000
 305:              warm and WARM_STRT or NOP,
 306:              0xE3A01A11,                # mov r1,#0x11000  (re-seed)
 307:              0xE4A18004, 0xE4A19004, 0xE4A1A004,
 308:              0xE4A1B004, 0xE4A16004, 0xE4A17004,
 309:              0xEAFFFFFE])
 310: 
 311: 
 312: print("=== #358: fold-fired markers, netbsd_copyin / netbsd_copyout ===")
 313: rows = []
 314: 
 315: #  ---- copyin ----------------------------------------------------------------
 316: r = session(COPYIN, True)
 317: if r is None:
 318:     rows.append(("A fold copyin fires", "DISC", "DEAD", False))
 319: else:
 320:     buf, regs, _ = r
 321:     n = count(buf, "netbsd_copyin")
 322:     verb = "3: DEBUG" in buf
 323:     #  The six loaded words prove the work happened; they hold folded or not,
 324:     #  which is why they are part of the row rather than a row of their own.
 325:     vals_ok = (regs.get("sl") == 0x11223344 and regs.get("fp") == 0x11223345
 326:                and regs.get("r6") == 0x11223346 and regs.get("r9") == 0x11223349)
 327:     rows.append(("A fold copyin fires", "DISC",
 328:                  "markers=%d verb=%s vals=%s" % (n, verb, vals_ok),
 329:                  n >= 1 and verb and vals_ok))
 330: 
 331: r = session(COPYIN, False)
 332: if r is None:
 333:     rows.append(("A fold copyin quiet", "PIN", "DEAD", False))
 334: else:
 335:     buf, _, _ = r
 336:     n = count(buf, "netbsd_copyin")
 337:     rows.append(("A fold copyin quiet", "PIN", "markers=%d" % n, n == 0))
 338: 
 339: #  ---- copyout ---------------------------------------------------------------
 340: SEED = {"r6": 0x66660001, "r7": 0x77770002, "r8": 0x88880003,
 341:         "r9": 0x99990004, "sl": 0xAAAA0005, "fp": 0xBBBB0006}
 342: r = session(COPYOUT, True, seed_regs=SEED)
 343: if r is None:
 344:     rows.append(("A fold copyout fires", "DISC", "DEAD", False))
 345: else:
 346:     buf, regs, mem = r
 347:     n = count(buf, "netbsd_copyout")
 348:     verb = "3: DEBUG" in buf
 349:     #  Store order is r8,r9,sl,fp,r6,r7 -- pinned by the matcher. Asserting the
 350:     #  MEMORY makes a future permutation regression visible, which a
 351:     #  register-only row could not see.
 352:     want = [SEED["r8"], SEED["r9"], SEED["sl"],
 353:             SEED["fp"], SEED["r6"], SEED["r7"]]
 354:     mem_ok = (mem == want)
 355:     rows.append(("A fold copyout fires", "DISC",
 356:                  "markers=%d verb=%s mem=%s" % (n, verb, mem_ok),
 357:                  n >= 1 and verb and mem_ok))
 358: 
 359: r = session(COPYOUT, False, seed_regs=SEED)
 360: if r is None:
 361:     rows.append(("A fold copyout quiet", "PIN", "DEAD", False))
 362: else:
 363:     buf, _, _ = r
 364:     n = count(buf, "netbsd_copyout")
 365:     rows.append(("A fold copyout quiet", "PIN", "markers=%d" % n, n == 0))
 366: 
 367: #  ---- #360: A/B pairs ------------------------------------------------------
 368: #  Expected counts are NUMBERS derived from the mechanism, never thresholds: a
 369: #  straight-line single-pass block dispatches the entry slot exactly once, so a
 370: #  warm arm is 1 fire / 0 declines and a cold arm is 0 fires / 1 decline, with
 371: #  1 install either way because the matcher runs at translation regardless.
 372: SEED2 = {"r5": 0x5A5A0001, "r6": 0x66660001, "r7": 0x77770002,
 373:          "r8": 0x88880003, "r9": 0x99990004, "sl": 0xAAAA0005,
 374:          "fp": 0xBBBB0006}
 375: for fold, warm, want_fire, want_dec in (("copyin", True, 1, 0),
 376:                                         ("copyin", False, 0, 1),
 377:                                         ("copyout", True, 1, 0),
 378:                                         ("copyout", False, 0, 1)):
 379:     nm = "A fold %s %s" % (fold, "warm" if warm else "cold")
 380:     r = session(ab_prog(fold, warm), True, seed_regs=SEED2)
 381:     if r is None:
 382:         rows.append((nm, "DISC" if warm else "PIN", "DEAD", False))
 383:         continue
 384:     buf, regs, _ = r
 385:     full = "netbsd_" + fold
 386:     f, d, i = (count(buf, full), declined(buf, full), installed(buf, full))
 387:     verb = "3: DEBUG" in buf
 388:     #  The execution witness: r0/r1 advanced by the full six transfers. This
 389:     #  holds folded OR not, so it proves the program ran without presuming the
 390:     #  fold -- which is exactly what makes the cold arm's zero meaningful.
 391:     adv = (regs.get("r0") == 0x10000 + 24 if fold == "copyin"
 392:            else regs.get("r1") == 0x11000 + 24)
 393:     ok = (f == want_fire and d == want_dec and i == 1 and verb and adv)
 394:     rows.append((nm, "DISC" if warm else "PIN",
 395:                  "fire=%d dec=%d inst=%d verb=%s adv=%s"
 396:                  % (f, d, i, verb, adv), ok))
 397: 
 398: #  ---- #368: the copyin fold's ROTATION, with an UNALIGNED base ---------------
 399: #  Every arm above bases on `mov r0,#0x10000`, so `r0 & 3 == 0` and #362's
 400: #  six-word rotation block in X(netbsd_copyin) NEVER EXECUTES. Measured: with
 401: #  that block neutralised, the writeback probe stayed 17/17 and this probe stayed
 402: #  14/14. So the rotation shipped unreachable, not merely unmeasured.
 403: #
 404: #  The row is a fold-versus-TEMPLATE differential on ONE binary, not a check
 405: #  against constants computed here. Pass 1 declines (the is_userpage bit is
 406: #  clear), so its six loads run through the very handler the fold's bail-out
 407: #  delegates to; pass 2 folds. r1 accumulates `sl` across both passes, so
 408: #  r1 == 0 iff the two paths AGREE -- and when they do not, pass 1's own value is
 409: #  recoverable as r1 ^ sl. That XOR is the whole design: a row that read
 410: #  registers only at the end would measure pass 2 against hand-arithmetic,
 411: #  because pass 2 OVERWRITES r6-r11 and pass 1's values are gone.
 412: #
 413: #  r1 is the accumulator deliberately: session() already reads it back and only
 414: #  the copyout arms assert it, so the shared helper needs no change.
 415: #
 416: #  #369: the accumulator covers ONE register of six (`sl`), and the reason that
 417: #  is sufficient is load-bearing enough to write down. All six ldrt dispatch the
 418: #  SAME instantiation, load_w1_word_u1_p0_imm, so a template defect cannot hit
 419: #  five destination registers and spare sl -- the six are not independent
 420: #  samples, they are one code path exercised six times. The six `vals` are still
 421: #  compared individually, so a FOLD defect that mangles one register is caught
 422: #  by those; the XOR's job is only the cross-path comparison. If a future change
 423: #  ever specialises one of those six slots to a different handler, this argument
 424: #  lapses and the accumulator must widen -- it would narrow silently otherwise.
 425: #
 426: #  #369: these arms also arm COMBINE(xchg) in passing (any eor_regshort decode
 427: #  arms it) and it declines -- but NOT for the reason #368's record gave. It is
 428: #  not a same-register short-circuit on r1: COMBINE(xchg) reads
 429: #  a = ic[-2].arg[0] and b = ic[-1].arg[0], which at the eor's slot are the
 430: #  `ldrt r8` and `ldrt r9` slots, whose arg[0] are BOTH &r[0] -- the two loads'
 431: #  shared BASE register. So `a != b` fails on that, and independently ic[-2].f
 432: #  is a load handler rather than instr(eor_regshort). Same conclusion, different
 433: #  mechanism. xchg prints only on install, so nothing is emitted either way; and
 434: #  because count()/declined()/installed() are name-scoped, a future xchg decline
 435: #  marker would not disturb these rows.
 436: #
 437: #  THREE offsets, not one. `8 * (r0 & 1)` agrees with `8 * (r0 & 3)` at +1 and
 438: #  differs at +2 and +3, and a guard of `if (r0 & 1)` would skip the rotation
 439: #  entirely at +2 -- one arm cannot tell those apart.
 440: #
 441: #  Every iword was checked through `unassemble`; the branch target especially,
 442: #  since a wrong target silently changes the pass count and the pass count is
 443: #  what makes fire=1/dec=1 a DERIVED number rather than a threshold. 0x5AFFFFF4
 444: #  disassembles as `bpl 0x8008`, which is word index 2 -- the re-seed point.
 445: #
 446: #  HONEST SCOPE -- #370: the bcopyinout claim below is UNVERIFIED. It exists in
 447: #  this tree only in our own writing; no NetBSD source is present, so it is
 448: #  panel recollection, the DDI 0100I provenance pattern. Until someone reads the
 449: #  real bcopyinout.S or disassembles copyin in the battery's ARM kernel image,
 450: #  the honest statement is "these rows pin internal consistency; guest
 451: #  reachability of the unaligned fold path is unverified."
 452: #  REPORTEDLY: NetBSD's bcopyinout.S does `ands r3,r0,#0x03 / bne` before its
 453: #  six-ldrt block, so a real guest never reaches this fold with an unaligned
 454: #  base. These rows pin an INTERNAL-CONSISTENCY property -- the fold agreeing
 455: #  with the handler its own bail-out delegates to, the #342/#355 class -- and not
 456: #  a guest-reachable behaviour. Also note #362's own comment describes the BROKEN
 457: #  build ("pass 1 yields the rotated word while pass 2 folds and yields the
 458: #  unrotated one"); on the shipped build BOTH rotate, so the healthy expectation
 459: #  here is AGREEMENT, not contradiction.
 460: MOV_R1_0 = 0xE3A01000       # mov  r1,#0
 461: EOR_R1_SL = 0xE021100A      # eor  r1,r1,sl
 462: ADD_R0_N = (0xE2800001, 0xE2800002, 0xE2800003)     # add r0,r0,#1 / #2 / #3
 463: 
 464: 
 465: def copyin_unal(n):
 466:     """Two passes, base re-seeded to 0x1000n each pass. No breakpoint anywhere:
 467:     read-ahead must stay alive so the fold is installed before its slot
 468:     dispatches, and a breakpoint would also make the fold count passes - 1."""
 469:     return [
 470:         0xE3A03001,        # 0  mov  r3,#1        two passes
 471:         MOV_R1_0,          # 1  mov  r1,#0        agreement accumulator
 472:         0xE3A00801,        # 2  L: mov r0,#0x10000
 473:         ADD_R0_N[n - 1],   # 3  add  r0,r0,#n     UNALIGNED, re-seeded each pass
 474:         0xE4B0A004,        # 4  ldrt sl,[r0],#4   <- fold entry slot
 475:         0xE4B0B004,        # 5  ldrt fp,[r0],#4
 476:         0xE4B06004,        # 6  ldrt r6,[r0],#4
 477:         0xE4B07004,        # 7  ldrt r7,[r0],#4
 478:         0xE4B08004,        # 8  ldrt r8,[r0],#4
 479:         0xE4B09004,        # 9  ldrt r9,[r0],#4   arms COMBINE(netbsd_copyin)
 480:         EOR_R1_SL,         # 10 eor  r1,r1,sl     0 iff both passes agree
 481:         0xE2533001,        # 11 subs r3,r3,#1
 482:         0x5AFFFFF4,        # 12 bpl -> word 2
 483:         0xEAFFFFFE,        # 13 b .
 484:     ]
 485: 
 486: 
 487: #  ROR 8*n of the six seeded words 0x11223344..0x49. "Rotation absent" would give
 488: #  the UNROTATED words -- which is exactly what the aligned `fires` row asserts,
 489: #  so a fold that stops rotating cannot pass these rows by satisfying that one.
 490: for n in (1, 2, 3):
 491:     rot = 8 * n
 492:     want = tuple(((0x11223344 + k) >> rot) | (((0x11223344 + k) << (32 - rot))
 493:                  & 0xFFFFFFFF) for k in range(6))
 494:     nm = "A fold copyin rot plus%d" % n
 495:     r = session(copyin_unal(n), True, seed_regs=SEED2)
 496:     if r is None:
 497:         rows.append((nm, "DISC", "DEAD", False))
 498:         continue
 499:     buf, regs, _ = r
 500:     f, d, i = (count(buf, "netbsd_copyin"), declined(buf, "netbsd_copyin"),
 501:                installed(buf, "netbsd_copyin"))
 502:     verb = "3: DEBUG" in buf
 503:     #  r0 advanced by the full six transfers from the UNALIGNED base. #357 makes
 504:     #  the fold and the template agree here, so this proves the program ran
 505:     #  without presuming the fold -- a run-witness, not a fold-witness.
 506:     adv = regs.get("r0") == 0x10000 + n + 24
 507:     vals = tuple(regs.get(k) for k in ("sl", "fp", "r6", "r7", "r8", "r9"))
 508:     agree = regs.get("r1") == 0
 509:     ok = (f == 1 and d == 1 and i == 1 and verb and adv
 510:           and vals == want and agree)
 511:     rows.append((nm, "DISC",
 512:                  "fire=%d dec=%d inst=%d adv=%s vals=%s xor=%s"
 513:                  % (f, d, i, adv, vals == want,
 514:                     "unread" if regs.get("r1") is None else "0x%x" % regs["r1"]),
 515:                  ok))
 516: 
 517: 
 518: #  ---- #361: xchg and netbsd_scanc, which had #358 fire markers but no rows ---
 519: #  Every iword below was verified through the emulator's own `unassemble`.
 520: XCHG_POS = [0xE0212002, 0xE0221001, 0xE0212002,   # eor r2,r1,r2 / r1,r2,r1 / r2,r1,r2
 521:             0xE3A0505A, 0xEAFFFFFE]               # sentinel, park
 522: XCHG_NEG = [0xE0211001, 0xE0211001, 0xE0211001,   # eor r1,r1,r1 x3 -- #342 rejects
 523:             0xE3A0505A, 0xEAFFFFFE]
 524: 
 525: #  scanc: warm through r4 (a base the matcher does NOT pin) so the warm-up load
 526: #  is not itself a fold candidate, then the pinned r1/r2 sequence. The two
 527: #  negative arms move ONE immediate each into unmapped space; the layout is
 528: #  otherwise identical so no address-derived expectation shifts.
 529: def scanc_prog(str_base, tbl_base):
 530:     return [str_base, tbl_base, 0xE3A0C0FF,       # mov r1,# / mov r2,# / mov ip,#0xff
 531:             0xE3A04801, 0xE5D43000,               # warm the string page via r4
 532:             0xE3A04802, 0xE5D43000,               # warm the table page via r4
 533:             0xE5D13000,                           # ldrb r3,[r1]  <- fold entry
 534:             0xE7D23003,                           # ldrb r3,[r2,r3]
 535:             0xE113000C,                           # tsts r3,ip    arms the matcher
 536:             0xE3A0505A, 0xEAFFFFFE]               # sentinel, park
 537: 
 538: SC_R1_OK, SC_R2_OK = 0xE3A01801, 0xE3A02802       # r1=0x10000, r2=0x20000
 539: SC_UNMAPPED = 0xE3A01201                          # #0x10000000 -- out of RAM
 540: SC_R2_BAD = 0xE3A02201
 541: 
 542: #  #361: the xchg negative arm is VACUOUS ON ITS OWN, which a measuring seat
 543: #  caught -- install 0 / fire 0 reads identically on a healthy build and on one
 544: #  with xchg's arming removed, so alone it cannot tell "the matcher rejected the
 545: #  shape" from "the matcher does not exist". That is the very defect #360 was
 546: #  about. Rather than relocate #342's `a != b` term into the matched shape to
 547: #  make the arm self-diagnosing (measured to work, and recorded as the rejected
 548: #  alternative -- it edits a shipped correction's guard for instrumentation's
 549: #  sake), the coupling is made EXPLICIT: selectivity is ONE row over BOTH arms,
 550: #  which cannot pass unless the matcher both installs for distinct registers and
 551: #  declines for equal ones. The pair was always the meaningful unit; this stops a
 552: #  reader mistaking half of it for a test.
 553: for nm, prog, want_fire, want_inst, wit in (
 554:         ("A fold xchg fires", XCHG_POS, 1, 1, ("r1", 0xB2B2B202)),
 555:         ("A fold xchg samereg", XCHG_NEG, 0, 0, ("r1", 0x00000000))):
 556:     r = session(prog, True, seed_regs={"r1": 0xA1A1A101, "r2": 0xB2B2B202})
 557:     if r is None:
 558:         rows.append((nm, "DISC", "DEAD", False)); continue
 559:     buf, regs, _ = r
 560:     f, i = count(buf, "xchg"), installed(buf, "xchg")
 561:     verb, wr = "3: DEBUG" in buf, regs.get(wit[0]) == wit[1]
 562:     rows.append((nm, "DISC" if want_fire else "PIN",
 563:                  "fire=%d inst=%d verb=%s wit=%s" % (f, i, verb, wr),
 564:                  f == want_fire and i == want_inst and verb and wr))
 565:     if want_fire:
 566:         _xchg_pos = (f, i)
 567:     else:
 568:         #  The row that cannot pass on a build where xchg does not exist.
 569:         rows.append(("A fold xchg selective", "DISC",
 570:                      "pos(inst=%d fire=%d) neg(inst=%d fire=%d)"
 571:                      % (_xchg_pos[1], _xchg_pos[0], i, f),
 572:                      _xchg_pos == (1, 1) and (f, i) == (0, 0)))
 573: 
 574: #  scanc: r3 is a genuine three-way value witness -- 0x77 is table[4] on the
 575: #  positive arm, 0x66 is table[0] because an unmapped string load yields 0, and
 576: #  0x00 when the table page itself is missing. Plus the r5 sentinel, measured
 577: #  not to perturb the fold.
 578: for nm, prog, wf, wd, wr3 in (
 579:         ("A fold scanc fires", scanc_prog(SC_R1_OK, SC_R2_OK), 1, 0, 0x77),
 580:         ("A fold scanc nostr", scanc_prog(SC_UNMAPPED, SC_R2_OK), 0, 1, 0x66),
 581:         ("A fold scanc notbl", scanc_prog(SC_R1_OK, SC_R2_BAD), 0, 1, 0x00)):
 582:     r = session(prog, True, seed_regs={"r3": 0xDEAD, "r5": 0},
 583:                 bseed=[(0x10000, 0x04), (0x20004, 0x77), (0x20000, 0x66)])
 584:     if r is None:
 585:         rows.append((nm, "DISC" if wf else "PIN", "DEAD", False)); continue
 586:     buf, regs, _ = r
 587:     f, d, i = (count(buf, "netbsd_scanc"), declined(buf, "netbsd_scanc"),
 588:                installed(buf, "netbsd_scanc"))
 589:     verb = "3: DEBUG" in buf
 590:     #  `is not None` matters: the notbl arm legitimately expects r3 == 0, so a
 591:     #  missing readback must not be silently accepted as a correct zero.
 592:     got3 = regs.get("r3")
 593:     ok = (f == wf and d == wd and i == 1 and verb
 594:           and got3 is not None and got3 == wr3 and regs.get("r5") == 0x5A)
 595:     rows.append((nm, "DISC" if wf else "PIN",
 596:                  "fire=%d dec=%d inst=%d r3=%s sent=%s"
 597:                  % (f, d, i, "none" if got3 is None else "0x%x" % got3,
 598:                     regs.get("r5") == 0x5A), ok))
 599: 
 600: #  ---- #383: the copyin/copyout folds vs GUEST byte order (barearm) ----------
 601: #  Both fold bodies moved raw HOST words between the guest registers and the
 602: #  host page with no byte-order term, while the load/store_w1_word template
 603: #  they delegate to on a decline is order-aware since #372 -- the #342/#355
 604: #  self-contradiction class, and (unlike memset/memcpy) NOT closed by #378's
 605: #  install gate because these matchers key on the GENERIC handler, which
 606: #  installs for a BE guest too. These rows put the folds' BE behaviour on the
 607: #  test surface: on the pre-fix build they read reversed values (the defect);
 608: #  after the swap they agree with the order-aware general path.
 609: #
 610: #  The two-pass XOR is the copyin machinery reused verbatim: pass 1 declines
 611: #  (is_userpage clear on the first ldrt) and runs the order-aware general
 612: #  handler, pass 2 folds. r1 == 0 iff the two AGREE, and the final `vals` are
 613: #  the fold's own output. THE UNALIGNED ROWS ARE LOAD-BEARING: the aligned row
 614: #  cannot tell swap-before-rotation from swap-after (ROR by 0 and 16 commute
 615: #  with a 4-byte reversal), so a fix that swapped AFTER #362's rotation would
 616: #  pass every aligned row and ship green. +1 and +3 are the offsets where the
 617: #  two orders diverge (a sweep that only hit palindromic seeds would miss this
 618: #  -- the tail a sweep cannot reach). LOADSRC is seeded with `put b` in
 619: #  big-endian byte order so every expectation below traces to DDI 0100I Table
 620: #  A2-2 (p. A2-32) and LDR's Alignment note (p. A4-44), not to `put w`'s swap.
 621: def copyin_xor(off):
 622:     """copyin_unal generalised to offset 0 (a NOP in the add slot keeps the
 623:     14-word layout and the proven 0x5AFFFFF4 bpl target)."""
 624:     return [
 625:         0xE3A03001, MOV_R1_0, 0xE3A00801,
 626:         NOP if off == 0 else ADD_R0_N[off - 1],
 627:         0xE4B0A004, 0xE4B0B004, 0xE4B06004, 0xE4B07004, 0xE4B08004, 0xE4B09004,
 628:         EOR_R1_SL, 0xE2533001, 0x5AFFFFF4, 0xEAFFFFFE,
 629:     ]
 630: 
 631: 
 632: def ror32(v, r):
 633:     r &= 31
 634:     return v if r == 0 else ((v >> r) | (v << (32 - r))) & 0xFFFFFFFF
 635: 
 636: 
 637: control_be = "FAIL"
 638: for off in (0, 1, 3):
 639:     want = tuple(ror32(0x11223344 + k, 8 * off) for k in range(6))
 640:     nm = "A fold copyin BE +%d" % off
 641:     r = session(copyin_xor(off), True, seed_regs=SEED2,
 642:                 machine="barearm", loadsrc_be=True)
 643:     if r is None:
 644:         rows.append((nm, "DISC", "DEAD", False)); continue
 645:     buf, regs, _ = r
 646:     f, d, i = (count(buf, "netbsd_copyin"), declined(buf, "netbsd_copyin"),
 647:                installed(buf, "netbsd_copyin"))
 648:     verb = "3: DEBUG" in buf
 649:     adv = regs.get("r0") == 0x10000 + off + 24
 650:     vals = tuple(regs.get(k) for k in ("sl", "fp", "r6", "r7", "r8", "r9"))
 651:     agree = regs.get("r1") == 0
 652:     puts = not regs.get("__put_failed")
 653:     #  FOLDMARK_CONTROL_BE: pass 1's general value is r1 ^ sl, which is the
 654:     #  architectural word 0x11223344 on BOTH builds (broken and fixed) -- a
 655:     #  fix-state-independent liveness pin, mirroring ENDIAN_CONTROL378. It pins
 656:     #  that the barearm rig CONSTRUCTED, both passes RAN, and (#384) that the
 657:     #  rig is genuinely big-endian: on an LE rig the general handler would
 658:     #  assemble the put-b bytes 11 22 33 44 as 0x44332211, so r1^sl != the
 659:     #  0x11223344 checked below and the control FAILs. It does NOT by itself
 660:     #  prove the fold FIRED -- a gated-off fold runs the general handler on
 661:     #  pass 2 too, giving r1 == 0 and the same control value; FOLDING is proven
 662:     #  by the value rows' fire==1 (#384 dropped the earlier "the fold fired"
 663:     #  over-claim). A dead/mis-threaded session cannot false-green the group.
 664:     if off == 0 and regs.get("r1") is not None and regs.get("sl") is not None:
 665:         if (regs["r1"] ^ regs["sl"]) == 0x11223344:
 666:             control_be = "OK"
 667:     ok = (f == 1 and d == 1 and i == 1 and verb and adv
 668:           and vals == want and agree and puts)
 669:     rows.append((nm, "DISC",
 670:                  "fire=%d dec=%d inst=%d adv=%s vals=%s xor=%s puts=%s"
 671:                  % (f, d, i, adv, vals == want,
 672:                     "unread" if regs.get("r1") is None else "0x%x" % regs["r1"],
 673:                     puts), ok))
 674: 
 675: #  copyout BE: single warm pass, then compare the RAW 24 stored bytes against
 676: #  the architectural big-endian layout (store order r8,r9,sl,fp,r6,r7, pinned
 677: #  by the matcher). Raw bytes, never a little-assembled value -- see dump_raw.
 678: BE_STORE_SEED = {"r5": 0x5A5A0000, "r6": 0x66660001, "r7": 0x77770002,
 679:                  "r8": 0x88880003, "r9": 0x99990004, "sl": 0xAAAA0005,
 680:                  "fp": 0xBBBB0006}
 681: BE_WANT_BYTES = bytes([0x88, 0x88, 0x00, 0x03, 0x99, 0x99, 0x00, 0x04,
 682:                        0xAA, 0xAA, 0x00, 0x05, 0xBB, 0xBB, 0x00, 0x06,
 683:                        0x66, 0x66, 0x00, 0x01, 0x77, 0x77, 0x00, 0x02])
 684: r = session(ab_prog("copyout", True), True, seed_regs=BE_STORE_SEED,
 685:             machine="barearm", dump_raw=True)
 686: if r is None:
 687:     rows.append(("A fold copyout BE", "DISC", "DEAD", False))
 688: else:
 689:     buf, regs, _ = r
 690:     f, d, i = (count(buf, "netbsd_copyout"), declined(buf, "netbsd_copyout"),
 691:                installed(buf, "netbsd_copyout"))
 692:     verb = "3: DEBUG" in buf
 693:     gotb = regs.get("__dstbytes")
 694:     bytes_ok = (gotb == BE_WANT_BYTES)
 695:     adv = regs.get("r1") == 0x11000 + 24
 696:     #  #384: the source registers must SURVIVE the fold -- copyout captures the
 697:     #  six words before swapping precisely so it does NOT corrupt the guest's
 698:     #  live r6..r11, and nothing else asserted that. Without this a future
 699:     #  in-place "simplification" would keep the stored bytes correct while
 700:     #  clobbering the registers, and no row would catch it. (Validated by a
 701:     #  throwaway in-place-copyout mutant, which turns this False.) sl/fp are
 702:     #  r10/r11 in the seed.
 703:     regs_kept = all(regs.get(k) == BE_STORE_SEED[k]
 704:                     for k in ("r6", "r7", "r8", "r9", "sl", "fp"))
 705:     #  #384: f == 1, not >= 1 -- the single-pass straight-line block dispatches
 706:     #  the fold entry slot exactly once; d == 0 / i == 1 are the derived
 707:     #  numbers the probe's own doctrine requires (the loose "fires" shape was
 708:     #  legacy).
 709:     rows.append(("A fold copyout BE", "DISC",
 710:                  "fire=%d dec=%d inst=%d verb=%s adv=%s bytes=%s kept=%s"
 711:                  % (f, d, i, verb, adv, bytes_ok, regs_kept),
 712:                  f == 1 and d == 0 and i == 1 and verb and adv
 713:                  and bytes_ok and regs_kept))
 714: 
 715: ngot = 0
 716: for name, kind, detail, ok in rows:
 717:     ngot += ok
 718:     print("%-28s  %-4s %-40s %s" % (name, kind, detail, "ok" if ok else "FAIL"))
 719: print("FOLDMARK_CONTROL_BE=%s" % control_be)
 720: print("FOLDMARK_RESULT=%d/%d" % (ngot, len(rows)))
