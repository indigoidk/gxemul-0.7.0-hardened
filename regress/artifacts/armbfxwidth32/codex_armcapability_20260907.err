   70:  *	Numeric values:
   71:  *		12345
   72:  *		0x7fff1234
   73:  *
   74:  *	Symbols:
   75:  *		memcpy
   76:  *
   77:  *  To force detection of different types, a character can be added in front of
   78:  *  the name: "$" for numeric values, "#" for registers or other settings,
   79:  *  and "@" for symbols.
   80:  *
   81:  *  Return value is:
   82:  *
   83:  *	PARSE_NOMATCH		no match
   84:  *	PARSE_MULTIPLE		multiple matches
   85:  *
   86:  *  or one of these (and then *valuep is read or written, depending on
   87:  *  the writeflag):
   88:  *
   89:  *	PARSE_SETTINGS		a setting (e.g. a register)
   90:  *	PARSE_NUMBER		a hex number
   91:  *	PARSE_SYMBOL		a symbol
   92:  */
   93: int debugger_parse_name(struct machine *m, char *name, int writeflag,
   94: 	uint64_t *valuep)
   95: {
   96: 	int match_settings = 0, match_symbol = 0, match_numeric = 0;
   97: 	int skip_settings, skip_numeric, skip_symbol;
   98: 
   99: 	if (m == NULL || name == NULL) {
  100: 		fprintf(stderr, "debugger_parse_name(): NULL ptr\n");
  101: 		exit(1);
  102: 	}
  103: 
  104: 	while (name[0] == '\t' || name[0] == ' ')
  105: 		name ++;
  106: 
  107: 	/*  Warn about non-signextended values:  */
  108: 	if (writeflag) {
  109: 		if (m->cpus[0]->is_32bit) {
  110: 			/*
  111: 			 *  Automagically sign-extend for MIPS.
  112: 			 *  TODO: Is this good?
  113: 			 */
  114: 			if (m->cpus[0]->cpu_family->arch == ARCH_MIPS &&
  115: 			    ((*valuep) >> 32) == 0 && (*valuep) & 0x80000000ULL)
  116: 				(*valuep) |= 0xffffffff00000000ULL;
  117: 		} else {
  118: 			if (((*valuep) >> 32) == 0 && (*valuep) & 0x80000000ULL)
  119: 				printf("WARNING: The value is not sign-extende"
  120: 				    "d. Is this what you intended?\n");
  121: 		}
  122: 	}
  123: 
  124: 	skip_settings = name[0] == '$' || name[0] == '@';
  125: 	skip_numeric  = name[0] == '#' || name[0] == '@';
  126: 	skip_symbol   = name[0] == '$' || name[0] == '#';
  127: 
  128: 	if (!skip_settings) {
  129: 		char setting_name[400];
  130: 		int res;
  131: 
  132: 		res = settings_access(global_settings, name, writeflag, valuep);
  133: 		if (res == SETTINGS_OK)
  134: 			match_settings = 1;
  135: 
  136: 		if (!match_settings) {
  137: 			snprintf(setting_name, sizeof(setting_name),
  138: 			    GLOBAL_SETTINGS_NAME".%s", name);
  139: 			res = settings_access(global_settings, setting_name,
  140: 			    writeflag, valuep);
  141: 			if (res == SETTINGS_OK)
  142: 				match_settings = 1;
  143: 		}
  144: 
  145: 		if (!match_settings) {
  146: 			snprintf(setting_name, sizeof(setting_name),
  147: 			    GLOBAL_SETTINGS_NAME".emul.%s", name);
  148: 			res = settings_access(global_settings, setting_name,
  149: 			    writeflag, valuep);
  150: 			if (res == SETTINGS_OK)
  151: 				match_settings = 1;
  152: 		}
  153: 
  154: 		if (!match_settings) {
  155: 			snprintf(setting_name, sizeof(setting_name),
  156: 			    GLOBAL_SETTINGS_NAME".emul.machine[%i].%s",
  157: 			    debugger_cur_machine, name);
  158: 			res = settings_access(global_settings, setting_name,
  159: 			    writeflag, valuep);
  160: 			if (res == SETTINGS_OK)
  161: 				match_settings = 1;
  162: 		}
  163: 
  164: 		if (!match_settings) {
  165: 			snprintf(setting_name, sizeof(setting_name),
  166: 			    GLOBAL_SETTINGS_NAME".emul.machine[%i]."
  167: 			    "cpu[%i].%s", debugger_cur_machine,
  168: 			    debugger_cur_cpu, name);
  169: 			res = settings_access(global_settings, setting_name,
  170: 			    writeflag, valuep);
  171: 			if (res == SETTINGS_OK)
  172: 				match_settings = 1;
  173: 		}
  174: 	}
  175: 
  176: 	/*  Check for a number match:  */
  177: 	if (!skip_numeric && isdigit((int)name[0])) {
  178: 		uint64_t x;
  179: 		x = strtoull(name, NULL, 0);
  180: 		if (writeflag)
  181: 			printf("You cannot assign like that.\n");
  182: 		else
  183: 			*valuep = x;
  184: 		match_numeric = 1;
  185: 	}
  186: 
  187: 	/*  Check for a symbol match:  */
  188: 	if (!skip_symbol) {
  189: 		uint64_t newaddr;
  190: 		if (get_symbol_addr(&m->symbol_context, name, &newaddr)) {
  191: 			if (writeflag)
  192: 				printf("You cannot assign like that.\n");
  193: 			else
  194: 				*valuep = newaddr;
  195: 			match_symbol = 1;
  196: 		}
  197: 	}
  198: 
  199: 	if (match_settings + match_symbol + match_numeric > 1)
  200: 		return PARSE_MULTIPLE;
  201: 
  202: 	if (match_settings)
  203: 		return PARSE_SETTINGS;
  204: 	if (match_numeric)
  205: 		return PARSE_NUMBER;
  206: 	if (match_symbol)
  207: 		return PARSE_SYMBOL;
  208: 
  209: 	return PARSE_NOMATCH;
  210: }
