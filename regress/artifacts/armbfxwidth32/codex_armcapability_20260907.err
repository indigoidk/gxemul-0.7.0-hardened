 491:     #  `buggy` = the pre-#386 build: raw LE load of P+2..P+5 = 33 44 99 AA ->
 492:     #  0xAA994433; raw LE store at P+2..P+5 -> ladder 11 22 88 77, sent 66.
 493:     ("387 be swp un2", "barearm", swp_un2_prog(), swp_un2_seeds(), [
 494:         ("swp be un2 r2", "r2", 0x33441122, 0xAA994433, "DISC"),
 495:         ("swp be un2 b0", "r3", 0x55, 0x11, "DISC"),
 496:         ("swp be un2 b1", "r4", 0x66, 0x22, "DISC"),
 497:         ("swp be un2 b2", "r5", 0x77, 0x88, "DISC"),
 498:         ("swp be un2 b3", "r6", 0x88, 0x77, "DISC"),
 499:         ("swp be un2 sent", "r7", 0x99, 0x66, "DISC"),
 500:     ]),
 501:     ("387 le swp un2", "testarm", swp_un2_prog(), swp_un2_seeds(), [
 502:         ("swp le un2 r2", "r2", 0x22114433, 0xAA994433, "DISC"),
 503:         ("swp le un2 b0", "r3", 0x88, 0x11, "DISC"),
 504:         ("swp le un2 b1", "r4", 0x77, 0x22, "DISC"),
 505:         ("swp le un2 b2", "r5", 0x66, 0x88, "DISC"),
 506:         ("swp le un2 b3", "r6", 0x55, 0x77, "DISC"),
 507:         ("swp le un2 sent", "r7", 0x99, 0x66, "DISC"),
 508:     ]),
 509:     #  ---- #389 rows: LDRD/STRD were three defects deep on BE -- a word-pair
 510:     #  inversion on BOTH sides (Rd took the upper word; the architecture pairs
 511:     #  Rd with the LOWER address, A4.1.26/A4.1.102), a carry-corrupting
 512:     #  data[1]<<6 term (buggy Rd = 0x55660908, NOT a byte permutation), and a
 513:     #  verbatim-LE R(d+1) branch. Both always take the general path (the
 514:     #  chicken-out is unconditional for A__LDRD||A__STRD), so no warm/cold
 515:     #  split. The LE rows are true invariance controls (LE was correct).
 516:     #  Oracle: the ldrd arch values equal the committed LDM rows' on the same
 517:     #  bytes. buggy = the pre-#389 build, measured in the RED reproduction.
 518:     ("389 be ldrd", "barearm", ldrd_prog(), seed_bytes(COLD), [
 519:         ("ldrd be r4", "r4", 0x11223344, 0x55660908, "DISC"),
 520:         ("ldrd be r5", "r5", 0x55667788, 0x44332211, "DISC"),
 521:     ]),
 522:     ("389 le ldrd", "testarm", ldrd_prog(), seed_bytes(COLD), [
 523:         ("ldrd le r4", "r4", 0x44332211, 0x44332211, "CTRL"),
 524:         ("ldrd le r5", "r5", 0x88776655, 0x88776655, "CTRL"),
 525:     ]),
 526:     ("389 be strd", "barearm", strd_prog(), [], [
 527:         ("strd be b0", "r4", 0x11, 0x55, "DISC"),
 528:         ("strd be b1", "r5", 0x22, 0x66, "DISC"),
 529:         ("strd be b2", "r6", 0x33, 0x77, "DISC"),
 530:         ("strd be b3", "r7", 0x44, 0x88, "DISC"),
 531:         ("strd be b4", "r8", 0x55, 0x11, "DISC"),
 532:         ("strd be b5", "r9", 0x66, 0x22, "DISC"),
 533:         ("strd be b6", "sl", 0x77, 0x33, "DISC"),
 534:         ("strd be b7", "fp", 0x88, 0x44, "DISC"),
 535:     ]),
 536:     ("389 le strd", "testarm", strd_prog(), [], [
 537:         ("strd le b0", "r4", 0x44, 0x44, "CTRL"),
 538:         ("strd le b1", "r5", 0x33, 0x33, "CTRL"),
 539:         ("strd le b2", "r6", 0x22, 0x22, "CTRL"),
 540:         ("strd le b3", "r7", 0x11, 0x11, "CTRL"),
 541:         ("strd le b4", "r8", 0x88, 0x88, "CTRL"),
 542:         ("strd le b5", "r9", 0x77, 0x77, "CTRL"),
 543:         ("strd le b6", "sl", 0x66, 0x66, "CTRL"),
 544:         ("strd le b7", "fp", 0x55, 0x55, "CTRL"),
 545:     ]),
 546: 
 547:     #  ---- #390 rows: the PC-as-base role conflation.  Addresses, not bytes,
 548:     #  so every value below is byte-order INDEPENDENT and both rigs must agree
 549:     #  -- which is itself the check that no byte-order-specific regression hides
 550:     #  here.  All four groups run on barearm and testarm alike.
 551:     #
 552:     #  buggy = MEASURED on the pre-#390 build (parent 495a07a), not predicted.
 553:     #  A THIRD implementation, a blanket +8 that also moves the data role, is
 554:     #  what "390 bothpc" exists to catch: it would put the right ADDRESS there
 555:     #  carrying 0x8008 instead of 0x800c, which no other row can see.
 556:     #
 557:     #  STR is at CODE+0x10 in the base group (four BUILD_R4 words precede it),
 558:     #  so its +8 target is 0x8058 and its +12 target 0x805c.  In the bothpc and
 559:     #  ldrd groups the instruction is first, at CODE, so the targets are 0x8048
 560:     #  and 0x804c.
 561:     ("390 be base", "barearm", str_base_prog(), [], [
 562:         ("390 be base +8",  "r5", 0x11223344, 0x00000000, "DISC"),
 563:         ("390 be base +12", "r6", 0x00000000, 0x11223344, "DISC"),
 564:     ]),
 565:     ("390 le base", "testarm", str_base_prog(), [], [
 566:         ("390 le base +8",  "r5", 0x11223344, 0x00000000, "DISC"),
 567:         ("390 le base +12", "r6", 0x00000000, 0x11223344, "DISC"),
 568:     ]),
 569: 
 570:     #  DATA-role guard.  arch == buggy ON PURPOSE: this row must pass on BOTH
 571:     #  builds.  It is not a discriminator for the defect -- it is the detector
 572:     #  for a WRONG FIX that moves the stored R15 value off +12.  A2-9 forbids
 573:     #  an implementation using +8 for some R15 stores and +12 for others.
 574:     ("390 be data", "barearm", str_data_prog(), [], [
 575:         ("390 be data +12", "r5", 0x8010, 0x8010, "CTRL"),
 576:     ]),
 577:     ("390 le data", "testarm", str_data_prog(), [], [
 578:         ("390 le data +12", "r5", 0x8010, 0x8010, "CTRL"),
 579:     ]),
 580: 
 581:     #  BOTH-PC: base +8 and data +12 at the same time.  buggy = 0 because
 582:     #  pre-#390 nothing was written to the +8 target at all.
 583:     ("390 be bothpc", "barearm", str_bothpc_prog(), [], [
 584:         ("390 be bothpc", "r5", 0x800c, 0x00000000, "DISC"),
 585:     ]),
 586:     ("390 le bothpc", "testarm", str_bothpc_prog(), [], [
 587:         ("390 le bothpc", "r5", 0x800c, 0x00000000, "DISC"),
 588:     ]),
 589: 
 590:     #  LDRD base -- CTRL because these rows are BLIND, not because LDRD is fine.
 591:     #
 592:     #  [This comment was itself corrected once.  It briefly claimed LDRD's base
 593:     #  was never wrong.  It was wrong, and #390 fixed it.]
 594:     #
 595:     #  LDRD does take A__NAME_PC's store arm (it encodes L == 0, so the
 596:     #  generator never defines A__L for it) and its base WAS four bytes high
 597:     #  before #390.  These rows cannot see that, and the reason is a theorem
 598:     #  rather than an accident: the general path masks the address with
 599:     #  ~(datalen - 1), and datalen is 8 here.  The base error is exactly +4, so
 600:     #  the wrong and right addresses share an eight-byte block whenever the
 601:     #  RIGHT one is doubleword-aligned -- and a non-doubleword-aligned LDRD is
 602:     #  UNPREDICTABLE before ARMv6 (A2.8).  So on every architecturally DEFINED
 603:     #  layout the mask heals the error, and no legal row can expose it.  Rows at
 604:     #  offset 0x44, or with the instruction one word later, DO show it -- but
 605:     #  those are exactly the UNPREDICTABLE layouts #355 forbids asserting on.
 606:     #
 607:     #  Hence CTRL with arch == buggy: an honest record that these values do not
 608:     #  move, NOT a claim that the instruction is unaffected.  Do NOT re-type
 609:     #  them DISC expecting them to catch a base regression; they cannot, and a
 610:     #  mutant reverting the base leaves them green.  Three distinct planted
 611:     #  words, so the row still says WHICH pair was read rather than merely
 612:     #  "not a sentinel".
 613:     ("390 be ldrd", "barearm", ldrd_pc_prog(),
 614:      ["put w 0x8048, 0xaaaa0001", "put w 0x804c, 0xbbbb0002",
 615:       "put w 0x8050, 0xcccc0003"], [
 616:         ("390 be ldrd r0", "r0", 0xaaaa0001, 0xaaaa0001, "CTRL"),
 617:         ("390 be ldrd r1", "r1", 0xbbbb0002, 0xbbbb0002, "CTRL"),
 618:     ]),
 619:     ("390 le ldrd", "testarm", ldrd_pc_prog(),
 620:      ["put w 0x8048, 0xaaaa0001", "put w 0x804c, 0xbbbb0002",
 621:       "put w 0x8050, 0xcccc0003"], [
 622:         ("390 le ldrd r0", "r0", 0xaaaa0001, 0xaaaa0001, "CTRL"),
 623:         ("390 le ldrd r1", "r1", 0xbbbb0002, 0xbbbb0002, "CTRL"),
 624:     ]),
 625: ]
 626: 
 627: print("=== #372 store + #378 LDM/STM: byte order must reach guest memory ===")
 628: print("    #372 DISC rows are COLD (general path was wrong);")
 629: print("    #378 DISC rows are WARM (fast path was wrong) -- inverted polarity")
 630: 
 631: #  Controls: `be warm word` proves the #372 machinery live (fast STR was always
 632: #  order-aware). `be stm cold b0` + `be ldm cold r1` prove the #378 machinery
 633: #  live INDEPENDENT of the fix state -- bdt_* swaps on every build, so these
 634: #  read arch values on buggy and fixed builds alike; a dead rig, wrong register
 635: #  field or non-firing LDM reads 0 / a sentinel instead.
 636: control = "FAIL"
 637: control378 = {}
 638: controlD = {}
 639: puts_ok = True
 640: ngot = ntot = 0
 641: for glabel, machine, prog, seeds, rows in GROUPS:
 642:     regs = [r[1] for r in rows]
 643:     got = run(machine, prog, seeds, regs)
 644:     #  #391 pass-2: this was `got is not None and not got.get(...)`, i.e.
 645:     #  FAIL-OPEN -- a run() that returned None never falsified puts_ok, so a
 646:     #  session that never started still printed PUT_STATUS=OK and gate 14's
 647:     #  "endian puts all landed" asserted OK.  MEASURED against a nonexistent
 648:     #  binary: every other control read FAIL and this one read OK, with zero
 649:     #  puts issued.  Every sibling control here defaults to FAIL; only this one
 650:     #  defaulted to OK.  Same defect as the round's headline, three lines below
 651:     #  the round's own fix -- which is why the round's residual list now leads
 652:     #  with "I fixed one instance of a pattern".
 653:     if got is None or not got.get("__put_ok", False):
 654:         puts_ok = False
 655:     for name, reg, arch, buggy, kind in rows:
 656:         ntot += 1
 657:         if got is None or reg not in got:
 658:             print("%-20s DEAD  FAIL" % name)
 659:             continue
 660:         v = got[reg]
 661:         ok = (v == arch)
 662:         ngot += ok
 663:         if name == "be warm word" and v == 0x11223344:
 664:             control = "OK"
 665:         if name in ("be stm cold b0", "be ldm cold r1"):
 666:             control378[name] = ok
 667:         #  #389 liveness pins: fix-state-independent LE rows whose DEAD value
 668:         #  is the sentinel 0 (MOV_R4_0 / the unseeded STRD page) -- nonzero
 669:         #  proves the instructions executed on the rig at all.
 670:         if name in ("ldrd le r4", "strd le b0"):
 671:             controlD[name] = (v != 0)
 672:         print("%-20s %-4s %s=0x%08x want 0x%08x (buggy 0x%08x)  %s"
 673:               % (name, kind, reg, v, arch, buggy, "ok" if ok else "FAIL"))
 674: 
 675: print("ENDIAN_CONTROL=%s" % control)
 676: print("ENDIAN_CONTROL378=%s"
 677:       % ("OK" if control378.get("be stm cold b0")
 678:          and control378.get("be ldm cold r1") else "FAIL"))
 679: print("ENDIAN_CONTROL_D=%s"
 680:       % ("OK" if controlD.get("ldrd le r4")
 681:          and controlD.get("strd le b0") else "FAIL"))
 682: print("PUT_STATUS=%s" % ("OK" if puts_ok else "FAIL"))
 683: print("ENDIAN_RESULT=%d/%d" % (ngot, ntot))
GXEMUL-SEC\regress\arm_flags_probe.py
   1: #!/usr/bin/env python3
   2: """Gate 14's measuring instrument: ARM subtract-carry flags and undefined routing.
   3: 
   4: Prints one line per row:  <name> <got> <want> ok|FAIL
   5: then ARM_FLAGS_CONTROL=OK|DEAD and ARM_FLAGS_RESULT=<passed>/<total>.
   6: gate_arm.sh does the asserting.
   7: 
   8: How it measures
   9: ---------------
  10: Cold debugger on `testarm` (SA1110), RAM at 0. The machine needs A file to
  11: construct -- it prints usage and exits without one -- so a four-byte raw stub is
  12: loaded at the code address purely to satisfy that; it is overwritten by every
  13: row before anything executes. LITTLE-endian, so `dump` renders bytes in memory
  14: order and every word read here is byte-swapped back (the PowerPC rig is the
  15: opposite case, and mixing the two up silently transposes every answer).
  16: 
  17: The flags are read by the guest's OWN `mrs r3,cpsr`, never by a debugger
  18: register print: `mrs` is the architectural read, and it is the same path a real
  19: kernel uses. The result register is stored alongside, because these two defects
  20: are FLAG defects -- the computed value was already right -- and a row that
  21: checked only the flag could not tell a fixed flag from a broken result.
  22: 
  23: The carry contract (ARM ARM, DDI 0100, subtract family)
  24: -------------------------------------------------------
  25: For SUB/CMP/RSB the carry-out is NOT-BORROW: set iff the 32-bit subtraction did
  26: not borrow. For SBC/RSC the operation is `a - b - NOT(C)` and the carry-out must
  27: account for that borrow-in term.
  28: 
  29: #311 computed the flag as `a >= b` for all five. That is correct for the three
  30: that have no borrow-in, and WRONG for SBC/RSC exactly when `a == b` and the
  31: carry-in is clear: `a - a - 1` borrows, so carry must be CLEAR, and `a >= b`
  32: reports it SET. The fix computes the flag from the full 64-bit result that the
  33: file already has in hand (`c32 == c64`), which is the same answer as `a >= b`
  34: whenever there is no borrow-in -- hence the many PIN rows here, which exist to
  35: prove the fix did NOT disturb the three instructions that were already right.
  36: 
  37: The carry-in for each row is established by a plain SUBS, never by a debugger
  38: write to cpsr: a debugger write sets cpsr but not the separate `flags` field the
  39: dyntrans handlers actually read, so it would preset nothing. SUBS is the correct
  40: choice because it is the one member of the family whose carry both the committed
  41: build and the fix compute identically -- the preset cannot itself be the bug.
  42: 
  43: The undefined contract
  44: ----------------------
  45: #312: ARM's permanently-undefined space must raise the Undefined Instruction
  46: exception. The committed build reached `goto bad`, which sets cpu->running = 0
  47: (cpu_dyntrans.c:2014) -- a legal-to-attempt encoding stopping the whole
  48: emulator, the same halt class as #264/#309/#310. GDB's breakpoint instruction
  49: lives in this space, which is why the tree already contained an `und` routing
  50: for it at cpu_arm_instr.c -- unreachable, because the block above it matches the
  51: identical encodings first and breaks.
  52: 
  53: The witness is the HANDLER, not the absence of a message: code planted at the
  54: UND vector (0x04) stores a marker, the mode, and the return address. A row that
  55: merely checked "the emulator did not halt" would pass if the instruction were
  56: silently treated as a nop.
  57: 
  58: Row classes
  59: -----------
  60:   PIN  -- correct today and must stay. Most of this table is pins, on purpose:
  61:           the fix rewrites a line shared by five instructions and two of them
  62:           are the ones that were already right.
  63:   DISC -- discriminator: the committed byte is the measured defect, and the
  64:           want flips when the fix lands.
  65: """
  66: import os
  67: import pty
  68: import re
  69: import select
  70: import sys
  71: import time
  72: 
  73: BIN = sys.argv[1]
  74: STUB = sys.argv[2]
  75: 
  76: CODE = 0x8000
  77: DEST = 0x9000
  78: VECT = 0x0004                   # ARM_EXCEPTION_UND * 4, low vectors
  79: #  Last instruction slot of a 4KB ic page. Deliberately NOT the page holding
  80: #  CODE: there, pc+4 would land exactly on DEST and the expected lr would be
  81: #  numerically equal to the witness address, which reads as a coincidence
  82: #  rather than a measurement.
  83: PAGE_END = 0xAFFC
  84: 
  85: #  Instruction words. Rd=r0, Rn=r1, Rm=r2 throughout; r3 carries cpsr.
  86: SUBS_R6_R6_R7 = 0xE0566007      # subs r6,r6,r7   -- the carry preset
  87: MRS_R3_CPSR   = 0xE10F3000      # mrs  r3,cpsr
  88: STR_R3_R4     = 0xE5843000      # str  r3,[r4]
  89: STR_R0_R4     = 0xE5840000      # str  r0,[r4]
  90: STR_R0_R5     = 0xE5850000      # str  r0,[r5]
  91: STR_LR_R5     = 0xE585E000      # str  r14,[r5]
  92: STR_R0_R6     = 0xE5860000      # str  r0,[r6]
  93: MOV_R0_5A     = 0xE3A0005A      # mov  r0,#0x5a
  94: NOP           = 0xE1A00000      # mov  r0,r0
  95: 
  96: SBCS = 0xE0D10002               # sbcs r0,r1,r2
  97: RSCS = 0xE0F10002               # rscs r0,r1,r2   (rd = r2 - r1 - !C)
  98: SUBS = 0xE0510002               # subs r0,r1,r2
  99: RSBS = 0xE0710002               # rsbs r0,r1,r2   (rd = r2 - r1)
 100: CMPS = 0xE1510002               # cmp  r1,r2
 101: SUBS_PC_4 = 0xE25F0004          # subs r0,pc,#4   (the A__PC template variant)
 102: ADDS = 0xE0910002               # adds r0,r1,r2
 103: ADCS = 0xE0B10002               # adcs r0,r1,r2
 104: 
 105: UDF        = 0xE7F000F0         # permanently undefined (UDF #0)
 106: UDF_GDB    = 0xE6000010         # the GDB-breakpoint form, same space
 107: UDF_EQ     = 0x07F000F0         # the same encoding, condition EQ
 108: ARM_MODE_UND32 = 0x1b
 109: 
 110: 
 111: def session(cmds, nwords):
 112:     """Run one cold-debugger session; return (words, transcript)."""
 113:     #  -A disables colorized output. Under pty.fork() both isatty() checks
 114:     #  pass, so a CLICOLOR in the caller's environment would otherwise put
 115:     #  ANSI escapes between "cpu " and the debugmsg name and silently fail
 116:     #  every marker grep -- an environment-dependent FAIL that looks like a
 117:     #  real regression (a round-99 review seat's catch).
 118:     pid, fd = pty.fork()
 119:     if pid == 0:
 120:         os.execvp(BIN, [BIN, "-V", "-A", "-E", "testarm", "-M", "64",
 121:                         "0x%x:%s" % (CODE, STUB)])
 122:         os._exit(127)
 123:     buf = ""
 124: 
 125:     def rd(t=0.4):
 126:         nonlocal buf
 127:         r, _, _ = select.select([fd], [], [], t)
 128:         if fd not in r:
 129:             return True
 130:         try:
 131:             d = os.read(fd, 65536)
 132:         except OSError:
 133:             return False
 134:         if not d:
 135:             return False
 136:         buf += d.decode("latin1", "replace")
 137:         return True
 138: 
 139:     def wait(timeout=45):
 140:         t = time.time()
 141:         while time.time() - t < timeout:
 142:             if not rd():
 143:                 return False
 144:             if buf.rstrip().endswith("GXemul>"):
 145:                 return True
 146:         return False
 147: 
 148:     def send(s):
 149:         b = (s + "\n").encode("latin1")
 150:         n = 0
 151:         while n < len(b):
 152:             n += os.write(fd, b[n:])
 153:         wait()
 154: 
 155:     if not wait(60):
 156:         try:
 157:             os.kill(pid, 9)
 158:             os.waitpid(pid, 0)
 159:         except Exception:
 160:             pass
 161:         return None, buf
 162: 
 163:     for c in cmds:
 164:         send(c)
 165: 
 166:     #  Retry the READ, never the row: a dump can straggle past the prompt
 167:     #  detector under host load, and the value cannot change between dumps.
 168:     #  A row that lost this retry showed up as a spurious DEAD in the very
 169:     #  first baseline sweep.
 170:     flat = []
 171:     for _ in range(3):
 172:         mark = len(buf)
 173:         send("dump 0x%x 0x%x" % (DEST, DEST + 4 * nwords))
 174:         words = re.findall(r"0x0*[0-9a-f]+\s+((?:[0-9a-f]{8}\s+){1,4})",
 175:                            buf[mark:])
 176:         flat = "".join(words).split()
 177:         if len(flat) >= nwords:
 178:             break
 179:         time.sleep(1.0)
 180:         rd(1.0)
 181:     try:
 182:         os.write(fd, b"quit\n")
 183:         time.sleep(0.3)
 184:         os.kill(pid, 9)
 185:         os.waitpid(pid, 0)
 186:     except Exception:
 187:         pass
 188:     return (flat[:nwords] if len(flat) >= nwords else None), buf
 189: 
 190: 
 191: def sw(h):
 192:     """dump renders little-endian bytes; recover the stored value."""
 193:     return int.from_bytes(bytes.fromhex(h), "little")
 194: 
 195: 
 196: def run_flags(iw, rn, rm, cin):
 197:     """Preset the carry, run one flag-setting instruction, publish cpsr and rd.
 198: 
 199:     Returns (cpsr, rd) or (None, None) if the session died."""
 200:     r6, r7 = (1, 0) if cin else (0, 1)      # 1-0 => no borrow => C=1
 201:     w, _ = session([
 202:         "r1=0x%x" % rn, "r2=0x%x" % rm,
 203:         "r6=0x%x" % r6, "r7=0x%x" % r7,
 204:         "r4=0x%x" % DEST, "r5=0x%x" % (DEST + 4),
 205:         "put w 0x%x, 0xdeadbeef" % DEST,
 206:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
 207:         "put w 0x%x, 0x%08x" % (CODE,      SUBS_R6_R6_R7),
 208:         "put w 0x%x, 0x%08x" % (CODE + 4,  iw),
 209:         "put w 0x%x, 0x%08x" % (CODE + 8,  MRS_R3_CPSR),
 210:         "put w 0x%x, 0x%08x" % (CODE + 12, STR_R3_R4),
 211:         "put w 0x%x, 0x%08x" % (CODE + 16, STR_R0_R5),
 212:         "pc=0x%x" % CODE, "step 5"], 2)
 213:     if w is None:
 214:         return None, None
 215:     return sw(w[0]), sw(w[1])
 216: 
 217: 
 218: def teq_imm(rot, imm8):
 219:     return 0xE3310000 | (rot << 8) | imm8
 220: 
 221: 
 222: def tst_imm(rot, imm8):
 223:     return 0xE3110000 | (rot << 8) | imm8
 224: 
 225: 
 226: MOV_R8_1   = 0xE3A08001         # mov  r8,#1     -- the pass counter
 227: SUBS_R8_R9 = 0xE0588009         # subs r8,r8,r9  -- r9 = 1
 228: BEQ_FWD3   = 0x0A000003         # beq  +3 words (the not-taken branch under test)
 229: BEQ_BACK8  = 0x0AFFFFF8         # beq  -8 words (back to the top of the loop)
 230: 
 231: 
 232: def run_combined(iw, rn, cin):
 233:     """FREE-RUNNING, TWO PASSES: the only way to reach a *_samepage handler.
 234: 
 235:     Two facts have to hold at once, and each defeated an earlier attempt:
 236: 
 237:       1. `step` cannot work. cpu_dyntrans.c:1888 disables combining whenever
 238:          single_step is set, so a stepped probe exercises the STANDALONE
 239:          handler while appearing to exercise the combined one.
 240: 
 241:       2. A single forward run cannot work either WHEN A BREAKPOINT IS SET.
 242:          arm_combine_instructions rewrites ic[-1].f -- the PREVIOUS
 243:          instruction -- while the BRANCH is translated, and by then the
 244:          compare has already executed. The combined handler therefore exists
 245:          only from the SECOND pass over that ic slot onward.
 246: 
 247:          CORRECTION (round 100): this is true only with a breakpoint. The
 248:          guard above is NOT the whole story -- translation READ-AHEAD
 249:          (cpu_dyntrans.c translates up to 128 following instructions ahead
 250:          of execution and runs the combiner for each) is separately gated on
 251:          `cpu->machine->breakpoints.n == 0` (:1939). Every probe in THIS file
 252:          uses `breakpoint add`, which sets breakpoints.n and turns read-ahead
 253:          OFF -- forcing the two-pass install. A real guest sets no breakpoint,
 254:          so the fold installs AHEAD of execution and a single forward pass
 255:          reaches it. The netbsd_idle rows live in arm_idle_probe.py precisely
 256:          so they can exercise that path (its register-alias and forward-beq
 257:          defects are invisible under a breakpoint, because the two-pass
 258:          install pre-writes the register the fold would otherwise read stale).
 259:          The two-pass driver below stays correct for the flag rows here; it
 260:          is just not the only way a fold is reached, contrary to what this
 261:          comment used to assert as a law.
 262: 
 263:     So the compare and its branch sit inside a loop that runs exactly twice,
 264:     and the flags published are the second pass's. r8 counts: 1 -> 0 sets Z and
 265:     branches back, 0 -> -1 clears Z and falls through. The carry preset uses
 266:     r7 = 0, so `subs r6,r6,r7` re-establishes C=1 on BOTH passes without
 267:     changing r6 -- a decrementing preset would silently differ between them.
 268: 
 269:     The breakpoint goes after the loop, never on the pair: single_step_breakpoint
 270:     is in the same guard but is transient (set at :1802-1823 only when pc equals
 271:     a breakpoint address, cleared at :1930). Instruction tracing must stay off
 272:     for the same reason -- it is the third term of that guard."""
 273:     r6, r7 = (1, 0) if cin else (0, 1)
 274:     w, _ = session([
 275:         "r1=0x%x" % rn, "r0=0x0",
 276:         "r6=0x%x" % r6, "r7=0x%x" % r7, "r9=0x1",
 277:         "r4=0x%x" % DEST,
 278:         "put w 0x%x, 0xdeadbeef" % DEST,
 279:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
 280:         "put w 0x%x, 0x%08x" % (CODE,      MOV_R8_1),
 281:         # loop top
 282:         "put w 0x%x, 0x%08x" % (CODE + 4,  SUBS_R6_R6_R7),
 283:         "put w 0x%x, 0x%08x" % (CODE + 8,  iw),
 284:         "put w 0x%x, 0x%08x" % (CODE + 12, BEQ_FWD3),
 285:         "put w 0x%x, 0x%08x" % (CODE + 16, MRS_R3_CPSR),
 286:         "put w 0x%x, 0x%08x" % (CODE + 20, STR_R3_R4),
 287:         "put w 0x%x, 0x%08x" % (CODE + 24, SUBS_R8_R9),
 288:         "put w 0x%x, 0x%08x" % (CODE + 28, BEQ_BACK8),
 289:         # loop exit / breakpoint
 290:         "put w 0x%x, 0x%08x" % (CODE + 32, NOP),
 291:         "breakpoint add 0x%x" % (CODE + 32),
 292:         "pc=0x%x" % CODE, "continue"], 2)
 293:     if w is None or w[0] == "deadbeef":
 294:         return None
 295:     return sw(w[0])
 296: 
 297: 
 298: #  eor Rd,Rn,Rm == 0xE0200000 | (Rn << 16) | (Rd << 12) | Rm.
 299: #
 300: #  The MATCHER's shape is `eor X,Y,X` -- Rm == Rd -- because eor_regshort's
 301: #  arg[0] is Rn, arg[1] is Rm and arg[2] is Rd (cpu_arm_instr_dpi.c:72/110/252).
 302: #  The first version of this control emitted `eor r0,r0,r1`, which is Rn == Rd,
 303: #  so it never matched the combiner at all and was measuring three standalone
 304: #  EORs while claiming to exercise the fold. A review seat caught it. The
 305: #  same-register row is unaffected -- every operand collapses to one register,
 306: #  so it matches under either reading -- which is why the DISC measurement below
 307: #  stands and only the control had to be rebuilt.
 308: EOR_R0_R0_R0 = 0xE0200000       # eor r0,r0,r0  -- zeroes r0, three times over
 309: EOR_R0_R1_R0 = 0xE0210000       # eor r0,r1,r0  -- r0 ^= r1
 310: EOR_R1_R0_R1 = 0xE0201001       # eor r1,r0,r1  -- r1 ^= r0
 311: MOV_R1_A5    = 0xE3A010A5       # mov r1,#0xa5
 312: STR_R1_R5    = 0xE5851000       # str r1,[r5]
 313: BEQ_BACK10   = 0x0AFFFFF6       # beq -10 words, back to the loop top
 314: 
 315: 
 316: def run_xchg(same_reg):
 317:     """Two-pass free-running witness for the XOR-swap fold (see run_combined
 318:     for why both properties are needed).
 319: 
 320:     The combiner folds `eor a,a,b / eor b,b,a / eor a,a,b` into X(xchg), which
 321:     swaps the two registers -- but its match has NO a != b guard, so three
 322:     `eor rX,rX,rX` also match. Standalone, each of those ZEROES rX; the folded
 323:     swap exchanges rX with itself and leaves it alone.
 324: 
 325:     r0 is re-seeded to 0x5a at the TOP of the loop, which is what makes the two
 326:     passes distinguishable: without it pass 1 would zero r0 and pass 2's
 327:     "unchanged" would also read zero, and the row could not fail.
 328: 
 329:     A result of 0x5a is unambiguous -- three standalone EORs cannot leave a
 330:     nonzero value, so only the folded handler can produce it, and it is both
 331:     the defect and the proof that the fold occurred. A result of 0 is the
 332:     correct answer but does NOT by itself prove the fold happened, so it is
 333:     never read as evidence of a fix on its own."""
 334:     seq = ([EOR_R0_R0_R0] * 3 if same_reg
 335:            else [EOR_R0_R1_R0, EOR_R1_R0_R1, EOR_R0_R1_R0])
 336:     w, _ = session([
 337:         "r0=0x0", "r1=0x0", "r9=0x1",
 338:         "r4=0x%x" % DEST, "r5=0x%x" % (DEST + 4),
 339:         "put w 0x%x, 0xdeadbeef" % DEST,
 340:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
 341:         "put w 0x%x, 0x%08x" % (CODE,      MOV_R8_1),
 342:         #  BOTH registers are re-seeded at the loop top, and to DISTINCT
 343:         #  values. Seeding r1 once outside the loop was the second half of the
 344:         #  same review finding: pass 1 would leave r1 == r0, so on pass 2 a
 345:         #  correct swap and a no-op would both answer 0x5a and the control
 346:         #  could not fail.
 347:         "put w 0x%x, 0x%08x" % (CODE + 4,  MOV_R0_5A),   # loop top
 348:         "put w 0x%x, 0x%08x" % (CODE + 8,  MOV_R1_A5),
 349:         "put w 0x%x, 0x%08x" % (CODE + 12, seq[0]),
 350:         "put w 0x%x, 0x%08x" % (CODE + 16, seq[1]),
 351:         "put w 0x%x, 0x%08x" % (CODE + 20, seq[2]),
 352:         "put w 0x%x, 0x%08x" % (CODE + 24, STR_R0_R4),
 353:         "put w 0x%x, 0x%08x" % (CODE + 28, STR_R1_R5),
 354:         "put w 0x%x, 0x%08x" % (CODE + 32, SUBS_R8_R9),
 355:         "put w 0x%x, 0x%08x" % (CODE + 36, BEQ_BACK10),
 356:         "put w 0x%x, 0x%08x" % (CODE + 40, NOP),
 357:         "breakpoint add 0x%x" % (CODE + 40),
 358:         "pc=0x%x" % CODE, "continue"], 2)
 359:     if w is None or w[0] == "deadbeef":
 360:         return None
 361:     return sw(w[0]), sw(w[1])
 362: 
 363: 
 364: #  #345/#346: NetBSD cache-clean fold. The matcher (COMBINE(netbsd_cacheclean)
 365: #  in cpu_arm_instr.c; numeric line cites here went stale twice in two rounds,
 366: #  so this one is by symbol) tested
 367: #  only the SHAPE of the loop -- a post-indexed word load, `subs rX,rX,#32`, a
 368: #  branch back to the load -- while X(netbsd_cacheclean) hardcodes
 369: #  `r[0] += r[1]; r[1] = 0`. #345 pinned the two registers the handler WRITES;
 370: #  #346 pins the load's own remaining two operands, because that closed form is
 371: #  arithmetic that only holds for a 32-BYTE STRIDE.
 372: #
 373: #  The genuine sequence, from the comment above X(netbsd_cacheclean):
 374: #
 375: #      ldr  r2,[r0],#32        subs r1,r1,#0x20        bne back        mcr ...
 376: #
 377: #  All four loops below are built from that with exactly ONE field wrong, so
 378: #  each row attributes its answer to one guard.
 379: SUBS_R6_32   = 0xE2566020       # subs r6,r6,#32
 380: SUBS_R1_32   = 0xE2511020       # subs r1,r1,#32
 381: BNE_BACK4    = 0x1AFFFFFC       # bne  -4 words, back to the load
 382: MCR_CLEAN    = 0xEE070F9A       # the iword that arms the combination check
 383: MOV_R6_32    = 0xE3A06020       # mov  r6,#32  -> one subs reaches zero
 384: MOV_R1_32    = 0xE3A01020       # mov  r1,#32
 385: MOV_R0_11    = 0xE3A00011       # mov  r0,#0x11 -- sentinel the loop never uses
 386: MOV_R1_22    = 0xE3A01022       # mov  r1,#0x22
 387: MOV_R5_9100  = 0xE3A05C91       # mov  r5,#0x9100  (safe RAM as the load base)
 388: MOV_R0_9100  = 0xE3A00C91       # mov  r0,#0x9100
 389: MOV_R2_77    = 0xE3A02077       # mov  r2,#0x77 -- the load's destination seed
 390: MOV_R6_66    = 0xE3A06066       # mov  r6,#0x66 -- ditto for the wrong-Rd loop
 391: STR_R0_R7    = 0xE5870000
 392: STR_R1_R7_4  = 0xE5871004
 393: STR_R2_R7_8  = 0xE5872008
 394: STR_R6_R7_12 = 0xE587600C
 395: 
 396: #  Round 99: the outer back-branch is COMPUTED from the program layout
 397: #  (outer_beq below). Its predecessor BEQ_BACK16 was a hand-encoded offset
 398: #  that was correct only for the 17-word #345/#346 program; adding the flag
 399: #  seed and the cpsr publish would have silently retargeted it mid-program,
 400: #  skipped the counter seeds on pass 2, and let `fold r0` and `still folds`
 401: #  keep passing while measuring a different program -- the hand-assembled-
 402: #  encoding trap this harness has recorded twice already.
 403: MOV_R1_48    = 0xE3A01030       # mov  r1,#0x30 -- borrow-exit counter
 404: MOV_R1_0     = 0xE3A01000       # mov  r1,#0    -- the #347 r1==0 disjunct
 405: MOV_R1_33    = 0xE3A01021       # mov  r1,#0x21 -- non-multiple counter
 406: MOV_R10_20   = 0xE3A0A020       # mov  r10,#0x20 -- zero-n pass-1 counter
 407: MOV_R10_0    = 0xE3A0A000       # mov  r10,#0    -- zero-n pass-2 counter
 408: MOV_R1_R10   = 0xE1A0100A       # mov  r1,r10   -- per-pass counter seed
 409: CMP_R9_HI    = 0xE3590208       # cmp  r9,#0x80000000 (0x08 ror 4; r9=1 ->
 410:                                 #   N1 Z0 C0 V1 = 0x9: every NZCV bit must
 411:                                 #   move to reach the 0x6 answer. 0xE3590102
 412:                                 #   encodes the same value; this one is the
 413:                                 #   form the round-99 repro measured live)
 414: CMP_R9_1     = 0xE3590001       # cmp  r9,#1 (r9=1 -> 0 -> Z1 C1 = 0x6)
 415: 
 416: CC_BASE = 0x9100                # safe RAM, clear of DEST..DEST+19
 417: CC_MEM  = 0xA5A5A5A5            # the word the load must fetch from CC_BASE
 418: 
 419: #  #349's fold-fired markers, anchored to the debugmsg line shape. On this
 420: #  1-machine 1-cpu rig the line is `[ cpu <name>: combined N iterations ]`
 421: #  -- there is NO "cpu0:" prefix (debugmsg.c:213-232 prints it only for
 422: #  multiple machines/cpus). Anchoring on `cpu <name>: combined` survives
 423: #  both the name-prefix collision (cacheclean vs cacheclean2) and pty ECHO
 424: #  of the probe's own typed commands, which lands in the same transcript.
 425: MARK1 = re.compile(r"cpu netbsd_cacheclean: combined")
 426: MARK2 = re.compile(r"cpu netbsd_cacheclean2: combined")
 427: 
 428: 
 429: def outer_beq(branch_idx, target_idx=1):
 430:     """Backward BEQ from program word branch_idx to word target_idx
 431:     (ARM B offset: target = branch + 8 + imm24*4)."""
 432:     return 0x0A000000 | ((target_idx - branch_idx - 2) & 0xFFFFFF)
 433: 
 434: 
 435: def verb_cmds():
 436:     """Raise the cpu subsystem to DEBUG and echo the setting back. The
 437:     echo line ("3: DEBUG") is each fires-session's own positive control
 438:     that the level took -- an absence row under a verbosity that silently
 439:     failed to rise would pass for the wrong reason."""
 440:     return ["verbosity cpu 3", "verbosity cpu"]
 441: 
 442: 
 443: def marker_count(buf, mark):
 444:     return len(mark.findall(buf)) if buf else 0
 445: 
 446: 
 447: def verb_took(buf):
 448:     return "3: DEBUG" in (buf or "")
 449: 
 450: 
 451: def ldr_post(rn, rd, imm):
 452:     """LDR Rd,[Rn],#imm -- post-indexed, immediate, U=1 W=0 (add, no writeback
 453:     bit; post-index always writes back). arg[0]=&r[Rn], arg[1]=imm,
 454:     arg[2]=&r[Rd] (the load/store decode in cpu_arm_instr.c's main-opcode-4
 455:     case, and cpu_arm_instr_loadstore.c:118)."""
 456:     return 0xE4900000 | (rn << 16) | (rd << 12) | imm
 457: 
 458: 
 459: def run_cacheclean(variant, seed=NOP, verbose=False):
 460:     """Two-pass witness for the cache-clean fold's operand checks.
 461: 
 462:     The inner `bne` never has to be TAKEN -- the matcher inspects the branch's
 463:     target at translation time, not its outcome -- so the counter is seeded to
 464:     32 and one `subs` reaches zero, except in "genuine40", whose TWO
 465:     iterations are load-bearing for #348: with a 0x20 counter, a broken fix
 466:     that skipped the `r[1] = 0x20` preload and delegated the subs on the LIVE
 467:     counter would produce bit-identical registers AND flags, and no row could
 468:     see it (a round-99 review seat's finding). At 0x40 the two diverge:
 469:     correct code answers r1 = 0 with flags Z|C; a missing preload answers
 470:     r1 = 0x20 with C alone. What must happen twice is entry to the whole
 471:     block, because the combiner rewrites ic[-3] while the MCR is translated,
 472:     so the folded handler only exists from the second pass (see run_combined).
 473: 
 474:     `seed` is one extra instruction word run LAST among the seeds on every
 475:     pass -- the flag preset for the #348 rows, a NOP elsewhere -- so the
 476:     value the cpsr row reads cannot have been left by anything but the loop.
 477:     `verbose=True` raises the cpu subsystem to DEBUG first and echoes the
 478:     setting back (the #349 fires rows; the echo is the session's own proof
 479:     the level took). Returns ((r0, r1, r2, r6, cpsr), transcript).
 480: 
 481:     Five program variants, one field each:
 482: 
 483:       "wrongregs" -- base r5, counter r6, stride 32. #345's guard. Folded it
 484:           answers r0 = 0x11 + 0x22 = 0x33 and r1 = 0; architecturally r0 and r1
 485:           are untouched. Its stride is 32 ON PURPOSE, so that #346's immediate
 486:           check cannot block this fold and quietly stand in for #345's.
 487: 
 488:       "genuine"   -- the real sequence, counter 0x20, and a fold CONTROL: it
 489:           must STILL fold, or the guards are over-tight and the optimisation
 490:           is silently dead. r0 CANNOT discriminate here -- the closed form is
 491:           exactly right for a 32-stride loop, and both answers are 0x9120
 492:           (measured). What separates them is r2: the handler never performs
 493:           the load, so folded r2 keeps its seed 0x77, while unfolded it holds
 494:           CC_MEM. That stale destination is a real defect round 99 did NOT fix
 495:           (see OUTSTANDING_BUGS); the row pins today's behaviour precisely
 496:           because it is a fold detector independent of #349's marker.
 497: 
 498:       "genuine40" -- the real sequence, counter 0x40: carries the #348 flag
 499:           and counter rows (see above).
 500: 
 501:       "imm4"      -- the same loop with `ldr r2,[r0],#4`. #346's discriminator:
 502:           the fold advances r0 by 32 regardless, so it answered 0x9120 where the
 503:           architecture returns 0x9104, and r2 was left at 0x77 instead of CC_MEM.
 504: 
 505:       "wrongdest" -- `ldr r6,[r0],#32`. Right stride, right base and counter,
 506:           wrong destination: the fold fired and stranded r6 at 0x66 rather than
 507:           CC_MEM.
 508: 
 509:     Every architectural answer above was taken from the identical program with
 510:     the MCR replaced by a nop, so that nothing combines at all.
 511:     """
 512:     if variant == "wrongregs":
 513:         seeds = [MOV_R6_32, MOV_R0_11, MOV_R1_22, MOV_R5_9100, MOV_R2_77]
 514:         ldr, subs = ldr_post(5, 4, 0x20), SUBS_R6_32
 515:     elif variant == "genuine":
 516:         seeds = [MOV_R1_32, MOV_R0_9100, NOP, NOP, MOV_R2_77]
 517:         ldr, subs = ldr_post(0, 2, 0x20), SUBS_R1_32
 518:     elif variant == "genuine40":
 519:         seeds = [MOV_R1_64, MOV_R0_9100, NOP, NOP, MOV_R2_77]
 520:         ldr, subs = ldr_post(0, 2, 0x20), SUBS_R1_32
 521:     elif variant == "imm4":
 522:         seeds = [MOV_R1_32, MOV_R0_9100, NOP, NOP, MOV_R2_77]
 523:         ldr, subs = ldr_post(0, 2, 0x04), SUBS_R1_32
 524:     elif variant == "wrongdest":
 525:         seeds = [MOV_R1_32, MOV_R0_9100, MOV_R6_66, NOP, MOV_R2_77]
 526:         ldr, subs = ldr_post(0, 6, 0x20), SUBS_R1_32
 527:     else:
 528:         raise ValueError(variant)
 529:     #  CODE+4 is the outer loop top: every seed re-runs on both passes, and
 530:     #  the flag seed runs LAST.
 531:     prog = [MOV_R8_1] + seeds + [seed] + [
 532:         ldr,                    # ic[-3]
 533:         subs,                   # ic[-2]
 534:         BNE_BACK4,              # ic[-1]
 535:         MCR_CLEAN,              # ic[0] -- arms the combination check
 536:         MRS_R3_CPSR,
 537:         STR_R0_R7, STR_R1_R7_4, STR_R2_R7_8, STR_R6_R7_12, STR_R3_R7_16,
 538:         SUBS_R8_R9]
 539:     prog += [outer_beq(len(prog)), NOP]
 540:     cmds = ["r9=0x1", "r7=0x%x" % DEST,
 541:             "put w 0x%x, 0x%08x" % (CC_BASE, CC_MEM)]
 542:     cmds += ["put w 0x%x, 0xdeadbeef" % (DEST + 4 * i) for i in range(5)]
 543:     cmds += ["put w 0x%x, 0x%08x" % (CODE + 4 * i, iw)
 544:              for i, iw in enumerate(prog)]
 545:     if verbose:
 546:         cmds += verb_cmds()
 547:     cmds += ["breakpoint add 0x%x" % (CODE + 4 * (len(prog) - 1)),
 548:              "pc=0x%x" % CODE, "continue"]
 549:     w, buf = session(cmds, 5)
 550:     if w is None or w[0] == "deadbeef":
 551:         return None, buf
 552:     return tuple(sw(x) for x in w), buf
 553: 
 554: 
 555: def run_cc_nonmult():
 556:     """#350's witness: a counter that is not a multiple of 32 must NOT fold.
 557: 
 558:     Architecturally `subs r1,r1,#0x20` from 0x21 never reaches zero (the
 559:     residue mod 32 is invariant), so the bne loop never exits; the unguarded
 560:     fold terminated it. The program installs the fold with a genuine 0x20
 561:     pass, then re-enters the SAME translated slot once with r1 = 0x21:
 562: 
 563:         word  0  mov r8,#1               outer-pass counter
 564:               1  mov r1,#0x20            \\ phase-A seeds
 565:               2  mov r0,#0x9100          /
 566:               3  mov r2,#0x77
 567:               4  ldr r2,[r0],#32         <- the fold slot
 568:               5  subs r1,r1,#0x20
 569:               6  bne -> 4
 570:               7  mcr (arms; fold exit lands at word 8)
 571:               8  mov r1,#0x21            phase-B counter
 572:               9  subs r8,r9              1->0 Z=1 first time, 0->-1 Z=0 after
 573:              10  beq -> 4                taken exactly once: re-enter the fold
 574:              11  str r0,[r7]             publish
 575:              12  nop                     breakpoint
 576: 
 577:     UNGUARDED: the fold consumes r1 = 0x21, r0 += 0x21 = 0x9141 (odd), falls
 578:     out to words 8-12 and hits the breakpoint without help. GUARDED: the
 579:     handler falls back to the real load every iteration and the loop runs
 580:     forever, exactly as the architecture says; the session is forced back to
 581:     the prompt with ^C and the verdict read from the REGISTERS. "live"
 582:     demands THREE things, and the third is load-bearing (a review seat's
 583:     catch): r1 mod 32 == 1 (the residue invariant), r0 a multiple of 0x20,
 584:     AND r0 advanced past phase A's 0x9120 -- because a broken guard that
 585:     returned WITHOUT calling the load would also loop forever with the
 586:     residue invariant intact, but its r0 would be parked at 0x9120. Only
 587:     the genuine fallback's post-index writeback moves r0.
 588: 
 589:     The first version of this witness planted a handler at the data-abort
 590:     vector and expected the walking load to fault at the top of RAM. That
 591:     was measured FALSE on this tree: a read of non-existent physical memory
 592:     logs `memory READ: from non-existant paddr=...` per access and execution
 593:     CONTINUES with the load returning junk -- r0 was observed 4 MB past the
 594:     top of RAM, still walking (pc mid-loop, r1 invariant holding, which is
 595:     also the live proof the guard's fallback path executes real loads). The
 596:     same first version compared the dump string against "deadbeef" without
 597:     byte-swapping -- the little-endian transposition this file's header
 598:     warns about -- and so read its own sentinel's parity as a measurement.
 599:     Both mistakes are recorded here so the next witness starts further on.
 600: 
 601:     A "live" verdict proves the guard HELD; it cannot by itself prove the
 602:     fold was ever INSTALLED -- a broken matcher yields the same infinite
 603:     loop. Words 4-7 here are iword-identical to the genuine session's
 604:     program, whose still-folds and fires rows carry installation for this
 605:     shape; the coverage is cross-row by design.
 606: 
 607:     Returns "fold" (the defect: fold consumed the counter), "live" (guard
 608:     held; loop genuinely running), a state string for anything else, or
 609:     None if the session died."""
 610:     prog = [MOV_R8_1, MOV_R1_32, MOV_R0_9100, MOV_R2_77,
 611:             ldr_post(0, 2, 0x20),   # word 4: the fold slot
 612:             SUBS_R1_32,
 613:             BNE_BACK4,              # -> word 4
 614:             MCR_CLEAN,
 615:             MOV_R1_33,
 616:             SUBS_R8_R9,
 617:             0x0AFFFFF8,             # beq -> word 4 (imm24 = 4 - 10 - 2 = -8)
 618:             STR_R0_R7, NOP]
 619:     pid, fd = pty.fork()
 620:     if pid == 0:
 621:         os.execvp(BIN, [BIN, "-V", "-A", "-E", "testarm", "-M", "64",
 622:                         "0x%x:%s" % (CODE, STUB)])
 623:         os._exit(127)
 624:     buf = ""
 625: 
 626:     def rd(t=0.4):
 627:         nonlocal buf
 628:         r, _, _ = select.select([fd], [], [], t)
 629:         if fd not in r:
 630:             return True
 631:         try:
 632:             d = os.read(fd, 65536)
 633:         except OSError:
 634:             return False
 635:         if not d:
 636:             return False
 637:         buf += d.decode("latin1", "replace")
 638:         return True
 639: 
 640:     def wait(timeout=30):
 641:         t = time.time()
 642:         while time.time() - t < timeout:
 643:             if not rd():
 644:                 return False
 645:             if buf.rstrip().endswith("GXemul>"):
 646:                 return True
 647:         return False
 648: 
 649:     def send(s, tmo=30):
 650:         b = (s + "\n").encode("latin1")
 651:         n = 0
 652:         while n < len(b):
 653:             n += os.write(fd, b[n:])
 654:         return wait(tmo)
 655: 
 656:     if not wait(60):
 657:         try:
 658:             os.kill(pid, 9)
 659:             os.waitpid(pid, 0)
 660:         except Exception:
 661:             pass
 662:         return None
 663:     send("r9=0x1")
 664:     send("r7=0x%x" % DEST)
 665:     send("put w 0x%x, 0x%08x" % (CC_BASE, CC_MEM))
 666:     for i, iw in enumerate(prog):
 667:         send("put w 0x%x, 0x%08x" % (CODE + 4 * i, iw))
 668:     send("breakpoint add 0x%x" % (CODE + 4 * (len(prog) - 1)))
 669:     send("pc=0x%x" % CODE)
 670:     #  Prompt detection anchored PAST the continue echo: whole-buffer
 671:     #  endswith() could match the stale pre-continue prompt, or a flood
 672:     #  line's trailing '>'. Either mis-detection fails toward "dead" (the
 673:     #  reg parse then starves), never toward a false verdict, but the
 674:     #  anchor removes the stall.
 675:     mark0 = len(buf)
 676:     os.write(fd, b"continue\n")
 677: 
 678:     def wait_past_mark(timeout):
 679:         t = time.time()
 680:         while time.time() - t < timeout:
 681:             if not rd():
 682:                 return False
 683:             if len(buf) > mark0 and buf[mark0:].rstrip().endswith("GXemul>"):
 684:                 return True
 685:         return False
 686: 
 687:     hit_bp = wait_past_mark(2.5)
 688:     if not hit_bp:
 689:         os.write(fd, b"\x03")
 690:         if not wait(15):
 691:             try:
 692:                 os.kill(pid, 9)
 693:                 os.waitpid(pid, 0)
 694:             except Exception:
 695:                 pass
 696:             return None
 697:     mark = len(buf)
 698:     send("reg")
 699:     seg = buf[mark:]
 700:     regs = {}
 701:     for r in ("r0", "r1"):
 702:         m = re.search(r"\b%s\s*=\s*0x([0-9a-f]+)" % r, seg)
 703:         if not m:
 704:             try:
 705:                 os.write(fd, b"quit\n")
 706:                 time.sleep(0.3)
 707:                 os.kill(pid, 9)
 708:                 os.waitpid(pid, 0)
 709:             except Exception:
 710:                 pass
 711:             return None
 712:         regs[r] = int(m.group(1), 16)
 713:     try:
 714:         os.write(fd, b"quit\n")
 715:         time.sleep(0.3)
 716:         os.kill(pid, 9)
 717:         os.waitpid(pid, 0)
 718:     except Exception:
 719:         pass
 720:     if hit_bp:
 721:         return "fold" if (regs["r0"] & 1) else "exit-%x" % regs["r0"]
 722:     if ((regs["r1"] & 0x1f) == 1 and (regs["r0"] & 0x1f) == 0
 723:             and regs["r0"] != 0x9120):
 724:         return "live"
 725:     return "state-%x-%x" % (regs["r0"], regs["r1"])
 726: 
 727: 
 728: def run_cc_zero_n():
 729:     """#350's r1 == 0 arm: gate the HONEST iteration count via the marker.
 730: 
 731:     For a zero counter the fold's registers and flags are identical whether
 732:     n is 2^27 or a reverted `r1 >> 5` (= 0) -- only the marker text and the
 733:     batch billing differ -- so the adopted formula was unassertable by any
 734:     state row (a review seat's catch). The #349 marker carries the count,
 735:     so this row reads it back.
 736: 
 737:     Installing the fold by genuinely executing a zero-counter loop is
 738:     infeasible (pass 1 would run 2^27 real iterations, walking the load
 739:     past the top of RAM through the log flood), so the counter is seeded
 740:     THROUGH A REGISTER that changes between passes: pass 1 runs the loop
 741:     with r1 = r10 = 0x20 (one iteration, installs the fold), r10 is then
 742:     cleared, and pass 2 re-enters with r1 = r10 = 0 -- the fold computes
 743:     n = 2^27 instantly and prints it.
 744: 
 745:         word  0  mov r8,#1
 746:               1  mov r10,#0x20
 747:               2  mov r1,r10          <- outer loop top, re-runs both passes
 748:               3  mov r0,#0x9100
 749:               4  mov r2,#0x77
 750:               5  ldr r2,[r0],#32     <- the fold slot
 751:               6  subs r1,r1,#0x20
 752:               7  bne -> 5
 753:               8  mcr (arms)
 754:               9  mov r10,#0          the second pass's counter
 755:              10  subs r8,r9
 756:              11  beq -> 2
 757:              12  nop                 breakpoint
 758: 
 759:     Returns the printed count as a string, "none" if the marker never
 760:     fired, or None if the session died."""
 761:     prog = [MOV_R8_1, MOV_R10_20,
 762:             MOV_R1_R10,             # word 2: outer loop top
 763:             MOV_R0_9100, MOV_R2_77,
 764:             ldr_post(0, 2, 0x20),   # word 5: the fold slot
 765:             SUBS_R1_32,
 766:             BNE_BACK4,              # -> word 5
 767:             MCR_CLEAN,
 768:             MOV_R10_0,
 769:             SUBS_R8_R9,
 770:             0x0AFFFFF5,             # beq -> word 2 (imm24 = 2 - 11 - 2 = -11)
 771:             NOP]
 772:     cmds = ["r9=0x1",
 773:             "put w 0x%x, 0x%08x" % (CC_BASE, CC_MEM)]
 774:     cmds += ["put w 0x%x, 0x%08x" % (CODE + 4 * i, iw)
 775:              for i, iw in enumerate(prog)]
 776:     cmds += verb_cmds()
 777:     cmds += ["breakpoint add 0x%x" % (CODE + 4 * (len(prog) - 1)),
 778:              "pc=0x%x" % CODE, "continue"]
 779:     w, buf = session(cmds, 0)
 780:     if w is None:
 781:         return None
 782:     m = re.search(r"cpu netbsd_cacheclean: combined (\d+) iterations",
 783:                   buf or "")
 784:     return m.group(1) if m else "none"
 785: 
 786: 
 787: #  #347: the SECOND cache-clean fold, and a worse case than the first. The
 788: #  genuine NetBSD sequence (from the comment above X(netbsd_cacheclean2)) is
 789: #
 790: #      mcr 15,0,r0,cr7,cr10,1     mcr 15,0,r0,cr7,cr6,1
 791: #      add r0,r0,#0x20            subs r1,r1,#0x20        bhi back
 792: #
 793: #  The two MCRs are pinned by exact iword, but the add and the subs were tested
 794: #  only for `rn == rd` and an immediate of 32 -- ANY register -- while the
 795: #  handler updated NO registers at all. Both halves are measured below.
 796: #
 797: #  The genuine counter is 0x40, two iterations, so the loop's last subs
 798: #  reaches ZERO; the borrow (0x30) and zero (0) counters exercise the other
 799: #  exit, where the subs BORROWS (see run_cc2).
 800: MCR_CC2_A  = 0xEE070F3A         # mcr 15,0,r0,cr7,cr10,1  -- ic[-4]
 801: MCR_CC2_B  = 0xEE070F36         # mcr 15,0,r0,cr7,cr6,1   -- ic[-3]
 802: ADD_R0_32  = 0xE2800020         # add  r0,r0,#0x20
 803: ADD_R5_32  = 0xE2855020         # add  r5,r5,#0x20
 804: BHI_BACK6  = 0x8AFFFFFA         # bhi  -6 words; the iword that arms the check
 805: CMP_R9_2   = 0xE3590002         # cmp  r9,#2  (r9 == 1) -> N=1 Z=0 C=0 V=0
 806: MOV_R1_64  = 0xE3A01040         # mov  r1,#0x40  -- two iterations
 807: MOV_R6_64  = 0xE3A06040         # mov  r6,#0x40
 808: MOV_R5_55  = 0xE3A05055         # mov  r5,#0x55 -- sentinel
 809: STR_R5_R7_8  = 0xE5875008
 810: STR_R3_R7_16 = 0xE5873010
 811: 
 812: 
 813: def run_cc2(variant, seed=CMP_R9_2, verbose=False):
 814:     """Two-pass witness for the SECOND cache-clean fold. Returns
 815:     ((r0, r1, r5, r6, cpsr), transcript).
 816: 
 817:     Unlike variant 1 the trigger is the BRANCH itself (the iword ==
 818:     0x8afffffa arming in cpu_arm_instr.c's to_be_translated, case 0xa --
 819:     cited by symbol; the numeric cite went stale twice), which sits at the
 820:     bottom of the loop, so on pass 1 the combiner rewrites ic[-4] and the
 821:     very next backward branch already lands on the folded handler. Pass 2 is still the
 822:     one that matters: it re-seeds every register and enters the block with
 823:     the fold already in place, which is the state a real guest reaches. The
 824:     stores run on both passes and the second overwrites the first.
 825: 
 826:     `seed` is the flag preset, run LAST among the seeds on every pass so the
 827:     value the cpsr rows read cannot have been left by anything but the loop.
 828:     The #348 rows use `cmp r9,#0x80000000` (0x9 -- every NZCV bit must move
 829:     to reach the zero-exit answer 0x6) and `cmp r9,#1` (0x6, against the
 830:     borrow-exit answer 0x8). `verbose=True` raises the cpu subsystem to
 831:     DEBUG and echoes the setting (the #349 fires rows).
 832: 
 833:     Five loops -- three matcher probes, each ONE field off the genuine
 834:     sequence, and two more counters for the exit-flag family:
 835: 
 836:       "genuine"   -- the real thing, counter 0x40, zero exit. DISC on r0/r1
 837:           (the #347 defect: stranded at 0x9100/0x40 where the loop owes
 838:           0x9140/0) and on the exit flags (the #348 defect: seed survived
 839:           where the loop owes Z|C = 0x6).
 840: 
 841:       "wrongbase" -- `add r5,r5,#32 / subs r1,r1,#32`. DISC on r5 and r1, which
 842:           the fold stranded at 0x9100 and 0x40. r0 is seeded 0x11 and PINNED:
 843:           it is what catches the OPPOSITE error, a handler that now writes r[0]
 844:           and r[1] by name behind a matcher that still accepts any register.
 845: 
 846:       "wrongcnt"  -- `add r0,r0,#32 / subs r6,r6,#32`. DISC on r6 (0x40 where
 847:           the loop owes 0); r1 is seeded 0x22 and pinned for the same reason.
 848:           r0 is deliberately NOT a row here: the architecture leaves 0x9140 and
 849:           an unguarded fold reading r1 = 0x22 computes 0x9140 too, so it cannot
 850:           attribute anything.
 851: 
 852:       "borrow"    -- counter 0x30: the loop exits on the subs BORROWING, not
 853:           reaching zero, and owes N alone (0x8) with r0 = 0x9140 and
 854:           r1 = 0xfffffff0. The registers pin #347's closed form on the borrow
 855:           path, which no other row covers; run with both flag seeds, 0x6 to
 856:           discriminate N/Z/C and 0x9 to discriminate V.
 857: 
 858:       "zero"      -- counter 0: the one input where #347's `(r1 == 0 ||`
 859:           disjunct is load-bearing (an alternative closed form like
 860:           `(r1+31)>>5` fails exactly here). One iteration, borrow exit:
 861:           owes r0 = 0x9120, r1 = 0xffffffe0, flags 0x8.
 862: 
 863:     The old cpsr CONTROL row (`A cclean2 still fold`) asserted the MISSING
 864:     flags and died with the defect: once #348 lands, the genuine sequence is
 865:     architecturally transparent folded or unfolded, and no register or flag
 866:     can prove the fold still fires. #349's DEBUG-gated marker took over that
 867:     duty -- see the fires/quiet rows.
 868: 
 869:     Architectural answers are measured, never derived: the identical program
 870:     with the first MCR replaced by a nop, so nothing combines. cr7 is an
 871:     unconditional no-op in this emulator (cpu_arm_coproc.c:209-215), so the
 872:     substitution changes nothing else, and a second neutraliser that instead
 873:     perturbs only the SECOND MCR's opcode2 (0xee070f56, still cr7) returned the
 874:     same values for all three loops on both builds.
 875:     """
 876:     if variant == "genuine":
 877:         seeds = [MOV_R1_64, MOV_R0_9100, MOV_R5_55, MOV_R6_66]
 878:         add, subs = ADD_R0_32, SUBS_R1_32
 879:     elif variant == "wrongbase":
 880:         seeds = [MOV_R1_64, MOV_R5_9100, MOV_R0_11, MOV_R6_66]
 881:         add, subs = ADD_R5_32, SUBS_R1_32
 882:     elif variant == "wrongcnt":
 883:         seeds = [MOV_R6_64, MOV_R0_9100, MOV_R1_22, MOV_R5_55]
 884:         add, subs = ADD_R0_32, SUBS_R6_32
 885:     elif variant == "borrow":
 886:         seeds = [MOV_R1_48, MOV_R0_9100, MOV_R5_55, MOV_R6_66]
 887:         add, subs = ADD_R0_32, SUBS_R1_32
 888:     elif variant == "zero":
 889:         seeds = [MOV_R1_0, MOV_R0_9100, MOV_R5_55, MOV_R6_66]
 890:         add, subs = ADD_R0_32, SUBS_R1_32
 891:     else:
 892:         raise ValueError(variant)
 893:     #  CODE+4 is the outer loop top; the flag seed is the LAST seed so that the
 894:     #  value the flag rows read cannot have been left by anything but the loop.
 895:     #  Program length is identical for every variant and seed (one-for-one
 896:     #  substitutions), so the computed outer branch always resolves to the
 897:     #  same word the old hand-encoded BEQ_BACK19 held.
 898:     prog = [MOV_R8_1] + seeds + [seed] + [
 899:         MCR_CC2_A,              # ic[-4] -- also the branch's target
 900:         MCR_CC2_B,              # ic[-3]
 901:         add,                    # ic[-2]
 902:         subs,                   # ic[-1]
 903:         BHI_BACK6,              # ic[ 0] -- arms the combination check
 904:         MRS_R3_CPSR, STR_R0_R7, STR_R1_R7_4, STR_R5_R7_8, STR_R6_R7_12,
 905:         STR_R3_R7_16, SUBS_R8_R9]
 906:     prog += [outer_beq(len(prog)), NOP]
 907:     cmds = ["r9=0x1", "r7=0x%x" % DEST]
 908:     cmds += ["put w 0x%x, 0xdeadbeef" % (DEST + 4 * i) for i in range(5)]
 909:     cmds += ["put w 0x%x, 0x%08x" % (CODE + 4 * i, iw)
 910:              for i, iw in enumerate(prog)]
 911:     if verbose:
 912:         cmds += verb_cmds()
 913:     cmds += ["breakpoint add 0x%x" % (CODE + 4 * (len(prog) - 1)),
 914:              "pc=0x%x" % CODE, "continue"]
 915:     w, buf = session(cmds, 5)
 916:     if w is None or sw(w[0]) == 0xdeadbeef:
 917:         return None, buf
 918:     return tuple(sw(x) for x in w), buf
 919: 
 920: 
 921: def run_und_condfailed(iw):
 922:     """A conditional UDF whose condition is FALSE must do nothing at all.
 923: 
 924:     This is the strongest reachability witness in the table. The committed
 925:     build's `goto bad` fires during DECODE, before any condition is evaluated,
 926:     so the emulator stops even though the instruction would never have executed
 927:     -- the guest does not have to semantically execute anything to stop the
 928:     machine. Returns (fallthrough_marker, handler_marker): the first must be
 929:     written and the second must NOT be, since no exception may be raised."""
 930:     w, _ = session([
 931:         "r6=5", "r7=3",                      # subs => Z=0, so EQ fails
 932:         "r4=0x%x" % DEST, "r5=0x%x" % (DEST + 4),
 933:         "put w 0x%x, 0xdeadbeef" % DEST,
 934:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
 935:         #  handler at the vector: if it runs, the row fails
 936:         "put w 0x%x, 0x%08x" % (VECT,     MOV_R0_5A),
 937:         "put w 0x%x, 0x%08x" % (VECT + 4, STR_R0_R5),
 938:         "put w 0x%x, 0x%08x" % (CODE,      SUBS_R6_R6_R7),
 939:         "put w 0x%x, 0x%08x" % (CODE + 4,  iw),
 940:         "put w 0x%x, 0x%08x" % (CODE + 8,  MOV_R0_5A),
 941:         "put w 0x%x, 0x%08x" % (CODE + 12, STR_R0_R4),
 942:         "pc=0x%x" % CODE, "step 6"], 2)
 943:     if w is None:
 944:         return None, None
 945:     return sw(w[0]), sw(w[1])
 946: 
 947: 
 948: def run_und(iw, at=CODE):
 949:     """Plant a handler at the UND vector; report (mode, lr, marker).
 950: 
 951:     The marker is the row that proves the handler RAN; mode and lr prove it was
 952:     entered as an exception rather than fallen into.
 953: 
 954:     `at` places the undefined word at a chosen address. X(und) reconstructs the
 955:     faulting PC as `(pc & 0xfffff000) + arg[0]` with `arg[0] = addr & 0xfff`,
 956:     both hard-coded to a 4KB instruction page. Offset 0 exercises none of that
 957:     arithmetic -- the two halves are zero -- so a row at the LAST slot of a
 958:     page is the one that can actually catch a wrong mask (a panel seat's
 959:     finding)."""
 960:     w, _ = session([
 961:         "r4=0x%x" % DEST, "r5=0x%x" % (DEST + 4), "r6=0x%x" % (DEST + 8),
 962:         "put w 0x%x, 0xdeadbeef" % DEST,
 963:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
 964:         "put w 0x%x, 0xdeadbeef" % (DEST + 8),
 965:         "put w 0x%x, 0x%08x" % (VECT,      MRS_R3_CPSR),
 966:         "put w 0x%x, 0x%08x" % (VECT + 4,  STR_R3_R4),
 967:         "put w 0x%x, 0x%08x" % (VECT + 8,  STR_LR_R5),
 968:         "put w 0x%x, 0x%08x" % (VECT + 12, MOV_R0_5A),
 969:         "put w 0x%x, 0x%08x" % (VECT + 16, STR_R0_R6),
 970:         "put w 0x%x, 0x%08x" % (at,        iw),
 971:         "pc=0x%x" % at, "step 8"], 3)
 972:     if w is None:
 973:         return None, None, None
 974:     return sw(w[0]), sw(w[1]), sw(w[2])
 975: 
 976: 
 977: #  ---- round 78: rotations the decoder used to reject, and MVNS's carry ------
 978: #  Three defects, all measured halting or answering wrongly on the committed
 979: #  build. Each row asserts a VALUE, not survival: round 79's sweep showed that a
 980: #  probe which only asks "did the emulator keep running" cannot tell a repaired
 981: #  instruction from one that merely stopped faulting.
 982: #
 983: #  `uxtah ROR 24` is the discriminating row of the first group. A byte extract
 984: #  gives the same answer under a rotate as under a shift at every encodable
 985: #  amount, so the uxtab rows cannot distinguish the two; at ROR 24 the halfword
 986: #  form wraps rm's low byte into bits 15:8, and copying the byte form's shift
 987: #  would be silently wrong for exactly that one encoding.
 988: #
 989: #  The `movs r0,#0 ROR 4` row is the one that never halted: the old guard
 990: #  exempted an imm8 of zero, so that case shipped with the wrong carry instead
 991: #  of loudly stopping. It is the reason this group is a wrong-answer fix and not
 992: #  only a halt fix.
 993: #
 994: #  The MVNS rows cover all four bands. The decoder rewrites `mvn #imm` into
 995: #  `mov #~imm`, and with S set the template then read the carry off the
 996: #  COMPLEMENT -- inverting the answer everywhere. Two rows would have passed by
 997: #  coincidence, which is why all four bands are here.
 998: STR_R0_R4 = 0xe5840000
 999: MRS_R3_CPSR2 = 0xe10f3000
1000: STR_R3_R4 = 0xe5843000
1001: SUBS_PRESET = 0xe0566007
1002: 
1003: R78 = [
1004:     #  (name, register presets, instruction, want, carry-in or None, read_flag)
1005:     ("uxtab ROR 8",   ["r1=0", "r2=0x11223344"], 0xe6e10472, 0x33, None, False),
1006:     ("uxtab ROR 16",  ["r1=0", "r2=0x11223344"], 0xe6e10872, 0x22, None, False),
1007:     ("uxtab ROR 24",  ["r1=0", "r2=0x11223344"], 0xe6e10c72, 0x11, None, False),
1008:     ("uxtah ROR 8",   ["r1=0", "r2=0x11223344"], 0xe6f10472, 0x2233, None, False),
1009:     ("uxtah ROR 16",  ["r1=0", "r2=0x11223344"], 0xe6f10872, 0x1122, None, False),
1010:     ("uxtah ROR 24",  ["r1=0", "r2=0x11223344"], 0xe6f10c72, 0x4411, None, False),
1011:     ("uxtab ROR 0",   ["r1=0", "r2=0x11223344"], 0xe6e10072, 0x44, None, False),
1012:     ("rotc movs val", [], 0xe3b00104, 1, None, False),
1013:     ("rotc movs C",   [], 0xe3b00104, 0, 1, True),
1014:     ("rotc zero C",   [], 0xe3b00200, 0, 1, True),
1015:     ("rotc ands C",   ["r1=0xffffffff"], 0xe2110104, 0, 1, True),
1016:     ("rotc orrs val", ["r1=0x10"], 0xe3910104, 0x11, None, False),
1017:     ("rotc bics val", ["r1=0xff"], 0xe3d10104, 0xfe, None, False),
1018:     ("rotc tst C",    ["r1=0xffffffff"], 0xe3110104, 0, 1, True),
1019:     ("rot0 movs C",   [], 0xe3b00004, 1, 1, True),
1020:     ("mvns rot0 C=0", [], 0xe3f00001, 0, 0, True),
1021:     ("mvns rot0 C=1", [], 0xe3f00001, 1, 1, True),
1022:     ("mvns b31=0 C",  [], 0xe3f00fff, 0, 1, True),
1023:     ("mvns b31=1 C",  [], 0xe3f004ff, 1, 0, True),
1024:     ("mvns value",    [], 0xe3f00001, 0xfffffffe, None, False),
1025:     ("mvn S-clear",   [], 0xe3e00001, 0xfffffffe, None, False),
1026:     #  #322: reading the PC as the source operand. Four of the five diff-review
1027:     #  seats named this as the round's one remaining defect and one supplied the
1028:     #  witness, which measured leaving the carry SET where the architecture
1029:     #  clears it. The first fix excluded rn == PC from routing on the stated
1030:     #  grounds that a cold handler could not reconstruct PC+8; that was simply
1031:     #  wrong -- it needs ic, cur_ic_page and cpu->pc, all of which it has.
1032:     #
1033:     #  The rot-0 row is the pin that keeps the fix honest: with no rotation the
1034:     #  carry must be left ALONE, so a handler that just cleared it always would
1035:     #  pass the row above and fail this one.
1036:     #
1037:     #  `pc gt255` goes through the template rather than the new handler, and
1038:     #  `bound 256` sits exactly one above the routing's `imm < 256` test -- a
1039:     #  rotated operand of 0x100 must take the template's >255 arm and clear the
1040:     #  carry from bit 31. Together they pin both sides of the boundary.
1041:     ("rotc pc src C", [], 0xe31f0104, 0, 1, True),
1042:     ("rot0 pc src C", [], 0xe31f0004, 1, 1, True),
1043:     ("rotc pc gt255", [], 0xe31f0fff, 0, 1, True),
1044:     ("rotc bound 256", [], 0xe3b00c01, 0, 1, True),
1045: ]
1046: 
1047: 
1048: def run78(pre, iw, cin, read_flag):
1049:     """Run one round-78 row; return the observed value, or None."""
1050:     code = [iw, MRS_R3_CPSR2, STR_R3_R4] if read_flag else [iw, STR_R0_R4]
1051:     cmds = list(pre)
1052:     if cin is not None:
1053:         #  Preset the carry with a plain SUBS, never a debugger cpsr write:
1054:         #  the debugger sets cpsr but not the separate `flags` field the
1055:         #  handlers actually read, so a written carry would preset nothing.
1056:         r6, r7 = (1, 0) if cin else (0, 1)
1057:         cmds = ["r6=%d" % r6, "r7=%d" % r7] + cmds
1058:         code = [SUBS_PRESET] + code
1059:     cmds += ["r4=0x%x" % DEST, "put w 0x%x, 0xdeadbeef" % DEST]
1060:     for i, w in enumerate(code):
1061:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
1062:     cmds += ["pc=0x%x" % CODE, "step %d" % len(code)]
1063:     w, _ = session(cmds, 1)
1064:     if w is None:
1065:         return None
1066:     v = sw(w[0])
1067:     return ((v >> 29) & 1) if read_flag else v
1068: 
1069: 
1070: rows = []
1071: 
1072: 
1073: def row(name, kind, got, want):
1074:     #  The name column is 30 wide, and that is load-bearing: gate_arm.sh
1075:     #  matches each named row with TWO spaces after the name, to stop a name that
1076:     #  is a prefix of a longer one from matching both. A name as long as the
1077:     #  column gets NO padding and only the format's single separator space, so
1078:     #  its check can never match anything -- the mirror image of the double-count
1079:     #  trap, and it silently made two checks unsatisfiable until a diff-review
1080:     #  seat found them. It was 26 through #347; round 99's review widened it to
1081:     #  30 for headroom after a proposed name came out at exactly 26 characters.
1082:     #  30 leaves >= 2 spaces for every name here; the longest is 24. Keep this
1083:     #  wider than the longest row name plus two if any are added.
1084:     ok = (got == want)
1085:     rows.append(ok)
1086:     print("%-30s %-12s %-12s %s %s"
1087:           % (name,
1088:              ("0x%08x" % got) if isinstance(got, int) else str(got),
1089:              ("0x%08x" % want) if isinstance(want, int) else str(want),
1090:              kind, "ok" if ok else "FAIL"))
1091: 
1092: 
1093: def cflag(cpsr):
1094:     return None if cpsr is None else (cpsr >> 29) & 1
1095: 
1096: 
1097: def nzcv(cpsr):
1098:     return None if cpsr is None else (cpsr >> 28) & 0xf
1099: 
1100: 
1101: #  ---- control -------------------------------------------------------------
1102: #  Nothing below may be believed unless the rig executes guest code at all.
1103: #  This harness has been bitten by a probe that reported a defect off sentinel
1104: #  reads while its guest code had never run.
1105: cpsr, rd = run_flags(SUBS, 5, 3, 1)
1106: control = "OK" if (cpsr is not None and rd == 2) else "DEAD"
1107: 
1108: print("ARM_FLAGS_CONTROL=%s" % control)
1109: if control != "OK":
1110:     print("ARM_FLAGS_RESULT=0/0")
1111:     sys.exit(0)
1112: 
1113: #  ---- DISC: the SBC/RSC borrow-in defect ----------------------------------
1114: #  Wrong exactly when a == b with carry-in clear, so all three equal-operand
1115: #  rows below are the defect and the unequal ones are pins. Three different
1116: #  equal values, because a fix that special-cased one constant would pass a
1117: #  single row.
1118: for nm, iw, a, b in [("sbcs eq C=0", SBCS, 5, 5),
1119:                      ("sbcs eq0 C=0", SBCS, 0, 0),
1120:                      ("sbcs eqmax C=0", SBCS, 0xffffffff, 0xffffffff),
1121:                      ("rscs eq C=0", RSCS, 5, 5)]:
1122:     cpsr, rd = run_flags(iw, a, b, 0)
1123:     row(nm + " C", "DISC", cflag(cpsr), 0)
1124:     #  The value was ALWAYS right; assert it so a "fix" that repaired the flag
1125:     #  by breaking the arithmetic cannot pass.
1126:     row(nm + " rd", "PIN", rd, 0xffffffff)
1127: 
1128: #  ---- PIN: the same two instructions where they were already correct ------
1129: for nm, iw, a, b, cin, wc, wrd in [
1130:         ("sbcs eq C=1",  SBCS, 5, 5, 1, 1, 0x00000000),
1131:         ("sbcs gt C=0",  SBCS, 5, 4, 0, 1, 0x00000000),
1132:         ("sbcs lt C=0",  SBCS, 4, 5, 0, 0, 0xfffffffe),
1133:         ("sbcs lt C=1",  SBCS, 4, 5, 1, 0, 0xffffffff),
1134:         ("rscs gt C=0",  RSCS, 4, 5, 0, 1, 0x00000000),
1135:         ("rscs lt C=0",  RSCS, 5, 4, 0, 0, 0xfffffffe)]:
1136:     cpsr, rd = run_flags(iw, a, b, cin)
1137:     row(nm + " C", "PIN", cflag(cpsr), wc)
1138:     row(nm + " rd", "PIN", rd, wrd)
1139: 
1140: #  ---- PIN: SUB/RSB/CMP, the three the fix must NOT disturb ----------------
1141: #  These share the rewritten line. `a >= b` and `c32 == c64` agree for them,
1142: #  which is exactly the claim these rows check rather than assume.
1143: for nm, iw, a, b, wc, wrd in [
1144:         ("subs eq", SUBS, 5, 5, 1, 0x00000000),
1145:         ("subs lt", SUBS, 3, 5, 0, 0xfffffffe),
1146:         ("subs gt", SUBS, 5, 3, 1, 0x00000002),
1147:         ("subs zerominus", SUBS, 0, 1, 0, 0xffffffff),
1148:         ("rsbs gt", RSBS, 3, 5, 1, 0x00000002),
1149:         ("rsbs lt", RSBS, 5, 3, 0, 0xfffffffe)]:
1150:     cpsr, rd = run_flags(iw, a, b, 1)
1151:     row(nm + " C", "PIN", cflag(cpsr), wc)
1152:     row(nm + " rd", "PIN", rd, wrd)
1153: 
1154: #  The A__PC template variant compiles its OWN copy of the changed line, and it
1155: #  is the one operand path that is not plainly a 32-bit register read: when Rn
1156: #  is PC the template recomputes the operand as page_base + slot*4 + 8 in 64-bit
1157: #  arithmetic, which passes 2^32 for the last two instruction slots of the
1158: #  address space. Three panel seats raised it and one classified it as a
1159: #  regression this round would otherwise introduce, so #311 truncates that
1160: #  operand back to 32 bits -- correct on its own terms, since ARM's PC is 32
1161: #  bits and reading it must wrap.
1162: #
1163: #  These two rows CANNOT reach the top-of-space case: it needs RAM mapped at
1164: #  0xfffff000 and this machine has not got any. What they do prove is that the
1165: #  truncation left the reachable A__PC path alone, which is the part that is
1166: #  measurable. The corner itself is reasoned, not measured, and the round notes
1167: #  say so rather than implying the gate covers it.
1168: #  The instruction sits at CODE+4, so ARM's PC reads CODE+12 and rd = CODE+8.
1169: cpsr, rd = run_flags(SUBS_PC_4, 0, 0, 1)
1170: row("subs rn=pc rd", "PIN", rd, CODE + 8)
1171: row("subs rn=pc C", "PIN", cflag(cpsr), 1)
1172: 
1173: #  CMP writes no rd, so only its flags are meaningful. Full NZCV, because CMP
1174: #  exists only for its flags and a carry-only check would miss a clobbered Z.
1175: for nm, a, b, wnzcv in [("cmp eq", 5, 5, 0x6),        # Z=1 C=1
1176:                         ("cmp lt", 3, 5, 0x8),        # N=1
1177:                         ("cmp gt", 5, 3, 0x2)]:       # C=1
1178:     cpsr, rd = run_flags(CMPS, a, b, 1)
1179:     row(nm + " NZCV", "PIN", nzcv(cpsr), wnzcv)
1180: 
1181: #  ---- PIN: the ADD side of the same #if, which must stay on c32 != c64 ----
1182: for nm, iw, a, b, cin, wc in [
1183:         ("adds carry-out", ADDS, 0xffffffff, 1, 1, 1),
1184:         ("adds no-carry",  ADDS, 1, 1, 1, 0),
1185:         ("adcs carry-out", ADCS, 0xffffffff, 0, 1, 1),
1186:         ("adcs no-carry",  ADCS, 1, 1, 0, 0)]:
1187:     cpsr, rd = run_flags(iw, a, b, cin)
1188:     row(nm + " C", "PIN", cflag(cpsr), wc)
1189: 
1190: #  ---- DISC: #313, ADC is the one opcode with no V formula -----------------
1191: #  ADC appears in the OUTER #if that clears and recomputes V, but matches
1192: #  neither inner arm (ADD||CMN, nor SUB||RSB||CMP||RSC||SBC), so `v` stays 0
1193: #  and ADCS could only ever CLEAR V. Found by a panel seat reading the #if
1194: #  nesting, then reproduced here. The paired ADDS rows are what make these
1195: #  rows a statement about ADC specifically rather than about V in general:
1196: #  the identical overflow through ADDS was already correct.
1197: for nm, iw, a, b, cin, wv, kind in [
1198:         ("adcs V pos-ovf",  ADCS, 0x7fffffff, 0, 1, 1, "DISC"),
1199:         ("adcs V pos-ovf2", ADCS, 0x7ffffffe, 1, 1, 1, "DISC"),
1200:         ("adcs V neg-ovf",  ADCS, 0x80000000, 0xffffffff, 0, 1, "DISC"),
1201:         ("adcs V none",     ADCS, 1, 1, 1, 0, "PIN"),
1202:         ("adds V pos-ovf",  ADDS, 0x7fffffff, 1, 1, 1, "PIN"),
1203:         ("adds V none",     ADDS, 1, 1, 1, 0, "PIN"),
1204:         ("sbcs V ovf",      SBCS, 0x80000000, 1, 0, 1, "PIN")]:
1205:     cpsr, rd = run_flags(iw, a, b, cin)
1206:     row(nm, kind, None if cpsr is None else (cpsr >> 28) & 1, wv)
1207: 
1208: #  ---- DISC: permanently-undefined routing ---------------------------------
1209: #  Committed: the emulator STOPS, so every witness keeps its sentinel. The
1210: #  marker proves the handler ran; the mode and lr prove it was reached as an
1211: #  exception and not merely branched to.
1212: for nm, iw, at in [("udf", UDF, CODE),
1213:                    ("udf gdb-form", UDF_GDB, CODE),
1214:                    ("udf page-end", UDF, PAGE_END)]:
1215:     mode, lr, marker = run_und(iw, at)
1216:     row(nm + " handler ran", "DISC", marker, 0x0000005a)
1217:     row(nm + " UND32 mode", "DISC",
1218:         None if mode is None else mode & 0x1f, ARM_MODE_UND32)
1219:     row(nm + " lr=pc+4", "DISC", lr, at + 4)
1220: 
1221: #  A conditional UDF whose condition FAILS. The committed build fails this
1222: #  because `goto bad` runs at DECODE time -- the guest never had to execute the
1223: #  instruction for the emulator to stop, which is the strongest statement of
1224: #  reachability in this table.
1225: #
1226: #  The two halves are ONE row on purpose. Asserting "the handler did not run"
1227: #  separately would pass on the committed build for the wrong reason: nothing
1228: #  ran at all there, so the sentinel survives and a dead emulator scores a
1229: #  point. Only the conjunction -- execution continued AND no exception was
1230: #  raised -- distinguishes correct silence from a stopped machine.
1231: fall, handler = run_und_condfailed(UDF_EQ)
1232: row("udf cond-failed nop", "DISC",
1233:     "ran=0x%08x handler=0x%08x" % (fall, handler)
1234:     if fall is not None else "dead",
1235:     "ran=0x0000005a handler=0xdeadbeef")
1236: 
1237: for name, pre, iw, want, cin, rf in R78:
1238:     got = run78(pre, iw, cin, rf)
1239:     row(name, "PIN" if name in ("uxtab ROR 0", "rot0 movs C", "mvn S-clear",
1240:                                 "rot0 pc src C", "rotc pc gt255",
1241:                                 "rotc bound 256") else "DISC", got, want)
1242: 
1243: 
1244: #  ---------------------------------------------------------------------------
1245: #  #328: THUMB. Everything above drives ARM-mode encodings; the Thumb
1246: #  interpreter is a completely separate implementation (cpu_arm.c,
1247: #  arm_cpu_interpret_thumb_SLOW) and #311 never touched it.
1248: #
1249: #  Thumb is entered ARCHITECTURALLY: an ARM `bx` to an ODD address sets
1250: #  ARM_FLAG_T and leaves the low bit in pc, and cpu_dyntrans.c dispatches to
1251: #  the interpreter on the T bit.
1252: #
1253: #  An earlier draft of this comment gave the wrong reason for that choice,
1254: #  claiming a debugger `cpsr=` write "would preset nothing" the way it does for
1255: #  the NZCV carry-in above. That is FALSE and was corrected by a review seat:
1256: #  cpu_dyntrans.c reads `cpu->cd.arm.cpsr & ARM_FLAG_T` directly, so a debugger
1257: #  write does set T. The mirror problem is real but applies only to NZCV. The
1258: #  actual reason to use `bx` is that the interpreter demands BOTH conditions --
1259: #  `if (!(cpu->pc & 1) || !(cpsr & ARM_FLAG_T))` -- so setting T alone lands on
1260: #  an even pc and refuses to run, and `bx` is the one operation that
1261: #  establishes both together, exactly as a guest would.
1262: #
1263: #  `mrs` is ARM-only in Thumb-1, so each row returns to ARM with a second `bx`
1264: #  before publishing; `bx` does not touch the flags, so the round trip is
1265: #  transparent to what is being measured.
1266: #
1267: #  Four near-identical blocks each computed `old + b` in 64 bits -- with b
1268: #  NEGATED first on the subtract arms -- and read every flag off that value.
1269: #  Three of the four flags were wrong:
1270: #    Z  from `result == 0` -- a subtract of equal NONZERO operands carries out
1271: #       of bit 31, so Z stayed CLEAR while rd was 0, and `subs; bne` never
1272: #       terminated. (0 - 0 was the one subtract that happened to work: nothing
1273: #       carries out of it, so Z was set -- though C was still wrong there.) The
1274: #       same line also missed Z for an ADD that wrapped to zero.
1275: #    C  from bit 32 -- with b == 0 the addend is (uint32_t)(-0) == 0, nothing
1276: #       carries out, so `cmp r0,#0` reported a borrow that never happened.
1277: #    V  from the sign of the NEGATED subtrahend, which breaks at exactly
1278: #       0x80000000 because that value is its own negation. Wrong in BOTH
1279: #       directions, and x - x claimed overflow.
1280: #  N was always right -- it cast to int32_t first, which is the shape the rest
1281: #  should have had.
1282: #
1283: #  Every row publishes rd as well as the flags: these are FLAG defects, the
1284: #  value was already correct, and a row checking only the flag could not tell a
1285: #  fixed flag from a broken result.
1286: THUMB_AT = 0x8100
1287: THUMB_RET = 0x8200
1288: BX_R6 = 0xE12FFF16              # arm:   bx r6
1289: SUBS_R8_R8_R9 = 0xE0588009      # arm:   subs r8,r8,r9  (the carry preset)
1290: T_BX_R7 = 0x4738                # thumb: bx r7
1291: 
1292: 
1293: def t_reg(op, rd, rs, rn):      # ADDS/SUBS rd,rs,rn  (format 2)
1294:     return op | ((rn & 7) << 6) | ((rs & 7) << 3) | (rd & 7)
1295: 
1296: 
1297: def t_imm8(op, rd, imm):        # CMP/SUBS rd,#imm8   (format 3)
1298:     return op | ((rd & 7) << 8) | (imm & 0xff)
1299: 
1300: 
1301: def t_reg3(op, rd, rs, imm3):   # ADDS/SUBS rd,rs,#imm3 (format 2, I set)
1302:     return op | ((imm3 & 7) << 6) | ((rs & 7) << 3) | (rd & 7)
1303: 
1304: 
1305: def t_cmp_reg(rd, rs):          # CMP rd,rs           (format 4, op 1010)
1306:     return 0x4280 | ((rs & 7) << 3) | (rd & 7)
1307: 
1308: 
1309: def run_thumb(tiw, r0=0, r1=0, r2=0, r3=0, cin=None, pub=0):
1310:     """One Thumb instruction, entered by bx; returns (cpsr, published reg).
1311: 
1312:     `cin` presets the CARRY, and it is not optional decoration. Without it the
1313:     machine starts with C clear, which makes two whole contracts unmeasurable:
1314:     "LSR #0 must CLEAR C for a positive operand" and "LSL #0 must LEAVE C
1315:     alone" both pass vacuously against C=0. The preset is the same real SUBS
1316:     gate 14 uses in ARM mode -- never a debugger cpsr write, which reaches
1317:     cpsr but not the `flags` field the handlers read -- and it runs BEFORE the
1318:     `bx`, which is safe because `bx` touches no flags.
1319: 
1320:     `pub` selects which register is published. Every row used to write and read
1321:     r0, so a handler that read r0 instead of rd would have been invisible;
1322:     that is the shadow of the very defect #329 fixes in the ASR block, where
1323:     the flags came from a register chosen by the shift amount.
1324:     """
1325:     pre = []
1326:     lead = 0
1327:     if cin is not None:
1328:         #  r8/r9 as the SUBS operands so r0-r3 stay free for the row.
1329:         a, b = (1, 0) if cin else (0, 1)     # 1-0 => no borrow => C=1
1330:         pre = ["r8=0x%x" % a, "r9=0x%x" % b,
1331:                "put w 0x%x, 0x%08x" % (CODE, SUBS_R8_R8_R9)]
1332:         lead = 1
1333:     str_pub = STR_R0_R5 if pub == 0 else (STR_R0_R5 | (pub << 12))
1334:     w, _ = session(pre + [
1335:         "r0=0x%x" % r0, "r1=0x%x" % r1, "r2=0x%x" % r2, "r3=0x%x" % r3,
1336:         "r4=0x%x" % DEST, "r5=0x%x" % (DEST + 4),
1337:         "r6=0x%x" % (THUMB_AT | 1), "r7=0x%x" % THUMB_RET,
1338:         "put w 0x%x, 0xdeadbeef" % DEST,
1339:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
1340:         "put w 0x%x, 0x%08x" % (CODE + 4 * lead, BX_R6),
1341:         #  two Thumb halfwords per word, low halfword first
1342:         "put w 0x%x, 0x%08x" % (THUMB_AT, (T_BX_R7 << 16) | tiw),
1343:         "put w 0x%x, 0x%08x" % (THUMB_RET,     MRS_R3_CPSR),
1344:         "put w 0x%x, 0x%08x" % (THUMB_RET + 4, STR_R3_R4),
1345:         "put w 0x%x, 0x%08x" % (THUMB_RET + 8, str_pub),
1346:         "pc=0x%x" % CODE, "step %d" % (6 + lead)], 2)
1347:     if w is None:
1348:         return None, None
1349:     return sw(w[0]), sw(w[1])
1350: 
1351: 
1352: def thumb_nzcv(cpsr):
1353:     """Flags as a string. NOT named nzcv(): there is already an nzcv() above
1354:     that returns an int, and defining a second one here SHADOWED it. Nothing
1355:     broke only because this file executes top to bottom and the first one has
1356:     finished being used by the time this line runs -- which is a latent trap,
1357:     not a design. A review seat spotted it."""
1358:     if cpsr is None:
1359:         return None
1360:     return "N%d Z%d C%d V%d" % ((cpsr >> 31) & 1, (cpsr >> 30) & 1,
1361:                                 (cpsr >> 29) & 1, (cpsr >> 28) & 1)
1362: 
1363: 
1364: T_ADD, T_SUB = 0x1800, 0x1A00           # format 2, register operand
1365: T_ADD3, T_SUB3 = 0x1C00, 0x1E00         # format 2, imm3 operand (I bit set)
1366: T_CMPI, T_SUBI, T_ADDI = 0x2800, 0x3800, 0x3000     # format 3, imm8
1367: 
1368: #  name, word, r0, r1, r2, want rd, want NZCV, class
1369: THUMB_ROWS = [
1370:     #  controls -- if these fail the rig never reached Thumb and no other
1371:     #  Thumb row here may be believed. The borrow control is the one that
1372:     #  proves the rig can still tell a REAL borrow from the broken ones.
1373:     ("T ctrl ADDS 2+3",    t_reg(T_ADD, 0, 1, 2), 0, 2, 3, 5,
1374:      "N0 Z0 C0 V0", "PIN"),
1375:     ("T ctrl SUBS 5-3",    t_reg(T_SUB, 0, 1, 2), 0, 5, 3, 2,
1376:      "N0 Z0 C1 V0", "PIN"),
1377:     ("T ctrl SUBS borrow", t_reg(T_SUB, 0, 1, 2), 0, 3, 5, 0xfffffffe,
1378:      "N1 Z0 C0 V0", "PIN"),
1379: 
1380:     #  Z, all four blocks, plus the ADD that wraps to zero.
1381:     ("T Z subs equal",     t_reg(T_SUB, 0, 1, 2), 0, 5, 5, 0,
1382:      "N0 Z1 C1 V0", "DISC"),
1383:     ("T Z cmp imm equal",  t_imm8(T_CMPI, 0, 5),  5, 0, 0, 5,
1384:      "N0 Z1 C1 V0", "DISC"),
1385:     ("T Z subs imm equal", t_imm8(T_SUBI, 0, 5),  5, 0, 0, 0,
1386:      "N0 Z1 C1 V0", "DISC"),
1387:     ("T Z cmp reg equal",  t_cmp_reg(0, 1),       5, 5, 0, 5,
1388:      "N0 Z1 C1 V0", "DISC"),
1389:     ("T Z adds wrap",      t_reg(T_ADD, 0, 1, 2), 0, 1, 0xffffffff, 0,
1390:      "N0 Z1 C1 V0", "DISC"),
1391: 
1392:     #  C, all four blocks: a subtraction of ZERO does not borrow.
1393:     ("T C subs zero",      t_reg(T_SUB, 0, 1, 2), 0, 5, 0, 5,
1394:      "N0 Z0 C1 V0", "DISC"),
1395:     ("T C cmp imm 0",      t_imm8(T_CMPI, 0, 0),  5, 0, 0, 5,
1396:      "N0 Z0 C1 V0", "DISC"),
1397:     ("T C subs imm 0",     t_imm8(T_SUBI, 0, 0),  5, 0, 0, 5,
1398:      "N0 Z0 C1 V0", "DISC"),
1399:     ("T C cmp reg zero",   t_cmp_reg(0, 1),       5, 0, 0, 5,
1400:      "N0 Z0 C1 V0", "DISC"),
1401: 
1402:     #  V at the one subtrahend where negation cannot work. The middle row is
1403:     #  the one that proves the defect ran in BOTH directions, and the third
1404:     #  shows Z and V failing together on the same instruction.
1405:     ("T V 0-INT_MIN",      t_cmp_reg(0, 1), 0, 0x80000000, 0, 0,
1406:      "N1 Z0 C0 V1", "DISC"),
1407:     ("T V -1-INT_MIN",     t_cmp_reg(0, 1), 0xffffffff, 0x80000000, 0,
1408:      0xffffffff, "N0 Z0 C1 V0", "DISC"),
1409:     ("T V INT_MIN-same",   t_cmp_reg(0, 1), 0x80000000, 0x80000000, 0,
1410:      0x80000000, "N0 Z1 C1 V0", "DISC"),
1411: 
1412:     #  rd == rm, the aliasing case: the subtrahend must be captured BEFORE the
1413:     #  result is stored, because `subs r0,r1,r0` overwrites it.
1414:     #
1415:     #  Read the operands here carefully, because the FIRST version of this row
1416:     #  used 5 - 5 and a review seat showed it proved nothing about aliasing:
1417:     #  for result = a - b, `a >= result` and `a >= b` have the SAME truth value
1418:     #  at every operand, so no choice of values can catch a late re-read used
1419:     #  by the CARRY formula. 0 - 1 is used instead because it catches a late
1420:     #  re-read used by the OVERFLOW formula: with b captured (1) V is 0, while
1421:     #  with b re-read after the store (0xffffffff) V comes out 1.
1422:     ("T alias subs rd==rm", t_reg(T_SUB, 0, 1, 0), 1, 0, 0, 0xffffffff,
1423:      "N1 Z0 C0 V0", "DISC"),
1424: 
1425:     #  The IMMEDIATE arms. Without these the `isImm3` operand selection and the
1426:     #  ADD-side `isSub` polarity are unpinned: a regression that read the
1427:     #  register instead of the imm3 field, or inverted isSub only where it
1428:     #  shows on an ADD, would pass every row above. A review seat found the
1429:     #  hole after the fix was already green.
1430:     ("T Z adds imm8 wrap", t_imm8(T_ADDI, 0, 1), 0xffffffff, 0, 0, 0,
1431:      "N0 Z1 C1 V0", "DISC"),
1432:     ("T Z adds imm3 wrap", t_reg3(T_ADD3, 0, 1, 1), 0, 0xffffffff, 0, 0,
1433:      "N0 Z1 C1 V0", "DISC"),
1434:     ("T C subs imm3 zero", t_reg3(T_SUB3, 0, 1, 0), 0, 5, 0, 5,
1435:      "N0 Z0 C1 V0", "DISC"),
1436: 
1437:     #  Four more the after-pass asked for, each closing a way a wrong
1438:     #  implementation could still have passed everything above:
1439:     #    - the V rows were all register CMP, so a SUBS with the same operand
1440:     #      pins the OTHER register form,
1441:     #    - no ADD row wanted V=1, so an add that always cleared V passed,
1442:     #    - 0 - 0 is the one subtract that sets Z on the OLD code (nothing
1443:     #      carries out), which makes it the case where C alone discriminates.
1444:     ("T V subs INT_MIN",   t_reg(T_SUB, 0, 1, 2), 0, 0, 0x80000000,
1445:      0x80000000, "N1 Z0 C0 V1", "DISC"),
1446:     ("T V adds overflow",  t_reg(T_ADD, 0, 1, 2), 0, 0x7fffffff, 1,
1447:      0x80000000, "N1 Z0 C0 V1", "PIN"),
1448:     ("T C subs 0-0",       t_reg(T_SUB, 0, 1, 2), 0, 0, 0, 0,
1449:      "N0 Z1 C1 V0", "DISC"),
1450:     ("T V adds INT_MIN x2", t_reg(T_ADD, 0, 1, 2), 0, 0x80000000, 0x80000000,
1451:      0, "N0 Z1 C1 V1", "DISC"),
1452: ]
1453: 
1454: for nm, tiw, a0, a1, a2, want_rd, want_f, cls in THUMB_ROWS:
1455:     cpsr, rd = run_thumb(tiw, a0, a1, a2)
1456:     row(nm, cls, thumb_nzcv(cpsr), want_f)
1457:     row(nm + " rd", cls, rd, want_rd)
1458: 
1459: 
1460: #  ---------------------------------------------------------------------------
1461: #  #329: the THUMB SHIFT paths. Three more flag defects in the same function
1462: #  #328 fixed, found by that round's completeness sweep.
1463: #
1464: #    1. ASR-immediate read Z and N from r[rd8] while writing r[rd]. In the
1465: #       shift-immediate format (000 op imm5 Rs Rd) rd8 is bits 10:8 -- the top
1466: #       three bits of imm5 -- so `asrs r0,r1,#12` took its flags from r3, a
1467: #       register the instruction does not name. LSL and LSR never had this.
1468: #       NOTE the witness needs imm5 >= 4: below that rd8 is 0, which for a row
1469: #       writing r0 is accidentally the right register.
1470: #    2. RORS ORed Z and N in without clearing first, so a stale Z survived a
1471: #       nonzero rotate and a stale N survived a positive one.
1472: #    3. LSR #0 and ASR #0 encode SHIFT BY 32, not shift by zero: LSR gives 0,
1473: #       ASR gives a sign fill, and both write C from bit 31 of the operand.
1474: #       They executed as no-ops with C untouched. LSL #0 IS a real no-op and
1475: #       must stay one -- it is the control.
1476: #
1477: #  Half of contract 3 was unmeasurable until this round gave run_thumb a carry
1478: #  preset: with C starting clear, "LSR #0 CLEARS C for a positive operand" and
1479: #  "LSL #0 LEAVES C alone" both pass against a build that never touches C. The
1480: #  rows below preset C=1 precisely so those two can fail.
1481: T_LSL_I, T_LSR_I, T_ASR_I = 0x0000, 0x0800, 0x1000
1482: 
1483: 
1484: def t_shift(op, rd, rs, imm5):
1485:     return op | ((imm5 & 31) << 6) | ((rs & 7) << 3) | (rd & 7)
1486: 
1487: 
1488: def t_ror(rd, rs):
1489:     return 0x41C0 | ((rs & 7) << 3) | (rd & 7)
1490: 
1491: 
1492: #  name, word, r0, r1, r2, r3, carry-in, publish, want reg, want NZCV, class
1493: SHIFT_ROWS = [
1494:     #  LSL #0 is the control in both directions: value through, C preserved.
1495:     ("T LSL #0 keeps C1", t_shift(T_LSL_I, 0, 1, 0), 0, 0x80000000, 0, 0,
1496:      1, 0, 0x80000000, "N1 Z0 C1 V0", "PIN"),
1497:     ("T LSL #0 keeps C0", t_shift(T_LSL_I, 0, 1, 0), 0, 0x80000000, 0, 0,
1498:      0, 0, 0x80000000, "N1 Z0 C0 V0", "PIN"),
1499: 
1500:     #  1. flags from the result, not from a register named by the shift count.
1501:     ("T ASR #12 flags reg", t_shift(T_ASR_I, 0, 1, 12), 0, 0x80000000, 0, 0,
1502:      0, 0, 0xfff80000, "N1 Z0 C0 V0", "DISC"),
1503: 
1504:     #  2. RORS must clear both. Z stale after an equal compare, N stale after
1505:     #     a negative one -- the rotate results are nonzero and positive.
1506:     ("T RORS clears Z", t_ror(0, 1), 0x12345678, 4, 0, 0,
1507:      1, 0, 0x81234567, "N1 Z0 C1 V0", "DISC"),
1508:     ("T RORS clears N", t_ror(0, 1), 0x00000010, 4, 0, 0,
1509:      1, 0, 0x00000001, "N0 Z0 C0 V0", "DISC"),
1510: 
1511:     #  3. shift-by-32, both operand signs. The POSITIVE rows are the ones the
1512:     #     carry preset made possible: C must be driven to 0, not left at 1.
1513:     ("T LSR #0 neg", t_shift(T_LSR_I, 0, 1, 0), 0, 0x80000000, 0, 0,
1514:      0, 0, 0x00000000, "N0 Z1 C1 V0", "DISC"),
1515:     ("T LSR #0 pos", t_shift(T_LSR_I, 0, 1, 0), 0, 0x7fffffff, 0, 0,
1516:      1, 0, 0x00000000, "N0 Z1 C0 V0", "DISC"),
1517:     ("T ASR #0 neg", t_shift(T_ASR_I, 0, 1, 0), 0, 0x80000000, 0, 0,
1518:      0, 0, 0xffffffff, "N1 Z0 C1 V0", "DISC"),
1519:     ("T ASR #0 pos", t_shift(T_ASR_I, 0, 1, 0), 0, 0x7fffffff, 0, 0,
1520:      1, 0, 0x00000000, "N0 Z1 C0 V0", "DISC"),
1521: 
1522:     #  A row whose destination is NOT r0, published from r1. Every other row
1523:     #  here writes and reads r0, so a handler reading r0 instead of rd would
1524:     #  be invisible -- which is the shadow of defect 1 itself.
1525:     ("T LSR rd!=0", t_shift(T_LSR_I, 1, 2, 4), 0xdeadbeef, 0, 0x80000000, 0,
1526:      0, 1, 0x08000000, "N0 Z0 C0 V0", "DISC"),
1527: ]
1528: 
1529: for nm, tiw, a0, a1, a2, a3, cin, pub, want_r, want_f, cls in SHIFT_ROWS:
1530:     cpsr, rv = run_thumb(tiw, a0, a1, a2, a3, cin=cin, pub=pub)
1531:     row(nm, cls, thumb_nzcv(cpsr), want_f)
1532:     row(nm + " rd", cls, rv, want_r)
1533: 
1534: 
1535: #  #340: the instruction COMBINER changes observable flags.
1536: #
1537: #  A data-processing immediate with S set updates C from the shifter carry-out;
1538: #  this tree approximates that as "encoded immediate > 255 means it was rotated,
1539: #  so C := its bit 31" (cpu_arm_instr_dpi.c:121-140). The standalone teqs/tsts
1540: #  do it. The *_samepage handlers that a teq/tst-followed-by-branch folds into
1541: #  do not touch C at all, and the teqs combiner has NO operand guard while the
1542: #  tsts one guards only bit 31 -- which is about N (with the top bit clear,
1543: #  a & b cannot be negative), not about C.
1544: #
1545: #  0x0000FF00 is `0xFF ror 24`: rotated, > 255, bit 31 CLEAR, so the owed answer
1546: #  is C := 0. C is preset to 1 so "did nothing" is distinguishable from
1547: #  "cleared correctly".
1548: #
1549: #  The STANDALONE rows are the control and are what attributes a difference to
1550: #  the COMBINER rather than to the instruction: identical encoding, identical
1551: #  operands, no following branch, and they must read C0 on both builds.
1552: TEQ_ROT = teq_imm(12, 0xFF)     # teq r1, #0x0000FF00
1553: TST_ROT = tst_imm(12, 0xFF)     # tst r1, #0x0000FF00
1554: 
1555: COMBINE_ROWS = [
1556:     ("A teq rot C combined", run_combined(TEQ_ROT, 0x00000001, 1), 0, "DISC"),
1557:     ("A tst rot C combined", run_combined(TST_ROT, 0x0000FF00, 1), 0, "DISC"),
1558:     ("A teq rot C standalone", run_flags(TEQ_ROT, 0x00000001, 0, 1)[0], 0,
1559:      "PIN"),
1560:     ("A tst rot C standalone", run_flags(TST_ROT, 0x0000FF00, 0, 1)[0], 0,
1561:      "PIN"),
1562:     #  unrotated (<= 255): C is PRESERVED by the ISA on both paths. Catches a
1563:     #  fix that starts clobbering C where it must be left alone.
1564:     ("A teq flat C preserved", run_combined(teq_imm(0, 0x01), 0x00000010, 1),
1565:      1, "PIN"),
1566: ]
1567: for nm, cpsr, want_c, cls in COMBINE_ROWS:
1568:     row(nm, cls, "C%d" % cflag(cpsr) if cpsr is not None else "dead",
1569:         "C%d" % want_c)
1570: 
1571: #  #342: the XOR-swap fold had no a != b guard.
1572: #
1573: #  DISC: three  each ZERO r0; X(xchg) exchanges r0 with itself and
1574: #  leaves it alone. 0x5a is the row own proof that the fold happened, since no
1575: #  standalone EOR triplet can leave a nonzero value.
1576: #
1577: #  PIN: the distinct-register swap, in the shape the matcher actually accepts
1578: #  (Rm == Rd). It exercises the FOLDED handler on pass 2 and pins that the swap
1579: #  it performs is correct -- so a broken X(xchg) fails here -- but it cannot by
1580: #  itself distinguish folded-and-correct from not-folded-and-correct, which is
1581: #  exactly why it is a PIN and not a second discriminator.
1582: XCHG_ROWS = []
1583: _d = run_xchg(True)
1584: XCHG_ROWS.append(("A xchg same-reg zeroes", _d[0] if _d else None,
1585:                   0x00000000, "DISC"))
1586: XCHG_ROWS.append(("A xchg same-reg r1 pin", _d[1] if _d else None,
1587:                   0x000000a5, "PIN"))
1588: _s = run_xchg(False)
1589: XCHG_ROWS.append(("A xchg swap r0", _s[0] if _s else None, 0x000000a5, "PIN"))
1590: XCHG_ROWS.append(("A xchg swap r1", _s[1] if _s else None, 0x0000005a, "PIN"))
1591: for nm, got, want, cls in XCHG_ROWS:
1592:     row(nm, cls, "%08x" % got if got is not None else "dead", "%08x" % want)
1593: 
1594: #  #345: the cache-clean fold clobbered r0/r1 for a loop that used neither.
1595: #  #346: and it fired on any post-index immediate, so a 4-byte stride advanced
1596: #  the base by 32. #348 made the fold write the loop's exit flags; #349 gave
1597: #  it a DEBUG-gated fold-fired marker; #350 made a non-multiple counter fall
1598: #  back to the real loop instead of terminating a loop that architecturally
1599: #  never exits. See run_cacheclean / run_cc_nonmult for what each variant
1600: #  isolates. "still folds" (stale r2) remains a fold detector independent of
1601: #  the marker, because the skipped load is deliberately unfixed.
1602: _cc, _ = run_cacheclean("wrongregs")
1603: _cg, _ = run_cacheclean("genuine")
1604: _ci, _ = run_cacheclean("imm4")
1605: _cd, _ = run_cacheclean("wrongdest")
1606: #  The #348 rows ride the 0x40 counter -- at 0x20 a fix that skipped the r1
1607: #  preload would be invisible (see the docstring). The quiet row shares the
1608: #  default-verbosity session: the marker must be absent from a plain run.
1609: #  NB debugmsg's verbosity gate is bypassed under single_step, so the quiet
1610: #  rows are valid only for breakpoint+continue sessions like these -- do not
1611: #  rewrite them to drive the loop with `step`.
1612: _cf, _cfbuf = run_cacheclean("genuine40", seed=CMP_R9_HI)
1613: _, _cvbuf = run_cacheclean("genuine40", seed=CMP_R9_HI, verbose=True)
