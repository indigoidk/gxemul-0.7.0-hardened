 401:     #  ---- #378 rows: WARM discriminates, COLD is the already-correct control.
 402:     ("378 be stm warm", "barearm", stm_prog(MOV_R3_WARM), SEED_WARM_W, [
 403:         ("be stm warm b0", "r4", 0x11, 0x44, "DISC"),
 404:         ("be stm warm b1", "r5", 0x22, 0x33, "DISC"),
 405:         ("be stm warm b2", "r6", 0x33, 0x22, "DISC"),
 406:         ("be stm warm b3", "r7", 0x44, 0x11, "DISC"),
 407:         ("be stm warm b4", "r8", 0x55, 0x88, "DISC"),
