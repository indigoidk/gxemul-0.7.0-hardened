 206:     if not wait_from(0, 60):
 207:         kill()
 208:         return None, None, buf
 209:     send("put w 0x%x, 0x0" % MEM)
 210:     send("put w 0x%x, 0xdeadbeef" % DEST)
 211:     send("put w 0x%x, 0xdeadbeef" % (DEST + 4))
 212:     if verbose:
 213:         send("verbosity cpu 3")
 214:         send("verbosity cpu")
