 232:     flat = []
 233:     for _ in range(3):
 234:         mark = len(buf)
 235:         send("dump 0x%x 0x%x" % (DEST, DEST + 8))
 236:         words = re.findall(r"0x0*[0-9a-f]+\s+((?:[0-9a-f]{8}\s+){1,4})",
 237:                            buf[mark:])
 238:         flat = "".join(words).split()
 239:         if len(flat) >= 2:
 240:             break
 241:         time.sleep(1.0)
 242:         rd(1.0)
 243:     mark = len(buf)
 244:     send("reg")
 245:     regtxt = buf[mark:]
 246:     os.write(fd, b"quit\n")
 247:     time.sleep(0.2)
 248:     kill()
 249:     return flat, regtxt, buf
