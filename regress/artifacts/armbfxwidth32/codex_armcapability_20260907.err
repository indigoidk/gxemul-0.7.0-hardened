 119: def session(prog, extra, verbose=False, grace=2.0):
 120:     """One read-ahead-ON run; return (dumpwords, regtext, transcript)."""
 121:     with open(STUB, "wb") as f:
 122:         for w in prog:
 123:             f.write(w.to_bytes(4, "little"))
 124:     pid, fd = pty.fork()
 125:     if pid == 0:
 126:         os.execvp(BIN, [BIN, "-V", "-A"] + extra +
 127:                   ["-E", "testarm", "-M", "64", "0x%x:%s" % (CODE, STUB)])
 128:         os._exit(127)
 129:     buf = ""
 130: 
 131:     def rd(t=0.4):
 132:         nonlocal buf
 133:         r, _, _ = select.select([fd], [], [], t)
 134:         if fd not in r:
 135:             return True
 136:         try:
 137:             d = os.read(fd, 65536)
 138:         except OSError:
 139:             return False
 140:         if not d:
 141:             return False
 142:         buf += d.decode("latin1", "replace")
 143:         return True
 144: 
 145:     def kill():
 146:         try:
 147:             os.kill(pid, 9)
 148:             os.waitpid(pid, 0)
 149:         except Exception:
 150:             pass
 151: 
 152:     #  Wait for a prompt AFTER a given buffer mark -- never the whole buffer.
 153:     #  A stale prompt already in `buf` must not satisfy a later wait (Codex's
 154:     #  round-100 finding); the round-99 nonmult witness learned the same.
 155:     #
 156:     #  #363: the suffix is the FULL prompt, not a bare '>'. This was the
 157:     #  gate-14 flake. `debug()` reaches va_debug(), which emits ONE printf per
 158:     #  CHARACTER, so on a pty (_IOLBF, and these probes exec the binary
 159:     #  directly rather than through lib.sh's stdbuf) the only flush boundary is
 160:     #  the newline: the ARM register dump arrives as FIVE separate write(2)s.
 161:     #  Its FIRST line ends in '>' unconditionally -- cpu_arm.c prints
 162:     #  "  <%s>" with " no symbol " as the fallback, and testarm never calls
 163:     #  machine_add_devices_as_symbols(). So a reader waking between line 1 and
 164:     #  line 2 saw a bare '>' and returned with the registers still unread,
 165:     #  while cpsr -- which sits ON line 1 -- was already present. That is why
 166:     #  `A idle path dest` failed alone while `A idle path flags` passed, giving
 167:     #  the 2-red-check signature the flake always showed.
 168:     #
 169:     #  Measured, not argued. Replacing os.read(fd, 65536) with os.read(fd, 1)
 170:     #  evaluates the predicate at every byte boundary and makes the truncation
 171:     #  CERTAIN rather than a scheduler race: with a bare '>' the probe scored
 172:     #  8/9 with `A idle path dest` reading None, and with the full prompt it
 173:     #  scored 9/9 -- the same run confirming the mechanism and validating the
 174:     #  fix. The committed 64 KB reader scores 9/9 either way, which is exactly
 175:     #  why the defect was intermittent rather than visible.
 176:     #
 177:     #  Matching the full prompt is also SUFFICIENT rather than merely safer:
 178:     #  the prompt is written AFTER all five lines and a pty preserves order, so
 179:     #  seeing the real prompt guarantees the whole dump has arrived. And it
 180:     #  pre-emptively disarms two latent '>' sources that are unarmed only by
 181:     #  current probe choices -- cpu_arm.c's load/store disassembly emits an
 182:     #  UNGUARDED "<0x%08x...>" whenever a breakpoint or trace hits one (both
 183:     #  DISASSEMBLE call sites pass running=1; today every breakpoint here lands
 184:     #  on a NOP), and `dump`'s ASCII column ends a line with its last byte,
 185:     #  which would end in '>' for a seed byte of 0x3e.
 186:     #
 187:     #  Do NOT "fix" the missing stdbuf -o0: per-character printf under -o0
 188:     #  would make every byte its own write and multiply these boundaries.
 189:     def wait_from(mark, timeout=30):
 190:         t = time.time()
 191:         while time.time() - t < timeout:
 192:             if not rd():
 193:                 return False
 194:             if len(buf) > mark and buf[mark:].rstrip().endswith("GXemul>"):
 195:                 return True
 196:         return False
 197: 
 198:     def send(s):
 199:         mark = len(buf)
 200:         b = (s + "\n").encode("latin1")
 201:         n = 0
 202:         while n < len(b):
 203:             n += os.write(fd, b[n:])
 204:         return wait_from(mark)
