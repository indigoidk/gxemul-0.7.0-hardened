 720:           % (name + " path", "PATH", "unread" if seen is None else seen, exp,
 721:              "ok" if lsok else "FAIL"))
 722: 
 723: print("WRITEBACK_CONTROL=%s" % control)
 724: print("WRITEBACK_RESULT=%d/%d" % (ngot, len(ROWS)))
 725: print("LSGEN_RESULT=%d/%d" % (lsgot, lswant))
