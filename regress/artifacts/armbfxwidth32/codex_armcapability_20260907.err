 204: def swp_prog():
 205:     return BUILD_R1_5567 + [MOV_R0_COLD, SWP_R2_R1_R0] + list(LDRB) + [SPIN]
 206: 
 207: 
 208: def swpb_prog():
 209:     return BUILD_R1_5567 + [MOV_R0_COLD, SWPB_R2_R1_R0, LDRB[0]] + [SPIN]
