72:/*
73: *  General load/store, by using memory_rw(). If at all possible, memory_rw()
74: *  then inserts the page into the translation array, so that the fast
75: *  load/store routine below can be used for further accesses.
76: */
77:void A__NAME__general(struct cpu *cpu, struct arm_instr_call *ic)
78:{
79:	/*
80:	 *  #367: count ENTRIES, before any work, so an exception-driven early
81:	 *  exit still counts -- an exception is still a general-path event.
82:	 *  Read via `tlbdump`; see the declaration in cpu_arm.h for why this is
