w31          0x9abcdef      0x9abcdef      UBFX #0,#31 -- UB (1<<31 overflows int) but wraps to the right mask; must STAY right ok
s mid        0xffffffde     0xffffffde     SBFX #4,#8 of 0x89abcdef: field 0xde, top bit set, so sign-extended ok
s w32        0x89abcdef     0x89abcdef     SBFX #0,#32: the whole register.  Does NOT pin topBitMask -- see the header ok
