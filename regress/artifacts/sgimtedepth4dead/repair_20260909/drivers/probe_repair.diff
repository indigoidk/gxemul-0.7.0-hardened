> def fill_at(A, tlbreg, dstsel):
>     """`fill()' at a NON-DEFAULT destination TLB label.  Added 2026-09-09.
> 
>     Byte for byte the same instruction sequence as fill(depth=MODE_D32), with two constants
>     changed: the tile goes into re_tlb_b[0] or re_tlb_c[0] instead of re_tlb_a[0], and the
>     mode word carries MTE_MODE_DST_BUF so do_mte_transfer()'s `dst_tlb' is 1 or 2, not 0.
> 
>     The oracle address is UNCHANGED, because the tile value is the same.  So `fill top',
>     `fill b top' and `fill c top' read the same byte of the same address after the same
>     transfer, and differ in exactly one variable -- which is what makes them a closure of
>     the label axis rather than three unrelated rows."""
>     c  = store(A, tlbreg, TLBA_TILE << 48, op=OP_SD_T0_A3)
>     c += store(A, DEST, PAINT)                     # pre-paint: a silent no-op reports 0x99
>     c += store(A, MTE_MODE, MODE_D32 | dstsel)
>     c += store(A, MTE_BG,   BG_VAL)
>     c += store(A, MTE_DST0, DST0)
>     c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
>     return c
> 
