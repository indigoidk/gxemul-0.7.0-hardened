  442: #endif /* CRMFBREG_H */

 succeeded in 200ms:
  660: 				    (long long)relative_addr);
  661: 			}
  662: 		}
  663: 	}
  664: 
  665: 	if (writeflag == MEM_READ)
  666: 		memory_writemax64(cpu, data, len, odata);
  667: 
  668: 	return 1;
  669: }
