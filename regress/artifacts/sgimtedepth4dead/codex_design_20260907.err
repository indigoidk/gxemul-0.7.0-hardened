  420: 
  421: /* status register */
  422: #define CRIME_DE_STATUS		0x4000
  423: #define CRIME_DE_IDLE		0x10000000
  424: #define CRIME_DE_SETUP_IDLE	0x08000000
  425: #define CRIME_DE_PIXPIPE_IDLE	0x04000000
  426: #define CRIME_DE_MTE_IDLE	0x02000000
