#define DE_ALPHA_OP_SRC_SHIFT 4
#define DE_ALPHA_OP_DST_SHIFT 0

/* status register */
#define CRIME_DE_STATUS		0x4000
#define CRIME_DE_IDLE		0x10000000
#define CRIME_DE_SETUP_IDLE	0x08000000
#define CRIME_DE_PIXPIPE_IDLE	0x04000000
