258: # ---------------------------------------------------------------- controls
259: A = Addr(CODE)
260: t, alive = session(store(A, SCRATCH, LIVE_VAL) + load(A, SCRATCH) + ["print v0"])
261: row("live", printed(t, "v0") if alive else "died", "0x%x" % LIVE_VAL,
262:     "LIVENESS: guest store then load, through RAM")
263: 
264: A = Addr(CODE)
265: t, alive = session(load(A, DE_STATUS) + ["print v0"])
266: row("devsig", printed(t, "v0") if alive else "died", DE_STAT,
267:     "DEVSIG: CRIME_DE_STATUS reads 0x1e000000; RAM reads 0")
268: 
269: # ---------------------------------------------------------------- the accept control
270: #  Both modes LIN_A: the copy is the operation the defect corrupts.  If this row does not
271: #  land the source value, the probe has not driven the engine and the defect row below is
272: #  VACUOUS -- which is why it is a row and not an assumption.
273: A = Addr(CODE)
274: t, alive = session(setup(A, MODE_LIN_A) + load(A, DST_KSEG1) + ["print v0"])
275: row("copy lin_a", printed(t, "v0") if alive else "died", "0x%x" % SRC_VAL,
276:     "ACCEPT: LIN_A source copies to the destination")
277: 
278: # ---------------------------------------------------------------- the defect
279: #  Source RGB, destination RGBA.  The XFER GET decodes the source with the RGB arm and the PUT
280: #  encodes it with the RGBA arm, so the destination shows exactly what the RGB GET produced.
281: #
282: #  *** THESE ROWS ARE WRITTEN RED-NOW / GREEN-AFTER, WHICH IS THE ONLY SHAPE A WITNESS MAY SHIP IN.
283: #  An earlier draft had them the other way round -- asserting the CORRUPT value, so both would have
284: #  gone RED the moment the fix landed.  That is a fine one-shot demonstration and an unshippable
285: #  gate row, and the ladder says so in clause (i): a witness shows the symptom on the pre-fix
286: #  committed HEAD AND GOES GREEN POST-FIX WITH THE SAME SCRIPT.  The exact pre-fix value is not
287: #  lost by the inversion -- it is pinned by `rgb not corrupt' below and printed in the GOT column
288: #  of every run, so the pre-fix log records it verbatim without any row having to expect it. ***
289: A = Addr(CODE)
290: t, alive = session(setup(A, MODE_RGB) + load(A, DST_KSEG1) + ["print v0"])
291: got_rgb = printed(t, "v0") if alive else "died"
292: 
293: #  THE FIX'S SUCCESS CRITERION.  RED on the committed build (it reads 0xbbccdd00), GREEN once
294: #  GET RGB reads buf[0..2].  It pins the EXACT post-fix value rather than merely "not the corrupt
295: #  one", so a fix that moves the bytes to some THIRD wrong place still reds.
296: row("rgb chan", got_rgb, "0x%x" % RGB_FIXED,
297:     "R,G,B must survive at their own byte offsets; the pad is not carried")
