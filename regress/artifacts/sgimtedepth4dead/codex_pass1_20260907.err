196: /*
197:  *  READ_WORD_LE / READ_WORD_BE:
198:  *
199:  *  Assemble a 32-bit word from a 4-byte buffer without signed-shift UB: each
200:  *  byte is promoted to uint32_t before shifting, so byte<<24 is always defined.
201:  *  Used for instruction fetches in the CPU disassemblers/decoders.
202:  */
203: #define	READ_WORD_LE(p)	( (uint32_t)(p)[0]         | ((uint32_t)(p)[1] <<  8) | \
204: 			  ((uint32_t)(p)[2] << 16) | ((uint32_t)(p)[3] << 24) )
205: #define	READ_WORD_BE(p)	( (uint32_t)(p)[3]         | ((uint32_t)(p)[2] <<  8) | \
206: 			  ((uint32_t)(p)[1] << 16) | ((uint32_t)(p)[0] << 24) )
207: 
208: /*
209:  *  LOADER_MAX_TABLE_BYTES:
210:  *
211:  *  Sanity cap for file-controlled symbol/string-table allocations in the file
212:  *  loaders (ELF / Mach-O / ECOFF).  The per-loader checks already require a table
213:  *  to lie within the file, but a sparse or oversized file can still report a
214:  *  multi-GB size and drive a (file-bounded) malloc to OOM.  256 MB is far larger
215:  *  than any real symbol/string table, so this only rejects absurd input.
216:  */
217: #define	LOADER_MAX_TABLE_BYTES	(256 * 1024 * 1024)
