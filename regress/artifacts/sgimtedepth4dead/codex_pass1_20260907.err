209: def run_ops(ops, at):
210:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
211:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
212:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
213:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
214: 
215: def store(A, addr, val, op=OP_SW_T0_A3):
216:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([op], A.take(1))
217: 
218: SENTINEL = 0xdeadbeef
219: def load(A, addr):
220:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT], A.take(1))
221: 
222: def setup(A, src_mode, dst_mode=None, stepx=4):
223:     """Program the engine, paint source and destination, then fire one rectangle.
224:        Every store is a REAL GUEST INSTRUCTION through memory_rw -- no device_add,
225:        no debugger `put' to a device register."""
226:     #  *** THE 64-BIT STORE WRITES THE HIGH WORD TO [n] AND THE LOW WORD TO [n+1]. ***  Measured:
227:     #  `sd' of 0x10 gave `re_linear_a[0] = 0, [1] = 0x10', so the tile pointer was 0 and every pixel
228:     #  went to PHYSICAL ADDRESS 0 -- the destination stayed at its pre-paint and the ACCEPT control
229:     #  failed, which is precisely the "do not leave it 0: that writes phys 0" trap grok named.  The
230:     #  value below puts 0x10 in the HIGH word so re_linear_a[0] = 0x10.
231:     c  = store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)  # sd: a 4-byte sw is DECLINED here
232:     c += store(A, DST_KSEG1, DST_PAINT)
233:     c += store(A, SRC_KSEG1, SRC_VAL)
234:     c += store(A, DE_MODE_DST,   MODE_LIN_A if dst_mode is None else dst_mode)
235:     c += store(A, DE_MODE_SRC,   src_mode)
236:     c += store(A, DE_DRAWMODE,   DRAWMODE)
237:     c += store(A, DE_XFER_ADDR,  SRC_OFS)              # linear: src_x = addr_src, src_y = 0
238:     c += store(A, DE_XFER_STEPX, stepx)                # must equal src bufdepth or the XFER arm warns
239:     c += store(A, DE_FG,         FG_VAL)               # what a declined GET leaves in `color'
240:     c += store(A, DE_XVERTEX_0,  0x00000000)           # (x1,y1) = (0,0)
241:     #  *** (x2,y2) = (0,3): ONE COLUMN, FOUR ROWS.  The height is load-bearing and the width must
242:     #  NOT be used instead. ***  (The latch row that needed the height lives in the probe this
243:     #  file was copied from, not here -- but the geometry is kept so the two sessions stay
244:     #  comparable, and because LIN_A addressing is `ofs = x & 4095' either way.
245:     #  is the announcement COUNT -- which cannot vary at all if the rectangle is one pixel, because an
246:     #  unlatched announce then also fires exactly once.  Measured: with (0,0)-(0,0) the M_NOLATCH
247:     #  mutant scored 8/8, a clean escape, and the row was VACUOUS BY CONSTRUCTION.
248:     #  It is the HEIGHT and not the width because LIN_A addressing is `ofs = x & 4095' -- y is
249:     #  ignored -- so four ROWS write the same byte four times (the value oracle survives) while four
250:     #  COLUMNS would write overlapping bytes at ofs 0..3 and destroy it.
251:     c += store(A, DE_XVERTEX_1,  0x00000003)           # (x2,y2) = (0,3): 4 pixels, all at ofs 0
252:     c += store(A, DE_PRIM_START, PRIM_RECT)            # PRIMITIVE|START fires the draw
253:     return c
