ontext": "fatal(\"osiop: TODO: move: wait for phase. \" | \"phase = %i, osiop_get_scsi_phase = %i\\n\", | phase, osiop_get_scsi_phase(d)); | exit(1); | }"}, {"p": "src/devices/dev_osiop.c", "n": 610, "fn": "*  See \"Symbios SYM53C710 SCSI I/O Processor Technical Manual, version 3.1\" *  chapter 5 for details about the instruction set. */ int osiop_execute_scripts_instr(struct cpu *cpu, struct osiop_data *d)", "context": " | default:fatal(\"osiop: TODO: unimplemented move, \" | \"phase=%i\\n\", phase); | exit(1); | }"}, {"p": "src/devices/dev_osiop.c", "n": 656, "fn": "*  See \"Symbios SYM53C710 SCSI I/O Processor Technical Manual, version 3.1\" *  chapter 5 for details about the instruction set. */ int osiop_execute_scripts_instr(struct cpu *cpu, struct osiop_data *d)", "context": " | if (scsi_ids_to_select == 0) { | fatal(\"osiop: TODO: scsi_ids_to_select = 0!\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_osiop.c", "n": 668, "fn": "*  See \"Symbios SYM53C710 SCSI I/O Processor Technical Manual, version 3.1\" *  chapter 5 for details about the instruction set. */ int osiop_execute_scripts_instr(struct cpu *cpu, struct osiop_data *d)", "context": "scsi_ids_to_select &= ~1; | if (scsi_ids_to_select != 0) { | fatal(\"osiop: TODO: multiselect?\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_osiop.c", "n": 715, "fn": "*  See \"Symbios SYM53C710 SCSI I/O Processor Technical Manual, version 3.1\" *  chapter 5 for details about the instruction set. */ int osiop_execute_scripts_instr(struct cpu *cpu, struct osiop_data *d)", "context": "case 2:\tif (osiop_debug) | debug(\": WAIT RESELECT\"); | fatal(\"osiop: TODO: wait reselect\\n\"); | exit(1); | break;"}, {"p": "src/devices/dev_osiop.c", "n": 727, "fn": "*  See \"Symbios SYM53C710 SCSI I/O Processor Technical Manual, version 3.1\" *  chapter 5 for details about the instruction set. */ int osiop_execute_scripts_instr(struct cpu *cpu, struct osiop_data *d)", "context": " | default:fatal(\": UNIMPLEMENTED dcmd=0x%02x opcode=