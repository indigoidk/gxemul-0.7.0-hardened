   44: void mips_unaligned_loadstore(struct cpu *cpu, struct mips_instr_call *ic,
   45: 	int is_left, int wlen, int store)
   46: {
   47: 	/*  For L (Left):   address is the most significant byte  */
   48: 	/*  For R (Right):  address is the least significant byte  */
   49: 	uint64_t addr = *((uint64_t *)ic->arg[1]) + (int32_t)ic->arg[2];
   50: 	int i, dir, reg_dir, reg_ofs, ok;
   51: 	uint64_t result_value, tmpaddr;
   52: 	uint64_t aligned_addr = addr & ~(wlen-1);
   53: 	unsigned char aligned_word[8], databyte;
   54: 
   55: 	int low_pc = ((size_t)ic - (size_t)cpu->cd.mips.cur_ic_page)
   56: 	    / sizeof(struct mips_instr_call);
   57: 	cpu->pc &= ~((MIPS_IC_ENTRIES_PER_PAGE-1)
   58: 	    << MIPS_INSTR_ALIGNMENT_SHIFT);
   59: 	cpu->pc += (low_pc << MIPS_INSTR_ALIGNMENT_SHIFT);
   60: 
   61: 	dir = 1;		/*  big endian, Left  */
   62: 	reg_dir = -1;
   63: 	reg_ofs = wlen - 1;	/*  byte offset in the register  */
   64: 	if (!is_left) {
   65: 		dir = -dir;
   66: 		reg_ofs = 0;
   67: 		reg_dir = 1;
   68: 	}
   69: 
   70: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
   71: 		dir = -dir;
   72: 
   73: 	result_value = *((uint64_t *)ic->arg[0]);
   74: 
   75: 	if (cpu->is_32bit) {
   76: 		result_value = (int32_t)result_value;
   77: 		aligned_addr = (int32_t)aligned_addr;
   78: 		addr = (int32_t)addr;
   79: 	}
   80: 
   81: 	if (store) {
   82: 		/*  Store:  */
   83: 		uint64_t oldpc = cpu->pc;
   84: 
   85: 		/*
   86: 		 *  NOTE (this is ugly): The memory_rw()
   87: 		 *  call generates a TLBL exception, if there
   88: 		 *  is a tlb refill exception. However, since
   89: 		 *  this is a Store, the exception is converted
   90: 		 *  to a TLBS:
   91: 		 */
   92: 		ok = cpu->memory_rw(cpu, cpu->mem, aligned_addr,
   93: 		    &aligned_word[0], wlen, MEM_READ, CACHE_DATA);
   94: 		if (!ok) {
   95: 			if (cpu->pc != oldpc) {
   96: 				/*  #227: (Codex/Fable/agy) the pre-read is a MEM_READ so it
   97: 				    raised a LOAD-side exception; this is a store -> map only
   98: 				    the load codes to their store counterparts (TLBL->TLBS,
   99: 				    AdEL->AdES) and leave the rest (DBE is shared load/store;
  100: 				    Mod can't come from a read).  */
  101: 				int exc = (cpu->cd.mips.coproc[0]->reg[COP0_CAUSE]
  102: 				    & CAUSE_EXCCODE_MASK) >> CAUSE_EXCCODE_SHIFT;
  103: 				if (exc == EXCEPTION_TLBL)
  104: 					exc = EXCEPTION_TLBS;
  105: 				else if (exc == EXCEPTION_ADEL)
  106: 					exc = EXCEPTION_ADES;
  107: 				cpu->cd.mips.coproc[0]->reg[COP0_CAUSE] =
  108: 				    (cpu->cd.mips.coproc[0]->reg[COP0_CAUSE]
  109: 				    & ~CAUSE_EXCCODE_MASK) | (exc << CAUSE_EXCCODE_SHIFT);
  110: 			}
  111: 			return;
  112: 		}
  113: 
  114: 		for (i=0; i<wlen; i++) {
  115: 			tmpaddr = addr + i*dir;
  116: 			/*  Have we moved into another word/dword? Then stop: */
  117: 			if ( (tmpaddr & ~(wlen-1)) != (addr & ~(wlen-1)) )
  118: 				break;
  119: 
  120: 			/*  debug("unaligned byte at %016"PRIx64",
  121: 			    reg_ofs=%i reg=0x%016"PRIx64"\n",
  122: 			    tmpaddr, reg_ofs, (long long)result_value);  */
  123: 
  124: 			/*  Store one byte:  */
  125: 			aligned_word[tmpaddr & (wlen-1)] =
  126: 			    (result_value >> (reg_ofs * 8)) & 255;
  127: 
  128: 			reg_ofs += reg_dir;
  129: 		}
  130: 
  131: 		ok = cpu->memory_rw(cpu, cpu->mem,
  132: 		    aligned_addr, &aligned_word[0], wlen,
  133: 		    MEM_WRITE, CACHE_DATA);
  134: 
  135: 		return;
  136: 	}
  137: 
  138: 	/*  Load:  */
  139: 	ok = cpu->memory_rw(cpu, cpu->mem, aligned_addr, &aligned_word[0], wlen,
  140: 	    MEM_READ, CACHE_DATA);
  141: 	if (!ok)
  142: 		return;
  143: 
  144: 	for (i=0; i<wlen; i++) {
  145: 		tmpaddr = addr + i*dir;
  146: 		/*  Have we moved into another word/dword? Then stop: */
  147: 		if ( (tmpaddr & ~(wlen-1)) != (addr & ~(wlen-1)) )
  148: 			break;
  149: 
  150: 		/*  debug("unaligned byte at %016"PRIx64", reg_ofs=%i reg="
  151: 		    "0x%016"PRIx64"\n", (uint64_t) tmpaddr,
  152: 		    reg_ofs, (uint64_t)result_value); */
  153: 
  154: 		/*  Load one byte:  */
  155: 		databyte = aligned_word[tmpaddr & (wlen-1)];
  156: 		result_value &= ~((uint64_t)0xff << (reg_ofs * 8));
  157: 		result_value |= (uint64_t)databyte << (reg_ofs * 8);
  158: 
  159: 		reg_ofs += reg_dir;
  160: 	}
