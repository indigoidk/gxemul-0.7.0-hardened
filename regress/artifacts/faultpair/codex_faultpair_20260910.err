 3100: /*
 3101:  *  lwc1, swc1:  Coprocessor 1 load/store (32-bit)
 3102:  *  ldc1, sdc1:  Coprocessor 1 load/store (64-bit)
 3103:  *
 3104:  *  arg[0] = ptr to coprocessor register
 3105:  *  arg[1] = ptr to rs (base pointer register)
 3106:  *  arg[2] = int32_t imm
 3107:  */
 3108: X(lwc1)
 3109: {
 3110: 	COPROC_AVAILABILITY_CHECK(1);
 3111: 
 3112: #ifdef MODE32
 3113: 	mips32_loadstore
 3114: #else
 3115: 	mips_loadstore
 3116: #endif
 3117: 	    [ (cpu->byte_order == EMUL_LITTLE_ENDIAN? 0 : 16) + 2 * 2 + 1]
 3118: 	    (cpu, ic);
 3119: }
 3120: X(swc1)
 3121: {
 3122: 	COPROC_AVAILABILITY_CHECK(1);
 3123: 
 3124: #ifdef MODE32
 3125: 	mips32_loadstore
 3126: #else
 3127: 	mips_loadstore
 3128: #endif
 3129: 	    [ (cpu->byte_order == EMUL_LITTLE_ENDIAN? 0 : 16) + 8 + 2 * 2]
 3130: 	    (cpu, ic);
 3131: }
 3132: X(ldc1)
 3133: {
 3134: 	int use_fp_pairs =
 3135: 	    !(cpu->cd.mips.coproc[0]->reg[COP0_STATUS] & STATUS_FR);
 3136: 	uint64_t fpr, *backup_ptr;
 3137: 
 3138: 	COPROC_AVAILABILITY_CHECK(1);
 3139: 
 3140: 	backup_ptr = (uint64_t *) ic->arg[0];
 3141: 
 3142: 	/*  #224: (Codex/Fable) ft=31 in FR=0 would index reg[32], one past the
 3143: 	    FPR file and into adjacent coproc state; odd ft is architecturally
 3144: 	    undefined -> raise RI instead of an OOB host access.  */
 3145: 	if (use_fp_pairs && backup_ptr == &cpu->cd.mips.coproc[1]->reg[31]) {
 3146: 		instr(reserved)(cpu, ic);
 3147: 		return;
 3148: 	}
 3149: 
 3150: 	/*  #225: (Codex/Fable) seed fpr from the current register so a FAULTING
 3151: 	    load leaves it unchanged instead of copying uninitialized host stack
 3152: 	    into the guest FPR (info leak).  */
 3153: 	fpr = use_fp_pairs?
 3154: 	    ((uint32_t)backup_ptr[0] | ((uint64_t)(uint32_t)backup_ptr[1] << 32))
 3155: 	    : *backup_ptr;
 3156: 
 3157: 	ic->arg[0] = (size_t) &fpr;
 3158: 
 3159: #ifdef MODE32
 3160: 	mips32_loadstore
 3161: #else
 3162: 	mips_loadstore
 3163: #endif
 3164: 	    [ (cpu->byte_order == EMUL_LITTLE_ENDIAN? 0 : 16) + 3 * 2 + 1]
 3165: 	    (cpu, ic);
 3166: 
 3167: 	if (use_fp_pairs) {
 3168: 		backup_ptr[0] = (int64_t)(int32_t) fpr;
 3169: 		backup_ptr[1] = (int64_t)(int32_t) (fpr >> 32);
 3170: 	} else {
 3171: 		*backup_ptr = fpr;
 3172: 	}
 3173: 
 3174: 	ic->arg[0] = (size_t) backup_ptr;
 3175: }
 3176: X(sdc1)
 3177: {
 3178: 	int use_fp_pairs =
 3179: 	    !(cpu->cd.mips.coproc[0]->reg[COP0_STATUS] & STATUS_FR);
 3180: 	uint64_t fpr, *backup_ptr;
 3181: 
 3182: 	COPROC_AVAILABILITY_CHECK(1);
 3183: 
 3184: 	backup_ptr = (uint64_t *) ic->arg[0];
 3185: 
 3186: 	/*  #224: (Codex/Fable) ft=31 in FR=0 would index reg[32] (OOB into
 3187: 	    adjacent coproc state); odd ft is architecturally undefined -> RI.  */
 3188: 	if (use_fp_pairs && backup_ptr == &cpu->cd.mips.coproc[1]->reg[31]) {
 3189: 		instr(reserved)(cpu, ic);
 3190: 		return;
 3191: 	}
 3192: 
 3193: 	ic->arg[0] = (size_t) &fpr;
 3194: 
 3195: 	if (use_fp_pairs) {
 3196: 		uint32_t lo = backup_ptr[0];
 3197: 		uint32_t hi = backup_ptr[1];
 3198: 		fpr = (((uint64_t)hi) << 32) | lo;
 3199: 	} else {
 3200: 		fpr = *backup_ptr;
 3201: 	}
 3202: 
 3203: #ifdef MODE32
 3204: 	mips32_loadstore
 3205: #else
 3206: 	mips_loadstore
 3207: #endif
 3208: 	    [ (cpu->byte_order == EMUL_LITTLE_ENDIAN? 0 : 16) + 8 + 3 * 2]
 3209: 	    (cpu, ic);
 3210: 
 3211: 	ic->arg[0] = (size_t) backup_ptr;
 3212: }
 3213: 
 3214: 
 3215: /*
 3216:  *  Unaligned loads/stores:
 3217:  *
 3218:  *  arg[0] = ptr to rt
 3219:  *  arg[1] = ptr to rs
 3220:  *  arg[2] = int32_t imm
 3221:  */
 3222: X(lwl) { mips_unaligned_loadstore(cpu, ic, 1, sizeof(uint32_t), 0); }
 3223: X(lwr) { mips_unaligned_loadstore(cpu, ic, 0, sizeof(uint32_t), 0); }
 3224: X(ldl) { mips_unaligned_loadstore(cpu, ic, 1, sizeof(uint64_t), 0); }
 3225: X(ldr) { mips_unaligned_loadstore(cpu, ic, 0, sizeof(uint64_t), 0); }
 3226: X(swl) { mips_unaligned_loadstore(cpu, ic, 1, sizeof(uint32_t), 1); }
 3227: X(swr) { mips_unaligned_loadstore(cpu, ic, 0, sizeof(uint32_t), 1); }
 3228: X(sdl) { mips_unaligned_loadstore(cpu, ic, 1, sizeof(uint64_t), 1); }
 3229: X(sdr) { mips_unaligned_loadstore(cpu, ic, 0, sizeof(uint64_t), 1); }
