: Set some bits in A05F80C4 to indicate | which raster position a lightgun is pointing | at!  */ | exit(1); | }"}, {"p": "src/devices/dev_dreamcast_maple.c", "n": 459, "fn": "*  Perform a DMA transfer. enable should be 1, and dmaaddr should point to *  the memory to transfer. */ void maple_do_dma_xfer(struct cpu *cpu, struct dreamcast_maple_data *d)", "context": "case 0x10: unit = 5; break; | default: fatal(\"[ dreamcast_maple: ERROR! multiple \" | \"units? Not yet implemented. to = 0x%02x ]\\n\", to); | exit(1); | }"}, {"p": "src/devices/dev_dreamcast_maple.c", "n": 520, "fn": "*  Perform a DMA transfer. enable should be 1, and dmaaddr should point to *  the memory to transfer. */ void maple_do_dma_xfer(struct cpu *cpu, struct dreamcast_maple_data *d)", "context": "} else { | fatal(\"[ dreamcast_maple: WARNING: GETCOND: \" | \"UNIMPLEMENTED 0x%08\" PRIx32\" ]\\n\", cond); | exit(1); | }"}, {"p": "src/devices/dev_dreamcast_maple.c", "n": 529, "fn": "*  Perform a DMA transfer. enable should be 1, and dmaaddr should point to *  the memory to transfer. */ void maple_do_dma_xfer(struct cpu *cpu, struct dreamcast_maple_data *d)", "context": "break; |  | default:fatal(\"[ dreamcast_maple: command %i: TODO ]\\n\", cmd); | exit(1); | }"}, {"p": "src/devices/dev_dreamcast_maple.c", "n": 565, "fn": "} DEVICE_ACCESS(dreamcast_maple)", "context": "} else { | fatal(\"[ dreamcast_maple: TODO: read from dmaaddr ]\\n\"); | odata = d->dmaaddr; | exit(1); | }"}, {"p": "src/devices/dev_eagle.c", "n": 182, "fn": "} DEVINIT(eagle)", "context": "break; | default:fatal(\"unimplemented machine subtype for \" | \"eagle/mvmeppc\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_eagle.c", "n": 187, "fn": "} DEVINIT(eagle)", "context": "break; |  | default:fatal(\"unimplemented machine type for eagle\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_fb.c", "n": 359, "fn": "*/ void framebuffer_blockcopyfill(struct vfb_data *d, int fillflag, int fill_r, int fill_g, int fill_b, int x1, int y1, int x2,