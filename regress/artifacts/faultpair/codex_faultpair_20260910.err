_error) | exit(1); | else"}, {"p": "src/devices/device.c", "n": 387, "fn": "* *  TODO: This function is quite ugly, and should be cleaned up. */ void *device_add(struct machine *machine, const char *name_and_params)", "context": "if (!p->initf(&devinit)) { | fatal(\"error adding device (\\\"%s\\\")\\n\", name_and_params); | if (device_exit_on_error) | exit(1); | else"}, {"p": "src/devices/lk201.c", "n": 210, "fn": "*  lk201_send_mouse_update_sequence(): */ static int lk201_send_mouse_update_sequence(struct lk201_data *d, int xdelta, int ydelta, int mouse_buttons, int mouse_fb_nr)", "context": "/*  TODO:  prompt mode and perhaps more stuff  */ | fatal(\"[ lk201: mouse mode 0x%02x unknown: TODO ]\\n\", | d->mouse_mode); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 212, "fn": "*  Also, any errors/warnings are printed using fatal()/debug(). */ int machine_name_to_type(char *stype, char *ssubtype, int *type, int *subtype)", "context": "fatal(\"\\nUse an alias when selecting a \" | \"subtype, e.g.:  -e %s\\n\", | me->subtype[0]->aliases[0]); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 351, "fn": "*  The hz value is used in this case. */ void machine_add_tickfunction(struct machine *machine, void (*func) (struct cpu *, void *), void *extra, int tickshift)", "context": "fatal(\"ERROR! tickshift = %i, less than \" | \"N_SAFE_DYNTRANS_LIMIT_SHIFT (%i)\\n\", | tickshift, N_SAFE_DYNTRANS_LIMIT_SHIFT); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 381, "fn": "* *  Note: The fname argument contains \"flags:filename\". */ void machine_statistics_init(struct machine *machine, char *fname)", "context": " | if (machine->statistics.fields != NULL) { | fprintf(stderr, \"Only one -s option is allowed.\\n\"); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 395, "fn": "* *  Note: The fname argument contains \"flags:filename\". */ void machine_statistics_init(struct machine *machine, char *fname)", "context": "fprintf(stderr, \"The syntax for the -s option is:    \" | \"-s flags:filename\\nYou omitted the flags. Run g\" | \"xemul -h for a list of available flags.\\n\"); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 422, "fn": "* *  Note: The fname argument contains \"flags:filename\". */ void machine_statistics_init(struct machine *machine, char *fname)", "context": " | default:fprintf(stderr, \"Unknown flag '%c' used with the\" | \" -s option. Aborting.\\n\", *fname); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 539, "fn": "*  This function initializes memory, registers, and/or devices *  required by specific machine emulations. */ void machine_setup(struct machine *machine)", "context": " | if (me == NULL) { | fatal(\"Unknown emulation type %i\\n\", machine->machine_type); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 615, "fn": "*  Sets physical_ram_in_mb (if not already set), and memory_offset_in_mb, *  depending on machine type. */ void machine_memsize_fix(struct machine *m)", "context": "{ | if (m == NULL) { | fatal(\"machine_defaultmemsize(): m == NULL?\\n\"); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 662, "fn": "* *  Sets m->cpu_name, if it isn't already set, depending on the machine type. */ void machine_default_cputype(struct machine *m)", "context": " | if (m == NULL) { | fatal(\"machine_default_cputype(): m == NULL?\\n\"); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 683, "fn": "* *  Sets m->cpu_name, if it isn't already set, depending on the machine type. */ void machine_default_cputype(struct machine *m)", "context": "fprintf(stderr, \"machine_default_cputype(): no default\" | \" cpu for machine type %i subtype %i\\n\", | m->machine_type, m->machine_subtype); | exit(1); | }"}, {"p": "src/machines/machine.c", "n": 950, "fn": "*  This function should be called before any other machine_*() function *  is used.  automachine_init() registers all machines in src/machines/. */ void machine_init(void)", "context": "{ | if (first_machine_entry != NULL) { | fa