   31: 
   32: void generate_multi(int store, int endianness, int n, int sixtyfourbit)
   33: {
   34: 	int i, nr;
   35: 
   36: 	printf("X(multi_%cw_%i_%ce)\n{\n",
   37: 	    store? 's' : 'l', n, endianness? 'b' : 'l');
   38: 
   39: 	printf("\tuint32_t *page;\n"
   40: 	    "\tMODE_uint_t rX = reg(ic[0].arg[1])");
   41: 	for (i=0; i<n; i++)
   42: 		printf(", r%i", i);
   43: 	printf(";\n");
   44: 
   45: 	for (i=0; i<n; i++)
   46: 		printf("\tMODE_uint_t addr%i = rX + (int32_t)ic[%i].arg[2];\n",
   47: 		    i, i);
   48: 
   49: 	if (sixtyfourbit) {
   50: 		printf("\tconst uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;\n");
   51: 		printf("\tconst uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;\n");
   52: 		printf("\tconst uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;\n");
   53: 		printf("\tuint32_t x1, x2, x3;\n");
   54: 		printf("\tstruct DYNTRANS_L2_64_TABLE *l2;\n");
   55: 		printf("\tstruct DYNTRANS_L3_64_TABLE *l3;\n");
   56: 		printf("\tx1 = (addr0 >> (64-DYNTRANS_L1N)) & mask1;\n");
   57: 		printf("\tx2 = (addr0 >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;\n");
   58: 		printf("\tx3 = (addr0 >> (64-DYNTRANS_L1N-DYNTRANS_L2N-DYNTRANS_L3N)) & mask3;\n");
   59: 		printf("\tl2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];\n");
   60: 		printf("\tl3 = l2->l3[x2];\n");
   61: 		printf("\tpage = (uint32_t *) l3->host_%s[x3];\n",
   62: 			store? "store" : "load");
   63: 	} else {
   64: 		printf("\tuint32_t index%i = addr%i >> 12;\n", 0, 0);
   65: 		printf("\tpage = (uint32_t *) cpu->cd.mips.host_%s[index0];\n",
   66: 		    store? "store" : "load");
   67: 	}
   68: 
   69: 	printf("\tif (cpu->delay_slot ||\n"
   70: 	    "\t    page == NULL");
   71: 	for (i=0; i<n; i++)
   72: 		printf(" || (addr%i & 3)", i);
   73: 	printf("\n\t   ");
   74: 	for (i=1; i<n; i++)
   75: 		printf(" || ((addr%i ^ addr0) & ~0xfff)", i);
   76: 	printf(") {\n");
   77: 
   78: 	nr = 2*2;
   79: 	if (store)
   80: 		nr += 8;
   81: 	else
   82: 		nr += 1;
   83: 	if (endianness)
   84: 		nr += 16;
   85: 	printf("\t\tmips%s_loadstore[%i](cpu, ic);\n", sixtyfourbit ? "" : "32", nr);
   86: 
   87: 	printf("\t\treturn;\n\t}\n");
   88: 
   89: 	/*  #388: fold-fire witness -- this one emission point covers all 32
   90: 	    generated bodies; past the single bail above, the handler always
   91: 	    completes. The enum NAME is emitted textually and resolves via
   92: 	    cpu_mips.h in the including translation unit.  */
   93: 	printf("\tcpu->cd.mips.fold_fire[MIPS_FOLD_MULTI_%cW_%i_%cE] ++;"
   94: 	    "\t/*  #388  */\n",
   95: 	    store? 'S' : 'L', n, endianness? 'B' : 'L');
   96: 
   97: 	for (i=0; i<n; i++)
   98: 		printf("\taddr%i = (addr%i >> 2) & 0x3ff;\n", i, i);
   99: 
  100: 	if (store) {
  101: 		for (i=0; i<n; i++)
  102: 			printf("\tr%i = reg(ic[%i].arg[0]);\n", i, i);
  103: 		for (i=0; i<n; i++)
  104: 			printf("\tr%i = %cE32_TO_HOST(r%i);\n", i,
  105: 			    endianness? 'B' : 'L', i);
  106: 		for (i=0; i<n; i++)
  107: 			printf("\tpage[addr%i] = r%i;\n", i, i);
  108: 	} else {
  109: 		for (i=0; i<n; i++)
  110: 			printf("\tr%i = page[addr%i];\n", i, i);
  111: 		for (i=0; i<n; i++)
  112: 			printf("\tr%i = %cE32_TO_HOST(r%i);\n", i,
  113: 			    endianness? 'B' : 'L', i);
  114: 		for (i=0; i<n; i++)
  115: 			printf("\treg(ic[%i].arg[0]) = (MODE_int_t)(int32_t)r%i;\n", i, i);
  116: 	}
  117: 
  118: 	printf("\tcpu->n_translated_instrs += %i;\n", n - 1);
  119: 	printf("\tcpu->cd.mips.next_ic += %i;\n", n - 1);
  120: 
  121: 	printf("}\n");
  122: }
  123: 
  124: 
  125: int main(int argc, char *argv[])
  126: {
  127: 	int store, endianness, n;
  128: 
  129: 	printf("\n/*  AUTOMATICALLY GENERATED! Do not edit.  */\n\n");
  130: 
  131: 	for (endianness=0; endianness<=1; endianness++)
  132: 		for (store=0; store<=1; store++)
  133: 			for (n=2; n<=5; n++) {
  134: 				printf("#ifdef MODE32\n");
  135: 				generate_multi(store, endianness, n, 0);
  136: 				printf("#else\n");
  137: 				generate_multi(store, endianness, n, 1);
  138: 				printf("#endif\n\n");
  139: 			}
  140: 
  141: 	return 0;
  142: }
