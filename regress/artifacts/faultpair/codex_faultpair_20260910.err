g three times *  out of four.  Check it per site. */ DEVICE_ACCESS(sh4)", "context": "} |  | #ifdef SH4_DEBUG | exit(1); | #endif"}, {"p": "src/devices/dev_sh4.c", "n": 3008, "fn": "} DEVINIT(sh4)", "context": "SH_INTEVT_TMU0_TUNI0); | if (!interrupt_handler_lookup(tmp, &d->timer_irq[0])) { | fatal(\"Could not find interrupt '%s'.\\n\", tmp); | exit(1); | }"}, {"p": "src/devices/dev_sh4.c", "n": 3014, "fn": "} DEVINIT(sh4)", "context": "SH_INTEVT_TMU1_TUNI1); | if (!interrupt_handler_lookup(tmp, &d->timer_irq[1])) { | fatal(\"Could not find interrupt '%s'.\\n\", tmp); | exit(1); | }"}, {"p": "src/devices/dev_sh4.c", "n": 3020, "fn": "} DEVINIT(sh4)", "context": "SH_INTEVT_TMU2_TUNI2); | if (!interrupt_handler_lookup(tmp, &d->timer_irq[2])) { | fatal(\"Could not find interrupt '%s'.\\n\", tmp); | exit(1); | }"}, {"p": "src/devices/dev_turbochannel.c", "n": 189, "fn": "*/ void dev_turbochannel_init(struct machine *machine, struct memory *mem, int slot_nr, uint64_t baseaddr, uint64_t endaddr, const char *device_name, const char *irq_path)", "context": " | if (strlen(device_name) > 8) { | fprintf(stderr, \"dev_turbochannel_init(): bad device_name\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_v3.c", "n": 271, "fn": "} DEVINIT(v3)", "context": " | default:fatal(\"!\\n! WARNING: v3 for non-implemented machine\" | \" type %i\\n!\\n\", devinit->machine->machine_type); | exit(1); | }"}, {"p": "src/devices/dev_v3.c", "n": 332, "fn": "} DEVINIT(v3)", "context": "break; | default:fatal(\"!\\n! WARNING: v3 for non-implemented machine\" | \" type %i\\n!\\n\", devinit->machine->machine_type); | exit(1); | }"}, {"p": "src/devices/dev_vme.c", "n": 143, "fn": "}; DEVICE_ACCESS(vme)", "context": "else | debug(\"[ vme: unimplemented WRITE to offset 0x%x: \" | \"0x%x ]\\n\", (int)relative_addr, (int)idata); | exit(1); | }"}, {"p": "src/devices/dev_vr41xx.c", "n": 758, "fn": "*  machine->path is something like \"machine[0]\". */ struct vr41xx_data *dev_vr41xx_init(struct machine *machin