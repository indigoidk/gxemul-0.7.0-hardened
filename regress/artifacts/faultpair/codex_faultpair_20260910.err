  186: 
  187: DEVICE_ACCESS(crime)
  188: {
  189: 	/*
  190: 	 *  The CRIME is memory mapped as 0x80 bytes, starting at
  191: 	 *  physical 0x14000000.
  192: 	 *
  193: 	 *  On my real O2:
  194: 	 *
  195: 	 *  0x14000080..0x140000ff is the same as 0x14000000..0x1400007f.
  196: 	 *  0x14000100..0x1400017f is the same as 0x14000000..0x1400007f.
  197: 	 *  0x14000180..0x140001ff is the same as 0x14000000..0x1400007f.
  198: 	 *
  199: 	 *  (I assume that real code will never access the above "mirrors",
  200: 	 *  but it would be trivial to add redirection so that such code
  201: 	 *  would work too.)
  202: 	 *
  203: 	 *  Memory control then starts at 0x14000200.
  204: 	 */
  205: 	struct crime_data *d = (struct crime_data *) extra;
  206: 	uint64_t idata = 0, odata = 0;
  207: 	uint64_t preserved_CRIME_HARDINT = d->reg[CRIME_HARDINT / sizeof(uint64_t)];
  208: 	size_t i;
  209: 
  210: 	if (writeflag == MEM_WRITE)
  211: 		idata = memory_readmax64(cpu, data, len);
  212: 
  213: 	/*
  214: 	 *  Set crime version/revision:
  215: 	 *
  216: 	 *  This might not be the most elegant or correct solution, but it
  217: 	 *  seems that the IP32 PROM likes 0x11 for machines without graphics,
  218: 	 *  and 0xa1 for machines with graphics.
  219: 	 *
  220: 	 *  NetBSD 2.0 complains about "unknown" crime for 0x11, but I guess
  221: 	 *  that's something one has to live with.  (TODO?)
  222: 	 */
  223: 	d->reg[CRIME_REV / sizeof(uint64_t)] = d->use_fb? 0xa1 : 0x11;
  224: 
  225: 	d->reg[CRIME_CONTROL / sizeof(uint64_t)] = CRIME_CONTROL_ENDIANESS;
  226: 
  227: 	d->reg[CRIME_INTSTAT / sizeof(uint64_t)] =
  228: 		(d->reg[CRIME_SOFTINT / sizeof(uint64_t)] |
  229: 		d->reg[CRIME_HARDINT / sizeof(uint64_t)]);
  230: 
  231: 	/*
  232: 	 *  Amount of memory.  Bit 8 of bank control set ==> 128MB instead
  233: 	 *  of 32MB per bank (?)
  234: 	 *
  235: 	 *  According to OpenBSD, "Empty banks are reported as duplicates of
  236: 	 *  bank #0."
  237: 	 */
  238: 	if (cpu->machine->physical_ram_in_mb > 1024) {
  239: 		fatal("[ sgi_crime: SGI O2 can not have more than 1024 MB RAM ]\n");
  240: 		exit(1);
  241: 	}
  242: 
  243: 	int mb_per_bank;
  244: 	if (cpu->machine->physical_ram_in_mb <= 256)
  245: 		mb_per_bank = 32;
  246: 	else
  247: 		mb_per_bank = 128;
  248: 
  249: 	if (cpu->machine->physical_ram_in_mb % mb_per_bank) {
  250: 		fatal("[ sgi_crime: for up to 256 MB RAM, RAM size needs to be divisible "
  251: 			"by 32 MB. for larger RAM sizes (up to 1024 MB), it needs to be "
  252: 			"divisible by 128 MB. ]\n");
  253: 		exit(1);
  254: 	}
  255: 
  256: 	int flag_for_128MB = mb_per_bank == 128 ? 0x100 : 0x000;
  257: 	size_t total_mb = 0;
  258: 	for (int bank = 0; bank < 8; ++bank) {
  259: 		int b = mb_per_bank == 128 ? (bank << 2) : bank;
  260: 		if (total_mb >= cpu->machine->physical_ram_in_mb)
  261: 			d->reg[CRIME_MEM_BANK_CTRL0 / sizeof(uint64_t) + bank] =
  262: 				d->reg[CRIME_MEM_BANK_CTRL0 / sizeof(uint64_t) + 0];
  263: 		else
  264: 			d->reg[CRIME_MEM_BANK_CTRL0 / sizeof(uint64_t) + bank] = flag_for_128MB | b;
  265: 
  266: 		total_mb += mb_per_bank;
  267: 	}
  268: 	
  269: 	if (len == 8) {
  270: 		if (writeflag == MEM_WRITE)
  271: 			d->reg[relative_addr / 8] = idata;
  272: 		else
  273: 			odata = d->reg[relative_addr / 8];
  274: 	} else if (len == 4) {
  275: 		if (writeflag == MEM_WRITE) {
  276: 			if (relative_addr & 4) {
  277: 				d->reg[relative_addr / 8] &= ~0xffffffffULL;
  278: 				d->reg[relative_addr / 8] |= (uint32_t)idata;
  279: 			} else {
  280: 				d->reg[relative_addr / 8] &= 0xffffffffULL;
  281: 				d->reg[relative_addr / 8] |= (uint64_t)(idata << 32ULL);
  282: 			}
  283: 		} else {
  284: 			odata = d->reg[relative_addr / 8];
  285: 			if (relative_addr & 4)
  286: 				odata = (int32_t)odata;
  287: 			else
  288: 				odata = (int32_t)(odata >> 32);
  289: 		}
  290: 	} else {
  291: 		fatal("crime access len = %i!\n", len);
  292: 		exit(1);
  293: 	}
  294: 
  295: 	switch (relative_addr) {
  296: 
  297: 	case CRIME_REV:		/*  0x000  */
  298: 		/*
  299: 		 *  A contender for winning a prize for the worst hack
  300: 		 *  in history:  the IP32 PROM probes the CPU caches during
  301: 		 *  bootup, but they are not really emulated, so it fails.
  302: 		 *  During the probe, the CRIME_REV is read a lot. By
  303: 		 *  "returning" from the probe function, i.e. jumping to ra,
  304: 		 *  when this register is read the second time, the probe
  305: 		 *  can be skipped, and the PROM thus runs further.
  306: 		 *
  307: 		 *  The address where this happens is:
  308: 		 *	0xbfc0517c	PROM v2.3
  309: 		 *	0xbfc051ac	PROM v4.13
  310: 		 *
  311: 		 *  4.18 works too.
  312: 		 *
  313: 		 *  By extrapolating a bit (allowing for variations for other
  314: 		 *  versions of the PROM), let's return if the read of the
  315: 		 *  CRIME_REV register occurs anywhere near 0xbfc051XX.
  316: 		 */
  317: 		if (((uint32_t)cpu->pc & 0xffffff00) == (uint32_t)0xbfc05100) {
  318: 			cpu->pc = cpu->cd.mips.gpr[MIPS_GPR_RA];
  319: 			if (cpu->is_32bit)
  320: 				mips32_pc_to_pointers(cpu);
  321: 			else
  322: 				mips_pc_to_pointers(cpu);
  323: 		}
  324: 		break;
  325: 
  326: 	case CRIME_CONTROL:	/*  0x008  */
  327: 		/*  TODO: 64-bit write to CRIME_CONTROL, but some things
  328: 		    (such as NetBSD 1.6.2) write to 0x00c!  */
  329: 		if (writeflag == MEM_WRITE) {
  330: 			/*
  331: 			 *  0x200 = watchdog timer (according to NetBSD)
  332: 			 *  0x800 = "reboot" used by the IP32 PROM
  333: 			 */
  334: 			if (idata & CRIME_CONTROL_DOG_ENABLE) {
  335: 				idata &= ~CRIME_CONTROL_DOG_ENABLE;
  336: 			}
  337: 			if (idata & CRIME_CONTROL_HARD_RESET) {
  338: 				int j;
  339: 
  340: 				/*  This is used by the IP32 PROM's
  341: 				    "reboot" command:  */
  342: 				for (j=0; j<cpu->machine->ncpus; j++)
  343: 					cpu->machine->cpus[j]->running = 0;
  344: 
  345: 				idata &= ~CRIME_CONTROL_HARD_RESET;
  346: 			}
  347: 
  348: 			idata &= ~CRIME_CONTROL_ENDIANESS;
  349: 
  350: 			if (idata != 0)
  351: 				fatal("[ CRIME_CONTROL: unimplemented "
  352: 				    "control 0x%016llx ]\n", (long long)idata);
  353: 		}
  354: 		break;
  355: 
  356: 	case CRIME_INTSTAT:	/*  0x010, Current interrupt status  */
  357: 	case CRIME_INTMASK:	/*  0x018, Current interrupt mask  */
  358: 		crime_interrupt_reassert(d);
  359: 		break;
  360: 
  361: 	case CRIME_DOG:		/*  0x030  */
  362: 		// No warning.
  363: 		break;
  364: 
  365: 	case CRIME_TIME:	/*  0x038  */
  366: 		crime_update_crime_time(d);
  367: 		break;
  368: 
  369: 	default:
  370: 		if (writeflag==MEM_READ) {
  371: 			debug("[ crime: read from 0x%x, len=%i:",
  372: 			    (int)relative_addr, len);
  373: 			for (i=0; i<len; i++)
  374: 				debug(" %02x", data[i]);
  375: 			debug(" ]\n");
  376: 		} else {
  377: 			debug("[ crime: write to 0x%x:", (int)relative_addr);
  378: 			for (i=0; i<len; i++)
  379: 				debug(" %02x", data[i]);
  380: 			debug(" (len=%i) ]\n", len);
  381: 		}
  382: 	}
  383: 
  384: 	d->reg[CRIME_HARDINT / sizeof(uint64_t)] = preserved_CRIME_HARDINT;
  385: 	d->reg[CRIME_INTSTAT / sizeof(uint64_t)] =
  386: 		(d->reg[CRIME_SOFTINT / sizeof(uint64_t)] |
  387: 		d->reg[CRIME_HARDINT / sizeof(uint64_t)]);
  388: 
  389: 	if (writeflag == MEM_READ)
  390: 		memory_writemax64(cpu, data, len, odata);
  391: 
  392: 	return 1;
  393: }
  394: 
  395: 
  396: /*
  397:  *  dev_crime_init():
  398:  */
  399: void dev_crime_init(struct machine *machine, struct memory *mem,
  400: 	uint64_t baseaddr, char *irq_path, int use_fb)
  401: {
  402: 	struct crime_data *d;
  403: 	char tmpstr[200];
  404: 	int i;
  405: 
  406: 	CHECK_ALLOCATION(d = (struct crime_data *) malloc(sizeof(struct crime_data)));
  407: 	memset(d, 0, sizeof(struct crime_data));
  408: 
  409: 	d->use_fb = use_fb;
  410: 
  411: 	INTERRUPT_CONNECT(irq_path, d->irq);
  412: 
  413: 	/*  Register 32 crime interrupts (hexadecimal names):  */
  414: 	for (i=0; i<32; i++) {
  415: 		struct interrupt templ;
  416: 		char name[400];
  417: 		snprintf(name, sizeof(name), "%s.crime.0x%x", irq_path, (uint32_t)1 << i);
  418: 		memset(&templ, 0, sizeof(templ));
  419:                 templ.line = (uint32_t)1 << i;
  420: 		templ.name = name;
  421: 		templ.extra = d;
  422: 		templ.interrupt_assert = crime_interrupt_assert;
  423: 		templ.interrupt_deassert = crime_interrupt_deassert;
  424: 		interrupt_handler_register(&templ);
  425:         }
  426: 
  427: 	memory_device_register(mem, "crime", baseaddr, DEV_CRIME_LENGTH,
  428: 	    dev_crime_access, d, DM_DEFAULT, NULL);
  429: 
  430: 	snprintf(tmpstr, sizeof(tmpstr), "mace addr=0x1f310000 irq=%s.crime",
  431: 	    irq_path);
  432: 	device_add(machine, tmpstr);
  433: 
  434: 	machine_add_tickfunction(machine, dev_crime_tick, d,
  435: 	    CRIME_TICKSHIFT);
  436: }
  437: 
  438: 
  439: /****************************************************************************/
  440: 
  441: 
  442: #define DEV_MACE_LENGTH		0x100
  443: struct mace_data {
  444: 	unsigned char		reg[DEV_MACE_LENGTH];
  445: 	struct interrupt	irq_periph;
  446: 	struct interrupt	irq_misc;
  447: 	int			prev_assert_periph;
  448: 	int			prev_assert_misc;
  449: };
  450: 
  451: 
  452: void mace_interrupt_reassert(struct mace_data *d)
  453: {
  454: 	uint8_t s4 = d->reg[MACE_ISA_INT_STATUS+4] & d->reg[MACE_ISA_INT_MASK+4];
  455: 	uint8_t s5 = d->reg[MACE_ISA_INT_STATUS+5] & d->reg[MACE_ISA_INT_MASK+5];
  456: 	uint8_t s6 = d->reg[MACE_ISA_INT_STATUS+6] & d->reg[MACE_ISA_INT_MASK+6];
  457: 	uint8_t s7 = d->reg[MACE_ISA_INT_STATUS+7] & d->reg[MACE_ISA_INT_MASK+7];
  458: 
  459: 	int assert_periph = s4 | s5 ? 1 : 0;
  460: 	int assert_misc = s6 | s7 ? 1 : 0;
  461: 
  462: /*
  463: printf("status=%02x%02x%02x%02x mask=%02x%02x%02x%02x => periph = %i misc = %i\n",
  464: d->reg[MACE_ISA_INT_STATUS+4],
  465: d->reg[MACE_ISA_INT_STATUS+5],
  466: d->reg[MACE_ISA_INT_STATUS+6],
  467: d->reg[MACE_ISA_INT_STATUS+7],
  468: d->reg[MACE_ISA_INT_MASK+4],
  469: d->reg[MACE_ISA_INT_MASK+5],
  470: d->reg[MACE_ISA_INT_MASK+6],
  471: d->reg[MACE_ISA_INT_MASK+7],
  472:  assert_periph, assert_misc);
  473: */
  474: 
  475: 	if (assert_periph != d->prev_assert_periph) {
  476: 		d->prev_assert_periph = assert_periph;
  477: 		if (assert_periph)
  478: 			INTERRUPT_ASSERT(d->irq_periph);
  479: 		else
  480: 			INTERRUPT_DEASSERT(d->irq_periph);
  481: 	}
  482: 
  483: 	if (assert_misc != d->prev_assert_misc) {
  484: 		d->prev_assert_misc = assert_misc;
  485: 		if (assert_misc)
  486: 			INTERRUPT_ASSERT(d->irq_misc);
  487: 		else
  488: 			INTERRUPT_DEASSERT(d->irq_misc);
  489: 	}
  490: }
  491: 
  492: 
  493: 
  494: /*
  495:  *  mace_interrupt_assert():
  496:  *  mace_interrupt_deassert():
  497:  */
  498: void mace_interrupt_assert(struct interrupt *interrupt)
  499: {
  500: 	struct mace_data *d = (struct mace_data *) interrupt->extra;
  501: 	uint32_t line = 1 << interrupt->line;
  502: 
  503: 	d->reg[MACE_ISA_INT_STATUS + 4] |= ((line >> 24) & 255);
  504: 	d->reg[MACE_ISA_INT_STATUS + 5] |= ((line >> 16) & 255);
  505: 	d->reg[MACE_ISA_INT_STATUS + 6] |= ((line >> 8) & 255);
  506: 	d->reg[MACE_ISA_INT_STATUS + 7] |= (line & 255);
  507: 
  508: 	mace_interrupt_reassert(d);
  509: }
  510: void mace_interrupt_deassert(struct interrupt *interrupt)
  511: {
  512: 	struct mace_data *d = (struct mace_data *) interrupt->extra;
  513: 	uint32_t line = 1 << interrupt->line;
  514: 
  515: 	d->reg[MACE_ISA_INT_STATUS + 4] &= ~((line >> 24) & 255);
  516: 	d->reg[MACE_ISA_INT_STATUS + 5] &= ~((line >> 16) & 255);
  517: 	d->reg[MACE_ISA_INT_STATUS + 6] &= ~((line >> 8) & 255);
  518: 	d->reg[MACE_ISA_INT_STATUS + 7] &= ~(line & 255);
  519: 
  520: 	mace_interrupt_reassert(d);
  521: }
  522: 
  523: 
  524: DEVICE_ACCESS(mace)
  525: {
  526: 	size_t i;
  527: 	struct mace_data *d = (struct mace_data *) extra;
  528: 
  529: 	/*
  530: 	 *  My O2 returns the following when dumping 0xbf310000 and forward:
  531: 	 *
  532: 	 *  +0x00: 0x0000000000000010 0x000000000000001e
  533: 	 *  +0x10: 0x0000000000000000 0x0000000000000000
  534: 	 *
  535: 	 *  and then the following addresses result in the same data as
  536: 	 *  0xbf310000.
  537: 	 */
  538: 	d->reg[MACE_ISA_RINGBASE + 7] = 0x10;
  539: 	d->reg[MACE_ISA_FLASH_NIC_REG + 7] |= MACE_ISA_PWD_CLEAR;
  540: 
  541: 	uint8_t old_mace_isa_flash_nic_reg =
  542: 		d->reg[MACE_ISA_FLASH_NIC_REG + 7];
  543: 
  544: 	if (writeflag == MEM_WRITE)
  545: 		memcpy(&d->reg[relative_addr], data, len);
  546: 	else
  547: 		memcpy(data, &d->reg[relative_addr], len);
  548: 
  549: 	switch (relative_addr & ~7) {
  550: 
  551: 	case MACE_ISA_RINGBASE:
  552: 		break;
  553: 
  554: 	case MACE_ISA_FLASH_NIC_REG:
  555: 		// I think the PROM attempts to read the machine's ethernet
  556: 		// address from a DS2502 EPROM, by writing MACE_ISA_NIC_DEASSERT
  557: 		// to this register in various patterns, and looking at the
  558: 		// resulting MACE_ISA_NIC_DATA (or does it write data as well?)
  559: 		// In any case, onewire is too complicated to implement right
  560: 		// now. TODO.
  561: 		if (writeflag)
  562: 		{
  563: 			/*
  564: 			 *  The NetBSD defines are called "RED" and "GREEN",
  565: 			 *  and are documented like this:
  566: 			 *
  567: 			 *	1=> Illuminate RED LED
  568: 			 *
  569: 			 *  (and similarly for GREEN). But on my O2, it feels
  570: 			 *  like the other way around (i.e. 1 = do NOT illuminate
  571: 			 *  that LED color). Also, having it this way is more
  572: 			 *  compatible with how NetBSD, OpenBSD, and the PROM
  573: 			 *  actually use the LED.
  574: 			 */
  575: 			uint8_t change = (d->reg[MACE_ISA_FLASH_NIC_REG + 7]
  576: 				^ old_mace_isa_flash_nic_reg) &
  577: 				(MACE_ISA_LED_RED | MACE_ISA_LED_GREEN);
  578: 			if (change) {
  579: 				switch (d->reg[MACE_ISA_FLASH_NIC_REG + 7] & (MACE_ISA_LED_RED | MACE_ISA_LED_GREEN)) {
  580: 				case 0:	debugmsg(SUBSYS_DEVICE, "mace", VERBOSITY_INFO, "turning LED WHITE/ORANGE");
  581: 					break;
  582: 				case MACE_ISA_LED_RED:
  583: 					debugmsg(SUBSYS_DEVICE, "mace", VERBOSITY_INFO, "turning LED GREEN");
  584: 					break;
  585: 				case MACE_ISA_LED_GREEN:
  586: 					debugmsg(SUBSYS_DEVICE, "mace", VERBOSITY_INFO, "turning LED RED");
  587: 					break;
  588: 				default:debugmsg(SUBSYS_DEVICE, "mace", VERBOSITY_WARNING, "turning LED OFF");
  589: 					break;
  590: 				}
  591: 			}
  592: 			
  593: //printf("%02x: MACE_ISA_NIC_DEASSERT = %i, DATA = %i\n",
  594: 	//d->reg[MACE_ISA_FLASH_NIC_REG + 7],
  595: //d->reg[MACE_ISA_FLASH_NIC_REG + 7] & MACE_ISA_NIC_DEASSERT,
  596: 	//d->reg[MACE_ISA_FLASH_NIC_REG + 7] & MACE_ISA_NIC_DATA);
  597: 		} else {
  598: //			data[len-1] ^= (random() & MACE_ISA_NIC_DATA);
  599: //			data[len-1] |= MACE_ISA_NIC_DEASSERT;
  600: 		}
  601: 		break;
  602: 
  603: 	case MACE_ISA_INT_STATUS:	/*  Current interrupt assertions  */
  604: 		/*  don't dump debug info for these  */
  605: 		if (writeflag == MEM_WRITE) {
  606: 			fatal("[ NOTE/TODO: WRITE to mace intr: "
  607: 			    "reladdr=0x%x data=", (int)relative_addr);
  608: 			for (i=0; i<len; i++)
  609: 				fatal(" %02x", data[i]);
  610: 			fatal(" (len=%i) ]\n", len);
  611: 		}
  612: 		break;
  613: 	case MACE_ISA_INT_MASK:		/*  Current interrupt mask  */
  614: 		mace_interrupt_reassert(d);
  615: 		break;
  616: 
  617: 	default:
  618: 		if (writeflag == MEM_READ) {
  619: 			debug("[ mace: read from 0x%x:", (int)relative_addr);
  620: 			for (i=0; i<len; i++)
  621: 				debug(" %02x", data[i]);
  622: 			debug(" (len=%i) ]\n", len);
  623: 		} else {
  624: 			debug("[ mace: write to 0x%x:", (int)relative_addr);
  625: 			for (i=0; i<len; i++)
  626: 				debug(" %02x", data[i]);
  627: 			debug(" (len=%i) ]\n", len);
  628: 		}
  629: 	}
  630: 
  631: 	return 1;
  632: }
  633: 
  634: 
  635: DEVINIT(mace)
  636: {
  637: 	struct mace_data *d;
  638: 	char tmpstr[300];
  639: 	int i;
  640: 
  641: 	CHECK_ALLOCATION(d = (struct mace_data *) malloc(sizeof(struct mace_data)));
  642: 	memset(d, 0, sizeof(struct mace_data));
  643: 
  644: 	snprintf(tmpstr, sizeof(tmpstr), "%s.0x%x",
  645: 	    devinit->interrupt_path, CRIME_INT_PERIPH_SERIAL);
  646: 	INTERRUPT_CONNECT(tmpstr, d->irq_periph);
  647: 
  648: 	snprintf(tmpstr, sizeof(tmpstr), "%s.0x%x",
  649: 	    devinit->interrupt_path, CRIME_INT_PERIPH_MISC);
  650: 	INTERRUPT_CONNECT(tmpstr, d->irq_misc);
  651: 
  652: 	/*
  653: 	 *  For CRIME interrupts PERIPH_SERIAL and PERIPH_MISC,
  654: 	 *  register 32 mace interrupts each.
  655: 	 */
  656: 	for (i=0; i<32; i++) {
  657: 		struct interrupt templ;
  658: 		char name[400];
  659: 		snprintf(name, sizeof(name), "%s.0x%x.mace.%i",
  660: 		    devinit->interrupt_path, CRIME_INT_PERIPH_SERIAL, i);
  661: 		memset(&templ, 0, sizeof(templ));
  662:                 templ.line = i;
  663: 		templ.name = name;
  664: 		templ.extra = d;
  665: 		templ.interrupt_assert = mace_interrupt_assert;
  666: 		templ.interrupt_deassert = mace_interrupt_deassert;
  667: 		interrupt_handler_register(&templ);
  668: 
  669: 		snprintf(name, sizeof(name), "%s.0x%x.mace.%i",
  670: 		    devinit->interrupt_path, CRIME_INT_PERIPH_MISC, i);
  671: 		memset(&templ, 0, sizeof(templ));
  672:                 templ.line = i;
  673: 		templ.name = name;
  674: 		templ.extra = d;
  675: 		templ.interrupt_assert = mace_interrupt_assert;
  676: 		templ.interrupt_deassert = mace_interrupt_deassert;
  677: 		interrupt_handler_register(&templ);
  678:         }
  679: 
  680: 	memory_device_register(devinit->machine->memory, devinit->name,
  681: 	    devinit->addr, DEV_MACE_LENGTH, dev_mace_access, d,
  682: 	    DM_DEFAULT, NULL);
  683: 
  684: 	devinit->return_ptr = d;
  685: 	return 1;
  686: }
  687: 
  688: 
  689: /****************************************************************************/
  690: 
  691: 
  692: DEVICE_ACCESS(macepci)
  693: {
  694: 	struct macepci_data *d = (struct macepci_data *) extra;
  695: 	uint64_t idata = 0, odata=0;
  696: 	int res = 1, bus, dev, func, pcireg;
  697: 
  698: 	if (len != 4)
  699: 		fatal("[ macepci: unimplemented len %i ]\n", len);
  700: 
  701: 	if (writeflag == MEM_WRITE) {
  702: 		idata = memory_readmax64(cpu, data, len);
  703: #ifdef MACEPCI_DEBUG
  704: 		fatal("[ macepci: write to address 0x%x, data=0x%02x (len %i) ]\n",
  705: 		    (int)relative_addr, (int)idata, len);
  706: #endif
  707: 	}
  708: 
  709: 	/*  Read from/write to the macepci:  */
  710: 	switch (relative_addr) {
  711: 
  712: 	case 0x00:	/*  Error address  */
  713: 		if (writeflag == MEM_WRITE) {
  714: 		} else {
  715: 			/*  My real O2 returns 0x4000.  */
  716: 			odata = 0x4000;
  717: 		}
  718: 		break;
  719: 
  720: 	case 0x04:	/*  Error flags  */
  721: 		if (writeflag == MEM_WRITE) {
  722: 		} else {
  723: 			/*  My real O2 returns 0x00100006.  */
  724: 			odata = 0x00100006;
  725: 		}
  726: 		break;
  727: 
  728: 	case 0x08:	/*  TODO: Unknown?  */
  729: 		if (writeflag == MEM_WRITE) {
  730: 		} else {
  731: 			/*  My real O2 returns 0xff000500.  */
  732: 			odata = 0xff000500;
  733: 		}
  734: 		break;
  735: 
  736: 	case 0x0c:	/*  Revision number  */
  737: 		if (writeflag == MEM_WRITE) {
  738: 		} else {
  739: 			/*  My real O2 returns 0x00000001.  */
  740: 			odata = 0x00000001;
  741: 		}
  742: 		break;
  743: 
  744: 	case 0xcf8:	/*  PCI ADDR  */
  745: 		bus_pci_decompose_1(idata, &bus, &dev, &func, &pcireg);
  746: 		bus_pci_setaddr(cpu, d->pci_data, bus, dev, func, pcireg);
  747: 		break;
  748: 
  749: 	case 0xcfc:	/*  PCI DATA  */
  750: 		bus_pci_data_access(cpu, d->pci_data, writeflag == MEM_READ?
  751: 		    &odata : &idata, len, writeflag);
  752: 		break;
  753: 
  754: 	default:
  755: 		if (writeflag == MEM_WRITE) {
  756: 			fatal("[ macepci: unimplemented write to address "
  757: 			    "0x%x, data=0x%02x ]\n",
  758: 			    (int)relative_addr, (int)idata);
  759: 		} else {
  760: 			fatal("[ macepci: unimplemented read from address "
  761: 			    "0x%x ]\n", (int)relative_addr);
  762: 
  763: 			/*  My real O2 returns 0xffffffff for all unimplemented
  764: 				registers.  */
  765: 			odata = 0xffffffff;
  766: 		}
  767: 	}
  768: 
  769: 	if (writeflag == MEM_READ) {
  770: 		memory_writemax64(cpu, data, len, odata);
  771: #ifdef MACEPCI_DEBUG
  772: 		fatal("[ macepci: read from address 0x%x, data=0x%02x (len %i) ]\n",
  773: 		    (int)relative_addr, (int)odata, len);
  774: #endif
  775: 	}
  776: 
  777: 	return res;
  778: }
  779: 
  780: 
  781: /*
  782:  *  dev_macepci_init():
  783:  */
  784: struct pci_data *dev_macepci_init(struct machine *machine,
  785: 	struct memory *mem, uint64_t baseaddr, char *irq_path)
  786: {
  787: 	struct macepci_data *d;
  788: 
  789: 	CHECK_ALLOCATION(d = (struct macepci_data *) malloc(sizeof(struct macepci_data)));
  790: 	memset(d, 0, sizeof(struct macepci_data));
  791: 
  792: 	/*  TODO: PCI vs ISA interrupt?  */
  793: 
  794: 	d->pci_data = bus_pci_init(machine,
  795: 	    irq_path,
  796: 	    0,
  797: 	    0,
  798: 	    0,
  799: 	    0,
  800: 	    "TODO: pci irq path",
  801: 	    0x18000003,		/*  ISA portbase  */
  802: 	    0,
  803: 	    irq_path);
  804: 
  805: 	memory_device_register(mem, "macepci", baseaddr, DEV_MACEPCI_LENGTH,
  806: 	    dev_macepci_access, (void *)d, DM_DEFAULT, NULL);
  807: 
  808: 	return d->pci_data;
  809: }
  810: 
  811: 
  812: /****************************************************************************/
  813: 
  814: 
  815: struct sgi_ust_data {
  816: 	uint64_t	reg[DEV_SGI_UST_LENGTH / sizeof(uint64_t)];
  817: };
  818: 
  819: 
  820: DEVICE_ACCESS(sgi_ust)
  821: {
  822: 	struct sgi_ust_data *d = (struct sgi_ust_data *) extra;
  823: 	uint64_t idata = 0, odata = 0;
  824: 	int regnr;
  825: 
  826: 	idata = memory_readmax64(cpu, data, len);
  827: 	regnr = relative_addr / sizeof(uint64_t);
  828: 
  829: 	/*  Treat all registers as read/write, by default.  */
  830: 	if (writeflag == MEM_WRITE)
  831: 		d->reg[regnr] = idata;
  832: 	else
  833: 		odata = d->reg[regnr];
  834: 
  835: 	switch (relative_addr) {
  836: 	case 0:
  837: 		d->reg[regnr] += 0x2710;	// HUH?
  838: 		break;
  839: 	default:
  840: 		if (writeflag == MEM_WRITE)
  841: 			debug("[ sgi_ust: unimplemented write to "
  842: 			    "address 0x%llx, data=0x%016llx ]\n",
  843: 			    (long long)relative_addr, (long long)idata);
  844: 		else
  845: 			debug("[ sgi_ust: unimplemented read from address"
  846: 			    " 0x%llx ]\n", (long long)relative_addr);
  847: 	}
  848: 
  849: 	if (writeflag == MEM_READ)
  850: 		memory_writemax64(cpu, data, len, odata);
  851: 
  852: 	return 1;
  853: }
  854: 
  855: 
  856: /*
  857:  *  dev_sgi_ust_init():
  858:  */
  859: void dev_sgi_ust_init(struct memory *mem, uint64_t baseaddr)
  860: {
  861: 	struct sgi_ust_data *d;
  862: 
  863: 	CHECK_ALLOCATION(d = (struct sgi_ust_data *) malloc(sizeof(struct sgi_ust_data)));
  864: 	memset(d, 0, sizeof(struct sgi_ust_data));
  865: 
  866: 	memory_device_register(mem, "sgi_ust", baseaddr,
  867: 	    DEV_SGI_UST_LENGTH, dev_sgi_ust_access, (void *)d,
  868: 	    DM_DEFAULT, NULL);
  869: }
