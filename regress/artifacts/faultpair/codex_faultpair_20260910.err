  442: int
  443: vme2chip_init(sc)
  444: 	struct vmesoftc *sc;
  445: {
  446: 	struct vme2reg *vme2 = (struct vme2reg *)sc->sc_vaddr;
  447: 	u_long ctl;
  448: 
  449: 	/* turn off SYSFAIL LED */
  450: 	vme2->vme2_tctl &= ~VME2_TCTL_SYSFAIL;
  451: 
  452: 	ctl = vme2->vme2_masterctl;
  453: 
  454: #if 0
  455: 	/* unused decoders 1 & 2 */
  456: 	printf("%s: phys 0x%08x-0x%08x to VMExxx 0x%08x-0x%08x\n",
  457: 	    sc->sc_dev.dv_xname,
  458: 	    vme2->vme2_master1 << 16, vme2->vme2_master1 & 0xffff0000,
  459: 	    vme2->vme2_master1 << 16, vme2->vme2_master1 & 0xffff0000);
  460: 	printf("%s: phys 0x%08x-0x%08x to VMExxx 0x%08x-0x%08x\n",
  461: 	    sc->sc_dev.dv_xname,
  462: 	    vme2->vme2_master2 << 16, vme2->vme2_master2 & 0xffff0000,
  463: 	    vme2->vme2_master2 << 16, vme2->vme2_master2 & 0xffff0000);
  464: #endif
  465: 
  466: 	/* setup a D16 space */
  467: 	vme2->vme2_master3 = ((VME2_D16ENDPHYS-1) & 0xffff0000) |
  468: 	    (VME2_D16STARTPHYS >> 16);
  469: 	ctl &= ~(VME2_MASTERCTL_ALL << VME2_MASTERCTL_3SHIFT);
  470: 	ctl |= (VME2_MASTERCTL_AM32SP | VME2_MASTERCTL_D16) <<
  471: 	    VME2_MASTERCTL_3SHIFT;
  472: #if 0
  473: 	printf("%s: phys 0x%08x-0x%08x to VMED16 0x%08x-0x%08x\n",
  474: 	    sc->sc_dev.dv_xname,
  475: 	    VME2_D16STARTPHYS, VME2_D16ENDPHYS-1,
  476: 	    VME2_D16STARTPHYS, VME2_D16ENDPHYS-1);
  477: #endif
  478: 
  479: 	/* setup a D32 space */
  480: 	vme2->vme2_master4 = ((VME2_D32ENDPHYS-1) & 0xffff0000) |
  481: 	    (VME2_D32STARTPHYS >> 16);
  482: 	vme2->vme2_master4mod = (VME2_D32STARTVME & 0xffff0000) |
  483: 	    (VME2_D32BITSVME >> 16);
  484: 	ctl &= ~(VME2_MASTERCTL_ALL << VME2_MASTERCTL_4SHIFT);
  485: 	ctl |= (VME2_MASTERCTL_AM32SP) <<
  486: 	    VME2_MASTERCTL_4SHIFT;
  487: #if 0
  488: 	printf("%s: phys 0x%08x-0x%08x to VMED32 0x%08x-0x%08x\n",
  489: 	    sc->sc_dev.dv_xname,
  490: 	    VME2_D32STARTPHYS, VME2_D32ENDPHYS-1,
  491: 	    VME2_D32STARTVME, VME2_D32STARTVME | ~VME2_D32BITSVME);
  492: #endif
  493: 
  494: 	vme2->vme2_masterctl = ctl;
  495: 
  496: 	ctl = vme2->vme2_gcsrctl;
  497: 
  498: 	/* enable A16 short IO map decoder (0xffffxxxx) */
  499: 	ctl &= ~(VME2_GCSRCTL_I1EN | VME2_GCSRCTL_I1D16 | VME2_GCSRCTL_I1WP |
  500: 	    VME2_GCSRCTL_I1SU);
  501: 	ctl |= VME2_GCSRCTL_I1EN | VME2_GCSRCTL_I1D16 | VME2_GCSRCTL_I1SU;
  502: 
  503: 	/* enable A24D16 (0xf0xxxxxx) and A32D16 (0xf[1-e]xxxxxx) decoders */
