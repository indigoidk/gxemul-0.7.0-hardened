"raw": 2, "rawlines": 2, "lex": 2}, "src/machines/machine_test.c": {"raw": 1, "rawlines": 1, "lex": 0}, "src/net/net.c": {"raw": 1, "rawlines": 1, "lex": 1}, "src/net/net_misc.c": {"raw": 2, "rawlines": 2, "lex": 2}, "src/promemul/arcbios.c": {"raw": 9, "rawlines": 9, "lex": 6}, "src/promemul/dec_prom.c": {"raw": 2, "rawlines": 2, "lex": 0}, "src/promemul/dreamcast_scramble.c": {"raw": 15, "rawlines": 15, "lex": 15}, "src/promemul/of.c": {"raw": 12, "rawlines": 12, "lex": 7}, "src/promemul/ps2_bios.c": {"raw": 5, "rawlines": 5, "lex": 0}, "src/symbol/symbol.c": {"raw": 3, "rawlines": 3, "lex": 3}, "src/symbol/symbol_demangle.c": {"raw": 2, "rawlines": 2, "lex": 2}}, "rows": [{"p": "src/cpus/cpu.c", "n": 530, "fn": "*  Prepare to run instructions on all CPUs in this machine. (This function *  should only need to be called once for each machine.) */ void cpu_run_init(struct machine *machine)", "context": " | if (machine->ncpus == 0) { | printf(\"Machine with no CPUs? TODO.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm.c", "n": 561, "fn": "/* *  arm_save_register_bank(): */ void arm_save_register_bank(struct cpu *cpu)", "context": "break; | default:fatal(\"arm_save_register_bank: unimplemented mode %i\\n\", | cpu->cd.arm.cpsr & ARM_FLAG_MODE); | exit(1); | }"}, {"p": "src/cpus/cpu_arm.c", "n": 608, "fn": "/* *  arm_load_register_bank(): */ void arm_load_register_bank(struct cpu *cpu)", "context": "break; | default:fatal(\"arm_load_register_bank: unimplemented mode %i\\n\", | cpu->cd.arm.cpsr & ARM_FLAG_MODE); | exit(1); | }"}, {"p": "src/cpus/cpu_arm.c", "n": 623, "fn": "/* *  arm_exception(): */ void arm_exception(struct cpu *cpu, int exception_nr)", "context": " | if (exception_nr < 0 || exception_nr >= N_ARM_EXCEPTIONS) { | fatal(\"arm_exception(): exception_nr = %i\\n\", exception_nr); | exit(1); | }"}, {"p": "src/cpus/cpu_arm.c", "n": 661, "fn": "/* *  arm_exception(): */ void arm_exception(struct cpu *cpu, int exception_nr)", "context": "case ARM_EXCEPTION_RESET: | cpu->running = 0; | fatal(\"ARM RESET: TODO\"); | exit(1); | case ARM_EXCEPTION_DATA_ABT:"}, {"p": "src/cpus/cpu_arm.c", "n": 686, "fn": "/* *  arm_exception(): */ void arm_exception(struct cpu *cpu, int exception_nr)", "context": "case ARM_MODE_FIQ32: | cpu->cd.arm.spsr_fiq = cpu->cd.arm.cpsr; break; | default:fatal(\"arm_exception(): unimplemented exception nr\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 62, "fn": "*  The system control coprocessor. */ void arm_coproc_15(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "} | if (rd == ARM_PC) { | fatal(\"[ TODO: arm_coproc_15: rd = PC ]\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 177, "fn": "*  The system control coprocessor. */ void arm_coproc_15(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "of that install gate.  */ | fatal(\"ERROR: Trying to switch endianness. Not \" | \"supported yet.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 264, "fn": "*  The system control coprocessor. */ void arm_coproc_15(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "if (cpu->cd.arm.pid != 0) { | fatal(\"ARM TODO: pid!=0. Fast Context Switch\" | \" Extension not implemented yet\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 313, "fn": "*  Intel 80321 coprocessor 6. */ void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "case 0:\tif (l_bit) { | cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_inten; | fatal(\"TODO: XScale read from inten?\\n\"); | exit(1); | } else"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 324, "fn": "*  Intel 80321 coprocessor 6. */ void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "if (cpu->cd.arm.r[rd] != 0) { | fatal(\"ARM xscale interrupt steering\" | \" is not yet implemented\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 333, "fn": "*  Intel 80321 coprocessor 6. */ void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "else { | cpu->cd.arm.i80321_isrc = cpu->cd.arm.r[rd]; | fatal(\"TODO: XScale int ack?\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 419, "fn": "*  Intel 80321 coprocessor 6. */ void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "unknown: | fatal(\"arm_coproc_i80321_6: unimplemented opcode1=%i opcode2=%i crn=\" | \"%i crm=%i rd=%i l=%i)\\n\", opcode1, opcode2, crn, crm, rd, l_bit); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 530, "fn": "*  XScale coprocessor 14, Performance Monitoring Unit. */ void arm_coproc_xscale_14(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "fatal(\"arm_coproc_xscale_14: unimplemented opcode1=%i opcode2=\" | \"%i crn=%i crm=%i rd=%i l=%i)\\n\", opcode1, opcode2, crn, | crm, rd, l_bit); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_instr.c", "n": 72, "fn": "* *  uniq -c bdt_statistics.txt|sort -nr|head -256|cut -f 2 > cpu_arm_multi.txt */ static void update_bdt_statistics(uint32_t iw)", "context": "f = fopen(\"bdt_statistics.txt\", \"w\"); | if (f == NULL) { | fprintf(stderr, \"update_bdt_statistics(): :-(\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 732, "fn": "* *  Generic case. See DYNTRANS_PC_TO_POINTERS_FUNC below. */ void DYNTRANS_PC_TO_POINTERS_GENERIC(struct cpu *cpu)", "context": "if (!ok) { | fatal(\"FATAL: could not find physical\" | \" address of the exception handler?\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1079, "fn": "} #ifdef BUGHUNT", "context": "if (x1 != x1b && | l2 == cpu->cd.DYNTRANS_ARCH.l1_64[x1b]) { | fatal(\"L2 reuse: %p\\n\", l2); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1092, "fn": "} } /*  Count how many pages are actually in use:  */", "context": "n++; | if (n != l3->refcount) { | printf(\"Z: %i in use, but refcount = %i!\\n\", n, l3->refcount); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1101, "fn": "} } /*  Count how many pages are actually in use:  */", "context": "n++; | if (n != l3->refcount) { | printf(\"ZHL: %i in use, but refcount = %i!\\n\", n, l3->refcount); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1157, "fn": "} } /*  Count how many pages are actually in use:  */", "context": " | if (l3->refcount < 0) { | fatal(\"xxx_invalidate_tlb_entry(): huh? Refcount bug.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1173, "fn": "#ifdef BUGHUNT /*  Make sure that we're placing a CLEAN page on the freelist:  */", "context": "for (i=0; i<=mask3; i++) | if (l3->host_load[i] != NULL) { | fatal(\"TRYING TO RETURN A NON-CLEAN L3 PAGE!\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1180, "fn": "#ifdef BUGHUNT /*  Make sure that we're placing a CLEAN page on the freelist:  */", "context": "l2->refcount --; | if (l2->refcount < 0) { | fatal(\"xxx_invalidate_tlb_entry(): Refcount bug L2.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1506, "fn": "*  Update the virtual memory translation tables. */ void DYNTRANS_UPDATE_TRANSLATION_TABLE(struct cpu *cpu, uint64_t vaddr_page, unsigned char *host_page, int writeflag, uint64_t paddr_page)", "context": "fatal(\"update_translation_table(): v=0x%016\" PRIx64\", h=%p w=%i\" | \" p=0x%016\" PRIx64\"\\n\", vaddr_page, host_page, writeflag, | paddr_page); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1625, "fn": "*  Update the virtual memory translation tables. */ void DYNTRANS_UPDATE_TRANSLATION_TABLE(struct cpu *cpu, uint64_t vaddr_page, unsigned char *host_page, int writeflag, uint64_t paddr_page)", "context": "} | if (l2->refcount != 0) { | fatal(\"Huh? l2 Refcount problem.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1630, "fn": "*  Update the virtual memory translation tables. */ void DYNTRANS_UPDATE_TRANSLATION_TABLE(struct cpu *cpu, uint64_t vaddr_page, unsigned char *host_page, int writeflag, uint64_t paddr_page)", "context": "} | if (l2 == cpu->cd.DYNTRANS_ARCH.l2_64_dummy) { | fatal(\"INTERNAL ERROR L2 reuse\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1645, "fn": "*  Update the virtual memory translation tables. */ void DYNTRANS_UPDATE_TRANSLATION_TABLE(struct cpu *cpu, uint64_t vaddr_page, unsigned char *host_page, int writeflag, uint64_t paddr_page)", "context": "} | if (l3->refcount != 0) { | fatal(\"Huh? l3 Refcount problem.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1651, "fn": "*  Update the virtual memory translation tables. */ void DYNTRANS_UPDATE_TRANSLATION_TABLE(struct cpu *cpu, uint64_t vaddr_page, unsigned char *host_page, int writeflag, uint64_t paddr_page)", "context": "} | if (l3 == cpu->cd.DYNTRANS_ARCH.l3_64_dummy) { | fatal(\"INTERNAL ERROR L3 reuse\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1670, "fn": "l3->refcount ++; #ifdef BUGHUNT /*  Count how many pages are actually in use:  */", "context": "n++; | if (n != l3->refcount) { | printf(\"X: %i in use, but refcount = %i!\\n\", n, l3->refcount); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1679, "fn": "l3->refcount ++; #ifdef BUGHUNT /*  Count how many pages are actually in use:  */", "context": "n++; | if (n != l3->refcount) { | printf(\"XHL: %i in use, but refcount = %i!\\n\", n, l3->refcount); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1751, "fn": "//l3->phys_page[x3] = NULL; #ifdef BUGHUNT /*  Count how many pages are actually in use:  */", "context": "n++; | if (n != l3->refcount) { | printf(\"Y: %i in use, but refcount = %i!\\n\", n, l3->refcount); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1763, "fn": "//l3->phys_page[x3] = NULL; #ifdef BUGHUNT /*  Count how many pages are actually in use:  */", "context": "printf(\"Entry r = %i\\n\", r); | printf(\"Valid = %i\\n\", | cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 303, "fn": "* *  Helper function, called from mips_coproc_new(). */ static void initialize_cop0_config(struct cpu *cpu, struct mips_coproc *c)", "context": "break; | default:fatal(\"Internal error: No initialization code for\" | \" config0? cpu rev = 0x%x\", cpu->cd.mips.cpu_type.rev); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 446, "fn": "void mips_coproc_tlb_set_entry(struct cpu *cpu, int entrynr, int size, uint64_t vaddr, uint64_t paddr0, uint64_t paddr1, int valid0, int valid1, int dirty0, int dirty1, int global, int asid, int cachealgo0, int cachealgo1)", "context": "if (entrynr < 0 || entrynr >= cpu->cd.mips.coproc[0]->nr_of_tlbs) { | printf(\"mips_coproc_tlb_set_entry(): invalid entry nr: %i\\n\", | entrynr); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 454, "fn": "void mips_coproc_tlb_set_entry(struct cpu *cpu, int entrynr, int size, uint64_t vaddr, uint64_t paddr0, uint64_t paddr1, int valid0, int valid1, int dirty0, int dirty1, int global, int asid, int cachealgo0, int cachealgo1)", "context": "if (size != 4096) { | printf(\"mips_coproc_tlb_set_entry(): invalid pagesize \" | \"(%i) for MMU3K\\n\", size); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 1518, "fn": "*  Debug trace should be printed for known instructions. */ static int fpu_function(struct cpu *cpu, struct mips_coproc *cp, uint32_t function, int unassemble_only)", "context": "fatal(\"INTERNAL ERROR: MIPS coprocessor branches should not\" | \" be implemented in cpu_mips_coproc.c, but in\" | \" cpu_mips_instr.c!\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 2041, "fn": "* *  MIPS TLB write random (tlbwr) and write indexed (tlbwi) instructions. */ void coproc_tlbwri(struct cpu *cpu, int randomflag)", "context": "if (cp->tlbs[index].lo0 & ENTRYLO_V || | cp->tlbs[index].lo1 & ENTRYLO_V) { | fatal(\"1KB pages don't work with dyntrans.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 2169, "fn": "* *  MIPS TLB write random (tlbwr) and write indexed (tlbwi) instructions. */ void coproc_tlbwri(struct cpu *cpu, int randomflag)", "context": "if (cp->tlbs[index].lo0 & ENTRYLO_V || | cp->tlbs[index].lo1 & ENTRYLO_V) { | fatal(\"1KB pages don't work with dyntrans.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 2489, "fn": "*  TODO:  This is a mess and should be restructured (again). */ void coproc_function(struct cpu *cpu, struct mips_coproc *cp, int cpnr, uint32_t function, int unassemble_only, int running)", "context": "if (!unassemble_only) { | fatal(\"FATAL INTERNAL ERROR: Should be implemented\" | \" with dyntrans instead.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_instr.c", "n": 123, "fn": "/* *  invalid:  For catching bugs. */ X(invalid)", "context": "fatal(\"FATAL ERROR: An internal error occured in the MIPS\" | \" dyntrans code. Please contact the author with detailed\" | \" repro steps on how to trigger this bug.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_instr.c", "n": 2650, "fn": "/* *  promemul:  PROM software emulation. */ X(promemul)", "context": "res = yamon_emul(cpu); | break; | default:fatal(\"TODO: Unimplemented machine type for PROM magic trap\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_instr.c", "n": 3798, "fn": "} X(end_of_page2)", "context": "return; |  | fatal(\"end_of_page2: fatal error, we're in a delay slot\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_ppc_instr.c", "n": 244, "fn": "/* *  invalid:  To catch bugs. */ X(invalid)", "context": "X(invalid) | { | fatal(\"PPC: invalid(): INTERNAL ERROR\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_ppc_instr.c", "n": 2307, "fn": "* *  arg[0] = copy of the instruction word. */ X(llsc)", "context": "if (load) { | if (rc) { | fatal(\"ll: rc-bit set?\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_ppc_instr.c", "n": 2333, "fn