, "fn": "} int main(int argc, char *argv[])", "context": "if (s[0] == '0') { | if (n_opcodes > max) { | fprintf(stderr, \"too many opcodes\\n\"); | exit(1); | }"}, {"p": "src/cpus/experiment_arm_multi.c", "n": 132, "fn": "} int main(int argc, char *argv[])", "context": "max_len = malloc(sizeof(int) * (1 << 25)); | if (max_len == NULL) { | fprintf(stderr, \"out of memory\\n\"); | exit(1); | }"}, {"p": "src/cpus/generate_arm_loadstore.c", "n": 46, "fn": "\"eq\", \"ne\", \"cs\", \"cc\", \"mi\", \"pl\", \"vs\", \"vc\", \"hi\", \"ls\", \"ge\", \"lt\", \"gt\", \"le\", \"\", \"\" }; int main(int argc, char *argv[])", "context": "} else { | if (argc != 4) { | fprintf(stderr, \"puw missing?\\n\"); | exit(1); | }"}, {"p": "src/cpus/generate_arm_multi.c", "n": 64, "fn": "*\to)  For accesses that cross page boundaries, use two pages using *\t    the fast method instead of calling the generic function? */ void generate_opcode(uint32_t opcode)", "context": "if ((opcode & 0x0e000000) != 0x08000000) { | fprintf(stderr, \"opcode 0x%08\"PRIx32\" is not an ldm/stm\\n\", | opcode); | exit(1); | }"}, {"p": "src/cpus/generate_arm_multi.c", "n": 83, "fn": "*\to)  For accesses that cross page boundaries, use two pages using *\t    the fast method instead of calling the generic function? */ void generate_opcode(uint32_t opcode)", "context": "if (n_regs == 0) { | fprintf(stderr, \"opcode 0x%08\"PRIx32\" has no registers set\\n\", | opcode); | exit(1); | }"}, {"p": "src/cpus/generate_arm_multi.c", "n": 88, "fn": "*\to)  For accesses that cross page boundaries, use two pages using *\t    the fast method instead of calling the generic function? */ void generate_opcode(uint32_t opcode)", "context": " | if (s) { | fprintf(stderr, \"opcode 0x%08\"PRIx32\" has s-bit set\\n\", opcode); | exit(1); | }"}, {"p": "src/cpus/generate_arm_multi.c", "n": 93, "fn": "*\to)  For accesses that cross page boundaries, use two pages using *\t    the fast method instead of calling the generic function? */ void gene