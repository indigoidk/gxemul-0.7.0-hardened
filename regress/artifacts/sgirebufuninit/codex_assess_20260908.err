  323: 			buf[3] = *color;
  324: 			break;
  325: 		case DE_MODE_TYPE_ABGR:
  326: 			buf[0] = *color;
  327: 			buf[1] = *color >> 8;
  328: 			buf[2] = *color >> 16;
  329: 			buf[3] = *color >> 24;
  330: 			break;
  331: 		default:buf[0] = random();
  332: 			buf[1] = random();
  333: 			buf[2] = random();
  334: 			buf[3] = random();
  335: 			// TODO.
  336: 			fatal("[ put: color mode = 0x%x ]\n", color_mode);
  337: 		}
  338: 
  339: 		cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
  340: 		    buf, bufdepth, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  341: 	} else {
  342: 		cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
  343: 		    buf, bufdepth, MEM_READ, NO_EXCEPTIONS | PHYSICAL);
  344: 
  345: 		switch (color_mode) {
  346: 		case DE_MODE_TYPE_CI:
  347: 			*color = buf[0];
  348: 			break;
  349: 		case DE_MODE_TYPE_RGB:
  350: 			/*  #505: this read buf[1..3] while the PUT arm above
  351: 			    writes the three channels at buf[0..2] and an
  352: 			    explicit pad at buf[3] -- so an RGB pixel did not
  353: 			    survive its own round trip, shifting one byte left
  354: 			    with a zero fill on every RGB source read.
  355: 
  356: 			    The PUT arm is the authoritative one, and the
  357: 			    warrant is OUTSIDE this function: dev_sgi_gbe.c's
  358: 			    scanout reads the same tile memory back for display
  359: 			    as (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3],
  360: 			    then CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
  361: 			    31..24, 23..16 and 15..8 -- byte 0 is R and byte 3
  362: 			    is UNUSED.  So the pad sits at buf[3] because the
  363: 			    consumer ignores buf[3], not because PUT writes a
  364: 			    zero there; that is what makes this non-circular.
  365: 			    The RGBA and ABGR PUT arms independently agree --
  366: 			    both lay [R,G,B,x] in memory despite opposite
  367: 			    register word orders -- which leaves this GET the
  368: 			    lone container outlier among the 32-bit arms.
  369: 
  370: 			    The low byte stays ZERO on purpose: RGB carries
  371: 			    three channels, so a corrected read of 0xaabbccdd
  372: 			    yields 0xaabbcc00, NOT the source word.  */
  373: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
  374: 			break;
  375: 		case DE_MODE_TYPE_RGBA:
  376: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
  377: 			break;
  378: 		case DE_MODE_TYPE_ABGR:
  379: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
  380: 			break;
  381: 		default:// Read "raw" 32-bit value:
  382: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
  383: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
  384: 		}
  385: 	}
  386: }
  387: 
  388: 
  389: /*
  390:  *  SGI "re", NetBSD sources describes it as a "rendering engine".
  391:  */
  392: 
  393: DEVICE_ACCESS(sgi_re)
  394: {
  395: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
  396: 	uint64_t idata = 0, odata = 0;
  397: 
  398: 	idata = memory_readmax64(cpu, data, len);
  399: 
  400: 	relative_addr += 0x1000;
  401: 
  402: 	/*
  403: 	 *  #497: THE SIX WIDTH GUARDS BELOW USED TO END THE HOST PROCESS.
  404: 	 *
  405: 	 *  A guest choosing an access width is not an emulator error, so each
  406: 	 *  `len != 8' arm now DECLINES the access and announces itself once.
  407: 	 *  Three properties of the shape are load-bearing:
  408: 	 *
  409: 	 *  1. It is an `else if' SPLICE, not an early return.  A `return' here
  410: 	 *     would skip this function's common tail, and `return 0' would be
  411: 	 *     coerced to -1 by cpus/memory_rw.c and raise EXCEPTION_DBE in the
  412: 	 *     guest -- turning a declined access into a guest bus error.
  413: 	 *
  414: 	 *  2. Control therefore reaches the tail, which answers a declined READ
  415: 	 *     with odata (0).
  416: 	 *
  417: 	 *     *** THIS PARAGRAPH ONCE CALLED THAT TAIL DEAD CODE -- "every read arm
  418: 	 *     below still exit(1)s, so odata is never assigned today".  #499 MADE IT
  419: 	 *     LIVE: the unmatched-address catch-all no longer exits, so a declined
  420: 	 *     read now runs the tail and lands a defined 0, and the shipped detector's
  421: 	 *     `rd sent' row exists to pin exactly that.  The six `TODO: read from'
  422: 	 *     arms below DO still exit(1) -- that half is unchanged and is sgirekills. ***
  423: 	 *
  424: 	 *     *** AND THAT HALF IS NOW GONE TOO: #513 REMOVED ALL SIX.  The tail is
  425: 	 *     reached by more than declines now -- five of the six arms ASSIGN odata
  426: 	 *     and let the tail deliver it, so the tail is the ACCEPT path as well as
  427: 	 *     the decline path.  The sentence above is #499's and was true when
  428: 	 *     written; it stands with its correction, as #499's own does. ***
  429: 	 *
  430: 	 *  3. The guards are NOT redundant.  For TLB_A/B/C and TEX the store is a
  431: 	 *     `for (hwi = 0; hwi < len; ...)' loop, so a narrower access simply
  432: 	 *     runs fewer iterations and stays in bounds -- there the guard is
  433: 	 *     modelling fidelity only.  For LINEAR_A and LINEAR_B it is not; see
  434: 	 *     the note at those two sites.
  435: 	 *
  436: 	 *  Only the WIDTH kills change HERE, IN #497.  The six `TODO: read from ...'
  437: 	 *  kills are still untouched.
  438: 	 *
  439: 	 *  *** UNTRUE SINCE #513, WHICH IS THE ROUND THAT TOOK THEM.  Five became
  440: 	 *  ACCEPTs (the read returns what the write stored) and CRIME_RE_TEX became a
  441: 	 *  latched decline.  #497's sentence was accurate for #497 and is kept for the
  442: 	 *  same reason the catch-all correction below is kept: a reader arriving from
  443: 	 *  #497's records has to be able to see which half moved and when. ***
  444: 	 *
  445: 	 *  *** THE CATCH-ALL IS NO LONGER UNTOUCHED: #499 DE-FATALISED IT and that row
  446: 	 *  is CLOSED.  The sentence is #497's and was true when written; it is left
  447: 	 *  standing with its correction rather than rewritten, because a reader
  448: 	 *  arriving from #497's records needs to see which half moved. ***  The READ
  449: 	 *  arms are
  450: 	 *  `sgirekills`, the CATCH-ALL is `sgireunmapped` (two different rows: one is a
  451: 	 *  direction, the other an unmatched address with no width predicate at all), as is
  452: 	 *  DEVICE_ACCESS(sgi_de)'s own width kill, whose accept set is {4,8}
  453: 	 *  rather than {8} (sgidewidth).
  454: 	 */
  455: 	if (relative_addr >= CRIME_RE_TLB_A && relative_addr < CRIME_RE_TLB_B) {
  456: 		if (len != 8) {
  457: 			if (!(d->warned & SGIRE_W_TLBA_LEN)) {
  458: 				d->warned |= SGIRE_W_TLBA_LEN;
  459: 				fatal("[ sgi_re: unimplemented len=%i for "
  460: 				    "CRIME_RE_TLB_A -- declined.  (once) ]\n",
  461: 				    (int) len);
  462: 			}
  463: 		} else if (writeflag == MEM_WRITE) {
  464: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  465: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  466: 				d->re_tlb_a[tlbi] = data[hwi]*256 + data[hwi+1];
  467: 				debug("d->re_tlb_a[%i] = 0x%04x\n", tlbi, d->re_tlb_a[tlbi]);
  468: 				tlbi++;
  469: 			}
  470: 		} else {
  471: 			/*
  472: 			 *  #513: ACCEPT.  A guest read of a len == 8 TLB slot ended
  473: 			 *  the host.  The write arm directly above already computes
  474: 			 *  and stores the value, so the disposition is member 4 of
  475: 			 *  the option set -- delete the kill and RETURN THE VALUE --
  476: 			 *  rather than a decline: nothing is unimplemented here.
  477: 			 *  This loop is the exact inverse of the write loop, cell for
  478: 			 *  cell and shift for shift.
  479: 			 *
  480: 			 *  *** IT MUST WRITE odata, NOT data[]. ***  The function's
  481: 			 *  common tail is
  482: 			 *      if (writeflag == MEM_READ)
  483: 			 *              memory_writemax64(cpu, data, len, odata);
  484: 			 *  so anything stored into data[] here is overwritten before
  485: 			 *  it reaches the guest.  A first draft of this fix filled
  486: 			 *  data[] and would have returned zeroes while looking right.
  487: 			 */
  488: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  489: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  490: 				odata = (odata << 16) | d->re_tlb_a[tlbi];
  491: 				tlbi++;
  492: 			}
  493: 		}
  494: 	} else if (relative_addr >= CRIME_RE_TLB_B && relative_addr < CRIME_RE_TLB_C) {
  495: 		if (len != 8) {
  496: 			if (!(d->warned & SGIRE_W_TLBB_LEN)) {
  497: 				d->warned |= SGIRE_W_TLBB_LEN;
  498: 				fatal("[ sgi_re: unimplemented len=%i for "
  499: 				    "CRIME_RE_TLB_B -- declined.  (once) ]\n",
  500: 				    (int) len);
  501: 			}
  502: 		} else if (writeflag == MEM_WRITE) {
  503: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  504: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  505: 				d->re_tlb_b[tlbi] = data[hwi]*256 + data[hwi+1];
  506: 				debug("d->re_tlb_b[%i] = 0x%04x\n", tlbi, d->re_tlb_b[tlbi]);
  507: 				tlbi++;
  508: 			}
  509: 		} else {
  510: 			/*  #513: ACCEPT -- the inverse of the write loop.  See the
  511: 			    CRIME_RE_TLB_A arm for why this sets odata, not data[].  */
  512: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  513: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  514: 				odata = (odata << 16) | d->re_tlb_b[tlbi];
  515: 				tlbi++;
  516: 			}
  517: 		}
  518: 	} else if (relative_addr >= CRIME_RE_TLB_C && relative_addr < CRIME_RE_TLB_C + 0x200) {
  519: 		if (len != 8) {
  520: 			if (!(d->warned & SGIRE_W_TLBC_LEN)) {
  521: 				d->warned |= SGIRE_W_TLBC_LEN;
  522: 				fatal("[ sgi_re: unimplemented len=%i for "
  523: 				    "CRIME_RE_TLB_C -- declined.  (once) ]\n",
  524: 				    (int) len);
  525: 			}
  526: 		} else if (writeflag == MEM_WRITE) {
  527: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  528: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  529: 				d->re_tlb_c[tlbi] = data[hwi]*256 + data[hwi+1];
  530: 				debug("d->re_tlb_c[%i] = 0x%04x\n", tlbi, d->re_tlb_c[tlbi]);
  531: 				tlbi++;
  532: 			}
  533: 		} else {
  534: 			/*  #513: ACCEPT -- the inverse of the write loop.  See the
  535: 			    CRIME_RE_TLB_A arm for why this sets odata, not data[].  */
  536: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  537: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  538: 				odata = (odata << 16) | d->re_tlb_c[tlbi];
  539: 				tlbi++;
  540: 			}
  541: 		}
  542: 	} else if (relative_addr >= CRIME_RE_TEX && relative_addr < CRIME_RE_TEX + 0xe0) {
  543: 		if (len != 8) {
  544: 			if (!(d->warned & SGIRE_W_TEX_LEN)) {
  545: 				d->warned |= SGIRE_W_TEX_LEN;
  546: 				fatal("[ sgi_re: unimplemented len=%i for "
  547: 				    "CRIME_RE_TEX -- declined.  (once) ]\n",
  548: 				    (int) len);
  549: 			}
  550: 		} else if (writeflag == MEM_WRITE) {
  551: 			int tlbi = ((relative_addr & 0xff) >> 3) & 0xff;
  552: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  553: 				d->re_tex[tlbi] = data[hwi]*256 + data[hwi+1];
  554: 				debug("d->re_tex[%i] = 0x%04x\n", tlbi, d->re_tex[tlbi]);
  555: 				tlbi++;
  556: 			}
  557: 		} else {
  558: 			/*
  559: 			 *  #513: DECLINE + LATCHED ANNOUNCE -- and TEX is the ONE arm
  560: 			 *  of the six that is NOT an accept.  The warrant is specific
  561: 			 *  and is recorded as `sgitexindex':
  562: 			 *
  563: 			 *    - the write arm's index is `>> 3' where a flat
  564: 			 *      uint16_t[112] incremented once per halfword needs the
  565: 			 *      register number times four.  The SGI CRIME specification
  566: 			 *      lists TLB.tex[28] as 28 separate 64-bit registers, so
  567: 			 *      `>> 3' is the REGISTER number and the missing factor of
  568: 			 *      four is the defect;
  569: 			 *    - consequently only 31 of the 112 cells are reachable and
  570: 			 *      consecutive registers overlap by three;
  571: 			 *    - `re_tex' has NO consumer anywhere in this file -- it is
  572: 			 *      written and debug-printed, never read back.
  573: 			 *
  574: 			 *  Accepting the read would therefore publish a mapping the
  575: 			 *  project has already recorded as wrong, and turn a future
  576: 			 *  sgitexindex fix into a breaking change to a shipped oracle.
  577: 			 *  Declining costs nothing today (no consumer) and leaves that
  578: 			 *  round free.  sgitexindex carries a standing do-not-code
  579: 			 *  ruling, so this round does not touch the shift.
  580: 			 */
  581: 			if (!(d->warned & SGIRE_W_TEX_RD)) {
  582: 				d->warned |= SGIRE_W_TEX_RD;
  583: 				fatal("[ sgi_re: unimplemented read from "
  584: 				    "CRIME_RE_TEX -- declined.  (once) ]\n");
  585: 			}
  586: 		}
  587: 	} else if (relative_addr >= CRIME_RE_LINEAR_A && relative_addr < CRIME_RE_LINEAR_A + 0x80) {
  588: 		if (len != 8) {
  589: 			/*
  590: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  591: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  592: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  593: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  594: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  595: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  596: 			 *  alignment is supplied by two independent mechanisms, and both
  597: 			 *  were checked rather than assumed:
  598: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  599: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  600: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  601: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  602: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  603: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
  604: 			 *      three of its memory_rw calls, so it cannot deliver an
  605: 			 *      unaligned len == 8 either.
  606: 			 *  Narrower accesses carry len != 8 and are declined above, and
  607: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  608: 			 *  so no other CPU family reaches this handler.
  609: 			 *
  610: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  611: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  612: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  613: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  614: 			 *  the invariant above is stated for GUEST paths only.  It also
  615: 			 *  means `put d' must NOT be used to "witness" the over-run:
  616: 			 *  it bypasses the guest instruction path, so a reproduction
  617: 			 *  built on it would be laundering rather than witnessing.
  618: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  619: 			 *  NOT guest-reachable while this guard stands.
  620: 			 *
  621: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  622: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  623: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  624: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  625: 			 *  reaching a DRAWING-engine register from a rendering-engine
  626: 			 *  write -- not a wild write outside the allocation, and not
  627: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  628: 			 */
  629: 			if (!(d->warned & SGIRE_W_LINA_LEN)) {
  630: 				d->warned |= SGIRE_W_LINA_LEN;
  631: 				fatal("[ sgi_re: unimplemented len=%i for "
  632: 				    "CRIME_RE_LINEAR_A -- declined.  (once) ]\n",
  633: 				    (int) len);
  634: 			}
  635: 		} else if (writeflag == MEM_WRITE) {
  636: 			/*
  637: 			 *  Very interesting. NetBSD writes stuff such as:
  638: 			 *
  639: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173080001731
  640: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173280001733
  641: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173480001735
  642: 			 *  ...
  643: 			 *
  644: 			 *  but the PROM writes something which looks like wrongly
  645: 			 *  32-bit sign-extended words:
  646: 			 *
  647: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040001
  648: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040003
  649: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040005
  650: 			 *  ...
  651: 			 *
  652: 			 *  followed by
  653: 			 *  [ sgi_mte: STARTING TRANSFER: mode=0x00000011
  654: 			 *    dst0=0x0000000040000000, dst1=0x0000000040007fff
  655: 			 *    (length 0x8000), dst_y_step=0 bg=0x0, bytemask=0xffffffff ]
  656: 			 *
  657: 			 *  indicating that it really meant to put both 0x80040000
  658: 			 *  and 0x80040001 into the first LINEAR_A entry.
  659: 			 *
  660: 			 *  The first guess would be a bug in the implementation of
  661: 			 *  one or more instructions in the emulator while coming up
  662: 			 *  with those values, but debugging the PROM so far has NOT
  663: 			 *  revealed any such bug. It may even be that the PROM code
  664: 			 *  is buggy (?) and never really set the LINEAR entries
  665: 			 *  correctly. Perhaps the hardware simply ignores the
  666: 			 *  weird values and does not fill it (using the MTE)
  667: 			 *  when asked to.
  668: 			 */
  669: 			// printf("CRIME_RE_LINEAR_A IDATA = %016llx\n", (long long)idata);
  670: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  671: 			d->re_linear_a[tlbi] = idata >> 32ULL;
  672: 			d->re_linear_a[tlbi+1] = idata;
  673: 			debug("[ d->re_linear_a[%i] = 0x%08x, [%i] = 0x%08x ]\n",
  674: 				tlbi, d->re_linear_a[tlbi], tlbi+1, d->re_linear_a[tlbi+1]);
  675: 		} else {
  676: 			/*
  677: 			 *  #513: ACCEPT -- the inverse of the fixed-arity write
  678: 			 *  directly above.  See CRIME_RE_TLB_A for the odata note.
  679: 			 *
  680: 			 *  The [tlbi+1] here has the SAME exposure as the write's
  681: 			 *  [tlbi+1] and no more, which is `sgilinearoob'.
  682: 			 *
  683: 			 *  *** AN EARLIER WORDING OF THIS SENTENCE SAID THE TWO ARE
  684: 			 *  "bounded only by the len == 8 guard keeping tlbi even".
  685: 			 *  THAT IS FALSE: WIDTH DOES NOT IMPLY ALIGNMENT.  The guard
  686: 			 *  tests LENGTH.  What keeps tlbi even is the CPU-side
  687: 			 *  alignment described at the write arm above -- ld/sd raise
  688: 			 *  ADES/ADEL before memory_rw, and the unaligned helper masks
  689: 			 *  the address itself.  Corrected on this round's pass 2;
  690: 			 *  the older surrounding comment had it right and my new one
  691: 			 *  did not. ***  This fix
  692: 			 *  deliberately does NOT add a clamp -- an unlicensed addition
  693: 			 *  here would change the index behaviour that sgilinearoob is
  694: 			 *  filed to fix across all five arms with ONE design.
  695: 			 */
  696: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  697: 			odata = ((uint64_t) d->re_linear_a[tlbi] << 32)
  698: 			    | d->re_linear_a[tlbi+1];
  699: 		}
  700: 	} else if (relative_addr >= CRIME_RE_LINEAR_B && relative_addr < CRIME_RE_LINEAR_B + 0x80) {
  701: 		if (len != 8) {
  702: 			/*
  703: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  704: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  705: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  706: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  707: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  708: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  709: 			 *  alignment is supplied by two independent mechanisms, and both
  710: 			 *  were checked rather than assumed:
  711: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  712: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  713: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  714: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  715: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  716: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
  717: 			 *      three of its memory_rw calls, so it cannot deliver an
  718: 			 *      unaligned len == 8 either.
  719: 			 *  Narrower accesses carry len != 8 and are declined above, and
  720: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  721: 			 *  so no other CPU family reaches this handler.
  722: 			 *
  723: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  724: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  725: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  726: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  727: 			 *  the invariant above is stated for GUEST paths only.  It also
  728: 			 *  means `put d' must NOT be used to "witness" the over-run:
  729: 			 *  it bypasses the guest instruction path, so a reproduction
  730: 			 *  built on it would be laundering rather than witnessing.
  731: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  732: 			 *  NOT guest-reachable while this guard stands.
  733: 			 *
  734: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  735: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  736: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  737: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  738: 			 *  reaching a DRAWING-engine register from a rendering-engine
  739: 			 *  write -- not a wild write outside the allocation, and not
  740: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  741: 			 */
  742: 			if (!(d->warned & SGIRE_W_LINB_LEN)) {
  743: 				d->warned |= SGIRE_W_LINB_LEN;
  744: 				fatal("[ sgi_re: unimplemented len=%i for "
  745: 				    "CRIME_RE_LINEAR_B -- declined.  (once) ]\n",
  746: 				    (int) len);
  747: 			}
  748: 		} else if (writeflag == MEM_WRITE) {
  749: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  750: 			d->re_linear_b[tlbi] = idata >> 32ULL;
  751: 			d->re_linear_b[tlbi+1] = idata;
  752: 			debug("[ d->re_linear_b[%i] = 0x%08x, [%i] = 0x%08x ]\n",
  753: 				tlbi, d->re_linear_b[tlbi], tlbi+1, d->re_linear_b[tlbi+1]);
  754: 		} else {
  755: 			/*
  756: 			 *  #513: ACCEPT -- the inverse of the fixed-arity write
  757: 			 *  directly above.  See CRIME_RE_TLB_A for the odata note.
  758: 			 *
  759: 			 *  The [tlbi+1] here has the SAME exposure as the write's
  760: 			 *  [tlbi+1] and no more, which is `sgilinearoob'.
  761: 			 *
  762: 			 *  *** AN EARLIER WORDING OF THIS SENTENCE SAID THE TWO ARE
  763: 			 *  "bounded only by the len == 8 guard keeping tlbi even".
  764: 			 *  THAT IS FALSE: WIDTH DOES NOT IMPLY ALIGNMENT.  The guard
  765: 			 *  tests LENGTH.  What keeps tlbi even is the CPU-side
  766: 			 *  alignment described at the write arm above -- ld/sd raise
  767: 			 *  ADES/ADEL before memory_rw, and the unaligned helper masks
  768: 			 *  the address itself.  Corrected on this round's pass 2;
  769: 			 *  the older surrounding comment had it right and my new one
  770: 			 *  did not. ***  This fix
  771: 			 *  deliberately does NOT add a clamp -- an unlicensed addition
  772: 			 *  here would change the index behaviour that sgilinearoob is
  773: 			 *  filed to fix across all five arms with ONE design.
  774: 			 */
  775: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  776: 			odata = ((uint64_t) d->re_linear_b[tlbi] << 32)
  777: 			    | d->re_linear_b[tlbi+1];
  778: 		}
  779: 	} else {
  780: 		if (writeflag == MEM_WRITE) {
  781: 			if (!(d->warned & SGIRE_W_UNMAP_WR)) {
  782: 				d->warned |= SGIRE_W_UNMAP_WR;
  783: 				fatal("[ sgi_re: unimplemented write to "
  784: 				    "address 0x%llx, data=0x%016llx -- "
  785: 				    "declined.  (once) ]\n",
  786: 				    (long long)relative_addr, (long long)idata);
  787: 			}
  788: 		} else {
  789: 			if (!(d->warned & SGIRE_W_UNMAP_RD)) {
  790: 				d->warned |= SGIRE_W_UNMAP_RD;
  791: 				fatal("[ sgi_re: unimplemented read from address"
  792: 				    " 0x%llx -- declined.  (once) ]\n",
  793: 				    (long long)relative_addr);
  794: 			}
  795: 		}
  796: 	}
  797: 
  798: 	if (writeflag == MEM_READ)
  799: 		memory_writemax64(cpu, data, len, odata);
  800: 
  801: 	return 1;
  802: }
  803: 
  804: 
  805: /*
  806:  *  dev_sgi_re_init():
  807:  */
  808: void dev_sgi_re_init(struct machine *machine, struct memory *mem, uint64_t baseaddr)
  809: {
  810: 	struct sgi_re_data *d;
  811: 
  812: 	CHECK_ALLOCATION(d = (struct sgi_re_data *) malloc(sizeof(struct sgi_re_data)));
  813: 	memset(d, 0, sizeof(struct sgi_re_data));
  814: 
  815: 	memory_device_register(mem, "sgi_re", baseaddr + 0x1000, DEV_SGI_RE_LENGTH,
  816: 	    dev_sgi_re_access, d, DM_DEFAULT, NULL);
  817: 
  818: 	dev_sgi_de_init(mem, baseaddr + 0x2000, d);
  819: 	dev_sgi_mte_init(mem, baseaddr + 0x3000, d);
  820: 	dev_sgi_de_status_init(mem, baseaddr + 0x4000, d);
  821: }
  822: 
  823: 
  824: 
  825: /****************************************************************************/
  826: 
  827: /*
  828:  *  SGI "de", NetBSD sources describes it as a "drawing engine".
  829:  */
  830: 
  831: void draw_primitive(struct cpu* cpu, struct sgi_re_data *d)
  832: {
  833: 	uint32_t op = d->de_reg[(CRIME_DE_PRIMITIVE - 0x2000) / sizeof(uint32_t)];
  834: 	uint32_t drawmode = d->de_reg[(CRIME_DE_DRAWMODE - 0x2000) / sizeof(uint32_t)];
  835: 	uint32_t dst_mode = d->de_reg[(CRIME_DE_MODE_DST - 0x2000) / sizeof(uint32_t)];
  836: 	uint32_t src_mode = d->de_reg[(CRIME_DE_MODE_SRC - 0x2000) / sizeof(uint32_t)];
  837: 	uint32_t fg = d->de_reg[(CRIME_DE_FG - 0x2000) / sizeof(uint32_t)];
  838: 	uint32_t bg = d->de_reg[(CRIME_DE_BG - 0x2000) / sizeof(uint32_t)];
  839: 	uint32_t rop = d->de_reg[(CRIME_DE_ROP - 0x2000) / sizeof(uint32_t)];
  840: 
  841: 	uint32_t stipple_mode = d->de_reg[(CRIME_DE_STIPPLE_MODE - 0x2000) / sizeof(uint32_t)];
  842: 	uint32_t pattern = d->de_reg[(CRIME_DE_STIPPLE_PAT - 0x2000) / sizeof(uint32_t)];
  843: 	int nr_of_bits_to_strip_to_the_left = (stipple_mode >> DE_STIP_STRTIDX_SHIFT) & 31;
  844: 	int nr_of_bits_to_strip_to_the_right = 31 - ((stipple_mode >> DE_STIP_MAXIDX_SHIFT) & 31);
  845: 	pattern >>= nr_of_bits_to_strip_to_the_right;
  846: 	pattern <<= nr_of_bits_to_strip_to_the_right;
  847: 	pattern <<= nr_of_bits_to_strip_to_the_left;
  848: 
  849: 	int nr_of_bits_in_the_middle = 32 - nr_of_bits_to_strip_to_the_left - nr_of_bits_to_strip_to_the_right;
  850: 
  851: 	if (stipple_mode & 0xe0e0ffff)
  852: 		fatal("[ sgi_de: UNIMPLEMENTED stipple_mode bits: 0x%08x ]\n", stipple_mode);
  853: 
  854: 	uint32_t x1 = (d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;
  855: 	uint32_t y1 = d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)]& 0x7ff;
  856: 	uint32_t x2 = (d->de_reg[(CRIME_DE_X_VERTEX_1 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;
  857: 	uint32_t y2 = d->de_reg[(CRIME_DE_X_VERTEX_1 - 0x2000) / sizeof(uint32_t)]& 0x7ff;
  858: 	size_t x, y;
  859: 
  860: 	debug("[ sgi_de: STARTING DRAWING COMMAND: op = 0x%08x,"
  861: 	    " drawmode=0x%x src_mode=0x%x dst_mode=0x%x x1=%i y1=%i"
  862: 	    " x2=%i y2=%i fg=0x%x bg=0x%x pattern=0x%08x ]\n",
  863: 	    op, drawmode, src_mode, dst_mode, x1, y1, x2, y2, fg, bg, pattern);
  864: 
  865: 	// bufdepth = 1, 2, or 4.
  866: 	// int dst_bufdepth = 1 << ((dst_mode >> 8) & 3);
  867: 	int src_bufdepth = 1 << ((src_mode >> 8) & 3);
  868: 
  869: 	int src_is_linear = 0;
  870: 	int src_x = -1, src_y = -1;
  871: 	int32_t step_x = 0;
  872: 	if (drawmode & DE_DRAWMODE_XFER_EN) {
  873: 		uint32_t addr_src = d->de_reg[(CRIME_DE_XFER_ADDR_SRC - 0x2000) / sizeof(uint32_t)];
  874: 		uint32_t strd_src = d->de_reg[(CRIME_DE_XFER_STRD_SRC - 0x2000) / sizeof(uint32_t)];
  875: 		step_x = d->de_reg[(CRIME_DE_XFER_STEP_X - 0x2000) / sizeof(uint32_t)];
  876: 		int32_t step_y = d->de_reg[(CRIME_DE_XFER_STEP_Y - 0x2000) / sizeof(uint32_t)];
  877: 		uint32_t addr_dst = d->de_reg[(CRIME_DE_XFER_ADDR_DST - 0x2000) / sizeof(uint32_t)];
  878: 		uint32_t strd_dst = d->de_reg[(CRIME_DE_XFER_STRD_DST - 0x2000) / sizeof(uint32_t)];
  879: 
  880: 		src_is_linear = ((src_mode & 0x00001c00) >> 10) > 3;
  881: 
  882: 		if (src_is_linear) {
  883: 			src_x = addr_src;
  884: 			src_y = 0;
  885: 		} else {
  886: 			src_x = (addr_src >> 16) & 0x7ff;
  887: 			src_y = addr_src & 0x7ff;
  888: 		}
  889: 
  890: 		if (step_x != src_bufdepth || (step_y != 0 && step_y != 1)) {
  891: 			fatal("[ sgi_de: unimplemented XFER addr_src=0x%x src_bufdepth=%i "
  892: 				"strd_src=0x%x step_x=0x%x step_y=0x%x "
  893: 				"addr_dst=0x%x strd_dst=0x%x ]\n",
  894: 				addr_src, src_bufdepth, strd_src, step_x, step_y, addr_dst, strd_dst);
  895: 
  896: 			// exit(1);
  897: 		}
  898: 	}
  899: 
  900: 	if (!(drawmode & DE_DRAWMODE_PLANEMASK)) {
  901: 		printf("!DE_DRAWMODE_PLANEMASK: TODO\n");
  902: 	}
  903: 	
  904: 	if ((drawmode & DE_DRAWMODE_BYTEMASK) != DE_DRAWMODE_BYTEMASK) {
  905: 		printf("not all DE_DRAWMODE_BYTEMASK set: TODO\n");
  906: 	}
  907: 	
  908: 	// primitive rendering direction (not for Lines? and presumably
  909: 	// not for Points either :-)
  910: 	int dx = op & DE_PRIM_RL ? -1 :  1;
  911: 	int dy = op & DE_PRIM_TB ?  1 : -1;
  912: 
  913: 	uint16_t saved_src_x = src_x;
  914: 
  915: 	/*
  916: 	 *  Drawing is limited to 2048 x 2048 pixel space.
  917: 	 *
  918: 	 *  TODO: MAYBE it is really -2048 to 2027, i.e. 12 bits of
  919: 	 *  pixel space. Perhaps it is possible to figure out
  920: 	 *  experimentally some day, e.g. by drawing lines from
  921: 	 *  -10,10 to 500,20 and see whether the real hardware
  922: 	 *  interprets -10 as -10 or 0x800 - 10.
  923: 	 */
  924: 	uint16_t endx = (x2 + dx) & 0x7ff;
  925: 	uint16_t endy = (y2 + dy) & 0x7ff;
  926: 
  927: 	int lx = abs((int)(x2 - x1)), ly = abs((int)(y2 - y1));
  928: 	int linelen = lx > ly ? lx : ly;
  929: 
  930: 	switch (op & 0xff000000) {
  931: 	case DE_PRIM_LINE:
  932: 		if (drawmode & DE_DRAWMODE_XFER_EN)
  933: 			fatal("[ sgi_de: XFER_EN for LINE op? ]\n");
  934: 
  935: 		// The PROM uses width 32, but NetBSD documents it as "half pixels".
  936: 		// if ((op & DE_PRIM_LINE_WIDTH_MASK) != 2)
  937: 		//	fatal("[ sgi_de: LINE_WIDTH_MASK = %i ]\n", op & DE_PRIM_LINE_WIDTH_MASK);
  938: 
  939: 		if (linelen == 0)
  940: 			linelen ++;
  941: 
  942: 		for (int i = 0; i < ((op & DE_PRIM_LINE_SKIP_END)? linelen : linelen+1); ++i) {
  943: 			x = (x2 * i + x1 * (linelen-i)) / linelen;
  944: 			y = (y2 * i + y1 * (linelen-i)) / linelen;
  945: 
  946: 			uint32_t color = fg;
  947: 			uint32_t oldcolor = fg;
  948: 
  949: 			if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
  950: 				horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
  951: 
  952: 			int draw = 1;
  953: 			if (drawmode & DE_DRAWMODE_LINE_STIP) {
  954: 				if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
  955: 					color = (pattern & 0x80000000UL) ? fg : bg;
  956: 				else
  957: 					draw = (pattern & 0x80000000UL)? 1 : 0;
  958: 			}
  959: 
  960: 			// Raster-OP.
  961: 			// TODO: Other ops.
  962: 			// TODO: Should this be before or after other things?
  963: 			if (drawmode & DE_DRAWMODE_ROP) {
  964: 				switch (rop) {
  965: 				case OPENGL_LOGIC_OP_COPY:
  966: 					// color = color;
  967: 					break;
  968: 				case OPENGL_LOGIC_OP_XOR:
  969: 					color = oldcolor ^ color;
  970: 					break;
  971: 				case OPENGL_LOGIC_OP_COPY_INVERTED:
  972: 					color = 0xffffffff - oldcolor;
  973: 					break;
  974: 				default:{
  975: 						static char rop_used[256];
  976: 						static int first = 1;
  977: 
  978: 						if (first) {
  979: 							memset(rop_used, 0, sizeof(rop_used));
  980: 							first = 0;
  981: 						}
  982: 
  983: 						if (!rop_used[rop & 255]) {
  984: 							rop_used[rop & 255] = 1;
  985: 							fatal("[ sgi_de: LINE: rop[0x%02x] used! ]\n", rop & 255);
  986: 						}
  987: 
  988: 						if (rop >> 8) {
  989: 							fatal("[ sgi_de: LINE: rop > 255: 0x%08x ]\n", rop);
  990: 						}
  991: 					}
  992: 				}
  993: 			}
  994: 
  995: 			if (draw)
  996: 				horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
  997: 
  998: 			// Rotate the stipple pattern:
  999: 			pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
 1000: 		}
 1001: 		break;
 1002: 
 1003: 	case DE_PRIM_RECTANGLE:
 1004: 		for (y = y1; y != endy; y = (y + dy) & 0x7ff) {
 1005: 			src_x = saved_src_x;
 1006: 			for (x = x1; x != endx; x = (x + dx) & 0x7ff) {
 1007: 				uint32_t color = fg;
 1008: 				uint32_t oldcolor = fg;
 1009: 
 1010: 				if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
 1011: 					horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
 1012: 
 1013: 				// Pixel colors copied from another source.
 1014: 				// (OpenBSD draws characters using this mechanism.)
 1015: 				if (drawmode & DE_DRAWMODE_XFER_EN)
 1016: 					horrible_getputpixel(0, cpu, d,	src_x, src_y, &color, src_mode);
 1017: 
 1018: 				int draw = 1;
 1019: 				if (drawmode & DE_DRAWMODE_POLY_STIP) {
 1020: 					if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
 1021: 						color = (pattern & 0x80000000UL) ? fg : bg;
 1022: 					else
 1023: 						draw = (pattern & 0x80000000UL)? 1 : 0;
 1024: 				}
 1025: 
 1026: 				// Raster-OP.
 1027: 				// TODO: Other ops.
 1028: 				// TODO: Should this be before or after other things?
 1029: 				if (drawmode & DE_DRAWMODE_ROP) {
 1030: 					switch (rop) {
 1031: 					case OPENGL_LOGIC_OP_COPY:
 1032: 						// color = color;
 1033: 						break;
 1034: 					case OPENGL_LOGIC_OP_XOR:
 1035: 						color = oldcolor ^ color;
 1036: 						break;
 1037: 					case OPENGL_LOGIC_OP_COPY_INVERTED:
 1038: 						color = 0xffffffff - oldcolor;
 1039: 						break;
 1040: 					default:{
 1041: 							static char rop_used[256];
 1042: 							static int first = 1;
 1043: 
 1044: 							if (first) {
 1045: 								memset(rop_used, 0, sizeof(rop_used));
 1046: 								first = 0;
 1047: 							}
 1048: 
 1049: 							if (!rop_used[rop & 255]) {
 1050: 								rop_used[rop & 255] = 1;
 1051: 								fatal("[ sgi_de: RECT: rop[0x%02x] used! ]\n", rop & 255);
 1052: 							}
 1053: 
 1054: 							if (rop >> 8) {
 1055: 								fatal("[ sgi_de: RECT: rop > 255: 0x%08x ]\n", rop);
 1056: 							}
 1057: 						}
 1058: 					}
 1059: 				}
 1060: 
 1061: 				if (draw)
 1062: 					horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
 1063: 
 1064: 				// Rotate the stipple pattern:
 1065: 				pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
 1066: 
 1067: 				if (src_is_linear)
 1068: 					src_x += step_x;
 1069: 				else
 1070: 					src_x = (src_x + dx) & 0x7ff;
 1071: 			}
 1072: 			
 1073: 			src_y = (src_y + dy) & 0x7ff;
 1074: 		}
 1075: 		break;
 1076: 
 1077: 	default:
 1078: 		/*  #500: a GUEST-WRITTEN drawing op ended the host process.
 1079: 		    The switch discriminates on the TOP BYTE only, so the domain
 1080: 		    is 256 values and only two are implemented -- DE_PRIM_LINE
 1081: 		    (0x01) and DE_PRIM_RECTANGLE (0x03).
 1082: 
 1083: 		    *** THE TWO KILLERS THAT MATTER ARE NOT EXOTIC VALUES: THEY
 1084: 		    ARE NAMED PRIMITIVES, AND ONE OF THEM IS THE RESET STATE. ***
 1085: 		    crmfbreg.h defines them as FULL 32-BIT VALUES, not top-byte
 1086: 		    indices: DE_PRIM_POINT 0x00000000, LINE 0x01000000,
 1087: 		    TRIANGLE 0x02000000, RECTANGLE 0x03000000.  Writing them
 1088: 		    as "0x01" invites a `case 0x02:' that can NEVER match,
 1089: 		    since the switch compares `op & 0xff000000'.  POINT and
 1090: 		    TRIANGLE land
 1091: 		    here.  And dev_sgi_re_init memsets the whole device struct,
 1092: 		    so CRIME_DE_PRIMITIVE reads 0 -- which IS POINT -- until a
 1093: 		    guest writes it.  A guest that sets the START bit having
 1094: 		    never written the primitive register at all therefore died
 1095: 		    here.  It need not choose a bad value; it need only omit a
 1096: 		    good one.
 1097: 
 1098: 		    Now a LATCHED DECLINE that falls out of the switch and
 1099: 		    returns.  The diagnostic is kept in full -- it names the op
 1100: 		    and the vertices, which is what a maintainer implementing
 1101: 		    the primitive would want -- and gains `-- declined.  (once)'
 1102: 		    so it cannot be mistaken for the old host kill and cannot
 1103: 		    flood a guest loop.  */
 1104: 		if (!(d->warned & SGIRE_W_PRIM_OP)) {
 1105: 			d->warned |= SGIRE_W_PRIM_OP;
 1106: 			fatal("[ sgi_de: UNIMPLEMENTED drawing op = 0x%08x,"
 1107: 			    " x1=%i y1=%i x2=%i y2=%i fg=0x%x bg=0x%x"
 1108: 			    " pattern=0x%08x -- declined.  (once) ]\n",
 1109: 			    op, x1, y1, x2, y2, fg, bg, pattern);
 1110: 		}
 1111: 		break;
 1112: 	}
 1113: }
 1114: 
 1115: DEVICE_ACCESS(sgi_de)
 1116: {
 1117: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
 1118: 	uint64_t idata = 0, odata = 0;
 1119: 	int regnr;
 1120: 	int startFlag = relative_addr & CRIME_DE_START;
 1121: 
 1122: 	relative_addr &= ~CRIME_DE_START;
 1123: 
 1124: 	idata = memory_readmax64(cpu, data, len);
 1125: 	regnr = relative_addr / sizeof(uint32_t);
 1126: 
 1127: 	relative_addr += 0x2000;
 1128: 
 1129: 	/*
 1130: 	 *  Treat all registers as read/write, by default.  Sometimes these
 1131: 	 *  are accessed as 32-bit words, sometimes as 64-bit words to access
 1132: 	 *  two adjacent registers in one operation.
 1133: 	 */
 1134: 	if (len == 8) {
 1135: 		if (writeflag == MEM_WRITE) {
 1136: 			d->de_reg[regnr] = idata >> 32ULL;
 1137: 			d->de_reg[regnr+1] = idata;
 1138: 		} else
 1139: 			odata = ((uint64_t)d->de_reg[regnr] << 32ULL) +
 1140: 			    d->de_reg[regnr+1];
 1141: 	} else if (len == 4) {
 1142: 		if (writeflag == MEM_WRITE)
 1143: 			d->de_reg[regnr] = idata;
 1144: 		else
 1145: 			odata = d->de_reg[regnr];
 1146: 	} else {
 1147: 		/*
 1148: 		 *  #498: THIS USED TO END THE HOST PROCESS.  A guest choosing an
 1149: 		 *  access width is not an emulator error -- one `sb' anywhere in
 1150: 		 *  this 4 KB window did it.  Witnessed at rung 3 on an unmodified
 1151: 		 *  -E sgi -e ip32: sb, sh, lbu and lhu each gave exactly one
 1152: 		 *  "len = N not implemented" and exit(1), 4/4.
 1153: 		 *
 1154: 		 *  *** THE SHAPE IS NOT #497's SPLICE, AND THE DIFFERENCE IS
 1155: 		 *  MEASURED, NOT STYLISTIC. ***  #497's tail only answered a read.
 1156: 		 *  THIS function's tail also calls draw_primitive() when the guest
 1157: 		 *  set CRIME_DE_START, so falling through would run a rendering
 1158: 		 *  primitive for an access we just refused.
 1159: 		 *
 1160: 		 *  Clearing startFlag and falling through -- the obvious repair --
 1161: 		 *  scores 24/25: the declined access still reaches the switch
 1162: 		 *  below, which announces e.g. "TODO: non-zero CRIME_DE_SCISSOR"
 1163: 		 *  about a write THAT NEVER HAPPENED, from an idata this arm
 1164: 		 *  discarded.  Shipping a wrong record inside a diagnostic is the
 1165: 		 *  same class the ACCEPT member of the option set was found
 1166: 		 *  through.  The goto form scores 25/25.
 1167: 		 *
 1168: 		 *  `goto <label>' to a common exit is house idiom, not an
 1169: 		 *  invention: 10 device files use goto and 8 of those use it
 1170: 		 *  inside a DEVICE_ACCESS body (dc7085, i80321, le, mk48txx,
 1171: 		 *  ne2000, pvr, vr41xx, wdc).
 1172: 		 *
 1173: 		 *  It is not an early `return' either.  Control still reaches the
 1174: 		 *  common exit, so a declined READ is answered with odata (0) via
 1175: 		 *  memory_writemax64 and the function still returns 1.  `return 0'
 1176: 		 *  would be coerced to -1 by cpus/memory_rw.c and raise
 1177: 		 *  EXCEPTION_DBE -- turning a refusal into a guest bus error.
 1178: 		 */
 1179: 		if (!(d->warned & SGIRE_W_DE_LEN)) {
 1180: 			d->warned |= SGIRE_W_DE_LEN;
 1181: 			fatal("[ sgi_de: unimplemented len=%i -- declined."
 1182: 			    "  (once) ]\n", (int) len);
 1183: 		}
 1184: 		goto de_declined;
 1185: 	}
 1186: 
 1187: 	switch (relative_addr) {
 1188: 
 1189: 	case CRIME_DE_MODE_SRC:
 1190: 		debug("[ sgi_de: %s CRIME_DE_MODE_SRC: 0x%016llx ]\n",
 1191: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1192: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1193: 		break;
 1194: 
 1195: 	case CRIME_DE_MODE_DST:
 1196: 		debug("[ sgi_de: %s CRIME_DE_MODE_DST: 0x%016llx ]\n",
 1197: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1198: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1199: 		break;
 1200: 
 1201: 	case CRIME_DE_CLIPMODE:
 1202: 		debug("[ sgi_de: %s CRIME_DE_CLIPMODE: 0x%016llx ]\n",
 1203: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1204: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1205: 		if (writeflag == MEM_WRITE && idata != 0)
 1206: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_CLIPMODE: 0x%016llx ]\n", idata);
 1207: 		break;
 1208: 
 1209: 	case CRIME_DE_DRAWMODE:
 1210: 		debug("[ sgi_de: %s CRIME_DE_DRAWMODE: 0x%016llx ]\n",
 1211: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1212: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1213: 		break;
 1214: 
 1215: 	case CRIME_DE_SCRMASK0:
 1216: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK0: 0x%016llx ]\n",
 1217: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1218: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1219: 		if (writeflag == MEM_WRITE && idata != 0)
 1220: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK0: 0x%016llx ]\n", idata);
 1221: 		break;
 1222: 
 1223: 	case CRIME_DE_SCRMASK1:
 1224: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK1: 0x%016llx ]\n",
 1225: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1226: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1227: 		if (writeflag == MEM_WRITE && idata != 0)
 1228: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK1: 0x%016llx ]\n", idata);
 1229: 		break;
 1230: 
 1231: 	case CRIME_DE_SCRMASK2:
 1232: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK2: 0x%016llx ]\n",
 1233: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1234: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1235: 		if (writeflag == MEM_WRITE && idata != 0)
 1236: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK2: 0x%016llx ]\n", idata);
 1237: 		break;
 1238: 
 1239: 	case CRIME_DE_SCRMASK3:
 1240: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK3: 0x%016llx ]\n",
 1241: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1242: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1243: 		if (writeflag == MEM_WRITE && idata != 0)
 1244: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK3: 0x%016llx ]\n", idata);
 1245: 		break;
 1246: 
 1247: 	case CRIME_DE_SCRMASK4:
 1248: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK4: 0x%016llx ]\n",
 1249: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1250: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1251: 		if (writeflag == MEM_WRITE && idata != 0)
 1252: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK4: 0x%016llx ]\n", idata);
 1253: 		break;
 1254: 
 1255: 	case CRIME_DE_SCISSOR:
 1256: 		debug("[ sgi_de: %s CRIME_DE_SCISSOR: 0x%016llx ]\n",
 1257: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1258: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1259: 		if (writeflag == MEM_WRITE && idata != 0)
 1260: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCISSOR: 0x%016llx ]\n", idata);
 1261: 		break;
 1262: 
 1263: 	case CRIME_DE_SCISSOR + 4:
 1264: 		// NetBSD writes 0x3fff3fff here. "High" part of SCISSOR register?
 1265: 		debug("[ sgi_de: %s CRIME_DE_SCISSOR+4: 0x%016llx ]\n",
 1266: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1267: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1268: 		if (writeflag == MEM_WRITE && idata != 0x3fff3fff)
 1269: 			fatal("[ sgi_de: TODO: CRIME_DE_SCISSOR+4: 0x%016llx ]\n", idata);
 1270: 		break;
 1271: 
 1272: 	case CRIME_DE_PRIMITIVE:
 1273: 		debug("[ sgi_de: %s CRIME_DE_PRIMITIVE: 0x%016llx ]\n",
 1274: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1275: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1276: 		break;
 1277: 
 1278: 	case CRIME_DE_WINOFFSET_SRC:
 1279: 		debug("[ sgi_de: %s CRIME_DE_WINOFFSET_SRC: 0x%016llx ]\n",
 1280: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1281: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1282: 		if (writeflag == MEM_WRITE && idata != 0)
 1283: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_WINOFFSET_SRC: 0x%016llx ]\n", idata);
 1284: 		break;
 1285: 
 1286: 	case CRIME_DE_WINOFFSET_DST:
 1287: 		debug("[ sgi_de: %s CRIME_DE_WINOFFSET_DST: 0x%016llx ]\n",
 1288: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1289: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1290: 		if (writeflag == MEM_WRITE && idata != 0)
 1291: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_WINOFFSET_DST: 0x%016llx ]\n", idata);
 1292: 		break;
 1293: 
 1294: 	case CRIME_DE_X_VERTEX_0:
 1295: 		debug("[ sgi_de: %s CRIME_DE_X_VERTEX_0: 0x%016llx ]\n",
 1296: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1297: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1298: 		break;
 1299: 
 1300: 	case CRIME_DE_X_VERTEX_1:
 1301: 		debug("[ sgi_de: %s CRIME_DE_X_VERTEX_1: 0x%016llx ]\n",
 1302: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1303: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1304: 		break;
 1305: 
 1306: 	case CRIME_DE_XFER_ADDR_SRC:
 1307: 		debug("[ sgi_de: %s CRIME_DE_XFER_ADDR_SRC: 0x%016llx ]\n",
 1308: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1309: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1310: 		break;
 1311: 
 1312: 	case CRIME_DE_XFER_STRD_SRC:
 1313: 		debug("[ sgi_de: %s CRIME_DE_XFER_STRD_SRC: 0x%016llx ]\n",
 1314: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1315: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1316: 		break;
 1317: 
 1318: 	case CRIME_DE_XFER_STEP_X:
 1319: 		debug("[ sgi_de: %s CRIME_DE_XFER_STEP_X: 0x%016llx ]\n",
 1320: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1321: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1322: 		break;
 1323: 
 1324: 	case CRIME_DE_XFER_STEP_Y:
 1325: 		debug("[ sgi_de: %s CRIME_DE_XFER_STEP_Y: 0x%016llx ]\n",
 1326: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1327: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1328: 		break;
 1329: 
 1330: 	case CRIME_DE_XFER_ADDR_DST:
 1331: 		debug("[ sgi_de: %s CRIME_DE_XFER_ADDR_DST: 0x%016llx ]\n",
 1332: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1333: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1334: 		break;
 1335: 
 1336: 	case CRIME_DE_XFER_STRD_DST:
 1337: 		debug("[ sgi_de: %s CRIME_DE_XFER_STRD_DST: 0x%016llx ]\n",
 1338: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1339: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1340: 		break;
 1341: 
 1342: 	case CRIME_DE_STIPPLE_MODE:
 1343: 		debug("[ sgi_de: %s CRIME_DE_STIPPLE_MODE: 0x%016llx ]\n",
 1344: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1345: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1346: 		break;
 1347: 
 1348: 	case CRIME_DE_STIPPLE_PAT:
 1349: 		debug("[ sgi_de: %s CRIME_DE_STIPPLE_PAT: 0x%016llx ]\n",
 1350: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1351: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1352: 		break;
 1353: 
 1354: 	case CRIME_DE_FG:
 1355: 		debug("[ sgi_de: %s CRIME_DE_FG: 0x%016llx ]\n",
 1356: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1357: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1358: 		break;
 1359: 
 1360: 	case CRIME_DE_BG:
 1361: 		debug("[ sgi_de: %s CRIME_DE_BG: 0x%016llx ]\n",
 1362: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1363: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1364: 		break;
 1365: 
 1366: 	case CRIME_DE_ROP:
 1367: 		debug("[ sgi_de: %s CRIME_DE_ROP: 0x%016llx ]\n",
 1368: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1369: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1370: 		break;
 1371: 
 1372: 	case CRIME_DE_PLANEMASK:
 1373: 		debug("[ sgi_de: %s CRIME_DE_PLANEMASK: 0x%016llx ]\n",
 1374: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1375: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1376: 		break;
 1377: 
 1378: 	case CRIME_DE_NULL:
 1379: 		debug("[ sgi_de: %s CRIME_DE_NULL: 0x%016llx ]\n",
 1380: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1381: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1382: 		break;
 1383: 
 1384: 	case CRIME_DE_FLUSH:
 1385: 		debug("[ sgi_de: %s CRIME_DE_FLUSH: 0x%016llx ]\n",
 1386: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1387: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1388: 		break;
 1389: 
 1390: 	default:
 1391: 		if (writeflag == MEM_WRITE)
 1392: 			fatal("[ sgi_de: unimplemented write to "
 1393: 			    "address 0x%llx, data=0x%016llx ]\n",
 1394: 			    (long long)relative_addr, (long long)idata);
 1395: 		else
 1396: 			fatal("[ sgi_de: unimplemented read from address"
 1397: 			    " 0x%llx ]\n", (long long)relative_addr);
 1398: 	}
 1399: 
 1400: 	if (startFlag)
 1401: 		draw_primitive(cpu, d);
 1402: 
 1403:  de_declined:
 1404: 	/*  #498: a declined access jumps here, skipping BOTH the register
 1405: 	    switch and draw_primitive(), and is still answered.  */
 1406: 	if (writeflag == MEM_READ)
 1407: 		memory_writemax64(cpu, data, len, odata);
 1408: 
 1409: 	return 1;
 1410: }
 1411: 
 1412: 
 1413: /*
 1414:  *  dev_sgi_de_init():
 1415:  */
 1416: void dev_sgi_de_init(struct memory *mem, uint64_t baseaddr, struct sgi_re_data *d)
 1417: {
 1418: 	memory_device_register(mem, "sgi_de", baseaddr, DEV_SGI_DE_LENGTH,
 1419: 	    dev_sgi_de_access, (void *)d, DM_DEFAULT, NULL);
 1420: }
 1421: 
 1422: 
 1423: /****************************************************************************/
 1424: 
 1425: /*
 1426:  *  SGI "mte", NetBSD sources describes it as a "memory transfer engine".
 1427:  *
 1428:  *  If the relative address has the 0x0800 (CRIME_DE_START) flag set, it means
 1429:  *  "go ahead with the transfer". Otherwise, it is just reads and writes of the
 1430:  *  registers.
 1431:  */
 1432: 
 1433: void do_mte_transfer(struct cpu* cpu, struct sgi_re_data *d)
 1434: {
 1435: 	uint32_t mode = d->mte_reg[(CRIME_MTE_MODE - 0x3000) / sizeof(uint32_t)];
 1436: 	uint32_t src0 = d->mte_reg[(CRIME_MTE_SRC0 - 0x3000) / sizeof(uint32_t)];
 1437: 	uint32_t src1 = d->mte_reg[(CRIME_MTE_SRC1 - 0x3000) / sizeof(uint32_t)];
 1438: 	uint32_t dst0 = d->mte_reg[(CRIME_MTE_DST0 - 0x3000) / sizeof(uint32_t)];
 1439: 	uint32_t dst1 = d->mte_reg[(CRIME_MTE_DST1 - 0x3000) / sizeof(uint32_t)];
 1440: 	int32_t src_y_step = d->mte_reg[(CRIME_MTE_SRC_Y_STEP - 0x3000) / sizeof(uint32_t)];
 1441: 	int32_t dst_y_step = d->mte_reg[(CRIME_MTE_DST_Y_STEP - 0x3000) / sizeof(uint32_t)];
 1442: 	uint32_t dstlen = dst1 - dst0 + 1, fill_addr;
 1443: 	unsigned char zerobuf[4096];
 1444: 	int depth = 8 << ((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT);
 1445: 	int src = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
 1446: 	uint32_t bytemask = d->mte_reg[(CRIME_MTE_BYTEMASK - 0x3000) / sizeof(uint32_t)];
 1447: 	uint32_t bg = d->mte_reg[(CRIME_MTE_BG - 0x3000) / sizeof(uint32_t)];
 1448: 
 1449: 	debug("[ sgi_mte: STARTING: mode=0x%08x src0=0x%08x src1=0x%08x src_y_step=%i dst0=0x%08x,"
 1450: 	    " dst1=0x%08x dst_y_step=%i bg=0x%x bytemask=0x%x ]\n",
 1451: 	    mode,
 1452: 	    src0, src1, src_y_step,
 1453: 	    dst0, dst1, dst_y_step,
 1454: 	    bg, bytemask);
 1455: 
 1456: 	if (dst_y_step != 0 && dst_y_step != 1 && dst_y_step != -1) {
 1457: 		fatal("[ sgi_mte: TODO! unimplemented dst_y_step %i ]", dst_y_step);
 1458: 		// exit(1);
 1459: 	}
 1460: 
 1461: 	if (mode & MTE_MODE_STIPPLE) {
 1462: 		fatal("[ sgi_mte: unimplemented MTE_MODE_STIPPLE ]");
 1463: 		exit(1);
 1464: 	}
 1465: 
 1466: 	int src_tlb = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
 1467: 	int dst_tlb = (mode & MTE_MODE_DST_BUF_MASK) >> MTE_DST_TLB_SHIFT;
 1468: 	
 1469: 	if (src > MTE_TLB_C) {
 1470: 		fatal("[ sgi_mte: unimplemented SRC ]");
 1471: 		exit(1);
 1472: 	}
 1473: 
 1474: 	switch (dst_tlb) {
 1475: 	case MTE_TLB_A:
 1476: 	case MTE_TLB_B:
 1477: 	case MTE_TLB_C:
 1478: 		// Used by NetBSD's crmfb_fill_rect. It puts graphical
 1479: 		// coordinates in dst0 and dst1.
 1480: 		{
 1481: 			int x1 = (dst0 >> 16) & 0xfff;
 1482: 			int y1 = dst0 & 0xfff;
 1483: 			int x2 = (dst1 >> 16) & 0xfff;
 1484: 			int y2 = dst1 & 0xfff;
 1485: 			x1 /= (depth / 8);
 1486: 			x2 /= (depth / 8);
 1487: 
 1488: 			int src_x1 = (src0 >> 16) & 0xfff;
 1489: 			int src_y1 = src0 & 0xfff;
 1490: 			// int src_x2 = (src1 >> 16) & 0xfff;
 1491: 			// int src_y2 = src1 & 0xfff;
 1492: 			src_x1 /= (depth / 8);
 1493: 			// src_x2 /= (depth / 8);
 1494: 
 1495: 			int dx = x1 > x2 ? -1 : 1;
 1496: 			int dy = y1 > y2 ? -1 : 1;
 1497: 			
 1498: 			uint32_t src_mode = (src_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
 1499: 			uint32_t dst_mode = (dst_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
 1500: 
 1501: 			// Hack. The MTE perhaps doesn't deal with colors per se,
 1502: 			// but this makes sure that we copy 32 bits when doing 32-bit
 1503: 			// transfers.
 1504: 			/*  #509: was `depth == 4' -- UNREACHABLE.  `depth' is
 1505: 			    a count of BITS (8 << a two-bit field, so 8/16/32/64
 1506: 			    only); 4 is the corresponding BYTE count, which the
 1507: 			    author used correctly in the `/ (depth / 8)' lines
 1508: 			    just above.  So both assignments were dead, every
 1509: 			    tiled transfer took the CI arm, and at 32 bits CI
 1510: 			    assigns buf[0] alone while memory_rw copies four --
 1511: 			    publishing three bytes of host stack into guest
 1512: 			    memory.  The comment above states the intended
 1513: 			    condition in words: 32-bit transfers.
 1514: 
 1515: 			    This repairs the 32-bit cell ONLY.  The 16-bit and
 1516: 			    reserved-encoding-3 cells assign fewer bytes than
 1517: 			    they copy for the same reason and are NOT closed
 1518: 			    here -- see the uninitialised-buffer sibling.  */
 1519: 			if (depth == 32) {	/*  #509  */
 1520: 				src_mode |= DE_MODE_TYPE_RGBA;
 1521: 				dst_mode |= DE_MODE_TYPE_RGBA;
 1522: 			}
 1523: 
 1524: 			int src_y = src_y1;
 1525: 			for (int y = y1; y != y2+dy; y += dy) {
 1526: 				int src_x = src_x1;
 1527: 				
 1528: 				for  (int x = x1; x != x2+dx; x += dx) {
 1529: 					if (mode & MTE_MODE_COPY) {
 1530: 						horrible_getputpixel(0, cpu, d,
 1531: 							src_x, src_y, &bg, src_mode);
 1532: 						src_x += dx;
 1533: 					}
 1534: 
 1535: 					horrible_getputpixel(1, cpu, d, x, y, &bg, dst_mode);
 1536: 				}
 1537: 				
 1538: 				src_y += dy;
 1539: 			}
 1540: 		}
 1541: 		break;
 1542: 	case MTE_TLB_LIN_A:
 1543: 	case MTE_TLB_LIN_B:
 1544: 		// Used by the PROM to zero-fill memory (?).
 1545: 		if (mode & MTE_MODE_COPY) {
 1546: 			fatal("[ sgi_mte: unimplemented MTE_MODE_COPY ]");
 1547: 			exit(1);
 1548: 		}
 1549: 
 1550: 		if (depth != 8) {
 1551: 			fatal("[ sgi_mte: unimplemented MTE_DEPTH_x ]");
 1552: 			exit(1);
 1553: 		}
 1554: 
 1555: 		debug("[ sgi_mte: LINEAR TRANSFER: mode=0x%08x dst0=0x%016llx,"
 1556: 		    " dst1=0x%016llx (length 0x%llx), dst_y_step=%i bg=0x%x, bytemask=0x%x ]\n",
 1557: 		    mode,
 1558: 		    (long long)dst0, (long long)dst1,
 1559: 		    (long long)dstlen, dst_y_step, (int)bg, (int)bytemask);
 1560: 
 1561: 		if (bytemask != 0xffffffff) {
 1562: 			fatal("unimplemented MTE bytemask 0x%08x\n", (int)bytemask);
 1563: 			exit(1);
 1564: 		}
 1565: 
 1566: 		/*
 1567: 		 *  Horrible hack:
 1568: 		 *
 1569: 		 *  During bootup, the PROM fills memory at 0x40000000 and
 1570: 		 *  forward. This corresponds to the lowest possible RAM address.
 1571: 		 *  However, these fills are not going via the CPU's cache,
 1572: 		 *  which contains things such as the return address on the
 1573: 		 *  stack. If we _really_ write this data in the emulator (which
 1574: 		 *  doesn't emulate the cache), it would overwrite the stack.
 1575: 		 *
 1576: 		 *  So let's not.
 1577: 		 *
 1578: 		 *  (If some guest OS or firmware variant actually depends on
 1579: 		 *  the ability to write to the start of memory this way,
 1580: 		 *  it would not work in the emulator.)
 1581: 		 */
 1582: 		// if (dst0 >= 0x40000000 && dst0 < 0x40004000 && dst1 > 0x40004000) {
 1583: 		//	dst0 += 0x4000;
 1584: 		//	dstlen -= 0x4000;
 1585: 		// }
 1586: 
 1587: 		/*
 1588: 		 *  HUH?
 1589: 		 *
 1590: 		 *  Note that due to a bug (?) in the PROM firmware when it
 1591: 		 *  is setting up the TLB entries, only every _second_ page is
 1592: 		 *  actually put correctly in the TLB. This means that even
 1593: 		 *  though it then tries to fill 0x40000000 .. 0x40007fff with
 1594: 		 *  zeroes, it only fills 0x40001000 .. 0x40001fff,
 1595: 		 *  0x40003000 .. 0x40003fff and so on!
 1596: 		 *
 1597: 		 *  So the Horrible hack above is not needed.
 1598: 		 *
 1599: 		 *  Ironic.
 1600: 		 */
 1601: 
 1602: 		memset(zerobuf, bg, dstlen < sizeof(zerobuf) ? dstlen : sizeof(zerobuf));
 1603: 		fill_addr = dst0;
 1604: 		while (dstlen != 0) {
 1605: 			uint64_t fill_len;
 1606: 			if (dstlen > sizeof(zerobuf))
 1607: 				fill_len = sizeof(zerobuf);
 1608: 			else
 1609: 				fill_len = dstlen;
 1610: 
 1611: 			uint64_t starting_page = fill_addr & ~0xfff;
 1612: 			uint64_t ending_page = (fill_addr + fill_len - 1) & ~0xfff;
 1613: 			if (starting_page != ending_page) {
 1614: 				fill_len = starting_page + 4096 - fill_addr;
 1615: 			}
 1616: 
 1617: 			// Find starting_page in the TLB in question.
 1618: 			starting_page >>= 12;
 1619: 			uint32_t *tlb = dst_tlb == MTE_TLB_LIN_A ? d->re_linear_a : d->re_linear_b;
 1620: 			int match = 0;
 1621: 			for (int i = 0; i < 32; ++i) {
 1622: 				uint32_t entry = tlb[i];
 1623: 				if (entry & 0x80000000) {
 1624: 					entry &= ~0x80000000;
 1625: 					if (entry == starting_page) {
 1626: 						match = 1;
 1627: 						break;
 1628: 					}
 1629: 				}
 1630: 			}
 1631: 			
 1632: 			if (match) {
 1633: 				cpu->memory_rw(cpu, cpu->mem, fill_addr, zerobuf, fill_len,
 1634: 					MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
 1635: 			} else {
 1636: 				debug("[ sgi_mte: WARNING: address 0x%x not found in TLB? Ignoring fill. ]\n",
 1637: 					(long long)fill_addr);
 1638: 			}
 1639: 
 1640: 			fill_addr += fill_len;
 1641: 			dstlen -= (uint32_t)fill_len;	/* OB-23: subtract bytes actually filled */
 1642: 		}
 1643: 		break;
 1644: 	default:
 1645: 		fatal("[ sgi_mte: TODO! unimplemented dst_tlb 0x%x ]", dst_tlb);
 1646: 	}
 1647: }
