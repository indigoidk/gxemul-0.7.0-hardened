  351: 			    writes the three channels at buf[0..2] and an
  352: 			    explicit pad at buf[3] -- so an RGB pixel did not
  353: 			    survive its own round trip, shifting one byte left
  354: 			    with a zero fill on every RGB source read.
  355: 
  356: 			    The PUT arm is the authoritative one, and the
  357: 			    warrant is OUTSIDE this function: dev_sgi_gbe.c's
  358: 			    scanout reads the same tile memory back for display
  359: 			    as (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3],
  360: 			    then CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
  361: 			    31..24, 23..16 and 15..8 -- byte 0 is R and byte 3
  362: 			    is UNUSED.  So the pad sits at buf[3] because the
  363: 			    consumer ignores buf[3], not because PUT writes a
  364: 			    zero there; that is what makes this non-circular.
  365: 			    The RGBA and ABGR PUT arms independently agree --
  366: 			    both lay [R,G,B,x] in memory despite opposite
  367: 			    register word orders -- which leaves this GET the
  368: 			    lone container outlier among the 32-bit arms.
  369: 
  370: 			    The low byte stays ZERO on purpose: RGB carries
  371: 			    three channels, so a corrected read of 0xaabbccdd
  372: 			    yields 0xaabbcc00, NOT the source word.  */
  373: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
  374: 			break;
  375: 		case DE_MODE_TYPE_RGBA:
  376: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
  377: 			break;
  378: 		case DE_MODE_TYPE_ABGR:
  379: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
  380: 			break;
  381: 		default:// Read "raw" 32-bit value:
  382: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
  383: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
  384: 		}
  385: 	}
  386: }
  387: 
  388: 
  389: /*
  390:  *  SGI "re", NetBSD sources describes it as a "rendering engine".
  391:  */
  392: 
  393: DEVICE_ACCESS(sgi_re)
  394: {
  831: void draw_primitive(struct cpu* cpu, struct sgi_re_data *d)
  832: {
  833: 	uint32_t op = d->de_reg[(CRIME_DE_PRIMITIVE - 0x2000) / sizeof(uint32_t)];
  834: 	uint32_t drawmode = d->de_reg[(CRIME_DE_DRAWMODE - 0x2000) / sizeof(uint32_t)];
  835: 	uint32_t dst_mode = d->de_reg[(CRIME_DE_MODE_DST - 0x2000) / sizeof(uint32_t)];
  836: 	uint32_t src_mode = d->de_reg[(CRIME_DE_MODE_SRC - 0x2000) / sizeof(uint32_t)];
  837: 	uint32_t fg = d->de_reg[(CRIME_DE_FG - 0x2000) / sizeof(uint32_t)];
  838: 	uint32_t bg = d->de_reg[(CRIME_DE_BG - 0x2000) / sizeof(uint32_t)];
  839: 	uint32_t rop = d->de_reg[(CRIME_DE_ROP - 0x2000) / sizeof(uint32_t)];
  840: 
  841: 	uint32_t stipple_mode = d->de_reg[(CRIME_DE_STIPPLE_MODE - 0x2000) / sizeof(uint32_t)];
  842: 	uint32_t pattern = d->de_reg[(CRIME_DE_STIPPLE_PAT - 0x2000) / sizeof(uint32_t)];
  843: 	int nr_of_bits_to_strip_to_the_left = (stipple_mode >> DE_STIP_STRTIDX_SHIFT) & 31;
  844: 	int nr_of_bits_to_strip_to_the_right = 31 - ((stipple_mode >> DE_STIP_MAXIDX_SHIFT) & 31);
  845: 	pattern >>= nr_of_bits_to_strip_to_the_right;
  846: 	pattern <<= nr_of_bits_to_strip_to_the_right;
  847: 	pattern <<= nr_of_bits_to_strip_to_the_left;
  848: 
  849: 	int nr_of_bits_in_the_middle = 32 - nr_of_bits_to_strip_to_the_left - nr_of_bits_to_strip_to_the_right;
  850: 
  851: 	if (stipple_mode & 0xe0e0ffff)
  852: 		fatal("[ sgi_de: UNIMPLEMENTED stipple_mode bits: 0x%08x ]\n", stipple_mode);
  853: 
  854: 	uint32_t x1 = (d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;
  855: 	uint32_t y1 = d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)]& 0x7ff;
  856: 	uint32_t x2 = (d->de_reg[(CRIME_DE_X_VERTEX_1 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;
  857: 	uint32_t y2 = d->de_reg[(CRIME_DE_X_VERTEX_1 - 0x2000) / sizeof(uint32_t)]& 0x7ff;
  858: 	size_t x, y;
  859: 
  860: 	debug("[ sgi_de: STARTING DRAWING COMMAND: op = 0x%08x,"
  861: 	    " drawmode=0x%x src_mode=0x%x dst_mode=0x%x x1=%i y1=%i"
  862: 	    " x2=%i y2=%i fg=0x%x bg=0x%x pattern=0x%08x ]\n",
  863: 	    op, drawmode, src_mode, dst_mode, x1, y1, x2, y2, fg, bg, pattern);
  864: 
  865: 	// bufdepth = 1, 2, or 4.
  866: 	// int dst_bufdepth = 1 << ((dst_mode >> 8) & 3);
  867: 	int src_bufdepth = 1 << ((src_mode >> 8) & 3);
  868: 
  869: 	int src_is_linear = 0;
  870: 	int src_x = -1, src_y = -1;
  871: 	int32_t step_x = 0;
  872: 	if (drawmode & DE_DRAWMODE_XFER_EN) {
  873: 		uint32_t addr_src = d->de_reg[(CRIME_DE_XFER_ADDR_SRC - 0x2000) / sizeof(uint32_t)];
  874: 		uint32_t strd_src = d->de_reg[(CRIME_DE_XFER_STRD_SRC - 0x2000) / sizeof(uint32_t)];
  875: 		step_x = d->de_reg[(CRIME_DE_XFER_STEP_X - 0x2000) / sizeof(uint32_t)];
  876: 		int32_t step_y = d->de_reg[(CRIME_DE_XFER_STEP_Y - 0x2000) / sizeof(uint32_t)];
  877: 		uint32_t addr_dst = d->de_reg[(CRIME_DE_XFER_ADDR_DST - 0x2000) / sizeof(uint32_t)];
  878: 		uint32_t strd_dst = d->de_reg[(CRIME_DE_XFER_STRD_DST - 0x2000) / sizeof(uint32_t)];
  879: 
  880: 		src_is_linear = ((src_mode & 0x00001c00) >> 10) > 3;
  881: 
  882: 		if (src_is_linear) {
  883: 			src_x = addr_src;
  884: 			src_y = 0;
  885: 		} else {
  886: 			src_x = (addr_src >> 16) & 0x7ff;
  887: 			src_y = addr_src & 0x7ff;
  888: 		}
  889: 
  890: 		if (step_x != src_bufdepth || (step_y != 0 && step_y != 1)) {
  891: 			fatal("[ sgi_de: unimplemented XFER addr_src=0x%x src_bufdepth=%i "
  892: 				"strd_src=0x%x step_x=0x%x step_y=0x%x "
  893: 				"addr_dst=0x%x strd_dst=0x%x ]\n",
  894: 				addr_src, src_bufdepth, strd_src, step_x, step_y, addr_dst, strd_dst);
  895: 
  896: 			// exit(1);
  897: 		}
  898: 	}
  899: 
  900: 	if (!(drawmode & DE_DRAWMODE_PLANEMASK)) {
  901: 		printf("!DE_DRAWMODE_PLANEMASK: TODO\n");
  902: 	}
  903: 	
  904: 	if ((drawmode & DE_DRAWMODE_BYTEMASK) != DE_DRAWMODE_BYTEMASK) {
  905: 		printf("not all DE_DRAWMODE_BYTEMASK set: TODO\n");
  906: 	}
  907: 	
  908: 	// primitive rendering direction (not for Lines? and presumably
  909: 	// not for Points either :-)
  910: 	int dx = op & DE_PRIM_RL ? -1 :  1;
  911: 	int dy = op & DE_PRIM_TB ?  1 : -1;
  912: 
  913: 	uint16_t saved_src_x = src_x;
  914: 
  915: 	/*
  916: 	 *  Drawing is limited to 2048 x 2048 pixel space.
  917: 	 *
  918: 	 *  TODO: MAYBE it is really -2048 to 2027, i.e. 12 bits of
  919: 	 *  pixel space. Perhaps it is possible to figure out
  920: 	 *  experimentally some day, e.g. by drawing lines from
  921: 	 *  -10,10 to 500,20 and see whether the real hardware
  922: 	 *  interprets -10 as -10 or 0x800 - 10.
  923: 	 */
  924: 	uint16_t endx = (x2 + dx) & 0x7ff;
  925: 	uint16_t endy = (y2 + dy) & 0x7ff;
  926: 
  927: 	int lx = abs((int)(x2 - x1)), ly = abs((int)(y2 - y1));
  928: 	int linelen = lx > ly ? lx : ly;
  929: 
  930: 	switch (op & 0xff000000) {
  931: 	case DE_PRIM_LINE:
  932: 		if (drawmode & DE_DRAWMODE_XFER_EN)
  933: 			fatal("[ sgi_de: XFER_EN for LINE op? ]\n");
  934: 
  935: 		// The PROM uses width 32, but NetBSD documents it as "half pixels".
  936: 		// if ((op & DE_PRIM_LINE_WIDTH_MASK) != 2)
  937: 		//	fatal("[ sgi_de: LINE_WIDTH_MASK = %i ]\n", op & DE_PRIM_LINE_WIDTH_MASK);
  938: 
  939: 		if (linelen == 0)
  940: 			linelen ++;
  941: 
  942: 		for (int i = 0; i < ((op & DE_PRIM_LINE_SKIP_END)? linelen : linelen+1); ++i) {
  943: 			x = (x2 * i + x1 * (linelen-i)) / linelen;
  944: 			y = (y2 * i + y1 * (linelen-i)) / linelen;
  945: 
  946: 			uint32_t color = fg;
  947: 			uint32_t oldcolor = fg;
  948: 
  949: 			if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
  950: 				horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
  951: 
  952: 			int draw = 1;
  953: 			if (drawmode & DE_DRAWMODE_LINE_STIP) {
  954: 				if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
  955: 					color = (pattern & 0x80000000UL) ? fg : bg;
  956: 				else
  957: 					draw = (pattern & 0x80000000UL)? 1 : 0;
  958: 			}
  959: 
  960: 			// Raster-OP.
  961: 			// TODO: Other ops.
  962: 			// TODO: Should this be before or after other things?
  963: 			if (drawmode & DE_DRAWMODE_ROP) {
  964: 				switch (rop) {
  965: 				case OPENGL_LOGIC_OP_COPY:
  966: 					// color = color;
  967: 					break;
  968: 				case OPENGL_LOGIC_OP_XOR:
  969: 					color = oldcolor ^ color;
  970: 					break;
  971: 				case OPENGL_LOGIC_OP_COPY_INVERTED:
  972: 					color = 0xffffffff - oldcolor;
  973: 					break;
  974: 				default:{
  975: 						static char rop_used[256];
  976: 						static int first = 1;
  977: 
  978: 						if (first) {
  979: 							memset(rop_used, 0, sizeof(rop_used));
  980: 							first = 0;
  981: 						}
  982: 
  983: 						if (!rop_used[rop & 255]) {
  984: 							rop_used[rop & 255] = 1;
  985: 							fatal("[ sgi_de: LINE: rop[0x%02x] used! ]\n", rop & 255);
  986: 						}
  987: 
  988: 						if (rop >> 8) {
  989: 							fatal("[ sgi_de: LINE: rop > 255: 0x%08x ]\n", rop);
  990: 						}
  991: 					}
  992: 				}
  993: 			}
  994: 
  995: 			if (draw)
  996: 				horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
  997: 
  998: 			// Rotate the stipple pattern:
  999: 			pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
 1000: 		}
 1001: 		break;
 1002: 
 1003: 	case DE_PRIM_RECTANGLE:
 1004: 		for (y = y1; y != endy; y = (y + dy) & 0x7ff) {
 1005: 			src_x = saved_src_x;
 1006: 			for (x = x1; x != endx; x = (x + dx) & 0x7ff) {
 1007: 				uint32_t color = fg;
 1008: 				uint32_t oldcolor = fg;
 1009: 
 1010: 				if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
 1011: 					horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
 1012: 
 1013: 				// Pixel colors copied from another source.
 1014: 				// (OpenBSD draws characters using this mechanism.)
 1015: 				if (drawmode & DE_DRAWMODE_XFER_EN)
 1016: 					horrible_getputpixel(0, cpu, d,	src_x, src_y, &color, src_mode);
 1017: 
 1018: 				int draw = 1;
 1019: 				if (drawmode & DE_DRAWMODE_POLY_STIP) {
 1020: 					if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
 1021: 						color = (pattern & 0x80000000UL) ? fg : bg;
 1022: 					else
 1023: 						draw = (pattern & 0x80000000UL)? 1 : 0;
 1024: 				}
 1025: 
 1026: 				// Raster-OP.
 1027: 				// TODO: Other ops.
 1028: 				// TODO: Should this be before or after other things?
 1029: 				if (drawmode & DE_DRAWMODE_ROP) {
 1030: 					switch (rop) {
 1031: 					case OPENGL_LOGIC_OP_COPY:
 1032: 						// color = color;
 1033: 						break;
 1034: 					case OPENGL_LOGIC_OP_XOR:
 1035: 						color = oldcolor ^ color;
 1036: 						break;
 1037: 					case OPENGL_LOGIC_OP_COPY_INVERTED:
 1038: 						color = 0xffffffff - oldcolor;
 1039: 						break;
 1040: 					default:{
 1041: 							static char rop_used[256];
 1042: 							static int first = 1;
 1043: 
 1044: 							if (first) {
 1045: 								memset(rop_used, 0, sizeof(rop_used));
 1046: 								first = 0;
 1047: 							}
 1048: 
 1049: 							if (!rop_used[rop & 255]) {
 1050: 								rop_used[rop & 255] = 1;
 1051: 								fatal("[ sgi_de: RECT: rop[0x%02x] used! ]\n", rop & 255);
 1052: 							}
 1053: 
 1054: 							if (rop >> 8) {
 1055: 								fatal("[ sgi_de: RECT: rop > 255: 0x%08x ]\n", rop);
 1056: 							}
 1057: 						}
 1058: 					}
 1059: 				}
 1060: 
 1061: 				if (draw)
 1062: 					horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
 1063: 
 1064: 				// Rotate the stipple pattern:
 1065: 				pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
 1066: 
 1067: 				if (src_is_linear)
 1068: 					src_x += step_x;
 1069: 				else
 1070: 					src_x = (src_x + dx) & 0x7ff;
 1071: 			}
 1072: 			
 1073: 			src_y = (src_y + dy) & 0x7ff;
 1074: 		}
 1075: 		break;
 1076: 
 1077: 	default:
 1078: 		/*  #500: a GUEST-WRITTEN drawing op ended the host process.
 1120: 	int startFlag = relative_addr & CRIME_DE_START;
 1121: 
 1122: 	relative_addr &= ~CRIME_DE_START;
 1123: 
 1124: 	idata = memory_readmax64(cpu, data, len);
 1125: 	regnr = relative_addr / sizeof(uint32_t);
 1126: 
 1127: 	relative_addr += 0x2000;
 1128: 
 1129: 	/*
 1130: 	 *  Treat all registers as read/write, by default.  Sometimes these
 1131: 	 *  are accessed as 32-bit words, sometimes as 64-bit words to access
 1132: 	 *  two adjacent registers in one operation.
 1133: 	 */
 1134: 	if (len == 8) {
 1135: 		if (writeflag == MEM_WRITE) {
 1136: 			d->de_reg[regnr] = idata >> 32ULL;
 1137: 			d->de_reg[regnr+1] = idata;
 1138: 		} else
 1139: 			odata = ((uint64_t)d->de_reg[regnr] << 32ULL) +
 1140: 			    d->de_reg[regnr+1];
 1141: 	} else if (len == 4) {
 1142: 		if (writeflag == MEM_WRITE)
 1143: 			d->de_reg[regnr] = idata;
 1144: 		else
 1145: 			odata = d->de_reg[regnr];
 1146: 	} else {
 1147: 		/*
 1148: 		 *  #498: THIS USED TO END THE HOST PROCESS.  A guest choosing an
 1149: 		 *  access width is not an emulator error -- one `sb' anywhere in
 1150: 		 *  this 4 KB window did it.  Witnessed at rung 3 on an unmodified
 1151: 		 *  -E sgi -e ip32: sb, sh, lbu and lhu each gave exactly one
 1152: 		 *  "len = N not implemented" and exit(1), 4/4.
 1153: 		 *
 1154: 		 *  *** THE SHAPE IS NOT #497's SPLICE, AND THE DIFFERENCE IS
 1155: 		 *  MEASURED, NOT STYLISTIC. ***  #497's tail only answered a read.
 1156: 		 *  THIS function's tail also calls draw_primitive() when the guest
 1157: 		 *  set CRIME_DE_START, so falling through would run a rendering
 1158: 		 *  primitive for an access we just refused.
 1159: 		 *
 1160: 		 *  Clearing startFlag and falling through -- the obvious repair --
 1161: 		 *  scores 24/25: the declined access still reaches the switch
 1162: 		 *  below, which announces e.g. "TODO: non-zero CRIME_DE_SCISSOR"
 1163: 		 *  about a write THAT NEVER HAPPENED, from an idata this arm
 1164: 		 *  discarded.  Shipping a wrong record inside a diagnostic is the
 1165: 		 *  same class the ACCEPT member of the option set was found
 1166: 		 *  through.  The goto form scores 25/25.
 1167: 		 *
 1168: 		 *  `goto <label>' to a common exit is house idiom, not an
 1169: 		 *  invention: 10 device files use goto and 8 of those use it
 1170: 		 *  inside a DEVICE_ACCESS body (dc7085, i80321, le, mk48txx,
 1171: 		 *  ne2000, pvr, vr41xx, wdc).
 1172: 		 *
 1173: 		 *  It is not an early `return' either.  Control still reaches the
 1174: 		 *  common exit, so a declined READ is answered with odata (0) via
 1175: 		 *  memory_writemax64 and the function still returns 1.  `return 0'
 1176: 		 *  would be coerced to -1 by cpus/memory_rw.c and raise
 1177: 		 *  EXCEPTION_DBE -- turning a refusal into a guest bus error.
 1178: 		 */
 1179: 		if (!(d->warned & SGIRE_W_DE_LEN)) {
 1180: 			d->warned |= SGIRE_W_DE_LEN;
 1181: 			fatal("[ sgi_de: unimplemented len=%i -- declined."
 1182: 			    "  (once) ]\n", (int) len);
 1183: 		}
 1184: 		goto de_declined;
 1185: 	}
 1186: 
 1187: 	switch (relative_addr) {
 1188: 
 1189: 	case CRIME_DE_MODE_SRC:
 1190: 		debug("[ sgi_de: %s CRIME_DE_MODE_SRC: 0x%016llx ]\n",
 1191: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1192: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1193: 		break;
 1194: 
 1195: 	case CRIME_DE_MODE_DST:
 1196: 		debug("[ sgi_de: %s CRIME_DE_MODE_DST: 0x%016llx ]\n",
 1197: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1198: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1199: 		break;
 1200: 
 1201: 	case CRIME_DE_CLIPMODE:
 1202: 		debug("[ sgi_de: %s CRIME_DE_CLIPMODE: 0x%016llx ]\n",
 1203: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1204: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1205: 		if (writeflag == MEM_WRITE && idata != 0)
 1206: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_CLIPMODE: 0x%016llx ]\n", idata);
 1207: 		break;
 1208: 
 1209: 	case CRIME_DE_DRAWMODE:
 1210: 		debug("[ sgi_de: %s CRIME_DE_DRAWMODE: 0x%016llx ]\n",
 1380: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1381: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1382: 		break;
 1383: 
 1384: 	case CRIME_DE_FLUSH:
 1385: 		debug("[ sgi_de: %s CRIME_DE_FLUSH: 0x%016llx ]\n",
 1386: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1387: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1388: 		break;
 1389: 
 1390: 	default:
 1391: 		if (writeflag == MEM_WRITE)
 1392: 			fatal("[ sgi_de: unimplemented write to "
 1393: 			    "address 0x%llx, data=0x%016llx ]\n",
 1394: 			    (long long)relative_addr, (long long)idata);
 1395: 		else
 1396: 			fatal("[ sgi_de: unimplemented read from address"
 1397: 			    " 0x%llx ]\n", (long long)relative_addr);
 1406: 	if (writeflag == MEM_READ)
 1407: 		memory_writemax64(cpu, data, len, odata);
 1408: 
 1409: 	return 1;
 1410: }
 1411: 
 1412: 
 1413: /*
 1414:  *  dev_sgi_de_init():
 1415:  */
 1416: void dev_sgi_de_init(struct memory *mem, uint64_t baseaddr, struct sgi_re_data *d)
 1417: {
 1418: 	memory_device_register(mem, "sgi_de", baseaddr, DEV_SGI_DE_LENGTH,
 1419: 	    dev_sgi_de_access, (void *)d, DM_DEFAULT, NULL);
 1420: }
 1421: 
 1422: 
 1423: /****************************************************************************/
 1424: 
 1425: /*
 1426:  *  SGI "mte", NetBSD sources describes it as a "memory transfer engine".
 1427:  *
 1428:  *  If the relative address has the 0x0800 (CRIME_DE_START) flag set, it means
