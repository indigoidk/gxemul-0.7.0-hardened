--
regress/gate_crossfamily.sh-82-    # perfectly: every marker matches, every value is right, and REASON is legitimately
regress/gate_crossfamily.sh-83-    # MARKER -- there is nothing wrong with the boot. The only observable difference is that
regress/gate_crossfamily.sh-84-    # the budget and stall detectors were never armed. Measured on landisk, which has no race
regress/gate_crossfamily.sh-85-    # to hide behind (8 s boot against a 60 s stall): every other row stayed green.
regress/gate_crossfamily.sh-86-    # *** A FLOOR, NOT MERELY NON-ZERO. *** `> 0` was one bit of coverage, and three separate
regress/gate_crossfamily.sh:87:    # mutants walked through it: setting ninstrs to a constant 1, incrementing by 1 per record
regress/gate_crossfamily.sh-88-    # instead of parsing, and keeping only the first record. Each silently disarms the budget
regress/gate_crossfamily.sh-89-    # oracle while every row stays green. The floors are measured minima with room: luna88k's
regress/gate_crossfamily.sh-90-    # lowest observed instructions-to-milestone is 7.517 G idle, landisk's is 1.040 G UNDER
regress/gate_crossfamily.sh-91-    # LOAD -- see the load note in drive_guest.py, landisk's count nearly halves under load.
regress/gate_crossfamily.sh-92-    local n floor; n=$(v NINSTRS)
--
regress/gate_crossfamily.sh-111-    #
regress/gate_crossfamily.sh-112-    # The bounds are derived, not taste. The stall threshold must be many -N record
regress/gate_crossfamily.sh-113-    # intervals (worst measured gap on this path under saturation: 7.06 s) and must stay
regress/gate_crossfamily.sh-114-    # well under the backstop, or a hang is indistinguishable from a slow host. The backstop
regress/gate_crossfamily.sh-115-    # must exceed the worst boot measured -- 720.8 s here under 8 busy loops on 8 cores --
regress/gate_crossfamily.sh:116:    # with real margin, and must not be so large that a wedged rig ties up the battery.
regress/gate_crossfamily.sh-117-    local st bs bg
regress/gate_crossfamily.sh-118-    st=$(v STALL); bs=$(v BACKSTOP); bg=$(v BUDGET)
regress/gate_crossfamily.sh-119-
regress/gate_crossfamily.sh-120-    # *** ASSERT THE KEYS ARE PRESENT BEFORE INTERPRETING THEM. ***
regress/gate_crossfamily.sh-121-    # Deleting the driver's `print("BUDGET=...")` produced ZERO red rows and then printed,
regress/gate_crossfamily.sh-122-    # green, "budget is deliberately absent (uncalibrated rig)" for a rig whose budget is
regress/gate_crossfamily.sh-123-    # 12 G -- because `${bg:-0}` turns MISSING into DELIBERATELY ZERO. That is worse than a
regress/gate_crossfamily.sh:124:    # missed mutant: a guard row that states a falsehood while passing. STALL and BACKSTOP
regress/gate_crossfamily.sh-125-    # default safely (they go red), but a default that happens to be safe is not a check.
regress/gate_crossfamily.sh-126-    check "$rig: driver reported all three progress constants" \
regress/gate_crossfamily.sh-127-          "$([ -n "$st" ] && [ -n "$bs" ] && [ -n "$bg" ] && echo yes || echo "missing: st='$st' bs='$bs' bg='$bg'")" yes
regress/gate_crossfamily.sh-128-    #  a4: BOOT_WALL is TELEMETRY -- these two rows assert presence and containment, NEVER
regress/gate_crossfamily.sh-129-    #  a magnitude.  A row of the form "BOOT_WALL <= <constant>" is the load-sensitive
regress/gate_crossfamily.sh:130:    #  oracle that cost this battery 45 minutes; do not add one.  Stated limit: a constant
regress/gate_crossfamily.sh-131-    #  value below the ceiling survives both rows.  Accepted -- wrong telemetry costs a
regress/gate_crossfamily.sh-132-    #  wrong calibration note, not a wrong verdict.
regress/gate_crossfamily.sh-133-    local bw=$(v BOOT_WALL)
regress/gate_crossfamily.sh-134-    check "$rig: driver reported wall telemetry (never a threshold)" \
regress/gate_crossfamily.sh-135-          "$([ -n "$bw" ] && echo yes || echo "missing: bw='$bw'")" yes
--
regress/gate_crossfamily.sh-148-    #  IT CANNOT PRODUCE A FALSE PASS, ONLY A FALSE FAIL, and both defaults fail safe.  What
regress/gate_crossfamily.sh-149-    #  it actually does is FORBID a legitimate future calibration: tightening landisk's
regress/gate_crossfamily.sh-150-    #  backstop to anything sensible for an 8-second boot reddens this gate for a bookkeeping
regress/gate_crossfamily.sh-151-    #  reason, which is the phantom-regression class and is how a gate gets switched off.
regress/gate_crossfamily.sh-152-    #  The fix is to class it the way `budget_class` already classes BUDGET -- real work with
regress/gate_crossfamily.sh:153:    #  a real negative control (per-rig stall/backstop mutants), so it is FILED, not smuggled
regress/gate_crossfamily.sh-154-    #  in as a bound widening with nothing proving the widened bound still reds.
regress/gate_crossfamily.sh-155-    check "$rig: backstop exceeds the worst boot measured, with margin" \
regress/gate_crossfamily.sh-156-          "$([ "${bs:-0}" -ge 900 ] && [ "${bs:-0}" -le 3600 ] && echo yes || echo "no: $bs")" yes
regress/gate_crossfamily.sh-157-    # *** MISSING AND DELIBERATELY-ZERO ARE DIFFERENT, AND CONFLATING THEM PRINTED A LIE.
regress/gate_crossfamily.sh-158-    # The presence row above now turns the gate red when BUDGET= is missing -- but the
