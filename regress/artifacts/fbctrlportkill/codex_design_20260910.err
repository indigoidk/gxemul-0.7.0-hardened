71: *  default_test():
72: *
73: *  Initializes devices for most test machines. (Note: MIPS is different,
74: *  because of legacy reasons.)
75: */
76:static void default_test(struct machine *machine, struct cpu *cpu)
77:{
78:	char tmpstr[2000];
79:	char base_irq[1000];
80:	char end_of_base_irq[50];
81:
82:	/*
83:	 *  First add the interrupt controller. Most processor architectures
84:	 *  in GXemul have only 1 interrupt pin on the CPU, and it is simply
85:	 *  called "machine[y].cpu[z]".
86:	 *
87:	 *  MIPS is an exception, dealt with in a separate setup function.
88:	 *  ARM and SH are dealt with here.
89:	 */
90:
91:	switch (cpu->cpu_family->arch) {
92:
93:	case ARCH_ARM:
94:		snprintf(end_of_base_irq, sizeof(end_of_base_irq), ".irq");
95:		break;
96:
97:	case ARCH_SH:
98:		/*
99:		 *  #456: NOT IRQ15.  The whole SH test machine hangs off this
100:		 *  one line, and 0x3e0 can never carry a priority: the loop in
101:		 *  sh_update_interrupt_priorities() stops at IRQ14, and its own
102:		 *  formula 15 - ((i - IRQ0) / 0x20) yields 0 for that line
103:		 *  anyway -- so widening the loop would NOT help, it would
104:		 *  merely assign zero to the encoding the manual calls "no
105:		 *  request".  Priority 0 means masked, so nothing this machine
106:		 *  raised could ever be delivered.
107:		 *
108:		 *  The hardware has no such source either.  SH7750 Hardware
109:		 *  Manual Rev.7.00 19.2.2: "A value of 15 (1111) indicates no
110:		 *  interrupt request (interrupt priority level 0)", and Table
111:		 *  19.5's IRL block ends at H'3C0.  `H'3E0` does not appear
112:		 *  anywhere in the manual.
113:		 *
114:		 *  IRQ14 is the lowest REAL level, which is the right tier for
115:		 *  a test machine's catch-all: least preemptive, and an IRL
116:		 *  encoding is the honest namespace for an external `irqc`.
117:		 *  An on-chip INTEVT code would misattribute the interrupt to
118:		 *  a peripheral a guest driver may legitimately claim.
119:		 *
120:		 *  Until #455 this was LOUD -- priority 0 ran exit(1), so any
121:		 *  interrupt here ended the host.  #455 correctly made priority
122:		 *  0 mean masked, which turned the same defect SILENT.  That is
123:		 *  why this fix ships immediately behind it rather than later.
124:		 */
125:		snprintf(end_of_base_irq, sizeof(end_of_base_irq),
126:		    ".irq[0x%x]", SH4_INTEVT_IRQ14);
127:		break;
128:
129:	default:
130:		end_of_base_irq[0] = '\0';
131:	}
132:
133:	snprintf(base_irq, sizeof(base_irq), "%s.cpu[%i]%s",
134:	    machine->path, machine->bootstrap_cpu, end_of_base_irq);
135:
136:	snprintf(tmpstr, sizeof(tmpstr), "irqc addr=0x%" PRIx64" irq=%s",
137:	    (uint64_t) DEV_IRQC_ADDRESS, base_irq);
138:	device_add(machine, tmpstr);
