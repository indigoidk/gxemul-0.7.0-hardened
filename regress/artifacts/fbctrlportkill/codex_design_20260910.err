src/machines/machine_test.c-355-	/*
src/machines/machine_test.c-356-	 *  Support for more than 256 MB RAM, as suggested in doc/TODO.html:
src/machines/machine_test.c-357-	 *
src/machines/machine_test.c:358:	 *	"testmips: Add support for more than 256 MB ram, e.g. by
src/machines/machine_test.c-359-	 *	 adding 'actual RAM' at the 1 GB offset. A 32 bit machine
src/machines/machine_test.c-360-	 *	 can thus use 3 GB, no limit on 64 bit machines. Low 256 MB
src/machines/machine_test.c-361-	 *	 can be considered a mirror of first 256 MB of RAM."
src/machines/machine_test.c-362-	 *
src/machines/machine_test.c-363-	 *  The machine's base RAM is created generically (emul.c) at
src/machines/machine_test.c-364-	 *  physical address 0, so with -M larger than 256 it would grow
src/machines/machine_test.c-365-	 *  into the experimental devices at 0x10000000 and up. Instead,
src/machines/machine_test.c-366-	 *  when more than 256 MB is requested, the full amount is made
src/machines/machine_test.c-367-	 *  visible as one contiguous block of "actual RAM" at the 1 GB
src/machines/machine_test.c-368-	 *  offset (0x40000000): the first 256 MB of that block is a
--
src/machines/machine_test.c-376-	 *  devices at 0x10000000..0x1fffffff remain accessible, and with
src/machines/machine_test.c-377-	 *  -M larger than 1024 the mirror + high RAM simply shadow the
src/machines/machine_test.c-378-	 *  base RAM that would otherwise overlap them. This is the same
src/machines/machine_test.c-379-	 *  scheme the SGI O2 emulation uses (machine_sgi.c), with the
src/machines/machine_test.c-380-	 *  window at 1 GB.
src/machines/machine_test.c-381-	 *
src/machines/machine_test.c-382-	 *  With -M 256 or less (including the default), nothing is added
src/machines/machine_test.c-383-	 *  here and the machine behaves exactly as it always has.
src/machines/machine_test.c-384-	 */
src/machines/machine_test.c-385-	if (machine->physical_ram_in_mb > 256) {
src/machines/machine_test.c:386:		debugmsg(SUBSYS_MACHINE, "testmips high RAM", VERBOSITY_INFO,
src/machines/machine_test.c-387-		    "%i MB at 0x40000000 (low 256 MB mirrors its first 256 MB)",
src/machines/machine_test.c-388-		    machine->physical_ram_in_mb);
src/machines/machine_test.c-389-
src/machines/machine_test.c-390-		/*  Mirror of the low 256 MB of RAM, at the 1 GB offset:  */
