148: panictrap(int type, struct m88100_saved_state *frame)
149: {
150: 	static int panicing = 0;
151: 
152: 	if (panicing++ == 0) {
153: 		if (type == 2) {	/* instruction exception */
154: 			printf("Instr access fault (%s) v = %x, frame %x\n",
155: 				pbus_exception_type[(frame->ipfsr >> 16) & 0x7],
156: 				frame->sxip & ~3, frame);
157: 		} else if (type == 3) {	/* data access exception */
158: 			printf("Data access fault (%s) v = %x, frame %x\n",
159: 				pbus_exception_type[(frame->dpfsr >> 16) & 0x7],
160: 				frame->sxip & ~3, frame);
161: 		} else
162: 			printf("trap type %d, v = %x, frame %x\n", type, frame->sxip & ~3, frame);
163: 		regdump(frame);
164: 	}
165: 	if ((u_int)type < trap_types)
166: 		panic(trap_type[type]);
167: 	panic("trap");
168: 	/*NOTREACHED*/
169: }
