478: 
479: 	/* setup a D32 space */
480: 	vme2->vme2_master4 = ((VME2_D32ENDPHYS-1) & 0xffff0000) |
481: 	    (VME2_D32STARTPHYS >> 16);
482: 	vme2->vme2_master4mod = (VME2_D32STARTVME & 0xffff0000) |
483: 	    (VME2_D32BITSVME >> 16);
484: 	ctl &= ~(VME2_MASTERCTL_ALL << VME2_MASTERCTL_4SHIFT);
485: 	ctl |= (VME2_MASTERCTL_AM32SP) <<
486: 	    VME2_MASTERCTL_4SHIFT;
487: #if 0
488: 	printf("%s: phys 0x%08x-0x%08x to VMED32 0x%08x-0x%08x\n",
489: 	    sc->sc_dev.dv_xname,
490: 	    VME2_D32STARTPHYS, VME2_D32ENDPHYS-1,
491: 	    VME2_D32STARTVME, VME2_D32STARTVME | ~VME2_D32BITSVME);
492: #endif
493: 
494: 	vme2->vme2_masterctl = ctl;
495: 
496: 	ctl = vme2->vme2_gcsrctl;
497: 
498: 	/* enable A16 short IO map decoder (0xffffxxxx) */
499: 	ctl &= ~(VME2_GCSRCTL_I1EN | VME2_GCSRCTL_I1D16 | VME2_GCSRCTL_I1WP |
500: 	    VME2_GCSRCTL_I1SU);
501: 	ctl |= VME2_GCSRCTL_I1EN | VME2_GCSRCTL_I1D16 | VME2_GCSRCTL_I1SU;
502: 
503: 	/* enable A24D16 (0xf0xxxxxx) and A32D16 (0xf[1-e]xxxxxx) decoders */
504: 	ctl &= ~(VME2_GCSRCTL_I2EN | VME2_GCSRCTL_I2WP | VME2_GCSRCTL_I2SU |
505: 	    VME2_GCSRCTL_I2PD);
506: 	ctl |= VME2_GCSRCTL_I2EN | VME2_GCSRCTL_I2SU | VME2_GCSRCTL_I2PD;
507: 
508: 	/* map decoders 3 & 4 which were just configured */
509: 	ctl &= ~(VME2_GCSRCTL_MDEN4 | VME2_GCSRCTL_MDEN3 | VME2_GCSRCTL_MDEN1 |
510: 	    VME2_GCSRCTL_MDEN2);
511: 	ctl |= VME2_GCSRCTL_MDEN4 | VME2_GCSRCTL_MDEN3;
512: 
513: 	vme2->vme2_gcsrctl = ctl;
514: 
515: 	/*
516: 	 * Map the VME irq levels to the cpu levels 1:1.
517: 	 * This is rather inflexible, but much easier.
518: 	 */
519: 	vme2->vme2_irql4 = (7 << VME2_IRQL4_VME7SHIFT) |
520: 	    (6 << VME2_IRQL4_VME6SHIFT) | (5 << VME2_IRQL4_VME5SHIFT) |
521: 	    (4 << VME2_IRQL4_VME4SHIFT) | (3 << VME2_IRQL4_VME3SHIFT) |
522: 	    (2 << VME2_IRQL4_VME2SHIFT) | (1 << VME2_IRQL4_VME1SHIFT);
523: 	/*
524: 	 * disable all interrupts, they will be enabled by each
525: 	 * driver when it configures
526: 	 */
527: 	vme2->vme2_irqen = 0;
528: 	if (vmebustype == BUS_PCCTWO){
529: 		/* 
530: 		 * pseudo driver, abort interrupt handler
531: 		 */
532: 		sc->sc_abih.ih_fn = vme2abort;
533: 		sc->sc_abih.ih_arg = 0;
534: 		sc->sc_abih.ih_ipl = IPL_NMI;
535: 		sc->sc_abih.ih_wantframe = 1;
536: #if 0
537: 		printf("inserting vme_ab handler\n");
538: #endif
539: 		intr_establish(110, &sc->sc_abih);
540: 		vme2->vme2_irqen |= VME2_IRQ_AB;
541: 	}
542: 	
543: }
544: 
545: /*
546:  * A32 accesses on the MVME1[678]x require setting up mappings in
547:  * the VME2 chip.
548:  * XXX VME address must be between 2G and 4G
549:  * XXX We only support D32 at the moment..
550:  */
551: u_long
552: vme2chip_map(base, len, dwidth)
553: 	u_long base;
554: 	int len, dwidth;
555: {
556: 	switch (dwidth) {
557: 	case 16:
558: 		if (base < VME2_D16STARTPHYS ||
559: 		    base + (u_long)len > VME2_D16ENDPHYS)
560: 			return (NULL);
561: 		return (base);
562: 	case 32:
563: 		if (base < VME2_D32STARTVME)
564: 			return (NULL);
565: 		return (base - VME2_D32STARTVME + VME2_D32STARTPHYS);
566: 	}
567: }
