956: 	/***************** REGISTER STATUS BLOCK ***********************\
957: 	* SR0: current thread 						*
958: 	* SR1: saved copy of exception-time register now holding FLAGS	*
959: 	* SR2: return address to the calling exception handler		*
960: 	* SR3: free							*
961: 	* FLAGS: CPU status flags					*
962: 	***************************************************		*
963: 	* immediate goal:						*
964: 	* 	Since we're servicing an exception from user mode, we	*
965: 	*	know that SR3 is free.  We use it to free up a temp.	*
966: 	*	register to be used in getting the thread's pcb         *
967: 	\***************************************************************/
968: 	stcr	r31, SR3		/* save previous r31 */
969: 
970: 	/* switch to the thread's kernel stack. */
971: 	or.u	r31, r0,  hi16(_curpcb)
972: 	ld	r31, r31, lo16(_curpcb)
973:      	addu	r31, r31, PCB_USER_STATE	/* point to user save area */
974: 	st	FLAGS, r31, REG_OFF(EF_FLAGS)	/* save flags */
975: 	st	r1, r31, GENREG_OFF(1)		/* save prev. r1 (now r1 free)*/
976: 	ldcr	r1, SR3				/* save previous r31 */
977: 	st	r1, r31, GENREG_OFF(31)
978: 	/*FALLTHROUGH */
979: 
980:     _LABEL(have_pcb)
981: 	/***************** REGISTER STATUS BLOCK ***********************\
982: 	* SR0: current thread 						*
983: 	* SR1: saved copy of exception-time register now holding FLAGS	*
984: 	* SR2: return address to the calling exception handler		*
985: 	* SR3: free							*
986: 	* r1:  free							*
987: 	* FLAGS: CPU status flags					*
988: 	* r31: our exception frame   					*
989: 	*    Valid in the exception frame:				*
990: 	*	Exception-time r1, r31, FLAGS.	 			*
991: 	*	Exception SR3, if appropriate.				*
992: 	***************************************************		*
993: 	* immediate goal:						*
994: 	* 	Save the shadow registers that need to be saved to	*
995: 	*	the exception frame.					*
996: 	\***************************************************************/
997: 	stcr	TMP, SR3	/* free up TMP, TMP2, TMP3 */
998: 	SAVE_TMP2
999: 	SAVE_TMP3
1000: 
1001: 	/* save some exception-time registers to the exception frame */
1002: 	ldcr	TMP, EPSR
1003: 	ldcr	TMP2, SFIP
1004: 	ldcr	TMP3, SNIP
1005: 	st	TMP, r31, REG_OFF(EF_EPSR)
1006: 	st	TMP2, r31, REG_OFF(EF_SFIP)
1007: 	st	TMP3, r31, REG_OFF(EF_SNIP)
1008: 
1009: 	/*
1010: 	 * Save Pbus fault status register from data and inst CMMU.
1011: 	 */
1012: 
1013: 	or.u	TMP, r0, hi16(CMMU_I)
1014: 	ld	TMP2, TMP, lo16(CMMU_I) + 0x108
1015: 	st	TMP2, r31, REG_OFF(EF_IPFSR)
1016: 	or.u	TMP, r0, hi16(CMMU_D)
1017: 	ld	TMP2, TMP, lo16(CMMU_D) + 0x108
1018: 	st	TMP2, r31, REG_OFF(EF_DPFSR)
1019: 
1020: 	ldcr	TMP, SSBR
1021: 	ldcr	TMP2, SXIP
1022: 	ldcr	TMP3, DMT0
1023: 	st	TMP2, r31, REG_OFF(EF_SXIP)
