189: 
190: def rotl32(x, n):
191:     """ROTL[32] per manual :6878 -- two copies of rS[32-63], then rotate."""
192:     lo = x & 0xFFFFFFFF
193:     n &= 31
194:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
195:     return (r32 << 32) | r32
