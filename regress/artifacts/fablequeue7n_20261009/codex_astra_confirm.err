269:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
270:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
271:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
