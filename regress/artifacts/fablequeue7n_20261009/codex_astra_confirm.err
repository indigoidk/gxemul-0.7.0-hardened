140: def mask_range(b, e):
141:     """MASK(b,e), the architecture's own wrapping mask generator (Book I:578, PEM:6879)."""
142:     assert 0 <= b <= 63 and 0 <= e <= 63
143:     m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
144:     assert m != 0, "MASK(%d,%d) came out all-zero, which architecture forbids" % (b, e)
145:     return m
146: 
147: 
148: def rotl32(x, n):
149:     """ROTL[32] per Book I:4008 -- two copies of (RS)[32:63], then rotate."""
150:     lo = x & 0xFFFFFFFF
151:     n &= 31
152:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
153:     return (r32 << 32) | r32
154: 
155: 
156: def mask32(mb, me):
157:     """MASK(MB+32, ME+32) at 64 bits (Book I:4125, 4310)."""
158:     assert 0 <= mb <= 31 and 0 <= me <= 31
159:     return mask_range(mb + 32, me + 32)
160: 
161: 
162: def want_rlwimi(rs_val, ra_val, sh, mb, me):
163:     """Architectural rlwimi result per Book I:4310."""
164:     m = mask32(mb, me)
165:     return (rotl32(rs_val, sh) & m) | (ra_val & (~m & M64))
166: 
167: 
168: def want_rlwinm(rs_val, sh, mb, me):
169:     """Architectural rlwinm result per Book I:4125."""
170:     m = mask32(mb, me)
171:     return rotl32(rs_val, sh) & m
172: 
173: 
174: # -------------------------------------------------------------------- encodings
175: def enc_m(op, rs, ra, sh, mb, me, rc=0):

