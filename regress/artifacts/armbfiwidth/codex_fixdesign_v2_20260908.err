/*
 *  bfi:  Bit-Field Insert.
 *
 *  arg[0] = ptr to rd
 *  arg[1] = ptr to rn
 *  arg[2] = (msb << 16) + lsb
 */
X(bfi)
{
	uint32_t x = reg(ic->arg[1]);

	int lsb = (uint8_t)ic->arg[2];
	int msb = ic->arg[2] >> 16;
	int width = msb - lsb + 1;

	x <<= lsb;

	uint32_t mask = (1 << width) - 1;

	mask <<= lsb;

