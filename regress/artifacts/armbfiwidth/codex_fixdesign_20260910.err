diff --git a/src/cpus/cpu_arm_instr.c b/src/cpus/cpu_arm_instr.c
index 8059125..6baff8f 100644
--- a/src/cpus/cpu_arm_instr.c
+++ b/src/cpus/cpu_arm_instr.c
@@ -1313,7 +1313,30 @@ X(ubfx)
 	int lsb = (uint8_t)ic->arg[2];
 	int width = ic->arg[2] >> 16;
 
-	uint32_t mask = (1 << width) - 1;
+	/*  #510: was `(1 << width) - 1'.  `width' is `1 + ((iword >> 16) & 31)', so
+	    it reaches 32 -- and `1' is a plain int, so the old expression was
+	    undefined at BOTH ends of that range: a shift count equal to the type's
+	    width at 32 (C99 6.5.7p3), and a signed overflow at 31 (6.5.7p4).
+
+	    ONLY THE 32 CASE IS OBSERVABLE, and the probe measured it: `UBFX
+	    r0,r1,#0,#32' of 0x89abcdef returned 0x0 on the committed build, while
+	    `#0,#31' returned the correct 0x9abcdef.
+
+	    *** WHAT THAT MEASUREMENT IS, STATED PRECISELY, BECAUSE A PASS-2 SEAT
+	    CAUGHT AN EARLIER DRAFT OVERSTATING IT.  The rows observe the RESULT
+	    REGISTER, never the mask.  "The mask became 0", and "1 << 31 gives
+	    INT_MIN so INT_MIN - 1 gives INT_MAX", are THIS HOST'S LOWERING (shl
+	    takes its count mod 32) -- undefined behaviour has no defined result to
+	    measure.  They explain the observation; they are not the observation. ***
+
+	    The repair is owed by the LANGUAGE at both widths; only one was returning
+	    a wrong value on this host.  `1U' defends 31 and the guard defends 32 --
+	    but a guest-VALUE probe cannot establish that, because `1 << 31' and
+	    `1U << 31' yield the SAME mask after the `- 1'.  No row can kill a
+	    `1U' -> `1' regression; UBSAN or a source pin can.  This is
+	    `cpu_m88k_instr.c's idiom in X(clr) and X(set), where `w == 0' encodes 32
+	    for that architecture.  */
+	uint32_t mask = (width == 32) ? 0xffffffffU : ((1U << width) - 1);
 
 	x >>= lsb;
 	x &= mask;
@@ -1337,12 +1360,55 @@ X(sbfx)
 	int lsb = (uint8_t)ic->arg[2];
 	int width = ic->arg[2] >> 16;
 
-	uint32_t mask = (1 << width) - 1;
+	/*  #510: was `(1 << width) - 1'.  `width' is `1 + ((iword >> 16) & 31)', so
+	    it reaches 32 -- and `1' is a plain int, so the old expression was
+	    undefined at BOTH ends of that range: a shift count equal to the type's
+	    width at 32 (C99 6.5.7p3), and a signed overflow at 31 (6.5.7p4).
+
+	    ONLY THE 32 CASE IS OBSERVABLE, and the probe measured it HERE, on SBFX:
+	    the `s w32' row returned 0x0 on the committed build.  (An earlier draft
+	    of this block was a VERBATIM COPY of the ubfx one and quoted a UBFX
+	    measurement -- a sentence about the other function.)
+
+	    *** WHAT THAT MEASUREMENT IS, STATED PRECISELY, BECAUSE A PASS-2 SEAT
+	    CAUGHT AN EARLIER DRAFT OVERSTATING IT.  The rows observe the RESULT
+	    REGISTER, never the mask.  "The mask became 0", and "1 << 31 gives
+	    INT_MIN so INT_MIN - 1 gives INT_MAX", are THIS HOST'S LOWERING (shl
+	    takes its count mod 32) -- undefined behaviour has no defined result to
+	    measure.  They explain the observation; they are not the observation. ***
+
+	    The repair is owed by the LANGUAGE at both widths; only one was returning
+	    a wrong value on this host.  `1U' defends 31 and the guard defends 32 --
+	    but a guest-VALUE probe cannot establish that, because `1 << 31' and
+	    `1U << 31' yield the SAME mask after the `- 1'.  No row can kill a
+	    `1U' -> `1' regression; UBSAN or a source pin can.  This is
+	    `cpu_m88k_instr.c's idiom in X(clr) and X(set), where `w == 0' encodes 32
+	    for that architecture.  */
+	uint32_t mask = (width == 32) ? 0xffffffffU : ((1U << width) - 1);
 	x >>= lsb;
 	x &= mask;
 
-	uint32_t topBitMask = 1 << (width-1);
-	if (x & topBitMask && width < 32)
+	/*  #510: was `uint32_t topBitMask = 1 << (width-1);' followed by
+	    `if (x & topBitMask && width < 32)'.  A SECOND undefined shift, and the
+	    `width < 32' test that would have made it moot sat on the NEXT line.
+
+	    *** THAT IS NOT MERELY A REORDER, AND AN EARLIER DRAFT CALLED IT ONE. ***
+	    The old form computed `1 << (width-1)' as a PRIOR STATEMENT, and a guard
+	    never rescues an expression already evaluated.  The guest-visible `x' is
+	    identical for every width in {1..32}; what changes is DEFINEDNESS at 32,
+	    where the old form always evaluated `1 << 31'.  Under a non-trapping
+	    lowering the stored value matches either way; under UBSAN the old form
+	    traps and this one does not.  That IS the fix.
+
+	    And with `1U' the shift is already defined at 32 (`1U << 31'), so the
+	    hoist is load-bearing for a SIGNED `1' and redundant for `1U'.  Doing
+	    both is right; calling them equivalent defences is not.
+
+	    At width 32 the body is skipped, and would be a no-op anyway: with mask
+	    0xffffffffU, `x |= ~mask' is `x |= 0'.  (An earlier draft said "there is
+	    no sign to extend", which is the wrong reason -- a 32-bit field HAS a
+	    sign bit.)  */
+	if (width < 32 && (x & (1U << (width - 1))))
 		x |= ~mask;
 
 	reg(ic->arg[0]) = x;
commit eb83992301fa68f2567bc64d3d3f935e99a6995f
Author: indigoidk <indigoidk@users.noreply.github.com>
Date:   Mon Sep 7 21:07:08 2026 -0500

    #510 pass 2: the panel was right and I refuted it, plus a broken comment I shipped in 01a0339
    
    Product change is COMMENT-ONLY in src/cpus/cpu_arm_instr.c and PROVEN so: stripping every comment
    from this revision and from c0c7f55 yields BYTE-IDENTICAL files.  Probe stays at 14 rows.
    
      MEASURED 14/14   regress/artifacts/armbfxwidth32/witness_FIXED14b_20260907.raw, sentinel ARMBFX_DONE
    
      build/            CLEAN / FRESH        build-asan/   CLEAN / FRESH
      /tmp/gxsec-build  CLEAN / FRESH        est/          CLEAN / part 2 N/A (source tree, no binary)
    
    ## *** A DEFECT I INTRODUCED IN 01a0339 AND SHIPPED, FOUND BY THE codex PASS-2 SEAT ***
    
    Both handlers' product comments read:
    
        No row can kill a
        UBSAN or a source pin can.
    
    My positional line-range edit replaced line i-1 whole, deleting "`1U' -> `1' regression;".  Repaired
    at both sites, and this time the repaired sentences were READ IN FULL rather than diffed.
    
    **MY OWN COMMENT-ONLY PROOF COULD NOT HAVE CAUGHT IT.**  Stripping comments and diffing establishes
    that no CODE changed; it says nothing about whether the PROSE still parses.  I verified the thing I
    had checked for and not the thing I had broken.  The string-anchored edit form REFUSES when
    ambiguous; the positional form SILENTLY EATS adjacent text.  Neither is safe alone -- the missing
    step is reading the result.
    
    ## *** THE PANEL WAS RIGHT ABOUT `s w32 pc' AND I REFUTED IT ON A MISTAKE ***
    
    Four seats called it an ATTRIBUTION CONTROL, not a kill.  I argued it was load-bearing because
    `run_word()' zeroes r0 in a fresh emulator, so a non-executing word leaves exactly the pre-fix
    failure value.  Every fact true; the conclusion does not follow.  grok settled it: a word that never
    ran leaves r0 = 0, which REDS `s w32' (it wants 0x89abcdef) rather than greening it -- so the row
    cannot produce a FALSE PASS.  It distinguishes executed-and-wrong from never-ran, which is
    attribution, not coverage.  The probe's own row note already said CONTROL.  The ledger refutation is
    struck in place with the correction beneath it.
    
    And minimax's STATED PREMISE WAS FALSE ("r0 retains its prior-row value" -- there is none) while its
    CONCLUSION WAS RIGHT.  I found the false premise, felt the refutation, and stopped one paragraph
    short of checking the conclusion.
    
    THE FLOOR QUESTION CLOSES WITH ITS DENOMINATOR (grok, having read the tree): "no in-rule clause-(d)
    mutant of `width == 32' or `width < 32' sweeps the 14-row detector except the two definedness
    escapes already disclosed."  A bare zero does not close a repair chain; a zero naming which cells
    and which mutant shapes were swept does.
    
    THREE MORE L4 FIXES from the same seat: `enc ok' claimed "every planted word" while omitting
    sbfx(1,4) and sbfx(0,31) -- the CHECK was widened rather than the CLAIM narrowed, so no score moves
    and the sentence becomes true; the `pc adv' ROW NOTE still carried the "bad encoding sets running=0"
    claim this round corrected in the header (fixed in one place, left in the other); and the prose
    "the SBFX rows are exactly the ones whose failure value is EXACTLY ZERO" is TOO WIDE -- UBFX's `w32'
    also returned 0x0 pre-fix, caught independently by glm AND grok.  Fourth false prose claim this
    round has shipped about its own rows.
    
    TWO SEAT FINDINGS ADJUDICATED AGAINST THE SEAT: deepseek's claimed floor breach `width < 32' ->
    `width <= 32' is an EQUIVALENT MUTANT (at width 32 the mask is 0xffffffff, ~mask is 0, `1U << 31' is
    defined -- nothing observable changes, no UB re-opened); and glm's escape claim is refuted by an
    EXISTING measurement my brief failed to inline (M_nosext.raw: 10/11, killed by `s mid' alone).
    
    ## *** lcabadval REVERSED: codex REFUTED MY CENTRAL PREMISE WITH ONE GREP ***
    
    I claimed LCA differs from SH4's RCR1 because RCR1's stored value "has a meaning the model honours."
    VERIFIED HERE: `grep -rn rtc_rcr1 src/' returns FOUR occurrences -- declaration, readback, store, and
    one inside the comment.  ZERO functional consumers.  `ioc_conf' also has four, but its fourth is the
    real consumer `bus = d->ioc_conf & 1'.  **RCR1 is consumed LESS than LCA's CONF, not more.**
    
    So #447 moved a store below a guard for a field with NO consumer -- exactly the LCA shape.  The
    tree's precedent SUPPORTS option B, which codex, deepseek and glm each said and I was discounting.
    grok's formulation, which I had recorded as "the keeper" ("RCR1 refuses CONSUMED FEATURE BITS"), is
    false in its first half.
    
    **AND THE SHARPEST LESSON IS HOW MY GLOSS BEAT MY OWN PRIMARY SOURCE.**  The brief inlined #447's
    comment VERBATIM, and that comment argues purely from READBACK -- it never claims a model consumer.
    The consumed/unconsumed framing was MINE, and grok adopted my gloss over the quotation directly
    above it.  Inlining the primary source does not protect a brief from a wrong summary placed beside
    it: a seat reads the summary as the QUESTION and the quote as supporting material.
    
    Third reversal in this round, and it cost nothing -- no product code is committed for lcabadval.
    Still open in B: codex found W_MASK0/W_BASE1/W_MASK1 RESET TO ZERO, which is not in their accepted
    set, so "retain the last accepted value" is not well-defined at reset.
    
    ## New HIGH row `lcaconfbus1kill', with a witness design reviewed SOUND
    
    Writing 0x1 to LCA_IOC_CONF is ACCEPTED (`idata & ~1' is 0; the arm's comment calls bit 0
    implemented), stored, and the NEXT PCI config access hits a bare fatal()+exit(1) at `bus != 0' in a
    different handler.  Two ordinary guest accesses, no rejected value on the path.
    
    CROSS-REFERENCED HONESTLY: lcabadval's eleven-kill census ALREADY enumerated line 134 as class BUS.
    What this row adds is that 0x1 PASSES the guard, so the kill needs no refusal -- and the witness.
    The census also names something plausibly WORSE: the two interrupt stubs at :73/:85 are bare
    fatal()+exit(1) with NO GUARD, so any device asserting an interrupt through the LCA ends the process.
    
    grok reviewed the witness construction SOUND against the largest denominator this row has seen, with
    four corrections: my liveness control is MISLABELLED (`ioc rt' proves the writer, not S2's window);
    S2 must be a READ (an empty-slot write emits a second fatal() on the control); one process beats two
    sessions; keep it on `step'.  **Contract limit: this witnesses THIS exit(1), it does NOT detect the
    repair** -- "host survives" greens for a silent return, a latched announce, AND for falling through
    into bus_pci with cur_bus=1.
    
    ## SEATS, and one genuine refusal
    
    codex REFUSED the witness brief on a CONTENT FILTER -- zero-byte .txt, exit 0, the error only in
    .err.  Recorded as instance 3 of `codexsubjectrefusal' with the cleanest discriminator yet: TWO
    briefs on the same subject matter PASSED the same day.  The difference is asking whether a
    CONSTRUCTION REACHES a termination rather than whether an ANALYSIS is correct.  RECOVERED by firing
    grok on the byte-identical brief -- and the recovery OUTPERFORMED the refused seat.
    
    Panels: codex, grok, glm, deepseek, minimax and the kimi-k3:cloud SUBSTITUTE answered both; the kimi
    CLI WALLED on a 403 weekly limit so that seat is COVERED, not lost; agy DELIBERATELY NOT FIRED
    (measurement reserve, owner ruling 2026-08-30); opus5 and fable5 NOT FIRED, reserved for the
    2026-09-09 adjudication.
    
    ## And a process defect of my own, filed as `refilingclass'
    
    SIX findings re-derived this session that were already recorded -- two in COMMITTED codex artifacts,
    four as open rows -- and one filed as a DUPLICATE (`ledgersevmissing', now withdrawn; its one real
    increment folded into `queueunrated').  It is the unread-review class where the unread things are
    committed files and open queue rows, not panel dirs.  What makes it a class: a source reading gives
    no signal that a row exists, under an id you would only search for if you already knew the answer.
    
    Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>

diff --git a/src/cpus/cpu_arm_instr.c b/src/cpus/cpu_arm_instr.c
index 976ae66..fa68d85 100644
--- a/src/cpus/cpu_arm_instr.c
+++ b/src/cpus/cpu_arm_instr.c
@@ -1340,7 +1340,7 @@ X(ubfx)
 	    a wrong value on this host.  `1U' defends 31 and the guard defends 32 --
 	    but a guest-VALUE probe cannot establish that, because `1 << 31' and
 	    `1U << 31' yield the SAME mask after the `- 1'.  No row can kill a
-	    UBSAN or a source pin can.
+	    `1U' -> `1' regression; UBSAN or a source pin can.
 
