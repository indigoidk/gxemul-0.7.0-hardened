1421:	    never rescues an expression already evaluated.  The guest-visible `x' is
1422:	    identical for every width in {1..32}; what changes is DEFINEDNESS at 32,
1423:	    where the old form always evaluated `1 << 31'.  Under a non-trapping
1424:	    lowering the stored value matches either way; under UBSAN the old form
1425:	    traps and this one does not.  That IS the fix.
1426:
1427:	    And with `1U' the shift is already defined at 32 (`1U << 31'), so the
1428:	    hoist is load-bearing for a SIGNED `1' and redundant for `1U'.  Doing
1429:	    both is right; calling them equivalent defences is not.
1430:
1431:	    At width 32 the body is skipped, and would be a no-op anyway: with mask
1432:	    0xffffffffU, `x |= ~mask' is `x |= 0'.  (An earlier draft said "there is
1433:	    no sign to extend", which is the wrong reason -- a 32-bit field HAS a
1434:	    sign bit.)  */
1435:	if (width < 32 && (x & (1U << (width - 1))))
1436:		x |= ~mask;
1437:
1438:	reg(ic->arg[0]) = x;
1439:}
1440:Y(sbfx)
1441:
1442:
1443:/*
1444: *  bfi:  Bit-Field Insert.
1445: *
1446: *  arg[0] = ptr to rd
1447: *  arg[1] = ptr to rn
1448: *  arg[2] = (msb << 16) + lsb
1449: */
1450:X(bfi)
1451:{
1452:	uint32_t x = reg(ic->arg[1]);
1453:
1454:	int lsb = (uint8_t)ic->arg[2];
1455:	int msb = ic->arg[2] >> 16;
1456:	int width = msb - lsb + 1;
1457:
1458:	x <<= lsb;
1459:
1460:	uint32_t mask = (1 << width) - 1;
1461:
1462:	mask <<= lsb;
1463:
1464:	reg(ic->arg[0]) &= ~mask;
1465:	reg(ic->arg[0]) |= (x & mask);
1466:}
1467:Y(bfi)
