165: /**************************************************************************/
166: 
167: 
168: /*
169:  *  diskimage__return_default_status_and_message():
170:  *
171:  *  Set the status and msg_in parts of a scsi_transfer struct
172:  *  to default values (msg_in = 0x00, status = 0x00).
173:  */
174: static void diskimage__return_default_status_and_message(
175: 	struct scsi_transfer *xferp, struct diskimage *d)
176: {
177: 	/*
178: 	 *  #417: a command that SUCCEEDS clears any latched sense.
179: 	 *
180: 	 *  #416 added the latch but not this, which was a regression it
181: 	 *  introduced: a refused READ followed by a GOOD READ left key 0x05
182: 	 *  latched, so the next REQUEST SENSE attributed "logical block
183: 	 *  address out of range" to the command that had just worked.  Before
184: 	 *  #416 that query returned 0x00.  Sense describes the LAST command,
185: 	 *  so success must retire it.
186: 	 */
187: 	if (d != NULL)
188: 		d->sense_key = d->sense_asc = d->sense_ascq = 0;
189: 
190: 	scsi_transfer_allocbuf(&xferp->status_len, &xferp->status, 1, 0);
191: 	xferp->status[0] = 0x00;
192: 	scsi_transfer_allocbuf(&xferp->msg_in_len, &xferp->msg_in, 1, 0);
193: 	xferp->msg_in[0] = 0x00;
194: }
195: 
196: 
197: /*
198:  *  diskimage__return_check_condition():
199:  *
200:  *  #416: report a failed command as CHECK CONDITION (status 0x02) and latch
201:  *  the sense data the guest's follow-up REQUEST SENSE will read.
202:  *
203:  *  The two halves are inseparable and must never be split: a CHECK CONDITION
204:  *  whose sense says "no sense" tells the guest that something failed and then
205:  *  that nothing is wrong, which is not a state it can act on.  Latching here
206:  *  is what makes the status meaningful.
207:  */
208: static void diskimage__return_check_condition(struct scsi_transfer *xferp,
209: 	struct diskimage *d, int key, int asc, int ascq)
210: {
211: 	d->sense_key = key;
212: 	d->sense_asc = asc;
213: 	d->sense_ascq = ascq;
214: 
215: 	scsi_transfer_allocbuf(&xferp->status_len, &xferp->status, 1, 0);
216: 	xferp->status[0] = 0x02;	/*  CHECK CONDITION  */
217: 	scsi_transfer_allocbuf(&xferp->msg_in_len, &xferp->msg_in, 1, 0);
218: 	xferp->msg_in[0] = 0x00;
219: }
