1176: DEVINIT(osiop)
1177: {
1178: 	struct osiop_data *d;
1179: 
1180: 	CHECK_ALLOCATION(d = (struct osiop_data *) malloc(sizeof(struct osiop_data)));
1181: 	memset(d, 0, sizeof(struct osiop_data));
1182: 
