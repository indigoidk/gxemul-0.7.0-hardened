906: DEVICE_TICK(osiop)
907: {
908: 	struct osiop_data *d = (struct osiop_data *) extra;
909: 
910: 	if (d->scripts_running)
911: 		osiop_execute_scripts(cpu, d);
912: 
913: 	osiop_reassert_interrupts(d);
914: }
