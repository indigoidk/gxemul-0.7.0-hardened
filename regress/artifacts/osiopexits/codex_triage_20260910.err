65: /*
66:  *  scsi_transfer_alloc():
67:  *
68:  *  Allocates memory for a new scsi_transfer struct, and fills it with
69:  *  sane data (NULL pointers).
70:  *  The return value is a pointer to the new struct.  If allocation
71:  *  failed, the program exits.
72:  */
73: struct scsi_transfer *scsi_transfer_alloc(void)
74: {
75: 	struct scsi_transfer *p;
76: 
77: 	if (first_free_scsi_transfer_alloc != NULL) {
78: 		p = first_free_scsi_transfer_alloc;
79: 		first_free_scsi_transfer_alloc = p->next_free;
80: 	} else {
81: 		p = (struct scsi_transfer *) malloc(sizeof(struct scsi_transfer));
82: 		if (p == NULL) {
83: 			fprintf(stderr, "scsi_transfer_alloc(): out "
84: 			    "of memory\n");
85: 			exit(1);
86: 		}
87: 	}
88: 
89: 	memset(p, 0, sizeof(struct scsi_transfer));
90: 
91: 	return p;
92: }
93: 
94: 
95: /*
96:  *  scsi_transfer_free():
97:  *
98:  *  Frees the space used by a scsi_transfer struct.  All buffers refered
99:  *  to by the scsi_transfer struct are freed.
100:  */
101: void scsi_transfer_free(struct scsi_transfer *p)
102: {
103: 	if (p == NULL) {
104: 		fprintf(stderr, "scsi_transfer_free(): p == NULL\n");
105: 		exit(1);
106: 	}
107: 
108: 	if (p->msg_out != NULL)
109: 		free(p->msg_out);
110: 	if (p->cmd != NULL)
111: 		free(p->cmd);
112: 	if (p->data_out != NULL)
113: 		free(p->data_out);
114: 
115: 	if (p->data_in != NULL)
116: 		free(p->data_in);
117: 	if (p->msg_in != NULL)
118: 		free(p->msg_in);
119: 	if (p->status != NULL)
120: 		free(p->status);
121: 
122: 	p->next_free = first_free_scsi_transfer_alloc;
123: 	first_free_scsi_transfer_alloc = p;
124: }
125: 
126: 
127: /*
128:  *  scsi_transfer_allocbuf():
129:  *
130:  *  Helper function, used by diskimage_scsicommand(), and SCSI controller
131:  *  devices.  Example of usage:
132:  *
133:  *	scsi_transfer_allocbuf(&xferp->msg_in_len, &xferp->msg_in, 1);
134:  */
135: void scsi_transfer_allocbuf(size_t *lenp, unsigned char **pp, size_t want_len,
136: 	int clearflag)
137: {
138: 	unsigned char *p = (*pp);
139: 
140: 	if (p != NULL) {
141: 		debugmsg(SUBSYS_DISK, "scsi", VERBOSITY_WARNING,
142: 		    "WARNING! scsi_transfer_allocbuf(): old pointer "
143: 		    "was not NULL, freeing it now");
144: 		free(p);
145: 	}
146: 
147: 	(*lenp) = want_len;
148: 	/*  #243: A legal zero-length SCSI transfer must not reach malloc(0),
149: 	    which C99 permits to return NULL and would trip the out-of-memory
150: 	    exit(1) below; always request at least one byte.  */
151: 	if ((p = (unsigned char *) malloc(want_len ? want_len : 1)) == NULL) {
152: 		debugmsg(SUBSYS_DISK, "scsi", VERBOSITY_ERROR,
153: 		    "scsi_transfer_allocbuf(): out of "
154: 		    "memory trying to allocate %li bytes", (long)want_len);
155: 		exit(1);
156: 	}
157: 
158: 	if (clearflag)
159: 		memset(p, 0, want_len);
160: 
161: 	(*pp) = p;
162: }
