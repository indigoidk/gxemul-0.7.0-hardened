1476- *  ppc_single_widen():  #305 -- the exact single -> double pattern conversion,
1477- *  including the classes the value domain cannot carry.
1478- *
1479- *  NaN is the reason this exists: a NaN's payload and sign are DATA, and the
1480- *  interpret/store pair destroys both (interpret reports only "is a NaN", and
1481- *  the store canonicalizes to all-ones).  Measured before #305: a single qNaN
1482- *  0xffc00001 widened to 0x7fffffffffffffff -- wrong sign, wrong payload.
1483- */
1484-static uint64_t ppc_single_widen(uint32_t s)
1485-{
--
1664-	 *  #330: VXCVI, and VXSNAN for a signalling operand. The RESULT
1665-	 *  branches below are unchanged -- what is new is that the exception
1666-	 *  is now recorded, and it is classified SEPARATELY from them.
1667-	 *
1668-	 *  That separation is the whole point. Reusing the saturation
1669-	 *  branches as the predicate would misclassify three ways, two of them
1670-	 *  in every rounding mode: `>= 2147483647.0` fires on exactly 2^31-1
1671-	 *  and `<= -2147483648.0` on exactly -2^31, both of which convert
1672-	 *  perfectly, and under RZ the test sees an UNROUNDED value because
1673-	 *  ieee_round_to_integral() deliberately passes RZ through, so
1674-	 *  2147483647.9 would be called invalid although it truncates in
1675-	 *  range. The predicate therefore rounds under the real mode first --
1676-	 *  trunc() for RZ, which is host-mode-independent -- and then uses
1677-	 *  STRICT inequalities.
1678-	 */
1679-	{
1680-		uint32_t causes = 0;
1681-		double r;
1682-
1683-		if (ppc_is_snan(frb_bits))
1684-			causes |= PPC_FPSCR_VXNAN;
1685-
1686:		r = (rm == IEEE_RM_RZ) ? trunc(frb.f)
1687-		    : ieee_round_to_integral(frb.f, rm);
1688-
1689-		if (frb.nan || r > 2147483647.0 || r < -2147483648.0)
1690-			causes |= PPC_FPSCR_VXCVI;
1691-
1692-		if (causes)
1693-			ppc_fpscr_raise(cpu, causes);
1694-	}
1695-
1696-	if (frb.nan)
1697-		return 0x80000000;
1698-
1699-	nf = ieee_round_to_integral(frb.f, rm);
1700-
1701-	if (nf >= 2147483647.0)
1702-		return 0x7fffffff;
1703-	if (nf <= -2147483648.0)
1704-		return 0x80000000;
1705-
1706-	return (uint32_t)(int32_t) nf;
1707-}
