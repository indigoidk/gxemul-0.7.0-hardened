 1652: DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
 1653: 
 1654: 
 1655: #  *** A PYTHON DICT LITERAL ACCEPTS A DUPLICATE KEY IN SILENCE, AND THE LAST ONE WINS.
 1656: #  MEASURED ON THIS FILE, HOURS AFTER IT WAS WRITTEN. ***
 1657: #
 1658: #  Two rounds added `sgi_eaddr_probe.py` to MANIFEST independently -- the author of this
 1659: #  checker, and the #446 round whose probe it was.  Both landed, four lines apart, and
 1660: #  `len(MANIFEST)` reported ONE entry.  Nothing complained, because nothing can: by the
 1661: #  time the module object exists the earlier entry is already gone.  Here the two agreed
 1662: #  on CLASS, so the behaviour was identical and the only damage was a stale line.  Had
 1663: #  they disagreed -- one DETECTOR, one TOOL -- the file would have carried a visible,
 1664: #  reviewed, *tracked* classification that the checker silently did not use, and the
 1665: #  filename tooth that refuses `*_probe.py` in class `tool` would have been reading the
 1666: #  wrong entry while looking correct in the diff.
 1667: #
 1668: #  It has to be caught by re-reading THIS FILE'S SOURCE TEXT, because the data structure
 1669: #  cannot represent the fault it suffers from.  A duplicate is a SETUP FAULT, not a
 1670: #  finding: it exits before any wiring is derived, so it can never be confused with a
 1671: #  probe that is genuinely unwired.
 1672: #  The open() is INLINE rather than a call to read() below: this guard runs at import time,
 1673: #  fifty lines before read() is defined, and the first draft died with a NameError proving it.
 1674: #  It failed loudly, which is luck -- a guard placed in a branch would have failed silently.
 1675: def _refuse_duplicate_keys():
 1676:     with open(os.path.abspath(__file__), "r", encoding="utf-8", errors="replace") as fh:
 1677:         src = fh.read()
 1678:     #  *** AN ANCHOR THAT NO LONGER MATCHES IS ITSELF A SETUP FAULT, NOT A REASON TO SKIP,
 1679:     #  AND THE FIRST VERSION OF THIS GUARD DID `continue`. ***  A flagship review MEASURED
 1680:     #  the consequence: `MANIFEST =  {` -- one extra space, valid Python, invisible to a
 1681:     #  reader -- makes a literal find() miss, the guard skips, and a planted duplicate key
 1682:     #  runs GREEN.  That is this file's own thesis turned on itself: a fault in a guard does
 1683:     #  not fail loudly, it stops guarding.  The regex tolerates whitespace, and a miss is
 1684:     #  now reported rather than shrugged at.
 1685:     for name in ("MANIFEST", "EXEMPT"):
 1686:         m = re.search(r"^%s\s*=\s*\{" % re.escape(name), src, re.M)
 1687:         if m is None:
 1688:             print("PROBEWIRING_SETUP_FAULT  the %s literal could not be located in this"
 1689:                   " file's own source." % name)
 1690:             print("  The duplicate-key guard cannot run, and a duplicate would pass"
 1691:                   " UNSEEN.  Fix the anchor, do not delete the check.")
 1692:             sys.exit(2)
 1693:         i = m.start()
 1694:         j = src.find("\n}", i)
 1695:         seen, dupes = set(), []
 1696:         for k in re.findall(r'^\s*"([^"]+)"\s*:', src[i:j], re.M):
 1697:             (dupes.append(k) if k in seen else None)
 1698:             seen.add(k)
 1699:         if dupes:
 1700:             print("PROBEWIRING_SETUP_FAULT  %s names the same key twice; a dict literal" % name)
 1701:             print("  keeps only the LAST and says nothing.  Delete the stale line(s):")
 1702:             for k in sorted(set(dupes)):
 1703:                 print("    %s" % k)
 1704:             sys.exit(2)
 1705: 
 1706: 
 1707: _refuse_duplicate_keys()
 1708: 
 1709: #  A python interpreter token.  Bare python/python3, or the $PY-style indirections other
 1710: #  harnesses in this tree use.  Anchored so python3.12 and mypython do not match.
 1711: #  *** THE TRAILING BOUNDARY IS LOAD-BEARING AND THE FIRST VERSION LACKED IT. ***  A
 1712: #  flagship review MEASURED that `"$PYLINT" probe.py` scored as WIRING: the alternation
 1713: #  had no boundary after the group, so ANY $PY-prefixed variable read as an interpreter
 1714: #  and a linter invocation would have marked a probe wired.  That is the FALSE ACCEPT
 1715: #  direction -- the one that silently stops demanding a gate.  Latent rather than live:
 1716: #  no such variable exists in the battery today.  `$PYTHON` and `$PY` still match;
 1717: #  `$PYLINT` and `$PYTEST` no longer do.
 1718: INTERP_RE = re.compile(
 1719:     r'"?\$\{?(?:PY|PY3|PYTHON|PYTHON3)\}?"?(?![A-Za-z0-9_])'
 1720:     r'|(?<![\w./-])python3?(?![\w.-])'
 1721: )
 1722: 
 1723: #  COMMAND POSITION -- the whole defence against "a mention counts as wiring".  Everything
 1724: #  before the interpreter must be shell scaffolding: leading space, an assignment opening a
 1725: #  command substitution (out=$( ), control keywords, and environment-variable prefixes.
 1726: #
 1727: #  THE LINE THIS WAS BUILT AGAINST IS REAL AND LIVE, not invented:
 1728: #      gate_hygiene.sh:331   note "diag_div_sweep.py or python3 missing -- class ratchet NOT run"
 1729: #  It carries a probe basename AND the token python3 on one non-comment line, and it is a
 1730: #  message saying the probe DID NOT RUN.  A two-sided "name near python" regex scores it as
 1731: #  execution.  Here the interpreter's prefix is `note "diag_div_sweep.py or `, which is not
 1732: #  scaffolding, so the line is rejected.
 1733: CMDPOS_RE = re.compile(
 1734:     r"""^\s*
 1735:         (?: [A-Za-z_]\w* = (?:\$\()? \s* )?
 1736:         (?: (?: if | then | else | elif | while | until | do | ! | \$\( | \( ) \s* )*
 1737:         (?: [A-Za-z_]\w* = (?: "[^"]*" | '[^']*' | \S* ) \s+ )*
 1738:         $""",
 1739:     re.X,
 1740: )
 1741: 
 1742: VAR_RE = re.compile(r"^\$\{?([A-Za-z_]\w*)\}?$")
 1743: ASSIGN_RE = re.compile(r"^\s*([A-Za-z_]\w*)=(\S+)")
 1744: 
 1745: 
 1746: def read(path):
 1747:     with open(path, "r", encoding="utf-8", errors="replace") as fh:
 1748:         return fh.read()
 1749: 
 1750: 
 1751: def unquote(tok):
 1752:     tok = tok.strip().rstrip(");,")
 1753:     if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in "\"'":
 1754:         tok = tok[1:-1]
 1755:     return tok.strip("\"'")
 1756: 
 1757: 
 1758: def gate_list(regress):
 1759:     """The battery's OWN array is the authority on which scripts run.
 1760: 
 1761:     Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
 1762:     second-order property worth having: a gate script that exists but was dropped out of
 1763:     GATES does not run, so every probe it owned becomes unwired here and this goes RED.
 1764:     A glob would have called those probes gated forever.
 1765:     """
 1766:     run = os.path.join(regress, "run.sh")
 1767:     if not os.path.isfile(run):
 1768:         return None, "regress/run.sh is missing -- cannot tell which gates run"
 1769:     m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
 1770:     if not m:
 1771:         return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
 1772:     return [n + ".sh" for n in m.group(1).split()], None
 1773: 
 1774: 
 1775: def exec_sites(regress, scripts):
 1776:     """Return (hits, ignored, missing).
 1777: 
 1778:     hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
 1779:     ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
 1780:     """
 1781:     hits, ignored, missing = {}, [], []
 1782:     for script in scripts:
 1783:         path = os.path.join(regress, script)
 1784:         if not os.path.isfile(path):
 1785:             missing.append(script)
 1786:             continue
 1787:         lines = read(path).splitlines()
 1788:         #  One-level variable map, from this file only.  gate_hygiene really does write
 1789:         #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
 1790:         #  one level would report a genuinely gated probe as unwired -- and a false red is
 1791:         #  how a rule gets switched off.
 1792:         varmap = {}
 1793:         for ln in lines:
 1794:             if ln.lstrip().startswith("#"):
 1795:                 continue
 1796:             a = ASSIGN_RE.match(ln)
 1797:             if a and ".py" in a.group(2):
 1798:                 varmap[a.group(1)] = unquote(a.group(2))
 1799:         #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
 1800:         #  flagship review MEASURED it: an invocation-shaped line inside a
 1801:         #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
 1802:         #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
 1803:         #  its own invocation is an entirely natural shape.  Latent rather than live -- every
 1804:         #  `<<` site in the battery today is a data table or a python program body, none
 1805:         #  carrying an interpreter plus a probe in body position -- but this is the
 1806:         #  dangerous direction: it does not fail loudly, it stops demanding a gate.
 1807:         #
 1808:         #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
 1809:         #  that GENERATES a script the gate then runs is genuine wiring one level away, and
 1810:         #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
 1811:         #  That is the right error to make.
 1812:         body = set()
 1813:         pend = None
 1814:         for no, ln in enumerate(lines, 1):
 1815:             if pend is not None:
 1816:                 body.add(no)
 1817:                 if ln.strip() == pend:
 1818:                     pend = None
 1819:                 continue
 1820:             h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
 1821:             if h and not ln.lstrip().startswith("#"):
 1822:                 pend = h.group(1)
 1823: 
 1824:         for no, ln in enumerate(lines, 1):
 1825:             if ln.lstrip().startswith("#") or no in body:
 1826:                 continue
 1827:             for m in INTERP_RE.finditer(ln):
 1828:                 if not CMDPOS_RE.match(ln[: m.start()]):
 1829:                     continue
 1830:                 toks = ln[m.end():].split()
 1831:                 if toks and toks[0].startswith("-c"):
 1832:                     continue          # an inline program, not a script invocation
 1833:                 for tok in toks:
 1834:                     t = unquote(tok)
 1835:                     v = VAR_RE.match(t)
 1836:                     if v:
 1837:                         t = varmap.get(v.group(1), "")
 1838:                     if not t.endswith(".py"):
 1839:                         continue
 1840:                     d, b = os.path.split(t)
 1841:                     if d in HERE_DIRS:
 1842:                         hits.setdefault(b, []).append("%s:%d" % (script, no))
 1843:                     else:
 1844:                         #  #471: a NESTED invocation is keyed by its RELATIVE PATH, not
 1845:                         #  its basename.  Before this, a gate invoking
 1846:                         #  `artifacts/.../gdrom_pio_null_probe.py` was filed as an
 1847:                         #  EXTERNAL reference and IGNORED -- so the detector #465 wired
 1848:                         #  by hand still reported UNWIRED once the scan could see it.
 1849:                         #
 1850:                         #  Path keys are also what makes the re-key SAFE: two detectors
 1851:                         #  sharing a basename in different directories stay distinct,
 1852:                         #  where basename keys would mark BOTH gated when only one is.
 1853:                         rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
 1854:                         if os.path.isfile(os.path.join(regress, rel)):
 1855:                             hits.setdefault(rel, []).append("%s:%d" % (script, no))
 1856:                         else:
 1857:                             ignored.append("%s:%d  %s" % (script, no, t))
 1858:                     break             # the first .py argument is the script
 1859:     return hits, ignored, missing
 1860: 
 1861: 
 1862: #  STANDALONE WORDS ONLY.  The first draft used a plain substring and reported
 1863: #  mips_fold_probe.py as self-labelled "witness" -- its summary line reads "the MIPS
 1864: #  fold-witness COUNTERS", where the word names a counter, not the artefact.  That is the
 1865: #  substring trap in the one place in this file that was allowed to be a heuristic, and an
 1866: #  advisory that cries wolf is an advisory nobody reads.  MEASURED: with the hyphen guard
 1867: #  the noise line disappears and pit8253's real disagreement still fires.
 1868: _LBL_W = re.compile(r"(?<![\w-])witness(?![\w-])", re.I)
 1869: _LBL_D = re.compile(r"(?<![\w-])detector(?![\w-])", re.I)
 1870: 
 1871: 
 1872: def domain(regress):
 1873:     """The .py artefacts this check governs, and (mode, why) describing how it decided.
 1874: 
 1875:     *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
 1876:     first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
 1877:     round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
 1878:     check went red -- correctly identifying a real unwired detector, but firing at a
 1879:     file its author had not yet offered for commit, in someone else's working tree.
 1880: 
 1881:     `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
 1882:     add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
 1883:     precisely when the author is present to classify it.  A scratch probe that is never
 1884:     staged defends nothing in a fresh clone either, so it is honestly out of scope.
 1885: 
 1886:     FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
 1887:     git cannot answer, and a fallback that quietly changes what a check governs is the
 1888:     kind of silent scope change this harness keeps being bitten by.  So the mode is
 1889:     printed on the summary line.
 1890:     """
 1891:     try:
 1892:         p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
 1893:                            capture_output=True, text=True)
 1894:         if p.returncode == 0:
 1895:             #  #471: NO `"/" not in f` FILTER.  Its docstring always claimed "every
 1896:             #  committed DETECTOR under regress/", and the filter made that false --
 1897:             #  the checker could not see below top level, which is exactly where
 1898:             #  #465 shipped a detector that no gate ran.
 1899:             #
 1900:             #  `git ls-files` yields paths RELATIVE to regress/, so a top-level file
 1901:             #  still arrives as a bare basename and every existing MANIFEST key keeps
 1902:             #  matching unchanged.  Only nested files gain a path key.
 1903:             files = sorted(f for f in p.stdout.split()
 1904:                            if f.endswith(".py")
 1905:                            and os.path.isfile(os.path.join(regress, f)))
 1906:             if files:
 1907:                 return files, "tracked-or-staged"
 1908:     except OSError:
 1909:         pass
 1910:     #  #471: the FALLBACK must descend too.  Leaving it flat would re-create the blind
 1911:     #  spot on any machine where git cannot answer -- a check whose coverage depends
 1912:     #  on which branch it took is the shape this file exists to refuse.
 1913:     found = []
 1914:     for dirpath, dirnames, filenames in os.walk(regress):
 1915:         dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
 1916:         for f in filenames:
 1917:             if f.endswith(".py"):
 1918:                 rel = os.path.relpath(os.path.join(dirpath, f), regress)
 1919:                 found.append(rel.replace(os.sep, "/"))
 1920:     return sorted(found), "on-disk (git could not answer)"
 1921: 
 1922: 
 1923: def self_label(path):
 1924:     """The file's OWN summary line, for the SELFLABEL advisory only.  Never a verdict."""
 1925:     try:
 1926:         head = read(path).splitlines()[:6]
 1927:     except OSError:
 1928:         return None
 1929:     for ln in head:
 1930:         has_w, has_d = bool(_LBL_W.search(ln)), bool(_LBL_D.search(ln))
 1931:         if has_w and not has_d:
 1932:             return CLASS_WITNESS
 1933:         if has_d and not has_w:
 1934:             return CLASS_DETECTOR
 1935:         if has_w and has_d:
 1936:             return None
 1937:     return None
 1938: 
 1939: 
 1940: #  =======================================================================================
 1941: #  SELFTEST.  Mutants are applied to COPIES in a temp dir; nothing in the repository is
 1942: #  touched, so no .MUTANT sentinel is needed.  EXIT STATUS IS TAKEN FROM THE PROCESS: this
 1943: #  project lost a whole battery result to `cmd | tail`, which reports tail's status, so a
 1944: #  KILLED run read as exit 0.  subprocess.run(...).returncode cannot make that mistake.
 1945: #
 1946: #  A CHECKER-SOURCE MUTANT THAT DOES NOT APPLY EXACTLY ONCE IS A FAULT, NEVER A PASS --
 1947: #  absorb_census.py's rule, and it is what keeps this selftest from silently going vacuous
 1948: #  after someone reformats the manifest below.
 1949: #
 1950: #  *** AND IT FIRED ON ITS OWN AUTHOR, FIRST RUN. ***  The mutants below started life as
 1951: #  plain string literals, which meant the text they searched for existed TWICE in this file:
 1952: #  once in the manifest and once in the selftest.  _st_apply refused ("x2 ... want 1") rather
 1953: #  than mutating both, which would have silently mutated the selftest instead of the subject.
 1954: #  So every mutant target is BUILT from its parts and never written out whole.
 1955: def _lit(*parts):
 1956:     """Join fragments, so the assembled search string appears nowhere in this source."""
 1957:     return "".join(parts)
 1958: 
 1959: 
 1960: def _exline(key):
 1961:     """The EXEMPT entry for `key` AS IT APPEARS IN THE SOURCE, whole, however many lines.
 1962: 
 1963:     *** THIS USED TO REBUILD A ONE-LINE ENTRY FROM THE TABLE, AND THAT WAS WRONG FOR EVERY
 1964:     ENTRY THAT WRAPS. ***  Measured 2026-08-30, the day the second exemption was discharged:
 1965:     of the six then remaining, the reconstruction matched **zero** -- all six are written
 1966:     across two or more lines.  So the selftest's four exemption mutants had nothing to bite
 1967:     on and its SKIP arm fired, dropping 4 of 21 mutants.
 1968: 
 1969:     **That is the worse failure of the two, because the SKIP arm reads as "the EXEMPT table
 1970:     is empty, nothing to test" when the truth was "the reconstruction is too narrow".**  A
 1971:     check quietly getting weaker while reporting PASS is the shape this project names first,
 1972:     and here it would have arrived wearing the clothes of progress.
 1973: 
 1974:     Extracting the REAL text instead of rebuilding an idealised one removes the whole class:
 1975:     it cannot disagree with the source, because it IS the source.  Scans from the key to the
 1976:     line that closes the tuple, so single-line and wrapped entries are handled identically.
 1977:     *** AND THE SEARCH IS ANCHORED INSIDE THE EXEMPT BLOCK, WHICH IS NOT A DETAIL. ***
 1978:     `    "<name>":` appears in BOTH tables -- MANIFEST first, EXEMPT second -- so a bare
 1979:     `find()` returns the MANIFEST entry and the mutant deletes the wrong one.  Measured: M1
 1980:     and M2 then reported `UNCLASSIFIED ... is not in the MANIFEST` and `ORPHAN EXEMPTION`
 1981:     instead of the `UNWIRED DETECTOR` they exist to prove, i.e. the mutant reddened for a
 1982:     reason unrelated to the rule under test -- which would have looked like a working check.
 1983: 
 1984:     This is the wrong-section trap this project already records for gate row lists: anchor on
 1985:     something that identifies the SECTION, never on a pattern several sections share.
 1986:     """
 1987:     src = src_of_self()
 1988:     block = src.find("EXEMPT = {")
 1989:     if block < 0:
 1990:         raise RuntimeError("_exline: no EXEMPT block")
 1991:     start = src.find('    "%s":' % key, block)
 1992:     if start < 0:
 1993:         raise RuntimeError("_exline: %r not in EXEMPT" % key)
 1994:     i = start
 1995:     while i < len(src):
 1996:         nl = src.find("\n", i)
 1997:         if nl < 0:
 1998:             return ""
 1999:         line = src[i:nl + 1]
 2000:         if line.rstrip().endswith("),"):
 2001:             return src[start:nl + 1]
 2002:         i = nl + 1
 2003:     raise RuntimeError("_exline: unterminated entry for %r" % key)
 2004: 
 2005: 
 2006: def src_of_self():
 2007:     with open(__file__, encoding="utf-8", newline="") as _f:
 2008:         return _f.read()
 2009: 
 2010: 
 2011: def _pick_exempt_detector():
 2012:     """The selftest's exemplar is DERIVED, never hardcoded.
 2013: 
 2014:     *** THIS FUNCTION EXISTS BECAUSE THE SELFTEST BROKE THE DAY AN EXEMPTION WAS
 2015:     DISCHARGED, WHICH IS THE ONE EVENT IT SHOULD HAVE BEEN CELEBRATING. ***  Four of its
 2016:     mutants named `pit8253_latch_probe.py` literally.  When that probe was wired into
 2017:     gate_arm.sh and its exemption deleted -- exactly the outcome the EXEMPT table exists
 2018:     to drive toward -- three mutants raised KeyError on the missing entry and the fourth
 2019:     had its premise inverted.  `precommit_check.sh` reported THE PROBE-WIRING CHECKER CAN
 2020:     NO LONGER BE SHOWN TO FAIL, correctly.
 2021: 
 2022:     So the harness punished progress: doing the right thing to the tree broke the tool
 2023:     that asks for it.  A hardcoded exemplar is a frozen claim about a table designed to
 2024:     empty, and swapping in another name would only move the tripwire to the next
 2025:     discharge.
 2026: 
 2027:     Any exempt DETECTOR serves: exempt means unwired, which is the precondition all four
 2028:     mutants need.  Sorted for determinism, so a failure names the same probe twice.
 2029: 
 2030:     *** AND THE PICK IS VERIFIED, NOT MERELY CHOSEN -- BUT NOT FOR THE REASON THIS
 2031:     PARAGRAPH GAVE UNTIL 2026-08-30. ***  It said `_exline()` "reconstructs a ONE-LINE
 2032:     entry from the table", so entries wrapped across two source lines matched nothing.
 2033:     `_exline()` EXTRACTS the real source text now, however many lines it spans, and its
 2034:     own docstring says so -- so the two halves of one file contradicted each other, the
 2035:     stale half sitting in the function that consumes the fresh one.  Found by the pass-2
 2036:     seat reviewing the commit that made the change.
 2037: 
 2038:     **The `count == 1` guard is still load-bearing and its warrant has MOVED.**  It no
 2039:     longer defends against a formatting mismatch -- extraction cannot have one.  It
 2040:     defends the SELF-MATCH case: a doc comment in this file quoting an EXEMPT line makes
 2041:     the extracted text appear twice.  **The MECHANISM stated here was wrong until the
 2042:     adjudicating seat built the case: `_st_apply` does NOT silently edit the comment
 2043:     instead of the table -- it COUNTS and RAISES**, `MUTANT DID NOT APPLY: '...' x2
 2044:     (want 1)`.  So the guard prevents a selftest CRASH, not a silent wrong-edit, and
 2045:     `_st_apply`'s own raise is a second line of defence behind it.
 2046: 
 2047:     Two facts the seat measured that belong here: injecting a verbatim copy of one
 2048:     EXEMPT entry makes `src.count()` return 2, the guard skips that name and returns
 2049:     the next candidate -- so it is genuinely load-bearing.  And **it never fires
 2050:     today**: all six counts are 1.  It is a LATENT defence, which is worth saying
 2051:     plainly, because a guard that has never fired is the one most likely to be
 2052:     deleted as dead by someone who does not know what it is for.
 2053: 
 2054:     *A guard whose stated reason expires but whose behaviour is still needed is the
 2055:     hardest kind to audit: deleting it looks safe, because the case it cites is gone.*
 2056:     """
 2057:     src = src_of_self()
 2058:     for name in sorted(EXEMPT):
 2059:         cls = MANIFEST.get(name, (None,))[0]
 2060:         if cls != CLASS_DETECTOR:
 2061:             continue
 2062:         if src.count(_exline(name)) == 1:
 2063:             return name
 2064:     return None
 2065: 
 2066: 
 2067: PIT_RUN = '\npython3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PLOG" 2>&1 || true\n'
 2068: #  Four shapes of MENTION, none of which is an invocation.  The third is the live
 2069: #  gate_hygiene.sh:331 shape: one non-comment line carrying the basename AND `python3`,
 2070: #  whose message is that the probe did NOT run.
 2071: PIT_MENTIONS = (
 2072:     '\n#python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PLOG" 2>&1 || true\n'
 2073:     '#  TODO: wire pit8253_latch_probe.py in\n'
 2074:     'note "pit8253_latch_probe.py or python3 missing -- PIT rows NOT run"\n'
 2075:     'echo "see pit8253_latch_probe.py"\n'
 2076: )
 2077: 
 2078: 
 2079: def _st_apply(path, old, new, want=1):
 2080:     src = read(path)
 2081:     n = src.count(old)
 2082:     if n != want:
 2083:         raise RuntimeError("MUTANT DID NOT APPLY: %r x%d in %s (want %d)"
 2084:                            % (old[:56], n, os.path.basename(path), want))
 2085:     with open(path, "w", encoding="utf-8", newline="\n") as fh:
 2086:         fh.write(src.replace(old, new))
 2087: 
 2088: 
 2089: def _st_append(path, text):
 2090:     with open(path, "a", encoding="utf-8", newline="\n") as fh:
 2091:         fh.write(text)
 2092: 
 2093: 
 2094: def selftest(verbose=False):
 2095:     import shutil
 2096:     import subprocess
 2097:     import tempfile
 2098: 
 2099:     src_regress = DEFAULT_REGRESS
 2100:     me = os.path.abspath(__file__)
 2101:     root = tempfile.mkdtemp(prefix="probewiring_selftest_")
 2102:     results = []
 2103: 
 2104:     #  *** THE BASELINE MUST BE GREEN BY CONSTRUCTION, AND THE FIRST VERSION WAS NOT. ***
 2105:     #  fresh() copied EVERY .py from the live tree, so when a concurrent round dropped an
 2106:     #  unclassified probe into regress/, M0/M2b/M5a all went red and the selftest announced
 2107:     #  "THE CHECKER CAN NO LONGER BE SHOWN TO FAIL".  Right colour, WRONG DIAGNOSIS: it
 2108:     #  blamed the checker for an APPARATUS state -- gate_offline's F5 shape, and the
 2109:     #  dangerous one, because it points the reader at the wrong file.
 2110:     #
 2111:     #  So the baseline copies exactly the MANIFEST set.  Live-tree content can no longer
 2112:     #  perturb a mutant, and M6 still tests the unclassified-arrival path by ADDING one.
 2113:     #  A MANIFEST entry with no source file is a SETUP FAULT here, never a mutant result --
 2114:     #  absorb_census.py's rule that a crash is a fault and never a detection.
 2115:     def fresh():
 2116:         work = tempfile.mkdtemp(dir=root)
 2117:         rg = os.path.join(work, "regress")
 2118:         os.makedirs(rg)
 2119:         #  #471: THE COPY MUST MIRROR THE TREE, NOT FLATTEN IT.  This loop was
 2120:         #  `os.listdir`, so once the checker could see nested detectors the selftest
 2121:         #  copy still could not -- and every nested MANIFEST entry became a GHOST in
 2122:         #  the copy, reddening the unmutated M0 control.
 2123:         #
 2124:         #  That is the SAME blind spot one level up, inside the harness that tests
 2125:         #  for it: a flat copy cannot exercise a recursive scan.
 2126:         for f in os.listdir(src_regress):
 2127:             if f.endswith(".sh"):
 2128:                 shutil.copyfile(os.path.join(src_regress, f), os.path.join(rg, f))
 2129:         for rel in MANIFEST:
 2130:             if not rel.endswith(".py"):
 2131:                 continue
 2132:             src = os.path.join(src_regress, rel.replace("/", os.sep))
 2133:             if not os.path.isfile(src):
 2134:                 continue
 2135:             dst = os.path.join(rg, rel.replace("/", os.sep))
 2136:             os.makedirs(os.path.dirname(dst), exist_ok=True)
 2137:             shutil.copyfile(src, dst)
 2138:         chk = os.path.join(work, "check_probe_wiring.py")
 2139:         shutil.copyfile(me, chk)
 2140:         return rg, chk
 2141: 
 2142:     absent = [f for f in sorted(MANIFEST) if not os.path.isfile(os.path.join(src_regress, f))]
 2143:     if absent:
 2144:         print("PROBEWIRING_SELFTEST_SETUP  the MANIFEST names files regress/ does not have:")
 2145:         for f in absent:
 2146:             print("    %s" % f)
 2147:         print("  fix the manifest first; a selftest on a broken baseline proves nothing.")
 2148:         return 2
 2149: 
 2150:     def case(name, want_rc, want_text, chk, rg, extra=(), forbid=None):
 2151:         p = subprocess.run([sys.executable, chk, "--regress", rg] + list(extra),
 2152:                            capture_output=True, text=True)
 2153:         out = p.stdout + p.stderr
 2154:         ok = (p.returncode == want_rc) and (want_text in out)
 2155:         if forbid is not None and forbid in out:
 2156:             ok = False
 2157:         results.append(ok)
 2158:         print("  %s  %-48s rc=%d want=%d" % ("ok  " if ok else "FAIL", name,
 2159:                                              p.returncode, want_rc))
 2160:         if verbose or not ok:
