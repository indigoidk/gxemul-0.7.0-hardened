  100: 
  101: # ----------------------------------------------------------------- architecture
  102: def rotl64(x, n):
  103:     n &= 63
  104:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
  105: 
  106: 
  107: def mask_b_63(b):
  108:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
  109:     assert 0 <= b <= 63
  110:     return (1 << (64 - b)) - 1
  111: 
  112: 
  113: def mask_0_e(e):
  114:     """MASK(0,e), big-endian = the high (e+1) bits."""
  115:     assert 0 <= e <= 63
  116:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
  117: 
  118: 
  119: def mask_range(b, e):
  120:     """MASK(b,e), the architecture's own wrapping mask generator (Book I:578, PEM:6879)."""
  121:     assert 0 <= b <= 63 and 0 <= e <= 63
  122:     m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
  123:     assert m != 0, "MASK(%d,%d) came out all-zero, which architecture forbids" % (b, e)
  124:     return m
  125: 
  126: 
  127: def want_rldimi(rs_val, ra_val, sh, mb):
  128:     """Architectural rldimi result per Book I:4315."""
  129:     m = mask_range(mb, (63 - sh) & 63)
  130:     return (rotl64(rs_val, sh) & m) | (ra_val & (~m & M64))
  131: 
  132: 
  133: def want_rldicl(rs_val, sh, mb):
  134:     return rotl64(rs_val, sh) & mask_b_63(mb)
  135: 
  136: 
  137: def want_rldicr(rs_val, sh, me):
  138:     return rotl64(rs_val, sh) & mask_0_e(me)
  139: 
  140: 
  141: # -------------------------------------------------------------------- encodings
  142: def enc_md(xo, rs, ra, sh, mbe, rc=0):
  143:     """opcode 30 (rldicl/rldicr/rldimi). Book I format MD."""
  144:     assert 0 <= sh <= 63 and 0 <= mbe <= 63 and 0 <= xo <= 7
  145:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
  146:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
  147:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
  148: 
  149: 
  150: def RLDICL(ra, rs, sh, mb, rc=0):
  151:     return enc_md(0, rs, ra, sh, mb, rc)
  152: 
  153: 
  154: def RLDICR(ra, rs, sh, me, rc=0):
  155:     return enc_md(1, rs, ra, sh, me, rc)
  156: 
  157: 
  158: def RLDIMI(ra, rs, sh, mb, rc=0):
  159:     return enc_md(3, rs, ra, sh, mb, rc)
  160: 
  161: 
  162: def LI(rd, simm):
  163:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
  164: 
  165: 
  166: def ORI(ra, rs, imm):
  167:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
  168: 
  169: 
  170: NOP = ORI(0, 0, 0)
  171: 
  172: 
  173: # ---------------------------------------------------------------------- sessions
  174: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
  175:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs."""
  176:     cmds = list(setup)
  177:     for i, w in enumerate(insns):
  178:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
  179:     if insns:
  180:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
  181:     cmds.append("pc=0x%x" % CODE)
  182:     if insns:
  183:         cmds.append("step %d" % len(insns))
  184:     cmds.append("reg")
  185:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
  186:     if cpu:
  187:         argv += ["-C", cpu]
  188:     argv += ["0x%x:%s" % (CODE, DUMMY)]
  189:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
  190:     try:
  191:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
  192:                            stderr=subprocess.STDOUT, timeout=timeout)
  193:     except subprocess.TimeoutExpired as e:
  194:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
  195:         return {}, [], out, "TIMEOUT"
  196:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
  197:     rc = p.returncode
  198:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
  199:     idx = t.rfind("GXemul> reg")
  200:     regs = {}
  201:     if idx >= 0:
  202:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
  203:             regs[int(m.group(1))] = int(m.group(2), 16)
  204:         m_cr = re.search(r"\bcr\s*=\s*(0x[0-9a-fA-F]+)", t[idx:])
  205:         if m_cr:
  206:             regs["cr"] = int(m_cr.group(1), 16)
  207:     dis = []
  208:     di = t.find("GXemul> unassemble")
  209:     if di >= 0:
  210:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
  211:                 else len(t)]
  212:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
  213:                              r"(?:\t(\S+))?", seg, re.M):
  214:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
  215:     return regs, dis, t, how
  216: 
