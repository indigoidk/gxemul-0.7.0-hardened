  255:         (CLASS_RESEARCH, "#525 the frozen probe copy for the DRDY kill table -- one instrument for every leg"),
  256:     "wdc_altdigin_probe.py":
  257:         (CLASS_DETECTOR, "#525 wdc alt-ctrl READ-side offset decode -- the cell #494 left open"),
  258:     "wdc_altoffset_probe.py":
  259:         (CLASS_DETECTOR, "#494 wdc alt-ctrl offset decode -- DRQ/ring channels"),
  260:     "wdc_altoffset_sig_probe.py":
  261:         (CLASS_DETECTOR, "#494 wdc alt-ctrl offset decode -- ATAPI signature channel"),
  262:     #  The THIRD is not redundant either, and it was added to repair a MEASURED
  263:     #  floor breach found on pass 2.  The other two use only 0x06, 0x02 and 0x04 at
  264:     #  offset 1 -- all three with WDCTL_4BIT clear -- so every offset-1 row they
  265:     #  carry sits in ONE bit-3 equivalence class, and a guard reading
  266:     #  `!(idata & WDCTL_4BIT)` escaped BOTH at 36/36 and declined.  That bit is
  267:     #  libata's steady-state ap->ctl, so a mask guard re-opens the defect at exactly
  268:     #  the values the commonest driver writes.
  269:     "wdc_altoffset_4bit_probe.py":
  270:         (CLASS_DETECTOR, "#494 wdc alt-ctrl -- the WDCTL_4BIT mask-guard escape"),
  271:     #  #495.  THE FLOOR FORCED THIS ONE TO BE A DETECTOR RATHER THAN EVIDENCE: the
  272:     #  shipped 128-row offline detector scores ZERO failures with the defect LIVE,
  273:     #  so vacuity-floor clause (a) is unsatisfiable from any existing row.  This is
  274:     #  the only instrument that observes the defect at all, and it is COMPLEMENTARY
  275:     #  to diff_wdc_identify.c rather than a replacement -- each catches mutants the
  276:     #  other misses, measured.
  277:     "sgi_re_width_probe.py":
  278:         (CLASS_DETECTOR, "#497 sgi_re six-site width decline -- 35 rows, wired into gate_arm.sh"),
  279:     "wdc_addtoinbuf_probe.py":
