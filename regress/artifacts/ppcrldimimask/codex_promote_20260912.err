   80: CODE = 0x10000
   81: M64 = (1 << 64) - 1
   82: SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into destination registers
   83: RS_ONES = M64                    # all-ones source: makes every mask window observable
   84: RS_VAL = 0xDEADBEEFCAFEF00D      # pattern source
   85: SRC = 3                          # rS is always r3; r3 is never a destination
   86: DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session
