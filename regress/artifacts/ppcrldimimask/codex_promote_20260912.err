  965:     #  sgirebufuninit's two census scanners, preserved beside the brief that cites their OUTPUT.  They
  966:     #  are ANALYSIS tools, not detectors: neither has an oracle and neither is wired to anything.  They
  967:     #  are kept because the brief makes a claim about the whole device tree -- that only dev_sgi_re.c
  968:     #  carries this defect -- and a reader must be able to re-run the search rather than trust the count.
  969:     "artifacts/sgirebufuninit/scan_len.py":
  970:         (CLASS_RESEARCH, "sgirebufuninit: scans src/devices for memory_rw calls whose transfer LENGTH "
  971:                          "is not pinned to the stack buffer (6 sites). Blind by construction to a "
  972:                          "partially-filled buffer passed as sizeof(buf) -- which is what scan_fill.py "
  973:                          "exists to cover"),
  974:     "artifacts/sgirebufuninit/scan_fill.py":
  975:         (CLASS_RESEARCH, "sgirebufuninit: the companion scan -- every memory_rw that WRITES a stack "
  976:                          "byte-buffer into guest-visible memory, with whether the buffer is ever "
  977:                          "initialised wholesale (5 sites). Found dev_scc.c:305, which scan_len.py "
  978:                          "excludes by construction. NOTE its known defect, recorded because it nearly "
  979:                          "produced a wrong conclusion: the declaration map is keyed by NAME file-wide, "
  980:                          "so two functions declaring the same buffer at different sizes collapse to the "
  981:                          "last one parsed -- its `size' column reported 32 for a data[8]"),
  982:     #  #499 pass 4's FROZEN MUTATOR, preserved because the E0/E0W measurement is cited in
  983:     #  the round record and a citation into a session temp dir is not a citation.  It builds
  984:     #  the announce-then-exit(0) mutants; it is EVIDENCE, not a detector the battery owes a
  985:     #  run -- same disposition as the repin2 frozen copy below.
  986:     #
  987:     #  It also carries a lesson worth keeping next to the code: its FIRST version anchored on
  988:     #  the handler's common tail, and `memory_writemax64(cpu, data, len, odata);' occurs FIVE
  989:     #  times across FOUR handlers in dev_sgi_re.c.  The anchor matched twice and the run
  990:     #  aborted.  This version anchors on SGIRE_W_UNMAP_* text and REFUSES unless the match
  991:     #  count is exactly 1, so a wrong-handler mutation is impossible rather than unlikely.
  992:     "artifacts/sgireunmapped/killtable_20260831/pass4/e0_mut.py":
  993:         (CLASS_RESEARCH, "#499 pass 4 -- the frozen mutator for E0/E0W, the announce-then-exit(0) pair that measured the write-side floor breach.  Evidence, not a detector"),
