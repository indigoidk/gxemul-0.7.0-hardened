need_file "$IMAGES/netbsd401-macppc-GENERIC"
command -v python3 >/dev/null || gate_skip "python3 not available"
```

NEW:
```bash
need_exec "$PMAX"
command -v python3 >/dev/null || gate_skip "python3 not available"

# ppcrldimimask: bareppc owns its loader stub and needs no NetBSD image.
RLDIMILOG=$LOGDIR/gate_ppc_rldimi.log
note "rldimi: bareppc/PPC970, cold debugger; log: $RLDIMILOG"
python3 -B -u ppc_rldimi_probe.py "$PMAX" gate_ppc > "$RLDIMILOG" 2>&1 || true

# PARSE BEFORE SCORE. Collect every matching line: duplicates must fail too.
rldimi_result=$(grep '^PPC_RLDIMI_RESULT=' "$RLDIMILOG" || true)
rldimi_control=$(grep '^PPC_RLDIMI_CONTROL=' "$RLDIMILOG" || true)
rldimi_done=$(grep '^PPC_RLDIMI_PROBE_DONE' "$RLDIMILOG" || true)
rldimi_parsed=FAIL
if [[ $rldimi_result =~ ^PPC_RLDIMI_RESULT=([0-9]+)/([0-9]+)$ ]]; then
    rldimi_got=${BASH_REMATCH[1]}
    rldimi_total=${BASH_REMATCH[2]}
    if [[ $rldimi_control == PPC_RLDIMI_CONTROL=OK ||
          $rldimi_control == PPC_RLDIMI_CONTROL=FAIL ]] &&
       [[ $rldimi_done == PPC_RLDIMI_PROBE_DONE ]]; then
        rldimi_parsed=OK
    fi
fi
check "rldimi protocol parsed exactly once" "$rldimi_parsed" "OK"
if [[ $rldimi_parsed != OK ]]; then
    note "rldimi protocol missing, malformed or duplicated; no score accepted"
    tail -10 "$RLDIMILOG" | sed 's/^/       /'
    gate_end
    exit 1
fi

grep -E " ok$| FAIL$" "$RLDIMILOG" | sed 's/^/       /'
rldimi_ctrl=${rldimi_control#*=}
check "rldimi controls prove the probe measures" "$rldimi_ctrl" "OK"
if [[ $rldimi_ctrl != OK ]]; then
    note "rldimi apparatus failed; no correctness score accepted"
    gate_end
    exit 1
fi

# Both expectations are literal: a shortened perfect table must fail.
check "rldimi rows run" "$rldimi_total" 27
check "rldimi rows correct" "$rldimi_got" 27
if [[ $rldimi_total != 27 || $rldimi_got != 27 ]]; then
    gate_end
    exit 1
fi

# Do not let the FP prerequisite turn completed rldimi checks into gate_skip.
if [[ ! -f "$IMAGES/netbsd401-macppc-GENERIC" ]]; then
    note "FP leg NOT RUN: missing $IMAGES/netbsd401-macppc-GENERIC"
    note "Only bareppc rldimi checks completed in this gate run"
    gate_end
    exit $?
fi
```

This replaces the missing-image whole-gate SKIP with explicit partial-coverage reporting after the bare-PPC checks. A failing bare-PPC leg finalizes before any later FP skip path.

