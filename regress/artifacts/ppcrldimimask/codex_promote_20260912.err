   88: rows = []
   89: 
   90: 
   91: def row(name, got, want, note=""):
   92:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
   93:     assert len(name) <= 18, name
   94:     ok = (got == want)
   95:     rows.append((name, ok))
   96:     print("%-19s %-20s %-20s %-46s %s" % (name, str(got), str(want), note,
   97:                                           "ok" if ok else "FAIL"))
   98:     return ok
