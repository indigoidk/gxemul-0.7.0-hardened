spec = json.loads(r'''{\"paths\":[\"C:\\\\DocumentNoSnc\\\\CC\\\\GXEMUL\\\\GXEMUL-SEC\\\\src\\\\cpus\\\\cpu_ppc_instr.c\",\"C:\\\\DocumentNoSnc\\\\CC\\\\GXEMUL\\\\GXEMUL-SEC\\\\regress\\\\artifacts\\\\ppcrldimimask\\\\opus_ppc_rldimi_witness_20260911.py\",\"C:\\\\DocumentNoSnc\\\\CC\\\\GXEMUL\\\\GXEMUL-SEC\\\\regress\\\\ppc_rldicl_probe.py\",\"C:\\\\DocumentNoSnc\\\\CC\\\\GXEMUL\\\\GXEMUL-SEC\\\\regress\\\\gate_ppc.sh\",\"C:\\\\DocumentNoSnc\\\\CC\\\\GXEMUL\\\\GXEMUL-SEC\\\\tools\\\\pipeline\\\\check_probe_wiring.py\"],\"witness\":[[\"\\\"\\\"\\\"ppcrldimimask -- RUNG-3 WITNESS for X(rldimi) mask bounds and wrapping defects.\",\"\\\"\\\"\\\"ppcrldimimask -- RUNG-3 DETECTOR for X(rldimi) mask bounds and wrapping defects.\"],[\"Sentinel: PPC_RLDIMI_WITNESS_DONE\",\"SHIPPED CONTRACT:\\n  27 rows; 495 distinct census cells. The census uses an all-ones source and\\n  does not test rotate amount independently of mask bounds. Pattern rows do.\\n  The CR row checks readback presence only; CR0 value semantics are not covered.\\n  This detector contains no rlwimi rows.\\n\\nSentinel: PPC_RLDIMI_PROBE_DONE\"],[\"import re\\nimport subprocess\\nimport sys\\nimport time\\n\\nif len(sys.argv) < 2:\\n    sys.stderr.write(\\\"usage: opus_ppc_rldimi_witness_20260911.py <gxemul> [label]\\\\n\\\")\\n    sys.exit(2)\\n\\nBIN = sys.argv[1]\\nLABEL = sys.argv[2] if len(sys.argv) > 2 else \\\"local\\\"\\nDUMMY = \\\"/tmp/ppc_rldimi_dummy.bin\\\"\\nopen(DUMMY, \\\"wb\\\").write(b\\\"\\\\x00\\\\x00\\\\x00\\\\x00\\\")\",\"import atexit\\nimport os\\nimport re\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\n\\nif len(sys.argv) < 2:\\n    sys.stderr.write(\\\"usage: ppc_rldimi_probe.py <gxemul> [label]\\\\n\\\")\\n    sys.exit(2)\\n\\nBIN = sys.argv[1]\\nLABEL = sys.argv[2] if len(sys.argv) > 2 else \\\"local\\\"\\n_scratch = tempfile.TemporaryDirectory(prefix=\\\"gxemul-ppc-rldimi-\\\")\\natexit.register(_scratch.cleanup)\\nDUMMY = os.path.join(_scratch.name, \\\"stub.bin\\\")\\nwith open(DUMMY, \\\"wb\\\") as stub:\\n    stub.write(b\\\"\\\\x00\\\\x00\\\\x00\\\\x00\\\")\"],[\"print(\\\"ppcrldimimask RUNG-3 WITNESS -- binary=%s label=%s\\\" % (BIN, LABEL))\",\"print(\\\"ppcrldimimask RUNG-3 DETECTOR -- binary=%s label=%s\\\" % (BIN, LABEL))\"],[\"row(\\\"cr0 record form\\\", \\\"exit0\\\" if \\\"cr\\\" in cr_regs else \\\"no-cr\\\", \\\"exit0\\\",\\n    \\\"rldimi. executes with Rc=1 and dumps CR\\\")\",\"row(\\\"cr parsed\\\", \\\"yes\\\" if \\\"cr\\\" in cr_regs else \\\"no\\\", \\\"yes\\\",\\n    \\\"CR dump parsed; CR0 value semantics are not asserted\\\")\"],[\"row(\\\"disasm total\\\", \\\"%d/%d\\\" % (disasm_ok, disasm_checked),\\n    \\\"%d/%d\\\" % (disasm_checked, disasm_checked),\\n    \\\"every placed word re-read by disassembler\\\")\\nrow(\\\"census run\\\", census_run, len(uniq_census),\\n    \\\"(SH,MB) cells driven across sweeps and diagonals\\\")\",\"row(\\\"disasm total\\\", \\\"%d/%d\\\" % (disasm_ok, disasm_checked), \\\"511/511\\\",\\n    \\\"control/core/census disassembly; excludes CR and rejection sessions\\\")\\nrow(\\\"census run\\\", census_run, 495,\\n    \\\"(SH,MB) cells driven across sweeps and diagonals\\\")\"],[\"# ================================================================ SCORE + DONE\\nnpass = sum(1 for _, ok in rows if ok)\\nprint(\\\"\\\")\\nprint(\\\"SCORE %d/%d  elapsed=%.1fs  binary=%s  label=%s\\\"\\n      % (npass, len(rows), time.time() - t0, BIN, LABEL))\\nprint(\\\"FAILING: \\\" + \\\", \\\".join(n for n, ok in rows if not ok))\\nprint(\\\"PPC_RLDIMI_WITNESS_DONE\\\")\",\"# ================================================================ SCORE + DONE\\ncontrol_names = (\\n    \\\"session\\\", \\\"live\\\", \\\"seed holds\\\", \\\"src intact\\\", \\\"disasm xcheck\\\",\\n    \\\"ctl rldicl\\\", \\\"ctl rldicr\\\", \\\"neg apparatus\\\",\\n    \\\"bits32 live\\\", \\\"bits32 rld bad\\\", \\\"cr parsed\\\",\\n    \\\"disasm total\\\", \\\"census run\\\",\\n)\\nrow_status = dict(rows)\\ncontrol_ok = all(row_status.get(name, False) for name in control_names)\\nnpass = sum(1 for _, ok in rows if ok)\\nprint(\\\"\\\")\\nprint(\\\"SCORE %d/%d  elapsed=%.1fs  binary=%s  label=%s\\\"\\n      % (npass, len(rows), time.time() - t0, BIN, LABEL))\\nprint(\\\"FAILING: \\\" + \\\", \\\".join(n for n, ok in rows if not ok))\\nprint(\\\"PPC_RLDIMI_RESULT=%d/%d\\\" % (npass, len(rows)))\\nprint(\\\"PPC_RLDIMI_CONTROL=%s\\\" % (\\\"OK\\\" if control_ok else \\\"FAIL\\\"))\\nprint(\\\"PPC_RLDIMI_PROBE_DONE\\\")\\nsys.exit(0 if control_ok and len(rows) == 27 and npass == 27 else 1)\"]],\"gate\":[[\"gate_begin \\\"gate 13: PowerPC FP conversion + FPSCR (#304/#305/#324-#330)\\\"\",\"gate_begin \\\"gate 13: PowerPC rldimi + FP conversion + FPSCR (#304/#305/#324-#330)\\\"\"],[\"need_exec \\\""'$PMAX'"\\\"\\nneed_file \\\""'$IMAGES/netbsd401-macppc-GENERIC'"\\\"\\ncommand -v python3 >/dev/null || gate_skip \\\"python3 not available\\\"\",\"need_exec \\\""'$PMAX'"\\\"\\ncommand -v python3 >/dev/null || gate_skip \\\"python3 not available\\\"\\n\\n# ppcrldimimask: bareppc owns its loader stub and needs no NetBSD image.\\nRLDIMILOG="'$LOGDIR/gate_ppc_rldimi.log'"\\nnote \\\"rldimi: bareppc/PPC970, cold debugger; log: "'$RLDIMILOG'"\\\"\\npython3 -B -u ppc_rldimi_probe.py \\\""'$PMAX'"\\\" gate_ppc > \\\""'$RLDIMILOG'"\\\" 2>&1 || true\\n\\n# PARSE BEFORE SCORE. Collect every matching line: duplicates must fail too.\\nrldimi_result="'$(grep '"'"'^PPC_RLDIMI_RESULT='"' \\\""'$RLDIMILOG'"\\\" || true)\\nrldimi_control="'$(grep '"'"'^PPC_RLDIMI_CONTROL='"' \\\""'$RLDIMILOG'"\\\" || true)\\nrldimi_done="'$(grep '"'"'^PPC_RLDIMI_PROBE_DONE'"' \\\""'$RLDIMILOG'"\\\" || true)\\nrldimi_parsed=FAIL\\nif [[ "'$rldimi_result =~ ''^PPC_RLDIMI_RESULT=([0-9]+)/([0-9]+)$ ]]; then'"\\n    rldimi_got="'${BASH_REMATCH[1]}'"\\n    rldimi_total="'${BASH_REMATCH[2]}'"\\n    if [[ "'$rldimi_control == PPC_RLDIMI_CONTROL=OK ||'"\\n          "'$rldimi_control == PPC_RLDIMI_CONTROL=FAIL ]] &&'"\\n       [[ "'$rldimi_done == PPC_RLDIMI_PROBE_DONE ]]; then'"\\n        rldimi_parsed=OK\\n    fi\\nfi\\ncheck \\\"rldimi protocol parsed exactly once\\\" \\\""'$rldimi_parsed'"\\\" \\\"OK\\\"\\nif [[ "'$rldimi_parsed != OK ]]; then'"\\n    note \\\"rldimi protocol missing, malformed or duplicated; no score accepted\\\"\\n    tail -10 \\\""'$RLDIMILOG'"\\\" | sed 's/"'^/       /'"'\\n    gate_end\\n    exit 1\\nfi\\n\\ngrep -E \\\" ok"'$| FAIL$'"\\\" \\\""'$RLDIMILOG'"\\\" | sed 's/"'^/       /'"'\\nrldimi_ctrl="'${rldimi_control#*=}'"\\ncheck \\\"rldimi controls prove the probe measures\\\" \\\""'$rldimi_ctrl'"\\\" \\\"OK\\\"\\nif [[ "'$rldimi_ctrl != OK ]]; then'"\\n    note \\\"rldimi apparatus failed; no correctness score accepted\\\"\\n    gate_end\\n    exit 1\\nfi\\n\\n# Both expectations are literal: a shortened perfect table must fail.\\ncheck \\\"rldimi rows run\\\" \\\""'$rldimi_total'"\\\" 27\\ncheck \\\"rldimi rows correct\\\" \\\""'$rldimi_got'"\\\" 27\\nif [[ "'$rldimi_total != 27 || $rldimi_got != 27 ]]; then'"\\n    gate_end\\n    exit 1\\nfi\\n\\n# Do not let the FP prerequisite turn completed rldimi checks into gate_skip.\\nif [[ "'! -f '"\\\""'$IMAGES/netbsd401-macppc-GENERIC'"\\\" ]]; then\\n    note \\\"FP leg NOT RUN: missing "'$IMAGES/netbsd401-macppc-GENERIC'"\\\"\\n    note \\\"Only bareppc rldimi checks completed in this gate run\\\"\\n    gate_end\\n    exit "'$?'"\\nfi\"]],\"manifest\":[[\"    # -- #522 ppcrldiclzero -------------------------------------------------------------\",\"    \\\"ppc_rldimi_probe.py\\\": (CLASS_DETECTOR, \\\"ppcrldimimask: bareppc rldimi mask bounds, wrapping and destination preservation; promoted-table measurements pending\\\"),\\n    \\\"artifacts/ppcrldimimask/opus_ppc_rldimi_witness_20260911.py\\\":\\n        (CLASS_RESEARCH, \\\"ppcrldimimask: original artifact instrument preserved as evidence\\\"),\\n    \\\"artifacts/ppcrldimimask/killtable_20260912/ppc_rldimi_probe.frozen.py\\\":\\n        (CLASS_RESEARCH, \\\"ppcrldimimask: frozen promoted instrument; must be byte-identical to the shipped probe\\\"),\\n    # -- #522 ppcrldiclzero -------------------------------------------------------------\"]],\"exempt\":[[\"    \\\"ppc_rldicl_probe.py\\\":         (\\\"2026-09-20\\\",\\n                                    \\\"no gate EXECUTES a 64-bit PowerPC CPU -- gate 9 \\\"\\n                                    \\\"constructs them with no result oracle; gate_ppc.sh \\\"\\n                                    \\\"is the named home, filed to wiringcliff\\\"),\",\"    \\\"ppc_rldimi_probe.py\\\":         (\\\"2026-09-20\\\",\\n                                    \\\"gate_ppc.sh owes the bareppc result/control leg; \\\"\\n                                    \\\"promotion awaiting gate validation, filed to wiringcliff\\\"),\\n    \\\"ppc_rldicl_probe.py\\\":         (\\\"2026-09-20\\\",\\n                                    \\\"no gate EXECUTES a 64-bit PowerPC CPU -- gate 9 \\\"\\n                                    \\\"constructs them with no result oracle; gate_ppc.sh \\\"\\n                                    \\\"is the named home, filed to wiringcliff\\\"),\"]]}''')

def read_allowed(index):
    with open(spec[\"paths\"][index], \"r\", encoding=\"utf-8\") as fh:
        return fh.read()

def replace_once(source, edits, label):
    original = source
    for n, (old, new) in enumerate(edits, 1):
        if original.count(old) "'!= 1 or source.count(old) != 1:
            raise AssertionError((label, n, original.count(old), source.count(old)))
        source = source.replace(old, new, 1)
    print(label + ": all old strings occur once")
    return source

probe = replace_once(read_allowed(1), spec["witness"], "probe")
gate = replace_once(read_allowed(3), spec["gate"], "gate")
checker = read_allowed(4)
registered = replace_once(checker, spec["manifest"], "manifest")
staged = replace_once(registered, spec["exempt"], "interim exemption")
for label, source in (("probe", probe), ("checker gated", registered), ("checker interim", staged)):
    ast.parse(source)
    print(label + ": Python AST parses")

tree = ast.parse(registered)
for dictionary in ("MANIFEST", "EXEMPT"):
    node = next(n.value for n in tree.body if isinstance(n, ast.Assign)
                and any(isinstance(t, ast.Name) and t.id == dictionary for t in n.targets))
    keys = [ast.literal_eval(key) for key in node.keys]
    assert len(keys) == len(set(keys))
    print(dictionary + ": no duplicate keys")

rows = [n.args[0].value for n in ast.walk(ast.parse(probe))
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
        and n.func.id == "row" and isinstance(n.args[0], ast.Constant)]
assert len(rows) == 27 and len(set(rows)) == 27
print("probe: 27 distinct row call sites")

names = {"HERE_DIRS", "INTERP_RE", "CMDPOS_RE", "VAR_RE", "ASSIGN_RE"}
selected = [n for n in tree.body
            if (isinstance(n, ast.FunctionDef) and n.name in {"unquote", "exec_sites"})
            or (isinstance(n, ast.Assign)
