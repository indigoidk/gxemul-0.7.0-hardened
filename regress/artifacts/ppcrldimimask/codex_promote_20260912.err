 2379: def main(argv):
 2380:     verbose = "-v" in argv or "--verbose" in argv
 2381:     if "--selftest" in argv:
 2382:         return selftest(verbose)
 2383:     regress = DEFAULT_REGRESS
 2384:     today = None
 2385:     for i, a in enumerate(argv):
 2386:         if a == "--regress" and i + 1 < len(argv):
 2387:             regress = os.path.abspath(argv[i + 1])
 2388:         if a == "--today" and i + 1 < len(argv):
 2389:             today = argv[i + 1]
 2390:     if today is None:
 2391:         import datetime
 2392:         today = datetime.date.today().isoformat()
 2393: 
 2394:     fails, notes = [], []
 2395: 
 2396:     if not os.path.isdir(regress):
 2397:         print("PROBEWIRING_FAIL  no regress dir at %s" % regress)
 2398:         return 1
 2399: 
 2400:     scripts, err = gate_list(regress)
 2401:     if err:
 2402:         print("  FAIL  %s" % err)
 2403:         print("PROBEWIRING_FAIL  the battery could not be derived")
 2404:         return 1
 2405:     scripts = scripts + [s for s in ALWAYS if s not in scripts]
 2406: 
 2407:     hits, ignored, missing = exec_sites(regress, scripts)
 2408:     for s in missing:
 2409:         fails.append("run.sh names %s and the file does not exist -- the battery is broken" % s)
 2410: 
 2411:     on_disk, mode = domain(regress)
 2412: 
 2413:     for f in on_disk:
 2414:         if f not in MANIFEST:
 2415:             fails.append("UNCLASSIFIED  %s is not in check_probe_wiring.py's MANIFEST.\n"
 2416:                          "                classify it detector (green once fixed), witness "
 2417:                          "(red once fixed) or tool." % f)
 2418:     for f in sorted(MANIFEST):
 2419:         if f not in on_disk:
 2420:             fails.append("GHOST  the MANIFEST names %s and regress/ has no such file -- "
 2421:                          "delete the entry" % f)
 2422: 
 2423:     rows = []
 2424:     for f in on_disk:
 2425:         if f not in MANIFEST:
 2426:             continue
 2427:         cls, why = MANIFEST[f]
 2428:         where = hits.get(f, [])
 2429:         if cls not in CLASSES:
 2430:             fails.append("BAD CLASS  %s is classified '%s'; want one of %s"
 2431:                          % (f, cls, "/".join(CLASSES)))
 2432:             continue
 2433: 
 2434:         if cls == CLASS_TOOL and (f.endswith("_probe.py") or f.endswith("_witness.py")):
 2435:             fails.append("MISFILED  %s is classified 'tool'. A file named *_probe.py or "
 2436:                          "*_witness.py asserts something; classify it detector or witness."
 2437:                          % f)
 2438: 
 2439:         if cls == CLASS_DETECTOR:
 2440:             if where:
 2441:                 state = "RUN by " + ", ".join(where)
 2442:                 if f in EXEMPT:
 2443:                     fails.append("STALE EXEMPTION  %s is RUN by %s and still carries an "
 2444:                                  "exemption dated %s -- the debt is paid, delete the line"
 2445:                                  % (f, where[0], EXEMPT[f][0]))
 2446:             elif f in EXEMPT:
 2447:                 d = EXEMPT[f][0]
 2448:                 if not DATE_RE.match(d or ""):
 2449:                     fails.append("MALFORMED EXEMPTION  %s:'%s' is not YYYY-MM-DD. A date "
 2450:                                  "nothing validates never expires -- refusing to guess."
 2451:                                  % (f, d))
 2452:                     state = "EXEMPT(BAD-DATE)"
 2453:                 elif d < today:
 2454:                     fails.append("EXPIRED EXEMPTION  %s came due %s (today %s) and is still "
 2455:                                  "run by no gate" % (f, d, today))
 2456:                     state = "EXEMPT(EXPIRED %s)" % d
 2457:                 else:
 2458:                     state = "EXEMPT until %s" % d
 2459:             else:
 2460:                 fails.append("UNWIRED DETECTOR  %s is run by NO gate and has no dated "
 2461:                              "exemption.\n                wire it into a gate, or add a dated "
 2462:                              "line to EXEMPT naming the gate that owes it." % f)
 2463:                 state = "UNWIRED"
 2464:         elif cls == CLASS_WITNESS:
 2465:             if where:
 2466:                 fails.append("GATED WITNESS  %s is invoked at %s. A witness asserts the "
 2467:                              "PRE-FIX symptom, so it goes RED the day the fix lands -- "
 2468:                              "gating it manufactures a regression." % (f, where[0]))
 2469:                 state = "GATED (must not be): " + ", ".join(where)
 2470:             else:
 2471:                 state = "not run (correct)"
 2472:         else:
 2473:             state = ("RUN by " + ", ".join(where)) if where else "-"
 2474: 
 2475:         if cls in (CLASS_DETECTOR, CLASS_WITNESS):
 2476:             lbl = self_label(os.path.join(regress, f))
 2477:             if lbl and lbl != cls:
 2478:                 notes.append("SELFLABEL  %s: manifest says %s, its own summary line says %s. "
 2479:                              "Advisory only -- self-labels are measurably unreliable in both "
 2480:                              "directions." % (f, cls, lbl))
 2481:         rows.append((cls, f, state, why))
 2482: 
 2483:     for f in sorted(EXEMPT):
 2484:         if f not in MANIFEST:
 2485:             fails.append("ORPHAN EXEMPTION  %s is exempted and is not in the MANIFEST" % f)
 2486:         elif MANIFEST[f][0] != CLASS_DETECTOR:
 2487:             fails.append("ORPHAN EXEMPTION  %s is classified '%s'; only a detector can be "
 2488:                          "exempted from being run" % (f, MANIFEST[f][0]))
 2489: 
 2490:     print("  check_probe_wiring: %d python artefacts in %s/ [%s], %d battery scripts "
 2491:           "from run.sh" % (len(on_disk), os.path.basename(regress), mode, len(scripts)))
 2492:     if verbose:
 2493:         for cls in CLASSES:
 2494:             for c, f, state, why in rows:
 2495:                 if c == cls:
 2496:                     print("    %-8s %-28s %-38s %s" % (c, f, state, why))
 2497:         for line in ignored:
 2498:             print("    IGNORED  %s   (not the regress copy)" % line)
 2499:     for n in notes:
 2500:         print("  note  %s" % n)
 2501:     for f in fails:
 2502:         print("  FAIL  %s" % f)
 2503: 
 2504:     det = [r for r in rows if r[0] == CLASS_DETECTOR]
 2505:     run = [r for r in det if r[2].startswith("RUN")]
 2506:     ex = [r for r in det if r[2].startswith("EXEMPT")]
 2507:     wit = [r for r in rows if r[0] == CLASS_WITNESS]
 2508:     if fails:
 2509:         print("PROBEWIRING_FAIL  %d problem(s); %d/%d detectors run by a gate, %d dated-exempt"
 2510:               % (len(fails), len(run), len(det), len(ex)))
 2511:         return 1
 2512:     print("PROBEWIRING_PASS  %d/%d detectors run by a gate, %d dated-exempt, %d witnesses "
 2513:           "correctly ungated" % (len(run), len(det), len(ex), len(wit)))
 2514:     return 0
 2515: 
 2516: 
 2517: if __name__ == "__main__":
 2518:     sys.exit(main(sys.argv[1:]))

