 1322:     "sh4_rtcsr_probe.py":          (CLASS_DETECTOR, "#449 sh4 RTCSR refresh-interrupt enables"),
 1323:     "sh4_rtcsr_witness.py":        (CLASS_WITNESS,  "#449 pre-fix symptom: a DELAYED host death"),
 1324:     "artifacts/shortread/round_20260827/shortread_witness.py": (CLASS_WITNESS,
 1325:                                     "#488 rung-3 on unmodified landisk: a guest READ SECTORS "
 1326:                                     "reads 0x0000 where the disk holds 'B','B' on the committed "
 1327:                                     "build AND on the rejected alternative, 0x4242 on the fix.  "
 1328:                                     "Not gated: it needs a hand-built truncated overlay (a "
 1329:                                     "200-byte data file plus a claiming .map) that no gate "
 1330:                                     "constructs, and a witness is checked for the ABSENCE of a "
 1331:                                     "gate call by design.  Preserved with all three transcripts."),
 1332:     "gdrom_toclen_probe.py":       (CLASS_DETECTOR,
 1333:                                     "#489 case 0x14 TOC length: a guest-supplied cnt is "
 1334:                                     "DECLINED with a latched (once) diagnostic instead of "
 1335:                                     "ending the host.  19 rows, gated in gate_sh_rounding.sh "
 1336:                                     "with a literal denominator pin.  Every value the guard "
 1337:                                     "refuses carries a DECLINE-CHANNEL row (bad/zero/over "
 1338:                                     "cond) and so does the latched STATE (latch cond) -- four "
 1339:                                     "measured escapes across three earlier row sets all had "
 1340:                                     "the same shape: a survive-only row is vacuous here."),
 1341:     "artifacts/wdcnoirq/witness_20260827/wdcnoirq_rung3_probe.py": (CLASS_WITNESS,
 1342:                                     "#485 rung-3 witness, PRESERVED INTO THE REPO 2026-08-28.  "
 1343:                                     "The ledger's witness field cited _scratchpad/witness485/ -- a "
 1344:                                     "volatile path -- and the files were still there, so this is a "
 1345:                                     "copy of a live witness rather than a reconstruction.  Its "
 1346:                                     "pre/post rows and transcripts sit beside it.  Ungated by "
 1347:                                     "design: a witness licenses a fix and is not a standing "
 1348:                                     "detector; #485's standing coverage is its kill table."),
 1349:     "artifacts/gdromexitsix/gdrom_toclen_witness.py": (CLASS_WITNESS,
 1350:                                     "gdromexitsix rung-3 on the unmodified dreamcast machine: "
 1351:                                     "nine guest accesses, cnt=407 and cnt=0 each end the host at "
 1352:                                     "the case 0x14 TOC length guard (exit1), while cnt=408 "
 1353:                                     "synthesizes a real TOC and survives.  MEASURED RED 8/8 on "
 1354:                                     "the committed build before any edit to the site.  Not "
 1355:                                     "gated, and a witness is checked for the ABSENCE of a gate "
 1356:                                     "call by design -- its badlen/zerolen rows INVERT the day "
 1357:                                     "the fix lands, so gating it manufactures a regression.  "
 1358:                                     "Preserved under artifacts/ because this row's previous TWO "
 1359:                                     "witnesses lived in a rotated scratchpad and no longer "
 1360:                                     "exist, which is why its witness field had to read `none`."),
 1361:     #  #496's DETECTOR, gated in gate_sh_rounding.sh.  It is the WITNESS's opposite number
 1362:     #  and the pair is worth reading together: the witness reads SURVIVAL and the detector is
 1363:     #  FORBIDDEN from reading it, because post-fix every one of these accesses exits 0.  Two
 1364:     #  files, opposite oracles, same defect -- which is why one is gated and one must not be.
 1365:     "gdrom_cond_probe.py":
 1366:         (CLASS_DETECTOR, "#496 GDROM_UNKNOWN_0x88 + GDROM_COND bad-value declines and the "
 1367:                          "d->cond store relocation -- 16 rows, keystone `R5 cond keep`"),
 1368: 
 1369:     #  gdromcondlies RUNG-3 WITNESS, 2026-08-30.  CLASS_WITNESS on the toclen precedent
 1370:     #  three entries up, and for the identical reason: its two kill rows INVERT the day
 1371:     #  the fix lands, so gating it would manufacture a regression.  The round's standing
 1372:     #  coverage is its own detector, which is a separate deliverable.
 1373:     "artifacts/gdromcondlies/witness_20260830/gdrom_cond_witness.py": (CLASS_WITNESS,
 1374:                                     "gdromcondlies rung-3 on the unmodified -E dreamcast: "
 1375:                                     "one guest mov.w per site ends the host at both live "
 1376:                                     "BADVAL exits (GDROM_UNKNOWN_0x88 != 0xb, GDROM_COND "
 1377:                                     "unmodelled), 15/15 on the committed build before any "
 1378:                                     "edit.  Carries BOTH mandatory controls plus two the "
 1379:                                     "ladder does not require and this result needs: a "
 1380:                                     "DEVICE-SIGNATURE row in the strong form (a "
 1381:                                     "TRANSFORMATION only the device performs -- the write "
 1382:                                     "arm masks to a byte, so 0x1234 to CNTLO reads back "
 1383:                                     "0x34, which RAM would not do), and ACCEPT rows.  The "
 1384:                                     "accept rows are what pin the defect to the VALUE and "
 1385:                                     "therefore to #443 BADVAL, rather than to the offset "
 1386:                                     "being unserviceable, which is the already-fixed #461 "
 1387:                                     "default-arm defect.  *** ITS ACCEPT ROWS MUST NOT BE "
 1388:                                     "CARRIED INTO THE DETECTOR UNCHANGED: they discriminate "
 1389:                                     "on SURVIVAL, and the fix makes survival universally "
 1390:                                     "green -- a survival oracle at a refusal-effect site is "
 1391:                                     "the CHANNEL check's canonical vacuous row.  Named by "
 1392:                                     "the fable5 seat on pass 1, before the detector existed."),
 1393:     #  #497 PASS 1, the opus5 seat, 2026-08-30.  CLASS_RESEARCH: these are EVIDENCE preserved
 1394:     #  so two measured escapes can be re-run rather than believed, not tests owed a gate.
 1395:     #
 1396:     #  They matter more than a usual artifacts drop because the seat DISCHARGED THE WITNESS
 1397:     #  OBLIGATION with them -- 26/26 across all six sites in both directions, where the round's
 1398:     #  original witness covered one site and stores only.  That settled a live scope
 1399:     #  disagreement between two seats by measurement instead of by argument.
 1400:     #
 1401:     #  `opus497_read_probe.py` is the re-aimed witness (its `lw` rows are the ones that expose
 1402:     #  the writeflag-conjunct escape); `latch_probe.py` drives two sites in ONE session, which
 1403:     #  is the only shape that can see a latch-bit collision; the three `apply_*.py` build the
 1404:     #  fix and the two mutants.
