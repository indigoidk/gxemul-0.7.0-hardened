 1312:     #  CLASSIFIED WHILE ITS OWN ROUND WAS STILL IN THE INDEX, and that is the check working
 1313:     #  rather than an exception to it: this file was `git add`ed by a concurrent #446 round
 1314:     #  MINUTES after this checker was written, went straight into the domain, and was named
 1315:     #  UNCLASSIFIED on the first run.  Reading it settled both questions in under a minute --
 1316:     #  its own first line says "#446 DETECTOR", and gate_offline.sh:1815 really does run it,
 1317:     #  so it needs no exemption.  #446 wired its probe in the same commit as its fix.
 1318:     "sgi_eaddr_probe.py":          (CLASS_DETECTOR, "#446 SGI eaddr value oracle at arcbios_init"),
 1319:     "sh4_pcic_probe.py":           (CLASS_DETECTOR, "#443 sh4 PCIC exit sites"),
