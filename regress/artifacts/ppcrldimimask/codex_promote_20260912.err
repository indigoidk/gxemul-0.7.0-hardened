  943:     "sgi_re_randompixel_probe.py":
  944:         (CLASS_DETECTOR, "#504 sgirandompixel -- horrible_getputpixel's unimplemented-mode arm is a "
  945:                          "latched decline; 8 rows, wired into gate_arm.sh in the same commit as the "
  946:                          "fix. It is BOTH the rung-3 witness and the detector. The `lin_b diag once' "
  947:                          "row requires the probe's 1x4 rectangle: with a single pixel an UNLATCHED "
