 1758: def gate_list(regress):
 1759:     """The battery's OWN array is the authority on which scripts run.
 1760: 
 1761:     Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
 1762:     second-order property worth having: a gate script that exists but was dropped out of
 1763:     GATES does not run, so every probe it owned becomes unwired here and this goes RED.
 1764:     A glob would have called those probes gated forever.
 1765:     """
 1766:     run = os.path.join(regress, "run.sh")
 1767:     if not os.path.isfile(run):
 1768:         return None, "regress/run.sh is missing -- cannot tell which gates run"
 1769:     m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
 1770:     if not m:
 1771:         return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
 1772:     return [n + ".sh" for n in m.group(1).split()], None
 1773: 
 1774: 
 1775: def exec_sites(regress, scripts):
 1776:     """Return (hits, ignored, missing).
 1777: 
 1778:     hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
 1779:     ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
 1780:     """
 1781:     hits, ignored, missing = {}, [], []
 1782:     for script in scripts:
 1783:         path = os.path.join(regress, script)
 1784:         if not os.path.isfile(path):
 1785:             missing.append(script)
 1786:             continue
 1787:         lines = read(path).splitlines()
 1788:         #  One-level variable map, from this file only.  gate_hygiene really does write
 1789:         #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
 1790:         #  one level would report a genuinely gated probe as unwired -- and a false red is
 1791:         #  how a rule gets switched off.
 1792:         varmap = {}
 1793:         for ln in lines:
 1794:             if ln.lstrip().startswith("#"):
 1795:                 continue
 1796:             a = ASSIGN_RE.match(ln)
 1797:             if a and ".py" in a.group(2):
 1798:                 varmap[a.group(1)] = unquote(a.group(2))
 1799:         #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
 1800:         #  flagship review MEASURED it: an invocation-shaped line inside a
 1801:         #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
 1802:         #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
 1803:         #  its own invocation is an entirely natural shape.  Latent rather than live -- every
 1804:         #  `<<` site in the battery today is a data table or a python program body, none
 1805:         #  carrying an interpreter plus a probe in body position -- but this is the
 1806:         #  dangerous direction: it does not fail loudly, it stops demanding a gate.
 1807:         #
 1808:         #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
 1809:         #  that GENERATES a script the gate then runs is genuine wiring one level away, and
 1810:         #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
 1811:         #  That is the right error to make.
 1812:         body = set()
 1813:         pend = None
 1814:         for no, ln in enumerate(lines, 1):
 1815:             if pend is not None:
 1816:                 body.add(no)
 1817:                 if ln.strip() == pend:
 1818:                     pend = None
 1819:                 continue
 1820:             h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
 1821:             if h and not ln.lstrip().startswith("#"):
 1822:                 pend = h.group(1)
 1823: 
 1824:         for no, ln in enumerate(lines, 1):
 1825:             if ln.lstrip().startswith("#") or no in body:
 1826:                 continue
 1827:             for m in INTERP_RE.finditer(ln):
 1828:                 if not CMDPOS_RE.match(ln[: m.start()]):
 1829:                     continue
 1830:                 toks = ln[m.end():].split()
 1831:                 if toks and toks[0].startswith("-c"):
 1832:                     continue          # an inline program, not a script invocation
 1833:                 for tok in toks:
 1834:                     t = unquote(tok)
 1835:                     v = VAR_RE.match(t)
 1836:                     if v:
 1837:                         t = varmap.get(v.group(1), "")
 1838:                     if not t.endswith(".py"):
 1839:                         continue
 1840:                     d, b = os.path.split(t)
 1841:                     if d in HERE_DIRS:
 1842:                         hits.setdefault(b, []).append("%s:%d" % (script, no))
 1843:                     else:
 1844:                         #  #471: a NESTED invocation is keyed by its RELATIVE PATH, not
 1845:                         #  its basename.  Before this, a gate invoking
 1846:                         #  `artifacts/.../gdrom_pio_null_probe.py` was filed as an
 1847:                         #  EXTERNAL reference and IGNORED -- so the detector #465 wired
 1848:                         #  by hand still reported UNWIRED once the scan could see it.
 1849:                         #
 1850:                         #  Path keys are also what makes the re-key SAFE: two detectors
 1851:                         #  sharing a basename in different directories stay distinct,
 1852:                         #  where basename keys would mark BOTH gated when only one is.
 1853:                         rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
 1854:                         if os.path.isfile(os.path.join(regress, rel)):
 1855:                             hits.setdefault(rel, []).append("%s:%d" % (script, no))
 1856:                         else:
 1857:                             ignored.append("%s:%d  %s" % (script, no, t))
 1858:                     break             # the first .py argument is the script
 1859:     return hits, ignored, missing
