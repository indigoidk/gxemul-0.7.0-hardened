from itertools import product
M32 = (1 << 32) - 1
M64 = (1 << 64) - 1

def arch_mask(b, e):
    return sum(1 << (63-p) for p in range(64)
               if (b <= p <= e if b <= e else p >= b or p <= e))

masks = {(b,e): arch_mask(b,e) for b in range(64) for e in range(64)}

def rotate_bits(s, n, width):
    bits = format(s & ((1 << width)-1), '0%db' % width)
    return int(bits[n:] + bits[:n], 2)

def repaired_rldimi(s, d, sh, mb, endpoint_constant=64):
    n = sh
    while n "'!= 0:
        n -= 1
        b = (s >> 63) & 1
        s = ((s << 1) | b) & M64
    m, mask, iterations = mb, 0, 0
    while True:
        assert 0 <= 63-m <= 63
        mask |= 1 << (63-m)
        m = (m+1) & 63
        iterations += 1
        if m == ((endpoint_constant-sh) & 63):
            break
        assert iterations < 64
    return ((d & (M64 ''^ mask)) | (s & mask)), iterations

def repaired_rlwimi(s, d, sh, mb, me, width, mutant=False):
    tmp = s & M32
    ra = d & ((1 << width)-1)
    if sh:
        tmp = ((tmp << sh) | (tmp >> (32-sh))) & M32
    if (mb < me if mutant else mb > me):
