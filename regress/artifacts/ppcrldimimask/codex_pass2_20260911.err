-	while (sh-- != 0) {
+	while (n-- != 0) {
 		int b = (s >> 63) & 1;
 		s = (s << 1) | b;
 	}
 	m = mb; tmp = 0;
 	do {
 		tmp |= ((uint64_t)1 << (63-m));
-		m ++;
-	} while (m != 63 - sh);
+		m = (m + 1) & 63;
+	} while (m != ((64 - sh) & 63));
 	cpu->cd.ppc.gpr[ra] &= ~tmp;
 	cpu->cd.ppc.gpr[ra] |= (tmp & s);
