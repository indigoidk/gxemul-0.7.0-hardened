92: 	long color;
93: 
94: #ifndef FB_SCALEDOWN
95: 
96: 	/*  Which framebuffer pixel does addr correspond to?  */
97: 	pixel = addr * 8 / d->bit_depth;
98: 	y = pixel / d->xsize;
99: 	x = pixel % d->xsize;
100: 
101: 	/*  How many framebuffer pixels? (len doesn't include the last pixel)  */
102: 	npixels = len * 8 / d->bit_depth;
103: 	npixels += d->bit_depth >= 8 ? 1 : (8 / d->bit_depth);
104: 
105: 	if (d->bit_depth < 8) {
106: 		for (pixel=0; pixel<npixels; pixel++) {
107: 			int c, r, g, b;
108: 			size_t fb_addr = (y * d->xsize + x) * d->bit_depth;
109: 			/*  fb_addr is now which _bit_ in the framebuffer  */
110: 
111: 			c = d->framebuffer[fb_addr >> 3];
112: 			fb_addr &= 7;
113: 
114: 			/*  HPC is reverse:  */
115: 			if (d->vfb_type == VFB_HPC || d->vfb_type == VFB_REVERSEBITS)
116: 				fb_addr = 8 - d->bit_depth - fb_addr;
117: 
118: 			c = (c >> fb_addr) & ((1<<d->bit_depth) - 1);
119: 			/*  c <<= (8 - d->bit_depth);  */
120: 
121: 			r = d->rgb_palette[c*3 + 0];
122: 			g = d->rgb_palette[c*3 + 1];
123: 			b = d->rgb_palette[c*3 + 2];
124: 
125: 			macro_put_pixel;
126: 			x++;

