        else: k+=1
        while k<len(ts):
            if ts[k][0] in ('[','('):
                a=ts[k][0]; b=']' if a=='[' else ')'; dep=1; k+=1
                while k<len(ts) and dep:
                    dep+=(ts[k][0]==a)-(ts[k][0]==b); k+=1
            elif ts[k][0] in ('->','.'): k+=2
            elif ts[k][0] in ('++','--'): k+=1
            else: break
        return k
    def mul(k):
        k=unary(k)
        while k<len(ts) and ts[k][0] in ('*','/','%'): k=unary(k+1)
        return k
    k=mul(j)
    while k<len(ts) and ts[k][0] in ('+','-'): k=mul(k+1)
