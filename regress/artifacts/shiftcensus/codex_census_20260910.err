760: 
761: /*
762:  *  net_init():
763:  *
764:  *  This function creates a network, and returns a pointer to it.
765:  *
766:  *  ipv4addr should be something like "10.0.0.0", netipv4len = 8.
767:  *
768:  *  If n_remote is more than zero, remote should be a pointer to an array
769:  *  of strings of the following format: "host:portnr".
770:  *
771:  *  Network settings are registered if settings_prefix is non-NULL.
772:  *  (The one calling net_init() is also responsible for calling net_deinit().)
773:  *
774:  *  On failure, NULL is returned.
775:  */
776: struct net *net_init(struct emul *emul, int init_flags,
777: 	const char *tapdev,
778: 	const char *ipv4addr, int netipv4len,
779: 	char **remote, int n_remote, int local_port,
780: 	const char *settings_prefix)
781: {
782: 	struct net *net;
783: 	int res;
784: 
785: 	CHECK_ALLOCATION(net = (struct net *) malloc(sizeof(struct net)));
786: 	memset(net, 0, sizeof(struct net));
787: 
788: 	/*  Set the back pointer:  */
789: 	net->emul = emul;
790: 
791: 	/*  Sane defaults:  */
792: 	net->timestamp = 0;
793: 	net->first_ethernet_packet = net->last_ethernet_packet = NULL;
794: 	net->n_queued_packets = 0;	/*  #178: (Codex/Fable)  */
795: 	net->tapdev = NULL;
796: 	net->tap_fd = -1;
797: 
798: 	/*
799: 	 *  If we're using a tap device, attempt to initialize it and
800: 	 *  none of the other stuff.
801: 	 */
802: 	if (tapdev) {
803: 		if (!net_tap_init(net, tapdev)) {
804: 			free(net);
805: 			return NULL;
806: 		}
807: 
808: 		net_dumpinfo(net);
809: 		return net;
810: 	}
811: 
812: #ifdef HAVE_INET_PTON
813: 	res = inet_pton(AF_INET, ipv4addr, &net->netmask_ipv4);
814: #else
815: 	res = inet_aton(ipv4addr, &net->netmask_ipv4);
816: #endif
817: 	if (res < 1) {
818: 		debugmsg(SUBSYS_NET, "", VERBOSITY_ERROR,
819: 		    "could not parse IPv4 address '%s'", ipv4addr);
820: 		free(net);
821: 		return NULL;
822: 	}
823: 
824: 	if (netipv4len < 1 || netipv4len > 30) {
825: 		debugmsg(SUBSYS_NET, "", VERBOSITY_ERROR,
826: 		    "extremely weird ipv4 network length (%i)", netipv4len);
827: 		free(net);
828: 		return NULL;
829: 	}
830: 
831: 	net->netmask_ipv4_len = netipv4len;
832: 
833: 	net->nameserver_known = 0;
834: 	parse_resolvconf(net);

