1301: 
1302: /*
1303:  *  ubfx:  Unsigned Bit-Field Extract.
1304:  *
1305:  *  arg[0] = ptr to rd
1306:  *  arg[1] = ptr to rn
1307:  *  arg[2] = (width << 16) + lsb
1308:  */
1309: X(ubfx)
1310: {
1311: 	uint32_t x = reg(ic->arg[1]);
1312: 
1313: 	int lsb = (uint8_t)ic->arg[2];
1314: 	int width = ic->arg[2] >> 16;
1315: 
1316: 	/*  #510: was `(1 << width) - 1'.  `width' is `1 + ((iword >> 16) & 31)', so
1317: 	    it reaches 32 -- and `1' is a plain int, so the old expression was
1318: 	    undefined at THE TWO HIGHEST VALUES of that range: a shift count equal
1319: 	    to the type's width at 32 (C99 6.5.7p3), and a signed overflow at 31
1320: 	    (6.5.7p4).  (An earlier draft said "at BOTH ends", which is wrong for
1321: 	    {1..32} -- the low end, width 1, is perfectly well defined.)
1322: 
1323: 	    IN THE WITNESS RUNS, ONLY THE WIDTH-32 RESULT ROWS FAILED: `UBFX
1324: 	    r0,r1,#0,#32' of 0x89abcdef returned 0x0 on the committed build, while
1325: 	    `#0,#31' returned the correct 0x9abcdef.  (An earlier draft said "ONLY
1326: 	    THE 32 CASE IS OBSERVABLE", which claims more than the runs establish --
1327: 	    and at the time SBFX at width 31 was not tested AT ALL, so the claim
1328: 	    generalised a UBFX row to the other function.  `s w31' now covers it.)
1329: 	    Note also that a width-32 extract returns the whole register only for a
1330: 	    LEGAL field, i.e. lsb = 0; the decoder does not enforce that.
1331: 
1332: 	    *** WHAT THAT MEASUREMENT IS, STATED PRECISELY, BECAUSE A PASS-2 SEAT
1333: 	    CAUGHT AN EARLIER DRAFT OVERSTATING IT.  The rows observe the RESULT
1334: 	    REGISTER, never the mask.  "The mask became 0", and "1 << 31 gives
1335: 	    INT_MIN so INT_MIN - 1 gives INT_MAX", are THIS HOST'S LOWERING (shl
1336: 	    takes its count mod 32) -- undefined behaviour has no defined result to
1337: 	    measure.  They explain the observation; they are not the observation. ***
1338: 
1339: 	    The repair is owed by the LANGUAGE at both widths; only one was returning
1340: 	    a wrong value on this host.  `1U' defends 31 and the guard defends 32 --
1341: 	    but a guest-VALUE probe cannot establish that, because `1 << 31' and
1342: 	    `1U << 31' yield the SAME mask after the `- 1'.  No row can kill a
1343: 	    `1U' -> `1' regression; UBSAN or a source pin can.
1344: 
1345: 	    The SHAPE comes from `cpu_m88k_instr.c's X(clr)/X(set), but the analogy
1346: 	    needs care and an earlier draft ran the two together: there `w == 0'
1347: 	    ENCODES full width and the guard selects the full-width mask instead of
1348: 	    zero.  **It is not defending against a shift by 32 -- m88k's encoded
1349: 	    count never reaches 32.**  Here the guard IS doing that job.  Same
1350: 	    shape, different reason.  */
1351: 	uint32_t mask = (width == 32) ? 0xffffffffU : ((1U << width) - 1);
1352: 
1353: 	x >>= lsb;
1354: 	x &= mask;
1355: 
1356: 	reg(ic->arg[0]) = x;
1357: }
1358: Y(ubfx)
1359: 
1360: 
1361: /*
1362:  *  sbfx:  Signed Bit-Field Extract.
1363:  *
1364:  *  arg[0] = ptr to rd
1365:  *  arg[1] = ptr to rn
1366:  *  arg[2] = (width << 16) + lsb
1367:  */
1368: X(sbfx)
1369: {
1370: 	uint32_t x = reg(ic->arg[1]);
1371: 
1372: 	int lsb = (uint8_t)ic->arg[2];
1373: 	int width = ic->arg[2] >> 16;
1374: 
1375: 	/*  #510: was `(1 << width) - 1'.  `width' is `1 + ((iword >> 16) & 31)', so
1376: 	    it reaches 32 -- and `1' is a plain int, so the old expression was
1377: 	    undefined at THE TWO HIGHEST VALUES of that range: a shift count equal
1378: 	    to the type's width at 32 (C99 6.5.7p3), and a signed overflow at 31
1379: 	    (6.5.7p4).  (An earlier draft said "at BOTH ends", which is wrong for
1380: 	    {1..32} -- the low end, width 1, is perfectly well defined.)
1381: 
1382: 	    IN THE WITNESS RUNS, ONLY THE WIDTH-32 RESULT ROWS FAILED: the `s w32'
1383: 	    row returned 0x0 on the committed build.  (An earlier draft of this block
1384: 	    was a VERBATIM COPY of the ubfx one and quoted a UBFX measurement -- a
1385: 	    sentence about the other function.)
1386: 
1387: 	    *** AND WHEN THAT SENTENCE WAS FIRST WRITTEN, SBFX AT WIDTH 31 WAS NOT
1388: 	    TESTED AT ALL -- the claim generalised a UBFX row to this function, which
1389: 	    is the same copy-the-neighbour defect one paragraph up, committed while
1390: 	    correcting it.  `s w31' now pins it.  A pass-2 seat named both. ***
1391: 
1392: 	    *** WHAT THAT MEASUREMENT IS, STATED PRECISELY, BECAUSE A PASS-2 SEAT
1393: 	    CAUGHT AN EARLIER DRAFT OVERSTATING IT.  The rows observe the RESULT
1394: 	    REGISTER, never the mask.  "The mask became 0", and "1 << 31 gives
1395: 	    INT_MIN so INT_MIN - 1 gives INT_MAX", are THIS HOST'S LOWERING (shl
1396: 	    takes its count mod 32) -- undefined behaviour has no defined result to
1397: 	    measure.  They explain the observation; they are not the observation. ***
1398: 
1399: 	    The repair is owed by the LANGUAGE at both widths; only one was returning
1400: 	    a wrong value on this host.  `1U' defends 31 and the guard defends 32 --
1401: 	    but a guest-VALUE probe cannot establish that, because `1 << 31' and
1402: 	    `1U << 31' yield the SAME mask after the `- 1'.  No row can kill a
1403: 	    `1U' -> `1' regression; UBSAN or a source pin can.
1404: 
1405: 	    The SHAPE comes from `cpu_m88k_instr.c's X(clr)/X(set), but the analogy
1406: 	    needs care and an earlier draft ran the two together: there `w == 0'
1407: 	    ENCODES full width and the guard selects the full-width mask instead of
1408: 	    zero.  **It is not defending against a shift by 32 -- m88k's encoded
1409: 	    count never reaches 32.**  Here the guard IS doing that job.  Same
1410: 	    shape, different reason.  */
1411: 	uint32_t mask = (width == 32) ? 0xffffffffU : ((1U << width) - 1);
1412: 	x >>= lsb;
1413: 	x &= mask;
1414: 
1415: 	/*  #510: was `uint32_t topBitMask = 1 << (width-1);' followed by
1416: 	    `if (x & topBitMask && width < 32)'.  A SECOND undefined shift, and the
1417: 	    `width < 32' test that would have made it moot sat on the NEXT line.
1418: 
1419: 	    *** THAT IS NOT MERELY A REORDER, AND AN EARLIER DRAFT CALLED IT ONE. ***
1420: 	    The old form computed `1 << (width-1)' as a PRIOR STATEMENT, and a guard
1421: 	    never rescues an expression already evaluated.  The guest-visible `x' is
1422: 	    identical for every width in {1..32}; what changes is DEFINEDNESS at 32,
1423: 	    where the old form always evaluated `1 << 31'.  Under a non-trapping
1424: 	    lowering the stored value matches either way; under UBSAN the old form
1425: 	    traps and this one does not.  That IS the fix.
1426: 
1427: 	    And with `1U' the shift is already defined at 32 (`1U << 31'), so the
1428: 	    hoist is load-bearing for a SIGNED `1' and redundant for `1U'.  Doing
1429: 	    both is right; calling them equivalent defences is not.
1430: 
1431: 	    At width 32 the body is skipped, and would be a no-op anyway: with mask
1432: 	    0xffffffffU, `x |= ~mask' is `x |= 0'.  (An earlier draft said "there is
1433: 	    no sign to extend", which is the wrong reason -- a 32-bit field HAS a
1434: 	    sign bit.)  */
1435: 	if (width < 32 && (x & (1U << (width - 1))))
1436: 		x |= ~mask;
1437: 
1438: 	reg(ic->arg[0]) = x;
1439: }
1440: Y(sbfx)
