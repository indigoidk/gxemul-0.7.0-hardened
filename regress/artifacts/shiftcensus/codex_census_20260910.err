1119: /*
1120:  *  ieee_int64_to_double_odd():
1121:  *
1122:  *  #301: the L->S half. cvt.s.l cannot be fixed the way cvt.d.l was --
1123:  *  rounding the integer to double in the REQUESTED mode and then
1124:  *  rounding that double to single in the same mode double-rounds (the
1125:  *  panel's witness: 2^54 + 2^30 + 2 under nearest ties DOWN twice,
1126:  *  landing at 2^54 where direct rounding owes 2^54 + 2^31). Instead the
1127:  *  integer is rounded to double under ROUND-TO-ODD -- truncate to 53
1128:  *  bits and, if inexact, force the quotient's last bit odd -- and the
1129:  *  ordinary single-precision store then rounds correctly in ANY mode:
1130:  *  Boldo-Melquiond, 53 >= 2*24 + 2, the same theorem #299 rests on.
1131:  *  No carry is possible here: only an EVEN quotient is ever bumped, and
1132:  *  an even value one below the significand limit bumps to an odd one
1133:  *  still inside it.
1134:  */
1135: double ieee_int64_to_double_odd(int64_t v)
1136: {
1137: 	uint64_t mag, q;
1138: 	int negative = (v < 0), shift, n;
1139: 
1140: 	if (v == INT64_MIN)
1141: 		return -9223372036854775808.0;	/*  -2^63, exact  */
1142: 	mag = negative ? (uint64_t)(-v) : (uint64_t)v;
1143: 
1144: 	n = 0;
1145: 	while ((mag >> n) != 0)
1146: 		n++;
1147: 	if (n <= 53)
1148: 		return negative ? -(double)mag : (double)mag;
1149: 
1150: 	shift = n - 53;
1151: 	q = mag >> shift;
1152: 	if ((mag & (((uint64_t)1 << shift) - 1)) != 0)
1153: 		q |= 1;			/*  round to odd  */
1154: 
1155: 	return negative ? -ldexp((double)q, shift) : ldexp((double)q, shift);
1156: }
