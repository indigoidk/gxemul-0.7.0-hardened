1647: 	int writeflag, size_t len)
1648: {
1649: 	int partial;
1650: 
1651: 	if (len == sizeof(uint16_t))
1652: 		return 1;
1653: 
1654: 	/*  A PARTIAL access does not cover the register, so it is diagnosed and
1655: 	    NOT serviced -- servicing it would let a 1-byte store overwrite both
1656: 	    halves.  Written the other way round first, and the D3 detector row
1657: 	    caught it on the first run: a byte write of 0xa5 left the register
1658: 	    holding 0xa5 instead of its reset 0x3ffc.  That is exactly the mutant
1659: 	    a pass-1 seat had predicted and written D3 against.  */
1660: 	partial = len < sizeof(uint16_t);
1661: 
1662: 	/*  LATCHED, and per site.  fatal() is NOT debug(): debug() returns early
1663: 	    under quiet_mode, fatal() has no such early-out, so an unlatched
1664: 	    complaint here could not be silenced even with -q.  A real
1665: 	    OpenBSD/landisk boot makes ZERO non-16-bit BSC accesses (measured),
1666: 	    so the latch costs a correct guest nothing and bounds a hostile one.
1667: 
1668: 	    THE ORACLE FOR THIS IS NOT THE REGISTER NAME.  A detector row that
1669: 	    asked "does the string BCR3 appear?" was passed by a mutant sharing
1670: 	    one flag between the sites, because the demoted debug() prints the
1671: 	    same name -- and under the cold debugger single_step is true, so
1672: 	    debug()'s quiet_mode early-out never fires and a probe cannot tell
1673: 	    fatal() from debug() by presence at all.  Count the latched suffix.  */
1674: 	if (!d->bsc16_reported[site]) {
1675: 		d->bsc16_reported[site] = 1;
1676: 		fatal("[ sh4: %i-byte %s of SH4_%s; it is a 16-bit register."
1677: 		    "  %s.  (reported once per register) ]\n",
1678: 		    (int) len, writeflag == MEM_WRITE ? "write" : "read", name,
1679: 		    partial ? "Ignored" : "Servicing its own two bytes");
1680: 	} else {
1681: 		debug("[ sh4: %i-byte %s of SH4_%s ]\n", (int) len,
1682: 		    writeflag == MEM_WRITE ? "write" : "read", name);
1683: 	}
1684: 
1685: 	return !partial;
1686: }
