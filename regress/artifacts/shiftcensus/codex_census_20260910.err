diff --git a/src/cpus/cpu_alpha_palcode.c b/src/cpus/cpu_alpha_palcode.c
index 97aa499..4fbe280 100644
--- a/src/cpus/cpu_alpha_palcode.c
+++ b/src/cpus/cpu_alpha_palcode.c
@@ -327,7 +327,9 @@ Make sure they are correct, as documented in the Manual.
 	case 0x33:	/*  PAL_OSF1_tbi  */
 		/*
 		 *  a0 = op, a1 = vaddr
-		 *  a0 is ignored for now. TODO.
+		 *  (#520: a0 was ignored -- "a0 is ignored for now. TODO." --
+		 *  until the selector test below was corrected.  It is read now,
+		 *  so that line is removed rather than left to mislead.)
 		 *	a0 = 1: ITB invalidate
 		 *	a0 = 2: DTB invalidate
 		 *	a0 = 3: both ITB and DTB
@@ -336,7 +338,69 @@ Make sure they are correct, as documented in the Manual.
 		 */
 		// debug("[ Alpha PALcode: PAL_OSF1_tbi: a0=%" PRIi64" a1=0x%"
 		//    PRIx64" ]\n", (int64_t)a0, (uint64_t)a1);
-		if (a0 >= 1)
+		/*  #520 (alphatbinegsel): `a0' is a uint64_t, so the old `a0 >= 1'
+		    was an UNSIGNED compare and BOTH negative selectors named in the
+		    header above -- -1 and -2, the two documented as invalidate-
+		    EVERYTHING -- compared GREATER than 1 and took the single-VADDR
+		    branch.  A guest TBIA/TBIAP therefore flushed ONE page and left
+		    every other cached translation live.  MEASURED at rung 3 BEFORE
+		    this edit.  The citation names the FROZEN 7-row witness, NOT the
+		    live probe, because the live probe has since grown to 13 rows and
+		    a citation into a file that changes under you decays silently:
+		        artifacts/alphatbinegsel/witness_agy_20260908/
+		            alphatbi_probe.asrun.py  -- the 7-row instrument
+		            alphatbi_committed.out   -- 5/7, both negatives RED
+		            alphatbi_fixed.out       -- 7/7
+		        artifacts/alphatbinegsel/fix_20260910/{HEAD,FIX520}_run1.out
+		            -- the same pair replicated on a second build
+		    The SHIPPED 13-row detector scores 10/13 and 13/13 on those two
+		    builds (killtable_20260910/t2/probe_{HEAD,BASE}.raw).  An earlier
+		    draft cited the LIVE path for the 5/7 pair, and the pass-2 review
+		    caught that the named artifact had come to CONTRADICT the number
+		    beside it -- the reused-log-name decay, inside product code.
+
+		    1, 2 and 3 are the only selective ops the architecture defines,
+		    so 0 and 4.. are undefined and fall to the conservative arm with
+		    the negatives.  Over-invalidation cannot serve a stale
+		    translation; under-invalidation can, which is this defect.
+
+		    *** THE LOAD-BEARING PROPERTY IS THE TWO-SIDEDNESS, NOT THE
+		    SIGNEDNESS, and the pass-2 panel corrected me on that. ***  The
+		    casts are MEASURED REDUNDANT: `a0 >= 1 && a0 <= 3' unsigned
+		    agrees with the signed form on every input, because a negative
+		    selector is a huge unsigned value that fails the UPPER bound
+		    exactly where the signed reading fails the LOWER one.  Checked
+		    over every boundary class and 300,000 random 64-bit values,
+		    zero disagreements (the kimi substitute raised it; enumerated
+		    rather than argued).  The casts are KEPT because they state the
+		    selector's signedness to a reader, not because they repair
+		    anything -- so do not describe them as the fix.
+
+		    WHAT THE COMPARISON'S WIDTH DOES buy is real and is ROWED:
+		    narrowing either cast to 32 bits passes every selector the
+		    detector drives, and diverges first at a0 = 0x100000001, where
+		    the 64-bit reading invalidates everything and a 32-bit one
+		    truncates to 1 and flushes a single page (deepseek, pass 2).
+
+		    -1 and -2 differ on hardware only in whether GLOBAL entries
+		    survive: -1 invalidates the ASM=0 entries and SPARES the ASM=1
+		    ones, -2 invalidates both.  This model's translation cache
+		    carries no ASM/ASN metadata to spare anything BY, so both map
+		    to INVALIDATE_ALL -- EXACT for -2 and CONSERVATIVE for -1,
+		    which is the safe direction and is not the same claim.
+
+		    NO ANNOUNCE, deliberately, and the warrant is IN THIS FILE: the
+		    #514 block handles an architecturally UNPREDICTABLE value the
+		    same way -- do nothing, document it in place, say nothing at run
+		    time.  Same file, same architecture, same shape.  The addition
+		    licence carries the rest: an announce here has no measured
+		    delta.  (An earlier draft appealed to "the house latched-
+		    announce idiom".  That idiom is a DEVICES one -- `(once)'
+		    appears 40 times under src/devices and NOT ONCE under src/cpus,
+		    which has four bare `static int warned' latches and no marker
+		    convention.  The conclusion is unchanged; the appeal was to the
+		    wrong layer.)  */
+		if ((int64_t)a0 >= 1 && (int64_t)a0 <= 3)
 			cpu->invalidate_translation_caches(cpu, a1, INVALIDATE_VADDR);
 		else
 			cpu->invalidate_translation_caches(cpu, 0, INVALIDATE_ALL);
diff --git a/src/devices/dev_lca.c b/src/devices/dev_lca.c
index de9aa64..117787a 100644
--- a/src/devices/dev_lca.c
+++ b/src/devices/dev_lca.c
@@ -52,6 +52,12 @@
     `interrupt->extra' -- see the comment on lca_interrupt_assert().  */
 #define	LCA_W_IRQ_ASSERT	0	/*  #516  */
 #define	LCA_W_IRQ_DEASSERT	1	/*  #516  */
+#define	LCA_W_IOC_CONF_CFG1	2	/*  #518: IOC_CONF<1> set -- CFG AD<1:0> = 10/11, not a cycle type  */
+#define	LCA_W_IOC_WMASK0	3	/*  #518: unsupported W_MASK0 encoding declined  */
+#define	LCA_W_IOC_WMASK1	4	/*  #518: unsupported W_MASK1 encoding declined  */
+#define	LCA_W_IOC_WEN		5	/*  #518: a DMA window enabled -- translation not modelled  */
+#define	LCA_W_IOC_DEF_W	6	/*  #518: default-arm write declined  */
+#define	LCA_W_IOC_DEF_R	7	/*  #518: default-arm read answered with zero  */
 
 struct lca_data {
 	struct pci_data		*pci_data;
@@ -296,6 +302,27 @@ DEVICE_ACCESS(lca_isa)
 }
 
 
+/*
+ *  #518 (lcabadval): one bounded announce per (device instance, reason).  Six
+ *  IOC write arms used to end the host with fatal()+exit(1) on any value outside
+ *  a tiny accepted set -- and the sets were WRONG, not merely harsh: the 21066
+ *  HRM (Table 6-6) lists THIRTEEN legal W_MASK encodings where the model took
+ *  one, and S6.4.14 REQUIRES SROM to write ZERO to W_BASE1, which was fatal.
+ *  The arms below store the ARCHITECTED FIELDS, ignore reserved bits (type X),
+ *  validate W_MASK by its field rule, and decline what the model cannot honour
+ *  with this announce -- fatal() prints and returns (it cannot be silenced by
+ *  -q, which is why a latch and not a verbosity flag).
+ */
+static void lca_ioc_announce(struct lca_data *d, int bit, const char *what,
+	uint64_t v)
+{
+	if (d->warned & (1u << bit))
+		return;
+	d->warned |= 1u << bit;
+	fatal("[ lca_ioc: %s: 0x%" PRIx64 "  (once) ]\n", what, v);
+}
+
+
 DEVICE_ACCESS(lca_ioc)
 {
 	uint64_t idata = 0, odata = 0;
@@ -314,23 +341,20 @@ DEVICE_ACCESS(lca_ioc)
 		if (writeflag == MEM_READ) {
 			odata = d->ioc_conf;
 		} else {
-			d->ioc_conf = idata;
-			/*  Only bit 0 is implemented so far, the PCI bus 0 vs
-			    bus non-0 selection bit.  */
-			if (idata & ~1) {
-				/*  #506: was `0x%x', (int)idata -- a 64-bit guarded value
-				    narrowed to 32 in the KILL diagnostic, so a write of
-				    0x100000000 trips `idata & ~1' and then reports "0x0",
-				    which is a value this same guard ACCEPTS.  The five
-				    sibling arms below already print the full width this
-				    way; this arm was the outlier among the VALUE-guard
-				    diagnostics.  (Not the file's only narrowing site --
-				    the default arm below has the same cast, and this
-				    round fixes it too.)  */
-				fatal("TODO: Write to unimplemented bit of"
-				    " IOC_CONF: 0x%" PRIx64 "\n", (uint64_t)idata);
-				exit(1);
-			}
+			/*  #518: was `if (idata & ~1) { fatal(); exit(1); }' with the
+			    store BEFORE the check (#506 had widened its diagnostic).
+			    HRM S6.2.9: IOC_CONF<1:0> select the configuration cycle
+			    TYPE; everything above is reserved and is IGNORED, not
+			    fatal.  Bit 0 selects type-1 cycles and is what lca_pci_conf
+			    reads (#515); bit 1 selects the CFG AD<1:0> encodings 10/11,
+			    which are not configuration-cycle types -- stored and
+			    announced once, not modelled.  (Pass 2: this comment first
+			    called bit 1 the type-1 select; grok read lca_pci_conf.)  */
+			d->ioc_conf = idata & 0x3ULL;
+			if (idata & 0x2ULL)
+				lca_ioc_announce(d, LCA_W_IOC_CONF_CFG1, "IOC_CONF<1> set"
+				    " (CFG AD<1:0> = 10/11, not a configuration-cycle type):"
+				    " stored, not modelled", idata);
 		}
 		break;
 
@@ -343,14 +367,10 @@ DEVICE_ACCESS(lca_ioc)
 		if (writeflag == MEM_READ) {
 			odata = d->tlb_enable;
