1372:  *    underflow   everything shifts out; only the directed modes can still
1373:  *                deliver the smallest subnormal, on the side they round toward.
1374:  *
1375:  *  Rounding is decided once, from (guard, sticky, lsb, sign), and applied by
1376:  *  incrementing the significand.  The increment is allowed to carry out of the
1377:  *  fraction and into the exponent -- that is how a subnormal at the top of the
1378:  *  band becomes the smallest NORMAL, and how the largest finite single becomes
1379:  *  Infinity, with no special case for either.
1380:  */
1381: static uint32_t ppc_single_narrow(uint64_t d, int rm)
1382: {
1383: 	int sign = (int) (d >> 63) & 1;
1384: 	int exp = (int) ((d >> 52) & 0x7ff);
1385: 	uint64_t frac = d & 0xfffffffffffffULL;
1386: 	uint64_t sig;			/*  significand, 24 bits wide when normal  */
1387: 	int e;				/*  the single's biased exponent  */
1388: 	int shift, round_up = 0;
1389: 	uint64_t guard_sticky = 0;
1390: 
1391: 	if (exp == 0 && frac == 0)
1392: 		return (uint32_t) sign << 31;		/*  +/-0 passes through  */
1393: 
1394: 	/*  Unbias to the single's frame.  A D subnormal (exp 0) is far below the
1395: 	    single format's reach, so it lands in the underflow arm below.  */
1396: 	sig = (exp == 0) ? frac : (frac | (1ULL << 52));
1397: 	e = ((exp == 0) ? 1 : exp) - 1023 + 127;
1398: 
1399: 	/*  The significand is 53 bits; single wants 24.  Discard 29 -- more when
1400: 	    the value is subnormal in the single format (e <= 0), which is the
1401: 	    denormalization the ISA spells out step by step.  */
1402: 	shift = 29;
1403: 	if (e <= 0) {
1404: 		shift += 1 - e;
1405: 		e = 0;
1406: 		if (shift > 63) {
1407: 			/*  Everything shifts out.  Only a directed mode toward
1408: 			    this value's own sign can still deliver the smallest
1409: 			    subnormal; nearest and toward-zero give signed 0.  */
1410: 			if ((rm == IEEE_RM_RP && !sign) ||
1411: 			    (rm == IEEE_RM_RM && sign))
1412: 				return ((uint32_t) sign << 31) | 1;
1413: 			return (uint32_t) sign << 31;
1414: 		}
1415: 	}
1416: 
1417: 	guard_sticky = sig & ((1ULL << shift) - 1);
1418: 	sig >>= shift;
1419: 
1420: 	switch (rm) {
1421: 	case IEEE_RM_RN:
1422: 		{
1423: 			uint64_t half = 1ULL << (shift - 1);
