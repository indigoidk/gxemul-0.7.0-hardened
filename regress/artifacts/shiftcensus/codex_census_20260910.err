3405: static int ppc_stfs_extract(uint64_t d, uint32_t *out)
3406: {
3407: 	int exp = (int) ((d >> 52) & 0x7ff);
3408: 	uint64_t frac = d & 0xfffffffffffffULL;
3409: 	uint32_t sign = (uint32_t) (d >> 63) & 1;
3410: 
3411: 	if (exp == 0x7ff && frac != 0) {		/*  #305: NaN  */
