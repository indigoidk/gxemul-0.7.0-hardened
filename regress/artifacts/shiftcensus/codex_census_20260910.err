508: static void m88k_rot(struct cpu *cpu, struct m88k_instr_call *ic, int n)
509: {
510: 	uint32_t x = reg(ic->arg[1]);
511: 
512: 	if (n != 0) {
513: 		uint32_t mask = (1 << n) - 1;
514: 		uint32_t bits = x & mask;
515: 		x >>= n;
516: 		x |= (bits << (32-n));
517: 	}
518: 
519: 	reg(ic->arg[0]) = x;
520: }
