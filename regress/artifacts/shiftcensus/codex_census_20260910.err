112: 
113: 
114: DEVICE_TICK(dc7085)
115: {
116: 	/*
117: 	 *  If a key is available from the keyboard, add it to the rx queue.
118: 	 *  If other bits are set, an interrupt might need to be caused.
119: 	 */
120: 	struct dc_data *d = (struct dc_data *) extra;
121: 	int avail;
122: 
123: 	d->regs.dc_csr &= ~CSR_RDONE;
124: 
125: 	if ((d->regs.dc_csr & CSR_MSE) && !(d->regs.dc_csr & CSR_TRDY)) {
126: 		int scanner_start = d->tx_scanner;
127: 
128: 		/*  Loop until we've checked all 4 channels, or some
129: 			channel was ready to transmit:  */
130: 
131: 		do {
132: 			d->tx_scanner = (d->tx_scanner + 1) % 4;
133: 
134: 			if (d->regs.dc_tcr & (1 << d->tx_scanner)) {
135: 				d->regs.dc_csr |= CSR_TRDY;
136: 				if (d->regs.dc_csr & CSR_TIE)
137: 					INTERRUPT_ASSERT(d->irq);
138: 
139: 				d->regs.dc_csr &= ~CSR_TX_LINE_NUM;
140: 				d->regs.dc_csr |= (d->tx_scanner << 8);
141: 			}
142: 		} while (!(d->regs.dc_csr & CSR_TRDY) &&
143: 		    d->tx_scanner != scanner_start);

src/devices/dev_fb.c
811:  *  device. :-)
812:  *
813:  *  visible_xsize and visible_ysize are the sizes of the visible display area.
814:  *  xsize and ysize tell how much memory is actually allocated (for example
815:  *  visible_xsize could be 640, but xsize could be 1024, for better alignment).
816:  *
817:  *  vfb_type is useful for selecting special features.
818:  *
819:  *  type = VFB_GENERIC is the most useful type, especially when bit_depth = 24.
820:  *
821:  *  VFB_DEC_VFB01, _VFB02, and VFB_DEC_MAXINE are DECstation specific.
822:  *
823:  *  VFB_HPC is like generic, but the color encoding is done as on HPCmips
824:  *  and Dreamcast.
825:  *
826:  *  VFB_REVERSEBITS is like generic, but with bit order reversed.
827:  *
828:  *  If bit_depth = -15 (note the minus sign), then a special hack is used for
829:  *  the Playstation Portable's 5-bit R, 5-bit G, 5-bit B.
830:  */
831: struct vfb_data *dev_fb_init(struct machine *machine, struct memory *mem,
832: 	uint64_t baseaddr, int vfb_type, int visible_xsize, int visible_ysize,
833: 	int xsize, int ysize, int bit_depth, const char *name)
834: {
835: 	struct vfb_data *d;
836: 	size_t size, nlen;
837: 	int flags;
838: 	int reverse_start = 0;
839: 	char *name2;
840: 
841: 	CHECK_ALLOCATION(d = (struct vfb_data *) malloc(sizeof(struct vfb_data)));
842: 	memset(d, 0, sizeof(struct vfb_data));
843: 
844: 	if (vfb_type & VFB_REVERSE_START) {
845: 		vfb_type &= ~VFB_REVERSE_START;
846: 		reverse_start = 1;
847: 	}
848: 
849: 	d->memory = mem;
850: 	/*  #157: (Codex/Fable) keep a machine handle so dev_fb_resize()
851: 	    can invalidate all CPUs' translation caches  */
852: 	d->machine = machine;
853: 	d->vfb_type = vfb_type;
854: 
855: 	/*  Defaults:  */
856: 	d->xsize = xsize;  d->visible_xsize = visible_xsize;
857: 	d->ysize = ysize;  d->visible_ysize = visible_ysize;
858: 
859: 	d->bit_depth = bit_depth;
860: 
861: 	if (bit_depth == 15) {
862: 		d->color32k = 1;
863: 		bit_depth = d->bit_depth = 16;
864: 	} else if (bit_depth == -15) {
865: 		d->psp_15bit = 1;
866: 		bit_depth = d->bit_depth = 16;
867: 	}
868: 
869: 	/*  Specific types:  */
870: 	switch (vfb_type) {
871: 	case VFB_DEC_VFB01:
872: 		/*  DECstation VFB01 (monochrome)  */
873: 		d->xsize = 2048;  d->visible_xsize = 1024;
874: 		d->ysize = 1024;  d->visible_ysize = 864;
875: 		d->bit_depth = 1;
876: 		break;
877: 	case VFB_DEC_VFB02:
878: 		/*  DECstation VFB02 (color)  */
879: 		d->xsize = 1024;  d->visible_xsize = 1024;
880: 		d->ysize = 1024;  d->visible_ysize = 864;
881: 		d->bit_depth = 8;
882: 		break;
883: 	case VFB_DEC_MAXINE:
884: 		/*  DECstation Maxine (1024x768x8)  */
885: 		d->xsize = 1024; d->visible_xsize = d->xsize;
886: 		d->ysize = 768;  d->visible_ysize = d->ysize;
887: 		d->bit_depth = 8;
888: 		break;
889: 	case VFB_PLAYSTATION2:
890: 		/*  Playstation 2  */
891: 		d->xsize = xsize;  d->visible_xsize = d->xsize;
892: 		d->ysize = ysize;  d->visible_ysize = d->ysize;
893: 		d->bit_depth = 24;
894: 		break;
895: 	}
896: 
897: 	if (d->bit_depth == 2 || d->bit_depth == 4)
898: 		set_grayscale_palette(d, 1 << d->bit_depth);
899: 	else if (d->bit_depth == 8 || d->bit_depth == 1)
900: 		set_blackwhite_palette(d, 1 << d->bit_depth);
901: 
902: 	d->vfb_scaledown = machine->x11_md.scaledown;
903: 
904: 	d->bytes_per_line = d->xsize * d->bit_depth / 8;
905: 	size = d->ysize * d->bytes_per_line;

