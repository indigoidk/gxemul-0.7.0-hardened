68: 
69: void irqc_interrupt_deassert(struct interrupt *interrupt)
70: {
71: 	struct irqc_data *d = (struct irqc_data *) interrupt->extra;
72: 	d->status &= ~interrupt->line;
73: 
74: 	if (!(d->status & d->enabled) && d->asserted) {
75: 		INTERRUPT_DEASSERT(d->irq);
76: 		d->asserted = 0;
77: 	}
78: }
79: 
80: 
81: DEVICE_ACCESS(irqc)
82: {
83: 	struct irqc_data *d = (struct irqc_data *) extra;
84: 	uint64_t idata = 0, odata = 0;
85: 
86: 	if (writeflag == MEM_WRITE)
87: 		idata = memory_readmax64(cpu, data, len);
88: 
89: 	switch (relative_addr) {
90: 
91: 	case DEV_IRQC_IRQ:
92: 		/*  Status register:  */
93: 		if (writeflag == MEM_READ) {
94: 			odata = d->status;
95: 		} else {
96: 			fatal("[ irqc: WARNING! write to DEV_IRQC_IRQ ]\n");
97: 		}
98: 		break;
99: 
100: 	case DEV_IRQC_MASK:
101: 		/*  Mask interrupts by clearing Enable bits:  */
102: 		if (writeflag == MEM_READ) {
103: 			fatal("[ irqc: WARNING! read from DEV_IRQC_MASK ]\n");
104: 		} else {
105: 			int old_assert = d->status & d->enabled;
106: 			int new_assert;
107: 
108: 			d->enabled &= ~(1 << idata);
109: 
110: 			new_assert = d->status & d->enabled;
111: 
112: 			if (!old_assert && new_assert)
113: 				INTERRUPT_ASSERT(d->irq);
114: 			else if (old_assert && !new_assert)
115: 				INTERRUPT_DEASSERT(d->irq);
116: 		}
117: 		break;
118: 
119: 	case DEV_IRQC_UNMASK:
120: 		/*  Unmask interrupts by setting Enable bits:  */
121: 		if (writeflag == MEM_READ) {
122: 			fatal("[ irqc: WARNING! read from DEV_IRQC_UNMASK ]\n");
123: 		} else {
124: 			int old_assert = d->status & d->enabled;
125: 			int new_assert;
126: 
127: 			d->enabled |= (1 << idata);
128: 
129: 			new_assert = d->status & d->enabled;
130: 
131: 			if (!old_assert && new_assert)
132: 				INTERRUPT_ASSERT(d->irq);
133: 			else if (old_assert && !new_assert)
134: 				INTERRUPT_DEASSERT(d->irq);
135: 		}
136: 		break;
137: 

src/devices/dev_i80321.c
196: 		/*  TODO: Temporary hack to allow NetBSD/evbarm to
197: 		    reboot itself.  Should be rewritten as soon as possible!  */
198: 		if (writeflag == MEM_WRITE && idata == 0x30) {
199: 			int j;
200: 			for (j=0; j<cpu->machine->ncpus; j++)
201: 				cpu->machine->cpus[j]->running = false;
202: 		}
203: 		break;
204: 	case VERDE_ATU_BASE + ATU_ATUIMR:
205: 	case VERDE_ATU_BASE + ATU_IABAR3:
206: 	case VERDE_ATU_BASE + ATU_IAUBAR3:
207: 	case VERDE_ATU_BASE + ATU_IALR3:
208: 	case VERDE_ATU_BASE + ATU_IATVR3:
209: 		/*  Ignoring these for now. TODO  */
210: 		break;
211: 	case VERDE_ATU_BASE + ATU_OCCAR:
212: 		/*  PCI address  */
213: 		if (writeflag == MEM_WRITE) {
214: 			d->pci_addr = idata;
215: 			bus_pci_decompose_1(idata, &bus, &dev, &func, &reg);
216: 			bus = 0;	/*  NOTE  */
217: 			bus_pci_setaddr(cpu, d->pci_bus, bus, dev, func, reg);
218: 		} else {
219: 			odata = d->pci_addr;
220: 		}
221: 		break;
222: 	case VERDE_ATU_BASE + ATU_OCCDR:
223: 	case VERDE_ATU_BASE + ATU_OCCDR + 1:
224: 	case VERDE_ATU_BASE + ATU_OCCDR + 2:
225: 	case VERDE_ATU_BASE + ATU_OCCDR + 3:
226: 		/*  PCI data  */
227: 		if (writeflag == MEM_READ) {
228: 			uint64_t tmp;
229: 			bus_pci_data_access(cpu, d->pci_bus, &tmp,
230: 			    sizeof(uint32_t), MEM_READ);
231: 			switch (relative_addr) {
232: 			case VERDE_ATU_BASE + ATU_OCCDR + 1:
233: 				odata = tmp >> 8; break;
234: 			case VERDE_ATU_BASE + ATU_OCCDR + 2:
235: 				odata = tmp >> 16; break;
236: 			case VERDE_ATU_BASE + ATU_OCCDR + 3:
237: 				odata = tmp >> 24; break;
238: 			default:odata = tmp;
239: 			}
240: 		} else {
241: 			uint64_t tmp;
242: 			unsigned int i;
243: 			int r = relative_addr - (VERDE_ATU_BASE + ATU_OCCDR);
244: 			bus_pci_data_access(cpu, d->pci_bus, &tmp,
245: 			    sizeof(uint32_t), MEM_READ);
246: 			for (i=0; i<len; i++) {
247: 				uint8_t b = idata >> (i*8);
248: 				tmp &= ~(0xff << ((r+i)*8));
249: 				tmp |= b << ((r+i)*8);
250: 			}
251: 			tmp &= 0xffffffff;  /* needed because << is 32-bit */
252: 			bus_pci_data_access(cpu, d->pci_bus, &tmp,
253: 			    sizeof(uint32_t), MEM_WRITE);
254: 		}
255: 		break;
256: 	case VERDE_ATU_BASE + ATU_PCIXSR:
257: 		odata = 0;		/*  TODO  */
258: 		break;
259: 
260: 	/*  Memory Controller Unit:  */
261: 	case VERDE_MCU_BASE + MCU_SDIR:
262: 		n = "MCU_SDIR (DDR SDRAM Init Register)";
263: 		break;
264: 	case VERDE_MCU_BASE + MCU_SDCR:
265: 		n = "MCU_SDCR (DDR SDRAM Control Register)";
266: 		break;

