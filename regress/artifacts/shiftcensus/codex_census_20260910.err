L1N-DYNTRANS_L2N)) & mask2;"}, {"p": "src/cpus/cpu_ppc_instr.c", "l": 4031, "op": ">>", "rhs": "(64-DYNTRANS_L1N-DYNTRANS_L2N- DYNTRANS_L3N)", "anchor": "uint32_t x3 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N-"}, {"p": "src/cpus/cpu_ppc_instr.c", "l": 4472, "op": ">>", "rhs": "mb", "anchor": "mask |= ((uint32_t)0x80000000 >> mb);"}, {"p": "src/cpus/cpu_ppc_instr.c", "l": 5315, "op": "<<", "rhs": "(17+bi)", "anchor": "if (iword & (1 << (17+bi)))"}, {"p": "src/cpus/cpu_ppc_instr_loadstore.c", "l": 60, "op": "<<", "rhs": "PPC_INSTR_ALIGNMENT_SHIFT", "anchor": "cpu->pc &= ~((PPC_IC_ENTRIES_PER_PAGE-1) << PPC_INSTR_ALIGNMENT_SHIFT);"}, {"p": "src/cpus/cpu_ppc_instr_loadstore.c", "l": 61, "op": "<<", "rhs": "PPC_INSTR_ALIGNMENT_SHIFT", "anchor": "cpu->pc += (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);"}, {"p": "src/cpus/generate_arm_multi.c", "l": 75, "op": "<<", "rhs": "i", "anchor": "if (opcode & (1 << i))"}, {"p": "src/cpus/generate_arm_multi.c", "l": 145, "op": "<<", "rhs": "i", "anchor": "if (!(opcode & (1 << i)))"}, {"p": "src/cpus/generate_arm_multi.c", "l": 170, "op": "<<", "rhs": "i", "anchor": "if (!(opcode & (1 << i)))"}, {"p": "src/cpus/generate_arm_r.c", "l": 79, "op": ">>", "rhs": "(c-1)", "anchor": "(int)(0x80000000 >> (c-1)));"}, {"p": "src/cpus/generate_arm_r.c", "l": 139, "op": "<<", "rhs": "(c-1)", "anchor": "(int)(1U << (c-1)));"}, {"p": "src/cpus/generate_arm_r.c", "l": 200, "op": "<<", "rhs": "(c-1)", "anchor": "(int)(1U << (c-1)));"}, {"p": "src/cpus/generate_arm_r.c", "l": 279, "op": "<<", "rhs": "(c-1)", "anchor": "(int)(1U << (c-1)));"}, {"p": "src/cpus/generate_ppc_loadstore.c", "l": 57, "op": "<<", "rhs": "size", "anchor": "printf(\"#define LS_SIZE %i\\n\", 1 << size);"}, {"p": "src/cpus/generate_ppc_loadstore.c", "l": 140, "op": "<<", "rhs": "size", "anchor": "printf(\"#define LS_SIZE %i\\n\", 1 << size);"}, {"p": "src/cpus/memory_arm.c", "l": 153, "op": ">>", "rhs": "(domain * 2)", "anchor": "dav = (cpu->cd.arm.dacr >> (domain * 2)) & 3;"}, {"p": "src/cpus/memory_ppc.c", "l": 185, "op": "<<", "rhs": "PTE_VSID_SHFT", "anchor": "PTE_VALID | api | (vsid << PTE_VSID_SHFT);"}]

codex
Two checks already change the provisional picture. `X(dext)` serves three encodings: ordinary DEXT has a safe count range; DEXTM and DEXTU need separate checks. `X(ins)` is another useful control: its paired shift count simplifies to `31 - msb`, even when the decoded field width is invalid.

The inventory also contains thousands of repeated operators in tracked generated files. I’ll report those totals separately from their source families so generated copies do not inflate the findings.

exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'

import subprocess,re,json,collections
paths=subprocess.check_output(['git','ls-tree','-r','--name-only','HEAD'],text=True).splitlines()
paths=[p for p in paths if re.search(r'\\.(c|h|cc|cpp|cxx|hpp|inc)"'$'"',p)]
raw=subprocess.check_output(['git','cat-file','--batch'],input=''.join('HEAD:'+p+'\\n' for p in paths).encode())
files={}
pos=0
for p in paths:
    e=raw.index(b'\\n',pos); size=int(raw[pos:e].split()[-1]); pos=e+1
    files[p]=raw[pos:pos+size].decode('utf-8','replace'); pos+=size+1
blank=re.compile(r'//["'^'"\\n]*|/\\*[\\s\\S]*?\\*/|\"(?:\\\\[\\s\\S]|["'^"'"\\\\])*\"|\\'(?:\\\\[\\s\\S]|["'^'"\\'\\\\])*\\'')
tok=re.compile(r'0[xX][0-9a-fA-F]+[uUlL]*|\\d+(?:\\.\\d*)?[uUlLfF]*|[A-Za-z_]\\w*|<<=|>>=|<<|>>|->|\\+\\+|--|&&|\\|\\||==|"'!=|<=|>=|[''^'"\\s]')
def right(ts,j):
    def unary(k):
        if k>=len(ts): return k
        t=ts[k][0]
        if t in ('+','-','~','"'!'"','*','&','++','--','sizeof'): return unary(k+1)
        if t=='(':
            start=k; dep=1; k+=1
            while k<len(ts) and dep:
                dep+= (ts[k][0]=='(')-(ts[k][0]==')'); k+=1
            inner=' '.join(x[0] for x in ts[start+1:k-1])
            if re.fullmatch(r'(?:(?:u?int\\d+_t|u?intptr_t|size_t|ssize_t|unsigned|signed|long|short|int|char|const|float|double|register|void|\\*)\\s*)+',inner): return unary(k)
        else: k+=1
        while k<len(ts):
            if ts[k][0] in ('[','('):
                a=ts[k][0]; b=']' if a=='[' else ')'; dep=1; k+=1
                while k<len(ts) and dep:
                    dep+=(ts[k][0]==a)-(ts[k][0]==b); k+=1
            elif ts[k][0] in ('->','.'): k+=2
            elif ts[k][0] in ('++','--'): k+=1
            else: break
        return k
    def mul(k):
        k=unary(k)
        while k<len(ts) and ts[k][0] in ('*','/','%'): k=unary(k+1)
        return k
    k=mul(j)
    while k<len(ts) and ts[k][0] in ('+','-'): k=mul(k+1)
    return k
rows=[]; totals=collections.Counter()
for p,s in files.items():
    clean=blank.sub(lambda m:re.sub(r'["'^'"\\n]',' ',m[0]),re.sub(r'\\\\\\r?\\n',lambda m:' '*len(m[0]),s))
    ts=[(m[0],m.start(),m.end()) for m in tok.finditer(clean)]
    for i,(op,st,en) in enumerate(ts):
        if op not in ('<<','>>','<<=','>>='):continue
        totals[p.split('/')[0]]+=1
        j=right(ts,i+1)
        rhs=clean[ts[i+1][1]:ts[j-1][2]]
        rhs=re.sub(r'\\s+',' ',rhs).strip()
        x=rhs
        while x.startswith('(') and x.endswith(')'):x=x[1:-1].strip()
        if re.fullmatch(r'(?:0[xX][0-9a-fA-F]+|\\d+)[uUlL]*',x):continue
        line=s.count('\\n',0,st)+1
        textline=s.splitlines()[line-1].strip()
        rows.append({'p':p,'l':line,'op':op,'rhs':rhs,'anchor':textline})

print(json.dumps([r for r in rows if r['p'].startswith('src/cpus/') and not any(x in r['p'] for x in ('arm','ppc','mips','/tmp_'))]))
