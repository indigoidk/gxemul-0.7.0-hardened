517: /*
518:  *  console_mouse_coordinate_update():
519:  *
520:  *  Updates mouse coordinates. Called by for example an X11 event handler.
521:  *  dx and dy are relative coordinates, fb_nr is where the mouse movement
522:  *  took place.
523:  */
524: void console_mouse_coordinate_update(int dx, int dy, int fb_nr)
525: {
526: 	gettimeofday(&console_mouse_lastupdate, NULL);
527: 	console_mouse_dx += dx;
528: 	console_mouse_dy += dy;
529: 	console_mouse_fb_nr = fb_nr;
530: }
531: 
532: 
533: /*
534:  *  console_mouse_button():
535:  *
536:  *  Sets a mouse button to be pressed or released. Called by for example an
537:  *  X11 event handler.  button is 1 (left), 2 (middle), or 3 (right), and
538:  *  pressed = 1 for pressed, 0 for not pressed.
539:  */
540: void console_mouse_button(int button, int pressed)
541: {
542: 	int mask = 1 << (3-button);
543: 
544: 	if (pressed)
545: 		console_mouse_buttons |= mask;
546: 	else
547: 		console_mouse_buttons &= ~mask;
548: }
