"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'

import subprocess,re,json,collections
paths=subprocess.check_output(['git','ls-tree','-r','--name-only','HEAD'],text=True).splitlines()
paths=[p for p in paths if re.search(r'\\.(c|h|cc|cpp|cxx|hpp|inc)"'$'"',p)]
raw=subprocess.check_output(['git','cat-file','--batch'],input=''.join('HEAD:'+p+'\\n' for p in paths).encode())
files={}
pos=0
for p in paths:
    e=raw.index(b'\\n',pos); size=int(raw[pos:e].split()[-1]); pos=e+1
    files[p]=raw[pos:pos+size].decode('utf-8','replace'); pos+=size+1
blank=re.compile(r'//["'^'"\\n]*|/\\*[\\s\\S]*?\\*/|\"(?:\\\\[\\s\\S]|["'^"'"\\\\])*\"|\\'(?:\\\\[\\s\\S]|["'^'"\\'\\\\])*\\'')
tok=re.compile(r'0[xX][0-9a-fA-F]+[uUlL]*|\\d+(?:\\.\\d*)?[uUlLfF]*|[A-Za-z_]\\w*|<<=|>>=|<<|>>|->|\\+\\+|--|&&|\\|\\||==|"'!=|<=|>=|[''^'"\\s]')
def right(ts,j):
    def unary(k):
        if k>=len(ts): return k
        t=ts[k][0]
        if t in ('+','-','~','"'!'"','*','&','++','--','sizeof'): return unary(k+1)
        if t=='(':
            start=k; dep=1; k+=1
            while k<len(ts) and dep:
                dep+= (ts[k][0]=='(')-(ts[k][0]==')'); k+=1
            inner=' '.join(x[0] for x in ts[start+1:k-1])
            if re.fullmatch(r'(?:(?:u?int\\d+_t|u?intptr_t|size_t|ssize_t|unsigned|signed|long|short|int|char|const|float|double|register|void|\\*)\\s*)+',inner): return unary(k)
        else: k+=1
        while k<len(ts):
            if ts[k][0] in ('[','('):
                a=ts[k][0]; b=']' if a=='[' else ')'; dep=1; k+=1
                while k<len(ts) and dep:
                    dep+=(ts[k][0]==a)-(ts[k][0]==b); k+=1
            elif ts[k][0] in ('->','.'): k+=2
            elif ts[k][0] in ('++','--'): k+=1
            else: break
        return k
    def mul(k):
        k=unary(k)
        while k<len(ts) and ts[k][0] in ('*','/','%'): k=unary(k+1)
        return k
    k=mul(j)
    while k<len(ts) and ts[k][0] in ('+','-'): k=mul(k+1)
    return k
rows=[]; totals=collections.Counter()
for p,s in files.items():
    clean=blank.sub(lambda m:re.sub(r'["'^'"\\n]',' ',m[0]),re.sub(r'\\\\\\r?\\n',lambda m:' '*len(m[0]),s))
    ts=[(m[0],m.start(),m.end()) for m in tok.finditer(clean)]
    for i,(op,st,en) in enumerate(ts):
        if op not in ('<<','>>','<<=','>>='):continue
        totals[p.split('/')[0]]+=1
        j=right(ts,i+1)
        rhs=clean[ts[i+1][1]:ts[j-1][2]]
        rhs=re.sub(r'\\s+',' ',rhs).strip()
        x=rhs
        while x.startswith('(') and x.endswith(')'):x=x[1:-1].strip()
        if re.fullmatch(r'(?:0[xX][0-9a-fA-F]+|\\d+)[uUlL]*',x):continue
        line=s.count('\\n',0,st)+1
        textline=s.splitlines()[line-1].strip()
        rows.append({'p':p,'l':line,'op':op,'rhs':rhs,'anchor':textline})

wanted=set()
for r in rows:
 if r['p'].startswith('src/') and '/tmp_' not in r['p']:
  wanted.update(x for x in re.findall(r'\\b[A-Z][A-Z_0-9]*\\b',r['rhs']))
defs=collections.defaultdict(set)
for p,s in files.items():
 if not p.startswith('src/'):continue
 for m in re.finditer(r'"'^'"\\s*#\\s*define\\s+([A-Za-z_]\\w*)[ \\t]+(["'^'"\\n]*)',s,re.M):
  if m[1] in wanted:defs[m[1]].add(re.sub(r'/\\*.*','',m[2]).strip())
print(json.dumps({k:list(v) for k,v in sorted(defs.items())}))

