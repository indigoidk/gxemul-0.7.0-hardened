459: static void m88k_ext(struct cpu *cpu, struct m88k_instr_call *ic, int w, int o)
460: {
461: 	uint32_t src = reg(ic->arg[1]), x = src >> o;
462: 	if (w != 0) {
463: 		uint32_t signbit = (uint32_t)1 << (w - 1);
464: 		x &= ((uint32_t)1 << w) - 1;
465: 		if (x & signbit)
