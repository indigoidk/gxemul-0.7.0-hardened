1280:  *  case out, and copying the byte form's shift here would have been silently
1281:  *  wrong for exactly one of the four encodings.
1282:  *
1283:  *  arg[0] = the instruction word
1284:  */
1285: X(uxtah_rot)
1286: {
1287: 	uint32_t iw = ic->arg[0];
1288: 	uint32_t x = cpu->cd.arm.r[iw & 15];
1289: 	int rot = ((iw >> 10) & 3) * 8;
1290: 
1291: 	if (rot == 24)
1292: 		x = (x >> 24) | ((x & 0xff) << 8);
1293: 	else
1294: 		x >>= rot;
1295: 
1296: 	cpu->cd.arm.r[(iw >> 12) & 15] = cpu->cd.arm.r[(iw >> 16) & 15]
1297: 	    + (uint16_t)x;
1298: }
1299: Y(uxtah_rot)
