901: static void mii_access(struct cpu *cpu, struct dec21143_data *d,
902: 	uint32_t oldreg, uint32_t idata)
903: {
904: 	int obit, ibit = 0;
905: 	uint16_t tmp;
906: 
907: 	/*  Only care about data during clock cycles:  */
908: 	if (!(idata & MIIROM_MDC))
909: 		return;
910: 
911: 	if (idata & MIIROM_MDC && oldreg & MIIROM_MDC)
912: 		return;
913: 
914: 	/*  fatal("[ mii_access(): 0x%08x ]\n", (int)idata);  */
915: 
916: 	if (idata & MIIROM_BR) {
917: 		fatal("[ mii_access(): MIIROM_BR: TODO ]\n");
918: 		return;
919: 	}
920: 
921: 	obit = idata & MIIROM_MDO? 1 : 0;
922: 
923: 	if (d->mii_state >= MII_STATE_START_WAIT &&
924: 	    d->mii_state <= MII_STATE_READ_PHYADDR_REGADDR &&
925: 	    idata & MIIROM_MIIDIR)
926: 		fatal("[ mii_access(): bad dir? ]\n");
927: 
928: 	switch (d->mii_state) {
929: 
930: 	case MII_STATE_RESET:
931: 		/*  Wait for a starting delimiter (0 followed by 1).  */
932: 		if (obit)
933: 			return;
934: 		if (idata & MIIROM_MIIDIR)
935: 			return;
936: 		/*  fatal("[ mii_access(): got a 0 delimiter ]\n");  */
937: 		d->mii_state = MII_STATE_START_WAIT;
938: 		d->mii_opcode = 0;
939: 		d->mii_phyaddr = 0;
940: 		d->mii_regaddr = 0;
941: 		break;
942: 
943: 	case MII_STATE_START_WAIT:
944: 		/*  Wait for a starting delimiter (0 followed by 1).  */
945: 		if (!obit)
946: 			return;
947: 		if (idata & MIIROM_MIIDIR) {
948: 			d->mii_state = MII_STATE_RESET;
949: 			return;
950: 		}
951: 		/*  fatal("[ mii_access(): got a 1 delimiter ]\n");  */
952: 		d->mii_state = MII_STATE_READ_OP;
953: 		d->mii_bit = 0;
954: 		break;
955: 
956: 	case MII_STATE_READ_OP:
957: 		if (d->mii_bit == 0) {
958: 			d->mii_opcode = obit << 1;
959: 			/*  fatal("[ mii_access(): got first opcode bit "
960: 			    "(%i) ]\n", obit);  */
961: 		} else {
962: 			d->mii_opcode |= obit;
963: 			/*  fatal("[ mii_access(): got opcode = %i ]\n",
964: 			    d->mii_opcode);  */
965: 			d->mii_state = MII_STATE_READ_PHYADDR_REGADDR;
966: 		}
967: 		d->mii_bit ++;
968: 		break;
969: 
970: 	case MII_STATE_READ_PHYADDR_REGADDR:
971: 		/*  fatal("[ mii_access(): got phy/reg addr bit nr %i (%i)"
972: 		    " ]\n", d->mii_bit - 2, obit);  */
973: 		if (d->mii_bit <= 6)
974: 			d->mii_phyaddr |= obit << (6-d->mii_bit);
975: 		else
976: 			d->mii_regaddr |= obit << (11-d->mii_bit);
977: 		d->mii_bit ++;
978: 		if (d->mii_bit >= 12) {
979: 			/*  fatal("[ mii_access(): phyaddr=0x%x regaddr=0x"
980: 			    "%x ]\n", d->mii_phyaddr, d->mii_regaddr);  */
981: 			d->mii_state = MII_STATE_A;
982: 		}
983: 		break;
984: 
985: 	case MII_STATE_A:
986: 		switch (d->mii_opcode) {
987: 		case MII_COMMAND_WRITE:
988: 			if (d->mii_bit >= 13)
989: 				d->mii_state = MII_STATE_D;
990: 			break;
991: 		case MII_COMMAND_READ:
992: 			ibit = 0;
993: 			d->mii_state = MII_STATE_D;
994: 			break;
995: 		default:debug("[ mii_access(): UNIMPLEMENTED MII opcode "
996: 			    "%i (probably just a bug in GXemul's "
997: 			    "MII data stream handling) ]\n", d->mii_opcode);
998: 			d->mii_state = MII_STATE_RESET;
999: 		}
1000: 		d->mii_bit ++;
1001: 		break;
1002: 
1003: 	case MII_STATE_D:
1004: 		switch (d->mii_opcode) {
1005: 		case MII_COMMAND_WRITE:
1006: 			if (idata & MIIROM_MIIDIR)
1007: 				fatal("[ mii_access(): write: bad dir? ]\n");
1008: 			obit = obit? (0x8000 >> (d->mii_bit - 14)) : 0;
1009: 			tmp = d->mii_phy_reg[(d->mii_phyaddr << 5) +
1010: 			    d->mii_regaddr] | obit;
1011: 			if (d->mii_bit >= 29) {
1012: 				d->mii_state = MII_STATE_IDLE;
1013: 				debug("[ mii_access(): WRITE to phyaddr=0x%x "
1014: 				    "regaddr=0x%x: 0x%04x ]\n", d->mii_phyaddr,
1015: 				    d->mii_regaddr, tmp);
1016: 			}
1017: 			break;
1018: 		case MII_COMMAND_READ:
1019: 			if (!(idata & MIIROM_MIIDIR))
1020: 				break;
1021: 			tmp = d->mii_phy_reg[(d->mii_phyaddr << 5) +
1022: 			    d->mii_regaddr];
1023: 			if (d->mii_bit == 13)
1024: 				debug("[ mii_access(): READ phyaddr=0x%x "
1025: 				    "regaddr=0x%x: 0x%04x ]\n", d->mii_phyaddr,
1026: 				    d->mii_regaddr, tmp);
1027: 			ibit = tmp & (0x8000 >> (d->mii_bit - 13));
1028: 			if (d->mii_bit >= 28)
1029: 				d->mii_state = MII_STATE_IDLE;
1030: 			break;
1031: 		}
1032: 		d->mii_bit ++;
1033: 		break;
1034: 
1035: 	case MII_STATE_IDLE:
1036: 		d->mii_bit ++;
1037: 		if (d->mii_bit >= 31)
1038: 			d->mii_state = MII_STATE_RESET;
1039: 		break;
1040: 	}
1041: 
1042: 	d->reg[CSR_MIIROM / 8] &= ~MIIROM_MDI;
1043: 	if (ibit)
1044: 		d->reg[CSR_MIIROM / 8] |= MIIROM_MDI;
1045: }
1046: 
1047: 
1048: /*
1049:  *  srom_access():
1050:  *
1051:  *  This function handles reads from the Ethernet Address ROM. This is not a
1052:  *  100% correct implementation, as it was reverse-engineered from OpenBSD
1053:  *  sources; it seems to work with OpenBSD, NetBSD, and Linux, though.
1054:  *
1055:  *  Each transfer (if I understood this correctly) is of the following format:
1056:  *
1057:  *	1xx yyyyyy zzzzzzzzzzzzzzzz
1058:  *
1059:  *  where 1xx    = operation (6 means a Read),
1060:  *        yyyyyy = ROM address
1061:  *        zz...z = data
1062:  *
1063:  *  y and z are _both_ read and written to at the same time; this enables the
1064:  *  operating system to sense the number of bits in y (when reading, all y bits
1065:  *  are 1 except the last one).
1066:  */
1067: static void srom_access(struct cpu *cpu, struct dec21143_data *d,
1068: 	uint32_t oldreg, uint32_t idata)
1069: {
1070: 	int obit, ibit;
1071: 
1072: 	/*  debug("CSR9 WRITE! 0x%08x\n", (int)idata);  */
1073: 
1074: 	/*  New selection? Then reset internal state.  */
1075: 	if (idata & MIIROM_SR && !(oldreg & MIIROM_SR)) {
1076: 		d->srom_curbit = 0;
1077: 		d->srom_opcode = 0;
1078: 		d->srom_opcode_has_started = 0;
1079: 		d->srom_addr = 0;
1080: 	}
1081: 
1082: 	/*  Only care about data during clock cycles:  */
1083: 	if (!(idata & MIIROM_SROMSK))
1084: 		return;
1085: 
1086: 	obit = 0;
1087: 	ibit = idata & MIIROM_SROMDI? 1 : 0;
1088: 	/*  debug("CLOCK CYCLE! (bit %i): ", d->srom_curbit);  */
1089: 
1090: 	/*
1091: 	 *  Linux sends more zeroes before starting the actual opcode, than
1092: 	 *  OpenBSD and NetBSD. Hopefully this is correct. (I'm just guessing
1093: 	 *  that all opcodes should start with a 1, perhaps that's not really
1094: 	 *  the case.)
1095: 	 */
1096: 	if (!ibit && !d->srom_opcode_has_started)
1097: 		return;
1098: 
1099: 	if (d->srom_curbit < 3) {
1100: 		d->srom_opcode_has_started = 1;
1101: 		d->srom_opcode <<= 1;
1102: 		d->srom_opcode |= ibit;
1103: 		/*  debug("opcode input '%i'\n", ibit);  */
1104: 	} else {
1105: 		switch (d->srom_opcode) {
1106: 		case TULIP_SROM_OPC_READ:
1107: 			if (d->srom_curbit < ROM_WIDTH + 3) {
1108: 				obit = d->srom_curbit < ROM_WIDTH + 2;
1109: 				d->srom_addr <<= 1;
1110: 				d->srom_addr |= ibit;
1111: 			} else {
1112: 				uint16_t romword = d->srom[d->srom_addr*2]
1113: 				    + (d->srom[d->srom_addr*2+1] << 8);
1114: 				if (d->srom_curbit == ROM_WIDTH + 3)
1115: 					debug("[ dec21143: ROM read from offset"
1116: 					    " 0x%03x: 0x%04x ]\n",
1117: 					    d->srom_addr, romword);
1118: 				obit = romword & (0x8000 >>
1119: 				    (d->srom_curbit - ROM_WIDTH - 3))? 1 : 0;
1120: 			}
1121: 			break;
1122: 		default:fatal("[ dec21243: unimplemented SROM/EEPROM "
1123: 			    "opcode %i ]\n", d->srom_opcode);
1124: 		}
1125: 		d->reg[CSR_MIIROM / 8] &= ~MIIROM_SROMDO;

