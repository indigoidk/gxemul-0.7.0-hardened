3413: 		    (uint32_t) (frac >> 29);
3414: 		return 1;
3415: 	}
3416: 
3417: 	if (exp >= 874 && exp <= 896) {			/*  #304: the band  */
3418: 		uint64_t sig = frac | (1ULL << 52);
3419: 		int shift = 29 + (896 - exp) + 1;
3420: 		/*  Truncate -- the extraction never rounds, so no guard bit is
3421: 		    consulted here, unlike frsp's path through the same band.  */
3422: 		*out = (sign << 31) | (uint32_t) (sig >> shift);
3423: 		return 1;
3424: 	}
3425: 
3426: 	return 0;
3427: }
3428: #endif	/*  PPC_STFS_EXTRACT_INCLUDED  */
