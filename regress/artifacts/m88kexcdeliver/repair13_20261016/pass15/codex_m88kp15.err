 244: import os, pty, re, select, struct, sys, time
 245: 
 246: BIN = sys.argv[1] if len(sys.argv) > 1 else "/tmp/gxsec-build/gxemul"
 247: CODE = 0x10000
 248: DATA = 0x20000
 249: XIP_V = 0x2
 250: PSR_RESET = 0x80000002          # MODE | IND (cpu_m88k.c: cr[PSR] = M88K_PSR_MODE | M88K_PSR_IND)
 251: PSR_EXC = 0x8000000b            # MODE | SFD1 | IND | SFRZ after the common path
 252: PSR_USER = 0x00000002           # IND only: what the user-mode rows write via stcr
 253: PSR_FRZSUP = 0x80000003         # MODE | IND | SFRZ, SFD1 CLEAR: a frozen handler that wants its divu to raise DIV0, not SFU1
 254: PSR_FRZUSER = 0x00000003        # IND | SFRZ: a frozen handler dropping to user mode (PRIVILEGE / UNIMPLEMENTED routes).
 255:                                 # *** MODE **AND SFD1** ARE BOTH CLEAR HERE, and this comment said only MODE until v20.
 256:                                 # That omission cost a prediction: PRETABLE15 expected M_RRTRAPSFD1 to red trapfrozensfd1
 257:                                 # alone (58/59) and it measured 57/59, because trapfrozenuser -- which uses this value --
 258:                                 # presents SFD1 clear as well.  A constant's comment that lists SOME of the bits it clears
 259:                                 # reads like a complete decode and is not one.
 260: PSR_USERSFD1 = 0x0000000a       # IND | SFD1, MODE CLEAR: user mode with the FPU disabled -- a legal divu raises SFU1 (kimi, pass 5)
 261: #  v22 (Fable 5.1, 2026-10-16 four-seat adjudication of the close): the re-route's TRAP side has its SFD1-clear stimulus
 262: #  on TWO constants -- PSR_FRZUSER (trapfrozenuser: MODE clear AND SFD1 clear; shared with errpriv and errunimpl) and
 263: #  PSR_FRZSUP (trapfrozensfd1: MODE set, SFD1 clear; shared with errdiv0).  An edit such as PSR_FRZUSER 0x03 -> 0x0b
 264: #  keeps errpriv and errunimpl green and deletes one of those stimuli, and BASE alone would not notice.  A comment is
 265: #  memory; these fire at startup, before any session runs.
 266: PSR_BIT_MODE, PSR_BIT_SFD1 = 0x80000000, 0x00000008
 267: assert not (PSR_FRZUSER & (PSR_BIT_MODE | PSR_BIT_SFD1)), "PSR_FRZUSER must keep MODE and SFD1 clear (trapfrozenuser's cell)"
 268: assert (PSR_FRZSUP & PSR_BIT_MODE) and not (PSR_FRZSUP & PSR_BIT_SFD1), "PSR_FRZSUP must keep MODE set, SFD1 clear (trapfrozensfd1's cell)"

