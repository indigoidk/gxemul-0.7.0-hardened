 592:     def wait_prompt(self, mark, timeout=30):
 593:         t = time.time()
 594:         while time.time() - t < timeout:
 595:             if not self.rd():
 596:                 return False
 597:             if len(self.buf) > mark and self.buf[mark:].rstrip().endswith("GXemul>"):
 598:                 return True
 599:         return False
 600:     def send(self, sx, timeout=30):
 601:         mark = len(self.buf)
 602:         b = (sx + "\n").encode("latin1"); n = 0
 603:         while n < len(b):
 604:             n += os.write(self.fd, b[n:])
 605:         self.wait_prompt(mark, timeout)
 606:         return mark
 607:     def cr(self, name):
 608:         m = self.send("reg 0,0")
 609:         mm = re.search(r"(?<![A-Z])%s=0x([0-9a-f]{8})" % name, self.buf[m:])
 610:         return int(mm.group(1), 16) if mm else None
 611:     def gpr(self, n):
 612:         m = self.send("reg")
 613:         mm = re.search(r"r%-2d\s*=\s*0x([0-9a-f]{8})" % n, self.buf[m:])
 614:         return int(mm.group(1), 16) if mm else None
 615:     def pc(self):
 616:         m = self.send("reg")
 617:         mm = re.search(r"pc\s*=\s*0x([0-9a-f]{8})", self.buf[m:])
 618:         return int(mm.group(1), 16) if mm else None
 619:     def close(self):
 620:         try:
 621:             os.write(self.fd, b"quit\n"); time.sleep(0.3); os.kill(self.pid, 9); os.waitpid(self.pid, 0)
 622:         except Exception:
 623:             pass
