"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import ast, pathlib, hashlib, re
root=pathlib.Path('.')
d=root/'regress/artifacts/m88kexcdeliver/repair13_20261016'
p=root/'regress/m88k_exc_probe.py'
f=d/'m88k_exc_probe_v24b.FROZEN.py'
def code_tree(path):
    node=ast.parse(path.read_text(encoding='utf-8'))
    if isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant) and isinstance(node.body[0].value.value,str):
        node.body.pop(0)
    return ast.dump(node,include_attributes=False)
print('working probe equals corrected measured instrument AST excluding docstring:',code_tree(p)==code_tree(f))
for path in (p,d/'m88k_exc_probe_v24.FROZEN.py',f):
    print(path.name,'md5',hashlib.md5(path.read_bytes()).hexdigest())
node=ast.parse(p.read_text(encoding='utf-8'))
expected={}
for item in node.body:
    if isinstance(item,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='EXPECT_RESULT' for t in item.targets):
        expected=ast.literal_eval(item.value)
for prefix in ('t20_','t20b_'):
    files=sorted(d.glob(prefix+'*.out'))
    problems=[]
    for path in files:
        txt=path.read_text(encoding='utf-8')
        rows=re.findall(r'"'^M88KEXC_ROW=('"\\S+)\\s+RESULT=(\\S+)',txt,re.M)
        fault=[(n,r) for n,r in rows if n not in ('live','attrib')]
        actual=sum(r==expected.get(n,'DELIVER') for n,r in fault)
        score=re.findall(r'M88KEXC_RESULT=(\\d+)/(\\d+)',txt)
        if score"'!=[(str(actual),'"'84')] or len(fault)"'!=84 or len(set(n for n,r in rows))!=86 or '"'M88KEXC_DONE' not in txt or any(r"'!='"'DONE' for n,r in rows if n in ('live','attrib')):
            problems.append(path.name)
    print(prefix,'logs checked',len(files),'score/denominator/control/completion discrepancies',problems)
