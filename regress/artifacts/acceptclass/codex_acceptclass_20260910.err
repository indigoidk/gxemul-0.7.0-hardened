178:"""
179:import os
180:import pty
181:import re
182:import select
183:import sys
184:import time
185:
186:BIN = sys.argv[1] if len(sys.argv) > 1 else "../../build/gxemul"
187:KERNEL = sys.argv[2] if len(sys.argv) > 2 else "../../_images/openbsd76-landisk-bsd.rd"
188:
189:#  Dreamcast RAM is 16 MB at 0x0c000000; the loaded ELF lands at 0x8c002000
190:#  and grows up, so plant below it.  -M 64 is passed only for uniformity with
191:#  the other SH probes; this machine's RAM is a fixed dev_ram regardless.
192:CODE = 0x8c001000
193:SCRATCH = 0x8c001800
194:
195:BASE = 0xa05f7000              # the 0x100 window, via P2 (uncached)
196:DMA = 0xa05f7400               # the DMA window, 0x80, SEPARATELY registered
197:GDROM_CNTLO = 0xa05f7090      # #460's probe drives these to stage a TOC
198:GDROM_CNTHI = 0xa05f7094
199:GDROM_COND  = 0xa05f709c
200:GDROM_DATAP = 0xa05f7080      # ...and the CONTROL window's data port (+0x80)
201:SYSASIC_PEND = 0xa05f6900     # pending_irq[0], guest-READABLE (dev_dreamcast_asic.c:130)
202:SYSASIC_DMA_BIT = 0x4000      # SYSASIC_EVENT_GDROM_DMA is 14, so bit 14
203:DMA_DST_P1 = 0x8c008000       # the accept session's destination, via P1.
204:#  The session writes 0x0c008000 into +0x04 and the device masks it with
205:#  0x0fffffff, so physical 0x0c008000 is what the transfer targets.  CODE
206:#  is 0x8c001000 and the TOC is 408 bytes, so the two never overlap.
207:IMPLEMENTED_WORDS = (0x18, 0x80, 0x84, 0x88, 0x8c, 0x90, 0x94, 0x9c)
208:IMPL_BUSY = BASE + 0x18        # implemented: returns d->busy
209:IMPL_CNTLO = BASE + 0x90       # implemented: returns d->cnt & 0xff
210:IMPL_COND = BASE + 0x9c        # implemented
211:UNIMPL_A = BASE + 0x00         # unimplemented -> default:
212:UNIMPL_B = BASE + 0x04         # unimplemented, a DIFFERENT word
213:UNIMPL_Z = BASE + 0xfc         # unimplemented, far end of the window
214:
215:SH4_IPRD = 0xffd00010
216:IPRD_RESET = 0xda74
217:LIVE = 0x12345678
218:
219:MOV_W_R8_AT_R7 = 0x2781
220:MOV_L_R8_AT_R7 = 0x2782
221:MOV_W_AT_R1_R2 = 0x6211
222:MOV_L_AT_R1_R2 = 0x6212
223:MOV_L_AT_R3_R2 = 0x6232       # mov.l @r3,r2
224:MOV_W_AT_R3_R2 = 0x6231       # mov.w @r3,r2
225:ADD_4_R1 = 0x7104             # add #4,r1
226:MOV_B_R6_AT_R5 = 0x2560       # mov.b r6,@r5
227:MOV_W_R6_AT_R5 = 0x2561       # mov.w r6,@r5
228:MOV_L_AT_R1_R3 = 0x6312       # mov.l @r1,r3.  0110nnnnmmmm0010 with n=3 m=1;
229:#  0x6313 -- which this line first said -- is `mov.l @Rm+,Rn`, a DIFFERENT
230:#  instruction that also post-increments r1.  Caught by computing the encoding
231:#  instead of trusting the typing, which is the hand-assembled-encoding trap the
232:#  carrier records: a wrong field yields a plausible value and no error.  The
233:#  sibling MOV_L_AT_R1_R2 = 0x6212 (n=2 m=1) is the cross-check.
234:MOV_L_R2_AT_R1 = 0x2122       # mov.l r2,@r1  (n=1 m=2)
235:MOV_L_R6_AT_R5 = 0x2562       # mov.l r6,@r5  (0010nnnnmmmm0010, n=5 m=6)
236:MOV_L_R4_AT_R3 = 0x2342       # mov.l r4,@r3  (0010nnnnmmmm0010, n=3 m=4)
237:MOV_B_AT_R1_R4 = 0x6410       # mov.b @r1,r4  (0110nnnnmmmm0000, n=4 m=1)
238:BRA_SELF = 0xaffe
239:NOP = 0x0009
240:
241:#  #490: the two decline diagnostics the sibling round added.  ANCHORED on `-- declined`,
242:#  because the bare `unimplemented data format` also matches the upstream 0x24
243:#  warn-and-continue line -- measured, not assumed.
244:FMT_DECL = re.compile(r"unimplemented data format 0x[0-9a-f]+ -- declined")
245:CMD_DECL = re.compile(r"unimplemented command 0x[0-9a-f]+ -- declined")
246:
247:rows = []
248:
249:
250:#  *** THE ROW-NAME COLUMN IS 14 AND THE LONGEST NAME IS 12, WHICH IS NOT
251:#  SLACK -- IT IS THE DISCRIMINATOR. ***
252:#
253:#  gate_sh_rounding.sh counts rows with `^$v  .*ok$` -- TWO spaces after the
254:#  name.  Four names here are prefixes of others (`dma rd`/`dma rd x1`,
255:#  `dma rd`/`dma rdleak`, `dma alias`/`dma alias x1`, `scan`/`scan uniq`),
256:#  and they are unambiguous ONLY because %-14s leaves at least two spaces
257:#  after every one of them.  `dma rd` cannot match the `dma rdleak` row
258:#  because that row has an `l` where the pattern needs a space.
259:#
260:#  *** #490 L4: THIS SAID "13 or 14" AND 13 IS FINE.  THE LIMIT IS 13. ***
261:#  The format is `"%-14s %-12s ..."` -- a 14-column field PLUS a literal
262:#  space -- so the padding and that space add up like this, measured:
263:#
264:#      12 chars -> 3 trailing spaces   `^name  ` MATCHES
265:#      13 chars -> 2 trailing spaces   MATCHES  (the comment denied this)
266:#      14 chars -> 1 trailing space    UNSATISFIABLE
267:#
268:#  Found by the codex seat on #490's pass 1, which also caught that I had
269:#  copied the wrong bound ("<= 12") out of this comment and into a design
270:#  brief -- so the error had already propagated once before it was read.
271:#  The extra character is NOT slack to spend casually: at 13 the margin is
272:#  exactly the two spaces the gate needs, with nothing left over.
273:#
274:#  A row named 14 characters leaves fewer than two spaces and its
275:#  check becomes UNSATISFIABLE.  Checked, and this is the SAFE direction:
276:#  the count reads 0 against a wanted 1, so the gate fails LOUDLY rather
277:#  than quietly dropping the row -- the opposite of the padded-column trap
278:#  the carrier records, where a too-long name makes a row stop being
279:#  tested in silence.  Widen the column if a longer name is ever needed;
280:#  do not shorten the name to fit and leave the constraint unstated.
281:def row(name, got, want, note=""):
282:    ok = (got == want)
283:    rows.append((name, ok))
284:    print("%-14s %-12s %-12s %-34s %s" % (name, got, want, note,
285:                                          "ok" if ok else "FAIL"))
286:    return ok
287:
288:
289:def session(cmds, settle=8.0, spin=2.0):
290:    pid, fd = pty.fork()
291:    if pid == 0:
292:        os.execv(BIN, [BIN, "-V", "-x", "-E", "dreamcast", "-M", "64", KERNEL])
293:        os._exit(127)
294:    buf = ""
295:
296:    def rd(t):
297:        nonlocal buf
298:        end = time.time() + t
299:        while time.time() < end:
300:            r, _, _ = select.select([fd], [], [], 0.25)
301:            if not r:
302:                continue
303:            try:
304:                d = os.read(fd, 65536)
305:            except OSError:
306:                return False
307:            if not d:
308:                return False
309:            buf += d.decode("latin-1", "replace")
310:        return True
311:
312:    alive = rd(settle)
313:    for i, c in enumerate(cmds):
314:        try:
315:            os.write(fd, (c + "\n").encode("latin-1"))
316:        except OSError:
317:            alive = False
318:            break
319:        if not rd(spin if i == len(cmds) - 1 else 0.35):
320:            alive = False
321:            break
322:    try:
323:        os.write(fd, b"quit\n")
324:        rd(0.6)
325:    except OSError:
326:        pass
327:    try:
328:        os.close(fd)
329:    except OSError:
330:        pass
331:    #  #490: DEATH-MODE CHANNEL.  `alive` is False only when a read raises OSError or
332:    #  returns empty inside a budget window, so it is true of a HUNG emulator, a FROZEN
333:    #  one, and -- measured -- one ALREADY KILLED after the last budget check.  It cannot
334:    #  tell a clean exit from a signal from a decline.  Round 2 removes two exit(1) sites,
335:    #  after which every mutant AND the correct decline are alike `exit0`, so a survival
336:    #  oracle stops discriminating entirely.
337:    #
338:    #  Spelling COPIED VERBATIM from gdrom_toclen_probe.py rather than invented: two panel
339:    #  seats independently said copy the existing oracle, and a third shape would make the
340:    #  two gdrom probes disagree about what "died" means.
341:    how = "nostatus"
342:    try:
343:        _, stat = os.waitpid(pid, 0)
344:        if os.WIFSIGNALED(stat):
345:            how = "sig%d" % os.WTERMSIG(stat)
346:        elif os.WIFEXITED(stat):
347:            how = "exit%d" % os.WEXITSTATUS(stat)
348:    except OSError:
349:        pass
350:    return buf, alive, how
351:
352:
353:def printed(t, reg):
354:    m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
355:    return m.group(1) if m else "absent"
356:
357:
358:def run(steps, at=CODE):
359:    """Plant a run of instructions, then a self-branch, and step them all."""
360:    put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(steps)]
361:    put += ["put h 0x%x, 0x%04x" % (at + 2 * len(steps), BRA_SELF),
362:            "put h 0x%x, 0x%04x" % (at + 2 * len(steps) + 2, NOP)]
363:    return put + ["pc=0x%x" % at, "step %d" % len(steps)]
364:
365:
366:def ld(reg):
367:    return ["r1=0x%x" % reg, "r2=0"]
368:
369:
370:def pair(setup, ops):
371:    """Plant SEVERAL accesses contiguously and step them all.
372:
373:    *** USE THIS FOR EVERY MULTI-ACCESS ROW. ***  Calling run() twice does NOT
374:    work: each call emits its own `pc=`/`step`, so the second overrides the
375:    first and only ONE access ever executes.  #460 hit exactly this and it
376:    made four latch rows vacuous -- they read a count of 1 whether the latch
377:    worked or not.  Here it turned a CONTROL red instead, which is the loud
378:    direction, and one measurement found it.
379:    """
380:    return setup + run(ops)
381:
382:
383:def st(reg, val):
384:    return ["r7=0x%x" % reg, "r8=0x%08x" % val]
385:
386:
387:#  ---------------------------------------------------------------- controls
388:t, alive, how = session(st(SCRATCH, LIVE) + ld(SCRATCH)
389:                   + run([MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
390:row("live", printed(t, "r2") if alive else "died", "0x%x" % LIVE,
391:    "RAM: guest store then guest load")
392:
393:t, alive, how = session(ld(SH4_IPRD) + run([MOV_L_AT_R1_R2]) + ["print r2"])
394:g = printed(t, "r2") if alive else "died"
395:row("devsig", ("0x%x" % (int(g, 16) & 0xffff)) if g.startswith("0x") else g,
396:    "0x%x" % IPRD_RESET, "SH4 IPRD reset value -- dispatch works")
397:
398:#  An IMPLEMENTED offset, to prove the device is mapped and its arm serves.
399:#
400:#  *** THE FIRST VERSION OF THIS ROW WAS VACUOUS, AND MEASURED SO. ***  It read
401:#  +0x18 and asserted only that the answer started with "0x" -- but `print r2`
402:#  ALWAYS prints hex, so it was green even on a build with `case GDROM_BUSY:`
403:#  DELETED, where +0x18 falls through to the default arm.  It was a
404:#  session-liveness row duplicating `live`, wearing a device row's label.
405:#
406:#  The root cause is worth keeping, because it constrains the fix: a DECLINED
407:#  read at +0x00 returns 0, and a SERVED read of +0x18 ALSO returns 0 on a
408:#  fresh device -- busy, cond, stat and cnt are all zero.  No value-only row
409:#  can tell served from declined here.  So this is now store-then-read-back on
410:#  CNTHI, which RAM cannot fake and a deleted case cannot satisfy.
411:t, alive, how = session(pair(st(BASE + 0x94, 0x5a) + ld(BASE + 0x94),
412:                        [MOV_W_R8_AT_R7, MOV_W_AT_R1_R2]) + ["print r2"])
413:row("impl ok", printed(t, "r2") if alive else "died", "0x5a",
414:    "CNTHI (+0x94) stores and reads back")
415:
416:#  #490: `rows and` IS LOAD-BEARING, and its absence was a CHECK THAT CANNOT FAIL.
417:#  `all([])` is True, so an empty `rows` printed CONTROL=OK -- the control row whose
418:#  entire job is to prove this probe MEASURED something would certify a run that
419:#  measured nothing, and gate_sh_rounding.sh's `check "... control proves it
420:#  measures" "OK"` would pass on it.  Latent today (all 58 rows always run) and
421:#  reachable the moment any row selection exists, which is why it is closed BEFORE
422:#  that lands rather than with it.  Found by the opus seat while attacking a row
423:#  filter that was withdrawn -- the filter went, the hazard it exposed stayed.
424:print("GDROM_DEF_CONTROL=%s"
425:      % ("OK" if rows and all(ok for _, ok in rows) else "DEAD"))
426:
427:#  ---------------------------------------------------------------- triggers
428:#  Each is ONE guest instruction at an UNIMPLEMENTED offset.  Post-fix every
429:#  one must leave the host alive AND name itself exactly once.
430:SAYS = re.compile(r"dreamcast_gdrom: (?:read from|write to) addr 0x")
431:#  The DMA arm needs its OWN pattern: SAYS cannot match it, because after
432:#  "dreamcast_gdrom" that pattern expects ": " and the DMA text has "_dma: ".
433:#  A seat flagged that before it could become a silently-zero count.
434:DMA_SAYS = re.compile(r"dreamcast_gdrom_dma: (?:read from|write to) addr 0x")
435:
436:for label, cmds, note in (
437:        ("rd lo", ld(UNIMPL_A) + run([MOV_L_AT_R1_R2]),
438:         "32-bit READ at +0x00"),
439:        ("wr lo", st(UNIMPL_B, 0x5a5a5a5a) + run([MOV_L_R8_AT_R7]),
440:         "32-bit WRITE at +0x04"),
441:        ("rd hi", ld(UNIMPL_Z) + run([MOV_L_AT_R1_R2]),
442:         "32-bit READ at +0xfc, far end"),
443:        ("rd w16", ld(UNIMPL_A) + run([MOV_W_AT_R1_R2]),
444:         "16-bit read: width must not matter here")):
445:    t, alive, how = session(cmds)
446:    row(label, "survived" if alive else "died", "survived", note)
447:    row(label.replace(" ", "") + " x1",
448:        ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
449:        "names itself EXACTLY once")
450:
451:#  ------------------------------------------------------- latch SCOPE rows
452:#
453:#  *** THESE ARE THE ROWS THAT DECIDE THE DESIGN, AND NOTHING ELSE CAN SEE IT.
454:#
455:#  A single per-device flag makes ONE unimplemented access silence the other
456:#  247, which is the "1 of 4 kinds" hazard #438 recorded and #443 refused.  A
457:#  per-word bitmap keyed by fault class is the shape #443 shipped for the same
458:#  problem in the same tree.  Only rows that drive TWO DIFFERENT offsets, and
459:#  the SAME offset in BOTH directions, can tell those apart.
460:
461:t, alive, how = session(ld(UNIMPL_A) + run([MOV_L_AT_R1_R2, MOV_L_AT_R1_R2]))
462:row("same twice", ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
463:    "SAME offset twice -> one line")
464:
465:#  r1 then r3, so both loads have their own address register and both can be
466:#  planted contiguously.
467:t, alive, how = session(pair(["r1=0x%x" % UNIMPL_A, "r3=0x%x" % UNIMPL_B, "r2=0"],
468:                        [MOV_L_AT_R1_R2, MOV_L_AT_R3_R2]))
469:row("two offs", ("%d" % len(SAYS.findall(t))) if alive else "died", "2",
470:    "DIFFERENT offsets -> TWO lines, not one")
471:
472:#  *** RE-PINNED 2 -> 1 -> 2. THE SECOND REVERSAL IS THE ONE THAT MATTERS, AND
473:#  IT IS A MEASUREMENT OVERTURNING A VOTE. ***
474:#
475:#  The first draft expected TWO lines, which silently pre-answered the brief's
476:#  own open question about a read/write class split.  The pass-1 panel answered
477:#  it the other way 3-1, on reasoning that read well: #443's classes are KINDS
478:#  OF COMPLAINT rather than directions, the fault here is spatial, and direction
479:#  is already printed in the first line.  I re-pinned to 1 on that.
480:#
481:#  THEN THE MEASURING SEAT BUILT BOTH AND RAN A READ PASS FOLLOWED BY A WRITE
482:#  PASS OVER THE SAME 31 DECLINED OFFSETS:
483:#
484:#      direction x offset   ->  62 lines, 31 unique offsets
485:#      offset only          ->  31 lines, and ZERO WRITE DIAGNOSTICS
486:#
487:#  The read pass latches every offset first, so under offset-only keying a
488:#  guest's writes to unimplemented space are reported NOWHERE.  And the write
489:#  line is the only one that carries `idata` -- the value you need in order to
490:#  model the register later.  That is not padding, and the three seats that
491:#  called it padding were reasoning from #443's structure rather than from this
492:#  arm's behaviour.
493:#
494:#  Restored to 2.  Recorded at length because the project's rule is that
495:#  disagreements are settled EMPIRICALLY and never by vote, and this is the
496:#  case where the vote and the measurement pointed opposite ways -- a 3-1
497:#  majority, overturned by one build.
498:t, alive, how = session(pair(ld(UNIMPL_A) + st(UNIMPL_A, 0x1234),
499:                        [MOV_L_AT_R1_R2, MOV_L_R8_AT_R7]))
500:row("rd then wr", ("%d" % len(SAYS.findall(t))) if alive else "died", "2",
501:    "SAME offset, both directions -> TWO lines")
502:
503:#  GRANULARITY, and it is a design commitment nothing else pins.  Per-WORD
504:#  keying merges +0x00..+0x03 into one bit; per-BYTE keying would give four.
505:#  A seat flagged that the brief chose per-word silently, and a second named the
506:#  mutant it protects against: indexing the bitmap with `relative_addr` instead
507:#  of `relative_addr >> 2`, which under a [2] array writes past the end while
508:#  still printing exactly once -- every other row green, host memory corrupted.
509:#  Under raw-byte indexing these two accesses latch different bits and print
510:#  twice, so this row reddens where the others cannot see it.
511:t, alive, how = session(pair(["r1=0x%x" % UNIMPL_A, "r3=0x%x" % (UNIMPL_A + 2), "r2=0"],
512:                        [MOV_L_AT_R1_R2, MOV_W_AT_R3_R2]))
513:row("granularity", ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
514:    "+0x00 then +0x02 are ONE word -> one line")
515:
516:#  ---------------------------------------------------------------- accept side
517:#
518:#  The de-escalation clause: this fix removes a host-fatal predicate, so the
519:#  detector must pin that the IMPLEMENTED offsets still work.  Without these,
520:#  a mutant that turns the whole switch into `default:` -- or simply deletes
521:#  the implemented arms -- scores full marks on every row above.
522:
523:t, alive, how = session(pair(st(IMPL_CNTLO, 0x98) + ld(IMPL_CNTLO),
524:                        [MOV_W_R8_AT_R7, MOV_W_AT_R1_R2]) + ["print r2"])
525:row("accept cnt", printed(t, "r2") if alive else "died", "0x98",
526:    "CNTLO (+0x90) still stores and reads back")
527:
528:t, alive, how = session(pair(st(IMPL_COND, 0xa0) + ld(IMPL_BUSY),
529:                        [MOV_W_R8_AT_R7, MOV_W_AT_R1_R2]) + ["print r2"])
530:row("accept cond", printed(t, "r2") if alive else "died", "0x8",
531:    "COND=0xa0 (+0x9c) still sets BUSY bit 3")
532:
533:#  ------------------------------------------------------------- the window scan
534:#
535:#  *** THE SCAN AND THE GRANULARITY ROW KILL DIFFERENT MUTANTS AND NEITHER
536:#  SUBSUMES THE OTHER -- measured, against the measuring seat's own prediction
537:#  that the scan would cover everything. ***
538:#
539:#      counter capped at 4   scan 4 != 56  KILLED   granularity 1  survives
540:#      key mask off & 0x7f   scan 32 != 56 KILLED   granularity 1  survives
541:#      index by raw address  scan 15 != 56 KILLED   granularity 2  KILLED
542:#
543:#  *** THE THIRD ROW SAID `scan 56 == 56 SURVIVES` UNTIL A PASS-2 SEAT
544:#  MEASURED IT AT 15. ***  The old number was the pass-1 analysis of a design
545:#  WITHOUT the bounds guard, and it survived into the shipped comment beside a
546:#  table that already refuted it.  With the guard, raw indexing makes every
547:#  offset >= 0x40 exceed the 64 keys and be rejected, so 41 of the 56 declined
548:#  offsets never report and the scan reads 15.
549:#
550:#  So the scan DOES kill this one, and `granularity` is no longer its sole
551:#  killer.  *** KEEP THE GRANULARITY ROW ANYWAY, but for the honest reason:
552:#  it pins a DESIGN COMMITMENT (per-word keying) cheaply and directly, rather
553:#  than because it is the only row that can see this mutant. ***  The same
554:#  seat measured that across six mutants `scan uniq` kills everything anything
555:#  kills -- so the subsumption claim this block was built on is false in the
556:#  other direction too, and saying so is cheaper than a row that pretends.
557:#
558:#  The magnitude claim was overstated as well.  A guardless `bits[k]` reaches
559:#  dma_reg[0..3] -- count, destination and length -- but NOT dma_reg[5], the
560:#  enable, which needs word index 11 against a maximum of 9.  "The two fields
561:#  that authorise a transfer" was wrong; it is three of the four.
562:#
563:#  EQUALITY, not >=, so this doubles as an IDENTITY row: 64 word keys minus 8
564:#  implemented offsets is exactly 56.  A ninth implemented register moves it to
565:#  55 in the same commit, which is the fail-closed ratchet gate_hygiene already
566:#  uses for EXPECT_CONVERTED.
567:#  ONE session, not 56.  A per-offset session took over ten minutes; a planted
568:#  linear run of `mov.l @r1,r2 ; add #4,r1` walks the whole window in one.
569:#  Implemented offsets are NOT skipped -- they emit nothing matching SAYS, which
570:#  is exactly what `accept8` proves independently, so the count is still 56.
571:ops = []
572:for _ in range(0x100 // 4):
573:    ops += [MOV_L_AT_R1_R2, ADD_4_R1]
574:t, alive, how = session(["r1=0x%x" % BASE, "r2=0"] + run(ops), settle=8.0, spin=3.0)
575:hits = SAYS.findall(t)
576:row("scan", "survived" if alive else "died", "survived",
577:    "all 64 words of the window, one run")
578:row("scan uniq", ("%d" % len(hits)) if alive else "died", "56",
579:    "64 words - 8 implemented = 56 declines")
580:
581:#  ------------------------------------------------- the accept side that MATTERS
582:#
583:#  *** THREE OF FOUR NARROWING MUTANTS SCORED A PERFECT 16/16 WITHOUT THIS ROW,
584:#  AND ONE OF THEM SILENTLY UNDOES THE PREVIOUS ROUND. ***
585:#
586:#  The measuring seat built Option B and then deleted ONE `case` label at a
587:#  time -- a one-line edit, exactly the shape a "fold this stub into the
588:#  default" tidy-up takes:
589:#
590:#      delete case GDROM_STAT  (+0x8c)  ->  16/16   the register NetBSD polls
591:#                                                   before every command is dead
592:#      delete case GDROM_DATA  (+0x80)  ->  16/16   #460'S ENTIRE ROUND UNDONE
593:#      delete case GDROM_CNTHI (+0x94)  ->  16/16   transfer-count high byte dead
594:#      delete case GDROM_BUSY  (+0x18)  ->  15/16   caught, but only by accident
595:#
596:#  This is the de-escalation clause's own scenario at its sharpest: BEFORE this
597:#  fix, deleting `case GDROM_STAT:` meant exit(1) on the first status poll --
598:#  unmissable.  AFTER it, a silently wrong status forever.  The fix destroys the
599:#  accidental tripwire for its own accept side, so the round owes this row.
600:#
601:#  Read all EIGHT implemented offsets and require the default arm
602:#
603:#  *** THIS SAID "in one session" AND THE LOOP BELOW REFUTES IT. ***  It runs
604:#  EIGHT emulator processes and concatenates their output, which the comment
605:#  eight lines down states correctly -- so two drafts of the same paragraph
606:#  disagreed and the wrong one was on top.  It is equivalent HERE only because
607:#  the expectation is a count of ZERO, which concatenation preserves; a row
608:#  expecting a NON-zero count would have been silently wrong.
609:#  to have printed NOTHING.  Safe by reading: none of the eight arms emits text
610:#  matching SAYS -- BUSY/STAT/CNTLO/CNTHI/COND are silent, REGX says
611:#  "[ Read to GDROM_REGX? ]", UNKNOWN_0x88 says "Read from GDROM_UNKNOWN_0x88?"
612:#  with no `dreamcast_gdrom:` prefix, and #460's warns say "read from
613:#  GDROM_DATA", not "read from addr 0x".
614:#  Same tuple as the scan uses -- one definition, so the two rows can never
615:#  disagree about which offsets are implemented.
616:IMPLEMENTED = IMPLEMENTED_WORDS
617:#  Eight loads through ONE address register, re-pointed between steps is not
618:#  possible in a single run -- so use r1 and step the loads one at a time with
619:#  an explicit pc per access, which is the one place the two-run hazard does
620:#  NOT apply because each access is its own complete run.
621:t = ""
622:alive = True
623:for i, off in enumerate(IMPLEMENTED):
624:    tt, aa, hh = session(pair(["r1=0x%x" % (BASE + off), "r2=0"], [MOV_W_AT_R1_R2]))
625:    t += tt
626:    alive = alive and aa
627:row("accept8", ("%d" % len(SAYS.findall(t))) if alive else "died", "0",
628:    "all EIGHT implemented offsets stay off the default arm")
629:
630:#  And GDROM_DATA's own accept side, which also closes an escape already filed
631:#  against #460: no row there pinned what a declined DATA read returns.
632:t, alive, how = session(ld(BASE + 0x80) + run([MOV_W_AT_R1_R2]) + ["print r2"])
633:g = printed(t, "r2") if alive else "died"
634:row("data 0xffff", ("0x%x" % (int(g, 16) & 0xffff)) if g.startswith("0x") else g,
635:    "0xffff", "+0x80 still declines with 0xffff, not via default")
636:
637:#  ---------------------------------------------------------------- the DMA window
638:#
639:#  *** THE DMA ARM JOINED THIS ROUND ON A MEASUREMENT AND HAD NO ROW AT ALL. ***
640:#  Every row above drives the CONTROL window at 0x005f7000; the sibling arm at
641:#  0x005f7400 was fixed and pinned by nothing.  A round that claims to fix two
642:#  arms and covers one is making a claim its own detector cannot support, so
643:#  these ship with the fix rather than after it.
644:t, alive, how = session(pair(["r1=0x%x" % DMA, "r2=0"], [MOV_L_AT_R1_R2]))
645:row("dma rd", "survived" if alive else "died", "survived",
646:    "32-bit READ at DMA+0x00")
647:row("dma rd x1", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "1",
648:    "the DMA arm names itself EXACTLY once")
649:
650:t, alive, how = session(pair(["r1=0x%x" % (DMA + 0x00), "r3=0x%x" % (DMA + 0x7c), "r2=0"],
651:                        [MOV_L_AT_R1_R2, MOV_L_AT_R3_R2]))
652:row("dma two", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "2",
653:    "DIFFERENT DMA offsets -> TWO lines, separate array")
654:
655:#  *** THE ASYMMETRY THIS ROUND HAD TO NAME, NOW PINNED. ***  In the control
656:#  window declining returns 0 and a declined write does nothing.  Here `odata`
657:#  is preloaded from the shadow register file before the switch and the tail
658:#  STORES a declined write into it -- so "decline" means store-and-return, which
659:#  is what the five implemented cases already do and is kept deliberately.
660:#  Without this row that difference is a claim in a comment and nothing else.
661:t, alive, how = session(pair(["r7=0x%x" % DMA, "r8=0x12345678", "r1=0x%x" % DMA, "r2=0"],
662:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
663:row("dma shadow", printed(t, "r2") if alive else "died", "0x12345678",
664:    "a declined DMA write STORES and reads back")
665:
666:#  *** THE ROW A PASS-2 SEAT'S DO-NOT-SHIP REQUIRED. ***
667:#
668:#  The tail store indexes with TRUNCATING division, so a byte write at DMA+0x05
669:#  does not match `case 0x04`, reaches the default arm, is declined -- and then
670:#  the tail writes it into dma_reg[1], the DMA DESTINATION.  The same alias
671:#  reaches dma_reg[2] (length), dma_reg[3] (count) and dma_reg[5] (enable) from
672:#  +0x09, +0x0d and +0x15, which between them are the whole transfer.
673:#
674:#  PRE-FIX those accesses exited instead, so the fix would have CREATED the
675:#  capability.  This row pins that it does not: write 0xff at +0x05, then read
676:#  +0x04 back and require it UNCHANGED.
677:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
678:                         "r1=0x%x" % (DMA + 0x04), "r2=0"],
679:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
680:row("dma seed", printed(t, "r2") if alive else "died", "0x11223344",
681:    "the implemented +0x04 takes a known value")
682:
683:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
684:                         "r5=0x%x" % (DMA + 0x05), "r6=0xff",
685:                         "r1=0x%x" % (DMA + 0x04), "r2=0"],
686:                        [MOV_L_R8_AT_R7, MOV_B_R6_AT_R5, MOV_L_AT_R1_R2])
687:                   + ["print r2"])
688:row("dma alias", printed(t, "r2") if alive else "died", "0x11223344",
689:    "a declined +0x05 must NOT reach dma_reg[1]")
690:#  ... and the row above is only meaningful if the store EXECUTED.  A wrong
691:#  opcode constant would leave +0x04 untouched and the row green -- the
692:#  hand-assembled-encoding trap exactly.  The declined +0x05 must announce.
693:row("dma alias x1", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "1",
694:    "the +0x05 store really reached the default arm")
695:
696:#  *** ONE CHARACTER RE-OPENS THE DEFECT ABOVE, AND `dma alias` CANNOT SEE IT. ***
697:#
698:#  A pass-2 seat weakened the guard to `relative_addr & 1` and scored 27/27.
699:#  That form still drops the ODD address `dma alias` uses, so that row is
700:#  STRUCTURALLY BLIND to it -- yet a 16-bit store at +0x06 is 2-byte aligned,
701:#  passes `& 1`, and the tail writes it into dma_reg[1] exactly as before.
702:#
703:#  The discriminator is WIDTH, not oddness.  This row uses mov.w at an EVEN but
704:#  not word-aligned address, which is the cheapest access the weaker guard lets
705:#  through -- and it is architecturally legal, so a real guest can issue it.
706:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
707:                         "r5=0x%x" % (DMA + 0x06), "r6=0xffff",
708:                         "r1=0x%x" % (DMA + 0x04), "r2=0"],
709:                        [MOV_L_R8_AT_R7, MOV_W_R6_AT_R5, MOV_L_AT_R1_R2])
710:                   + ["print r2"])
711:row("dma align16", printed(t, "r2") if alive else "died", "0x11223344",
712:    "a 2-byte-aligned +0x06 must NOT reach dma_reg[1]")
713:
714:#  THE SAME DEFECT POINTING THE OTHER WAY.  The source comment claims the guard
715:#  "also stops leaking the aliased word's value" -- and no row pinned it, so a
716:#  seat restricted the guard to `&& writeflag == MEM_WRITE`, scored 27/27, and
717:#  read dma_reg[1] out through a 16-bit load at +0x06.  An UNPINNED CLAIM IN A
718:#  COMMENT IS NOT A PROPERTY.
719:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
720:                         "r3=0x%x" % (DMA + 0x06), "r2=0"],
721:                        [MOV_L_R8_AT_R7, MOV_W_AT_R3_R2]) + ["print r2"])
722:row("dma rdleak", printed(t, "r2") if alive else "died", "0x0",
723:    "an unaligned declined READ returns 0, not the aliased word")
724:
725:#  *** THE SEPARATE-ARRAYS CLAIM, WHICH NO ROW REACHED. ***
726:#
727:#  Two windows, two latch arrays, and the source calls confusing them
728:#  "invisible by construction".  It WAS: every row above drives ONE window, so
729:#  a DMA arm keyed into the control array passes all of them, and so does a
730:#  control arm keyed into the DMA array (which additionally writes past it).
731:#
732:#  Both windows in ONE session at the SAME word index, so a shared array
733:#  latches the first access and SILENCES the second.  Different indices would
734:#  not do it -- that is why this row is not `dma two` with a control offset.
735:#
736:#  *** IT DRIVES BOTH DIRECTIONS, AND THE READ-ONLY VERSION WAS WEAKER. ***  A
737:#  seat pointed out that a read-only row is blind to a DIRECTION-ASYMMETRIC
738:#  cross-wiring -- only the WR arms swapped -- because every other row that
739:#  counts a write diagnostic drives ONE window.  Four accesses in the same
740:#  session cost nothing extra and expect 2/2, which additionally kills that
741:#  variant (it would read 2/1).
742:t, alive, how = session(pair(["r1=0x%x" % UNIMPL_A, "r3=0x%x" % (DMA + 0x00),
743:                         "r7=0x%x" % UNIMPL_A, "r8=0x5a5a5a5a",
744:                         "r5=0x%x" % (DMA + 0x00), "r6=0x5a", "r2=0"],
745:                        [MOV_L_AT_R1_R2, MOV_L_AT_R3_R2,
746:                         MOV_L_R8_AT_R7, MOV_L_R6_AT_R5]))
747:row("both windows",
748:    ("%d/%d" % (len(SAYS.findall(t)), len(DMA_SAYS.findall(t)))) if alive else "died",
749:    "2/2", "same word index, both windows, BOTH directions")
750:
751:#  *** THE OBLIGATION THIS ROUND OWED AND HAD NOT PAID. ***
752:#
753:#  `accept8` exists because three narrowing mutants -- deleting ONE `case`
754:#  label at a time -- each scored full marks against the control window.  The
755:#  de-escalation clause says a fatal->survive fix DELETES the accidental
756:#  tripwire that made such an edit self-announcing, so the detector must pin
757:#  the ACCEPT SIDE of every de-fatalised predicate.
758:#
759:#  The DMA window got the same fix and NO accept row.  A seat traced it: delete
760:#  `case 0x18:` and the DMA trigger silently dies forever, where BEFORE this
761:#  round that deletion was a loud exit on the first touch.  That is the clause's
762:#  own scenario, applied to one window and not the other.
763:#
764:#  *** A READ AT +0x18 IS SAFE, AND THE REASON IS NOT THE ONE THE FIRST
765:#  DRAFT OF THIS COMMENT GAVE. ***  It said 'the arm is guarded on idata',
766:#  which is true but stops one step short of the property that matters.
767:#
768:#  `case 0x18` arms on `if (idata != 0)` with NO write-direction test of its
769:#  own.  What makes a read safe is 140 lines above it: `idata` is declared
770:#  `= 0` and assigned ONLY under `if (writeflag == MEM_WRITE)`, so on a read
771:#  it keeps its initialiser and the arm cannot fire.  That is a real, local,
772:#  self-contained guarantee -- NOT an accident of memory_rw memsetting the
773:#  caller's buffer, which is what it would be if idata were loaded
774:#  unconditionally.
775:#
776:#  Written out because a pass-3 seat asked for an explicit write-direction
777:#  condition around the arming, not seeing that one already exists at that
778:#  distance.  A guard 140 lines from what it protects is correct and hard to
779:#  see, and this row depends on it.
780:t = ""
781:alive = True
782:for off in (0x04, 0x08, 0x0c, 0x14, 0x18):
783:    tt, aa, hh = session(pair(["r1=0x%x" % (DMA + off), "r2=0"], [MOV_L_AT_R1_R2]))
784:    t += tt
785:    alive = alive and aa
786:row("dma accept", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "0",
787:    "all five implemented DMA offsets stay off the default arm")
788:
789:#  ========================================================================
790:#  #462: the DMA+0x18 pair.  Both sites ENDED THE HOST PROCESS on the
791:#  committed build, each measured with its own device-signature control.
792:#
793:#  The design came out of a three-way disagreement that measurement settled:
794:#  two seats said de-fatalising would HANG Linux in its poll loop; one said
795:#  latch-and-break; the flagship seat read the driver and found BOTH
796:#  incomplete -- every wait in that path is time-bounded (HZ*7 after the
797:#  trigger, HZ/2 before it), so a decline gives bounded EIO rather than a
798:#  hang, BUT a bare `break` leaves the trigger value in the shadow.
799:DMA_ARM = re.compile(r"unsupported arming, declined")
800:DMA_NOD = re.compile(r"DMA start with no staged data -- declined")
801:
802:#  --- the ARMING-MISMATCH arm (on HEAD :845), armed wrongly
803:#  (count/enable not both 1 on a fresh device) ---
804:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1"],
805:                        [MOV_L_R8_AT_R7]) + ["print r8"])
806:row("arm survive", "survived" if alive else "died", "survived",
807:    "one store to +0x18 no longer ends the host")
808:row("arm says", ("%d" % len(DMA_ARM.findall(t))) if alive else "died", "1",
809:    "and the decline SPEAKS -- a silent decline is what this round argued against")
810:
811:#  *** THE ROW THAT MATTERS, and no panel seat named the defect it pins. ***
812:#
813:#  The window's tail store writes idata into dma_reg[6] after every aligned
814:#  break, and the SUCCESS arm sets `idata = 0` first -- which is why a
815:#  completed transfer polls idle.  Drop the exit(1) and simply break, the
816:#  shape #447/#459/#460/#461 all used at their sites, and the guest's
817:#  trigger value 1 reaches the shadow: +0x18 then reads BUSY FOREVER.
818:#
819:#  Linux survives that (bounded waits) -- and Linux is the guest this rests
820:#  on: mainline byte-reads +0x18 to poll completion.  *** THE NetBSD HALF OF
821:#  THIS COMMENT WAS WRONG AND IS CORRECTED HERE. ***  It cited
822:#  `while ((GDROM_BUSY & 0x88) != 0x08) ;` as an unbounded poll of +0x18.
823:#  That loop needs bit 3 SET and bit 7 CLEAR; +0x18 is {0, 1} and neither
824:#  ANDs to 0x08, so it would hang on CORRECT hardware.  It is the
825:#  command-start handshake on the CONTROL window's BUSY register, which
826:#  dev_dreamcast_gdrom.c's GDROM_COND case documents outright.  This row is
827:#  still the difference between the fix and the obvious fix.
828:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
829:                         "r1=0x%x" % (DMA + 0x18), "r2=0"],
830:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
831:row("arm idle", printed(t, "r2") if alive else "died", "0x0",
832:    "+0x18 reads IDLE after a declined trigger, not busy-forever")
833:
834:#  *** A CLAUSE (d) ESCAPE, NAMED BY A PACKET-FED SEAT ON THE PASS-2 BRIEF
835:#  AND CONFIRMED BY READING THIS FILE.  It keeps BOTH guards and BOTH
836:#  diagnostics and nulls only the repair:
837:#
838:#      if (d->dma_reg[0x0c / sizeof(uint32_t)] == 0 &&
839:#          d->dma_reg[0x14 / sizeof(uint32_t)] == 0)
840:#              idata = 0;
841:#
842:#  `arm idle` above writes ONLY +0x18, so on a fresh device count and enable
843:#  are both 0, that condition is TRUE, and the row stays green -- while every
844:#  OTHER arming mismatch sticks busy-forever.  The row written to pin the
845:#  repair could not see the repair being nulled, which is the same structural
846:#  blindness `dma alias` had against the one-character `m_align1`.
847:#
848:#  This row arms HALF way: count=1 with enable still 0.  That is a real guest
849:#  state -- a driver interrupted between its two arming stores -- and it makes
850:#  the mutant's condition FALSE.
851:#
852:#  NOTE the poison preset `r2=0x5a`, which the two older idle rows do not use.
853:#  They preset r2=0 and EXPECT 0x0, so a load that never executed would read
854:#  as a pass; their measured kills discharge that, but the shape is fragile.
855:#  0x5a is neither the expected 0x0 nor the sticky 0x1, so this row tells
856:#  green, sticky and never-ran apart BY VALUE.
857:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x0c), "r4=1",
858:                         "r7=0x%x" % (DMA + 0x18), "r8=1",
859:                         "r1=0x%x" % (DMA + 0x18), "r2=0x5a"],
860:                        [MOV_L_R4_AT_R3, MOV_L_R8_AT_R7, MOV_L_AT_R1_R2])
861:                   + ["print r2"])
862:row("arm halfarm", printed(t, "r2") if alive else "died", "0x0",
863:    "+0x18 idle after a HALF-armed decline (count=1, enable=0)")
864:
865:#  *** ONE SESSION THAT DRIVES BOTH DECLINE ARMS. ***  A seat predicted, before
866:#  the table ran, that a mutant collapsing the two arms onto a SHARED warn bit
867:#  would escape every row -- because no session anywhere reaches both arms, so
868:#  the first arm's latch silencing the second is unobservable.  This closes it:
869:#  a bare trigger takes the ARMING arm, then arming properly and triggering
870:#  again takes the NO-STAGED-DATA arm, and BOTH must speak.
871:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
872:                         "r3=0x%x" % (DMA + 0x0c), "r4=1",
873:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
874:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
875:                        [MOV_L_R8_AT_R7, MOV_L_R4_AT_R3, MOV_L_R6_AT_R5,
876:                         MOV_L_R2_AT_R1]))
877:row("both decl",
878:    ("%d" % (len(DMA_ARM.findall(t)) + len(DMA_NOD.findall(t)))) if alive else "died",
879:    "2", "BOTH decline arms in one session must EACH speak (separate latches)")
880:
881:#  the latch: a guest that retries must not flood
882:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
883:                         "r5=0x%x" % (DMA + 0x18), "r6=1"],
884:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5]) + ["print r8"])
885:row("arm once", ("%d" % len(DMA_ARM.findall(t))) if alive else "died", "1",
886:    "TWO triggers -> ONE line")
887:
888:#  --- the NO-STAGED-DATA arm (on HEAD :829).  NOTE the row name:
889:#  `nodata survive` was 14 characters, exactly
890:#  the %-14s column, leaving ZERO trailing spaces -- so the gate's `^$v  `
891:#  two-space match becomes UNSATISFIABLE and the row silently stops being
892:#  tested.  Caught by a name-length check before anything ran.  `nodata live`
893:#  is 11.
894:#  --- the NO-STAGED-DATA arm (on HEAD :829), armed correctly but
895:#  nothing staged.  A COMPLIANT guest reaches
896:#  this: Linux programs the four DMA registers BEFORE sending its packet, so
897:#  a short image or a refused sector count leaves d->data NULL and the guest,
898:#  told nothing it checks, triggers anyway.
899:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
900:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
901:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
902:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1]))
903:row("nodata live", "survived" if alive else "died", "survived",
904:    "arming with no staged data no longer ends the host")
905:row("nodata says", ("%d" % len(DMA_NOD.findall(t))) if alive else "died", "1",
906:    "and it names itself exactly once")
907:
908:#  *** THE DECLINED PATH MUST NOT ANNOUNCE A TRANSFER IT DOES NOT RUN. ***
909:#  Two seats found this independently from opposite directions: the
910:#  `Transfering %i bytes` fatal sits ABOVE the `d->data == NULL` test, so the
911:#  declined session printed "Transfering 0 bytes ..." and then "declined".  The
912:#  round's own comment claimed that line "prints data_len, the count actually
913:#  transferred" -- on this path nothing is transferred at all, so the claim was
914:#  false about the very path the round adds.  This row costs nothing: it reads
915:#  the transcript already in hand.
916:row("nodata notx", ("%d" % t.count("Transfering")) if alive else "died", "0",
917:    "a declined transfer must not ANNOUNCE itself as running")
918:
919:#  *** THE STRUCTURAL TWIN OF `arm idle`, AND TWO SEATS FOUND IT MISSING
920:#  INDEPENDENTLY. ***  Without it the `idata = 0` at the
921:#  NO-STAGED-DATA arm is UNPINNED, so the
922:#  smallest possible regression -- deleting one line -- passes green.  The
923:#  sibling site had its row from the start; this one did not, which is the
924:#  asymmetry a reader of the fix would never notice.
925:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
926:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
927:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
928:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1])
929:                   + ["r1=0x%x" % (DMA + 0x18), "r2=0"]
930:                   + run([MOV_L_AT_R1_R2], CODE + 0x200) + ["print r2"])
931:row("nodata idle", printed(t, "r2") if alive else "died", "0x0",
932:    "+0x18 reads IDLE after the no-data decline too")
933:
934:#  *** THE ROW THAT CLOSES THE ACTIVELY-HARMFUL MUTANT.  A seat measured that
935:#  firing SYSASIC_TRIGGER_EVENT on a declined path passes every other row here,
936:#  because nothing reads the pending register. ***
937:#
938:#  Why that mutant is worse than the defect this round fixes: the guest's
939:#  gdrom_dma_interrupt() clears gd.transfer UNCONDITIONALLY and inspects no
940:#  error bit, so a completion signalled on an EMPTY transfer ends the wait with
941:#  BLK_STS_OK -- the block layer is told the read succeeded while zero bytes
942:#  moved, and the guest consumes the destination page AS DISK DATA.  A host
943:#  death is loud; that is silent.
944:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
945:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
946:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
947:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1])
948:                   #  poison 0x4000, NOT 0 -- these two quiet rows expect "clear",
949:                   #  so with a 0 preset a load that never executed reads as a PASS
950:                   #  BY VALUE.  Their M8/M9 kills discharge vacuity today, but the
951:                   #  shape was fragile and it skipped this file's own 0x5a/0xa5
952:                   #  poison discipline.  Presetting the FAILURE-reading value makes
953:                   #  never-ran distinguishable at zero cost.
954:                   + ["r1=0x%x" % SYSASIC_PEND, "r2=0x4000"]
955:                   + run([MOV_L_AT_R1_R2], CODE + 0x200) + ["print r2"])
956:_p = printed(t, "r2") if alive else "died"
957:row("nodata quiet",
958:    ("clear" if (_p != "died" and not (int(_p, 16) & SYSASIC_DMA_BIT))
959:     else _p), "clear",
960:    "a DECLINED trigger must NOT signal completion")
961:
962:
963:#  *** THE ACCEPT BOUNDARY WAS ONLY EVER PROBED FROM THE NARROWING SIDE, and
964:#  THREE SEATS FOUND THAT INDEPENDENTLY on the ask-again. ***
965:#
966:#  The arming test is `count == 1 && enable == 1`.  M5 moved the boundary IN
967:#  (`== 2`) and the accept rows caught it.  Nothing moved it OUT.  Every row in
968:#  this file drives (count, enable) at (0,0), (1,0) or (1,1) -- and at all three
969:#  points `== 1` and `!= 0` agree, so widening to `count && enable`, `>= 1` or
970:#  bare truthiness is INDISTINGUISHABLE to the whole table.
971:#
972:#  `arm halfarm` is the row built to probe this predicate off its canonical
973:#  points, and it cannot see this: it half-arms by ZEROING a register, never by
974:#  EXCEEDING one, so at (1,0) both forms are false.  Same structural blindness
975:#  as `dma alias` against `m_align1`.
976:#
977:#  TWO rows, not one, because each comparison can be widened ALONE: a (2,1) row
978:#  is green under an enable-only widening.
979:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x0c), "r4=2",
980:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
981:                         "r7=0x%x" % (DMA + 0x18), "r8=1"],
982:                        [MOV_L_R4_AT_R3, MOV_L_R6_AT_R5, MOV_L_R8_AT_R7]))
983:row("arm count2",
984:    ("%d/%d" % (len(DMA_ARM.findall(t)), len(DMA_NOD.findall(t)))) if alive else "died",
985:    "1/0", "count=2 enable=1 must still be REFUSED, not widened into accept")
986:
987:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x0c), "r4=1",
988:                         "r5=0x%x" % (DMA + 0x14), "r6=2",
989:                         "r7=0x%x" % (DMA + 0x18), "r8=1"],
990:                        [MOV_L_R4_AT_R3, MOV_L_R6_AT_R5, MOV_L_R8_AT_R7]))
991:row("arm enable2",
992:    ("%d/%d" % (len(DMA_ARM.findall(t)), len(DMA_NOD.findall(t)))) if alive else "died",
993:    "1/0", "enable=2 count=1 must still be REFUSED -- each half widens alone")
994:
995:#  *** THE NO-DATA ARM'S LATCH-SCOPED TWIN, AND `arm twice` DOES NOT COVER IT. ***
996:#
997:#  A seat found this on the capped ask-again and named the gap exactly: "that is
998:#  the exact shape `arm twice` was written to close.  The row is arming-only.
999:#  There is no `nodata twice`."  It then sat UNREAD for hours, because its
1000:#  verdict line was recorded and the answer behind it was not opened.
1001:#
1002:#  The mutant, which reads as tidying rather than as a change:
1003:#
1004:#      if (!(d->warned & GDROM_W_DMANODATA)) {
1005:#              d->warned |= GDROM_W_DMANODATA;
1006:#              fatal("[ ... no staged data -- declined ... ] (once) ]");
1007:#              idata = 0;        /* moved INSIDE */
1008:#      }
1009:#      break;
1010:#
1011:#  The FIRST no-data trigger still prints and still clears, so every existing
1012:#  row stays green -- they all trigger that arm exactly once in a freshly forked
1013:#  emulator.  Every LATER trigger leaves the guest's value in dma_reg[6] and
1014:#  +0x18 reads BUSY FOREVER.  Under the corrected clause (d) -- which enumerates
1015:#  the predicates a fix DEPENDS ON, not only those it adds -- that is
1016:#  guard-kept-repair-nulled: an L2 floor breach, fixed in-round however late.
1017:#
1018:#  Poison 0xa5 again, so never-ran (0xa5) is distinguishable from sticky (0x1).
1019:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
1020:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
1021:                         "r1=0x%x" % (DMA + 0x18), "r2=1",
1022:                         "r3=0x%x" % (DMA + 0x18), "r4=1"],
1023:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1,
1024:                         MOV_L_R4_AT_R3])
1025:                   + ["r1=0x%x" % (DMA + 0x18), "r2=0xa5"]
1026:                   + run([MOV_L_AT_R1_R2], CODE + 0x220) + ["print r2"])
1027:row("nodata twice", printed(t, "r2") if alive else "died", "0x0",
1028:    "+0x18 idle after the SECOND no-data decline, not only the latched first")
1029:
1030:#  *** THE ARMING ARM'S OWN COMPLETION-EVENT ROW, and its absence was the
1031:#  round's one UNDISCHARGED OBLIGATION (L3).  `nodata quiet` above pins "a
1032:#  declined trigger must not signal completion" for ONE of the two declining
1033:#  arms.  The fix's own comment states that requirement as a design rule for
1034:#  BOTH.  Nothing carried it for the arming arm, so adding
1035:#  SYSASIC_TRIGGER_EVENT to that arm alone scored a clean sweep -- the round
1036:#  would have shipped its worst-case mutant half-closed.
1037:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
1038:                         "r1=0x%x" % SYSASIC_PEND, "r2=0x4000"],
1039:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
1040:_a = printed(t, "r2") if alive else "died"
1041:row("arm quiet",
1042:    ("clear" if (_a != "died" and not (int(_a, 16) & SYSASIC_DMA_BIT)) else _a),
1043:    "clear", "the ARMING decline must not signal completion either")
1044:
1045:#  *** THE LATCH-STATE MEMBER of the same family `arm halfarm` closes. ***  A
1046:#  seat pointed out that every idle row above triggers exactly ONCE in a
1047:#  freshly forked emulator, so moving `idata = 0` INSIDE the `if (!(d->warned
1048:#  & ...))` block passes all of them: the first and only observed decline still
1049:#  clears, and every later one sticks BUSY FOREVER.  `arm once` does trigger
1050:#  twice, but it counts diagnostics instead of reading +0x18.  This row reads
1051:#  +0x18 after the SECOND decline.
1052:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
1053:                         "r5=0x%x" % (DMA + 0x18), "r6=1",
1054:                         "r1=0x%x" % (DMA + 0x18), "r2=0x5a"],
1055:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_AT_R1_R2])
1056:                   + ["print r2"])
1057:row("arm twice", printed(t, "r2") if alive else "died", "0x0",
1058:    "+0x18 idle after the SECOND decline, not only the latched first")
1059:
1060:#  *** THE LENGTH BLIND SPOT.  No row anywhere wrote DMA +0x08, so any repair
1061:#  conditioned on the guest's programmed length -- `if (!length) idata = 0;` --
1062:#  cleared on every row here (length is 0 throughout) while sticking BUSY for a
1063:#  Linux-shaped guest, which programs +0x08 BEFORE it triggers.
1064:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x08), "r4=0x800",
1065:                         "r7=0x%x" % (DMA + 0x0c), "r8=1",
1066:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
1067:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
1068:                        [MOV_L_R4_AT_R3, MOV_L_R8_AT_R7, MOV_L_R6_AT_R5,
1069:                         MOV_L_R2_AT_R1])
1070:                   + ["r1=0x%x" % (DMA + 0x18), "r2=0x5a"]
1071:                   + run([MOV_L_AT_R1_R2], CODE + 0x200) + ["print r2"])
1072:row("nodata len", printed(t, "r2") if alive else "died", "0x0",
1073:    "+0x18 idle when a LENGTH was programmed first, as Linux does")
1074:
1075:#  *** THE WIDTH BLIND SPOT.  Every #462 store to +0x18 was 32-bit, so a repair
1076:#  conditioned on access width -- `if (len == 4) idata = 0;` -- passed the whole
1077:#  table.  This tree ALREADY established, in the `gdromdmawidth` assessment,
1078:#  that mainline Linux BYTE-writes this register, so that mutant is not
1079:#  hypothetical: it breaks the one guest whose behaviour the round documented.
1080:#
1081:#  *** AND THIS ROW ALSO CARRIES THE TRIGGER-VALUE CLOSE. ***  A seat observed
1082:#  that EVERY +0x18 trigger in every other row stores the value 1, so a repair
1083:#  written `idata &= ~1u;` or `idata -= 1;` -- both plausible as "clear the
1084:#  trigger bit" -- passed the whole table while any guest trigger >= 2 stuck.
1085:#  The arm fires on any nonzero and the diagnostic does not print the trigger,
1086:#  so triggering with 0x5a costs nothing and closes that family here.
1087:#
1088:#  NOTE the poison preset is 0xa5, NOT 0x5a as the other rows use.  The seat's
1089:#  suggestion was to trigger with 0x5a while keeping the 0x5a preset -- but then
1090:#  "the mutant left the trigger stuck" and "the load never executed" both read
1091:#  back 0x5a and the row could not tell them apart.  Trigger and poison must
1092:#  DIFFER, which is the same three-outcome discipline `accept data` uses.
1093:t, alive, how = session(pair(["r5=0x%x" % (DMA + 0x18), "r6=0x5a",
1094:                         "r1=0x%x" % (DMA + 0x18), "r2=0xa5"],
1095:                        [MOV_B_R6_AT_R5, MOV_L_AT_R1_R2]) + ["print r2"])
1096:row("arm bytetrig", printed(t, "r2") if alive else "died", "0x0",
1097:    "a BYTE trigger of 0x5a declines and clears -- not just a 32-bit 1")
1098:
1099:
1100:#  *** #490 L4 -- READ THIS BEFORE THE BLOCK BELOW.  EVERYTHING IN IT WAS TRUE WHEN
1101:#  #462 WROTE IT AND WAS EXPIRED BY #465 THREE ROUNDS LATER.  THE ROWS ARE SOUND; THEIR
1102:#  STATED WARRANT IS NOT, AND A KILL CLAIM RODE ON IT. ***
1103:#
1104:#  THE CHRONOLOGY, from git rather than memory:
1105:#      7c9dd9e (#462)  wrote this block and its three-state model
1106:#      4d05cf0 (#465)  "data and data_len were RELEASED APART" -- the fix for exactly
1107:#                      the hazard this block describes
1108:#
1109:#  Post-#465 `free_data()` sets BOTH `d->data = NULL` and `d->data_len = 0`, and it is
1110:#  `handle_command`'s prologue.  So:
1111:#    * the THIRD state below (`data == NULL, data_len STALE`) is NOT CONSTRUCTIBLE by
1112:#      this route -- the session builds the FIRST state, both fields agreeing at zero;
1113:#    * "handle_command ... NEVER resets d->data_len" is FALSE -- free_data resets it;
1114:#    * "leaving data_len at the TOC's 408" is FALSE -- the prologue already zeroed it;
1115:#    * and the M11 claim -- that swapping the guard to `d->data_len == 0` reaches
1116:#      `memory_rw(..., NULL, 408, ...)` -- IS REFUTED BY MEASUREMENT, not by argument.
1117:#
1118:#  MEASURED 2026-08-28 (artifacts/gdromexitsix/opus_r2table_20260828/): the M11 mutant
1119:#  built as a single line over the R2 fix, both trees run, results BYTE-IDENTICAL --
1120:#      fixed:  alive=True  stale_says=1  stale_idle=0x0  Transfering=0
1121:#      M11:    alive=True  stale_says=1  stale_idle=0x0  Transfering=0
1122:#  M11 is EQUIVALENT.  No row can kill it because there is nothing left to kill.
1123:#
1124:#  *** THE GENERAL LESSON, and it is the reason this is written out rather than deleted:
1125:#  A KILL RECORD IS TIME-INDEXED EXACTLY AS AN ABSENCE RECORD IS. ***  The carrier already
1126:#  says an absence record must name its warrant and that any edit touching that warrant
1127:#  RE-RUNS the death measurement.  The same holds for a claim that a mutant IS killed:
1128:#  #465 edited the warrant, and nothing re-ran the test for three rounds.  The block is
1129:#  kept because its REASONING is still the right reasoning -- it is the WORLD that moved.
1130:#
1131:#  What the rows below actually pin, stated correctly: the NO-DATA decline path, with
1132:#  both fields at zero.  That is real, reachable, and worth a row.  It is simply not the
1133:#  third state.
1134:#
1135:#  *** THE STATE THE FIX WAS WRITTEN FOR, AND UNTIL NOW NO ROW BUILT IT. ***
1136:#
1137:#  A seat observed that this detector sees `d->data` in TWO states and there are
1138:#  THREE:
1139:#      never-allocated      data == NULL, data_len == 0     <- every nodata row
1140:#      successfully-alloc   data != NULL, data_len == 408   <- the accept session
1141:#      FAILED COMMAND       data == NULL, data_len STALE    <- nothing, until now
1142:#
1143:#  The third is exactly what this round's own motivation describes: a command
1144:#  fails, `handle_command` frees `d->data` and leaves it NULL -- but NEVER resets
1145:#  `d->data_len`, which is assigned in `alloc_data` and nowhere else.
1146:#
1147:#  Why it matters beyond completeness: `if (d->data == NULL)` -> `if
1148:#  (d->data_len == 0)` reads as a tidy-up (the guard tests one field while the
1149:#  body it guards uses another) and scores a CLEAN SWEEP on the 52-row table,
1150:#  because in the only two states the table builds, both operands agree.  In the
1151:#  third state the mutated guard is FALSE and control reaches
1152:#  `memory_rw(..., d->data /* NULL */, d->data_len /* 408 */, ...)` -- a
1153:#  multi-kilobyte read from a NULL pointer.  The round's own defect class,
1154:#  restored through a different door.
1155:#
1156:#  CONSTRUCTION, and every constant is derived rather than guessed.  The data
1157:#  port fills the packet LOW BYTE FIRST (`cmd[n] = idata; cmd[n+1] = idata >> 8`),
1158:#  which is why the TOC staging writes 0x0014 to mean command 0x14.  So 0x2030
1159:#  gives cmd[0] = 0x30 (read sectors) and cmd[1] = 0x20 (the ONLY data format
1160:#  that does not itself exit).  cmd[8..10] stay zero, so sector_count is 0, and
1161:#  OB-20's clamp rejects and `break`s BEFORE `alloc_data` -- leaving data_len at
1162:#  the TOC's 408.
1163:t, alive, how = session(
1164:    ["r7=0x%x" % GDROM_CNTLO, "r8=0x98"] + run([MOV_W_R8_AT_R7])
1165:    + ["r7=0x%x" % GDROM_CNTHI, "r8=0x01"] + run([MOV_W_R8_AT_R7], CODE + 0x20)
1166:    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
1167:    + ["r7=0x%x" % GDROM_DATAP, "r8=0x0014"]
1168:    + run([MOV_W_R8_AT_R7] * 6, CODE + 0x60)
1169:    #  second command: 0x30 / format 0x20 / sector_count 0 -> OB-20 rejects
1170:    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x100)
1171:    + ["r7=0x%x" % GDROM_DATAP, "r8=0x2030"]
1172:    + run([MOV_W_R8_AT_R7], CODE + 0x120)
1173:    + ["r8=0x0000"] + run([MOV_W_R8_AT_R7] * 5, CODE + 0x140)
1174:    #  *** #490 L4: THIS SAID "data is NULL, data_len is STALE" AND THAT STATE HAS NOT
1175:    #  EXISTED SINCE #465. ***  handle_command's prologue is `free_data(d); /* #465 */`
1176:    #  and free_data sets BOTH `d->data = NULL` AND `d->data_len = 0`.  Before #465 the
1177:    #  prologue cleared only the POINTER, which is why the original evidence for this
1178:    #  row read `Transfering 408 bytes to 0x00000000` -- a pre-#465 artefact.
1179:    #  MEASURED, not argued: swapping the DMA arm's guard operand from `data == NULL`
1180:    #  to `data_len == 0` is BEHAVIOURALLY EQUIVALENT -- both trees return
1181:    #  `alive=True stale_says=1 stale_idle=0x0 Transfering=0`, byte for byte.
1182:    #  What the session actually builds is the NO-DATA state: both fields agree at
1183:    #  zero, and the DMA arm declines on that.  The row is sound; its description was
1184:    #  a wrong record.  (Found by the opus seat; the equivalence re-measured here
1185:    #  rather than inherited, because a KILL record is time-indexed exactly as an
1186:    #  absence record is -- #465 edited the warrant and nothing re-ran the test.)
1187:    #  arm correctly and trigger: data NULL and data_len 0 -- the no-data state
1188:    + ["r7=0x%x" % (DMA + 0x0c), "r8=1"] + run([MOV_L_R8_AT_R7], CODE + 0x1a0)
1189:    + ["r7=0x%x" % (DMA + 0x14), "r8=1"] + run([MOV_L_R8_AT_R7], CODE + 0x1c0)
1190:    + ["r7=0x%x" % (DMA + 0x18), "r8=1"] + run([MOV_L_R8_AT_R7], CODE + 0x1e0)
1191:    + ["r1=0x%x" % (DMA + 0x18), "r2=0xa5"]
1192:    + run([MOV_L_AT_R1_R2], CODE + 0x200) + ["print r2"])
1193:row("nodata stale", "survived" if alive else "died", "survived",
1194:    "FAILED-COMMAND state: data NULL, data_len 0 -- the fix's own path")
1195:row("stale says", ("%d" % len(DMA_NOD.findall(t))) if alive else "died", "1",
1196:    "and it declines by the NO-DATA arm, exactly once")
1197:row("stale idle", printed(t, "r2") if alive else "died", "0x0",
1198:    "+0x18 idle after the stale-length decline (0xa5 = the load never ran)")
1199:
1200:#  *** #490: `stale quiet` RESTORES WHAT THE SIBLING FIX BLINDED, AND THE LOSS WAS MEASURED
1201:#  BEFORE THE FIX LANDED RATHER THAN INFERRED AFTER. ***
1202:#
1203:#  The three rows above detect a mis-assembled packet only by the HOST DYING: each reads
1204:#  `... if alive else "died"`.  Frozen and measured on the committed build, a packet with
1205:#  cmd[0]=0x31 or cmd[1]=0x21 scored **55/58, CAUGHT** -- all three red, all via `died`.
1206:#
1207:#  #490 de-fatalised both of those sites.  Re-measured against the post-fix binary with the
1208:#  SAME two packets: **58/58 BOTH TIMES** -- the triple reverts and this probe reads exactly   [58-row denominator, as measured then]
1209:#  what a CORRECT packet reads.  Not merely vacuous: ACTIVELY MISLEADING, because a future
1210:#  maintainer whose packet rots gets a clean run.
1211:#      artifacts/gdromexitsix/challenge_freeze_20260828/  (pre-fix, 55/58 twice)
1212:#      artifacts/gdromexitsix/blinding_20260828/          (post-fix, 58/58 twice)   [58-row denominator, as measured then]
1213:#
1214:#  *** THOSE ARE 58-row FIGURES AND STAY THAT WAY. ***  They are what the probe
1215:#  measured when it had 58 rows; the gate pin is authoritative for TODAY's
1216:#  denominator, and restating a past measurement in a later denominator is exactly
1217:#  the frozen-number defect this project keeps correcting.  A score names the
1218:#  artifact that produced it, and these two name theirs.
1219:#
1220:#  This row reads the DECLINE TEXT instead, on the session that is supposed to send a
1221:#  CORRECT packet.  A mis-assembled one now reddens it whether or not the host survives.
1222:#  kills: a rotted test packet, and a deleted `case 0x30` (which would decline at default:)
1223:#  via:   the two anchored decline regexes, which cannot fire on a correct packet
1224:row("stale quiet", "%d" % (len(FMT_DECL.findall(t)) + len(CMD_DECL.findall(t))), "0",
1225:    "the packet is well-formed -- NEITHER new site declines it")
1226:
1227:#  *** #490: THE DEATH-MODE ORACLE.  `how` has been threaded through 37 call sites since
1228:#  ea97a10 and UNTIL NOW NO ROW READ IT -- that commit said so in its own message and the
1229:#  plumbing stayed inert. ***  `alive` is False only when a read fails INSIDE a budget
1230:#  window, so it is true of a HUNG emulator, a FROZEN one, and -- measured -- one already
1231:#  killed after the last budget check.  `how` is the exit status and cannot be fooled that
1232:#  way.
1233:#  *** THE kills: LINE HERE READ "floor clause (b) -- reinstating either exit(1) at the
1234:#  sibling sites", AND THAT IS FALSE.  Caught by a pass-2 seat, 2026-08-29. ***  This
1235:#  session sends a CORRECT packet, which reaches NEITHER de-fatalised site -- so under a
1236:#  reinstated exit(1) at either one the session never gets there, exits 0, and this row
1237:#  stays GREEN.  Its named channel cannot vary under its named mutant, which is exactly
1238:#  what the CHANNEL check calls vacuous BY CONSTRUCTION.  The claim was true only JOINTLY
1239:#  with packet rot, and `stale quiet` is the row that carries rot.
1240:#
1241:#  kills: a death the budget-window read pattern CANNOT SEE -- any build that exits after
1242:#         the last budget check, which `alive` reports as True.  That is a real and
1243:#         otherwise-unpinned channel: `how` had been threaded through 37 call sites since
1244:#         ea97a10 with NO row reading it.
1245:#  via:   the exit status, which `alive` structurally cannot see
1246:#
1247:#  *** THIS BLOCK PREDICTED "one rot-packet run reds `stale quiet` AND DISCHARGES BOTH".
1248:#  THE RUN HAPPENED AND REFUTED THE SECOND HALF.  Corrected 2026-08-29. ***
1249:#
1250:#  `regress/artifacts/gdromexitsix/rot_20260829/`, post-fix binary, one-line frozen-probe
1251:#  edit (packed format byte 0x20 -> 0x21):
1252:#
1253:#      base.log   GDROM_DEF_RESULT=60/60    stale quiet  0 vs 0      ok
1254:#      rot.log    GDROM_DEF_RESULT=59/60    stale quiet  1 vs 0    **FAIL**
1255:#
1256:#  The two `GDROM_DEF_VECTOR` lines differ in EXACTLY ONE POSITION, so the rot is
1257:#  discriminating rather than merely disruptive -- proven by the probe's own vector, not
1258:#  asserted.  **`stale quiet` is DISCHARGED by a measured kill.**
1259:#
1260:#  *** `stale how` IS NOT, AND THE REASON IS STRUCTURAL RATHER THAN AN OVERSIGHT. ***  It
1261:#  stayed `exit0` under the rot because the fix DECLINES the bad format instead of dying, so
1262:#  the session still ends cleanly.  A rotted packet cannot red this row at all.
1263:#
1264:#  AND IT IS THE WANTED-EQUALS-FAILURE SHAPE, which the round's own PRETABLE addendum names:
1265:#  **this row WANTS `exit0`, and a BROKEN `how` capture also yields `exit0`.**  So a measured
1266:#  red is not a nicety here -- it is the only thing that distinguishes a working oracle from
1267:#  an inert one.  Killing it needs a mutant that makes the build EXIT AFTER the last budget
1268:#  check; the reinstated-`exit(1)` binaries in the pass-2 ask-again's bins are the obvious
1269:#  candidate, driven through the preserved rot instrument.
1270:#
1271:#  **UNTIL THAT IS MEASURED, TREAT THIS ROW AS UNPROVEN.**  Owed before the round closes.
1272:row("stale how", how, "exit0",
1273:    "and the session ended CLEANLY -- not merely answering when last asked")
1274:
1275:#  *** THE DE-ESCALATION ACCEPT ROW.  The fix removed TWO host-fatal
1276:#  predicates -- `d->data == NULL` and `count == 1 && enable == 1` -- and
1277:#  the clause says the detector must pin the ACCEPT SIDE of each, or the
1278:#  round has deleted a tripwire and shipped nothing in its place.
1279:#
1280:#  Before this fix, narrowing either predicate meant exit(1) on the first
1281:#  legal transfer: unmissable.  After it, the same edit means a SILENTLY
1282:#  REFUSED transfer and nothing anywhere notices.
1283:#
1284:#  *** ONE STAGING SESSION, FIVE ROWS -- and the sharing is the point, not the
1285:#  saving. ***  These rows used to stage independently, which cost five full TOC
1286:#  sequences and, worse, meant they observed five SIMILAR transfers.  Driven from
1287:#  one session they observe THE SAME transfer, so "the arming was accepted",
1288:#  "+0x18 polls idle", "no decline fired", "the event fired" and "the bytes
1289:#  landed" are five facts about ONE event.
1290:#
1291:#  A row set describing one transfer can contradict itself and be caught.  Five
1292:#  separate transfers can each be individually consistent and jointly wrong.
1293:#
1294:#  Staging is #460's sequence verbatim: CNTLO=0x98, CNTHI=0x01, COND=0xa0, then
1295:#  six halfword stores of 0x0014 into the data port.  The TOC command allocates
1296:#  d->data and fills it with DEVICE-GENERATED bytes (dev_dreamcast_gdrom.c:352-357
1297:#  writes 0x10,0x00,0x00,0x96 over a 0xff background).
1298:#
1299:#  *** THAT PATTERN IS THE DEVICE-SIGNATURE CONTROL, AND UNTIL `accept data` IT
1300:#  WAS CLAIMED AND NOT IMPLEMENTED. ***  The older wording here asserted "RAM
1301:#  could not produce that pattern" while NO row read the destination at all --
1302:#  a control named in prose and absent in fact, which is the shape this file
1303:#  exists to catch.  `accept data` below reads it back.
1304:#
1305:#  *** AND `accept idle` IS NOT AN ACCEPT ROW.  FOUR SEATS SAID SO INDEPENDENTLY.
1306:#  ***  It cannot redden under growth of EITHER de-fatalised predicate, because
1307:#  all three arms -- success, no-data and arming-mismatch -- clear `idata`.  Its
1308:#  own note admits it: "as the success arm has always done".  It is a LIVE row
1309:#  (deleting the success arm's `idata = 0` kills it) but it is a REGRESSION row
1310:#  for pre-existing success-arm behaviour, not an accept-side row, and counting
1311:#  it toward the de-escalation obligation was a wrong record.
1312:#
1313:#  The obligation is discharged by `accept dma`, `accept event`, `accept quiet`
1314:#  and `accept data`.
1315:t, alive, how = session(
1316:    ["r7=0x%x" % GDROM_CNTLO, "r8=0x98"] + run([MOV_W_R8_AT_R7])
1317:    + ["r7=0x%x" % GDROM_CNTHI, "r8=0x01"] + run([MOV_W_R8_AT_R7], CODE + 0x20)
1318:    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
1319:    + ["r7=0x%x" % GDROM_DATAP, "r8=0x0014"]
1320:    + run([MOV_W_R8_AT_R7] * 6, CODE + 0x60)
1321:    #  arm correctly and trigger: the path that must still work
1322:    + ["r7=0x%x" % (DMA + 0x04), "r8=0x0c008000"]
1323:    + run([MOV_L_R8_AT_R7], CODE + 0x100)
1324:    + ["r7=0x%x" % (DMA + 0x0c), "r8=1"]
1325:    + run([MOV_L_R8_AT_R7], CODE + 0x120)
1326:    + ["r7=0x%x" % (DMA + 0x14), "r8=1"]
1327:    + run([MOV_L_R8_AT_R7], CODE + 0x140)
1328:    + ["r7=0x%x" % (DMA + 0x18), "r8=1"]
1329:    + run([MOV_L_R8_AT_R7], CODE + 0x160)
1330:    #  and read BOTH observables from that one transfer
1331:    + ["r1=0x%x" % (DMA + 0x18), "r2=0"]
1332:    + run([MOV_L_AT_R1_R2], CODE + 0x180)
1333:    + ["r1=0x%x" % SYSASIC_PEND, "r3=0"]
1334:    + run([MOV_L_AT_R1_R3], CODE + 0x1a0)
1335:    #  *** AND READ THE DESTINATION.  Until this row, NO row anywhere observed
1336:    #  the DMA's data movement, so mutants that neutered the transfer itself --
1337:    #  `d->data_len` -> 0, or a different `dst` mask -- left every row green
1338:    #  while moving nothing.  The comment above ALSO claimed a device-signature
1339:    #  control that nothing implemented; this is that control.
1340:    #
1341:    #  handle_command's TOC arm fills d->data[0..3] with 0x10,0x00,0x00,0x96
1342:    #  over a 0xff background (dev_dreamcast_gdrom.c:352-357) and the DMA is a
1343:    #  byte copy, so dst+0 is 0x10 whatever the byte order -- a BYTE load needs
1344:    #  no endianness assumption, which a word load here would.
1345:    #
1346:    #  Three outcomes are distinguishable, which is the point:
1347:    #      0x10        the transfer ran and moved DEVICE-generated bytes
1348:    #      0xffffffea  it did NOT run -- see below
1349:    #      0x5a        the load itself never executed (the poison preset)
1350:    #
1351:    #  *** THE MIDDLE LINE SAID `0x0  it never ran (the destination page is
1352:    #  zero beforehand)` AND THE MUTANT TABLE MEASURED THAT FALSE. ***  Under
1353:    #  M5 (`count == 1` -> `count == 2`, so a legal transfer is refused) this
1354:    #  row read back 0xffffffea, not 0x0.  Two facts the original wording got
1355:    #  wrong, and only a mutant that stops the transfer could expose either:
1356:    #
1357:    #    * the destination page is NOT zero beforehand.  DMA_DST_P1 is
1358:    #      0x8c008000, 28 KB past CODE, and the session runs with a real
1359:    #      kernel image loaded -- so the byte already there is 0xea.
1360:    #    * `mov.b` SIGN-EXTENDS.  0xea has bit 7 set, so it arrives as
1361:    #      0xffffffea.  0x10 does not, which is why the ran-case is clean.
1362:    #
1363:    #  The row still discriminates -- 0x10, 0xffffffea and 0x5a are three
1364:    #  distinct values -- so the ROW is sound and only its stated REASON was
1365:    #  wrong.  That is worth separating: a green row with a false explanation
1366:    #  is a wrong record, not a vacuous row, and the fix is the comment.
1367:    #
1368:    #  Do NOT re-pin this row on 0xffffffea: that value is whatever the loaded
1369:    #  image happens to put at that address, so it is an artefact of the
1370:    #  KERNEL argument and not a property of the device.  The row asserts
1371:    #  0x10 -- the device's own TOC byte -- and everything else is a failure.
1372:    + ["r1=0x%x" % DMA_DST_P1, "r4=0x5a"]
1373:    + run([MOV_B_AT_R1_R4], CODE + 0x1c0)
1374:    + ["print r2", "print r3", "print r4"])
1375:
1376:#  NOTE the wording.  This row was recorded as proving "a LEGAL armed transfer
1377:#  with staged data still runs"; it proves the ARMING TEST passed and nothing
1378:#  more, because the `Transfering` fatal printed BEFORE the `d->data == NULL`
1379:#  check.  `accept data` below is the row that proves the transfer ran.
1380:row("accept dma", "yes" if ("Transfering" in t and alive) else "no", "yes",
1381:    "a LEGAL arming is still accepted and enters the transfer path")
1382:#  NOT an accept row -- see the block above.  Kept because it is live.
1383:row("accept idle", printed(t, "r2") if alive else "died", "0x0",
1384:    "+0x18 polls IDLE after a real transfer (success-arm regression row)")
1385:_q = printed(t, "r3") if alive else "died"
1386:row("accept event",
1387:    ("set" if (_q != "died" and (int(_q, 16) & SYSASIC_DMA_BIT)) else _q),
1388:    "set", "a REAL transfer DOES signal completion")
1389:row("accept quiet",
1390:    ("%d" % (len(DMA_ARM.findall(t)) + len(DMA_NOD.findall(t)))) if alive else "died",
1391:    "0", "with NEITHER decline diagnostic -- the accept side is not refused")
1392:row("accept data", printed(t, "r4") if alive else "died", "0x10",
1393:    "and the DEVICE's own TOC byte actually LANDED at the destination")
1394:
1395:
1396:n = sum(1 for _, ok in rows if ok)
1397:print("GDROM_DEF_RESULT=%d/%d" % (n, len(rows)))
1398:print("GDROM_DEF_VECTOR=" + ",".join(("1" if ok else "0") for _, ok in rows))

