1:#!/bin/bash
2:# GATE 14 -- ARM subtract-family carry flags (#311) and undefined routing (#312).
3:#
4:# What this protects
5:# -----------------
6:# #311: the subtract family computed its carry-out as `a >= b`. That is
7:# NOT-BORROW for SUB/CMP/RSB, which have no borrow-in, and WRONG for SBC/RSC,
8:# whose result is `a - b - NOT(C)`. The two disagree exactly when `a == b` with
9:# carry-in clear: `a - a - 1` borrows, so carry must be CLEAR, and `a >= b`
10:# reported it SET. The fix takes the flag from the full 64-bit result the file
11:# already computes (`c32 == c64`), which is the same answer as `a >= b` for the
12:# three instructions that were already right.
13:#
14:# #312: ARM's permanently-undefined encodings reached `goto bad`, which sets
15:# cpu->running = 0 (cpu_dyntrans.c) -- a legal-to-attempt instruction stopping
16:# the whole emulator, the same halt class as #264/#309/#310. They now raise the
17:# Undefined Instruction exception the silicon raises.
18:#
19:# This gate is known to be able to FAIL
20:# ------------------------------------
21:# It was run against the committed pre-fix build and scored 39 of the 56 rows it
22:# had at that moment, failing in exactly the 17 places the three fixes were
23:# predicted to flip and nowhere else. The two `subs rn=pc` pins were added after
24:# that sweep and pass either way, so the same build on today's table would read
25:# 41/58 -- stated exactly rather than restated as 39/58, because the count is
26:# evidence and evidence does not get rounded to the number that sounds better.
27:# That measurement is what shows these rows discriminate; gate 3's mutant
28:# machinery does not reach here, because it operates on float_emul.c and this
29:# gate measures the real emulator instead of a pure function.
30:#
31:# Swept again for #346 against a binary built from the parent commit: 162 of
32:# 165, failing the three cache-clean rows the fix flips and nowhere else. The
33:# two cache-clean CONTROL rows pass on both builds, which is what they are for.
34:#
35:# And again for #347 against a binary built from ITS parent (be6ea08): 168 of
36:# 173, failing exactly the five `A cclean2 ... ` discriminators and nowhere
37:# else. All three of that round's control/anti-clobber pins pass on both builds.
38:#
39:# And for round 99 (#348/#349/#350) against a binary built from the pre-fix
40:# HEAD (dea2fef): 181 of 190, failing exactly the NINE new DISC rows -- the
41:# two flags rows, the tail/zero/tail-V flag rows, the two fires rows,
42:# `A cacheclean nonmult` reading "fold", and `A cacheclean zero n` reading
43:# "none" -- and nowhere else. On the fixed build: 190/190. The retired
44:# `A cclean2 still fold` control asserted the MISSING flags and was replaced
45:# in the same change by the #349 marker rows, exactly as its own comment
46:# required. The nonmult witness's first draft is itself a recorded lesson:
47:# it expected a data abort at the top of RAM (measured false -- non-existent
48:# reads log and continue) and compared a dump string unswapped, so it read
49:# its own sentinel's parity; see run_cc_nonmult's docstring. Its "live"
50:# verdict was then tightened in review to also demand load progress (r0
51:# moved off 0x9120), closing a false pass against a guard that returns
52:# without calling the load.
53:#
54:# Why most of this gate is PINs
55:# ----------------------------
56:# #311 rewrites ONE line that five instructions share, and two of them were
57:# already correct. The pins are the point: they assert that SUB, RSB and CMP --
58:# and the ADD/ADC arm of the same #if, which keeps its own `c32 != c64` test --
59:# were not disturbed. A gate for this fix that checked only SBC and RSC would
60:# not detect the regression that matters most.
61:#
62:# The decode-time row
63:# ------------------
64:# `udf cond-failed nop` is the strongest reachability statement here: a
65:# conditional UDF whose condition is FALSE also stopped the committed
66:# emulator, because `goto bad` fires during DECODE, before any condition is
67:# evaluated. The guest never had to execute the instruction at all. That row
68:# asserts execution continued AND no exception was raised as a SINGLE value,
69:# because checking "no exception" alone would score a point on a build that
70:# halted before reaching anything.
71:set -u
72:cd "$(dirname "$0")"
73:. ./lib.sh
74:
75:gate_begin "gate 14: ARM/Thumb flags (#311/#312/#319-#322/#328/#329)"
76:
77:PMAX=${PMAX:-$ROOT/build/gxemul}
78:LOG=$LOGDIR/gate_arm.log
79:STUB=$LOGDIR/arm_stub.bin
80:
81:need_exec "$PMAX"
82:command -v python3 >/dev/null || gate_skip "python3 not available"
83:
84:# `testarm` prints usage and exits without a file argument, so a four-byte raw
85:# stub is loaded purely to make the machine construct. Every row overwrites it
86:# before anything executes; it is scaffolding, not code under test.
87:python3 -c "
88:import struct, sys
89:open(sys.argv[1], 'wb').write(struct.pack('<I', 0xe1a00000))
90:" "$STUB" || gate_skip "could not write the load stub"
91:
92:note "binary : $PMAX"
93:note "machine: testarm/SA1110, cold debugger, RAM at 0"
94:note "little-endian; every word read is byte-swapped back by the probe"
95:note "flags read by the guest's own mrs r3,cpsr -- not a debugger register print"
96:
97:python3 arm_flags_probe.py "$PMAX" "$STUB" > "$LOG" 2>&1 || true
98:
99:if ! grep -q "ARM_FLAGS_RESULT=" "$LOG"; then
100:    note "probe produced no result line; last lines follow"
101:    tail -5 "$LOG" | sed 's/^/       /'
102:    gate_skip "probe did not complete"
103:fi
104:
105:grep -E " ok$| FAIL$" "$LOG" | sed 's/^/       /'
106:
107:# A probe whose control row failed has measured NOTHING and no other row may be
108:# believed. This harness has been bitten by a probe that reported a defect off
109:# sentinel reads while its guest code had never run.
110:ctrl=$(grep -o "ARM_FLAGS_CONTROL=[A-Z]*" "$LOG" | tail -1 | cut -d= -f2)
111:check "control row proves the probe measures" "${ctrl:-missing}" "OK"
112:
113:res=$(grep -o "ARM_FLAGS_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
114:got=${res%/*}; want=${res#*/}
115:check "rows run"     "$want" 190
116:check "rows correct" "$got"  "$want"
117:
118:# Both classes must stay populated: a gate that is all pins cannot detect a
119:# reverted fix, and one with no pins cannot detect collateral damage. The
120:# floors track the deltas each round adds; a review seat noted they are far
121:# below the actuals (112/78 after round 99) and so guard only against mass
122:# reclassification, with `rows run` guarding deletion.
123:disc=$(grep -c " DISC " "$LOG")
124:pins=$(grep -c " PIN " "$LOG")
125:check_min "discriminating rows present" "$disc" 58
126:check_min "pinned rows present"         "$pins" 66
127:
128:# Named rows, one contract each, so a single site reverting cannot hide behind
129:# a total. Two spaces after the name: the probe pads names to a fixed column,
130:# and a name that is a PREFIX of another would otherwise match both rows (the
131:# trap that made three of gate 13's checks count the wrong rows).
132:#
133:# The SBC/RSC discriminators -- three different equal-operand values, because a
134:# fix that special-cased one constant would pass a single row.
135:# #340: the combiner rows. The two "combined" rows carry the defect; the two
136:# "standalone" rows are the control that attributes it to the COMBINER rather
137:# than to the instruction -- same encoding, same operands, no following branch;
138:# and "flat C preserved" catches a fix that starts clobbering C on an
139:# unrotated immediate, where the ISA preserves it. Named individually so one
140:# reverting site cannot hide behind the total.
141:for v in "A teq rot C combined" "A tst rot C combined" \
142:         "A teq rot C standalone" "A tst rot C standalone" \
143:         "A teq flat C preserved"; do
144:    n=$(count "$LOG" "^$v  .*ok$")
145:    check "  row: $v" "$n" 1
146:done
147:
148:# #342: the XOR-swap fold. The DISC row is its own proof that the fold
149:# happened -- three standalone `eor rX,rX,rX` cannot leave a nonzero value, so
150:# only X(xchg) could have produced the 0x5a the committed build returned.
151:#
152:# The swap rows are PINs in the shape the matcher actually accepts, Rm == Rd
153:# (`eor X,Y,X`). The first version of them used Rn == Rd and so never matched
154:# the combiner at all -- it was measuring three standalone EORs while claiming
155:# to exercise the fold, which a review seat caught. They now run the FOLDED
156:# handler on pass 2 and pin that its swap is correct, so a broken X(xchg) fails
157:# here; they still cannot distinguish folded-and-correct from
158:# not-folded-and-correct, which is why they are pins and not discriminators.
159:for v in "A xchg same-reg zeroes" "A xchg same-reg r1 pin" \
160:         "A xchg swap r0" "A xchg swap r1"; do
161:    n=$(count "$LOG" "^$v  .*ok$")
162:    check "  row: $v" "$n" 1
163:done
