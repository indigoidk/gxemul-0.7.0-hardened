regress/gdrom_default_probe.py:1062:#  cleared on every row here (length is 0 throughout) while sticking BUSY for a
regress/gdrom_default_probe.py:1063:#  Linux-shaped guest, which programs +0x08 BEFORE it triggers.
regress/gdrom_default_probe.py:1064:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x08), "r4=0x800",
regress/gdrom_default_probe.py:1065:                         "r7=0x%x" % (DMA + 0x0c), "r8=1",
regress/gdrom_default_probe.py:1066:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:1067:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
regress/gdrom_default_probe.py:1068:                        [MOV_L_R4_AT_R3, MOV_L_R8_AT_R7, MOV_L_R6_AT_R5,
regress/gdrom_default_probe.py:1069:                         MOV_L_R2_AT_R1])
