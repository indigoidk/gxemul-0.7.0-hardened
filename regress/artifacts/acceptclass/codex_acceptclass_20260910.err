regress/gate_arm.sh:41:# two flags rows, the tail/zero/tail-V flag rows, the two fires rows,
regress/gate_arm.sh:42:# `A cacheclean nonmult` reading "fold", and `A cacheclean zero n` reading
regress/gate_arm.sh:43:# "none" -- and nowhere else. On the fixed build: 190/190. The retired
regress/gate_arm.sh:44:# `A cclean2 still fold` control asserted the MISSING flags and was replaced
regress/gate_arm.sh:45:# in the same change by the #349 marker rows, exactly as its own comment
regress/gate_arm.sh:46:# required. The nonmult witness's first draft is itself a recorded lesson:
regress/gate_arm.sh:47:# it expected a data abort at the top of RAM (measured false -- non-existent
regress/gate_arm.sh:48:# reads log and continue) and compared a dump string unswapped, so it read
regress/gate_arm.sh:49:# its own sentinel's parity; see run_cc_nonmult's docstring. Its "live"
regress/gate_arm.sh:50:# verdict was then tightened in review to also demand load progress (r0
regress/gate_arm.sh:51:# moved off 0x9120), closing a false pass against a guard that returns
regress/gate_arm.sh:52:# without calling the load.
regress/gate_arm.sh:53:#
regress/gate_arm.sh:54:# Why most of this gate is PINs
regress/gate_arm.sh:55:# ----------------------------
regress/gate_arm.sh:56:# #311 rewrites ONE line that five instructions share, and two of them were
regress/gate_arm.sh:57:# already correct. The pins are the point: they assert that SUB, RSB and CMP --
regress/gate_arm.sh:58:# and the ADD/ADC arm of the same #if, which keeps its own `c32 != c64` test --
regress/gate_arm.sh:59:# were not disturbed. A gate for this fix that checked only SBC and RSC would
regress/gate_arm.sh:60:# not detect the regression that matters most.
regress/gate_arm.sh:61:#
regress/gate_arm.sh:62:# The decode-time row
regress/gate_arm.sh:63:# ------------------
regress/gate_arm.sh:64:# `udf cond-failed nop` is the strongest reachability statement here: a
regress/gate_arm.sh:65:# conditional UDF whose condition is FALSE also stopped the committed
regress/gate_arm.sh:66:# emulator, because `goto bad` fires during DECODE, before any condition is
regress/gate_arm.sh:67:# evaluated. The guest never had to execute the instruction at all. That row
regress/gate_arm.sh:68:# asserts execution continued AND no exception was raised as a SINGLE value,
regress/gate_arm.sh:69:# because checking "no exception" alone would score a point on a build that
regress/gate_arm.sh:70:# halted before reaching anything.
regress/gate_arm.sh:71:set -u
regress/gate_arm.sh:72:cd "$(dirname "$0")"
regress/gate_arm.sh:73:. ./lib.sh
regress/gate_arm.sh:74:
regress/gate_arm.sh:75:gate_begin "gate 14: ARM/Thumb flags (#311/#312/#319-#322/#328/#329)"
regress/gate_arm.sh:76:
regress/gate_arm.sh:77:PMAX=${PMAX:-$ROOT/build/gxemul}
regress/gate_arm.sh:78:LOG=$LOGDIR/gate_arm.log
regress/gate_arm.sh:79:STUB=$LOGDIR/arm_stub.bin
regress/gate_arm.sh:80:
regress/gate_arm.sh:81:need_exec "$PMAX"
regress/gate_arm.sh:82:command -v python3 >/dev/null || gate_skip "python3 not available"
regress/gate_arm.sh:83:
regress/gate_arm.sh:84:# `testarm` prints usage and exits without a file argument, so a four-byte raw
regress/gate_arm.sh:85:# stub is loaded purely to make the machine construct. Every row overwrites it
regress/gate_arm.sh:86:# before anything executes; it is scaffolding, not code under test.
regress/gate_arm.sh:87:python3 -c "
regress/gate_arm.sh:88:import struct, sys
regress/gate_arm.sh:89:open(sys.argv[1], 'wb').write(struct.pack('<I', 0xe1a00000))
regress/gate_arm.sh:90:" "$STUB" || gate_skip "could not write the load stub"
regress/gate_arm.sh:91:
regress/gate_arm.sh:92:note "binary : $PMAX"
regress/gate_arm.sh:93:note "machine: testarm/SA1110, cold debugger, RAM at 0"
regress/gate_arm.sh:94:note "little-endian; every word read is byte-swapped back by the probe"
regress/gate_arm.sh:95:note "flags read by the guest's own mrs r3,cpsr -- not a debugger register print"
regress/gate_arm.sh:96:
regress/gate_arm.sh:97:python3 arm_flags_probe.py "$PMAX" "$STUB" > "$LOG" 2>&1 || true
regress/gate_arm.sh:98:
regress/gate_arm.sh:99:if ! grep -q "ARM_FLAGS_RESULT=" "$LOG"; then
regress/gate_arm.sh:100:    note "probe produced no result line; last lines follow"
regress/gate_arm.sh:101:    tail -5 "$LOG" | sed 's/^/       /'
regress/gate_arm.sh:102:    gate_skip "probe did not complete"
regress/gate_arm.sh:103:fi
regress/gate_arm.sh:104:
regress/gate_arm.sh:105:grep -E " ok$| FAIL$" "$LOG" | sed 's/^/       /'
regress/gate_arm.sh:106:
regress/gate_arm.sh:107:# A probe whose control row failed has measured NOTHING and no other row may be
regress/gate_arm.sh:108:# believed. This harness has been bitten by a probe that reported a defect off
regress/gate_arm.sh:109:# sentinel reads while its guest code had never run.
regress/gate_arm.sh:110:ctrl=$(grep -o "ARM_FLAGS_CONTROL=[A-Z]*" "$LOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:111:check "control row proves the probe measures" "${ctrl:-missing}" "OK"
regress/gate_arm.sh:112:
regress/gate_arm.sh:113:res=$(grep -o "ARM_FLAGS_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:114:got=${res%/*}; want=${res#*/}
regress/gate_arm.sh:115:check "rows run"     "$want" 190
regress/gate_arm.sh:116:check "rows correct" "$got"  "$want"
regress/gate_arm.sh:117:
regress/gate_arm.sh:118:# Both classes must stay populated: a gate that is all pins cannot detect a
regress/gate_arm.sh:119:# reverted fix, and one with no pins cannot detect collateral damage. The
regress/gate_arm.sh:120:# floors track the deltas each round adds; a review seat noted they are far
regress/gate_arm.sh:121:# below the actuals (112/78 after round 99) and so guard only against mass
regress/gate_arm.sh:122:# reclassification, with `rows run` guarding deletion.
regress/gate_arm.sh:123:disc=$(grep -c " DISC " "$LOG")
regress/gate_arm.sh:124:pins=$(grep -c " PIN " "$LOG")
regress/gate_arm.sh:125:check_min "discriminating rows present" "$disc" 58
regress/gate_arm.sh:126:check_min "pinned rows present"         "$pins" 66
regress/gate_arm.sh:127:
regress/gate_arm.sh:128:# Named rows, one contract each, so a single site reverting cannot hide behind
regress/gate_arm.sh:129:# a total. Two spaces after the name: the probe pads names to a fixed column,
regress/gate_arm.sh:130:# and a name that is a PREFIX of another would otherwise match both rows (the
regress/gate_arm.sh:131:# trap that made three of gate 13's checks count the wrong rows).
regress/gate_arm.sh:132:#
regress/gate_arm.sh:133:# The SBC/RSC discriminators -- three different equal-operand values, because a
regress/gate_arm.sh:134:# fix that special-cased one constant would pass a single row.
regress/gate_arm.sh:135:# #340: the combiner rows. The two "combined" rows carry the defect; the two
regress/gate_arm.sh:136:# "standalone" rows are the control that attributes it to the COMBINER rather
regress/gate_arm.sh:137:# than to the instruction -- same encoding, same operands, no following branch;
regress/gate_arm.sh:138:# and "flat C preserved" catches a fix that starts clobbering C on an
regress/gate_arm.sh:139:# unrotated immediate, where the ISA preserves it. Named individually so one
regress/gate_arm.sh:140:# reverting site cannot hide behind the total.
regress/gate_arm.sh:141:for v in "A teq rot C combined" "A tst rot C combined" \
regress/gate_arm.sh:142:         "A teq rot C standalone" "A tst rot C standalone" \
regress/gate_arm.sh:143:         "A teq flat C preserved"; do
regress/gate_arm.sh:144:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:145:    check "  row: $v" "$n" 1
regress/gate_arm.sh:146:done
regress/gate_arm.sh:147:
regress/gate_arm.sh:148:# #342: the XOR-swap fold. The DISC row is its own proof that the fold
regress/gate_arm.sh:149:# happened -- three standalone `eor rX,rX,rX` cannot leave a nonzero value, so
regress/gate_arm.sh:150:# only X(xchg) could have produced the 0x5a the committed build returned.
regress/gate_arm.sh:151:#
regress/gate_arm.sh:152:# The swap rows are PINs in the shape the matcher actually accepts, Rm == Rd
regress/gate_arm.sh:153:# (`eor X,Y,X`). The first version of them used Rn == Rd and so never matched
regress/gate_arm.sh:154:# the combiner at all -- it was measuring three standalone EORs while claiming
regress/gate_arm.sh:155:# to exercise the fold, which a review seat caught. They now run the FOLDED
regress/gate_arm.sh:156:# handler on pass 2 and pin that its swap is correct, so a broken X(xchg) fails
regress/gate_arm.sh:157:# here; they still cannot distinguish folded-and-correct from
regress/gate_arm.sh:158:# not-folded-and-correct, which is why they are pins and not discriminators.
regress/gate_arm.sh:159:for v in "A xchg same-reg zeroes" "A xchg same-reg r1 pin" \
regress/gate_arm.sh:160:         "A xchg swap r0" "A xchg swap r1"; do
regress/gate_arm.sh:161:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:162:    check "  row: $v" "$n" 1
regress/gate_arm.sh:163:done
regress/gate_arm.sh:164:
regress/gate_arm.sh:165:# #345/#346/#348/#349/#350: the first cache-clean fold. Matcher probes, each
regress/gate_arm.sh:166:# one field off the genuine `ldr r2,[r0],#32 / subs r1,r1,#0x20 / bne / mcr`,
regress/gate_arm.sh:167:# so no row can be satisfied by the wrong guard:
regress/gate_arm.sh:168:#
regress/gate_arm.sh:169:#   r0/r1 intact  -- #345: base r5, counter r6. Its stride is 32 deliberately,
regress/gate_arm.sh:170:#       so that #346's immediate check cannot block this fold and stand in for
regress/gate_arm.sh:171:#       the register check the row exists to protect.
regress/gate_arm.sh:172:#   imm4 r0/r2    -- #346: `ldr r2,[r0],#4` folded anyway and advanced r0 by 32,
regress/gate_arm.sh:173:#       reading 0x9120 where the architecture returns 0x9104. r2 is the second
regress/gate_arm.sh:174:#       half of that: the skipped load left it at its 0x77 seed.
regress/gate_arm.sh:175:#   wrong Rd      -- `ldr r6,[r0],#32` folded and stranded r6 at 0x66.
regress/gate_arm.sh:176:#
regress/gate_arm.sh:177:# "fold r0" pins the closed form's arithmetic; "still folds" asserts the stale
regress/gate_arm.sh:178:# r2, a defect deliberately unfixed (OUTSTANDING_BUGS), which makes it a fold
regress/gate_arm.sh:179:# detector independent of #349's marker. The #348 rows ride a 0x40 counter --
regress/gate_arm.sh:180:# at 0x20, a fix that skipped the r1 preload would be invisible:
regress/gate_arm.sh:181:#
regress/gate_arm.sh:182:#   flags         -- #348: seeded N|V (cmp r9,#0x80000000), the loop's zero
regress/gate_arm.sh:183:#       exit owes Z|C = 0x6; the committed pre-fix build read the seed back.
regress/gate_arm.sh:184:#   fold r1       -- the genuine counter result, 0, unasserted before round 99.
regress/gate_arm.sh:185:#   nonmult       -- #350: a 0x21 counter re-entering the installed fold. The
regress/gate_arm.sh:186:#       unguarded fold consumed it (r0 went odd: += 0x21); the guard falls
regress/gate_arm.sh:187:#       back to the real loop, which never exits, and the session is forced
regress/gate_arm.sh:188:#       back with ^C. The verdict is read from the registers: "fold" on an
regress/gate_arm.sh:189:#       unaided exit with r0 odd, "live" only with the residue invariant
regress/gate_arm.sh:190:#       AND r0 advanced off its phase-A value (load progress).
regress/gate_arm.sh:191:#   quiet/fires   -- #349: the fold-fired marker, absent at default verbosity,
regress/gate_arm.sh:192:#       present under `verbosity cpu 3` on the genuine loop only. The fires
regress/gate_arm.sh:193:#       row is the channel's own positive control; ctrl proves selectivity.
regress/gate_arm.sh:194:#   zero n        -- #350's r1 == 0 arm: the honest iteration count (2^27) is
regress/gate_arm.sh:195:#       unassertable by any register or flag, so it is read off the marker
regress/gate_arm.sh:196:#       text itself. A formula reverted to `r1 >> 5` prints 0 and fails.
regress/gate_arm.sh:197:for v in "A cacheclean r0 intact" "A cacheclean r1 intact" \
regress/gate_arm.sh:198:         "A cacheclean still folds" "A cacheclean fold r0" \
regress/gate_arm.sh:199:         "A cacheclean imm4 r0" "A cacheclean imm4 r2" \
regress/gate_arm.sh:200:         "A cacheclean wrong Rd" "A cacheclean flags" \
regress/gate_arm.sh:201:         "A cacheclean fold r1" "A cacheclean nonmult" \
regress/gate_arm.sh:202:         "A cacheclean quiet" "A cacheclean fires" \
regress/gate_arm.sh:203:         "A cacheclean fires ctrl" "A cacheclean zero n"; do
regress/gate_arm.sh:204:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:205:    check "  row: $v" "$n" 1
regress/gate_arm.sh:206:done
regress/gate_arm.sh:207:
regress/gate_arm.sh:208:# #347/#348/#349: the SECOND cache-clean fold, which had BOTH halves of the
regress/gate_arm.sh:209:# #347 defect -- `add rX,rX,#32 / subs rY,rY,#32` accepted for any X and Y,
regress/gate_arm.sh:210:# and a handler that wrote no guest register at all -- and then the flags
regress/gate_arm.sh:211:# defect #348 closed. Loops one field off the genuine
regress/gate_arm.sh:212:# `mcr / mcr / add r0,r0,#32 / subs r1,r1,#32 / bhi`, plus counters for both
regress/gate_arm.sh:213:# exits of the loop:
regress/gate_arm.sh:214:#
regress/gate_arm.sh:215:#   fold r0/r1    -- the genuine sequence. The committed #346-era handler
regress/gate_arm.sh:216:#       returned r0 = 0x9100 and r1 = 0x40 for a loop that owes 0x9140 and 0.
regress/gate_arm.sh:217:#   flags         -- #348: seeded N|V, the 0x40 counter's zero exit owes
regress/gate_arm.sh:218:#       Z|C = 0x6. The pre-fix build read the seed back.
regress/gate_arm.sh:219:#   base r5/r1    -- `add r5,r5,#32`: the fold fired anyway and stranded r5 at
regress/gate_arm.sh:220:#       0x9100 and r1 at 0x40.
regress/gate_arm.sh:221:#   cnt r6        -- `subs r6,r6,#32`: fired anyway, r6 left at 0x40.
regress/gate_arm.sh:222:#   base r0 / cnt r1 -- the anti-clobber pins. They pass on the pre-fix build
regress/gate_arm.sh:223:#       too, on purpose: they exist to catch the OPPOSITE error, a handler that
regress/gate_arm.sh:224:#       now writes r[0]/r[1] by name behind a matcher that still takes any
regress/gate_arm.sh:225:#       register. Without them the register guard could be dropped and only the
regress/gate_arm.sh:226:#       rows above, which already pass, would notice.
regress/gate_arm.sh:227:#   tail flags/r0/r1 -- the 0x30 counter exits on the subs BORROWING and owes
regress/gate_arm.sh:228:#       N alone (0x8); the registers pin #347's closed form on the borrow
regress/gate_arm.sh:229:#       path, which no earlier row covered. "tail V" repeats the run seeded
regress/gate_arm.sh:230:#       V=1: V must come back 0 on the borrow exit too (it is structurally 0
regress/gate_arm.sh:231:#       -- the final operand lies in [0, 0x20] for every uint32 counter).
regress/gate_arm.sh:232:#   zero flags/r0/r1 -- counter 0, the one input where #347's `(r1 == 0 ||`
regress/gate_arm.sh:233:#       disjunct is load-bearing: owes r0 += 0x20, r1 = 0xffffffe0, flags 0x8.
regress/gate_arm.sh:234:#   quiet/fires   -- #349: the marker channel. The old `still fold` control
regress/gate_arm.sh:235:#       asserted the MISSING flags (seeded N surviving) and was retired in the
regress/gate_arm.sh:236:#       same change that fixed them, as its own comment required; the marker
regress/gate_arm.sh:237:#       is its replacement as the only fold-fired detector, since post-#348
regress/gate_arm.sh:238:#       the genuine sequence is architecturally transparent.
regress/gate_arm.sh:239:for v in "A cclean2 fold r0" "A cclean2 fold r1" "A cclean2 flags" \
regress/gate_arm.sh:240:         "A cclean2 base r5" "A cclean2 base r1" "A cclean2 base r0" \
regress/gate_arm.sh:241:         "A cclean2 cnt r6" "A cclean2 cnt r1" "A cclean2 tail flags" \
regress/gate_arm.sh:242:         "A cclean2 tail r0" "A cclean2 tail r1" "A cclean2 tail V" \
regress/gate_arm.sh:243:         "A cclean2 zero flags" "A cclean2 zero r0" "A cclean2 zero r1" \
regress/gate_arm.sh:244:         "A cclean2 quiet" "A cclean2 fires" "A cclean2 fires ctrl"; do
regress/gate_arm.sh:245:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:246:    check "  row: $v" "$n" 1
regress/gate_arm.sh:247:done
regress/gate_arm.sh:248:
regress/gate_arm.sh:249:for v in "sbcs eq C=0 C" "sbcs eq0 C=0 C" "sbcs eqmax C=0 C" "rscs eq C=0 C"; do
regress/gate_arm.sh:250:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:251:    check "  disc: $v" "$n" 1
regress/gate_arm.sh:252:done
regress/gate_arm.sh:253:
regress/gate_arm.sh:254:# The value rows on those same four: the arithmetic was ALWAYS right, and a
regress/gate_arm.sh:255:# "fix" that repaired the flag by breaking the result must not pass.
regress/gate_arm.sh:256:for v in "sbcs eq C=0 rd" "sbcs eq0 C=0 rd" "sbcs eqmax C=0 rd" "rscs eq C=0 rd"; do
regress/gate_arm.sh:257:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:258:    check "  value intact: $v" "$n" 1
regress/gate_arm.sh:259:done
regress/gate_arm.sh:260:
regress/gate_arm.sh:261:# The instructions the fix must NOT disturb.
regress/gate_arm.sh:262:for v in "subs eq C" "subs lt C" "subs gt C" "subs zerominus C" \
regress/gate_arm.sh:263:         "rsbs gt C" "rsbs lt C" \
regress/gate_arm.sh:264:         "cmp eq NZCV" "cmp lt NZCV" "cmp gt NZCV" \
regress/gate_arm.sh:265:         "subs rn=pc rd" "subs rn=pc C" \
regress/gate_arm.sh:266:         "adds carry-out C" "adds no-carry C" \
regress/gate_arm.sh:267:         "adcs carry-out C" "adcs no-carry C" \
regress/gate_arm.sh:268:         "sbcs eq C=1 C" "sbcs gt C=0 C" "sbcs lt C=0 C" "sbcs lt C=1 C" \
regress/gate_arm.sh:269:         "rscs gt C=0 C" "rscs lt C=0 C"; do
regress/gate_arm.sh:270:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:271:    check "  pin: $v" "$n" 1
regress/gate_arm.sh:272:done
regress/gate_arm.sh:273:
regress/gate_arm.sh:274:# #313: ADC was the ONE opcode listed in the outer V-update #if that matched
regress/gate_arm.sh:275:# neither inner formula, so ADCS could only ever clear V. The paired adds rows
regress/gate_arm.sh:276:# are what make these a statement about ADC rather than about V generally --
regress/gate_arm.sh:277:# the identical overflow through ADDS was already correct.
regress/gate_arm.sh:278:for v in "adcs V pos-ovf" "adcs V pos-ovf2" "adcs V neg-ovf"; do
regress/gate_arm.sh:279:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:280:    check "  disc: $v" "$n" 1
regress/gate_arm.sh:281:done
regress/gate_arm.sh:282:for v in "adcs V none" "adds V pos-ovf" "adds V none" "sbcs V ovf"; do
regress/gate_arm.sh:283:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:284:    check "  pin: $v" "$n" 1
regress/gate_arm.sh:285:done
regress/gate_arm.sh:286:
regress/gate_arm.sh:287:# #312's rows. The handler-ran row is the witness that the exception was
regress/gate_arm.sh:288:# actually TAKEN; mode and lr prove it was entered as an exception rather than
regress/gate_arm.sh:289:# branched into.
regress/gate_arm.sh:290:#
regress/gate_arm.sh:291:# The page-end row is not redundant with the first: X(und) reconstructs the
regress/gate_arm.sh:292:# faulting PC with a hard-coded 4KB mask, and at page offset 0 both halves of
regress/gate_arm.sh:293:# that arithmetic are zero, so only a row at the last slot of a page can catch
regress/gate_arm.sh:294:# a wrong mask.
regress/gate_arm.sh:295:for v in "udf handler ran" "udf UND32 mode" "udf lr=pc+4" \
regress/gate_arm.sh:296:         "udf gdb-form handler ran" "udf gdb-form UND32 mode" \
regress/gate_arm.sh:297:         "udf gdb-form lr=pc+4" \
regress/gate_arm.sh:298:         "udf page-end handler ran" "udf page-end UND32 mode" \
regress/gate_arm.sh:299:         "udf page-end lr=pc+4" "udf cond-failed nop"; do
regress/gate_arm.sh:300:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:301:    check "  undefined: $v" "$n" 1
regress/gate_arm.sh:302:done
regress/gate_arm.sh:303:
regress/gate_arm.sh:304:# ---- #319/#320/#321: rotations the decoder rejected, and MVNS's carry -------
regress/gate_arm.sh:305:# Every row asserts a VALUE. `uxtah ROR 24` is the discriminating one of the
regress/gate_arm.sh:306:# first group: a byte extract is the same under a rotate as under a shift at
regress/gate_arm.sh:307:# every encodable amount, so the uxtab rows cannot tell those apart, while the
regress/gate_arm.sh:308:# halfword form at 24 wraps rm's low byte into bits 15:8.
regress/gate_arm.sh:309:#
regress/gate_arm.sh:310:# `rotc zero C` is the row that never halted -- the old guard exempted an imm8
regress/gate_arm.sh:311:# of zero, so that case shipped with the wrong carry rather than stopping, which
regress/gate_arm.sh:312:# is why this group is a wrong-answer fix and not only a halt fix.
regress/gate_arm.sh:313:#
regress/gate_arm.sh:314:# All four MVNS bands are present because two of them would pass by coincidence:
regress/gate_arm.sh:315:# the decoder rewrites `mvn #imm` to `mov #~imm`, and with S set the carry was
regress/gate_arm.sh:316:# then read off the COMPLEMENT.
regress/gate_arm.sh:317:for v in "uxtab ROR 8" "uxtab ROR 16" "uxtab ROR 24" \
regress/gate_arm.sh:318:         "uxtah ROR 8" "uxtah ROR 16" "uxtah ROR 24" \
regress/gate_arm.sh:319:         "rotc movs val" "rotc movs C" "rotc zero C" "rotc ands C" \
regress/gate_arm.sh:320:         "rotc orrs val" "rotc bics val" "rotc tst C" \
regress/gate_arm.sh:321:         "mvns rot0 C=0" "mvns rot0 C=1" "mvns b31=0 C" "mvns b31=1 C" \
regress/gate_arm.sh:322:         "mvns value"; do
regress/gate_arm.sh:323:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:324:    check "  round 78: $v" "$n" 1
regress/gate_arm.sh:325:done
regress/gate_arm.sh:326:for v in "rotc pc src C"; do
regress/gate_arm.sh:327:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:328:    check "  round 78: $v" "$n" 1
regress/gate_arm.sh:329:done
regress/gate_arm.sh:330:for v in "uxtab ROR 0" "rot0 movs C" "mvn S-clear" "rot0 pc src C" \
regress/gate_arm.sh:331:         "rotc pc gt255" "rotc bound 256"; do
regress/gate_arm.sh:332:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:333:    check "  round 78 pin: $v" "$n" 1
regress/gate_arm.sh:334:done
regress/gate_arm.sh:335:
regress/gate_arm.sh:336:# #328: the THUMB rows. Everything above is ARM-mode; the Thumb interpreter is a
regress/gate_arm.sh:337:# separate implementation that #311 never touched, and it had THREE flag defects in
regress/gate_arm.sh:338:# four near-identical blocks -- Z read off a 64-bit value, C derived from the carry
regress/gate_arm.sh:339:# out of a negation (so subtracting zero reported a borrow), and V read from the sign
regress/gate_arm.sh:340:# of the negated subtrahend (which breaks at 0x80000000, the one value that is its
regress/gate_arm.sh:341:# own negation). Each row asserts the flags AND rd, because the value was already
regress/gate_arm.sh:342:# right and a flags-only row could not tell a fixed flag from a broken result.
regress/gate_arm.sh:343:for v in "T ctrl ADDS 2+3" "T ctrl SUBS 5-3" "T ctrl SUBS borrow"          "T Z subs equal" "T Z cmp imm equal" "T Z subs imm equal"          "T Z cmp reg equal" "T Z adds wrap"          "T C subs zero" "T C cmp imm 0" "T C subs imm 0" "T C cmp reg zero"          "T V 0-INT_MIN" "T V -1-INT_MIN" "T V INT_MIN-same"          "T alias subs rd==rm" \
regress/gate_arm.sh:344:         "T Z adds imm8 wrap" "T Z adds imm3 wrap" "T C subs imm3 zero" \
regress/gate_arm.sh:345:         "T V subs INT_MIN" "T V adds overflow" "T C subs 0-0" \
regress/gate_arm.sh:346:         "T V adds INT_MIN x2"; do
regress/gate_arm.sh:347:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:348:    check "  thumb: $v" "$n" 1
regress/gate_arm.sh:349:    n=$(count "$LOG" "^$v rd  .*ok$")
regress/gate_arm.sh:350:    check "  thumb: $v rd" "$n" 1
regress/gate_arm.sh:351:done
regress/gate_arm.sh:352:
regress/gate_arm.sh:353:
regress/gate_arm.sh:354:# #329: the Thumb SHIFT rows. ASR-immediate took Z and N from a register chosen by the
regress/gate_arm.sh:355:# shift amount; RORS never cleared Z/N; and LSR #0 / ASR #0 encode shift-by-32 rather
regress/gate_arm.sh:356:# than shift-by-zero. The two LSL #0 rows are the control -- that encoding IS a genuine
regress/gate_arm.sh:357:# no-op and its C must survive untouched, which is why they run at both carry-in values.
regress/gate_arm.sh:358:# The positive-operand shift-32 rows only became measurable once the rig could preset
regress/gate_arm.sh:359:# carry: against a build that never writes C they would pass on a cold machine anyway.
regress/gate_arm.sh:360:for v in "T LSL #0 keeps C1" "T LSL #0 keeps C0" "T ASR #12 flags reg"          "T RORS clears Z" "T RORS clears N"          "T LSR #0 neg" "T LSR #0 pos" "T ASR #0 neg" "T ASR #0 pos"          "T LSR rd!=0"; do
regress/gate_arm.sh:361:    n=$(count "$LOG" "^$v  .*ok$")
regress/gate_arm.sh:362:    check "  shift: $v" "$n" 1
regress/gate_arm.sh:363:    n=$(count "$LOG" "^$v rd  .*ok$")
regress/gate_arm.sh:364:    check "  shift: $v rd" "$n" 1
regress/gate_arm.sh:365:done
regress/gate_arm.sh:366:
regress/gate_arm.sh:367:# ---- #351/#352/#353: netbsd_idle, via the READ-AHEAD install path -----------
regress/gate_arm.sh:368:# A SEPARATE probe (arm_idle_probe.py), because every row here runs with NO
regress/gate_arm.sh:369:# breakpoint so translation read-ahead is ON -- the install path a real guest
regress/gate_arm.sh:370:# takes, and the one arm_flags_probe.py's breakpoint driver structurally cannot
regress/gate_arm.sh:371:# reach (cpu_dyntrans.c:1939 gates read-ahead on breakpoints.n == 0). The
regress/gate_arm.sh:372:# register-alias defect (c) and the forward-beq hang (d) are invisible under a
regress/gate_arm.sh:373:# breakpoint, so they could only be witnessed here.
regress/gate_arm.sh:374:#
regress/gate_arm.sh:375:# Swept against a binary built from the pre-fix HEAD (704036e): 2 of 9, failing
regress/gate_arm.sh:376:# exactly the seven DISC rows -- exit dest 0x77, exit flags 0x6, idle dest 0x77,
regress/gate_arm.sh:377:# idle flags 0x8, `alias exits` 0x55 (fold took the wrong exit), `target
regress/gate_arm.sh:378:# reached` deadbeef (the forward-beq HUNG the guest), and `fires` (no marker) --
regress/gate_arm.sh:379:# and passing the two PINs. On the fixed build: 9/9.
regress/gate_arm.sh:380:IDLELOG=$LOGDIR/gate_arm_idle.log
regress/gate_arm.sh:381:python3 arm_idle_probe.py "$PMAX" "$STUB" > "$IDLELOG" 2>&1 || true
regress/gate_arm.sh:382:
regress/gate_arm.sh:383:if ! grep -q "IDLE_RESULT=" "$IDLELOG"; then
regress/gate_arm.sh:384:    note "idle probe produced no result line; last lines follow"
regress/gate_arm.sh:385:    tail -5 "$IDLELOG" | sed 's/^/       /'
regress/gate_arm.sh:386:    gate_skip "idle probe did not complete"
regress/gate_arm.sh:387:fi
regress/gate_arm.sh:388:
regress/gate_arm.sh:389:grep -E " ok$| FAIL$" "$IDLELOG" | sed 's/^/       /'
regress/gate_arm.sh:390:
regress/gate_arm.sh:391:ictrl=$(grep -o "IDLE_CONTROL=[A-Z]*" "$IDLELOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:392:check "idle control proves the probe measures" "${ictrl:-missing}" "OK"
regress/gate_arm.sh:393:
regress/gate_arm.sh:394:ires=$(grep -o "IDLE_RESULT=[0-9]*/[0-9]*" "$IDLELOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:395:igot=${ires%/*}; iwant=${ires#*/}
regress/gate_arm.sh:396:check "idle rows run"     "$iwant" 9
regress/gate_arm.sh:397:check "idle rows correct" "$igot"  "$iwant"
regress/gate_arm.sh:398:
regress/gate_arm.sh:399:# Named rows, one contract each. The two PINs pass on both builds by design:
regress/gate_arm.sh:400:# `quiet` asserts marker absence at default verbosity (boot-log hygiene), and
regress/gate_arm.sh:401:# `alias -J ref` pins that the alias program's architectural answer really is
regress/gate_arm.sh:402:# idle (so the DISC above attributes its 0x55 to the fold, not the program).
regress/gate_arm.sh:403:for v in "A idle exit dest" "A idle exit flags" "A idle path dest" \
regress/gate_arm.sh:404:         "A idle path flags" "A idle alias exits" "A idle target reached" \
regress/gate_arm.sh:405:         "A idle fires" "A idle quiet" "A idle alias -J ref"; do
regress/gate_arm.sh:406:    n=$(count "$IDLELOG" "^$v  .*ok$")
regress/gate_arm.sh:407:    check "  idle row: $v" "$n" 1
regress/gate_arm.sh:408:done
regress/gate_arm.sh:409:
regress/gate_arm.sh:410:# ---- #354: netbsd_memcpy, via the READ-AHEAD install path -------------------
regress/gate_arm.sh:411:# The memcpy fold did memcpy(dst,src,32) + advanced r0/r1 but never wrote
regress/gate_arm.sh:412:# r3/r4/ip/lr, which the architecture leaves = the last 16 bytes loaded (the
regress/gate_arm.sh:413:# final iteration's second ldmia). Same SEPARATE-probe / read-ahead-ON reason
regress/gate_arm.sh:414:# as the idle rows. Owed words are full-width and distinct per register so a
regress/gate_arm.sh:415:# byteswap or wrong index is self-evident.
regress/gate_arm.sh:416:#
regress/gate_arm.sh:417:# Swept against a binary built from the committed HEAD (pre-#354): 4 of 12,
regress/gate_arm.sh:418:# failing exactly the eight DISC rows (r3/r4/ip/lr = seeds 0x33/0x44/0xcc/0xee
regress/gate_arm.sh:419:# on both the 1-iteration and 2-iteration loops) and passing the four r0/r1
regress/gate_arm.sh:420:# PINs (the advance was always correct). On the fixed build: 12/12.
regress/gate_arm.sh:421:MEMLOG=$LOGDIR/gate_arm_memcpy.log
regress/gate_arm.sh:422:python3 arm_memcpy_probe.py "$PMAX" "$STUB" > "$MEMLOG" 2>&1 || true
regress/gate_arm.sh:423:
regress/gate_arm.sh:424:if ! grep -q "MEMCPY_RESULT=" "$MEMLOG"; then
regress/gate_arm.sh:425:    note "memcpy probe produced no result line; last lines follow"
regress/gate_arm.sh:426:    tail -5 "$MEMLOG" | sed 's/^/       /'
regress/gate_arm.sh:427:    gate_skip "memcpy probe did not complete"
regress/gate_arm.sh:428:fi
regress/gate_arm.sh:429:
regress/gate_arm.sh:430:grep -E " ok$| FAIL$" "$MEMLOG" | sed 's/^/       /'
regress/gate_arm.sh:431:
regress/gate_arm.sh:432:# The control proves the harness runs end-to-end (program assembled, guest
regress/gate_arm.sh:433:# executed, dump parsed, byteswap convention right) against the GENUINE
regress/gate_arm.sh:434:# instruction path under -J. It does NOT prove the measured sessions went
regress/gate_arm.sh:435:# through the FOLD: post-#354 the fold and the genuine path agree by
regress/gate_arm.sh:436:# construction, so nothing here would notice if a future change broke the
regress/gate_arm.sh:437:# combiner registration -- the rows would keep passing via the real
regress/gate_arm.sh:438:# instructions and the coverage would silently vanish. Only a #349/#352-style
regress/gate_arm.sh:439:# fold-fired marker closes that; it is recorded in OUTSTANDING_BUGS, and the
regress/gate_arm.sh:440:# historical pre-#354 sweep (4/12, the eight DISC rows red) is what establishes
regress/gate_arm.sh:441:# that these rows discriminate at all.
regress/gate_arm.sh:442:mctrl=$(grep -o "MEMCPY_CONTROL=[A-Z]*" "$MEMLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:443:check "memcpy control: harness measures (not fold-fired)" "${mctrl:-missing}" "OK"
regress/gate_arm.sh:444:
regress/gate_arm.sh:445:mres=$(grep -o "MEMCPY_RESULT=[0-9]*/[0-9]*" "$MEMLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:446:mgot=${mres%/*}; mwant=${mres#*/}
regress/gate_arm.sh:447:check "memcpy rows run"     "$mwant" 17
regress/gate_arm.sh:448:check "memcpy rows correct" "$mgot"  "$mwant"
regress/gate_arm.sh:449:
regress/gate_arm.sh:450:# The four r0/r1 PINs pass on both builds -- they guard against a fix that
regress/gate_arm.sh:451:# regresses the advance while writing the registers (Codex's clobber concern:
regress/gate_arm.sh:452:# r0/r1/r2 are outside the {r3,r4,ip,lr} reglist, so the exact-iword matcher
regress/gate_arm.sh:453:# already forbids aliasing; these pins make that guarantee visible).
regress/gate_arm.sh:454:#  #359: the five `dst` rows are the only assertions in this whole gate that
regress/gate_arm.sh:455:#  read the BYTES the fold moved. Everything else here reads registers, and
regress/gate_arm.sh:456:#  registers cannot see the copy size: r3/r4/ip/lr are published by a direct
regress/gate_arm.sh:457:#  page read that bypasses the fold's memcpy call, and r0/r1 advance
regress/gate_arm.sh:458:#  unconditionally. Measured, and this is why the rows exist: a build whose fold
regress/gate_arm.sh:459:#  called memcpy with 16 instead of 32 -- half the bytes moved, same iteration
regress/gate_arm.sh:460:#  count, same register advance -- passed this probe 12/12 and the whole of gate
regress/gate_arm.sh:461:#  14 at 243 checks. With the dst rows it reads 15/17, red at exactly
regress/gate_arm.sh:462:#  `1it dst w6` and `2it dst w14`, both showing the pre-fill sentinel where a
regress/gate_arm.sh:463:#  source word was owed. They are PIN, not DISC: the genuine ldmia/stmia moves
regress/gate_arm.sh:464:#  the same bytes, so the destination is identical folded or not -- what they
regress/gate_arm.sh:465:#  discriminate is a broken copy. Note `2it dst w9` deliberately PASSES on that
regress/gate_arm.sh:466:#  mutant (it lies in the first 16 bytes of the second iteration, which is still
regress/gate_arm.sh:467:#  copied); the discriminator for a later iteration is w14, and keeping both
regress/gate_arm.sh:468:#  makes the row set say which half of the copy failed.
regress/gate_arm.sh:469:for v in "A memcpy 1it r3" "A memcpy 1it r4" "A memcpy 1it ip" \
regress/gate_arm.sh:470:         "A memcpy 1it lr" "A memcpy 1it r0" "A memcpy 1it r1" \
regress/gate_arm.sh:471:         "A memcpy 1it dst w1" "A memcpy 1it dst w6" \
regress/gate_arm.sh:472:         "A memcpy 1it dst tail" \
regress/gate_arm.sh:473:         "A memcpy 2it r3" "A memcpy 2it r4" "A memcpy 2it ip" \
regress/gate_arm.sh:474:         "A memcpy 2it lr" "A memcpy 2it r0" "A memcpy 2it r1" \
regress/gate_arm.sh:475:         "A memcpy 2it dst w9" "A memcpy 2it dst w14"; do
regress/gate_arm.sh:476:    n=$(count "$MEMLOG" "^$v  .*ok$")
regress/gate_arm.sh:477:    check "  memcpy row: $v" "$n" 1
regress/gate_arm.sh:478:done
regress/gate_arm.sh:479:
regress/gate_arm.sh:480:# ---- #355/#356: the strlen fold ---------------------------------------------
regress/gate_arm.sh:481:# #355: COMBINE(strlen) never required the load's base and destination to
regress/gate_arm.sh:482:# differ, so `ldrb r3,[r3,#1]!` folded. The genuine writeback overwrites the
regress/gate_arm.sh:483:# loaded byte, so the cmps compares an ADDRESS and the loop runs on; the fold's
regress/gate_arm.sh:484:# condition tests the byte and EXITS. The encoding is UNPREDICTABLE, so neither
regress/gate_arm.sh:485:# answer is "wrong" -- but the emulator was giving two answers for one program
regress/gate_arm.sh:486:# depending on whether the combination happened, and -J is this gate's own
regress/gate_arm.sh:487:# architectural oracle.
regress/gate_arm.sh:488:#
regress/gate_arm.sh:489:# #356: the walk had no budget bound and ran the whole string inside ONE
regress/gate_arm.sh:490:# dispatch -- host unresponsive for the duration, and n_translated_instrs (an
regress/gate_arm.sh:491:# int, reset per run_instr, with a REPLAYABLE walk) drivable into signed
regress/gate_arm.sh:492:# overflow with ~18-24 MB of non-NUL memory at the DEFAULT -M 64.
regress/gate_arm.sh:493:#
regress/gate_arm.sh:494:# The yield is witnessed WITHOUT a clock: the test machine's mp device exposes
regress/gate_arm.sh:495:# cpu->ninstrs at 0x110000d0, and ninstrs is committed only when run_instr
regress/gate_arm.sh:496:# returns, so a guest sampling it either side of a 16 KB walk reads ~0 if the
regress/gate_arm.sh:497:# walk never left one dispatch. All numeric rows assert BANDS, because the exact
regress/gate_arm.sh:498:# counts depend on N_SAFE_DYNTRANS_LIMIT (8191) and the 120-dispatch group
regress/gate_arm.sh:499:# boundary -- named so a change to either moves the bands deliberately.
regress/gate_arm.sh:500:#
regress/gate_arm.sh:501:# Swept against a binary built from the pre-fix HEAD: 3 of 7, failing exactly
regress/gate_arm.sh:502:# the four discriminators -- `yields` and `bill band` both read 0 (the walk
regress/gate_arm.sh:503:# never left the dispatch), `alias exits` read 0x55 (the fold took the wrong
regress/gate_arm.sh:504:# exit) and `alias moved` read "no" (it had exited after three bytes). The
regress/gate_arm.sh:505:# three PINs pass on both builds. On the fixed build: 7/7.
regress/gate_arm.sh:506:STRLOG=$LOGDIR/gate_arm_strlen.log
regress/gate_arm.sh:507:python3 arm_strlen_probe.py "$PMAX" > "$STRLOG" 2>&1 || true
regress/gate_arm.sh:508:
regress/gate_arm.sh:509:if ! grep -q "STRLEN_RESULT=" "$STRLOG"; then
regress/gate_arm.sh:510:    note "strlen probe produced no result line; last lines follow"
regress/gate_arm.sh:511:    tail -5 "$STRLOG" | sed 's/^/       /'
regress/gate_arm.sh:512:    gate_skip "strlen probe did not complete"
regress/gate_arm.sh:513:fi
regress/gate_arm.sh:514:
regress/gate_arm.sh:515:grep -E " ok$| FAIL$" "$STRLOG" | sed 's/^/       /'
regress/gate_arm.sh:516:
regress/gate_arm.sh:517:sctrl=$(grep -o "STRLEN_CONTROL=[A-Z]*" "$STRLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:518:check "strlen control: -J reference walked and yielded" "${sctrl:-missing}" "OK"
regress/gate_arm.sh:519:
regress/gate_arm.sh:520:sres=$(grep -o "STRLEN_RESULT=[0-9]*/[0-9]*" "$STRLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:521:sgot=${sres%/*}; swant=${sres#*/}
regress/gate_arm.sh:522:check "strlen rows run"     "$swant" 7
regress/gate_arm.sh:523:check "strlen rows correct" "$sgot"  "$swant"
regress/gate_arm.sh:524:
regress/gate_arm.sh:525:for v in "A strlen -J ref" "A strlen -J end addr" "A strlen yields" \
regress/gate_arm.sh:526:         "A strlen bill band" "A strlen end addr" "A strlen alias exits" \
regress/gate_arm.sh:527:         "A strlen alias moved"; do
regress/gate_arm.sh:528:    n=$(count "$STRLOG" "^$v  .*ok$")
regress/gate_arm.sh:529:    check "  strlen row: $v" "$n" 1
regress/gate_arm.sh:530:done
regress/gate_arm.sh:531:
regress/gate_arm.sh:532:# #357: the base writeback (cpu_arm_instr_loadstore.c)
regress/gate_arm.sh:533:# -------------------------------------------------------------------------
regress/gate_arm.sh:534:# The template computed one address, masked it for alignment, and wrote the
regress/gate_arm.sh:535:# base register back FROM THE MASKED VALUE. ARM ARM DDI 0100I computes the
regress/gate_arm.sh:536:# writeback from the unmasked Rn (A5.2.8 post-indexed, A5.2.5 pre-indexed;
regress/gate_arm.sh:537:# A2-43 puts the truncation inside Memory[]).
regress/gate_arm.sh:538:#
regress/gate_arm.sh:539:# The reachable symptom is a loop that cannot make progress, not a wrong
regress/gate_arm.sh:540:# value: with a word access and a post-index offset of 1 the masked writeback
regress/gate_arm.sh:541:# is a FIXED POINT -- base 0x10001 masks to 0x10000, plus 1 is 0x10001, the
regress/gate_arm.sh:542:# value it started from. Rows A/A2 run ten iterations and assert the exact
regress/gate_arm.sh:543:# architectural result; the count lives in r3, so nothing here depends on how
regress/gate_arm.sh:544:# far execution got or on host speed.
regress/gate_arm.sh:545:#
regress/gate_arm.sh:546:# WHICH ROW REACHES WHICH SITE -- #364 CORRECTED THIS TABLE, WHICH WAS INVERTED.
regress/gate_arm.sh:547:# It used to say the fast path "only runs once the page is in the translation
regress/gate_arm.sh:548:# array, so a single-execution row measures the GENERAL path and nothing else",
regress/gate_arm.sh:549:# and it referred forward to a "CORRECTION below" that was never written. Both
regress/gate_arm.sh:550:# are fixed here. MEASURED: no row in this probe reached the general path at
regress/gate_arm.sh:551:# all -- a marker at the top of A__NAME__general counted ZERO hits on all 17
regress/gate_arm.sh:552:# rows, including the x10 iterations and both re-seeded passes.
regress/gate_arm.sh:553:#
regress/gate_arm.sh:554:# The cause was the probe's own seeding. `put w` -> store_32bit_word ->
regress/gate_arm.sh:555:# memory_rw(CACHE_DATA), and insertion is gated on !no_exceptions, so a page
regress/gate_arm.sh:556:# seeded with `put w` is ALREADY warm before the guest runs. `put b` uses
regress/gate_arm.sh:557:# CACHE_NONE | NO_EXCEPTIONS and does not insert. The old note had the two
regress/gate_arm.sh:558:# backwards, and it was recorded as a verified mechanism, so two shipped rounds
regress/gate_arm.sh:559:# leaned on it: #357's general-path writeback and #362's general-path rotation
regress/gate_arm.sh:560:# were both unmeasured, and each was independently confirmed DELETABLE with this
regress/gate_arm.sh:561:# whole gate still green at 358 checks.  (This said 261 until 2026-08-26 -- the count
regress/gate_arm.sh:562:# grew when the gate took on `barearm` and `cats`, and commit 6014b7e's message records
regress/gate_arm.sh:563:# "PASS 358 checks (was 261)".  The carrier carried the same stale number; both were
regress/gate_arm.sh:564:# corrected together, because a number with two homes rots in both.)
regress/gate_arm.sh:565:#
regress/gate_arm.sh:566:# TWO AXES, kept apart. The first draft of this correction conflated them and
regress/gate_arm.sh:567:# claimed the new cold rows cover "general post-index writeback". They do NOT:
regress/gate_arm.sh:568:# their LDR is P=1/W=0, and the writeback is emitted only under (P and W) or
regress/gate_arm.sh:569:# (not P), so an offset form has no writeback statement at all. Caught in review.
regress/gate_arm.sh:570:#
regress/gate_arm.sh:571:#   -- the four WRITEBACK sites (the `reg(ic->arg[0]) =` statements) --
regress/gate_arm.sh:572:#   fast    post-index  every iteration of the x10 rows, plus the one-shot
regress/gate_arm.sh:573:#                       post-index rows and the PIN rows (11 in total)
regress/gate_arm.sh:574:#   fast    pre-index   "pre4 unal gen" AND "pre4 unal fast" (both passes)
regress/gate_arm.sh:575:#   general post-index  UNCOVERED
regress/gate_arm.sh:576:#   general pre-index   UNCOVERED
regress/gate_arm.sh:577:#
regress/gate_arm.sh:578:#   -- rows with NO writeback site (P=1/W=0 offset forms) --
regress/gate_arm.sh:579:#   "pre4 no wb" and the three "rot word unal" rows   (fast function)
regress/gate_arm.sh:580:#   the three "rot word cold" rows                    (general function)
regress/gate_arm.sh:581:#
regress/gate_arm.sh:582:#   -- which rows enter A__NAME__general AT ALL, the question this round answers --
regress/gate_arm.sh:583:#   the three "rot word cold" rows, and nothing else: they exercise the
regress/gate_arm.sh:584:#   load-and-rotate arm and the memory_rw slow path, which is a DATA site.
regress/gate_arm.sh:585:#
regress/gate_arm.sh:586:# So #357's general-path WRITEBACK fix still has no row reaching it. That is
regress/gate_arm.sh:587:# recorded in OUTSTANDING_BUGS rather than papered over here.
regress/gate_arm.sh:588:#
regress/gate_arm.sh:589:# No line numbers here on purpose: the ones this table used to carry (:213/:216,
regress/gate_arm.sh:590:# :338/:342) had gone stale by the round that corrected it -- the third time in
regress/gate_arm.sh:591:# this file, whose own #357 note already says a numeric cite here has gone stale
regress/gate_arm.sh:592:# twice before.
regress/gate_arm.sh:593:#
regress/gate_arm.sh:594:# "pre4 unal fast" still needs its two passes with the base re-seeded each pass:
regress/gate_arm.sh:595:# without the re-seed, pass 1 leaves an ALIGNED base and the row has nothing
regress/gate_arm.sh:596:# left to discriminate. Only its SITE attribution was wrong, not its design.
regress/gate_arm.sh:597:# Loads and stores are separate instantiations of the template, so a load-only
regress/gate_arm.sh:598:# set cannot see a store-side regression: hence the store row. Register-offset
regress/gate_arm.sh:599:# forms are a third family: hence the regofs row.
regress/gate_arm.sh:600:#
regress/gate_arm.sh:601:# The control is the loaded-data row rather than a pass count: r1 starts at 0,
regress/gate_arm.sh:602:# so a distinctive nonzero value proves the guest really executed and really
regress/gate_arm.sh:603:# loaded. A wrong register field reads 0, and a row that accepts 0 accepts that
regress/gate_arm.sh:604:# mistake by accident -- this harness has shipped exactly that defect before.
regress/gate_arm.sh:605:#
regress/gate_arm.sh:606:# DISC-M ("model") on the halfword row is deliberate: an unaligned halfword
regress/gate_arm.sh:607:# load's DATA is UNPREDICTABLE (A4.1.28) while its writeback stays defined
regress/gate_arm.sh:608:# (A5.3.6), so the row asserts the BASE only and pins the pseudocode model, not
regress/gate_arm.sh:609:# a silicon mandate. Every other DISC row is a word form, i.e. mandated space.
regress/gate_arm.sh:610:# There is no *unaligned* LDRD/STRD row on purpose: A2.8 makes an unaligned
regress/gate_arm.sh:611:# doubleword access UNPREDICTABLE prior to ARMv6, so every base that would
regress/gate_arm.sh:612:# exercise the ~7 mask makes the instruction unspecified -- covered by the
regress/gate_arm.sh:613:# fix, not honestly assertable. [#389: ALIGNED LDRD/STRD byte-order rows now
regress/gate_arm.sh:614:# live in the endian section below -- this note is scoped to the writeback/
regress/gate_arm.sh:615:# unaligned axis only.]
regress/gate_arm.sh:616:#
regress/gate_arm.sh:617:# #364: the sentence that used to stand here -- "no row pins the unaligned
regress/gate_arm.sh:618:# loaded DATA ... such a row would be inverted by the round that fixes
regress/gate_arm.sh:619:# rotation" -- was falsified by #362, which added exactly three such rows, and
regress/gate_arm.sh:620:# by #364, which added three more from a cold page. It is removed rather than
regress/gate_arm.sh:621:# annotated. The ALIGNED data row remains, and remains correct for its own
regress/gate_arm.sh:622:# reason: no rotation applies at offset 0 in any architecture version.
regress/gate_arm.sh:623:#
regress/gate_arm.sh:624:# Swept against a snapshot of the pre-fix binary: 5 of 14, with all nine DISC
regress/gate_arm.sh:625:# rows failing at exactly the predicted masked values and all five PINs
regress/gate_arm.sh:626:# passing. On the fixed build: 14/14. Read that 5/14 with the corrected table
regress/gate_arm.sh:627:# above -- it is entirely a FAST-path result, since no row of that era entered
regress/gate_arm.sh:628:# the general path. #362 took the set to 17, #364 to 20.
regress/gate_arm.sh:629:WBLOG=$LOGDIR/gate_arm_writeback.log
regress/gate_arm.sh:630:python3 arm_writeback_probe.py "$PMAX" > "$WBLOG" 2>&1 || true
regress/gate_arm.sh:631:
regress/gate_arm.sh:632:if ! grep -q "WRITEBACK_RESULT=" "$WBLOG"; then
regress/gate_arm.sh:633:    note "writeback probe produced no result line; last lines follow"
regress/gate_arm.sh:634:    tail -5 "$WBLOG" | sed 's/^/       /'
regress/gate_arm.sh:635:    gate_skip "writeback probe did not complete"
regress/gate_arm.sh:636:fi
regress/gate_arm.sh:637:
regress/gate_arm.sh:638:grep -E " ok$| FAIL$" "$WBLOG" | sed 's/^/       /'
regress/gate_arm.sh:639:
regress/gate_arm.sh:640:wctrl=$(grep -o "WRITEBACK_CONTROL=[A-Z]*" "$WBLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:641:check "writeback control: guest ran and loaded" "${wctrl:-missing}" "OK"
regress/gate_arm.sh:642:
regress/gate_arm.sh:643:wres=$(grep -o "WRITEBACK_RESULT=[0-9]*/[0-9]*" "$WBLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:644:wgot=${wres%/*}; wwant=${wres#*/}
regress/gate_arm.sh:645:check "writeback rows run"     "$wwant" 22
regress/gate_arm.sh:646:check "writeback rows correct" "$wgot"  "$wwant"
regress/gate_arm.sh:647:
regress/gate_arm.sh:648:# #367: PATH ATTRIBUTION IS NOW A CHECKED QUANTITY, not a comment.
regress/gate_arm.sh:649:#
regress/gate_arm.sh:650:# Which of the two load/store paths a row takes was asserted in prose and was
regress/gate_arm.sh:651:# wrong three rounds running: #364 found the `put w` / `put b` warming note
regress/gate_arm.sh:652:# INVERTED and recorded as verified, with two shipped rounds leaning on it;
regress/gate_arm.sh:653:# #364's own draft then mis-attributed a writeback site to an offset form that
regress/gate_arm.sh:654:# compiles no writeback statement at all; and #365 found the general writeback
regress/gate_arm.sh:655:# sites reached but UNDISCRIMINATED, since `ldrb` has datalen 1 so the alignment
regress/gate_arm.sh:656:# mask is the identity for it. Each was rediscovered with a throwaway marker and
regress/gate_arm.sh:657:# a scratch build, three times, because the instrument did not survive the round.
regress/gate_arm.sh:658:#
regress/gate_arm.sh:659:# The emulator now counts entries into A__NAME__general (cpu_arm.h ls_general),
regress/gate_arm.sh:660:# and `tlbdump` -- previously an EMPTY stub on ARM while it printed on other
regress/gate_arm.sh:661:# architectures -- reads it out. PULL-ONLY: nothing prints unless a session asks,
regress/gate_arm.sh:662:# so the rows elsewhere in this gate that assert an ABSENCE of output are
regress/gate_arm.sh:663:# untouched, and a free-running guest cannot be flooded.
regress/gate_arm.sh:664:#
regress/gate_arm.sh:665:# The aggregate carries the seventeen ZEROS -- exactly the claim #364 found
regress/gate_arm.sh:666:# inverted -- so a warming assumption that silently changes turns this red even
regress/gate_arm.sh:667:# though no named row below covers those rows individually.
regress/gate_arm.sh:668:lsres=$(grep -o "LSGEN_RESULT=[0-9]*/[0-9]*" "$WBLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:669:lsgot=${lsres%/*}; lswant=${lsres#*/}
regress/gate_arm.sh:670:check "writeback path rows run"     "${lswant:-missing}" 22
regress/gate_arm.sh:671:check "writeback path rows correct" "${lsgot:-missing}"  "$lswant"
regress/gate_arm.sh:672:
regress/gate_arm.sh:673:# The five rows that must ENTER the general path, named individually so one
regress/gate_arm.sh:674:# reverting cannot hide behind the total. The derivation, which matters more than
regress/gate_arm.sh:675:# the numbers: the general path's own memory_rw SELF-WARMS, so a cold row is 1
regress/gate_arm.sh:676:# and not N. The `ldrt` row is 1 despite its page being WARM, because the
regress/gate_arm.sh:677:# is_userpage test precedes the page test and a kernel `put w` insert never sets
regress/gate_arm.sh:678:# that bit -- which is what makes a T form general-path BY CONSTRUCTION and
regress/gate_arm.sh:679:# immune to any future seeding change.
regress/gate_arm.sh:680:for v in "A wb rot word cold plus1" "A wb rot word cold plus2" \
regress/gate_arm.sh:681:         "A wb rot word cold plus3" "A wb word ldrt post4 unal" \
regress/gate_arm.sh:682:         "A wb word cold pre4 unal"; do
regress/gate_arm.sh:683:    n=$(count "$WBLOG" "^$v path  .*ok\$")
regress/gate_arm.sh:684:    check "  writeback path: $v" "$n" 1
regress/gate_arm.sh:685:done
regress/gate_arm.sh:686:
regress/gate_arm.sh:687:# #358: fold-fired markers (netbsd_copyin / netbsd_copyout)
regress/gate_arm.sh:688:# -------------------------------------------------------------------------
regress/gate_arm.sh:689:# Both folds replace six user-mode transfers with one C function whose
regress/gate_arm.sh:690:# registers, addresses and instruction billing are IDENTICAL to the
regress/gate_arm.sh:691:# instructions replaced, so a row asserting their result passes whether or not
regress/gate_arm.sh:692:# the fold fires. Until #357 one witness existed -- the template masked its base
regress/gate_arm.sh:693:# writeback while these folds did not, so an unaligned base read 0x10019 folded
regress/gate_arm.sh:694:# against 0x10018 genuine -- and #357 correctly removed it by fixing the
regress/gate_arm.sh:695:# template. These two folds also had NO rows at all before this.
regress/gate_arm.sh:696:#
regress/gate_arm.sh:697:# The rows are FREE-RUNNING by necessity, not by style. Measured: a two-pass
regress/gate_arm.sh:698:# program with a breakpoint one instruction before the folded window executes the
regress/gate_arm.sh:699:# GENUINE sequence on both the default and the -J build, while the same program
regress/gate_arm.sh:700:# with no breakpoint folds -- so a breakpoint suppresses the fold. A breakpoint ON
regress/gate_arm.sh:701:# a slot is worse: that path re-marks its own slot for retranslation and the
regress/gate_arm.sh:702:# matchers test ic[i].f, so a fold can never install there. Two passes are
regress/gate_arm.sh:703:# required because the folds gate on is_userpage, which only the user-access
regress/gate_arm.sh:704:# general handler sets -- the very handler the fold's bail-out delegates to.
regress/gate_arm.sh:705:#
regress/gate_arm.sh:706:# Each fold gets a pair so neither row can be vacuous in either direction. The
regress/gate_arm.sh:707:# `fires` row demands the marker AND the verbosity echo AND the six transferred
regress/gate_arm.sh:708:# values: without the echo a session whose verbosity raise silently failed would
regress/gate_arm.sh:709:# report zero markers and look exactly like a dead fold, and without the values
regress/gate_arm.sh:710:# the row would prove a line was printed rather than that work was done. The
regress/gate_arm.sh:711:# `quiet` row asserts silence at default verbosity and must never be rewritten to
regress/gate_arm.sh:712:# drive the guest with `step` -- single-step BYPASSES debugmsg's verbosity gate.
regress/gate_arm.sh:713:#
regress/gate_arm.sh:714:# Non-vacuity proven per fold on scratch trees built from this exact source.
regress/gate_arm.sh:715:# Disabling ONLY netbsd_copyin's arming (by making its iword test unsatisfiable,
regress/gate_arm.sh:716:# which keeps the statement structure intact) gives 3 of 4, with exactly
regress/gate_arm.sh:717:# `A fold copyin fires` red and copyout's rows still green. An earlier attempt
regress/gate_arm.sh:718:# replaced the arming assignment with a comment and left a dangling `if` that
regress/gate_arm.sh:719:# swallowed the copyout arming, killing both folds -- one real reason and one
regress/gate_arm.sh:720:# artifact, which is why the break is done by constant and not by deletion.
regress/gate_arm.sh:721:FOLDLOG=$LOGDIR/gate_arm_foldmark.log
regress/gate_arm.sh:722:python3 arm_fold_marker_probe.py "$PMAX" > "$FOLDLOG" 2>&1 || true
regress/gate_arm.sh:723:
regress/gate_arm.sh:724:if ! grep -q "FOLDMARK_RESULT=" "$FOLDLOG"; then
regress/gate_arm.sh:725:    note "fold-marker probe produced no result line; last lines follow"
regress/gate_arm.sh:726:    tail -5 "$FOLDLOG" | sed 's/^/       /'
regress/gate_arm.sh:727:    gate_skip "fold-marker probe did not complete"
regress/gate_arm.sh:728:fi
regress/gate_arm.sh:729:
regress/gate_arm.sh:730:grep -E " ok$| FAIL$" "$FOLDLOG" | sed 's/^/       /'
regress/gate_arm.sh:731:
regress/gate_arm.sh:732:fres=$(grep -o "FOLDMARK_RESULT=[0-9]*/[0-9]*" "$FOLDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:733:fgot=${fres%/*}; fwant=${fres#*/}
regress/gate_arm.sh:734:#  #360: the `warm`/`cold` pairs are the LIVE controls, and the difference from
regress/gate_arm.sh:735:#  the `quiet` rows is visible in one measurement. On a build with ONLY
regress/gate_arm.sh:736:#  netbsd_copyin's arming disabled, `A fold copyin quiet` still reads **ok** --
regress/gate_arm.sh:737:#  it asserts an absence, and an absence is exactly what a dead fold produces --
regress/gate_arm.sh:738:#  while `A fold copyin cold` goes red because it asserts a DECLINE occurred
regress/gate_arm.sh:739:#  (install 1, fire 0, decline 1). Measured 5 of 8 on that build, red at exactly
regress/gate_arm.sh:740:#  the three copyin rows, with copyout's four green.
regress/gate_arm.sh:741:#
regress/gate_arm.sh:742:#  The install count is what makes the diagnosis one-read: install 0 means the
regress/gate_arm.sh:743:#  matcher declined; install 1 with fire 0 and decline 1 means the fold was
regress/gate_arm.sh:744:#  reached and turned the operands down, and the decline text names the clause.
regress/gate_arm.sh:745:#  Every arm also asserts the verbosity echo and that r0/r1 advanced by the full
regress/gate_arm.sh:746:#  six transfers -- the latter holds folded or not, so it proves the program ran
regress/gate_arm.sh:747:#  without presuming the fold, which is what stops the cold arm's zero from
regress/gate_arm.sh:748:#  being meaningless. Measured: with verbosity off the guest ran perfectly and
regress/gate_arm.sh:749:#  reported zero fires AND zero installs, so counting absences alone cannot tell
regress/gate_arm.sh:750:#  a dead fold from a broken session.
regress/gate_arm.sh:751:#  #361 adds rows for the last two folds that had #358 markers but nothing
regress/gate_arm.sh:752:#  exercising them -- the scope debt #358 was criticised for. Two shapes, and
regress/gate_arm.sh:753:#  they are NOT interchangeable:
regress/gate_arm.sh:754:#    xchg  declines at the MATCHER (install 0), because #342's `a != b` term
regress/gate_arm.sh:755:#          rejects the shape before anything is installed.
regress/gate_arm.sh:756:#    scanc declines at a GUARD (install 1, decline 1), like copyin/copyout, and
regress/gate_arm.sh:757:#          has TWO decline sites -- the second reachable only after the first
regress/gate_arm.sh:758:#          passes, since the table address is computed from the byte just loaded.
regress/gate_arm.sh:759:#          Both are exercised, with distinct reason spellings so a row can say
regress/gate_arm.sh:760:#          which page missed.
regress/gate_arm.sh:761:#
regress/gate_arm.sh:762:#  `A fold xchg selective` is one row spanning BOTH xchg arms, and it exists
regress/gate_arm.sh:763:#  because a measuring seat showed the negative arm is VACUOUS ALONE: install 0 /
regress/gate_arm.sh:764:#  fire 0 reads identically on a healthy build and on one with xchg's arming
regress/gate_arm.sh:765:#  removed, so by itself it cannot tell "the matcher rejected the shape" from
regress/gate_arm.sh:766:#  "the matcher does not exist" -- the #360 defect again. Measured on an
regress/gate_arm.sh:767:#  arming-dead build: `A fold xchg samereg` reads **ok** while
regress/gate_arm.sh:768:#  `A fold xchg selective` goes red. The rejected alternative is recorded in the
regress/gate_arm.sh:769:#  probe: relocating #342's term into the matched shape so the arm self-diagnoses
regress/gate_arm.sh:770:#  works, but it edits a shipped correction's guard for instrumentation's sake.
regress/gate_arm.sh:771:#
regress/gate_arm.sh:772:#  scanc's r3 is a genuine three-way value witness -- 0x77 is table[4] when the
regress/gate_arm.sh:773:#  fold runs, 0x66 is table[0] because an unmapped string load yields zero, and
regress/gate_arm.sh:774:#  0x00 when the table page is the missing one -- plus an r5 sentinel proving the
regress/gate_arm.sh:775:#  program reached its end. Measured: on a scanc-arming-dead build all three arms
regress/gate_arm.sh:776:#  keep byte-identical register values and only the marker triple moves, so a
regress/gate_arm.sh:777:#  value-only row would be vacuous for this fold.
regress/gate_arm.sh:778:check "fold-marker rows run"     "$fwant" 21
regress/gate_arm.sh:779:check "fold-marker rows correct" "$fgot"  "$fwant"
regress/gate_arm.sh:780:
regress/gate_arm.sh:781:# #383: the four BE rows put the copyin/copyout folds' byte-order handling on
regress/gate_arm.sh:782:# the test surface -- on barearm both folds install and fire (their matchers
regress/gate_arm.sh:783:# gate on HOST endianness, not guest), so the value rows discriminate the fix.
regress/gate_arm.sh:784:# The +1/+3 UNALIGNED copyin rows are the composition-order discriminators (a
regress/gate_arm.sh:785:# fix swapping AFTER #362's rotation passes +0 but fails these). FOLDMARK_
regress/gate_arm.sh:786:# CONTROL_BE is the fix-state-independent liveness pin (r1 ^ sl == the
regress/gate_arm.sh:787:# architectural word on every build), so a dead barearm session cannot
regress/gate_arm.sh:788:# false-green the BE group.
regress/gate_arm.sh:789:fctrlbe=$(grep -o "FOLDMARK_CONTROL_BE=[A-Z]*" "$FOLDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:790:# #384: the control pins that the barearm rig ran, both passes executed, and
regress/gate_arm.sh:791:# the rig is genuinely big-endian (an LE rig fails it). It does NOT prove the
regress/gate_arm.sh:792:# fold fired -- that is the value rows' fire==1 -- so the name does not claim it.
regress/gate_arm.sh:793:check "fold-marker BE control: barearm ran, rig is BE" "${fctrlbe:-missing}" "OK"
regress/gate_arm.sh:794:
regress/gate_arm.sh:795:for v in "A fold copyin fires" "A fold copyin quiet" \
regress/gate_arm.sh:796:         "A fold copyout fires" "A fold copyout quiet" \
regress/gate_arm.sh:797:         "A fold copyin warm" "A fold copyin cold" \
regress/gate_arm.sh:798:         "A fold copyout warm" "A fold copyout cold" \
regress/gate_arm.sh:799:         "A fold xchg fires" "A fold xchg samereg" \
regress/gate_arm.sh:800:         "A fold xchg selective" "A fold scanc fires" \
regress/gate_arm.sh:801:         "A fold scanc nostr" "A fold scanc notbl" \
regress/gate_arm.sh:802:         "A fold copyin rot plus1" "A fold copyin rot plus2" \
regress/gate_arm.sh:803:         "A fold copyin rot plus3" \
regress/gate_arm.sh:804:         "A fold copyin BE +0" "A fold copyin BE +1" \
regress/gate_arm.sh:805:         "A fold copyin BE +3" "A fold copyout BE"; do
regress/gate_arm.sh:806:    n=$(count "$FOLDLOG" "^$v  .*ok$")
regress/gate_arm.sh:807:    check "  fold-marker row: $v" "$n" 1
regress/gate_arm.sh:808:done
regress/gate_arm.sh:809:
regress/gate_arm.sh:810:for v in "A wb word post1 unal x10" "A wb word post1 algn x10" \
regress/gate_arm.sh:811:         "A wb word post4 unal" "A wb word pre4 unal gen" \
regress/gate_arm.sh:812:         "A wb word pre4 unal fast" "A wb word postneg4 unal" \
regress/gate_arm.sh:813:         "A wb store post1 unal x10" "A wb regofs post1 unal x10" \
regress/gate_arm.sh:814:         "A wb halfword post1 unal" "A wb word post4 algn" \
regress/gate_arm.sh:815:         "A wb algn load data" "A wb byte post1 unal" \
regress/gate_arm.sh:816:         "A wb word pre4 no wb" "A wb wrap from zero" \
regress/gate_arm.sh:817:         "A wb rot word unal plus1" "A wb rot word unal plus2" \
regress/gate_arm.sh:818:         "A wb rot word unal plus3" \
regress/gate_arm.sh:819:         "A wb rot word cold plus1" "A wb rot word cold plus2" \
regress/gate_arm.sh:820:         "A wb rot word cold plus3" \
regress/gate_arm.sh:821:         "A wb word ldrt post4 unal" "A wb word cold pre4 unal"; do
regress/gate_arm.sh:822:    n=$(count "$WBLOG" "^$v  .*ok$")
regress/gate_arm.sh:823:    check "  writeback row: $v" "$n" 1
regress/gate_arm.sh:824:done
regress/gate_arm.sh:825:
regress/gate_arm.sh:826:# #372: the general-path word STORE ignored cpu->byte_order.
regress/gate_arm.sh:827:# ----------------------------------------------------------------------------
regress/gate_arm.sh:828:# Its arm was UNCONDITIONALLY EMPTY -- guard `!A__B && !A__H && HOST_LE` with an
regress/gate_arm.sh:829:# `#ifdef A__STRD`-only body, and A__STRD implies A__H, which the guard excludes.
regress/gate_arm.sh:830:# So a plain word STR on an LE host emitted no bytes and memory_rw copied the
regress/gate_arm.sh:831:# register's HOST bytes; the FAST path was always order-aware, so one STR wrote
regress/gate_arm.sh:832:# guest order to a warm page and host order to a cold one, and every strt (always
regress/gate_arm.sh:833:# general on its first access per page) was reversed.
regress/gate_arm.sh:834:#
regress/gate_arm.sh:835:# This probe runs BOTH byte orders. The six `be *` rows use -E barearm (BE) and
regress/gate_arm.sh:836:# are the DISCriminators; the six `le *` rows use -E testarm (LE) and are
regress/gate_arm.sh:837:# INVARIANCE CONTROLS -- on LE the broken code was accidentally right (host order
regress/gate_arm.sh:838:# == guest order), so they pin nothing about #372 and exist only to catch a fix
regress/gate_arm.sh:839:# that repairs BE by breaking LE. The `ldrb` witnesses are the purest form: a
regress/gate_arm.sh:840:# byte load has no byte order, so it exposes the raw memory layout directly, and
regress/gate_arm.sh:841:# the buggy column is the exact reverse of the arch column.
regress/gate_arm.sh:842:#
regress/gate_arm.sh:843:# #372's original sweep (its SIX BE + six LE rows): pre-fix 7 of 12 -- the five
regress/gate_arm.sh:844:# cold BE rows red at the host-order values, the warm control and LE controls
regress/gate_arm.sh:845:# green. Fixed: 12/12. #378 grew the section to 34 rows (22 BE / 12 LE) with the
regress/gate_arm.sh:846:# INVERTED polarity -- its sweep numbers are in the named-row comment below; the
regress/gate_arm.sh:847:# 12-row narrative above this line is #372 history, scoped as such by #379.
regress/gate_arm.sh:848:# #386 grew it to 58: swp (the last word-sized ARM memory handler, LE-only on
regress/gate_arm.sh:849:# both sides + raw unmasked address) and its swpb/aligned-LE/by-construction
regress/gate_arm.sh:850:# controls; sweep numbers in the named-row comment below.
regress/gate_arm.sh:851:ENDLOG=$LOGDIR/gate_arm_endian.log
regress/gate_arm.sh:852:python3 arm_endian_probe.py "$PMAX" > "$ENDLOG" 2>&1 || true
regress/gate_arm.sh:853:
regress/gate_arm.sh:854:if ! grep -q "ENDIAN_RESULT=" "$ENDLOG"; then
regress/gate_arm.sh:855:    note "endian probe produced no result line; last lines follow"
regress/gate_arm.sh:856:    tail -5 "$ENDLOG" | sed 's/^/       /'
regress/gate_arm.sh:857:    gate_skip "endian probe did not complete"
regress/gate_arm.sh:858:fi
regress/gate_arm.sh:859:
regress/gate_arm.sh:860:grep -E " ok$| FAIL$" "$ENDLOG" | sed 's/^/       /'
regress/gate_arm.sh:861:
regress/gate_arm.sh:862:# The control is the BE cold-word row's SIBLING warm row: it demands a
regress/gate_arm.sh:863:# distinctive nonzero word through the order-aware fast path, proving the BE rig
regress/gate_arm.sh:864:# (barearm) constructed and the program ran, before any DISC row is believed.
regress/gate_arm.sh:865:ectrl=$(grep -o "ENDIAN_CONTROL=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:866:check "endian control: BE rig ran and stored" "${ectrl:-missing}" "OK"
regress/gate_arm.sh:867:
regress/gate_arm.sh:868:# #378's own liveness pin: the multi-transfer cold rows go through bdt_*, which
regress/gate_arm.sh:869:# swaps on EVERY build, so they read arch values on buggy and fixed builds
regress/gate_arm.sh:870:# alike -- a dead rig, wrong register field or non-firing LDM reads 0/sentinel
regress/gate_arm.sh:871:# instead. Distinct from ENDIAN_CONTROL so the two extensions fail separately.
regress/gate_arm.sh:872:ectrl378=$(grep -o "ENDIAN_CONTROL378=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:873:check "endian control: multi rows ran (378)" "${ectrl378:-missing}" "OK"
regress/gate_arm.sh:874:
regress/gate_arm.sh:875:# #379: the warm DISC rows depend on `put w` having warmed the pages, and a
regress/gate_arm.sh:876:# silently failing put would flip them all to a FALSE GREEN on a buggy build
regress/gate_arm.sh:877:# (bdt_* is architecturally correct on both arms). The probe checks every
regress/gate_arm.sh:878:# put's echo for the debugger's FAILED marker.
regress/gate_arm.sh:879:eputs=$(grep -o "PUT_STATUS=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:880:check "endian puts all landed (379)" "${eputs:-missing}" "OK"
regress/gate_arm.sh:881:
regress/gate_arm.sh:882:eres=$(grep -o "ENDIAN_RESULT=[0-9]*/[0-9]*" "$ENDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:883:egot=${eres%/*}; ewant=${eres#*/}
regress/gate_arm.sh:884:#  #389's liveness pin: the LE LDRD/STRD rows are fix-state-independent (LE
regress/gate_arm.sh:885:#  was always correct) and read the sentinel 0 if the instructions are dead.
regress/gate_arm.sh:886:ectrld=$(grep -o "ENDIAN_CONTROL_D=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
regress/gate_arm.sh:887:#  #389 pass-2 (Opus seat): the name used to read "ldrd/strd ran", which
regress/gate_arm.sh:888:#  overclaimed -- BOTH pins behind ENDIAN_CONTROL_D are on the LE rig
regress/gate_arm.sh:889:#  (testarm), so nothing here pins that LDRD/STRD executed on barearm. That is
regress/gate_arm.sh:890:#  not a fixable omission: a liveness pin must be fix-state-INDEPENDENT, and on
regress/gate_arm.sh:891:#  BE every LDRD/STRD row changes value with the fix by construction. The BE
regress/gate_arm.sh:892:#  side is still fail-closed -- a dead BE rig reddens its ten DISC rows -- but
regress/gate_arm.sh:893:#  the NAME must say what it actually pins.
regress/gate_arm.sh:894:check "endian control: ldrd/strd ran on the LE rig (389)" "${ectrld:-missing}" "OK"
regress/gate_arm.sh:895:
regress/gate_arm.sh:896:check "endian rows run"     "${ewant:-missing}" 102
regress/gate_arm.sh:897:check "endian rows correct" "${egot:-missing}"  "$ewant"
regress/gate_arm.sh:898:
regress/gate_arm.sh:899:# The BE discriminators named individually, so one reverting cannot hide
regress/gate_arm.sh:900:# behind the total. #372's DISC rows are the COLD ones (general path was
regress/gate_arm.sh:901:# wrong); #378's DISC rows are the WARM ones (LDM/STM fast path was wrong) --
regress/gate_arm.sh:902:# the inverted polarity is the point, and the probe carries explicit per-row
regress/gate_arm.sh:903:# kinds for exactly that reason. Swept against the pre-#378 build: 24/34, the
regress/gate_arm.sh:904:# ten warm multi rows red at exactly the per-word-reversed values. Fixed: 34/34.
regress/gate_arm.sh:905:# #386 grew the section 34 -> 58 (swp/swpb; X(swp) was LE-only both sides and
regress/gate_arm.sh:906:# unrotated/unmasked). Swept against the pre-#386 build: 42/58, all 16 DISC
regress/gate_arm.sh:907:# rows red at exactly the predicted buggy values. Fixed: 58/58. The LE unal
regress/gate_arm.sh:908:# rows are DISC too (the manual's rotation is endian-independent, so the fix
regress/gate_arm.sh:909:# MOVES them); "swp be unal b2" is arch==buggy by construction (bits[15:8]
regress/gate_arm.sh:910:# lands at P+2 under both the buggy +1-shifted LE write and the fixed BE
regress/gate_arm.sh:911:# write) and is deliberately NOT in this list.
regress/gate_arm.sh:912:# #387 grew it 58 -> 70: the +2 offset groups, because three wrong forms
regress/gate_arm.sh:913:# AGREE with the shipped code at +1 and aligned -- `8*(addr&1)`, a raw-odd
regress/gate_arm.sh:914:# rotate guard, and an `addr &= ~1` mask -- and all three passed the 58-row
regress/gate_arm.sh:915:# set (the fold-marker probe's three-offsets rule). Every +2 row is DISC
regress/gate_arm.sh:916:# (the +1 b2 collision does not recur at +2). Measured: each hole-mutant
regress/gate_arm.sh:917:# reddens the +2 rows while the +1 rows stay green (68/68/58 of 70).
regress/gate_arm.sh:918:# The pattern below also pins each named row's KIND (DISC): re-typing a red
regress/gate_arm.sh:919:# discriminator as CTRL with arch=buggy would otherwise keep the name green
regress/gate_arm.sh:920:# -- the "shipped fix with no detector" vacuity mode, closed for free here.
regress/gate_arm.sh:921:for v in "be cold word" "be cold byte0" "be cold byte1" \
regress/gate_arm.sh:922:         "be cold byte2" "be cold byte3" \
regress/gate_arm.sh:923:         "be stm warm b0" "be stm warm b1" "be stm warm b2" "be stm warm b3" \
regress/gate_arm.sh:924:         "be stm warm b4" "be stm warm b5" "be stm warm b6" "be stm warm b7" \
regress/gate_arm.sh:925:         "be ldm warm r1" "be ldm warm r2" \
regress/gate_arm.sh:926:         "swp be word" "swp be b0" "swp be b1" "swp be b2" "swp be b3" \
regress/gate_arm.sh:927:         "swp be unal r2" "swp be unal b0" "swp be unal b1" \
regress/gate_arm.sh:928:         "swp be unal b3" "swp be unal sent" \
regress/gate_arm.sh:929:         "swp le unal r2" "swp le unal b0" "swp le unal b1" \
regress/gate_arm.sh:930:         "swp le unal b2" "swp le unal b3" "swp le unal sent" \
regress/gate_arm.sh:931:         "swp be un2 r2" "swp be un2 b0" "swp be un2 b1" \
regress/gate_arm.sh:932:         "swp be un2 b2" "swp be un2 b3" "swp be un2 sent" \
regress/gate_arm.sh:933:         "swp le un2 r2" "swp le un2 b0" "swp le un2 b1" \
regress/gate_arm.sh:934:         "swp le un2 b2" "swp le un2 b3" "swp le un2 sent" \
regress/gate_arm.sh:935:         "ldrd be r4" "ldrd be r5" \
regress/gate_arm.sh:936:         "strd be b0" "strd be b1" "strd be b2" "strd be b3" \
regress/gate_arm.sh:937:         "strd be b4" "strd be b5" "strd be b6" "strd be b7" \
regress/gate_arm.sh:938:         "390 be base +8" "390 be base +12" \
regress/gate_arm.sh:939:         "390 le base +8" "390 le base +12" \
regress/gate_arm.sh:940:         "390 be bothpc" "390 le bothpc"; do
regress/gate_arm.sh:941:    n=$(count "$ENDLOG" "^$v  *DISC .*ok$")
regress/gate_arm.sh:942:    check "  endian row: $v" "$n" 1
regress/gate_arm.sh:943:done
regress/gate_arm.sh:944:
regress/gate_arm.sh:945:#  #390's CTRL rows, pinned by name so they cannot be quietly retyped or
regress/gate_arm.sh:946:#  dropped -- a DISC pattern would never match them.  Two different reasons:
regress/gate_arm.sh:947:#
regress/gate_arm.sh:948:#  the DATA-role rows must pass on the PRE-fix build too, because they do not
regress/gate_arm.sh:949:#  detect the defect; they detect a WRONG FIX that moves the stored R15 value
regress/gate_arm.sh:950:#  off +12, which A2-9 forbids doing for some R15 stores and not others.
regress/gate_arm.sh:951:#
regress/gate_arm.sh:952:#  the LDRD rows are CTRL because the round's original claim about them was
regress/gate_arm.sh:953:#  REFUTED by measurement: LDRD's base was never +12.  They began as DISC with
regress/gate_arm.sh:954:#  a `buggy` column that turned out to be fiction -- the mutant battery left
regress/gate_arm.sh:955:#  them green, and the actual pre-#390 parent reads the same values the fixed
regress/gate_arm.sh:956:#  build does.  They are kept as standing evidence that LDRD with Rn == PC is
regress/gate_arm.sh:957:#  unaffected, and they will redden if a future round drags it into that path.
regress/gate_arm.sh:958:for v in "390 be data +12" "390 le data +12" \
regress/gate_arm.sh:959:         "390 be ldrd r0" "390 be ldrd r1" \
regress/gate_arm.sh:960:         "390 le ldrd r0" "390 le ldrd r1"; do
regress/gate_arm.sh:961:    n=$(count "$ENDLOG" "^$v  *CTRL .*ok$")
regress/gate_arm.sh:962:    check "  endian row: $v" "$n" 1
regress/gate_arm.sh:963:done
regress/gate_arm.sh:964:
regress/gate_arm.sh:965:# ---------------------------------------------------------------------------
regress/gate_arm.sh:966:#  #432: THE FOOTBRIDGE'S FIRST REACHABILITY WITNESS OF ANY KIND.
regress/gate_arm.sh:967:#
regress/gate_arm.sh:968:#  Recorded before this probe existed: R6 was the ONLY code round in this tree with no
regress/gate_arm.sh:969:#  reachability witness -- no rig boots a footbridge machine and there is no m8online analog.
regress/gate_arm.sh:970:#  regress/diff_footbridge.c calls the device functions DIRECTLY, so it proves BEHAVIOUR and
regress/gate_arm.sh:971:#  would stay green under a change that unmapped the device entirely.  This drives real guest
regress/gate_arm.sh:972:#  ldr/str through the real address decode and the real memory_rw plumbing on a COLD DEBUGGER:
regress/gate_arm.sh:973:#  measured 1.9 s for three arms, against a rig boot this tree does not have at all.
regress/gate_arm.sh:974:#
regress/gate_arm.sh:975:#  IT LIVES HERE, in the ARM gate, for the same reason m8820x_sites_probe.py lives in
regress/gate_arm.sh:976:#  gate_m88k_rounding.sh: `cats` is an ARM machine and this gate already writes the four-byte
regress/gate_arm.sh:977:#  raw stub that makes such a machine construct.  A new gate script would move GATE_MANIFEST,
regress/gate_arm.sh:978:#  which is a bigger claim than one probe is worth.
regress/gate_arm.sh:979:#
regress/gate_arm.sh:980:#  THE TRAP IT GUARDS, and it nearly produced a confident wrong answer.  machine_cats.c:131
regress/gate_arm.sh:981:#  maps only the low 256 MB and the footbridge is at PA 0x42000000, so under the boot-time MMU
regress/gate_arm.sh:982:#  every device row reads 0x0 WITH A RAM LIVENESS ROW STILL GREEN -- which is exactly what an
regress/gate_arm.sh:983:#  absent device looks like.  The probe's arm T runs the same program with the MMU-disable
regress/gate_arm.sh:984:#  instructions replaced by nops and requires that it CANNOT produce the device's answer; arm L
regress/gate_arm.sh:985:#  reads CP15 c1 back and requires bit 0 clear.  Negative-controlled in both directions.
regress/gate_arm.sh:986:FBLOG=$LOGDIR/footbridge_sites.log
regress/gate_arm.sh:987:python3 footbridge_sites_probe.py "$PMAX" "$STUB" > "$FBLOG" 2>&1 || true
regress/gate_arm.sh:988:grep -E "^(  arm |C[0-9]|A[0-9]|I1|K1|D1)" "$FBLOG" | sed 's/^/       /'
regress/gate_arm.sh:989:
regress/gate_arm.sh:990:if ! grep -q "FOOTBRIDGE_SITES_" "$FBLOG"; then
regress/gate_arm.sh:991:    note "footbridge probe produced no verdict; last lines follow"
regress/gate_arm.sh:992:    tail -5 "$FBLOG" | sed 's/^/       /'
regress/gate_arm.sh:993:    check "footbridge probe completed" "no" "yes"
regress/gate_arm.sh:994:else
regress/gate_arm.sh:995:    #  THE CONTROL FIRST, and separately from the verdict.  A probe whose controls failed has
regress/gate_arm.sh:996:    #  measured NOTHING, and this one has a control that a liveness row cannot substitute for.
regress/gate_arm.sh:997:    check "footbridge: controls prove the probe measures" \
regress/gate_arm.sh:998:          "$(grep -c 'FOOTBRIDGE_SITES_CONTROL=OK' "$FBLOG")" "1"
regress/gate_arm.sh:999:    check "footbridge: every row green" \
regress/gate_arm.sh:1000:          "$(grep -c 'FOOTBRIDGE_SITES_PASS' "$FBLOG")" "1"
regress/gate_arm.sh:1001:    #  VALUES, NOT SURVIVAL.  0x1011 is DC21285_VENDOR_ID (dev_footbridge.c:423) and can only
regress/gate_arm.sh:1002:    #  have come back through this device; an unmapped read survives too, it just returns 0.
regress/gate_arm.sh:1003:    check "footbridge: VENDOR_ID 0x1011 through a real guest ldr" \
regress/gate_arm.sh:1004:          "$(grep -cE '^A1 .*got=0x00001011 .*ok$' "$FBLOG")" "1"
regress/gate_arm.sh:1005:    #  The vanishing top byte IS the handler's signature: :548 stores idata & TIMER_MAX_VAL.
regress/gate_arm.sh:1006:    #  RAM, or any decode that merely absorbed the store, returns 0x12345678 unchanged.
regress/gate_arm.sh:1007:    check "footbridge: TIMER_1_LOAD masked to 24 bits by the handler" \
regress/gate_arm.sh:1008:          "$(grep -cE '^A2 .*got=0x00345678 .*ok$' "$FBLOG")" "1"
regress/gate_arm.sh:1009:    #  THE PROBE'S OWN FAILABILITY CONTROL.  Arms L and K differ by ONE instruction; K reads
regress/gate_arm.sh:1010:    #  IRQ_ENABLE_SET, an UNFIXED fatal()+exit(1) at :495-497.  Without it, "SURVIVED" on every
regress/gate_arm.sh:1011:    #  row is satisfied by a probe whose guest code never reached the device at all.
regress/gate_arm.sh:1012:    check "footbridge: the one-instruction kill arm still dies" \
regress/gate_arm.sh:1013:          "$(grep -cE '^K1 .*ok$' "$FBLOG")" "1"
regress/gate_arm.sh:1014:    #  The defence against the hand-assembled-encoding trap: every planted word is compared
regress/gate_arm.sh:1015:    #  against the disassembly the emulator printed AS IT STEPPED IT.
regress/gate_arm.sh:1016:    check "footbridge: no planted word failed its disassembly check" \
regress/gate_arm.sh:1017:          "$(grep -c 'DISASSEMBLY MISMATCH' "$FBLOG")" "0"
regress/gate_arm.sh:1018:fi
regress/gate_arm.sh:1019:
regress/gate_arm.sh:1020:#  ---------------------------------------------------------------------------------------
regress/gate_arm.sh:1021:#  #439/#440 PIT 8253 latch + LSB/MSB selector -- pitlatch / pitclobber.
regress/gate_arm.sh:1022:#
regress/gate_arm.sh:1023:#  WIRED HERE, ALONGSIDE footbridge_sites_probe.py, BECAUSE gate_hygiene.sh SAID SO.  Its
regress/gate_arm.sh:1024:#  own 17 -> 18 bump note reads: "Wiring it into gate_arm.sh alongside
regress/gate_arm.sh:1025:#  footbridge_sites_probe.py is the follow-up, and it wants an operator who can run that
regress/gate_arm.sh:1026:#  gate."  The probe execs `-E cats` and hand-assembles ARM, so this is the only gate whose
regress/gate_arm.sh:1027:#  machine it shares.
regress/gate_arm.sh:1028:#
regress/gate_arm.sh:1029:#  *** IT SHIPPED UNWIRED AND THE CARRIER SAID WHY THAT IS DANGEROUS: an unwired probe is
regress/gate_arm.sh:1030:#  exactly what shipped latent in cf4b083. ***  It has been dated-exempt in
regress/gate_arm.sh:1031:#  check_probe_wiring.py until 2026-09-20 (`wiringcliff`), and this discharges that debt --
regress/gate_arm.sh:1032:#  the exemption line comes out in the same edit, which is what stops a stale exemption
regress/gate_arm.sh:1033:#  outliving its cause.
regress/gate_arm.sh:1034:#
regress/gate_arm.sh:1035:#  CONTROLS FIRST AND SEPARATELY.  The probe's own header says it: "CONTROLS (if any is RED
regress/gate_arm.sh:1036:#  every row below is meaningless)".  C1 is a RAM liveness through the same decode, C2 reads
regress/gate_arm.sh:1037:#  CP15 c1 back to prove the MMU really went off, A1 is a device signature -- and arm T is
regress/gate_arm.sh:1038:#  the negative control that runs the same program with the MMU-disable instructions
regress/gate_arm.sh:1039:#  replaced by nops and requires it CANNOT produce the device's answer.  Under the boot-time
regress/gate_arm.sh:1040:#  MMU the low 256 MB alone is mapped, so a device row reads 0x0 WITH A LIVENESS ROW STILL
regress/gate_arm.sh:1041:#  GREEN, which is indistinguishable from an absent device.  That is why C2 and T exist and
regress/gate_arm.sh:1042:#  why a liveness row cannot stand in for them.
regress/gate_arm.sh:1043:#  ---------------------------------------------------------------- #497 widthkillclass
regress/gate_arm.sh:1044:#  *** THIS PROBE IS FOR AN SGI/MIPS MACHINE AND IT IS WIRED INTO THE GATE NAMED `arm`.
regress/gate_arm.sh:1045:#  That is following a precedent, not endorsing it. ***  This gate already runs
regress/gate_arm.sh:1046:#  footbridge_sites_probe.py and pit8253_latch_probe.py -- neither of which is an ARM
regress/gate_arm.sh:1047:#  instruction test either -- so it has become the tree's general DEVICE-probe gate by
regress/gate_arm.sh:1048:#  accretion.  *** BUT THOSE TWO AT LEAST RUN THIS GATE'S OWN `-E cats` MACHINE, AND
regress/gate_arm.sh:1049:#  THIS ONE DOES NOT: it is the FIRST probe here on a foreign machine AND CPU family.
regress/gate_arm.sh:1050:#  The PIT wiring comment says outright that it was placed here BECAUSE this is the only
regress/gate_arm.sh:1051:#  gate whose machine it shares. ***  So this is not a third instance of an existing
regress/gate_arm.sh:1052:#  accretion; it is a new kind of one, and the sentence above is true while its
regress/gate_arm.sh:1053:#  implication was generous to the decision it defends.  The architecture-named alternative, gate_mips.sh, is an 82-line RIG-BOOT
regress/gate_arm.sh:1054:#  gate with no probe infrastructure at all; putting a 35-row detector there would change
regress/gate_arm.sh:1055:#  what that gate is for.
regress/gate_arm.sh:1056:#
regress/gate_arm.sh:1057:#  Recorded rather than silently compounded: the right answer is a gate_devices.sh split,
regress/gate_arm.sh:1058:#  which is a harness round of its own and owes its own controls.  FILED as
regress/gate_arm.sh:1059:#  `gatedevicesplit`, with a forcing criterion: the NEXT device probe wired into
regress/gate_arm.sh:1060:#  this gate converts it from filed to OWED.
regress/gate_arm.sh:1061:#  *** #498 sgidewidth.  WIRING THIS PROBE FIRES A PRE-SPECIFIED TRIGGER, AND THE TRIGGER
regress/gate_arm.sh:1062:#  IS HONOURED RATHER THAN QUIETLY PASSED. ***  The #497 block below filed `gatedevicesplit`
regress/gate_arm.sh:1063:#  with a forcing criterion in its own words: "the NEXT device probe wired into this gate
regress/gate_arm.sh:1064:#  converts it from filed to OWED."  This is that probe.  The row is moved to OWED in the
regress/gate_arm.sh:1065:#  same commit -- a criterion that fires and is ignored is worse than one never written,
regress/gate_arm.sh:1066:#  because the next reader trusts it.
regress/gate_arm.sh:1067:#
regress/gate_arm.sh:1068:#  It is wired HERE anyway, and deliberately: the split is a harness round owing its own
regress/gate_arm.sh:1069:#  controls, and holding a HIGH device fix hostage to a gate refactor would be the tail
regress/gate_arm.sh:1070:#  wagging the dog.  What is NOT acceptable is compounding it silently.
regress/gate_arm.sh:1071:DEWLOG=$LOGDIR/sgi_de_width.log
regress/gate_arm.sh:1072:python3 sgi_de_width_probe.py "$PMAX" gate > "$DEWLOG" 2>&1 || true
regress/gate_arm.sh:1073:
regress/gate_arm.sh:1074:#  SENTINEL FIRST -- a preserved log is verified by its completion sentinel, never by its
regress/gate_arm.sh:1075:#  existence.  A killed run loses every row and looks exactly like one that produced none.
regress/gate_arm.sh:1076:if ! grep -q "OPUS498T_DONE" "$DEWLOG"; then
regress/gate_arm.sh:1077:    note "sgi_de width probe did not reach its completion sentinel; last lines follow"
regress/gate_arm.sh:1078:    tail -5 "$DEWLOG" | sed 's/^/       /'
regress/gate_arm.sh:1079:    check "sgi_de width probe completed" "no" "yes"
regress/gate_arm.sh:1080:else
regress/gate_arm.sh:1081:    check "sgi_de width probe completed" "yes" "yes"
regress/gate_arm.sh:1082:
regress/gate_arm.sh:1083:    #  CONTROLS BY NAME.  A detector whose liveness and device-signature rows are dead
regress/gate_arm.sh:1084:    #  scores well on a corpse: every access row would read "no message" and pass.
regress/gate_arm.sh:1085:    check "sgi_de controls live+devsig" \
regress/gate_arm.sh:1086:          "$(grep -q 'OPUS498T_CONTROL=OK' "$DEWLOG" && echo yes || echo no)" "yes"
regress/gate_arm.sh:1087:
regress/gate_arm.sh:1088:    #  PER-ROW PASS, one line, checked individually.  A row that silently stops being
regress/gate_arm.sh:1089:    #  tested is the padded-column class -- a name as long as its column makes the check
regress/gate_arm.sh:1090:    #  unsatisfiable and the row quietly stops being tested.
regress/gate_arm.sh:1091:    #  *** `tail_acc_x' PINS A HOST DEATH ON PURPOSE AND WILL GO RED BY SUCCEEDING. ***
regress/gate_arm.sh:1092:    #  It observes `sgideprimop' -- an accepted-width access with startFlag reaches
regress/gate_arm.sh:1093:    #  draw_primitive(), whose default arm is fatal on 254 of 256 top-byte op classes,
regress/gate_arm.sh:1094:    #  two of which (POINT 0x00, TRIANGLE 0x02) are DOCUMENTED primitives.
regress/gate_arm.sh:1095:    #
regress/gate_arm.sh:1096:    #  *** THE BLAST RADIUS HAS THREE TIERS, NOT ONE, AND THIS NOTE SAID `BOTH ROWS' UNTIL
regress/gate_arm.sh:1097:    #  2026-08-31.  Corrected after the grok seat read the oracles against the code paths
regress/gate_arm.sh:1098:    #  they exercise and found the overstatement. ***
regress/gate_arm.sh:1099:    #
regress/gate_arm.sh:1100:    #    tail_acc_x            CERTAIN red -- wants exit1, and the fix removes the death.
regress/gate_arm.sh:1101:    #    tail_acc              CONDITIONAL -- it counts the DRAW message SUBSTRING and
regress/gate_arm.sh:1102:    #                          wants 1.  A fix that LATCHES the text without REWORDING it
regress/gate_arm.sh:1103:    #                          still prints the first occurrence, so the row stays GREEN.
regress/gate_arm.sh:1104:    #                          It reds only if the message is reworded.
regress/gate_arm.sh:1105:    #    hi_draw, hi_rd_draw   NEITHER red NOR safe.  Both want count(DRAW) == 0, so a
regress/gate_arm.sh:1106:    #                          REWORD leaves them green because the string no longer
regress/gate_arm.sh:1107:    #                          exists -- GREEN FOR THE WRONG REASON, i.e. VACUOUS BY
regress/gate_arm.sh:1108:    #                          CONSTRUCTION.  A reword silently blinds them; it does not
regress/gate_arm.sh:1109:    #                          fail them, and nothing would say so.
regress/gate_arm.sh:1110:    #
regress/gate_arm.sh:1111:    #  *** SO THE DESIGN CONSTRAINT IS: KEEP THE MESSAGE TEXT AND ADD `(once)'. ***  That
regress/gate_arm.sh:1112:    #  costs ONE oracle re-pin (tail_acc_x).  Rewording costs two re-pins AND silently
regress/gate_arm.sh:1113:    #  blinds two further rows -- which is the worse half and is invisible to any gate.
regress/gate_arm.sh:1114:    #  *** AND THE OBVIOUS RE-PIN IS A TRAP.  DO NOT RE-PIN `tail_acc_x' ONTO `"exit0"'. ***
regress/gate_arm.sh:1115:    #  Adjudicated 2026-08-31 by the flagship seat, which traced the channel rather than the
regress/gate_arm.sh:1116:    #  intent.  The row wants `exit1' today; the natural correction is `exit0' ("the host now
regress/gate_arm.sh:1117:    #  survives").  Trace what that oracle can see:
regress/gate_arm.sh:1118:    #
regress/gate_arm.sh:1119:    #    a future one-token death reinstatement -- `exit(0)' at the default arm instead of
regress/gate_arm.sh:1120:    #    `exit(1)' -- prints the announce once and then DIES.  `how' is then "exit0", so a
regress/gate_arm.sh:1121:    #    re-pinned tail_acc_x reads GREEN; `tail_acc' still counts its one message, GREEN;
regress/gate_arm.sh:1122:    #    and no other session reaches draw_primitive() at all.  TOTAL ESCAPE, 29/29.
regress/gate_arm.sh:1123:    #
regress/gate_arm.sh:1124:    #  So the re-pin would MINT, at the exact site being fixed, the exact blindness the queue
regress/gate_arm.sh:1125:    #  row `exit0oracle' was filed to describe: EXIT STATUS CANNOT VARY between `declined and
regress/gate_arm.sh:1126:    #  then quit' and `died with status 0'.  That is knowable at WRITING time from the CHANNEL
regress/gate_arm.sh:1127:    #  check -- name the mutant a row kills and the observable that differs under it -- and it
regress/gate_arm.sh:1128:    #  is why that check is run before the table, not after.
regress/gate_arm.sh:1129:    #
regress/gate_arm.sh:1130:    #  RE-PIN ONTO A POSITIVE POST-DRAW OBSERVABLE INSTEAD: extend the session with a load
regress/gate_arm.sh:1131:    #  through the device and assert the VALUE (`printed()' already exists in the probe and
regress/gate_arm.sh:1132:    #  reads "died" when the host is gone).  An exit-status row may stay as a SECOND channel;
regress/gate_arm.sh:1133:    #  the value row is the load-bearing one.  This is L1 -- a row under construction -- so
regress/gate_arm.sh:1134:    #  there is no stopping-rule tension in fixing it in-round.
regress/gate_arm.sh:1135:    #
regress/gate_arm.sh:1136:    #  The fixing round therefore owes a FOURTH mutant beside the three already enumerated:
regress/gate_arm.sh:1137:    #  death-by-`exit(0)' at the default arm, which the re-pinned row must kill.
regress/gate_arm.sh:1138:    #
regress/gate_arm.sh:1139:    #  Oracle-correction ordering applies -- re-pin FIRST, measure the committed build red,
regress/gate_arm.sh:1140:    #  THEN edit.  Without this note the red reads as a regression in THIS device.
regress/gate_arm.sh:1141:    for v in "live" "devsig" "lo_kill" "lo_decl" "lo_alive" "lo_sent" "lo_latch" "lo_kill2" "lo_decl2" "lo_alive2" "lo_sent2" "hi_draw" "hi_alive" "hi_rd_draw" "hi_rd_alive" "hi_rd_sent" "two_widths_n" "two_widths_1" "two_widths_2" "dec_switch" "hi_kill" "tail_acc" "tail_acc_x" "tail_acc_h" "acc4_last" "acc8_hi32" "acc8_lo32" "acc8_read" "re_first" "sharedlatch"; do
regress/gate_arm.sh:1142:        check "sgi_de row: $v" "$(count "$DEWLOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1143:    done
regress/gate_arm.sh:1144:
regress/gate_arm.sh:1145:    #  DENOMINATOR, SUMMED ARITHMETICALLY.  Two rows, not one: a single "22 ok" check
regress/gate_arm.sh:1146:    #  cannot tell a LOST row from a FAILING one, and those need different responses.
regress/gate_arm.sh:1147:    #  The sum is arithmetic rather than a string join -- concatenating two counts and
regress/gate_arm.sh:1148:    #  comparing to "220" is satisfied by (22 ok, 0 FAIL) AND by (2 ok, 20 FAIL), which
regress/gate_arm.sh:1149:    #  is a defect this gate has already shipped once.
regress/gate_arm.sh:1150:    check "sgi_de rows emitted" \
regress/gate_arm.sh:1151:          "$(( $(count "$DEWLOG" " ok$") + $(count "$DEWLOG" " FAIL$") ))" "30"
regress/gate_arm.sh:1152:    check "sgi_de rows green" "$(count "$DEWLOG" " ok$")" "30"
regress/gate_arm.sh:1153:fi
regress/gate_arm.sh:1154:
regress/gate_arm.sh:1155:SGILOG=$LOGDIR/sgi_re_width.log
regress/gate_arm.sh:1156:python3 sgi_re_width_probe.py "$PMAX" gate > "$SGILOG" 2>&1 || true
regress/gate_arm.sh:1157:
regress/gate_arm.sh:1158:#  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
regress/gate_arm.sh:1159:#  existence: a killed run loses every row and looks exactly like a run that produced none.
regress/gate_arm.sh:1160:if ! grep -q "OPUS497T_DONE" "$SGILOG"; then
regress/gate_arm.sh:1161:    note "sgi_re width probe did not reach its completion sentinel; last lines follow"
regress/gate_arm.sh:1162:    tail -5 "$SGILOG" | sed 's/^/       /'
regress/gate_arm.sh:1163:    check "sgi_re width probe completed" "no" "yes"
regress/gate_arm.sh:1164:else
regress/gate_arm.sh:1165:    grep -E " ok$| FAIL$" "$SGILOG" | sed 's/^/       /'
regress/gate_arm.sh:1166:
regress/gate_arm.sh:1167:    #  CONTROLS BY NAME, not by count.  A green-row total lets a control go red while the
regress/gate_arm.sh:1168:    #  sum stays acceptable -- and a run whose controls died is an APPARATUS failure, which
regress/gate_arm.sh:1169:    #  must not be read as a wall of product failures.
regress/gate_arm.sh:1170:    for c in "live" "live64" "devsig stat"; do
regress/gate_arm.sh:1171:        check "sgi_re control: $c" "$(count "$SGILOG" "^$c  .*ok$")" "1"
regress/gate_arm.sh:1172:    done
regress/gate_arm.sh:1173:    check "sgi_re controls live" \
regress/gate_arm.sh:1174:          "$(grep -q 'OPUS497T_CONTROL=OK' "$SGILOG" && echo yes || echo no)" "yes"
regress/gate_arm.sh:1175:
regress/gate_arm.sh:1176:    #  PER-ROW PASS.  Checked individually rather than by a total, because a row that
regress/gate_arm.sh:1177:    #  silently stops being tested is the padded-column class: a name as long as its column
regress/gate_arm.sh:1178:    #  makes a check UNSATISFIABLE and the row quietly stops being tested.
regress/gate_arm.sh:1179:    #  The list is ONE LINE on purpose -- a backslash-continued list assembled through
regress/gate_arm.sh:1180:    #  nested quoting once gained a bogus word `n` and shipped a RED gate.
regress/gate_arm.sh:1181:    for v in "live" "devsig stat" "tlb_a sw surv" "tlb_a sw lat1" "tlb_a lw surv" "tlb_a accept" "tlb_b sw surv" "tlb_b sw lat1" "tlb_b lw surv" "tlb_b accept" "tlb_c sw surv" "tlb_c sw lat1" "tlb_c lw surv" "tlb_c accept" "tex sw surv" "tex sw lat1" "tex lw surv" "tex accept" "linear_a sw surv" "linear_a sw lat1" "linear_a lw surv" "linear_a accept" "linear_b sw surv" "linear_b sw lat1" "linear_b lw surv" "linear_b accept" "xsite 6msg" "xsite order" "other decl" "live64" "tlb_a ld lo" "tlb_a ld hi" "tlb_b ld lo" "tlb_b ld hi" "tlb_c ld lo" "tlb_c ld hi" "linear_a ld lo" "linear_a ld hi" "linear_b ld lo" "linear_b ld hi" "tex ld lo" "tex ld hi" "tex rd lat1" "tex xbit" "tex/unmap" "unmap/tex"; do
regress/gate_arm.sh:1182:        check "sgi_re row: $v" "$(count "$SGILOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1183:    done
regress/gate_arm.sh:1184:
regress/gate_arm.sh:1185:    #  DENOMINATOR PINNED TO A LITERAL.  A detector that loses rows must not be able to pass
regress/gate_arm.sh:1186:    #  by shrinking, and the count is the only thing that says so.  Raise it DELIBERATELY.
regress/gate_arm.sh:1187:    #  Both halves pinned: 46 rows emitted AND all 46 green.
regress/gate_arm.sh:1188:    #  *** RAISED 44 -> 46 ON THIS ROUND'S OWN PASS 2. ***  The panel found a clause-(d)
regress/gate_arm.sh:1189:    #  floor breach: giving the TEX read decline an already-used NON-LEN latch bit
regress/gate_arm.sh:1190:    #  (1 << 8 = SGIRE_W_UNMAP_RD) escapes a 44/44 sweep, because the detector's four
regress/gate_arm.sh:1191:    #  TEX-read scenarios and its unmapped-read scenario never share an emulator instance
regress/gate_arm.sh:1192:    #  -- `tex xbit' set bits 0-5 only AT THAT TIME (it now fires 0-10).  Repaired by two
regress/gate_arm.sh:1193:    #  SAME-INSTANCE rows asserting both
regress/gate_arm.sh:1194:    #  announces fire, in BOTH orderings; one ordering would leave the mirror open.
regress/gate_arm.sh:1195:    #  *** RAISED 35 -> 44 BY #513, DELIBERATELY, IN THE SAME COMMIT AS THE FIX. ***
regress/gate_arm.sh:1196:    #  The six `<arm> ld kill' rows are GONE -- they asserted that a len == 8 READ still
regress/gate_arm.sh:1197:    #  ends the host at each window, which was true until #513 removed those kills.  They
regress/gate_arm.sh:1198:    #  are replaced by TWO anchored ACCEPT rows per accepting arm (window base AND last
regress/gate_arm.sh:1199:    #  slot, because a row at the base tests the near bound twice and the far bound never),
regress/gate_arm.sh:1200:    #  four CRIME_RE_TEX decline rows, and a 64-bit liveness control.  Arithmetic:
regress/gate_arm.sh:1201:    #  35 - 6 + 14 + 1 = 44.  Two rows rather than one,
regress/gate_arm.sh:1202:    #  because a single "35 ok" check cannot tell a LOST row from a FAILING one -- and
regress/gate_arm.sh:1203:    #  those need different responses.
regress/gate_arm.sh:1204:    #  *** THE FIRST DRAFT OF THIS BLOCK HAD TWO DEFECTS, BOTH FOUND BY THE PASS-2 SEAT.
regress/gate_arm.sh:1205:    #  (1) It ended in `|| true`, which is INERT: check() in lib.sh has no `return`, so
regress/gate_arm.sh:1206:    #  it exits 0 on BOTH branches and the row counts into _fails regardless.  The
regress/gate_arm.sh:1207:    #  suppression never existed -- but a reader would conclude that row was advisory,
regress/gate_arm.sh:1208:    #  which is worse than either behaviour on its own.
regress/gate_arm.sh:1209:    #  (2) The denominator concatenated two counts and compared to "350" -- satisfied by
regress/gate_arm.sh:1210:    #  (35 ok, 0 FAIL) AND by (3 ok, 50 FAIL).  A string join is not an arithmetic
regress/gate_arm.sh:1211:    #  identity, and it was redundant with the two rows below it anyway. ***
regress/gate_arm.sh:1212:    #  *** AND THE FIRST REPAIR OF (2) REPRODUCED THE VERY DEFECT THE PANEL HAD JUST FOUND
regress/gate_arm.sh:1213:    #  IN THIS ROUND'S BRIEF.  I wrote `count "$SGILOG" " ok$| FAIL$"` -- but count() is
regress/gate_arm.sh:1214:    #  `grep -ac`, PLAIN grep, so `|` is a LITERAL and the pattern matches NOTHING.
regress/gate_arm.sh:1215:    #  Measured: 0 against a log holding 35 rows.  The seats had flagged `grep -i
regress/gate_arm.sh:1216:    #  'sgi|width'` in the brief for exactly this, one hour earlier. ***
regress/gate_arm.sh:1217:    #
regress/gate_arm.sh:1218:    #  Summed ARITHMETICALLY instead, which needs no regex dialect at all -- and unlike the
regress/gate_arm.sh:1219:    #  string-concatenation form it replaces, it cannot be satisfied by (3 ok, 50 FAIL).
regress/gate_arm.sh:1220:    check "sgi_re rows emitted" \
regress/gate_arm.sh:1221:          "$(( $(count "$SGILOG" " ok$") + $(count "$SGILOG" " FAIL$") ))" "46"
regress/gate_arm.sh:1222:    check "sgi_re rows green"   "$(count "$SGILOG" " ok$")"   "46"
regress/gate_arm.sh:1223:    check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
regress/gate_arm.sh:1224:
regress/gate_arm.sh:1225:fi
regress/gate_arm.sh:1226:
regress/gate_arm.sh:1227:#  ---- *** MOVED OUT ONE NESTING LEVEL, 2026-08-31.  It was pasted INSIDE the
regress/gate_arm.sh:1228:#  ---- sgi_re_width probe's success branch, so if THAT probe missed its sentinel this
regress/gate_arm.sh:1229:#  ---- block was never invoked at all -- 28 rows, three denominators and its own
regress/gate_arm.sh:1230:#  ---- sentinel check evaporating while the gate reported one red row about a
regress/gate_arm.sh:1231:#  ---- different probe.  Silent coverage loss, and it defeated the very sentence
regress/gate_arm.sh:1232:#  ---- that justified the block (a committed detector no gate runs is a wrong
regress/gate_arm.sh:1233:#  ---- record).  Both sibling blocks sit at depth 0; the block's own zero
regress/gate_arm.sh:1234:#  ---- indentation was the tell that it had been written top-level and pasted
regress/gate_arm.sh:1235:#  ---- into a branch.  Found by the #499 pass-2 seat walking the brace depth. ***
regress/gate_arm.sh:1236:#  ---- #499's detector for the unmatched-address catch-all.  Wired IN THE SAME COMMIT as
regress/gate_arm.sh:1237:#  ---- the fix: a committed detector that no gate runs is a wrong record under the vacuity
regress/gate_arm.sh:1238:#  ---- floor's contract clause, and this one measured 18/28 on the pre-fix build and 28/28
regress/gate_arm.sh:1239:#  ---- on the fix, so it carries its own test-first evidence.
regress/gate_arm.sh:1240:#  ---- the coordinator's file.  Modelled on the sgi_re_width_probe block -- find it
regress/gate_arm.sh:1241:#  ---- with `grep -n 'sgi_re_width_probe.py "$PMAX"' gate_arm.sh`, NOT by line
regress/gate_arm.sh:1242:#  ---- number: the original citation said :1131, which is inside the sgi_de comment,
regress/gate_arm.sh:1243:#  ---- and this block has since moved once already.  A same-file line citation is
regress/gate_arm.sh:1244:#  ---- invalidated by your own edits to that file.
regress/gate_arm.sh:1245:UNMLOG=$LOGDIR/sgi_re_unmapped.log
regress/gate_arm.sh:1246:python3 sgi_re_unmapped_probe.py "$PMAX" gate > "$UNMLOG" 2>&1 || true
regress/gate_arm.sh:1247:
regress/gate_arm.sh:1248:#  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
regress/gate_arm.sh:1249:#  existence: a killed run loses every row and looks exactly like a run that produced none.
regress/gate_arm.sh:1250:if ! grep -q "OPUS499T_DONE" "$UNMLOG"; then
regress/gate_arm.sh:1251:    check "sgi_re unmapped probe completed" "no" "yes"
regress/gate_arm.sh:1252:else
regress/gate_arm.sh:1253:    check "sgi_re unmapped probe completed" "yes" "yes"
regress/gate_arm.sh:1254:    check "sgi_re unmapped controls" "$(count "$UNMLOG" '^OPUS499T_CONTROL=OK$')" "1"
regress/gate_arm.sh:1255:    for v in "live" "devsig" "wr surv" "wr kill" "wr decl" "rd surv" "rd kill" "rd decl" "rd sent" "rd nodbe" "wr lat1" "rd lat1" "wr rd 2msg" "xwin7 pre" "xwin wr" "xwin rd" "tlba acc lo" "tlba acc hi" "tlbb acc lo" "tlbb acc hi" "tlbc acc lo" "tlbc acc hi" "tex acc lo" "tex acc hi" "lina acc lo" "lina acc hi" "linb acc lo" "linb acc hi" "wr narrow surv" "wr narrow decl" "rd narrow surv" "rd narrow sent" "clip surv" "clip decl" "clip nar surv" "clip nar decl" "clip rd surv" "clip rd decl" "clip rd sent" "clip rdn surv" "clip rdn decl" "cliphi rd surv" "cliphi rd decl" "cliphi wr surv" "cliphi wr decl" "rd narrow decl" "wr zero surv" "wr zero decl" "wr then live" "clip wr live"; do
regress/gate_arm.sh:1256:        check "sgi_re unmapped row: $v" "$(count "$UNMLOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1257:    done
regress/gate_arm.sh:1258:
regress/gate_arm.sh:1259:    #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one: a single "28 ok" check
regress/gate_arm.sh:1260:    #  cannot tell a LOST row from a FAILING one, and those need different responses.
regress/gate_arm.sh:1261:    check "sgi_re unmapped rows emitted" \
regress/gate_arm.sh:1262:          "$(( $(count "$UNMLOG" " ok$") + $(count "$UNMLOG" " FAIL$") ))" "50"
regress/gate_arm.sh:1263:    check "sgi_re unmapped rows green" "$(count "$UNMLOG" " ok$")"   "50"
regress/gate_arm.sh:1264:    check "sgi_re unmapped rows red"   "$(count "$UNMLOG" " FAIL$")" "0"
regress/gate_arm.sh:1265:fi
regress/gate_arm.sh:1266:
regress/gate_arm.sh:1267:#  ---- sgirandompixel: horrible_getputpixel()'s unimplemented-mode arm.
regress/gate_arm.sh:1268:#
regress/gate_arm.sh:1269:#  WHAT THIS PROTECTS.  That arm used to do `*color = random()' with its exit(1) commented out, so a failed
regress/gate_arm.sh:1270:#  pixel GET handed the CALLER a random value and draw_primitive() wrote it to the destination in the same
regress/gate_arm.sh:1271:#  loop iteration.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes crmfbreg.h documents and extracts to
regress/gate_arm.sh:1272:#  tlb_mode 5, so it was reachable with a DOCUMENTED mode.  Now declined, with a latched announce.
regress/gate_arm.sh:1273:#
regress/gate_arm.sh:1274:#  The probe is BOTH the rung-3 WITNESS (7/8 red on the pre-fix build under the re-pinned oracle, preserved as
regress/gate_arm.sh:1275:#  artifacts/sgirandompixel/witness_20260906/prefix_repinned_RED.out) and the DETECTOR (kill table in
regress/gate_arm.sh:1276:#  artifacts/sgirandompixel/killtable/: five mutants, all killed, BASE 8/8 opening and closing).
regress/gate_arm.sh:1277:#
regress/gate_arm.sh:1278:#  `lin_b diag once' IS THE ROW THAT NEEDED THE MOST CARE and the reason the probe draws a 1x4 rectangle
regress/gate_arm.sh:1279:#  rather than a single pixel: with one pixel an UNLATCHED announce also fires exactly once, the count channel
regress/gate_arm.sh:1280:#  cannot vary, and M_NOLATCH escaped 8/8.  Height rather than width, because LIN_A addressing is
regress/gate_arm.sh:1281:#  `ofs = x & 4095' -- y is ignored, so four rows rewrite one byte and the VALUE oracle survives.
regress/gate_arm.sh:1282:RANDLOG=$LOGDIR/sgi_re_randompixel.log
regress/gate_arm.sh:1283:python3 sgi_re_randompixel_probe.py "$PMAX" gate > "$RANDLOG" 2>&1 || true
regress/gate_arm.sh:1284:
regress/gate_arm.sh:1285:if ! grep -q "SGIRAND_DONE" "$RANDLOG"; then
regress/gate_arm.sh:1286:    check "sgi_re randompixel probe completed" "no" "yes"
regress/gate_arm.sh:1287:else
regress/gate_arm.sh:1288:    check "sgi_re randompixel probe completed" "yes" "yes"
regress/gate_arm.sh:1289:    check "sgi_re randompixel witness verdict" "$(count "$RANDLOG" '^SGIRAND_WITNESS=PASS$')" "1"
regress/gate_arm.sh:1290:    #  TWO SPACES AFTER $v, NOT ONE -- the sibling block above uses the same idiom and this block did not,
regress/gate_arm.sh:1291:    #  which the gate caught on its first run: `lin_b diag' got=2, because `^lin_b diag .*ok$' also matches
regress/gate_arm.sh:1292:    #  the row `lin_b diag once'.  That is the padded-column trap in its MATCHES-TWO-ROWS direction.
regress/gate_arm.sh:1293:    #
regress/gate_arm.sh:1294:    #  The probe prints names with "%-16s" followed by an explicit space, so a name of N chars is followed
regress/gate_arm.sh:1295:    #  by (16-N)+1 spaces.  The longest name here is `lin_b diag once' at 15, leaving exactly two -- so this
regress/gate_arm.sh:1296:    #  pattern has ONE CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s"
regress/gate_arm.sh:1297:    #  in the same diff.
regress/gate_arm.sh:1298:    #
regress/gate_arm.sh:1299:    #  *** CORRECTED 2026-09-07 (#505 pass 2, the kimi substitute).  This used to say a name of 16 or
regress/gate_arm.sh:1300:    #  more makes the pattern "UNSATISFIABLE, which is the same trap in its other, SILENT direction:
regress/gate_arm.sh:1301:    #  the check stops testing anything and stays green."  THE SILENT PART IS FALSE. ***  `count'
regress/gate_arm.sh:1302:    #  returns 0, `check' compares 0 against the wanted "1", and 0 != 1 FAILS -- loudly.  Measured
regress/gate_arm.sh:1303:    #  over rendered rows at lengths 15/16/17.  An unsatisfiable pattern is silent only where a check
regress/gate_arm.sh:1304:    #  wants ZERO, which no row check here does.  The dangerous direction is the ONE-SPACE form,
regress/gate_arm.sh:1305:    #  which matched `lin_b diag once' from `lin_b diag' and is what this block was written for.
regress/gate_arm.sh:1306:    for v in "live" "devsig" "copy lin_a" "lin_b not src" "lin_b is fg" "lin_b alive" "lin_b diag" "lin_b diag once"; do
regress/gate_arm.sh:1307:        check "sgi_re randompixel row: $v" "$(count "$RANDLOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1308:    done
regress/gate_arm.sh:1309:
regress/gate_arm.sh:1310:    #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one, for the sibling block's reason.
regress/gate_arm.sh:1311:    check "sgi_re randompixel rows emitted" \
regress/gate_arm.sh:1312:          "$(( $(count "$RANDLOG" " ok$") + $(count "$RANDLOG" " FAIL$") ))" "8"
regress/gate_arm.sh:1313:    check "sgi_re randompixel rows green" "$(count "$RANDLOG" " ok$")"   "8"
regress/gate_arm.sh:1314:    check "sgi_re randompixel rows red"   "$(count "$RANDLOG" " FAIL$")" "0"
regress/gate_arm.sh:1315:fi
regress/gate_arm.sh:1316:
regress/gate_arm.sh:1317:#  ------------------------------------------------------------ #505 sgirergbroundtrip
regress/gate_arm.sh:1318:#  horrible_getputpixel()'s RGB GET read buf[1..3] while its RGB PUT writes the three channels at
regress/gate_arm.sh:1319:#  buf[0..2] and an explicit pad at buf[3] -- so an RGB pixel did not survive its own round trip and
regress/gate_arm.sh:1320:#  the red channel was dropped.  RGB was the ONLY 32-bit colour mode in the file failing this way.
regress/gate_arm.sh:1321:#
regress/gate_arm.sh:1322:#  THE ARM WAS CHOSEN ON EVIDENCE FROM A DIFFERENT DEVICE, which is what makes the warrant
regress/gate_arm.sh:1323:#  non-circular: dev_sgi_gbe.c's scanout reads the same tile memory back as
regress/gate_arm.sh:1324:#  (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3], and CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
regress/gate_arm.sh:1325:#  31..24 / 23..16 / 15..8 -- byte 0 is R and byte 3 is UNUSED.  The pad sits at buf[3] because the
regress/gate_arm.sh:1326:#  CONSUMER ignores buf[3], not because PUT writes a zero there.
regress/gate_arm.sh:1327:#
regress/gate_arm.sh:1328:#  `rgb depth64' IS NOT DECORATION -- IT CLOSES A MEASURED CLAUSE-(d) FLOOR BREACH.  The first kill
regress/gate_arm.sh:1329:#  table's M6_cond (guard kept, repair conditioned on `bufdepth == 4') scored a CLEAN SWEEP 6/6,
regress/gate_arm.sh:1330:#  because every session then used BUFDEPTH_32 and the mutant's fix branch was the only one the
regress/gate_arm.sh:1331:#  detector ever executed.  Its mirror M7_cond8 (exempting bufdepth 8 instead) also dies, so the
regress/gate_arm.sh:1332:#  WIDTH AXIS is closed rather than the one cell the mutant happened to use.
regress/gate_arm.sh:1333:#
regress/gate_arm.sh:1334:#  `rgb samemode' reaches the RGB *PUT* arm, which no other row executes -- every other session is
regress/gate_arm.sh:1335:#  RGB->RGBA.  Measured, not assumed: M8_put corrupts that arm alone and reds exactly this row.
regress/gate_arm.sh:1336:RGBLOG=$LOGDIR/sgi_re_rgb.log
regress/gate_arm.sh:1337:python3 sgi_re_rgb_probe.py "$PMAX" gate > "$RGBLOG" 2>&1 || true
regress/gate_arm.sh:1338:
regress/gate_arm.sh:1339:if ! grep -q "SGIRGB_DONE" "$RGBLOG"; then
regress/gate_arm.sh:1340:    check "sgi_re rgb probe completed" "no" "yes"
regress/gate_arm.sh:1341:else
regress/gate_arm.sh:1342:    check "sgi_re rgb probe completed" "yes" "yes"
regress/gate_arm.sh:1343:    check "sgi_re rgb witness verdict" "$(count "$RGBLOG" '^SGIRGB_WITNESS=PASS$')" "1"
regress/gate_arm.sh:1344:    #  TWO SPACES AFTER $v, NOT ONE -- the sibling blocks above were both bitten by the one-space
regress/gate_arm.sh:1345:    #  form, in both of its directions.  Pre-flighted mechanically for this row set before the gate
regress/gate_arm.sh:1346:    #  ever ran: no name is a prefix of another, and every pattern matches exactly one rendered row.
regress/gate_arm.sh:1347:    #
regress/gate_arm.sh:1348:    #  The probe prints names with "%-16s" plus an explicit space, so a name of N chars is followed
regress/gate_arm.sh:1349:    #  by (16-N)+1 spaces.  The longest here is `rgb not corrupt' at 15, leaving exactly two -- ONE
regress/gate_arm.sh:1350:    #  CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s" in the same diff.
regress/gate_arm.sh:1351:    #
regress/gate_arm.sh:1352:    #  *** WHAT A TOO-LONG NAME ACTUALLY DOES: IT REDS, LOUDLY.  The sibling block above says it
regress/gate_arm.sh:1353:    #  "silently stops testing anything while staying green", and an earlier draft of THIS block
regress/gate_arm.sh:1354:    #  copied that sentence.  It is WRONG, and the pass-2 panel caught it. ***  `count' returns 0
regress/gate_arm.sh:1355:    #  when the pattern matches nothing, `check' compares that 0 against a wanted "1", and 0 != 1
regress/gate_arm.sh:1356:    #  FAILS.  Measured over rendered rows at lengths 15/16/17: 15 matches (ok), 16 and 17 match
regress/gate_arm.sh:1357:    #  nothing (FAIL).  The UNSATISFIABLE direction of this trap is the SAFE one for a want-1 check;
regress/gate_arm.sh:1358:    #  it is only silent where a check wants ZERO.  The genuinely dangerous direction remains the
regress/gate_arm.sh:1359:    #  ONE-SPACE form, which matches a LONGER name's row as well and was measured on the sibling.
regress/gate_arm.sh:1360:    for v in "live" "devsig" "copy lin_a" "rgb chan" "rgb not corrupt" "rgb alive" "rgb samemode" "rgb depth64" "rgb tiled" "rgb tiled64"; do
regress/gate_arm.sh:1361:        check "sgi_re rgb row: $v" "$(count "$RGBLOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1362:    done
regress/gate_arm.sh:1363:
regress/gate_arm.sh:1364:    #  DENOMINATOR, SUMMED ARITHMETICALLY: a row that stops being emitted at all is otherwise
regress/gate_arm.sh:1365:    #  invisible -- its named check goes 0, but so does a check for a row that never existed.
regress/gate_arm.sh:1366:    #  *** THE DENOMINATOR PINNED 8 WHILE THE PROBE EMITTED 9, AND THE ROW LIST NEVER NAMED
regress/gate_arm.sh:1367:    #  `rgb tiled'.  A pass-3 seat found it by reading the gate against the probe rather than the
regress/gate_arm.sh:1368:    #  probe against itself. ***  It would have failed LOUDLY -- emitted 9, wanted 8 -- which is the
regress/gate_arm.sh:1369:    #  safe direction, but it would have shipped, and `rgb tiled' would have been unchecked BY NAME
regress/gate_arm.sh:1370:    #  while appearing in the count.  Both new rows are named above and the pins are 10.
regress/gate_arm.sh:1371:    check "sgi_re rgb rows emitted" \
regress/gate_arm.sh:1372:          "$(( $(count "$RGBLOG" " ok$") + $(count "$RGBLOG" " FAIL$") ))" "10"
regress/gate_arm.sh:1373:    check "sgi_re rgb rows green" "$(count "$RGBLOG" " ok$")"   "10"
regress/gate_arm.sh:1374:    check "sgi_re rgb rows red"   "$(count "$RGBLOG" " FAIL$")" "0"
regress/gate_arm.sh:1375:fi
regress/gate_arm.sh:1376:
regress/gate_arm.sh:1377:#  ------------------------------------------------------------ #500 sgideprimop
regress/gate_arm.sh:1378:#  draw_primitive()'s default arm ended the host on a guest-written drawing op.
regress/gate_arm.sh:1379:#  Now a latched decline.  The detector is its OWN probe rather than rows bolted
regress/gate_arm.sh:1380:#  onto sgi_de_width_probe.py, because that one is about WIDTH and owns the
regress/gate_arm.sh:1381:#  `tail_acc*' rows that pin draw_primitive's REACHABILITY -- a different claim.
regress/gate_arm.sh:1382:PRIMLOG=$LOGDIR/sgi_de_primop.log
regress/gate_arm.sh:1383:python3 sgi_de_primop_probe.py "$PMAX" gate > "$PRIMLOG" 2>&1 || true
regress/gate_arm.sh:1384:
regress/gate_arm.sh:1385:#  SENTINEL FIRST, for the reason the sibling block states: a preserved log is
regress/gate_arm.sh:1386:#  verified by its completion sentinel, never by its existence.
regress/gate_arm.sh:1387:if ! grep -q "OPUS500_DONE" "$PRIMLOG"; then
regress/gate_arm.sh:1388:    check "sgi_de primop probe completed" "no" "yes"
regress/gate_arm.sh:1389:else
regress/gate_arm.sh:1390:    check "sgi_de primop probe completed" "yes" "yes"
regress/gate_arm.sh:1391:    for v in "live" "devsig" "pt surv" "pt live" "pt decl" "tri surv" "tri live" "tri decl" "reset surv" "reset live" "reset decl" "two once" "two live" "rd surv" "rd decl" "xlatch decl" "xlatch live" "xlatch unm" "xlatch unliv" "xlatch all" "xlatch alliv" "xlatch pre" "acc rect" "acc live" "acc rect mod" "acc rect liv" "acc line mod" "acc line liv" "n25 nox" "n25 noxset" "dec b26" "dec b27" "dec b28" "dec b29" "dec b30" "dec b31" "dec hi liv" "dec low" "dec low liv" "dec ops" "dec ops liv" "dec flood" "dec flood liv" "dec regs" "dec regs liv" "dec regs set" "dec regs stip" "n25 rect" "n25 rectliv" "n25 rectset" "n25 line"; do
regress/gate_arm.sh:1392:        check "sgi_de primop row: $v" "$(count "$PRIMLOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1393:    done
regress/gate_arm.sh:1394:
regress/gate_arm.sh:1395:    #  DENOMINATOR, SUMMED -- a single "19 ok" check cannot tell a LOST row from a
regress/gate_arm.sh:1396:    #  FAILING one, and those need different responses.
regress/gate_arm.sh:1397:    check "sgi_de primop rows emitted"           "$(( $(count "$PRIMLOG" " ok$") + $(count "$PRIMLOG" " FAIL$") ))" "51"
regress/gate_arm.sh:1398:    check "sgi_de primop rows green" "$(count "$PRIMLOG" " ok$")"   "51"
regress/gate_arm.sh:1399:    check "sgi_de primop rows red"   "$(count "$PRIMLOG" " FAIL$")" "0"
regress/gate_arm.sh:1400:fi
regress/gate_arm.sh:1401:
regress/gate_arm.sh:1402:
regress/gate_arm.sh:1403:
regress/gate_arm.sh:1404:#  ------------------------------------------------------------ pcc2widthkills
regress/gate_arm.sh:1405:#  Twelve width-guard blocks in DEVICE_ACCESS(pcc2) ended the host on a guest-chosen
regress/gate_arm.sh:1406:#  access width.  Now a DIRECTION SPLIT: reads accept (the memcpy above the switch
regress/gate_arm.sh:1407:#  already served them), writes decline with a per-instance latch.  The witness
regress/gate_arm.sh:1408:#  (pcc2_width_witness.py, 4/10 on the committed build) is NOT run here -- its job was
regress/gate_arm.sh:1409:#  to exist before the edit; this is the detector it grew into.
regress/gate_arm.sh:1410:PCC2LOG=$LOGDIR/pcc2_width.log
regress/gate_arm.sh:1411:python3 -u pcc2_width_probe.py "$PMAX" gate > "$PCC2LOG" 2>&1 || true
regress/gate_arm.sh:1412:
regress/gate_arm.sh:1413:#  SENTINEL FIRST: a preserved log is verified by its completion sentinel, never by
regress/gate_arm.sh:1414:#  its existence.
regress/gate_arm.sh:1415:if ! grep -q "PCC2W_PROBE_DONE" "$PCC2LOG"; then
regress/gate_arm.sh:1416:    check "pcc2 width probe completed" "no" "yes"
regress/gate_arm.sh:1417:else
regress/gate_arm.sh:1418:    check "pcc2 width probe completed" "yes" "yes"
regress/gate_arm.sh:1419:    for v in "live" "devsig" "byte rd" "byte rd liv" "hrd genctl" "hrd genctl lv" "hrd genctl nod" "hwr genctl" "hwr genctl lv" "hrd t2ctl" "hrd t2ctl lv" "hrd t2ctl nod" "hwr t2ctl" "hwr t2ctl lv" "hrd t2icr" "hrd t2icr lv" "hrd t2icr nod" "hwr t2icr" "hwr t2icr lv" "hrd sccerr" "hrd sccerr lv" "hrd sccerr nod" "hwr sccerr" "hwr sccerr lv" "hrd scctx" "hrd scctx lv" "hrd scctx nod" "hwr scctx" "hwr scctx lv" "wrd sccerr" "wrd sccerr lv" "wrd sccerr nod" "wwr sccerr" "wwr sccerr lv" "wwr sccerr dcl" "val h genctl" "val w sccerr" "rb genctl" "rb genctl dcl" "rb vecbase" "rb t2ctl" "rb t2ctl dcl" "rb t2icr" "rb t2icr dcl" "rb scctx" "rb scctx dcl" "hwr sccerr dcl" "rb genctl lo" "latch same" "latch two" "latch aba" "latch same2" "rb2 genctl" "rb2 t2ctl" "rb2 t2icr" "rb2 scctx" "rb2 vecbase" "rb2 sccicr" "rb2 sccrx" "rb2 scsiicr" "rb2 mask" "pscale noig2" "ipl noig2" "hrd genctl rb" "hrd t2ctl rb" "hrd t2icr rb" "hrd scctx rb" "hrd ipl noro" "brd2 genctl" "brd2 vecbase" "brd2 t2ctl" "brd2 t2icr" "brd2 sccicr" "brd2 scctx" "brd2 sccrx" "brd2 scsiicr" "brd2 mask" "brd pscale noig" "brd ipl noro" "rb4 genctl" "rb8 genctl" "rb4 vecbase" "rbq vecbase" "rb8 vecbase" "rb4 t2ctl" "rb8 t2ctl" "rb4 t2icr" "rb8 t2icr" "rb4 sccicr" "rbq sccicr" "rb8 sccicr" "rb4 scctx" "rbq scctx" "rb8 scctx" "rb4 sccrx" "rbq sccrx" "rb8 sccrx" "rb4 scsiicr" "rbq scsiicr" "rb8 scsiicr" "rb4 mask" "rb8 mask" "pscale noig4" "pscale noig8" "ipl noig4" "ipl noig8" "latch samew" "latch samed" "latch all one" "pend2 arm" "pend2 decl" "pend2 rb" "pend2 rbi" "pend2 rb1" "pend2 rb1i" "pend2 rbc" "pend2 rbh" "pend2 rb1c" "pend2 rb1h" "pend2 huh" "pend2 zctl" "pend2 rbz" "pend1 arm" "pend1 decl" "pend1 rb" "pend1 rbi" "pend1 rb2" "pend1 rb2i" "pend1 rbc" "pend1 rbh" "pend1 rb2c" "pend1 rb2h" "pend1 huh" "pend1 zctl" "pend1 rbz" "ovf2 arm" "ovf2 decl" "ovf2 rb" "ovf2 rbv" "ovf2 rbx" "ovf2 rb1" "ovf2 rb1v" "ovf2 rb1x" "ovf2 huh" "ovf1 arm" "ovf1 decl" "ovf1 rb" "ovf1 rbv" "ovf1 rbx" "ovf1 rb2" "ovf1 rb2v" "ovf1 rb2x" "ovf1 huh" "ipl wset" "ovfhi2 arm" "ovfhi2 decl" "ovfhi2 rb" "ovfhi2 rbv" "ovfhi2 rbx" "ovfhi2 rb1" "ovfhi2 rb1v" "ovfhi2 rb1x" "ovfhi2 huh" "ovfhi1 arm" "ovfhi1 decl" "ovfhi1 rb" "ovfhi1 rbv" "ovfhi1 rbx" "ovfhi1 rb2" "ovfhi1 rb2v" "ovfhi1 rb2x" "ovfhi1 huh" "pendn2 arm" "pendn2 decl" "pendn2 rb" "pendn1 arm" "pendn1 decl" "pendn1 rb" "latch all zero" "rb t2icr il4" "rb t1icr il4" "ipl rset" "latch all rev" "pendboth arm" "pendboth arm1" "pendboth decl" "pendboth rb" "pendboth rbi" "pendboth rb1" "pendboth rb1i" "pendboth rbc" "pendboth rbh" "pendboth rb1c" "pendboth rb1h" "pendboth huh" "rb t2ctl b27" "rb t1ctl b27" "rb4 t1ctl" "rb8 t1ctl" "rb4 t1icr" "rb8 t1icr" "latch all" "latch all lv" "latch all fail" "acc genctl" "acc genctl nod" "acc t2ctl" "acc t2ctl nod" "acc t2icr" "acc t2icr nod" "acc scctx" "acc scctx nod" "acc sccerr" "acc sccerr nod" "op vecbase" "op vecbase dcl" "op pscale" "op pscale dcl" "op t1ctl" "op t1ctl dcl" "op t1icr" "op t1icr dcl" "op sccicr" "op sccicr dcl" "op sccrx" "op sccrx dcl" "op scsiicr" "op scsiicr dcl" "rb sccicr" "rb sccrx" "rb scsiicr" "op pscale noig" "rb vecbase own" "hwr ipl noig" "latch all w" "latch all d" "acc all" "acc all lv" "acc pscale ign" "acc ipl ro" "rb t1ctl" "rb t1icr" "hrd ipl" "hrd ipl lv" "hrd ipl nod" "hwr ipl" "hwr ipl lv" "hwr ipl dcl" "op mask" "op mask dcl" "rb mask"; do
regress/gate_arm.sh:1420:        check "pcc2 width row: $v" "$(count "$PCC2LOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1421:    done
regress/gate_arm.sh:1422:
regress/gate_arm.sh:1423:    #  DENOMINATOR, SUMMED -- a lost row and a failing row need different responses.
regress/gate_arm.sh:1424:    check "pcc2 width rows emitted"           "$(( $(count "$PCC2LOG" " ok$") + $(count "$PCC2LOG" " FAIL$") ))" "251"
regress/gate_arm.sh:1425:    check "pcc2 width rows green" "$(count "$PCC2LOG" " ok$")"   "251"
regress/gate_arm.sh:1426:    check "pcc2 width rows red"   "$(count "$PCC2LOG" " FAIL$")" "0"
regress/gate_arm.sh:1427:fi
regress/gate_arm.sh:1428:
regress/gate_arm.sh:1429:
regress/gate_arm.sh:1430:#  ------------------------------------------------------------ pcc2defaultkill (#501)
regress/gate_arm.sh:1431:#  The default: arm of DEVICE_ACCESS(pcc2) ended the host on any access to an uncased
regress/gate_arm.sh:1432:#  offset, reads included.  Now: reads keep the served byte, writes are declined, one
regress/gate_arm.sh:1433:#  latched announce per offset per instance.  The witness (regress/artifacts/pcc2defaultkill/
regress/gate_arm.sh:1434:#  witness_20260905/, 7/13 on the committed build) is NOT run here; this is its detector.
regress/gate_arm.sh:1435:PCC2DLOG=$LOGDIR/pcc2_default.log
regress/gate_arm.sh:1436:python3 -u pcc2_default_probe.py "$PMAX" gate > "$PCC2DLOG" 2>&1 || true
regress/gate_arm.sh:1437:if ! grep -q "PCC2D_PROBE_DONE" "$PCC2DLOG"; then
regress/gate_arm.sh:1438:    check "pcc2 default probe completed" "no" "yes"
regress/gate_arm.sh:1439:else
regress/gate_arm.sh:1440:    check "pcc2 default probe completed" "yes" "yes"
regress/gate_arm.sh:1441:    for v in "live" "devsig chipid" "named wr" "named wr msg" "named rd" "named rd msg" \
regress/gate_arm.sh:1442:        "named rd srvd" "inword wr" "inword msg" "inword rdawr" "inword rd" "unnamed wr" \
regress/gate_arm.sh:1443:        "unnamed msg" "unnamed rdawr" "unnamed rd" "ieicr rdawr" "ieerr rdawr" "sccerr rdawr" \
regress/gate_arm.sh:1444:        "latch sameoff" "sameoff val" "latch twooff" "latch rw one" "latch rd rd" "latch rd wr" \
regress/gate_arm.sh:1445:        "latch aba" "alias 0x6a" "alias msg" "dir wr text" "wr declined" "wr val text" \
regress/gate_arm.sh:1446:        "dir rd text" "srvd val" "srvd val text" "srvd half text" "half wr rdawr" "srvd rd latch" \
regress/gate_arm.sh:1447:        "srvd wr latch" "wide wr" "wide wr msg" "wide wr val" "wide rd" "wide rd srvd" \
regress/gate_arm.sh:1448:        "genctl rt" "t1cmp word rt" "put b ctl" "put b ctl msg"; do
regress/gate_arm.sh:1449:        check "pcc2 default row: $v" "$(count "$PCC2DLOG" "^$v  .*ok$")" "1"
regress/gate_arm.sh:1450:    done
regress/gate_arm.sh:1451:    check "pcc2 default rows emitted" "$(( $(count "$PCC2DLOG" " ok$") + $(count "$PCC2DLOG" " FAIL$") ))" "46"
regress/gate_arm.sh:1452:    check "pcc2 default rows green"   "$(count "$PCC2DLOG" " ok$")"   "46"
regress/gate_arm.sh:1453:    check "pcc2 default rows red"     "$(count "$PCC2DLOG" " FAIL$")" "0"
regress/gate_arm.sh:1454:fi
regress/gate_arm.sh:1455:
regress/gate_arm.sh:1456:
regress/gate_arm.sh:1457:PITLOG=$LOGDIR/pit8253_latch.log
regress/gate_arm.sh:1458:python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PITLOG" 2>&1 || true
regress/gate_arm.sh:1459:
regress/gate_arm.sh:1460:#  A PRESERVED LOG IS VERIFIED BY ITS COMPLETION SENTINEL, NOT BY ITS EXISTENCE.  The probe
regress/gate_arm.sh:1461:#  gained PIT8253_LATCH_DONE specifically so this row could be written correctly the first
regress/gate_arm.sh:1462:#  time -- before it, the last line was a bare "PASS", a word that occurs in dozens of other
regress/gate_arm.sh:1463:#  contexts and cannot distinguish a COMPLETED run from a TRUNCATED one.
regress/gate_arm.sh:1464:if ! grep -q "PIT8253_LATCH_DONE" "$PITLOG"; then
regress/gate_arm.sh:1465:    note "pit8253 probe did not reach its completion sentinel; last lines follow"
regress/gate_arm.sh:1466:    tail -5 "$PITLOG" | sed 's/^/       /'
regress/gate_arm.sh:1467:    check "pit8253 probe completed" "no" "yes"
regress/gate_arm.sh:1468:else
regress/gate_arm.sh:1469:    grep -E "^  (ok|FAIL) " "$PITLOG" | sed 's/^/       /'
regress/gate_arm.sh:1470:
regress/gate_arm.sh:1471:    #  THE THREE CONTROLS PLUS THE MMU-ON NEGATIVE CONTROL, each pinned by name.  A count of
regress/gate_arm.sh:1472:    #  green rows would let a control go red while the total stayed acceptable.
regress/gate_arm.sh:1473:    for c in "C1 liveness" "C2 MMU state" "A1 device signature" "T  MMU-ON control"; do
regress/gate_arm.sh:1474:        check "pit8253 control: $c" \
regress/gate_arm.sh:1475:              "$(grep -c "^  ok   $c" "$PITLOG")" "1"
regress/gate_arm.sh:1476:    done
regress/gate_arm.sh:1477:
regress/gate_arm.sh:1478:    #  Per-row presence.  A row that silently stops being tested is the padded-column class,
regress/gate_arm.sh:1479:    #  so each is checked individually rather than by a total.  Eighteen rows: 4 controls +
regress/gate_arm.sh:1480:    #  E/A2 apparatus + R0..R11.
regress/gate_arm.sh:1481:    for v in "E  encodings" "A2 recompute stream" \
regress/gate_arm.sh:1482:             "R0 the run produced data" "R1 latch preserves programming" \
regress/gate_arm.sh:1483:             "R2 latch is not an error" "R3 latched read is not the reload" \
regress/gate_arm.sh:1484:             "R4 16-bit readback is the reload" "R5 one recompute per write pair" \
regress/gate_arm.sh:1485:             "R6 no transient count of zero" \
regress/gate_arm.sh:1486:             "R7 read and write flip-flops are separate" \
regress/gate_arm.sh:1487:             "R8 the latch is released by reading it" \
regress/gate_arm.sh:1488:             "R9 a mid-pair latch completes the pair and lets go" \
regress/gate_arm.sh:1489:             "R10 a Control Word rewinds the write flip-flop" \
regress/gate_arm.sh:1490:             "R11 ...and it does so PER COUNTER, not just counter 0"; do
regress/gate_arm.sh:1491:        check "pit8253 row green: $v" \
regress/gate_arm.sh:1492:              "$(grep -c "^  ok   $v" "$PITLOG")" "1"
regress/gate_arm.sh:1493:    done
regress/gate_arm.sh:1494:
regress/gate_arm.sh:1495:    #  The denominator against a LITERAL: a probe that loses rows cannot pass by shrinking.
regress/gate_arm.sh:1496:    check "pit8253 rows run" "$(grep -cE '^  (ok|FAIL) ' "$PITLOG")" "18"
regress/gate_arm.sh:1497:fi
regress/gate_arm.sh:1498:
regress/gate_arm.sh:1499:gate_end
regress/gdrom_default_probe.py:1:#!/usr/bin/env python3
regress/gdrom_default_probe.py:2:"""DETECTOR for gdromdefault, carrying the round's witness measurement.
regress/gdrom_default_probe.py:3:
regress/gdrom_default_probe.py:4:THE DEFECT: dev_dreamcast_gdrom.c registers a 0x100 window at 0x005f7000 and
regress/gdrom_default_probe.py:5:its switch implements EIGHT offsets -- 0x18, 0x80, 0x84, 0x88, 0x8c, 0x90,
regress/gdrom_default_probe.py:6:0x94, 0x9c.  Every other address in that window falls to `default:`, which
regress/gdrom_default_probe.py:7:prints and then runs exit(1), for a READ or a WRITE, at any width.
regress/gdrom_default_probe.py:8:
regress/gdrom_default_probe.py:9:*** ONE PREDICATE, ROUGHLY 248 OF 256 BYTE OFFSETS LETHAL. ***  A driver or a
regress/gdrom_default_probe.py:10:diagnostic that scans the device's register space -- an ordinary thing to do
regress/gdrom_default_probe.py:11:before you know what is there -- ends the host process on its first unhandled
regress/gdrom_default_probe.py:12:address.  That is a wider blast radius than the whole GDROM_DATA arm #460
regress/gdrom_default_probe.py:13:fixed, which needed a specific register and, for two of three sites, specific
regress/gdrom_default_probe.py:14:device state.
regress/gdrom_default_probe.py:15:
regress/gdrom_default_probe.py:16:CENSUS, measured on an unmodified `-E dreamcast -x`, one 32-bit guest load per
regress/gdrom_default_probe.py:17:offset: 21 sampled, 19 DIED via this arm, 2 survived (0x90 and 0x94, both
regress/gdrom_default_probe.py:18:implemented).  32-bit was chosen deliberately -- it reaches `default:` for an
regress/gdrom_default_probe.py:19:unhandled offset WITHOUT first tripping GDROM_DATA's own width guard, so a
regress/gdrom_default_probe.py:20:death is attributable to this arm and not to another.
regress/gdrom_default_probe.py:21:
regress/gdrom_default_probe.py:22:THE LATCH SHAPE IS THE ROUND'S DESIGN QUESTION, and #443 already answered the
regress/gdrom_default_probe.py:23:same question in this tree: `uint32_t pcic_reported[NCLASS][(N_REGS+31)/32]`,
regress/gdrom_default_probe.py:24:a PER-WORD BITMAP keyed by fault class, with its own comment recording why --
regress/gdrom_default_probe.py:25:"A per-device flag would hide it ... 137 named flags would be absurd.  This is
regress/gdrom_default_probe.py:26:five words."  A single flag here would let ONE unimplemented access silence
regress/gdrom_default_probe.py:27:the other 247; a named constant per offset is absurd at this width.
regress/gdrom_default_probe.py:28:
regress/gdrom_default_probe.py:29:*** DREAMCAST NEEDS -x OR IT NEVER REACHES THE DEBUGGER PROMPT. ***  Two
regress/gdrom_default_probe.py:30:console inputs, and console.c:994-1007 makes that fatal without allow_slaves.
regress/gdrom_default_probe.py:31:Without it a session dies for a CONFIGURATION reason and prints the same
regress/gdrom_default_probe.py:32:"died" the defect prints -- that cost #459 a false positive.
regress/gdrom_default_probe.py:33:
regress/gdrom_default_probe.py:34:Rung 3 by the witness ladder: real guest instructions through real address
regress/gdrom_default_probe.py:35:decode on an UNMODIFIED in-tree machine description.
regress/gdrom_default_probe.py:36:
regress/gdrom_default_probe.py:37:CONTROLS RUN IN THEIR OWN SESSIONS AND NEVER TOUCH AN UNIMPLEMENTED OFFSET,
regress/gdrom_default_probe.py:38:so a red trigger row cannot be confused with a broken session.
regress/gdrom_default_probe.py:39:
regress/gdrom_default_probe.py:40:*** CONTRACT (vacuity floor clause (e)) -- WHAT THESE ROWS ARE DESIGNED TO
regress/gdrom_default_probe.py:41:CATCH, WHAT THEY ARE NOT, AND WHAT IS KNOWN TO ESCAPE THEM. ***  A detector
regress/gdrom_default_probe.py:42:that says so is falsifiable; one claiming completeness is not, and a later
regress/gdrom_default_probe.py:43:escape then becomes an argument about overclaiming instead of a contract
regress/gdrom_default_probe.py:44:question with an answer.
regress/gdrom_default_probe.py:45:
regress/gdrom_default_probe.py:46:SCOPE.  This contract covers the #462 `case 0x18` DMA rows added below.  The
regress/gdrom_default_probe.py:47:#461 `default:`-arm rows are governed by the census header above; an escape
regress/gdrom_default_probe.py:48:against one of THOSE is adjudicated there, not here.
regress/gdrom_default_probe.py:49:
regress/gdrom_default_probe.py:50:DESIGNED TO CATCH -- each backed by a mutant that measurably reddens a row,
regress/gdrom_default_probe.py:51:not by intent:
regress/gdrom_default_probe.py:52:
regress/gdrom_default_probe.py:53:  * reinstatement of either `exit(1)`                        (Mb1, Mb2)
regress/gdrom_default_probe.py:54:  * loss, RELOCATION, CONDITIONING or LATCH-SCOPING of the
regress/gdrom_default_probe.py:55:    `idata = 0` shadow clear, at either declining arm or at
regress/gdrom_default_probe.py:56:    the success arm                          (M1, M3, M6, M7, M12)
regress/gdrom_default_probe.py:57:  * collapse of the two warn-bit latches onto ONE bit (M2), or
regress/gdrom_default_probe.py:58:    loosening of the ARMING latch into a counter (M4)
regress/gdrom_default_probe.py:59:  * a completion event SET on a declined transfer            (M8, M9)
regress/gdrom_default_probe.py:60:  * outward growth of the arming test                        (M10)
regress/gdrom_default_probe.py:61:  * an operand swap in the no-data guard                     (M11)
regress/gdrom_default_probe.py:62:    *** #490: THIS CLAIM IS EXPIRED AND THE MEASUREMENT SAYS SO.  M11 IS NOW
regress/gdrom_default_probe.py:63:    EQUIVALENT -- NO ROW KILLS IT, BECAUSE THERE IS NOTHING LEFT TO KILL. ***
regress/gdrom_default_probe.py:64:      artifacts/gdromexitsix/m11_rescore_20260828/m11_58row.txt
regress/gdrom_default_probe.py:65:      (a 58-row measurement: these are the counts AS MEASURED THEN, not today's
regress/gdrom_default_probe.py:66:       denominator.  The probe has since grown and the gate pin is authoritative;
regress/gdrom_default_probe.py:67:       rewriting these to match it would falsify the record they exist to preserve.)
regress/gdrom_default_probe.py:68:        fixed  GDROM_DEF_RESULT=58/58   nodata stale/stale says/stale idle all ok   [58-row denominator, as measured then]
regress/gdrom_default_probe.py:69:        M11    GDROM_DEF_RESULT=58/58   ... byte-identical   [58-row denominator, as measured then]
regress/gdrom_default_probe.py:70:
regress/gdrom_default_probe.py:71:    THE CHRONOLOGY, from git rather than memory, because every record here was
regress/gdrom_default_probe.py:72:    CORRECT WHEN WRITTEN and one of them was overtaken:
regress/gdrom_default_probe.py:73:      2026-08-25  abf665c  M11 measured DETERMINISTICALLY LETHAL -- five runs, five
regress/gdrom_default_probe.py:74:                           SIGSEGVs, written out in words rather than as a ratio
regress/gdrom_default_probe.py:75:                           because an N/N in this docstring is indistinguishable
regress/gdrom_default_probe.py:76:                           from a stale ROW SCORE against the gate's pin of 58.
regress/gdrom_default_probe.py:77:                           (The round that first measured it recorded exactly this
regress/gdrom_default_probe.py:78:                           remedy; I wrote the ratio anyway and section U caught it.)
regress/gdrom_default_probe.py:79:                           Preceded by
regress/gdrom_default_probe.py:80:                           `Transfering 408 bytes to 0x00000000` -- a real NULL read.
regress/gdrom_default_probe.py:81:                           That round recorded, honestly, that A RE-SCORE WAS OWED.
regress/gdrom_default_probe.py:82:      2026-08-26  4d05cf0  #465 `data and data_len were released apart` -- free_data
regress/gdrom_default_probe.py:83:                           now clears BOTH.  THE CRASH BECAME IMPOSSIBLE.
regress/gdrom_default_probe.py:84:      2026-08-28           the owed re-score, finally run: EQUIVALENT.
regress/gdrom_default_probe.py:85:    `git merge-base --is-ancestor` confirms the fix is NOT an ancestor of the SIGSEGV
regress/gdrom_default_probe.py:86:    measurement, so the two results do not contradict -- they are one day apart.
regress/gdrom_default_probe.py:87:
regress/gdrom_default_probe.py:88:    *** THE LESSON IS NOT ABOUT M11.  A KILL RECORD IS TIME-INDEXED EXACTLY AS AN
regress/gdrom_default_probe.py:89:    ABSENCE RECORD IS. ***  The carrier already requires that an absence record NAME
regress/gdrom_default_probe.py:90:    ITS WARRANT and that any edit touching that warrant RE-RUNS the death measurement.
regress/gdrom_default_probe.py:91:    Nothing said the same about a claim that a mutant IS caught -- so #465 edited the
regress/gdrom_default_probe.py:92:    warrant, the owed re-score was written down the day before, and three rounds ran
regress/gdrom_default_probe.py:93:    with this contract asserting coverage it no longer had.
regress/gdrom_default_probe.py:94:
regress/gdrom_default_probe.py:95:    KEPT, NOT DELETED: the mutant is still worth listing.  A future edit that
regress/gdrom_default_probe.py:96:    re-separates the two fields makes M11 lethal again, and this entry is where a
regress/gdrom_default_probe.py:97:    reader learns that -- which a deleted line could not do.
regress/gdrom_default_probe.py:98:  * REFUSAL OR CORRUPTION OF A LEGAL TRANSFER -- legal arming still enters
regress/gdrom_default_probe.py:99:    the path, the completion still fires, and the device's own TOC byte
regress/gdrom_default_probe.py:100:    still lands                                              (M5)
regress/gdrom_default_probe.py:101:
regress/gdrom_default_probe.py:102:*** THE `idata = 0` VERB LIST IS DELIBERATELY WIDE. ***  The mutants do not
regress/gdrom_default_probe.py:103:merely DELETE that clear: M3 relocates it after the `break`, M6 conditions it
regress/gdrom_default_probe.py:104:on fresh-device state, M12 scopes it inside the latch.  A contract saying only
regress/gdrom_default_probe.py:105:"loss" would let a future conditioning escape be argued outside it.
regress/gdrom_default_probe.py:106:
regress/gdrom_default_probe.py:107:*** AND THE LATCH CLAUSE IS DELIBERATELY NARROW. ***  M4 is anchored on
regress/gdrom_default_probe.py:108:`GDROM_W_DMAARM`, so only the ARMING latch is measured; NO mutant loosens the
regress/gdrom_default_probe.py:109:no-data latch alone.  Claiming "either latch" would be an overclaim inside a
regress/gdrom_default_probe.py:110:contract, which is worse than not writing one.
regress/gdrom_default_probe.py:111:
regress/gdrom_default_probe.py:112:KNOWN TO ESCAPE -- measured, filed, and named here so a rediscovery can be
regress/gdrom_default_probe.py:113:adjudicated instead of re-argued:
regress/gdrom_default_probe.py:114:
regress/gdrom_default_probe.py:115:  * `gdromdmaclear` -- a completion event CLEARED on a decline.  The SET
regress/gdrom_default_probe.py:116:    direction is caught (M8/M9); the CLEAR direction escapes every row.
regress/gdrom_default_probe.py:117:  * `gdromdmaguard` -- `count == 1` widened to `count <= 1`, so `(0,1)` is
regress/gdrom_default_probe.py:118:    accepted.  `arm halfarm` cannot see it.
regress/gdrom_default_probe.py:119:  * `gdromdmasilent` -- `if (idata != 0)` narrowed to `if (idata == 1)`.
regress/gdrom_default_probe.py:120:
regress/gdrom_default_probe.py:121:*** THAT LIST IS THE HALF THAT DOES THE ADJUDICATING. ***  Without it, the
regress/gdrom_default_probe.py:122:next reader to rediscover `gdromdmaclear` cannot tell a FLOOR BREACH (L2, fix
regress/gdrom_default_probe.py:123:in-round) from FILED COVERAGE DEBT -- which is exactly the distinction clause
regress/gdrom_default_probe.py:124:(e) exists to make mechanical.
regress/gdrom_default_probe.py:125:
regress/gdrom_default_probe.py:126:NOT CAUGHT, structurally:
regress/gdrom_default_probe.py:127:
regress/gdrom_default_probe.py:128:  * *** THE SURVIVAL ROWS DETECT PROCESS TERMINATION ONLY. ***  `arm survive`,
regress/gdrom_default_probe.py:129:    `nodata live` and `nodata stale` compute `"survived" if alive else "died"`,
regress/gdrom_default_probe.py:130:    and `alive` is False ONLY when a read raises OSError or returns empty INSIDE
regress/gdrom_default_probe.py:131:    a budget window -- so they are true of an emulator that is HUNG, one that is
regress/gdrom_default_probe.py:132:    FROZEN, and, measured, one that has ALREADY BEEN KILLED.
regress/gdrom_default_probe.py:133:
regress/gdrom_default_probe.py:134:    *** THIS PARAGRAPH SAID "False ONLY on EOF ... true of an emulator that is
regress/gdrom_default_probe.py:135:    HUNG but has not exited", AND BOTH HALVES ARE MEASURABLY WRONG. ***
regress/gdrom_default_probe.py:136:
regress/gdrom_default_probe.py:137:      * `rd()` returns False on `except OSError` as well as on EOF, and on Linux
regress/gdrom_default_probe.py:138:        a pty-master read after the child dies gives EIO -- so the OSError arm is
regress/gdrom_default_probe.py:139:        the USUAL death path, not an exotic one.  "Only on EOF" mislabels the
regress/gdrom_default_probe.py:140:        common case.
regress/gdrom_default_probe.py:141:      * The defect is not on either False path.  It is on the THIRD path: the
regress/gdrom_default_probe.py:142:        loop is `while time.time() < end:`, so it returns True when the budget
regress/gdrom_default_probe.py:143:        expires having read nothing.  **A death that lands after the last budget
regress/gdrom_default_probe.py:144:        check is never read.**  Measured on a rig built from this file's own
regress/gdrom_default_probe.py:145:        session()/rd(): a process SIGKILLed just before its session's `quit`
regress/gdrom_default_probe.py:146:        scores `alive == True`.
regress/gdrom_default_probe.py:147:
regress/gdrom_default_probe.py:148:    So `alive` does not mean "hung but not exited".  It does not even mean
regress/gdrom_default_probe.py:149:    "not exited".  It means: no EOF and no OSError were observed inside the
regress/gdrom_default_probe.py:150:    sampled windows.  A red `alive == died` also cannot distinguish a clean exit
regress/gdrom_default_probe.py:151:    from a pty error.
regress/gdrom_default_probe.py:152:    Hang-shaped regressions are the IDLE rows' subject, not theirs.
regress/gdrom_default_probe.py:153:
regress/gdrom_default_probe.py:154:  * The `absent` path is DESIGNED to fire when a readback produces no output
regress/gdrom_default_probe.py:155:    (e.g. a wedged handler).  It HAS fired once --
regress/gdrom_default_probe.py:156:    `regress/artifacts/kill462/table3_58rows/probe_M11.raw`, row `stale idle`
regress/gdrom_default_probe.py:157:    -- and that firing's CAUSE IS UNATTRIBUTED: a hang and a session
regress/gdrom_default_probe.py:158:    outrunning its spin budget are both consistent with it -- AND SO IS A THIRD
regress/gdrom_default_probe.py:159:    CAUSE THIS LIST OMITTED, WHICH A CLEAN REBUILD REPRODUCES DETERMINISTICALLY:
regress/gdrom_default_probe.py:160:    A HOST DEATH THIS PREDICATE MISSED.  The M11 session was re-run five times
regress/gdrom_default_probe.py:161:    on a tree synced byte-identical to SEC, and EVERY ONE OF THE FIVE gave a SIGSEGV
regress/gdrom_default_probe.py:162:    -- written out rather than as a ratio, because an `N/N` in a probe docstring
regress/gdrom_default_probe.py:163:    is indistinguishable from a stale ROW SCORE, and the score-claims gate
regress/gdrom_default_probe.py:164:    correctly flagged the ratio form against this probe's pin of 58.  Preceded by
regress/gdrom_default_probe.py:165:    `Transfering 408 bytes to 0x00000000 (guest asked for 0)`.  The shipped
regress/gdrom_default_probe.py:166:    table3 entry records `survived` for that session.  Detection is proven;
regress/gdrom_default_probe.py:167:    diagnosis is not claimed -- and the leading diagnosis is now the one the
regress/gdrom_default_probe.py:168:    original list did not contain.
regress/gdrom_default_probe.py:169:
regress/gdrom_default_probe.py:170:  * No row observes interrupt ASSERTION.  The completion rows observe the
regress/gdrom_default_probe.py:171:    SYSASIC pending register, which is a different channel.
regress/gdrom_default_probe.py:172:
regress/gdrom_default_probe.py:173:Filed for the gaps rather than left implicit: `probetimebased` carries the
regress/gdrom_default_probe.py:174:liveness predicate's soundness defect and its fix shape (a three-state
regress/gdrom_default_probe.py:175:predicate -- terminated / responsive / unresponsive), and `lethalonly` carries
regress/gdrom_default_probe.py:176:the one row whose only kill is lethal.
regress/gdrom_default_probe.py:177:
regress/gdrom_default_probe.py:178:"""
regress/gdrom_default_probe.py:179:import os
regress/gdrom_default_probe.py:180:import pty
regress/gdrom_default_probe.py:181:import re
regress/gdrom_default_probe.py:182:import select
regress/gdrom_default_probe.py:183:import sys
regress/gdrom_default_probe.py:184:import time
regress/gdrom_default_probe.py:185:
regress/gdrom_default_probe.py:186:BIN = sys.argv[1] if len(sys.argv) > 1 else "../../build/gxemul"
regress/gdrom_default_probe.py:187:KERNEL = sys.argv[2] if len(sys.argv) > 2 else "../../_images/openbsd76-landisk-bsd.rd"
regress/gdrom_default_probe.py:188:
regress/gdrom_default_probe.py:189:#  Dreamcast RAM is 16 MB at 0x0c000000; the loaded ELF lands at 0x8c002000
regress/gdrom_default_probe.py:190:#  and grows up, so plant below it.  -M 64 is passed only for uniformity with
regress/gdrom_default_probe.py:191:#  the other SH probes; this machine's RAM is a fixed dev_ram regardless.
regress/gdrom_default_probe.py:192:CODE = 0x8c001000
regress/gdrom_default_probe.py:193:SCRATCH = 0x8c001800
regress/gdrom_default_probe.py:194:
regress/gdrom_default_probe.py:195:BASE = 0xa05f7000              # the 0x100 window, via P2 (uncached)
regress/gdrom_default_probe.py:196:DMA = 0xa05f7400               # the DMA window, 0x80, SEPARATELY registered
regress/gdrom_default_probe.py:197:GDROM_CNTLO = 0xa05f7090      # #460's probe drives these to stage a TOC
regress/gdrom_default_probe.py:198:GDROM_CNTHI = 0xa05f7094
regress/gdrom_default_probe.py:199:GDROM_COND  = 0xa05f709c
regress/gdrom_default_probe.py:200:GDROM_DATAP = 0xa05f7080      # ...and the CONTROL window's data port (+0x80)
regress/gdrom_default_probe.py:201:SYSASIC_PEND = 0xa05f6900     # pending_irq[0], guest-READABLE (dev_dreamcast_asic.c:130)
regress/gdrom_default_probe.py:202:SYSASIC_DMA_BIT = 0x4000      # SYSASIC_EVENT_GDROM_DMA is 14, so bit 14
regress/gdrom_default_probe.py:203:DMA_DST_P1 = 0x8c008000       # the accept session's destination, via P1.
regress/gdrom_default_probe.py:204:#  The session writes 0x0c008000 into +0x04 and the device masks it with
regress/gdrom_default_probe.py:205:#  0x0fffffff, so physical 0x0c008000 is what the transfer targets.  CODE
regress/gdrom_default_probe.py:206:#  is 0x8c001000 and the TOC is 408 bytes, so the two never overlap.
regress/gdrom_default_probe.py:207:IMPLEMENTED_WORDS = (0x18, 0x80, 0x84, 0x88, 0x8c, 0x90, 0x94, 0x9c)
regress/gdrom_default_probe.py:208:IMPL_BUSY = BASE + 0x18        # implemented: returns d->busy
regress/gdrom_default_probe.py:209:IMPL_CNTLO = BASE + 0x90       # implemented: returns d->cnt & 0xff
regress/gdrom_default_probe.py:210:IMPL_COND = BASE + 0x9c        # implemented
regress/gdrom_default_probe.py:211:UNIMPL_A = BASE + 0x00         # unimplemented -> default:
regress/gdrom_default_probe.py:212:UNIMPL_B = BASE + 0x04         # unimplemented, a DIFFERENT word
regress/gdrom_default_probe.py:213:UNIMPL_Z = BASE + 0xfc         # unimplemented, far end of the window
regress/gdrom_default_probe.py:214:
regress/gdrom_default_probe.py:215:SH4_IPRD = 0xffd00010
regress/gdrom_default_probe.py:216:IPRD_RESET = 0xda74
regress/gdrom_default_probe.py:217:LIVE = 0x12345678
regress/gdrom_default_probe.py:218:
regress/gdrom_default_probe.py:219:MOV_W_R8_AT_R7 = 0x2781
regress/gdrom_default_probe.py:220:MOV_L_R8_AT_R7 = 0x2782
regress/gdrom_default_probe.py:221:MOV_W_AT_R1_R2 = 0x6211
regress/gdrom_default_probe.py:222:MOV_L_AT_R1_R2 = 0x6212
regress/gdrom_default_probe.py:223:MOV_L_AT_R3_R2 = 0x6232       # mov.l @r3,r2
regress/gdrom_default_probe.py:224:MOV_W_AT_R3_R2 = 0x6231       # mov.w @r3,r2
regress/gdrom_default_probe.py:225:ADD_4_R1 = 0x7104             # add #4,r1
regress/gdrom_default_probe.py:226:MOV_B_R6_AT_R5 = 0x2560       # mov.b r6,@r5
regress/gdrom_default_probe.py:227:MOV_W_R6_AT_R5 = 0x2561       # mov.w r6,@r5
regress/gdrom_default_probe.py:228:MOV_L_AT_R1_R3 = 0x6312       # mov.l @r1,r3.  0110nnnnmmmm0010 with n=3 m=1;
regress/gdrom_default_probe.py:229:#  0x6313 -- which this line first said -- is `mov.l @Rm+,Rn`, a DIFFERENT
regress/gdrom_default_probe.py:230:#  instruction that also post-increments r1.  Caught by computing the encoding
regress/gdrom_default_probe.py:231:#  instead of trusting the typing, which is the hand-assembled-encoding trap the
regress/gdrom_default_probe.py:232:#  carrier records: a wrong field yields a plausible value and no error.  The
regress/gdrom_default_probe.py:233:#  sibling MOV_L_AT_R1_R2 = 0x6212 (n=2 m=1) is the cross-check.
regress/gdrom_default_probe.py:234:MOV_L_R2_AT_R1 = 0x2122       # mov.l r2,@r1  (n=1 m=2)
regress/gdrom_default_probe.py:235:MOV_L_R6_AT_R5 = 0x2562       # mov.l r6,@r5  (0010nnnnmmmm0010, n=5 m=6)
regress/gdrom_default_probe.py:236:MOV_L_R4_AT_R3 = 0x2342       # mov.l r4,@r3  (0010nnnnmmmm0010, n=3 m=4)
regress/gdrom_default_probe.py:237:MOV_B_AT_R1_R4 = 0x6410       # mov.b @r1,r4  (0110nnnnmmmm0000, n=4 m=1)
regress/gdrom_default_probe.py:238:BRA_SELF = 0xaffe
regress/gdrom_default_probe.py:239:NOP = 0x0009
regress/gdrom_default_probe.py:240:
regress/gdrom_default_probe.py:241:#  #490: the two decline diagnostics the sibling round added.  ANCHORED on `-- declined`,
regress/gdrom_default_probe.py:242:#  because the bare `unimplemented data format` also matches the upstream 0x24
regress/gdrom_default_probe.py:243:#  warn-and-continue line -- measured, not assumed.
regress/gdrom_default_probe.py:244:FMT_DECL = re.compile(r"unimplemented data format 0x[0-9a-f]+ -- declined")
regress/gdrom_default_probe.py:245:CMD_DECL = re.compile(r"unimplemented command 0x[0-9a-f]+ -- declined")
regress/gdrom_default_probe.py:246:
regress/gdrom_default_probe.py:247:rows = []
regress/gdrom_default_probe.py:248:
regress/gdrom_default_probe.py:249:
regress/gdrom_default_probe.py:250:#  *** THE ROW-NAME COLUMN IS 14 AND THE LONGEST NAME IS 12, WHICH IS NOT
regress/gdrom_default_probe.py:251:#  SLACK -- IT IS THE DISCRIMINATOR. ***
regress/gdrom_default_probe.py:252:#
regress/gdrom_default_probe.py:253:#  gate_sh_rounding.sh counts rows with `^$v  .*ok$` -- TWO spaces after the
regress/gdrom_default_probe.py:254:#  name.  Four names here are prefixes of others (`dma rd`/`dma rd x1`,
regress/gdrom_default_probe.py:255:#  `dma rd`/`dma rdleak`, `dma alias`/`dma alias x1`, `scan`/`scan uniq`),
regress/gdrom_default_probe.py:256:#  and they are unambiguous ONLY because %-14s leaves at least two spaces
regress/gdrom_default_probe.py:257:#  after every one of them.  `dma rd` cannot match the `dma rdleak` row
regress/gdrom_default_probe.py:258:#  because that row has an `l` where the pattern needs a space.
regress/gdrom_default_probe.py:259:#
regress/gdrom_default_probe.py:260:#  *** #490 L4: THIS SAID "13 or 14" AND 13 IS FINE.  THE LIMIT IS 13. ***
regress/gdrom_default_probe.py:261:#  The format is `"%-14s %-12s ..."` -- a 14-column field PLUS a literal
regress/gdrom_default_probe.py:262:#  space -- so the padding and that space add up like this, measured:
regress/gdrom_default_probe.py:263:#
regress/gdrom_default_probe.py:264:#      12 chars -> 3 trailing spaces   `^name  ` MATCHES
regress/gdrom_default_probe.py:265:#      13 chars -> 2 trailing spaces   MATCHES  (the comment denied this)
regress/gdrom_default_probe.py:266:#      14 chars -> 1 trailing space    UNSATISFIABLE
regress/gdrom_default_probe.py:267:#
regress/gdrom_default_probe.py:268:#  Found by the codex seat on #490's pass 1, which also caught that I had
regress/gdrom_default_probe.py:269:#  copied the wrong bound ("<= 12") out of this comment and into a design
regress/gdrom_default_probe.py:270:#  brief -- so the error had already propagated once before it was read.
regress/gdrom_default_probe.py:271:#  The extra character is NOT slack to spend casually: at 13 the margin is
regress/gdrom_default_probe.py:272:#  exactly the two spaces the gate needs, with nothing left over.
regress/gdrom_default_probe.py:273:#
regress/gdrom_default_probe.py:274:#  A row named 14 characters leaves fewer than two spaces and its
regress/gdrom_default_probe.py:275:#  check becomes UNSATISFIABLE.  Checked, and this is the SAFE direction:
regress/gdrom_default_probe.py:276:#  the count reads 0 against a wanted 1, so the gate fails LOUDLY rather
regress/gdrom_default_probe.py:277:#  than quietly dropping the row -- the opposite of the padded-column trap
regress/gdrom_default_probe.py:278:#  the carrier records, where a too-long name makes a row stop being
regress/gdrom_default_probe.py:279:#  tested in silence.  Widen the column if a longer name is ever needed;
regress/gdrom_default_probe.py:280:#  do not shorten the name to fit and leave the constraint unstated.
regress/gdrom_default_probe.py:281:def row(name, got, want, note=""):
regress/gdrom_default_probe.py:282:    ok = (got == want)
regress/gdrom_default_probe.py:283:    rows.append((name, ok))
regress/gdrom_default_probe.py:284:    print("%-14s %-12s %-12s %-34s %s" % (name, got, want, note,
regress/gdrom_default_probe.py:285:                                          "ok" if ok else "FAIL"))
regress/gdrom_default_probe.py:286:    return ok
regress/gdrom_default_probe.py:287:
regress/gdrom_default_probe.py:288:
regress/gdrom_default_probe.py:289:def session(cmds, settle=8.0, spin=2.0):
regress/gdrom_default_probe.py:290:    pid, fd = pty.fork()
regress/gdrom_default_probe.py:291:    if pid == 0:
regress/gdrom_default_probe.py:292:        os.execv(BIN, [BIN, "-V", "-x", "-E", "dreamcast", "-M", "64", KERNEL])
regress/gdrom_default_probe.py:293:        os._exit(127)
regress/gdrom_default_probe.py:294:    buf = ""
regress/gdrom_default_probe.py:295:
regress/gdrom_default_probe.py:296:    def rd(t):
regress/gdrom_default_probe.py:297:        nonlocal buf
regress/gdrom_default_probe.py:298:        end = time.time() + t
regress/gdrom_default_probe.py:299:        while time.time() < end:
regress/gdrom_default_probe.py:300:            r, _, _ = select.select([fd], [], [], 0.25)
regress/gdrom_default_probe.py:301:            if not r:
regress/gdrom_default_probe.py:302:                continue
regress/gdrom_default_probe.py:303:            try:
regress/gdrom_default_probe.py:304:                d = os.read(fd, 65536)
regress/gdrom_default_probe.py:305:            except OSError:
regress/gdrom_default_probe.py:306:                return False
regress/gdrom_default_probe.py:307:            if not d:
regress/gdrom_default_probe.py:308:                return False
regress/gdrom_default_probe.py:309:            buf += d.decode("latin-1", "replace")
regress/gdrom_default_probe.py:310:        return True
regress/gdrom_default_probe.py:311:
regress/gdrom_default_probe.py:312:    alive = rd(settle)
regress/gdrom_default_probe.py:313:    for i, c in enumerate(cmds):
regress/gdrom_default_probe.py:314:        try:
regress/gdrom_default_probe.py:315:            os.write(fd, (c + "\n").encode("latin-1"))
regress/gdrom_default_probe.py:316:        except OSError:
regress/gdrom_default_probe.py:317:            alive = False
regress/gdrom_default_probe.py:318:            break
regress/gdrom_default_probe.py:319:        if not rd(spin if i == len(cmds) - 1 else 0.35):
regress/gdrom_default_probe.py:320:            alive = False
regress/gdrom_default_probe.py:321:            break
regress/gdrom_default_probe.py:322:    try:
regress/gdrom_default_probe.py:323:        os.write(fd, b"quit\n")
regress/gdrom_default_probe.py:324:        rd(0.6)
regress/gdrom_default_probe.py:325:    except OSError:
regress/gdrom_default_probe.py:326:        pass
regress/gdrom_default_probe.py:327:    try:
regress/gdrom_default_probe.py:328:        os.close(fd)
regress/gdrom_default_probe.py:329:    except OSError:
regress/gdrom_default_probe.py:330:        pass
regress/gdrom_default_probe.py:331:    #  #490: DEATH-MODE CHANNEL.  `alive` is False only when a read raises OSError or
regress/gdrom_default_probe.py:332:    #  returns empty inside a budget window, so it is true of a HUNG emulator, a FROZEN
regress/gdrom_default_probe.py:333:    #  one, and -- measured -- one ALREADY KILLED after the last budget check.  It cannot
regress/gdrom_default_probe.py:334:    #  tell a clean exit from a signal from a decline.  Round 2 removes two exit(1) sites,
regress/gdrom_default_probe.py:335:    #  after which every mutant AND the correct decline are alike `exit0`, so a survival
regress/gdrom_default_probe.py:336:    #  oracle stops discriminating entirely.
regress/gdrom_default_probe.py:337:    #
regress/gdrom_default_probe.py:338:    #  Spelling COPIED VERBATIM from gdrom_toclen_probe.py rather than invented: two panel
regress/gdrom_default_probe.py:339:    #  seats independently said copy the existing oracle, and a third shape would make the
regress/gdrom_default_probe.py:340:    #  two gdrom probes disagree about what "died" means.
regress/gdrom_default_probe.py:341:    how = "nostatus"
regress/gdrom_default_probe.py:342:    try:
regress/gdrom_default_probe.py:343:        _, stat = os.waitpid(pid, 0)
regress/gdrom_default_probe.py:344:        if os.WIFSIGNALED(stat):
regress/gdrom_default_probe.py:345:            how = "sig%d" % os.WTERMSIG(stat)
regress/gdrom_default_probe.py:346:        elif os.WIFEXITED(stat):
regress/gdrom_default_probe.py:347:            how = "exit%d" % os.WEXITSTATUS(stat)
regress/gdrom_default_probe.py:348:    except OSError:
regress/gdrom_default_probe.py:349:        pass
regress/gdrom_default_probe.py:350:    return buf, alive, how
regress/gdrom_default_probe.py:351:
regress/gdrom_default_probe.py:352:
regress/gdrom_default_probe.py:353:def printed(t, reg):
regress/gdrom_default_probe.py:354:    m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
regress/gdrom_default_probe.py:355:    return m.group(1) if m else "absent"
regress/gdrom_default_probe.py:356:
regress/gdrom_default_probe.py:357:
regress/gdrom_default_probe.py:358:def run(steps, at=CODE):
regress/gdrom_default_probe.py:359:    """Plant a run of instructions, then a self-branch, and step them all."""
regress/gdrom_default_probe.py:360:    put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(steps)]
regress/gdrom_default_probe.py:361:    put += ["put h 0x%x, 0x%04x" % (at + 2 * len(steps), BRA_SELF),
regress/gdrom_default_probe.py:362:            "put h 0x%x, 0x%04x" % (at + 2 * len(steps) + 2, NOP)]
regress/gdrom_default_probe.py:363:    return put + ["pc=0x%x" % at, "step %d" % len(steps)]
regress/gdrom_default_probe.py:364:
regress/gdrom_default_probe.py:365:
regress/gdrom_default_probe.py:366:def ld(reg):
regress/gdrom_default_probe.py:367:    return ["r1=0x%x" % reg, "r2=0"]
regress/gdrom_default_probe.py:368:
regress/gdrom_default_probe.py:369:
regress/gdrom_default_probe.py:370:def pair(setup, ops):
regress/gdrom_default_probe.py:371:    """Plant SEVERAL accesses contiguously and step them all.
regress/gdrom_default_probe.py:372:
regress/gdrom_default_probe.py:373:    *** USE THIS FOR EVERY MULTI-ACCESS ROW. ***  Calling run() twice does NOT
regress/gdrom_default_probe.py:374:    work: each call emits its own `pc=`/`step`, so the second overrides the
regress/gdrom_default_probe.py:375:    first and only ONE access ever executes.  #460 hit exactly this and it
regress/gdrom_default_probe.py:376:    made four latch rows vacuous -- they read a count of 1 whether the latch
regress/gdrom_default_probe.py:377:    worked or not.  Here it turned a CONTROL red instead, which is the loud
regress/gdrom_default_probe.py:378:    direction, and one measurement found it.
regress/gdrom_default_probe.py:379:    """
regress/gdrom_default_probe.py:380:    return setup + run(ops)
regress/gdrom_default_probe.py:381:
regress/gdrom_default_probe.py:382:
regress/gdrom_default_probe.py:383:def st(reg, val):
regress/gdrom_default_probe.py:384:    return ["r7=0x%x" % reg, "r8=0x%08x" % val]
regress/gdrom_default_probe.py:385:
regress/gdrom_default_probe.py:386:
regress/gdrom_default_probe.py:387:#  ---------------------------------------------------------------- controls
