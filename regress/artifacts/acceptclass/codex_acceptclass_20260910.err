405:DEVINIT(i80321)
406:{
407:	struct i80321_data *d;
408:	uint32_t memsize = devinit->machine->physical_ram_in_mb * 1048576;
409:	uint32_t base;
410:	char tmpstr[300];
411:	struct cpu *cpu = devinit->machine->cpus[devinit->
412:	    machine->bootstrap_cpu];
413:	int i;
414:
415:	CHECK_ALLOCATION(d = (struct i80321_data *) malloc(sizeof(struct i80321_data)));
416:	memset(d, 0, sizeof(struct i80321_data));
417:
418:	/*  Connect to the CPU interrupt pin:  */
419:	INTERRUPT_CONNECT(devinit->interrupt_path, d->irq);
420:
421:	/*  Register 32 i80321 interrupts:  */
422:	for (i=0; i<32; i++) {
423:		struct interrupt templ;
424:		char tmpstr2[300];
425:		snprintf(tmpstr2, sizeof(tmpstr2), "%s.i80321.%i",
426:		    devinit->interrupt_path, i);
427:		memset(&templ, 0, sizeof(templ));
428:		templ.line = (uint32_t)1 << i;
429:		templ.name = tmpstr2;
430:		templ.extra = d;
431:		templ.interrupt_assert = i80321_interrupt_assert;
432:		templ.interrupt_deassert = i80321_interrupt_deassert;
433:		interrupt_handler_register(&templ);
434:
435:		/*
436:		 *  Connect the CPU's TMR0 and TMR1 interrupts to these
437:		 *  i80321 timer interrupts (nr 9 and 10):
438:		 */
439:		if (i == 9)
440:			INTERRUPT_CONNECT(tmpstr2, cpu->cd.arm.tmr0_irq);
441:		if (i == 10)
442:			INTERRUPT_CONNECT(tmpstr2, cpu->cd.arm.tmr1_irq);
443:	}
444:
445:	d->status = &cpu->cd.arm.i80321_isrc;
446:	d->enable = &cpu->cd.arm.i80321_inten;
447:
448:	/*  TODO: base = 0 on Iyonix?  */
449:	d->mcu_reg[MCU_SDBR / sizeof(uint32_t)] = base = 0xa0000000;
450:	d->mcu_reg[MCU_SBR0 / sizeof(uint32_t)] = (base + memsize) >> 25;
451:	d->mcu_reg[MCU_SBR1 / sizeof(uint32_t)] = (base + memsize) >> 25;
452:
453:	snprintf(tmpstr, sizeof(tmpstr), "%s.i80321", devinit->interrupt_path);
454:
455:	d->pci_bus = bus_pci_init(devinit->machine,
456:	    tmpstr	/*  pciirq  */,
457:	    0x90000000	/*  TODO: pci_io_offset  */,
458:	    0x90010000	/*  TODO: pci_mem_offset  */,
