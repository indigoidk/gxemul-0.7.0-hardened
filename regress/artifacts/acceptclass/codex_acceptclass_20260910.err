289:def session(cmds, settle=8.0, spin=2.0):
290:    pid, fd = pty.fork()
291:    if pid == 0:
292:        os.execv(BIN, [BIN, "-V", "-x", "-E", "dreamcast", "-M", "64", KERNEL])
293:        os._exit(127)
294:    buf = ""
295:
296:    def rd(t):
297:        nonlocal buf
298:        end = time.time() + t
299:        while time.time() < end:
300:            r, _, _ = select.select([fd], [], [], 0.25)
301:            if not r:
302:                continue
303:            try:
304:                d = os.read(fd, 65536)
305:            except OSError:
306:                return False
307:            if not d:
308:                return False
309:            buf += d.decode("latin-1", "replace")
310:        return True
311:
312:    alive = rd(settle)
313:    for i, c in enumerate(cmds):
314:        try:
315:            os.write(fd, (c + "\n").encode("latin-1"))
316:        except OSError:
317:            alive = False
318:            break
319:        if not rd(spin if i == len(cmds) - 1 else 0.35):
320:            alive = False
321:            break
322:    try:
323:        os.write(fd, b"quit\n")
324:        rd(0.6)
325:    except OSError:
326:        pass
327:    try:
328:        os.close(fd)
329:    except OSError:
330:        pass
331:    #  #490: DEATH-MODE CHANNEL.  `alive` is False only when a read raises OSError or
332:    #  returns empty inside a budget window, so it is true of a HUNG emulator, a FROZEN
333:    #  one, and -- measured -- one ALREADY KILLED after the last budget check.  It cannot
334:    #  tell a clean exit from a signal from a decline.  Round 2 removes two exit(1) sites,
335:    #  after which every mutant AND the correct decline are alike `exit0`, so a survival
336:    #  oracle stops discriminating entirely.
337:    #
338:    #  Spelling COPIED VERBATIM from gdrom_toclen_probe.py rather than invented: two panel
339:    #  seats independently said copy the existing oracle, and a third shape would make the
340:    #  two gdrom probes disagree about what "died" means.
341:    how = "nostatus"
342:    try:
343:        _, stat = os.waitpid(pid, 0)
344:        if os.WIFSIGNALED(stat):
345:            how = "sig%d" % os.WTERMSIG(stat)
346:        elif os.WIFEXITED(stat):
347:            how = "exit%d" % os.WEXITSTATUS(stat)
348:    except OSError:
349:        pass
350:    return buf, alive, how
351:
352:
353:def printed(t, reg):
354:    m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
355:    return m.group(1) if m else "absent"
