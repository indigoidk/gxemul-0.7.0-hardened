547:DEVICE_ACCESS(dreamcast_maple)
548:{
549:	struct dreamcast_maple_data *d = (struct dreamcast_maple_data *) extra;
550:	uint64_t idata = 0, odata = 0;
551:
552:	if (writeflag == MEM_WRITE)
553:		idata = memory_readmax64(cpu, data, len);
554:
555:	switch (relative_addr) {
556:
557:	case 0x04:	/*  MAPLE_DMAADDR  */
558:		if (writeflag == MEM_WRITE) {
559:			d->dmaaddr = idata;
560:			/* debug("[ dreamcast_maple: dmaaddr set to 0x%08x"
561:			    " ]\n", d->dmaaddr);  */
562:		} else {
563:			fatal("[ dreamcast_maple: TODO: read from dmaaddr ]\n");
564:			odata = d->dmaaddr;
565:			exit(1);
566:		}
567:		break;
568:
569:	case 0x10:	/*  MAPLE_RESET2  */
570:		if (writeflag == MEM_WRITE && idata != 0)
571:			fatal("[ dreamcast_maple: UNIMPLEMENTED reset2 value"
572:			    " 0x%08x ]\n", (int)idata);
573:		break;
574:
575:	case 0x14:	/*  MAPLE_ENABLE  */
576:		if (writeflag == MEM_WRITE)
577:			d->enable = idata;
578:		else
579:			odata = d->enable;
580:		break;
581:
582:	case 0x18:	/*  MAPLE_STATE  */
583:		if (writeflag == MEM_WRITE) {
584:			switch (idata) {
585:			case 0:	break;
586:			case 1:	maple_do_dma_xfer(cpu, d);
587:				break;
588:			default:fatal("[ dreamcast_maple: UNIMPLEMENTED "
589:				    "state value %i ]\n", (int)idata);
590:			}
591:		} else {
592:			/*  Always return 0 to indicate DMA xfer complete.  */
593:			odata = 0;
594:		}
595:		break;
596:
597:	case 0x80:	/*  MAPLE_SPEED  */
598:		if (writeflag == MEM_WRITE) {
599:			d->timeout = (idata >> 16) & 0xffff;
600:			/*  TODO: Bits 8..9 are "speed", but only the value
601:			    0 (indicating 2 Mbit/s) should be used.  */
602:			debug("[ dreamcast_maple: timeout set to %i ]\n",
603:			    d->timeout);
604:		} else {
605:			odata = d->timeout << 16;
606:		}
607:		break;
608:
609:	case 0x8c:	/*  MAPLE_RESET  */
610:		if (writeflag == MEM_WRITE) {
611:			if (idata != 0x6155404f && idata != 0x61557f00)
612:				fatal("[ dreamcast_maple: UNIMPLEMENTED reset "
613:				    "value 0x%08x ]\n", (int)idata);
614:			d->enable = 0;
615:		}
616:		break;
617:
618:	case 0xe8:	/*  UNKNOWN_0xe8  */
619:		if (writeflag == MEM_WRITE) {
620:			// The Dreamcast PROM writes 1 here.
621:			if (idata != 1) {
622:				fatal("[ dreamcast_maple: UNIMPLEMENTED 0xe8 "
623:				    "value 0x%08x ]\n", (int)idata);
624:			}
625:		}
626:		break;
627:
628:	default:if (writeflag == MEM_READ) {
629:			fatal("[ dreamcast_maple: UNIMPLEMENTED read from "
630:			    "addr 0x%x ]\n", (int)relative_addr);
631:		} else {
632:			fatal("[ dreamcast_maple: UNIMPLEMENTED write to addr "
633:			    "0x%x: 0x%x ]\n", (int)relative_addr, (int)idata);
634:		}
635:	}
636:
637:	if (writeflag == MEM_READ)
638:		memory_writemax64(cpu, data, len, odata);
639:
640:	return 1;
641:}
642:
643:
644:DEVINIT(dreamcast_maple)
645:{
646:	struct dreamcast_maple_data *d;
647:
648:	CHECK_ALLOCATION(d = (struct dreamcast_maple_data *) malloc(sizeof(struct dreamcast_maple_data)));
649:	memset(d, 0, sizeof(struct dreamcast_maple_data));
650:
651:	memory_device_register(devinit->machine->memory, devinit->name,
652:	    0x5f6c00, 0x100, dev_dreamcast_maple_access, d, DM_DEFAULT, NULL);
653:
654:	/*  Devices connected to port A..D:  */
655:	d->device[0] = &maple_device_controller;
656:	d->device[1] = NULL;
657:	d->device[2] = &maple_device_keyboard;
658:	d->device[3] = NULL;	/*  TODO:  &maple_device_mouse;  */
659:
660:	d->console_handle = console_start_slave_inputonly(
661:	    devinit->machine, "maple", 1);
662:	devinit->machine->main_console_handle = d->console_handle;
663:
664:	machine_add_tickfunction(devinit->machine, dev_maple_tick, d,
665:	    MAPLE_TICK_SHIFT);
666:
667:	return 1;
668:}
