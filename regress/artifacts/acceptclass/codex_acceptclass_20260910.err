regress/gdrom_default_probe.py:389:                   + run([MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:390:row("live", printed(t, "r2") if alive else "died", "0x%x" % LIVE,
regress/gdrom_default_probe.py:391:    "RAM: guest store then guest load")
regress/gdrom_default_probe.py:392:
regress/gdrom_default_probe.py:393:t, alive, how = session(ld(SH4_IPRD) + run([MOV_L_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:394:g = printed(t, "r2") if alive else "died"
regress/gdrom_default_probe.py:395:row("devsig", ("0x%x" % (int(g, 16) & 0xffff)) if g.startswith("0x") else g,
regress/gdrom_default_probe.py:396:    "0x%x" % IPRD_RESET, "SH4 IPRD reset value -- dispatch works")
regress/gdrom_default_probe.py:397:
regress/gdrom_default_probe.py:398:#  An IMPLEMENTED offset, to prove the device is mapped and its arm serves.
regress/gdrom_default_probe.py:399:#
regress/gdrom_default_probe.py:400:#  *** THE FIRST VERSION OF THIS ROW WAS VACUOUS, AND MEASURED SO. ***  It read
regress/gdrom_default_probe.py:401:#  +0x18 and asserted only that the answer started with "0x" -- but `print r2`
regress/gdrom_default_probe.py:402:#  ALWAYS prints hex, so it was green even on a build with `case GDROM_BUSY:`
regress/gdrom_default_probe.py:403:#  DELETED, where +0x18 falls through to the default arm.  It was a
regress/gdrom_default_probe.py:404:#  session-liveness row duplicating `live`, wearing a device row's label.
regress/gdrom_default_probe.py:405:#
regress/gdrom_default_probe.py:406:#  The root cause is worth keeping, because it constrains the fix: a DECLINED
regress/gdrom_default_probe.py:407:#  read at +0x00 returns 0, and a SERVED read of +0x18 ALSO returns 0 on a
regress/gdrom_default_probe.py:408:#  fresh device -- busy, cond, stat and cnt are all zero.  No value-only row
regress/gdrom_default_probe.py:409:#  can tell served from declined here.  So this is now store-then-read-back on
regress/gdrom_default_probe.py:410:#  CNTHI, which RAM cannot fake and a deleted case cannot satisfy.
regress/gdrom_default_probe.py:411:t, alive, how = session(pair(st(BASE + 0x94, 0x5a) + ld(BASE + 0x94),
regress/gdrom_default_probe.py:412:                        [MOV_W_R8_AT_R7, MOV_W_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:413:row("impl ok", printed(t, "r2") if alive else "died", "0x5a",
regress/gdrom_default_probe.py:414:    "CNTHI (+0x94) stores and reads back")
regress/gdrom_default_probe.py:415:
regress/gdrom_default_probe.py:416:#  #490: `rows and` IS LOAD-BEARING, and its absence was a CHECK THAT CANNOT FAIL.
regress/gdrom_default_probe.py:417:#  `all([])` is True, so an empty `rows` printed CONTROL=OK -- the control row whose
regress/gdrom_default_probe.py:418:#  entire job is to prove this probe MEASURED something would certify a run that
regress/gdrom_default_probe.py:419:#  measured nothing, and gate_sh_rounding.sh's `check "... control proves it
regress/gdrom_default_probe.py:420:#  measures" "OK"` would pass on it.  Latent today (all 58 rows always run) and
regress/gdrom_default_probe.py:421:#  reachable the moment any row selection exists, which is why it is closed BEFORE
regress/gdrom_default_probe.py:422:#  that lands rather than with it.  Found by the opus seat while attacking a row
regress/gdrom_default_probe.py:423:#  filter that was withdrawn -- the filter went, the hazard it exposed stayed.
regress/gdrom_default_probe.py:424:print("GDROM_DEF_CONTROL=%s"
regress/gdrom_default_probe.py:425:      % ("OK" if rows and all(ok for _, ok in rows) else "DEAD"))
regress/gdrom_default_probe.py:426:
regress/gdrom_default_probe.py:427:#  ---------------------------------------------------------------- triggers
regress/gdrom_default_probe.py:428:#  Each is ONE guest instruction at an UNIMPLEMENTED offset.  Post-fix every
regress/gdrom_default_probe.py:429:#  one must leave the host alive AND name itself exactly once.
regress/gdrom_default_probe.py:430:SAYS = re.compile(r"dreamcast_gdrom: (?:read from|write to) addr 0x")
regress/gdrom_default_probe.py:431:#  The DMA arm needs its OWN pattern: SAYS cannot match it, because after
regress/gdrom_default_probe.py:432:#  "dreamcast_gdrom" that pattern expects ": " and the DMA text has "_dma: ".
regress/gdrom_default_probe.py:433:#  A seat flagged that before it could become a silently-zero count.
regress/gdrom_default_probe.py:434:DMA_SAYS = re.compile(r"dreamcast_gdrom_dma: (?:read from|write to) addr 0x")
regress/gdrom_default_probe.py:435:
regress/gdrom_default_probe.py:436:for label, cmds, note in (
regress/gdrom_default_probe.py:437:        ("rd lo", ld(UNIMPL_A) + run([MOV_L_AT_R1_R2]),
regress/gdrom_default_probe.py:438:         "32-bit READ at +0x00"),
regress/gdrom_default_probe.py:439:        ("wr lo", st(UNIMPL_B, 0x5a5a5a5a) + run([MOV_L_R8_AT_R7]),
regress/gdrom_default_probe.py:440:         "32-bit WRITE at +0x04"),
regress/gdrom_default_probe.py:441:        ("rd hi", ld(UNIMPL_Z) + run([MOV_L_AT_R1_R2]),
regress/gdrom_default_probe.py:442:         "32-bit READ at +0xfc, far end"),
regress/gdrom_default_probe.py:443:        ("rd w16", ld(UNIMPL_A) + run([MOV_W_AT_R1_R2]),
regress/gdrom_default_probe.py:444:         "16-bit read: width must not matter here")):
regress/gdrom_default_probe.py:445:    t, alive, how = session(cmds)
regress/gdrom_default_probe.py:446:    row(label, "survived" if alive else "died", "survived", note)
regress/gdrom_default_probe.py:447:    row(label.replace(" ", "") + " x1",
regress/gdrom_default_probe.py:448:        ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:449:        "names itself EXACTLY once")
regress/gdrom_default_probe.py:450:
regress/gdrom_default_probe.py:451:#  ------------------------------------------------------- latch SCOPE rows
regress/gdrom_default_probe.py:452:#
regress/gdrom_default_probe.py:453:#  *** THESE ARE THE ROWS THAT DECIDE THE DESIGN, AND NOTHING ELSE CAN SEE IT.
regress/gdrom_default_probe.py:454:#
regress/gdrom_default_probe.py:455:#  A single per-device flag makes ONE unimplemented access silence the other
regress/gdrom_default_probe.py:456:#  247, which is the "1 of 4 kinds" hazard #438 recorded and #443 refused.  A
regress/gdrom_default_probe.py:457:#  per-word bitmap keyed by fault class is the shape #443 shipped for the same
regress/gdrom_default_probe.py:458:#  problem in the same tree.  Only rows that drive TWO DIFFERENT offsets, and
regress/gdrom_default_probe.py:459:#  the SAME offset in BOTH directions, can tell those apart.
regress/gdrom_default_probe.py:460:
regress/gdrom_default_probe.py:461:t, alive, how = session(ld(UNIMPL_A) + run([MOV_L_AT_R1_R2, MOV_L_AT_R1_R2]))
regress/gdrom_default_probe.py:462:row("same twice", ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:463:    "SAME offset twice -> one line")
regress/gdrom_default_probe.py:464:
regress/gdrom_default_probe.py:465:#  r1 then r3, so both loads have their own address register and both can be
regress/gdrom_default_probe.py:466:#  planted contiguously.
regress/gdrom_default_probe.py:467:t, alive, how = session(pair(["r1=0x%x" % UNIMPL_A, "r3=0x%x" % UNIMPL_B, "r2=0"],
regress/gdrom_default_probe.py:468:                        [MOV_L_AT_R1_R2, MOV_L_AT_R3_R2]))
regress/gdrom_default_probe.py:469:row("two offs", ("%d" % len(SAYS.findall(t))) if alive else "died", "2",
regress/gdrom_default_probe.py:470:    "DIFFERENT offsets -> TWO lines, not one")
regress/gdrom_default_probe.py:471:
regress/gdrom_default_probe.py:472:#  *** RE-PINNED 2 -> 1 -> 2. THE SECOND REVERSAL IS THE ONE THAT MATTERS, AND
regress/gdrom_default_probe.py:473:#  IT IS A MEASUREMENT OVERTURNING A VOTE. ***
regress/gdrom_default_probe.py:474:#
regress/gdrom_default_probe.py:475:#  The first draft expected TWO lines, which silently pre-answered the brief's
regress/gdrom_default_probe.py:476:#  own open question about a read/write class split.  The pass-1 panel answered
regress/gdrom_default_probe.py:477:#  it the other way 3-1, on reasoning that read well: #443's classes are KINDS
regress/gdrom_default_probe.py:478:#  OF COMPLAINT rather than directions, the fault here is spatial, and direction
regress/gdrom_default_probe.py:479:#  is already printed in the first line.  I re-pinned to 1 on that.
regress/gdrom_default_probe.py:480:#
regress/gdrom_default_probe.py:481:#  THEN THE MEASURING SEAT BUILT BOTH AND RAN A READ PASS FOLLOWED BY A WRITE
regress/gdrom_default_probe.py:482:#  PASS OVER THE SAME 31 DECLINED OFFSETS:
regress/gdrom_default_probe.py:483:#
regress/gdrom_default_probe.py:484:#      direction x offset   ->  62 lines, 31 unique offsets
regress/gdrom_default_probe.py:485:#      offset only          ->  31 lines, and ZERO WRITE DIAGNOSTICS
regress/gdrom_default_probe.py:486:#
regress/gdrom_default_probe.py:487:#  The read pass latches every offset first, so under offset-only keying a
regress/gdrom_default_probe.py:488:#  guest's writes to unimplemented space are reported NOWHERE.  And the write
regress/gdrom_default_probe.py:489:#  line is the only one that carries `idata` -- the value you need in order to
regress/gdrom_default_probe.py:490:#  model the register later.  That is not padding, and the three seats that
regress/gdrom_default_probe.py:491:#  called it padding were reasoning from #443's structure rather than from this
regress/gdrom_default_probe.py:492:#  arm's behaviour.
regress/gdrom_default_probe.py:493:#
regress/gdrom_default_probe.py:494:#  Restored to 2.  Recorded at length because the project's rule is that
regress/gdrom_default_probe.py:495:#  disagreements are settled EMPIRICALLY and never by vote, and this is the
regress/gdrom_default_probe.py:496:#  case where the vote and the measurement pointed opposite ways -- a 3-1
regress/gdrom_default_probe.py:497:#  majority, overturned by one build.
regress/gdrom_default_probe.py:498:t, alive, how = session(pair(ld(UNIMPL_A) + st(UNIMPL_A, 0x1234),
regress/gdrom_default_probe.py:499:                        [MOV_L_AT_R1_R2, MOV_L_R8_AT_R7]))
regress/gdrom_default_probe.py:500:row("rd then wr", ("%d" % len(SAYS.findall(t))) if alive else "died", "2",
regress/gdrom_default_probe.py:501:    "SAME offset, both directions -> TWO lines")
regress/gdrom_default_probe.py:502:
regress/gdrom_default_probe.py:503:#  GRANULARITY, and it is a design commitment nothing else pins.  Per-WORD
regress/gdrom_default_probe.py:504:#  keying merges +0x00..+0x03 into one bit; per-BYTE keying would give four.
regress/gdrom_default_probe.py:505:#  A seat flagged that the brief chose per-word silently, and a second named the
regress/gdrom_default_probe.py:506:#  mutant it protects against: indexing the bitmap with `relative_addr` instead
regress/gdrom_default_probe.py:507:#  of `relative_addr >> 2`, which under a [2] array writes past the end while
regress/gdrom_default_probe.py:508:#  still printing exactly once -- every other row green, host memory corrupted.
regress/gdrom_default_probe.py:509:#  Under raw-byte indexing these two accesses latch different bits and print
regress/gdrom_default_probe.py:510:#  twice, so this row reddens where the others cannot see it.
regress/gdrom_default_probe.py:511:t, alive, how = session(pair(["r1=0x%x" % UNIMPL_A, "r3=0x%x" % (UNIMPL_A + 2), "r2=0"],
regress/gdrom_default_probe.py:512:                        [MOV_L_AT_R1_R2, MOV_W_AT_R3_R2]))
regress/gdrom_default_probe.py:513:row("granularity", ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:514:    "+0x00 then +0x02 are ONE word -> one line")
regress/gdrom_default_probe.py:515:
regress/gdrom_default_probe.py:516:#  ---------------------------------------------------------------- accept side
regress/gdrom_default_probe.py:517:#
regress/gdrom_default_probe.py:518:#  The de-escalation clause: this fix removes a host-fatal predicate, so the
regress/gdrom_default_probe.py:519:#  detector must pin that the IMPLEMENTED offsets still work.  Without these,
regress/gdrom_default_probe.py:520:#  a mutant that turns the whole switch into `default:` -- or simply deletes
regress/gdrom_default_probe.py:521:#  the implemented arms -- scores full marks on every row above.
regress/gdrom_default_probe.py:522:
regress/gdrom_default_probe.py:523:t, alive, how = session(pair(st(IMPL_CNTLO, 0x98) + ld(IMPL_CNTLO),
regress/gdrom_default_probe.py:524:                        [MOV_W_R8_AT_R7, MOV_W_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:525:row("accept cnt", printed(t, "r2") if alive else "died", "0x98",
regress/gdrom_default_probe.py:526:    "CNTLO (+0x90) still stores and reads back")
regress/gdrom_default_probe.py:527:
regress/gdrom_default_probe.py:528:t, alive, how = session(pair(st(IMPL_COND, 0xa0) + ld(IMPL_BUSY),
regress/gdrom_default_probe.py:529:                        [MOV_W_R8_AT_R7, MOV_W_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:530:row("accept cond", printed(t, "r2") if alive else "died", "0x8",
regress/gdrom_default_probe.py:531:    "COND=0xa0 (+0x9c) still sets BUSY bit 3")
regress/gdrom_default_probe.py:532:
regress/gdrom_default_probe.py:533:#  ------------------------------------------------------------- the window scan
regress/gdrom_default_probe.py:534:#
regress/gdrom_default_probe.py:535:#  *** THE SCAN AND THE GRANULARITY ROW KILL DIFFERENT MUTANTS AND NEITHER
regress/gdrom_default_probe.py:536:#  SUBSUMES THE OTHER -- measured, against the measuring seat's own prediction
regress/gdrom_default_probe.py:537:#  that the scan would cover everything. ***
regress/gdrom_default_probe.py:538:#
regress/gdrom_default_probe.py:539:#      counter capped at 4   scan 4 != 56  KILLED   granularity 1  survives
regress/gdrom_default_probe.py:540:#      key mask off & 0x7f   scan 32 != 56 KILLED   granularity 1  survives
regress/gdrom_default_probe.py:541:#      index by raw address  scan 15 != 56 KILLED   granularity 2  KILLED
regress/gdrom_default_probe.py:542:#
regress/gdrom_default_probe.py:543:#  *** THE THIRD ROW SAID `scan 56 == 56 SURVIVES` UNTIL A PASS-2 SEAT
regress/gdrom_default_probe.py:544:#  MEASURED IT AT 15. ***  The old number was the pass-1 analysis of a design
regress/gdrom_default_probe.py:545:#  WITHOUT the bounds guard, and it survived into the shipped comment beside a
regress/gdrom_default_probe.py:546:#  table that already refuted it.  With the guard, raw indexing makes every
regress/gdrom_default_probe.py:547:#  offset >= 0x40 exceed the 64 keys and be rejected, so 41 of the 56 declined
regress/gdrom_default_probe.py:548:#  offsets never report and the scan reads 15.
regress/gdrom_default_probe.py:549:#
regress/gdrom_default_probe.py:550:#  So the scan DOES kill this one, and `granularity` is no longer its sole
regress/gdrom_default_probe.py:551:#  killer.  *** KEEP THE GRANULARITY ROW ANYWAY, but for the honest reason:
regress/gdrom_default_probe.py:552:#  it pins a DESIGN COMMITMENT (per-word keying) cheaply and directly, rather
regress/gdrom_default_probe.py:553:#  than because it is the only row that can see this mutant. ***  The same
regress/gdrom_default_probe.py:554:#  seat measured that across six mutants `scan uniq` kills everything anything
regress/gdrom_default_probe.py:555:#  kills -- so the subsumption claim this block was built on is false in the
regress/gdrom_default_probe.py:556:#  other direction too, and saying so is cheaper than a row that pretends.
regress/gdrom_default_probe.py:557:#
regress/gdrom_default_probe.py:558:#  The magnitude claim was overstated as well.  A guardless `bits[k]` reaches
regress/gdrom_default_probe.py:559:#  dma_reg[0..3] -- count, destination and length -- but NOT dma_reg[5], the
regress/gdrom_default_probe.py:560:#  enable, which needs word index 11 against a maximum of 9.  "The two fields
regress/gdrom_default_probe.py:561:#  that authorise a transfer" was wrong; it is three of the four.
regress/gdrom_default_probe.py:562:#
regress/gdrom_default_probe.py:563:#  EQUALITY, not >=, so this doubles as an IDENTITY row: 64 word keys minus 8
regress/gdrom_default_probe.py:564:#  implemented offsets is exactly 56.  A ninth implemented register moves it to
regress/gdrom_default_probe.py:565:#  55 in the same commit, which is the fail-closed ratchet gate_hygiene already
regress/gdrom_default_probe.py:566:#  uses for EXPECT_CONVERTED.
regress/gdrom_default_probe.py:567:#  ONE session, not 56.  A per-offset session took over ten minutes; a planted
regress/gdrom_default_probe.py:568:#  linear run of `mov.l @r1,r2 ; add #4,r1` walks the whole window in one.
regress/gdrom_default_probe.py:569:#  Implemented offsets are NOT skipped -- they emit nothing matching SAYS, which
regress/gdrom_default_probe.py:570:#  is exactly what `accept8` proves independently, so the count is still 56.
regress/gdrom_default_probe.py:571:ops = []
regress/gdrom_default_probe.py:572:for _ in range(0x100 // 4):
regress/gdrom_default_probe.py:573:    ops += [MOV_L_AT_R1_R2, ADD_4_R1]
regress/gdrom_default_probe.py:574:t, alive, how = session(["r1=0x%x" % BASE, "r2=0"] + run(ops), settle=8.0, spin=3.0)
regress/gdrom_default_probe.py:575:hits = SAYS.findall(t)
regress/gdrom_default_probe.py:576:row("scan", "survived" if alive else "died", "survived",
regress/gdrom_default_probe.py:577:    "all 64 words of the window, one run")
regress/gdrom_default_probe.py:578:row("scan uniq", ("%d" % len(hits)) if alive else "died", "56",
regress/gdrom_default_probe.py:579:    "64 words - 8 implemented = 56 declines")
regress/gdrom_default_probe.py:580:
regress/gdrom_default_probe.py:581:#  ------------------------------------------------- the accept side that MATTERS
regress/gdrom_default_probe.py:582:#
regress/gdrom_default_probe.py:583:#  *** THREE OF FOUR NARROWING MUTANTS SCORED A PERFECT 16/16 WITHOUT THIS ROW,
regress/gdrom_default_probe.py:584:#  AND ONE OF THEM SILENTLY UNDOES THE PREVIOUS ROUND. ***
regress/gdrom_default_probe.py:585:#
regress/gdrom_default_probe.py:586:#  The measuring seat built Option B and then deleted ONE `case` label at a
regress/gdrom_default_probe.py:587:#  time -- a one-line edit, exactly the shape a "fold this stub into the
regress/gdrom_default_probe.py:588:#  default" tidy-up takes:
regress/gdrom_default_probe.py:589:#
regress/gdrom_default_probe.py:590:#      delete case GDROM_STAT  (+0x8c)  ->  16/16   the register NetBSD polls
regress/gdrom_default_probe.py:591:#                                                   before every command is dead
regress/gdrom_default_probe.py:592:#      delete case GDROM_DATA  (+0x80)  ->  16/16   #460'S ENTIRE ROUND UNDONE
regress/gdrom_default_probe.py:593:#      delete case GDROM_CNTHI (+0x94)  ->  16/16   transfer-count high byte dead
regress/gdrom_default_probe.py:594:#      delete case GDROM_BUSY  (+0x18)  ->  15/16   caught, but only by accident
regress/gdrom_default_probe.py:595:#
regress/gdrom_default_probe.py:596:#  This is the de-escalation clause's own scenario at its sharpest: BEFORE this
regress/gdrom_default_probe.py:597:#  fix, deleting `case GDROM_STAT:` meant exit(1) on the first status poll --
regress/gdrom_default_probe.py:598:#  unmissable.  AFTER it, a silently wrong status forever.  The fix destroys the
regress/gdrom_default_probe.py:599:#  accidental tripwire for its own accept side, so the round owes this row.
regress/gdrom_default_probe.py:600:#
regress/gdrom_default_probe.py:601:#  Read all EIGHT implemented offsets and require the default arm
regress/gdrom_default_probe.py:602:#
regress/gdrom_default_probe.py:603:#  *** THIS SAID "in one session" AND THE LOOP BELOW REFUTES IT. ***  It runs
regress/gdrom_default_probe.py:604:#  EIGHT emulator processes and concatenates their output, which the comment
regress/gdrom_default_probe.py:605:#  eight lines down states correctly -- so two drafts of the same paragraph
regress/gdrom_default_probe.py:606:#  disagreed and the wrong one was on top.  It is equivalent HERE only because
regress/gdrom_default_probe.py:607:#  the expectation is a count of ZERO, which concatenation preserves; a row
regress/gdrom_default_probe.py:608:#  expecting a NON-zero count would have been silently wrong.
regress/gdrom_default_probe.py:609:#  to have printed NOTHING.  Safe by reading: none of the eight arms emits text
regress/gdrom_default_probe.py:610:#  matching SAYS -- BUSY/STAT/CNTLO/CNTHI/COND are silent, REGX says
regress/gdrom_default_probe.py:611:#  "[ Read to GDROM_REGX? ]", UNKNOWN_0x88 says "Read from GDROM_UNKNOWN_0x88?"
regress/gdrom_default_probe.py:612:#  with no `dreamcast_gdrom:` prefix, and #460's warns say "read from
regress/gdrom_default_probe.py:613:#  GDROM_DATA", not "read from addr 0x".
regress/gdrom_default_probe.py:614:#  Same tuple as the scan uses -- one definition, so the two rows can never
regress/gdrom_default_probe.py:615:#  disagree about which offsets are implemented.
regress/gdrom_default_probe.py:616:IMPLEMENTED = IMPLEMENTED_WORDS
regress/gdrom_default_probe.py:617:#  Eight loads through ONE address register, re-pointed between steps is not
regress/gdrom_default_probe.py:618:#  possible in a single run -- so use r1 and step the loads one at a time with
regress/gdrom_default_probe.py:619:#  an explicit pc per access, which is the one place the two-run hazard does
regress/gdrom_default_probe.py:620:#  NOT apply because each access is its own complete run.
regress/gdrom_default_probe.py:621:t = ""
regress/gdrom_default_probe.py:622:alive = True
regress/gdrom_default_probe.py:623:for i, off in enumerate(IMPLEMENTED):
regress/gdrom_default_probe.py:624:    tt, aa, hh = session(pair(["r1=0x%x" % (BASE + off), "r2=0"], [MOV_W_AT_R1_R2]))
regress/gdrom_default_probe.py:625:    t += tt
regress/gdrom_default_probe.py:626:    alive = alive and aa
regress/gdrom_default_probe.py:627:row("accept8", ("%d" % len(SAYS.findall(t))) if alive else "died", "0",
regress/gdrom_default_probe.py:628:    "all EIGHT implemented offsets stay off the default arm")
regress/gdrom_default_probe.py:629:
regress/gdrom_default_probe.py:630:#  And GDROM_DATA's own accept side, which also closes an escape already filed
regress/gdrom_default_probe.py:631:#  against #460: no row there pinned what a declined DATA read returns.
regress/gdrom_default_probe.py:632:t, alive, how = session(ld(BASE + 0x80) + run([MOV_W_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:633:g = printed(t, "r2") if alive else "died"
regress/gdrom_default_probe.py:634:row("data 0xffff", ("0x%x" % (int(g, 16) & 0xffff)) if g.startswith("0x") else g,
regress/gdrom_default_probe.py:635:    "0xffff", "+0x80 still declines with 0xffff, not via default")
regress/gdrom_default_probe.py:636:
regress/gdrom_default_probe.py:637:#  ---------------------------------------------------------------- the DMA window
regress/gdrom_default_probe.py:638:#
regress/gdrom_default_probe.py:639:#  *** THE DMA ARM JOINED THIS ROUND ON A MEASUREMENT AND HAD NO ROW AT ALL. ***
regress/gdrom_default_probe.py:640:#  Every row above drives the CONTROL window at 0x005f7000; the sibling arm at
regress/gdrom_default_probe.py:641:#  0x005f7400 was fixed and pinned by nothing.  A round that claims to fix two
regress/gdrom_default_probe.py:642:#  arms and covers one is making a claim its own detector cannot support, so
regress/gdrom_default_probe.py:643:#  these ship with the fix rather than after it.
regress/gdrom_default_probe.py:644:t, alive, how = session(pair(["r1=0x%x" % DMA, "r2=0"], [MOV_L_AT_R1_R2]))
regress/gdrom_default_probe.py:645:row("dma rd", "survived" if alive else "died", "survived",
regress/gdrom_default_probe.py:646:    "32-bit READ at DMA+0x00")
regress/gdrom_default_probe.py:647:row("dma rd x1", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:648:    "the DMA arm names itself EXACTLY once")
regress/gdrom_default_probe.py:649:
regress/gdrom_default_probe.py:650:t, alive, how = session(pair(["r1=0x%x" % (DMA + 0x00), "r3=0x%x" % (DMA + 0x7c), "r2=0"],
regress/gdrom_default_probe.py:651:                        [MOV_L_AT_R1_R2, MOV_L_AT_R3_R2]))
regress/gdrom_default_probe.py:652:row("dma two", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "2",
regress/gdrom_default_probe.py:653:    "DIFFERENT DMA offsets -> TWO lines, separate array")
regress/gdrom_default_probe.py:654:
regress/gdrom_default_probe.py:655:#  *** THE ASYMMETRY THIS ROUND HAD TO NAME, NOW PINNED. ***  In the control
regress/gdrom_default_probe.py:656:#  window declining returns 0 and a declined write does nothing.  Here `odata`
regress/gdrom_default_probe.py:657:#  is preloaded from the shadow register file before the switch and the tail
regress/gdrom_default_probe.py:658:#  STORES a declined write into it -- so "decline" means store-and-return, which
regress/gdrom_default_probe.py:659:#  is what the five implemented cases already do and is kept deliberately.
regress/gdrom_default_probe.py:660:#  Without this row that difference is a claim in a comment and nothing else.
regress/gdrom_default_probe.py:661:t, alive, how = session(pair(["r7=0x%x" % DMA, "r8=0x12345678", "r1=0x%x" % DMA, "r2=0"],
regress/gdrom_default_probe.py:662:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:663:row("dma shadow", printed(t, "r2") if alive else "died", "0x12345678",
regress/gdrom_default_probe.py:664:    "a declined DMA write STORES and reads back")
regress/gdrom_default_probe.py:665:
regress/gdrom_default_probe.py:666:#  *** THE ROW A PASS-2 SEAT'S DO-NOT-SHIP REQUIRED. ***
regress/gdrom_default_probe.py:667:#
regress/gdrom_default_probe.py:668:#  The tail store indexes with TRUNCATING division, so a byte write at DMA+0x05
regress/gdrom_default_probe.py:669:#  does not match `case 0x04`, reaches the default arm, is declined -- and then
regress/gdrom_default_probe.py:670:#  the tail writes it into dma_reg[1], the DMA DESTINATION.  The same alias
regress/gdrom_default_probe.py:671:#  reaches dma_reg[2] (length), dma_reg[3] (count) and dma_reg[5] (enable) from
regress/gdrom_default_probe.py:672:#  +0x09, +0x0d and +0x15, which between them are the whole transfer.
regress/gdrom_default_probe.py:673:#
regress/gdrom_default_probe.py:674:#  PRE-FIX those accesses exited instead, so the fix would have CREATED the
regress/gdrom_default_probe.py:675:#  capability.  This row pins that it does not: write 0xff at +0x05, then read
regress/gdrom_default_probe.py:676:#  +0x04 back and require it UNCHANGED.
regress/gdrom_default_probe.py:677:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
regress/gdrom_default_probe.py:678:                         "r1=0x%x" % (DMA + 0x04), "r2=0"],
regress/gdrom_default_probe.py:679:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:680:row("dma seed", printed(t, "r2") if alive else "died", "0x11223344",
regress/gdrom_default_probe.py:681:    "the implemented +0x04 takes a known value")
regress/gdrom_default_probe.py:682:
regress/gdrom_default_probe.py:683:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
regress/gdrom_default_probe.py:684:                         "r5=0x%x" % (DMA + 0x05), "r6=0xff",
regress/gdrom_default_probe.py:685:                         "r1=0x%x" % (DMA + 0x04), "r2=0"],
regress/gdrom_default_probe.py:686:                        [MOV_L_R8_AT_R7, MOV_B_R6_AT_R5, MOV_L_AT_R1_R2])
regress/gdrom_default_probe.py:687:                   + ["print r2"])
regress/gdrom_default_probe.py:688:row("dma alias", printed(t, "r2") if alive else "died", "0x11223344",
regress/gdrom_default_probe.py:689:    "a declined +0x05 must NOT reach dma_reg[1]")
regress/gdrom_default_probe.py:690:#  ... and the row above is only meaningful if the store EXECUTED.  A wrong
regress/gdrom_default_probe.py:691:#  opcode constant would leave +0x04 untouched and the row green -- the
regress/gdrom_default_probe.py:692:#  hand-assembled-encoding trap exactly.  The declined +0x05 must announce.
regress/gdrom_default_probe.py:693:row("dma alias x1", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:694:    "the +0x05 store really reached the default arm")
regress/gdrom_default_probe.py:695:
regress/gdrom_default_probe.py:696:#  *** ONE CHARACTER RE-OPENS THE DEFECT ABOVE, AND `dma alias` CANNOT SEE IT. ***
regress/gdrom_default_probe.py:697:#
regress/gdrom_default_probe.py:698:#  A pass-2 seat weakened the guard to `relative_addr & 1` and scored 27/27.
regress/gdrom_default_probe.py:699:#  That form still drops the ODD address `dma alias` uses, so that row is
regress/gdrom_default_probe.py:700:#  STRUCTURALLY BLIND to it -- yet a 16-bit store at +0x06 is 2-byte aligned,
regress/gdrom_default_probe.py:701:#  passes `& 1`, and the tail writes it into dma_reg[1] exactly as before.
regress/gdrom_default_probe.py:702:#
regress/gdrom_default_probe.py:703:#  The discriminator is WIDTH, not oddness.  This row uses mov.w at an EVEN but
regress/gdrom_default_probe.py:704:#  not word-aligned address, which is the cheapest access the weaker guard lets
regress/gdrom_default_probe.py:705:#  through -- and it is architecturally legal, so a real guest can issue it.
regress/gdrom_default_probe.py:706:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
regress/gdrom_default_probe.py:707:                         "r5=0x%x" % (DMA + 0x06), "r6=0xffff",
regress/gdrom_default_probe.py:708:                         "r1=0x%x" % (DMA + 0x04), "r2=0"],
regress/gdrom_default_probe.py:709:                        [MOV_L_R8_AT_R7, MOV_W_R6_AT_R5, MOV_L_AT_R1_R2])
regress/gdrom_default_probe.py:710:                   + ["print r2"])
regress/gdrom_default_probe.py:711:row("dma align16", printed(t, "r2") if alive else "died", "0x11223344",
regress/gdrom_default_probe.py:712:    "a 2-byte-aligned +0x06 must NOT reach dma_reg[1]")
regress/gdrom_default_probe.py:713:
regress/gdrom_default_probe.py:714:#  THE SAME DEFECT POINTING THE OTHER WAY.  The source comment claims the guard
regress/gdrom_default_probe.py:715:#  "also stops leaking the aliased word's value" -- and no row pinned it, so a
regress/gdrom_default_probe.py:716:#  seat restricted the guard to `&& writeflag == MEM_WRITE`, scored 27/27, and
regress/gdrom_default_probe.py:717:#  read dma_reg[1] out through a 16-bit load at +0x06.  An UNPINNED CLAIM IN A
regress/gdrom_default_probe.py:718:#  COMMENT IS NOT A PROPERTY.
regress/gdrom_default_probe.py:719:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x04), "r8=0x11223344",
regress/gdrom_default_probe.py:720:                         "r3=0x%x" % (DMA + 0x06), "r2=0"],
regress/gdrom_default_probe.py:721:                        [MOV_L_R8_AT_R7, MOV_W_AT_R3_R2]) + ["print r2"])
regress/gdrom_default_probe.py:722:row("dma rdleak", printed(t, "r2") if alive else "died", "0x0",
regress/gdrom_default_probe.py:723:    "an unaligned declined READ returns 0, not the aliased word")
regress/gdrom_default_probe.py:724:
regress/gdrom_default_probe.py:725:#  *** THE SEPARATE-ARRAYS CLAIM, WHICH NO ROW REACHED. ***
regress/gdrom_default_probe.py:726:#
regress/gdrom_default_probe.py:727:#  Two windows, two latch arrays, and the source calls confusing them
regress/gdrom_default_probe.py:728:#  "invisible by construction".  It WAS: every row above drives ONE window, so
regress/gdrom_default_probe.py:729:#  a DMA arm keyed into the control array passes all of them, and so does a
regress/gdrom_default_probe.py:730:#  control arm keyed into the DMA array (which additionally writes past it).
regress/gdrom_default_probe.py:731:#
regress/gdrom_default_probe.py:732:#  Both windows in ONE session at the SAME word index, so a shared array
regress/gdrom_default_probe.py:733:#  latches the first access and SILENCES the second.  Different indices would
regress/gdrom_default_probe.py:734:#  not do it -- that is why this row is not `dma two` with a control offset.
regress/gdrom_default_probe.py:735:#
regress/gdrom_default_probe.py:736:#  *** IT DRIVES BOTH DIRECTIONS, AND THE READ-ONLY VERSION WAS WEAKER. ***  A
regress/gdrom_default_probe.py:737:#  seat pointed out that a read-only row is blind to a DIRECTION-ASYMMETRIC
regress/gdrom_default_probe.py:738:#  cross-wiring -- only the WR arms swapped -- because every other row that
regress/gdrom_default_probe.py:739:#  counts a write diagnostic drives ONE window.  Four accesses in the same
regress/gdrom_default_probe.py:740:#  session cost nothing extra and expect 2/2, which additionally kills that
regress/gdrom_default_probe.py:741:#  variant (it would read 2/1).
regress/gdrom_default_probe.py:742:t, alive, how = session(pair(["r1=0x%x" % UNIMPL_A, "r3=0x%x" % (DMA + 0x00),
regress/gdrom_default_probe.py:743:                         "r7=0x%x" % UNIMPL_A, "r8=0x5a5a5a5a",
regress/gdrom_default_probe.py:744:                         "r5=0x%x" % (DMA + 0x00), "r6=0x5a", "r2=0"],
regress/gdrom_default_probe.py:745:                        [MOV_L_AT_R1_R2, MOV_L_AT_R3_R2,
regress/gdrom_default_probe.py:746:                         MOV_L_R8_AT_R7, MOV_L_R6_AT_R5]))
regress/gdrom_default_probe.py:747:row("both windows",
regress/gdrom_default_probe.py:748:    ("%d/%d" % (len(SAYS.findall(t)), len(DMA_SAYS.findall(t)))) if alive else "died",
regress/gdrom_default_probe.py:749:    "2/2", "same word index, both windows, BOTH directions")
regress/gdrom_default_probe.py:750:
regress/gdrom_default_probe.py:751:#  *** THE OBLIGATION THIS ROUND OWED AND HAD NOT PAID. ***
regress/gdrom_default_probe.py:752:#
regress/gdrom_default_probe.py:753:#  `accept8` exists because three narrowing mutants -- deleting ONE `case`
regress/gdrom_default_probe.py:754:#  label at a time -- each scored full marks against the control window.  The
regress/gdrom_default_probe.py:755:#  de-escalation clause says a fatal->survive fix DELETES the accidental
regress/gdrom_default_probe.py:756:#  tripwire that made such an edit self-announcing, so the detector must pin
regress/gdrom_default_probe.py:757:#  the ACCEPT SIDE of every de-fatalised predicate.
regress/gdrom_default_probe.py:758:#
regress/gdrom_default_probe.py:759:#  The DMA window got the same fix and NO accept row.  A seat traced it: delete
regress/gdrom_default_probe.py:760:#  `case 0x18:` and the DMA trigger silently dies forever, where BEFORE this
regress/gdrom_default_probe.py:761:#  round that deletion was a loud exit on the first touch.  That is the clause's
regress/gdrom_default_probe.py:762:#  own scenario, applied to one window and not the other.
regress/gdrom_default_probe.py:763:#
regress/gdrom_default_probe.py:764:#  *** A READ AT +0x18 IS SAFE, AND THE REASON IS NOT THE ONE THE FIRST
regress/gdrom_default_probe.py:765:#  DRAFT OF THIS COMMENT GAVE. ***  It said 'the arm is guarded on idata',
regress/gdrom_default_probe.py:766:#  which is true but stops one step short of the property that matters.
regress/gdrom_default_probe.py:767:#
regress/gdrom_default_probe.py:768:#  `case 0x18` arms on `if (idata != 0)` with NO write-direction test of its
regress/gdrom_default_probe.py:769:#  own.  What makes a read safe is 140 lines above it: `idata` is declared
regress/gdrom_default_probe.py:770:#  `= 0` and assigned ONLY under `if (writeflag == MEM_WRITE)`, so on a read
regress/gdrom_default_probe.py:771:#  it keeps its initialiser and the arm cannot fire.  That is a real, local,
regress/gdrom_default_probe.py:772:#  self-contained guarantee -- NOT an accident of memory_rw memsetting the
regress/gdrom_default_probe.py:773:#  caller's buffer, which is what it would be if idata were loaded
regress/gdrom_default_probe.py:774:#  unconditionally.
regress/gdrom_default_probe.py:775:#
regress/gdrom_default_probe.py:776:#  Written out because a pass-3 seat asked for an explicit write-direction
regress/gdrom_default_probe.py:777:#  condition around the arming, not seeing that one already exists at that
regress/gdrom_default_probe.py:778:#  distance.  A guard 140 lines from what it protects is correct and hard to
regress/gdrom_default_probe.py:779:#  see, and this row depends on it.
regress/gdrom_default_probe.py:780:t = ""
regress/gdrom_default_probe.py:781:alive = True
regress/gdrom_default_probe.py:782:for off in (0x04, 0x08, 0x0c, 0x14, 0x18):
regress/gdrom_default_probe.py:783:    tt, aa, hh = session(pair(["r1=0x%x" % (DMA + off), "r2=0"], [MOV_L_AT_R1_R2]))
regress/gdrom_default_probe.py:784:    t += tt
regress/gdrom_default_probe.py:785:    alive = alive and aa
regress/gdrom_default_probe.py:786:row("dma accept", ("%d" % len(DMA_SAYS.findall(t))) if alive else "died", "0",
regress/gdrom_default_probe.py:787:    "all five implemented DMA offsets stay off the default arm")
regress/gdrom_default_probe.py:788:
regress/gdrom_default_probe.py:789:#  ========================================================================
regress/gdrom_default_probe.py:790:#  #462: the DMA+0x18 pair.  Both sites ENDED THE HOST PROCESS on the
regress/gdrom_default_probe.py:791:#  committed build, each measured with its own device-signature control.
regress/gdrom_default_probe.py:792:#
regress/gdrom_default_probe.py:793:#  The design came out of a three-way disagreement that measurement settled:
regress/gdrom_default_probe.py:794:#  two seats said de-fatalising would HANG Linux in its poll loop; one said
regress/gdrom_default_probe.py:795:#  latch-and-break; the flagship seat read the driver and found BOTH
regress/gdrom_default_probe.py:796:#  incomplete -- every wait in that path is time-bounded (HZ*7 after the
regress/gdrom_default_probe.py:797:#  trigger, HZ/2 before it), so a decline gives bounded EIO rather than a
regress/gdrom_default_probe.py:798:#  hang, BUT a bare `break` leaves the trigger value in the shadow.
regress/gdrom_default_probe.py:799:DMA_ARM = re.compile(r"unsupported arming, declined")
regress/gdrom_default_probe.py:800:DMA_NOD = re.compile(r"DMA start with no staged data -- declined")
regress/gdrom_default_probe.py:801:
regress/gdrom_default_probe.py:802:#  --- the ARMING-MISMATCH arm (on HEAD :845), armed wrongly
regress/gdrom_default_probe.py:803:#  (count/enable not both 1 on a fresh device) ---
regress/gdrom_default_probe.py:804:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1"],
regress/gdrom_default_probe.py:805:                        [MOV_L_R8_AT_R7]) + ["print r8"])
regress/gdrom_default_probe.py:806:row("arm survive", "survived" if alive else "died", "survived",
regress/gdrom_default_probe.py:807:    "one store to +0x18 no longer ends the host")
regress/gdrom_default_probe.py:808:row("arm says", ("%d" % len(DMA_ARM.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:809:    "and the decline SPEAKS -- a silent decline is what this round argued against")
regress/gdrom_default_probe.py:810:
regress/gdrom_default_probe.py:811:#  *** THE ROW THAT MATTERS, and no panel seat named the defect it pins. ***
regress/gdrom_default_probe.py:812:#
regress/gdrom_default_probe.py:813:#  The window's tail store writes idata into dma_reg[6] after every aligned
regress/gdrom_default_probe.py:814:#  break, and the SUCCESS arm sets `idata = 0` first -- which is why a
regress/gdrom_default_probe.py:815:#  completed transfer polls idle.  Drop the exit(1) and simply break, the
regress/gdrom_default_probe.py:816:#  shape #447/#459/#460/#461 all used at their sites, and the guest's
regress/gdrom_default_probe.py:817:#  trigger value 1 reaches the shadow: +0x18 then reads BUSY FOREVER.
regress/gdrom_default_probe.py:818:#
regress/gdrom_default_probe.py:819:#  Linux survives that (bounded waits) -- and Linux is the guest this rests
regress/gdrom_default_probe.py:820:#  on: mainline byte-reads +0x18 to poll completion.  *** THE NetBSD HALF OF
regress/gdrom_default_probe.py:821:#  THIS COMMENT WAS WRONG AND IS CORRECTED HERE. ***  It cited
regress/gdrom_default_probe.py:822:#  `while ((GDROM_BUSY & 0x88) != 0x08) ;` as an unbounded poll of +0x18.
regress/gdrom_default_probe.py:823:#  That loop needs bit 3 SET and bit 7 CLEAR; +0x18 is {0, 1} and neither
regress/gdrom_default_probe.py:824:#  ANDs to 0x08, so it would hang on CORRECT hardware.  It is the
regress/gdrom_default_probe.py:825:#  command-start handshake on the CONTROL window's BUSY register, which
regress/gdrom_default_probe.py:826:#  dev_dreamcast_gdrom.c's GDROM_COND case documents outright.  This row is
regress/gdrom_default_probe.py:827:#  still the difference between the fix and the obvious fix.
regress/gdrom_default_probe.py:828:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
regress/gdrom_default_probe.py:829:                         "r1=0x%x" % (DMA + 0x18), "r2=0"],
regress/gdrom_default_probe.py:830:                        [MOV_L_R8_AT_R7, MOV_L_AT_R1_R2]) + ["print r2"])
regress/gdrom_default_probe.py:831:row("arm idle", printed(t, "r2") if alive else "died", "0x0",
regress/gdrom_default_probe.py:832:    "+0x18 reads IDLE after a declined trigger, not busy-forever")
regress/gdrom_default_probe.py:833:
regress/gdrom_default_probe.py:834:#  *** A CLAUSE (d) ESCAPE, NAMED BY A PACKET-FED SEAT ON THE PASS-2 BRIEF
regress/gdrom_default_probe.py:835:#  AND CONFIRMED BY READING THIS FILE.  It keeps BOTH guards and BOTH
regress/gdrom_default_probe.py:836:#  diagnostics and nulls only the repair:
regress/gdrom_default_probe.py:837:#
regress/gdrom_default_probe.py:838:#      if (d->dma_reg[0x0c / sizeof(uint32_t)] == 0 &&
regress/gdrom_default_probe.py:839:#          d->dma_reg[0x14 / sizeof(uint32_t)] == 0)
regress/gdrom_default_probe.py:840:#              idata = 0;
regress/gdrom_default_probe.py:841:#
regress/gdrom_default_probe.py:842:#  `arm idle` above writes ONLY +0x18, so on a fresh device count and enable
regress/gdrom_default_probe.py:843:#  are both 0, that condition is TRUE, and the row stays green -- while every
regress/gdrom_default_probe.py:844:#  OTHER arming mismatch sticks busy-forever.  The row written to pin the
regress/gdrom_default_probe.py:845:#  repair could not see the repair being nulled, which is the same structural
regress/gdrom_default_probe.py:846:#  blindness `dma alias` had against the one-character `m_align1`.
regress/gdrom_default_probe.py:847:#
regress/gdrom_default_probe.py:848:#  This row arms HALF way: count=1 with enable still 0.  That is a real guest
regress/gdrom_default_probe.py:849:#  state -- a driver interrupted between its two arming stores -- and it makes
regress/gdrom_default_probe.py:850:#  the mutant's condition FALSE.
regress/gdrom_default_probe.py:851:#
regress/gdrom_default_probe.py:852:#  NOTE the poison preset `r2=0x5a`, which the two older idle rows do not use.
regress/gdrom_default_probe.py:853:#  They preset r2=0 and EXPECT 0x0, so a load that never executed would read
regress/gdrom_default_probe.py:854:#  as a pass; their measured kills discharge that, but the shape is fragile.
regress/gdrom_default_probe.py:855:#  0x5a is neither the expected 0x0 nor the sticky 0x1, so this row tells
regress/gdrom_default_probe.py:856:#  green, sticky and never-ran apart BY VALUE.
regress/gdrom_default_probe.py:857:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x0c), "r4=1",
regress/gdrom_default_probe.py:858:                         "r7=0x%x" % (DMA + 0x18), "r8=1",
regress/gdrom_default_probe.py:859:                         "r1=0x%x" % (DMA + 0x18), "r2=0x5a"],
regress/gdrom_default_probe.py:860:                        [MOV_L_R4_AT_R3, MOV_L_R8_AT_R7, MOV_L_AT_R1_R2])
regress/gdrom_default_probe.py:861:                   + ["print r2"])
regress/gdrom_default_probe.py:862:row("arm halfarm", printed(t, "r2") if alive else "died", "0x0",
regress/gdrom_default_probe.py:863:    "+0x18 idle after a HALF-armed decline (count=1, enable=0)")
regress/gdrom_default_probe.py:864:
regress/gdrom_default_probe.py:865:#  *** ONE SESSION THAT DRIVES BOTH DECLINE ARMS. ***  A seat predicted, before
regress/gdrom_default_probe.py:866:#  the table ran, that a mutant collapsing the two arms onto a SHARED warn bit
regress/gdrom_default_probe.py:867:#  would escape every row -- because no session anywhere reaches both arms, so
regress/gdrom_default_probe.py:868:#  the first arm's latch silencing the second is unobservable.  This closes it:
regress/gdrom_default_probe.py:869:#  a bare trigger takes the ARMING arm, then arming properly and triggering
regress/gdrom_default_probe.py:870:#  again takes the NO-STAGED-DATA arm, and BOTH must speak.
regress/gdrom_default_probe.py:871:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
regress/gdrom_default_probe.py:872:                         "r3=0x%x" % (DMA + 0x0c), "r4=1",
regress/gdrom_default_probe.py:873:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:874:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
regress/gdrom_default_probe.py:875:                        [MOV_L_R8_AT_R7, MOV_L_R4_AT_R3, MOV_L_R6_AT_R5,
regress/gdrom_default_probe.py:876:                         MOV_L_R2_AT_R1]))
regress/gdrom_default_probe.py:877:row("both decl",
regress/gdrom_default_probe.py:878:    ("%d" % (len(DMA_ARM.findall(t)) + len(DMA_NOD.findall(t)))) if alive else "died",
regress/gdrom_default_probe.py:879:    "2", "BOTH decline arms in one session must EACH speak (separate latches)")
regress/gdrom_default_probe.py:880:
regress/gdrom_default_probe.py:881:#  the latch: a guest that retries must not flood
regress/gdrom_default_probe.py:882:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x18), "r8=1",
regress/gdrom_default_probe.py:883:                         "r5=0x%x" % (DMA + 0x18), "r6=1"],
regress/gdrom_default_probe.py:884:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5]) + ["print r8"])
regress/gdrom_default_probe.py:885:row("arm once", ("%d" % len(DMA_ARM.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:886:    "TWO triggers -> ONE line")
regress/gdrom_default_probe.py:887:
regress/gdrom_default_probe.py:888:#  --- the NO-STAGED-DATA arm (on HEAD :829).  NOTE the row name:
regress/gdrom_default_probe.py:889:#  `nodata survive` was 14 characters, exactly
regress/gdrom_default_probe.py:890:#  the %-14s column, leaving ZERO trailing spaces -- so the gate's `^$v  `
regress/gdrom_default_probe.py:891:#  two-space match becomes UNSATISFIABLE and the row silently stops being
regress/gdrom_default_probe.py:892:#  tested.  Caught by a name-length check before anything ran.  `nodata live`
regress/gdrom_default_probe.py:893:#  is 11.
regress/gdrom_default_probe.py:894:#  --- the NO-STAGED-DATA arm (on HEAD :829), armed correctly but
regress/gdrom_default_probe.py:895:#  nothing staged.  A COMPLIANT guest reaches
regress/gdrom_default_probe.py:896:#  this: Linux programs the four DMA registers BEFORE sending its packet, so
regress/gdrom_default_probe.py:897:#  a short image or a refused sector count leaves d->data NULL and the guest,
regress/gdrom_default_probe.py:898:#  told nothing it checks, triggers anyway.
regress/gdrom_default_probe.py:899:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
regress/gdrom_default_probe.py:900:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:901:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
regress/gdrom_default_probe.py:902:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1]))
regress/gdrom_default_probe.py:903:row("nodata live", "survived" if alive else "died", "survived",
regress/gdrom_default_probe.py:904:    "arming with no staged data no longer ends the host")
regress/gdrom_default_probe.py:905:row("nodata says", ("%d" % len(DMA_NOD.findall(t))) if alive else "died", "1",
regress/gdrom_default_probe.py:906:    "and it names itself exactly once")
regress/gdrom_default_probe.py:907:
regress/gdrom_default_probe.py:908:#  *** THE DECLINED PATH MUST NOT ANNOUNCE A TRANSFER IT DOES NOT RUN. ***
regress/gdrom_default_probe.py:909:#  Two seats found this independently from opposite directions: the
regress/gdrom_default_probe.py:910:#  `Transfering %i bytes` fatal sits ABOVE the `d->data == NULL` test, so the
regress/gdrom_default_probe.py:911:#  declined session printed "Transfering 0 bytes ..." and then "declined".  The
regress/gdrom_default_probe.py:912:#  round's own comment claimed that line "prints data_len, the count actually
regress/gdrom_default_probe.py:913:#  transferred" -- on this path nothing is transferred at all, so the claim was
regress/gdrom_default_probe.py:914:#  false about the very path the round adds.  This row costs nothing: it reads
regress/gdrom_default_probe.py:915:#  the transcript already in hand.
regress/gdrom_default_probe.py:916:row("nodata notx", ("%d" % t.count("Transfering")) if alive else "died", "0",
regress/gdrom_default_probe.py:917:    "a declined transfer must not ANNOUNCE itself as running")
regress/gdrom_default_probe.py:918:
regress/gdrom_default_probe.py:919:#  *** THE STRUCTURAL TWIN OF `arm idle`, AND TWO SEATS FOUND IT MISSING
regress/gdrom_default_probe.py:920:#  INDEPENDENTLY. ***  Without it the `idata = 0` at the
regress/gdrom_default_probe.py:921:#  NO-STAGED-DATA arm is UNPINNED, so the
regress/gdrom_default_probe.py:922:#  smallest possible regression -- deleting one line -- passes green.  The
regress/gdrom_default_probe.py:923:#  sibling site had its row from the start; this one did not, which is the
regress/gdrom_default_probe.py:924:#  asymmetry a reader of the fix would never notice.
regress/gdrom_default_probe.py:925:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
regress/gdrom_default_probe.py:926:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:927:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
regress/gdrom_default_probe.py:928:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1])
regress/gdrom_default_probe.py:929:                   + ["r1=0x%x" % (DMA + 0x18), "r2=0"]
regress/gdrom_default_probe.py:930:                   + run([MOV_L_AT_R1_R2], CODE + 0x200) + ["print r2"])
regress/gdrom_default_probe.py:931:row("nodata idle", printed(t, "r2") if alive else "died", "0x0",
regress/gdrom_default_probe.py:932:    "+0x18 reads IDLE after the no-data decline too")
regress/gdrom_default_probe.py:933:
regress/gdrom_default_probe.py:934:#  *** THE ROW THAT CLOSES THE ACTIVELY-HARMFUL MUTANT.  A seat measured that
regress/gdrom_default_probe.py:935:#  firing SYSASIC_TRIGGER_EVENT on a declined path passes every other row here,
regress/gdrom_default_probe.py:936:#  because nothing reads the pending register. ***
regress/gdrom_default_probe.py:937:#
regress/gdrom_default_probe.py:938:#  Why that mutant is worse than the defect this round fixes: the guest's
regress/gdrom_default_probe.py:939:#  gdrom_dma_interrupt() clears gd.transfer UNCONDITIONALLY and inspects no
regress/gdrom_default_probe.py:940:#  error bit, so a completion signalled on an EMPTY transfer ends the wait with
regress/gdrom_default_probe.py:941:#  BLK_STS_OK -- the block layer is told the read succeeded while zero bytes
regress/gdrom_default_probe.py:942:#  moved, and the guest consumes the destination page AS DISK DATA.  A host
regress/gdrom_default_probe.py:943:#  death is loud; that is silent.
regress/gdrom_default_probe.py:944:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
regress/gdrom_default_probe.py:945:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:946:                         "r1=0x%x" % (DMA + 0x18), "r2=1"],
regress/gdrom_default_probe.py:947:                        [MOV_L_R8_AT_R7, MOV_L_R6_AT_R5, MOV_L_R2_AT_R1])
regress/gdrom_default_probe.py:948:                   #  poison 0x4000, NOT 0 -- these two quiet rows expect "clear",
regress/gdrom_default_probe.py:949:                   #  so with a 0 preset a load that never executed reads as a PASS
regress/gdrom_default_probe.py:950:                   #  BY VALUE.  Their M8/M9 kills discharge vacuity today, but the
regress/gdrom_default_probe.py:951:                   #  shape was fragile and it skipped this file's own 0x5a/0xa5
regress/gdrom_default_probe.py:952:                   #  poison discipline.  Presetting the FAILURE-reading value makes
regress/gdrom_default_probe.py:953:                   #  never-ran distinguishable at zero cost.
regress/gdrom_default_probe.py:954:                   + ["r1=0x%x" % SYSASIC_PEND, "r2=0x4000"]
regress/gdrom_default_probe.py:955:                   + run([MOV_L_AT_R1_R2], CODE + 0x200) + ["print r2"])
regress/gdrom_default_probe.py:956:_p = printed(t, "r2") if alive else "died"
regress/gdrom_default_probe.py:957:row("nodata quiet",
regress/gdrom_default_probe.py:958:    ("clear" if (_p != "died" and not (int(_p, 16) & SYSASIC_DMA_BIT))
regress/gdrom_default_probe.py:959:     else _p), "clear",
regress/gdrom_default_probe.py:960:    "a DECLINED trigger must NOT signal completion")
regress/gdrom_default_probe.py:961:
regress/gdrom_default_probe.py:962:
regress/gdrom_default_probe.py:963:#  *** THE ACCEPT BOUNDARY WAS ONLY EVER PROBED FROM THE NARROWING SIDE, and
regress/gdrom_default_probe.py:964:#  THREE SEATS FOUND THAT INDEPENDENTLY on the ask-again. ***
regress/gdrom_default_probe.py:965:#
regress/gdrom_default_probe.py:966:#  The arming test is `count == 1 && enable == 1`.  M5 moved the boundary IN
regress/gdrom_default_probe.py:967:#  (`== 2`) and the accept rows caught it.  Nothing moved it OUT.  Every row in
regress/gdrom_default_probe.py:968:#  this file drives (count, enable) at (0,0), (1,0) or (1,1) -- and at all three
regress/gdrom_default_probe.py:969:#  points `== 1` and `!= 0` agree, so widening to `count && enable`, `>= 1` or
regress/gdrom_default_probe.py:970:#  bare truthiness is INDISTINGUISHABLE to the whole table.
regress/gdrom_default_probe.py:971:#
regress/gdrom_default_probe.py:972:#  `arm halfarm` is the row built to probe this predicate off its canonical
regress/gdrom_default_probe.py:973:#  points, and it cannot see this: it half-arms by ZEROING a register, never by
regress/gdrom_default_probe.py:974:#  EXCEEDING one, so at (1,0) both forms are false.  Same structural blindness
regress/gdrom_default_probe.py:975:#  as `dma alias` against `m_align1`.
regress/gdrom_default_probe.py:976:#
regress/gdrom_default_probe.py:977:#  TWO rows, not one, because each comparison can be widened ALONE: a (2,1) row
regress/gdrom_default_probe.py:978:#  is green under an enable-only widening.
regress/gdrom_default_probe.py:979:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x0c), "r4=2",
regress/gdrom_default_probe.py:980:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:981:                         "r7=0x%x" % (DMA + 0x18), "r8=1"],
regress/gdrom_default_probe.py:982:                        [MOV_L_R4_AT_R3, MOV_L_R6_AT_R5, MOV_L_R8_AT_R7]))
regress/gdrom_default_probe.py:983:row("arm count2",
regress/gdrom_default_probe.py:984:    ("%d/%d" % (len(DMA_ARM.findall(t)), len(DMA_NOD.findall(t)))) if alive else "died",
regress/gdrom_default_probe.py:985:    "1/0", "count=2 enable=1 must still be REFUSED, not widened into accept")
regress/gdrom_default_probe.py:986:
regress/gdrom_default_probe.py:987:t, alive, how = session(pair(["r3=0x%x" % (DMA + 0x0c), "r4=1",
regress/gdrom_default_probe.py:988:                         "r5=0x%x" % (DMA + 0x14), "r6=2",
regress/gdrom_default_probe.py:989:                         "r7=0x%x" % (DMA + 0x18), "r8=1"],
regress/gdrom_default_probe.py:990:                        [MOV_L_R4_AT_R3, MOV_L_R6_AT_R5, MOV_L_R8_AT_R7]))
regress/gdrom_default_probe.py:991:row("arm enable2",
regress/gdrom_default_probe.py:992:    ("%d/%d" % (len(DMA_ARM.findall(t)), len(DMA_NOD.findall(t)))) if alive else "died",
regress/gdrom_default_probe.py:993:    "1/0", "enable=2 count=1 must still be REFUSED -- each half widens alone")
regress/gdrom_default_probe.py:994:
regress/gdrom_default_probe.py:995:#  *** THE NO-DATA ARM'S LATCH-SCOPED TWIN, AND `arm twice` DOES NOT COVER IT. ***
regress/gdrom_default_probe.py:996:#
regress/gdrom_default_probe.py:997:#  A seat found this on the capped ask-again and named the gap exactly: "that is
regress/gdrom_default_probe.py:998:#  the exact shape `arm twice` was written to close.  The row is arming-only.
regress/gdrom_default_probe.py:999:#  There is no `nodata twice`."  It then sat UNREAD for hours, because its
regress/gdrom_default_probe.py:1000:#  verdict line was recorded and the answer behind it was not opened.
regress/gdrom_default_probe.py:1001:#
regress/gdrom_default_probe.py:1002:#  The mutant, which reads as tidying rather than as a change:
regress/gdrom_default_probe.py:1003:#
regress/gdrom_default_probe.py:1004:#      if (!(d->warned & GDROM_W_DMANODATA)) {
regress/gdrom_default_probe.py:1005:#              d->warned |= GDROM_W_DMANODATA;
regress/gdrom_default_probe.py:1006:#              fatal("[ ... no staged data -- declined ... ] (once) ]");
regress/gdrom_default_probe.py:1007:#              idata = 0;        /* moved INSIDE */
regress/gdrom_default_probe.py:1008:#      }
regress/gdrom_default_probe.py:1009:#      break;
regress/gdrom_default_probe.py:1010:#
regress/gdrom_default_probe.py:1011:#  The FIRST no-data trigger still prints and still clears, so every existing
regress/gdrom_default_probe.py:1012:#  row stays green -- they all trigger that arm exactly once in a freshly forked
regress/gdrom_default_probe.py:1013:#  emulator.  Every LATER trigger leaves the guest's value in dma_reg[6] and
regress/gdrom_default_probe.py:1014:#  +0x18 reads BUSY FOREVER.  Under the corrected clause (d) -- which enumerates
regress/gdrom_default_probe.py:1015:#  the predicates a fix DEPENDS ON, not only those it adds -- that is
regress/gdrom_default_probe.py:1016:#  guard-kept-repair-nulled: an L2 floor breach, fixed in-round however late.
regress/gdrom_default_probe.py:1017:#
regress/gdrom_default_probe.py:1018:#  Poison 0xa5 again, so never-ran (0xa5) is distinguishable from sticky (0x1).
regress/gdrom_default_probe.py:1019:t, alive, how = session(pair(["r7=0x%x" % (DMA + 0x0c), "r8=1",
regress/gdrom_default_probe.py:1020:                         "r5=0x%x" % (DMA + 0x14), "r6=1",
regress/gdrom_default_probe.py:1021:                         "r1=0x%x" % (DMA + 0x18), "r2=1",
regress/gdrom_default_probe.py:1022:                         "r3=0x%x" % (DMA + 0x18), "r4=1"],
