391:		} else {
392:			debug("[ i80321: write to %s: 0x%llx ]\n",
393:			    n, (long long)idata);
394:		}
395:	}
396:
397:ret:
398:	if (writeflag == MEM_READ)
399:		memory_writemax64(cpu, data, len, odata);
400:
401:	return 1;
