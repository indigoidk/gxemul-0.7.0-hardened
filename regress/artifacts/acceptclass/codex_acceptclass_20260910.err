225:ADD_4_R1 = 0x7104             # add #4,r1
226:MOV_B_R6_AT_R5 = 0x2560       # mov.b r6,@r5
227:MOV_W_R6_AT_R5 = 0x2561       # mov.w r6,@r5
228:MOV_L_AT_R1_R3 = 0x6312       # mov.l @r1,r3.  0110nnnnmmmm0010 with n=3 m=1;
229:#  0x6313 -- which this line first said -- is `mov.l @Rm+,Rn`, a DIFFERENT
230:#  instruction that also post-increments r1.  Caught by computing the encoding
231:#  instead of trusting the typing, which is the hand-assembled-encoding trap the
232:#  carrier records: a wrong field yields a plausible value and no error.  The
233:#  sibling MOV_L_AT_R1_R2 = 0x6212 (n=2 m=1) is the cross-check.
234:MOV_L_R2_AT_R1 = 0x2122       # mov.l r2,@r1  (n=1 m=2)
235:MOV_L_R6_AT_R5 = 0x2562       # mov.l r6,@r5  (0010nnnnmmmm0010, n=5 m=6)
236:MOV_L_R4_AT_R3 = 0x2342       # mov.l r4,@r3  (0010nnnnmmmm0010, n=3 m=4)
237:MOV_B_AT_R1_R4 = 0x6410       # mov.b @r1,r4  (0110nnnnmmmm0000, n=4 m=1)
238:BRA_SELF = 0xaffe
239:NOP = 0x0009
