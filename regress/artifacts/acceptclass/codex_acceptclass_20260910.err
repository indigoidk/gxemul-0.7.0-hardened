358:def run(steps, at=CODE):
359:    """Plant a run of instructions, then a self-branch, and step them all."""
360:    put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(steps)]
361:    put += ["put h 0x%x, 0x%04x" % (at + 2 * len(steps), BRA_SELF),
362:            "put h 0x%x, 0x%04x" % (at + 2 * len(steps) + 2, NOP)]
363:    return put + ["pc=0x%x" % at, "step %d" % len(steps)]
