351: ## 5. THE DIFF, #551e -> #551f
352: 
353: ```diff
354: --- regress/diff_wdc_identify.c.551e
355: +++ regress/diff_wdc_identify.c.551f
356: @@ -518,6 +518,8 @@
357:  		    (unsigned long long)got57, (unsigned long long)got60);
358:  		failures ++;
359:  		cmp_fails ++;
360: +		if (why[0] != '@')	/*  #551f: contract (B) -- a covered failure reports itself  */
