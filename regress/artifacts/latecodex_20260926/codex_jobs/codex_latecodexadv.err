4883: static void row_ring_occupancy_sound(void)
4884: {
4885: 	struct wdc_data d;
4886: 	unsigned char buf[8];
4887: 	int i;
4888: 
4889: 	/*  R6 LIVENESS -- one short of full must ALL land.  Without this every
4890: 	    row below is satisfied by a ring that refuses everything.  */
4891: 	altctl_fresh(&d);
4892: 	for (i = 0; i < WDC_INBUF_SIZE - 1; i++) wdc_addtoinbuf(&d, 0x11);
4893: 	chk("R6 liveness: SIZE-1 all land", gx_occ(&d), WDC_INBUF_SIZE - 1);
4894: 	chk("R6 liveness: DRQ asserted",
4895: 	    (status_byte(&d, fake_cpu()) & WDCS_DRQ) ? 1 : 0, 1);
4896: 	free(d.inbuf);
4897: 
4898: 	/*  R1 -- THE WRAP ROW IN THE EXISTING (head-tail) IDIOM.  */
4899: 	altctl_fresh(&d);
4900: 	for (i = 0; i < WDC_INBUF_SIZE; i++) wdc_addtoinbuf(&d, 0x11);
4901: 	chk("R1 full ring: pointer occupancy", gx_occ(&d), WDC_INBUF_SIZE - 1);
4902: 	chk("R3 full ring: DRQ still set",
4903: 	    (status_byte(&d, fake_cpu()) & WDCS_DRQ) ? 1 : 0, 1);
4904: 	free(d.inbuf);
4905: 
4906: 	/*  R2 -- THE ANCHORED ROW.  A marker byte the ring did not compute.  */
4907: 	altctl_fresh(&d);
4908: 	wdc_addtoinbuf(&d, 0xA5);			/*  the anchor  */
4909: 	for (i = 1; i < WDC_INBUF_SIZE + 64; i++) wdc_addtoinbuf(&d, 0x11);
4910: 	chk("R2 anchor: inbuf[tail] survives", d.inbuf[d.inbuf_tail], 0xA5);
4911: 	chk("R2 anchor: cell 0 untouched", d.inbuf[0], 0xA5);
4912: 	free(d.inbuf);
4913: 
4914: 	/*  R4 -- FIFO ORDER through the real consumer.  */
4915: 	altctl_fresh(&d);
4916: 	wdc_addtoinbuf(&d, 0xA5);
4917: 	for (i = 1; i < WDC_INBUF_SIZE + 64; i++) wdc_addtoinbuf(&d, 0x11);
4918: 	chk("R4 fifo: first pop is first push",
4919: 	    (long)(wdc_get_inbuf(&d) & 0xff), 0xA5);
4920: 	free(d.inbuf);
4921: 
4922: 	/*  R5 -- THE DISK-IMAGE SINK (the rider's fifth consumer).  Wrap the ring
4923: 	    while an ATA WRITE is armed, then land on a multiple of 512.
