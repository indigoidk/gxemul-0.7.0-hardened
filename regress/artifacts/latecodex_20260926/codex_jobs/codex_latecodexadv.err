print('LABEL_PREDICATES_INCLUDING_HIGH_BYTE',len(patterns),'DISTINCT_MATCHED_LOG_ROWS',len(mapping))
for hit, pats in mapping.items():
    if len(pats)>1: print('DUPLICATE_TARGET',hit,'PREDICATES',pats)
