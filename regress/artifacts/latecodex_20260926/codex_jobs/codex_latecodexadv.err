1: #!/usr/bin/env python3
2: """#551f: gate 2 emulated per (shape, device), after the Opus seat's analyze7.py: the wdc checks extracted verbatim from
3: gate_offline.sh, H (token in SOURCE), G (text in LOG), the one PASS token, and the self-mutant lane on the matching _sm
4: device.  A shape ESCAPES on a device when the unedited #551f file reds that device, gate 2 is GREEN with the shape
5: applied, and the pristine device is GREEN too.  Each shape carries its expected class from meas551f.py."""
6: import io
7: import os
8: import re
9: import subprocess
10: 
11: W = "/tmp/wdc551f"
12: NAMED = "geometry words carry their high byte"
13: G_TEXT = "SELFCHECK the comparator can still fail"
14: EMIT = "covered comparator failure"
15: io.open(W + "/gate_eval.sh", "w").write(
16:     'WDCLOG="$1"; _f=0\n'
17:     'check() { [ "$2" = "$3" ] || { echo "RED $1 got=$2 want=$3"; _f=$((_f+1)); }; }\n'
18:     'check_min() { [ "$2" -ge "$3" ] 2>/dev/null || { echo "RED $1 got=$2 min=$3"; _f=$((_f+1)); }; }\n'
19:     'note() { :; }\n'
20:     '. ' + W + '/gatewdc.inc\n')
21: CAUGHT = set("""F_v_eq F_v_nocmp F_printf_sub F_ret_nocmp F_hardcode F_recon_ge_sub F_sub_after F_v_eq_printf_sub
22: F_v_nocmp_sub_after F_reset_mid F_resetcmp_mid F_reset2_mid F_cond_start F_cond_mid F_cond_trailer F_cond_afterprintf
23: F_both_trailer F_both_afterprintf F_movefake F_movefake_row F_countforge F_forge_move F_atexit_defer F_move_repin
24: F_nopin_move_repin F_delring_repin F_delrow_repin F_emitoff F_nopin""".split())
25: DISCLOSED = {"F_want165": "A", "F_postinc": "A", "F_name": "A", "F_phase": "A", "F_wrap": "A", "F_sum": "A",
26:              "F_emitoff_cond_trailer": "B", "F_skipforge": "C", "F_nopin_delring_repin": "C", "F_nopin_delrow_repin": "C",
27:              "F_scweak_nocmpinc_reset": "D"}
28: 
29: 
30: def rd(dev, h, ext):
31:     p = "%s/dev/%s/regress/%s.%s" % (W, dev, h, ext)
32:     return io.open(p, encoding="utf-8", errors="replace").read() if os.path.exists(p) else None
33: 
34: 
35: def summ(dev, h):
36:     if (rd(dev, h, "rc") or "").strip() == "BUILD_FAIL":
37:         return "BUILD_FAIL"
38:     t = rd(dev, h, "log") or ""
39:     m = re.search(r"^(\d+) rows, (\d+) failures", t, re.M)
40:     e = len([l for l in t.split("\n") if EMIT in l])
41:     return "%s/%s %s%s" % (m.group(1) if m else "?", m.group(2) if m else "?",
42:                            "PASS" if "WDC_IDENTIFY_PASS" in t else ("FAIL" if "WDC_IDENTIFY_FAIL" in t else "NOTOKEN"),
43:                            " r%d" % e if e else "")
44: 
45: 
46: def gate(h, dev):
47:     if (rd(dev, h, "rc") or "").strip() == "BUILD_FAIL":
48:         return ["compile"]
49:     lane_dev = "selfmut" if dev == "pristine" else dev + "_sm"
50:     t = rd(dev, h, "log")
51:     out = subprocess.run(["bash", W + "/gate_eval.sh", "%s/dev/%s/regress/%s.log" % (W, dev, h)],
52:                          capture_output=True, text=True).stdout
53:     reds = [l[4:44] for l in out.split("\n") if l.startswith("RED ")]
54:     if "@@SELFCHECK@@" not in io.open("%s/h/%s.c" % (W, h), encoding="utf-8").read():
55:         reds.append("H")
56:     if G_TEXT not in t:
57:         reds.append("G")
58:     tm = rd(lane_dev, h, "log")
59:     named = [l for l in t.split("\n") if l.strip().startswith(("ok", "FAIL")) and NAMED in l and "@@SELFCHECK@@" not in l]
60:     lane = "SETUP"
61:     if tm is not None and re.search(r"\b[A-Z0-9_]+_PASS\b", t) and len(named) == 1 and not named[0].strip().startswith("FAIL"):
62:         killed = [l for l in tm.split("\n") if l.strip().startswith("FAIL") and NAMED in l and "@@SELFCHECK@@" not in l]
63:         lane = "OK" if (re.search(r"\b[A-Z0-9_]+_FAIL\b", tm) and killed) else "FAIL"
64:     if lane != "OK":
65:         reds.append("lane:" + lane)
66:     return reds
67: 
68: 
69: def cell(h, dev):
70:     return ("GREEN" if not gate(h, dev) else "red") + "(" + summ(dev, h) + ")"
71: 
72: 
73: shapes = sorted(f[:-2] for f in os.listdir(W + "/h") if f.endswith(".c") and f[:-2] not in ("F", "E", "ORIG"))
74: DEFECTS = ("dropold", "drqring", "w57hi")
