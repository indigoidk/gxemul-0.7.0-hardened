106: V["F_want165"] = sub1(F, CHK_IF, "\tif (got != want && want-165) {\n\t\tfailures ++;\n\t\tcmp_fails ++;\n")
107: V["F_postinc"] = sub1(F, CHK_IF, "\tif (got != want && (rows & 127) < 2) {\n\t\tfailures ++;\n\t\tcmp_fails ++;\n")
108: V["F_name"] = sub1(F, CHK_IF, "\tif (got != want && *name == '@') {\n\t\tfailures ++;\n\t\tcmp_fails ++;\n")
109: V["F_phase"] = sub1(F, CHK_IF, "\tif (got != want && name[0] == '@') {\n\t\tfailures ++;\n\t\tcmp_fails ++;\n")
110: V["F_wrap"] = sub1(F, "\trow_cmp(why, sectors, got57, got60);\n", "\trow_cmp(why, sectors, sectors, sectors);\n")
111: V["F_sum"] = sub1(F, ROWCMP_IF, "\tif (got57 + got60 != 2 * sectors) {\n")
112: #  (B) residual
113: off = sub1(sub1(F, EMIT_CHK, "\t\tif (0)\n"), EMIT_ROW, "\t\tif (0)\n")
114: V["F_emitoff"] = off
115: V["F_emitoff_cond_trailer"] = sub1(off, RECON, COND + RECON)
116: #  (C) one insertion: the ring rows skipped, their labels printed, the counts forged
117: labels = ", ".join("\"%s\"" % n for n in RING_NAMES)
118: V["F_skipforge"] = sub1(F, RING_HEAD, RING_HEAD +
119:     "\t{ static const char *const L[] = { " + labels + " }; int k;\n"
120:     "\t  for (k = 0; k < 24; k++) printf(\"  ok   %-40s 1" + NL + "\", L[k]);\n"
121:     "\t  rows += 24; chk_calls += 24; return; }\n")
122: V["F_delring_repin"] = sub1(sub1(F, AFTER_COVERED, ""), ID_PIN, "\tif (rows != 104) {\n")
123: V["F_nopin_delring_repin"] = sub1(sub1(NOPIN, AFTER_COVERED, ""), ID_PIN, "\tif (rows != 104) {\n")
124: #  the pin's delta on ONE covered row gate 2 does not pin by name (deleting the whole ring also deletes 12 pinned labels)
125: DRQ_ROW = "\tchk(\"R6 liveness: DRQ asserted\",\n\t    (status_byte(&d, fake_cpu()) & WDCS_DRQ) ? 1 : 0, 1);\n"
126: V["F_delrow_repin"] = sub1(sub1(F, DRQ_ROW, ""), ID_PIN, "\tif (rows != 127) {\n")
127: V["F_nopin_delrow_repin"] = sub1(sub1(NOPIN, DRQ_ROW, ""), ID_PIN, "\tif (rows != 127) {\n")
128: #  (D) the block itself: the chk probes' cmp_fails check weakened, chk()'s increment deleted, a reset after the rows
129: D1 = "\t\tif (failures != sc_f + (cg[i] != cw[i]) || cmp_fails != sc_cf + (cg[i] != cw[i]))\n"
130: d = sub1(F, D1, "\t\tif (failures != sc_f + (cg[i] != cw[i]) || cmp_fails > sc_cf + (cg[i] != cw[i]))\n")
131: d = sub1(d, CHK_IF, "\tif (got != want) {\n\t\tfailures ++;\n")
132: V["F_scweak_nocmpinc_reset"] = sub1(d, AFTER_COVERED, AFTER_COVERED + "\tfailures = 0;\n")
133: for k, v in V.items():
134:     io.open("%s/%s.c" % (H, k), "w", encoding="utf-8", newline="").write(v)
135: io.open("%s/F_nopin.c" % H, "w", encoding="utf-8", newline="").write(NOPIN)
136: print("variants (%d):" % (len(V) + 1), " ".join(sorted(list(V) + ["F_nopin"])))

