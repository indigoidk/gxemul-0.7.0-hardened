542: /*
543:  *  The anchor. Word 53's bytes are 0x00,0x02 -- asymmetric, so a +0/+1 swap in
544:  *  the packing is visible here. Word 47 (0x8080) is a palindrome and would not
545:  *  be, which is exactly why it is not used.
546:  */
547: static void row_anchor(void)
548: {
549: 	struct wdc_data d;
550: 
551: 	build(&d, 1024, 1, 1, 1);
552: 	rows ++;
553: 	if (d.identify_struct[2 * 53 + 0] != 0x00 ||
554: 	    d.identify_struct[2 * 53 + 1] != 0x02) {
555: 		printf("  FAIL word-53 anchor: %02x %02x, want 00 02"
556: 		    " (a +0/+1 swap in the packing)\n",
557: 		    d.identify_struct[2 * 53 + 0], d.identify_struct[2 * 53 + 1]);
558: 		failures ++;
4860: 	}
4861: }
