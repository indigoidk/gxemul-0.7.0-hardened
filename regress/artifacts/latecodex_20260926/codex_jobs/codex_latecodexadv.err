4883: static void row_ring_occupancy_sound(void)
4884: {
4885: 	struct wdc_data d;
4886: 	unsigned char buf[8];
4887: 	int i;
4888: 
4889: 	/*  R6 LIVENESS -- one short of full must ALL land.  Without this every
4890: 	    row below is satisfied by a ring that refuses everything.  */
5660:  *  goes inert partway through is caught at one end or the other; the LAST run also requires the
5661:  *  comparator call counts (chk() 24, row_cmp() 8).  Only the success arm prints gate 2's G text; see (D)
5662:  *  for what the failure arms do.
5663:  *
5664:  *  WHAT IT COVERS: the rows that go through chk() and row_cmp() -- the last run prints how many calls
5665:  *  each comparator took.  Of chk()'s calls, the ones in row_ring_occupancy_sound() that pass a
5666:  *  `cond ? 1 : 0' (or `? 0 : 1') hand it a VERDICT computed at the call, not a comparison, and every
5667:  *  other row in this file compares inline: neither is covered by this block.  "Covered" means the
5668:  *  COMPARATOR is live, not that a row is.  The 8 verdict-handed calls still REPORT through (B): the file
5669:  *  covers 24 comparisons and reports all 32 comparator failures.
5670:  *
5671:  *  WHAT THIS FILE'S CHECKS CAN AND CANNOT SEE.  Every check here reads state this file writes (the
5672:  *  tallies, the call counts, `rows', sc_g) or output this file prints, so an edit that reproduces a healthy
5673:  *  run's observables -- by skipping rows and printing what they would have printed, by writing what a check
5674:  *  reads, or by rewriting the log after the rows have run -- is invisible to all of them.  That boundary is a
5675:  *  fact about in-file checks, not a gap in this block.  Two things cross it: a gate-side run on a device that
5676:  *  fails a covered row -- one capacity row through row_cmp() AND one ring row through chk(), each on its own
5677:  *  device mutant, because a skip of one group leaves the other group's lane green, and a lane closes only
5678:  *  the rows its mutants fail (filed: `wdcidlane') -- and the log reaching the gate through a pipe rather
5679:  *  than a seekable file, which no exit handler can rewrite (filed with it).  Inside the boundary:
5680:  *
5681:  *  (A) THE COMPARATORS ARE PINNED -- the probes require the exact change in `failures' and cmp_fails on
5682:  *  their own calls, so an inert comparator, or one narrowed on values the probes present, is caught at one
5683:  *  end of the run or the other.  Not caught, measured: any difference between what a comparator does on a
5684:  *  probe call and on a real call -- a test keyed on a value, a name, a position or this block's phase that
5685:  *  the probes do not share; a predicate rewritten to agree with the original on every probe and differ
5686:  *  elsewhere (the sum of the two gots against twice the want, say: it survives the probes, measured, and was
5687:  *  red on all three defect devices, so its blindness to a device whose differences compensate is a reading,
5688:  *  not a measurement -- GPT-6 Astra, confirming #551); and the code that FEEDS a comparator
5689:  *  (row() handing row_cmp() its own want).  "Comparator" means its compiled behaviour: a file-scope macro
5690:  *  that rewrites a printf or a name inside it is an edit of the comparator, wherever the line sits.
5691:  *
5692:  *  (B) A COVERED FAILURE REPORTS ITSELF -- on a non-probe mismatch each comparator prints a line gate 2's
5693:  *  failure-count check reads (`N failures so far'), at the moment it fails; that check compares the
5694:  *  newline-joined list of EVERY number it captures in the log with the one string "0" (lib.sh's check();
5695:  *  it never accepts a zero line on its own -- this said it compared every such line against "0": GPT-6
5696:  *  Astra, confirming #551), so once the line is in the log no edit of the tallies, the trailer or the rows'
5697:  *  order takes it back, and no line matching the check can be added without reddening it, not even one
5698:  *  reading `0 failures'.  Hence no
5699:  *  edit that leaves the covered rows running and the comparators' compiled behaviour intact hides a covered
5700:  *  failure: not the trailer's count, token or exit rewritten singly or together, not a reset of either
5701:  *  tally or both at any placement, not rows moved or deferred past the verdict with their counts forged
5702:  *  (measured on #551f's pass: regress/artifacts/wdcidselfcheck_20260925/measured/run551f.out, scored by an
5703:  *  EMULATION of gate 2's checks and lane; opus551_measured_f/analyze9.out, its 41 rows re-run with gate 2's
5704:  *  own lib.sh; gate 2's own selfmutant.py on five of those cells -- this said "gate 2's own lib.sh and
5705:  *  selfmutant.py" of all of it: GPT-6 Astra, confirming #551).  Not caught -- the (A) residual
5706:  *  reaching the report: the report kept from the check on real calls (its guard switched off, its text
5707:  *  moved off the pattern, or its printf swallowed by a file-scope macro) together with the tallies hidden
5708:  *  (a reset, or the rows deferred past the trailer) -- and both halves can be ONE edit (a guard that also
5709:  *  undoes the increments; the macro).  No other line in this file may print `<digits> failures': one that
5710:  *  does reds every healthy run, loudly.
5711:  *
5712:  *  (C) OBSERVABLES FORGED -- a row that does not run cannot report, and a log rewritten after the rows have
5713:  *  run reports nothing.  Skipping the ring rows while printing their gate-pinned labels and adding 24 to
5714:  *  `rows' and chk_calls is one insertion and green (measured); an exit handler that seeks a file-redirected
5715:  *  stdout to 0 and writes a healthy log over the real one is one insertion and passes the file-redirected
5716:  *  MAIN checks (M19, #551f's pass) -- the existing piped self-mutant lane rejects it on all three tested
5717:  *  defects (dropold, drqring, w57hi), so it does not keep the complete gate green (GPT-6 Astra, confirming
5718:  *  #551).  The identity row's 128 and the LAST run's call counts raise the cost of a skip;
5719:  *  nothing in this file raises the cost of a rewrite.  That is the boundary's own class; its close is
5720:  *  `wdcidlane' and the pipe.
5721:  *
5722:  *  (D) This block itself.  Nothing this block prints carries the self-mutant row's text, "high byte" or a
5723:  *  pinned label.  Gate 2's G text is printed ONCE, by the last run, only when both runs passed; the run's
5724:  *  PASS needs that line (sc_g) and both tallies at zero; a probe failure forces one failure, and a missing
5725:  *  first run is counted by the trailer's `!sc_g' line.  Reviewed in the differential, not chased.  The rest
5726:  *  of the file is filed as `wdcidcomparators' (#551; owner ruling 2026-09-25).
5727:  */
5728: static int sc_first_bad = -1;	/*  -1 until the FIRST run has happened  */
5729: static int sc_g;	/*  set ONLY where gate 2's G line prints: the run's PASS needs it  */
5730: 
5731: static void selfcheck(const char *where)
5732: {
5733: 	static const long long cg[] = { 1, 0x100000000LL, 0, 0, 7 };
5734: 	static const long long cw[] = { 2, 0, 1, 0x100000000LL, 7 };
5735: 	static const uint64_t rw[] = { 2, 2, 1, 3, 0x100000000ULL, 0x100000000ULL, 0, 0 };
5736: 	static const uint64_t r57[] = { 1, 2, 0, 3, 0, 0x100000000ULL, 1, 0 };
5737: 	static const uint64_t r60[] = { 2, 1, 0, 3, 0x100000000ULL, 0, 0, 1 };
5738: 	int sc_f = failures, sc_r = rows, sc_c = chk_calls, sc_rc = rowcmp_calls, sc_cf = cmp_fails, sc_bad = 0;
5739: 	int i, n = 0;
5740: 
5741: 	for (i = 0; i < 5; i++, n++) {
5742: 		chk("@@SELFCHECK@@/chk", cg[i], cw[i]);
5743: 		if (failures != sc_f + (cg[i] != cw[i]) || cmp_fails != sc_cf + (cg[i] != cw[i]))
5744: 			sc_bad++;
5745: 		failures = sc_f; rows = sc_r; cmp_fails = sc_cf;
5746: 	}
5747: 	for (i = 0; i < 8; i++, n++) {
5748: 		row_cmp("@@SELFCHECK@@/row", rw[i], r57[i], r60[i]);
5749: 		if (failures != sc_f + (r57[i] != rw[i] || r60[i] != rw[i])
5750: 		    || cmp_fails != sc_cf + (r57[i] != rw[i] || r60[i] != rw[i]))
5751: 			sc_bad++;
5752: 		failures = sc_f; rows = sc_r; cmp_fails = sc_cf;
5753: 	}
5754: 	chk_calls = sc_c; rowcmp_calls = sc_rc;
5755: 	if (sc_bad) {
5756: 		printf("  FAIL  SELFCHECK(%s): %d of %d probes answered wrongly\n", where, sc_bad, n);
5757: 		failures = sc_f + 1; rows = sc_r; cmp_fails = sc_cf;
5758: 	}
5759: 	if (where[0] == 'f') {
5760: 		sc_first_bad = sc_bad;
5761: 		if (!sc_bad)
5762: 			printf("  ok    SELFCHECK(first): all %d probes answered right\n", n);
5763: 		return;
5764: 	}
5765: 	/*  #551e: a second identity constant -- the LAST run requires the comparator call counts the note line
5766: 	    below prints, chk() 24 and row_cmp() 8.  It catches covered rows skipped or moved without their counts
5767: 	    forged; like the identity row's 128 it is forgeable by an edit that writes the counter (contract (C)).
5768: 	    Change these with the rows.  */
5769: 	if (chk_calls != 24 || rowcmp_calls != 8) {
5770: 		printf("  FAIL  SELFCHECK(last): chk() ran %d times and row_cmp() %d before this run; want 24 and 8\n",
5771: 		    chk_calls, rowcmp_calls);
5772: 		if (!sc_bad)
5773: 			failures = sc_f + 1;
5774: 		sc_bad++;
5775: 	}
5776: 	if (!sc_bad && sc_first_bad == 0) {
5777: 		sc_g = 1;
5778: 		printf("  ok    SELFCHECK the comparator can still fail (first and last)\n");
5779: 	} else if (!sc_bad)
5780: 		printf("  FAIL  SELFCHECK(last): the first run did not run, or did not pass\n");
5781: 	printf("  note  SELFCHECK comparator calls this run: chk() %d, row_cmp() %d\n",
5782: 	    chk_calls, rowcmp_calls);
5783: }
5784: 
5785: int main(void)
5786: {
5787: 	/*  Unbuffered, so a crash mid-run still shows how far it got -- with stdout
5788: 	    block-buffered a segfault loses every row and looks like a build failure.
5789: 	    Same reason diff_diskimage_io.c does this; this file lacked it, and that
5790: 	    cost a diagnostic cycle chasing an invisible crash.  */
5791: 	setvbuf(stdout, NULL, _IONBF, 0);
5792: 
5793: 	printf("ATA IDENTIFY capacity packing (#405), against the REAL dev_wdc.c\n");
5794: 	selfcheck("first");
5795: 
5796: 	/*  Controls: below the divergence point these pass either way, and they
5797: 	    are here to prove the rig reports correct values, not to detect.  */
5798: 	row("control: 1 sector (passes unfixed too)",        1);
5799: 	row("control: 255 sectors (the correct line)",       255);
5800: 
5801: 	/*  Each of these puts a specific byte at or past the point where % and &
5802: 	    part company. Without them the whole table is vacuous.  */
5803: 	row("threshold: >>8 byte reaches 255",               65280);
5804: 	row("carry: >>8 wraps into >>16",                    65536);
5805: 	row("all four bytes distinct",                       0x12345678ULL);
5806: 	row(">>8 accidentally right, >>16 wrong",            0xFF0000ULL);
5807: 	row("threshold: >>24 byte reaches 255",              0xFF010203ULL);
5808: 	row("every byte 255",                                0xFFFFFFFFULL);
5809: 
5810: 	row_anchor();
5811: 	row_slave();
5812: 	row_base_drive();
5813: 	row_identity();
5814: 	row_arm_overrun();
5815: 	row_null_atapi_st();
5816: 	row_cdb_midxfer();
5817: 	row_cdb_already12();
5818: 	row_midxfer_phases();
5819: 	row_pkt_cdb_accept();
5820: 	row_cdb_overshoot();
5821: 	row_dataout_drain();
5822: 	row_pkt_drain();
5823: 	row_badlen_then_legal();
5824: 	row_partial_sector();
5825: 	row_stale_phase_write();
5826: 	row_altctl_cdb_accept();
5827: 	row_drain_announce();
5828: 	row_devctl_preserves_write();
5829: 	row_command_fills_ring();
5830: 	row_latch_survives_command();
5831: 	row_wip_not_cleared();
5832: 	row_ring_not_flushed();
5833: 	row_residue_recovery();
5834: 	row_badlen_no_dispatch();
5835: 	row_writemulti_moment();
5836: 	row_leftover_second_badlen();
5837: 	row_little_endian_arm();
5838: 	row_same_opcode_resets();
5839: 	row_rejected_cmd_resets();
5840: 	row_refill_cmd_resets();
5841: 	row_absent_drive_resets();
5842: 	row_every_opcode_resets();
5843: 	row_srst_is_a_reset();
5844: 	row_routine_ctl_preserves_cmd();
5845: 	row_nien_is_not_a_reset();
5846: 	row_srst_aborts();
5847: 	row_srst_signature();
5848: 	row_srst_aborts_ata_only();
5849: 	row_srst_aborts_pkt_only();
5850: 	row_srst_aborts_empty_ring();
5851: 	row_hob_is_not_a_reset();
5852: 	row_srst_purges_orphan_ring();
5853: 	row_srst_aborts_pkt_empty_ring();
5854: 	row_reset_bit_iff();
5855: 	row_ring_occupancy_sound();
5856: 	row_completion_irq();
5857: 	row_odd_step();
5858: 	row_odd_midwalk();
5859: 	row_odd_width();
5860: 	row_odd_multichunk();
5861: 	row_odd_bytecount();
5862: 	row_odd_zerolen();
5863: 	row_rearm_zero();
5864: 	row_q2_short_last_chunk();
5865: 	row_atapi_flags();
5866: 	row_wide_geometry();
5867: 	row_no_lba_claim();
5868: 	row_selfconsistent();
5869: 	selfcheck("last");
5870: 
5871: 	/*
5872: 	 *  IDENTITY GUARD.  Two files with this name once differed only by the case of a
5873: 	 *  parent directory, and the stale one encoded a REVERSED design decision.  A row
5874: 	 *  count is the cheapest proof that the file which RAN is the file that was
5875: 	 *  reviewed.  Last, so it counts every row above it.
5876: 	 *
5877: 	 *  It is also floor clause (c): against a null medium -- a stale copy, or a
5878: 	 *  comment-only source -- this row is what refuses to report a pass.
5879: 	 */
5880: 	rows ++;
5881: 	if (rows != 128) {
5882: 		printf("  FAIL %-38s rows = %i, want 128\n",
5883: 		    "[IDENTITY] row count", rows);
5884: 		failures ++;
5885: 	} else {
5886: 		printf("  ok   %-38s %i\n", "[IDENTITY] row count", rows);
5887: 	}
5888: 
5889: 	/*  #551: the PRINTED count shows the comparators' failures even after a reset of `failures' placed
5890: 	    before this line (untouched, `failures' always counts at least as many); the verdict and the exit
5891: 	    status read cmp_fails directly.  A self-check that did not pass is a failure the count shows.  */
5892: 	if (cmp_fails > failures)
5893: 		failures = cmp_fails;
5894: 	if (!sc_g && failures == 0)
5895: 		failures = 1;
5896: 	printf("\n%d rows, %d failures\n", rows, failures);
5897: 	if (failures == 0 && cmp_fails == 0 && sc_g)
5898: 		printf("WDC_IDENTIFY_PASS\n");
5899: 	else
5900: 		printf("WDC_IDENTIFY_FAIL\n");
5901: 	return (failures || cmp_fails || !sc_g) ? 1 : 0;
5902: }

