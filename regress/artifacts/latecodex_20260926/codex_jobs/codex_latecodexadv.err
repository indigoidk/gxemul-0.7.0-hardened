86:                                                         cell(h, "w57hi"), cls, ",".join(esc) or "-"))
87: print("  CONTRACT CHECK: %s" % ("every CAUGHT shape is red on every covered-only defect" if not bad else "; ".join(bad)))
88: green = [h for h in shapes if any(not gate(h, "pristine") and not gate(h, d) and gate("F", d) for d in DEFECTS)]
89: print("  shapes GREEN on at least one covered-only defect: %s" % " ".join(green))
90: print("  ...of which the manifest does NOT class inside A-D: %s" % (" ".join(h for h in green if h not in DISCLOSED) or "NONE"))
91: print("  the pin's delta (one unpinned covered row deleted, identity re-pinned 127): with the pin %s; without it %s" % (
92:     cell("F_delrow_repin", "pristine"), cell("F_nopin_delrow_repin", "pristine")))
93: print("\n=== (2) #551f against #551e and against HEAD, WHOLE log ===")
94: for dev in sorted(os.listdir(W + "/dev")):
95:     f, e, o = rd(dev, "F", "log"), rd(dev, "E", "log"), rd(dev, "ORIG", "log")
96:     fl = f.split("\n")
97:     extra = [l for l in fl if l not in e.split("\n")]
98:     em = len([l for l in fl if EMIT in l])
99: 
100:     def strip(t):
101:         return [l for l in t.split("\n") if "SELFCHECK" not in l and EMIT not in l]
102: 
103:     print("    %-11s F vs E: %-44s | F vs HEAD without SELFCHECK and report lines: %-9s | rc F=%s E=%s HEAD=%s" % (
104:         dev, "WHOLE-LOG IDENTICAL" if f == e else "+%d lines, all report lines: %s" % (len(extra), all(EMIT in l for l in extra)),
105:         "IDENTICAL" if strip(f) == strip(o) else "DIFFERS",
106:         rd(dev, "F", "rc").strip(), rd(dev, "E", "rc").strip(), rd(dev, "ORIG", "rc").strip()))
107: print("ANALYZE8_DONE")
