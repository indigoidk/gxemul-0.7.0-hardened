189: import os
190: import pty
191: import re
192: import select
193: import signal
194: import sys
195: import time
196: 
197: BIN = sys.argv[1]
198: 
199: STUBADDR = 0xffffffff80100000
200: CODE = 0xffffffff80100020
201: FBCTRL = 0xffffffffb2f00000
202: 
203: ONCE_RE = re.compile(r"\[ fbctrl: port number 0x[0-9a-f]+ is out of range; the selector is unchanged \(once\) \]")
204: #  The refused value, captured whole: "0x8" can match only 0x8, never 0x80 (the digits run to " is").
205: VAL_RE = re.compile(r"\[ fbctrl: port number (0x[0-9a-f]+) is out of range; the selector is unchanged \(once\) \]")
206: 
207: REG = dict(zr=0, v0=2, v1=3, a0=4, a1=5, a2=6, a3=7, t0=8, t1=9, t2=10, t3=11, t4=12, t5=13, t6=14, t7=15,
208:            s0=16, s1=17, s2=18, s3=19, s4=20, s5=21, s6=22, s7=23, t8=24, t9=25)
209: OPS = dict(sb=0x28, sh=0x29, sw=0x2b, sd=0x3f, lb=0x20, lh=0x21, lw=0x23, ld=0x37)
210: LOADS = ("lb", "lh", "lw", "ld")
211: 
212: 
213: def ins(op, rt, off, base="t0"):
214:     if op == "dsll":                                     # SPECIAL dsll rt,rt,off: rd == rt, the shift in sa
215:         return (REG[rt] << 16) | (REG[rt] << 11) | ((off & 31) << 6) | 0x38
216:     return (OPS[op] << 26) | (REG[base] << 21) | (REG[rt] << 16) | (off & 0xffff)
217: 
218: 
219: def text(op, rt, off, base="t0"):
220:     if op == "dsll":
221:         return "dsll %s,%s,%d" % (rt, rt, off)
222:     return "%s %s,%d(%s)" % (op, rt, off, base)
223: 
224: 
225: ANCHOR = (0x0f << 26) | (REG["t7"] << 16)                   # lui t7,0 -- the breakpoint anchor, never executed
226: #  Pinned independently of the helper: a wrong register field would otherwise pass silently.
227: assert ins("sw", "t1", 0) == 0xad090000
228: assert ins("lw", "t2", 0x10) == 0x8d0a0010
229: assert ins("sd", "t5", 0) == 0xfd0d0000
230: assert ins("sb", "t8", 0) == 0xa1180000
231: assert ins("sh", "t9", 0) == 0xa5190000
232: assert ins("ld", "s3", 0) == 0xdd130000
233: assert ins("sb", "zr", 0) == 0xa1000000
234: assert ins("lb", "a1", 0) == 0x81050000
235: assert ins("lh", "a2", 0) == 0x85060000
236: assert ANCHOR == 0x3c0f0000
237: assert ins("dsll", "t1", 1) == 0x00094878
238: assert ins("dsll", "t4", 1) == 0x000c6078
239: 
240: 
241: def stub_path():
242:     p = "/tmp/gx_fbctrl549p_%d.bin" % os.getpid()
243:     with open(p, "wb") as f:
244:         f.write(b"\x00\x00\x00\x00")
245:     return p
450: #  16 by sb and by sh, each read back into a register whose own value (0x200000000, 0x100000003) is spent by then and
451: #  can never read as 5 -- so an ignored read, or a session that died, reds the row too.
452: EXTRA = [("sb", "t3", "t4", "16 (sb)"), ("sh", "t3", "t5", "16 (sh)")]
453: READ_P = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "v0"]
454: PROG_P = [("sw", "a0", 0, None), ("sw", "a1", 16, None)]
455: REGS_P = [("t0", FBCTRL), ("a0", 5), ("a1", 0x2a), ("a2", 7)]
456: for k, (w, r, v, _n) in enumerate(REFUSE):
457:     REGS_P.append((r, v))
458:     if k:
459:         PROG_P.append(("sw", "a0", 0, None))                   # a fresh PORT=5 before every later refusal
460:     PROG_P.append((w, r, 0, "r%d" % k))
461:     PROG_P.append(("lw", READ_P[k], 0, None))
462: for w, r, rb, _n in EXTRA:
463:     PROG_P += [("sw", "a0", 0, None), (w, r, 0, None), ("lw", rb, 0, None)]
464: PROG_P += [("sw", "a2", 0, None), ("sw", "t1", 0, "r11"), ("lw", "v1", 0, None)]
465: READS_P = READ_P + [e[2] for e in EXTRA] + ["v1"]
466: 
467: #  R: between two refusals, a PORT read, a DATA write, a NOP command, a DATA READ and a GET_RESOLUTION -- every kind of
468: #  traffic a guest makes except SET_RESOLUTION -- in its own session.
469: PROG_R = [("sw", "a0", 0, None), ("sw", "t1", 0, "ra"), ("lw", "s0", 0, None),
470:           ("sw", "a1", 16, None),                                        # DATA write: port 5 = 0x2a
471:           ("sw", "zr", 0, None), ("sw", "zr", 16, None),                 # PORT=0, DATA=0: a NOP command
472:           ("sw", "a0", 0, None), ("lw", "s2", 16, None),                 # PORT=5, DATA READ
473:           ("sw", "zr", 0, None), ("sw", "s3", 16, None),                 # PORT=0, DATA=2: GET_RESOLUTION
474:           ("sw", "a0", 0, None), ("sw", "t1", 0, "rb"), ("lw", "s1", 0, None)]
475: REGS_R = [("t0", FBCTRL), ("a0", 5), ("a1", 0x2a), ("t1", 9), ("s3", 2), ("s0", 0xdead), ("s1", 0xdead),
476:           ("s2", 0xdead)]
477: 
478: PROG_K = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("sw", "t2", 0, None), ("lw", "s0", 16, None),
479:           ("sw", "t4", 16, None), ("sw", "t1", 0, None), ("lw", "s1", 16, None)]
480: REGS_K = [("t0", FBCTRL), ("t1", 5), ("t3", 0x2a), ("t2", 9), ("t4", 0x77), ("s0", 0xdead), ("s1", 0xdead)]
481: 
482: #  F: the free-run executes the refused sw AND a guest lw of PORT into a poisoned t2 (a GPR nothing loads would
483: #  print the zero cpu_new() gave it on every device -- the channel has to be a guest load).
484: PROG_F = [("sw", "t1", 0, None), ("lw", "t2", 0, None)]
485: REGS_F = [("t0", FBCTRL), ("t1", 9), ("t2", 0xdead)]
486: 
487: #  V: X1 across a refusal made while COMMAND still holds GET_RESOLUTION, then every cell across four refusals.
488: #  Port 0 is never written after the first GET_RESOLUTION: a DATA write there EXECUTES the command.
489: REGS_V = [("t0", FBCTRL)] + [("s%d" % p, p) for p in range(1, 8)] + [("t%d" % p, 0x11 * p) for p in range(1, 8)] + \
490:          [("t8", 123), ("a0", 9), ("a1", 16), ("a2", 0x100000003), ("a3", 0xff), ("t9", 8), ("s0", 0xdead),
491:           ("v0", 0xdead), ("v1", 0xdead)]
492: PROG_V = [("sw", "zr", 0, None), ("sw", "s2", 16, None),               # COMMAND = GET_RESOLUTION (X1 = Y1 = 0)
493:           ("sw", "s1", 0, None), ("sw", "t8", 16, None),               # X1 = 123

