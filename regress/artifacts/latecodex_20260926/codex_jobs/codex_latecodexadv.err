4863: /*  Each assertion is a ROW in this file's sense: it bumps `rows`, and a
4864:     mismatch bumps `failures`.  The seat's private counters are deliberately
4865:     NOT carried over -- a row this file does not count is a row the identity
4866:     pin cannot protect.  */
4867: static int chk_calls;	/*  #551: counted, so the LAST self-check can print the coverage  */
4868: 
4869: static void chk(const char *name, long long got, long long want)
4870: {
4871: 	chk_calls ++;
4872: 	rows ++;
4873: 	if (got != want) {
4874: 		failures ++;
4875: 		cmp_fails ++;
4876: 		printf("  FAIL %-40s got %lld want %lld\n", name, got, want);
4877: 		if (name[0] != '@')	/*  #551f: contract (B) -- a covered failure reports itself  */
4878: 			printf("  FAIL  covered comparator failure -- %d failures so far\n", cmp_fails);
4879: 	} else
4880: 		printf("  ok   %-40s %lld\n", name, got);
4881: }
