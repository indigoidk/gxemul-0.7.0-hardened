1: """#494 -- THE ROW THE OTHER TWO DETECTORS DO NOT HAVE.
2: 
3:     python3 wdc_altoffset_4bit_probe.py <outdir> <disk> <tag>=<binary> ...
4: 
5: WHY.  The shipped 18-row detector pokes offset 1 with exactly three values -- 0x06
6: (P2), 0x02 (P3) and 0x04 (P4).  ALL THREE HAVE WDCTL_4BIT (0x08) CLEAR.  So every
7: offset-1 row lies in ONE equivalence class on the bit-3 axis, and a guard narrowed
8: with `&& !(idata & WDCTL_4BIT)` keeps all 18 rows green while re-opening the defect.
9: 
10: That is not a hypothetical bit.  dev_wdc.c's own #481 comment says WDCTL_4BIT is
11: "a head-addressing mode selector that Linux libata holds as its STEADY-STATE
12: ap->ctl", and that comment's level-vs-edge measurement asserts SRST with 0x0e.
13: libata's soft reset writes ap->ctl|ATA_SRST, i.e. 0x0c, or 0x0e with nIEN.  So the
14: values a mask guard re-opens are the ones the commonest modern driver actually
15: writes, and the values the detector tests are the ones it does not.
16: 
17:     PHASE 5   0x0e at OFFSET 1 (0x3f7)  -- the DEFECT row this detector lacks.
18:               base: reset happens.  fix: declined.  A mask-guard mutant: reset
19:               happens again, which is the kill.
20: 
21:     PHASE 6   0x0e at OFFSET 0 (0x3f6)  -- the ACCEPT row for the same value.
22:               The de-escalation clause wants the accept side pinned for each
23:               predicate the old exit(1) used to gate; 0x0e is a LEGAL control
24:               write and every leg must still reset.  Without this row a "fix"
25:               that declines 0x0e everywhere would look correct.
26: 
27: Both phases reuse the shipped encoder and Emu by import, so the instrument is the
28: committed one, not a re-implementation.
29: 
30: CONTRACT -- vacuity-floor clause (e).
31: 
32:   CATCHES: MASK-shaped narrowings of the offset decline.  The other two detectors
33:     use only 0x06, 0x02 and 0x04 at offset 1 -- ALL THREE WITH BIT 3 CLEAR -- so
34:     every offset-1 row they carry sits in one WDCTL_4BIT equivalence class, and a
35:     guard reading `!(idata & WDCTL_4BIT)` escapes both at 36/36 and declined.
36:     Measured, not predicted.  P6 is the ACCEPT half and is discharged by a MEASURED
37:     KILL: it reds under an over-reaching decline, so a fix that refused 0x0e
38:     everywhere cannot pass by looking correct.
39: 
40:   BLIND to: everything the other two cover (partial guards sparing the ring; DRQ
41:     and ring channels at other values; reads of the alt region, which NO probe in
42:     this family pins -- the handler read path has zero rows).  Values outside 0x0e
43:     at offset 1, except as the other detectors already cover them.
44: 
45:   NOT WIRED INTO A GATE: two-leg differential, dated-exempt with its siblings.
46: """
47: import os
48: import sys
49: import time
50: 
51: OUTDIR = sys.argv[1]
52: DISK = sys.argv[2]
53: LEGS = [a.split("=", 1) for a in sys.argv[3:]]
54: 
55: HERE = os.path.dirname(os.path.abspath(__file__))
56: os.makedirs(OUTDIR, exist_ok=True)
57: sys.argv = [sys.argv[0]]
58: sys.path.insert(0, HERE)
59: import wdc_altoffset_probe as W            # noqa: E402
60: 
61: W.DISK_PREFIX = "iR:"                      # plain IDE: the DRQ/ring channel
62: LIBATA_SRST = 0x0e                         # nIEN | SRST | 4BIT
63: 
64: W.prog[:] = []
65: t0, t1, t2 = W.t0, W.t1, W.t2
66: v0, v1, a0 = W.v0, W.v1, W.a0
67: s0, s1, s2, s3, s4, s5 = W.s0, W.s1, W.s2, W.s3, W.s4, W.s5
68: 
69: W.emit(W.lui(t0, W.WDC_HI), "lui t0,0xb800")
70: W.emit(W.ori(t0, t0, W.WDC_LO), "ori t0,t0,0x01f0")
71: W.emit(W.lui(t1, W.ALT_HI), "lui t1,0xb800")
72: W.emit(W.ori(t1, t1, W.ALT_LO), "ori t1,t1,0x03f6")
73: W.emit(W.lui(t2, W.RAM_HI), "lui t2,0x8020")
74: 
75: #  liveness -- RAM, then the wdc's own decode (#481's 0x6655 idiom).
76: W.e_store(0x55, 0, t2)
77: W.e_lbu(v0, 0, t2)
78: W.e_store(0x55, W.R_CYL_LO, t0)
79: W.e_store(0x66, W.R_CYL_HI, t0)
80: W.e_lbu(v1, W.R_CYL_LO, t0)
81: W.e_lbu(a0, W.R_CYL_HI, t0)
82: 
83: #  PHASE 5 -- 0x0e at the READ-ONLY offset 1.
84: W.arm_a_write()
85: W.e_lbu(s0, W.R_STATUS, t0)                # armed -> DRQ set, every leg
86: W.e_store(LIBATA_SRST, 1, t1)              # <<< 0x3f7
87: W.e_lbu(s1, W.R_STATUS, t0)                # base/mask-mutant: 50   fix: 58
88: W.e_lbu(s2, W.R_DATA, t0)                  # base/mask-mutant: ff   fix: 71
89: 
90: #  PHASE 6 -- 0x0e at offset 0, the LEGAL control write.  Accept row.
91: W.arm_a_write()
92: W.e_lbu(s3, W.R_STATUS, t0)                # armed -> DRQ set, every leg
93: W.e_store(LIBATA_SRST, 0, t1)              # <<< 0x3f6
94: W.e_lbu(s4, W.R_STATUS, t0)                # EVERY leg: 50, the reset happened
95: W.e_lbu(s5, W.R_DATA, t0)                  # EVERY leg: ff, the ring was purged
96: 
97: HALT = len(W.prog)
98: W.emit(W.beq(W.zero, W.zero, -1), "b 0x")
99: W.emit(W.NOP, "nop")
100: W.HALT_ADDR = W.BASE + HALT * 4
101: W.REGS = ("v0", "v1", "a0", "s0", "s1", "s2", "s3", "s4", "s5")
102: 
103: W.DISK = DISK
104: W.OUTDIR = OUTDIR
105: W.RAWBIN = os.path.join(OUTDIR, "wdcaltoff_4bit.bin")
106: with open(W.RAWBIN, "wb") as f:
107:     for w, _ in W.prog:
108:         f.write(bytes([w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff]))
109: 
110: lines = []
111: 
112: 
113: def out(s=""):
114:     lines.append(s)
115:     print(s)
116:     sys.stdout.flush()
117: 
118: 
119: def run_leg(binary, tag):
120:     import re
121:     argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
122:             "-d", W.DISK_PREFIX + DISK, "0x%x:%s" % (W.BASE, W.RAWBIN)]
123:     out("  command   " + " ".join(argv))
124:     emu = W.Emu(argv)
125:     dis = emu.send("unassemble 0x%x 0x%x" % (W.BASE, W.BASE + len(W.prog) * 4), wait=3.0)
126:     seen = {}
127:     for line in dis.splitlines():
128:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
129:         if m:
130:             seen[int(m.group(1), 16) & 0xffffffff] = m.group(2)
131:     w_ok = sum(1 for i, (w, _) in enumerate(W.prog)
132:                if seen.get((W.BASE + i * 4) & 0xffffffff) == "%08x" % w)
133:     out("  CONTROL 0 encodings: %d of %d words agree with the emulator's disassembler"
134:         % (w_ok, len(W.prog)))
135:     emu.send("breakpoint add 0x%x" % W.HALT_ADDR, wait=0.5)
136:     emu.send("continue", wait=1.0)
137:     deadline = time.time() + 90
138:     parked = False
139:     while time.time() < deadline:
140:         emu.drain(0.5)
141:         #  *** MATCH THE HIT LINE, NOT THE BARE WORD. ***  This read
142:         #  `if "BREAKPOINT" in <tail>.upper():` until 2026-08-30, and the
143:         #  transcript contains the probe's OWN echoed setup command,
144:         #  `breakpoint add 0x...`.  The check matched its own input and could
145:         #  never return False.  It was right by accident in every run where the
146:         #  guest parked, and silently wrong in the first run where it did not:
147:         #  a mutant returning 0 from the device handler raises EXCEPTION_DBE, the
148:         #  guest re-executes the faulting store forever, and the probe still
149:         #  reported `breakpoint reached: True` with every register reading ??.
150:         #  That was scored as a KILL -- a failed run counted as a table result.
151:         #  The emulator prints `BREAKPOINT: pc = 0x...` on a real hit.
152:         if "BREAKPOINT: PC" in bytes(emu.buf[-4000:]).decode("latin1", "replace").upper():
153:             parked = True
154:             break
155:     out("  parked at the halt breakpoint: %s" % ("yes" if parked else "*** NO ***"))
156:     got = {}
157:     for nm in W.REGS:
158:         v = W.reg(emu, nm)
159:         got[nm] = None if v is None else (v & 0xff)
160:     emu.close(os.path.join(OUTDIR, "transcript_4bit_%s.log" % tag))
161:     return got, w_ok, parked
162: 
163: 
164: out("=" * 100)
165: out("wdcaltoffset -- THE 0x0e ROW.  Offset-1 pokes in the shipped detector are")
166: out("0x06/0x02/0x04, all with WDCTL_4BIT CLEAR.  This adds the bit-3-SET value.")
167: out("=" * 100)
168: out("date        %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
169: out("rig         evbmips -e malta (UNMODIFIED), image %s attached iR:" % DISK)
170: out("program     %d guest instructions" % len(W.prog))
171: out("value       0x%02x = WDCTL_IDS|WDCTL_RST|WDCTL_4BIT -- libata's SRST assert" % LIBATA_SRST)
172: out()
173: 
174: res = {}
175: for tag, binary in LEGS:
176:     out("-" * 100)
177:     out("LEG %s   %s" % (tag, binary))
178:     out("-" * 100)
179:     got, w_ok, parked = run_leg(binary, tag)
180:     res[tag] = dict(got=got, w=w_ok, parked=parked)
181:     out()
182: 
183: #  label, reg, want-or-None.  A `None` want is RECORDED, not predicted.
184: NAMES = [
185:     ("v0", "liveness   RAM round-trip 0x55", 0x55),
186:     ("v1", "liveness   cyl_lo readback (0x6655 low)", 0x55),
187:     ("a0", "liveness   cyl_hi readback (0x6655 high)", 0x66),
188:     ("s0", "P5 live    armed before the 0x3f7 0x0e poke: DRQ SET", W.ST_ARMED),
189:     ("s1", "P5 DEFECT  status after 0x0e at 0x3f7   (50 = reset happened)", None),
190:     ("s2", "P5 DEFECT  data   after 0x0e at 0x3f7   (ff = ring purged)", None),
191:     ("s3", "P6 live    armed before the 0x3f6 0x0e poke: DRQ SET", W.ST_ARMED),
192:     ("s4", "P6 ACCEPT  status after 0x0e at 0x3f6   (50 on EVERY leg)", W.ST_IDLE),
193:     ("s5", "P6 ACCEPT  data   after 0x0e at 0x3f6   (ff on EVERY leg)", W.FF),
194: ]
195: 
196: out("=" * 100)
197: out("THE TABLE")
198: out("=" * 100)
199: hdr = "  %-58s %-5s" % ("", "want")
200: for tag, _ in LEGS:
201:     hdr += " %-7s" % tag
202: out(hdr)
203: npass = nfail = 0
204: for rn, lab, want in NAMES:
205:     line = "  %-58s %-5s" % (lab, ("%02x" % want) if want is not None else "--")
206:     for tag, _ in LEGS:
207:         g = res[tag]["got"].get(rn)
208:         line += " %-7s" % (("%02x" % g) if g is not None else "??")
209:         if want is not None:
210:             npass += (g == want)
211:             nfail += (g != want)
212:     out(line)
213: out()
214: out("  %d of %d PREDICTED cells correct (the P5 pair is recorded, not predicted --"
215:     % (npass, npass + nfail))
216: out("  it is the differential, and its whole point is that it DIFFERS by leg)")
217: out()
218: 
219: out("=" * 100)
220: out("VERDICT -- per leg, did a 0x0e store to the READ-ONLY 0x3f7 perform a reset?")
221: out("=" * 100)
222: for tag, _ in LEGS:
223:     g = res[tag]["got"]
224:     reset = (g.get("s1") == W.ST_IDLE and g.get("s2") == W.FF)
225:     declined = (g.get("s1") == W.ST_ARMED and g.get("s2") == 0x71)
226:     accept_ok = (g.get("s4") == W.ST_IDLE and g.get("s5") == W.FF)
227:     armed_ok = (g.get("s0") == W.ST_ARMED and g.get("s3") == W.ST_ARMED)
228:     out("  %-6s armed both phases: %-3s   ACCEPT 0x3f6 0x0e still resets: %-3s"
229:         % (tag, "yes" if armed_ok else "NO", "yes" if accept_ok else "NO"))
230:     out("         0x3f7 0x0e -> %s"
231:         % ("*** RESET PERFORMED -- DEFECT PRESENT ***" if reset else
232:            ("declined (the fix's behaviour)" if declined else
233:             "INDETERMINATE s1=%s s2=%s" % (g.get("s1"), g.get("s2")))))
234: out()
235: out("  If the fix leg declines and a mask-guard mutant RESETS, the shipped 18 rows")
236: out("  are blind to a one-clause narrowing on a bit libata holds set at all times.")
237: out("ALTOFF_4BIT_DONE")
238: 
239: with open(os.path.join(OUTDIR, "TABLE_4BIT.txt"), "w") as f:
240:     f.write("\n".join(lines) + "\n")
regress/ppc_rldicl_probe.py
1: #!/usr/bin/env python3
2: """ppcrldiclzero -- RUNG-3 WITNESS for X(rldicl) writing zero on every execution.
3: 
4: DEFECT.  src/cpus/cpu_ppc_instr.c, X(rldicl):
5: 
6:         uint64_t tmp = cpu->cd.ppc.gpr[rs], tmp2;
7:         while (sh-- != 0) { ... }              /*  rotate, into tmp        */
8:         tmp2 = 0;
9:         while (mb <= 63) {
10:                 tmp |= ((uint64_t)1 << (63-mb));   /*  <-- tmp, not tmp2   */
11:                 mb ++;
12:         }
13:         cpu->cd.ppc.gpr[ra] = tmp & tmp2;          /*  tmp2 is still 0     */
14: 
15: TWO TOKENS ARE WRONG, NOT ONE, and only the second is observable today:
16:   (1) the mask is ORed into `tmp' -- the ROTATED VALUE -- rather than into `tmp2',
17:       so the rotated data is destroyed by having the mask bits forced to 1;
18:   (2) `tmp2' is therefore never assigned after `= 0', so the AND yields 0.
19: Defect (2) hides defect (1).  The single-character repair `tmp |=' -> `tmp2 |='
20: fixes both at once.  TWO tempting edits are measured wrong, and they are wrong
21: DIFFERENTLY -- a distinction an earlier draft of this paragraph got wrong, and a
22: pass-2 seat caught it still standing here after the product comment was corrected:
23:   * replacing the `&' with `|' ships ROTL64(rS,SH) | MASK(MB,63), an OR where the
24:     architecture says AND -- 126 of 190 cells wrong.  That is the M_NAIVE leg.
25:   * deleting the `& tmp2' outright, ON THE FIXED CODE, ships ROTL64 ALONE with the
26:     mask IGNORED -- 16/19, measured as M_NOMASK by the pass-2 seat.  (Before the fix
27:     it would have shipped the OR, because the mask was in `tmp'; witness_naive.out
28:     measured THAT function, not this one.)
29: *** THE `naive fix' ROW BELOW IS AN ARITHMETIC IDENTITY OVER THIS FILE'S OWN
30: CONSTANTS AND CANNOT FAIL UNDER ANY MUTATION OF THE EMULATOR. ***  It never touches
31: the binary, the registers or any session, and it is green in every leg of every table
32: run so far.  An earlier draft of this line said it 'exists to make that statement
33: measurable rather than argued'; it does not, and a pass-2 seat named it as the
34: check-that-cannot-fail shape sitting inside a detector whose whole purpose is to be
35: failable.  **THE M_NAIVE KILL-TABLE LEG is what makes the claim measurable.**  The row
36: is CARRIED-NOT-COUNTED, the disposition already used for `vacuous cell'.
37: 
38: ARCHITECTURE, read locally -- _scratchpad/ppc_pem_32and64_2005.txt:29736 (rldiclx):
39:         n <- sh[5] || sh[0-4]
40:         r <- ROTL[64](rS, n)
41:         b <- mb[5] || mb[0-4]
42:         m <- MASK(b, 63)
43:         rA <- r & m
44: and the prose at :29737 -- "A mask is generated having 1 bits from bit MB through
45: bit 63 and 0 bits elsewhere.  The rotated data is ANDed with the generated mask".
46: IBM bit numbering is big-endian, so MASK(b,63) is the LOW (64-b) bits: for b=32
47: that is 0x00000000ffffffff, which is why `rldicl rA,rS,0,32' is the canonical
48: 32-bit zero-extend (`clrldi rA,rS,32', manual :29758).
49: EVERY `want' in this probe is computed from those five lines, never from the tree.
50: 
51: RUNG 3: real PowerPC instructions fetched from guest RAM, decoded by the real
52: decoder and executed by the real handler, on the UNMODIFIED in-tree `-E bareppc'.
53: No machine description edited, no device_add, no CPU model override -- bareppc's
54: own MACHINE_DEFAULT_CPU is PPC970, which is 64-bit in the in-tree CPU table, and
55: 64-bit is what the decoder requires (`if (cpu->cd.ppc.bits == 32) goto bad').
56: 
57: THE ORACLE is a guest-visible wrong VALUE, not a process death, so it is read
58: directly out of the destination register.  Four controls:
59:   live          `li r9,0x1234' in the same session reads back 0x1234 -- the guest
60:                 really executes and the readback path really works.
61:   seed holds    a destination register seeded with a sentinel and then stepped
62:                 over a NON-WRITING instruction still holds the sentinel.  This is
63:                 the control that makes a zero readback attributable: it proves 0
64:                 means "rldicl wrote 0", not "nothing ever wrote this register".
65:   neg apparatus a bogus machine name must turn `live' RED.  Without this, `live'
66:                 is a check that cannot fail.
67:   disasm xcheck every instruction word placed is disassembled by the tree's own
68:                 disassembler (cpu_ppc.c, a DIFFERENT code path from the execute
69:                 handler in cpu_ppc_instr.c) and compared against the operands the
70:                 encoder intended.  Guards the hand-assembled-encoding trap.
71:   rldicr        the correctly-written sibling, same rotate-and-mask shape, same
72:                 session -- attributes the failure to X(rldicl) rather than to the
73:                 encoding, the machine, the rotate or this program.
74: 
75: TEST-FIRST SHAPE: every `want' is the ARCHITECTURAL value.  On the committed
76: pre-fix build the rldicl rows are RED; after `tmp |=' -> `tmp2 |=' the identical
77: script goes green.
78: 
79: Sentinel: PPC_RLDICL_PROBE_DONE
80: """
81: 
82: import re
83: import subprocess
84: import sys
85: import time
86: 
87: if len(sys.argv) < 2:
88:     sys.stderr.write("usage: ppc_rldicl_witness.py <gxemul> [label]\n")
89:     sys.exit(2)
90: 
91: BIN = sys.argv[1]
92: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
93: DUMMY = "/tmp/ppc_rldicl_dummy.bin"
94: open(DUMMY, "wb").write(b"\x00\x00\x00\x00")
95: 
96: CODE = 0x10000
97: M64 = (1 << 64) - 1
98: SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into every destination
99: RS_ONES = M64                    # census source: makes EVERY cell non-vacuous
100: RS_VAL = 0xDEADBEEFCAFEF00D      # value source: exercises the rotate too
101: SRC = 3                          # rS is always r3; r3 is never a destination
102: DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session
103: 
104: rows = []
105: 
106: 
107: def row(name, got, want, note=""):
108:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
109:     assert len(name) <= 17, name
110:     ok = (got == want)
111:     rows.append((name, ok))
112:     print("%-18s %-20s %-20s %-48s %s" % (name, str(got), str(want), note,
113:                                           "ok" if ok else "FAIL"))
114:     return ok
115: 
116: 
117: # ----------------------------------------------------------------- architecture
118: def rotl64(x, n):
119:     n &= 63
120:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
121: 
122: 
123: def mask_b_63(b):
124:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
125:     assert 0 <= b <= 63
126:     return (1 << (64 - b)) - 1
127: 
128: 
129: def mask_0_e(e):
130:     """MASK(0,e), big-endian = the high (e+1) bits."""
131:     assert 0 <= e <= 63
132:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
133: 
134: 
135: def want_rldicl(rs_val, sh, mb):
136:     return rotl64(rs_val, sh) & mask_b_63(mb)
137: 
138: 
139: def want_rldicr(rs_val, sh, me):
140:     return rotl64(rs_val, sh) & mask_0_e(me)
141: 
142: 
143: def want_rldimi(rs_val, ra_val, sh, mb):
144:     """manual :29908 -- m <- MASK(b, ~n); prose :29909 "1 bits from bit MB
145:        through bit 63 - SH"."""
146:     m = mask_b_63(mb) & mask_0_e((63 - sh) & 63)
147:     return (rotl64(rs_val, sh) & m) | (ra_val & (~m & M64))
148: 
149: 
150: def rotl32(x, n):
151:     """ROTL[32] per manual :6878 -- two copies of rS[32-63], then rotate."""
152:     lo = x & 0xFFFFFFFF
153:     n &= 31
154:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
155:     return (r32 << 32) | r32
156: 
157: 
158: def mask32(mb, me):
159:     """MASK(mb+32, me+32) confined to the low 32 bits, PowerPC wrap-around form."""
160:     m = 0
161:     b = mb
162:     while True:
163:         m |= 1 << (31 - b)
164:         if b == me:
165:             break
166:         b = (b + 1) & 31
167:     return m
168: 
169: 
170: def want_rlwinm(rs_val, sh, mb, me):
171:     return rotl32(rs_val, sh) & mask32(mb, me)
172: 
173: 
174: def want_rlwimi(rs_val, ra_val, sh, mb, me):
175:     m = mask32(mb, me)
176:     return (rotl32(rs_val, sh) & m) | (ra_val & (~m & M64))
177: 
178: 
179: # -------------------------------------------------------------------- encodings
180: def enc_md(xo, rs, ra, sh, mbe, rc=0):
181:     """opcode 30 (rldicl/rldicr/rldimi).  Field placement derived from the manual's
182:        own instruction-format diagram at :29706-29734:
183:          0-5 opcode | 6-10 S | 11-15 A | 16-20 sh[0-4] | 21-26 mb[5]||mb[0-4]
184:          | 27-29 XO | 30 sh[5] | 31 Rc      (all big-endian bit numbers)"""
185:     assert 0 <= sh <= 63 and 0 <= mbe <= 63 and 0 <= xo <= 7
186:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
187:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
188:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
189: 
190: 
191: def RLDICL(ra, rs, sh, mb):
192:     return enc_md(0, rs, ra, sh, mb)
193: 
194: 
195: def RLDICR(ra, rs, sh, me):
196:     return enc_md(1, rs, ra, sh, me)
197: 
198: 
199: def RLDIMI(ra, rs, sh, mb):
200:     return enc_md(3, rs, ra, sh, mb)
201: 
202: 
203: def enc_m(op, rs, ra, sh, mb, me, rc=0):
204:     """opcode 20/21 (rlwimi/rlwinm): 0-5 op | 6-10 S | 11-15 A | 16-20 SH
205:        | 21-25 MB | 26-30 ME | 31 Rc."""
206:     return ((op << 26) | (rs << 21) | (ra << 16) | (sh << 11) | (mb << 6)
207:             | (me << 1) | rc) & 0xFFFFFFFF
208: 
209: 
210: def RLWINM(ra, rs, sh, mb, me):
211:     return enc_m(21, rs, ra, sh, mb, me)
212: 
213: 
214: def RLWIMI(ra, rs, sh, mb, me):
215:     return enc_m(20, rs, ra, sh, mb, me)
216: 
217: 
218: def LI(rd, simm):
219:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
220: 
221: 
222: def ORI(ra, rs, imm):
223:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
224: 
225: 
226: NOP = ORI(0, 0, 0)               # ori r0,r0,0 -- writes r0 only
227: 
228: 
229: # ---------------------------------------------------------------------- sessions
230: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
231:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs.
232:        Returns (regs dict, disasm list, transcript, how)."""
233:     cmds = list(setup)
234:     for i, w in enumerate(insns):
235:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
236:     if insns:
237:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
238:     cmds.append("pc=0x%x" % CODE)
239:     if insns:
240:         cmds.append("step %d" % len(insns))
241:     cmds.append("reg")
242:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
243:     if cpu:
244:         argv += ["-C", cpu]
245:     argv += ["0x%x:%s" % (CODE, DUMMY)]
246:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
247:     try:
248:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
249:                            stderr=subprocess.STDOUT, timeout=timeout)
250:     except subprocess.TimeoutExpired as e:
251:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
252:         return {}, [], out, "TIMEOUT"
253:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
254:     rc = p.returncode
255:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
256:     # the LAST `reg' dump in the transcript
257:     idx = t.rfind("GXemul> reg")
258:     regs = {}
259:     if idx >= 0:
260:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
261:             regs[int(m.group(1))] = int(m.group(2), 16)
262:     dis = []
263:     di = t.find("GXemul> unassemble")
264:     if di >= 0:
265:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
266:                 else len(t)]
267:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
268:                              r"(?:\t(\S+))?", seg, re.M):
269:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
270:     return regs, dis, t, how
271: 
272: 
273: def seed(pairs):
274:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
275: 
276: 
277: print("ppcrldiclzero RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
278: print("machine: -E bareppc -M 64 (UNMODIFIED in-tree; MACHINE_DEFAULT_CPU=PPC970,"
279:       " 64-bit)")
280: print("wants derived from _scratchpad/ppc_pem_32and64_2005.txt:29736 (rldiclx),"
281:       " :6878 (ROTL32)")
282: print("%-18s %-20s %-20s %-48s %s" % ("row", "got", "want", "note", ""))
283: t0 = time.time()
284: disasm_checked = 0
285: disasm_ok = 0
286: 
287: # ============================================================ CONTROL SESSION ==
288: ctl_insns = [
289:     LI(9, 0x1234),                       # liveness
290:     NOP,                                 # seed-holds probe steps over this
291:     RLDICL(4, SRC, 0, 32),               # clrldi r4,r3,32 -- the canonical case
292:     RLDICR(5, SRC, 0, 31),               # DISCRIMINATING control: correct sibling
293:     RLDICL(6, SRC, 8, 0),                # pure rotate, mask = all ones
294:     RLDICR(7, SRC, 8, 63),               # same rotate through the good sibling
295: ]
296: ctl_setup = seed([(SRC, RS_VAL), (30, SENT)] + [(r, SENT) for r in DESTS])
297: regs, dis, T, how = session(ctl_setup, ctl_insns)
298: 
299: open("/tmp/ppc_rldicl_ctl.txt", "w").write(T)
300: 
301: row("session", how, "exit0", "the control session ran to `quit'")
302: row("live", hex(regs.get(9, -1)), hex(0x1234),
303:     "li r9,0x1234 -- the guest executes and readback works")
304: row("seed holds", hex(regs.get(30, -1)), hex(SENT),
305:     "r30 seeded, never a destination: a 0 readback means SOMETHING wrote it")
306: row("src intact", hex(regs.get(SRC, -1)), hex(RS_VAL),
307:     "rS is unchanged by any of these instructions")
308: 
309: # --- disassembler cross-check (different code path from the execute handler)
310: want_dis = ["li", "nop", "rldicl", "rldicr", "rldicl", "rldicr"]
311: want_ops = ["r9,4660", "", "r4,r3,0,32", "r5,r3,0,31", "r6,r3,8,0",
312:             "r7,r3,8,63"]
313: got_pairs = [(m, o) for _, m, o in dis]
314: disasm_checked += len(want_dis)
315: disasm_ok += sum(1 for i, (m, o) in enumerate(got_pairs[:len(want_dis)])
316:                  if m == want_dis[i] and o == want_ops[i])
317: row("disasm xcheck", "%d/%d" % (disasm_ok, disasm_checked), "6/6",
318:     "tree's OWN disassembler agrees with the encoder, operand for operand")
319: 
320: # --- the defect, and its discriminating sibling, in ONE session
321: row("zx32 rldicl", hex(regs.get(4, -1)), hex(want_rldicl(RS_VAL, 0, 32)),
322:     "clrldi r4,r3,32 -- the 32-bit zero-extend compilers emit constantly")
323: row("zx32 rldicr", hex(regs.get(5, -1)), hex(want_rldicr(RS_VAL, 0, 31)),
324:     "DISCRIMINATING: the sibling, same session, same rotate, same encoder")
325: row("rot8 rldicl", hex(regs.get(6, -1)), hex(want_rldicl(RS_VAL, 8, 0)),
326:     "rotldi r6,r3,8 -- mask is all-ones, so this is a PURE rotate")
327: row("rot8 rldicr", hex(regs.get(7, -1)), hex(want_rldicr(RS_VAL, 8, 63)),
328:     "DISCRIMINATING: the same pure rotate through the good sibling")
329: 
330: # --- what the NAIVE repair would produce, stated as a measurable prediction
331: # DERIVED, not measured here: what the "obvious" repair would produce.
332: _naive = rotl64(RS_VAL, 0) | mask_b_63(32)
333: row("naive fix wrong", "differs" if _naive != want_rldicl(RS_VAL, 0, 32) else "same",
334:     "differs",
335:     "DERIVED, arithmetic only: `&'->`|' ships OR-not-AND (0x%x).  Deleting the AND on the FIXED code ships ROTL alone -- see M_NOMASK" % _naive)
336: 
337: # ================================================ NEGATIVE APPARATUS CONTROL ==
338: # Prove `live' CAN go red.  A bogus machine name means no machine is built, so a
339: # green `live' would be a check that cannot fail.
340: nregs, _, nT, nhow = session(seed([(9, SENT)]), [LI(9, 0x1234)],
341:                              machine="nosuchmachine", timeout=60)
342: row("neg apparatus", "%s/%s" % (nhow, hex(nregs.get(9, -1))), "exit1/-0x1",
343:     "bogus machine -> no guest -> `live' MUST fail; the oracle is failable")
344: 
345: # ============================================ REACHABILITY CONTROL (32-bit) ===
346: # The decoder sends rld* to `bad' when bits == 32.  Same session, same encoding,
347: # a 32-bit CPU: the instruction must NOT execute as rldicl.
348: b32regs, _, b32T, b32how = session(
349:     seed([(SRC, RS_VAL), (4, SENT), (9, SENT)]),
350:     [LI(9, 0x1234), RLDICL(4, SRC, 0, 32)], timeout=60, machine="bareppc",
351:     cpu="PPC603")
352: open("/tmp/ppc_rldicl_32.txt", "w").write(b32T)
353: row("bits32 live", hex(b32regs.get(9, -1)), hex(0x1234),
354:     "PPC603 (32-bit): the guest still runs -- li executes")
355: row("bits32 rld bad", "TODO" if "TODO: rld" in b32T else "no-msg", "TODO",
356:     "decoder prints `TODO: rld* in 32-bit mode?' and goes to bad -- unreachable")
357: 
358: # ===================================================== VACUITY (question 3) ===
359: # A cell where the ARCHITECTURAL answer is itself zero: a detector row placed
360: # here could never fail, whatever the handler does.
361: RS_VAC = 0xFFFFFFFF00000000
362: vregs, _, vT, vhow = session(seed([(SRC, RS_VAC)] + [(r, SENT) for r in DESTS]),
363:                              [RLDICL(4, SRC, 0, 32), RLDICL(5, SRC, 0, 0)])
364: row("vacuous cell", hex(vregs.get(4, -1)), hex(want_rldicl(RS_VAC, 0, 32)),
365:     "rS=0xffffffff00000000, SH=0, MB=32: correct answer IS 0 -- GREEN on a")
366: row("vac neighbour", hex(vregs.get(5, -1)), hex(want_rldicl(RS_VAC, 0, 0)),
367:     "  broken build.  Its MB=0 neighbour on the same rS is not vacuous.")
368: 
369: # ============================================================ THE (SH,MB) CENSUS
370: # rS = all-ones, so ROTL64(rS,SH) = all-ones for every SH and the architectural
371: # answer is exactly MASK(MB,63), which is NONZERO for every MB in 0..63.  Every
372: # cell of this census is therefore provably non-vacuous by construction.
373: combos = []
374: for mb in range(64):
375:     combos.append((0, mb))                      # MB sweep at SH=0
376: for sh in range(1, 64):
377:     combos.append((sh, 0))                      # SH sweep at MB=0
378: for k in range(1, 64):
379:     combos.append((k, k))                       # the diagonal
380: seen = set()
381: uniq = []
382: for c in combos:
383:     if c not in seen:
384:         seen.add(c)
385:         uniq.append(c)
386: 
387: census_fail = 0
388: census_zero = 0
389: census_run = 0
390: for base in range(0, len(uniq), len(DESTS)):
391:     chunk = uniq[base:base + len(DESTS)]
392:     insns = [RLDICL(DESTS[i], SRC, sh, mb) for i, (sh, mb) in enumerate(chunk)]
393:     st = seed([(SRC, RS_ONES)] + [(r, SENT) for r in DESTS])
394:     cregs, cdis, cT, chow = session(st, insns)
395:     if chow != "exit0":
396:         print("CENSUS SESSION ABORTED how=%s at base=%d" % (chow, base))
397:         break
398:     # disassembler cross-check on every census word too
399:     for i, (sh, mb) in enumerate(chunk):
400:         disasm_checked += 1
401:         if i < len(cdis) and cdis[i][1] == "rldicl" and \
402:            cdis[i][2] == "r%d,r%d,%d,%d" % (DESTS[i], SRC, sh, mb):
403:             disasm_ok += 1
404:     for i, (sh, mb) in enumerate(chunk):
405:         census_run += 1
406:         got = cregs.get(DESTS[i], None)
407:         exp = want_rldicl(RS_ONES, sh, mb)
408:         if got != exp:
409:             census_fail += 1
410:         if got == 0:
411:             census_zero += 1
412: 
413: row("census run", census_run, len(uniq),
414:     "(SH,MB) cells driven: MB sweep + SH sweep + diagonal, rS=all-ones")
415: row("census wrong", census_fail, 0,
416:     "cells whose result differs from MASK(MB,63) -- want 0 after a fix")
417: row("census zero", census_zero, 0,
418:     "cells that returned EXACTLY ZERO -- want 0 after a fix")
419: row("disasm total", "%d/%d" % (disasm_ok, disasm_checked),
420:     "%d/%d" % (disasm_checked, disasm_checked),
421:     "every placed word re-read by the tree's own disassembler")
422: 
423: # ================================ WHY THE SIBLING ROWS ARE NOT HERE =============
424: #
425: #  The witness this file is derived from is a FAMILY instrument: it also rows
426: #  X(rldimi) and X(rlwimi), which carry their OWN measured defects (ppcrldimimask,
427: #  ppcrlwimiwidth) that #522 does not touch and must not touch.  Shipping those rows
428: #  in a DETECTOR would make it PERMANENTLY RED until two unrelated rounds land --
429: #  a detector that cannot be green is a different fault from the one it was written
430: #  to catch, and a gate row over it would have to be ignored, which is how a gate
431: #  stops being read at all.
432: #
433: #  So this detector is scoped to X(rldicl).  The three sibling rows stay in the
434: #  witness at regress/artifacts/ppcrldiclzero/, which is the EVIDENCE for those two
435: #  filed rows and is correctly red there.  When either is fixed, its rows move here
436: #  or into a detector of its own -- that is a decision for those rounds, not this one.
437: #
438: #  MEASURED: witness 19/27 committed and 24/27 fixed, the five flipped rows being
439: #  exactly the ones kept below.  **THIS FILE HAS 19 ROWS, NOT 24** -- an earlier draft
440: #  of this note carried the witness's own post-fix count straight across, which a
441: #  pass-2 seat caught.  It is 19/19 on the fix and 14/19 pre-fix
442: #  (killtable_20260910/SCORES.txt).
443: 
444: # ================== ROWS ADDED BY PASS 2, WHICH FOUND TWO TOTAL ESCAPES =========
445: #
446: #  The 19-row instrument scored 19/19 against BOTH of these mutants -- total escapes,
447: #  MEASURED by the pass-2 measuring seat, not predicted:
448: #
449: #    M_SH5   drop the `sh5' bit from the SH decode.  Every rldicl with SH >= 32 then
450: #            rotates by SH-32.  *** THE INSTRUMENT WAS BLIND BY CONSTRUCTION: the
451: #            census uses an ALL-ONES source, and ROTL64(all-ones, n) is all-ones for
452: #            every n, so all 126 SH-varying cells compute the same value whatever the
453: #            rotate amount.  The only rotate-sensitive rows were zx32 (SH=0) and rot8
454: #            (SH=8) -- BOTH BELOW 32, so the sh5 bit was never load-bearing anywhere. ***
455: #            And it matters: the manual's simplified mnemonics make `srdi rA,rS,n' EQUAL
456: #            to `rldicl rA,rS,64-n,n', so EVERY logical right shift by 1..32 has SH >= 32.
457: #            Measured: under M_SH5 `clrldi' stays CORRECT while `srdi r5,r3,1' is wrong.
458: #            The one form the old instrument pinned is the one the mutant gets right.
459: #
460: #    M_CR0   feed update_cr0 the UNMASKED rotated value.  *** THIS IS NOT AN INVENTED
461: #            MUTANT: it is the token X(rldicr) ships, CORRECTLY, ten lines below -- there
462: #            `tmp' IS the destination.  A future editor harmonising the two handlers
463: #            writes exactly this. ***  The old instrument could not see it because it
464: #            emitted rc=0 on every encoding, leaving the whole record-form path unrun.
465: #
466: #  CR0 is a THREE-valued channel here and each candidate lands in a different value:
467: #    the fix -> GT (0x40000000) | the defect -> EQ (0x20000000) | M_CR0 -> LT (0x80000000)
468: #  so one row separates all three states.  These rows also redden under M_ORIG, so they
469: #  satisfy floor (a)/(b) as well as killing the (d)-shaped mutant.
470: #
471: #  In their OWN session, so the control session's disasm cross-check lists are untouched.
472: xregs, _, xT, xhow = session(
473:     seed([(SRC, RS_VAL)] + [(r, SENT) for r in DESTS]),
474:     [RLDICL(8, SRC, 63, 0),            # rotldi r8,r3,63 -- SH=63 NEEDS the sh5 bit
475:      RLDICL(11, SRC, 32, 32),          # high-word extract -- SH=32 NEEDS the sh5 bit
476:      enc_md(0, SRC, 10, 0, 32, rc=1)]) # rldicl. r10,r3,0,32 -- THE RECORD FORM
477: _cr = re.findall(r"cr[ \t]+= (0x[0-9a-fA-F]+)", xT)
478: _crv = int(_cr[-1], 16) if _cr else -1
479: row("cand session", xhow, "exit0", "the candidate-row session ran to `quit'")
480: row("cr parsed", "yes" if _cr else "no", "yes",
481:     "NEGATIVE CONTROL on the apparatus: the cr regex must MATCH something")
482: row("sh63 rldicl", hex(xregs.get(8, -1)), hex(want_rldicl(RS_VAL, 63, 0)),
483:     "SH=63: pins the sh5 bit of the SH decode")
484: row("sh32 rldicl", hex(xregs.get(11, -1)), hex(want_rldicl(RS_VAL, 32, 32)),
485:     "SH=32,MB=32 high-word extract: pins the sh5 bit again, on a masked cell")
486: row("rc cr0", hex(_crv), hex(0x40000000),
487:     "rldicl. -> CR0=GT.  defect gives EQ(0x2...), update_cr0(cpu,tmp) gives LT(0x8...)")
488: 
489: # ================================ WHY THE SIBLING ROWS ARE NOT HERE =============
490: #
491: #  The witness this file is derived from is a FAMILY instrument: it also rows
492: #  X(rldimi) and X(rlwimi), which carry their OWN measured defects (ppcrldimimask,
493: #  ppcrlwimiwidth) that #522 does not touch and must not touch.  Shipping those rows
494: #  in a DETECTOR would make it PERMANENTLY RED until two unrelated rounds land --
495: #  a detector that cannot be green is a different fault from the one it was written
496: #  to catch, and a gate row over it would have to be ignored, which is how a gate
497: #  stops being read at all.
498: #
499: #  So this detector is scoped to X(rldicl).  The three sibling rows stay in the
500: #  witness at regress/artifacts/ppcrldiclzero/, which is the EVIDENCE for those two
501: #  filed rows and is correctly red there.  When either is fixed, its rows move here
502: #  or into a detector of its own -- that is a decision for those rounds, not this one.
503: #
504: #  MEASURED: witness 19/27 committed and 24/27 fixed, the five flipped rows being
505: #  exactly the ones kept below.  **THIS FILE HAS 19 ROWS, NOT 24** -- an earlier draft
506: #  of this note carried the witness's own post-fix count straight across, which a
507: #  pass-2 seat caught.  It is 19/19 on the fix and 14/19 pre-fix
508: #  (killtable_20260910/SCORES.txt).
509: 
510: #  =============================== CONTRACT (clause (e)) =========================
511: #
512: #  WHAT THIS DETECTOR IS DESIGNED TO CATCH, and what it is NOT.  The boundary below
513: #  is MEASURED -- every entry was established by a mutant that was built and scored,
514: #  not by reasoning about the row set.
515: #
516: #  CAUGHT:  the mask variable; the mask bit positions; the mask end bound; `&' -> `|';
517: #           the mask ignored entirely; the `mb'-field decode INCLUDING its high bit;
518: #           rotate-versus-shift (the census sees SHL(all-ones,n) != all-ones); the
519: #           rotate AMOUNT at SH=0, 8, 32 and 63; the destination width; the `ra'-field
520: #           decode for ra >= 16; and the record form's CR0 result.
521: #
522: #  NOT CAUGHT, disclosed rather than left to be discovered:
523: #    * `rs'-field edits that are the identity on r3.  EVERY rldicl this file executes
524: #      reads rS = r3, so `(iw >> 21) & 31' -> `& 15' escapes.  Low plausibility, named
525: #      because it is a real property of the design rather than an oversight.
526: #    * edits conditioned on `ra == 0'.
527: #    * rotate-amount edits that are the identity at ALL FOUR rowed SH values.
528: #
529: #  *** AND THE 190-CELL CENSUS IS NARROWER THAN ITS HEADLINE NUMBER SUGGESTS. ***  It
530: #  drives an ALL-ONES source deliberately, so that every mask window is non-empty and
531: #  "190 of 190" means something.  The same choice makes ROTL64 the IDENTITY, so the
532: #  census is a function of MB ALONE: the 63 cells of its SH sweep are 63 copies of the
533: #  same mask case.  **The census pins MASK(MB,63).  It does not pin the rotate.**  The
534: #  rotate is pinned by the value rows -- zx32, rot8, sh32 and sh63 -- and a genuine
535: #  two-axis census would need a second source value.  This was found by a pass-2 seat
536: #  after the round's own PRETABLE claimed the census "walks the cross-product"; it does
537: #  not, and the corrected sentence is the one that belongs in a contract.
538: 
539: # ================================================================ SCORE + DONE
540: npass = sum(1 for _, ok in rows if ok)
541: print("")
542: print("SCORE %d/%d  elapsed=%.1fs  binary=%s  label=%s"
543:       % (npass, len(rows), time.time() - t0, BIN, LABEL))
544: print("FAILING: " + ", ".join(n for n, ok in rows if not ok))
545: print("PPC_RLDICL_PROBE_DONE")

