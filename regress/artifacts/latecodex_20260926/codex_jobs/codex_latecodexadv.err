499:  *  One row: an exact sector count, asserted through BOTH capacity word pairs
500:  *  (57-58 "current capacity" and 60-61 "total addressable"). `why` names the
501:  *  byte this row puts at or past the divergence point -- a row that cannot say
502:  *  that is a row that would pass unfixed.
503:  */
504: /*  #551: the comparison is split out of row() as a DEVICE-INDEPENDENT comparator (it counts and prints, so it
505:     is not pure), so the self-check can feed it each disjunct alone, and a zero, without building a device.
506:     row() built the device and compared the extracted got57/got60 against `sectors'; nothing could inject an
507:     observed value independently.  row()'s eight call sites keep their original output and add a report line
508:     for each COVERED failure (four on the w57hi device variant, five on w58lo -- GPT-6 Astra, confirming
509:     #551).  */
510: static int rowcmp_calls;
511: static int cmp_fails;	/*  failures the two comparators counted; only they increment it  */
512: 
513: static void row_cmp(const char *why, uint64_t sectors, uint64_t got57, uint64_t got60)
514: {
515: 	rowcmp_calls ++;
516: 	rows ++;
517: 
518: 	if (got57 != sectors || got60 != sectors) {
519: 		printf("  FAIL %-38s sectors=%llu -> 57/58=%llu 60/61=%llu\n",
520: 		    why, (unsigned long long)sectors,
521: 		    (unsigned long long)got57, (unsigned long long)got60);
522: 		failures ++;
523: 		cmp_fails ++;
524: 		if (why[0] != '@')	/*  #551f: contract (B) -- a covered failure reports itself  */
525: 			printf("  FAIL  covered comparator failure -- %d failures so far\n", cmp_fails);
526: 	} else {
527: 		printf("  ok   %-38s %llu\n", why, (unsigned long long)sectors);
528: 	}
529: }
530: 
531: static void row(const char *why, uint64_t sectors)
532: {
533: 	struct wdc_data d;
534: 	uint64_t got57, got60;
535: 
536: 	build(&d, sectors, 1, 1, 1);
537: 	got57 = sectors_from_block(&d, 57, 58);
538: 	got60 = sectors_from_block(&d, 60, 61);
539: 	row_cmp(why, sectors, got57, got60);
540: }
