HEAD:regress/gate_mips_folds.sh:2:# GATE 16 -- MIPS instruction-combiner ("fold") witness (#388).
HEAD:regress/gate_mips_folds.sh:3:#
HEAD:regress/gate_mips_folds.sh:4:# What this protects
HEAD:regress/gate_mips_folds.sh:5:# -----------------
HEAD:regress/gate_mips_folds.sh:6:# The nine MIPS COMBINE sites install 34 fold-handler variants, and before #388
HEAD:regress/gate_mips_folds.sh:7:# NOTHING could witness one firing: most folds are architecturally transparent
HEAD:regress/gate_mips_folds.sh:8:# by construction, so any result-asserting row passes whether or not the fold
HEAD:regress/gate_mips_folds.sh:9:# fires -- the recorded vacuity mode. #388 added pull-only install/fire counters
HEAD:regress/gate_mips_folds.sh:10:# (cpu_mips.h) printed by tlbdump as a prefix-bound MFOLD block. This gate runs
HEAD:regress/gate_mips_folds.sh:11:# regress/mips_fold_probe.py, whose rows drive real fold loops free-running
HEAD:regress/gate_mips_folds.sh:12:# (never step -- combining gates on !single_step) with a breakpoint AFTER each
HEAD:regress/gate_mips_folds.sh:13:# sequence on a NON-ARMING instruction, and grades the counters as EQUALITIES
HEAD:regress/gate_mips_folds.sh:14:# derived from the read-ahead rule (a breakpoint anywhere disables read-ahead
HEAD:regress/gate_mips_folds.sh:15:# machine-wide, so fire == passes-1; the derivations live in the probe's rows).
HEAD:regress/gate_mips_folds.sh:16:#
