1: #!/usr/bin/env python3
2: """#551f2: score M19 (heal) and M18 (four resets) with gate 2's REAL lib.sh, on the FILE redirect the gate
3: uses and on the PIPE the adjudication proposes as the close.  Main-check verdict = real lib.sh fails==0 AND
4: H (@@SELFCHECK@@ in source) AND G (G text in log).  A shape ESCAPES the MAIN checks on a device when it is
5: green on pristine and green on a defect device that the unedited F reds."""
6: import io, os, re, subprocess
7: W = "/tmp/opus551f2"
8: G_TEXT = "SELFCHECK the comparator can still fail"
9: EMIT = "covered comparator failure"
10: io.open(W + "/gate_real.sh", "w").write(
11:     'export LOGDIR=' + W + '/logdir\nWDCLOG="$1"\n. ' + W + '/lib.sh > /dev/null 2>&1\n'
12:     'gate_begin "wdc-only" > /dev/null 2>&1\n. ' + W + '/gatewdc.inc > /dev/null 2>&1\necho "REALFAILS=$_fails"\n')
13: DEVS = ("pristine", "dropold", "drqring", "w57hi")
14: HARN = ["F", "M19_heal", "M18_f_before_recon", "M18_f_after_printf", "M18_cf_before_recon", "M18_cf_after_printf"]
15: 
16: 
17: def rd(dev, h, ext):
18:     p = "%s/dev/%s/regress/%s.%s" % (W, dev, h, ext)
19:     return io.open(p, encoding="utf-8", errors="replace").read() if os.path.exists(p) else None
20: 
21: 
22: def summ(t):
23:     if t is None:
24:         return "NOLOG"
25:     m = re.search(r"^(\d+) rows, (\d+) failures", t, re.M)
26:     e = len([l for l in t.split("\n") if EMIT in l])
27:     tok = "PASS" if "WDC_IDENTIFY_PASS" in t else ("FAIL" if "WDC_IDENTIFY_FAIL" in t else "NOTOK")
28:     return "%s/%s %s%s" % (m.group(1) if m else "?", m.group(2) if m else "?", tok, " r%d" % e if e else "")
29: 
30: 
31: def main_reds(dev, h, chan):
32:     if (rd(dev, h, chan + ".rc") or "").startswith("BUILD_FAIL"):
33:         return ["compile"]
34:     logp = "%s/dev/%s/regress/%s.%s.log" % (W, dev, h, chan)
35:     out = subprocess.run(["bash", W + "/gate_real.sh", logp], capture_output=True, text=True).stdout
36:     m = re.search(r"REALFAILS=(\d+)", out)
37:     reds = ["lib=%s" % (m.group(1) if m else "?")] if (not m or m.group(1) != "0") else []
38:     src = "%s/h/%s.c" % (W, h)
39:     if subprocess.run(["grep", "-q", "@@SELFCHECK@@", src]).returncode != 0:
40:         reds.append("H")
41:     if subprocess.run(["grep", "-q", G_TEXT, logp]).returncode != 0:
42:         reds.append("G")
43:     return reds
44: 
45: 
46: def verd(dev, h, chan):
47:     return "GREEN" if not main_reds(dev, h, chan) else "red" + str(main_reds(dev, h, chan))
48: 
49: 
50: print("=== MAIN checks (real lib.sh + H + G), per device, FILE redirect vs PIPE ===")
51: print("  %-22s %-8s | %-38s | %-38s" % ("harness", "chan", "pristine / defect verdicts", "escape?"))
52: for h in HARN:
53:     for chan in ("file", "pipe"):
54:         cells = {d: verd(d, h, chan) for d in DEVS}
55:         # escape: green pristine AND green on a defect device F reds (F is red there on this channel)
56:         esc = [d for d in DEVS[1:]
57:                if cells["pristine"] == "GREEN" and cells[d] == "GREEN"
58:                and verd(d, "F", chan) != "GREEN"]
59:         s = " ".join("%s=%s" % (d[:4], cells[d].split("[")[0] + ("" if cells[d] == "GREEN" else "*")) for d in DEVS)
60:         sm = " ".join("%s:%s" % (d[:4], summ(rd(d, h, chan + ".log"))) for d in DEVS)
61:         print("  %-22s %-8s | %s" % (h, chan, s))
62:         print("  %-22s %-8s |   %s  ESCAPES=%s" % ("", "", sm, ",".join(esc) or "-"))
63: print("ANALYZE_F2_DONE")
