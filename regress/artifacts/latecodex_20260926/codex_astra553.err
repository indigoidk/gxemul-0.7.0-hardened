1: #!/usr/bin/env python3
2: """#551f2: three measurements the adjudication asked to be MEASURED, not reasoned.
3:   M19  -- grok's walked shape: a constructor-registered atexit handler that, when
4:           failures==cmp_fails>0, rewinds a file-redirected stdout and writes a
5:           healthy log over the real one.  Built exactly as grok describes
6:           (constructor -> atexit -> fflush -> fseek(0) -> overwrite with a healthy
7:           log -> trim the tail).  I embed the REAL pristine healthy log (one adjacent
8:           string literal per line) and ftruncate the tail, which is the strongest,
9:           most faithful form of "writes a healthy-looking log over the real one".
10:   M18  -- four reset cells not in the roster: unconditional `failures = 0` before the
11:           reconciliation and after the count printf; likewise `cmp_fails = 0`.
12: usage: xf2.py <dir> <pristine_healthy_log>    (<dir>/F.c is MINE_f.c)"""
13: import io, sys
14: 
15: H = sys.argv[1]
16: HEALTHY = sys.argv[2]
17: F = io.open(H + "/F.c", encoding="utf-8", newline="").read()
18: 
19: 
20: def sub1(s, old, new):
21:     n = s.count(old)
32: raw = io.open(HEALTHY, encoding="utf-8", newline="").read()
33: lit = []
34: for ln in raw.split("\n"):
35:     e = ln.replace("\\", "\\\\").replace("\"", "\\\"")
36:     lit.append("\t\"%s\\n\"" % e)
37: HEAL_LOG = "static const char heal_log[] =\n" + "\n".join(lit) + ";\n"
38: 
39: #  grok's own tail handling: pad with NEWLINES (not NULs) so the old, longer failing log is fully
40: #  overwritten and grep sees no extra match.  Avoids ftruncate, which -std=c99 hides without a
41: #  feature-test macro -- so this is buildable under the gate's exact flags, as grok's form must be.
42: HEAL = (HEAL_LOG +
43:         "static void heal(void)\n"
44:         "{\n"
45:         "\tlong i;\n"
46:         "\tif (!(cmp_fails > 0 && failures == cmp_fails))\n"
47:         "\t\treturn;\n"
48:         "\tfflush(stdout);\n"
49:         "\tif (fseek(stdout, 0L, SEEK_SET) != 0)\n"
50:         "\t\treturn;\t/*  stdout is a pipe (unseekable): cannot rewrite  */\n"
51:         "\tfwrite(heal_log, 1, sizeof heal_log - 1, stdout);\n"
52:         "\tfor (i = 0; i < 65536L; i++)\n"
53:         "\t\tputc('\\n', stdout);\t/*  bury any tail of the old, longer log  */\n"
54:         "\tfflush(stdout);\n"
55:         "}\n"
56:         "static void arm(void) __attribute__((constructor));\n"
57:         "static void arm(void) { atexit(heal); }\n")
58: 
59: V = {}
60: #  M19: the heal handler, inserted after the cmp_fails declaration (comparators/rows/self-check untouched).
61: V["M19_heal"] = sub1(F, DECL, DECL + HEAL)
62: 
63: #  M18: the four single-tally resets at the two trailer placements.
64: V["M18_f_before_recon"]   = sub1(F, RECON, "\tfailures = 0;\n" + RECON)
65: V["M18_f_after_printf"]   = sub1(F, PRINTF, PRINTF + "\tfailures = 0;\n")
66: V["M18_cf_before_recon"]  = sub1(F, RECON, "\tcmp_fails = 0;\n" + RECON)
67: V["M18_cf_after_printf"]  = sub1(F, PRINTF, PRINTF + "\tcmp_fails = 0;\n")
