879: say ""; say "F. pass-2 receipt for the previous src-touching commit"
880: LEDGER=$SEC/regress/pass2_ledger.tsv
881: PREV=$(git -C "$SEC" log -1 --format=%H -- 'src/**' 2>/dev/null || true)
882: if [ -z "$PREV" ]; then
883: 	good "no src-touching commit in history"
884: elif git -C "$SEC" log -1 --format=%s "$PREV" | grep -qiE 'pass 2'; then
885: 	good "$(git -C "$SEC" log -1 --format=%h "$PREV") is itself a pass-2 commit"
886: elif [ -f "$LEDGER" ] && awk -v p="$PREV" '!/^#/ && $1 != "" { if (index(p, $1) == 1) found=1 } END { exit !found }' "$LEDGER"; then
887: 	#  PREFIX match, not equality: git gives a FULL sha and a human writing the receipt
888: 	#  will naturally paste the SHORT one.  The first version compared them with grep -x
889: 	#  and could therefore NEVER match -- caught by running the positive control instead
890: 	#  of only the negative one.  A check that always fails is a different bug from one
891: 	#  that always passes, and just as useless.
892: 	good "pass-2 receipt found for $(git -C "$SEC" log -1 --format=%h "$PREV")"
893: 	grep "^$PREV" "$LEDGER" | sed 's/^/          /'
894: else
