61:     "ollama_deepseek.txt": "deepseek",
62:     "ollama_minimax.txt": "minimax",
63:     #  *** ADDED 2026-08-25. Without this entry a kimi SUBSTITUTE answer was
64:     #  INVISIBLE to section G -- an unread review BY CONSTRUCTION, in the very
65:     #  check that exists to catch unread reviews. The kimi CLI is 403-walled and
66:     #  `kimi-k3:cloud` is the live transport; both map to the same SEAT.
67:     "ollama_kimi.txt": "kimi",
68: }
