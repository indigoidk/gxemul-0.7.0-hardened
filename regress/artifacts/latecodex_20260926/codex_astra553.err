53:     "codex.txt": "codex",
54:     "agy.txt": "agy",
55:     "kimi.txt": "kimi",
56:     "grok.txt": "grok",
57:     "grok_fg.txt": "grok",           # a foreground re-fire of a truncated seat
58:     "grok_retry.txt": "grok",
59:     "codex_pass2.txt": "codex",
