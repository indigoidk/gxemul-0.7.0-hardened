  544:  *  the packing is visible here. Word 47 (0x8080) is a palindrome and would not
  867: 		} else {
  868: 			memset(&es, 0, sizeof(es));
  869: 			es.data_in = epay;  es.data_in_len = 200000;
  870: 			e.atapi_st = &es;  e.atapi_phase = PHASE_DATAIN;
  871: 			e.atapi_cmd_in_progress = 1;
  872: 			e.atapi_received = 131070;
  873: 			e.atapi_len = 2;
  874: 
  875: 			/*  the two chunk bytes the guest is about to drain...  */
  876: 			wdc_addtoinbuf(&e, 0x5a);
  877: 			wdc_addtoinbuf(&e, 0x5a);
  878: 			/*  ...and FIVE bytes behind them that atapi_len knows nothing
  879: 			    about, which is exactly what an interleaved data-port write
  880: 			    leaves in the ring.  */
  881: 			for (i = 0; i < 5; i++)
  882: 				wdc_addtoinbuf(&e, 0x77);
  883: 
  884: 			memset(ebuf, 0, sizeof(ebuf));
  885: 			dev_wdc_access(fake_cpu(), NULL, wd_data, ebuf, 2, MEM_READ, &e);
 4860: 	}
