FILE regress/artifacts/wdcidselfcheck_20260925/opus551_measured_f/analyze9.py.txt
1: #!/usr/bin/env python3
2: """#551f: score every (shape, device) TWICE and compare with the coordinator's run551f.out cell by cell.
3: 
4:   scorer M (mine, as analyze7): gate 2's wdc block with a MOCK check()/check_min() of lib.sh's semantics.
5:   scorer R (independent of the mock): the SAME extracted block run under gate 2's REAL lib.sh (sourced; gate_begin,
6:            then the block, then its own _fails counter), plus H and G as the literal greps gate_offline.sh runs.
7:   Both add the self-mutant lane (selfmutant.py's pristine/mutant logic; arms = device and device+self-mutant).
8: A shape ESCAPES on a device when the unedited #551f file reds it, the shape keeps gate 2 green there, and the
9: pristine device is green too."""
10: import io, os, re, subprocess
11: W = "/tmp/opus551f"
12: ART = "/mnt/c/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC/regress/artifacts/wdcidselfcheck_20260925"
13: NAMED = "geometry words carry their high byte"
14: G_TEXT = "SELFCHECK the comparator can still fail"
15: EMIT = "covered comparator failure"
16: os.makedirs(W + "/logdir", exist_ok=True)
17: io.open(W + "/gate_mock.sh", "w").write(
18:     'WDCLOG="$1"; _f=0\n'
19:     'check() { [ "$2" = "$3" ] || { echo "RED $1 got=$2 want=$3"; _f=$((_f+1)); }; }\n'
20:     'check_min() { [ "$2" -ge "$3" ] 2>/dev/null || { echo "RED $1 got=$2 min=$3"; _f=$((_f+1)); }; }\n'
21:     'note() { :; }\n. ' + W + '/gatewdc.inc\n')
22: io.open(W + "/gate_real.sh", "w").write(
23:     'export LOGDIR=' + W + '/logdir\nWDCLOG="$1"\n. ' + W + '/lib.sh > /dev/null 2>&1\n'
24:     'gate_begin "wdc-only" > /dev/null 2>&1\n. ' + W + '/gatewdc.inc > /dev/null 2>&1\necho "REALFAILS=$_fails CHECKS=$_checks"\n')
25: 
26: 
27: def rd(dev, h, ext):
28:     p = "%s/dev/%s/regress/%s.%s" % (W, dev, h, ext)
29:     return io.open(p, encoding="utf-8", errors="replace").read() if os.path.exists(p) else None
30: 
31: 
32: def summ(dev, h):
33:     if (rd(dev, h, "rc") or "").strip() == "BUILD_FAIL":
34:         return "BUILD_FAIL"
35:     t = rd(dev, h, "log") or ""
36:     m = re.search(r"^(\d+) rows, (\d+) failures", t, re.M)
37:     e = len([l for l in t.split("\n") if EMIT in l])
38:     return "%s/%s %s%s" % (m.group(1) if m else "?", m.group(2) if m else "?",
39:                            "PASS" if "WDC_IDENTIFY_PASS" in t else ("FAIL" if "WDC_IDENTIFY_FAIL" in t else "NOTOKEN"),
40:                            " r%d" % e if e else "")
41: 
42: 
43: def lane(h, dev):
44:     lane_dev = "selfmut" if dev == "pristine" else dev + "_sm"
45:     t, tm = rd(dev, h, "log"), rd(lane_dev, h, "log")
46:     named = [l for l in t.split("\n") if l.strip().startswith(("ok", "FAIL")) and NAMED in l and "@@SELFCHECK@@" not in l]
47:     if tm is not None and re.search(r"\b[A-Z0-9_]+_PASS\b", t) and len(named) == 1 and not named[0].strip().startswith("FAIL"):
48:         killed = [l for l in tm.split("\n") if l.strip().startswith("FAIL") and NAMED in l and "@@SELFCHECK@@" not in l]
49:         return "OK" if (re.search(r"\b[A-Z0-9_]+_FAIL\b", tm) and killed) else "FAIL"
50:     return "SETUP"
51: 
52: 
53: def gate(h, dev, real):
54:     if (rd(dev, h, "rc") or "").strip() == "BUILD_FAIL":
55:         return ["compile"]
56:     logp = "%s/dev/%s/regress/%s.log" % (W, dev, h)
57:     if real:
58:         out = subprocess.run(["bash", W + "/gate_real.sh", logp], capture_output=True, text=True).stdout
59:         m = re.search(r"REALFAILS=(\d+)", out)
60:         reds = ["real-lib fails=%s" % (m.group(1) if m else "?")] if (not m or m.group(1) != "0") else []
61:         src = "%s/h/%s.c" % (W, h)
62:         if subprocess.run(["grep", "-q", "@@SELFCHECK@@", src]).returncode != 0:
63:             reds.append("H")
64:         if subprocess.run(["grep", "-q", G_TEXT, logp]).returncode != 0:
65:             reds.append("G")
66:     else:
67:         out = subprocess.run(["bash", W + "/gate_mock.sh", logp], capture_output=True, text=True).stdout
68:         reds = [l[4:44] for l in out.split("\n") if l.startswith("RED ")]
69:         if "@@SELFCHECK@@" not in io.open("%s/h/%s.c" % (W, h), encoding="utf-8").read():
70:             reds.append("H")
71:         if G_TEXT not in rd(dev, h, "log"):
72:             reds.append("G")
73:     ln = lane(h, dev)
74:     if ln != "OK":
75:         reds.append("lane:" + ln)
76:     return reds
77: 
78: 
79: def cell(h, dev, real):
80:     return ("GREEN" if not gate(h, dev, real) else "red") + "(" + summ(dev, h) + ")"
81: 
82: 
83: #  the coordinator's table, parsed
84: theirs = {}
85: for line in io.open(ART + "/measured/run551f.out", encoding="utf-8").read().split("\n"):
86:     m = re.match(r"\s+(F\w*)\s+((?:GREEN|red)\([^)]*\))\s+((?:GREEN|red)\([^)]*\))\s+((?:GREEN|red)\([^)]*\))\s+((?:GREEN|red)\([^)]*\))", line)
87:     if m:
88:         theirs[m.group(1)] = [m.group(i) for i in (2, 3, 4, 5)]
89: DEVS = ("pristine", "dropold", "drqring", "w57hi")
90: shapes = sorted(f[:-2] for f in os.listdir(W + "/h") if f.endswith(".c") and f[:-2] not in ("F", "E", "ORIG"))
91: print("=== (1) %d shapes: my scorer (M), gate 2's real lib.sh (R), and the coordinator's cell (C), each device ===" % len(shapes))
92: mism, mr = [], []
93: for h in ["F"] + shapes:
94:     M = [cell(h, d, False) for d in DEVS]
95:     R = [cell(h, d, True) for d in DEVS]
96:     C = theirs.get(h)
97:     esc = [d for d in DEVS[1:] if not gate(h, "pristine", True) and not gate(h, d, True) and gate("F", d, True)] if h != "F" else []
98:     flag = ""
99:     if M != R:
100:         mr.append(h); flag += " M!=R"
101:     if C is not None and C != M:
102:         mism.append(h); flag += " C!=M"
103:     print("    %-24s %-26s %-26s %-26s %-26s esc=%-18s %s" % (h, M[0], M[1], M[2], M[3], ",".join(esc) or "-",
104:                                                              ("theirs: " + ("same" if C == M else "|".join(C))) if C else "(not in run551f)") + flag)
105: print("  cells where my mock and gate 2's real lib.sh disagree: %s" % (" ".join(mr) or "NONE"))
106: print("  shapes whose cells differ from run551f.out: %s" % (" ".join(mism) or "NONE"))
107: print("  shapes in run551f.out not rebuilt here: %s" % (" ".join(sorted(set(theirs) - set(["F"] + shapes))) or "NONE"))
108: 
109: print("\n=== (2) healthy and defect runs: #551f against #551e (whole log) ===")
110: for dev in sorted(os.listdir(W + "/dev")):
111:     f, e = rd(dev, "F", "log"), rd(dev, "E", "log")
112:     extra = [l for l in f.split("\n") if l not in e.split("\n")]
113:     print("    %-11s %s | rc F=%s E=%s" % (dev, "WHOLE-LOG IDENTICAL" if f == e else "+%d lines, all report lines: %s" % (
114:         len(extra), all(EMIT in l for l in extra)), rd(dev, "F", "rc").strip(), rd(dev, "E", "rc").strip()))
115: 
116: print("\n=== (3) the report line against every gate-2 pattern (would a report line satisfy or break a named check?) ===")
117: pats = re.findall(r"grep -c(F?) '([^']+)' \"\$WDCLOG\"", io.open(W + "/gatewdc.inc", encoding="utf-8").read())
118: rep = "  FAIL  covered comparator failure -- 3 failures so far"
119: hits = []
120: for fixed, p in pats:
121:     r = subprocess.run(["grep", "-c" + ("F" if fixed else ""), p], input=rep + "\n", capture_output=True, text=True).stdout.strip()
122:     if r != "0":
123:         hits.append(p)
124: print("    %d named-row/text patterns checked; patterns the report line matches: %s" % (len(pats), hits or "NONE"))
125: print("    probe names starting with '@': chk(\"@@SELFCHECK@@/chk\") and row_cmp(\"@@SELFCHECK@@/row\") only -- %s" % (
126:     subprocess.run(["bash", "-c", "grep -oE '\\b(chk|row|row_cmp)\\(\"@[^\"]*\"' " + W + "/h/F.c | sort | uniq -c | tr '\\n' ' '"],
127:                    capture_output=True, text=True).stdout.strip()))
128: print("ANALYZE9_DONE")

