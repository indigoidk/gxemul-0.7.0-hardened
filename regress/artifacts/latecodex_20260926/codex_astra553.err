  204: #  The refused value, captured whole: "0x8" can match only 0x8, never 0x80 (the digits run to " is").
  410: # ---------------------------------------------------------------- sessions
  411: PROG_C = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("lw", "t4", 16, None), ("lw", "t5", 0, None),
  412:           ("sw", "t6", 0, None), ("sw", "t7", 16, None),               # PORT=1 (X1), X1 = 123
  413:           ("sw", "s1", 0, None), ("sw", "t7", 16, None),               # PORT=2 (Y1), Y1 = 123
  414:           ("sw", "s0", 0, None), ("sw", "s1", 16, None),               # PORT=0 (COMMAND), DATA=2: GET_RESOLUTION
  415:           ("sw", "t6", 0, None), ("lw", "s2", 16, None),               # read X1
  416:           ("sw", "s1", 0, None), ("lw", "s3", 16, None)]               # read Y1
  417: REGS_C = [("t0", FBCTRL), ("t1", 5), ("t3", 0x2a), ("t6", 1), ("t7", 123), ("s0", 0), ("s1", 2),
  418:           ("t4", 0xdead), ("t5", 0xdead), ("s2", 0xdead), ("s3", 0xdead)]
  419: 
  420: #  A: selector p written at a rotating width and read back through PORT into s<k> (poisoned 0xdead first, so a
  421: #  read that never ran cannot pass -- selector 0 would otherwise match a register's reset value); DATA value 0x11*p
  422: #  for p >= 1, read back through DATA INTO THE SELECTOR REGISTER, which holds p before the read, never 0x11*p.
  423: #  Port 0 is COMMAND: written with NOP (0, from zr) only.
  424: ACC = [(0, "sw"), (1, "sb"), (2, "sh"), (3, "sw"), (4, "sd"), (5, "sb"), (6, "sh"), (7, "sd")]
  425: SEL_REG = ["t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8"]           # the selector values
  426: VAL_REG = ["zr", "a0", "a1", "a2", "a3", "v0", "v1", "t9"]           # the DATA values (port 0 gets zr = NOP)
  427: PORT_RB = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7"]           # PORT read-backs
  428: PROG_A, REGS_A = [], [("t0", FBCTRL)]
  429: for k, (p, w) in enumerate(ACC):
  430:     REGS_A.append((SEL_REG[k], p))
  431:     REGS_A.append((PORT_RB[k], 0xdead))
  432:     if k:
  433:         REGS_A.append((VAL_REG[k], 0x11 * p))
  434:     PROG_A.append((w, SEL_REG[k], 0, None))                            # PORT = p at width w
  435:     PROG_A.append(("lw", PORT_RB[k], 0, None))                         # read PORT
  436:     PROG_A.append(("sw", VAL_REG[k], 16, None))                        # DATA = 0x11*p (NOP for port 0)
  437: #  the DATA read-backs, one per port 1..7: re-select p, read DATA into the selector register
  438: for k, (p, w) in enumerate(ACC):
  439:     if k:
  440:         PROG_A.append(("sw", SEL_REG[k], 0, None))
  441:         PROG_A.append(("lw", SEL_REG[k], 16, None))
  442: READS_A = PORT_RB + SEL_REG[1:]
  443: 
  444: #  P: previous selector 5, then nine refusals with read-backs (the FIRST is 8), two count-only refusals, and the
  445: #  twelfth after PORT=7.  The count is sampled after the twelfth, so a latch re-armed every N refusals, N <= 11, reds.
  446: REFUSE = [("sw", "t2", 8, "8 (sw)"), ("sw", "t1", 9, "9 (sw)"), ("sw", "t3", 16, "16 (sw)"),
  447:           ("sd", "t4", 0x200000000, "0x200000000 (sd)"), ("sd", "t5", 0x100000003, "0x100000003 (sd)"),
  448:           ("sd", "t6", M64, "all-ones (sd)"), ("sw", "t7", 0xffffffff, "all-ones (sw)"),
  449:           ("sb", "t8", 0xff, "0xff (sb)"), ("sh", "t9", 0x100, "0x100 (sh)")]
  450: #  16 by sb and by sh, each read back into a register whose own value (0x200000000, 0x100000003) is spent by then and
  451: #  can never read as 5 -- so an ignored read, or a session that died, reds the row too.
  452: EXTRA = [("sb", "t3", "t4", "16 (sb)"), ("sh", "t3", "t5", "16 (sh)")]
  453: READ_P = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "v0"]
  454: PROG_P = [("sw", "a0", 0, None), ("sw", "a1", 16, None)]
  455: REGS_P = [("t0", FBCTRL), ("a0", 5), ("a1", 0x2a), ("a2", 7)]
  456: for k, (w, r, v, _n) in enumerate(REFUSE):
  457:     REGS_P.append((r, v))
  458:     if k:
  459:         PROG_P.append(("sw", "a0", 0, None))                   # a fresh PORT=5 before every later refusal
  460:     PROG_P.append((w, r, 0, "r%d" % k))
  461:     PROG_P.append(("lw", READ_P[k], 0, None))
  462: for w, r, rb, _n in EXTRA:
  463:     PROG_P += [("sw", "a0", 0, None), (w, r, 0, None), ("lw", rb, 0, None)]
  464: PROG_P += [("sw", "a2", 0, None), ("sw", "t1", 0, "r11"), ("lw", "v1", 0, None)]
  465: READS_P = READ_P + [e[2] for e in EXTRA] + ["v1"]
  466: 
  467: #  R: between two refusals, a PORT read, a DATA write, a NOP command, a DATA READ and a GET_RESOLUTION -- every kind of
  468: #  traffic a guest makes except SET_RESOLUTION -- in its own session.
