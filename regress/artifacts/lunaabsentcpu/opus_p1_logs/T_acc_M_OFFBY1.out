BINARY=/tmp/gxopus_luna_BIN_M_OFFBY1   (-n 2)
ACCEPT_ROW=two cpus       RESULT=OK    machine reports 2 running cpus
ACCEPT_ROW=encoding       RESULT=OK    st=True  vector br=True
ACCEPT_ROW=cpu1 setup     RESULT=OK    VBR=0x00040000 PSR=0x80000000 (IND clear) pc=0x00030100
ACCEPT_ROW=mask1 land     RESULT=OK    MASK1 readback 0x00040000 (0x04000000>>8; a DECLINED store reads 0)
ACCEPT_ROW=survive        RESULT=OK    the two stores do not kill the host on 2 cpus
ACCEPT_ROW=cpu1 deliver   RESULT=OK    cpu1 pc=0x00040008 (want vector 0x00040008)  SXIP=0x00030102  EPSR 0x00000000->0x80000000
ACCEPT_ROW=cpu1 shadow    RESULT=OK    EPSR must hold the pre-exception PSR and PSR must now have IND set (PSR=0x8000000b)
ACCEPT_ROW=cpu0 parked    RESULT=OK    cpu0 pc=0x00030000 -- it was cpu 1, not cpu 0, that took the vector
ACCEPT_RESULT=8/8
ACCEPT_VERDICT=PASS
ACCEPT_WALL=0.4s
