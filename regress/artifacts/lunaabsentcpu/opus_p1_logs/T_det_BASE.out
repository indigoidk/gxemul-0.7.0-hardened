BINARY=/tmp/gxopus_luna_BIN_BASE
LUNAABS_ROW=encoding       RESULT=OK        planted words disassemble as expected
LUNAABS_ROW=live           RESULT=OK        RAM readback 0x12345678
LUNAABS_ROW=devsig         RESULT=OK        MASK0 readback 0x00fc0000 (the handler's own >>8; RAM cannot produce it)
LUNAABS_ROW=slot0          RESULT=OK        SOFT_INT0 readback 0x00000001 (read clears it)
LUNAABS_ROW=mask1          RESULT=OK        MASK1 readback 0x00fc0000 (stored as-is; a decline => 0)
LUNAABS_ROW=soft1          RESULT=HALT      HOST DIED -- INTERRUPT_ASSERT through a NULL pointer
SYMPTOM=NULL_CALLBACK_ON_ABSENT_CPU
LUNA_ABSENTCPU_WITNESS=PRE_FIX_SYMPTOM
LUNAABS_RESULT=5/6
LUNAABS_DIEDAT=soft1
