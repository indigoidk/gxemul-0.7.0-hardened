BINARY=/tmp/gxopus_luna_BIN_FIXD
LUNAABS_ROW=encoding       RESULT=OK        planted words disassemble as expected
LUNAABS_ROW=live           RESULT=OK        RAM readback 0x12345678
LUNAABS_ROW=devsig         RESULT=OK        MASK0 readback 0x00fc0000 (the handler's own >>8; RAM cannot produce it)
LUNAABS_ROW=slot0          RESULT=OK        SOFT_INT0 readback 0x00000001 (read clears it)
LUNAABS_ROW=mask1          RESULT=FAIL      MASK1 readback 0x00000000 (stored as-is; a decline => 0)
LUNAABS_ROW=soft1          RESULT=FAIL      SOFT_INT1 readback 0x00000000
LUNAABS_ROW=soft1x2        RESULT=FAIL      second SOFT_INT1 store+read survives
LUNAABS_ROW=mask1 disarm   RESULT=OK        MASK1 readback after disarm 0x00000000
LUNAABS_ROW=mask2          RESULT=FAIL      MASK2 readback 0x00000000 (stored as-is; a decline => 0)
LUNAABS_ROW=soft2          RESULT=FAIL      SOFT_INT2 readback 0x00000000
LUNAABS_ROW=soft2x2        RESULT=FAIL      second SOFT_INT2 store+read survives
LUNAABS_ROW=mask2 disarm   RESULT=OK        MASK2 readback after disarm 0x00000000
LUNAABS_ROW=mask3          RESULT=FAIL      MASK3 readback 0x00000000 (stored as-is; a decline => 0)
LUNAABS_ROW=soft3          RESULT=FAIL      SOFT_INT3 readback 0x00000000
LUNAABS_ROW=soft3x2        RESULT=FAIL      second SOFT_INT3 store+read survives
LUNAABS_ROW=mask3 disarm   RESULT=OK        MASK3 readback after disarm 0x00000000
LUNAABS_ROW=live2          RESULT=OK        RAM readback 0x0badf00d
LUNAABS_ROW=cpu0 setup     RESULT=OK        VBR=0x00040000 PSR=0x80000000 (IND must be clear)
LUNAABS_ROW=slot0 deliver  RESULT=OK        cpu0 pc=0x00040008 (want vector 0x00040008)  SXIP=0x00030002 EPSR=0x80000000 PSR=0x8000000b
LUNAABS_ROW=slot0 shadow   RESULT=OK        EPSR must hold the pre-exception PSR and PSR must now have IND set
LUNA_ABSENTCPU_WITNESS=FAIL
LUNAABS_RESULT=11/20
LUNAABS_FAILED=mask1;soft1;soft1x2;mask2;soft2;soft2x2;mask3;soft3;soft3x2
PROBE_WALL=1.7s
