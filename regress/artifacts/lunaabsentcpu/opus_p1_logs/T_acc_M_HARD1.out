BINARY=/tmp/gxopus_luna_BIN_M_HARD1   (-n 2)
ACCEPT_ROW=two cpus       RESULT=OK    machine reports 2 running cpus
ACCEPT_ROW=encoding       RESULT=OK    st=True  vector br=True
ACCEPT_ROW=cpu1 setup     RESULT=OK    VBR=0x00040000 PSR=0x80000000 (IND clear) pc=0x00030100
ACCEPT_ROW=mask1 land     RESULT=OK    MASK1 readback 0x00040000 (0x04000000>>8; a DECLINED store reads 0)
ACCEPT_ROW=survive        RESULT=OK    the two stores do not kill the host on 2 cpus
ACCEPT_ROW=cpu1 deliver   RESULT=FAIL  cpu 1 never entered its interrupt vector 0x00040008 in 40s -- NOT delivered
ACCEPT_RESULT=5/6
ACCEPT_VERDICT=FAIL cpu1 deliver
ACCEPT_WALL=40.4s
