		break;

	case 2:	switch (crn) {
		case 0:	if (l_bit)
				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc2_pmn0;
			else
				cpu->cd.arm.xsc2_pmn0 = cpu->cd.arm.r[rd];
			break;
