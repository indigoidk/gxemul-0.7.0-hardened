         (0xEE040610, 0xEE001610, 0xEE147610, NOP), 0),
    ):
        probe = Session(BIN)
        try:
            setup = [
                "r0=0x00000000",
                f"r1=0x{S1:08x}",
                "r7=0xdeadbe07",
            ]
            setup += [
                f"put w 0x{CODE + 4*i:08x}, 0x{word:08x}"
                for i, word in enumerate(words)
            ]
            setup.append(f"pc=0x{CODE:08x}")
            ready = all(probe.send(cmd) for cmd in setup)
            for _ in words[:-2]:
                if ready:
                    ready = probe.send("step 1", timeout=10)
            before = probe.get_regs().get(7) if ready else None
            if not ready or before is None:
                got = "HOST-DIED" if probe.dead else "SETUP-UNOBSERVED"
                ok = None
            elif before != 0xDEADBE07:
                got, ok = "BAD-POISON", False
            elif not probe.send("step 1", timeout=10):
                got = "HOST-DIED" if probe.dead else "TIMEOUT"
                ok = False
            else:
                got = probe.get_regs().get(7)
                ok = None if got is None else got == want
            report_row(tag, desc, got, want, ok)
        finally:
            probe.close()

    # -------------------------------------------------------------
    # ARM RD15: Destination PC (r15)
    # -------------------------------------------------------------
```

