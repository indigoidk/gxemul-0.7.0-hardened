class_src, report_src, snapshots_src = sys.stdin.read().split(\"\\n===PART===\\n\")
class Clock:
    def __init__(self): self.now = 0
    def monotonic(self): return self.now
    def sleep(self, dt): self.now += dt
clock = Clock()
writes = []
fake_os = types.SimpleNamespace(write=lambda fd, data: writes.append(data))
ns = {\"os\": fake_os, \"time\": clock, \"re\": re}
exec(class_src, ns)
Session = ns[\"Session\"]
def session(buf=\"old\\nGXemul> \", chunks=()):
    s = Session.__new__(Session)
    s.buf, s.dead, s.ready, s.fd = buf, False, True, 10
    pending = iter(chunks)
    def rd(t):
        clock.now += t
        s.buf += next(pending, \"\")
    s.rd = rd
    return s
s = session()
assert not s.send(\"step 1\", timeout=.25)
n = len(writes)
assert not s.send(\"reg\", timeout=.1) and len(writes) == n
s = session(chunks=(\"\", \"step 1\\r\\n\", \"\\r\\nGXemul> \"))
assert s.send(\"step 1\", timeout=.5) and s.ready
s = session(chunks=(\"continue\\r\\n\", \"\", \"\", \"\"))
assert not s.send(\"continue\", timeout=.25)
pending = iter((\"interrupt\\r\\nGXemul> \",))
def rd_interrupt(t):
    clock.now += t
    s.buf += next(pending, \"\")
s.rd = rd_interrupt
assert s.interrupt(.5) and s.ready
print(\"Prompt checks: stale prompt rejected, timeout prevents commands, interrupt resynchronizes\")

s = session()
s.pid = 123
def quit_send(cmd, timeout):
    assert cmd == \"quit\"
    s.dead = True
    return False
s.send = quit_send
fake_os.close = lambda fd: None
fake_os.WNOHANG = 1
fake_os.waitpid = lambda pid, flags: (pid, 0)
fake_os.WIFEXITED = lambda st: True
fake_os.WEXITSTATUS = lambda st: 0
fake_os.WIFSIGNALED = lambda st: False
fake_os.WTERMSIG = lambda st: 0
assert s.close()[0] == 0 and s.dead is False
print(\"Cleanup check: quitting a live child does not masquerade as guest death\")

def check_snapshots(stopped, missing=False, void=False):
    dest = {0x08:9, 0x10:4, 0x18:5, 0x20:6, 0x24:10}
    wants = {0x08:0, 0x10:0xA500005A, 0x18:0, 0x20:0x5AA5F00D, 0x24:0x5AA5F00D}
    pre = {off:0xDEADBE00+rd for off,rd in dest.items() if stopped is None or off <= stopped}
    post = {off:{rd:wants[off]} for off,rd in dest.items() if stopped is None or off < stopped}
    post[0x04] = {8:0x11112222}
    if stopped is None: post[0x28] = {0:0x5A}
    if missing: post[0x10] = {}
    if void: pre[0x20] = wants[0x20]
    env = dict(dest_map=dest, expect_map=wants, pre_snapshots=pre, post_snapshots=post,
               d_died_at=stopped, d_stop_reason=\"HOST-DIED\", buf_d=\"\", rows=[],
               S1=0xA500005A, S2=0x5AA5F00D, TRR0_SEED=0x11112222, MARKER=0x5A,
               hexs=lambda v:\"-\" if v is None else str(v))
    with contextlib.redirect_stdout(io.StringIO()):
        exec(report_src, env)
        exec(snapshots_src, env)
    return {tag:ok for tag,ok,*_ in env[\"rows\"]}
r = check_snapshots(0x24)
assert all(r[tag] is True for tag in (\"D_RESET\",\"D_S1\",\"D_ZERO\",\"D_S2\"))
assert r[\"D_SURVIVE\"] is False and r[\"D_OP2\"] is None and r[\"D_MARKER\"] is None
r = check_snapshots(0x08)
assert r[\"P2_VACUITY\"] is None and r[\"D_RESET\"] is None and r[\"D_S1\"] is None
r = check_snapshots(None, missing=True)
assert r[\"D_S1\"] is None and r[\"D_S2\"] is True
r = check_snapshots(None, void=True)
assert r[\"D_S2\"] is False and r[\"D_S1\"] is True and r[\"P2_VACUITY\"] is False
print(\"Snapshot checks: earlier observations retained, missing evidence BLOCKED, vacuity localized\")
