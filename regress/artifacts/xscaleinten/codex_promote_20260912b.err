# P2 Vacuity Guard Check
vacuity_violated = False
for off, rd in dest_map.items():
    val = pre_snapshots.get(off)
    if val is not None and val == expect_map[off]:
        vacuity_violated = True

missing_pre = [off for off in dest_map if pre_snapshots.get(off) is None]
p2_ok = False if vacuity_violated else (None if missing_pre else True)
report_row(\"P2_VACUITY\", \"D: each pre-read value differs from want\",
           \"VOID\" if vacuity_violated else (
               \"MISSING-PRE\" if missing_pre else \"DIFFERENT\"),
           \"DIFFERENT\", p2_ok)

# A2 Check: no generic uninstalled coproc message
a2_bad = \"[ TODO: arm_mcr_mrc:\" in buf_d and \"cp_num=6\" in buf_d
report_row(\"A2_INSTALLED\", \"CP6 is installed in IQ80321\",
           \"ABSENT\" if not a2_bad else \"FOUND\",
           \"ABSENT\",
           not a2_bad)

# Check TRR0 liveness (stepped at 0x04)
r8_trr0 = post_snapshots.get(0x04, {}).get(8)
report_row(\"D_TRR0\", \"D: trr0 CP6 liveness\", r8_trr0, TRR0_SEED,
           None if r8_trr0 is None else r8_trr0 == TRR0_SEED)

# Check TODO text absence in D
d_todo = \"TODO: XScale read from inten?\" in buf_d
report_row(\"D_TODO_ABS\", \"D: TODO read diagnostic absent\",
           \"ABSENT\" if not d_todo else \"PRESENT\",
           \"ABSENT\",
           not d_todo)

d_cause = (
    f\"{d_stop_reason}@0x{d_died_at:02x}\"
    if d_died_at is not None else \"MISSING-SNAPSHOT\"
)
report_row(\"D_SURVIVE\", \"D: ran to marker without exit(1)\",
           d_cause if d_died_at is not None else \"SURVIVED\",
           \"SURVIVED\", d_died_at is None)
for tag, desc, off, rd, want in (
    (\"D_RESET\", \"D: inten reset val (rd=9)\", 0x08, 9, 0),
    (\"D_S1\", \"D: inten read S1 (rd=4)\", 0x10, 4, S1),
    (\"D_ZERO\", \"D: inten read 0 (rd=5)\", 0x18, 5, 0),
    (\"D_S2\", \"D: inten read S2 (rd=6)\", 0x20, 6, S2),
    (\"D_OP2\", \"D: inten read opcode2=1 (rd=10)\", 0x24, 10, S2),
):
    before = pre_snapshots.get(off)
    after = post_snapshots.get(off, {}).get(rd)
    if after is None:
        report_row(tag, desc, d_cause, want, None)
    elif before is None:
        report_row(tag, desc, \"MISSING-PRE\", want, None)
    elif before == want:
        report_row(tag, desc, \"VOID\", want, False)
    else:
        report_row(tag, desc, after, want, after == want)
marker = post_snapshots.get(0x28, {}).get(0)
report_row(\"D_MARKER\", \"D: marker reached (r0=0x5a)\",
           d_cause if marker is None else marker, MARKER,
           None if marker is None else marker == MARKER)

