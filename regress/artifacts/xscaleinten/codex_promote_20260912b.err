OLD:
```python
    def wait_prompt(self, timeout=30):
        t0 = time.time()
        while time.time() - t0 < timeout:
            if self.dead:
                return False
            self.rd(0.1)
            if self.buf.rstrip().endswith("GXemul>"):
                return True
        return False

    def send(self, cmd_str, timeout=30):
        if self.dead:
            return False
        b = (cmd_str + "\n").encode("latin1")
        try:
            os.write(self.fd, b)
        except OSError:
            self.dead = True
            return False
        return self.wait_prompt(timeout)
```

NEW:
```python
    def wait_prompt(self, timeout=30, mark=None):
        if mark is None:
            mark = len(self.buf)
        self.ready = False
        deadline = time.monotonic() + timeout
        while not self.dead:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return False
            self.rd(min(0.1, remaining))
            if self.dead:
                return False
            if self.buf[mark:].rstrip().endswith("GXemul>"):
                self.ready = True
                return True
        return False

    def send(self, cmd_str, timeout=30):
        if self.dead or not self.ready:
            return False
        mark = len(self.buf)
        self.ready = False
        b = (cmd_str + "\n").encode("latin1")
        try:
            os.write(self.fd, b)
        except OSError:
            self.dead = True
            return False
        return self.wait_prompt(timeout, mark=mark)

    def interrupt(self, timeout=2):
        if self.dead:
            return False
        mark = len(self.buf)
        self.ready = False
        try:
            os.write(self.fd, b"\x03")
        except OSError:
            self.dead = True
            return False
        return self.wait_prompt(timeout, mark=mark)
```

Cleanup needs an escape from a still-running child. Preserve the pre-cleanup death flag: EOF caused by our own `quit` must not make the expected-death controls pass.

OLD:
```python
    def close(self):
        try:
            os.write(self.fd, b"quit\n")
            time.sleep(0.1)
        except OSError:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass
        try:
            _, st = os.waitpid(self.pid, 0)
            code = os.WEXITSTATUS(st) if os.WIFEXITED(st) else None
            sig = os.WTERMSIG(st) if os.WIFSIGNALED(st) else None
        except Exception:
            code, sig = None, None
        return code, sig, self.buf
```

NEW:
```python
    def close(self):
        dead_before_close = self.dead
        if not self.dead and not self.ready:
            self.interrupt(timeout=2)
        if not self.dead and self.ready:
            self.send("quit", timeout=1)
        try:
            os.close(self.fd)
        except OSError:
            pass
        deadline = time.monotonic() + 2
        st = None
        while st is None:
            try:
                pid, status = os.waitpid(self.pid, os.WNOHANG)
            except ChildProcessError:
                break
            if pid == self.pid:
                st = status
                break
            if time.monotonic() >= deadline:
                try:
                    os.kill(self.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                try:
                    _, st = os.waitpid(self.pid, 0)
                except ChildProcessError:
                    pass
                break
            time.sleep(0.02)
        code = os.WEXITSTATUS(st) if st is not None and os.WIFEXITED(st) else None
        sig = os.WTERMSIG(st) if st is not None and os.WIFSIGNALED(st) else None
        self.dead = dead_before_close
        return code, sig, self.buf
```

