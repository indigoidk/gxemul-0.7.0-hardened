440: #  ALL FOUR EXITS USE say(), and the first version of this change got that wrong
441: #  in the most embarrassing possible direction: only the HEALTHY path was
442: #  converted, so SEATS.txt recorded every seat that answered and silently dropped
443: #  every seat that did not.  A file that keeps the good news and loses the bad is
444: #  worse than no file, because it reads as a complete roster.  Caught by testing
445: #  the change against a fake grok.txt of exactly the 523 bytes the real one wrote.
446: check() {   # name file
447:     local name="$1" f="$2" sz vibe head
448:     if [ ! -s "$f" ]; then say "  $name: MISSING/EMPTY"; return; fi
449:     sz=$(wc -c < "$f")
450:     #  Error sentinels are only meaningful at the START of the file or as our
451:     #  own OLLAMA_SEAT_ERROR marker -- NOT anywhere in the text, or a review
452:     #  that merely quotes "was retired" or "usage:" gets mis-flagged (it did,
453:     #  on the first live run). Anchor to the first 400 bytes.
454:     head=$(head -c 400 "$f")
455:     if printf '%s' "$head" | grep -qiE "OLLAMA_SEAT_ERROR|error: model|was retired|Argument list too long"; then
456:         say "  $name: ERROR (${sz}b) -- $(printf '%s' "$head" | grep -ioE 'OLLAMA_SEAT_ERROR.*|was retired[^"]*|Argument list too long' | head -1)"
457:         return
458:     fi
459:     if [ "$sz" -lt 800 ]; then say "  $name: SUSPECT (only ${sz}b -- may be thinking-only or a tool-call misfire)"; return; fi
460:     #  *** THE ECHO TEST, WHICH THIS FUNCTION'S OWN COMMENT PROMISED SINCE THE FIRST
461:     #  VERSION AND WHICH DID NOT EXIST.  Measured 2026-08-17: codex printed its banner,
462:     #  echoed the 9,375-byte brief, then ended with "ERROR: You've hit your usage limit
463:     #  ... try again at Aug 22nd".  It produced NO REVIEW and was scored "10063b
464:     #  answered".  BSZ was computed at the top of the script for exactly this test and
465:     #  then never used -- a documented check that cannot fail, which is worse than no
466:     #  check because it reassures.
467:     #
468:     #  The verdict-token heuristic below could not save it either, and the reason is
469:     #  worth keeping: THE ECHOED BRIEF CONTAINS THE TOKENS, because a brief that tells
470:     #  seats to open with "VERDICT:" necessarily has the word "VERDICT" in it.  Every
471:     #  future brief will too.  So payload size, not content, is the discriminator.
472:     #  *** ONLY APPLY THE PAYLOAD TEST TO A FILE THAT ACTUALLY CONTAINS THE BRIEF. ***
473:     #  The first version of this test did not check, and it was WORSE THAN THE BUG IT FIXED.
474:     #  `sz - BSZ` is negative for any seat that does not echo -- grok reads the brief from a
475:     #  file, the Ollama seats return only their answer -- so every real answer SHORTER than
476:     #  the brief was declared ECHO-ONLY. Measured on the very next panel: four genuine
477:     #  answers mislabelled, deepseek's and glm's verdicts among them. One false negative
478:     #  traded for four false positives.
479:     #
480:     #  It survived four negative controls because ALL FOUR USED THE SAME LARGE BRIEF, whose
481:     #  real answers all happened to exceed it. A control suite that varies only the seat and
482:     #  never the brief cannot see a bug that lives in the brief-to-answer RATIO.
483:     #
484:     #  The discriminator is possession, not arithmetic: an echoing seat reproduces the brief
485:     #  verbatim, so look for a distinctive line from it.
486:     local marker echoed=""
487:     marker=$(awk 'length($0) > 55 && $0 !~ /^[#*|> -]/ { print; exit }' "$BRIEF" 2>/dev/null)
488:     if [ -n "$marker" ] && grep -qF "$marker" "$f" 2>/dev/null; then
489:         echoed="yes"
490:     fi
491:     local payload=$((sz - BSZ))
492:     if [ -n "$echoed" ] && [ "$payload" -lt 800 ]; then
493:         say "  $name: ECHO-ONLY (${sz}b = brief ${BSZ}b + ${payload}b) -- NOT A REVIEW"
494:         #  Name the wall if the file says what it was, so the operator does not have to
495:         #  guess whether this was a quota, an auth failure or a crash.
496:         local why
497:         why=$(grep -ioE "You've hit your usage limit[^.]*|usage limit[^.]*|quota[^.]*|rate.?limit[^.]*|reached your [a-z0-9 ]*limit" "$f" | head -1)
498:         [ -n "$why" ] && say "        wall: $why"
499:         return
500:     fi
501:     #  *** A SEAT CAN ANSWER AT LENGTH AND THEN HIT THE WALL, and until 2026-08-23
502:     #  nothing here saw that. ***  The branch above only catches the ECHO-ONLY shape --
503:     #  brief echoed, tiny payload, the codex signature.  Kimi walled with **36 KB of
504:     #  real content and 98% novel lines**, ending mid-sentence with a 403 usage-limit
505:     #  notice.  Payload huge, echo absent: invisible to every test above, and the panel

