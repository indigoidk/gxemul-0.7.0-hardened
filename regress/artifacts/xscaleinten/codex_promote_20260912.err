  232: #   zero flags/r0/r1 -- counter 0, the one input where #347's `(r1 == 0 ||`
  233: #       disjunct is load-bearing: owes r0 += 0x20, r1 = 0xffffffe0, flags 0x8.
  234: #   quiet/fires   -- #349: the marker channel. The old `still fold` control
  235: #       asserted the MISSING flags (seeded N surviving) and was retired in the
  236: #       same change that fixed them, as its own comment required; the marker
  237: #       is its replacement as the only fold-fired detector, since post-#348
  238: #       the genuine sequence is architecturally transparent.
  239: for v in "A cclean2 fold r0" "A cclean2 fold r1" "A cclean2 flags" \
  240:          "A cclean2 base r5" "A cclean2 base r1" "A cclean2 base r0" \
  241:          "A cclean2 cnt r6" "A cclean2 cnt r1" "A cclean2 tail flags" \
  242:          "A cclean2 tail r0" "A cclean2 tail r1" "A cclean2 tail V" \
  243:          "A cclean2 zero flags" "A cclean2 zero r0" "A cclean2 zero r1" \
  244:          "A cclean2 quiet" "A cclean2 fires" "A cclean2 fires ctrl"; do
  245:     n=$(count "$LOG" "^$v  .*ok$")
  246:     check "  row: $v" "$n" 1
  247: done
  248: 
  249: for v in "sbcs eq C=0 C" "sbcs eq0 C=0 C" "sbcs eqmax C=0 C" "rscs eq C=0 C"; do
  250:     n=$(count "$LOG" "^$v  .*ok$")
  251:     check "  disc: $v" "$n" 1
  252: done
  253: 
  254: # The value rows on those same four: the arithmetic was ALWAYS right, and a
  255: # "fix" that repaired the flag by breaking the result must not pass.
  256: for v in "sbcs eq C=0 rd" "sbcs eq0 C=0 rd" "sbcs eqmax C=0 rd" "rscs eq C=0 rd"; do
  257:     n=$(count "$LOG" "^$v  .*ok$")
  258:     check "  value intact: $v" "$n" 1
  259: done
  260: 
  261: # The instructions the fix must NOT disturb.
  262: for v in "subs eq C" "subs lt C" "subs gt C" "subs zerominus C" \
  263:          "rsbs gt C" "rsbs lt C" \
  264:          "cmp eq NZCV" "cmp lt NZCV" "cmp gt NZCV" \
  265:          "subs rn=pc rd" "subs rn=pc C" \
  266:          "adds carry-out C" "adds no-carry C" \
  267:          "adcs carry-out C" "adcs no-carry C" \
  268:          "sbcs eq C=1 C" "sbcs gt C=0 C" "sbcs lt C=0 C" "sbcs lt C=1 C" \
  269:          "rscs gt C=0 C" "rscs lt C=0 C"; do
  270:     n=$(count "$LOG" "^$v  .*ok$")
  271:     check "  pin: $v" "$n" 1
  272: done
  273: 
  274: # #313: ADC was the ONE opcode listed in the outer V-update #if that matched
  275: # neither inner formula, so ADCS could only ever clear V. The paired adds rows
  276: # are what make these a statement about ADC rather than about V generally --
  277: # the identical overflow through ADDS was already correct.
  278: for v in "adcs V pos-ovf" "adcs V pos-ovf2" "adcs V neg-ovf"; do
  279:     n=$(count "$LOG" "^$v  .*ok$")
  280:     check "  disc: $v" "$n" 1
  281: done
  282: for v in "adcs V none" "adds V pos-ovf" "adds V none" "sbcs V ovf"; do
  283:     n=$(count "$LOG" "^$v  .*ok$")
  284:     check "  pin: $v" "$n" 1
  285: done
  286: 
  287: # #312's rows. The handler-ran row is the witness that the exception was
  288: # actually TAKEN; mode and lr prove it was entered as an exception rather than
  289: # branched into.
  290: #
  291: # The page-end row is not redundant with the first: X(und) reconstructs the
  292: # faulting PC with a hard-coded 4KB mask, and at page offset 0 both halves of
  293: # that arithmetic are zero, so only a row at the last slot of a page can catch
  294: # a wrong mask.
  295: for v in "udf handler ran" "udf UND32 mode" "udf lr=pc+4" \
  296:          "udf gdb-form handler ran" "udf gdb-form UND32 mode" \
  297:          "udf gdb-form lr=pc+4" \
  298:          "udf page-end handler ran" "udf page-end UND32 mode" \
  299:          "udf page-end lr=pc+4" "udf cond-failed nop"; do
  300:     n=$(count "$LOG" "^$v  .*ok$")
  301:     check "  undefined: $v" "$n" 1
  302: done
  303: 
  304: # ---- #319/#320/#321: rotations the decoder rejected, and MVNS's carry -------
  305: # Every row asserts a VALUE. `uxtah ROR 24` is the discriminating one of the
  306: # first group: a byte extract is the same under a rotate as under a shift at
  307: # every encodable amount, so the uxtab rows cannot tell those apart, while the
  308: # halfword form at 24 wraps rm's low byte into bits 15:8.
  309: #
  310: # `rotc zero C` is the row that never halted -- the old guard exempted an imm8
  311: # of zero, so that case shipped with the wrong carry rather than stopping, which
  312: # is why this group is a wrong-answer fix and not only a halt fix.
  313: #
  314: # All four MVNS bands are present because two of them would pass by coincidence:
  315: # the decoder rewrites `mvn #imm` to `mov #~imm`, and with S set the carry was
  316: # then read off the COMPLEMENT.
  317: for v in "uxtab ROR 8" "uxtab ROR 16" "uxtab ROR 24" \
  318:          "uxtah ROR 8" "uxtah ROR 16" "uxtah ROR 24" \
  319:          "rotc movs val" "rotc movs C" "rotc zero C" "rotc ands C" \
  320:          "rotc orrs val" "rotc bics val" "rotc tst C" \
  321:          "mvns rot0 C=0" "mvns rot0 C=1" "mvns b31=0 C" "mvns b31=1 C" \
  322:          "mvns value"; do
  323:     n=$(count "$LOG" "^$v  .*ok$")
  324:     check "  round 78: $v" "$n" 1
  325: done
  326: for v in "rotc pc src C"; do
  327:     n=$(count "$LOG" "^$v  .*ok$")
  328:     check "  round 78: $v" "$n" 1
  329: done
  330: for v in "uxtab ROR 0" "rot0 movs C" "mvn S-clear" "rot0 pc src C" \
  331:          "rotc pc gt255" "rotc bound 256"; do
  332:     n=$(count "$LOG" "^$v  .*ok$")
  333:     check "  round 78 pin: $v" "$n" 1
  334: done
  335: 
  336: # #328: the THUMB rows. Everything above is ARM-mode; the Thumb interpreter is a
  337: # separate implementation that #311 never touched, and it had THREE flag defects in
  338: # four near-identical blocks -- Z read off a 64-bit value, C derived from the carry
  339: # out of a negation (so subtracting zero reported a borrow), and V read from the sign
  340: # of the negated subtrahend (which breaks at 0x80000000, the one value that is its
  341: # own negation). Each row asserts the flags AND rd, because the value was already
  342: # right and a flags-only row could not tell a fixed flag from a broken result.
  343: for v in "T ctrl ADDS 2+3" "T ctrl SUBS 5-3" "T ctrl SUBS borrow"          "T Z subs equal" "T Z cmp imm equal" "T Z subs imm equal"          "T Z cmp reg equal" "T Z adds wrap"          "T C subs zero" "T C cmp imm 0" "T C subs imm 0" "T C cmp reg zero"          "T V 0-INT_MIN" "T V -1-INT_MIN" "T V INT_MIN-same"          "T alias subs rd==rm" \
  344:          "T Z adds imm8 wrap" "T Z adds imm3 wrap" "T C subs imm3 zero" \
  345:          "T V subs INT_MIN" "T V adds overflow" "T C subs 0-0" \
  346:          "T V adds INT_MIN x2"; do
  347:     n=$(count "$LOG" "^$v  .*ok$")
  348:     check "  thumb: $v" "$n" 1
  349:     n=$(count "$LOG" "^$v rd  .*ok$")
  350:     check "  thumb: $v rd" "$n" 1
  351: done
  352: 
  353: 
  354: # #329: the Thumb SHIFT rows. ASR-immediate took Z and N from a register chosen by the
  355: # shift amount; RORS never cleared Z/N; and LSR #0 / ASR #0 encode shift-by-32 rather
  356: # than shift-by-zero. The two LSL #0 rows are the control -- that encoding IS a genuine
  357: # no-op and its C must survive untouched, which is why they run at both carry-in values.
  358: # The positive-operand shift-32 rows only became measurable once the rig could preset
  359: # carry: against a build that never writes C they would pass on a cold machine anyway.
  360: for v in "T LSL #0 keeps C1" "T LSL #0 keeps C0" "T ASR #12 flags reg"          "T RORS clears Z" "T RORS clears N"          "T LSR #0 neg" "T LSR #0 pos" "T ASR #0 neg" "T ASR #0 pos"          "T LSR rd!=0"; do
  361:     n=$(count "$LOG" "^$v  .*ok$")
  362:     check "  shift: $v" "$n" 1
  363:     n=$(count "$LOG" "^$v rd  .*ok$")
  364:     check "  shift: $v rd" "$n" 1
  365: done
  366: 
  367: # ---- #351/#352/#353: netbsd_idle, via the READ-AHEAD install path -----------
  368: # A SEPARATE probe (arm_idle_probe.py), because every row here runs with NO
  369: # breakpoint so translation read-ahead is ON -- the install path a real guest
  370: # takes, and the one arm_flags_probe.py's breakpoint driver structurally cannot
  371: # reach (cpu_dyntrans.c:1939 gates read-ahead on breakpoints.n == 0). The
  372: # register-alias defect (c) and the forward-beq hang (d) are invisible under a
  373: # breakpoint, so they could only be witnessed here.
  374: #
  375: # Swept against a binary built from the pre-fix HEAD (704036e): 2 of 9, failing
  376: # exactly the seven DISC rows -- exit dest 0x77, exit flags 0x6, idle dest 0x77,
  377: # idle flags 0x8, `alias exits` 0x55 (fold took the wrong exit), `target
  378: # reached` deadbeef (the forward-beq HUNG the guest), and `fires` (no marker) --
  379: # and passing the two PINs. On the fixed build: 9/9.
  380: IDLELOG=$LOGDIR/gate_arm_idle.log
  382:   383: if ! grep -q "IDLE_RESULT=" "$IDLELOG"; then
  384:     note "idle probe produced no result line; last lines follow"
  385:     tail -5 "$IDLELOG" | sed 's/^/       /'
  386:     gate_skip "idle probe did not complete"
  387: fi
  388: 
  389: grep -E " ok$| FAIL$" "$IDLELOG" | sed 's/^/       /'
  390: 
  391: ictrl=$(grep -o "IDLE_CONTROL=[A-Z]*" "$IDLELOG" | tail -1 | cut -d= -f2)
  392: check "idle control proves the probe measures" "${ictrl:-missing}" "OK"
  393: 
  394: ires=$(grep -o "IDLE_RESULT=[0-9]*/[0-9]*" "$IDLELOG" | tail -1 | cut -d= -f2)
  395: igot=${ires%/*}; iwant=${ires#*/}
  396: check "idle rows run"     "$iwant" 9
  397: check "idle rows correct" "$igot"  "$iwant"
  398: 
  399: # Named rows, one contract each. The two PINs pass on both builds by design:
  400: # `quiet` asserts marker absence at default verbosity (boot-log hygiene), and
  401: # `alias -J ref` pins that the alias program's architectural answer really is
  402: # idle (so the DISC above attributes its 0x55 to the fold, not the program).
  403: for v in "A idle exit dest" "A idle exit flags" "A idle path dest" \
  404:          "A idle path flags" "A idle alias exits" "A idle target reached" \
  405:          "A idle fires" "A idle quiet" "A idle alias -J ref"; do
  406:     n=$(count "$IDLELOG" "^$v  .*ok$")
  407:     check "  idle row: $v" "$n" 1
  408: done
  409: 
  410: # ---- #354: netbsd_memcpy, via the READ-AHEAD install path -------------------
  411: # The memcpy fold did memcpy(dst,src,32) + advanced r0/r1 but never wrote
  412: # r3/r4/ip/lr, which the architecture leaves = the last 16 bytes loaded (the
  413: # final iteration's second ldmia). Same SEPARATE-probe / read-ahead-ON reason
  414: # as the idle rows. Owed words are full-width and distinct per register so a
  415: # byteswap or wrong index is self-evident.
  416: #
  417: # Swept against a binary built from the committed HEAD (pre-#354): 4 of 12,
  418: # failing exactly the eight DISC rows (r3/r4/ip/lr = seeds 0x33/0x44/0xcc/0xee
  419: # on both the 1-iteration and 2-iteration loops) and passing the four r0/r1
  420: # PINs (the advance was always correct). On the fixed build: 12/12.
  421: MEMLOG=$LOGDIR/gate_arm_memcpy.log
  422: python3 arm_memcpy_probe.py "$PMAX" "$STUB" > "$MEMLOG" 2>&1 || true
  423: 
  424: if ! grep -q "MEMCPY_RESULT=" "$MEMLOG"; then
  425:     note "memcpy probe produced no result line; last lines follow"
  426:     tail -5 "$MEMLOG" | sed 's/^/       /'
  427:     gate_skip "memcpy probe did not complete"
  428: fi
  429: 
  430: grep -E " ok$| FAIL$" "$MEMLOG" | sed 's/^/       /'
  431: 
  432: # The control proves the harness runs end-to-end (program assembled, guest
  433: # executed, dump parsed, byteswap convention right) against the GENUINE
  434: # instruction path under -J. It does NOT prove the measured sessions went
  435: # through the FOLD: post-#354 the fold and the genuine path agree by
  436: # construction, so nothing here would notice if a future change broke the
  437: # combiner registration -- the rows would keep passing via the real
  438: # instructions and the coverage would silently vanish. Only a #349/#352-style
  439: # fold-fired marker closes that; it is recorded in OUTSTANDING_BUGS, and the
  440: # historical pre-#354 sweep (4/12, the eight DISC rows red) is what establishes
  441: # that these rows discriminate at all.
  442: mctrl=$(grep -o "MEMCPY_CONTROL=[A-Z]*" "$MEMLOG" | tail -1 | cut -d= -f2)
  443: check "memcpy control: harness measures (not fold-fired)" "${mctrl:-missing}" "OK"
  444: 
  445: mres=$(grep -o "MEMCPY_RESULT=[0-9]*/[0-9]*" "$MEMLOG" | tail -1 | cut -d= -f2)
  446: mgot=${mres%/*}; mwant=${mres#*/}
  447: check "memcpy rows run"     "$mwant" 17
  448: check "memcpy rows correct" "$mgot"  "$mwant"
  449: 
  450: # The four r0/r1 PINs pass on both builds -- they guard against a fix that
  451: # regresses the advance while writing the registers (Codex's clobber concern:
  452: # r0/r1/r2 are outside the {r3,r4,ip,lr} reglist, so the exact-iword matcher
  453: # already forbids aliasing; these pins make that guarantee visible).
  454: #  #359: the five `dst` rows are the only assertions in this whole gate that
  455: #  read the BYTES the fold moved. Everything else here reads registers, and
  456: #  registers cannot see the copy size: r3/r4/ip/lr are published by a direct
  457: #  page read that bypasses the fold's memcpy call, and r0/r1 advance
  458: #  unconditionally. Measured, and this is why the rows exist: a build whose fold
  459: #  called memcpy with 16 instead of 32 -- half the bytes moved, same iteration
  460: #  count, same register advance -- passed this probe 12/12 and the whole of gate
  461: #  14 at 243 checks. With the dst rows it reads 15/17, red at exactly
  462: #  `1it dst w6` and `2it dst w14`, both showing the pre-fill sentinel where a
  463: #  source word was owed. They are PIN, not DISC: the genuine ldmia/stmia moves
  464: #  the same bytes, so the destination is identical folded or not -- what they
  465: #  discriminate is a broken copy. Note `2it dst w9` deliberately PASSES on that
  466: #  mutant (it lies in the first 16 bytes of the second iteration, which is still
  467: #  copied); the discriminator for a later iteration is w14, and keeping both
  468: #  makes the row set say which half of the copy failed.
  469: for v in "A memcpy 1it r3" "A memcpy 1it r4" "A memcpy 1it ip" \
  470:          "A memcpy 1it lr" "A memcpy 1it r0" "A memcpy 1it r1" \
  471:          "A memcpy 1it dst w1" "A memcpy 1it dst w6" \
  472:          "A memcpy 1it dst tail" \
  473:          "A memcpy 2it r3" "A memcpy 2it r4" "A memcpy 2it ip" \
  474:          "A memcpy 2it lr" "A memcpy 2it r0" "A memcpy 2it r1" \
  475:          "A memcpy 2it dst w9" "A memcpy 2it dst w14"; do
  476:     n=$(count "$MEMLOG" "^$v  .*ok$")
  477:     check "  memcpy row: $v" "$n" 1
  478: done
  479: 
  480: # ---- #355/#356: the strlen fold ---------------------------------------------
  481: # #355: COMBINE(strlen) never required the load's base and destination to
  482: # differ, so `ldrb r3,[r3,#1]!` folded. The genuine writeback overwrites the
  483: # loaded byte, so the cmps compares an ADDRESS and the loop runs on; the fold's
  484: # condition tests the byte and EXITS. The encoding is UNPREDICTABLE, so neither
  485: # answer is "wrong" -- but the emulator was giving two answers for one program
  486: # depending on whether the combination happened, and -J is this gate's own
  487: # architectural oracle.
  488: #
  489: # #356: the walk had no budget bound and ran the whole string inside ONE
  490: # dispatch -- host unresponsive for the duration, and n_translated_instrs (an
  491: # int, reset per run_instr, with a REPLAYABLE walk) drivable into signed
  492: # overflow with ~18-24 MB of non-NUL memory at the DEFAULT -M 64.
  493: #
  494: # The yield is witnessed WITHOUT a clock: the test machine's mp device exposes
  495: # cpu->ninstrs at 0x110000d0, and ninstrs is committed only when run_instr
  496: # returns, so a guest sampling it either side of a 16 KB walk reads ~0 if the
  497: # walk never left one dispatch. All numeric rows assert BANDS, because the exact
  498: # counts depend on N_SAFE_DYNTRANS_LIMIT (8191) and the 120-dispatch group
  499: # boundary -- named so a change to either moves the bands deliberately.
  500: #
  501: # Swept against a binary built from the pre-fix HEAD: 3 of 7, failing exactly
  502: # the four discriminators -- `yields` and `bill band` both read 0 (the walk
  503: # never left the dispatch), `alias exits` read 0x55 (the fold took the wrong
  504: # exit) and `alias moved` read "no" (it had exited after three bytes). The
  505: # three PINs pass on both builds. On the fixed build: 7/7.
  506: STRLOG=$LOGDIR/gate_arm_strlen.log
  507: python3 arm_strlen_probe.py "$PMAX" > "$STRLOG" 2>&1 || true
  508: 
  509: if ! grep -q "STRLEN_RESULT=" "$STRLOG"; then
  510:     note "strlen probe produced no result line; last lines follow"
  511:     tail -5 "$STRLOG" | sed 's/^/       /'
  512:     gate_skip "strlen probe did not complete"
  513: fi
  514: 
  515: grep -E " ok$| FAIL$" "$STRLOG" | sed 's/^/       /'
  516: 
  517: sctrl=$(grep -o "STRLEN_CONTROL=[A-Z]*" "$STRLOG" | tail -1 | cut -d= -f2)
  518: check "strlen control: -J reference walked and yielded" "${sctrl:-missing}" "OK"
  519: 
  520: sres=$(grep -o "STRLEN_RESULT=[0-9]*/[0-9]*" "$STRLOG" | tail -1 | cut -d= -f2)
  521: sgot=${sres%/*}; swant=${sres#*/}
  522: check "strlen rows run"     "$swant" 7
  523: check "strlen rows correct" "$sgot"  "$swant"
  524: 
  525: for v in "A strlen -J ref" "A strlen -J end addr" "A strlen yields" \
  526:          "A strlen bill band" "A strlen end addr" "A strlen alias exits" \
  527:          "A strlen alias moved"; do
  528:     n=$(count "$STRLOG" "^$v  .*ok$")
  529:     check "  strlen row: $v" "$n" 1
  530: done
  531: 
  532: # #357: the base writeback (cpu_arm_instr_loadstore.c)
  533: # -------------------------------------------------------------------------
  534: # The template computed one address, masked it for alignment, and wrote the
  535: # base register back FROM THE MASKED VALUE. ARM ARM DDI 0100I computes the
  536: # writeback from the unmasked Rn (A5.2.8 post-indexed, A5.2.5 pre-indexed;
  537: # A2-43 puts the truncation inside Memory[]).
  538: #
  539: # The reachable symptom is a loop that cannot make progress, not a wrong
  540: # value: with a word access and a post-index offset of 1 the masked writeback
  541: # is a FIXED POINT -- base 0x10001 masks to 0x10000, plus 1 is 0x10001, the
  542: # value it started from. Rows A/A2 run ten iterations and assert the exact
  543: # architectural result; the count lives in r3, so nothing here depends on how
  544: # far execution got or on host speed.
  545: #
  546: # WHICH ROW REACHES WHICH SITE -- #364 CORRECTED THIS TABLE, WHICH WAS INVERTED.
  547: # It used to say the fast path "only runs once the page is in the translation
  548: # array, so a single-execution row measures the GENERAL path and nothing else",
  549: # and it referred forward to a "CORRECTION below" that was never written. Both
  550: # are fixed here. MEASURED: no row in this probe reached the general path at
  551: # all -- a marker at the top of A__NAME__general counted ZERO hits on all 17
  552: # rows, including the x10 iterations and both re-seeded passes.
  553: #
  554: # The cause was the probe's own seeding. `put w` -> store_32bit_word ->
  555: # memory_rw(CACHE_DATA), and insertion is gated on !no_exceptions, so a page
  556: # seeded with `put w` is ALREADY warm before the guest runs. `put b` uses
  557: # CACHE_NONE | NO_EXCEPTIONS and does not insert. The old note had the two
  558: # backwards, and it was recorded as a verified mechanism, so two shipped rounds
  559: # leaned on it: #357's general-path writeback and #362's general-path rotation
  560: # were both unmeasured, and each was independently confirmed DELETABLE with this
  561: # whole gate still green at 358 checks.  (This said 261 until 2026-08-26 -- the count
  562: # grew when the gate took on `barearm` and `cats`, and commit 6014b7e's message records
  563: # "PASS 358 checks (was 261)".  The carrier carried the same stale number; both were
  564: # corrected together, because a number with two homes rots in both.)
  565: #
  566: # TWO AXES, kept apart. The first draft of this correction conflated them and
  567: # claimed the new cold rows cover "general post-index writeback". They do NOT:
  568: # their LDR is P=1/W=0, and the writeback is emitted only under (P and W) or
  569: # (not P), so an offset form has no writeback statement at all. Caught in review.
  570: #
  571: #   -- the four WRITEBACK sites (the `reg(ic->arg[0]) =` statements) --
  572: #   fast    post-index  every iteration of the x10 rows, plus the one-shot
  573: #                       post-index rows and the PIN rows (11 in total)
  574: #   fast    pre-index   "pre4 unal gen" AND "pre4 unal fast" (both passes)
  575: #   general post-index  UNCOVERED
  576: #   general pre-index   UNCOVERED
  577: #
  578: #   -- rows with NO writeback site (P=1/W=0 offset forms) --
  579: #   "pre4 no wb" and the three "rot word unal" rows   (fast function)
  580: #   the three "rot word cold" rows                    (general function)
  581: #
  582: #   -- which rows enter A__NAME__general AT ALL, the question this round answers --
  583: #   the three "rot word cold" rows, and nothing else: they exercise the
  584: #   load-and-rotate arm and the memory_rw slow path, which is a DATA site.
  585: #
  586: # So #357's general-path WRITEBACK fix still has no row reaching it. That is
  587: # recorded in OUTSTANDING_BUGS rather than papered over here.
  588: #
  589: # No line numbers here on purpose: the ones this table used to carry (:213/:216,
  590: # :338/:342) had gone stale by the round that corrected it -- the third time in
  591: # this file, whose own #357 note already says a numeric cite here has gone stale
  592: # twice before.
  593: #
  594: # "pre4 unal fast" still needs its two passes with the base re-seeded each pass:
  595: # without the re-seed, pass 1 leaves an ALIGNED base and the row has nothing
  596: # left to discriminate. Only its SITE attribution was wrong, not its design.
  597: # Loads and stores are separate instantiations of the template, so a load-only
  598: # set cannot see a store-side regression: hence the store row. Register-offset
  599: # forms are a third family: hence the regofs row.
  600: #
  601: # The control is the loaded-data row rather than a pass count: r1 starts at 0,
  602: # so a distinctive nonzero value proves the guest really executed and really
  603: # loaded. A wrong register field reads 0, and a row that accepts 0 accepts that
  604: # mistake by accident -- this harness has shipped exactly that defect before.
  605: #
  606: # DISC-M ("model") on the halfword row is deliberate: an unaligned halfword
  607: # load's DATA is UNPREDICTABLE (A4.1.28) while its writeback stays defined
  608: # (A5.3.6), so the row asserts the BASE only and pins the pseudocode model, not
  609: # a silicon mandate. Every other DISC row is a word form, i.e. mandated space.
  610: # There is no *unaligned* LDRD/STRD row on purpose: A2.8 makes an unaligned
  611: # doubleword access UNPREDICTABLE prior to ARMv6, so every base that would
  612: # exercise the ~7 mask makes the instruction unspecified -- covered by the
  613: # fix, not honestly assertable. [#389: ALIGNED LDRD/STRD byte-order rows now
  614: # live in the endian section below -- this note is scoped to the writeback/
  615: # unaligned axis only.]
  616: #
  617: # #364: the sentence that used to stand here -- "no row pins the unaligned
  618: # loaded DATA ... such a row would be inverted by the round that fixes
  619: # rotation" -- was falsified by #362, which added exactly three such rows, and
  620: # by #364, which added three more from a cold page. It is removed rather than
  621: # annotated. The ALIGNED data row remains, and remains correct for its own
  622: # reason: no rotation applies at offset 0 in any architecture version.
  623: #
  624: # Swept against a snapshot of the pre-fix binary: 5 of 14, with all nine DISC
  625: # rows failing at exactly the predicted masked values and all five PINs
  626: # passing. On the fixed build: 14/14. Read that 5/14 with the corrected table
  627: # above -- it is entirely a FAST-path result, since no row of that era entered
  628: # the general path. #362 took the set to 17, #364 to 20.
  629: WBLOG=$LOGDIR/gate_arm_writeback.log
  630: python3 arm_writeback_probe.py "$PMAX" > "$WBLOG" 2>&1 || true
  631: 
  632: if ! grep -q "WRITEBACK_RESULT=" "$WBLOG"; then
  633:     note "writeback probe produced no result line; last lines follow"
  634:     tail -5 "$WBLOG" | sed 's/^/       /'
  635:     gate_skip "writeback probe did not complete"
  636: fi
  637: 
  638: grep -E " ok$| FAIL$" "$WBLOG" | sed 's/^/       /'
  639: 
  640: wctrl=$(grep -o "WRITEBACK_CONTROL=[A-Z]*" "$WBLOG" | tail -1 | cut -d= -f2)
  641: check "writeback control: guest ran and loaded" "${wctrl:-missing}" "OK"
  642: 
  643: wres=$(grep -o "WRITEBACK_RESULT=[0-9]*/[0-9]*" "$WBLOG" | tail -1 | cut -d= -f2)
  644: wgot=${wres%/*}; wwant=${wres#*/}
  645: check "writeback rows run"     "$wwant" 22
  646: check "writeback rows correct" "$wgot"  "$wwant"
  647: 
  648: # ---------------------------------------------------------------------------
  649: # #524 (armbdt): block data transfer through a COLD host page.
  650: #
  651: # arm_pop()/arm_push() take a fast path when the host page is resident and a
  652: # slow memory_rw() path when it is not.  The fast path truncates the low two
  653: # address bits for free; the slow path passed the RAW address, whose transfer
  654: # is a page-granular memcpy -- so an unaligned base SPLICED BYTES ACROSS A WORD
  655: # BOUNDARY and the same instruction returned different bytes according to host
  656: # page-cache warmth.  Fixed by masking AT THE TWO ACCESS SITES ONLY; the mask
  657: # must never move to function entry, because writeback uses the unmasked
  658: # running address.
  659: #
  660: # THE DENOMINATOR IS PINNED TO A LITERAL BELOW, DELIBERATELY.  The probe grew
  661: # 25 -> 29 -> 32 rows across three kill tables as clause-(d) mutants were
  662: # closed, and a gate that trusts the probe s own denominator cannot tell a
  663: # probe that lost rows from one that never had them.
  664: #
  665: # Five mutants are measured dead in regress/artifacts/armbdt/killtable_20260911e/:
  666: #   M_ENTRY      mask hoisted to entry      27/32  ARM_LDM_WB_UNAL1/2, ARM_STM_WB_UNAL,
  667: #                                                  THUMB_POP_WB_UNAL, THUMB_PUSH_WB_UNAL
  668: #   M_MASK1      mask weakened to & ~1      29/32  ARM_LDM_COLD_DATA_P2, ARM_STM_COLD_DATA_P2,
  669: #                                                  THUMB_PUSH_COLD_DATA_P2
  670: #   M_MASK7      mask over-aligned to & ~7  30/32  ARM_LDM_COLD_DATA_BIT2, ARM_STM_COLD_DATA_BIT2
  671: #   M_PBITCOND   mask conditional on p_bit  31/32  THUMB_PUSH_COLD_DATA_P2
  672: #   M_NULL_MEDIUM both helpers return        8/32  24 rows red; the 8 that SURVIVE are the six
  673: #                                                  PATH_* rows and the two *_COLD_CLOBBER rows
  674: #
  675: # THE KILLING ROWS ARE NAMED, NOT DESCRIBED, FOR TWO REASONS.  A name is checkable against
  676: # killtable_20260911e/probe_<mutant>.raw; a description is not.  And the earlier wording said
  677: # M_ENTRY was "killed by the writeback rows" -- which collided with the arm_writeback_probe.py
  678: # stem and made check_score_claims read 27/32 as a stale claim about THAT probe (its pin is 22).
  679: # A comment that makes a checker wrong is the defanging rule's own lesson: before writing a word
  680: # a tool matches on, ask what the tool will do with it.
  681: #
  682: # *** THE 8 SURVIVORS UNDER THE NULL MEDIUM ARE A DISCLOSED LIMIT, NOT A PASS. ***  With both
  683: # helpers replaced by `return;' nothing is written at all, so a row asserting a NEIGHBOUR was not
  684: # clobbered is satisfied trivially, and the PATH_* rows observe which host-page path was taken
  685: # rather than what landed.  Clause (c) is met by the 24 that do red; these 8 say why 8/32 is not 0.
  686: BDTLOG=$LOGDIR/gate_arm_bdt.log
  687: python3 arm_bdt_probe.py "$PMAX" > "$BDTLOG" 2>&1 || true
  688: 
  689: if ! grep -q "ARMBDT_RESULT=" "$BDTLOG"; then
  690:     note "bdt probe produced no result line; last lines follow"
  691:     tail -5 "$BDTLOG" | sed 's/^/       /'
  692:     gate_skip "bdt probe did not complete"
  693: fi
  694: 
  695: grep -E " ok$| FAIL$" "$BDTLOG" | sed 's/^/       /'
  696: 
  697: bctrl=$(grep -o "ARMBDT_CONTROL=[A-Z]*" "$BDTLOG" | tail -1 | cut -d= -f2)
  698: check "bdt control: liveness and attribution" "${bctrl:-missing}" "OK"
  699: 
  700: bres=$(grep -o "ARMBDT_RESULT=[0-9]*/[0-9]*" "$BDTLOG" | tail -1 | cut -d= -f2)
  701: bgot=${bres%/*}; bwant=${bres#*/}
  702: #  *** PIN MOVED 32 -> 39 ON 2026-09-11, DELIBERATELY, FOR THE CLASS CLOSURE. ***
  703: #  Pass C measured FIVE clause-(d) mutants at 32/32 -- a TOTAL ESCAPE each -- all
  704: #  one class: every p/u/s/w partition was discharged on the STORE side and
  705: #  undischarged on the LOAD side, because the only leg varying those bits was
  706: #  Thumb PUSH, which calls arm_push().  Seven rows close the load side; all SIX
  707: #  built mutants now die (killtable_20260911g_closure/SCORES.txt):
  708: #    BASE        39/39                     M_SBIT_NONE 38/39 -- S_P2
  709: #    M_POPP_NONE 37/39 -- IB_P2, DB_P2     M_POPP_WEAK 37/39 -- IB_P2, DB_P2
  710: #    M_NPMASK    37/39 -- IB_P2, DB_P2     M_POPW_WEAK 37/39 -- DB_P2, MULTI_P2_R1
  711: #    M_POPU_WEAK 37/39 -- DA_P2, DB_P2
  712: #  A pin that follows the probe cannot tell a probe that GAINED rows from one
  713: #  that LOST them, so the literal moves by hand and says why.
  714: #  *** PIN 39 -> 43 ON 2026-09-12: THE TEN-CELL FLOOR. ***  Table 7
  715: #  (killtable_20260911h_floor) is the first table in this round whose rows are
  716: #  enumerated from the HELPERS OWN INPUTS rather than from the mutant list --
  717: #  which is what the class-closure rule always said, and what pass C invoked but
  718: #  did not do.  Every earlier repair rowed at the residue of the mutant it had
  719: #  just found, so each pass discovered the next strength.
  720: #
  721: #  EVERY NEW ROW SITS AT AN ACCESS ADDRESS = 7 (mod 8): bits 0, 1 and 2 are all
  722: #  set, so ONE access discriminates ~1, ~2, ~3 AND ~7.  No future strength needs
  723: #  a new residue.
  724: #
  725: #    BASE 43/43.  All ten floor cells kill:
  726: #      M_PUSHS_NONE   42/43 ARM_STM_S_R7        M_POPP_MASK2  41/43 IB_P2, DB_P2
  727: #      M_PUSH_IB_WEAK 42/43 ARM_STM_IB_R7       M_PUSH_DA_WEAK 42/43 ARM_STM_DA_R7
  728: #      M_PUSHPC_NONE  42/43 ARM_STM_PC_DB_R7    M_PUSHP_OVER7 41/43 IB_R7, PC_DB_R7
  729: #      plus the six table-g mutants, all still dead.
  730: #    The ONE escape is DISCLOSED: D_PUW_WEAK 43/43, named in the contract.
  731: check "bdt rows run"     "$bwant" 43
  732: check "bdt rows correct" "$bgot"  "$bwant"
  733: 
  734: # #367: PATH ATTRIBUTION IS NOW A CHECKED QUANTITY, not a comment.
  735: #
  736: # Which of the two load/store paths a row takes was asserted in prose and was
  737: # wrong three rounds running: #364 found the `put w` / `put b` warming note
  738: # INVERTED and recorded as verified, with two shipped rounds leaning on it;
  739: # #364's own draft then mis-attributed a writeback site to an offset form that
  740: # compiles no writeback statement at all; and #365 found the general writeback
  741: # sites reached but UNDISCRIMINATED, since `ldrb` has datalen 1 so the alignment
  742: # mask is the identity for it. Each was rediscovered with a throwaway marker and
  743: # a scratch build, three times, because the instrument did not survive the round.
  744: #
  745: # The emulator now counts entries into A__NAME__general (cpu_arm.h ls_general),
  746: # and `tlbdump` -- previously an EMPTY stub on ARM while it printed on other
  747: # architectures -- reads it out. PULL-ONLY: nothing prints unless a session asks,
  748: # so the rows elsewhere in this gate that assert an ABSENCE of output are
  749: # untouched, and a free-running guest cannot be flooded.
  750: #
  751: # The aggregate carries the seventeen ZEROS -- exactly the claim #364 found
  752: # inverted -- so a warming assumption that silently changes turns this red even
  753: # though no named row below covers those rows individually.
  754: lsres=$(grep -o "LSGEN_RESULT=[0-9]*/[0-9]*" "$WBLOG" | tail -1 | cut -d= -f2)
  755: lsgot=${lsres%/*}; lswant=${lsres#*/}
  756: check "writeback path rows run"     "${lswant:-missing}" 22
  757: check "writeback path rows correct" "${lsgot:-missing}"  "$lswant"
  758: 
  759: # The five rows that must ENTER the general path, named individually so one
  760: # reverting cannot hide behind the total. The derivation, which matters more than
  761: # the numbers: the general path's own memory_rw SELF-WARMS, so a cold row is 1
  762: # and not N. The `ldrt` row is 1 despite its page being WARM, because the
  763: # is_userpage test precedes the page test and a kernel `put w` insert never sets
  764: # that bit -- which is what makes a T form general-path BY CONSTRUCTION and
  765: # immune to any future seeding change.
  766: for v in "A wb rot word cold plus1" "A wb rot word cold plus2" \
  767:          "A wb rot word cold plus3" "A wb word ldrt post4 unal" \
  768:          "A wb word cold pre4 unal"; do
  769:     n=$(count "$WBLOG" "^$v path  .*ok\$")
  770:     check "  writeback path: $v" "$n" 1
  771: done
  772: 
  773: # #358: fold-fired markers (netbsd_copyin / netbsd_copyout)
  774: # -------------------------------------------------------------------------
  775: # Both folds replace six user-mode transfers with one C function whose
  776: # registers, addresses and instruction billing are IDENTICAL to the
  777: # instructions replaced, so a row asserting their result passes whether or not
  778: # the fold fires. Until #357 one witness existed -- the template masked its base
  779: # writeback while these folds did not, so an unaligned base read 0x10019 folded
  780: # against 0x10018 genuine -- and #357 correctly removed it by fixing the
  781: # template. These two folds also had NO rows at all before this.
  782: #
  783: # The rows are FREE-RUNNING by necessity, not by style. Measured: a two-pass
  784: # program with a breakpoint one instruction before the folded window executes the
  785: # GENUINE sequence on both the default and the -J build, while the same program
  786: # with no breakpoint folds -- so a breakpoint suppresses the fold. A breakpoint ON
  787: # a slot is worse: that path re-marks its own slot for retranslation and the
  788: # matchers test ic[i].f, so a fold can never install there. Two passes are
  789: # required because the folds gate on is_userpage, which only the user-access
  790: # general handler sets -- the very handler the fold's bail-out delegates to.
  791: #
  792: # Each fold gets a pair so neither row can be vacuous in either direction. The
  793: # `fires` row demands the marker AND the verbosity echo AND the six transferred
  794: # values: without the echo a session whose verbosity raise silently failed would
  795: # report zero markers and look exactly like a dead fold, and without the values
  796: # the row would prove a line was printed rather than that work was done. The
  797: # `quiet` row asserts silence at default verbosity and must never be rewritten to
  798: # drive the guest with `step` -- single-step BYPASSES debugmsg's verbosity gate.
  799: #
  800: # Non-vacuity proven per fold on scratch trees built from this exact source.
  801: # Disabling ONLY netbsd_copyin's arming (by making its iword test unsatisfiable,
  802: # which keeps the statement structure intact) gives 3 of 4, with exactly
  803: # `A fold copyin fires` red and copyout's rows still green. An earlier attempt
  804: # replaced the arming assignment with a comment and left a dangling `if` that
  805: # swallowed the copyout arming, killing both folds -- one real reason and one
  806: # artifact, which is why the break is done by constant and not by deletion.
  807: FOLDLOG=$LOGDIR/gate_arm_foldmark.log
  808: python3 arm_fold_marker_probe.py "$PMAX" > "$FOLDLOG" 2>&1 || true
  809: 
  810: if ! grep -q "FOLDMARK_RESULT=" "$FOLDLOG"; then
  811:     note "fold-marker probe produced no result line; last lines follow"
  812:     tail -5 "$FOLDLOG" | sed 's/^/       /'
  813:     gate_skip "fold-marker probe did not complete"
  814: fi
  815: 
  816: grep -E " ok$| FAIL$" "$FOLDLOG" | sed 's/^/       /'
  817: 
  818: fres=$(grep -o "FOLDMARK_RESULT=[0-9]*/[0-9]*" "$FOLDLOG" | tail -1 | cut -d= -f2)
  819: fgot=${fres%/*}; fwant=${fres#*/}
  820: #  #360: the `warm`/`cold` pairs are the LIVE controls, and the difference from
  821: #  the `quiet` rows is visible in one measurement. On a build with ONLY
  822: #  netbsd_copyin's arming disabled, `A fold copyin quiet` still reads **ok** --
  823: #  it asserts an absence, and an absence is exactly what a dead fold produces --
  824: #  while `A fold copyin cold` goes red because it asserts a DECLINE occurred
  825: #  (install 1, fire 0, decline 1). Measured 5 of 8 on that build, red at exactly
  826: #  the three copyin rows, with copyout's four green.
  827: #
  828: #  The install count is what makes the diagnosis one-read: install 0 means the
  829: #  matcher declined; install 1 with fire 0 and decline 1 means the fold was
  830: #  reached and turned the operands down, and the decline text names the clause.
  831: #  Every arm also asserts the verbosity echo and that r0/r1 advanced by the full
  832: #  six transfers -- the latter holds folded or not, so it proves the program ran
  833: #  without presuming the fold, which is what stops the cold arm's zero from
  834: #  being meaningless. Measured: with verbosity off the guest ran perfectly and
  835: #  reported zero fires AND zero installs, so counting absences alone cannot tell
  836: #  a dead fold from a broken session.
  837: #  #361 adds rows for the last two folds that had #358 markers but nothing
  838: #  exercising them -- the scope debt #358 was criticised for. Two shapes, and
  839: #  they are NOT interchangeable:
  840: #    xchg  declines at the MATCHER (install 0), because #342's `a != b` term
  841: #          rejects the shape before anything is installed.
  842: #    scanc declines at a GUARD (install 1, decline 1), like copyin/copyout, and
  843: #          has TWO decline sites -- the second reachable only after the first
  844: #          passes, since the table address is computed from the byte just loaded.
  845: #          Both are exercised, with distinct reason spellings so a row can say
  846: #          which page missed.
  847: #
  848: #  `A fold xchg selective` is one row spanning BOTH xchg arms, and it exists
  849: #  because a measuring seat showed the negative arm is VACUOUS ALONE: install 0 /
  850: #  fire 0 reads identically on a healthy build and on one with xchg's arming
  851: #  removed, so by itself it cannot tell "the matcher rejected the shape" from
  852: #  "the matcher does not exist" -- the #360 defect again. Measured on an
  853: #  arming-dead build: `A fold xchg samereg` reads **ok** while
  854: #  `A fold xchg selective` goes red. The rejected alternative is recorded in the
  855: #  probe: relocating #342's term into the matched shape so the arm self-diagnoses
  856: #  works, but it edits a shipped correction's guard for instrumentation's sake.
  857: #
  858: #  scanc's r3 is a genuine three-way value witness -- 0x77 is table[4] when the
  859: #  fold runs, 0x66 is table[0] because an unmapped string load yields zero, and
  860: #  0x00 when the table page is the missing one -- plus an r5 sentinel proving the
  861: #  program reached its end. Measured: on a scanc-arming-dead build all three arms
  862: #  keep byte-identical register values and only the marker triple moves, so a
  863: #  value-only row would be vacuous for this fold.
  864: check "fold-marker rows run"     "$fwant" 21
  865: check "fold-marker rows correct" "$fgot"  "$fwant"
  866: 
  867: # #383: the four BE rows put the copyin/copyout folds' byte-order handling on
  868: # the test surface -- on barearm both folds install and fire (their matchers
  869: # gate on HOST endianness, not guest), so the value rows discriminate the fix.
  870: # The +1/+3 UNALIGNED copyin rows are the composition-order discriminators (a
  871: # fix swapping AFTER #362's rotation passes +0 but fails these). FOLDMARK_
  872: # CONTROL_BE is the fix-state-independent liveness pin (r1 ^ sl == the
  873: # architectural word on every build), so a dead barearm session cannot
  874: # false-green the BE group.
  875: fctrlbe=$(grep -o "FOLDMARK_CONTROL_BE=[A-Z]*" "$FOLDLOG" | tail -1 | cut -d= -f2)
  876: # #384: the control pins that the barearm rig ran, both passes executed, and
  877: # the rig is genuinely big-endian (an LE rig fails it). It does NOT prove the
  878: # fold fired -- that is the value rows' fire==1 -- so the name does not claim it.
  879: check "fold-marker BE control: barearm ran, rig is BE" "${fctrlbe:-missing}" "OK"
  880: 
  881: for v in "A fold copyin fires" "A fold copyin quiet" \
  882:          "A fold copyout fires" "A fold copyout quiet" \
  883:          "A fold copyin warm" "A fold copyin cold" \
  884:          "A fold copyout warm" "A fold copyout cold" \
  885:          "A fold xchg fires" "A fold xchg samereg" \
  886:          "A fold xchg selective" "A fold scanc fires" \
  887:          "A fold scanc nostr" "A fold scanc notbl" \
  888:          "A fold copyin rot plus1" "A fold copyin rot plus2" \
  889:          "A fold copyin rot plus3" \
  890:          "A fold copyin BE +0" "A fold copyin BE +1" \
  891:          "A fold copyin BE +3" "A fold copyout BE"; do
  892:     n=$(count "$FOLDLOG" "^$v  .*ok$")
  893:     check "  fold-marker row: $v" "$n" 1
  894: done
  895: 
  896: for v in "A wb word post1 unal x10" "A wb word post1 algn x10" \
  897:          "A wb word post4 unal" "A wb word pre4 unal gen" \
  898:          "A wb word pre4 unal fast" "A wb word postneg4 unal" \
  899:          "A wb store post1 unal x10" "A wb regofs post1 unal x10" \
  900:          "A wb halfword post1 unal" "A wb word post4 algn" \
  901:          "A wb algn load data" "A wb byte post1 unal" \
  902:          "A wb word pre4 no wb" "A wb wrap from zero" \
  903:          "A wb rot word unal plus1" "A wb rot word unal plus2" \
  904:          "A wb rot word unal plus3" \
  905:          "A wb rot word cold plus1" "A wb rot word cold plus2" \
  906:          "A wb rot word cold plus3" \
  907:          "A wb word ldrt post4 unal" "A wb word cold pre4 unal"; do
  908:     n=$(count "$WBLOG" "^$v  .*ok$")
  909:     check "  writeback row: $v" "$n" 1
  910: done
  911: 
  912: # #372: the general-path word STORE ignored cpu->byte_order.
  913: # ----------------------------------------------------------------------------
  914: # Its arm was UNCONDITIONALLY EMPTY -- guard `!A__B && !A__H && HOST_LE` with an
  915: # `#ifdef A__STRD`-only body, and A__STRD implies A__H, which the guard excludes.
  916: # So a plain word STR on an LE host emitted no bytes and memory_rw copied the
  917: # register's HOST bytes; the FAST path was always order-aware, so one STR wrote
  918: # guest order to a warm page and host order to a cold one, and every strt (always
  919: # general on its first access per page) was reversed.
  920: #
  921: # This probe runs BOTH byte orders. The six `be *` rows use -E barearm (BE) and
  922: # are the DISCriminators; the six `le *` rows use -E testarm (LE) and are
  923: # INVARIANCE CONTROLS -- on LE the broken code was accidentally right (host order
  924: # == guest order), so they pin nothing about #372 and exist only to catch a fix
  925: # that repairs BE by breaking LE. The `ldrb` witnesses are the purest form: a
  926: # byte load has no byte order, so it exposes the raw memory layout directly, and
  927: # the buggy column is the exact reverse of the arch column.
  928: #
  929: # #372's original sweep (its SIX BE + six LE rows): pre-fix 7 of 12 -- the five
  930: # cold BE rows red at the host-order values, the warm control and LE controls
  931: # green. Fixed: 12/12. #378 grew the section to 34 rows (22 BE / 12 LE) with the
  932: # INVERTED polarity -- its sweep numbers are in the named-row comment below; the
  933: # 12-row narrative above this line is #372 history, scoped as such by #379.
  934: # #386 grew it to 58: swp (the last word-sized ARM memory handler, LE-only on
  935: # both sides + raw unmasked address) and its swpb/aligned-LE/by-construction
  936: # controls; sweep numbers in the named-row comment below.
  937: ENDLOG=$LOGDIR/gate_arm_endian.log
  938: python3 arm_endian_probe.py "$PMAX" > "$ENDLOG" 2>&1 || true
  939: 
  940: if ! grep -q "ENDIAN_RESULT=" "$ENDLOG"; then
  941:     note "endian probe produced no result line; last lines follow"
  942:     tail -5 "$ENDLOG" | sed 's/^/       /'
  943:     gate_skip "endian probe did not complete"
  944: fi
  945: 
  946: grep -E " ok$| FAIL$" "$ENDLOG" | sed 's/^/       /'
  947: 
  948: # The control is the BE cold-word row's SIBLING warm row: it demands a
  949: # distinctive nonzero word through the order-aware fast path, proving the BE rig
  950: # (barearm) constructed and the program ran, before any DISC row is believed.
  951: ectrl=$(grep -o "ENDIAN_CONTROL=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  952: check "endian control: BE rig ran and stored" "${ectrl:-missing}" "OK"
  953: 
  954: # #378's own liveness pin: the multi-transfer cold rows go through bdt_*, which
  955: # swaps on EVERY build, so they read arch values on buggy and fixed builds
  956: # alike -- a dead rig, wrong register field or non-firing LDM reads 0/sentinel
  957: # instead. Distinct from ENDIAN_CONTROL so the two extensions fail separately.
  958: ectrl378=$(grep -o "ENDIAN_CONTROL378=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  959: check "endian control: multi rows ran (378)" "${ectrl378:-missing}" "OK"
  960: 
  961: # #379: the warm DISC rows depend on `put w` having warmed the pages, and a
  962: # silently failing put would flip them all to a FALSE GREEN on a buggy build
  963: # (bdt_* is architecturally correct on both arms). The probe checks every
  964: # put's echo for the debugger's FAILED marker.
  965: eputs=$(grep -o "PUT_STATUS=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  966: check "endian puts all landed (379)" "${eputs:-missing}" "OK"
  967: 
  968: eres=$(grep -o "ENDIAN_RESULT=[0-9]*/[0-9]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  969: egot=${eres%/*}; ewant=${eres#*/}
  970: #  #389's liveness pin: the LE LDRD/STRD rows are fix-state-independent (LE
  971: #  was always correct) and read the sentinel 0 if the instructions are dead.
  972: ectrld=$(grep -o "ENDIAN_CONTROL_D=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  973: #  #389 pass-2 (Opus seat): the name used to read "ldrd/strd ran", which
  974: #  overclaimed -- BOTH pins behind ENDIAN_CONTROL_D are on the LE rig
  975: #  (testarm), so nothing here pins that LDRD/STRD executed on barearm. That is
  976: #  not a fixable omission: a liveness pin must be fix-state-INDEPENDENT, and on
  977: #  BE every LDRD/STRD row changes value with the fix by construction. The BE
  978: #  side is still fail-closed -- a dead BE rig reddens its ten DISC rows -- but
  979: #  the NAME must say what it actually pins.
  980: check "endian control: ldrd/strd ran on the LE rig (389)" "${ectrld:-missing}" "OK"
  981: 
  982: check "endian rows run"     "${ewant:-missing}" 102
  983: check "endian rows correct" "${egot:-missing}"  "$ewant"
  984: 
  985: # The BE discriminators named individually, so one reverting cannot hide
  986: # behind the total. #372's DISC rows are the COLD ones (general path was
  987: # wrong); #378's DISC rows are the WARM ones (LDM/STM fast path was wrong) --
  988: # the inverted polarity is the point, and the probe carries explicit per-row
  989: # kinds for exactly that reason. Swept against the pre-#378 build: 24/34, the
  990: # ten warm multi rows red at exactly the per-word-reversed values. Fixed: 34/34.
  991: # #386 grew the section 34 -> 58 (swp/swpb; X(swp) was LE-only both sides and
  992: # unrotated/unmasked). Swept against the pre-#386 build: 42/58, all 16 DISC
  993: # rows red at exactly the predicted buggy values. Fixed: 58/58. The LE unal
  994: # rows are DISC too (the manual's rotation is endian-independent, so the fix
  995: # MOVES them); "swp be unal b2" is arch==buggy by construction (bits[15:8]
  996: # lands at P+2 under both the buggy +1-shifted LE write and the fixed BE
  997: # write) and is deliberately NOT in this list.
  998: # #387 grew it 58 -> 70: the +2 offset groups, because three wrong forms
  999: # AGREE with the shipped code at +1 and aligned -- `8*(addr&1)`, a raw-odd
 1000: # rotate guard, and an `addr &= ~1` mask -- and all three passed the 58-row
 1001: # set (the fold-marker probe's three-offsets rule). Every +2 row is DISC
 1002: # (the +1 b2 collision does not recur at +2). Measured: each hole-mutant
 1003: # reddens the +2 rows while the +1 rows stay green (68/68/58 of 70).
 1004: # The pattern below also pins each named row's KIND (DISC): re-typing a red
 1005: # discriminator as CTRL with arch=buggy would otherwise keep the name green
 1006: # -- the "shipped fix with no detector" vacuity mode, closed for free here.
 1007: for v in "be cold word" "be cold byte0" "be cold byte1" \
 1008:          "be cold byte2" "be cold byte3" \
 1009:          "be stm warm b0" "be stm warm b1" "be stm warm b2" "be stm warm b3" \
 1010:          "be stm warm b4" "be stm warm b5" "be stm warm b6" "be stm warm b7" \
 1011:          "be ldm warm r1" "be ldm warm r2" \
 1012:          "swp be word" "swp be b0" "swp be b1" "swp be b2" "swp be b3" \
 1013:          "swp be unal r2" "swp be unal b0" "swp be unal b1" \
 1014:          "swp be unal b3" "swp be unal sent" \
 1015:          "swp le unal r2" "swp le unal b0" "swp le unal b1" \
 1016:          "swp le unal b2" "swp le unal b3" "swp le unal sent" \
 1017:          "swp be un2 r2" "swp be un2 b0" "swp be un2 b1" \
 1018:          "swp be un2 b2" "swp be un2 b3" "swp be un2 sent" \
 1019:          "swp le un2 r2" "swp le un2 b0" "swp le un2 b1" \
 1020:          "swp le un2 b2" "swp le un2 b3" "swp le un2 sent" \
 1021:          "ldrd be r4" "ldrd be r5" \
 1022:          "strd be b0" "strd be b1" "strd be b2" "strd be b3" \
 1023:          "strd be b4" "strd be b5" "strd be b6" "strd be b7" \
 1024:          "390 be base +8" "390 be base +12" \
 1025:          "390 le base +8" "390 le base +12" \
 1026:          "390 be bothpc" "390 le bothpc"; do
 1027:     n=$(count "$ENDLOG" "^$v  *DISC .*ok$")
 1028:     check "  endian row: $v" "$n" 1
 1029: done
 1030: 
 1031: #  #390's CTRL rows, pinned by name so they cannot be quietly retyped or
 1032: #  dropped -- a DISC pattern would never match them.  Two different reasons:
 1033: #
 1034: #  the DATA-role rows must pass on the PRE-fix build too, because they do not
 1035: #  detect the defect; they detect a WRONG FIX that moves the stored R15 value
 1036: #  off +12, which A2-9 forbids doing for some R15 stores and not others.
 1037: #
 1038: #  the LDRD rows are CTRL because the round's original claim about them was
 1039: #  REFUTED by measurement: LDRD's base was never +12.  They began as DISC with
 1040: #  a `buggy` column that turned out to be fiction -- the mutant battery left
 1041: #  them green, and the actual pre-#390 parent reads the same values the fixed
 1042: #  build does.  They are kept as standing evidence that LDRD with Rn == PC is
 1043: #  unaffected, and they will redden if a future round drags it into that path.
 1044: for v in "390 be data +12" "390 le data +12" \
 1045:          "390 be ldrd r0" "390 be ldrd r1" \
 1046:          "390 le ldrd r0" "390 le ldrd r1"; do
 1047:     n=$(count "$ENDLOG" "^$v  *CTRL .*ok$")
 1048:     check "  endian row: $v" "$n" 1
 1049: done
 1050: 
 1051: # ---------------------------------------------------------------------------
 1052: #  #432: THE FOOTBRIDGE'S FIRST REACHABILITY WITNESS OF ANY KIND.
 1053: #
 1054: #  Recorded before this probe existed: R6 was the ONLY code round in this tree with no
 1055: #  reachability witness -- no rig boots a footbridge machine and there is no m8online analog.
 1056: #  regress/diff_footbridge.c calls the device functions DIRECTLY, so it proves BEHAVIOUR and
 1057: #  would stay green under a change that unmapped the device entirely.  This drives real guest
 1058: #  ldr/str through the real address decode and the real memory_rw plumbing on a COLD DEBUGGER:
 1059: #  measured 1.9 s for three arms, against a rig boot this tree does not have at all.
 1060: #
 1061: #  IT LIVES HERE, in the ARM gate, for the same reason m8820x_sites_probe.py lives in
 1062: #  gate_m88k_rounding.sh: `cats` is an ARM machine and this gate already writes the four-byte
 1063: #  raw stub that makes such a machine construct.  A new gate script would move GATE_MANIFEST,
 1064: #  which is a bigger claim than one probe is worth.
 1065: #
 1066: #  THE TRAP IT GUARDS, and it nearly produced a confident wrong answer.  machine_cats.c:131
 1067: #  maps only the low 256 MB and the footbridge is at PA 0x42000000, so under the boot-time MMU
 1068: #  every device row reads 0x0 WITH A RAM LIVENESS ROW STILL GREEN -- which is exactly what an
 1069: #  absent device looks like.  The probe's arm T runs the same program with the MMU-disable
 1070: #  instructions replaced by nops and requires that it CANNOT produce the device's answer; arm L
 1071: #  reads CP15 c1 back and requires bit 0 clear.  Negative-controlled in both directions.
 1072: FBLOG=$LOGDIR/footbridge_sites.log
 1073: python3 footbridge_sites_probe.py "$PMAX" "$STUB" > "$FBLOG" 2>&1 || true
 1074: grep -E "^(  arm |C[0-9]|A[0-9]|I1|K1|D1)" "$FBLOG" | sed 's/^/       /'
 1075: 
 1076: if ! grep -q "FOOTBRIDGE_SITES_" "$FBLOG"; then
 1077:     note "footbridge probe produced no verdict; last lines follow"
 1078:     tail -5 "$FBLOG" | sed 's/^/       /'
 1079:     check "footbridge probe completed" "no" "yes"
 1080: else
 1081:     #  THE CONTROL FIRST, and separately from the verdict.  A probe whose controls failed has
 1082:     #  measured NOTHING, and this one has a control that a liveness row cannot substitute for.
 1083:     check "footbridge: controls prove the probe measures" \
 1084:           "$(grep -c 'FOOTBRIDGE_SITES_CONTROL=OK' "$FBLOG")" "1"
 1085:     check "footbridge: every row green" \
 1086:           "$(grep -c 'FOOTBRIDGE_SITES_PASS' "$FBLOG")" "1"
 1087:     #  VALUES, NOT SURVIVAL.  0x1011 is DC21285_VENDOR_ID (dev_footbridge.c:423) and can only
 1088:     #  have come back through this device; an unmapped read survives too, it just returns 0.
 1089:     check "footbridge: VENDOR_ID 0x1011 through a real guest ldr" \
 1090:           "$(grep -cE '^A1 .*got=0x00001011 .*ok$' "$FBLOG")" "1"
 1091:     #  The vanishing top byte IS the handler's signature: :548 stores idata & TIMER_MAX_VAL.
 1092:     #  RAM, or any decode that merely absorbed the store, returns 0x12345678 unchanged.
 1093:     check "footbridge: TIMER_1_LOAD masked to 24 bits by the handler" \
 1094:           "$(grep -cE '^A2 .*got=0x00345678 .*ok$' "$FBLOG")" "1"
 1095:     #  THE PROBE'S OWN FAILABILITY CONTROL.  Arms L and K differ by ONE instruction; K reads
 1096:     #  IRQ_ENABLE_SET, an UNFIXED fatal()+exit(1) at :495-497.  Without it, "SURVIVED" on every
 1097:     #  row is satisfied by a probe whose guest code never reached the device at all.
 1098:     check "footbridge: the one-instruction kill arm still dies" \
 1099:           "$(grep -cE '^K1 .*ok$' "$FBLOG")" "1"
 1100:     #  The defence against the hand-assembled-encoding trap: every planted word is compared
 1101:     #  against the disassembly the emulator printed AS IT STEPPED IT.
 1102:     check "footbridge: no planted word failed its disassembly check" \
 1103:           "$(grep -c 'DISASSEMBLY MISMATCH' "$FBLOG")" "0"
 1104: fi
 1105: 
 1106: #  ---------------------------------------------------------------------------------------
 1107: #  #439/#440 PIT 8253 latch + LSB/MSB selector -- pitlatch / pitclobber.
 1108: #
 1109: #  WIRED HERE, ALONGSIDE footbridge_sites_probe.py, BECAUSE gate_hygiene.sh SAID SO.  Its
 1110: #  own 17 -> 18 bump note reads: "Wiring it into gate_arm.sh alongside
 1111: #  footbridge_sites_probe.py is the follow-up, and it wants an operator who can run that
 1112: #  gate."  The probe execs `-E cats` and hand-assembles ARM, so this is the only gate whose
 1113: #  machine it shares.
 1114: #
 1115: #  *** IT SHIPPED UNWIRED AND THE CARRIER SAID WHY THAT IS DANGEROUS: an unwired probe is
 1116: #  exactly what shipped latent in cf4b083. ***  It has been dated-exempt in
 1117: #  check_probe_wiring.py until 2026-09-20 (`wiringcliff`), and this discharges that debt --
 1118: #  the exemption line comes out in the same edit, which is what stops a stale exemption
 1119: #  outliving its cause.
 1120: #
 1121: #  CONTROLS FIRST AND SEPARATELY.  The probe's own header says it: "CONTROLS (if any is RED
 1122: #  every row below is meaningless)".  C1 is a RAM liveness through the same decode, C2 reads
 1123: #  CP15 c1 back to prove the MMU really went off, A1 is a device signature -- and arm T is
 1124: #  the negative control that runs the same program with the MMU-disable instructions
 1125: #  replaced by nops and requires it CANNOT produce the device's answer.  Under the boot-time
 1126: #  MMU the low 256 MB alone is mapped, so a device row reads 0x0 WITH A LIVENESS ROW STILL
 1127: #  GREEN, which is indistinguishable from an absent device.  That is why C2 and T exist and
 1128: #  why a liveness row cannot stand in for them.
 1129: #  ---------------------------------------------------------------- #497 widthkillclass
 1130: #  *** THIS PROBE IS FOR AN SGI/MIPS MACHINE AND IT IS WIRED INTO THE GATE NAMED `arm`.
 1131: #  That is following a precedent, not endorsing it. ***  This gate already runs
 1132: #  footbridge_sites_probe.py and pit8253_latch_probe.py -- neither of which is an ARM
 1133: #  instruction test either -- so it has become the tree's general DEVICE-probe gate by
 1134: #  accretion.  *** BUT THOSE TWO AT LEAST RUN THIS GATE'S OWN `-E cats` MACHINE, AND
 1135: #  THIS ONE DOES NOT: it is the FIRST probe here on a foreign machine AND CPU family.
 1136: #  The PIT wiring comment says outright that it was placed here BECAUSE this is the only
 1137: #  gate whose machine it shares. ***  So this is not a third instance of an existing
 1138: #  accretion; it is a new kind of one, and the sentence above is true while its
 1139: #  implication was generous to the decision it defends.  The architecture-named alternative, gate_mips.sh, is an 82-line RIG-BOOT
 1140: #  gate with no probe infrastructure at all; putting a 35-row detector there would change
 1141: #  what that gate is for.
 1142: #
 1143: #  Recorded rather than silently compounded: the right answer is a gate_devices.sh split,
 1144: #  which is a harness round of its own and owes its own controls.  FILED as
 1145: #  `gatedevicesplit`, with a forcing criterion: the NEXT device probe wired into
 1146: #  this gate converts it from filed to OWED.
 1147: #  *** #498 sgidewidth.  WIRING THIS PROBE FIRES A PRE-SPECIFIED TRIGGER, AND THE TRIGGER
 1148: #  IS HONOURED RATHER THAN QUIETLY PASSED. ***  The #497 block below filed `gatedevicesplit`
 1149: #  with a forcing criterion in its own words: "the NEXT device probe wired into this gate
 1150: #  converts it from filed to OWED."  This is that probe.  The row is moved to OWED in the
 1151: #  same commit -- a criterion that fires and is ignored is worse than one never written,
 1152: #  because the next reader trusts it.
 1153: #
 1154: #  It is wired HERE anyway, and deliberately: the split is a harness round owing its own
 1155: #  controls, and holding a HIGH device fix hostage to a gate refactor would be the tail
 1156: #  wagging the dog.  What is NOT acceptable is compounding it silently.
 1157: DEWLOG=$LOGDIR/sgi_de_width.log
 1158: python3 sgi_de_width_probe.py "$PMAX" gate > "$DEWLOG" 2>&1 || true
 1159: 
 1160: #  SENTINEL FIRST -- a preserved log is verified by its completion sentinel, never by its
 1161: #  existence.  A killed run loses every row and looks exactly like one that produced none.
 1162: if ! grep -q "OPUS498T_DONE" "$DEWLOG"; then
 1163:     note "sgi_de width probe did not reach its completion sentinel; last lines follow"
 1164:     tail -5 "$DEWLOG" | sed 's/^/       /'
 1165:     check "sgi_de width probe completed" "no" "yes"
 1166: else
 1167:     check "sgi_de width probe completed" "yes" "yes"
 1168: 
 1169:     #  CONTROLS BY NAME.  A detector whose liveness and device-signature rows are dead
 1170:     #  scores well on a corpse: every access row would read "no message" and pass.
 1171:     check "sgi_de controls live+devsig" \
 1172:           "$(grep -q 'OPUS498T_CONTROL=OK' "$DEWLOG" && echo yes || echo no)" "yes"
 1173: 
 1174:     #  PER-ROW PASS, one line, checked individually.  A row that silently stops being
 1175:     #  tested is the padded-column class -- a name as long as its column makes the check
 1176:     #  unsatisfiable and the row quietly stops being tested.
 1177:     #  *** `tail_acc_x' PINS A HOST DEATH ON PURPOSE AND WILL GO RED BY SUCCEEDING. ***
 1178:     #  It observes `sgideprimop' -- an accepted-width access with startFlag reaches
 1179:     #  draw_primitive(), whose default arm is fatal on 254 of 256 top-byte op classes,
 1180:     #  two of which (POINT 0x00, TRIANGLE 0x02) are DOCUMENTED primitives.
 1181:     #
 1182:     #  *** THE BLAST RADIUS HAS THREE TIERS, NOT ONE, AND THIS NOTE SAID `BOTH ROWS' UNTIL
 1183:     #  2026-08-31.  Corrected after the grok seat read the oracles against the code paths
 1184:     #  they exercise and found the overstatement. ***
 1185:     #
 1186:     #    tail_acc_x            CERTAIN red -- wants exit1, and the fix removes the death.
 1187:     #    tail_acc              CONDITIONAL -- it counts the DRAW message SUBSTRING and
 1188:     #                          wants 1.  A fix that LATCHES the text without REWORDING it
 1189:     #                          still prints the first occurrence, so the row stays GREEN.
 1190:     #                          It reds only if the message is reworded.
 1191:     #    hi_draw, hi_rd_draw   NEITHER red NOR safe.  Both want count(DRAW) == 0, so a
 1192:     #                          REWORD leaves them green because the string no longer
 1193:     #                          exists -- GREEN FOR THE WRONG REASON, i.e. VACUOUS BY
 1194:     #                          CONSTRUCTION.  A reword silently blinds them; it does not
 1195:     #                          fail them, and nothing would say so.
 1196:     #
 1197:     #  *** SO THE DESIGN CONSTRAINT IS: KEEP THE MESSAGE TEXT AND ADD `(once)'. ***  That
 1198:     #  costs ONE oracle re-pin (tail_acc_x).  Rewording costs two re-pins AND silently
 1199:     #  blinds two further rows -- which is the worse half and is invisible to any gate.
 1200:     #  *** AND THE OBVIOUS RE-PIN IS A TRAP.  DO NOT RE-PIN `tail_acc_x' ONTO `"exit0"'. ***
 1201:     #  Adjudicated 2026-08-31 by the flagship seat, which traced the channel rather than the
 1202:     #  intent.  The row wants `exit1' today; the natural correction is `exit0' ("the host now
 1203:     #  survives").  Trace what that oracle can see:
 1204:     #
 1205:     #    a future one-token death reinstatement -- `exit(0)' at the default arm instead of
 1206:     #    `exit(1)' -- prints the announce once and then DIES.  `how' is then "exit0", so a
 1207:     #    re-pinned tail_acc_x reads GREEN; `tail_acc' still counts its one message, GREEN;
 1208:     #    and no other session reaches draw_primitive() at all.  TOTAL ESCAPE, 29/29.
 1209:     #
 1210:     #  So the re-pin would MINT, at the exact site being fixed, the exact blindness the queue
 1211:     #  row `exit0oracle' was filed to describe: EXIT STATUS CANNOT VARY between `declined and
 1212:     #  then quit' and `died with status 0'.  That is knowable at WRITING time from the CHANNEL
 1213:     #  check -- name the mutant a row kills and the observable that differs under it -- and it
 1214:     #  is why that check is run before the table, not after.
 1215:     #
 1216:     #  RE-PIN ONTO A POSITIVE POST-DRAW OBSERVABLE INSTEAD: extend the session with a load
 1217:     #  through the device and assert the VALUE (`printed()' already exists in the probe and
 1218:     #  reads "died" when the host is gone).  An exit-status row may stay as a SECOND channel;
 1219:     #  the value row is the load-bearing one.  This is L1 -- a row under construction -- so
 1220:     #  there is no stopping-rule tension in fixing it in-round.
 1221:     #
 1222:     #  The fixing round therefore owes a FOURTH mutant beside the three already enumerated:
 1223:     #  death-by-`exit(0)' at the default arm, which the re-pinned row must kill.
 1224:     #
 1225:     #  Oracle-correction ordering applies -- re-pin FIRST, measure the committed build red,
 1226:     #  THEN edit.  Without this note the red reads as a regression in THIS device.
 1227:     for v in "live" "devsig" "lo_kill" "lo_decl" "lo_alive" "lo_sent" "lo_latch" "lo_kill2" "lo_decl2" "lo_alive2" "lo_sent2" "hi_draw" "hi_alive" "hi_rd_draw" "hi_rd_alive" "hi_rd_sent" "two_widths_n" "two_widths_1" "two_widths_2" "dec_switch" "hi_kill" "tail_acc" "tail_acc_x" "tail_acc_h" "acc4_last" "acc8_hi32" "acc8_lo32" "acc8_read" "re_first" "sharedlatch"; do
 1228:         check "sgi_de row: $v" "$(count "$DEWLOG" "^$v  .*ok$")" "1"
 1229:     done
 1230: 
 1231:     #  DENOMINATOR, SUMMED ARITHMETICALLY.  Two rows, not one: a single "22 ok" check
 1232:     #  cannot tell a LOST row from a FAILING one, and those need different responses.
 1233:     #  The sum is arithmetic rather than a string join -- concatenating two counts and
 1234:     #  comparing to "220" is satisfied by (22 ok, 0 FAIL) AND by (2 ok, 20 FAIL), which
 1235:     #  is a defect this gate has already shipped once.
 1236:     check "sgi_de rows emitted" \
 1237:           "$(( $(count "$DEWLOG" " ok$") + $(count "$DEWLOG" " FAIL$") ))" "30"
 1238:     check "sgi_de rows green" "$(count "$DEWLOG" " ok$")" "30"
 1239: fi
 1240: 
 1241: SGILOG=$LOGDIR/sgi_re_width.log
 1242: python3 sgi_re_width_probe.py "$PMAX" gate > "$SGILOG" 2>&1 || true
 1243: 
 1244: #  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
 1245: #  existence: a killed run loses every row and looks exactly like a run that produced none.
 1246: if ! grep -q "OPUS497T_DONE" "$SGILOG"; then
 1247:     note "sgi_re width probe did not reach its completion sentinel; last lines follow"
 1248:     tail -5 "$SGILOG" | sed 's/^/       /'
 1249:     check "sgi_re width probe completed" "no" "yes"
 1250: else
 1251:     grep -E " ok$| FAIL$" "$SGILOG" | sed 's/^/       /'
 1252: 
 1253:     #  CONTROLS BY NAME, not by count.  A green-row total lets a control go red while the
 1254:     #  sum stays acceptable -- and a run whose controls died is an APPARATUS failure, which
 1255:     #  must not be read as a wall of product failures.
 1256:     for c in "live" "live64" "devsig stat"; do
 1257:         check "sgi_re control: $c" "$(count "$SGILOG" "^$c  .*ok$")" "1"
 1258:     done
 1259:     check "sgi_re controls live" \
 1260:           "$(grep -q 'OPUS497T_CONTROL=OK' "$SGILOG" && echo yes || echo no)" "yes"
 1261: 
 1262:     #  PER-ROW PASS.  Checked individually rather than by a total, because a row that
 1263:     #  silently stops being tested is the padded-column class: a name as long as its column
 1264:     #  makes a check UNSATISFIABLE and the row quietly stops being tested.
 1265:     #  The list is ONE LINE on purpose -- a backslash-continued list assembled through
 1266:     #  nested quoting once gained a bogus word `n` and shipped a RED gate.
 1267:     for v in "live" "devsig stat" "tlb_a sw surv" "tlb_a sw lat1" "tlb_a lw surv" "tlb_a accept" "tlb_b sw surv" "tlb_b sw lat1" "tlb_b lw surv" "tlb_b accept" "tlb_c sw surv" "tlb_c sw lat1" "tlb_c lw surv" "tlb_c accept" "tex sw surv" "tex sw lat1" "tex lw surv" "tex accept" "linear_a sw surv" "linear_a sw lat1" "linear_a lw surv" "linear_a accept" "linear_b sw surv" "linear_b sw lat1" "linear_b lw surv" "linear_b accept" "xsite 6msg" "xsite order" "other decl" "live64" "tlb_a ld lo" "tlb_a ld hi" "tlb_b ld lo" "tlb_b ld hi" "tlb_c ld lo" "tlb_c ld hi" "linear_a ld lo" "linear_a ld hi" "linear_b ld lo" "linear_b ld hi" "tex ld lo" "tex ld hi" "tex rd lat1" "tex xbit" "tex/unmap" "unmap/tex"; do
 1268:         check "sgi_re row: $v" "$(count "$SGILOG" "^$v  .*ok$")" "1"
 1269:     done
 1270: 
 1271:     #  DENOMINATOR PINNED TO A LITERAL.  A detector that loses rows must not be able to pass
 1272:     #  by shrinking, and the count is the only thing that says so.  Raise it DELIBERATELY.
 1273:     #  Both halves pinned: 46 rows emitted AND all 46 green.
 1274:     #  *** RAISED 44 -> 46 ON THIS ROUND'S OWN PASS 2. ***  The panel found a clause-(d)
 1275:     #  floor breach: giving the TEX read decline an already-used NON-LEN latch bit
 1276:     #  (1 << 8 = SGIRE_W_UNMAP_RD) escapes a 44/44 sweep, because the detector's four
 1277:     #  TEX-read scenarios and its unmapped-read scenario never share an emulator instance
 1278:     #  -- `tex xbit' set bits 0-5 only AT THAT TIME (it now fires 0-10).  Repaired by two
 1279:     #  SAME-INSTANCE rows asserting both
 1280:     #  announces fire, in BOTH orderings; one ordering would leave the mirror open.
 1281:     #  *** RAISED 35 -> 44 BY #513, DELIBERATELY, IN THE SAME COMMIT AS THE FIX. ***
 1282:     #  The six `<arm> ld kill' rows are GONE -- they asserted that a len == 8 READ still
 1283:     #  ends the host at each window, which was true until #513 removed those kills.  They
 1284:     #  are replaced by TWO anchored ACCEPT rows per accepting arm (window base AND last
 1285:     #  slot, because a row at the base tests the near bound twice and the far bound never),
 1286:     #  four CRIME_RE_TEX decline rows, and a 64-bit liveness control.  Arithmetic:
 1287:     #  35 - 6 + 14 + 1 = 44.  Two rows rather than one,
 1288:     #  because a single "35 ok" check cannot tell a LOST row from a FAILING one -- and
 1289:     #  those need different responses.
 1290:     #  *** THE FIRST DRAFT OF THIS BLOCK HAD TWO DEFECTS, BOTH FOUND BY THE PASS-2 SEAT.
 1291:     #  (1) It ended in `|| true`, which is INERT: check() in lib.sh has no `return`, so
 1292:     #  it exits 0 on BOTH branches and the row counts into _fails regardless.  The
 1293:     #  suppression never existed -- but a reader would conclude that row was advisory,
 1294:     #  which is worse than either behaviour on its own.
 1295:     #  (2) The denominator concatenated two counts and compared to "350" -- satisfied by
 1296:     #  (35 ok, 0 FAIL) AND by (3 ok, 50 FAIL).  A string join is not an arithmetic
 1297:     #  identity, and it was redundant with the two rows below it anyway. ***
 1298:     #  *** AND THE FIRST REPAIR OF (2) REPRODUCED THE VERY DEFECT THE PANEL HAD JUST FOUND
 1299:     #  IN THIS ROUND'S BRIEF.  I wrote `count "$SGILOG" " ok$| FAIL$"` -- but count() is
 1300:     #  `grep -ac`, PLAIN grep, so `|` is a LITERAL and the pattern matches NOTHING.
 1301:     #  Measured: 0 against a log holding 35 rows.  The seats had flagged `grep -i
 1302:     #  'sgi|width'` in the brief for exactly this, one hour earlier. ***
 1303:     #
 1304:     #  Summed ARITHMETICALLY instead, which needs no regex dialect at all -- and unlike the
 1305:     #  string-concatenation form it replaces, it cannot be satisfied by (3 ok, 50 FAIL).
 1306:     check "sgi_re rows emitted" \
 1307:           "$(( $(count "$SGILOG" " ok$") + $(count "$SGILOG" " FAIL$") ))" "46"
 1308:     check "sgi_re rows green"   "$(count "$SGILOG" " ok$")"   "46"
 1309:     check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
 1310: 
 1311: fi
 1312: 
 1313: #  ---- *** MOVED OUT ONE NESTING LEVEL, 2026-08-31.  It was pasted INSIDE the
 1314: #  ---- sgi_re_width probe's success branch, so if THAT probe missed its sentinel this
 1315: #  ---- block was never invoked at all -- 28 rows, three denominators and its own
 1316: #  ---- sentinel check evaporating while the gate reported one red row about a
 1317: #  ---- different probe.  Silent coverage loss, and it defeated the very sentence
 1318: #  ---- that justified the block (a committed detector no gate runs is a wrong
 1319: #  ---- record).  Both sibling blocks sit at depth 0; the block's own zero
 1320: #  ---- indentation was the tell that it had been written top-level and pasted
 1321: #  ---- into a branch.  Found by the #499 pass-2 seat walking the brace depth. ***
 1322: #  ---- #499's detector for the unmatched-address catch-all.  Wired IN THE SAME COMMIT as
 1323: #  ---- the fix: a committed detector that no gate runs is a wrong record under the vacuity
 1324: #  ---- floor's contract clause, and this one measured 18/28 on the pre-fix build and 28/28
 1325: #  ---- on the fix, so it carries its own test-first evidence.
 1326: #  ---- the coordinator's file.  Modelled on the sgi_re_width_probe block -- find it
 1327: #  ---- with `grep -n 'sgi_re_width_probe.py "$PMAX"' gate_arm.sh`, NOT by line
 1328: #  ---- number: the original citation said :1131, which is inside the sgi_de comment,
 1329: #  ---- and this block has since moved once already.  A same-file line citation is
 1330: #  ---- invalidated by your own edits to that file.
 1331: UNMLOG=$LOGDIR/sgi_re_unmapped.log
 1332: python3 sgi_re_unmapped_probe.py "$PMAX" gate > "$UNMLOG" 2>&1 || true
 1333: 
 1334: #  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
 1335: #  existence: a killed run loses every row and looks exactly like a run that produced none.
 1336: if ! grep -q "OPUS499T_DONE" "$UNMLOG"; then
 1337:     check "sgi_re unmapped probe completed" "no" "yes"
 1338: else
 1339:     check "sgi_re unmapped probe completed" "yes" "yes"
 1340:     check "sgi_re unmapped controls" "$(count "$UNMLOG" '^OPUS499T_CONTROL=OK$')" "1"
 1341:     for v in "live" "devsig" "wr surv" "wr kill" "wr decl" "rd surv" "rd kill" "rd decl" "rd sent" "rd nodbe" "wr lat1" "rd lat1" "wr rd 2msg" "xwin7 pre" "xwin wr" "xwin rd" "tlba acc lo" "tlba acc hi" "tlbb acc lo" "tlbb acc hi" "tlbc acc lo" "tlbc acc hi" "tex acc lo" "tex acc hi" "lina acc lo" "lina acc hi" "linb acc lo" "linb acc hi" "wr narrow surv" "wr narrow decl" "rd narrow surv" "rd narrow sent" "clip surv" "clip decl" "clip nar surv" "clip nar decl" "clip rd surv" "clip rd decl" "clip rd sent" "clip rdn surv" "clip rdn decl" "cliphi rd surv" "cliphi rd decl" "cliphi wr surv" "cliphi wr decl" "rd narrow decl" "wr zero surv" "wr zero decl" "wr then live" "clip wr live"; do
 1342:         check "sgi_re unmapped row: $v" "$(count "$UNMLOG" "^$v  .*ok$")" "1"
 1343:     done
 1344: 
 1345:     #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one: a single "28 ok" check
 1346:     #  cannot tell a LOST row from a FAILING one, and those need different responses.
 1347:     check "sgi_re unmapped rows emitted" \
 1348:           "$(( $(count "$UNMLOG" " ok$") + $(count "$UNMLOG" " FAIL$") ))" "50"
 1349:     check "sgi_re unmapped rows green" "$(count "$UNMLOG" " ok$")"   "50"
 1350:     check "sgi_re unmapped rows red"   "$(count "$UNMLOG" " FAIL$")" "0"
 1351: fi
 1352: 
 1353: #  ---- sgirandompixel: horrible_getputpixel()'s unimplemented-mode arm.
 1354: #
 1355: #  WHAT THIS PROTECTS.  That arm used to do `*color = random()' with its exit(1) commented out, so a failed
 1356: #  pixel GET handed the CALLER a random value and draw_primitive() wrote it to the destination in the same
 1357: #  loop iteration.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes crmfbreg.h documents and extracts to
 1358: #  tlb_mode 5, so it was reachable with a DOCUMENTED mode.  Now declined, with a latched announce.
 1359: #
 1360: #  The probe is BOTH the rung-3 WITNESS (7/8 red on the pre-fix build under the re-pinned oracle, preserved as
 1361: #  artifacts/sgirandompixel/witness_20260906/prefix_repinned_RED.out) and the DETECTOR (kill table in
 1362: #  artifacts/sgirandompixel/killtable/: five mutants, all killed, BASE 8/8 opening and closing).
 1363: #
 1364: #  `lin_b diag once' IS THE ROW THAT NEEDED THE MOST CARE and the reason the probe draws a 1x4 rectangle
 1365: #  rather than a single pixel: with one pixel an UNLATCHED announce also fires exactly once, the count channel
 1366: #  cannot vary, and M_NOLATCH escaped 8/8.  Height rather than width, because LIN_A addressing is
 1367: #  `ofs = x & 4095' -- y is ignored, so four rows rewrite one byte and the VALUE oracle survives.
 1368: RANDLOG=$LOGDIR/sgi_re_randompixel.log
 1369: python3 sgi_re_randompixel_probe.py "$PMAX" gate > "$RANDLOG" 2>&1 || true
 1370: 
 1371: if ! grep -q "SGIRAND_DONE" "$RANDLOG"; then
 1372:     check "sgi_re randompixel probe completed" "no" "yes"
 1373: else
 1374:     check "sgi_re randompixel probe completed" "yes" "yes"
 1375:     check "sgi_re randompixel witness verdict" "$(count "$RANDLOG" '^SGIRAND_WITNESS=PASS$')" "1"
 1376:     #  TWO SPACES AFTER $v, NOT ONE -- the sibling block above uses the same idiom and this block did not,
 1377:     #  which the gate caught on its first run: `lin_b diag' got=2, because `^lin_b diag .*ok$' also matches
 1378:     #  the row `lin_b diag once'.  That is the padded-column trap in its MATCHES-TWO-ROWS direction.
 1379:     #
 1380:     #  The probe prints names with "%-16s" followed by an explicit space, so a name of N chars is followed
 1381:     #  by (16-N)+1 spaces.  The longest name here is `lin_b diag once' at 15, leaving exactly two -- so this
 1382:     #  pattern has ONE CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s"
 1383:     #  in the same diff.
 1384:     #
 1385:     #  *** CORRECTED 2026-09-07 (#505 pass 2, the kimi substitute).  This used to say a name of 16 or
 1386:     #  more makes the pattern "UNSATISFIABLE, which is the same trap in its other, SILENT direction:
 1387:     #  the check stops testing anything and stays green."  THE SILENT PART IS FALSE. ***  `count'
 1388:     #  returns 0, `check' compares 0 against the wanted "1", and 0 != 1 FAILS -- loudly.  Measured
 1389:     #  over rendered rows at lengths 15/16/17.  An unsatisfiable pattern is silent only where a check
 1390:     #  wants ZERO, which no row check here does.  The dangerous direction is the ONE-SPACE form,
 1391:     #  which matched `lin_b diag once' from `lin_b diag' and is what this block was written for.
 1392:     for v in "live" "devsig" "copy lin_a" "lin_b not src" "lin_b is fg" "lin_b alive" "lin_b diag" "lin_b diag once"; do
 1393:         check "sgi_re randompixel row: $v" "$(count "$RANDLOG" "^$v  .*ok$")" "1"
 1394:     done
 1395: 
 1396:     #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one, for the sibling block's reason.
 1397:     check "sgi_re randompixel rows emitted" \
 1398:           "$(( $(count "$RANDLOG" " ok$") + $(count "$RANDLOG" " FAIL$") ))" "8"
 1399:     check "sgi_re randompixel rows green" "$(count "$RANDLOG" " ok$")"   "8"
 1400:     check "sgi_re randompixel rows red"   "$(count "$RANDLOG" " FAIL$")" "0"
 1401: fi
 1402: 
 1403: #  ------------------------------------------------------------ #505 sgirergbroundtrip
 1404: #  horrible_getputpixel()'s RGB GET read buf[1..3] while its RGB PUT writes the three channels at
 1405: #  buf[0..2] and an explicit pad at buf[3] -- so an RGB pixel did not survive its own round trip and
 1406: #  the red channel was dropped.  RGB was the ONLY 32-bit colour mode in the file failing this way.
 1407: #
 1408: #  THE ARM WAS CHOSEN ON EVIDENCE FROM A DIFFERENT DEVICE, which is what makes the warrant
 1409: #  non-circular: dev_sgi_gbe.c's scanout reads the same tile memory back as
 1410: #  (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3], and CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
 1411: #  31..24 / 23..16 / 15..8 -- byte 0 is R and byte 3 is UNUSED.  The pad sits at buf[3] because the
 1412: #  CONSUMER ignores buf[3], not because PUT writes a zero there.
 1413: #
 1414: #  `rgb depth64' IS NOT DECORATION -- IT CLOSES A MEASURED CLAUSE-(d) FLOOR BREACH.  The first kill
 1415: #  table's M6_cond (guard kept, repair conditioned on `bufdepth == 4') scored a CLEAN SWEEP 6/6,
 1416: #  because every session then used BUFDEPTH_32 and the mutant's fix branch was the only one the
 1417: #  detector ever executed.  Its mirror M7_cond8 (exempting bufdepth 8 instead) also dies, so the
 1418: #  WIDTH AXIS is closed rather than the one cell the mutant happened to use.
 1419: #
 1420: #  `rgb samemode' reaches the RGB *PUT* arm, which no other row executes -- every other session is
 1421: #  RGB->RGBA.  Measured, not assumed: M8_put corrupts that arm alone and reds exactly this row.
 1422: RGBLOG=$LOGDIR/sgi_re_rgb.log
 1423: python3 sgi_re_rgb_probe.py "$PMAX" gate > "$RGBLOG" 2>&1 || true
 1424: 
 1425: if ! grep -q "SGIRGB_DONE" "$RGBLOG"; then
 1426:     check "sgi_re rgb probe completed" "no" "yes"
 1427: else
 1428:     check "sgi_re rgb probe completed" "yes" "yes"
 1429:     check "sgi_re rgb witness verdict" "$(count "$RGBLOG" '^SGIRGB_WITNESS=PASS$')" "1"
 1430:     #  TWO SPACES AFTER $v, NOT ONE -- the sibling blocks above were both bitten by the one-space
 1431:     #  form, in both of its directions.  Pre-flighted mechanically for this row set before the gate
 1432:     #  ever ran: no name is a prefix of another, and every pattern matches exactly one rendered row.
 1433:     #
 1434:     #  The probe prints names with "%-16s" plus an explicit space, so a name of N chars is followed
 1435:     #  by (16-N)+1 spaces.  The longest here is `rgb not corrupt' at 15, leaving exactly two -- ONE
 1436:     #  CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s" in the same diff.
 1437:     #
 1438:     #  *** WHAT A TOO-LONG NAME ACTUALLY DOES: IT REDS, LOUDLY.  The sibling block above says it
 1439:     #  "silently stops testing anything while staying green", and an earlier draft of THIS block
 1440:     #  copied that sentence.  It is WRONG, and the pass-2 panel caught it. ***  `count' returns 0
 1441:     #  when the pattern matches nothing, `check' compares that 0 against a wanted "1", and 0 != 1
 1442:     #  FAILS.  Measured over rendered rows at lengths 15/16/17: 15 matches (ok), 16 and 17 match
 1443:     #  nothing (FAIL).  The UNSATISFIABLE direction of this trap is the SAFE one for a want-1 check;
 1444:     #  it is only silent where a check wants ZERO.  The genuinely dangerous direction remains the
 1445:     #  ONE-SPACE form, which matches a LONGER name's row as well and was measured on the sibling.
 1446:     for v in "live" "devsig" "copy lin_a" "rgb chan" "rgb not corrupt" "rgb alive" "rgb samemode" "rgb depth64" "rgb tiled" "rgb tiled64"; do
 1447:         check "sgi_re rgb row: $v" "$(count "$RGBLOG" "^$v  .*ok$")" "1"
 1448:     done
 1449: 
 1450:     #  DENOMINATOR, SUMMED ARITHMETICALLY: a row that stops being emitted at all is otherwise
 1451:     #  invisible -- its named check goes 0, but so does a check for a row that never existed.
 1452:     #  *** THE DENOMINATOR PINNED 8 WHILE THE PROBE EMITTED 9, AND THE ROW LIST NEVER NAMED
 1453:     #  `rgb tiled'.  A pass-3 seat found it by reading the gate against the probe rather than the
 1454:     #  probe against itself. ***  It would have failed LOUDLY -- emitted 9, wanted 8 -- which is the
 1455:     #  safe direction, but it would have shipped, and `rgb tiled' would have been unchecked BY NAME
 1456:     #  while appearing in the count.  Both new rows are named above and the pins are 10.
 1457:     check "sgi_re rgb rows emitted" \
 1458:           "$(( $(count "$RGBLOG" " ok$") + $(count "$RGBLOG" " FAIL$") ))" "10"
 1459:     check "sgi_re rgb rows green" "$(count "$RGBLOG" " ok$")"   "10"
 1460:     check "sgi_re rgb rows red"   "$(count "$RGBLOG" " FAIL$")" "0"
 1461: fi
 1462: 
 1463: #  ------------------------------------------------------------ #500 sgideprimop
 1464: #  draw_primitive()'s default arm ended the host on a guest-written drawing op.
 1465: #  Now a latched decline.  The detector is its OWN probe rather than rows bolted
 1466: #  onto sgi_de_width_probe.py, because that one is about WIDTH and owns the
 1467: #  `tail_acc*' rows that pin draw_primitive's REACHABILITY -- a different claim.
 1468: PRIMLOG=$LOGDIR/sgi_de_primop.log
 1469: python3 sgi_de_primop_probe.py "$PMAX" gate > "$PRIMLOG" 2>&1 || true
 1470: 
 1471: #  SENTINEL FIRST, for the reason the sibling block states: a preserved log is
 1472: #  verified by its completion sentinel, never by its existence.
 1473: if ! grep -q "OPUS500_DONE" "$PRIMLOG"; then
 1474:     check "sgi_de primop probe completed" "no" "yes"
 1475: else
 1476:     check "sgi_de primop probe completed" "yes" "yes"
 1477:     for v in "live" "devsig" "pt surv" "pt live" "pt decl" "tri surv" "tri live" "tri decl" "reset surv" "reset live" "reset decl" "two once" "two live" "rd surv" "rd decl" "xlatch decl" "xlatch live" "xlatch unm" "xlatch unliv" "xlatch all" "xlatch alliv" "xlatch pre" "acc rect" "acc live" "acc rect mod" "acc rect liv" "acc line mod" "acc line liv" "n25 nox" "n25 noxset" "dec b26" "dec b27" "dec b28" "dec b29" "dec b30" "dec b31" "dec hi liv" "dec low" "dec low liv" "dec ops" "dec ops liv" "dec flood" "dec flood liv" "dec regs" "dec regs liv" "dec regs set" "dec regs stip" "n25 rect" "n25 rectliv" "n25 rectset" "n25 line"; do
 1478:         check "sgi_de primop row: $v" "$(count "$PRIMLOG" "^$v  .*ok$")" "1"
 1479:     done
 1480: 
 1481:     #  DENOMINATOR, SUMMED -- a single "19 ok" check cannot tell a LOST row from a
 1482:     #  FAILING one, and those need different responses.
 1483:     check "sgi_de primop rows emitted"           "$(( $(count "$PRIMLOG" " ok$") + $(count "$PRIMLOG" " FAIL$") ))" "51"
 1484:     check "sgi_de primop rows green" "$(count "$PRIMLOG" " ok$")"   "51"
 1485:     check "sgi_de primop rows red"   "$(count "$PRIMLOG" " FAIL$")" "0"
 1486: fi
