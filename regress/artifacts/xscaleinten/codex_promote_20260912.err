  128:     rows = []
  129:     
  130:     def report_row(tag, desc, got, want, ok):
  131:         st = "ok" if ok else "FAIL"
  132:         print(f"{tag:<16} {desc:<48} got={hexs(got):<14} want={hexs(want):<14} {st}")
  133:         rows.append((tag, ok, desc, got, want))
  134:         return ok
  135: 
  136:     # -------------------------------------------------------------
  137:     # ARM D: Value Tracking & Subject Reads
  138:     # -------------------------------------------------------------
  139:     s = Session(BIN)
  140:     for i in range(11):
  141:         s.send(f"r{i}=0xdeadbe{i:02x}")
  142:     s.send(f"r1=0x{S1:08x}")
  143:     s.send("r2=0x00000000")
  144:     s.send(f"r3=0x{S2:08x}")
  145:     s.send(f"r7=0x{TRR0_SEED:08x}")
  146: 
  147:     prog_d = [
  148:         (0x00, 0xEE047611, "mcr 6,0,r7,cr4,cr1,0"),      # seed trr0
  149:         (0x04, 0xEE148611, "mrc 6,0,r8,cr4,cr1,0"),      # read trr0 (CP6 liveness)
  150:         (0x08, 0xEE109610, "mrc 6,0,r9,cr0,cr0,0"),      # read inten at reset (expect 0)
  151:         (0x0C, 0xEE001610, "mcr 6,0,r1,cr0,cr0,0"),      # inten <- S1
  152:         (0x10, 0xEE104610, "mrc 6,0,r4,cr0,cr0,0"),      # read inten (expect S1)
  153:         (0x14, 0xEE002610, "mcr 6,0,r2,cr0,cr0,0"),      # inten <- 0
  154:         (0x18, 0xEE105610, "mrc 6,0,r5,cr0,cr0,0"),      # read inten (expect 0)
  155:         (0x1C, 0xEE003610, "mcr 6,0,r3,cr0,cr0,0"),      # inten <- S2
  156:         (0x20, 0xEE106610, "mrc 6,0,r6,cr0,cr0,0"),      # read inten (expect S2)
  157:         (0x24, 0xEE10A630, "mrc 6,0,r10,cr0,cr0,1"),     # 4th read: opcode2=1 (expect S2)
  158:         (0x28, 0xE3A0005A, "mov r0,#0x5a"),              # continuation marker
  159:         (0x2C, NOP,        "mov r0,r0")                   # landing pad
  160:     ]
  161:     for off, w, _ in prog_d:
  162:         s.send(f"put w 0x{CODE+off:08x}, 0x{w:08x}")
  163:     s.send(f"pc=0x{CODE:08x}")
  164: 
  165:     dest_map = {0x08: 9, 0x10: 4, 0x18: 5, 0x20: 6, 0x24: 10}
  166:     expect_map = {0x08: 0, 0x10: S1, 0x18: 0, 0x20: S2, 0x24: S2}
  167:     pre_snapshots = {}
  168:     post_snapshots = {}
  169:     d_died_at = None
  170: 
  171:     for off, w, dis in prog_d[:-1]:
  172:         if off in dest_map:
  173:             regs_pre = s.get_regs()
  174:             pre_snapshots[off] = regs_pre.get(dest_map[off])
  175:         
  176:         ok = s.send("step 1", timeout=10)
  177:         if not ok or s.dead:
  178:             d_died_at = off
  179:             break
  180:         
  181:         # Snapshot immediately after step while alive
  182:         if off in (0x04, 0x08, 0x10, 0x18, 0x20, 0x24, 0x28):
  183:             post_snapshots[off] = s.get_regs()
  184: 
  185:     code_d, sig_d, buf_d = s.close()
  186: 
  187:     # P2 Vacuity Guard Check
  188:     vacuity_violated = False
  189:     for off, rd in dest_map.items():
  190:         val = pre_snapshots.get(off)
  191:         if val is not None and val == expect_map[off]:
  192:             vacuity_violated = True
  193: 
  194:     report_row("P2_VACUITY", "D: subject dest held poison pre-step",
  195:                "VOID" if vacuity_violated else "POISON_CLEAN",
  196:                "POISON_CLEAN",
  197:                not vacuity_violated)
  198: 
  199:     # A2 Check: no generic uninstalled coproc message
  200:     a2_bad = "[ TODO: arm_mcr_mrc:" in buf_d and "cp_num=6" in buf_d
  201:     report_row("A2_INSTALLED", "CP6 is installed in IQ80321",
  202:                "ABSENT" if not a2_bad else "FOUND",
  203:                "ABSENT",
  204:                not a2_bad)
  205: 
  206:     # Check TRR0 liveness (stepped at 0x04)
  207:     r8_trr0 = post_snapshots.get(0x04, {}).get(8)
  208:     report_row("D_TRR0", "D: trr0 CP6 liveness", r8_trr0, TRR0_SEED, r8_trr0 == TRR0_SEED)
  209: 
  210:     # Check TODO text absence in D
  211:     d_todo = "TODO: XScale read from inten?" in buf_d
  212:     report_row("D_TODO_ABS", "D: TODO read diagnostic absent",
  213:                "ABSENT" if not d_todo else "PRESENT",
  214:                "ABSENT",
  215:                not d_todo)
  216: 
  217:     if d_died_at is not None:
  218:         report_row("D_SURVIVE", "D: ran to marker without exit(1)", f"died@0x{d_died_at:02x}", "SURVIVED", False)
  219:         report_row("D_RESET", "D: inten reset val (rd=9)", "VOID" if vacuity_violated else "-", 0, False)
  220:         report_row("D_S1", "D: inten read S1 (rd=4)", "VOID" if vacuity_violated else "-", S1, False)
  221:         report_row("D_ZERO", "D: inten read 0 (rd=5)", "VOID" if vacuity_violated else "-", 0, False)
  222:         report_row("D_S2", "D: inten read S2 (rd=6)", "VOID" if vacuity_violated else "-", S2, False)
  223:         report_row("D_OP2", "D: inten read opcode2=1 (rd=10)", "VOID" if vacuity_violated else "-", S2, False)
  224:         report_row("D_MARKER", "D: marker reached (r0=0x5a)", "-", MARKER, False)
  225:     else:
  226:         regs_final = post_snapshots.get(0x28, {})
  227:         report_row("D_SURVIVE", "D: ran to marker without exit(1)", "SURVIVED", "SURVIVED", True)
  228:         report_row("D_RESET", "D: inten reset val (rd=9)", "VOID" if vacuity_violated else regs_final.get(9), 0, (not vacuity_violated) and regs_final.get(9) == 0)
  229:         report_row("D_S1", "D: inten read S1 (rd=4)", "VOID" if vacuity_violated else regs_final.get(4), S1, (not vacuity_violated) and regs_final.get(4) == S1)
  230:         report_row("D_ZERO", "D: inten read 0 (rd=5)", "VOID" if vacuity_violated else regs_final.get(5), 0, (not vacuity_violated) and regs_final.get(5) == 0)
  231:         report_row("D_S2", "D: inten read S2 (rd=6)", "VOID" if vacuity_violated else regs_final.get(6), S2, (not vacuity_violated) and regs_final.get(6) == S2)
  232:         report_row("D_OP2", "D: inten read opcode2=1 (rd=10)", "VOID" if vacuity_violated else regs_final.get(10), S2, (not vacuity_violated) and regs_final.get(10) == S2)
  233:         report_row("D_MARKER", "D: marker reached (r0=0x5a)", regs_final.get(0), MARKER, regs_final.get(0) == MARKER)
  234: 
  235:     # -------------------------------------------------------------
  236:     # ARM LNC: Condition, NOP, Subject read
  237:     # -------------------------------------------------------------
  238:     s_lnc = Session(BIN)
  239:     s_lnc.send("r0=0xdeadbe00")
  240:     s_lnc.send(f"r1=0x{S1:08x}")
  241:     s_lnc.send("r3=0xdeadbe03")
  242: 
  243:     prog_lnc = [
  244:         (0x00, 0xEE001610, "mcr 6,0,r1,cr0,cr0,0"),  # inten <- S1
  245:         (0x04, 0x0E103610, "mrceq 6,0,r3,cr0,cr0,0"),# cond EQ is false -> must NOT touch r3
  246:         (0x08, NOP,        "mov r0,r0"),              # NOP -> dest r0 must not hold S1
  247:         (0x0C, 0xEE103610, "mrc 6,0,r3,cr0,cr0,0"),  # subject read -> MUST write S1 to r3
  248:         (0x10, 0xE3A0005A, "mov r0,#0x5a"),          # marker
  249:         (0x14, NOP,        "mov r0,r0")               # landing pad
  250:     ]
  251:     for off, w, _ in prog_lnc:
  252:         s_lnc.send(f"put w 0x{CODE+off:08x}, 0x{w:08x}")
  253:     s_lnc.send(f"pc=0x{CODE:08x}")
  254: 
  255:     s_lnc.send("step 1") # mcr
  256:     s_lnc.send("step 1") # mrceq
  257:     r_after_mrceq = s_lnc.get_regs().get(3)
  258:     report_row("LNC_COND", "LNC: mrceq preserves poison in r3",
  259:                r_after_mrceq, 0xDEADBE03, r_after_mrceq == 0xDEADBE03)
  260: 
  261:     s_lnc.send("step 1") # NOP
  262:     r0_after_nop = s_lnc.get_regs().get(0)
  263:     r3_before_sub = s_lnc.get_regs().get(3)
  264:     report_row("X4_NOP", "LNC: NOP dest r0 does NOT hold S1",
  265:                r0_after_nop, 0xDEADBE00, r0_after_nop != S1 and r0_after_nop == 0xDEADBE00)
  266:     report_row("LNC_P2", "LNC: r3 poison preserved before subject",
  267:                r3_before_sub, 0xDEADBE03, r3_before_sub == 0xDEADBE03)
  268: 
  269:     ok_sub = s_lnc.send("step 1") # subject mrc
  270:     lnc_died = (not ok_sub) or s_lnc.dead
  271: 
  272:     if lnc_died:
  273:         code_lnc, _, buf_lnc = s_lnc.close()
  274:         lnc_todo = "TODO: XScale read from inten?" in buf_lnc
  275:         report_row("LNC_TODO_ABS", "LNC: TODO read diagnostic absent",
  276:                    "ABSENT" if not lnc_todo else "PRESENT",
  277:                    "ABSENT",
  278:                    not lnc_todo)
  279:         report_row("LNC_SUB", "LNC: subject mrc r3 <- S1", "HOST-DIED", hexs(S1), False)
  280:         report_row("LNC_MARKER", "LNC: marker reached (r0=0x5a)", "HOST-DIED", hexs(MARKER), False)
  281:     else:
  282:         r3_after_sub = s_lnc.get_regs().get(3)
  283:         s_lnc.send("step 1") # marker
  284:         r0_marker = s_lnc.get_regs().get(0)
  285:         code_lnc, _, buf_lnc = s_lnc.close()
  286:         lnc_todo = "TODO: XScale read from inten?" in buf_lnc
  287:         report_row("LNC_TODO_ABS", "LNC: TODO read diagnostic absent",
  288:                    "ABSENT" if not lnc_todo else "PRESENT",
  289:                    "ABSENT",
  290:                    not lnc_todo)
  291:         report_row("LNC_SUB", "LNC: subject mrc r3 <- S1",
  292:                    r3_after_sub, S1, r3_after_sub == S1)
  293:         report_row("LNC_MARKER", "LNC: marker reached (r0=0x5a)",
  294:                    r0_marker, MARKER, r0_marker == MARKER)
  295: 
  296:     # -------------------------------------------------------------
  297:     # ARM E: Unknown register / opcode -> MUST DIE both builds
  298:     # -------------------------------------------------------------
  299:     s_e = Session(BIN)
  300:     s_e.send(f"put w 0x{CODE:08x}, 0xee79b6b2")
  301:     s_e.send(f"pc=0x{CODE:08x}")
  302:     s_e.send("step 1", timeout=5)
  303:     code_e, _, buf_e = s_e.close()
  304:     e_died = (code_e == 1) or s_e.dead
  305:     e_msg = ("arm_coproc_i80321_6: unimplemented opcode1=3 opcode2=5 crn=9 crm=2 rd=11 l=1" in buf_e)
  306:     report_row("E_UNKNOWN", "E: unknown opcode dies with 6 fields",
  307:                "DIED_WITH_MSG" if (e_died and e_msg) else ("DIED" if e_died else "SURVIVED"),
  308:                "DIED_WITH_MSG",
  309:                e_died and e_msg)
  310: 
  311:     # -------------------------------------------------------------
  312:     # ARM S: ISRC write kill -> MUST DIE both builds
  313:     # -------------------------------------------------------------
  314:     s_s = Session(BIN)
  315:     s_s.send(f"put w 0x{CODE:08x}, 0xee080610")
  316:     s_s.send(f"pc=0x{CODE:08x}")
  317:     s_s.send("step 1", timeout=5)
  318:     code_s, _, buf_s = s_s.close()
  319:     s_died = (code_s == 1) or s_s.dead
  320:     s_msg = ("TODO: XScale int ack?" in buf_s)
  321:     report_row("S_ISRC_WR", "S: isrc write dies (exit 1)",
  322:                "DIED_WITH_MSG" if (s_died and s_msg) else ("DIED" if s_died else "SURVIVED"),
  323:                "DIED_WITH_MSG",
  324:                s_died and s_msg)
  325: 
  326:     # -------------------------------------------------------------
  327:     # ARM SIB: crn=4 sibling pair
  328:     # -------------------------------------------------------------
  329:     # SIB_R: crn=4 silent-accept READ (survives both)
  330:     s_sibr = Session(BIN)
  331:     s_sibr.send("r0=0xdeadbe00")
  332:     s_sibr.send(f"put w 0x{CODE:08x}, 0xee147610")
  333:     s_sibr.send(f"put w 0x{CODE+4:08x}, 0xe3a0005a")
  334:     s_sibr.send(f"pc=0x{CODE:08x}")
  335:     s_sibr.send("step 1")
  336:     s_sibr.send("step 1")
  337:     r0_sibr = s_sibr.get_regs().get(0)
  338:     report_row("SIB_READ", "SIB: crn-4 read silent-accept",
  339:                r0_sibr, MARKER, r0_sibr == MARKER)
  340:     s_sibr.close()
  341: 
  342:     # SIB_W: crn=4 non-zero store (dies both)
  343:     s_sibw = Session(BIN)
  344:     s_sibw.send(f"r1=0x{S1:08x}")
  345:     s_sibw.send(f"put w 0x{CODE:08x}, 0xee041610")
  346:     s_sibw.send(f"pc=0x{CODE:08x}")
  347:     s_sibw.send("step 1", timeout=5)
  348:     code_sibw, _, buf_sibw = s_sibw.close()
  349:     sibw_died = (code_sibw == 1) or s_sibw.dead
  350:     sibw_msg = ("ARM xscale interrupt steering is not yet implemented" in buf_sibw)
  351:     report_row("SIB_WRITE", "SIB: crn-4 non-zero store dies",
  352:                "DIED_WITH_MSG" if (sibw_died and sibw_msg) else ("DIED" if sibw_died else "SURVIVED"),
  353:                "DIED_WITH_MSG",
  354:                sibw_died and sibw_msg)
  355: 
  356:     # -------------------------------------------------------------
  357:     # ARM RD15: Destination PC (r15)
  358:     # -------------------------------------------------------------
  359:     s_r15 = Session(BIN)
  360:     s_r15.send("r0=0xdeadbe00")
  361:     s_r15.send(f"r1=0x{S1:08x}")
  362:     s_r15.send(f"put w 0x{CODE:08x}, 0xee001610")      # mcr inten <- S1
  363:     s_r15.send(f"put w 0x{CODE+0x04:08x}, 0xee10f610") # mrc 6,0,r15,cr0,cr0,0 (rd=15)
  364:     s_r15.send(f"put w 0x{CODE+0x08:08x}, 0xe3a0005a") # mov r0,#0x5a (marker)
  365:     s_r15.send(f"put w 0x{CODE+0x0C:08x}, 0xe1a00000") # landing pad
  366:     s_r15.send(f"pc=0x{CODE:08x}")
  367:     s_r15.send("step 1") # mcr
  368:     ok_r15 = s_r15.send("step 1") # mrc to r15
  369:     if (not ok_r15) or s_r15.dead:
  370:         report_row("RD15_SURVIVE", "RD15: read into r15 survives to marker", "HOST-DIED", hexs(MARKER), False)
  371:     else:
  372:         s_r15.send("step 1") # marker mov r0, #0x5a
  373:         r0_r15 = s_r15.get_regs().get(0)
  374:         report_row("RD15_SURVIVE", "RD15: read into r15 survives to marker",
  375:                    r0_r15, MARKER, r0_r15 == MARKER)
  376:     s_r15.close()
  377: 
  378:     # -------------------------------------------------------------
  379:     # ARM ANCHOR: Free-running Interrupt Trigger & Contrast
  380:     # -------------------------------------------------------------
  381:     s_anc = Session(BIN)
  382:     s_anc.send("r1=0x10000000")
  383:     s_anc.send("r2=0xfe800000")
  384:     s_anc.send("r3=0x02")
  385:     s_anc.send("r4=0x08")
  386:     s_anc.send("r7=0xdeadbe07")
  387:     s_anc.send("r9=0xdeadbe09")
  388: 
  389:     prog_anc = [
  390:         (0x00, NOP,        "mov r0,r0"),          # 0x00: step 1 tick burn
  391:         (0x04, 0xEE001610, "mcr 6,0,r1,cr0,cr0,0"), # 0x04: inten <- 0x10000000
  392:         (0x08, 0xE5C23001, "strb r3,[r2,#1]"),     # 0x08: com_ier <- 2
  393:         (0x0C, 0xE5C24004, "strb r4,[r2,#4]"),     # 0x0C: com_mcr <- 8 (asserts irq 28)
  394:         (0x10, 0xEE187610, "mrc 6,0,r7,cr8,cr0,0"), # 0x10: read isrc back -> r7
  395:         (0x14, 0xEE109610, "mrc 6,0,r9,cr0,cr0,0"), # 0x14: read inten back while isrc!=0 -> r9 (M1 trap!)
  396:         (0x18, 0xE10F5000, "mrs r5,cpsr"),
  397:         (0x1C, 0xE3C55080, "bic r5,r5,#0x80"),
  398:         (0x20, 0xE121F005, "msr cpsr_c,r5"),
  399:         (0x24, 0xEAFFFFFE, "b .")
  400:     ]
  401:     for off, w, _ in prog_anc:
  402:         s_anc.send(f"put w 0x{CODE+off:08x}, 0x{w:08x}")
  403:     s_anc.send(f"pc=0x{CODE:08x}")
  404: 
  405:     post_anc = {}
  406:     anc_died_at = None
  407:     for off, _, _ in prog_anc[:6]:
  408:         ok = s_anc.send("step 1")
  409:         if not ok or s_anc.dead:
  410:             anc_died_at = off
  411:             break
  412:         post_anc[off] = s_anc.get_regs()
  413: 
  414:     r7_isrc = post_anc.get(0x10, {}).get(7)
  415:     r9_inten = post_anc.get(0x14, {}).get(9)
  416: 
  417:     report_row("ANCHOR_ISRC", "ANCHOR: isrc has bit 28 asserted",
  418:                r7_isrc, 0x10000000, r7_isrc == 0x10000000)
  419:     report_row("ANCHOR_M1", "ANCHOR: inten read while isrc!=0 (M1 floor)",
  420:                r9_inten, 0x10000000, r9_inten == 0x10000000)
  421: 
  422:     if s_anc.dead:
  423:         report_row("ANCHOR_EXC", "ANCHOR: IRQ exception reached vector 0x18", "HOST-DIED", "0x00000018", False)
  424:     else:
  425:         for off, _, _ in prog_anc[6:]:
  426:             s_anc.send("step 1")
  427:         s_anc.send("breakpoint add 0x18")
  428:         s_anc.send("continue", timeout=3)
  429:         regs_anc_cont = s_anc.get_regs()
  430:         pc_hit = regs_anc_cont.get("pc")
  431:         report_row("ANCHOR_EXC", "ANCHOR: IRQ exception reached vector 0x18",
  432:                    pc_hit, 0x00000018, pc_hit == 0x00000018)
  433:     s_anc.close()
  434: 
  435:     # ANCHOR_CONTRAST: inten = 0 -> spins in b ., vector 0x18 never reached
  436:     s_ctl = Session(BIN)
  437:     s_ctl.send("r1=0x00000000")
  438:     s_ctl.send("r2=0xfe800000")
  439:     s_ctl.send("r3=0x02")
  440:     s_ctl.send("r4=0x08")
  441:     for off, w, _ in prog_anc:
  442:         s_ctl.send(f"put w 0x{CODE+off:08x}, 0x{w:08x}")
  443:     s_ctl.send(f"pc=0x{CODE:08x}")
  444:     
  445:     ctl_died = False
  446:     for off, _, _ in prog_anc:
  447:         ok = s_ctl.send("step 1")
  448:         if not ok or s_ctl.dead:
  449:             ctl_died = True
  450:             break
  451:             
  452:     if ctl_died:
  453:         pc_ctl = "HOST-DIED"
  454:     else:
  455:         s_ctl.send("breakpoint add 0x18")
  456:         os.write(s_ctl.fd, b"continue\n")
  457:         time.sleep(0.4)
  458:         try:
  459:             os.write(s_ctl.fd, b"\x03")
  460:             s_ctl.wait_prompt(2)
  461:             regs_ctl = s_ctl.get_regs()
  462:             pc_ctl = regs_ctl.get("pc")
  463:         except:
  464:             pc_ctl = None
  465:     s_ctl.close()
  466:     report_row("ANCHOR_CONTRAST", "ANCHOR: inten=0 spins, 0x18 never reached",
  467:                pc_ctl, CODE+0x24, pc_ctl == (CODE+0x24))
  468: 
  469:     passed = sum(1 for _, ok, _, _, _ in rows if ok)
  470:     total = len(rows)
  471:     failing = [tag for tag, ok, _, _, _ in rows if not ok]
  472:     print()
  473:     print(f"SCORE {passed}/{total}")
  474:     if failing:
  475:         print(f"FAILING: {', '.join(failing)}")
  476:     else:
  477:         print("FAILING: NONE")
  478:     print("XSCALE_WITNESS_DONE")
  479:     return passed, total
  480: 
  481: if __name__ == "__main__":
  482:     run()

