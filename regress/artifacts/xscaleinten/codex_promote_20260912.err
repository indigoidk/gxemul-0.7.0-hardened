 1516: #  ------------------------------------------------------------ pcc2defaultkill (#501)
 1517: #  The default: arm of DEVICE_ACCESS(pcc2) ended the host on any access to an uncased
 1518: #  offset, reads included.  Now: reads keep the served byte, writes are declined, one
 1519: #  latched announce per offset per instance.  The witness (regress/artifacts/pcc2defaultkill/
 1520: #  witness_20260905/, 7/13 on the committed build) is NOT run here; this is its detector.
 1521: PCC2DLOG=$LOGDIR/pcc2_default.log
 1522: python3 -u pcc2_default_probe.py "$PMAX" gate > "$PCC2DLOG" 2>&1 || true
 1523: if ! grep -q "PCC2D_PROBE_DONE" "$PCC2DLOG"; then
 1524:     check "pcc2 default probe completed" "no" "yes"
 1525: else
 1526:     check "pcc2 default probe completed" "yes" "yes"
 1527:     for v in "live" "devsig chipid" "named wr" "named wr msg" "named rd" "named rd msg" \
 1528:         "named rd srvd" "inword wr" "inword msg" "inword rdawr" "inword rd" "unnamed wr" \
 1529:         "unnamed msg" "unnamed rdawr" "unnamed rd" "ieicr rdawr" "ieerr rdawr" "sccerr rdawr" \
 1530:         "latch sameoff" "sameoff val" "latch twooff" "latch rw one" "latch rd rd" "latch rd wr" \
 1531:         "latch aba" "alias 0x6a" "alias msg" "dir wr text" "wr declined" "wr val text" \
 1532:         "dir rd text" "srvd val" "srvd val text" "srvd half text" "half wr rdawr" "srvd rd latch" \
 1533:         "srvd wr latch" "wide wr" "wide wr msg" "wide wr val" "wide rd" "wide rd srvd" \
 1534:         "genctl rt" "t1cmp word rt" "put b ctl" "put b ctl msg"; do
 1535:         check "pcc2 default row: $v" "$(count "$PCC2DLOG" "^$v  .*ok$")" "1"
 1536:     done
 1537:     check "pcc2 default rows emitted" "$(( $(count "$PCC2DLOG" " ok$") + $(count "$PCC2DLOG" " FAIL$") ))" "46"
 1538:     check "pcc2 default rows green"   "$(count "$PCC2DLOG" " ok$")"   "46"
 1539:     check "pcc2 default rows red"     "$(count "$PCC2DLOG" " FAIL$")" "0"
 1540: fi
