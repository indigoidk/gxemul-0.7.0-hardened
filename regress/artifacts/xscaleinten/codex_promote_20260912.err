   44: 
   45: /*
   46:  *  arm_coproc_15():
   47:  *
   48:  *  The system control coprocessor.
   49:  */
   50: void arm_coproc_15(struct cpu *cpu, int opcode1, int opcode2, int l_bit,
   51: 	int crn, int crm, int rd)
   52: {
   53: 	uint32_t old_control;
   54: 
   55: 	/*  Some sanity checks:  */
   56: 	if (opcode1 != 0) {
   57: 		fatal("[ TODO: arm_coproc_15: opcode1 = %i, should be 0 ]\n", opcode1);
   58: 		// exit(1);
   59: 	}
   60: 	if (rd == ARM_PC) {
   61: 		fatal("[ TODO: arm_coproc_15: rd = PC ]\n");
   62: 		exit(1);
   63: 	}
   64: 
   65: 	switch (crn) {
   66: 
   67: 	case 0:	/*
   68: 		 *  Main ID register (and Cache Type register, on XScale)
   69: 		 *
   70: 		 *  Writes are supposed to be ignored, according to Intel docs.
   71: 		 */
   72: 		switch (opcode2) {
   73: 		case 0:	if (l_bit)
   74: 				cpu->cd.arm.r[rd] = cpu->cd.arm.cpu_type.cpu_id;
   75: 			else
   76: 				fatal("[ TODO: arm_coproc_15: attempt to write "
   77: 				    "to the Main ID register? ]\n");
   78: 			break;
   79: 		case 1:	if (l_bit)
   80: 				cpu->cd.arm.r[rd] = cpu->cd.arm.cachetype;
   81: 			else
   82: 				fatal("[ TODO: arm_coproc_15: attempt to write "
   83: 				    "to the Cache Type register? ]\n");
   84: 			break;
   85: 		default:fatal("[ TODO: arm_coproc_15: cr0, opcode2=%i ]\n",
   86: 			    opcode2);
   87: 			// exit(1);
   88: 		}
   89: 		break;
   90: 
   91: 	case 1:	/*  Control Register:  */
   92: 		if (l_bit) {
   93: 			/*  Load from the normal/aux control register:  */
   94: 			switch (opcode2) {
   95: 			case 0:	cpu->cd.arm.r[rd] = cpu->cd.arm.control;
   96: 				break;
   97: 			case 1:	cpu->cd.arm.r[rd] = cpu->cd.arm.auxctrl;
   98: 				break;
   99: 			default:fatal("[ TODO: Unimplemented opcode2 = %i ", opcode2);
  100: 				fatal("(opcode1=%i crn=%i crm=%i rd=%i l=%i) ]\n",
  101: 				    opcode1, crn, crm, rd, l_bit);
  102: 				// exit(1);
  103: 			}
  104: 			return;
  105: 		}
  106: 
  107: 		if (opcode2 == 1) {
  108: 			/*  Write to auxctrl:  */
  109: 			old_control = cpu->cd.arm.auxctrl;
  110: 			cpu->cd.arm.auxctrl = cpu->cd.arm.r[rd];
  111: 			if ((old_control & ARM_AUXCTRL_MD) !=
  112: 			    (cpu->cd.arm.auxctrl & ARM_AUXCTRL_MD)) {
  113: 				debug("[ setting the minidata cache attribute"
  114: 				    " to 0x%x ]\n", (cpu->cd.arm.auxctrl &
  115: 				    ARM_AUXCTRL_MD) >> ARM_AUXCTRL_MD_SHIFT);
  116: 			}
  117: 			if ((old_control & ARM_AUXCTRL_K) !=
  118: 			    (cpu->cd.arm.auxctrl & ARM_AUXCTRL_K)) {
  119: 				debug("[ %s write buffer coalescing ]\n",
  120: 				    cpu->cd.arm.auxctrl & ARM_AUXCTRL_K?
  121: 				    "Disabling" : "Enabling");
  122: 			}
  123: 			return;
  124: 		} else if (opcode2 != 0) {
  125: 			fatal("[ Unimplemented write, opcode2 = %i ", opcode2);
  126: 			fatal("(opcode1=%i crn=%i crm=%i rd=%i l=%i)]\n",
  127: 			    opcode1, crn, crm, rd, l_bit);
  128: 			// exit(1);
  129: 		}
  130: 			
  131: 		/*
  132: 		 *  Write to control:  Check each bit individually:
  133: 		 */
  134: 		old_control = cpu->cd.arm.control;
  135: 		cpu->cd.arm.control = cpu->cd.arm.r[rd];
  136: 		if ((old_control & ARM_CONTROL_MMU) !=
  137: 		    (cpu->cd.arm.control & ARM_CONTROL_MMU)) {
  138: 			debug("[ %s the MMU ]\n", cpu->cd.arm.control &
  139: 			    ARM_CONTROL_MMU? "enabling" : "disabling");
  140: 			cpu->translate_v2p =
  141: 			    cpu->cd.arm.control & ARM_CONTROL_MMU?
  142: 			    arm_translate_v2p_mmu : arm_translate_v2p;
  143: 		}
  144: 		if ((old_control & ARM_CONTROL_ALIGN) !=
  145: 		    (cpu->cd.arm.control & ARM_CONTROL_ALIGN))
  146: 			debug("[ %s alignment checks ]\n", cpu->cd.arm.control &
  147: 			    ARM_CONTROL_ALIGN? "enabling" : "disabling");
  148: 		if ((old_control & ARM_CONTROL_CACHE) !=
  149: 		    (cpu->cd.arm.control & ARM_CONTROL_CACHE))
  150: 			debug("[ %s the [data] cache ]\n", cpu->cd.arm.control &
  151: 			    ARM_CONTROL_CACHE? "enabling" : "disabling");
  152: 		if ((old_control & ARM_CONTROL_WBUFFER) !=
  153: 		    (cpu->cd.arm.control & ARM_CONTROL_WBUFFER))
  154: 			debug("[ %s the write buffer ]\n", cpu->cd.arm.control &
  155: 			    ARM_CONTROL_WBUFFER? "enabling" : "disabling");
  156: 
  157: 		old_control &= ~ARM_CONTROL_BIG;
  158: 		if (cpu->byte_order == EMUL_BIG_ENDIAN)
  159: 			old_control |= ARM_CONTROL_BIG;
  160: 
  161: 		if ((old_control & ARM_CONTROL_BIG) !=
  162: 		    (cpu->cd.arm.control & ARM_CONTROL_BIG)) {
  163: 			/*  #378: this exit is LOAD-BEARING for translate-time
  164: 			    byte-order decisions elsewhere: the LDM/STM fast-path
  165: 			    install gate in cpu_arm_instr.c reads cpu->byte_order
  166: 			    once, at translation, which is sound only because no
  167: 			    route changes it afterwards (this one exits; SETEND
  168: 			    is undecoded; every other write is machine setup).
  169: 			    Implementing the switch therefore needs more than
  170: 			    setting byte_order: invalidate_translation_caches(
  171: 			    cpu, 0, INVALIDATE_ALL) so cached ic->f handlers are
  172: 			    re-picked, AND re-translation of instruction words
  173: 			    (the decoder itself reads byte_order), AND a revisit
  174: 			    of that install gate.  */
  175: 			fatal("ERROR: Trying to switch endianness. Not "
  176: 			    "supported yet.\n");
  177: 			exit(1);
  178: 		}
  179: 		if ((old_control & ARM_CONTROL_ICACHE) !=
  180: 		    (cpu->cd.arm.control & ARM_CONTROL_ICACHE))
  181: 			debug("[ %s the icache ]\n", cpu->cd.arm.control &
  182: 			    ARM_CONTROL_ICACHE? "enabling" : "disabling");
  183: 		/*  TODO: More bits.  */
  184: 		break;
  185: 
  186: 	case 2:	/*  Translation Table Base register:  */
  187: 		/*  NOTE: 16 KB aligned.  */
  188: 		if (l_bit)
  189: 			cpu->cd.arm.r[rd] = cpu->cd.arm.ttb & 0xffffc000;
  190: 		else {
  191: 			cpu->cd.arm.ttb = cpu->cd.arm.r[rd];
  192: 			if (cpu->cd.arm.ttb & 0x3fff)
  193: 				fatal("[ WARNING! low bits of new TTB non-"
  194: 				    "zero? 0x%08x ]\n", cpu->cd.arm.ttb);
  195: 			cpu->cd.arm.ttb &= 0xffffc000;
  196: 		}
  197: 		break;
  198: 
  199: 	case 3:	/*  Domain Access Control Register:  */
  200: 		if (l_bit)
  201: 			cpu->cd.arm.r[rd] = cpu->cd.arm.dacr;
  202: 		else
  203: 			cpu->cd.arm.dacr = cpu->cd.arm.r[rd];
  204: 		break;
  205: 
  206: 	case 5:	/*  Fault Status Register:  */
  207: 		/*  Note: Only the lowest 8 bits are defined.  */
  208: 		if (l_bit)
  209: 			cpu->cd.arm.r[rd] = cpu->cd.arm.fsr & 0xff;
  210: 		else
  211: 			cpu->cd.arm.fsr = cpu->cd.arm.r[rd] & 0xff;
  212: 		break;
  213: 
  214: 	case 6:	/*  Fault Address Register:  */
  215: 		if (l_bit)
  216: 			cpu->cd.arm.r[rd] = cpu->cd.arm.far;
  217: 		else
  218: 			cpu->cd.arm.far = cpu->cd.arm.r[rd];
  219: 		break;
  220: 
  221: 	case 7:	/*  Cache functions:  */
  222: 		if (l_bit) {
  223: 			fatal("[ arm_coproc_15: attempt to read cr7? ]\n");
  224: 			return;
  225: 		}
  226: 		/*  debug("[ arm_coproc_15: cache op: TODO ]\n");  */
  227: 		/*  TODO:  */
  228: 		break;
  229: 
  230: 	case 8:	/*  TLB functions:  */
  231: 		if (l_bit) {
  232: 			fatal("[ arm_coproc_15: attempt to read cr8? ]\n");
  233: 			return;
  234: 		}
  235: 		/*  fatal("[ arm_coproc_15: TLB: op2=%i crm=%i rd=0x%08x ]\n",
  236: 		    opcode2, crm, cpu->cd.arm.r[rd]);  */
  237: 		if (opcode2 == 0)
  238: 			cpu->invalidate_translation_caches(cpu, 0,
  239: 			    INVALIDATE_ALL);
  240: 		else
  241: 			cpu->invalidate_translation_caches(cpu,
  242: 			    cpu->cd.arm.r[rd], INVALIDATE_VADDR);
  243: 		break;
  244: 
  245: 	case 9:	/*  Cache lockdown:  */
  246: 		fatal("[ arm_coproc_15: cache lockdown: TODO ]\n");
  247: 		/*  TODO  */
  248: 		break;
  249: 
  250: 	case 13:/*  Process ID Register:  */
  251: 		if (opcode2 != 0)
  252: 			debug("[ arm_coproc_15: PID access, but opcode2 "
  253: 			    "= %i? (should be 0) ]\n", opcode2);
  254: 		if (crm != 0)
  255: 			fatal("[ arm_coproc_15: PID access, but crm "
  256: 			    "= %i? (should be 0) ]\n", crm);
  257: 		if (l_bit)
  258: 			cpu->cd.arm.r[rd] = cpu->cd.arm.pid;
  259: 		else
  260: 			cpu->cd.arm.pid = cpu->cd.arm.r[rd];
  261: 		if (cpu->cd.arm.pid != 0) {
  262: 			fatal("ARM TODO: pid!=0. Fast Context Switch"
  263: 			    " Extension not implemented yet\n");
  264: 			exit(1);
  265: 		}
  266: 		break;
  267: 
  268: 	/*  case 14:  */
  269: 		/*  Breakpoint registers on XScale (possibly others?)  */
  270: 		/*  TODO  */
  271: 		/*  break;  */
  272: 
  273: 	case 15:/*  IMPLEMENTATION DEPENDENT!  */
  274: 		switch (crm) {
  275: 		case 1:	/*
  276: 			 *  On XScale (and others? TODO), this is the
  277: 			 *  CoProcessor Access Register.  Note/TODO: This isn't
  278: 			 *  really used throughout the rest of the code yet.
  279: 			 */
  280: 			if (l_bit)
  281: 				cpu->cd.arm.r[rd] = cpu->cd.arm.cpar;
  282: 			else
  283: 				cpu->cd.arm.cpar = cpu->cd.arm.r[rd];
  284: 			break;
  285: 		default:fatal("[ TODO: arm_coproc_15: IMPLEMENTATION "
  286: 			    "DEPENDENT! ]\n");
  287: 			// exit(1);
  288: 		}
  289: 		break;
  290: 
  291: 	default:fatal("[ TODO: arm_coproc_15: unimplemented crn = %i ", crn);
  292: 		fatal("(opcode1=%i opcode2=%i crm=%i rd=%i l=%i) ]\n",
  293: 		    opcode1, opcode2, crm, rd, l_bit);
  294: 		// exit(1);
  295: 	}
  296: }
  297: 
  298: 
  299: /*
  300:  *  arm_coproc_i80321_6():
  301:  *
  302:  *  Intel 80321 coprocessor 6.
  303:  */
  304: void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit,
  305: 	int crn, int crm, int rd)
  306: {
  307: 	switch (crm) {
  308: 
  309: 	case 0:	switch (crn) {
  310: 		case 0:	if (l_bit) {
  311: 				cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_inten;
  312: 			} else
  313: 				cpu->cd.arm.i80321_inten = cpu->cd.arm.r[rd];
  314: 			break;
  315: 		case 4:	if (l_bit)
  316: 				cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_isteer;
  317: 			else {
  318: 				cpu->cd.arm.i80321_isteer = cpu->cd.arm.r[rd];
  319: 				if (cpu->cd.arm.r[rd] != 0) {
  320: 					fatal("ARM xscale interrupt steering"
  321: 					    " is not yet implemented\n");
  322: 					exit(1);
  323: 				}
  324: 			}
  325: 			break;
  326: 		case 8:	if (l_bit)
  327: 				cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_isrc;
  328: 			else {
  329: 				cpu->cd.arm.i80321_isrc = cpu->cd.arm.r[rd];
  330: 				fatal("TODO: XScale int ack?\n");
  331: 				exit(1);
  332: 			}
  333: 			break;
  334: 		default:goto unknown;
  335: 		}
  336: 		break;
  337: 
  338: 	case 1:	/*  fatal("TIMER opcode1=%i opcode2=%i crn="
  339:     "%i crm=%i rd=%i l=%i)\n", opcode1, opcode2, crn, crm, rd, l_bit);  */
  340: 
  341: 		switch (crn) {
  342: 		case 0:	/*  tmr0:  */
  343: 			if (l_bit)
  344: 				cpu->cd.arm.r[rd] = cpu->cd.arm.tmr0;
  345: 			else
  346: 				cpu->cd.arm.tmr0 = cpu->cd.arm.r[rd];
  347: 			break;
  348: 		case 1:	/*  tmr1:  */
  349: 			if (l_bit)
  350: 				cpu->cd.arm.r[rd] = cpu->cd.arm.tmr1;
  351: 			else
  352: 				cpu->cd.arm.tmr1 = cpu->cd.arm.r[rd];
  353: 			break;
  354: 		case 2:	/*  tcr0:  */
  355: 			if (l_bit) {
  356: 				/*  NOTE/TODO: Ugly hack: timer increment  */
  357: 				cpu->cd.arm.tcr0 ++;
  358: 				cpu->cd.arm.r[rd] = cpu->cd.arm.tcr0;
  359: 			} else {
  360: 				cpu->cd.arm.tcr0 = cpu->cd.arm.r[rd];
  361: 			}
  362: 			break;
  363: 		case 3:	/*  tcr1:  */
  364: 			if (l_bit) {
  365: 				/*  NOTE/TODO: Ugly hack: timer increment  */
  366: 				cpu->cd.arm.tcr1 ++;
  367: 				cpu->cd.arm.r[rd] = cpu->cd.arm.tcr1;
  368: 			} else {
  369: 				cpu->cd.arm.tcr1 = cpu->cd.arm.r[rd];
  370: 			}
  371: 			break;
  372: 		case 4:	/*  trr0:  */
  373: 			if (l_bit)
  374: 				cpu->cd.arm.r[rd] = cpu->cd.arm.trr0;
  375: 			else
  376: 				cpu->cd.arm.trr0 = cpu->cd.arm.r[rd];
  377: 			break;
  378: 		case 5:	/*  trr1:  */
  379: 			if (l_bit)
  380: 				cpu->cd.arm.r[rd] = cpu->cd.arm.trr1;
  381: 			else
  382: 				cpu->cd.arm.trr1 = cpu->cd.arm.r[rd];
  383: 			break;
  384: 		case 6:	/*  tisr:  */
  385: 			if (l_bit)
  386: 				cpu->cd.arm.r[rd] = cpu->cd.arm.tisr;
  387: 			else {
  388: 				/*  Writing clears interrupts:  */
  389: 				cpu->cd.arm.tisr &= ~cpu->cd.arm.r[rd];
  390: 
  391: 				if (!(cpu->cd.arm.tisr & TISR_TMR0))
  392: 					INTERRUPT_DEASSERT(
  393: 					    cpu->cd.arm.tmr0_irq);
  394: 				if (!(cpu->cd.arm.tisr & TISR_TMR1))
  395: 					INTERRUPT_DEASSERT(
  396: 					    cpu->cd.arm.tmr1_irq);
  397: 			}
  398: 			break;
  399: 		case 7:	/*  wdtcr:  */
  400: 			if (l_bit)
  401: 				cpu->cd.arm.r[rd] = cpu->cd.arm.wdtcr;
  402: 			else
  403: 				cpu->cd.arm.wdtcr = cpu->cd.arm.r[rd];
  404: 			break;
  405: 		default:goto unknown;
  406: 		}
  407: 		break;
  408: 
  409: 	default:goto unknown;
  410: 	}
  411: 
  412: 	return;
  413: 
  414: unknown:
  415: 	fatal("arm_coproc_i80321_6: unimplemented opcode1=%i opcode2=%i crn="
  416: 	    "%i crm=%i rd=%i l=%i)\n", opcode1, opcode2, crn, crm, rd, l_bit);
  417: 	exit(1);
  418: }
  419: 
  420: 
  421: /*
  422:  *  arm_coproc_xscale_14():
  423:  *
  424:  *  XScale coprocessor 14, Performance Monitoring Unit.
  425:  */
  426: void arm_coproc_xscale_14(struct cpu *cpu, int opcode1, int opcode2, int l_bit,
  427: 	int crn, int crm, int rd)
  428: {
  429: 	if (opcode2 != 0) {
  430: 		fatal("TODO: opcode2 = %i\n", opcode2);
  431: 		goto unknown;
  432: 	}
  433: 
  434: 	switch (crm) {
  435: 
  436: 	case 0:	switch (crn) {
  437: 		case 0:	if (l_bit)
  438: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc1_pmnc;
  439: 			else
  440: 				cpu->cd.arm.xsc1_pmnc = cpu->cd.arm.r[rd];
  441: 			break;
  442: 		case 1:	if (l_bit)
  443: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc1_ccnt;
  444: 			else
  445: 				cpu->cd.arm.xsc1_ccnt = cpu->cd.arm.r[rd];
  446: 			break;
  447: 		case 2:	if (l_bit)
  448: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc1_pmn0;
  449: 			else
  450: 				cpu->cd.arm.xsc1_pmn0 = cpu->cd.arm.r[rd];
  451: 			break;
  452: 		case 3:	if (l_bit)
  453: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc1_pmn1;
  454: 			else
  455: 				cpu->cd.arm.xsc1_pmn1 = cpu->cd.arm.r[rd];
  456: 			break;
  457: 		case 7:	/*  UNIMPLEMENTED!!! TODO  */
  458: 			/*  Possibly some kind of idle or sleep function.  */
  459: 			break;
  460: 		default:goto unknown;
  461: 		}
  462: 		break;
  463: 
  464: 	case 1:	switch (crn) {
  465: 		case 0:	if (l_bit)
  466: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc2_pmnc;
  467: 			else
  468: 				cpu->cd.arm.xsc2_pmnc = cpu->cd.arm.r[rd];
  469: 			break;
  470: 		case 1:	if (l_bit)
  471: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc2_ccnt;
  472: 			else
  473: 				cpu->cd.arm.xsc2_ccnt = cpu->cd.arm.r[rd];
  474: 			break;
  475: 		case 4:	if (l_bit)
  476: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc2_inten;
  477: 			else
  478: 				cpu->cd.arm.xsc2_inten = cpu->cd.arm.r[rd];
  479: 			break;
  480: 		case 5:	if (l_bit)
  481: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc2_flag;
  482: 			else
  483: 				cpu->cd.arm.xsc2_flag = cpu->cd.arm.r[rd];
  484: 			break;
  485: 		case 8:	if (l_bit)
  486: 				cpu->cd.arm.r[rd] = cpu->cd.arm.xsc2_evtsel;
  487: 			else
  488: 				cpu->cd.arm.xsc2_evtsel = cpu->cd.arm.r[rd];
  489: 			break;
  490: 		default:goto unknown;
  491: 		}
  492: 		break;
  493: 
  494: 	case 2:	switch (crn) {
  495: 		case 0:	if (l_bit)
