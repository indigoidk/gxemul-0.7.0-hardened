 1542: 
 1543: PITLOG=$LOGDIR/pit8253_latch.log
 1544: python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PITLOG" 2>&1 || true
 1545: 
 1546: #  A PRESERVED LOG IS VERIFIED BY ITS COMPLETION SENTINEL, NOT BY ITS EXISTENCE.  The probe
 1547: #  gained PIT8253_LATCH_DONE specifically so this row could be written correctly the first
 1548: #  time -- before it, the last line was a bare "PASS", a word that occurs in dozens of other
 1549: #  contexts and cannot distinguish a COMPLETED run from a TRUNCATED one.
 1550: if ! grep -q "PIT8253_LATCH_DONE" "$PITLOG"; then
 1551:     note "pit8253 probe did not reach its completion sentinel; last lines follow"
 1552:     tail -5 "$PITLOG" | sed 's/^/       /'
 1553:     check "pit8253 probe completed" "no" "yes"
 1554: else
 1555:     grep -E "^  (ok|FAIL) " "$PITLOG" | sed 's/^/       /'
 1556: 
 1557:     #  THE THREE CONTROLS PLUS THE MMU-ON NEGATIVE CONTROL, each pinned by name.  A count of
 1558:     #  green rows would let a control go red while the total stayed acceptable.
 1559:     for c in "C1 liveness" "C2 MMU state" "A1 device signature" "T  MMU-ON control"; do
 1560:         check "pit8253 control: $c" \
 1561:               "$(grep -c "^  ok   $c" "$PITLOG")" "1"
 1562:     done
 1563: 
 1564:     #  Per-row presence.  A row that silently stops being tested is the padded-column class,
 1565:     #  so each is checked individually rather than by a total.  Eighteen rows: 4 controls +
 1566:     #  E/A2 apparatus + R0..R11.
 1567:     for v in "E  encodings" "A2 recompute stream" \
 1568:              "R0 the run produced data" "R1 latch preserves programming" \
 1569:              "R2 latch is not an error" "R3 latched read is not the reload" \
 1570:              "R4 16-bit readback is the reload" "R5 one recompute per write pair" \
 1571:              "R6 no transient count of zero" \
 1572:              "R7 read and write flip-flops are separate" \
 1573:              "R8 the latch is released by reading it" \
 1574:              "R9 a mid-pair latch completes the pair and lets go" \
 1575:              "R10 a Control Word rewinds the write flip-flop" \
 1576:              "R11 ...and it does so PER COUNTER, not just counter 0"; do
 1577:         check "pit8253 row green: $v" \
 1578:               "$(grep -c "^  ok   $v" "$PITLOG")" "1"
 1579:     done
 1580: 
 1581:     #  The denominator against a LITERAL: a probe that loses rows cannot pass by shrinking.
 1582:     check "pit8253 rows run" "$(grep -cE '^  (ok|FAIL) ' "$PITLOG")" "18"
 1583: fi
 1584: 
 1585: gate_end

