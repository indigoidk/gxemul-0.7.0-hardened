   37: 
   38:     def rd(self, t=0.2):
   39:         r, _, _ = select.select([self.fd], [], [], t)
   40:         if self.fd not in r:
   41:             return False
   42:         try:
   43:             d = os.read(self.fd, 65536)
   44:         except OSError:
   45:             self.dead = True
   46:             return False
   47:         if not d:
   48:             self.dead = True
   49:             return False
   50:         self.buf += d.decode("latin1", "replace")
   51:         return True
   52: 
   53:     def wait_prompt(self, timeout=30):
   54:         t0 = time.time()
   55:         while time.time() - t0 < timeout:
   56:             if self.dead:
   57:                 return False
   58:             self.rd(0.1)
   59:             if self.buf.rstrip().endswith("GXemul>"):
   60:                 return True
   61:         return False
   62: 
   63:     def send(self, cmd_str, timeout=30):
   64:         if self.dead:
   65:             return False
   66:         b = (cmd_str + "\n").encode("latin1")
   67:         try:
   68:             os.write(self.fd, b)
   69:         except OSError:
   70:             self.dead = True
   71:             return False
   72:         return self.wait_prompt(timeout)
   73: 
   74:     def get_regs(self):
