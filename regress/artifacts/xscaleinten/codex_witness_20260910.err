450:	d->mcu_reg[MCU_SBR0 / sizeof(uint32_t)] = (base + memsize) >> 25;
451:	d->mcu_reg[MCU_SBR1 / sizeof(uint32_t)] = (base + memsize) >> 25;
452:
453:	snprintf(tmpstr, sizeof(tmpstr), "%s.i80321", devinit->interrupt_path);
454:
455:	d->pci_bus = bus_pci_init(devinit->machine,
456:	    tmpstr	/*  pciirq  */,
457:	    0x90000000	/*  TODO: pci_io_offset  */,
458:	    0x90010000	/*  TODO: pci_mem_offset  */,
459:	    0xffff0000	/*  TODO: pci_portbase  */,
460:	    0x00000000	/*  TODO: pci_membase  */,
461:	    tmpstr	/*  pci_irqbase  */,
462:	    0x90000000	/*  TODO: isa_portbase  */,
463:	    0x90010000	/*  TODO: isa_membase  */,
464:	    "TODO: isa_irqbase" /*  TODO: isa_irqbase  */);
465:
466:	memory_device_register(devinit->machine->memory, devinit->name,
467:	    devinit->addr, DEV_I80321_LENGTH,
468:	    dev_i80321_access, d, DM_DEFAULT, NULL);
469:
470:	/*  TODO: Don't hardcode to 100 Hz!  */
