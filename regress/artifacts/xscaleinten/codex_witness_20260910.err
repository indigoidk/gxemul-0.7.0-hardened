3985:		    sizeof(ib), MEM_READ, CACHE_INSTRUCTION)) {
3986:			fatal("to_be_translated(): "
3989:		}3990:	}
3991:
3992:	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
3993:		iword = READ_WORD_LE(ib);
3994:	else
3995:		iword = READ_WORD_BE(ib);
