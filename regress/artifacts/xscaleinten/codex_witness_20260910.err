439:		if (i == 9)
440:			INTERRUPT_CONNECT(tmpstr2, cpu->cd.arm.tmr0_irq);
441:		if (i == 10)
442:			INTERRUPT_CONNECT(tmpstr2, cpu->cd.arm.tmr1_irq);
443:	}
