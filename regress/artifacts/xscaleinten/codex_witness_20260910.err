2635:/*
2636: *  arm_mcr_mrc():
2637: *
2638: *  Coprocessor register move.
2639: *
2640: *  The program counter should be synched before calling this function (to
2641: *  make debug output with the correct PC value possible).
2642: */
2643:void arm_mcr_mrc(struct cpu *cpu, uint32_t iword)
2644:{
2645:	int opcode1 = (iword >> 21) & 7;
2646:	int l_bit = (iword >> 20) & 1;
2647:	int crn = (iword >> 16) & 15;
2648:	int rd = (iword >> 12) & 15;
2649:	int cp_num = (iword >> 8) & 15;
2650:	int opcode2 = (iword >> 5) & 7;
2651:	int crm = iword & 15;
2652:
2653:	if (cpu->cd.arm.coproc[cp_num] != NULL)
2654:		cpu->cd.arm.coproc[cp_num](cpu, opcode1, opcode2, l_bit,
2655:		    crn, crm, rd);
2656:	else {
2657:		fatal("[ TODO: arm_mcr_mrc: pc=0x%08x, iword=0x%08x: "
2658:		    "cp_num=%i ]\n", (int)cpu->pc, iword, cp_num);
2659:
2660:		// arm_exception(cpu, ARM_EXCEPTION_UND);
2661:		/*  exit(1);  */
2662:	}
2663:}
2664:
2665:
2666:/*
2667: *  arm_cdp():
2668: *
2669: *  Coprocessor operations.
2670: *
2671: *  The program counter should be synched before calling this function (to
2672: *  make debug output with the correct PC value possible).
2673: */
2674:void arm_cdp(struct cpu *cpu, uint32_t iword)
2675:{
2676:	fatal("[ arm_cdp: pc=0x%08x, iword=0x%08x ]\n", (int)cpu->pc, iword);
2677:	arm_exception(cpu, ARM_EXCEPTION_UND);
2678:	/*  exit(1);  */
2679:}
2680:
2681:
2682:/*****************************************************************************/
