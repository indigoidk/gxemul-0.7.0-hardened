3967:	/*  Figure out the address of the instruction:  */
3968:	low_pc = ((size_t)ic - (size_t)cpu->cd.arm.cur_ic_page)
3969:	    / sizeof(struct arm_instr_call);
3970:	addr = cpu->pc & ~((ARM_IC_ENTRIES_PER_PAGE-1) <<
3971:	    ARM_INSTR_ALIGNMENT_SHIFT);
3972:	addr += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
3973:	cpu->pc = addr;
3974:	addr &= ~((1 << ARM_INSTR_ALIGNMENT_SHIFT) - 1);
