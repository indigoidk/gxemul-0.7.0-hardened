423:		struct interrupt templ;
424:		char tmpstr2[300];
425:		snprintf(tmpstr2, sizeof(tmpstr2), "%s.i80321.%i",
426:		    devinit->interrupt_path, i);
427:		memset(&templ, 0, sizeof(templ));
428:		templ.line = (uint32_t)1 << i;
429:		templ.name = tmpstr2;
430:		templ.extra = d;
431:		templ.interrupt_assert = i80321_interrupt_assert;
432:		templ.interrupt_deassert = i80321_interrupt_deassert;
433:		interrupt_handler_register(&templ);
