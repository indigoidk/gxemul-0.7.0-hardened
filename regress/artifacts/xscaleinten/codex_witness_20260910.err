299:/*
300: *  arm_coproc_i80321_6():
301: *
302: *  Intel 80321 coprocessor 6.
303: */
304:void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit,
305:	int crn, int crm, int rd)
306:{
307:	switch (crm) {
308:
309:	case 0:	switch (crn) {
310:		case 0:	if (l_bit) {
311:				cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_inten;
312:				fatal("TODO: XScale read from inten?\n");
313:				exit(1);
314:			} else
315:				cpu->cd.arm.i80321_inten = cpu->cd.arm.r[rd];
316:			break;
317:		case 4:	if (l_bit)
318:				cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_isteer;
319:			else {
320:				cpu->cd.arm.i80321_isteer = cpu->cd.arm.r[rd];
321:				if (cpu->cd.arm.r[rd] != 0) {
322:					fatal("ARM xscale interrupt steering"
323:					    " is not yet implemented\n");
324:					exit(1);
325:				}
326:			}
327:			break;
328:		case 8:	if (l_bit)
329:				cpu->cd.arm.r[rd] = cpu->cd.arm.i80321_isrc;
330:			else {
331:				cpu->cd.arm.i80321_isrc = cpu->cd.arm.r[rd];
332:				fatal("TODO: XScale int ack?\n");
333:				exit(1);
334:			}
335:			break;
336:		default:goto unknown;
337:		}
338:		break;
339:
340:	case 1:	/*  fatal("TIMER opcode1=%i opcode2=%i crn="
341:    "%i crm=%i rd=%i l=%i)\n", opcode1, opcode2, crn, crm, rd, l_bit);  */
342:
343:		switch (crn) {
344:		case 0:	/*  tmr0:  */
345:			if (l_bit)
346:				cpu->cd.arm.r[rd] = cpu->cd.arm.tmr0;
347:			else
348:				cpu->cd.arm.tmr0 = cpu->cd.arm.r[rd];
349:			break;
350:		case 1:	/*  tmr1:  */
351:			if (l_bit)
352:				cpu->cd.arm.r[rd] = cpu->cd.arm.tmr1;
353:			else
354:				cpu->cd.arm.tmr1 = cpu->cd.arm.r[rd];
355:			break;
356:		case 2:	/*  tcr0:  */
357:			if (l_bit) {
358:				/*  NOTE/TODO: Ugly hack: timer increment  */
359:				cpu->cd.arm.tcr0 ++;
360:				cpu->cd.arm.r[rd] = cpu->cd.arm.tcr0;
361:			} else {
362:				cpu->cd.arm.tcr0 = cpu->cd.arm.r[rd];
363:			}
364:			break;
365:		case 3:	/*  tcr1:  */
366:			if (l_bit) {
367:				/*  NOTE/TODO: Ugly hack: timer increment  */
368:				cpu->cd.arm.tcr1 ++;
369:				cpu->cd.arm.r[rd] = cpu->cd.arm.tcr1;
370:			} else {
371:				cpu->cd.arm.tcr1 = cpu->cd.arm.r[rd];
372:			}
373:			break;
374:		case 4:	/*  trr0:  */
375:			if (l_bit)
376:				cpu->cd.arm.r[rd] = cpu->cd.arm.trr0;
377:			else
378:				cpu->cd.arm.trr0 = cpu->cd.arm.r[rd];
379:			break;
380:		case 5:	/*  trr1:  */
381:			if (l_bit)
382:				cpu->cd.arm.r[rd] = cpu->cd.arm.trr1;
383:			else
384:				cpu->cd.arm.trr1 = cpu->cd.arm.r[rd];
385:			break;
386:		case 6:	/*  tisr:  */
387:			if (l_bit)
388:				cpu->cd.arm.r[rd] = cpu->cd.arm.tisr;
389:			else {
390:				/*  Writing clears interrupts:  */
391:				cpu->cd.arm.tisr &= ~cpu->cd.arm.r[rd];
392:
393:				if (!(cpu->cd.arm.tisr & TISR_TMR0))
394:					INTERRUPT_DEASSERT(
395:					    cpu->cd.arm.tmr0_irq);
396:				if (!(cpu->cd.arm.tisr & TISR_TMR1))
397:					INTERRUPT_DEASSERT(
398:					    cpu->cd.arm.tmr1_irq);
399:			}
400:			break;
401:		case 7:	/*  wdtcr:  */
402:			if (l_bit)
403:				cpu->cd.arm.r[rd] = cpu->cd.arm.wdtcr;
404:			else
405:				cpu->cd.arm.wdtcr = cpu->cd.arm.r[rd];
406:			break;
407:		default:goto unknown;
408:		}
409:		break;
410:
411:	default:goto unknown;
412:	}
413:
414:	return;
415:
416:unknown:
417:	fatal("arm_coproc_i80321_6: unimplemented opcode1=%i opcode2=%i crn="
418:	    "%i crm=%i rd=%i l=%i)\n", opcode1, opcode2, crn, crm, rd, l_bit);
419:	exit(1);
420:}
