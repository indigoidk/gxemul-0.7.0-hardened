1:#!/usr/bin/env python3
2:"""Drive an emulated guest to a shell over a pty and check what it computes.
3:
4:Why a pty rather than a pipe: on a pipe, both the emulator and the guest's libc switch to
5:block buffering, so a run cut short by a timeout loses its last partial block. An earlier
6:version of this harness compared byte counts across builds over pipes and "found" a
7:capability regression that was entirely a lost 4 KB buffer. A pty is line-buffered and is
8:also the only way to type at a login prompt.
9:
10:Usage:  drive_guest.py <rig> <emulator-binary>
11:Exit:   0 all markers seen, 1 otherwise. Marker counts are printed as KEY=VALUE lines so
12:        the calling gate can parse them without guessing.
13:"""
14:import os
15:import pty
16:import re
17:import select
18:import sys
19:import time
20:
21:IMAGES = "/mnt/c/DocumentNoSnc/CC/GXEMUL/_images"
22:
23:# Each rig: the emulator arguments, the conversation, and the markers that must appear.
24:# A rig proves something only if it CHECKS AN ANSWER -- "the guest survived" is not a
25:# result. The FP steps below compute values whose correct output is known, so a wrong
26:# float_emul.c arm shows up as a wrong number rather than as a still-running guest.
27:RIGS = {
28:    # m88k: cpu_m88k_instr.c stores IEEE_FMT_S, i.e. the exact arm #287 changed, and had
29:    # no execution coverage at all before this rig existed.
30:    "luna88k": {
31:        # "R:" opens the base image read-only and sends every guest write to a temporary
32:        # overlay that is thrown away at exit. Without it each run mutates the shared 2 GB
33:        # image and later runs inherit whatever filesystem state earlier ones left --
34:        # including an unclean unmount when a timeout kills a booted guest. That made
35:        # gate 7 fail non-deterministically; see the note in gate_ab.sh.
36:        # #420: -N makes gxemul print "[ <ninstrs> instrs; ...]" every 2^25 instructions.
37:        # That stream is the progress oracle; see boot_progress() below.
38:        "args": ["-N", "-e", "luna-88k", "-d",
39:                 "R:" + IMAGES + "/liveimage-luna88k-raw-20250518.img", "boot"],
40:        "boot_wait": 2400,
41:        # #420, each measured. The 600 s that used to sit in boot_wait was the defect:
42:        # under 8 busy loops on 8 cores a healthy, fully-correct boot needs far longer
43:        # than 600 s. Two runs, and they are DIFFERENT runs -- do not merge them: gate 7's
44:        # file-polling driver reached login at 742 s (markers only), and this gate's pty
45:        # driver reached it at 720.8 s with every marker AND both computed values correct.
46:        # Against the old budget that boot scored BOOT_REACHED=0 and three red rows -- a
47:        # capability regression that never was.
48:        # 12 G is the same budget gate 7 uses (observed max 7.786 G over eleven boots,
49:        # +54%); it bounds only the failure path, since a healthy boot stops at the
50:        # marker long before it. 120 s of silence is 17x the worst inter-record gap
51:        # measured on this path under saturation (7.06 s; n=219, median 3.86).
52:        "budget": 12000000000,
53:        "stall": 120,
54:        "boot_pat": r"login:",
55:        "tries": 4,
56:        # Markers split in the source so they can only come from guest OUTPUT, never from
57:        # the pty echoing what was typed.
58:        "steps": [
59:            ("root\n", 8),
60:            ("\n", 5),
61:            ("echo GX_SHELL''_OK; uname -m\n", 12, r"GX_SHELL_OK"),
62:            # 1.5/3.0 = 0.5 and sqrt(2) = 1.414214 -- the ANSWER is what is checked.
63:            ("awk 'BEGIN{printf \"GX_FP %.6f %.6f\\n\", 1.5/3.0, 2.0**0.5}'\n", 15,
64:             r"GX_FP [\d.]+ [\d.]+"),
65:            ("echo GX_DO''NE\n", 8, r"GX_DONE"),
66:        ],
67:        "markers": ["login:", "GX_SHELL_OK", "GX_DONE"],
68:        "expect_values": {r"GX_FP ([\d.]+) ([\d.]+)": ["0.500000", "1.414214"]},
69:    },
70:    # SuperH: cpu_sh_instr.c also stores IEEE_FMT_S. The 7.6 install kernel stops at an
71:    # installer menu offering (S)hell.
72:    #
73:    # NO IN-GUEST FP CHECK HERE, and that is a measured limitation rather than an
74:    # oversight: the OpenBSD install ramdisk was probed and has no awk, perl, bc, dc or
75:    # python, and its shell arithmetic is integer-only ($((3/2)) evaluates to 1). There is
76:    # nothing on the media that can compute a float. What this rig therefore proves is
77:    # that the SH4 core executes a complete kernel boot and an interactive shell -- real
78:    # instruction-level coverage of cpu_sh_instr.c, but not of its FP store path.
79:    #
80:    # That gap is narrower than it looks. #287 is in the SHARED float_emul.c, and the
81:    # luna88k rig above exercises that shared arm from a non-MIPS caller with a checked
82:    # answer. What remains unproven for SuperH is only its own caller glue.
83:    "landisk": {
84:        "args": ["-N", "-E", "landisk", "-M", "64",
85:                 IMAGES + "/openbsd76-landisk-bsd.rd"],
86:        #  *** landiskdisk: dev_wdc.c HAD ZERO RIG COVERAGE IN THE WHOLE BATTERY. ***
87:        #  This rig booted a ramdisk with no disk image, so wdc0 attached and was never
88:        #  driven -- measured: not one ATA opcode reaches the command register across a
89:        #  full boot to the installer prompt.  With a disk attached the same boot issues
90:        #  14 command-register writes across SEVEN opcodes (3x 0xEC IDENTIFY, 3x 0x20
91:        #  READ, 2x 0xC6 SETMULTI, 2x 0x91 IDP, 2x 0x10 RECAL, 1x 0xF5 SEC_FREEZE_LOCK,
94:        #  SCOPE IT HONESTLY: this gives ZERO coverage of wdc_command()'s `default:` arm,
95:        #  which is where every filed wdc defect lives -- "Unimplemented command" warnings
96:        #  on a disked boot measured ZERO.  Its real value is 0xF5 as [[wdcnoirq]]'s
97:        #  witness, plus general wdc exercise.  No 0xE0, no 0x30 WRITE, no 0xC5
98:        #  WRITEMULTI: those need a full filesystem lifecycle through `halt -p`, which
99:        #  this rig never performs.
100:        #
101:        #  MEASURED SAFE, 4 fixed windows, same host and binary:
102:        #      no disk        prompt_reached=1  instrs=2,852,727,965
103:        #      iR: 64MB       prompt_reached=1  instrs=1,879,394,907
104:        #      no disk   (2)  prompt_reached=1  instrs=2,382,496,189
105:        #      iR: 64MB  (2)  prompt_reached=1  instrs=1,711,379,982
106:        #  Both reach the installer menu, wd0 attaches and is probed, and
107:        #  gate_crossfamily.sh's SH7751R,42 token is unaffected.
108:        #
109:        #  *** TWO TRAPS, BOTH MEASURED. ***
110:        #  (1) SYNTAX: `-d i:R:<path>` ABORTS.  diskimage_add() takes ALL prefix chars
111:        #      before a SINGLE colon (diskimage.c:1700-1755), so the form is `-d iR:`.
112:        #  (2) THE DISKED BOOT RETIRES 28-34% FEWER INSTRUCTIONS in the same wall time.
113:        #      Harmless TODAY only because "budget": 0 below -- landisk deliberately has
114:        #      no instruction ceiling.  But a NINSTRS floor is FILED, and a floor derived
115:        #      from a diskless boot and applied to a disked one is a false-FAIL waiting
116:        #      to happen.  Whoever calibrates that floor must calibrate the DISKED config.
117:        #
118:        #  The `R:` is not optional: plain `-d` opens the image read/write, so every boot
119:        #  would mutate the shared file and later runs would inherit the previous run's
120:        #  state.  R: discards guest writes into a pid-unique overlay.
121:        #
122:        #  OPTIONAL BY DESIGN.  _images/ is deliberately outside the repository, so on a
123:        #  fresh clone this file does not exist.  Absent, the rig boots exactly as it did
124:        #  before -- but it SAYS SO on stdout, because a silent revert to zero wdc
125:        #  coverage is indistinguishable from coverage that ran, which is this project's
126:        #  "silent coverage loss scored as a pass" class.
127:        "optional_disk": IMAGES + "/wdc-scratch-64m.img",
128:        "boot_wait": 900,
129:        # *** #420: NO INSTRUCTION BUDGET FOR LANDISK, AND THAT IS DELIBERATE. ***
130:        # Six idle landisk boots span 2,046,965,550 to 2,852,740,381 -- a 39.4% spread,
131:        # against luna88k's 3.57% over eight runs. A ceiling derived from that would be
132:        # either uselessly loose or a false-FAIL waiting to happen, and inventing one
133:        # from six samples would be exactly the "mean quoted as a worst case" error #419
134:        # pass 4 corrected. Landisk relies on the stall detector and the backstop until
135:        # somebody measures its rate properly; that is FILED, not fixed.
136:        #
137:        # Note also that landisk had no measured false-FAIL to begin with: it reaches its
138:        # prompt in 7.2-8.3 s against the old 420 s budget, 50x headroom. Converting it
139:        # buys DISTINGUISHABILITY -- a hung SH4 core now reports STALLED instead of a
140:        # timeout indistinguishable from load -- not headroom.
141:        "budget": 0,
142:        # Its -N records arrive far more often in WALL TIME than luna88k's (median gap
143:        # 0.04 s against 3.86 s; 62-87 records in an 8 s boot), so 60 s of silence is
144:        # overwhelming evidence of a hang.
145:        #
146:        # NOTE THE FRAMING, because an earlier version of this comment got it wrong twice:
147:        # it said "~20x denser" when the stated medians give 96x, and "denser" is the wrong
148:        # word anyway -- PER GUEST INSTRUCTION both streams fire at the same 2^25 cadence.
149:        # What differs is how fast landisk executes, not how often gxemul prints.
150:        "stall": 60,
151:        "boot_pat": r"\(I\)nstall, \(U\)pgrade, \(A\)utoinstall or \(S\)hell\?",
152:        # This rig is INTERACTIVE again as of #293. It originally sent no input at all,
153:        # because typed lines vanished non-deterministically -- measured at 10 of 12
154:        # commands lost whole, no echo, no execution. The cause was never the SCIF: the
155:        # machine's main console handle was unclaimed on landisk, so handle 0 (polled
156:        # every tick for CTRL-C) raced the SCIF for the same host stdin and stole whole
157:        # lines. #293 makes the SCIF claim the main console, after which the same probe
158:        # measures 12 of 12 commands delivered. The confirm-and-retry machinery is kept
159:        # as a belt against future regressions -- a retry that never fires is free.
160:        #
161:        # Markers are split in the source (GX_SH''ELL_OK) so a pty echo of the typed
162:        # command cannot satisfy them; only guest output can.
163:        "tries": 3,
164:        "settle": 2,
165:        "steps": [
166:            ("S\n", 15),
167:            ("stty sane\n", 5),
168:            ("echo GX_SH''ELL_OK\n", 8, r"GX_SHELL_OK"),
169:            # The checked ANSWER: integer arithmetic computed by the guest shell. The
170:            # typed text is "$((6*7))", which does not contain "42", so the value can
171:            # only come from execution.
172:            ("echo GX_ANS $((6*7))\n", 8, r"GX_ANS 42"),
173:            ("echo GX_DO''NE\n", 8, r"GX_DONE"),
174:        ],
175:        "markers": ["OpenBSD 7.6", "root on rd0a", "GX_SHELL_OK", "GX_DONE"],

