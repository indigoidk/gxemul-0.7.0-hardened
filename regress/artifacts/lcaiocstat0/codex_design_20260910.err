  386: /******************************************************************************
  387:  *                                                                            *
  388:  *  The following is glue code for PCI controllers and devices. The glue      *
  389:  *  code does the minimal stuff necessary to get an emulated OS to detect     *
  390:  *  the device (i.e. set up PCI configuration registers), and then if         *
  391:  *  necessary adds a "normal" device.                                         *
  392:  *                                                                            *
  393:  ******************************************************************************/
  394: 
  395: 
  396: 
  397: /*
  398:  *  Integraphics Systems "igsfb" Framebuffer (graphics) card, used in at
  399:  *  least the NetWinder.
  747: 	PCI_SET_DATA(PCI_BHLC_REG,
  748: 	    PCI_BHLC_CODE(0,0, 1 /* multi-function */, 0x40,0));
  749: 
  750: 	pd->cfg_reg_write = piix_isa_cfg_reg_write;
  751: }
  752: 
  753: PCIINIT(i82378zb)
  754: {
  755: 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_INTEL,
  756: 	    PCI_PRODUCT_INTEL_SIO));
  757: 
  758: 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_BRIDGE,
  759: 	    PCI_SUBCLASS_BRIDGE_ISA, 0) + 0x43);
  760: 
  761: 	PCI_SET_DATA(PCI_BHLC_REG,
  762: 	    PCI_BHLC_CODE(0,0, 1 /* multi-function */, 0x40,0));
  763: 
  764: 	PCI_SET_DATA(0x40, 0x20);
  765: 
  766: 	/*  PIRQ[0]=10 PIRQ[1]=11 PIRQ[2]=14 PIRQ[3]=15  */
  767: 	PCI_SET_DATA(0x60, 0x0f0e0b0a);
  768: }
