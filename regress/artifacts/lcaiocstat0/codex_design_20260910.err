  473: 		    unimplemented HOLES: STAT0 (+0x040), STAT1 (+0x060), SFT_RST
  474: 		    (+0x0c0) and PAR_DIS (+0x0e0) are DOCUMENTED registers this
  475: 		    model has never had, and S6.4.14 items 1-2 require SROM to
  476: 		    write SFT_RST and STAT0 -- those now survive as declined writes
  477: 		    instead of ending the process, and are filed (lcaiocstat0) for
  478: 		    an implementation, which this decline is not.  (grok, pass 2)  */
  479: 		{
  480: 			int bit = writeflag == MEM_WRITE ?
  481: 			    LCA_W_IOC_DEF_W : LCA_W_IOC_DEF_R;
