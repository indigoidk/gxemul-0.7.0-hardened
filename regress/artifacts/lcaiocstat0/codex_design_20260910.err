  492: 				fatal("  (once per direction) ]\n");
  493: 			}
  494: 		}
  495: 		break;
  496: 	}
  497: 
  498: 	if (writeflag == MEM_READ)
  499: 		memory_writemax64(cpu, data, len, odata);
  500: 
  501: 	return 1;
  502: }
