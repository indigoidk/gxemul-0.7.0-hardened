   30: 
   31: #include <stdio.h>
   32: #include <stdlib.h>
   33: #include <string.h>
   34: 
   35: #include "bus_isa.h"
   36: #include "bus_pci.h"
   37: #include "cpu.h"
   38: #include "device.h"
   39: #include "emul.h"
   40: #include "interrupt.h"
   41: #include "machine.h"
   42: #include "memory.h"
   43: #include "misc.h"
   44: 
   45: #include "thirdparty/alpha_lcareg.h"
   46: 
   47: #define	LCA_ISA_BASE	(LCA_PCI_SIO + 0x10000000)
   48: #define	LCA_ISA_MEMBASE	(LCA_PCI_SIO + 0x18000000)
   49: 
   50: 
   51: /*  #516: warn-once latch bits, one per stub.  PER-INSTANCE, reached through
   52:     `interrupt->extra' -- see the comment on lca_interrupt_assert().  */
   53: #define	LCA_W_IRQ_ASSERT	0	/*  #516  */
   54: #define	LCA_W_IRQ_DEASSERT	1	/*  #516  */
   55: #define	LCA_W_IOC_CONF_CFG1	2	/*  #518: IOC_CONF<1> set -- type-1 cycles not modelled  */
   56: #define	LCA_W_IOC_WMASK0	3	/*  #518: unsupported W_MASK0 encoding declined  */
   57: #define	LCA_W_IOC_WMASK1	4	/*  #518: unsupported W_MASK1 encoding declined  */
   58: #define	LCA_W_IOC_WEN		5	/*  #518: a DMA window enabled -- translation not modelled  */
   59: #define	LCA_W_IOC_DEF_W	6	/*  #518: default-arm write declined  */
   60: #define	LCA_W_IOC_DEF_R	7	/*  #518: default-arm read answered with zero  */
   61: 
   62: struct lca_data {
   63: 	struct pci_data		*pci_data;
   64: 
   65: 	unsigned int		warned;		/*  #516  */
   66: 
   67: 	uint64_t		ioc_conf;
   68: 	uint64_t		tlb_enable;
   69: 	uint64_t		window_base_0;
   70: 	uint64_t		window_mask_0;
   71: 	uint64_t		window_t_base_0;
   72: 	uint64_t		window_base_1;
   73: 	uint64_t		window_mask_1;
   74: 	uint64_t		window_t_base_1;
   75: };
   76: 
   77: 
   78: /*
   79:  *  lca_interrupt_assert():
   80:  *
   81:  *  Line 0 = ISA interrupt.
   82:  */
   83: void lca_interrupt_assert(struct interrupt *interrupt)
   84: {
   85: 	struct lca_data *d = (struct lca_data *) interrupt->extra;	/*  #516  */
   86: 
   87: 	/*  #516: this was `fatal(); exit(1)' with NO GUARD -- not a refused value,
   88: 	    an unimplemented path -- and DEVINIT below installs it as the ISA
   89: 	    interrupt callback that `bus_isa_init' wires to BUS_ISA_IDE0|IDE1.  So an
   90: 	    ordinary ISA interrupt ended the host, needing no unusual value anywhere.
   91: 	    MEASURED on two independent guest paths: one store to the 8042 command
   92: 	    port (regress/lca_irqstub_probe.py, 3/4) and three byte stores to the
   93: 	    ns16550 on IRQ 4 (regress/lca_irqstub_uart_probe.py, 2/4).
   94: 
   95: 	    *** THE STUB IS NOT REPLACED BY A FORWARD, BECAUSE A FORWARD WOULD BE A
   96: 	    NO-OP.  ALPHA HAS NO INTERRUPT DELIVERY AT ALL. ***  `cd.alpha.irq_asserted'
   97: 	    is written by `cpu_alpha.c' and read NOWHERE.  `cpu_dyntrans.c' turns a
   98: 	    pending interrupt into a delivered one for FIVE architectures -- ARM and
   99: 	    M88K and PPC through their own `irq_asserted', MIPS through the COP0
  100: 	    exception model, and SH through `int_to_assert' -- and ALPHA IS ABSENT
  101: 	    FROM THAT LIST.  (An earlier draft of this comment said "ARM, M88K and
  102: 	    PPC only": that enumeration was made by grepping for `irq_asserted', which
  103: 	    is a CORRELATE of delivering rather than the property, and it missed the
  104: 	    two architectures that deliver by another mechanism.  The Alpha conclusion
  105: 	    is unchanged and is strengthened -- it is the outlier among five, not
  106: 	    three.)  Calling `cpu_interrupt()' here would set
  107: 	    a field nothing consumes.  Implementing delivery is a SUBSYSTEM -- the
  108: 	    dyntrans dispatch, the PALcode entry and the IPL check -- and is its own
  109: 	    round, not this one.
  110: 
  111: 	    So the disposition is DECLINE plus a bounded announce, and what it buys is
  112: 	    stated narrowly on purpose: THE HOST STOPS DYING.  Interrupts do not start
  113: 	    working; they were never delivered on this architecture and still are not.
  114: 
  115: 	    The latch is PER-INSTANCE (`interrupt->extra'), not function-static: a
  116: 	    function-static bit would let one guest access to one device instance
  117: 	    silence the diagnostic for every other instance, which is a class already
  118: 	    filed against this tree.  */
  119: 	if (d != NULL && !(d->warned & (1u << LCA_W_IRQ_ASSERT))) {	/*  #516  */
  120: 		d->warned |= 1u << LCA_W_IRQ_ASSERT;
  121: 		fatal("[ lca: ISA interrupt assert not implemented (Alpha has no "
  122: 		    "interrupt delivery); ignored  (once) ]\n");
  123: 	}
  124: }
  125: 
  126: 
  127: /*
  128:  *  lca_interrupt_deassert():
  129:  *
  130:  *  Line 0 = ISA interrupt.
  131:  */
  132: void lca_interrupt_deassert(struct interrupt *interrupt)
  133: {
  134: 	struct lca_data *d = (struct lca_data *) interrupt->extra;	/*  #516  */
  135: 
  136: 	/*  #516: the sibling of lca_interrupt_assert() above, same reasoning.  A
  137: 	    SEPARATE latch bit, so the two are distinguishable: a driver normally
  138: 	    reaches both within one interrupt cycle, and one shared bit would report
  139: 	    whichever arrived first and hide the other entirely.  */
  140: 	if (d != NULL && !(d->warned & (1u << LCA_W_IRQ_DEASSERT))) {	/*  #516  */
  141: 		d->warned |= 1u << LCA_W_IRQ_DEASSERT;
  142: 		fatal("[ lca: ISA interrupt deassert not implemented (Alpha has no "
  143: 		    "interrupt delivery); ignored  (once) ]\n");
  144: 	}
  145: }
  146: 
  147: 
  148: DEVICE_ACCESS(lca_pci_conf)
  149: {
  150: 	uint64_t idata = 0, odata = 0;
  151: 	int tag, type1, bus, dev, func, reg;	/*  #515  */
  152: 	struct lca_data *d = (struct lca_data *) extra;
  153: 
  154: 	if (writeflag == MEM_WRITE)
  155: 		idata = memory_readmax64(cpu, data, len);
  156: 
  157: 	/*
  158: 	 *  1. Decompose the address into a tag.
  159: 	 *
  160: 	 *  According to NetBSD's lca_pci.c, the address is composed like this:
  161: 	 *
  162: 	 *	addr = tag << 5 | (regoffset & ~0x03) << 5 | 0x3 << 3
  163: 	 */
  164: 	reg = (relative_addr >> 5) & 0xfc;
  165: 	tag = (relative_addr >> 5) & ~0xff;
  166: 
  167: 	/*
  168: 	 *  2. Decompose the tag into bus, dev, and func.
  169: 	 *
  170: 	 *  The tag can be constructed in one of two ways. On the primary
  171: 	 *  bus (nr 0):
  172: 	 *
  173: 	 *	tag = (1 << (device + 11)) | (function << 8);
  174: 	 *
  175: 	 *  and on other busses, the tag is a normal:
  176: 	 *
  177: 	 *	tag = (bus << 16) | (device << 11) | (function << 8)
  178: 	 */
  179: 	/*  printf("tag = 0x%x\n", (int)tag);  */
  180: 
  181: 	/*  #515: `bus' used to be BOTH the configuration CYCLE TYPE and the
  182: 	    DESTINATION BUS, and conflating them is the whole defect.  IOC_CONF bit 0
  183: 	    selects the cycle type only -- 21066/21066A HRM S6.2.9: "PCI address bits
  184: 	    ad<1:0> come directly from configuration cycle type register (IOC_CONF,
  185: 	    Section 6.4.2) bits <1:0>" -- and it does NOT carry a bus number.  The
  186: 	    destination bus of a type-1 cycle lives in the ADDRESS, per the PCI Local
  187: 	    Bus specification's type-1 layout (bus 23..16, dev 15..11, fn 10..8,
  188: 	    reg 7..2), which S6.2.9 defers to explicitly.
  189: 
  190: 	    Before this, a guest that merely SET bit 0 -- a value the CONF guard
  191: 	    ACCEPTS -- made any subsequent access in this window reach
  192: 	    `fatal("TODO. Non-zero bus."); exit(1)'.  MEASURED: two ordinary guest
  193: 	    accesses, nothing refused anywhere on the path
  194: 	    (regress/lca_confbus_probe.py, 3/4 pre-fix; artifacts/lcaconfbus1kill/).  */
  195: 	type1 = d->ioc_conf & 1;	/*  #515  */
  196: 	bus = 0;			/*  #515  */
  197: 
  198: 	if (!type1) {			/*  #515  */
  199: 		/*  #511: was `0x800 << dev'.  `0x800' is a plain int (2^11) and `dev'
  200: 		    reaches 20, so the last iteration evaluates 2^31 -- a SIGNED
  201: 		    OVERFLOW, undefined by C99 6.5.7p4, not merely
  202: 		    implementation-defined.  MEASURED under UBSAN before the change:
  203: 		    "dev_lca.c:125:21: runtime error: left shift of 2048 by 20 places
  204: 		    cannot be represented in type 'int'", reached by an ordinary guest
  205: 		    ldq into the PCI config window (regress/lca_confbus_probe.py against
  206: 		    build-asan; artifacts/lcashiftub/ubsan_HEAD_20260907.raw).
  207: 
  208: 		    `0x800U' makes the operand unsigned, so 2048U << 20 is 0x80000000U --
  209: 		    inside unsigned int -- and NOTHING ELSE MOVES.
  210: 
  211: 		    *** THE REASON, CORRECTED: AN EARLIER DRAFT SAID `tag' IS "ALREADY A
  212: 		    WIDER UNSIGNED QUANTITY".  THAT IS FALSE -- `tag' is a plain signed
  213: 		    `int' (:92) -- AND FOUR PASS-2 SEATS CAUGHT IT.  Worse, the claim was
  214: 		    backwards: being WIDER is what would CREATE a difference, not remove
  215: 		    one.  Had `tag' been `uint64_t', the old `int' 0x80000000 is NEGATIVE
  216: 		    and would SIGN-EXTEND to 0xffffffff80000000 for the `&', while
  217: 		    `0x800U << 20' zero-extends to 0x0000000080000000 -- two different
  218: 		    masks.  The seats were right about the mechanism and it does not fire
  219: 		    here only because of the type.
  220: 
  221: 		    WHAT ACTUALLY HOLDS: both operands are 32-bit, so the `&' is performed
  222: 		    at 32 bits either way -- `int & int' before, and after, `tag' converted
  223: 		    to `unsigned int' by the usual arithmetic conversions.  The RESULT'S
  224: 		    BIT PATTERN IS IDENTICAL; only its type changes, and it is consumed
  225: 		    solely as a truth test in `if (...)'.  So no guest-visible value moves,
  226: 		    and the repair is owed purely by the LANGUAGE. ***
  227: 
  228: 		    *** THE LOOP THIS SITS IN IS THIS FILE'S OWN GRACEFUL-DEGRADATION
  229: 		    PRECEDENT -- the `dev >= 21' arm below has a commented-out
  230: 		    fatal()/exit(1) and substitutes `dev = 0' instead, and `lcabadval'
  231: 		    cites it as a transferable warrant.  The safe path contained the UB. ***  */
  232: 		for (dev=0; dev<21; dev++)
  233: 			if (tag & (0x800U << dev))	/*  #511  */
  234: 				break;
  235: 		if (dev >= 21) {
  236: 			/*  fatal("[ LCA: No bus 0 device? TODO ]\n");
  237: 			exit(1);  */
  238: 			dev = 0;
  239: 		}
  240: 	} else {
  241: 		/*  #515: a type-1 cycle carries its destination in the address.  */
  242: 		bus = (tag >> 16) & 0xff;	/*  #515  */
  243: 		dev = (tag >> 11) & 0x1f;	/*  #515  */
  244: 	}
  245: 
  246: 	func = (tag >> 8) & 7;
  247: 	/*  printf("bus=%i dev=%i func=%i reg=%i\n", bus,dev,func,reg);  */
  248: 
  249: 	/*  #515: a type-1 cycle whose bus field is zero selects NOTHING.  Type-1 is
  250: 	    how a bridge is asked to reach a bus BEHIND it; the primary bus is reached
  251: 	    with type-0 cycles, whose IDSEL encoding is decoded above.  Forwarding this
  252: 	    case would set cur_bus = 0 and hand the access to whichever primary-bus
  253: 	    device matched -- `i82378zb' is registered at 0:7:0 by DEVINIT below -- so
  254: 	    simply decoding `bus' and stopping there would replace a host kill with a
  255: 	    NEW MISROUTING.  Refuse it instead, matching `bus_pci_data_access''s own
  256: 	    empty-slot contract (bus_pci.c, the `dev == NULL' arm: all-ones at register
  257: 	    0, zero elsewhere) so the guest sees the ordinary "nothing there" answer.
  258: 	    Writes are discarded, which leaves backend state untouched.  */
  259: 	if (type1 && bus == 0) {		/*  #515  */
  260: 		odata = reg == 0? (uint64_t) -1 : 0;
  261: 	} else {
  262: 		/*  Pass PCI accesses onto bus_pci:  */
  263: 		bus_pci_setaddr(cpu, d->pci_data, bus, dev, func, reg);
  264: 		bus_pci_data_access(cpu, d->pci_data, writeflag == MEM_READ?
  265: 		    &odata : &idata, len, writeflag);
  266: 	}
  267: 
  272: }  273: 
  274: 
  275: DEVICE_ACCESS(lca_isa)
  276: {
  277: 	unsigned int ofs, i;
  278: 	uint8_t byte;
  279: 
  280: 	relative_addr >>= 5;
  281: 
  282: 	ofs = relative_addr & 3;
  283: 	if (ofs > len) {
  284: 		fatal("[ ofs=%i len=%i in lca_isa access function. "
  285: 		    "aborting ]\n", ofs, len);
  286: 		exit(1);
  287: 	}
  288: 
  289: 	if (writeflag == MEM_WRITE) {
  290: 		byte = data[ofs % len];
  291: 		return cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE +
  292: 		    relative_addr, &byte, 1, writeflag, CACHE_NONE);
  293: 	}
  294: 
  295: 	cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE + relative_addr,
  296: 	    &byte, 1, MEM_READ, CACHE_NONE);
  297: 
  298: 	for (i=0; i<len; i++)
  299: 		data[i] = i == ofs? byte : 0x00;
  300: 
  301: 	return 1;
  302: }
  303: 
  304: 
  305: /*
  306:  *  #518 (lcabadval): one bounded announce per (device instance, reason).  Six
  307:  *  IOC write arms used to end the host with fatal()+exit(1) on any value outside
  308:  *  a tiny accepted set -- and the sets were WRONG, not merely harsh: the 21066
  309:  *  HRM (Table 6-6) lists THIRTEEN legal W_MASK encodings where the model took
  310:  *  one, and S6.4.14 REQUIRES SROM to write ZERO to W_BASE1, which was fatal.
  311:  *  The arms below store the ARCHITECTED FIELDS, ignore reserved bits (type X),
  312:  *  validate W_MASK by its field rule, and decline what the model cannot honour
  313:  *  with this announce -- fatal() prints and returns (it cannot be silenced by
  314:  *  -q, which is why a latch and not a verbosity flag).
  315:  */
  316: static void lca_ioc_announce(struct lca_data *d, int bit, const char *what,
  317: 	uint64_t v)
  318: {
  319: 	if (d->warned & (1u << bit))
  320: 		return;
  321: 	d->warned |= 1u << bit;
  322: 	fatal("[ lca_ioc: %s: 0x%" PRIx64 "  (once) ]\n", what, v);
  323: }
  324: 
  325: 
  326: DEVICE_ACCESS(lca_ioc)
  327: {
  328: 	uint64_t idata = 0, odata = 0;
  329: 	struct lca_data *d = (struct lca_data *) extra;
  330: 
  331: 	if (writeflag == MEM_WRITE)
  332: 		idata = memory_readmax64(cpu, data, len);
  333: 
  334: 	switch (relative_addr + LCA_IOC_BASE) {
  335: 
  336: 	case LCA_IOC_BASE:
  337: 		/*  Ignore? Linux reads from the base at startup.  */
  338: 		break;
  339: 
  340: 	case LCA_IOC_CONF:
  341: 		if (writeflag == MEM_READ) {
  342: 			odata = d->ioc_conf;
  343: 		} else {
  344: 			/*  #518: was `if (idata & ~1) { fatal(); exit(1); }' with the
  345: 			    store BEFORE the check (#506 had widened its diagnostic).
  346: 			    HRM S6.2.9: IOC_CONF<1:0> select the configuration cycle
  347: 			    TYPE; everything above is reserved and is IGNORED, not
  348: 			    fatal.  Bit 0 selects type-1 cycles and is what lca_pci_conf
  349: 			    reads (#515); bit 1 selects the CFG AD<1:0> encodings 10/11,
  350: 			    which are not configuration-cycle types -- stored and
  351: 			    announced once, not modelled.  (Pass 2: this comment first
  352: 			    called bit 1 the type-1 select; grok read lca_pci_conf.)  */
  353: 			d->ioc_conf = idata & 0x3ULL;
  354: 			if (idata & 0x2ULL)
  355: 				lca_ioc_announce(d, LCA_W_IOC_CONF_CFG1, "IOC_CONF<1> set"
  356: 				    " (CFG AD<1:0> = 10/11, not a configuration-cycle type):"
  357: 				    " stored, not modelled", idata);
  358: 		}
  359: 		break;
  360: 
  361: 	case LCA_IOC_TBIA:
  362: 		/*  TLB Invalidate All.  */
  363: 		/*  TODO: For now, let's just ignore it.  */
  364: 		break;
  365: 
  366: 	case LCA_IOC_TB_ENA:
  367: 		if (writeflag == MEM_READ) {
  368: 			odata = d->tlb_enable;
  369: 		} else {
  370: 			/*  #518: TEN is the only architected bit (HRM Table 6-13);
  371: 			    the rest are type X -- IGNORED on write, never fatal.  The
  372: 			    old arm stored the whole value and then died on it.  */
  373: 			d->tlb_enable = idata & IOC_TB_ENA_TEN;
  374: 		}
  375: 		break;
  376: 
  377: 	case LCA_IOC_W_BASE0:
  378: 		if (writeflag == MEM_READ) {
  379: 			odata = d->window_base_0;
  380: 		} else {
  381: 			/*  #518: was a two-value whitelist + exit(1).  The HRM defines
  382: 			    this register by FIELDS -- W_BASE<31:20>, SG<32>, WEN<33> --
  383: 			    not by a list of numbers, and S6.4.14 REQUIRES SROM to write
  384: 			    zero here.  Store the fields (reserved bits dropped); the
  385: 			    window is not translated by this model, which is announced
  386: 			    once when any window is ENABLED.  */
  387: 			d->window_base_0 = idata & (IOC_W_BASE_W_BASE | IOC_W_BASE_SG | IOC_W_BASE_WEN);
  388: 			if (idata & IOC_W_BASE_WEN)
  389: 				lca_ioc_announce(d, LCA_W_IOC_WEN, "a DMA window was"
  390: 				    " enabled; window translation is not modelled", idata);
  391: 		}
  392: 		break;
  393: 
  394: 	case LCA_IOC_W_MASK0:
  395: 		if (writeflag == MEM_READ) {
  396: 			odata = d->window_mask_0;
  397: 		} else {
  398: 			/*  #518: was `!= 0x700000ULL' + exit(1): ONE accepted value where
  399: 			    HRM Table 6-6 lists THIRTEEN (W_MASK<31:20> = 0, 1, 3, 7, ...
  400: 			    0xfff: a contiguous low-ones field), and the old arm STORED
  401: 			    before it checked.  Validate the field, store only when it is
  402: 			    legal, decline once otherwise with the previous value kept.  */
  403: 			{
  404: 				uint64_t v = idata & 0xfff00000ULL, f = v >> 20;
  405: 				if ((f & (f + 1)) == 0)
  406: 					d->window_mask_0 = v;
  407: 				else
  408: 					lca_ioc_announce(d, LCA_W_IOC_WMASK0, "unsupported"
  409: 					    " IOC_W_MASK0 encoding declined (HRM Table 6-6);"
  410: 					    " previous value kept", idata);
  411: 			}
  412: 		}
  413: 		break;
  414: 
  415: 	case LCA_IOC_W_T_BASE0:
  416: 		if (writeflag == MEM_READ) {
  417: 			odata = d->window_t_base_0;
  418: 		} else {
  419: 			d->window_t_base_0 = idata;
  420: 			/*  TODO: Actually implement this.  */
  421: 		}
  422: 		break;
  423: 
  424: 	case LCA_IOC_W_BASE1:
  425: 		if (writeflag == MEM_READ) {
  426: 			odata = d->window_base_1;
  427: 		} else {
  428: 			/*  #518: was a ONE-value whitelist + exit(1) -- and the one value
  429: 			    was not zero, which S6.4.14 item 3 requires SROM to write.
  430: 			    Same disposition as W_BASE0 above.  */
  431: 			d->window_base_1 = idata & (IOC_W_BASE_W_BASE | IOC_W_BASE_SG | IOC_W_BASE_WEN);
  432: 			if (idata & IOC_W_BASE_WEN)
  433: 				lca_ioc_announce(d, LCA_W_IOC_WEN, "a DMA window was"
  434: 				    " enabled; window translation is not modelled", idata);
  435: 		}
  436: 		break;
  437: 
  438: 	case LCA_IOC_W_MASK1:
  439: 		if (writeflag == MEM_READ) {
  440: 			odata = d->window_mask_1;
  441: 		} else {
  442: 			/*  #518: was `!= 0x3ff00000ULL' + exit(1): ONE accepted value where
  443: 			    HRM Table 6-6 lists THIRTEEN (W_MASK<31:20> = 0, 1, 3, 7, ...
  444: 			    0xfff: a contiguous low-ones field), and the old arm STORED
  445: 			    before it checked.  Validate the field, store only when it is
  446: 			    legal, decline once otherwise with the previous value kept.  */
  447: 			{
  448: 				uint64_t v = idata & 0xfff00000ULL, f = v >> 20;
  449: 				if ((f & (f + 1)) == 0)
  450: 					d->window_mask_1 = v;
  451: 				else
  452: 					lca_ioc_announce(d, LCA_W_IOC_WMASK1, "unsupported"
  453: 					    " IOC_W_MASK1 encoding declined (HRM Table 6-6);"
  454: 					    " previous value kept", idata);
  455: 			}
  456: 		}
  457: 		break;
  458: 
  459: 	case LCA_IOC_W_T_BASE1:
  460: 		if (writeflag == MEM_READ) {
  461: 			odata = d->window_t_base_1;
  462: 		} else {
  463: 			d->window_t_base_1 = idata;
  464: 			/*  TODO: Actually implement this.  */
  465: 		}
  466: 		break;
  467: 
  468: 	default:
  469: 		/*  #518: was fatal()+exit(1) for ANY offset the switch does not
  470: 		    list.  Decline the write (no state changes), answer a read with
  471: 		    zero (odata is already 0), announce each direction once.  The
  472: 		    value keeps #506's full width.  NOT all of these offsets are
  473: 		    unimplemented HOLES: STAT0 (+0x040), STAT1 (+0x060), SFT_RST
  474: 		    (+0x0c0) and PAR_DIS (+0x0e0) are DOCUMENTED registers this
  475: 		    model has never had, and S6.4.14 items 1-2 require SROM to
  476: 		    write SFT_RST and STAT0 -- those now survive as declined writes
  477: 		    instead of ending the process, and are filed (lcaiocstat0) for
  478: 		    an implementation, which this decline is not.  (grok, pass 2)  */
  479: 		{
  480: 			int bit = writeflag == MEM_WRITE ?
  481: 			    LCA_W_IOC_DEF_W : LCA_W_IOC_DEF_R;
  482: 			if (!(d->warned & (1u << bit))) {
  483: 				d->warned |= 1u << bit;
  484: 				fatal("[ lca_ioc: unimplemented %s to offset 0x%x",
  485: 				    writeflag == MEM_WRITE? "write" : "read", (int)
  486: 				    relative_addr);
  487: 				if (writeflag == MEM_WRITE)
  488: 					fatal(": 0x%" PRIx64 " -- declined",
  489: 					    (uint64_t)idata);	/*  #506  */
  490: 				else
  491: 					fatal(" -- answered with zero");
  492: 				fatal("  (once per direction) ]\n");
  493: 			}
  494: 		}
  495: 		break;
  496: 	}
  497: 
  498: 	if (writeflag == MEM_READ)
  499: 		memory_writemax64(cpu, data, len, odata);
  500: 
  501: 	return 1;
  502: }
  503: 
  504: 
  505: DEVINIT(lca)
  506: {
  507: 	char *interrupt_path;
  508: 	struct interrupt interrupt_template;
  509: 	struct lca_data *d;
  510: 
  511: 	CHECK_ALLOCATION(d = (struct lca_data *) malloc(sizeof(struct lca_data)));
  512: 	memset(d, 0, sizeof(struct lca_data));
  513: 
  514: 	/*  Register a PCI bus:  */
  515: 	d->pci_data = bus_pci_init(
  516: 	    devinit->machine,
  517: 	    "TODO: irq"		/*  pciirq: TODO  */,
  518: 	    LCA_PCI_SIO,	/*  pci device io offset  */
  519: 	    0x00000000,		/*  pci device mem offset: TODO  */
  520: 	    0x00000000,		/*  PCI portbase: TODO  */
  521: 	    0x00000000,		/*  PCI membase: TODO  */
  522: 	    "TODO: pci irq base",	/*  PCI irqbase: TODO  */
  523: 	    LCA_ISA_BASE,	/*  ISA portbase  */
  524: 	    LCA_ISA_MEMBASE,	/*  ISA membase  */
  525: 	    "TODO: irqbase isa");                /*  ISA irqbase: TODO  */
  526: 
  527: 	/*  Add the "sio0" controller (as seen by NetBSD):  */
  528: 	bus_pci_add(devinit->machine, d->pci_data, devinit->machine->memory,
  529: 	    0, 7, 0, "i82378zb");
  530: 
  531: 	memory_device_register(devinit->machine->memory, "lca_pci_conf",
  532: 	    LCA_PCI_CONF, 0x20000000, dev_lca_pci_conf_access, (void *)d,
  533: 	    DM_DEFAULT, NULL);
  534: 
  535: 	memory_device_register(devinit->machine->memory, "lca_isa",
  536: 	    LCA_PCI_SIO, 0x10000 << 5, dev_lca_isa_access, (void *)d,
  537: 	    DM_DEFAULT, NULL);
  538: 
  539: 	memory_device_register(devinit->machine->memory, "lca_ioc",
  540: 	    LCA_IOC_BASE, 0x20000000, dev_lca_ioc_access, (void *)d,
  541: 	    DM_DEFAULT, NULL);
  542: 
  543: 	CHECK_ALLOCATION(interrupt_path = (char *)
  544: 	    malloc(strlen(devinit->machine->path) + 10));
  545: 	snprintf(interrupt_path, strlen(devinit->machine->path) + 10,
  546: 	    "%s.lca", devinit->machine->path);
  547: 
  548: 	memset(&interrupt_template, 0, sizeof(interrupt_template));
  549: 	interrupt_template.line = 0;
  550: 	interrupt_template.name = interrupt_path;
  551: 	interrupt_template.extra = d;
  552: 	interrupt_template.interrupt_assert = lca_interrupt_assert;
  553: 	interrupt_template.interrupt_deassert = lca_interrupt_deassert;
  554: 	interrupt_handler_register(&interrupt_template);
  555: 
  556: 	bus_isa_init(devinit->machine, interrupt_path,
  557: 	    BUS_ISA_IDE0 | BUS_ISA_IDE1, LCA_ISA_BASE, LCA_ISA_MEMBASE);
  558: 
  559: 	return 1;
  560: }
