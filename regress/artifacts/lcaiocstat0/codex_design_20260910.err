  125: 	pd->cfg_mem[(ofs) + 1] = ((value) >> 8) & 255;			\
  126: 	pd->cfg_mem[(ofs) + 2] = ((value) >> 16) & 255;			\
  127: 	pd->cfg_mem[(ofs) + 3] = ((value) >> 24) & 255;			\
  128: 	}
