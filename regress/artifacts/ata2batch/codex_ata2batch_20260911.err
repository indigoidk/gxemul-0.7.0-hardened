  1988: 	memset(d, 0, sizeof(struct wdc_data));
  1989: 
  1990: 	INTERRUPT_CONNECT(devinit->interrupt_path, d->irq);
  1991: 	d->addr_mult  = devinit->addr_mult;
  1992: 	d->data_debug = 1;
  1993: 	d->io_enabled = 1;
  1994: 	d->error      = 1;
  1995: 
  1996: 	d->inbuf = (unsigned char *) zeroed_alloc(WDC_INBUF_SIZE);
  1997: 
  1998: 	/*  base_drive = 0 for the primary controller, 2 for the secondary.  */
  1999: 	d->base_drive = 0;
  2000: 	if ((devinit->addr & 0xfff) == 0x170)
  2001: 		d->base_drive = 2;
  2002: 
  2003: 	alt_status_addr = devinit->addr + 0x206;
  2004: 
  2005: 	/*  Special hacks for individual machines:  */
  2006: 	switch (devinit->machine->machine_type) {
  2007: 	case MACHINE_MACPPC:
  2008: 		alt_status_addr = devinit->addr + 0x160;
  2009: 		break;
  2010: 	case MACHINE_HPCMIPS:
  2011: 		/*  TODO: Fix  */
  2012: 		if (devinit->addr == 0x14000180)
  2013: 			alt_status_addr = 0x14000386;
  2014: 		break;
  2015: 	case MACHINE_IQ80321:
  2016: 		alt_status_addr = devinit->addr + 0x402;
  2017: 		break;
  2018: 	}
  2019: 
  2020: 	/*  Get disk geometries:  */
  2021: 	for (i=0; i<2; i++)
  2022: 		if (diskimage_exist(devinit->machine, d->base_drive +i,
  2023: 		    DISKIMAGE_IDE))
  2024: 			diskimage_getchs(devinit->machine, d->base_drive + i,
  2025: 			    DISKIMAGE_IDE, &d->cyls[i], &d->heads[i],
  2026: 			    &d->sectors_per_track[i]);
  2027: 
  2028: 	memory_device_register(devinit->machine->memory, "wdc_altstatus",
  2029: 	    alt_status_addr, 2, dev_wdc_altstatus_access, d, DM_DEFAULT, NULL);
  2030: 	memory_device_register(devinit->machine->memory, devinit->name,
