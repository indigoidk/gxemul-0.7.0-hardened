   965: 	/*  Unsupported commands, without warning:  */
   966: 	case WDCC_SEC_SET_PASSWORD:
   967: 	case WDCC_SEC_UNLOCK:
   968: 	case WDCC_SEC_ERASE_PREPARE:
   969: 	case WDCC_SEC_ERASE_UNIT:
   970: 	case WDCC_SEC_FREEZE_LOCK:
   971: 	case WDCC_SEC_DISABLE_PASSWORD:
   972: 		/*  #485: A TERMINAL ARM RAISES ITS COMPLETION INTERRUPT.
   973: 
   974: 		    THE INVARIANT, derived over all 256 opcodes rather than from a
   975: 		    few neighbours: every command wdc_command() FINISHES raises the
   976: 		    completion interrupt.  The only opcodes that stay silent are the
   977: 		    THREE that hand control back for a data phase -- WDCC_WRITE,
   978: 		    WDCC_WRITEMULTI and ATAPI_PKT_CMD -- and each of those asserts
   979: 		    when its data phase drains.  This arm and the `default:` arm
   980: 		    below were the only violations.
   981: 
   982: 		    *** THEY WERE ALSO THE ONLY TERMINAL ARMS IN THE FUNCTION WITH NO
   983: 		    INTERRUPT DECISION RECORDED AT ALL -- no assert, and no comment.
   984: 		    ***  Six arms carry a `TODO ... interrupt` hedge; in five the
   985: 		    author asserted, and in the sixth (ATAPI_PKT_CMD) he left the
   986: 		    assert COMMENTED OUT, so that decision is visible in the source.
   987: 		    A question never reached, not a decision to stay silent.
   988: 
   989: 		    NO SPECIFICATION IS CITED AND NONE IS AVAILABLE -- there is no ATA
   990: 		    document in this tree.  The warrant is the invariant above plus a
   991: 		    sibling model: dev_mb89352.c asserts on ANY non-zero interrupt
   992: 		    status, without regard to whether the command succeeded.
  1829: 
  1830: 				    The CONDITION is kept: it fires where the unfixed code would have
  1831: 				    put a spurious sector on the disk image, which is worth saying
  1832: 				    however the ring reached that state.  The TEXT now describes what
  1833: 				    happened -- a drain was refused -- instead of asserting a buffer
  1834: 				    state it never checked.  */
  1835: 				fatal("[ wdc: refused a sector drain the buffer "
