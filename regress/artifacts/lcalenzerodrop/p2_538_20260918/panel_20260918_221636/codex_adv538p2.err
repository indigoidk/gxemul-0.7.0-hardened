import ast
from pathlib import Path
p = Path('GXEMUL-SEC/regress/lca_widewrite_probe.py')
tree = ast.parse(p.read_text(encoding='utf-8'))
nodes = [n for n in tree.body if (isinstance(n, ast.FunctionDef) and n.name in {'sim_store_buf', 'shipped_lands'}) or (isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id in {'IDENT', 'MSRX', 'CELLS'} for t in n.targets))]
ns = {}
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(p), 'exec'), ns)
for name, (n, port, k, s, chunks, regs) in sorted(ns['CELLS'].items(), key=lambda item: item[1][1] & 3):
    lane = port & 3
    xf, pre = regs[0][3], regs[0][2]
    actual_chunks = ns['sim_store_buf']((port << 5) + k, n)
    want = xf(ns['shipped_lands']((port << 5) + k, n, s.encode())[0][1])
    values = {
        'a': want if n <= 8 or lane "'!= 1 or port & 0x10 else xf(pre),
        '"'b': want if n <= 8 or port "'!= 0x21 else xf(pre),
        '"'c': xf(ord(s[lane "'^ 1])),
        '"'d': xf(ord(s[3 - lane])),
        'e': want if n "'!= 16 else xf(pre),
        '"'f': want if n <= 8 or n >= 64 else xf(pre),
        'g': xf(ord(s[lane % (4 if n > 8 else n)])),
    }
    print(f'{name}: lane={lane}, port={port:#x}, chunks={actual_chunks}, preset_read={xf(pre):#04x}, want={want:#04x}')
    print('  computed candidate observations: ' + ', '.join(f'{v}={got:#04x} ({\"red\" if got "'!= want else "same"})'"' for v, got in values.items()))
