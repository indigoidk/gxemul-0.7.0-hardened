937: elif [ -f "$LEDGER" ] && awk -v p="$PREV" '!/^#/ && $1 != "" { if (index(p, $1) == 1) found=1 } END { exit !found }' "$LEDGER"; then
938: 	#  PREFIX match, not equality: git gives a FULL sha and a human writing the receipt
939: 	#  will naturally paste the SHORT one.  The first version compared them with grep -x
940: 	#  and could therefore NEVER match -- caught by running the positive control instead
941: 	#  of only the negative one.  A check that always fails is a different bug from one
942: 	#  that always passes, and just as useless.
943: 	good "pass-2 receipt found for $(git -C "$SEC" log -1 --format=%h "$PREV")"
