  545: 
  546: /*
  547:  *  #461: report an unimplemented offset ONCE per (direction, word).
  548:  *
  549:  *  `nkeys` is passed rather than assumed so the two windows cannot share a
  550:  *  bound by accident, and it is the SAME macro that dimensions the caller's
  551:  *  array.  The check is therefore live: it is not defending against a guest
  552:  *  (registration already does that) but against a future edit that changes
  553:  *  one window's size without the other -- and against the measured mutant
  554:  *  that indexes by raw address, which lands past the latch rows and
  555:  *  directly on dma_reg[].
  556:  *
  557:  *  *** THE MAGNITUDE WAS OVERSTATED AND A SEAT MEASURED IT. ***  This
  558:  *  said "five words past a [2][2] array ... the two fields that authorise
  559:  *  a transfer".  A guardless bits[k] reaches dma_reg[0..3] -- count,
  560:  *  destination and length -- but NOT dma_reg[5], the ENABLE, which needs
  561:  *  word index 11 against a reachable maximum of 9.  Three of the four,
  562:  *  not two; and the overreach is 4 words for the read row and 6 for the
  563:  *  write row, not five for both.  The defect is real either way; the
  564:  *  sentence was not.
  565:  */
  566: static int gdrom_unimpl_first(uint32_t *bits, size_t nkeys, uint32_t off)
  567: {
  568: 	size_t k = off / sizeof(uint32_t);
  569: 	uint32_t bit;
  570: 
  571: 	if (k >= nkeys)
  572: 		return 0;
  573: 
  574: 	bit = 1u << (k & 31);
  575: 	if (bits[k >> 5] & bit)
  576: 		return 0;
  577: 
  578: 	bits[k >> 5] |= bit;
  579: 	return 1;
  580: }
  581: 
  582: /*
  583:  *  #461 pass 2: BIND THE EXTENT TO THE ARRAY, not merely to a number that
  584:  *  happens to match it.
  585:  *
  586:  *  The round claimed its structural defence was that GDROM_NKEYS both sizes
  587:  *  the array and guards the helper, so the number is never written twice.
  588:  *  *** A PASS-2 SEAT MEASURED THAT CLAIM TRUE OF THE NUMBER AND FALSE OF THE
  589:  *  BINDING. ***  `bits` and `nkeys` are two independent arguments, so pointing
  590:  *  the CONTROL arm at d->dma_unimpl_reported while keeping GDROM_NKEYS passes
  591:  *  every row AND writes one word past the shorter row -- onto dma_reg[0].
  592:  *  ASan cannot see it either: it is member-to-member inside one malloc.
  593:  *
  594:  *  sizeof(arr) * 8 derives the extent FROM the array named in the same
  595:  *  expression, so the two cannot disagree.  8 bytes * 8 = 64 keys for the
  596:  *  control window, 4 * 8 = 32 for DMA -- exact for both, and a future window
  597:  *  gets its own for free.  `arr` is evaluated twice but is side-effect-free
  598:  *  (a member selection and a constant-index subscript).
  599:  *
  600:  *  *** `arr` MUST BE A uint32_t[] -- TWO PASS-3 SEATS FLAGGED THIS
  601:  *  INDEPENDENTLY. ***  `sizeof(arr) * 8` is element-type-agnostic and would
  602:  *  compute the right BIT COUNT for any array, but gdrom_unimpl_first takes
  603:  *  `uint32_t *bits` and indexes `bits[k >> 5]` with `1u << (k & 31)`.  Hand
  604:  *  it a uint8_t[] and the count would be right while the indexing is wrong.
  605:  *
  606:  *  *** THE 'SILENT' HALF OF THAT WARNING IS MEASURED FALSE ON THIS TOOLCHAIN,
  607:  *  and a seat built both forms to check. ***  An earlier draft called it 'the
  608:  *  worst combination, because the obvious sanity check passes'.  Both
  609:  *  uint8_t[] and uint64_t[] are HARD BUILD ERRORS at both call sites (GCC
  610:  *  15.2.1; -Wincompatible-pointer-types has been an error by default since
  611:  *  GCC 14), so the mistake cannot reach a running binary here.
  612:  *
  613:  *  The constraint is still worth stating -- it holds for a pre-GCC-14
  614:  *  compiler and this tree targets portable C99 -- but as a PORTABILITY
  615:  *  caution, not as a silent-corruption hazard on the compiler in use.
  616:  *
  617:  *  Stated rather than asserted.  *** THE REASON GIVEN HERE WAS "`_Static_assert` is C11 and
  618:  *  this tree is C99", AND THAT IS REFUTED -- INSIDE THIS FILE'S OWN TRANSLATION UNIT.
  619:  *  Corrected 2026-08-28; found by the opus seat, which was the only one of nine to look. ***
  620:  *
  621:  *  `#include "thirdparty/dreamcast_sysasicvar.h"` at the top of this file brings in
  622:  *  SYSASIC_EVENT_RANGE_OK, a C99 compile-time bound assert, and every
  623:  *  SYSASIC_TRIGGER_EVENT() call here expands it -- FOUR of them, compiled on every build,
  624:  *  two hundred lines below this sentence claiming the technique is unavailable.  The
  625:  *  build also passes no `-std=` at all and the compiler reports __STDC_VERSION__ 202311L,
  626:  *  so "this tree is C99" is a PORTABILITY POLICY, not a fact about what compiles.
  627:  *  sysasicvar.h records both legs of exactly this rationale being refuted by measurement
  628:  *  on #466's pass 2 -- one day before this comment shipped.
  629:  *
  630:  *  The claim is therefore narrowed to what survives: an assert here is not IMPOSSIBLE,
  631:  *  it is merely NOT YET WRITTEN, and the constraint is visible at every call site because
  632:  *  the two existing callers both pass uint32_t[N][M] members declared a few lines above.
  633:  *  (The count-fits-its-carriers bound near the warn-bit enum IS now asserted; this
  634:  *  paragraph governs a DIFFERENT constraint -- GDROM_UNIMPL_FIRST's array type -- and the
  635:  *  two were conflated once already, in a brief that cited this comment for that bound.)
  636:  */
  637: #define	GDROM_UNIMPL_FIRST(arr, off)	\
  638: 	gdrom_unimpl_first((arr), sizeof(arr) * 8, (off))
