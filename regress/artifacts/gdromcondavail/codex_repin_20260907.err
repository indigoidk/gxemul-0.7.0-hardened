  268:         "put h 0x%x, 0x%04x" % (at, op1),
  269:         "put h 0x%x, 0x%04x" % (at + 2, op2),
  270:         "put h 0x%x, 0x%04x" % (at + 4, BRA_SELF),
  271:         "put h 0x%x, 0x%04x" % (at + 6, NOP),
  272:         "pc=0x%x" % at, "step 2"]
  273: 
  274: 
  275: ST = ["r7=0x%x" % GDROM_DATA, "r8=0x00005a5a"]     # store setup
  276: LD = ["r1=0x%x" % GDROM_DATA, "r2=0"]              # load setup
  277: 
  278: #  *** THE LOAD VARIANTS ARE NOT DECORATION -- LOSING THEM COST A LIVE ESCAPE. ***
  279: #  Pass 1 had them; the pass-2 rebuild wrapped the width rows around STORES only,
  280: #  and a seat immediately named the mutant that walks through the gap: restore
  281: #  exit(1) on WRONG-WIDTH READ ONLY.  Every remaining row is a store, a 16-bit
  282: #  access, or never touches the register, so it scored a clean 14/14 while one
  283: #  guest MOV.B *read* from 0xa05f7080 still ended the host.
  284: for label, op, setup, key, note in (
  285:         ("w8 store", MOV_B_R8_AT_R7, ST, "width", "8-bit store x2: wrong WIDTH"),
  286:         ("w32 store", MOV_L_R8_AT_R7, ST, "width", "32-bit store x2: wrong WIDTH"),
  287:         ("w8 load", MOV_B_AT_R1_R2, LD, "width", "8-bit LOAD x2: wrong WIDTH, read side"),
  288:         ("w32 load", MOV_L_AT_R1_R2, LD, "width", "32-bit LOAD x2: wrong WIDTH, read side"),
  289:         ("w16 load", MOV_W_AT_R1_R2, LD, "nodata", "16-bit load x2: no data"),
  290:         ("w16 store", MOV_W_R8_AT_R7, ST, "notwait", "16-bit store x2: not waiting")):
  291:     t, alive = session(pair((op, setup), (op, [])))
  292:     row(label, "survived" if alive else "died", "survived", note)
  293:     row(label.replace(" ", "") + " x1",
  294:         ("%d" % len(SAYS[key].findall(t))) if alive else "died", "1",
  295:         "SAME site TWICE -> diagnostic exactly once")
  296: 
  297: #  Two genuinely independent sites, both 16-bit ON PURPOSE.  An earlier draft
  298: #  paired an 8-bit store with a 16-bit one and could never reach 2, because the
  299: #  width guard LOGS AND CONTINUES -- that single 8-bit store falls through and
  300: #  touches TWO sites at once, latching both before the second access runs.
  301: #
  302: #  This row is the ONLY one that separates a per-site latch from ONE SHARED
  303: #  BIT: a measuring seat built both and they score identically on every row
  304: #  that drives one site per session.
  305: t, alive = session(pair((MOV_W_AT_R1_R2, LD), (MOV_W_R8_AT_R7, ST)))
  306: row("two sites", "survived" if alive else "died", "survived",
  307:     "no-data then not-waiting, ONE session")
  308: row("two sites x2",
  309:     ("%d" % (len(SAYS["nodata"].findall(t)) + len(SAYS["notwait"].findall(t))))
  310:     if alive else "died", "2",
  311:     "DIFFERENT sites -> TWO diagnostics, not one")
  312: 
  313: #  ---------------------------------------------------------------- accept side
  314: #
  315: #  *** THE DE-ESCALATION ACCEPT FOR THE REMOVED PREDICATES. ***
  316: #
  317: #  An earlier banner here claimed these were "the only rows that catch a
  318: #  deleted arm" and listed rows that did not exist.  MEASURED FALSE: the
  319: #  deleted-arm mutant is caught by the six count rows and `two sites x2`, and
  320: #  the accept row as first written caught nothing at all -- it never touched
  321: #  GDROM_DATA.  Replaced rather than patched, because a banner describing
  322: #  absent rows is worse than no banner.
  323: #
  324: #  Coverage of the four de-fatalised predicates: `accept d0`/`accept d1` carry
  325: #  the two read predicates and the busy mask, the 204 good reads inside
  326: #  `overread` carry data_len, and `accept w8` carries the width predicate.
  327: #
  328: #  The values are device-signature quality -- RAM cannot produce them, and
  329: #  they come from the synthesized TOC (d->data[0]=0x10, then 0x9600).
  330: 
  331: GDROM_CNTLO = 0xa05f7090       # 0x005f7000 + 0x90
  332: GDROM_CNTHI = 0xa05f7094       # 0x005f7000 + 0x94
  333: GDROM_COND = 0xa05f709c        # 0x005f7000 + 0x9c
  334: 
  335: MOV_W_AT_R1_R3 = 0x6311        # mov.w @r1,r3
  336: BRA_BACK3 = 0xaffd             # bra .-2 : (pc+4) + (-3 * 2) lands on the insn before
  337: 
  338: 
  339: def run(steps, at=CODE):
  340:     """Plant a run of instructions, then a self-branch, and step them all."""
  341:     put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(steps)]
  342:     put += ["put h 0x%x, 0x%04x" % (at + 2 * len(steps), BRA_SELF),
  343:             "put h 0x%x, 0x%04x" % (at + 2 * len(steps) + 2, NOP)]
  344:     return put + ["pc=0x%x" % at, "step %d" % len(steps)]
  345: 
  346: 
  347: setup = ["r7=0x%x" % GDROM_CNTLO, "r8=0x98"]
  348: t, alive = session(setup + run([MOV_W_R8_AT_R7])
  349:                    + ["r7=0x%x" % GDROM_CNTHI, "r8=0x01"] + run([MOV_W_R8_AT_R7], CODE + 0x20)
  350:                    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
  351:                    + ["r7=0x%x" % GDROM_DATA, "r8=0x0014"]
  352:                    + run([MOV_W_R8_AT_R7] * 6, CODE + 0x60)
  353:                    + ["r1=0x%x" % GDROM_DATA, "r2=0", "r3=0"]
  354:                    + run([MOV_W_AT_R1_R2, MOV_W_AT_R1_R3], CODE + 0x100)
  355:                    + ["print r2", "print r3"])
  356: row("accept d0", printed(t, "r2") if alive else "died", "0x10",
  357:     "legal TOC PIO: first halfword")
  358: #  0xffff9600, not 0x9600: mov.w SIGN-EXTENDS and 0x9600 has bit 15 set.  The
  359: #  first halfword (0x0010) does not, which is why only this one is extended --
  360: #  a consistency check on the expectation rather than on the emulator.
  361: row("accept d1", printed(t, "r3") if alive else "died", "0xffff9600",
  362:     "legal TOC PIO: second halfword, sign-extended")
  363: 
  364: #  ---------------------------------------------------------------- the VALUE
  365: #  No row pinned what a DECLINED read returns, so `odata = 0xffff` -> `0` passed
  366: #  every row while the diagnostic still said "returning 0xffff".  A first-touch
  367: #  16-bit load is the one path the TOC sequence cannot explain, so it pins the
  368: #  value on its own.  mov.w sign-extends, so 0xffff arrives as 0xffffffff.
  369: t, alive = session(["r1=0x%x" % GDROM_DATA, "r2=0"] + run([MOV_W_AT_R1_R2])
  370:                    + ["print r2"])
  371: row("declined val", printed(t, "r2") if alive else "died", "0xffffffff",
  372:     "a declined read returns 0xffff, sign-extended")
  373: 
  374: #  ---------------------------------------------------------------- site :334
  375: #  JOINED into the product, so it must be DRIVEN -- a seat's rule, and it is
  376: #  right: joining a site and then not testing it is the worst of both.  Reached
  377: #  by completing a legal TOC, then setting cnt PAST data_len so the boundary
  378: #  branch never clears COND_DATA_AVAIL, then reading on past 408 bytes.
  379: #  Three instructions per iteration, so ~700 steps covers 204+ halfwords.
  380: t, alive = session(setup + run([MOV_W_R8_AT_R7])
  381:                    + ["r7=0x%x" % GDROM_CNTHI, "r8=0x01"] + run([MOV_W_R8_AT_R7], CODE + 0x20)
  382:                    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
  383:                    + ["r7=0x%x" % GDROM_DATA, "r8=0x0014"]
  384:                    + run([MOV_W_R8_AT_R7] * 6, CODE + 0x60)
  385:                    + ["r7=0x%x" % GDROM_CNTHI, "r8=0xff"] + run([MOV_W_R8_AT_R7], CODE + 0xa0)
  386:                    + ["r1=0x%x" % GDROM_DATA, "r2=0",
  387:                       "put h 0x%x, 0x%04x" % (CODE + 0x200, MOV_W_AT_R1_R2),
  388:                       "put h 0x%x, 0x%04x" % (CODE + 0x202, BRA_BACK3),
  389:                       "put h 0x%x, 0x%04x" % (CODE + 0x204, NOP),
  390:                       "pc=0x%x" % (CODE + 0x200), "step 700"], spin=4.0)
  391: row("overread", "survived" if alive else "died", "survived",
  392:     "TOC, cnt past data_len, then read on")
  393: row("overread x1", ("%d" % len(SAYS["overread"].findall(t))) if alive else "died",
  394:     "1", "reading past the buffer -> diagnostic exactly once")
  395: 
  396: #  ---------------------------------------------------------------- width accept
  397: #
  398: #  *** THE FOURTH DE-ESCALATED PREDICATE, AND THE ONLY ONE THAT HAD NO ROW. ***
  399: #
  400: #  A pass-2 seat built the shipped code with three lines added -- log, then
  401: #  `odata = 0xffff; break;` instead of continuing -- and MEASURED IT AT 22/22
  402: #  WITH A VECTOR BYTE-IDENTICAL TO THE SHIPPED BUILD.  Nothing in the detector
  403: #  could see the difference, and that difference is the round's OWN CENTRAL
  404: #  CLAIM: "this site logs and continues; the other three decline."
  405: #
  406: #  It is also the likeliest future edit here -- it is what the other three
  407: #  sites in this same arm do, and what dev_wdc.c:155-167 does for its own
  408: #  bad-length case, so "harmonise the four sites" reproduces it verbatim.
  409: #
  410: #  The row: SIX 8-BIT stores must still assemble and dispatch the TOC packet,
  411: #  so a legal narrow-access command keeps working.  Measured base -> 0x10,
  412: #  width-declines -> 0xffffffff, pre-fix -> died.
  413: t, alive = session(setup + run([MOV_W_R8_AT_R7])
  414:                    + ["r7=0x%x" % GDROM_CNTHI, "r8=0x01"] + run([MOV_W_R8_AT_R7], CODE + 0x20)
  415:                    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
  416:                    + ["r7=0x%x" % GDROM_DATA, "r8=0x0014"]
  417:                    + run([MOV_B_R8_AT_R7] * 6, CODE + 0x60)
  418:                    + ["r1=0x%x" % GDROM_DATA, "r2=0"]
  419:                    + run([MOV_W_AT_R1_R2], CODE + 0x100) + ["print r2"])
  420: row("accept w8", printed(t, "r2") if alive else "died", "0x10",
  421:     "SIX 8-BIT stores assemble and dispatch")
  422: 
  423: n = sum(1 for _, ok in rows if ok)
  424: print("GDROM_RESULT=%d/%d" % (n, len(rows)))
  425: print("GDROM_VECTOR=" + ",".join(("1" if ok else "0") for _, ok in rows))

