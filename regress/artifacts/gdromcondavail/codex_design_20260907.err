  181: #define	GDROM_DATA		0x80
  182: 
  183: #define	GDROM_REGX		0x84
  184: #define	GDROM_UNKNOWN_0x88	0x88
  185: #define	GDROM_STAT		0x8c
  186: #define	GDROM_CNTLO		0x90
  187: #define	GDROM_CNTHI		0x94
  188: #define	GDROM_COND		0x9c
  189: 
  190: /*
  191:  *  #460: one warn-once bit per declined site.  Named constants rather than
  192:  *  bare numbers, so a new site cannot silently reuse another's bit -- the
  193:  *  duplicate-key hazard this project already paid for once in dev_sh4.c.
  194:  */
  195: /*
  196:  *  *** THE PRE-SET TRIGGER BELOW HAS FIRED, AND THIS IS IT BEING DISCHARGED. ***  (It said
  197:  *  ABOVE until 2026-08-28; the trigger is BELOW, at the `SIX OF EIGHT BITS` block.  A
  198:  *  pointer naming the wrong direction is a small wrong record of the kind a future reader
  199:  *  gives up on -- the opus seat caught it on this row's assess panel.)  It was
  200:  *  written as "at the SEVENTH bit"; `gdromexitsix` Round 1 adds THREE latches to the six
  201:  *  below, so the NINTH would be `1u << 8` -- truncating to zero in a uint8_t, never
  202:  *  setting, and letting the diagnostic it guards FLOOD.  No compile error, no runtime
  203:  *  complaint.  Two review seats reached it independently on that round's pass 1.
  204:  *
  205:  *  BIT POSITIONS, not hand-assigned masks: GDROM_W_NBITS is then correct BY CONSTRUCTION
  206:  *  rather than by maintenance, and an ACCIDENTAL duplicate position is impossible to write.
  207:  *  *** THAT CLAUSE READ "a duplicate is impossible to write" AND WAS TOO STRONG.  Corrected
  208:  *  on the assess panel, where the opus and fable seats objected to it independently. ***  C
  209:  *  permits an explicit duplicate enumerator, and nothing here stops a NEW SITE spelling a raw
  210:  *  `d->warned |= 0x40` that collides with the seventh enumerator when it arrives.  What
  211:  *  implicit numbering buys is that no two enumerators written in the normal way can collide,
  212:  *  and that the count stays synchronised with them -- which is worth having and is less than
  213:  *  the original sentence claimed.  The CAPACITY half is enforced separately, below.  The masks
  214:  *  reproduce 0x01..0x20 exactly, in the same order -- checked mechanically by the script
  215:  *  that made this edit, not asserted here.
  216:  *
  217:  *  `warned` widens from uint8_t to uint32_t in the same change, because an enum that can
  218:  *  count past 8 is no use if the field it indexes cannot hold the bit.
  219:  *
  220:  *  Precedent transferred rather than invented: dev_sh4.c did the equivalent conversion for
  221:  *  its value-class keys on its own pre-set trigger ("when a tenth class arrives").
  222:  */
  223: enum {
  224: 	GDROM_W_LEN_B,	/*  was 0x01  */
  225: 	GDROM_W_NODATA_B,	/*  was 0x02  */
  226: 	GDROM_W_NOTWAIT_B,	/*  was 0x04  */
  227: 	GDROM_W_OVERREAD_B,	/*  was 0x08  */
  228: 	GDROM_W_DMANODATA_B,	/*  was 0x10  */
  229: 	GDROM_W_DMAARM_B,	/*  was 0x20  */
  230: 	GDROM_W_TOCLEN_B,	/*  #489: the SEVENTH, and the bit the trigger was set for  */
  231: 	GDROM_W_FMT_B,		/*  #490: case 0x30's data-format decline  */
  232: 	GDROM_W_CMD_B,		/*  #490: the default: unimplemented-command decline  */
  233: 	GDROM_W_88VAL_B,	/*  #496: GDROM_UNKNOWN_0x88's bad-value decline  */
  234: 	GDROM_W_CONDVAL_B,	/*  #496: GDROM_COND's bad-value decline  */
  235: 	GDROM_W_NBITS
  236: };
  237: 
  238: #define	GDROM_W_LEN	(1u << GDROM_W_LEN_B)
  239: #define	GDROM_W_NODATA	(1u << GDROM_W_NODATA_B)
  240: #define	GDROM_W_NOTWAIT	(1u << GDROM_W_NOTWAIT_B)
  241: #define	GDROM_W_OVERREAD	(1u << GDROM_W_OVERREAD_B)
  242: #define	GDROM_W_DMANODATA	(1u << GDROM_W_DMANODATA_B)
  243: #define	GDROM_W_DMAARM	(1u << GDROM_W_DMAARM_B)
  244: #define	GDROM_W_TOCLEN	(1u << GDROM_W_TOCLEN_B)
  245: #define	GDROM_W_FMT	(1u << GDROM_W_FMT_B)
  246: #define	GDROM_W_CMD	(1u << GDROM_W_CMD_B)
  247: #define	GDROM_W_88VAL	(1u << GDROM_W_88VAL_B)
  248: #define	GDROM_W_CONDVAL	(1u << GDROM_W_CONDVAL_B)
  249: 
  250: /*
  251:  *  *** #490: TWO BITS, NOT ONE, AND THAT IS MEASURED RATHER THAN TIDY. ***
  252:  *
  253:  *  The measuring seat built the one-bit form (`M3shared`) and it ESCAPED a detector that
  254:  *  otherwise passed: a session declining at BOTH sites sees the second site fall silent,
  255:  *  because the first already latched.  Separate bits, and a row (`both sites`) that trips
  256:  *  both in one session.
  257:  *
  258:  *  *** AND THE COLLISION SURFACE IS WIDER THAN THIS PAIR.  `d->warned` now has NINE
  259:  *  writers sharing one field, and SIX of the pre-existing ones are set from inside
  260:  *  DEVICE_ACCESS by ordinary guest register reads *** -- `GDROM_W_OVERREAD` is set by the
  261:  *  benign TOC-then-Mount-then-read sequence a shipped probe already exercises.  So a bit
  262:  *  COLLISION here is not announced by anything: the wrong bit is simply already set, and
  263:  *  the decline goes silent under traffic that looks entirely normal.  `Ma_toclen` and
  264:  *  `Mb_toclen` measured exactly that, and `crossbit` is the row that sees it.
  265:  *
  266:  *  Note the pre-table GUARD-FIELD check cannot catch this class: it asks where the guard
  267:  *  field and the body field DIFFER, and here they are the SAME field.  For a shared
  268:  *  bitfield the question is "who else writes this field, and can they set my bit?"
  269:  */
  270: 
  271: /*
  272:  *  *** THE COUNT-FITS-ITS-CARRIERS BOUND, AS A COMPILE ERROR RATHER THAN A SENTENCE. ***
  273:  *  Added on the gdromwarnbits assess panel, where the OPUS and FABLE seats derived it
  274:  *  independently and each MEASURED the case against it.
  275:  *
  276:  *  The comment above says GDROM_W_NBITS is "correct BY CONSTRUCTION".  That is true of the
  277:  *  COUNT -- the compiler numbers the enumerators -- and it says nothing about whether those
  278:  *  positions FIT.  Nothing in the product build enforced that, and the offline
  279:  *  mask_equivalence_check.c cannot: it compiles a REPLICA of this enum, so adding bits to
  280:  *  the product leaves the artifact's private NBITS at six forever.  A drift that matters
  281:  *  therefore leaves the offline check completely GREEN.
  282:  *
  283:  *  *** THE OBVIOUS FORM WAS MEASURED WRONG AND IS NOT WHAT IS WRITTEN HERE. ***  A guard
  284:  *  spelled `GDROM_W_NBITS <= 32` COMPILES CLEAN over a `uint8_t warned` carrying a live
  285:  *  `1u << 8` truncation -- measured on this build's compiler at -std=c99 -pedantic-errors
  286:  *  -Wall -Wextra.  It is written from the DEFECT (too many bits) instead of from the DOMAIN
  287:  *  (the bits must fit the things that carry them), which is the exact failure
  288:  *  thirdparty/dreamcast_sysasicvar.h names for #466: "a guard written from the DEFECT
  289:  *  rather than from the DOMAIN covers one end and reads as if it covers both."
  290:  *
  291:  *  TWO clauses, because there are TWO carriers and storage width alone does not imply the
  292:  *  other:
  293:  *    1. `warned` must be able to HOLD the bit -- the half mask_equivalence_check.c is blind
  294:  *       to, and the half a one-token revert of this diff (uint32_t -> uint8_t) attacks.
  295:  *    2. `1u` must be able to PRODUCE it -- every mask above shifts `1u`, and `1u << 32` is
  296:  *       undefined however wide `warned` becomes.  A `uint64_t` field would satisfy clause 1
  297:  *       at 40 bits while clause 2 correctly refuses.
  298:  *
  299:  *  C99-legal and precedented in product code rather than invented here: the negative-size
  300:  *  typedef is #388's shape at cpus/cpu_mips.c (two sites) and cpus/memory_rw.c, whose own
  301:  *  licence sentence transfers verbatim -- "a static assertion costs nothing and covers the
  302:  *  build the test cannot reach."  The bitfield spelling used by dreamcast_sysasicvar.h is
  303:  *  needed only where the operand can be a runtime variable; an enum constant cannot be.
  304:  *  (And "this tree is C99" is a portability policy, not a fact about what compiles --
  305:  *  sysasicvar.h records the build compiler reporting __STDC_VERSION__ 202311L.)
  306:  *
  307:  *  *** AND THIS IS NOT AN ADDED GUARD.  IT IS GDROM_W_NBITS'S FIRST CONSUMER. ***  The
  308:  *  opus seat measured that the count had ZERO references anywhere -- it sized nothing and
  309:  *  bounded nothing, and DELETING it compiled clean.  So the "correct BY CONSTRUCTION"
  310:  *  claim above rested on a decorative symbol.  Under this project's addition licence that
  311:  *  matters: this is not accretion needing a warrant, it is the L4 repair that makes an
  312:  *  already-shipped claim true.
  313:  *
  314:  *  *** THE dev_sh4.c PRECEDENT TRANSFERS ON SHAPE AND NOT ON THIS PROPERTY, which the
  315:  *  comment above does not say. ***  SH4_VAL_NCLASS is load-bearing -- it SIZES
  316:  *  val_reported[SH4_VAL_NCLASS][...] and bounds a runtime check -- so its own
  317:  *  by-construction claim is true unaided.  GDROM_W_NBITS was not.  Same conversion, and
  318:  *  the property it is cited for was present in one case and absent in the other.
  319:  *
  320:  *  MEASURED, not asserted: a hard compile error at nine bits over a uint8_t and at
  321:  *  thirty-three over a uint32_t; CLEAN on the shipped source and at nine over uint32_t,
  322:  *  so it is not a check that cannot fail.  Controls preserved at
  323:  *  regress/artifacts/gdromwarnbits/bound_assert_controls{.sh,_20260828.out}.  It emits no
  324:  *  object code -- verified with the filename held constant: the object differs in exactly
  325:  *  two bytes, both __LINE__ immediates displaced by this comment block.
  326:  */
  327: typedef char gdrom_w_fits_its_carriers[
  328:     (GDROM_W_NBITS <= 8 * sizeof(((struct dreamcast_gdrom_data *)0)->warned) &&
  329:      GDROM_W_NBITS <= 8 * sizeof(1u)) ? 1 : -1];
  330: 
  331: /*
  332:  *  #490: THE MASKS MUST BE PAIRWISE DISJOINT, AS A COMPILE ERROR RATHER THAN AS
  333:  *  A ROW.  Added on owner decision after the pass-2 ask-again MEASURED an escape
  334:  *  that no row could see.
  335:  *
  336:  *  THE ESCAPE, measured at 20/20 with the mutant's whole row block byte-identical
  337:  *  to base -- a total escape, not a tie:
  338:  *
  339:  *      E1_aliasover   #define GDROM_W_FMT (1u << GDROM_W_OVERREAD_B)
  340:  *
  341:  *  `crossbit` is the row written for exactly this class and it stages only a
  342:  *  short TOC, so it can see a collision with GDROM_W_TOCLEN and with nothing
  343:  *  else -- ONE of the seven pre-existing bits.  No session in the detector takes
  344:  *  the OVERREAD, LEN, NODATA, NOTWAIT, DMANODATA or DMAARM path, so an alias
  345:  *  onto any of those six is invisible to every row.
  346:  *
  347:  *  *** WHY A DECLARATION AND NOT TWELVE MORE MUTANTS. ***  Closing the class by
  348:  *  rows costs one build and one probe run per bit per site and still only
  349:  *  enumerates today's bits.  This closes it for ALL bits, present and future,
  350:  *  and it FAILS CLOSED: add a tenth bit without extending the sum below and
  351:  *  file stops compiling.  The addition-licence bar is a MEASURED DELTA, and the
  352:  *  delta here is E1 going from 20/20 (escaped) to not building at all.
  353:  *
  354:  *  MEASURED IN EIGHT STATES AGAINST BOTH OPERATOR FORMS, on the real file,
  355:  *  preserved at regress/artifacts/gdromexitsix/supp_p2_20260829/ (see its
  356:  *  README.md; the PRE/POST files carry md5s).  `|` is the form this
  357:  *  declaration ORIGINALLY shipped with; `+` is what is above.
  358:  *
  359:  *                                                    with |     with +
  360:  *      unmodified source ........................... COMPILES   COMPILES
  361:  *      #define FMT -> OVERREAD_B  (E1 as built) ..... REFUSED    REFUSED
  362:  *      enum CMD_B = FMT_B  (one token) ............... ESCAPES    REFUSED
  363:  *      enum FMT_B = OVERREAD_B, RELOCATED ............ ESCAPES    REFUSED
  364:  *      enum FMT_B = OVERREAD_B, in place ............. REFUSED    REFUSED
  365:  *      FMT redefined as a 2-bit SUPERSET ............. ESCAPES    REFUSED
  366:  *      tenth bit at BACK, sum not extended ........... REFUSED    REFUSED
  367:  *      tenth bit at FRONT, sum not extended .......... REFUSED    REFUSED
  368:  *
  369:  *  *** THE `|` FORM HAD THREE ESCAPES AND THIS COMMENT CLAIMED IT HAD NONE.
  370:  *  ***  The earlier table here listed five states, all synthetic and all
  371:  *  ***  against `|`, and read them as a clean sweep.  It missed the whole
  372:  *  ***  ENUM-side door: an explicit enumerator initialiser renumbers every
  373:  *  ***  later enumerator, so GDROM_W_NBITS falls in lockstep with the lost
  374:  *  ***  bit and the equality RE-BALANCES.  An OR test proves coverage
  375:  *  ***  relative to a bound derived from the same possibly-aliased enum it
  376:  *  ***  is checking -- both sides move together.  That is the vacuity
  377:  *  ***  floor's ANCHOR RULE (clause (f)) one level down, in a constant
  378:  *  ***  expression: a RELATIVE check where an ANCHORED one was needed.
  379:  *  ***  `+` is anchored because a sum cannot absorb a duplicate.
  380:  *
  381:  *  Note the third and fifth rows are the SAME SHAPE in two spellings, and
  382:  *  they disagree under `|`: the #define spelling was refused while the enum
  383:  *  spelling compiled.  A control that varies only the #define block cannot
  384:  *  see this class at all, which is why the earlier five-state table missed
  385:  *  it -- it was measuring the wrong half of the file.
  386:  *
  387:  *  The in-place-vs-relocated pair matters for the same reason: an alias left
  388:  *  in its original position keeps NBITS where it was, so the OR equality
  389:  *  still breaks.  Moving it is what lets the bound follow the bit down.
  390:  *
  391:  *  A NEGATIVE CONTROL was run in the earlier set and still holds: E1's alias
  392:  *  WITH THE ASSERT REMOVED compiles, proving this declaration is what
  393:  *  refuses and not something else in the file.  gcc's diagnostic is
  394:  *  "size of array 'gdrom_w_masks_disjoint' is negative".
  395:  *
  396:  *  Note the three grounds on which a disjointness assert was REJECTED for
  397:  *  dev_sh4.c do not hold here, and each was checked rather than assumed: those
  398:  *  classes had pervasively overlapping bit-domains (these are one-bit masks by
  399:  *  construction), their separation rested on array INDICES rather than on the
  400:  *  constants (this rests on the constants themselves), and for the one disjoint

 succeeded in 246ms:
 1250: 			 *  cancelled -- not a crash.
 1251: 			 *
 1252: 			 *  Accepted values keep their old semantics
 1253: 			 *  byte for byte, store included and in the
 1254: 			 *  same order.
 1255: 			 *
 1256: 			 *  NO COMPLETION EVENT ON THE DECLINE, and the
 1257: 			 *  two precedents in this file disagree, so the
 1258: 			 *  choice is stated rather than assumed: the
 1259: 			 *  handle_command() default arm FIRES one
 1260: 			 *  because a guest that has SENT a packet is
 1261: 			 *  waiting on it, while the DMA arm refuses one
 1262: 			 *  because a completion on a declined transfer
 1263: 			 *  is a false success.
 1264: 			 *
 1265: 			 *  This declined write ACCEPTED NO NEW COMMAND
 1266: 			 *  OR PACKET, so it must not synthesize a
 1267: 			 *  completion; any pre-existing command state
 1268: 			 *  is left untouched.  Stated that way on
 1269: 			 *  purpose -- an earlier draft said "the guest
 1270: 			 *  has sent no packet", which is too broad:
 1271: 			 *  nothing stops a bad COND write arriving
 1272: 			 *  AFTER a 0xa0, or midway through a partially
 1273: 			 *  assembled packet.  The warrant is that THIS
 1274: 			 *  write began nothing, not that nothing is in
 1275: 			 *  flight.
 1276: 			 */
 1277: 			if (idata == 0xa0) {
 1278: 				d->cond = idata;
 1279: 				d->stat = 0;	/*  TODO  */
 1280: 				d->busy |= 0x08;
 1281: 				d->cmd_count = 0;
 1282: 			} else if (idata == 0xef) {
 1283: 				d->cond = idata;
 1284: 				debug("dreamcast_gdrom: ROM: TODO\n");
 1285: 				SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
 1286: 			} else {
 1287: 				if (!(d->warned & GDROM_W_CONDVAL)) {
 1288: 					d->warned |= GDROM_W_CONDVAL;
 1289: 					fatal("[ dreamcast_gdrom:"
 1290: 					    " unimplemented GDROM_COND ="
 1291: 					    " 0x%02x -- declined, and"
 1292: 					    " d->cond left unchanged."
 1293: 					    "  (once) ]\n", (int)idata);
 1294: 				}
 1295: 			}
 1296: 		}
 1297: 		break;
 1298: 
 1299: 	/*
 1300: 	 *  #461: EIGHT offsets are implemented and this arm took the other ~248 --
 1301: 	 *  a read OR a write, at any width -- and ended the host process.  MEASURED
 1302: 	 *  on an unmodified -E dreamcast: 21 offsets sampled, 19 died here.  A
 1303: 	 *  driver or diagnostic scanning the register space dies on its first
 1304: 	 *  unhandled address.
 1305: 	 *
 1306: 	 *  Declined reads return 0, and that is the value that claims LEAST rather
 1307: 	 *  than the value that reads best.  #452 already settled this shape in this
 1308: 	 *  tree for unimplemented sub-windows: reads return 0, writes are ignored.
 1309: 	 *  dev_wdc.c's all-ones is a claim about a RELEASED BUS with no responder;
 1310: 	 *  here a responder exists and simply does not model the register, so
 1311: 	 *  all-ones would be a strictly stronger claim and a false one.
 1312: 	 *
 1313: 	 *  `odata` is already 0 -- memory_rw.c memsets the caller's buffer before
 1314: 	 *  every device read (#95) and odata is initialised at the top -- so the
 1315: 	 *  assignment below is EXPLICIT BUT NOT LOAD-BEARING and deliberately
 1316: 	 *  carries no detector row: a mutant deleting it is equivalent.  #452
 1317: 	 *  records the same for its own site.
 1318: 	 */
 1319: 	/*
 1320: 	 *  *** WHY THIS WINDOW NEEDS NO ALIGNMENT GUARD, and why adding one was
 1321: 	 *  DECLINED rather than overlooked.  Two pass-3 seats asked for it. ***
 1322: 	 *
 1323: 	 *  The DMA arm below carries `if (relative_addr & 3) return 1;` because its
 1324: 	 *  tail STORES through a truncating index, so an unaligned access aliases an
 1325: 	 *  implemented word.  This arm has no tail at all: `odata` is a fresh local
 1326: 	 *  0, nothing here is indexed by `relative_addr` except the latch bitmap,
 1327: 	 *  and that is bounds-guarded from its own array's sizeof.
 1328: 	 *
 1329: 	 *  So the same guard here would be DEAD CODE, and this round has already
 1330: 	 *  rejected one dead bounds check for exactly that reason -- `if (off >=
 1331: 	 *  0x100)` can never fire, because memory_rw gates on the registered range
 1332: 	 *  and subtracts before the device is entered.  A guard that cannot fire is
 1333: 	 *  not insurance; it is a claim that something is checked when nothing is.
 1334: 	 *
 1335: 	 *  *** THE INVARIANT IS THE THING TO WATCH: if a store tail is ever added
 1336: 	 *  to this arm, the injectivity argument at the DMA site must be re-derived
 1337: 	 *  HERE and a guard added with it. ***  Written down because the safety is
 1338: 	 *  structural rather than guarded, and structure is what a later edit
 1339: 	 *  silently changes.
 1340: 	 */
 1341: 	default:if (GDROM_UNIMPL_FIRST(d->unimpl_reported[
 1342: 		    writeflag == MEM_READ ? GDROM_RD : GDROM_WR],
 1343: 		    relative_addr)) {
 1344: 			if (writeflag == MEM_READ)
 1345: 				fatal("[ dreamcast_gdrom: read from addr"
 1346: 				    " 0x%x -- unimplemented, returning 0."
 1347: 				    "  (once per offset per direction) ]\n",
 1348: 				    (int)relative_addr);
 1349: 			else
 1350: 				fatal("[ dreamcast_gdrom: write to addr"
 1351: 				    " 0x%x: 0x%x -- unimplemented, ignored."
 1352: 				    "  (once per offset per direction) ]\n",
 1353: 				    (int)relative_addr, (int)idata);
 1354: 		}
 1355: 
 1356: 		odata = 0;
 1357: 		break;
 1358: 	}
 1359: 
 1360: 	if (writeflag == MEM_READ)
 1361: 		memory_writemax64(cpu, data, len, odata);
 1362: 
 1363: 	return 1;
 1364: }
