  380: t, alive = session(setup + run([MOV_W_R8_AT_R7])
  381:                    + ["r7=0x%x" % GDROM_CNTHI, "r8=0x01"] + run([MOV_W_R8_AT_R7], CODE + 0x20)
  382:                    + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
  383:                    + ["r7=0x%x" % GDROM_DATA, "r8=0x0014"]
  384:                    + run([MOV_W_R8_AT_R7] * 6, CODE + 0x60)
  385:                    + ["r7=0x%x" % GDROM_CNTHI, "r8=0xff"] + run([MOV_W_R8_AT_R7], CODE + 0xa0)
  386:                    + ["r1=0x%x" % GDROM_DATA, "r2=0",
  387:                       "put h 0x%x, 0x%04x" % (CODE + 0x200, MOV_W_AT_R1_R2),
  388:                       "put h 0x%x, 0x%04x" % (CODE + 0x202, BRA_BACK3),
  389:                       "put h 0x%x, 0x%04x" % (CODE + 0x204, NOP),
  390:                       "pc=0x%x" % (CODE + 0x200), "step 700"], spin=4.0)
  391: row("overread", "survived" if alive else "died", "survived",
