  857: 			// Hack to get NetBSD/dreamcast to work:
  858: 			// See the variable "openpart_start" in NetBSD's
  859: 			// sys/arch/dreamcast/dev/gdrom.c:
  860: 			sector_nr -= 150;
  861: 
  862: 			// printf("sector nr step 2 = %i\n", (int)sector_nr);
  863: 		} else {
  864: 			// printf("sector nr step 1 = %i\n", (int)sector_nr);
  865: 			sector_nr -= 45150;
  866: 			// printf("sector nr step 2 = %i\n", (int)sector_nr);
  867: 			sector_nr += (diskimage_get_baseoffset(cpu->machine, 0, DISKIMAGE_IDE) / 2048);
  868: 			// printf("sector nr step 3 = %i\n", (int)sector_nr);
  869: 		}
  870: 
  871: 		res = diskimage_access(cpu->machine, 0, DISKIMAGE_IDE,
  872: 		    0, sector_nr * 2048, d->data, d->data_len);
  873: 		if (!res) {
  874: 			fatal("GDROM: diskimage_access failed? TODO\n");
  875: 			free_data(d);			/*  #465  */
  876: 		}
  877: 
  878: 		/* {
  879: 			printf("(Dump of GDROM sector %i: \"", (int)sector_nr);
  880: 			for (int k = 0; k < 256; ++k)
  881: 				printf("%c", d->data[k] >= 32 ? d->data[k] : '.');
  882: 			printf("\")\n");
  883: 		} */
  884: 
  885: 		break;
  886: 
  887: 	case 0x70:
  888: 		/*
  889: 		 *  Mount:
  890: 		 *
  891: 		 *  See NetBSD's sys/arch/dreamcast/dev/gdrom.c: gdrom_mount_disk().
  892: 		 */
  893: 
  894: 		// Note/TODO: This is ignored for now.
  895: 		break;
  896: 
  897: 	default:/*
  898: 		 *  #490: an unimplemented command byte ended the host process.
  899: 		 *  Decline, announced ONCE behind its own latch bit.
  900: 		 *
  901: 		 *  A SEPARATE bit from Site A's, measured: `M3shared` folded
  902: 		 *  both onto one bit and ESCAPED -- a session declining at both
  903: 		 *  sites saw the second fall silent because the first had
  904: 		 *  latched.
  905: 		 *
  906: 		 *  `break` and not `return`, and here the reason is subtler
  907: 		 *  than at Site A: this is the LAST arm, so deleting exit(1)
  908: 		 *  with no break would fall out of the switch into the tail
  909: 		 *  anyway.  The `break` is house idiom rather than load-bearing
  910: 		 *  -- but a `return` is NOT equivalent, because the tail below
  911: 		 *  zeroes d->cnt, clears COND_DATA_AVAIL and fires the
  912: 		 *  completion event.  An early return skips that event and
  913: 		 *  leaves a guest waiting for a completion that never comes.
  914: 		 */
  915: 		if (!(d->warned & GDROM_W_CMD)) {
  916: 			d->warned |= GDROM_W_CMD;
  917: 			fatal("[ dreamcast_gdrom: handle_command:"
  918: 			    " unimplemented command 0x%02x -- declined."
  919: 			    "  (once) ]\n", d->cmd[0]);
  920: 		}
  921: 		break;
  922: 	}
  923: 
  924: 	// Any resulting data? Then set COND_DATA_AVAIL. Otherwise, clear
  925: 	// that bit, and set count to zero.
  926: 	if (d->data != NULL) {
  927: 		d->cond |= COND_DATA_AVAIL;
  928: 	} else {
  929: 		d->cnt = 0;
  930: 		d->cond &= ~COND_DATA_AVAIL;
  931: 	}
  932: 
  933: 	// NetBSD seems to sometimes request 32 sectors (2048 bytes each), i.e.
  934: 	// 65536 bytes. That is represented as count = 0x0000 (when NetBSD reads
  935: 	// from the CNTHI and CNTLO registers). That does not work very well.
  936: 	// This is a hack/workaround for that.
  937: 	if (d->cnt == 65536)
  938: 		d->cnt = 32768;
  939: 
  940: 	SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
  941: }
  942: 
  943: void dreamcast_gdrom_update_stat(struct cpu *cpu, struct dreamcast_gdrom_data *d)
  944: {
  945: 	// See NetBSD's gdrom.c.
  946: 	d->stat = 6;
  947: 
  948: 	if (diskimage_exist(cpu->machine, 0, DISKIMAGE_IDE)) {
  949: 		d->stat = 0;
  950: 	}
  951: }
  952: 
  953: 
  954: DEVICE_ACCESS(dreamcast_gdrom)
  955: {
  956: 	struct dreamcast_gdrom_data *d = (struct dreamcast_gdrom_data *) extra;
  957: 	uint64_t idata = 0, odata = 0;
  958: 
  959: 	if (writeflag == MEM_WRITE)
  960: 		idata = memory_readmax64(cpu, data, len);
  961: 
  962: 	switch (relative_addr) {
  963: 
  964: 	case GDROM_BUSY:
  965: 		if (writeflag == MEM_READ) {
  966: 			odata = d->busy;
  967: 		} else {
  968: 			// fatal("[ Write to GDROM_BUSY: 0x%08x ]\n", (int)idata);
  969: 			// I'm assuming that writing bits to BUSY clears them.
  970: 			d->busy &= ~idata;
  971: 		}
  972: 		break;
  973: 
  974: 	case GDROM_DATA:
  975: 		/*
  976: 		 *  #460: THIS SITE LOGS AND CONTINUES; the other three decline.
  977: 		 *  The difference is measured, not stylistic.
  978: 		 *
  979: 		 *  BEFORE THIS FIX, `len` appeared exactly once in the whole arm --
  980: 		 *  in the guard that was here -- and no index expression consulted
  981: 		 *  it.  (It appears three times now: this fix's own format string
  982: 		 *  and argument.  Stated in the past tense because the claim is
  983: 		 *  about the code the measurement was taken against, and a seat
  984: 		 *  caught the present tense going false the moment it shipped.)
  985: 		 *  Measured:
  986: 		 *  byte, word and longword reads all consume exactly two bytes
  987: 		 *  and return the same odata, and six BYTE stores assemble the
  988: 		 *  12-byte packet and DISPATCH the command, reaching handle_command
  989: 		 *  exactly as six word stores do.
  990: 		 *
  991: 		 *  *** BUT THE CONTINUATION IS NOT WIDTH-TRANSPARENT, and an earlier
  992: 		 *  draft said it was. ***  `idata >> 8` is zero for a byte store, so
  993: 		 *  EVERY ODD COMMAND BYTE IS FORGED TO ZERO.  That is harmless for
  994: 		 *  the TOC packet 0x14, whose odd bytes are already zero -- which is
  995: 		 *  exactly why the measurement that produced the earlier claim did
  996: 		 *  not see it.  Command 0x30 needs cmd[1] in {0x20,0x24} and a
  997: 		 *  byte-store packet can never satisfy it, so it reaches
  998: 		 *  handle_command's data-format arm.
  999: 		 *
 1000: 		 *  *** THIS SENTENCE READ "so it reaches handle_command's own
 1001: 		 *  exit(1).  MEASURED: this build dies there and a DECLINING
 1002: 		 *  build survives."  #490 MADE ITS OWN ANTECEDENT FALSE and the
 1003: 		 *  claim with it: there is no longer ANY exit(1) in
 1004: 		 *  handle_command, so a byte-store packet now reaches the
 1005: 		 *  LATCHED DECLINE and the build survives.  The comment even
 1006: 		 *  named the outcome -- "a DECLINING build survives" -- which is
 1007: 		 *  exactly what this build now is.  Caught by a pass-2 seat;
 1008: 		 *  corrected in-round because a WRONG RECORD is one of the two
 1009: 		 *  things the stopping rule fixes rather than files, and a claim
 1010: 		 *  labelled MEASURED is the worst kind to leave stale. ***
 1011: 		 *
 1012: 		 *  That is a RELOCATION, not a regression -- before this fix the
 1013: 		 *  same byte store died at the width guard, one step earlier -- but
 1014: 		 *  it means "dropping the guard changes NO BOUND" is the MEMORY
 1015: 		 *  safety argument and not the whole safety story.  Memory safety
 1016: 		 *  does hold: no index consults len, cur_data_offset advances by two
 1017: 		 *  regardless, and no mutant produced an out-of-bounds access.
 1018: 		 *
 1019: 		 *  Dropping the guard changes no bound -- which is
 1020: 		 *  precisely the warrant dev_pvr.c:1577-1581 (#187) states for
 1021: 		 *  the same class on this same machine.
 1022: 		 *
 1023: 		 *  *** DO NOT "EMULATE" NARROW ACCESS INSTEAD. ***  A pass-1
 1024: 		 *  panel split on that, and it was MEASURED ACTIVELY HARMFUL:
 1025: 		 *  letting cmd_count step by 1 makes eleven byte writes plus one
 1026: 		 *  word write go 11 -> 13, SKIPPING the `== 12` equality below,
 1027: 		 *  so busy&0x08 never clears and the next write reaches the
 1028: 		 *  "Too much GDROM_DATA" exit -- otherwise unreachable.  It also
 1029: 		 *  writes cmd[12], one past the array.  A fix that re-opens a
 1030: 		 *  dead site is worse than the defect, and only a build saw it.
 1031: 		 *
 1032: 		 *  DE-ESCALATION: this round removes FOUR host-fatal predicates and
 1033: 		 *  the detector carries accept rows for THREE.  *** THIS ONE IS
 1034: 		 *  EXEMPT, AND THE EXEMPTION IS STATED RATHER THAN LEFT AS A GAP. ***
 1035: 		 *  The clause's accept-row obligation applies to predicates a guest
 1036: 		 *  store can feed; this predicate tests the ACCESS WIDTH against a
 1037: 		 *  compile-time constant, and no guest store reaches its operand --
 1038: 		 *  the same failability carve-out the project already applies to
 1039: 		 *  read-only and never-set-by-device bits.  The other three (the two
 1040: 		 *  read predicates and the busy mask) DO carry rows.
 1041: 		 */
 1042: 		if (len != sizeof(uint16_t)) {
 1043: 			if (!(d->warned & GDROM_W_LEN)) {
 1044: 				d->warned |= GDROM_W_LEN;
 1045: 				fatal("[ dreamcast_gdrom: non-16bit"
 1046: 				    " GDROM_DATA access, len=%i -- handled"
 1047: 				    " as 16-bit.  (once) ]\n", (int) len);
 1048: 			}
 1049: 		}
 1050: 
 1051: 		if (writeflag == MEM_READ) {
 1052: 			if (!(d->cond & COND_DATA_AVAIL)) {
 1053: 				/*  #460: was exit(1).  `cond` is zero on a fresh
 1054: 				    device, so the FIRST guest load ended the host.  */
 1055: 				if (!(d->warned & GDROM_W_NODATA)) {
 1056: 					d->warned |= GDROM_W_NODATA;
 1057: 					fatal("[ dreamcast_gdrom: read from"
 1058: 					    " GDROM_DATA with no data"
 1059: 					    " available -- returning 0xffff."
 1060: 					    "  (once) ]\n");
 1061: 				}
 1062: 				/*  0xffff because a released ATA/ATAPI data bus
 1063: 				    reads as all-ones, which dev_wdc.c:155-167 also
 1064: 				    returns.  NOTE THE COLLISION: this device's TOC is
 1065: 				    memset(0xff), so 0xffff is LEGITIMATE PAYLOAD here
 1066: 				    and no returned value is self-identifying.  The
 1067: 				    DIAGNOSTIC is the truthfulness channel, not the
 1068: 				    value -- which is also why the latch is per-site.  */
 1069: 				odata = 0xffff;
 1070: 				break;
 1071: 			}
 1072: 
 1073: 			if (d->cur_data_offset < d->data_len) {
 1074: 				odata = d->data[d->cur_data_offset ++];
 1075: 				odata |= (d->data[d->cur_data_offset ++] << 8);
 1076: 				d->cur_cnt += sizeof(uint16_t);
 1077: 				if (d->cur_cnt >= d->cnt) {
 1078: 					if (d->cur_data_offset >= d->data_len) {
 1079: 						d->cond &= ~COND_DATA_AVAIL;
 1080: 					} else {
 1081: 						d->cnt = d->data_len - d->cur_data_offset;
 1082: 						d->cur_cnt = 0;
 1083: 					}
 1084: 
 1085: 					SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
 1086: 				}
 1087: 			} else {
 1088: 				/*  #460: joined on the merits -- this and the
 1089: 				    COND_DATA_AVAIL site above are ONE predicate
 1090: 				    family, "read when there is nothing to give".
 1091: 				    Fixing one and leaving the other fatal gives a
 1092: 				    device where a declined read is safe in one
 1093: 				    state and lethal in another.  */
 1094: 				if (!(d->warned & GDROM_W_OVERREAD)) {
 1095: 					d->warned |= GDROM_W_OVERREAD;
 1096: 					fatal("[ dreamcast_gdrom: read past"
 1097: 					    " the end of the GDROM_DATA"
 1098: 					    " buffer -- returning 0xffff."
 1099: 					    "  (once) ]\n");
 1100: 				}
 1101: 				odata = 0xffff;
 1102: 				break;
 1103: 			}
 1104: 		} else {
 1105: 			if (d->busy & 0x08) {
 1106: 				if (d->cmd_count >= 12) {
 1107: 					fatal("Too much GDROM_DATA?\n");
 1108: 					exit(1);
 1109: 				}
 1110: 				/*  Add data to cmd:  */
 1111: 				d->cmd[d->cmd_count++] = idata;
 1112: 				d->cmd[d->cmd_count++] = idata >> 8;
 1113: 				if (d->cmd_count == 12) {
 1114: 					d->busy &= ~0x08;
 1115: 					handle_command(cpu, d);
 1116: 				}
 1117: 			} else {
 1118: 				/*  #460: was exit(1).  `busy` is zero on a fresh
 1119: 				    device, so the FIRST guest store ended the host.  */
 1120: 				if (!(d->warned & GDROM_W_NOTWAIT)) {
 1121: 					d->warned |= GDROM_W_NOTWAIT;
 1122: 					fatal("[ dreamcast_gdrom: write to"
 1123: 					    " GDROM_DATA while not waiting"
 1124: 					    " for data -- ignored.  (once) ]\n");
 1125: 				}
 1126: 			}
 1127: 		}
 1128: 		break;
 1129: 
 1130: 	case GDROM_REGX:
 1131: 		if (writeflag == MEM_READ) {
 1132: 			debug("[ Read to GDROM_REGX? ]\n");
 1133: 		} else {
 1134: 			/*  NetBSD/dreamcast writes 0 here.  */
 1135: 			if (idata != 0)
 1136: 				debug("[ Write 0x%x to GDROM_REGX? ]\n", (int)idata);
 1137: 		}
 1138: 		break;
 1139: 
 1140: 	case GDROM_UNKNOWN_0x88:
 1141: 		if (writeflag == MEM_READ) {
 1142: 			fatal("Read from GDROM_UNKNOWN_0x88?\n");
 1143: 			// exit(1);
 1144: 		} else {
 1145: 			if (idata != 0xb) {
 1146: 				/*
 1147: 				 *  #496: a guest write of any value but
 1148: 				 *  0x0b ENDED THE HOST PROCESS here.  One
 1149: 				 *  store, from an ordinary driver, on an
 1150: 				 *  unmodified -E dreamcast.
 1151: 				 *
 1152: 				 *  The model implements NO behaviour for
 1153: 				 *  this register: 0x0b is accepted and is
 1154: 				 *  a no-op, touching no device state.  So
 1155: 				 *  an unmodelled value is declined, not
 1156: 				 *  fatal.  The announce is kept because
 1157: 				 *  the accepted set is what ONE boot ROM
 1158: 				 *  happens to write, not a documented
 1159: 				 *  register contract -- so an unmodelled
 1160: 				 *  value is a fact about the guest worth
 1161: 				 *  reporting, and the decline itself is
 1162: 				 *  the only channel that ever reports it.
 1163: 				 *
 1164: 				 *  The message carries idata: this is the
 1165: 				 *  only line that has the value a later
 1166: 				 *  round would need to model the register.
 1167: 				 */
 1168: 				if (!(d->warned & GDROM_W_88VAL)) {
 1169: 					d->warned |= GDROM_W_88VAL;
 1170: 					fatal("[ dreamcast_gdrom: write of"
 1171: 					    " 0x%02x to GDROM_UNKNOWN_0x88;"
 1172: 					    " only 0x0b is modelled --"
 1173: 					    " ignored.  (once) ]\n",
 1174: 					    (int)idata);
 1175: 				}
 1176: 			}
 1177: 		}
 1178: 		break;
 1179: 
 1180: 	case GDROM_STAT:
 1181: 		if (writeflag == MEM_READ) {
 1182: 			dreamcast_gdrom_update_stat(cpu, d);
 1183: 			odata = d->stat;
 1184: 		} else {
 1185: 			fatal("[ Write to GDROM_STAT? ]\n");
 1186: /*			exit(1);  */
 1187: 		}
 1188: 		break;
 1189: 
 1190: 	case GDROM_CNTLO:
 1191: 		if (writeflag == MEM_READ) {
 1192: 			odata = d->cnt & 0xff;
 1193: 		} else {
 1194: 			d->cnt = (d->cnt & 0xff00) | (idata & 0xff);
 1195: 		}
 1196: 		break;
 1197: 
 1198: 	case GDROM_CNTHI:
 1199: 		if (writeflag == MEM_READ) {
 1200: 			odata = (d->cnt >> 8) & 0xff;
 1201: 		} else {
 1202: 			d->cnt = (d->cnt & 0x00ff) | ((idata & 0xff) << 8);
 1203: 		}
 1204: 		break;
 1205: 
 1206: 	case GDROM_COND:
 1207: 		if (writeflag == MEM_READ) {
 1208: 			odata = d->cond;
 1209: 		} else {
 1210: 			/*
 1211: 			 *  NetBSD/dreamcast writes 0xa0 to GDROM_COND to
 1212: 			 *  start a command. See gdrom_do_command() in NetBSD's
 1213: 			 *  sys/arch/dreamcast/dev/gdrom.c.
 1214: 			 *
 1215: 			 *  Before sending anything, NetBSD expects:
 1216: 			 *   o) the lowest 4 bits of STAT to not be 6.
 1217: 			 *
 1218: 			 *  After writing 0xa0 to GDROM_COND, NetBSD expects:
 1219: 			 *   o) (BUSY & 0x88) to be 0x08.
 1220: 			 *
 1221: 			 *  NetBSD then sends 6 16-bit data words to GDROM_DATA.
 1222: 			 */
 1223: 			/*
 1224: 			 *  #496: an unmodelled value ENDED THE HOST
 1225: 			 *  PROCESS here -- one guest store, through
 1226: 			 *  real decode, on an unmodified machine.
 1227: 			 *
 1228: 			 *  *** THE STORE OF idata MOVED IN HERE, INTO
 1229: 			 *  THE ACCEPTED ARMS, AND THAT IS THE HALF OF
 1230: 			 *  THIS FIX THAT IS NOT ABOUT exit(). ***  It
 1231: 			 *  used to run UNCONDITIONALLY above this
 1232: 			 *  dispatch, so merely de-fatalising the else
 1233: 			 *  arm would leave every unmodelled value a
 1234: 			 *  direct write to d->cond -- and COND_DATA_AVAIL
 1235: 			 *  (0x08) is a bit of that same byte, which
 1236: 			 *  GATES THE ENTIRE GDROM_DATA READ PATH.
 1237: 			 *  A declined write could therefore FORGE
 1238: 			 *  data-available when no command produced any,
 1239: 			 *  or REVOKE a genuine one -- a worse defect
 1240: 			 *  than the kill it replaced, because it is
 1241: 			 *  silent.
 1242: 			 *
 1243: 			 *  Stated as readiness rather than as a NULL
 1244: 			 *  deref on purpose: with d->data NULL the read
 1245: 			 *  path does not fault today, because
 1246: 			 *  `cur_data_offset < data_len` is 0 < 0 and
 1247: 			 *  falls into the OVERREAD arm.  The harm is a
 1248: 			 *  guest told to read a buffer that never
 1249: 			 *  existed, and a genuine transfer silently
 1250: 			 *  cancelled -- not a crash.
 1251: 			 *
 1252: 			 *  Accepted values keep their old semantics
 1253: 			 *  byte for byte, store included and in the
 1254: 			 *  same order.
 1255: 			 *
 1256: 			 *  NO COMPLETION EVENT ON THE DECLINE, and the
 1257: 			 *  two precedents in this file disagree, so the
 1258: 			 *  choice is stated rather than assumed: the
 1259: 			 *  handle_command() default arm FIRES one
 1260: 			 *  because a guest that has SENT a packet is
 1261: 			 *  waiting on it, while the DMA arm refuses one
 1262: 			 *  because a completion on a declined transfer
 1263: 			 *  is a false success.
 1264: 			 *
 1265: 			 *  This declined write ACCEPTED NO NEW COMMAND
 1266: 			 *  OR PACKET, so it must not synthesize a
 1267: 			 *  completion; any pre-existing command state
 1268: 			 *  is left untouched.  Stated that way on
 1269: 			 *  purpose -- an earlier draft said "the guest
 1270: 			 *  has sent no packet", which is too broad:
 1271: 			 *  nothing stops a bad COND write arriving
 1272: 			 *  AFTER a 0xa0, or midway through a partially
 1273: 			 *  assembled packet.  The warrant is that THIS
 1274: 			 *  write began nothing, not that nothing is in
 1275: 			 *  flight.
 1276: 			 */
 1277: 			if (idata == 0xa0) {
 1278: 				d->cond = idata;
 1279: 				d->stat = 0;	/*  TODO  */
 1280: 				d->busy |= 0x08;
 1281: 				d->cmd_count = 0;
 1282: 			} else if (idata == 0xef) {
 1283: 				d->cond = idata;
 1284: 				debug("dreamcast_gdrom: ROM: TODO\n");
 1285: 				SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
 1286: 			} else {
 1287: 				if (!(d->warned & GDROM_W_CONDVAL)) {
 1288: 					d->warned |= GDROM_W_CONDVAL;
 1289: 					fatal("[ dreamcast_gdrom:"
 1290: 					    " unimplemented GDROM_COND ="
 1291: 					    " 0x%02x -- declined, and"
 1292: 					    " d->cond left unchanged."
 1293: 					    "  (once) ]\n", (int)idata);
 1294: 				}
 1295: 			}
 1296: 		}
 1297: 		break;
 1298: 
 1299: 	/*
 1300: 	 *  #461: EIGHT offsets are implemented and this arm took the other ~248 --
 1301: 	 *  a read OR a write, at any width -- and ended the host process.  MEASURED
 1302: 	 *  on an unmodified -E dreamcast: 21 offsets sampled, 19 died here.  A
 1303: 	 *  driver or diagnostic scanning the register space dies on its first
 1304: 	 *  unhandled address.
 1305: 	 *
 1306: 	 *  Declined reads return 0, and that is the value that claims LEAST rather
 1307: 	 *  than the value that reads best.  #452 already settled this shape in this
 1308: 	 *  tree for unimplemented sub-windows: reads return 0, writes are ignored.
 1309: 	 *  dev_wdc.c's all-ones is a claim about a RELEASED BUS with no responder;
 1310: 	 *  here a responder exists and simply does not model the register, so
 1311: 	 *  all-ones would be a strictly stronger claim and a false one.
 1312: 	 *
 1313: 	 *  `odata` is already 0 -- memory_rw.c memsets the caller's buffer before
 1314: 	 *  every device read (#95) and odata is initialised at the top -- so the
 1315: 	 *  assignment below is EXPLICIT BUT NOT LOAD-BEARING and deliberately
 1316: 	 *  carries no detector row: a mutant deleting it is equivalent.  #452
 1317: 	 *  records the same for its own site.
 1318: 	 */
 1319: 	/*
 1320: 	 *  *** WHY THIS WINDOW NEEDS NO ALIGNMENT GUARD, and why adding one was
 1321: 	 *  DECLINED rather than overlooked.  Two pass-3 seats asked for it. ***
 1322: 	 *
 1323: 	 *  The DMA arm below carries `if (relative_addr & 3) return 1;` because its
 1324: 	 *  tail STORES through a truncating index, so an unaligned access aliases an
 1325: 	 *  implemented word.  This arm has no tail at all: `odata` is a fresh local
 1326: 	 *  0, nothing here is indexed by `relative_addr` except the latch bitmap,
 1327: 	 *  and that is bounds-guarded from its own array's sizeof.
 1328: 	 *
 1329: 	 *  So the same guard here would be DEAD CODE, and this round has already
 1330: 	 *  rejected one dead bounds check for exactly that reason -- `if (off >=
 1331: 	 *  0x100)` can never fire, because memory_rw gates on the registered range
 1332: 	 *  and subtracts before the device is entered.  A guard that cannot fire is
 1333: 	 *  not insurance; it is a claim that something is checked when nothing is.
 1334: 	 *
 1335: 	 *  *** THE INVARIANT IS THE THING TO WATCH: if a store tail is ever added
 1336: 	 *  to this arm, the injectivity argument at the DMA site must be re-derived
 1337: 	 *  HERE and a guard added with it. ***  Written down because the safety is
 1338: 	 *  structural rather than guarded, and structure is what a later edit
 1339: 	 *  silently changes.
 1340: 	 */
 1341: 	default:if (GDROM_UNIMPL_FIRST(d->unimpl_reported[
 1342: 		    writeflag == MEM_READ ? GDROM_RD : GDROM_WR],
 1343: 		    relative_addr)) {
 1344: 			if (writeflag == MEM_READ)
 1345: 				fatal("[ dreamcast_gdrom: read from addr"
 1346: 				    " 0x%x -- unimplemented, returning 0."
 1347: 				    "  (once per offset per direction) ]\n",
 1348: 				    (int)relative_addr);
 1349: 			else
 1350: 				fatal("[ dreamcast_gdrom: write to addr"
 1351: 				    " 0x%x: 0x%x -- unimplemented, ignored."
 1352: 				    "  (once per offset per direction) ]\n",
 1353: 				    (int)relative_addr, (int)idata);
 1354: 		}
 1355: 
 1356: 		odata = 0;
 1357: 		break;
 1358: 	}
 1359: 
 1360: 	if (writeflag == MEM_READ)
 1361: 		memory_writemax64(cpu, data, len, odata);
 1362: 
 1363: 	return 1;
 1364: }
 1365: 
 1366: 
 1367: DEVICE_ACCESS(dreamcast_gdrom_dma)
 1368: {
 1369: 	struct dreamcast_gdrom_data *d = (struct dreamcast_gdrom_data *) extra;
 1370: 	uint64_t idata = 0, odata = 0;
 1371: 
 1372: 	if (writeflag == MEM_WRITE)
 1373: 		idata = memory_readmax64(cpu, data, len);
 1374: 
 1375: 	/*  Default read:  */
 1376: 	if (writeflag == MEM_READ)
 1377: 		odata = d->dma_reg[relative_addr / sizeof(uint32_t)];
 1378: 
 1379: 	switch (relative_addr) {
 1380: 
 1381: 	case 0x04:	// destination address? e.g. 0x8c008000
 1382: 	case 0x08:	// DMA length in bytes? e.g. 0x3800
 1383: 	case 0x0c:	// count? e.g. 1
 1384: 	case 0x14:	// "enable"?
 1385: 		break;
 1386: 
 1387: 	case 0x18:
 1388: 		// GDROM DMA start?
 1389: 		if (idata != 0) {
 1390: 			if (d->dma_reg[0x0c / sizeof(uint32_t)] == 1 &&
 1391: 			    d->dma_reg[0x14 / sizeof(uint32_t)] == 1) {
 1392: 				// GDROM DMA transfer.
 1393: 				uint32_t dst = d->dma_reg[0x04 / sizeof(uint32_t)];
 1394: 				int length = d->dma_reg[0x08 / sizeof(uint32_t)];
 1395: 				if (d->data == NULL) {
 1396: 					/*
 1397: 					 *  #462: was exit(1).  A guest can reach this WITHOUT
 1398: 					 *  doing anything wrong: Linux's gdrom_readdisk_dma
 1399: 					 *  programs the four DMA registers BEFORE sending its
 1400: 					 *  packet, so if diskimage_access fails on a short image
 1401: 					 *  -- or OB-20's sector clamp refuses the request --
 1402: 					 *  handle_command leaves d->data NULL and the guest,
 1403: 					 *  told nothing it checks, triggers anyway.  Two shipped
 1404: 					 *  defensive declines were feeding a host kill.
 1405: 					 *
 1406: 					 *  *** THE `idata = 0` IS LOAD-BEARING AND THE OBVIOUS
 1407: 					 *  FIX OMITS IT. ***  The tail store below writes idata
 1408: 					 *  into dma_reg[6] after every aligned break, and the
 1409: 					 *  SUCCESS arm clears it for exactly that reason -- which
 1410: 					 *  is why a completed transfer polls idle.  Drop the
 1411: 					 *  exit(1) and simply break, as #447/#459/#460/#461 all
 1412: 					 *  did at their sites, and the guest's trigger value 1
 1413: 					 *  reaches the shadow: +0x18 then reads BUSY FOREVER.
 1414: 					 *  Linux survives that (its waits are time-bounded), and it
 1415: 					 *  is the guest this claim rests on: mainline byte-reads
 1416: 					 *  +0x18 to poll completion, per this tree's own
 1417: 					 *  `gdromdmawidth` assessment.
 1418: 					 *
 1419: 					 *  *** THIS COMMENT USED TO CITE NetBSD, AND THAT CITATION
 1420: 					 *  WAS WRONG. ***  It said NetBSD's status waits are
 1421: 					 *  unbounded spins, exhibiting
 1422: 					 *  `while ((GDROM_BUSY & 0x88) != 0x08) ;`.  That loop exits
 1423: 					 *  only when bit 3 is SET and bit 7 CLEAR, and +0x18 is
 1424: 					 *  {0 idle, 1 busy} -- neither ANDs to 0x08, so it would
 1425: 					 *  hang on CORRECT hardware.  It is the command-start
 1426: 					 *  handshake on the CONTROL window's BUSY register: see
 1427: 					 *  the GDROM_COND case in this same file, which documents
 1428: 					 *  it and sets `d->busy |= 0x08` in reply.  The exhibit was
 1429: 					 *  lifted from there and re-pointed at a register it says
 1430: 					 *  nothing about.  Filed as `gdromdriverclaims`.
 1431: 					 *
 1432: 					 *  *** AND THE COMPLETION EVENT MUST NOT FIRE. ***  A
 1433: 					 *  completion on a DECLINED transfer would be a FALSE SUCCESS;
 1434: 					 *  the mechanism, and why a detectable stall is the honest
 1435: 					 *  failure, are in the `As reported` paragraph below.
 1436: 					 *  (This sentence was severed mid-word when that block was
 1437: 					 *  inserted after its opening `A`.  A first repair restated
 1438: 					 *  the whole argument here and duplicated it ~24 lines apart
 1439: 					 *  in one comment block; the words were right, they belong
 1440: 					 *  once.)
 1441: 					 *
 1442: 					 *  *** THE THREE DRIVER CLAIMS IN THIS COMMENT ARE
 1443: 					 *  SEAT-REPORTED, NOT VERIFIED LOCALLY.  There is no copy
 1444: 					 *  of Linux's drivers/cdrom/gdrom.c or NetBSD's
 1445: 					 *  sys/arch/dreamcast/dev/gdrom.c anywhere in this tree, so
 1446: 					 *  nothing here can be re-derived by a later reader. ***
 1447: 					 *  This is the #357/#362/#365 shape -- DDI 0100I page numbers
 1448: 					 *  that came from panel output rather than a local manual and
 1449: 					 *  held by luck.  If the claim below is wrong, the choice to
 1450: 					 *  decline WITHOUT signalling completion is wrong.  Filed as
 1451: 					 *  `gdromdriverclaims`; obtaining the two sources is cheap and
 1452: 					 *  is what settled the SH case.
 1453: 					 *
 1454: 					 *  As reported: gdrom_dma_interrupt() clears
 1455: 					 *  gd.transfer UNCONDITIONALLY and inspects no error
 1456: 					 *  bit, so signalling completion on an empty transfer
 1457: 					 *  ends the wait with BLK_STS_OK -- the block layer is
 1458: 					 *  told the read SUCCEEDED while zero bytes moved, and
 1459: 					 *  the guest consumes the destination page as disk data.
 1460: 					 *  That is #460's invented-behaviour class at the block
 1461: 					 *  layer.  The driver has ONE error channel, its 7-second
 1462: 					 *  timeout, so guest-visible EIO is not a compromise --
 1463: 					 *  it is the only honest signal available here.
 1464: 					 */
 1465: 					if (!(d->warned & GDROM_W_DMANODATA)) {
 1466: 						d->warned |= GDROM_W_DMANODATA;
 1467: 						fatal("[ dreamcast_gdrom_dma: DMA start with no"
 1468: 						    " staged data -- declined, the transfer does"
 1469: 						    " not run.  (once) ]\n");
 1470: 					}
 1471: 					idata = 0;
 1472: 					break;
 1473: 				}
 1474: 
 1475: 				/*
 1476: 				 *  *** AND IT SAT ABOVE THE `d->data == NULL` TEST, so the DECLINED
 1477: 				 *  path announced a transfer it never ran -- while the comment below
 1478: 				 *  claimed this line prints "the count actually transferred".  Three
 1479: 				 *  seats found it independently on the pass-2 diff.
 1480: 				 *
 1481: 				 *  Moved BELOW the check, and left ABOVE the `dst &= 0x0fffffff` mask,
 1482: 				 *  so the ADDRESS it prints is unchanged by the move.
 1483: 				 *
 1484: 				 *  (This said "the round is only fixing WHEN it says it", which the
 1485: 				 *  diff refutes: a separate hunk also changes WHAT it says, `length`
 1486: 				 *  -> `d->data_len` plus the `guest asked for` clause.  Corrected in
 1487: 				 *  the CHANGELOG first and HERE second -- the sibling this file's own
 1488: 				 *  grep-for-siblings rule exists to catch.)
 1489: 				 *
 1490: 				 *  Pinned by `nodata notx`, MEASURED RED on the pre-move build
 1491: 				 *  (50/51, sole red -- probe_pre51.raw).
 1492: 				 */
 1493: 				/*  #462: prints data_len, the count actually transferred.  It
 1494: 				    printed `length` -- the guest's +0x08 register -- while the
 1495: 				    memory_rw below moves d->data_len, so the line lied in
 1496: 				    exactly the sessions where the two disagree.  */
 1497: 				fatal("[ dreamcast_gdrom_dma: Transfering %i bytes to 0x%08"
 1498: 				    PRIx32 " (guest asked for %i) ]\n",
 1499: 				    (int) d->data_len, dst, length);
 1500: 
 1501: 				dst &= 0x0fffffff;	// 0x8c008000 => 0x0c008000
 1502: 				cpu->memory_rw(cpu, cpu->mem, dst,
 1503: 				    d->data, d->data_len, MEM_WRITE, PHYSICAL);
 1504: 
 1505: 				SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM_DMA);
 1506: 
 1507: 				idata = 0;
 1508: 			} else {
 1509: 				/*
 1510: 				 *  #462: was exit(1).  MEASURED on the pre-fix build:
 1511: 				 *  ONE guest store of 1 to +0x18 on a fresh device ends
 1512: 				 *  the host process, because count and enable are both 0
 1513: 				 *  and this arm runs.  The device-signature control --
 1514: 				 *  the identical store to the implemented +0x04 -- leaves
 1515: 				 *  the host alive.
 1516: 				 *
 1517: 				 *  Same `idata = 0` requirement as the sibling above, and
 1518: 				 *  the same reason: without it the trigger value sticks in
 1519: 				 *  the shadow and +0x18 reads busy forever.
 1520: 				 */
 1521: 				if (!(d->warned & GDROM_W_DMAARM)) {
 1522: 					d->warned |= GDROM_W_DMAARM;
 1523: 					fatal("[ dreamcast_gdrom_dma: DMA start with dst"
 1524: 					    " 0x%08x len 0x%x count %i enable %i --"
 1525: 					    " unsupported arming, declined.  (once) ]\n",
 1526: 					    /*  #462 pass 2: %x requires unsigned int; a seat pointed out
 1527: 					        that (int) is UB by the C format rules even though common
 1528: 					        ABIs print the expected bits.  The count and enable args
 1529: 					        below are %i and correctly stay int.  */
 1530: 					    (unsigned int) d->dma_reg[4 / sizeof(uint32_t)],
 1531: 					    (unsigned int) d->dma_reg[8 / sizeof(uint32_t)],
 1532: 					    (int) d->dma_reg[0xc / sizeof(uint32_t)],
 1533: 					    (int) d->dma_reg[0x14 / sizeof(uint32_t)]);
 1534: 				}
 1535: 				idata = 0;
 1536: 			}
 1537: 		}
 1538: 		break;			
 1539: 
 1540: 	/*
 1541: 	 *  #461: the SIBLING ARM, and it joined this round on a measurement.  It
 1542: 	 *  was named in no filing and no brief until a seat enumerated the file --
 1543: 	 *  the round's own scope list said 'two DMA sites' when there are three,
 1544: 	 *  and this is the only one in the same semantic class as the arm above.
 1545: 	 *  MEASURED: a 32-bit read scan of this window died on the first offset on
 1546: 	 *  committed HEAD, and died again on a build that fixed only the control
 1547: 	 *  window.
 1548: 	 *
 1549: 	 *  *** ONE FIX DESIGN IS TRUE OF THE LATCH AND FALSE OF THE DECLINE. ***
 1550: 	 *  Above, `odata` is a local starting at 0, so declining means the tail
 1551: 	 *  returns 0 and a declined write does nothing.  HERE, odata is already
 1552: 	 *  loaded from the shadow register file before the switch, and the tail
 1553: 	 *  STORES a declined write into that file.  So 'decline' in this window
 1554: 	 *  means store-and-return, not discard -- which is what the five
 1555: 	 *  implemented cases already do, and is kept deliberately.
 1556: 	 *
 1557: 	 *  *** THAT NEARLY SHIPPED A WORSE DEFECT THAN THE ONE IT FIXES, AND A
 1558: 	 *  PASS-2 SEAT CAUGHT IT. ***  An earlier draft of this comment claimed
 1559: 	 *  "no declined offset can reach a load-bearing one".  THAT IS FALSE, and
 1560: 	 *  the reason is one character: the tail store indexes with TRUNCATING
 1561: 	 *  division, `dma_reg[relative_addr / sizeof(uint32_t)]`.
 1562: 	 *
 1563: 	 *  A byte access at +0x05 does not match `case 0x04` -- the switch tests
 1564: 	 *  the exact value -- so it reaches this arm, is declined and latched, and
 1565: 	 *  THEN the tail stores it into dma_reg[1].  The same alias exists at
 1566: 	 *  +0x09..0x0b -> dma_reg[2], +0x0d..0x0f -> dma_reg[3] and
 1567: 	 *  +0x15..0x17 -> dma_reg[5].
 1568: 	 *
 1569: 	 *  Those four ARE the transfer: `case 0x18` reads dma_reg[3] (count) and
 1570: 	 *  dma_reg[5] (enable) as its arming condition, then dma_reg[1] as the
 1571: 	 *  destination and dma_reg[2] as the length.  So a guest could arm and AIM
 1572: 	 *  a DMA transfer entirely through declined offsets, bypassing every check
 1573: 	 *  the implemented cases perform.  PRE-FIX each of those accesses exited
 1574: 	 *  instead, so this fix would have CREATED the capability -- the same shape
 1575: 	 *  as #460's Option C, which was rejected for exactly this reason.
 1576: 	 *
 1577: 	 *  THE RULE: an UNALIGNED access never stores.  Alignment alone separates
 1578: 	 *  "unimplemented word" from "misaligned access to an implemented one",
 1579: 	 *  and only the first keeps store-and-return.
 1580: 	 *
 1581: 	 *  WHY THAT IS SOUND, as a proof rather than an appeal to intuition about
 1582: 	 *  switch statements -- and INDEPENDENTLY RE-DERIVED by a review seat
 1583: 	 *  before it was believed.  On multiples of 4 the map off -> off/4 is
 1584: 	 *  INJECTIVE, so an aligned offset reaching this arm cannot share an index
 1585: 	 *  with any implemented case: if it did, it would BE that case and the
 1586: 	 *  switch would have matched it.  The implemented DMA offsets are
 1587: 	 *  0x04/0x08/0x0c/0x14/0x18, i.e. indices 1/2/3/5/6; every aligned offset
 1588: 	 *  reaching here yields 0, 4, or 7..31.  Disjoint by construction, not by
 1589: 	 *  inspection.  Truncation can only collide for UNALIGNED addresses, which
 1590: 	 *  is exactly what the guard rejects.
 1591: 	 *
 1592: 	 *  *** A FUTURE `case` AT AN ALIGNED OFFSET KEEPS THIS TRUE AUTOMATICALLY;
 1593: 	 *  ONE AT AN UNALIGNED OFFSET WOULD BREAK IT. ***  There is no such thing
 1594: 	 *  in this device, and the same seat checked the CONTROL window: its
 1595: 	 *  default arm has no store tail at all, so there is no aliasing channel
 1596: 	 *  there to guard, which is why the rule is stated only here.
 1597: 	 *
 1598: 	 *  The bitmap's own bounds guard does NOT help here -- it protects the
 1599: 	 *  latch array, and dma_reg is a different array reached by a different
 1600: 	 *  index.  Two arrays, two bounds problems, and only one of them was
 1601: 	 *  guarded before a seat read the tail.
 1602: 	 */
 1603: 	default:if (GDROM_UNIMPL_FIRST(d->dma_unimpl_reported[
 1604: 		    writeflag == MEM_READ ? GDROM_RD : GDROM_WR],
 1605: 		    relative_addr)) {
 1606: 			if (writeflag == MEM_READ)
 1607: 				fatal("[ dreamcast_gdrom_dma: read from"
 1608: 				    " addr 0x%x -- unimplemented, returning %s."
 1609: 				    "  (once per offset per direction) ]\n", (int)relative_addr,
 1610: 				    (relative_addr & (sizeof(uint32_t) - 1)) ?
 1611: 				    "0" : "the shadow value");
 1612: 			else
 1613: 				fatal("[ dreamcast_gdrom_dma: write to addr"
 1614: 				    " 0x%x: 0x%x -- unimplemented, %s."
 1615: 				    "  (once per offset per direction) ]\n",
 1616: 				    (int)relative_addr, (int)idata,
 1617: 				    (relative_addr & (sizeof(uint32_t) - 1)) ?
 1618: 				    "dropped" : "stored but inert");
 1619: 		}
 1620: 
 1621: 		/*  #461 pass 2: an UNALIGNED declined access must not reach the
 1622: 		    tail, whose truncating index would alias an implemented word.
 1623: 		    Returning here skips BOTH tails; a declined unaligned READ
 1624: 		    therefore also stops leaking the aliased word's value, which
 1625: 		    is the same defect pointing the other way.  */
 1626: 		if (relative_addr & (sizeof(uint32_t) - 1)) {
 1627: 			if (writeflag == MEM_READ)
 1628: 				memory_writemax64(cpu, data, len, 0);
 1629: 			return 1;
 1630: 		}
 1631: 
 1632: 		break;
 1633: 	}
 1634: 
 1635: 	/*  Default write:  */
 1636: 	/*
 1637: 	 *  *** THIS STORE IS WIDTH-BLIND, AND THAT IS ASSESSED-NOT-CHANGED RATHER
 1638: 	 *  THAN OVERLOOKED.  `gdromdmawidth`, adjudicated 2026-08-23. ***
 1639: 	 *
 1640: 	 *  `len` is used ONLY to marshal bytes (memory_readmax64 in, memory_writemax64
 1641: 	 *  out).  An ALIGNED narrow write to an IMPLEMENTED offset therefore widens
 1642: 	 *  to 32 bits zero-extended.  MEASURED on this build: seed +0x04 with
 1643: 	 *  0x11223344 (32-bit), then byte-write 0xff at +0x04, then read back ->
 1644: 	 *  0x000000ff.  Liveness control in the same run returned 0x12345678.
 1645: 	 *
 1646: 	 *  *** THE #461 ALIGNMENT RULE ABOVE NEITHER CAUSES NOR EXCUSES THIS. ***
 1647: 	 *  That rule says an ALIGNED offset reaching the DEFAULT arm is genuinely an
 1648: 	 *  unimplemented word.  It says nothing about an aligned NARROW access to an
 1649: 	 *  IMPLEMENTED offset, which is a separate WIDTH question -- address
 1650: 	 *  decoding and width validation are independent axes.  Written here
 1651: 	 *  because a reader who applies that rule to this store would conclude the
 1652: 	 *  site is safe.
 1653: 	 *
 1654: 	 *  NOT FIXED, and the reason is an ABSENT ORACLE, not laziness.  0x005f74xx
 1655: 	 *  is Sega's Holly ASIC, outside the SH7750 manual, and this project holds
 1656: 	 *  NO documentation for it -- so "real hardware preserves the upper bits"
 1657: 	 *  would be an oracle from plausibility, the #357/#362 shape this tree has
 1658: 	 *  already been burned by once.
 1659: 	 *
 1660: 	 *  *** AND MAINLINE LINUX CONSTRAINS ANY FUTURE FIX, WHICH IS THE FINDING
 1661: 	 *  THAT KILLED THE PANEL'S UNANIMOUS ANSWER. ***  drivers/cdrom/gdrom.c
 1662: 	 *  BYTE-WRITES this window's +0x18 to trigger every DMA transfer, and
 1663: 	 *  BYTE-READS it to poll for completion; the four VALUE registers it uses
 1664: 	 *  (+0x04/08/0c/14) are always 32-bit.  So the width-blind code delivers
 1665: 	 *  exactly what the one real narrow user needs, and a blanket "decline
 1666: 	 *  narrow writes" would BREAK a booting Linux.
 1667: 	 *
 1668: 	 *  THE DECIDED DESIGN, if a fix is ever warranted: decline with a latched
 1669: 	 *  diagnostic at the four VALUE registers ONLY, keeping +0x18 byte-capable.
 1670: 	 *  The discriminating row is seed 0x11223344 / byte 0xff / read back:
 1671: 	 *  0x000000ff today, 0x11223344 declined, 0x112233ff merged.  It must NOT
 1672: 	 *  ship as a green row pinning 0x000000ff -- that would enshrine this
 1673: 	 *  model's own behaviour as an oracle.
 1674: 	 */
 1675: 	if (writeflag == MEM_WRITE)
 1676: 		d->dma_reg[relative_addr / sizeof(uint32_t)] = idata;
 1677: 
 1678: 	if (writeflag == MEM_READ)
 1679: 		memory_writemax64(cpu, data, len, odata);
 1680: 
 1681: 	return 1;
 1682: }
 1683: 
 1684: 
 1685: DEVINIT(dreamcast_gdrom)
 1686: {
 1687: 	struct dreamcast_gdrom_data *d;
 1688: 
 1689: 	CHECK_ALLOCATION(d = (struct dreamcast_gdrom_data *) malloc(sizeof(struct dreamcast_gdrom_data)));
 1690: 	memset(d, 0, sizeof(struct dreamcast_gdrom_data));
 1691: 
 1692: 	memory_device_register(devinit->machine->memory, devinit->name,
 1693: 	    0x005f7000, 0x100, dev_dreamcast_gdrom_access, d,
 1694: 	    DM_DEFAULT, NULL);
 1695: 
 1696: 	memory_device_register(devinit->machine->memory, "gdrom_dma", 0x005f7400,
 1697: 	    0x80, dev_dreamcast_gdrom_dma_access, d, DM_DEFAULT, NULL);
 1698: 
 1699: 	return 1;
 1700: }
