#!/usr/bin/env python3
"""Render pipeline/matrix.html from pipeline/ledger.json.  NEVER hand-edit the output.

THE DOCSTRING SAID `dashboard.html` WHILE LINE 24 WROTE `matrix.html`, and an untracked,
stale dashboard.html has been sitting beside the real output as a result -- smaller and
hours older, and indistinguishable from the live board to anyone about to publish one.
The file this script writes is matrix.html; that is the tracked one and the one to publish.

Ledger-first (PIPELINE.md section 5): the JSON is the single source of truth; a cell without
a ledger entry behind it is a defect.  Idempotent.

Layout per the owner's directives (2026-08-15):
  * EVERY BUG SHOWS ALL FOUR PHASE ROWS (Assessment / Research / Final review / Regression);
    an empty phase is a row of dots - input is possible there.
  * BUGS IN WORK AT THE TOP, CLOSED BUGS AT THE BOTTOM, with a divider between them.
  * CELLS WITH CLEAR EDGES: full borders on the matrix cells.
  * THE BUG HEADER IS ONE LINE: id + title + state. The hold reason shows on
    MOUSE OVER only (owner, 2026-08-15): the state chip's title attribute and
    the id/title tooltip both carry it. Nothing inline.
Text on the page is ASD-STE100 unless a technical name is necessary.
"""
import html
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
#  GXLEDGER (#534): the render leg of the stage-token controls feeds a FIXTURE ledger, the same
#  override check_stage_panels.py and check_fable_queue.py already take.
LEDGER = os.environ.get("GXLEDGER") or os.path.join(HERE, "ledger.json")
#  `--out PATH` renders somewhere else WITHOUT touching the tracked file, so precommit
#  section Q can regenerate into a temp path and cmp.  Added when it turned out NOTHING
#  checked that matrix.html was current with ledger.json -- and the published artifact is
#  generated from that file, so a stale rendering ships a stale artifact.
OUT = os.path.join(HERE, "matrix.html")
if "--out" in sys.argv:
    OUT = sys.argv[sys.argv.index("--out") + 1]

L = json.load(open(LEDGER, encoding="utf-8"))
seats = L["seats"]
sid = {s["id"]: s for s in seats}
PHASES = ["assess", "research", "review", "regress"]
PLABEL = L["phase_labels"]

#  *** A SEAT ID THAT NO COLUMN DECLARES IS A HARD ERROR, NEVER A SILENT DROP. ***
#  Measured 2026-08-16: 59 entries were keyed "opus" while the column is declared
#  "opus5".  cell() matches on x["seat"] == seat["id"], so every one of them rendered
#  NOWHERE -- the measure seat's work simply was not on the dashboard, and the blank
#  cells read as "that seat never answered", which is the exact opposite of the truth
#  and the one reading this dashboard exists to prevent.  The owner spotted it by eye.
#
#  A dashboard that silently drops data it cannot place is worse than one that crashes:
#  a missing cell is indistinguishable from a seat failure, and this project's whole
#  discipline is that a seat failure is never counted as agreement.  So: refuse to
#  render, name every offender and how many entries it holds, and exit non-zero.
_declared = {s["id"] for s in seats}
_orphans = {}
for _r in L["rows"]:
    for _e in _r.get("entries", []):
        if _e.get("seat") not in _declared:
            _orphans.setdefault(_e.get("seat"), []).append(_r["id"])
if _orphans:
    sys.stderr.write("gen_dashboard: REFUSING TO RENDER -- seat ids used by entries "
                     "but declared by no column:\n")
    for _k in sorted(_orphans, key=lambda k: str(k)):
        _rows = sorted(set(_orphans[_k]))
        sys.stderr.write("  %-12r %3d entries across %d rows: %s%s\n"
                         % (_k, len(_orphans[_k]), len(_rows), ", ".join(_rows[:6]),
                            " ..." if len(_rows) > 6 else ""))
    sys.stderr.write("Fix the ledger (or add the column). Declared: %s\n"
                     % ", ".join(sorted(_declared)))
    sys.exit(2)

D_CLASS = {"�": "ok", "?": "hold", "?": "bad", ".": "pend"}
#  *** AN EXPLICIT `d` OUTSIDE THOSE FOUR IS NEITHER APPROVAL NOR A SEAT FAILURE, AND UNTIL 2026-10-16 IT RENDERED AS THE
#  SECOND.  (ledger `dashokclass`; ruled by Fable 5.1, GPT-6 Astra and Grok 4.7, adj_20261016/RULINGS_C_records.md F2.) ***
#  The fallback was `pend`, so 1,397 entries whose `d` is "OK", "N/A", a date, "y", "HELD", blank ... -- 439 of them "OK",
#  365 displayed cells -- all read as "no answer / seat failure".  Mapping "OK" to `ok` was REJECTED (it canonises one
#  off-domain spelling as approval); every mechanical sweep of the entries was withdrawn.  So an explicit `d` the map does
#  not know renders as ONE residue class, LEGACY, keeping its text, with the reason first in its tooltip; a MISSING `d` is
#  still `.`.  check_entry_domain.py (precommit Q2) stops new off-domain answers, so this class can only shrink.
LEGACY = "legacy"
e = lambda t: html.escape(str(t), quote=True)

BADGE_TIP = {"A": "the author did this review (shown, not hidden)",
             "s": "a review by the same model family",
             "?": "attribution not confirmed"}

#  `dropped` sorts BELOW closed. Any state not named here falls to 5 and lands in the
#  in-work bucket -- which is how twelve adjudicated-off rows nearly published as "in
#  work". Add new states HERE and to the section split below; the two must agree.
STATE_ORDER = {"active": 0, "held": 1, "pending": 2, "closed": 9, "dropped": 10}


#  *** AN ANNOTATION IS NOT AN ANSWER, AND UNTIL 2026-09-18 THIS FILE COULD NOT TELL THEM APART.
#  ***
#  `check_stage_panels.py` and `check_fable_queue.py` both SKIP entries carrying a stage token
#  before tallying seats -- an annotation exists to say WHY a stage is short, so counting it as one
#  of the seats that answered would let marking a gap CLOSE it.  This file never learned that, and
#  `cell()` matched on `seat` + `phase` alone.
#
#  The tokens are conventionally written with `seat: "fable5"`, so every one of them rendered as a
#  FABLE CELL -- **the dashboard asserted that the flagship seat had answered a stage on which no
#  panel was ever convened.**  That is not a cosmetic slip: it is the inverted form of the failure
#  this whole layer exists to prevent.  A missing cell reads as "seat failure, never agreement",
#  which the legend says out loud; a FABRICATED cell reads as agreement from the one seat whose
#  agreement carries the most weight, and nothing anywhere contradicts it.
#
#  Found 2026-09-18 by asking what the OTHER tools do with a token this file does not know -- the
#  same question that had just found `check_fable_queue.py` blind to RE_READ.  **Two tools, two
#  blind spots, one cause: a token was added where it was needed and never mirrored.**
#  *** CORRECTED 2026-09-18 (#534 F3): the paragraph above says the dashboard "asserted that the
#  flagship seat had answered" a stage no panel was convened on.  MEASURED FALSE by fable5 on #532
#  pass 2: before #532, zero token cells rendered as agreement (1415 ok cells before and after) --
#  ANNOTATION rendered as a held glyph, NOPANEL as the seat-failure glyph, HELD as its own `d'.  The
#  finding that survives is narrower: the tool was blind to the tokens, so it rendered them by
#  accident rather than by rule.  And #532's own fix over-reached the other way: filtering HELD
#  blanked a real held cell, and filtering ANNOTATION rendered an honest annotation as nothing.
#
#  #534: the literals and the classification live in stage_tokens.py (R5).  A HELD entry renders as
#  itself (R1); an entry that is not an answer renders the distinct glyph below WITH its note as the
#  tooltip, so an exemption can be read, never mistaken for a blank (R1, ANNOTATION included).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import stage_tokens as st  # noqa: E402

TOKEN_GLYPH = "�"   # empty set: this seat's entry here is a record, not an answer


def _latest(xs):
    """Date-latest entry, ties to the later-recorded one -- never simply list-last: an older answer
    appended after a newer hold must not hide the hold (codex, #534 pass 2)."""
    return max(enumerate(xs), key=lambda t: ((t[1].get("date") or ""), t[0]))[1]


def _held_cell(h, seat_id):
    t = e(" - ".join(p for p in (h.get("date"), "awaiting " + seat_id, h.get("note")) if p))
    return ('<td class="c hold"><span class="wrap" tabindex="0">'
            f'<span class="g">?</span><span class="tip">{t}</span></span></td>')


def cell(row, phase, seat):
    stage = [x for x in row.get("entries", []) if x.get("phase") == phase]
    mine = [x for x in stage if x["seat"] == seat["id"]]
    #  #534 pass 2 (Opus + codex, measured): a hold renders from its SEMANTICS, never from its `d'
    #  field -- no real HELD entry carries the hold glyph (25 say "HELD", others "--", "N/A", "" or
    #  nothing), so all of them rendered as `pend', the seat-failure glyph.  And it renders in the
    #  column of every seat it AWAITS, not only the column it happens to be filed under.
    if seat["id"] in st.live_holds(stage):
        return _held_cell(_latest([h for h in stage if seat["id"] in st.held_seats(h)]), seat["id"])
    ents = [x for x in mine if st.is_answer(x)]
    if not ents:
        held = [x for x in mine if st.is_held(x) and not st.held_seats(x)]
        if held:                         # a marker in no parseable shape: still a hold, never blank
            return _held_cell(_latest(held), seat["id"])
        recs = [x for x in mine if not st.is_answer(x)]
        if not recs:
            return '<td class="c none"><span class="g">�</span></td>'
        #  every record's note, not only the last: a later NOTSEAT must not hide an exemption's reason
        t = " || ".join(" - ".join(p for p in (r.get("date"), r.get("note")) if p) for r in recs)
        #  a refused exemption must not render as a calm one (kimi, #534 pass 2)
        refused = st.stage_token_problems(stage) if any(st.exempts_stage(r) for r in recs) else []
        if refused:
            t = "EXEMPTION REFUSED BY SECTION H: " + "; ".join(refused) + " || " + t
        t = e(t)
        return ('<td class="c tok"><span class="wrap" tabindex="0">'
                f'<span class="g">{TOKEN_GLYPH}</span><span class="tip">{t}</span></span></td>')
    ent = _latest(ents)
    d = ent.get("d", ".")
    cls = D_CLASS.get(d, LEGACY)
    badge = ent.get("b", "")
    tip = [p for p in (ent.get("date"), ent.get("grade"),
                       BADGE_TIP.get(badge), ent.get("note")) if p]
    if ent.get("ev"):
        tip.append("evidence: " + ent["ev"])
    if cls == LEGACY:
        tip.insert(0, "legacy -- verdict unclassified: d = %r is none of � ? ? . (not approval, not a seat failure)" % d)
    #  #534 F2 pass (codex): both of these lived only in the no-answer branch, so an ANSWER cell hid
    #  them -- a refused RE_READ rendered calm, and a record filed after the seat's answer vanished.
    if st.exempts_stage(ent):
        refused = st.stage_token_problems(stage)
        if refused:
            tip.insert(0, "EXEMPTION REFUSED BY SECTION H: " + "; ".join(refused))
    for r in (x for x in mine if not st.is_answer(x) and not st.is_held(x)):
        tip.append("record: " + " - ".join(p for p in (r.get("date"), r.get("note")) if p))
    t = e(" - ".join(tip))
    b = f'<sup class="b b-{badge}">{badge}</sup>' if badge else ""
    return (f'<td class="c {cls}"><span class="wrap" tabindex="0">'
            f'<span class="g">{e(d) if str(d).strip() else "?"}</span>{b}<span class="tip">{t}</span></span></td>')


def fix_section(row):
    state = row.get("state", "pending")
    clo = row.get("closure", {}) or {}
    hold = row.get("hold", "")
    tiplist = [row["title"]]
    if row.get("commits"):
        tiplist.append("commits: " + row["commits"])
    if hold:
        tiplist.append("HOLD: " + hold)
    if clo.get("note"):
        tiplist.append(clo["note"])
    #  *** `witness` AND `state_note` WERE RENDERED NOWHERE. ***  Filed as
    #  `witnessinvisible` after a ledger edit changed matrix.html by ZERO BYTES twice:
    #  this generator contained no reference to either field, so 34,712 bytes -- 3.0% of
    #  ledger prose, and the six largest `state_note` fields were all written the same day
    #  -- never reached the published artifact.  The proportion rises precisely because
    #  `state_note` is where a round's own reasoning now goes.
    #
    #  THE COST WAS NOT COSMETIC.  `witness` is the field a RANKER reads, and twice this
    #  week a fact was corrected in a seat entry and left stale in that field:
    #  `gdrompionull` advertised a rung-3 cost of "four stores and a load" after it was
    #  measured at 18 accesses, and `asicbadaddr` still said "none yet -- one constant
    #  away" after its witness existed and had been reviewed -- under-rating, in that
    #  second case, the row a ranking then placed FIRST.  A field nobody can see is a field
    #  nobody re-reads.
    #
    #  Rendered into the TOOLTIP, not inline, per the owner's 2026-08-15 layout directive:
    #  the header stays one line (id + title + state) and everything else is mouse-over.
    if row.get("witness"):
        tiplist.append("witness: " + str(row["witness"]))
    if row.get("state_note"):
        tiplist.append("note: " + str(row["state_note"]))
    lt = e(" - ".join(tiplist))
    badge = clo.get("badge", "")
    b = f'<sup class="b b-{badge}">{badge}</sup>' if badge else ""
    # Hold reason is MOUSE-OVER ONLY (owner, 2026-08-15): native title on the
    # state chip + the custom .tip on the id/title wrap. Nothing inline.
    ht = f' title="{e(hold)}"' if hold else ""
    statechip = f'<span class="state st-{state}"{ht}>{e(state)}</span>'
    head = (f'<tr class="fixhead st-{state}"><th colspan="{len(seats)+1}">'
            f'<span class="hline"><span class="wrap" tabindex="0">'
            f'<span class="rid">{e(row["id"])}</span>'
            f'<span class="ttl">{e(row["title"])}</span>{b}'
            f'<span class="tip">{lt}</span></span>'
            f'{statechip}</span></th></tr>')
    body = "".join(
        f'<tr class="ph st-{state}"><th scope="row" class="phlabel">{e(PLABEL[p])}</th>'
        + "".join(cell(row, p, s) for s in seats) + "</tr>"
        for p in PHASES)
    return head + body


rows_sorted = sorted(L["rows"], key=lambda r: STATE_ORDER.get(r.get("state"), 5))
#  THREE buckets, not two. `dropped` is NOT `closed`: closed means the work shipped, dropped
#  means the premise was refuted by measurement and no work is owed. Folding them together
#  would erase the distinction the adjudication exists to record -- and leaving `dropped` out
#  of the split entirely (the state it was in until 2026-08-20) silently counted twelve
#  adjudicated-off rows as "in work", because open_rows was defined by NOT-closed.
open_rows = [r for r in rows_sorted if r.get("state") not in ("closed", "dropped")]
closed_rows = [r for r in rows_sorted if r.get("state") == "closed"]
dropped_rows = [r for r in rows_sorted if r.get("state") == "dropped"]


def _divider(label, n):
    return (f'<tr class="divider"><th colspan="{len(seats)+1}">{label}</th></tr>'
            if n else "")


sections = ("".join(fix_section(r) for r in open_rows)
            + _divider("closed", len(closed_rows))
            + "".join(fix_section(r) for r in closed_rows)
            + _divider("dropped &mdash; premise refuted by measurement, no work owed",
                       len(dropped_rows))
            + "".join(fix_section(r) for r in dropped_rows))


def summary():
    #  the strip SUMS TO THE ENTRY TOTAL: every explicit `d` outside the four glyphs is counted once, as legacy
    n = {"�": 0, "?": 0, "?": 0, ".": 0, LEGACY: 0, "total": 0}
    for r in L["rows"]:
        for x in r.get("entries", []):
            d = x.get("d", ".")
            n[d if d in D_CLASS else LEGACY] += 1
            n["total"] += 1
    return n


n = summary()
bat = L["battery"]

heads = "".join(
    f'<th class="seat"><div class="diag"><span class="wrap" tabindex="0">'
    f'{e(s["name"])} <em>({e(s["ver"])})</em>'
    f'<span class="tip">{e(s["model"])} - {e(s["cls"])} - {e(s["note"])}</span>'
    f'</span><i class="cls cls-{e(s["cls"].split("+")[0])}">{e(s["cls"])}</i></div></th>'
    for s in seats)

page = f"""<title>GXemul Panel Ledger</title>
<style>
:root {{
  --ground:#f2f5f4; --panel:#ffffff; --ink:#1d2724; --muted:#5c6d68;
  --line:#c6d1cd; --line2:#e0e7e4; --accent:#1f6e64;
  --ok:#2f7d3b; --hold:#9a6b08; --bad:#ae352c; --pend:#7b8a86;
  --okbg:#eaf4eb; --holdbg:#f6eeda; --badbg:#f8e6e4;
  --chipbg:#e4ecea; --tipbg:#243330; --tipink:#e8f0ed;
  --fixbg:#e9efed; --closedbg:#f0f2f1;
}}
@media (prefers-color-scheme: dark) {{
  :root:not([data-theme="light"]) {{
    --ground:#121917; --panel:#1a2321; --ink:#d9e4e0; --muted:#8ca09a;
    --line:#3b4844; --line2:#27322f; --accent:#5fc4b4;
    --ok:#79c784; --hold:#dfb35c; --bad:#e77e74; --pend:#6d7f7a;
    --okbg:#1c2d21; --holdbg:#31280f; --badbg:#371f18;
    --chipbg:#22302d; --tipbg:#e8f0ed; --tipink:#1d2724;
    --fixbg:#202c29; --closedbg:#151d1b;
  }}
}}
:root[data-theme="dark"] {{
  --ground:#121917; --panel:#1a2321; --ink:#d9e4e0; --muted:#8ca09a;
  --line:#3b4844; --line2:#27322f; --accent:#5fc4b4;
  --ok:#79c784; --hold:#dfb35c; --bad:#e77e74; --pend:#6d7f7a;
  --okbg:#1c2d21; --holdbg:#31280f; --badbg:#371f18;
  --chipbg:#22302d; --tipbg:#e8f0ed; --tipink:#1d2724;
  --fixbg:#202c29; --closedbg:#151d1b;
}}
* {{ box-sizing:border-box; }}
body {{
  margin:0; background:var(--ground); color:var(--ink);
  font:14px/1.45 "Cascadia Mono","Consolas",ui-monospace,SFMono-Regular,Menlo,monospace;
  font-variant-numeric: tabular-nums; padding:28px 20px 60px;
}}
.sheet {{ max-width:1120px; margin:0 auto; display:flex; flex-direction:column; gap:18px; }}
header .eyebrow {{ font-size:11px; letter-spacing:.22em; text-transform:uppercase;
  color:var(--accent); font-weight:600; }}
header h1 {{ margin:2px 0 0;
  font-family:"Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;
  font-size:30px; font-weight:650; letter-spacing:-.01em; text-wrap:balance; }}
header .sub {{ color:var(--muted); margin-top:4px; max-width:70ch; }}
.strip {{ display:flex; flex-wrap:wrap; gap:8px; }}
.chip {{ background:var(--chipbg); border:1px solid var(--line2); border-radius:3px;
  padding:4px 10px; font-size:12px; display:inline-flex; gap:7px; align-items:baseline; }}
.chip b {{ font-weight:600; }}
.chip .k {{ color:var(--muted); font-size:11px; letter-spacing:.08em; text-transform:uppercase; }}
.chip.pass b {{ color:var(--ok); }}
.matrix-scroll {{ overflow-x:auto; background:var(--panel); border:1px solid var(--line);
  border-radius:4px; padding:6px 10px 14px; }}
table {{ border-collapse:collapse; width:100%; min-width:980px; }}
thead th {{ height:150px; vertical-align:bottom; border-bottom:2px solid var(--accent); }}
thead th.rowhead {{ text-align:left; color:var(--muted); font-size:11px; font-weight:500;
  letter-spacing:.14em; text-transform:uppercase; padding:0 8px 8px; }}
th.seat {{ width:62px; }}
.diag {{ position:relative; height:150px; width:62px; }}
.diag > .wrap {{ position:absolute; bottom:34px; left:30px; transform:rotate(-50deg);
  transform-origin:bottom left; white-space:nowrap; font-size:12.5px; font-weight:600; }}
.diag em {{ color:var(--muted); font-style:normal; font-weight:500; }}
.diag .cls {{ position:absolute; bottom:8px; left:50%; transform:translateX(-50%);
  font-style:normal; font-size:9.5px; letter-spacing:.06em; color:var(--muted);
  border:1px solid var(--line2); border-radius:2px; padding:0 4px; }}
.cls-PK {{ color:var(--accent); border-color:var(--accent); }}
tr.fixhead th {{ text-align:left; background:var(--fixbg);
  border:1px solid var(--line); border-left:none; border-right:none;
  padding:7px 10px; font-weight:600; font-size:13px; }}
tr.fixhead.st-closed th, tr.fixhead.st-dropped th {{ background:var(--closedbg); }}
tr.fixhead.st-dropped .ttl {{ opacity:.55; text-decoration:line-through; }}
.state.st-dropped {{ color:var(--muted); border-color:var(--muted); }}
tr.fixhead.st-closed .ttl {{ opacity:.7; }}
/* ONE LINE: nothing in the header may wrap; long parts get an ellipsis. */
.hline {{ display:flex; align-items:baseline; gap:8px; white-space:nowrap; overflow:hidden; }}
.hline > .wrap {{ display:inline-flex; align-items:baseline; gap:6px; min-width:0;
  flex:0 1 auto; }}
.ttl {{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:430px;
  display:inline-block; vertical-align:bottom; }}
.rid {{ color:var(--accent); font-weight:700; flex:none; }}
.state {{ flex:none; font-size:9.5px; letter-spacing:.09em; text-transform:uppercase;
  border:1px solid var(--line2); border-radius:2px; padding:1px 6px; color:var(--muted); }}
.state.st-active {{ color:var(--accent); border-color:var(--accent); font-weight:700; }}
.state.st-held {{ color:var(--hold); border-color:var(--hold); }}
.state[title] {{ cursor:help; border-style:dashed; }}
tr.ph th.phlabel {{ text-align:left; font-weight:400; color:var(--muted); font-size:12.5px;
  padding:5px 10px 5px 22px; border:1px solid var(--line2); border-left:none;
  white-space:nowrap; }}
tr.ph td {{ border:1px solid var(--line2); text-align:center; padding:4px 0;
  background:var(--panel); }}
tr.ph.st-closed td, tr.ph.st-closed th.phlabel,
tr.ph.st-dropped td, tr.ph.st-dropped th.phlabel {{ background:var(--closedbg); }}
td.c.ok {{ background:var(--okbg); }}
td.c.hold {{ background:var(--holdbg); }}
td.c.bad {{ background:var(--badbg); }}
tr.ph.st-closed td.c.ok {{ background:color-mix(in srgb, var(--okbg) 55%, var(--closedbg)); }}
.c .g {{ font-size:15px; }}
.c.ok .g {{ color:var(--ok); }} .c.hold .g {{ color:var(--hold); }}
.c.bad .g {{ color:var(--bad); font-weight:700; }} .c.pend .g {{ color:var(--pend); }}
.c.none .g {{ color:var(--line); }}
.c.tok .g {{ color:var(--muted); }}
td.c.legacy {{ outline:1px dashed var(--line); outline-offset:-3px; }}
.c.legacy .g {{ color:var(--muted); font-style:italic; font-size:11px; }}
.b {{ font-size:9.5px; font-weight:700; margin-left:1px; color:var(--accent);
  border:1px solid var(--accent); border-radius:2px; padding:0 2px; vertical-align:6px; }}
.b-s {{ color:var(--hold); border-color:var(--hold); }}
tr.divider th {{ background:var(--ground); color:var(--muted); text-align:left;
  font-size:10.5px; letter-spacing:.18em; text-transform:uppercase;
  padding:12px 10px 4px; border:none; border-bottom:2px solid var(--line); }}
.wrap {{ position:relative; cursor:default; }}
.wrap:focus {{ outline:2px solid var(--accent); outline-offset:1px; }}
.tip {{ display:none; position:absolute; z-index:9; left:50%; bottom:calc(100% + 8px);
  transform:translateX(-50%); width:340px; max-width:76vw; white-space:normal;
  text-align:left; font-size:12px; line-height:1.45; font-weight:400;
  background:var(--tipbg); color:var(--tipink); border-radius:4px; padding:9px 11px;
  box-shadow:0 6px 22px rgba(0,0,0,.28); text-transform:none; letter-spacing:0; }}
.wrap:hover .tip, .wrap:focus .tip {{ display:block; }}
thead .tip {{ transform:none; left:auto; right:-10px; bottom:auto; top:calc(100% + 6px); }}
tr.fixhead .tip {{ transform:none; left:0; bottom:auto; top:calc(100% + 6px); }}
.legend {{ display:flex; flex-wrap:wrap; gap:14px; color:var(--muted); font-size:12px; }}
.legend .g {{ font-size:14px; }}
footer {{ color:var(--muted); font-size:11.5px; max-width:78ch; }}
footer code {{ color:var(--ink); }}
</style>
<div class="sheet">
<header>
  <div class="eyebrow">multi-llm fix pipeline � made from the ledger</div>
  <h1>GXemul Panel Ledger</h1>
  <div class="sub">Each bug shows all four phases. A phase with no input shows a row of
  dots: input is possible there. Bugs in work are at the top; closed bugs are below the
  divider. Put the pointer on a cell, or give it focus, to see the date, the evidence
  grade, the note, and the path of the evidence file.</div>
</header>
<div class="strip">
  <span class="chip pass"><span class="k">battery</span><b>{e(bat["verdict"])} {e(bat["coverage"])}</b>
    <span>{e(bat["when"])} @ {e(bat["head"])}</span></span>
  <span class="chip"><span class="k">flagship</span><b>{e(sid[L["flagship"]]["name"])} ({e(sid[L["flagship"]]["ver"])})</b></span>
  <span class="chip"><span class="k">bugs</span><b>{len(open_rows)} in work � {len(closed_rows)} closed � {len(dropped_rows)} dropped</b></span>
  <span class="chip"><span class="k">entries</span><b>{n["�"]}� {n["?"]}? {n["?"]}? {n["."]}. {n[LEGACY]} legacy � {n["total"]} in all</b></span>
  <span class="chip"><span class="k">updated</span><b>{e(L["updated"])}</b></span>
</div>
<div class="matrix-scroll"><table>
<thead><tr><th class="rowhead">bug � phase</th>{heads}</tr></thead>
<tbody>{sections}</tbody>
</table></div>
<div class="legend">
  <span><span class="g" style="color:var(--ok)">�</span> approved</span>
  <span><span class="g" style="color:var(--hold)">?</span> held / in work</span>
  <span><span class="g" style="color:var(--bad)">?</span> objection</span>
  <span><span class="g" style="color:var(--pend)">.</span> no answer / seat failure (not agreement)</span>
  <span><span class="g" style="color:var(--muted);font-style:italic">OK</span> legacy -- an older entry's verdict text outside � ? ? . (unclassified: not approval, not a seat failure; hover for it)</span>
  <span><span class="g" style="color:var(--muted)">�</span> a record, not an answer (exemption or main-loop note; hover for why)</span>
  <span><span class="g" style="color:var(--line)">�</span> no input - input is possible</span>
  <span><sup class="b">A</sup> the author did this review (shown)</span>
  <span><sup class="b b-s">s</sup> a review by the same model family</span>
  <span>FR = reads files � FR+M = reads files and does tests � <span style="color:var(--accent)">PK = gets a packet only</span></span>
</div>
<footer>The program <code>gen_dashboard.py</code> makes this page from
<code>pipeline/ledger.json</code>. Do not change this page manually. If a cell does not have
a ledger entry, the cell is a defect. A packet-fed seat examines the argument only. Its vote
about the contents of the repository is not equal to the vote of a seat that reads files
(PIPELINE.md, Section 1). An ? cell can be the most important cell in its row: the ? in the
Research phase of #419 changed the design. Rule for closed rows (owner, 2026-08-15): a closed
row does not need new tests when the flagship seat (Fable) examined the final change and its
evidence. That examination fills the Final review cell of the closed row.
<b>Regression phase (owner, 2026-08-15): only the flagship seat reviews the regression tests,
and the reviews are BATCHED TO SUNDAY NIGHT, after the full battery, which now runs Sunday at
18:00 so that its evidence covers the rounds the review examines.</b> The other eight cells in a Regression line are NOT
REQUIRED, and a Regression line that is empty on a round finished after Saturday is WAITING FOR THE
SUNDAY BATCH, not missing. So a line of dots there shows a rule, not a gap. The first three phases
still need all nine seats, per round, before that round proceeds.</footer>
</div>
"""

#  newline="\n" IS LOAD-BEARING, AND CHECK Q WAS INTERPRETER-DEPENDENT WITHOUT IT.
#
#  In text mode Windows Python translates every \n to \r\n while WSL python3 does not, so
#  the SAME ledger rendered 1,448,409 bytes under one and 1,446,256 under the other -- a
#  2,153-byte delta over ~2,153 lines.  precommit section Q renders to a temp file and
#  `cmp`s it against the committed matrix.html, so whether Q passed depended entirely on
#  whether the person who last regenerated used the same interpreter the gate does.
#
#  Both directions were wrong.  Regenerate with WSL python3 and Q is RED over a file that
#  is perfectly current -- and a check that reddens on correct state gets worked around,
#  which is how a gate stops meaning anything.  Regenerate with Windows python and Q goes
#  green over CRLF content that no other tool in this tree writes.
#
#  MEASURED on this file's own output, which is why it is a one-word fix and not a
#  tolerance in the comparison: the render is otherwise fully deterministic (two
#  consecutive runs are byte-identical), so an exact cmp is the right test once the
#  newline translation is off.
#  #534 F2 pass (Opus): IMPORTING this module to call cell() rewrote the TRACKED matrix.html -- a
#  measuring seat did exactly that by accident.  Only a run as a script writes the file.
if __name__ == "__main__":
    open(OUT, "w", encoding="utf-8", newline="\n").write(page)
    sys.stdout.write("wrote %s (%d bytes, %d in work + %d closed, %d seats)\n"
                     % (OUT, os.path.getsize(OUT), len(open_rows), len(closed_rows), len(seats)))
"""THE ONE PLACE A LEDGER STAGE TOKEN IS SPELLED OR CLASSIFIED.  #534, 2026-09-18.

WHY THIS FILE EXISTS.  Four tools read ledger entries and each carried its own copy of the tokens:
check_stage_panels.py knew four, check_fable_queue.py was never taught RE_READ, gen_dashboard.py
filtered HELD markers it had no business filtering, and check_fix_seats.py knew only HELD -- so it
credited a stage-exemption entry written under `seat: fable5' as a FLAGSHIP ANSWER, and the row that
introduced the newest token passed its own flagship mandate on that token (#532 pass 2, Opus seat,
MEASURED).  One cause every time: a token added where it was needed and never mirrored.  So the
literals AND the classification live here, and precommit_check.sh refuses a token literal anywhere
else in tools/pipeline/.  *** THREE of those four readers ship with #534 and are covered by its controls;
check_fix_seats.py is another round's untracked, unwired draft -- it imports is_answer from here but NO
control covers it until it ships (fable5, #534 last seat: this sentence overclaimed until then). ***

AN ENTRY HAS TWO INDEPENDENT PROPERTIES, and the #532 code conflated them:

  is_answer(e)     -- does this entry count as the seat answering?
  exempts_stage(e) -- does this entry exempt its WHOLE (row, phase) stage from the panel rule?

                    is_answer   exempts_stage
    HELD             no           no          (a promise; handled by its own rules)
    ANNOTATION       no           yes         (pre-2026-08-16 policy)
    RE_READ          YES          yes         (a real single-seat re-read -- fable measured one
                                               rendering as agreement pre-#532, rightly)
    NOPANEL          no           yes         (no panel was convened on this stage)
    NOTSEAT          no           NO          (THIS ENTRY is a main-loop record, not a seat
                                               answer; it can never silence other entries)
    anything else    yes          no

NOTSEAT IS THE ENTRY-SCOPED MARKER, and it is the one to reach for by default.  #532 used the
stage-scoped NOPANEL for six records that meant only "this entry is not a seat answer"; on those
rows any panel LATER recorded under the same phase would have been silently exempted in advance
(fable5, #532 pass 2, R2).  A stage exemption is a claim about everything in the stage and must be
earned; see stage_token_problems() for the guard.
"""
import re

HELD = "[HELD AWAITING SEAT:"
ANNOTATION = "[RUN UNDER THE PRE-2026-08-16 POLICY]"
RE_READ = "[NOT A PANEL STAGE: SINGLE-SEAT RE-READ]"
NOPANEL = "[NOT A PANEL STAGE: NO PANEL CONVENED]"
NOTSEAT = "[NOT A SEAT ANSWER]"

STAGE_EXEMPT = (ANNOTATION, RE_READ, NOPANEL)
ALL = (HELD, ANNOTATION, RE_READ, NOPANEL, NOTSEAT)

PANEL_DIR = re.compile(r"panel_\d{8}_\d{6}")


def _note(e):
    return e.get("note") or ""


def is_held(e):
    return HELD in _note(e)


def exempts_stage(e):
    n = _note(e)
    #  HELD and NOTSEAT both dominate: a hold is a promise and NOTSEAT says "this entry only" -- an
    #  entry carrying either can never exempt the stage, whatever else it quotes (minimax, #534 pass 2:
    #  the docstring promised this of NOTSEAT and the code did not deliver it).
    return (not is_held(e)) and NOTSEAT not in n and any(t in n for t in STAGE_EXEMPT)


def is_answer(e):
    n = _note(e)
    if HELD in n or NOTSEAT in n or ANNOTATION in n or NOPANEL in n:
        return False
    return True          # RE_READ entries ARE answers; so is every untokened entry


HELD_SEATS = re.compile(re.escape(HELD) + r"[ \t]*([a-z0-9_]+(?:[ \t]*,[ \t]*[a-z0-9_]+)*)[ \t]*\]")
#  case-SENSITIVE, like is_held() -- they disagreed until the #534 F2 pass (codex); the ledger holds
#  zero non-canonical spellings, so this changes no real reading


MALFORMED = "?malformed-hold"
POLICY_CUTOFF = "2026-08-16"   # full panel on every stage; work before it is not judged by it


def held_seats(e):
    """The seats a HELD entry names, in order, or [] if it names none in the strict shape."""
    m = HELD_SEATS.search(_note(e))
    return [x.strip().lower() for x in m.group(1).split(",")] if m else []


def live_holds(entries):
    """Seats still awaited in one (row, phase): named by a HELD entry and NOT answered by that seat
    in this stage at a STRICTLY LATER date -- the carrier's discharge rule, applied here so every
    reader agrees on it.  (#534 pass 2, codex + Opus: two of the three stages that showed a full count
    over a hold were DISCHARGED holds, and one was live; a reader must tell them apart.)"""
    out = []
    for h in entries:
        if not is_held(h):
            continue
        hd = h.get("date") or ""
        named = held_seats(h)
        if not named:
            #  a hold in no parseable shape can never be discharged by an answer -- it holds until
            #  someone writes it properly; a malformed marker must not read as "nothing owed"
            #  (codex, #534 F2 pass: `[HELD AWAITING SEAT: glm,]` let a closed row pass H and I)
            if MALFORMED not in out:
                out.append(MALFORMED)
            continue
        for seat in named:
            done = any((e.get("seat") or "").lower() == seat and is_answer(e)
                       and (e.get("date") or "") > hd for e in entries)
            if not done and seat not in out:
                out.append(seat)
    return out


def stage_token_problems(entries):
    """Why a stage's exemption must be REFUSED, or [] if it stands.  `entries' = one (row, phase).

    (i)  STRICTLY LATER -- EVERY exemption token: a tallied answer dated after the newest exemption
         entry.  An exemption is a claim about the stage AS IT STOOD; material recorded afterwards is
         new, and nothing about a token's vintage makes it cover the future (#534 pass 2: codex, Opus,
         deepseek, minimax, kimi all refused the NOPANEL-only scope; Opus measured that clause (i) was
         never the part that refused the legacy stages).
    (ii) UNCITED PANEL -- NOPANEL ONLY: a tallied answer cites a panel dir that no exemption entry
         names.  This clause IS the retroactive one: annotations and re-reads were written before an
         exemption had to name its panels, and applying it to them refused seven legacy stages for a
         requirement nobody owed at the time.  (A stage whose answers cite no panel dir passes it --
         Opus fixture G, a DISCLOSED escape.)

    Brief-TITLE matching is deliberately absent: a correlate that missed BOTH real disputed cases
    (fable5, #532 pass 2, R4)."""
    tok = [e for e in entries if exempts_stage(e)]
    if not tok:
        return []
    newest_tok = max((e.get("date") or "") for e in tok)
    nop = [e for e in tok if NOPANEL in _note(e)]
    cited = set()
    for e in nop:
        cited |= set(PANEL_DIR.findall(_note(e) + " " + (e.get("ev") or "")))
    out = []
    for e in entries:
        if not is_answer(e) or e in tok:
            continue
        d = e.get("date") or ""
        #  a later answer that itself PREDATES the full-panel directive is not judged by it: the
        #  pre-policy stage it joined was grandfathered, and stays so (kimi, #534 F2 pass)
        if d > newest_tok and d >= POLICY_CUTOFF:
            out.append("answer by %s dated %s is LATER than the exemption (%s)"
                       % (e.get("seat"), d, newest_tok))
        if nop:
            for p in PANEL_DIR.findall(e.get("ev") or ""):
                if p not in cited:
                    out.append("answer by %s cites %s, which the exemption does not name"
                               % (e.get("seat"), p))
    return out


_CORES = {HELD: ("HELD AWAITING SEAT",), ANNOTATION: ("PRE-2026-08-16 POLICY", "RUN UNDER THE PRE"),
          RE_READ: ("SINGLE-SEAT RE-READ",), NOPANEL: ("NO PANEL CONVENED",),
          NOTSEAT: ("NOT A SEAT ANSWER",)}


def literal_offenders(paths):
    """(path, line, token) for every CODE string constant outside this module that spells a token.

    The control fable5 required with R5: the literals live here or nowhere.  Docstrings and comments
    are exempt -- they DESCRIBE tokens, and a prose mention never classified an entry.  An AST walk,
    not a grep, because a grep cannot tell a docstring from a constant and would either flag every
    history paragraph or be loosened until it flagged nothing."""
    import ast
    out = []
    for p in paths:
        src = open(p, encoding="utf-8").read()
        tree = ast.parse(src, p)
        docs = set()
        for n in ast.walk(tree):
            if isinstance(n, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                b = getattr(n, "body", None)
                if b and isinstance(b[0], ast.Expr) and isinstance(b[0].value, ast.Constant):
                    docs.add(id(b[0].value))
        def fold(n):
            """a string built by explicit `+' of constants, folded -- or None"""
            if isinstance(n, ast.Constant) and isinstance(n.value, str):
                return n.value
            if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
                a, b = fold(n.left), fold(n.right)
                return a + b if a is not None and b is not None else None
            return None
        for n in ast.walk(tree):
            if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
                v = fold(n)
                hit = [t for t in ALL if v is not None and any(c in v for c in _CORES[t])]
                if hit:
                    #  #534 F2 pass (kimi, minimax, deepseek): "NOT A SEAT " + "ANSWER]" escaped the
                    #  per-constant match; fold the concatenation and test the whole
                    out.append((p, n.lineno, hit[0]))
                continue
            if isinstance(n, ast.Constant) and isinstance(n.value, str) and id(n) not in docs:
                for t in ALL:
                    #  Matched on the token's CORE PHRASE, brackets and punctuation stripped: a
                    #  fragment like "PRE-2026-08-16 POLICY" or "HELD AWAITING SEAT" classifies just
                    #  as well as the whole literal, and a whole-literal match missed it (Opus, #534
                    #  pass 2: `or "PRE-2026-08-16 POLICY" in note' passed this check).
                    if any(c in n.value for c in _CORES[t]):
                        out.append((p, n.lineno, t))
                        break
    return out


if __name__ == "__main__":
    import glob
    import os
    import sys
    if sys.argv[1:2] == ["--census"]:
        #  fable5 F2 (#534): #532 stated this population three ways ("nine", "eleven of twelve",
        #  and the true 17 stages / 23 entries) because each was counted by hand.  This is the one
        #  deriver: per token, ENTRIES and distinct (row, phase) STAGES -- two units, both named.
        import io
        import json
        led = sys.argv[2] if len(sys.argv) > 2 else os.path.join(
            os.path.dirname(os.path.abspath(__file__)), "ledger.json")
        rows = json.load(io.open(led, encoding="utf-8"))["rows"]
        names = {HELD: "HELD", ANNOTATION: "ANNOTATION", RE_READ: "RE_READ",
                 NOPANEL: "NOPANEL", NOTSEAT: "NOTSEAT"}
        for t in ALL:
            n_ent, stages = 0, set()
            for r in rows:
                for e in r.get("entries", []):
                    if t in _note(e):
                        n_ent += 1
                        stages.add((r["id"], e.get("phase")))
            print("%-10s %4d entries  %4d stages" % (names[t], n_ent, len(stages)))
        print("STAGE_TOKEN_CENSUS  ledger=%s" % led)
        sys.exit(0)
    if sys.argv[1:2] != ["--selfcheck"]:
        print("usage: stage_tokens.py --selfcheck [files...] | --census [ledger.json]")
        sys.exit(2)
    here = os.path.dirname(os.path.abspath(__file__))
    files = sys.argv[2:] or [f for f in sorted(glob.glob(os.path.join(here, "*.py")))
                             if os.path.basename(f) != "stage_tokens.py"]
    bad = literal_offenders(files)
    for p, ln, t in bad:
        print("  %s:%d spells %s -- import it from stage_tokens.py" % (os.path.basename(p), ln, t))
    print("STAGE_TOKENS_%s  %d file(s) scanned, %d literal(s) outside stage_tokens.py"
          % ("FAIL" if bad else "PASS", len(files), len(bad)))
