1: #!/usr/bin/env python3
2: """Render pipeline/matrix.html from pipeline/ledger.json.  NEVER hand-edit the output.
3: 
4: THE DOCSTRING SAID `dashboard.html` WHILE LINE 24 WROTE `matrix.html`, and an untracked,
5: stale dashboard.html has been sitting beside the real output as a result -- smaller and
6: hours older, and indistinguishable from the live board to anyone about to publish one.
7: The file this script writes is matrix.html; that is the tracked one and the one to publish.
8: 
9: Ledger-first (PIPELINE.md section 5): the JSON is the single source of truth; a cell without
10: a ledger entry behind it is a defect.  Idempotent.
11: 
12: Layout per the owner's directives (2026-08-15):
13:   * EVERY BUG SHOWS ALL FOUR PHASE ROWS (Assessment / Research / Final review / Regression);
14:     an empty phase is a row of dots \u2014 input is possible there.
15:   * BUGS IN WORK AT THE TOP, CLOSED BUGS AT THE BOTTOM, with a divider between them.
16:   * CELLS WITH CLEAR EDGES: full borders on the matrix cells.
17:   * THE BUG HEADER IS ONE LINE: id + title + state. The hold reason shows on
18:     MOUSE OVER only (owner, 2026-08-15): the state chip's title attribute and
19:     the id/title tooltip both carry it. Nothing inline.
20: Text on the page is ASD-STE100 unless a technical name is necessary.
21: """
22: import html
23: import json
24: import os
25: import sys
26: 
27: HERE = os.path.dirname(os.path.abspath(__file__))
28: #  GXLEDGER (#534): the render leg of the stage-token controls feeds a FIXTURE ledger, the same
29: #  override check_stage_panels.py and check_fable_queue.py already take.
30: LEDGER = os.environ.get("GXLEDGER") or os.path.join(HERE, "ledger.json")
31: #  `--out PATH` renders somewhere else WITHOUT touching the tracked file, so precommit
32: #  section Q can regenerate into a temp path and cmp.  Added when it turned out NOTHING
33: #  checked that matrix.html was current with ledger.json -- and the published artifact is
34: #  generated from that file, so a stale rendering ships a stale artifact.
35: OUT = os.path.join(HERE, "matrix.html")
36: if "--out" in sys.argv:
37:     OUT = sys.argv[sys.argv.index("--out") + 1]
38: 
39: L = json.load(open(LEDGER, encoding="utf-8"))
40: seats = L["seats"]
41: sid = {s["id"]: s for s in seats}
42: PHASES = ["assess", "research", "review", "regress"]
43: PLABEL = L["phase_labels"]
44: 
45: #  *** A SEAT ID THAT NO COLUMN DECLARES IS A HARD ERROR, NEVER A SILENT DROP. ***
46: #  Measured 2026-08-16: 59 entries were keyed "opus" while the column is declared
47: #  "opus5".  cell() matches on x["seat"] == seat["id"], so every one of them rendered
48: #  NOWHERE -- the measure seat's work simply was not on the dashboard, and the blank
49: #  cells read as "that seat never answered", which is the exact opposite of the truth
50: #  and the one reading this dashboard exists to prevent.  The owner spotted it by eye.
51: #
52: #  A dashboard that silently drops data it cannot place is worse than one that crashes:
53: #  a missing cell is indistinguishable from a seat failure, and this project's whole
54: #  discipline is that a seat failure is never counted as agreement.  So: refuse to
55: #  render, name every offender and how many entries it holds, and exit non-zero.
56: _declared = {s["id"] for s in seats}
57: _orphans = {}
58: for _r in L["rows"]:
59:     for _e in _r.get("entries", []):
60:         if _e.get("seat") not in _declared:
61:             _orphans.setdefault(_e.get("seat"), []).append(_r["id"])
62: if _orphans:
63:     sys.stderr.write("gen_dashboard: REFUSING TO RENDER -- seat ids used by entries "
64:                      "but declared by no column:\\n")
65:     for _k in sorted(_orphans, key=lambda k: str(k)):
66:         _rows = sorted(set(_orphans[_k]))
67:         sys.stderr.write("  %-12r %3d entries across %d rows: %s%s\\n"
68:                          % (_k, len(_orphans[_k]), len(_rows), ", ".join(_rows[:6]),
69:                             " ..." if len(_rows) > 6 else ""))
70:     sys.stderr.write("Fix the ledger (or add the column). Declared: %s\\n"
71:                      % ", ".join(sorted(_declared)))
72:     sys.exit(2)
73: 
74: D_CLASS = {"\u2713": "ok", "\u23f8": "hold", "\u2715": "bad", "\u2026": "pend"}
75: #  *** AN EXPLICIT `d` OUTSIDE THOSE FOUR IS NEITHER APPROVAL NOR A SEAT FAILURE, AND UNTIL 2026-10-16 IT RENDERED AS THE
76: #  SECOND.  (ledger `dashokclass`; ruled by Fable 5.1, GPT-6 Astra and Grok 4.7, adj_20261016/RULINGS_C_records.md F2.) ***
77: #  The fallback was `pend`, so 1,397 entries whose `d` is "OK", "N/A", a date, "y", "HELD", blank ... -- 439 of them "OK",
78: #  365 displayed cells -- all read as "no answer / seat failure".  Mapping "OK" to `ok` was REJECTED (it canonises one
79: #  off-domain spelling as approval); every mechanical sweep of the entries was withdrawn.  So an explicit `d` the map does
80: #  not know renders as ONE residue class, LEGACY, keeping its text, with the reason first in its tooltip; a MISSING `d` is
81: #  still `\u2026`.  check_entry_domain.py (precommit Q2) stops new off-domain answers, so this class can only shrink.
82: LEGACY = "legacy"
83: e = lambda t: html.escape(str(t), quote=True)
84: 
85: BADGE_TIP = {"A": "the author did this review (shown, not hidden)",
86:              "s": "a review by the same model family",
87:              "?": "attribution not confirmed"}
88: 
89: #  `dropped` sorts BELOW closed. Any state not named here falls to 5 and lands in the
90: #  in-work bucket -- which is how twelve adjudicated-off rows nearly published as "in
91: #  work". Add new states HERE and to the section split below; the two must agree.
92: STATE_ORDER = {"active": 0, "held": 1, "pending": 2, "closed": 9, "dropped": 10}
93: 
94: 
95: #  *** AN ANNOTATION IS NOT AN ANSWER, AND UNTIL 2026-09-18 THIS FILE COULD NOT TELL THEM APART.
96: #  ***
97: #  `check_stage_panels.py` and `check_fable_queue.py` both SKIP entries carrying a stage token
98: #  before tallying seats -- an annotation exists to say WHY a stage is short, so counting it as one
99: #  of the seats that answered would let marking a gap CLOSE it.  This file never learned that, and
100: #  `cell()` matched on `seat` + `phase` alone.
101: #
102: #  The tokens are conventionally written with `seat: "fable5"`, so every one of them rendered as a
103: #  FABLE CELL -- **the dashboard asserted that the flagship seat had answered a stage on which no
104: #  panel was ever convened.**  That is not a cosmetic slip: it is the inverted form of the failure
105: #  this whole layer exists to prevent.  A missing cell reads as "seat failure, never agreement",
106: #  which the legend says out loud; a FABRICATED cell reads as agreement from the one seat whose
107: #  agreement carries the most weight, and nothing anywhere contradicts it.
108: #
109: #  Found 2026-09-18 by asking what the OTHER tools do with a token this file does not know -- the
110: #  same question that had just found `check_fable_queue.py` blind to RE_READ.  **Two tools, two
111: #  blind spots, one cause: a token was added where it was needed and never mirrored.**
112: #  *** CORRECTED 2026-09-18 (#534 F3): the paragraph above says the dashboard "asserted that the
113: #  flagship seat had answered" a stage no panel was convened on.  MEASURED FALSE by fable5 on #532
114: #  pass 2: before #532, zero token cells rendered as agreement (1415 ok cells before and after) --
115: #  ANNOTATION rendered as a held glyph, NOPANEL as the seat-failure glyph, HELD as its own `d'.  The
116: #  finding that survives is narrower: the tool was blind to the tokens, so it rendered them by
117: #  accident rather than by rule.  And #532's own fix over-reached the other way: filtering HELD
118: #  blanked a real held cell, and filtering ANNOTATION rendered an honest annotation as nothing.
119: #
120: #  #534: the literals and the classification live in stage_tokens.py (R5).  A HELD entry renders as
121: #  itself (R1); an entry that is not an answer renders the distinct glyph below WITH its note as the
122: #  tooltip, so an exemption can be read, never mistaken for a blank (R1, ANNOTATION included).
123: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
124: import stage_tokens as st  # noqa: E402
125: 
126: TOKEN_GLYPH = "\u2205"   # empty set: this seat\'s entry here is a record, not an answer
127: 
128: 
129: def _latest(xs):
130:     """Date-latest entry, ties to the later-recorded one -- never simply list-last: an older answer
131:     appended after a newer hold must not hide the hold (codex, #534 pass 2)."""
132:     return max(enumerate(xs), key=lambda t: ((t[1].get("date") or ""), t[0]))[1]
133: 
134: 
135: def _held_cell(h, seat_id):
136:     t = e(" \u2014 ".join(p for p in (h.get("date"), "awaiting " + seat_id, h.get("note")) if p))
137:     return (\'<td class="c hold"><span class="wrap" tabindex="0">\'
138:             f\'<span class="g">\u23f8</span><span class="tip">{t}</span></span></td>\')
139: 
140: 
141: def cell(row, phase, seat):
142:     stage = [x for x in row.get("entries", []) if x.get("phase") == phase]
143:     mine = [x for x in stage if x["seat"] == seat["id"]]
144:     #  #534 pass 2 (Opus + codex, measured): a hold renders from its SEMANTICS, never from its `d'
145:     #  field -- no real HELD entry carries the hold glyph (25 say "HELD", others "--", "N/A", "" or
146:     #  nothing), so all of them rendered as `pend', the seat-failure glyph.  And it renders in the
147:     #  column of every seat it AWAITS, not only the column it happens to be filed under.
148:     if seat["id"] in st.live_holds(stage):
149:         return _held_cell(_latest([h for h in stage if seat["id"] in st.held_seats(h)]), seat["id"])
150:     ents = [x for x in mine if st.is_answer(x)]
151:     if not ents:
152:         held = [x for x in mine if st.is_held(x) and not st.held_seats(x)]
153:         if held:                         # a marker in no parseable shape: still a hold, never blank
154:             return _held_cell(_latest(held), seat["id"])
155:         recs = [x for x in mine if not st.is_answer(x)]
156:         if not recs:
157:             return \'<td class="c none"><span class="g">\xb7</span></td>\'
158:         #  every record's note, not only the last: a later NOTSEAT must not hide an exemption's reason
159:         t = " || ".join(" \u2014 ".join(p for p in (r.get("date"), r.get("note")) if p) for r in recs)
