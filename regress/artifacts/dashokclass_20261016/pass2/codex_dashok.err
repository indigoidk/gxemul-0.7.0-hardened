495: #  ---- Q2 --------------------------------------------------------------------------
496: #  A NEW LEDGER ANSWER CARRIES A `d` THE DASHBOARD CLASSIFIES -- OR NONE.  2026-10-16, ledger `dashokclass`
497: #  (ruled by Fable 5.1, GPT-6 Astra and Grok 4.7, regress/artifacts/adj_20261016/RULINGS_C_records.md F2).
498: #  gen_dashboard.py maps four glyphs; 1,397 entries carried a `d` outside them ("OK" 439 of them) and all that reached a
499: #  cell rendered as SEAT FAILURES.  The renderer now shows them as one LEGACY class; this section keeps that class from
500: #  growing.  Grandfathering is against the EXISTING ENTRIES (a frozen baseline), not a date, because a date-only
501: #  cutoff cannot stop a back-dated or undated addition -- check_entry_domain.py's docstring says how.  HARD: it is
502: #  forward-only by construction, so it cannot retro-fail anything that was already there.
503: say ""; say "Q2. a new ledger answer carries a d the dashboard classifies"
504: CED=$_HERE/pipeline/check_entry_domain.py
505: if [ ! -f "$CED" ]; then
506: \tbad "check_entry_domain.py MISSING -- the entry-domain check proved nothing"
507: else
508: \t_ced=$(python "$CED" 2>&1); _cedrc=$?
509: \tif [ $_cedrc -eq 0 ]; then
510: \t\tgood "$(printf \'%s\\n\' "$_ced" | head -1)"
511: \telif [ $_cedrc -eq 1 ]; then
512: \t\tbad "a NEW ledger answer carries a d outside the four glyphs:"
513: \t\tprintf \'%s\\n\' "$_ced" | sed \'s/^/          /\'
514: \telse
515: \t\tbad "check_entry_domain.py could not run (rc $_cedrc): $(printf \'%s\\n\' "$_ced" | head -1)"
516: \tfi
517: fi
518: 
519: #  ---- R ---------------------------------------------------------------------------
520: #  A COMMITTED DETECTOR THAT NO GATE RUNS DEFENDS NOTHING BETWEEN BATTERIES.
521: #
regress/artifacts/dashokclass_20261016/write_baseline.py
1: #!/usr/bin/env python3
2: """write_baseline.py <ledger.json> <out baseline.json> -- ONE-TIME: freeze the off-domain ANSWER entries present when
3: check_entry_domain.py landed (2026-10-16, ledger `dashokclass`), as [row, phase, seat, date, d, count] rows sorted for a
4: stable diff.  check_entry_domain.py only READS the baseline; re-running this to make a new entry pass would launder it,
5: which is why it lives in the round\'s artifacts directory and not beside the checker."""
6: import collections, io, json, os, sys
7: 
8: HERE = os.path.dirname(os.path.abspath(__file__))
9: src, dst = sys.argv[1], sys.argv[2]
10: sys.path.insert(0, os.environ.get("GXPIPELINE") or os.path.join(HERE, os.pardir, os.pardir, os.pardir, "tools", "pipeline"))
11: import check_entry_domain as ced  # noqa: E402  (the checker's own off_domain_answers: one definition)
12: 
13: L = json.load(io.open(src, encoding="utf-8"))
14: c = collections.Counter(ced.off_domain_answers(L))
15: rows = sorted([list(k) + [n] for k, n in c.items()], key=lambda r: [str(x) for x in r])
16: #  one tuple per line, so a rewritten entry is a one-line diff
17: io.open(dst, "w", encoding="utf-8", newline="\\n").write("[\\n" + ",\\n".join(json.dumps(r, ensure_ascii=False) for r in rows) + "\\n]\\n")
18: print("baseline: %d off-domain answer entries in %d tuples -> %s" % (sum(c.values()), len(c), dst))

