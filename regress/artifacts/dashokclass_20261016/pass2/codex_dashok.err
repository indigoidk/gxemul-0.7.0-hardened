42: T = tempfile.mkdtemp()
43: res = []
44: 
45: 
46: def say(label, ok, detail=""):
47:     res.append(ok)
48:     print("%-4s %-70s %s  %s" % (label.split()[0], label[len(label.split()[0]) + 1:], "ok" if ok else "NO", detail))
49: 
50: 
51: def wjson(name, obj):
52:     p = os.path.join(T, name)
53:     io.open(p, "w", encoding="utf-8").write(json.dumps(obj, ensure_ascii=False))
