   343	def with_entries(entries, ledger=None):
   344	    L = copy.deepcopy(ledger or L0)
   345	    for row, e in entries:
   346	        for r in L["rows"]:
   347	            if r["id"] == row:
   348	                r.setdefault("entries", []).append(e)
   349	    return wjson("l_%d.json" % len(res), L)
