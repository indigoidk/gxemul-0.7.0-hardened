    % (rc, nb, N_OFF, len(out), "ok" if f11 == s11 else repr(f11[:90]), "ok" if hint else repr(out[-1][:90] if out else "")))
# C12: the cutoff test isolated -- each fixture entry IS in its fixture baseline, so only the date can refuse it
