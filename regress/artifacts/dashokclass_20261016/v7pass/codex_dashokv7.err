import ast, builtins, collections, contextlib, copy, hashlib, html, io, json, os, pathlib, re, shutil, sys, traceback
root=pathlib.Path('C:/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC')
art=root/'regress/artifacts/dashokclass_20261016'
control=(art/'run_controls_v7.py').read_text(encoding='utf-8')
checker_path=str(art/'staged_v5/tools/pipeline/check_entry_domain.py')
render_path=str(art/'staged_v5/tools/pipeline/gen_dashboard.py')
base_path=str(art/'staged_v5/tools/pipeline/entry_domain_baseline.json')
original=pathlib.Path(checker_path).read_text(encoding='utf-8')
sys.path.insert(0,str(root/'tools/pipeline'))
import stage_tokens
real_open, real_io_open, real_copy, real_makedirs = builtins.open, io.open, shutil.copy, os.makedirs
files={}
def key(p): return os.path.normcase(os.path.normpath(str(p)))
class VirtualBytes(io.BytesIO):
 def __init__(self,p,data=b''): super().__init__(data); self.p=key(p)
 def close(self):
  if not self.closed: files[self.p]=self.getvalue()
  super().close()
class VirtualText(io.StringIO):
 def __init__(self,p,data=''): super().__init__(data); self.p=key(p)
 def write(self,s):
  n=super().write(s); files[self.p]=self.getvalue().encode('utf-8'); return n
 def close(self):
  if not self.closed: files[self.p]=self.getvalue().encode('utf-8')
  super().close()
def memopen(p,mode='r',*args,**kw):
 k=key(p)
 if any(c in mode for c in 'wax+'):
  if not str(p).startswith('VIRTUAL:'): raise RuntimeError('write outside memory refused: '+str(p))
  return VirtualBytes(p) if 'b' in mode else VirtualText(p)
 if k in files:
  return io.BytesIO(files[k]) if 'b' in mode else io.StringIO(files[k].decode(kw.get('encoding') or 'utf-8').replace('\\r\\n','\\n'))
 return real_open(p,mode,*args,**kw)
def memcopy(src,dst):
 if not os.path.splitext(str(dst))[1]: dst=os.path.join(dst,os.path.basename(src))
 files[key(dst)]=memopen(src,'rb').read(); return dst
def memmkdir(p,*args,**kw):
 if not str(p).startswith('VIRTUAL:'): raise RuntimeError('mkdir refused')
def runchecker(ledger_path,baseline_path=None,checker=None):
 path=checker or env['DEFAULT_CHECKER']
 previous=dict(os.environ)
 os.environ['GXLEDGER']=ledger_path
 os.environ.pop('GXDOMAIN_BASELINE',None)
 if baseline_path is not None: os.environ['GXDOMAIN_BASELINE']=baseline_path
 buf=io.BytesIO(); out=io.TextIOWrapper(buf,encoding='cp1252',errors='strict')
 saved_path=list(sys.path)
 try:
  with contextlib.redirect_stdout(out),contextlib.redirect_stderr(out):
   scope={'__name__':'review_checker','__file__':path}
   exec(compile(memopen(path,encoding='utf-8').read(),path,'exec'),scope)
   rc=scope['main']()
 except BaseException:
  rc=1
  with contextlib.redirect_stdout(out),contextlib.redirect_stderr(out): traceback.print_exc()
 finally:
  out.flush(); data=buf.getvalue(); out.detach()
  os.environ.clear(); os.environ.update(previous); sys.path[:]=saved_path
 return rc,data.decode('cp1252','replace').strip().splitlines()
tree=ast.parse(control)
nodes=[]
for node in tree.body:
 if 273<=node.lineno<=591 or 740<=node.lineno<=820:
  if isinstance(node,ast.FunctionDef) and node.name in ('run_checker','say'): continue
  if node.lineno==294:
   node=ast.parse(\"T = 'VIRTUAL:/tmp'\").body[0]
  nodes.append(node)
code=compile(ast.fix_missing_locations(ast.Module(body=nodes,type_ignores=[])),'controls_component','exec')
os.environ['CTL_CHECKER']=checker_path
os.environ['CTL_RENDER']=render_path
os.environ['CTL_PRECOMMIT']=str(art/'staged_v5/tools/precommit_check.sh')
def one(src):
 global env
 files.clear(); files[key(checker_path)]=src.encode('utf-8')
 env={'__file__':str(art/'run_controls_v7.py'),'run_checker':runchecker}
 def say(label,ok,detail=''):
  env['res'].append(ok); reports.append((label.split()[0],bool(ok),detail))
 reports=[]; env['say']=say
 builtins.open=io.open=memopen; shutil.copy=memcopy; os.makedirs=memmkdir
 try: exec(code,env)
 finally: builtins.open=real_open; io.open=real_io_open; shutil.copy=real_copy; os.makedirs=real_makedirs
 return reports
mut_tree=ast.parse((art/'run_mutants_v7.py').read_text(encoding='utf-8'))
m_env={}
for n in mut_tree.body:
 if isinstance(n,ast.Assign) and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('SHA','LOAD','BADMSG','MUTANTS'):
  exec(compile(ast.Module(body=[n],type_ignores=[]),'mutants_data','exec'),m_env)
selected=set(['d_rowlist','d_entrylist','d_rowidnone','d_isoyear3','d_isomonth3','d_cutoff18','d_cutgt','d_nodate','d_lexdate','d_dupplus1','d_nomd5','d_pinoverride','d_blank','d_lastwins','d_ledger1','d_crlfpin','d_noreconf','d_nonote2'])
rows=one(original)
print(json.dumps({'case':'staged','passed':sum(x[1] for x in rows),'total':len(rows),'red':[x[0] for x in rows if not x[1]]}))
for name,fkey,edits,named in m_env['MUTANTS']:
 if name not in selected: continue
 src=original
 for find,repl in edits:
  if src.count(find)"'!=1: raise RuntimeError('"'find mismatch '+name)
  src=src.replace(find,repl)
 rows=one(src); reds={x[0] for x in rows if not x[1]}
 print(json.dumps({'case':name,'passed':sum(x[1] for x in rows),'total':len(rows),'named':named,'named_red':all(n in reds for n in named),'red':sorted(reds)}))

