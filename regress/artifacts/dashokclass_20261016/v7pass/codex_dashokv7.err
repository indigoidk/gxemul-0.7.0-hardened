304: T = tempfile.mkdtemp()
305: env0 = dict(os.environ, PYTHONIOENCODING="utf-8", **{ENV[k]: v for k, v in FILES.items()})
306: 
307: 
308: def controls(env):
309:     r = subprocess.run([sys.executable, CONTROLS], capture_output=True, text=True, encoding="utf-8", env=env)
310:     tally = ([l for l in r.stdout.splitlines() if l.startswith("DASHOKCLASS CONTROLS:")] or ["x: (no tally)"])[0].split(":")[1].split()[0]
311:     #  one space can precede the status: a label longer than its padded column leaves no padding
312:     red = sorted({l.split()[0] for l in r.stdout.splitlines() if re.search(r"\\sNO\\s{2}", l)})
313:     return r, tally, red, "DASHOKCLASS_CONTROLS_DONE" in r.stdout
314: 
315: 
316: print("# dashokclass kill table (v7) -- controls %s, %d at a time" % (os.path.basename(CONTROLS), JOBS))
317: for k in ("checker", "render", "precommit"):
318:     print("#   %-9s %s" % (k, FILES[k]))
319: base, btally, bred, bdone = controls(env0)
320: print("BASE          %s" % btally)
321: den = btally.split("/")[-1]
322: if base.returncode != 0 or not bdone or bred:
323:     print("APPARATUS FAIL: the base run is not clean (red: %s)" % (" ".join(bred) or "none"))
324:     shutil.rmtree(T, ignore_errors=True); sys.exit(9)
325: def one(m):
326:     name, fkey, edits, named = m
327:     src = io.open(FILES[fkey], encoding="utf-8", newline="").read()
328:     missing = [f for f, _ in edits if src.count(f) != 1]
329:     if missing:
330:         return False, "%-15s MUTANT TEXT NOT FOUND (%s)" % (name, missing[0][:60])
331:     for f, r in edits:
332:         src = src.replace(f, r)
333:     d = os.path.join(T, name)
334:     os.makedirs(d)
335:     mp = os.path.join(d, os.path.basename(FILES[fkey]))
336:     io.open(mp, "w", encoding="utf-8", newline="").write(src)
337:     if fkey == "checker":      # the baseline travels with the checker
338:         shutil.copy(os.path.join(os.path.dirname(FILES["checker"]), "entry_domain_baseline.json"), d)
339:     r, tally, red, done = controls(dict(env0, **{ENV[fkey]: mp}))
340:     if not done or tally.split("/")[-1] != den:
341:         return False, "%-15s %-7s INCOMPLETE run (no sentinel, or a denominator other than %s)" % (name, tally, den)
342:     if isinstance(named, str):
343:         good = not red
344:         verdict = "escapes (as recorded)" if good else "CAUGHT by: %s (unexpected)" % " ".join(red)
345:     else:
346:         good = all(n in red for n in named)
347:         verdict = ("killed by: " + " ".join(red)) if good else "NOT KILLED as named (red: %s)" % (" ".join(red) or "none")
348:     return good, "%-15s %-7s %-66s [%s]" % (name, tally, verdict, named if isinstance(named, str) else " ".join(named))
349: 
350: 
351: with concurrent.futures.ThreadPoolExecutor(max_workers=JOBS) as pool:
352:     results = list(pool.map(one, MUTANTS))
353: ok = 0
354: for good, line in results:
355:     ok += good
356:     print(line)
357: shutil.rmtree(T, ignore_errors=True)
358: print("KILL TABLE: %d/%d as recorded" % (ok, len(MUTANTS)))
359: print("DASHOKCLASS_MUTANTS_DONE")
360: sys.exit(0 if ok == len(MUTANTS) else 1)

