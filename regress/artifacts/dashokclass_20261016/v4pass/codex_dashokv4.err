import os, sys, io, json, pathlib, contextlib, builtins, shutil, tempfile, subprocess, traceback, copy
from unittest.mock import patch
ROOT='C:/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC'
ART=ROOT+'/regress/artifacts/dashokclass_20261016'
STAGE=ART+'/staged_v4/tools'
CONTROL=ART+'/run_controls_v4.py'
real_open=builtins.open
real_ioopen=io.open
real_run=subprocess.run
real_exists=os.path.exists
real_size=os.path.getsize
src_control=pathlib.Path(CONTROL).read_text(encoding='utf-8')
original={x:pathlib.Path(STAGE+'/'+p).read_text(encoding='utf-8') for x,p in [('checker','pipeline/check_entry_domain.py'),('render','pipeline/gen_dashboard.py'),('precommit','precommit_check.sh')]}
paths={x:STAGE+'/'+p for x,p in [('checker','pipeline/check_entry_domain.py'),('render','pipeline/gen_dashboard.py'),('precommit','precommit_check.sh')]}
sys.path.insert(0,ROOT+'/tools/pipeline')
import stage_tokens
V={}
def key(p): return os.path.normcase(os.path.abspath(p))
class VText(io.StringIO):
    def __init__(self,p,mode,encoding,initial):
        super().__init__(initial)
        self.p=p; self.mode=mode; self.enc=encoding or 'cp1252'
    def write(self,s):
        n=super().write(s); V[key(self.p)]=self.getvalue().encode(self.enc); return n
class VBytes(io.BytesIO):
    def __init__(self,p,mode,initial):
        super().__init__(initial); self.p=p
    def write(self,s):
        n=super().write(s); V[key(self.p)]=self.getvalue(); return n
def vopen(p,mode='r',encoding=None,*a,**kw):
    if not isinstance(p,(str,bytes,os.PathLike)): return real_open(p,mode,encoding if isinstance(encoding,int) else -1,*a,**kw)
    k=key(p)
    if any(c in mode for c in 'wax+'):
        V[k]=b''
        return VBytes(p,mode,b'') if 'b' in mode else VText(p,mode,encoding,'')
    if k in V:
        return io.BytesIO(V[k]) if 'b' in mode else io.StringIO(V[k].decode(encoding or 'cp1252'))
    return real_open(p,mode,*a,encoding=encoding,**kw)
def vcopy(src,dst,*a,**kw):
    if key(dst) in DIRS: dst=os.path.join(dst,os.path.basename(src))
    with vopen(src,'rb') as f: V[key(dst)]=f.read()
    return dst
DIRS=set()
def vmakedir(p,*a,**kw): DIRS.add(key(p))
def run_python(argv,env,text_mode=False,encoding=None):
    b=io.BytesIO(); out=io.TextIOWrapper(b,encoding=encoding or 'cp1252',errors='strict',write_through=True)
    errb=io.BytesIO(); err=io.TextIOWrapper(errb,encoding=encoding or 'cp1252',errors='strict',write_through=True)
    code=vopen(argv[1],encoding='utf-8').read()
    g={'__name__':'__main__','__file__':argv[1]}
    rc=0
    with patch.dict(os.environ,env,clear=True),patch.object(sys,'argv',argv[1:]),contextlib.redirect_stdout(out),contextlib.redirect_stderr(err):
        try: exec(compile(code,argv[1],'exec'),g)
        except SystemExit as ex: rc=ex.code or 0
        except BaseException: traceback.print_exc(); rc=1
    out.flush(); err.flush(); ob=b.getvalue(); eb=errb.getvalue()
    return subprocess.CompletedProcess(argv,rc,ob.decode(encoding or 'utf-8') if text_mode else ob,eb.decode(encoding or 'utf-8') if text_mode else eb)
def shell_quote(x): return \"'\"+x.replace(\"'\",\"'\\\\''\")+\"'\"
def bash_run(argv,env):
    block=vopen(argv[1],encoding='utf-8').read()
    checker=argv[2]+'/pipeline/check_entry_domain.py'
    exists=key(checker) in V
    block=block.replace('[ "'! -f "$CED" ]'"','[ 0 = 1 ]' if exists else '[ 1 = 1 ]')
    # Keep shell branching/printing/counters; emulate only checker process and virtual file existence.
    func='python () {\\n'
    if exists:
        for keep_l,keep_b in [(True,True),(True,False),(False,True),(False,False)]:
            en=dict(env)
            if not keep_l: en.pop('GXLEDGER',None)
            if not keep_b: en.pop('GXDOMAIN_BASELINE',None)
            r=run_python([sys.executable,checker],en)
            condl='-n' if keep_l and 'GXLEDGER' in env else '-z'
            condb='-n' if keep_b and 'GXDOMAIN_BASELINE' in env else '-z'
            data=r.stdout+r.stderr
            esc=''.join('\\\\x%02x'%b for b in data)
            func+='if builtin [ '+condl+' \"\\"'${GXLEDGER:-}" ] && builtin [ '"'+condb+' \"\\"'${GXDOMAIN_BASELINE:-}" ]; then'"\\n'
            func+=\"printf '%b' \"+shell_quote(esc)+\"\\nreturn \"+str(r.returncode)+\"\\nfi\\n\"
    func+='return 127\\n}\\nenv () ( while builtin [ \""'$1" = "-u" ]; do unset "$2"; shift 2; done; "$@" )'"\\n'
    func=func.replace('\\\\"'$'"','"'$'"')
    r = real_run([argv[0],'-s','--',argv[2]],input=(func+block).encode('utf-8'),capture_output=True,env=env)
    if not r.stdout: print('BASHERR',r.returncode,repr(r.stderr),file=sys.__stderr__)
    return r
def vrun(argv,**kw):
    if os.path.basename(argv[0]).lower()=='bash.exe': return bash_run(argv,kw.get('env',dict(os.environ)))
    return run_python(argv,kw.get('env',dict(os.environ)),kw.get('text',False),kw.get('encoding'))
def execute(label,edit=None):
    V.clear();DIRS.clear()
    if edit:
        target,old,new=edit
        assert original[target].count(old)==1,(label,original[target].count(old))
        V[key(paths[target])]=original[target].replace(old,new).encode('utf-8')
    g={'__name__':'__main__','__file__':CONTROL}
    cap=io.StringIO()
    env=dict(os.environ,CTL_CHECKER=paths['checker'],CTL_RENDER=paths['render'],CTL_PRECOMMIT=paths['precommit'])
    with patch.dict(os.environ,env,clear=True),patch('builtins.open',vopen),patch('io.open',vopen),patch('tempfile.mkdtemp',lambda *a,**k:'C:/__dash_virtual__'),patch('shutil.copy',vcopy),patch('shutil.rmtree',lambda *a,**k:None),patch('os.makedirs',vmakedir),patch('os.path.exists',lambda p:key(p) in V or key(p) in DIRS or real_exists(p)),patch('os.path.getsize',lambda p:len(V[key(p)]) if key(p) in V else real_size(p)),patch('subprocess.run',vrun),contextlib.redirect_stdout(cap):
        try: exec(compile(src_control,CONTROL,'exec'),g)
        except SystemExit: pass
        except BaseException: traceback.print_exc()
    txt=cap.getvalue()
    print(label,json.dumps({'total':len(g.get('res',[])),'passed':sum(g.get('res',[])),'red':[l for l in txt.splitlines() if ' NO  ' in l],'tail':txt.splitlines()[-2:]},ensure_ascii=True))
    return g,txt

src_control=src_control.split('# ------------------------------------------------------------------ the wiring:')[0]
execute('render_null_tip',('render','if cls == LEGACY:','if cls == LEGACY and d is not None:'))
execute('render_false_approval',('render','{n[LEGACY]} legacy','{n[LEGACY]} approved'))
execute('render_invisible',('render','font-style:italic; font-size:11px;','font-style:italic; font-size:0;'))

