350:
351:void pcctwo_interrupt_common(struct interrupt *interrupt, int assert)
352:{
353:	struct pcc2_data *d = (struct pcc2_data *) interrupt->extra;
354:
355:	switch (interrupt->line) {
356:
357:	case PCC2V_SCSI:
358:		if (assert)
359:			d->pcctwo_reg[PCCTWO_SCSIICR] |= PCC2_IRQ_INT;
360:		else
361:			d->pcctwo_reg[PCCTWO_SCSIICR] &= ~PCC2_IRQ_INT;
362:		break;
363:
364:	case PCC2V_SCC_TX:
365:		if (assert)
366:			d->pcctwo_reg[PCCTWO_SCCTX] |= PCC2_IRQ_INT;
367:		else
368:			d->pcctwo_reg[PCCTWO_SCCTX] &= ~PCC2_IRQ_INT;
369:		break;
370:
371:	case PCC2V_SCC_RX:
372:		if (assert)
373:			d->pcctwo_reg[PCCTWO_SCCRX] |= PCC2_IRQ_INT;
374:		else
375:			d->pcctwo_reg[PCCTWO_SCCRX] &= ~PCC2_IRQ_INT;
376:		break;
377:
378:	default:fatal("[ pcctwo_interrupt_common: TODO: line = %i ]\n",
379:		    interrupt->line);
380:		exit(1);
381:	}
382:
383:	reassert_interrupts(d);
384:}
385:
386:
387:static void pcctwo_interrupt_assert(struct interrupt *interrupt)
388:{
389:	pcctwo_interrupt_common(interrupt, 1);
390:}
391:static void pcctwo_interrupt_deassert(struct interrupt *interrupt)
392:{
393:	pcctwo_interrupt_common(interrupt, 0);
394:}
