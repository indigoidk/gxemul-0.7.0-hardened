986:
987:		bool any_cpu_running = false;
988:		bool idling = true;
989:		for (int i = 0; i < emul->n_machines; ++i) {
990:			for (int j = 0; j < emul->machines[i]->ncpus; ++j) {
991:				if (emul->machines[i]->cpus[j]->running) {
992:					any_cpu_running = true;
993:					if (!emul->machines[i]->cpus[j]->wants_to_idle)
994:						idling = false;
995:				}
