227:/*
228: *  alpha_print_imm16_disp():
229: *
230: *  Used internally by alpha_cpu_disassemble_instr().
231: */
232:static void alpha_print_imm16_disp(int imm, int rb)
233:{
234:	imm = (int16_t)imm;
235:
236:	if (imm < 0) {
237:		debug("-");
238:		imm = -imm;
239:	}
240:	if (imm <= 256)
241:		debug("%i", imm);
242:	else
243:		debug("0x%x", imm);
244:	if (rb != ALPHA_ZERO)
245:		debug("(%s)", alpha_regname[rb]);
246:}
247:
248:
249:/*
250: *  alpha_cpu_disassemble_instr():
251: *
252: *  Convert an instruction word into human readable format, for instruction
253: *  tracing.
254: *              
255: *  If running is 1, cpu->pc should be the address of the instruction.
256: *
257: *  If running is 0, things that depend on the runtime environment (eg.
258: *  register contents) will not be shown, and addr will be used instead of
259: *  cpu->pc for relative addresses.
260: */                     
261:int alpha_cpu_disassemble_instr(struct cpu *cpu, unsigned char *ib,
262:        int running, uint64_t dumpaddr)
263:{
264:	uint32_t iw;
265:	uint64_t offset, tmp;
266:	int opcode, ra, rb, func, rc, imm, floating, rbrc = 0, indir = 0;
267:	const char *symbol, *mnem = NULL;
268:	char palcode_name[30];
269:
270:	if (running)
271:		dumpaddr = cpu->pc;
272:
273:	symbol = get_symbol_name(&cpu->machine->symbol_context,
274:	    dumpaddr, &offset);
275:	if (symbol != NULL && offset == 0)
276:		debug("<%s>\n", symbol);
277:
278:	if (cpu->machine->ncpus > 1 && running)
279:		debug("cpu%i:\t", cpu->cpu_id);
280:
281:	debug("%016" PRIx64":  ", (uint64_t) dumpaddr);
282:
283:	iw = READ_WORD_LE(ib);
284:	debug("%08x", (int)iw);
285:
286:	cpu_print_pc_indicator_in_disassembly(cpu, running, dumpaddr);
287:
288:	opcode = iw >> 26;
289:	ra = (iw >> 21) & 31;
290:	rb = (iw >> 16) & 31;
291:	func = (iw >> 5) & 0x7ff;
292:	rc = iw & 31;
293:	imm = iw & 0xffff;
294:
295:	switch (opcode) {
296:	case 0x00:
297:		alpha_palcode_name(iw & 0x3ffffff, palcode_name,
298:		    sizeof(palcode_name));
299:		debug("call_pal %s\n", palcode_name);
300:		break;
301:	case 0x08:
302:	case 0x09:
303:		debug("lda%s\t%s,", opcode == 9? "h" : "", alpha_regname[ra]);
304:		alpha_print_imm16_disp(imm, rb);
305:		debug("\n");
306:		break;
307:	case 0x0a:
308:	case 0x0b:
309:	case 0x0c:
310:	case 0x0d:
311:	case 0x0e:
312:	case 0x0f:
313:	case 0x20:
314:	case 0x21:
315:	case 0x22:
316:	case 0x23:
317:	case 0x24:
318:	case 0x25:
319:	case 0x26:
320:	case 0x27:
321:	case 0x28:
322:	case 0x29:
323:	case 0x2a:
324:	case 0x2b:
325:	case 0x2c:
326:	case 0x2d:
327:	case 0x2e:
328:	case 0x2f:
329:		floating = 0;
330:		switch (opcode) {
331:		case 0x0a: mnem = "ldbu"; break;
332:		case 0x0b: mnem = "ldq_u"; break;
333:		case 0x0c: mnem = "ldwu"; break;
334:		case 0x0d: mnem = "stw"; break;
335:		case 0x0e: mnem = "stb"; break;
336:		case 0x0f: mnem = "stq_u"; break;
337:		case 0x20: mnem = "ldf"; floating = 1; break;
338:		case 0x21: mnem = "ldg"; floating = 1; break;
339:		case 0x22: mnem = "lds"; floating = 1; break;
340:		case 0x23: mnem = "ldt"; floating = 1; break;
341:		case 0x24: mnem = "stf"; floating = 1; break;
342:		case 0x25: mnem = "stg"; floating = 1; break;
343:		case 0x26: mnem = "sts"; floating = 1; break;
344:		case 0x27: mnem = "stt"; floating = 1; break;
345:		case 0x28: mnem = "ldl"; break;
346:		case 0x29: mnem = "ldq"; break;
347:		case 0x2a: mnem = "ldl_l"; break;
348:		case 0x2b: mnem = "ldq_l"; break;
349:		case 0x2c: mnem = "stl"; break;
350:		case 0x2d: mnem = "stq"; break;
351:		case 0x2e: mnem = "stl_c"; break;
352:		case 0x2f: mnem = "stq_c"; break;
353:		}
354:		if (opcode == 0x0b && ra == ALPHA_ZERO) {
355:			debug("unop");
356:		} else {
357:			debug("%s\t", mnem);
358:			if (floating)
359:				debug("f%i,", ra);
360:			else
361:				debug("%s,", alpha_regname[ra]);
362:			alpha_print_imm16_disp(imm, rb);
363:		}
364:		debug("\n");
365:		break;
366:	case 0x10:
367:		switch (func & 0x7f) {
368:		case 0x00: mnem = "addl"; break;
369:		case 0x02: mnem = "s4addl"; break;
370:		case 0x09: mnem = "subl"; break;
371:		case 0x0b: mnem = "s4subl"; break;
372:		case 0x0f: mnem = "cmpbge"; break;
373:		case 0x12: mnem = "s8addl"; break;
374:		case 0x1b: mnem = "s8subl"; break;
375:		case 0x1d: mnem = "cmpult"; break;
376:		case 0x20: mnem = "addq"; break;
377:		case 0x22: mnem = "s4addq"; break;
378:		case 0x29: mnem = "subq"; break;
379:		case 0x2b: mnem = "s4subq"; break;
380:		case 0x2d: mnem = "cmpeq"; break;
381:		case 0x32: mnem = "s8addq"; break;
382:		case 0x3b: mnem = "s8subq"; break;
383:		case 0x3d: mnem = "cmpule"; break;
384:		case 0x40: mnem = "addl/v"; break;
385:		case 0x49: mnem = "subl/v"; break;
386:		case 0x4d: mnem = "cmplt"; break;
387:		case 0x60: mnem = "addq/v"; break;
388:		case 0x69: mnem = "subq/v"; break;
389:		case 0x6d: mnem = "cmple"; break;
390:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
391:			    opcode, func);
392:		}
393:		if (mnem == NULL)
394:			break;
395:		if (func & 0x80)
396:			debug("%s\t%s,0x%x,%s\n", mnem,
397:			    alpha_regname[ra], (rb << 3) + (func >> 8),
398:			    alpha_regname[rc]);
399:		else
400:			debug("%s\t%s,%s,%s\n", mnem, alpha_regname[ra],
401:			    alpha_regname[rb], alpha_regname[rc]);
402:		break;
403:	case 0x11:
404:		switch (func & 0x7f) {
405:		case 0x000: mnem = "and"; break;
406:		case 0x008: mnem = "andnot"; break;
407:		case 0x014: mnem = "cmovlbs"; break;
408:		case 0x016: mnem = "cmovlbc"; break;
409:		case 0x020: mnem = "or"; break;
410:		case 0x024: mnem = "cmoveq"; break;
411:		case 0x026: mnem = "cmovne"; break;
412:		case 0x028: mnem = "ornot"; break;
413:		case 0x040: mnem = "xor"; break;
414:		case 0x044: mnem = "cmovlt"; break;
415:		case 0x046: mnem = "cmovge"; break;
416:		case 0x048: mnem = "eqv"; break;
417:		case 0x061: mnem = "amask"; break;
418:		case 0x064: mnem = "cmovle"; break;
419:		case 0x066: mnem = "cmovgt"; break;
420:		case 0x06c: mnem = "implver"; break;
421:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
422:			    opcode, func);
423:		}
424:		if (mnem == NULL)
425:			break;
426:		/*  Special cases: "nop" etc:  */
427:		if (func == 0x020 && rc == ALPHA_ZERO)
428:			debug("nop\n");
429:		else if (func == 0x020 && (ra == ALPHA_ZERO
430:		    || rb == ALPHA_ZERO)) {
431:			if (ra == ALPHA_ZERO && rb == ALPHA_ZERO)
432:				debug("clr\t%s\n", alpha_regname[rc]);
433:			else if (ra == ALPHA_ZERO)
434:				debug("mov\t%s,%s\n", alpha_regname[rb],
435:				    alpha_regname[rc]);
436:			else
437:				debug("mov\t%s,%s\n", alpha_regname[ra],
438:				    alpha_regname[rc]);
439:		} else if (func == 0x1ec) {
440:			/*  implver  */
441:			debug("%s\t%s\n", mnem, alpha_regname[rc]);
442:		} else if (func & 0x80)
443:			debug("%s\t%s,0x%x,%s\n", mnem,
444:			    alpha_regname[ra], (rb << 3) + (func >> 8),
445:			    alpha_regname[rc]);
446:		else
447:			debug("%s\t%s,%s,%s\n", mnem, alpha_regname[ra],
448:			    alpha_regname[rb], alpha_regname[rc]);
449:		break;
450:	case 0x12:
451:		switch (func & 0x7f) {
452:		case 0x02: mnem = "mskbl"; break;
453:		case 0x06: mnem = "extbl"; break;
454:		case 0x0b: mnem = "insbl"; break;
455:		case 0x12: mnem = "mskwl"; break;
456:		case 0x16: mnem = "extwl"; break;
457:		case 0x1b: mnem = "inswl"; break;
458:		case 0x22: mnem = "mskll"; break;
459:		case 0x26: mnem = "extll"; break;
460:		case 0x2b: mnem = "insll"; break;
461:		case 0x30: mnem = "zap"; break;
462:		case 0x31: mnem = "zapnot"; break;
463:		case 0x32: mnem = "mskql"; break;
464:		case 0x34: mnem = "srl"; break;
465:		case 0x36: mnem = "extql"; break;
466:		case 0x39: mnem = "sll"; break;
467:		case 0x3b: mnem = "insql"; break;
468:		case 0x3c: mnem = "sra"; break;
469:		case 0x52: mnem = "mskwh"; break;
470:		case 0x57: mnem = "inswh"; break;
471:		case 0x5a: mnem = "extwh"; break;
472:		case 0x62: mnem = "msklh"; break;
473:		case 0x67: mnem = "inslh"; break;
474:		case 0x6a: mnem = "extlh"; break;
475:		case 0x72: mnem = "mskqh"; break;
476:		case 0x77: mnem = "insqh"; break;
477:		case 0x7a: mnem = "extqh"; break;
478:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
479:			    opcode, func);
480:		}
481:		if (mnem == NULL)
482:			break;
483:		if (func & 0x80)
484:			debug("%s\t%s,0x%x,%s\n", mnem,
485:			    alpha_regname[ra], (rb << 3) + (func >> 8),
486:			    alpha_regname[rc]);
487:		else
488:			debug("%s\t%s,%s,%s\n", mnem, alpha_regname[ra],
489:			    alpha_regname[rb], alpha_regname[rc]);
490:		break;
491:	case 0x13:
492:		switch (func & 0x7f) {
493:		case 0x00: mnem = "mull"; break;
494:		case 0x20: mnem = "mulq"; break;
495:		case 0x30: mnem = "umulh"; break;
496:		case 0x40: mnem = "mull/v"; break;
497:		case 0x60: mnem = "mulq/v"; break;
498:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
499:			    opcode, func);
500:		}
501:		if (mnem == NULL)
502:			break;
503:		if (func & 0x80)
504:			debug("%s\t%s,0x%x,%s\n", mnem,
505:			    alpha_regname[ra], (rb << 3) + (func >> 8),
506:			    alpha_regname[rc]);
507:		else
508:			debug("%s\t%s,%s,%s\n", mnem, alpha_regname[ra],
509:			    alpha_regname[rb], alpha_regname[rc]);
510:		break;
511:	case 0x16:
512:		switch (func & 0x7ff) {
513:		case 0x02f: mnem = "cvttq/c"; rbrc = 1; break;
514:		case 0x080: mnem = "adds"; break;
515:		case 0x081: mnem = "subs"; break;
516:		case 0x082: mnem = "muls"; break;
517:		case 0x083: mnem = "XXXx083"; break;
518:		case 0x0a0: mnem = "addt"; break;
519:		case 0x0a1: mnem = "subt"; break;
520:		case 0x0a2: mnem = "mult"; break;
521:		case 0x0a3: mnem = "divt"; break;
522:		case 0x0a5: mnem = "cmpteq"; break;
523:		case 0x0a6: mnem = "cmptlt"; break;
524:		case 0x0a7: mnem = "cmptle"; break;
525:		case 0x0be: mnem = "cvtqt"; rbrc = 1; break;
526:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
527:			    opcode, func);
528:		}
529:		if (mnem == NULL)
530:			break;
531:		if (rbrc)
532:			debug("%s\tf%i,f%i\n", mnem, rb, rc);
533:		else
534:			debug("%s\tf%i,f%i,f%i\n", mnem, ra, rb, rc);
535:		break;
536:	case 0x17:
537:		switch (func & 0x7ff) {
538:		case 0x020: mnem = "fabs"; rbrc = 1; break;
539:		case 0x021: mnem = "fneg"; rbrc = 1; break;
540:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
541:			    opcode, func);
542:		}
543:		if (mnem == NULL)
544:			break;
545:		if ((func & 0x7ff) == 0x020 && ra == 31 && rb == 31)
546:			debug("fclr\tf%i\n", rc);
547:		else if (rbrc)
548:			debug("%s\tf%i,f%i\n", mnem, rb, rc);
549:		else
550:			debug("%s\tf%i,f%i,f%i\n", mnem, ra, rb, rc);
551:		break;
552:	case 0x18:
553:		switch (iw & 0xffff) {
554:		case 0x0000: mnem = "trapb"; break;
555:		case 0x0400: mnem = "excb"; break;
556:		case 0x4000: mnem = "mb"; break;
557:		case 0x4400: mnem = "wmb"; break;
558:		case 0x8000: mnem = "fetch"; indir = 1; break;
559:		case 0xa000: mnem = "fetch_m"; indir = 1; break;
560:		case 0xc000: mnem = "rpcc"; break;
561:		case 0xe000: mnem = "rc"; break;
562:		case 0xe800: mnem = "ecb"; indir = 1; break;
563:		case 0xf000: mnem = "rs"; break;
564:		case 0xf800: mnem = "wh64"; indir = 1; break;
565:		default:debug("UNIMPLEMENTED opcode 0x%x func 0x%x\n",
566:			    opcode, func);
567:		}
568:		if (mnem == NULL)
569:			break;
570:		debug("%s", mnem);
571:		if ((iw & 0xffff) >= 0x8000) {
572:			debug("\t");
573:			if (indir)
574:				debug("(%s)", alpha_regname[rb]);
575:			else
576:				debug("%s", alpha_regname[ra]);
577:		}
578:		debug("\n");
579:		break;
580:	case 0x1a:
581:		tmp = iw & 0x3fff;
582:		if (tmp & 0x2000)
583:			tmp |= 0xffffffffffffc000ULL;
584:		tmp <<= 2;
585:		tmp += dumpaddr + sizeof(uint32_t);
586:		switch ((iw >> 14) & 3) {
587:		case 0:
588:		case 1:	if (((iw >> 14) & 3) == 0)
589:				debug("jmp");
590:			else
591:				debug("jsr");
592:			debug("\t%s,", alpha_regname[ra]);
593:			debug("(%s),", alpha_regname[rb]);
594:			debug("0x%" PRIx64, (uint64_t) tmp);
595:			symbol = get_symbol_name(&cpu->machine->symbol_context,
596:			    tmp, &offset);
597:			if (symbol != NULL)
598:				debug("\t<%s>", symbol);
599:			break;
600:		case 2:	debug("ret");
601:			break;
602:		default:fatal("unimpl JSR!");
603:		}
604:		debug("\n");
605:		break;
606:	case 0x30:
607:	case 0x34:
608:		tmp = iw & 0x1fffff;
609:		if (tmp & 0x100000)
610:			tmp |= 0xffffffffffe00000ULL;
611:		tmp <<= 2;
612:		tmp += dumpaddr + sizeof(uint32_t);
613:		debug("%s\t", opcode==0x30? "br" : "bsr");
614:		if (ra != ALPHA_ZERO)
615:			debug("%s,", alpha_regname[ra]);
616:		debug("0x%" PRIx64, (uint64_t) tmp);
617:		symbol = get_symbol_name(&cpu->machine->symbol_context,
618:		    tmp, &offset);
619:		if (symbol != NULL)
620:			debug("\t<%s>", symbol);
621:		debug("\n");
622:		break;
623:	case 0x31:
624:	case 0x35:
625:	case 0x38:
626:	case 0x39:
627:	case 0x3a:
628:	case 0x3b:
629:	case 0x3c:
630:	case 0x3d:
631:	case 0x3e:
632:	case 0x3f:
633:		floating = 0;
634:		switch (opcode) {
635:		case 0x31: mnem = "fbeq"; floating = 1; break;
636:		case 0x35: mnem = "fbne"; floating = 1; break;
637:		case 0x38: mnem = "blbc"; break;
638:		case 0x39: mnem = "beq"; break;
639:		case 0x3a: mnem = "blt"; break;
640:		case 0x3b: mnem = "ble"; break;
641:		case 0x3c: mnem = "blbs"; break;
642:		case 0x3d: mnem = "bne"; break;
643:		case 0x3e: mnem = "bge"; break;
644:		case 0x3f: mnem = "bgt"; break;
645:		}
646:		tmp = iw & 0x1fffff;
647:		if (tmp & 0x100000)
648:			tmp |= 0xffffffffffe00000ULL;
649:		tmp <<= 2;
650:		tmp += dumpaddr + sizeof(uint32_t);
651:		debug("%s\t", mnem);
652:		if (floating)
653:			debug("f%i,", ra);
654:		else
655:			debug("%s,", alpha_regname[ra]);
656:		debug("0x%" PRIx64, (uint64_t) tmp);
657:		symbol = get_symbol_name(&cpu->machine->symbol_context,
658:		    tmp, &offset);
659:		if (symbol != NULL)
660:			debug("\t<%s>", symbol);
661:		debug("\n");
662:		break;
663:	default:debug("UNIMPLEMENTED opcode 0x%x\n", opcode);
664:	}
665:
666:	return sizeof(uint32_t);
667:}
