405:/*
406: *  sh4_timer_tick():
407: *
408: *  This function is called SH4_PSEUDO_TIMER_HZ times per real-world second.
409: *  Its job is to update the SH4 timer counters, and if necessary, increase
410: *  the number of pending interrupts.
411: *
412: *  Also, RAM Refresh is also faked here.
413: */
414:static void sh4_timer_tick(struct timer *t, void *extra)
415:{
416:	struct sh4_data *d = (struct sh4_data *) extra;
417:	int i;
418:
419:	/*  Fake RAM refresh:  */
420:	d->bsc_rfcr ++;
421:	/*
422:	 *  #449: this called exit(1), and it is reached from a HOST TIMER CALLBACK rather
423:	 *  than from a guest store.  A guest write to RTCSR lands, the handler returns
424:	 *  normally, and the process dies here about nine milliseconds later.  MEASURED on
425:	 *  an unmodified -E landisk: the store alone leaves the host alive (which is why
426:	 *  every store-site probe in this tree was blind to it), and a bounded free run
427:	 *  after it kills the host with this diagnostic.  Two controls survive the same
428:	 *  free run -- RTCSR 0x00, and RTCSR_CMF, a DIFFERENT bit of the SAME byte.
429:	 *
430:	 *  *** FALL THROUGH.  DO NOT RETURN. ***  The rest of this function is the TMU
431:	 *  channel 0-2 update, which never reads bsc_rtcsr; the refresh work above is
432:	 *  already done.  Returning early would make every tick skip the TMU while a
433:	 *  DRAM-refresh enable bit stays set -- the #400 wall-clock freeze, newly gated on
434:	 *  an unrelated register.  A review seat named that before it was written, and
435:	 *  regress/diff_sh4_tmu.c now carries the row that catches it offline.
436:	 *
437:	 *  THE LATCH IS LOAD-BEARING HERE IN A WAY IT WAS NOT ON THE STORE-SITE ROUNDS.
438:	 *  This runs at SH4_PSEUDO_TIMER_HZ, and timer.c can burst several ticks inside one
439:	 *  signal; fatal() has no quiet_mode early-out, so an unlatched complaint is a
440:	 *  flood that -q cannot stop.  The key is (class, instance 0, enable bits), and
441:	 *  sh4_val_first() never clears -- so a guest that writes 0 and re-sets CMIE gets
442:	 *  no second line, deliberately.  At most one line per bit for the device lifetime.
443:	 *
444:	 *  THE WORDING IS NOT "write ignored", WHICH IS THE RCR1 SENTENCE AND WOULD BE A
445:	 *  LIE HERE: the write DID land, and the guest can read it back.  What is missing
446:	 *  is the delivery of the interrupt.
447:	 */
448:	if (d->bsc_rtcsr & (RTCSR_CMIE | RTCSR_OVIE)) {
449:		/*
450:		 *  TWO WORDINGS HERE WERE CORRECTED BY A PASS-2 SEAT, and both were
451:		 *  wrong in the same direction -- more specific than the code earns.
452:		 *
453:		 *  "the interrupt is NOT delivered" reads as though a refresh interrupt
454:		 *  becomes pending and is then dropped.  Nothing becomes pending: CMF and
455:		 *  OVF are never set on any path in this device, and RTCNT has no `case`
456:		 *  at all, so there is no compare-match to raise.  The honest statement is
457:		 *  that the GENERATION of the interrupt is not implemented.
458:		 *
459:		 *  "(once per bit)" is not quite what the latch does either: a single
460:		 *  store that sets BOTH enables for the first time yields ONE coalesced
461:		 *  line naming 0x42, not two.  Row R3 of sh4_rtcsr_probe.py measures
462:		 *  exactly that, so the comment and the row now agree.
463:		 */
464:		if (sh4_val_first(d, SH4_VAL_RTCSRINT, 0,
465:		    d->bsc_rtcsr & (RTCSR_CMIE | RTCSR_OVIE)))
466:			fatal("[ sh4: refresh interrupt enable(s) 0x%02x stored,"
467:			    " but refresh-interrupt generation is not implemented"
468:			    " -- each enable is reported once ]\n",
469:			    (int) (d->bsc_rtcsr & (RTCSR_CMIE | RTCSR_OVIE)));
470:		/*  TODO: Implement refresh interrupts etc.  */
471:	}
472:
473:	/*  Timer interrupts:  */
474:	for (i=0; i<N_SH4_TIMERS; i++) {
475:		uint32_t step, cnt;
476:
477:		/*  Only update timers that are currently started:  */
