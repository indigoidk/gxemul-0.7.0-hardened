codex
The Alpha CPU has callbacks that set and clear an IRQ flag, but I found no code that consumes that flag to deliver a guest interrupt. The shared execution loop also suppresses interrupt delivery during single-stepping. Forwarding, guest delivery, and a survival-only check therefore need separate conclusions.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$dyntransLines = Get-Content -LiteralPath GXEMUL-SEC/src/cpus/cpu_dyntrans.c
for ($n=166; $n -lt 270; $n++) { '"'{0}:{1}' -f ("'$n+1), $dyntransLines[$n] }
rg -n '"'"'^'"\\s*interrupt_handler_register\\s*\\(' GXEMUL-SEC/src -g '*.[ch]' -g '*.cc' -g '*.cpp'
rg -n 'interrupt_assert\\s*=|interrupt_deassert\\s*=' GXEMUL-SEC/src/devices/dev_v3.c GXEMUL-SEC/src/devices/dev_cpc700.c GXEMUL-SEC/src/devices/dev_footbridge.c GXEMUL-SEC/src/devices/dev_dec5800.c GXEMUL-SEC/src/devices/dev_irqc.c
rg -n 'TODO|unimplemented|Unimplemented|fatal|exit\\(|warn|announce|running|single_step' GXEMUL-SEC/src/devices/dev_v3.c GXEMUL-SEC/src/devices/dev_cpc700.c GXEMUL-SEC/src/devices/dev_footbridge.c GXEMUL-SEC/src/devices/dev_dec5800.c GXEMUL-SEC/src/devices/dev_irqc.c" in C:\DocumentNoSnc\CC\GXEMUL
