140:/*
141: *  alpha_cpu_list_available_types():
142: *
143: *  Print a list of available Alpha CPU types.
144: */
145:void alpha_cpu_list_available_types(void)
146:{
147:	int i, j;
148:	struct alpha_cpu_type_def tdefs[] = ALPHA_CPU_TYPE_DEFS;
149:
150:	i = 0;
151:	while (tdefs[i].name != NULL) {
152:		debug("%s", tdefs[i].name);
153:		for (j=13 - strlen(tdefs[i].name); j>0; j--)
154:			debug(" ");
155:		i++;
156:		if ((i % 4) == 0 || tdefs[i].name == NULL)
157:			debug("\n");
158:	}
159:}
