162:/*
163: *  alpha_cpu_register_dump():
164: *  
165: *  Dump cpu registers in a relatively readable format.
166: *  
167: *  gprs: set to non-zero to dump GPRs and some special-purpose registers.
168: *  coprocs: set bit 0..3 to dump registers in coproc 0..3.
169: */
170:void alpha_cpu_register_dump(struct cpu *cpu, int gprs, int coprocs)
171:{ 
172:	char *symbol;
173:	uint64_t offset;
174:	int i, x = cpu->cpu_id;
175:
176:	if (gprs) {
177:		symbol = get_symbol_name(&cpu->machine->symbol_context,
178:		    cpu->pc, &offset);
179:		debug("cpu%i:\t pc = 0x%016" PRIx64, x, (uint64_t) cpu->pc);
180:		debug("  <%s>\n", symbol != NULL? symbol : " no symbol ");
181:		for (i=0; i<N_ALPHA_REGS; i++) {
182:			int r = (i >> 1) + ((i & 1) << 4);
183:			if ((i % 2) == 0)
184:				debug("cpu%i:\t", x);
185:			if (r != ALPHA_ZERO)
186:				debug("%3s = 0x%016" PRIx64, alpha_regname[r],
187:				    (uint64_t) cpu->cd.alpha.r[r]);
188:			if ((i % 2) == 1)
189:				debug("\n");
190:			else
191:				debug("   ");
192:		}
193:	}
194:}
