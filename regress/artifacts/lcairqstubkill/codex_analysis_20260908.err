285-	    machine_watchpoint_match(cpu->machine, paddr, len)) {
286-		char valbuf[3 * 16 + 1];
287-		size_t vi, vn = len < 16 ? len : 16;
288-		valbuf[0] = '\0';
289-		for (vi = 0; vi < vn; vi++)
