 succeeded in 190ms:
   1: #!/usr/bin/env python3
   2: """lca_irqstub_probe.py -- can a guest reach lca_interrupt_assert() and end the emulator?
   3: 
   4:     usage:  lca_irqstub_probe.py <gxemul-binary> [label]
   5: 
   6: WHAT THIS PINS.  `dev_lca.c' registers `lca_interrupt_assert'/`_deassert' as the machine's
   7: interrupt template, and both are a bare diagnostic plus `exit(1)' with NO GUARD.  `devinit_lca()'
   8: hands the same interrupt path to `bus_isa_init()', which connects the upstream interrupt and
   9: UNCONDITIONALLY installs the first ns16550 on ISA IRQ 4.  So the source-derived path is
  10: 
  11:     dev_ns16550_tick() -> isa_interrupt_assert() -> isa_interrupt_common()
  12:                        -> lca_interrupt_assert() -> exit(1)
  13: 
  14: and it needs no machine-description modification, which is what makes it a witness candidate
  15: rather than laundering.
  16: 
  17: *** WHY THIS PROBE USES GUEST STORES AND NOT `put'.  MEASURED, and it is the reason an earlier
  18: attempt of mine did not fire. ***  The debugger's `put' calls memory_rw with NO_EXCEPTIONS
  19: (debugger_cmds.c:1461,:1507), and memory_rw only invokes a device handler when
  20: `!no_exceptions || (flags & DM_READS_HAVE_NO_SIDE_EFFECTS)'.  ns16550 registers DM_DEFAULT
  21: (dev_ns16550.c:353), so **a debugger `put' to the UART never reaches DEVICE_ACCESS(ns16550)** --
  22: the write is absorbed and the debugger still echoes it back, which is what makes it look like it
  23: worked.  Device access in a probe must be made by GUEST INSTRUCTIONS; `put' is for RAM only.
  24: 
  25: The UART registers are byte-wide, so this needs `stb'.  That is a BWX instruction and a 21066
  26: would not have BWX on real hardware -- but `cpu_alpha_instr.c:895' decodes `case 0x0e' with no
  27: feature gate, and `ALPHA_FEATURE_BWX' (cpu_alpha.h:57) is DEFINED AND NEVER CONSULTED anywhere in
  28: the tree.  So stb executes here on any Alpha.  Recorded because it is a fact about the emulator,
  29: not about the hardware, and a future round that gates BWX would break this probe.
  30: 
  31: ORACLE POLARITY: this asserts the CORRECT behaviour -- the session SURVIVES an ordinary UART
  32: interrupt.  It is therefore RED on the committed build (which exits) and GREEN once the stubs stop
  33: ending the process.
  34: 
  35: ATTRIBUTION: `ram ctl' runs the IDENTICAL instruction sequence against RAM instead of the UART.
  36: If that also died, the death would be the code sequence and not the device.  One control, two
  37: hypotheses separated.
  38: """
  39: import os, sys, pty, select, time
  40: 
  41: BIN   = sys.argv[1]
  42: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
  43: MACH  = "alphabook1"
  44: 
  45: rows = []
  46: def row(name, got, want, note=""):
  47:     ok = (got == want)
  48:     rows.append((name, ok))
  49:     print("%-14s %-12s %-12s %-60s %s" % (name, str(got), str(want), note,
  50:                                           "ok" if ok else "FAIL"))
 148: print("lca_irqstub_probe -- binary=%s label=%s machine=%s" % (BIN, LABEL, MACH))
 149: print("%-14s %-12s %-12s %-60s %s" % ("row", "got", "want", "note", ""))
 150: 
 151: #  ---- CONTROL 1: LIVENESS ---------------------------------------------------------------
 152: t, alive = session(["put w 0x%x, 0x%08x" % (k0(CODE), SELFBR),
 153:                     "pc=0x%x" % k0(CODE), "continue"])
 154: row("live", "alive" if alive else "died", "alive",
 155:     "CONTROL: a free-running self-branch alone must survive")
 156: 
 157: #  ---- CONTROL 2: ATTRIBUTION -- the same instructions, aimed at RAM ----------------------
 158: t2, alive2 = session(build(RAMDST))
 159: row("ram ctl", "alive" if alive2 else "died", "alive",
 160:     "ATTRIBUTION: the IDENTICAL sequence against RAM must survive")
 161: 
 162: #  ---- THE WITNESS -----------------------------------------------------------------------
 163: t3, alive3 = session(build(UART))
 164: row("uart irq", "alive" if alive3 else "died", "alive",
 165:     "an ordinary UART interrupt must not end the emulator")
 166: row("stub named", "no" if "lca_interrupt_assert" not in t3 else "yes", "no",
 167:     "the stub's own TODO diagnostic must not appear")
 168: 
 169: bad = [n for n, ok in rows if not ok]
 170: print("\nIRQSTUB_RESULT=%d/%d" % (len(rows) - len(bad), len(rows)))
 171: if bad:
 172:     print("FAILING: " + " ".join(bad))
 173: open("/tmp/irqstub_last.txt", "w").write(t3)
 174: print("IRQSTUB_DONE")

