   63: /*  256 on DECstation, SGI uses reg at 72*4 as the Century  */
   64: #define	N_REGISTERS	1024
   65: struct mc_data {
   66: 	int		access_style;
   67: 	int		last_addr;
   68: 
   69: 	int		register_choice;
   70: 	int		reg[N_REGISTERS];
