 1197: /*
 1198:  *  dev_pckbc_init():
 1199:  *
 1200:  *  Type should be PCKBC_8042 or PCKBC_8242.
 1201:  */
 1202: int dev_pckbc_init(struct machine *machine, struct memory *mem,
 1203: 	uint64_t baseaddr, int type, char *keyboard_irqpath,
 1204: 	char *mouse_irqpath, int in_use, int pc_style_flag)
 1205: {
 1206: 	struct pckbc_data *d;
 1207: 	int len = DEV_PCKBC_LENGTH;
 1208: 
 1209: 	CHECK_ALLOCATION(d = (struct pckbc_data *) malloc(sizeof(struct pckbc_data)));
 1210: 	memset(d, 0, sizeof(struct pckbc_data));
 1211: 
 1212: 	d->translation_table = 2;
 1213: 
 1214: 	if (type == PCKBC_8242) {
 1215: 		len = 0x40;
 1216: 		d->translation_table = 3;
 1217: 	}
 1218: 	
 1219: 	if (type == PCKBC_JAZZ) {
 1220: 		type = PCKBC_8042;
 1221: 		len = DEV_PCKBC_LENGTH + 0x60;
 1222: 	}
 1223: 
 1224: 	INTERRUPT_CONNECT(keyboard_irqpath, d->irq_keyboard);
 1225: 	INTERRUPT_CONNECT(mouse_irqpath, d->irq_mouse);
 1226: 
 1227: 	d->type              = type;
 1228: 	d->in_use            = in_use;
 1229: 	d->pc_style_flag     = pc_style_flag;
 1230: 	d->rx_int_enable[0]  = 1;
 1231: 	d->rx_int_enable[1]  = 0;
 1232: 	d->output_byte       = 0x02;	/*  A20 enable on PCs  */
 1233: 
 1234: 	// Default is ENABLE keyboard but DISABLE mouse port:
 1235: 	d->scanning_enabled[0] = 1;
 1236: 	d->scanning_enabled[1] = 0;
 1237: 
 1238: 	d->console_handle = console_start_slave_inputonly(
 1239: 	    machine, "pckbc", d->in_use);
 1240: 
 1241: 	memory_device_register(mem, "pckbc", baseaddr,
 1242: 	    len, dev_pckbc_access, d, DM_DEFAULT, NULL);
 1243: 	machine_add_tickfunction(machine, dev_pckbc_tick, d,
 1244: 	    PCKBC_TICKSHIFT);
 1245: 
 1246: 	return d->console_handle;
 1247: }
