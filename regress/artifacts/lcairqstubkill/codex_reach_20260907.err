  605: /*
  606:  *  machine_memsize_fix():
  607:  *
  608:  *  Sets physical_ram_in_mb (if not already set), and memory_offset_in_mb,
  609:  *  depending on machine type.
  610:  */
  611: void machine_memsize_fix(struct machine *m)
  612: {
  613: 	if (m == NULL) {
  614: 		fatal("machine_defaultmemsize(): m == NULL?\n");
  615: 		exit(1);
  616: 	}
  617: 
  618: 	if (m->physical_ram_in_mb == 0) {
  619: 		struct machine_entry *me = first_machine_entry;
  620: 		while (me != NULL) {
  621: 			if (m->machine_type == me->machine_type &&
  622: 			    me->set_default_ram != NULL) {
  623: 				me->set_default_ram(m);
  624: 				break;
  625: 			}
  626: 			me = me->next;
  627: 		}
  628: 	}
  629: 
  630: 	/*  Special SGI memory offsets:  (TODO: move this somewhere else)  */
  631: 	if (m->machine_type == MACHINE_SGI) {
  632: 		switch (m->machine_subtype) {
  633: 		case 20:
  634: 		case 22:
  635: 		case 24:
  636: 		case 26:
  637: 			m->memory_offset_in_mb = 128;
  638: 			break;
  639: 		case 28:
  640: 		case 30:
  641: 			m->memory_offset_in_mb = 512;
  642: 			break;
  643: 		}
  644: 	}
  645: 
  646: 	if (m->physical_ram_in_mb == 0)
  647: 		m->physical_ram_in_mb = DEFAULT_RAM_IN_MB;
  648: }
