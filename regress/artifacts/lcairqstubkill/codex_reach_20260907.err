  174: /*
  175:  *  pckbc_get_code():
  176:  *
  177:  *  Reads a byte from a data queue.
  178:  */
  179: int pckbc_get_code(struct pckbc_data *d, int port)
  180: {
  181: 	if (d->head[port] == d->tail[port])
  182: 		fatal("[ pckbc: queue empty, port %i! ]\n", port);
  183: 	else
  184: 		d->tail[port] = (d->tail[port]+1) % MAX_8042_QUEUELEN;
  185: 
  186: 	return d->key_queue[port][d->tail[port]];
  187: }
