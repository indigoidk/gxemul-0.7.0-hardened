  351:  *  console_charavail():
  352:  *
  353:  *  Returns the number of chararacters available in the fifo.
  354:  */
  355: int console_charavail(int handle)
  356: {
  357: 	while (console_stdin_avail(handle)) {
  358: 		unsigned char ch[100];		/* = getchar(); */
  359: 		ssize_t len;
  360: 		int i, d;
  361: 
  362: 		// If adding more would lead to a full FIFO, then let's
  363: 		// wait.
  364: 		int roomLeftInFIFO = console_room_left_in_fifo(handle);
  365: 		if (roomLeftInFIFO < (int)sizeof(ch) + 1)
  366: 			break;
  367: 
  368: 		if (!allow_slaves)
  369: 			d = STDIN_FILENO;
  370: 		else
  371: 			d = console_handles[handle].r_descriptor;
  372: 
  373: 		len = read(d, ch, sizeof(ch));
  374: 
  375: 		/*  #252: EOF (or error) on the input descriptor selects
  376: 		    readable forever; without this the while() spins inside
  377: 		    the console tick and wedges the whole emulator.  */
  378: 		if (len < 1)
  379: 			break;
  380: 
  381: 		for (i=0; i<len; i++) {
  382: 			/*  printf("[ %i: %i ]\n", i, ch[i]);  */
  383: 
  384: 			if (!allow_slaves) {
  385: 				/*  Convert CTRL-B intro CTRL-C.  */
  386: 				if (ch[i] == 2)
  387: 					ch[i] = 3;
  388: 			}
  389: 
  390: 			// CTRL-T (SIGINFO-like) info. This does not work
  391: 			// well when running with -x, since noone checks
  392: 			// for charavail at stdin then...
  393: 			//
  394: 			// if (ch[i] == 20 && d == STDIN_FILENO) {
  395: 			//	printf("\n");
  396: 			//	cpu_show_cycles(machine..., true);
  397: 			// }
  398: 
  399: 			console_makeavail(handle, ch[i]);
  400: 		}
  401: 	}
  402: 
  403: 	return CONSOLE_FIFO_LEN - console_room_left_in_fifo(handle);
