  643: DEVICE_TICK(pckbc)
  644: {
  645: 	struct pckbc_data *d = (struct pckbc_data *) extra;
  646: 	int ch;
  647: 
  648: 	// Keyboard input:
  649: 	if (d->in_use) {
  650: 		/*  #288: stop draining while the queue is nearly full, the way
  651: 		    lk201_tick() and dev_luna88k.c already do. Without a bound
  652: 		    here console_charavail() refills the console fifo from the
  653: 		    host inside this very loop, so a producer that never stops
  654: 		    keeps it true forever and the tick never returns to the
  655: 		    guest: measured on arc, an unbounded producer left the guest
  656: 		    with 0 "OpenBSD" banner lines against 4 in the control, while
  657: 		    pmax under identical stimulus was unaffected because its
  658: 		    lk201 drain loop has this guard. Leaving the input in the
  659: 		    host buffer is the correct back pressure. The reserve exceeds
  660: 		    the longest scancode sequence (6: shift make, code, break,
  661: 		    shift break -- shift and ctrl are mutually exclusive in all
  662: 		    three converters) so an admitted character always fits whole
  663: 		    and a make cannot be queued with its break dropped.  */
  664: 		while (pckbc_room_left(d, 0) > 8 &&
  665: 		    console_charavail(d->console_handle)) {
  666: 			ch = console_readchar(d->console_handle);
  667: 			if (ch >= 0) {
  668: 				switch (d->translation_table) {
  669: 				case 1:	ascii_to_pc_scancodes_type1(ch, d);
  670: 					break;
  671: 				case 2:	ascii_to_pc_scancodes_type2(ch, d);
  672: 					break;
  673: 				case 3:	ascii_to_pc_scancodes_type3(ch, d);
  674: 					break;
  675: 				default:debugmsg(SUBSYS_DEVICE, "pckbc", VERBOSITY_WARNING,
  676: 					    "unimplemented translation table type %i",
  677: 					    d->translation_table);
  678: 				}
  679: 			}
  680: 		}
  681: 	}
  682: 
  683: 	// Mouse input:
  684: 	/*  Don't do mouse updates if we're running in serial console mode:  */
  685: 	if (cpu->machine->x11_md.in_use && d->state[1] == STATE_NORMAL && d->scanning_enabled[1]) {
  686: 		int xdelta, ydelta, mouse_buttons, mouse_fb_nr;
  687: 		console_getmouse(&xdelta, &ydelta, &mouse_buttons, &mouse_fb_nr);
  688: 
  689: 		ydelta = 0 - ydelta;
  690: 
  691: 		const int m = 100;
  692: 
  693: 		if (xdelta > m)
  694: 			xdelta = m;
  695: 		if (xdelta < -m)
  696: 			xdelta = -m;
  697: 		if (ydelta > m)
  698: 			ydelta = m;
  699: 		if (ydelta < -m)
  700: 			ydelta = -m;
  701: 
  702: 		/*  Only send update if there is an actual diff.  */
  703: 		if (xdelta != 0 || ydelta != 0 || d->mouse_buttons != mouse_buttons) {
  704: 			d->mouse_buttons = mouse_buttons;
  705: 
  706: 			// See "The default protocol" at
  707: 			// https://www.win.tue.nl/~aeb/linux/kbd/scancodes-13.html
  708: 			uint8_t b1 = 0x08;
  709: 			uint8_t b2 = xdelta;
  710: 			uint8_t b3 = ydelta;
  711: 
  712: 			b1 |= (mouse_buttons & 4) >> 2;	// Left
  713: 			b1 |= (mouse_buttons & 2) << 1;	// Middle
  714: 			b1 |= (mouse_buttons & 1) << 1;	// Right
  715: 			b1 |= ((xdelta >> 8) & 1) << 4;
  716: 			b1 |= ((ydelta >> 8) & 1) << 5;
  717: 
  718: 			// printf("x=%i y=%i b1=%02x %02x %02x\n", xdelta, ydelta, b1,b2,b3);
  719: 
  720: 			pckbc_add_code(d, b1, 1);
  721: 			pckbc_add_code(d, b2, 1);
  722: 			pckbc_add_code(d, b3, 1);
  723: 		}
  724: 	}
  725: 
  726: 	pckbc_reassert_interrupts(d);
  727: }
