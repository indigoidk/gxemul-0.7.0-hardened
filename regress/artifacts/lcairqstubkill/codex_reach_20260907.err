  606: void pckbc_reassert_interrupts(struct pckbc_data *d)
  607: {
  608: 	int ints_enabled = 1;
  609: 
  610: 	// if (d->cmdbyte & KC8_KDISABLE)
  611: 	//	ints_enabled = 0;
  612: 
  613: 	for (int port_nr = 0; port_nr < 2; port_nr++) {
  614: 		/*
  615: 		 *  Cause receive interrupt, if there's something in the
  616: 		 *  receive buffer: (Otherwise deassert the interrupt.)
  617: 		 */
  618: 		if (d->head[port_nr] != d->tail[port_nr] && ints_enabled && d->rx_int_enable[port_nr]) {
  619: 			if (!d->currently_asserted[port_nr]) {
  620: 				// fatal("[ pckbc: interrupt port %i ]\n", port_nr);
  621: 				if (port_nr == 0)
  622: 					INTERRUPT_ASSERT(d->irq_keyboard);
  623: 				else
  624: 					INTERRUPT_ASSERT(d->irq_mouse);
  625: 			}
  626: 
  627: 			d->currently_asserted[port_nr] = 1;
  628: 		} else {
  629: 			if (d->currently_asserted[port_nr]) {
  630: 				// fatal("[ pckbc: DEASSERT interrupt port %i ]\n", port_nr);
  631: 				if (port_nr == 0)
  632: 					INTERRUPT_DEASSERT(d->irq_keyboard);
  633: 				else
  634: 					INTERRUPT_DEASSERT(d->irq_mouse);
  635: 			}
  636: 
  637: 			d->currently_asserted[port_nr] = 0;
  638: 		}
  639: 	}
  640: }
