GXEMUL-SEC/src/devices/dev_lca.c:175: 	for (i=0; i<len; i++)
GXEMUL-SEC/src/devices/dev_lca.c:176: 		data[i] = i == ofs? byte : 0x00;
GXEMUL-SEC/src/devices/dev_lca.c:177: 
GXEMUL-SEC/src/devices/dev_lca.c:178: 	return 1;
GXEMUL-SEC/src/devices/dev_lca.c:179: }
