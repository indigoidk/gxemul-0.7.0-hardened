  691: /*
  692:  *  machine_run():
  693:  *
  694:  *  Run one or more instructions on all CPUs in this machine. (Usually,
  695:  *  around N_SAFE_DYNTRANS_LIMIT instructions will be run by the dyntrans
  696:  *  system.)
  697:  *
  698:  *  Return value is true if any CPU in this machine is still running,
  699:  *  false if all CPUs are stopped.
  700:  */
  701: bool machine_run(struct machine *machine)
  702: {
  703: 	struct cpu **cpus = machine->cpus;
  704: 	int ncpus = machine->ncpus;
  705: 	bool any_running = false;
  706: 
  707: 	for (int i=0; i<ncpus; i++) {
  708: 		if (cpus[i]->running) {
  709: 			any_running = true;
  710: 			cpus[i]->run_instr(cpus[i]);
  711: 		}
  712: 	}
  713: 
  714: 	if (!any_running)
  715: 		return false;
  716: 
  717: 	/*
  718: 	 *  Hardware 'ticks':  (clocks, interrupt sources...)
  719: 	 *
  720: 	 *  This assumes that the CPUs ran approximately N_SAFE_DYNTRANS_LIMIT
  721: 	 *  instructions (or "ticks") in the core dyntrans loop.
  722: 	 *
  723: 	 *  TODO: This should be redesigned into some "mainbus" stuff instead!
  724: 	 */
  725: 
  726: 	for (int te=0; te<machine->tick_functions.n_entries; te++) {
  727: 		machine->tick_functions.ticks_till_next[te] -=
  728: 		    single_step ? 1 : N_SAFE_DYNTRANS_LIMIT;
  729: 
  730: 		if (machine->tick_functions.ticks_till_next[te] <= 0) {
  731: 			while (machine->tick_functions.ticks_till_next[te]<=0) {
  732: 				machine->tick_functions.ticks_till_next[te] +=
  733: 				    machine->tick_functions.ticks_reset_value[te];
  734: 
  735: 				machine->tick_functions.f[te](cpus[0],
  736: 			    	    machine->tick_functions.extra[te]);
  737: 			}
  738: 		}
  739: 	}
  740: 
  741: 	/*  Is any CPU still alive?  */
  742: 	for (int i=0; i<ncpus; i++)
  743: 		if (cpus[i]->running)
  744: 			return true;
  745: 
  746: 	return false;
