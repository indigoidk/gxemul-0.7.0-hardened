  146: /*
  147:  *  dev_mc146818_jazz_access():
  148:  *
  149:  *  It seems like JAZZ machines accesses the mc146818 by writing one byte to
  150:  *  0x90000070 and then reading or writing another byte at 0x......0004000.
  280: DEVICE_ACCESS(mc146818)
  281: {
  282: 	struct mc_data *d = (struct mc_data *) extra;
  283: 	struct tm *tmp;
  284: 	time_t timet;
  285: 	size_t i;
  286: 
  287: 	/*  NOTE/TODO: This access function only handles 8-bit accesses!  */
  288: 
  289: 	relative_addr /= d->addrdiv;
  290: 
  291: 	/*  Different ways of accessing the registers:  */
  292: 	switch (d->access_style) {
  293: 	case MC146818_ALGOR:
  294: 	case MC146818_CATS:
  295: 	case MC146818_PC_CMOS:
  296: 		if ((relative_addr & 1) == 0x00) {
  297: 			if (writeflag == MEM_WRITE) {
  298: 				d->last_addr = data[0];
  299: 				return 1;
  300: 			} else {
  301: 				data[0] = d->last_addr;
  302: 				return 1;
  303: 			}
  304: 		} else
  305: 			relative_addr = d->last_addr * 4;
  306: 		break;
  307: 	case MC146818_ARC_NEC:
  308: 		if (relative_addr == 0x01) {
  309: 			if (writeflag == MEM_WRITE) {
  310: 				d->last_addr = data[0];
  311: 				return 1;
  312: 			} else {
  313: 				data[0] = d->last_addr;
  314: 				return 1;
  315: 			}
  316: 		} else if (relative_addr == 0x00)
  317: 			relative_addr = d->last_addr * 4;
  318: 		else {
  319: 			fatal("[ mc146818: not accessed as an "
  320: 			    "MC146818_ARC_NEC device! ]\n");
  321: 		}
  322: 		break;
  323: 	case MC146818_ARC_JAZZ:
  324: 		/*  See comment for dev_mc146818_jazz_access().  */
  325: 		relative_addr = d->last_addr * 4;
  326: 		break;
  327: 	case MC146818_DEC:
  328: 	case MC146818_SGI:
  329: 		/*
  330: 		 *  This device was originally written for DECstation
  331: 		 *  emulation, so no changes are necessary for that access
  332: 		 *  style.
  333: 		 *
  334: 		 *  SGI access bytes 0x0..0xd at offsets 0x0yz..0xdyz, where yz
  335: 		 *  should be ignored. It works _almost_ as DEC, if offsets are
  336: 		 *  divided by 0x40.
  337: 		 */
  338: 		break;
  339: 	case MC146818_PMPPC:
  340: 		relative_addr *= 4;
  341: 		break;
  342: 	default:
  343: 		;
  344: 	}
  345: 
  346: #ifdef MC146818_DEBUG
  347: 	if (writeflag == MEM_WRITE) {
  348: 		fatal("[ mc146818: write to addr=0x%04x (len %i): ",
  349: 		    (int)relative_addr, (int)len);
  350: 		for (i=0; i<len; i++)
  351: 			fatal("0x%02x ", data[i]);
  352: 		fatal("]\n");
  353: 	}
  354: #endif
  355: 
  356: 	/*
  357: 	 *  Sprite seems to wants UF interrupt status, once every second, or
  358: 	 *  it hangs forever during bootup.  (These do not cause interrupts,
  359: 	 *  but it is good enough... Sprite polls this, iirc.)
  360: 	 *
  361: 	 *  Linux on at least sgimips and evbmips (Malta) wants the UIP bit
  362: 	 *  in REGA to be updated once a second.
  363: 	 */
  364: 	if (relative_addr == MC_REGA*4 || relative_addr == MC_REGC*4) {
  365: 		timet = time(NULL);
  366: 		tmp = gmtime(&timet);
  367: 		d->reg[MC_REGC * 4] &= ~MC_REGC_UF;
  368: 		if (tmp->tm_sec != d->previous_second) {
  369: 			d->n_seconds_elapsed ++;
  370: 			d->previous_second = tmp->tm_sec;
  371: 		}
  372: 		if (d->n_seconds_elapsed > d->uip_threshold) {
  373: 			d->n_seconds_elapsed = 0;
  374: 
  375: 			d->reg[MC_REGA * 4] |= MC_REGA_UIP;
  376: 
  377: 			d->reg[MC_REGC * 4] |= MC_REGC_UF;
  378: 			d->reg[MC_REGC * 4] |= MC_REGC_IRQF;
  379: 
  380: 			/*  For some reason, some Linux/DECstation KN04
  381: 			    kernels want the PF (periodic flag) bit set,
  382: 			    even though interrupts are not enabled?  */
  383: 			d->reg[MC_REGC * 4] |= MC_REGC_PF;
  384: 		} else
  385: 			d->reg[MC_REGA * 4] &= ~MC_REGA_UIP;
  386: 	}
  387: 
  388: 	/*  RTC data is in either BCD format or binary:  */
  389: 	if (d->use_bcd)
  390: 		d->reg[MC_REGB * 4] &= ~(1 << 2);
  391: 	else
  392: 		d->reg[MC_REGB * 4] |= (1 << 2);
  393: 
  394: 	/*  RTC date/time is always Valid:  */
  395: 	d->reg[MC_REGD * 4] |= MC_REGD_VRT;
  396: 
  397: 	if (writeflag == MEM_WRITE) {
  398: 		/*  WRITE:  */
  399: 		switch (relative_addr) {
  400: 		case MC_REGA*4:
  401: 			if ((data[0] & MC_REGA_DVMASK) == MC_BASE_32_KHz)
  402: 				d->timebase_hz = 32000;
  403: 			if ((data[0] & MC_REGA_DVMASK) == MC_BASE_1_MHz)
  404: 				d->timebase_hz = 1000000;
  405: 			if ((data[0] & MC_REGA_DVMASK) == MC_BASE_4_MHz)
  406: 				d->timebase_hz = 4000000;
  407: 			switch (data[0] & MC_REGA_RSMASK) {
  408: 			case MC_RATE_NONE:
  409: 				d->interrupt_hz = 0;
  410: 				break;
  411: 			case MC_RATE_1:
  412: 				if (d->timebase_hz == 32000)
  413: 					d->interrupt_hz = 256;
  414: 				else
  415: 					d->interrupt_hz = 32768;
  416: 				break;
  417: 			case MC_RATE_2:
  418: 				if (d->timebase_hz == 32000)
  419: 					d->interrupt_hz = 128;
  420: 				else
  421: 					d->interrupt_hz = 16384;
  422: 				break;
  423: 			case MC_RATE_8192_Hz:	d->interrupt_hz = 8192;	break;
  424: 			case MC_RATE_4096_Hz:	d->interrupt_hz = 4096;	break;
  425: 			case MC_RATE_2048_Hz:	d->interrupt_hz = 2048;	break;
  426: 			case MC_RATE_1024_Hz:	d->interrupt_hz = 1024;	break;
  427: 			case MC_RATE_512_Hz:	d->interrupt_hz = 512;	break;
  428: 			case MC_RATE_256_Hz:	d->interrupt_hz = 256;	break;
  429: 			case MC_RATE_128_Hz:	d->interrupt_hz = 128;	break;
  430: 			case MC_RATE_64_Hz:	d->interrupt_hz = 64;	break;
  431: 			case MC_RATE_32_Hz:	d->interrupt_hz = 32;	break;
  432: 			case MC_RATE_16_Hz:	d->interrupt_hz = 16;	break;
  433: 			case MC_RATE_8_Hz:	d->interrupt_hz = 8;	break;
  434: 			case MC_RATE_4_Hz:	d->interrupt_hz = 4;	break;
  435: 			case MC_RATE_2_Hz:	d->interrupt_hz = 2;	break;
  436: 			default:/*  debug("[ mc146818: unimplemented "
  437: 				    "MC_REGA RS: %i ]\n",
  438: 				    data[0] & MC_REGA_RSMASK);  */
  439: 				;
  440: 			}
  441: 
  442: 			if (d->interrupt_hz != d->old_interrupt_hz) {
  443: 				debug("[ rtc changed to interrupt at %i Hz ]\n",
  444: 				    d->interrupt_hz);
  445: 
  446: 				d->old_interrupt_hz = d->interrupt_hz;
  447: 
  448: 				if (d->timer == NULL)
  449: 					d->timer = timer_add(d->interrupt_hz,
  450: 					    timer_tick, d);
  451: 				else
  452: 					timer_update_frequency(d->timer,
  453: 					    d->interrupt_hz);
  454: 			}
  455: 
  456: 			d->reg[MC_REGA * 4] =
  457: 			    data[0] & (MC_REGA_RSMASK | MC_REGA_DVMASK);
  458: 			break;
  459: 		case MC_REGB*4:
  460: 			d->reg[MC_REGB*4] = data[0];
  461: 			if (!(data[0] & MC_REGB_PIE)) {
  462: 				INTERRUPT_DEASSERT(d->irq);
  463: 			}
  464: 
  465: 			/*  debug("[ mc146818: write to MC_REGB, data[0] "
  466: 			    "= 0x%02x ]\n", data[0]);  */
  467: 			break;
  468: 		case MC_REGC*4:
  469: 			d->reg[MC_REGC * 4] = data[0];
  470: 			debug("[ mc146818: write to MC_REGC, data[0] = "
  471: 			    "0x%02x ]\n", data[0]);
  472: 			break;
  473: 		case 0x128:
  474: 			d->reg[relative_addr] = data[0];
  475: 			if (data[0] & 8) {
  476: 				int j;
  477: 
  478: 				/*  Used on SGI to power off the machine.  */
  479: 				fatal("[ md146818: power off ]\n");
  480: 				for (j=0; j<cpu->machine->ncpus; j++)
  481: 					cpu->machine->cpus[j]->running = false;
  482: 			}
  483: 			break;
  484: 		default:
  485: 			d->reg[relative_addr] = data[0];
  530: 		case 4 * 72:	/*  72 is Century, on SGI (DS1687)  */
  531: 			/*
  532: 			 *  If the SET bit is set, then we don't automatically
  533: 			 *  update the values.  Otherwise, we update them by
  534: 			 *  reading from the host's clock:
  535: 			 */
  536: 			if (d->reg[MC_REGB * 4] & MC_REGB_SET)
  537: 				break;
  538: 
  539: 			if (d->ugly_netbsd_prep_hack_done >= NETBSD_HACK_DONE)
  540: 				mc146818_update_time(d);
  541: 			break;
  542: 		case 4 * MC_REGA:
  543: 			break;
  544: 		case 4 * MC_REGC:	/*  Interrupt ack.  */
  545: 			/*  NOTE: Acking is done below, _after_ the
  546: 			    register has been read.  */
  547: 			break;
  548: 		default:debug("[ mc146818: read from relative_addr = "
  549: 			    "%04x ]\n", (int)relative_addr);
  550: 		}
  551: 
  552: 		data[0] = d->reg[relative_addr];
  553: 
  554: 		if (relative_addr == MC_REGC*4) {
  555: 			INTERRUPT_DEASSERT(d->irq);
  556: 
  557: 			/*
  558: 			 *  Acknowledging an interrupt decreases the
  559: 			 *  number of pending "real world" timer ticks.
  560: 			 */
  561: 			if (d->reg[MC_REGC * 4] & MC_REGC_PF &&
  562: 			    d->pending_timer_interrupts > 0)
  563: 				d->pending_timer_interrupts --;
  564: 
  565: 			d->reg[MC_REGC * 4] = 0x00;
  566: 		}
  567: 	}
  568: 
  569: #ifdef MC146818_DEBUG
  570: 	if (writeflag == MEM_READ) {
  571: 		fatal("[ mc146818: read from addr=0x%04x (len %i): ",
  572: 		    (int)relative_addr, (int)len);
  573: 		for (i=0; i<len; i++)
  574: 			fatal("0x%02x ", data[i]);
  575: 		fatal("]\n");
  576: 	}
  577: #endif
  578: 
  579: 	return 1;
  580: }
