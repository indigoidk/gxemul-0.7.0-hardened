GXEMUL-SEC/src/devices/dev_lca.c:100: 	 *
GXEMUL-SEC/src/devices/dev_lca.c:101: 	 *  According to NetBSD's lca_pci.c, the address is composed like this:
GXEMUL-SEC/src/devices/dev_lca.c:102: 	 *
GXEMUL-SEC/src/devices/dev_lca.c:103: 	 *	addr = tag << 5 | (regoffset & ~0x03) << 5 | 0x3 << 3
GXEMUL-SEC/src/devices/dev_lca.c:104: 	 */
GXEMUL-SEC/src/devices/dev_lca.c:105: 	reg = (relative_addr >> 5) & 0xfc;
GXEMUL-SEC/src/devices/dev_lca.c:106: 	tag = (relative_addr >> 5) & ~0xff;
GXEMUL-SEC/src/devices/dev_lca.c:107: 
GXEMUL-SEC/src/devices/dev_lca.c:108: 	/*
GXEMUL-SEC/src/devices/dev_lca.c:109: 	 *  2. Decompose the tag into bus, dev, and func.
GXEMUL-SEC/src/devices/dev_lca.c:110: 	 *
GXEMUL-SEC/src/devices/dev_lca.c:111: 	 *  The tag can be constructed in one of two ways. On the primary
GXEMUL-SEC/src/devices/dev_lca.c:112: 	 *  bus (nr 0):
GXEMUL-SEC/src/devices/dev_lca.c:113: 	 *
GXEMUL-SEC/src/devices/dev_lca.c:114: 	 *	tag = (1 << (device + 11)) | (function << 8);
GXEMUL-SEC/src/devices/dev_lca.c:115: 	 *
GXEMUL-SEC/src/devices/dev_lca.c:116: 	 *  and on other busses, the tag is a normal:
GXEMUL-SEC/src/devices/dev_lca.c:117: 	 *
GXEMUL-SEC/src/devices/dev_lca.c:118: 	 *	tag = (bus << 16) | (device << 11) | (function << 8)
GXEMUL-SEC/src/devices/dev_lca.c:119: 	 */
GXEMUL-SEC/src/devices/dev_lca.c:120: 	/*  printf("tag = 0x%x\n", (int)tag);  */
GXEMUL-SEC/src/devices/dev_lca.c:121: 	bus = d->ioc_conf & 1;
GXEMUL-SEC/src/devices/dev_lca.c:122: 
GXEMUL-SEC/src/devices/dev_lca.c:123: 	if (bus == 0) {
GXEMUL-SEC/src/devices/dev_lca.c:124: 		for (dev=0; dev<21; dev++)
GXEMUL-SEC/src/devices/dev_lca.c:125: 			if (tag & (0x800 << dev))
GXEMUL-SEC/src/devices/dev_lca.c:126: 				break;
GXEMUL-SEC/src/devices/dev_lca.c:127: 		if (dev >= 21) {
GXEMUL-SEC/src/devices/dev_lca.c:128: 			/*  fatal("[ LCA: No bus 0 device? TODO ]\n");
GXEMUL-SEC/src/devices/dev_lca.c:129: 			exit(1);  */
GXEMUL-SEC/src/devices/dev_lca.c:130: 			dev = 0;
GXEMUL-SEC/src/devices/dev_lca.c:131: 		}
GXEMUL-SEC/src/devices/dev_lca.c:132: 	} else {
GXEMUL-SEC/src/devices/dev_lca.c:133: 		fatal("TODO. Non-zero bus.\n");
GXEMUL-SEC/src/devices/dev_lca.c:134: 		exit(1);
GXEMUL-SEC/src/devices/dev_lca.c:135: 	}
GXEMUL-SEC/src/devices/dev_lca.c:136: 
GXEMUL-SEC/src/devices/dev_lca.c:137: 	func = (tag >> 8) & 7;
GXEMUL-SEC/src/devices/dev_lca.c:138: 	/*  printf("bus=%i dev=%i func=%i reg=%i\n", bus,dev,func,reg);  */
GXEMUL-SEC/src/devices/dev_lca.c:139: 
GXEMUL-SEC/src/devices/dev_lca.c:140: 	/*  Pass PCI accesses onto bus_pci:  */
GXEMUL-SEC/src/devices/dev_lca.c:141: 	bus_pci_setaddr(cpu, d->pci_data, bus, dev, func, reg);
GXEMUL-SEC/src/devices/dev_lca.c:142: 	bus_pci_data_access(cpu, d->pci_data, writeflag == MEM_READ?
GXEMUL-SEC/src/devices/dev_lca.c:143: 	    &odata : &idata, len, writeflag);
GXEMUL-SEC/src/devices/dev_lca.c:144: 
GXEMUL-SEC/src/devices/dev_lca.c:145: 	if (writeflag == MEM_READ)
GXEMUL-SEC/src/devices/dev_lca.c:146: 		memory_writemax64(cpu, data, len, odata);
GXEMUL-SEC/src/devices/dev_lca.c:147: 
GXEMUL-SEC/src/devices/dev_lca.c:148: 	return 1;
GXEMUL-SEC/src/devices/dev_lca.c:149: }
