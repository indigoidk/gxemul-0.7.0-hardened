  274: /*
  275:  *  d_avail():
  276:  *
  277:  *  Returns 1 if anything is available on a descriptor.
  278:  */
  279: static int d_avail(int d)
  280: {
  281: 	fd_set rfds;
  282: 	struct timeval tv;
  283: 
  284: 	FD_ZERO(&rfds);
  285: 	FD_SET(d, &rfds);
  286: 	tv.tv_sec = 0;
  287: 	tv.tv_usec = 0;
  288: 
  289: 	for (;;) {
  290: 		// Select may return -1 if interrupted.
  291: 		int r = select(d+1, &rfds, NULL, NULL, &tv);
  292: 		if (r >= 0)
  293: 			return r;
  294: 	}
  295: }
