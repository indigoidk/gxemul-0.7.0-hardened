  124: 
  125: /*
  126:  *  pckbc_add_code():
  127:  *
  128:  *  Adds a byte to the data queue.
  129:  */
  130: /*
  131:  *  pckbc_room_left():
  132:  *
  133:  *  #288: codes that still fit before head would meet tail.
  134:  */
  135: static int pckbc_room_left(struct pckbc_data *d, int port)
  136: {
  137: 	int used = d->head[port] - d->tail[port];
  138: 	if (used < 0)
  139: 		used += MAX_8042_QUEUELEN;
  140: 	return MAX_8042_QUEUELEN - 1 - used;
  141: }
  142: 
  143: 
  144: void pckbc_add_code(struct pckbc_data *d, int code, int port)
  145: {
  146: 	/*  Add at the head, read at the tail:  */
  147: 	int next = (d->head[port]+1) % MAX_8042_QUEUELEN;
  148: 
  149: 	/*  #288: on a full queue drop the INCOMING code and keep what is
  150: 	    already queued. The old shape advanced head onto tail and only
  151: 	    then warned -- and head == tail is what pckbc_get_code() and the
  152: 	    status and interrupt paths all read as EMPTY, so one overrun
  153: 	    silently discarded the WHOLE queue rather than the single code
  154: 	    that did not fit. Measured on arc: a 44 KB paste wrapped the ring
  155: 	    4 times and the guest received 21 of 1702 lines. Warn once per
  156: 	    port -- nothing tells the guest (no 8042 overrun status bit is
  157: 	    modelled) and fatal() is ungated, so a per-code message would be
  158: 	    a flood of over a million lines under the very input that trips
  159: 	    it.  */
  160: 	if (next == d->tail[port]) {
  161: 		if (!d->overrun_warned[port]) {
  162: 			d->overrun_warned[port] = 1;
  163: 			fatal("[ pckbc: queue overrun, port %i; dropping"
  164: 			    " input ]\n", port);
  165: 		}
  166: 		return;
  167: 	}
  168: 
  169: 	d->head[port] = next;
  170: 	d->key_queue[port][d->head[port]] = code;
  171: }
  172: 
  173: 
  174: /*
  175:  *  pckbc_get_code():
  176:  *
  177:  *  Reads a byte from a data queue.
  178:  */
  179: int pckbc_get_code(struct pckbc_data *d, int port)
  180: {
  181: 	if (d->head[port] == d->tail[port])
  182: 		fatal("[ pckbc: queue empty, port %i! ]\n", port);
  183: 	else
  184: 		d->tail[port] = (d->tail[port]+1) % MAX_8042_QUEUELEN;
  185: 
  186: 	return d->key_queue[port][d->tail[port]];
  187: }
  188: 
