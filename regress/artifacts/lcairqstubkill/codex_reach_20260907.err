  651: /*
  652:  *  machine_default_cputype():
  653:  *
  654:  *  Sets m->cpu_name, if it isn't already set, depending on the machine type.
  655:  */
  656: void machine_default_cputype(struct machine *m)
  657: {
  658: 	struct machine_entry *me;
  659: 
  660: 	if (m == NULL) {
  661: 		fatal("machine_default_cputype(): m == NULL?\n");
  662: 		exit(1);
  663: 	}
  664: 
  665: 	/*  Already set? Then return.  */
  666: 	if (m->cpu_name != NULL)
  667: 		return;
  668: 
  669: 	me = first_machine_entry;
  670: 	while (me != NULL) {
  671: 		if (m->machine_type == me->machine_type &&
  672: 		    me->set_default_cpu != NULL) {
  673: 			me->set_default_cpu(m);
  674: 			break;
  675: 		}
  676: 		me = me->next;
  677: 	}
  678: 
  679: 	if (m->cpu_name == NULL) {
  680: 		fprintf(stderr, "machine_default_cputype(): no default"
  681: 		    " cpu for machine type %i subtype %i\n",
  682: 		    m->machine_type, m->machine_subtype);
  683: 		exit(1);
  684: 	}
  685: }
