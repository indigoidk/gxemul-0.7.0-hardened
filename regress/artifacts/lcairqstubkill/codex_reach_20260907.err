 1671: int diskimage_access(struct machine *machine, int id, int type, int writeflag,
 1672: 	off_t offset, unsigned char *buf, size_t len)
 1673: {
 1674: 	struct diskimage *d = machine->first_diskimage;
 1675: 
 1676: 	while (d != NULL) {
 1677: 		if (d->type == type && d->id == id)
 1678: 			break;
 1679: 		d = d->next;
 1680: 	}
 1681: 
 1682: 	if (d == NULL) {
 1683: 		fatal("[ diskimage_access(): ERROR: trying to access a "
 1684: 		    "non-existant %s disk image (id %i)\n",
 1685: 		    diskimage_types[type], id);
 1686: 		return 0;
 1687: 	}
 1688: 
 1689: 	offset -= d->override_base_offset;
 1690: 	if (offset < 0 && offset + d->override_base_offset >= 0) {
 1691: 		debug("[ reading before start of disk image ]\n");
 1692: 		/*  Returning zeros.  */
 1693: 		memset(buf, 0, len);
 1694: 		return 1;
 1695: 	}
 1696: 
 1697: 	return diskimage__internal_access(d, writeflag, offset, buf, len);
 1698: }
