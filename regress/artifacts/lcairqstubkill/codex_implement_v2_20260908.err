src\machines\machine_alpha.c:141: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:142: 	    &(crb.crb_v_dispatch), CRB_ADDR - 0x100);
src\machines\machine_alpha.c:143: 	store_64bit_word(cpu, CRB_ADDR - 0x100 + 8, PROM_ENTRY_PADDR);
src\machines\machine_alpha.c:144: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:145: 	    &(crb.crb_v_fixup), CRB_ADDR - 0x80);
src\machines\machine_alpha.c:146: 	store_64bit_word(cpu, CRB_ADDR - 0x80 + 8, PROM_ENTRY_PADDR + 0x800);
src\machines\machine_alpha.c:147: 
src\machines\machine_alpha.c:148: 	/*  PCS: Processor ID etc.  */
src\machines\machine_alpha.c:149: 	for (i=0; i<machine->ncpus; i++) {
src\machines\machine_alpha.c:150: 		memset(&pcs[i], 0, sizeof(struct pcs));
src\machines\machine_alpha.c:151: 		store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:152: 		    &(pcs[i].pcs_flags), PCS_RC | PCS_PA | PCS_PP |
src\machines\machine_alpha.c:153: 		    PCS_CV | PCS_PV | PCS_PMV | PCS_PL);
src\machines\machine_alpha.c:154: 		store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:155: 		    &(pcs[i].pcs_proc_type),
src\machines\machine_alpha.c:156: 		    machine->cpus[i]->cd.alpha.cpu_type.pcs_type);
src\machines\machine_alpha.c:157: 	}
src\machines\machine_alpha.c:158: 
src\machines\machine_alpha.c:159: 	/*
src\machines\machine_alpha.c:160: 	 *  MDDT: Memory Data Descriptor Table. For now, it is a simple
src\machines\machine_alpha.c:161: 	 *  two-entry table with half of the available RAM in each entry.
src\machines\machine_alpha.c:162: 	 *  (The values are in number of 8K pages.)
src\machines\machine_alpha.c:163: 	 *  The first 16 MB are not included (the kernel lives there).
src\machines\machine_alpha.c:164: 	 *  The last 1 MB is not included either, it is reserved for bootup
src\machines\machine_alpha.c:165: 	 *  and similar.
src\machines\machine_alpha.c:166: 	 */
src\machines\machine_alpha.c:167: 	memset(&mddt, 0, sizeof(struct mddt));
src\machines\machine_alpha.c:168: 	memset(&mddt.mddt_clusters[0], 0, sizeof(struct mddt_cluster));
src\machines\machine_alpha.c:169: 	memset(&mddt.mddt_clusters[1], 0, sizeof(struct mddt_cluster));
src\machines\machine_alpha.c:170: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:171: 	    &(mddt.mddt_cluster_cnt), 2);
src\machines\machine_alpha.c:172: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:173: 	    &(mddt.mddt_clusters[0].mddt_pfn), 16 * 128);
src\machines\machine_alpha.c:174: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:175: 	    &(mddt.mddt_clusters[0].mddt_pg_cnt),
src\machines\machine_alpha.c:176: 	    (machine->physical_ram_in_mb/2 - 16) * 128);
