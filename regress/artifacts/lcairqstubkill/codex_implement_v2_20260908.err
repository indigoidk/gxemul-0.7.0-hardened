src\core\interrupt.c:71: /*
src\core\interrupt.c:72:  *  interrupt_handler_register():
src\core\interrupt.c:73:  *
src\core\interrupt.c:74:  *  Add an interrupt handler to the interrupt subsystem. The template
src\core\interrupt.c:75:  *  needs to have all members set.
src\core\interrupt.c:76:  *
src\core\interrupt.c:77:  *  Name is of the form "machine[0].cpu[0].irq[3].isa[14]" etc.
src\core\interrupt.c:78:  *
src\core\interrupt.c:79:  *  If there already is a handler with this name, the emulator aborts.
src\core\interrupt.c:80:  */
src\core\interrupt.c:81: void interrupt_handler_register(struct interrupt *templ)
src\core\interrupt.c:82: {
src\core\interrupt.c:83: 	int i;
src\core\interrupt.c:84: 
src\core\interrupt.c:85: #ifdef INTERRUPT_DEBUG
src\core\interrupt.c:86: 	printf("interrupt_handler_register(\"%s\")\n", templ->name);
src\core\interrupt.c:87: #endif
src\core\interrupt.c:88: 
src\core\interrupt.c:89: 	/*  See if the name is already registered:  */
src\core\interrupt.c:90: 	for (i=0; i<nr_of_interrupt_handlers; i++) {
src\core\interrupt.c:91: 		if (strcmp(templ->name,
src\core\interrupt.c:92: 		    interrupt_handlers[i].templ.name) != 0)
src\core\interrupt.c:93: 			continue;
src\core\interrupt.c:94: 
src\core\interrupt.c:95: 		fatal("\ninterrupt_handler_register(): An interrupt handler"
src\core\interrupt.c:96: 		    " using the name '%s' is already registered.\n",
src\core\interrupt.c:97: 		    templ->name);
src\core\interrupt.c:98: 		exit(1);
src\core\interrupt.c:99: 	}
src\core\interrupt.c:100: 
src\core\interrupt.c:101: 	nr_of_interrupt_handlers ++;
src\core\interrupt.c:102: 	CHECK_ALLOCATION(interrupt_handlers = 
src\core\interrupt.c:103: 	    (struct interrupt_handler *) realloc(interrupt_handlers,
src\core\interrupt.c:104: 	    nr_of_interrupt_handlers * sizeof(struct interrupt_handler)));
src\core\interrupt.c:105: 
src\core\interrupt.c:106: 	interrupt_handlers[nr_of_interrupt_handlers-1].templ = *templ;
src\core\interrupt.c:107: 	CHECK_ALLOCATION(interrupt_handlers[nr_of_interrupt_handlers-1].
src\core\interrupt.c:108: 	    templ.name = strdup(templ->name));
src\core\interrupt.c:109: }
src\core\interrupt.c:110: 
