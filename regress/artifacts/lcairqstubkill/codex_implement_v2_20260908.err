src\machines\machine_alpha.c:81: 	}
src\machines\machine_alpha.c:82: 
src\machines\machine_alpha.c:83: 	if (!machine->prom_emulation)
src\machines\machine_alpha.c:84: 		return;
src\machines\machine_alpha.c:85: 
src\machines\machine_alpha.c:86: 	/*  These are used by NetBSD/alpha:  */
src\machines\machine_alpha.c:87: 	/*  a0 = First free Page Frame Number  */
src\machines\machine_alpha.c:88: 	/*  a1 = PFN of current Level 1 page table  */
src\machines\machine_alpha.c:89: 	/*  a2 = Bootinfo magic  */
src\machines\machine_alpha.c:90: 	/*  a3 = Bootinfo pointer  */
src\machines\machine_alpha.c:91: 	/*  a4 = Bootinfo version  */
src\machines\machine_alpha.c:92: 	cpu->cd.alpha.r[ALPHA_A0] = 16*1024*1024 / 8192;
src\machines\machine_alpha.c:93: 	cpu->cd.alpha.r[ALPHA_A1] = 0;	/*  TODO  */
src\machines\machine_alpha.c:94: 	cpu->cd.alpha.r[ALPHA_A2] = 0;	/*  Note: NOT ALPHA_BOOTINFO_MAGIC  */
src\machines\machine_alpha.c:95: 	cpu->cd.alpha.r[ALPHA_A3] = 0;	/*  TODO  */
src\machines\machine_alpha.c:96: 	cpu->cd.alpha.r[ALPHA_A4] = 1;
src\machines\machine_alpha.c:97: 
src\machines\machine_alpha.c:98: 	/*
src\machines\machine_alpha.c:99: 	 *  HWRPB: Hardware Restart Parameter Block
src\machines\machine_alpha.c:100: 	 *
src\machines\machine_alpha.c:101: 	 *  TODO: Almost everything.
src\machines\machine_alpha.c:102: 	 */
src\machines\machine_alpha.c:103: 	memset(&rpb, 0, sizeof(struct rpb));
src\machines\machine_alpha.c:104: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:105: 	    &(rpb.rpb_phys), 0x14000);
src\machines\machine_alpha.c:106: 	strlcpy((char *)&(rpb.rpb_magic), "HWRPB", 8);
src\machines\machine_alpha.c:107: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:108: 	    &(rpb.rpb_version), HWRPB_DSRDB_MINVERS);
src\machines\machine_alpha.c:109: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:110: 	    &(rpb.rpb_size), sizeof(struct rpb));
src\machines\machine_alpha.c:111: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:112: 	    &(rpb.rpb_page_size), 8192);
src\machines\machine_alpha.c:113: 	strlcpy((char *)&(rpb.rpb_ssn), "123456789", 10);
src\machines\machine_alpha.c:114: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:115: 	    &(rpb.rpb_type), machine->machine_subtype);
src\machines\machine_alpha.c:116: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:117: 	    &(rpb.rpb_cc_freq), machine->emulated_hz);
src\machines\machine_alpha.c:118: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:119: 	    &(rpb.rpb_intr_freq), 1024 << 12);
src\machines\machine_alpha.c:120: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:121: 	    &(rpb.rpb_pcs_cnt), machine->ncpus);
src\machines\machine_alpha.c:122: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:123: 	    &(rpb.rpb_pcs_size), sizeof(struct pcs));
src\machines\machine_alpha.c:124: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:125: 	    &(rpb.rpb_pcs_off), PCS_ADDR - HWRPB_ADDR);
src\machines\machine_alpha.c:126: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:127: 	    &(rpb.rpb_ctb_off), CTB_ADDR - HWRPB_ADDR);
src\machines\machine_alpha.c:128: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:129: 	    &(rpb.rpb_crb_off), CRB_ADDR - HWRPB_ADDR);
src\machines\machine_alpha.c:130: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:131: 	    &(rpb.rpb_memdat_off), MEMDAT_ADDR - HWRPB_ADDR);
src\machines\machine_alpha.c:132: 
src\machines\machine_alpha.c:133: 	/*  CTB: Console Terminal Block  */
src\machines\machine_alpha.c:134: 	memset(&ctb, 0, sizeof(struct ctb));
src\machines\machine_alpha.c:135: 	store_64bit_word_in_host(cpu, (unsigned char *)
src\machines\machine_alpha.c:136: 	    &(ctb.ctb_term_type), machine->x11_md.in_use?
src\machines\machine_alpha.c:137: 	    CTB_GRAPHICS : CTB_PRINTERPORT);
src\machines\machine_alpha.c:138: 
