src\core\interrupt.c:205: /*
src\core\interrupt.c:206:  *  interrupt_connect():
src\core\interrupt.c:207:  *
src\core\interrupt.c:208:  *  Increases the exclusive or nonexclusive nr or users of an interrupt.
src\core\interrupt.c:209:  */
src\core\interrupt.c:210: void interrupt_connect(struct interrupt *in, int exclusive)
src\core\interrupt.c:211: {
src\core\interrupt.c:212: 	int i;
src\core\interrupt.c:213: 
src\core\interrupt.c:214: #ifdef INTERRUPT_DEBUG
src\core\interrupt.c:215: 	printf("interrupt_connect(\"%s\")\n", in->name);
src\core\interrupt.c:216: #endif
src\core\interrupt.c:217: 
src\core\interrupt.c:218: 	if (in->name == NULL || in->name[0] == '\0')
src\core\interrupt.c:219: 		return;
src\core\interrupt.c:220: 
src\core\interrupt.c:221: 	for (i=0; i<nr_of_interrupt_handlers; i++) {
src\core\interrupt.c:222: 		if (strcmp(in->name, interrupt_handlers[i].templ.name) != 0)
src\core\interrupt.c:223: 			continue;
src\core\interrupt.c:224: 
src\core\interrupt.c:225: 		if (exclusive) {
src\core\interrupt.c:226: 			interrupt_handlers[i].nr_of_exclusive_users ++;
src\core\interrupt.c:227: 			if (interrupt_handlers[i].nr_of_exclusive_users > 1) {
src\core\interrupt.c:228: 				fatal("Fatal error in interrupt_connect(): "
src\core\interrupt.c:229: 				    "more than 1 exclusive user. Dumping "
src\core\interrupt.c:230: 				    "core for backtrace.\n");
src\core\interrupt.c:231: 				abort();
src\core\interrupt.c:232: 			}
src\core\interrupt.c:233: 		} else {
src\core\interrupt.c:234: 			interrupt_handlers[i].nr_of_nonexclusive_users ++;
src\core\interrupt.c:235: 		}
src\core\interrupt.c:236: 
src\core\interrupt.c:237: 		return;
src\core\interrupt.c:238: 	}
src\core\interrupt.c:239: 
src\core\interrupt.c:240: 	fatal("Internal error in interrupt_connect(): name '%s' not "
src\core\interrupt.c:241: 	    "found? Dumping core for debugging.\n", in->name);
src\core\interrupt.c:242: 	abort();
src\core\interrupt.c:243: }
