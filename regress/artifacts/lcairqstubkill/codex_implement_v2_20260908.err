src\core\interrupt.c:112: /*
src\core\interrupt.c:113:  *  interrupt_handler_remove():
src\core\interrupt.c:114:  *
src\core\interrupt.c:115:  *  Remove an interrupt handler from the interrupt subsystem. If there are
src\core\interrupt.c:116:  *  still connected users of this interrupt, then an error message is printed
src\core\interrupt.c:117:  *  and the emulator aborts.
src\core\interrupt.c:118:  */
src\core\interrupt.c:119: void interrupt_handler_remove(const char *name)
src\core\interrupt.c:120: {
src\core\interrupt.c:121: 	int i;
src\core\interrupt.c:122: 
src\core\interrupt.c:123: #ifdef INTERRUPT_DEBUG
src\core\interrupt.c:124: 	printf("interrupt_handler_remove(\"%s\")\n", name);
src\core\interrupt.c:125: #endif
src\core\interrupt.c:126: 
src\core\interrupt.c:127: 	for (i=0; i<nr_of_interrupt_handlers; i++) {
src\core\interrupt.c:128: 		if (strcmp(name, interrupt_handlers[i].templ.name) != 0)
src\core\interrupt.c:129: 			continue;
src\core\interrupt.c:130: 
src\core\interrupt.c:131: 		/*
src\core\interrupt.c:132: 		 *  Remove handler i, and return:
src\core\interrupt.c:133: 		 */
src\core\interrupt.c:134: 		if (interrupt_handlers[i].nr_of_exclusive_users > 0 ||
src\core\interrupt.c:135: 		    interrupt_handlers[i].nr_of_nonexclusive_users > 0) {
src\core\interrupt.c:136: 			fatal("interrupt_handler_remove(): Attempt to "
src\core\interrupt.c:137: 			    "remove interrupt handler '%s' which has %i "
src\core\interrupt.c:138: 			    "exclusive and %i non-exclusive users. Aborting.\n",
src\core\interrupt.c:139: 			    name, interrupt_handlers[i].nr_of_exclusive_users,
src\core\interrupt.c:140: 			    interrupt_handlers[i].nr_of_nonexclusive_users);
src\core\interrupt.c:141: 			exit(1);
src\core\interrupt.c:142: 		}
src\core\interrupt.c:143: 
src\core\interrupt.c:144: 		if (i != nr_of_interrupt_handlers-1)
src\core\interrupt.c:145: 			memcpy(&interrupt_handlers[i],
src\core\interrupt.c:146: 			    &interrupt_handlers[i + 1],
src\core\interrupt.c:147: 			    nr_of_interrupt_handlers - i - 1);
src\core\interrupt.c:148: 
src\core\interrupt.c:149: 		nr_of_interrupt_handlers --;
src\core\interrupt.c:150: 
src\core\interrupt.c:151: 		return;
src\core\interrupt.c:152: 	}
src\core\interrupt.c:153: 
src\core\interrupt.c:154: 	fatal("interrupt_handler_remove(): '%s' not found? Aborting.\n", name);
src\core\interrupt.c:155: 	exit(1);
src\core\interrupt.c:156: }
src\core\interrupt.c:157: 
src\core\interrupt.c:158: 
src\core\interrupt.c:159: /*
src\core\interrupt.c:160:  *  interrupt_handler_lookup():
src\core\interrupt.c:161:  *
src\core\interrupt.c:162:  *  Scans the list of registered interrupt handlers for a given name. If the
src\core\interrupt.c:163:  *  name is found, the template is filled with valid data, and 1 is returned.
src\core\interrupt.c:164:  *  If the name is not found, 0 is returned.
src\core\interrupt.c:165:  */
src\core\interrupt.c:166: int interrupt_handler_lookup(const char *name, struct interrupt *templ)
src\core\interrupt.c:167: {
src\core\interrupt.c:168: 	int i;
src\core\interrupt.c:169: 
src\core\interrupt.c:170: #ifdef INTERRUPT_DEBUG
src\core\interrupt.c:171: 	printf("interrupt_handler_lookup(\"%s\")\n", name);
src\core\interrupt.c:172: #endif
src\core\interrupt.c:173: 
src\core\interrupt.c:174: 	if (name[0] == '\0') {
src\core\interrupt.c:175: 		/*  No interrupt:  */
src\core\interrupt.c:176: 		memset(templ, 0, sizeof(struct interrupt));
src\core\interrupt.c:177: 		templ->interrupt_assert = no_interrupt_assert;
src\core\interrupt.c:178: 		templ->interrupt_deassert = no_interrupt_deassert;
src\core\interrupt.c:179: 	}
src\core\interrupt.c:180: 
src\core\interrupt.c:181: 	for (i=0; i<nr_of_interrupt_handlers; i++) {
src\core\interrupt.c:182: 		if (strcmp(name, interrupt_handlers[i].templ.name) != 0)
src\core\interrupt.c:183: 			continue;
src\core\interrupt.c:184: 
src\core\interrupt.c:185: 		*templ = interrupt_handlers[i].templ;
src\core\interrupt.c:186: 		return 1;
src\core\interrupt.c:187: 	}
src\core\interrupt.c:188: 
src\core\interrupt.c:189: 	/*  The 'if' is an ugly hack to prevent a Compaq CC warning.  */
src\core\interrupt.c:190: 	if (i >= nr_of_interrupt_handlers) {
src\core\interrupt.c:191: 		printf("interrupt_handler_lookup(\"%s\") failed.\n", name);
src\core\interrupt.c:192: 
src\core\interrupt.c:193: 		printf("Available handler paths are:\n");
src\core\interrupt.c:194: 		for (i=0; i<nr_of_interrupt_handlers; i++)
src\core\interrupt.c:195: 			printf("    %s\n", interrupt_handlers[i].templ.name);
src\core\interrupt.c:196: 
src\core\interrupt.c:197: 		printf("Aborting.\n");
src\core\interrupt.c:198: 		abort();
src\core\interrupt.c:199: 	}
src\core\interrupt.c:200: 
src\core\interrupt.c:201: 	return 0;
src\core\interrupt.c:202: }
src\core\interrupt.c:203: 
