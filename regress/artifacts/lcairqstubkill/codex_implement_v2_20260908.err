src\devices\dev_jazz.c:145: 	if ((d->int_asserted & PICA_TIMER_IRQ_MASK) && (d->int_enable_mask & R4030_EXT_IP6))
src\devices\dev_jazz.c:146: 		INTERRUPT_ASSERT(d->mips_irq_6);
src\devices\dev_jazz.c:147: }
