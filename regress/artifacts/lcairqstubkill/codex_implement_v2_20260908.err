src\core\interrupt.c:246: /*
src\core\interrupt.c:247:  *  interrupt_disconnect():
src\core\interrupt.c:248:  *
src\core\interrupt.c:249:  *  Decreases the exclusive or nonexclusive nr or users of an interrupt.
src\core\interrupt.c:250:  */
src\core\interrupt.c:251: void interrupt_disconnect(struct interrupt *in, int exclusive)
src\core\interrupt.c:252: {
src\core\interrupt.c:253: 	int i;
src\core\interrupt.c:254: 
src\core\interrupt.c:255: 	if (in->name == NULL || in->name[0] == '\0')
src\core\interrupt.c:256: 		return;
src\core\interrupt.c:257: 
src\core\interrupt.c:258: 	for (i=0; i<nr_of_interrupt_handlers; i++) {
src\core\interrupt.c:259: 		if (strcmp(in->name, interrupt_handlers[i].templ.name) != 0)
src\core\interrupt.c:260: 			continue;
src\core\interrupt.c:261: 
src\core\interrupt.c:262: 		if (exclusive) {
src\core\interrupt.c:263: 			interrupt_handlers[i].nr_of_exclusive_users --;
src\core\interrupt.c:264: 			if (interrupt_handlers[i].nr_of_exclusive_users < 0) {
src\core\interrupt.c:265: 				fatal("Fatal error in interrupt_disconnect():"
src\core\interrupt.c:266: 				    "nr of exclusive users < 0?\n");
src\core\interrupt.c:267: 				exit(1);
src\core\interrupt.c:268: 			}
src\core\interrupt.c:269: 		} else {
src\core\interrupt.c:270: 			interrupt_handlers[i].nr_of_nonexclusive_users --;
src\core\interrupt.c:271: 			if (interrupt_handlers[i].nr_of_nonexclusive_users<0) {
src\core\interrupt.c:272: 				fatal("Fatal error in interrupt_disconnect():"
src\core\interrupt.c:273: 				    "nr of non-exclusive users < 0?\n");
src\core\interrupt.c:274: 				exit(1);
src\core\interrupt.c:275: 			}
