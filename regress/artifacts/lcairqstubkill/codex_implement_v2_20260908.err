src\devices\dev_v3.c:144:             (*d->ptr_to_pending_timer_interrupts) > 0)
src\devices\dev_v3.c:145:                 (*d->ptr_to_pending_timer_interrupts) --;
src\devices\dev_v3.c:146: 
src\devices\dev_v3.c:147: 	v3_isa_interrupt_common(d, old_isa_assert);
