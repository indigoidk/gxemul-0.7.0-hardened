src\devices\dev_lca.c:354: 		if (writeflag == MEM_WRITE)
src\devices\dev_lca.c:355: 			fatal(": 0x%" PRIx64, (uint64_t)idata);	/*  #506  */
src\devices\dev_lca.c:356: 		fatal(" ]\n");
