275: 			// Update all variables in the pcb simultaneously:
276: 			cpu->cd.alpha.pcb.apcb_ksp = new_ksp;
277: 			cpu->cd.alpha.pcb.apcb_usp = new_usp;
278: 			cpu->cd.alpha.pcb.apcb_ptbr = new_ptbr;
279: 			cpu->cd.alpha.pcb.apcb_cpc = new_cpc;
280: 			cpu->cd.alpha.pcb.apcb_asn = new_asn;
281: 			cpu->cd.alpha.pcb.apcb_unique = new_unique;
282: 			/*  #507: was `apcb_ptbr = new_flags' -- a field-name transposition that
283: 			    assigned apcb_ptbr TWICE (here and at the `apcb_ptbr = new_ptbr' four
284: 			    lines above -- "three lines up" until 2026-09-07, corrected
285: 			    after a pass-2 seat derived the true distance from the hunk
286: 			    header alone and called the phrasing inconsistent) and apcb_flags NEVER,
287: 			    while every other field in this block is assigned exactly once.  Two
288: 			    consequences: apcb_ptbr ended up holding the flags word, and the incoming
289: 			    context's flags were dropped -- so the NEXT save published a never-loaded
290: 			    word back into the outgoing PCB, wiping what the guest planted.  */
291: 			cpu->cd.alpha.pcb.apcb_flags = new_flags;	/*  #507  */
292: 			cpu->cd.alpha.pcb.apcb_decrsv0 = new_decrsv0;
293: 			cpu->cd.alpha.pcb.apcb_decrsv1 = new_decrsv1;
294: 
295: 			// TODO: Don't invalidate EVERYTHING!
