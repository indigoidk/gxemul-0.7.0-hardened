src\devices\dev_lca.c:374: 	memset(d, 0, sizeof(struct lca_data));
src\devices\dev_lca.c:375: 
src\devices\dev_lca.c:376: 	/*  Register a PCI bus:  */
src\devices\dev_lca.c:377: 	d->pci_data = bus_pci_init(
src\devices\dev_lca.c:378: 	    devinit->machine,
src\devices\dev_lca.c:379: 	    "TODO: irq"		/*  pciirq: TODO  */,
src\devices\dev_lca.c:380: 	    LCA_PCI_SIO,	/*  pci device io offset  */
src\devices\dev_lca.c:381: 	    0x00000000,		/*  pci device mem offset: TODO  */
src\devices\dev_lca.c:382: 	    0x00000000,		/*  PCI portbase: TODO  */
src\devices\dev_lca.c:383: 	    0x00000000,		/*  PCI membase: TODO  */
src\devices\dev_lca.c:384: 	    "TODO: pci irq base",	/*  PCI irqbase: TODO  */
src\devices\dev_lca.c:385: 	    LCA_ISA_BASE,	/*  ISA portbase  */
src\devices\dev_lca.c:386: 	    LCA_ISA_MEMBASE,	/*  ISA membase  */
src\devices\dev_lca.c:387: 	    "TODO: irqbase isa");                /*  ISA irqbase: TODO  */
src\devices\dev_lca.c:388: 
src\devices\dev_lca.c:389: 	/*  Add the "sio0" controller (as seen by NetBSD):  */
src\devices\dev_lca.c:390: 	bus_pci_add(devinit->machine, d->pci_data, devinit->machine->memory,
src\devices\dev_lca.c:391: 	    0, 7, 0, "i82378zb");
src\devices\dev_lca.c:392: 
src\devices\dev_lca.c:393: 	memory_device_register(devinit->machine->memory, "lca_pci_conf",
src\devices\dev_lca.c:394: 	    LCA_PCI_CONF, 0x20000000, dev_lca_pci_conf_access, (void *)d,
src\devices\dev_lca.c:395: 	    DM_DEFAULT, NULL);
src\devices\dev_lca.c:396: 
src\devices\dev_lca.c:397: 	memory_device_register(devinit->machine->memory, "lca_isa",
src\devices\dev_lca.c:398: 	    LCA_PCI_SIO, 0x10000 << 5, dev_lca_isa_access, (void *)d,
src\devices\dev_lca.c:399: 	    DM_DEFAULT, NULL);
src\devices\dev_lca.c:400: 
src\devices\dev_lca.c:401: 	memory_device_register(devinit->machine->memory, "lca_ioc",
src\devices\dev_lca.c:402: 	    LCA_IOC_BASE, 0x20000000, dev_lca_ioc_access, (void *)d,
src\devices\dev_lca.c:403: 	    DM_DEFAULT, NULL);
src\devices\dev_lca.c:404: 
src\devices\dev_lca.c:405: 	CHECK_ALLOCATION(interrupt_path = (char *)
src\devices\dev_lca.c:406: 	    malloc(strlen(devinit->machine->path) + 10));
src\devices\dev_lca.c:407: 	snprintf(interrupt_path, strlen(devinit->machine->path) + 10,
src\devices\dev_lca.c:408: 	    "%s.lca", devinit->machine->path);
src\devices\dev_lca.c:409: 
src\devices\dev_lca.c:410: 	memset(&interrupt_template, 0, sizeof(interrupt_template));
src\devices\dev_lca.c:411: 	interrupt_template.line = 0;
src\devices\dev_lca.c:412: 	interrupt_template.name = interrupt_path;
src\devices\dev_lca.c:413: 	interrupt_template.extra = d;
src\devices\dev_lca.c:414: 	interrupt_template.interrupt_assert = lca_interrupt_assert;
src\devices\dev_lca.c:415: 	interrupt_template.interrupt_deassert = lca_interrupt_deassert;
src\devices\dev_lca.c:416: 	interrupt_handler_register(&interrupt_template);
src\devices\dev_lca.c:417: 
src\devices\dev_lca.c:418: 	bus_isa_init(devinit->machine, interrupt_path,
src\devices\dev_lca.c:419: 	    BUS_ISA_IDE0 | BUS_ISA_IDE1, LCA_ISA_BASE, LCA_ISA_MEMBASE);
src\devices\dev_lca.c:420: 
src\devices\dev_lca.c:421: 	return 1;
src\devices\dev_lca.c:422: }
