src\devices\dev_jazz.c:122: void reassert_isa_interrupts(struct jazz_data *d)
src\devices\dev_jazz.c:123: {
src\devices\dev_jazz.c:124: 	/*  The R4030 EXT_IMASK IP4 bit is the CPU-IP-level enable for the ISA
src\devices\dev_jazz.c:125: 	    interrupt bridge (mips_irq_4).  Gate the ISA funnel on it, the same
src\devices\dev_jazz.c:126: 	    way the local-bus (IP3) and interval-timer (IP6) paths are gated in
src\devices\dev_jazz.c:127: 	    jazz_interrupt_assert()/deassert().  Without this gate an ISA device
src\devices\dev_jazz.c:128: 	    interrupt (e.g. the NE2000/ed0 at irq 9) would be delivered to the
src\devices\dev_jazz.c:129: 	    CPU while the guest has masked IP4 via spl(), causing re-entrancy.  */
src\devices\dev_jazz.c:130: 	if ((d->isa_int_asserted & d->isa_int_enable_mask)
src\devices\dev_jazz.c:131: 	    && (d->int_enable_mask & R4030_EXT_IP4))
src\devices\dev_jazz.c:132: 		INTERRUPT_ASSERT(d->mips_irq_4);
src\devices\dev_jazz.c:133: 	else
src\devices\dev_jazz.c:134: 		INTERRUPT_DEASSERT(d->mips_irq_4);
src\devices\dev_jazz.c:135: }
