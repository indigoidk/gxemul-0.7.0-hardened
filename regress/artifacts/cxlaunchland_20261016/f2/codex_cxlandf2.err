strip=lambda s: re.sub(r'\\x1b\\[[0-9;]*[A-Za-z]','',s)
def ran_v1(s):
 return next((x[6:].strip() for x in strip(s).split('\\n')[:40] if x.startswith('model:')),'')
def ran_v2(s):
 h=0; block=[]
 for line in strip(s).split('\\n'):
  if line.startswith('OpenAI Codex'):
   h=1; continue
  if h==1 and line.startswith('--------'):
   h=2; continue
  if h==2 and line.startswith('--------'):
   break
  if h==2: block.append(line)
 return next((x[6:].strip() for x in block if x.startswith('model:')),'')
print('N1 original v1/v2:',repr(ran_v1(raw)),repr(ran_v2(raw)))
a,b=ran_v1(stream),ran_v2(stream)
