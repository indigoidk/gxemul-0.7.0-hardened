+    #  its two column-0 `ERROR: You've hit your usage limit` lines come after them) -- Grok 4.7, pass 2, re-run here.
+    CXERR=$(strip_ansi "$ERR" | grep -a '^ERROR:')
     verd=$(grep -ic 'VERDICT' "$TXT" 2>/dev/null)
     body=$(wc -c < "$TXT")
     refus=0; wall=0
