 55: #
 56: #  Usage: cxlaunch.sh <brief-path> <out-dir> <tag>
 57: set -u
 58: BRIEF="$1"; OUT="$2"; TAG="$3"
 59: PROJ=/c/DocumentNoSnc/CC/GXEMUL
 60: CODEX="${CX_CODEX_BIN:-$HOME/AppData/Local/Programs/OpenAI/Codex/bin/codex}"
 61: MODEL="${CX_MODEL:-gpt-6-astra}"
 62: EFFORT="${CX_EFFORT:-ultra}"
 63: AUP_MODEL="${CX_AUP_MODEL-gpt-daybreak-blue-latest}"
 64: AUP_EFFORT="${CX_AUP_EFFORT:-ultra}"
 65: mkdir -p "$OUT"
 66: TXT="$OUT/codex_${TAG}.txt"; ERR="$OUT/codex_${TAG}.err"
 67: ESC=$(printf '\033')
 68: 
 69: sz=$(wc -c < "$BRIEF")
 70: echo "brief bytes: $sz"
 71: [ "$sz" -gt 30000 ] && { echo "*** above the argv cap -- use the pointer form"; exit 9; }
 72: 
 73: cd "$PROJ" || exit 9
 74: 
 75: strip_ansi() { sed "s/${ESC}\[[0-9;]*[A-Za-z]//g" "$1" 2>/dev/null; }
 76: 
 77: run_codex() {    # $1 model, $2 effort
 78:     "$CODEX" exec --sandbox read-only --skip-git-repo-check -m "$1" \
 79:         -c model_reasoning_effort="$2" "$(cat "$BRIEF")" > "$TXT" 2> "$ERR" < /dev/null
 80:     rc=$?
 81:     #  the header codex prints (in its first dozen stderr lines, before the brief and any streamed source) names the
 82:     #  model and effort it actually ran
 83:     RAN=$(strip_ansi "$ERR" | head -n 40 | grep -m1 '^model:' | sed 's/^model:[[:space:]]*//; s/[[:space:]]*$//')
 84:     echo "codex rc=$rc   stdout=$(wc -c < "$TXT") b   stderr=$(wc -c < "$ERR") b   asked: $1 / $2"
 85:     echo "  ran: ${RAN:+model: $RAN} / $(strip_ansi "$ERR" | head -n 40 | grep -m1 '^reasoning effort:')"
 86: }
 87: 
 88: #  CONTENT CHECK.  Verify by content, never by size -- and NOT by grepping stderr for codex's diagnostics alone.
 89: #
 90: #  *** MEASURED 2026-09-07, on the run that installed this file: codex STREAMS THE SOURCE IT READS into stderr, so a
 91: #  bare grep over stderr matches any file containing the words -- hence the `^ERROR:` anchor. ***
 92: #
 93: #  *** AND THE ANCHOR IS NOT ENOUGH.  MEASURED 2026-09-26: THREE REAL ANSWERS WERE REPORTED "SEAT WALLED" -- astra549
 94: #  (rc 0, 11,472 b), astra550 (rc 0, 4,265 b), rec529audit (rc 0, 13,442 b) -- because each read an old panel file
 95: #  whose lines BEGIN with a codex wall message ("ERROR: You've hit your usage limit ... 7:01 AM"), and codex streamed
 96: #  those lines into stderr at column 0.  A quoted marker re-arms the tool that reads it (the carrier's own rule). ***
 97: #
 98: #  So the discriminator is the EXIT STATUS and the ANSWER, which quoted text cannot forge.  stderr's `ERROR:` lines are
 99: #  classified ONLY WHEN rc != 0 OR stdout IS EMPTY; rc 0 with a non-empty stdout is an ANSWER, whatever stderr quotes.
100: #  Every real wall and refusal on record is rc 1 with an EMPTY stdout, and every rc-0 run carries an answer: 362 + 25
101: #  of 387 launch lines, nothing off that diagonal (launchlog_census.txt) -- the residuals above are the off-diagonal.
102: classify() {
103:     CXERR=$(strip_ansi "$ERR" | grep '^ERROR:')
104:     verd=$(grep -ic 'VERDICT' "$TXT" 2>/dev/null)
105:     body=$(wc -c < "$TXT")
106:     refus=0; wall=0
107:     if [ "$rc" -ne 0 ] || [ "$body" -eq 0 ]; then
108:         refus=$(printf '%s' "$CXERR" | grep -ic 'flagged for possible cybersecurity\|cannot help with\|can.t help with\|I won.t help')
109:         wall=$(printf '%s' "$CXERR" | grep -ic 'usage limit\|quota\|rate limit\|not authenticated')
110:     else
111:         q=$(printf '%s' "$CXERR" | grep -c .)
112:         [ "$q" -gt 0 ] && echo "  note: $q ERROR:-shaped line(s) in stderr IGNORED -- rc 0 with an answer, so they are quoted source"
113:     fi
114:     echo "  verdict-in-stdout: $verd   refusal: $refus   wall: $wall   (classified only when rc != 0 or stdout is empty)"
115: }
116: 
117: run_codex "$MODEL" "$EFFORT"; classify
118: ANSWERED_BY="$MODEL"
119: 
120: if [ "$refus" -gt 0 ] && [ -n "$AUP_MODEL" ] && [ "$AUP_MODEL" != "$MODEL" ]; then
