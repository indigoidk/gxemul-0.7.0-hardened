1: #!/bin/bash
2: #  A codex launcher that CANNOT report a refused seat as a clean run.
3: #
4: #  *** THE TWO DEFECTS THIS REPLACES, both mine, both measured 2026-09-07 on the lcaconfwidth
5: #  census. ***
6: #    1. The content check grepped the .txt for refusal text.  A codex CONTENT-FILTER REFUSAL writes
7: #       NOTHING to stdout and puts "ERROR: This content was flagged..." on STDERR -- so the check
8: #       reported `refusal hits: 0` on a refusal.  A check that looks in the wrong stream answers the
9: #       same whether or not the thing it tests is true.
10: #    2. The script ended on a successful command, so it exited 0 while holding `codex rc=1`.  The
11: #       harness then reported the task as COMPLETED.  A failure laundered into a clean completion.
12: #
13: #  *** LANDED HERE 2026-10-16 (ledger `cxlaunchquotation`; ruled by Fable 5.1, GPT-6 Astra and Grok 4.7 in
14: #  regress/artifacts/adj_20261016/RULINGS_C_records.md, F1).  Until then THIS file ran Astra at `max` with the
15: #  2026-09-07 classifier, while most farm jobs ran an UNTRACKED scratchpad copy (cxlaunch_u.sh) carrying the two
16: #  owner directives of 2026-09-26 -- and the carrier described the copy's behaviour as this file's.  Not every job
17: #  ran the copy: the 2026-10-09 asicconverge confirm used the old classifier and reported an rc-0, 10,466-byte answer
18: #  as WALLED (fablequeue8n_20261009/astra_confirm/cxlaunch_asicconverge_stdout.txt). ***
19: #    1. "Astra (ultra) can replace codex 5.6 sol" -- the effort is `ultra`.  MEASURED 2026-09-26 before use: the
20: #       server's enum lists 'none'..'xhigh','max' and rejects a bogus value with 400 invalid_enum_value; `ultra` is
21: #       accepted (rc 0, header `reasoning effort: ultra`, liveness token and a verbatim CHECKPOINT.md quote returned).
22: #       The CLI's own model cache describes it as "Maximum reasoning with automatic task delegation" -- max plus
23: #       delegation, so it is a CLI tier above max, not a server one.
24: #    2. "use daybreak ... if encountering AUP error" -- on a content-filter refusal (codex's own `ERROR: This content
25: #       was flagged for possible cybersecurity risk` on stderr) the brief is re-run ONCE on the Daybreak model
26: #       (gpt-daybreak-blue-latest, the CLI's only Daybreak slug: "frontier agentic coding model for broad defensive
27: #       cybersecurity work"; liveness-verified 2026-09-26).  The refused run's files are KEPT as
28: #       codex_<tag>.refused.{txt,err}, and the log names which model answered -- a Daybreak answer is recorded as
29: #       Daybreak's, never as Astra's.  The receipt of the fallback firing on a REAL refusal is
30: #       regress/artifacts/codexpack_20260928/dossier_gdromdma/dossier_gdromdma.launch.log; the controls below test
31: #       the classifier on fixtures, which is a different claim.
32: #    3. (2026-10-16, Fable 5.1) codex's diagnostics are matched AFTER ANSI colour is stripped.  7 of 453 panel.sh
33: #       codex.txt files carry a column-0 `ERROR:` coloured as ESC[1m ESC[31m ERROR: ESC[0m
34: #       (adj_20261016/fable5/meas_C/ansi_census.txt; 0 of 593 launcher .err files), and one is a REAL codex refusal:
35: #       _scratchpad/panel_20260919_013302/codex_adv540p2.REFUSED1.err, where `grep '^ERROR:'` finds 0 lines unstripped
36: #       and 2 stripped.  Unstripped, such a run reads exit 6 "seat down" (Fable's Q3 is the wall-shaped twin).
37: #    4. (2026-10-16, GPT-6 Astra) the `model:` line of codex's HEADER BLOCK is COMPARED to the model asked for.  This
38: #       file printed both and compared neither, so "a wrong name is a SEAT FAILURE" was unenforced.  On record: 322
39: #       asked/ran pairs across 519 launch logs under the project root, 319 across 493 inside GXEMUL-SEC (Astra), no
40: #       header absent and no mismatch -- so a mismatch is new, and it exits 5.  Only the OPENING header block is read
41: #       (pass 2 and the adjudication pass, Astra): a `model:` line anywhere else in stderr is streamed source or the
42: #       brief -- it can name a model, and it is never READ (GLM 5.3 and Grok 4.7, v3 pass).
43: #
44: #  KNOWN RESIDUALS -- recorded, NOT fixed (the ruling's own wording; no real run has either shape, 0 of 387 launch
45: #  lines are off the diagonal of {rc 0 with stdout, rc 1 with empty stdout} -- adj_20261016/fable5/meas_C/
46: #  launchlog_census.txt):
47: #    * rc != 0 WITH an answer AND column-0 quoted wall text -> exit 8 (fixture N4).  Reading only codex's LAST
48: #      `ERROR:` line does not fix it: in N4 that line is itself a quotation.
49: #    * its refusal twin: a quoted `flagged for possible cybersecurity` line on rc != 0 -> the Daybreak re-run fires
50: #      and the first answer is renamed codex_<tag>.refused.* (Grok 4.7).
51: #    * a run whose stderr carries NO opening codex header block is reported "model UNVERIFIED" and is not failed -- 0 of
52: #      330 launcher-captured answered runs on record lack it (counted on pass 2); failing it would lose every answer to a
53: #      CLI format change.  A block whose closing rule never comes is read for 30 lines at most.
54: #    * the ANSI strip widens both residuals above to colour-prefixed quoted lines on a failed or empty run (GLM 5.3,
55: #      pass 2): a quoted line whose only prefix was colour becomes column-0 -- still inside the classify-on-failure gate.
56: #    * a REFUSED first run's header is printed (`ran:`) but not compared; its answer is discarded, and the fallback's
57: #      own run is the one compared (GLM 5.3, pass 2).
58: #    * exit 5 is new to callers: the farm's pack runner special-cases 7 and 8 only, so it RETRIES a 5 rather than
59: #      recording an answer (Grok 4.7, pass 2) -- a different model having answered is not an answer from this seat.
60: #
61: #  Overrides, each only so the branches are testable without the network: CX_MODEL, CX_EFFORT, CX_AUP_MODEL (set it
62: #  EMPTY to disable the fallback), CX_AUP_EFFORT, CX_CODEX_BIN.
63: #
64: #  Exit status: 0 answered; 5 a different model ran; 6 empty stdout with no refusal or wall text; 7 refused (after
65: #  the fallback, if any); 8 walled; 9 the brief is above the argv cap or the project dir is missing; otherwise
66: #  codex's own nonzero rc.  An answered run whose model is unverified still exits 0, and says so instead of naming
67: #  a model.  Controls: regress/artifacts/cxlaunchland_20261016/run_controls_v4.sh (RECEIPT_v4.txt; the kill table is
68: #  KILLTABLE_v4.txt; its header is the CONTRACT -- which edge of each decision this file makes is pinned, and which is
69: #  deliberately not).  RECEIPT.txt, RECEIPT_v2.txt and RECEIPT_v3.txt are the receipts of the earlier versions.
70: #
71: #  Usage: cxlaunch.sh <brief-path> <out-dir> <tag>
72: set -u
73: BRIEF="$1"; OUT="$2"; TAG="$3"
74: PROJ=/c/DocumentNoSnc/CC/GXEMUL
75: CODEX="${CX_CODEX_BIN:-$HOME/AppData/Local/Programs/OpenAI/Codex/bin/codex}"
76: MODEL="${CX_MODEL:-gpt-6-astra}"
77: EFFORT="${CX_EFFORT:-ultra}"
78: AUP_MODEL="${CX_AUP_MODEL-gpt-daybreak-blue-latest}"
79: AUP_EFFORT="${CX_AUP_EFFORT:-ultra}"
80: mkdir -p "$OUT"
81: TXT="$OUT/codex_${TAG}.txt"; ERR="$OUT/codex_${TAG}.err"
82: ESC=$(printf '\033')
83: 
84: sz=$(wc -c < "$BRIEF")
85: echo "brief bytes: $sz"
86: [ "$sz" -gt 30000 ] && { echo "*** above the argv cap -- use the pointer form"; exit 9; }
87: 
88: cd "$PROJ" || exit 9
89: 
90: strip_ansi() { sed "s/${ESC}\[[0-9;]*[A-Za-z]//g" "$1" 2>/dev/null; }
91: 
92: run_codex() {    # $1 model, $2 effort
93:     "$CODEX" exec --sandbox read-only --skip-git-repo-check -m "$1" \
94:         -c model_reasoning_effort="$2" "$(cat "$BRIEF")" > "$TXT" 2> "$ERR" < /dev/null
95:     rc=$?
96:     #  codex's OPENING header block -- `OpenAI Codex vX`, then the lines between the next two `--------` rules -- names the
97:     #  model and effort it actually ran.  Read only that block, and only at the TOP of stderr: the banner and its first
98:     #  rule must appear by line 12 and the block is read for at most 30 lines.  On record the block's `model:` line is
99:     #  line 5 of stderr in 599 of 600 codex .err files and line 7 in one (two pre-header lines; Astra).  A `model:` line
100:     #  anywhere else is streamed source or the brief and is never READ -- including a complete QUOTED header block, which
101:     #  N1's own stderr carries at line 5528 (GPT-6 Astra, adjudication pass: v2 matched the banner anywhere).
102:     HDR=$(strip_ansi "$ERR" | awk 'NR > 12 && h < 2 { exit }
103:         h == 0 && /^OpenAI Codex/ { h = 1; next }
104:         h == 1 && /^--------/ { h = 2; next }
105:         h == 2 && /^--------/ { exit }
106:         h == 2 { if (++n > 30) exit; print }')
107:     RAN=$(printf '%s\n' "$HDR" | grep -m1 '^model:' | sed 's/^model:[[:space:]]*//; s/[[:space:]]*$//')
108:     echo "codex rc=$rc   stdout=$(wc -c < "$TXT") b   stderr=$(wc -c < "$ERR") b   asked: $1 / $2"
109:     echo "  ran: ${RAN:+model: $RAN} / $(printf '%s\n' "$HDR" | grep -m1 '^reasoning effort:')"
110: }
111: 
112: #  CONTENT CHECK.  Verify by content, never by size -- and NOT by grepping stderr for codex's diagnostics alone.
113: #
114: #  *** MEASURED 2026-09-07, on the run that installed this file: codex STREAMS THE SOURCE IT READS into stderr, so a
115: #  bare grep over stderr matches any file containing the words -- hence the `^ERROR:` anchor. ***
116: #
117: #  *** AND THE ANCHOR IS NOT ENOUGH.  MEASURED 2026-09-26: THREE REAL ANSWERS WERE REPORTED "SEAT WALLED" -- astra549
118: #  (rc 0, 11,472 b), astra550 (rc 0, 4,265 b), rec529audit (rc 0, 13,442 b) -- because each read an old panel file
119: #  whose lines BEGIN with a codex wall message ("ERROR: You've hit your usage limit ... 7:01 AM"), and codex streamed
120: #  those lines into stderr at column 0.  A quoted marker re-arms the tool that reads it (the carrier's own rule). ***
121: #
122: #  So the discriminator is the EXIT STATUS and the ANSWER, which quoted text cannot forge.  stderr's `ERROR:` lines are
123: #  classified ONLY WHEN rc != 0 OR stdout IS EMPTY; rc 0 with a non-empty stdout is an ANSWER, whatever stderr quotes.
124: #  Every real wall and refusal on record is rc 1 with an EMPTY stdout, and every rc-0 run carries an answer: 362 + 25
125: #  of 387 launch lines, nothing off that diagonal (launchlog_census.txt) -- the residuals above are the off-diagonal.
126: classify() {
127:     #  `grep -a`: a stderr carrying a NUL byte is "binary" to grep, which then prints `Binary file (standard input)
128:     #  matches` instead of the lines.  A real wall was recorded exit 6 "seat down" that way:
129:     #  _scratchpad/cxfarm3_20260919/out/codex_l1_batterypreflight.err (rc 1, empty stdout, 1,449 NULs from byte 2,318,517;
130:     #  its two column-0 `ERROR: You've hit your usage limit` lines come after them) -- Grok 4.7, pass 2, re-run here.
131:     CXERR=$(strip_ansi "$ERR" | grep -a '^ERROR:')
132:     verd=$(grep -ic 'VERDICT' "$TXT" 2>/dev/null)
133:     body=$(wc -c < "$TXT")
134:     refus=0; wall=0
135:     if [ "$rc" -ne 0 ] || [ "$body" -eq 0 ]; then
136:         refus=$(printf '%s' "$CXERR" | grep -ic 'flagged for possible cybersecurity\|cannot help with\|can.t help with\|I won.t help')
137:         wall=$(printf '%s' "$CXERR" | grep -ic 'usage limit\|quota\|rate limit\|not authenticated')
138:     else
139:         q=$(printf '%s' "$CXERR" | grep -c .)
140:         [ "$q" -gt 0 ] && echo "  note: $q ERROR:-shaped line(s) in stderr IGNORED -- rc 0 with an answer, so they are quoted source"
141:     fi
142:     echo "  verdict-in-stdout: $verd   refusal: $refus   wall: $wall   (classified only when rc != 0 or stdout is empty)"
143: }
144: 
145: run_codex "$MODEL" "$EFFORT"; classify
146: ANSWERED_BY="$MODEL"
147: 
148: if [ "$refus" -gt 0 ] && [ -n "$AUP_MODEL" ] && [ "$AUP_MODEL" != "$MODEL" ]; then
149:     echo "  *** SEAT REFUSED on $MODEL (content filter):"
150:     printf '%s\n' "$CXERR" | grep -m1 -i 'flagged for possible cybersecurity' | cut -c1-160 | sed 's/^/    /'
151:     mv -f "$TXT" "$OUT/codex_${TAG}.refused.txt"; mv -f "$ERR" "$OUT/codex_${TAG}.refused.err"
152:     echo "  *** AUP FALLBACK: re-running ONCE on $AUP_MODEL / $AUP_EFFORT (the refused run is kept as codex_${TAG}.refused.*)"
153:     run_codex "$AUP_MODEL" "$AUP_EFFORT"; classify
154:     ANSWERED_BY="$AUP_MODEL"
155: fi
156: 
157: if [ "$refus" -gt 0 ]; then
158:     echo "  *** SEAT REFUSED (content filter) on $ANSWERED_BY.  The answer is LOST, whatever the token count says."
159:     printf '%s\n' "$CXERR" | grep -m2 -i 'flagged for possible cybersecurity' | cut -c1-160 | sed 's/^/    /'
160:     echo "  *** REPHRASE (neutral test-coverage wording) or ROUTE THIS BRIEF TO GROK."
161:     exit 7
162: fi
163: if [ "$wall" -gt 0 ]; then echo "  *** SEAT WALLED ($ANSWERED_BY)."; exit 8; fi
164: if [ "$body" -eq 0 ]; then echo "  *** EMPTY STDOUT with no refusal/wall text -- seat down, cause NOT established."; exit 6; fi
165: if [ -n "$RAN" ] && [ "$RAN" != "$ANSWERED_BY" ]; then
166:     echo "  *** A DIFFERENT MODEL RAN: asked $ANSWERED_BY, codex's header says $RAN -- a SEAT FAILURE; the answer is not $ANSWERED_BY's."
167:     exit 5
168: fi
169: if [ "$rc" -ne 0 ];  then echo "  *** codex exited $rc -- NOT a clean run."; exit "$rc"; fi
170: if [ -z "$RAN" ]; then
171:     echo "  seat answered -- model UNVERIFIED: no codex header block in stderr (requested: $ANSWERED_BY)"
172: else
173:     echo "  seat answered. (answered by: $ANSWERED_BY)"
174: fi

