1: #!/bin/bash
2: #  The controls' KILL TABLE: every one-edit mutant of the landed launcher (mut_launcher_v4.py) run through run_controls_v4.sh as the
3: #  AFTER column.  A pinned mutant must turn at least one AFTER expectation red, and it must be the control its line names;
4: #  an UNPINNED one is measured too, so its escape is a recorded result rather than a guess.
5: #  Usage: bash run_mutants_v4.sh [launcher]     (default: tools/cxlaunch.sh; writes only to a scratch dir it removes)
6: set -u
7: HERE=$(cd "$(dirname "$0")" && pwd)
8: REPO=$(cd "$HERE/../../.." && pwd)
9: L="${1:-$REPO/tools/cxlaunch.sh}"
10: M=$(mktemp -d)
11: trap 'rm -rf "$M"' EXIT
12: PYW=$(command -v python || command -v python3)
13: "$PYW" "$HERE/mut_launcher_v4.py" "$(cygpath -w "$L" 2>/dev/null || echo "$L")" "$(cygpath -w "$M" 2>/dev/null || echo "$M")" || { echo "APPARATUS FAIL: mutant generation"; exit 9; }
14: echo "# kill table for $L ($(md5sum < "$L" | cut -c1-32)), $(date '+%Y-%m-%d %H:%M:%S')"
15: CXL_AFTER="$L" bash "$HERE/run_controls_v4.sh" > "$M/base.out" 2>&1
16: echo "BASE      $(grep '^CONTROLS:' "$M/base.out")"
17: grep -q 'CXLAND_CONTROLS_DONE' "$M/base.out" && grep -q '^CONTROLS: \([0-9]*\)/\1 ' "$M/base.out" || { echo "APPARATUS FAIL: the base run is not clean"; exit 9; }
18: ok=0; n=0
19: while IFS="$(printf '\t')" read -r name catches; do
20:     CXL_AFTER="$M/$name.sh" bash "$HERE/run_controls_v4.sh" > "$M/$name.out" 2>&1
21:     tally=$(grep '^CONTROLS:' "$M/$name.out" | cut -d' ' -f2)
22:     #  row names run to three characters (X10): `[0-9A-Z]*', not `?'
23:     red=$(grep -E '^[A-Z][0-9A-Z]* +after +exit=.*NO$|^[A-Z][0-9A-Z]* +after +.*  NO$' "$M/$name.out" | awk '{print $1}' | sort -u | tr '\n' ' ')
24:     n=$((n + 1))
25:     case "$catches" in
26:         UNPINNED*) verdict=$([ -z "$red" ] && echo "escapes (as recorded)" || echo "CAUGHT by: $red(unexpected)"); [ -z "$red" ] && ok=$((ok + 1)) ;;
27:         *) miss=""; for c in $catches; do case " $red " in *" $c "*) ;; *) miss="$miss $c";; esac; done
28:            if [ -n "$red" ] && [ -z "$miss" ]; then verdict="killed by: $red"; ok=$((ok + 1)); else verdict="NOT KILLED as named (red: ${red:-none}; missing:$miss)"; fi ;;
29:     esac
30:     printf '%-13s %-8s %-62s %s\n' "$name" "$tally" "$verdict" "[$catches]"
31: done < "$M/MUTANTS.list"
32: echo "KILL TABLE: $ok/$n as recorded"
33: echo "CXLAND_MUTANTS_DONE"
34: [ "$ok" = "$n" ]

