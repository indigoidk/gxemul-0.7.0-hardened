1: #!/usr/bin/env python3
2: """census_v4.py [root ...] -- the on-record shapes behind the v4 contract's DISCLOSED lines (2026-10-17, the v3 pass's
3: findings).  Reads every codex*.err under the roots (default: GXEMUL-SEC and _scratchpad, beside this repo) and reports:
4:   * opening header blocks found by the landed launcher's rule (banner and first rule by line 12, closing rule within the
5:     block) -- how many lack a `model:' line, carry two or more, or never close within the read; and how many files show a
6:     banner in their first 200 lines WITHOUT an opening block (a late or displaced header);
7:   * the classification population -- runs whose sibling .txt is empty or absent -- and how many of those carry BOTH a
8:     column-0 refusal `ERROR:' line and a column-0 wall `ERROR:' line (after the ANSI strip), which is the only shape on
9:     which the refusal-before-wall precedence (m_prec) is observable.
10: Read-only.  Prints its denominators beside every count."""
11: import os, re, sys
12: 
13: HERE = os.path.dirname(os.path.abspath(__file__))
14: PROJ = os.path.abspath(os.path.join(HERE, os.pardir, os.pardir, os.pardir, os.pardir))
15: roots = sys.argv[1:] or [os.path.join(PROJ, "GXEMUL-SEC"), os.path.join(PROJ, "_scratchpad")]
16: ESC = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
17: REF = re.compile(r"flagged for possible cybersecurity|cannot help with|can.t help with|I won.t help", re.I)
18: WAL = re.compile(r"usage limit|quota|rate limit|not authenticated", re.I)
19: n_err = blocks = nomodel = twomodel = unclosed = late = cls = both = 0
20: both_files = []
21: for root in roots:
22:     for dp, dn, fn in os.walk(root):
23:         if os.sep + ".git" in dp or dp.endswith(".git"):
24:             continue
25:         for f in fn:
26:             if not (f.endswith(".err") and "codex" in f.lower()):
27:                 continue
28:             p = os.path.join(dp, f)
29:             try:
30:                 raw = open(p, "rb").read()
31:             except OSError:
32:                 continue
33:             n_err += 1
34:             lines = ESC.sub("", raw.decode("utf-8", "replace")).split("\n")
35:             h = 0; body = []; closed = False
36:             for i, l in enumerate(lines, 1):
37:                 if i > 12 and h < 2:
38:                     break
39:                 if h == 0 and l.startswith("OpenAI Codex"):
40:                     h = 1; continue
41:                 if h == 1 and l.startswith("--------"):
42:                     h = 2; continue
43:                 if h == 2 and l.startswith("--------"):
44:                     closed = True; break
45:                 if h == 2:
46:                     body.append(l)
47:             if h == 2:
48:                 blocks += 1
49:                 m = sum(1 for l in body if l.startswith("model:"))
50:                 nomodel += m == 0
51:                 twomodel += m > 1
52:                 unclosed += not closed
53:             elif any(l.startswith("OpenAI Codex") for l in lines[:200]):
54:                 late += 1
55:             t = p[:-4] + ".txt"
56:             if (not os.path.exists(t)) or os.path.getsize(t) == 0:
57:                 cls += 1
58:                 errl = [l for l in lines if l.startswith("ERROR:")]
59:                 if any(REF.search(l) for l in errl) and any(WAL.search(l) for l in errl):
60:                     both += 1; both_files.append(p)
61: print("roots: %s" % " ".join(roots))
62: print("codex .err files read: %d" % n_err)
63: print("opening blocks by the landed rule: %d of %d files | no model line: %d | two or more: %d | unclosed: %d"
64:       % (blocks, n_err, nomodel, twomodel, unclosed))
65: print("files with a banner in their first 200 lines but no opening block: %d of %d" % (late, n_err))
66: print("classification population (sibling .txt empty or absent): %d of %d | carrying BOTH a column-0 refusal and a "
67:       "column-0 wall ERROR line: %d" % (cls, n_err, both))
68: for b in both_files:
69:     print("  both: %s" % b)
70: print("CENSUS_V4_DONE")

