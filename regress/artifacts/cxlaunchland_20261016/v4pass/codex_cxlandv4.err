149: #  the fake codex: replays $FX (or $FX2 when the requested -m equals $FX2_MODEL) and logs its arguments to $FX_ARGS
150: cat > "$T/fakecodex.sh" <<'EOF'
151: #!/bin/bash
152: D="$FX"; prev=""
153: for a in "$@"; do
154:     if [ "$prev" = "-m" ] && [ -n "${FX2_MODEL:-}" ] && [ "$a" = "$FX2_MODEL" ]; then D="$FX2"; fi
155:     prev="$a"
156: done
157: [ -n "${FX_ARGS:-}" ] && { printf 'CALL\n'; for a in "$@"; do printf 'ARG %s\n' "$a"; done; } >> "$FX_ARGS"
158: cat "$D/stdout"; cat "$D/stderr" 1>&2; exit "$(cat "$D/rc")"
159: EOF
160: chmod +x "$T/fakecodex.sh"
161: #  the tracked launcher names $HOME/AppData/Local/Programs/OpenAI/Codex/bin/codex and reads no override, so give it a HOME
162: mkdir -p "$T/home/AppData/Local/Programs/OpenAI/Codex/bin"
163: cp "$T/fakecodex.sh" "$T/home/AppData/Local/Programs/OpenAI/Codex/bin/codex"
164: chmod +x "$T/home/AppData/Local/Programs/OpenAI/Codex/bin/codex"
165: printf 'control brief\n' > "$T/brief.md"
166: printf '%30000s' '' | tr ' ' b > "$T/brief30000.md"
167: printf '%30001s' '' | tr ' ' b > "$T/brief30001.md"
168: 
169: pass=0; total=0
170: run() {    # $1 row, $2 launcher label, $3 launcher, $4 expected exit, then env assignments
171:     local row="$1" lab="$2" sh="$3" want="$4"; shift 4
172:     local out="$T/out_${row}_${lab}"
173:     ( export CX_CODEX_BIN="$T/fakecodex.sh" FX2= FX2_MODEL= FX_ARGS="$T/args_${row}_${lab}"
174:       [ "$lab" = tracked ] && export HOME="$T/home"
175:       for kv in "$@"; do export "$kv"; done
176:       timeout 120 bash "$sh" "${BRIEF_OVERRIDE:-$T/brief.md}" "$out" "$row" ) > "$T/log_${row}_${lab}.txt" 2>&1
177:     local got=$?
178:     total=$((total + 1))
179:     local ok="NO"; [ "$got" = "$want" ] && { ok="ok"; pass=$((pass + 1)); }
180:     printf '%-3s %-7s exit=%-2s want=%-2s %s\n' "$row" "$lab" "$got" "$want" "$ok"
181:     sed 's/^/      /' "$T/log_${row}_${lab}.txt" | grep -v '^      brief bytes' | cut -c1-170
182: }
183: three() {    # $1 row, $2 want-tracked, $3 want-before, $4 want-after, then env
184:     local row="$1" wt="$2" wb="$3" wa="$4"; shift 4
185:     run "$row" tracked "$TRACKED" "$wt" "$@"
186:     run "$row" before "$BEFORE" "$wb" "$@"
187:     run "$row" after "$AFTER" "$wa" "$@"
188: }
189: check() {    # $1 label, $2 0/1 result
190:     total=$((total + 1))
191:     if [ "$2" = 0 ]; then pass=$((pass + 1)); echo "$1  ok"; else echo "$1  NO"; fi
192: }
