 346 printf '#!/bin/bash\n[ -n "${FX_ARGS:-}" ] && echo DEFAULT >> "$FX_ARGS.default"\nexec bash "%s" "$@"\n' "$T/fakecodex.sh" > "$DEFBIN/codex"
 347 chmod +x "$DEFBIN/codex"
 348 printf 'control brief\n' > "$T/brief.md"
