  870: #else
  871: 	const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
  872: 	const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
  873: 	const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
