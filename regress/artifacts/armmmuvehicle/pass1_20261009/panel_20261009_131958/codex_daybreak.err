  337: def dwords(buf):
  338:     """The words the LAST `dump` printed, in ADDRESS order, exactly as printed.
  339: 
  340:     `dump` renders raw bytes, so a little-endian 32-bit 0xac000000 stored at
  341:     DEST prints as 000000ac.  Anchored on the TWO spaces `dump` puts after the
  342:     address, which `put`'s echo (`0x8c010100: 11111111`) does not have.
  343:     """
  344:     m = re.findall(r"^\s*0x[0-9a-f]+  ((?:[0-9a-f]{8} )*[0-9a-f]{8})",
  345:                    (buf or "").replace("\r", ""), re.M)
  346:     return m[-1].split() if m else []
  347: 
  348: 
  349: def dumped(buf):
  350:     """The word at DEST itself -- w[0], not the last word on the line."""
  351:     w = dwords(buf)
  352:     return w[0] if w else None
  353: 
