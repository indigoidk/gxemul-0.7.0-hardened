  855: {
  856: #ifdef MODE32
  857: 	uint32_t
  858: #else
  859: 	uint64_t
  860: #endif
  861: 	    cached_pc = cpu->pc;
  862: 	struct DYNTRANS_TC_PHYSPAGE *ppp;
  863: 
  864: #ifdef MODE32
  865: 	int index;
  866: 	index = DYNTRANS_ADDR_TO_PAGENR(cached_pc);
  867: 	ppp = cpu->cd.DYNTRANS_ARCH.phys_page[index];
  868: 	if (ppp != NULL)
