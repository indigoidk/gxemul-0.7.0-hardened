  854: void DYNTRANS_PC_TO_POINTERS_FUNC(struct cpu *cpu)
  855: {
  856: #ifdef MODE32
  857: 	uint32_t
  858: #else
  859: 	uint64_t
  860: #endif
  861: 	    cached_pc = cpu->pc;
