1104:WORDS["ldm_r6_pc"] = 0xE8968000              # ldmia r6, {pc}        (non-S, PC)
1105:WORDS["ldm_r6_r0_s"] = 0xE8D60001            # ldmia r6, {r0}^       (S, no PC)
