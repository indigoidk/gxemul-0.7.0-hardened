=== GXEMUL-SEC/regress/sh4_chcr_witness.py ===
1:#!/usr/bin/env python3
2:"""`sh4chcr` WITNESS (rung 3): a guest CHCR write with TD=1 ends the HOST PROCESS,
3:on an UNMODIFIED in-tree `-E landisk`.
4:
5:*** THIS IS EASIER TO REACH THAN ANYTHING #447 REPAIRED. ***  Each of that round's four
6:guards needed the guest to write a SPECIFIC unimplemented bit.  These need only that the
7:guest ENABLE A DMA CHANNEL, because of how the two switches compose:
8:
9:    dev_sh4.c:1763-1775   the CHCR write STORES idata unconditionally, then
10:                          `if (idata & CHCR_TD) sh4_dmac_transfer(...)`
11:    dev_sh4.c:468-491     inside that call, ONLY `case 0x200:` survives the CHCR_RS
12:                          switch -- every other resource-select value reaches
13:                          `default: fatal(); exit(1);`
14:    dev_sh4.c:486         and with RS == 0x200, CHCR_IE reaches its own exit(1)
15:
16:So the reachable-and-fatal set is not a corner: it is nearly every CHCR value with TD set.
17:Three more exits sit above it on the same path -- TS (`:436`), DM (`:445`), SM (`:454`) --
18:each guarding a `default:` in a switch whose other arms are the legal encodings.
19:
20:WHAT THE STORE POSITION MEANS FOR THE FIX, and it differs from every site #447 touched.
21:`cpu->cd.sh.dmac_chcr[dma_channel] = idata` happens BEFORE the call and is unconditional,
22:so THE GUEST-VISIBLE STATE IS ALREADY CORRECT and no store has to move.  #447's TCR needed
23:its guard hoisted above a prescaler switch because `timer_hz` was computed upstream; its
24:RCR1 needed the store moved below the guard.  Here neither applies -- the whole defect is
25:that the process dies, and the repair is to diagnose and decline the transfer.  A fix
26:design copied from #447 without checking would move a store that is already in the right
27:place.
28:
29:THE CONTROLS ARE WHAT MAKE THIS A MEASUREMENT AND NOT A CRASH REPORT.  *** C1 IS THE
30:DECISIVE ONE: it writes the SAME ADDRESS at the SAME WIDTH with the SAME ILLEGAL DM=3, and
31:only TD cleared -- and the host SURVIVES. ***  So the result reads "this VALUE ends the
32:host", not "this address does", not "this width does", and not even "an illegal field
33:does".  C2 narrows it further: RS=0x200 with TD SET also survives, which is the one arm of
34:that switch that returns normally.  C3 shows the guards are WRITE-path only.  Two
35:device-signature reads prove `DEVICE_ACCESS(sh4)` was entered at all, returning values only
36:that switch synthesises, so RAM cannot supply them.
37:
38:MEASURED on the committed pre-fix build: 13/13, six kills and three survivals.
39:
40:RUNG 3, and the ceiling for this defect: real SH-4 guest instructions through real address
41:decode, real `memory_rw` and real device dispatch, on a committed unmodified machine
42:description.  No source is edited and no `device_add` is introduced to reach the site.
43:
44:*** THIS ASSERTS THE PRE-FIX SYMPTOM, so it is RED once the defect is gone. ***  That is
45:what a witness should be, and it is why it must NEVER be wired into a gate --
46:`check_probe_wiring.py` treats a gated witness as a HARD failure, because it manufactures
47:a phantom regression on the day the fix lands.  Its detector sibling will assert the
48:repaired behaviour.
49:
50:usage:  sh4_chcr_witness.py <gxemul-binary> <landisk-kernel>
51:
52:    *** KEEP THE "./" ON THE BINARY. ***  `os.execvp` on a bare name searches PATH; when
53:    it misses, EVERY arm reports alive=False and a witness written the naive way "passes"
54:    having measured nothing.  W0 catches that.
55:"""
56:import os
57:import sys
58:
59:#  Python puts this script's own directory on sys.path[0], so the session machinery
60:#  comes from the one place in the tree that has it rather than a copy.
61:import sh4_pcic_probe as P
62:
63:#  Every address and constant READ from a header in this repository, not remembered.
64:SH4_CHCR0 = 0xffa0000c          # src/include/sh4_dmacreg.h:40
65:SH4_CHCR3 = 0xffa0003c          # :55
66:CHCR_DM = 0x0000c000            # :117   valid arms are 0<<14, 1<<14, 2<<14
67:CHCR_SM = 0x00003000            # :121   valid arms are 0<<12, 1<<12, 2<<12
68:CHCR_TS = 0x00000070            # :127   valid arms are 0..4 << 4
69:CHCR_TS_4BYTE = 3 << 4          # :131
70:CHCR_IE = 0x00000004            # :134
71:CHCR_TD = 0x00000001            # :136
72:CHCR_DM_INCREMENTED = 1 << 14   # :119
73:CHCR_SM_INCREMENTED = 1 << 12   # :123
74:
75:SH4_PVR_ADDR = 0xff000030       # thirdparty/sh4_cpu.h:187
76:SH4_PRR_ADDR = 0xff000044       # :189
77:SH4_PVR_SH7751 = 0x04110000     # :196
78:SH4_PRR_7751R = 0x00000110      # :200
79:
80:ST = {1: 0x2100, 2: 0x2101, 4: 0x2102}    # mov.b/w/l r0,@r1
81:
82:#  The IDENTITY constant.  A witness copied into a tree where it no longer runs all of its
83:#  rows must not report green over a shorter file.
84:EXPECT_ROWS = 13
85:
86:rows = []
87:
88:
89:def row(name, ok, got, want):
90:    rows.append((name, bool(ok), got, want))
91:    print("  %-4s %s" % ("ok" if ok else "FAIL", name))
92:    if not ok:
93:        print("       got  %s\n       want %s" % (got, want))
94:
95:
96:def rd(addr, label, kw):
97:    return P.read_arm(addr, label, kw)
98:
99:
100:def wr(addr, val, label, kw):
101:    return P.write_arm(addr, val, label, kw, op=ST[4])
102:
103:
104:def main():
105:    if len(sys.argv) != 3:
106:        print("usage:  sh4_chcr_witness.py <gxemul-binary> <landisk-kernel>")
107:        return 2
108:    b, k = sys.argv[1], sys.argv[2]
109:    kw = dict(binary=b, kernel=k)
110:    for p in (b, k):
111:        if not os.path.exists(p):
112:            print("OPERATIONAL FAILURE: %s does not exist (cwd=%s)" % (p, os.getcwd()))
113:            print("SH4CHCR_WITNESS_FAIL")
114:            return 2
115:
116:    #  ---- the device is reached, and answers something only it knows ------------------
117:    buf, alive, st = rd(SH4_PVR_ADDR, "W-c1", kw)
118:    v = P.dumped(buf)
119:    row("W-c1 DEVICE SIGNATURE: PVR reads 0x04110000 in DEVICE_ACCESS(sh4)",
120:        st and alive and v == P.le(SH4_PVR_SH7751),
121:        "started=%s alive=%s val=%s" % (st, alive, v),
122:        "val=%s (RAM would answer %s)" % (P.le(SH4_PVR_SH7751), P.le(0)))
123:
124:    buf, alive, st = rd(SH4_PRR_ADDR, "W-c2", kw)
125:    v = P.dumped(buf)
126:    row("W-c2 DEVICE SIGNATURE: PRR reads 0x00000110 (small non-zero)",
127:        st and alive and v == P.le(SH4_PRR_7751R),
128:        "started=%s alive=%s val=%s" % (st, alive, v),
129:        "val=%s" % P.le(SH4_PRR_7751R))
130:
131:    #  ---- THE KILLS ------------------------------------------------------------------
132:    #  Every value below sets TD.  The comment on each names WHICH default: arm it lands
133:    #  in, so a row that starts failing says which guard changed rather than merely that
134:    #  something did.
135:    kills = [
136:        ("S1 CHCR0 TS=5   -> dev_sh4.c:436",
137:         SH4_CHCR0, (5 << 4) | CHCR_TD, "Unimplemented transmit size"),
138:        ("S2 CHCR0 DM=3   -> dev_sh4.c:445",
139:         SH4_CHCR0, CHCR_DM | CHCR_TD, "Unimplemented destination delta"),
140:        ("S3 CHCR0 SM=3   -> dev_sh4.c:454",
141:         SH4_CHCR0, CHCR_SM | CHCR_TD, "Unimplemented source delta"),
142:        #  *** THE ONE THAT MAKES THIS BROAD.  Everything here is LEGAL -- 4-byte
143:        #  transfers, both addresses incrementing -- and it still dies, because RS is
144:        #  0x100 and only 0x200 survives the switch.
145:        ("S4 CHCR0 a SANE config, RS=0x100 -> dev_sh4.c:491",
146:         SH4_CHCR0,
147:         CHCR_DM_INCREMENTED | CHCR_SM_INCREMENTED | 0x100 | CHCR_TS_4BYTE | CHCR_TD,
148:         "Unimplemented SH4 RS DMAC"),
149:        #  RS == 0x200 survives its switch and then CHCR_IE kills at the next site, so
150:        #  this row reaches a DIFFERENT exit from S4 by a value one bit apart.
151:        ("S5 CHCR0 RS=0x200 with IE -> dev_sh4.c:486",
152:         SH4_CHCR0, 0x200 | CHCR_IE | CHCR_TD, "sh4 dmac interrupt"),
153:        #  A DIFFERENT CHANNEL, to show the defect is per-device and not per-address.
154:        ("S6 CHCR3 DM=3   -> dev_sh4.c:445, channel 3",
155:         SH4_CHCR3, CHCR_DM | CHCR_TD, "Unimplemented destination delta"),
156:    ]
157:    for name, addr, val, msg in kills:
158:        buf, alive, st = wr(addr, val, name.split()[0], kw)
159:        row("%s  KILLS the host (0x%08x)" % (name, val),
160:            st and not alive and msg in (buf or ""),
161:            "started=%s alive=%s diagnostic=%s" % (st, alive, msg in (buf or "")),
162:            "started, NOT alive, and the output names %r" % msg)
163:
164:    #  ---- THE CONTROLS: same address, same width, and the host LIVES -----------------
165:    #  *** WITHOUT THESE THE SIX ROWS ABOVE WOULD BE A CRASH REPORT. ***  C1 is S2's value
166:    #  with ONE BIT cleared -- an illegal DM=3 is still written, the store still happens,
167:    #  and the host survives because sh4_dmac_transfer is never entered.  So the kill is
168:    #  attributable to TD, not to the address, the width, or the illegal field.
169:    buf, alive, st = wr(SH4_CHCR0, CHCR_DM, "C1", kw)
170:    row("C1 CONTROL: the SAME illegal DM=3 with TD CLEAR -- host SURVIVES",
171:        st and alive,
172:        "started=%s alive=%s" % (st, alive),
173:        "started and alive: the transfer is never entered, so nothing can exit")
174:
175:    buf, alive, st = wr(SH4_CHCR0, 0x200 | CHCR_TD, "C2", kw)
176:    row("C2 CONTROL: RS=0x200 WITHOUT IE and TD set -- host SURVIVES",
177:        st and alive,
178:        "started=%s alive=%s" % (st, alive),
179:        "started and alive: 0x200 is the one arm that survives, and IE is clear")
