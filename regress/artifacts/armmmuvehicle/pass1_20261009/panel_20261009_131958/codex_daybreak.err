  968: 
  969:     # --------------------------------------------------------- P11 disassembly
  970:     #  EVERY hand-assembled halfword, checked against the emulator's OWN
  971:     #  disassembler in a session that executed it.  A wrong register field is
  972:     #  silent -- it produces a plausible address and a zero result -- which is
  973:     #  why P7c also insists on a small non-zero value.
  974:     bad = {"%04x" % w: (DISASM.get(w), t) for w, t in OPS.items()
  975:            if DISASM.get(w) != t}
  976:     row("P11 every planted opcode matches the emulator's own disassembler",
  977:         not bad, "mismatches=%s" % (bad or "none"),
  978:         "all of: " + ", ".join("%04x" % w for w in sorted(OPS)))
  979: 
  980:     # ------------------------------------------------- P0, last: absent data
  981:     n_ses = len(STARTS)
  982:     n_ok = sum(1 for _, s in STARTS if s)
  983:     vals = [p7a, p7b, p7c, p8, p2, p2b, p3, p3b, p6, p10, p18, p19]
  984:     row("P0 EVERY session reached the debugger prompt AND every arm produced "
  985:         "data",
  986:         n_ses > 0 and n_ok == n_ses and all(v is not None for v in vals)
  987:         and p4n >= 1 and p5n >= 1 and len(p1w) >= 2,
  988:         "sessions=%d started=%d failed=%s vals=%s"
  989:         % (n_ses, n_ok, [l for l, s in STARTS if not s][:6], vals),
  990:         "started == sessions > 0, and every value present")
  991: 
  992:     # ------------------------------------------------------------ P13 identity
  993:     row("P13 IDENTITY row count -- guards against a stale copy",
  994:         len(rows) + 1 == EXPECT_ROWS, "rows=%d" % (len(rows) + 1),
  995:         "rows=%d" % EXPECT_ROWS)
  996: 
  997:     print("=" * 78)
  998:     print("#443  SH4 PCIC unsupported transaction -- DETECTOR "
  999:           "(-E landisk, unmodified)")
 1000:     print("  binary %s   kernel %s" % (a.binary, a.kernel))
 1001:     print("=" * 78)
 1002:     fails = 0
 1003:     for name, ok, got, want in rows:
 1004:         fails += 0 if ok else 1
 1005:         print("  %-4s %-70s" % ("ok" if ok else "FAIL", name))
 1006:         if not ok:
 1007:             print("       got  %s\n       want %s" % (got, want))
 1008:     print()
 1009:     print("  elapsed %.0f s" % (time.time() - t_all))
 1010:     print("SH4_PCIC_RESULT=%d/%d" % (len(rows) - fails, len(rows)))
 1011:     print("SH4_PCIC_PASS" if fails == 0 else "SH4_PCIC_FAIL")
 1012:     return 1 if fails else 0
 1013: 
 1014: 
 1015: if __name__ == "__main__":
 1016:     sys.exit(main())
