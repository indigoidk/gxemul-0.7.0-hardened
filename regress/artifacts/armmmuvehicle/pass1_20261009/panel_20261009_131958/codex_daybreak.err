  247: 		if (cpu->cd.sh.int_to_assert > 0 && !(cpu->cd.sh.sr & SH_SR_BL)
  248: 		    && ((cpu->cd.sh.sr & SH_SR_IMASK) >> SH_SR_IMASK_SHIFT)
  249: 		    < cpu->cd.sh.int_level)
  250: 			sh_exception(cpu, 0, cpu->cd.sh.int_to_assert, 0);
  251: #endif
  252: 	}
  253: 
  254: #ifdef DYNTRANS_ARM
  255: 	if (cpu->cd.arm.cpsr & ARM_FLAG_T) {
  256: 		// fatal("THUMB execution not implemented.\n");
  257: 		// cpu->running = false;
  258: 		// return 0;
  259: 		
  260: 		arm_cpu_interpret_thumb_SLOW(cpu);
  261: 		return 1;
  262: 	}
  263: #endif
  264: 
  265: 	cached_pc = cpu->pc;
  266: 
  267: 	cpu->n_translated_instrs = 0;
  268: 
  269: 	cpu->cd.DYNTRANS_ARCH.cur_physpage = (struct DYNTRANS_TC_PHYSPAGE *)
  270: 	    cpu->cd.DYNTRANS_ARCH.cur_ic_page;
  271: 
  272: 	if (single_step || cpu->machine->instruction_trace
  273: 	    || cpu->machine->register_dump) {
  274: 		/*
  275: 		 *  Single-step:
  276: 		 */
  277: 		struct DYNTRANS_IC *ic = cpu->cd.DYNTRANS_ARCH.next_ic;
  278: 		if (cpu->machine->register_dump) {
  279: 			debug("\n");
  280: 			cpu_register_dump(cpu->machine, cpu, 1, 0x1);
  281: 		}
  282: 		if (single_step || cpu->machine->instruction_trace) {
  283: 			/*  TODO/Note: This must be large enough to hold
  284: 			    any instruction for any ISA:  */
  285: 			unsigned char instr[1 <<
  286: 			    DYNTRANS_INSTR_ALIGNMENT_SHIFT];
  287: 			if (!cpu->memory_rw(cpu, cpu->mem, cached_pc, &instr[0],
  288: 			    sizeof(instr), MEM_READ, CACHE_INSTRUCTION)) {
  289: 				fatal("XXX_run_instr(): could not read "
  290: 				    "the instruction\n");
  291: 			} else {
  292: #ifdef DYNTRANS_DELAYSLOT
  293: 				int len =
  294: #endif
  295: 				    cpu_disassemble_instr(
  296: 				    cpu->machine, cpu, instr, 1, cpu->pc);
  297: #ifdef DYNTRANS_DELAYSLOT
  298: 				/*  Show the instruction in the delay slot,
  299: 				    if any:  */
  300: 				if (cpu->instruction_has_delayslot == NULL)
  301: 					fatal("WARNING: ihd func not yet"
  302: 					    " implemented?\n");
  303: 				else if (cpu->instruction_has_delayslot(cpu,
  304: 				    instr)) {
  305: 					int saved_delayslot = cpu->delay_slot;
  306: 					cpu->memory_rw(cpu, cpu->mem, cached_pc
  307: 					    + len, &instr[0],
  308: 					    sizeof(instr), MEM_READ,
  309: 					    CACHE_INSTRUCTION);
  310: 					cpu->delay_slot = DELAYED;
  311: 					cpu->pc += len;
  312: 					cpu_disassemble_instr(cpu->machine,
  313: 					    cpu, instr, 1, cpu->pc);
  314: 					cpu->delay_slot = saved_delayslot;
  315: 					cpu->pc -= len;
  316: 				}
  317: #endif
  318: 			}
  319: 		}
  320: 
  321: 		if (cpu->machine->statistics.enabled)
  322: 			S;
  323: 
  324: 		/*  Execute just one instruction:  */
  325: 		I;
  326: 
  327: 		n_instrs = 1;
  328: 	} else if (cpu->machine->statistics.enabled) {
  329: 		/*  Gather statistics while executing multiple instructions:  */
  330: 		n_instrs = 0;
 1770: 
 1771: 	/*
 1772: 	 *  #250: if this page overlaps a data write-watchpoint, keep it out of
 1773: 	 *  the fast store table so every store to it traps to memory_rw, where
 1774: 	 *  the watchpoint is evaluated. NOP unless a watchpoint is set; only
 1775: 	 *  the watched page(s) are affected, so a run without watchpoints is
 1776: 	 *  behaviourally identical. index (MODE32) and l3/x3 (!MODE32) are
 1777: 	 *  valid here for both the new-mapping and update branches.
 1778: 	 */
 1779: 	if (cpu->machine->watchpoints.n != 0 &&
 1780: 	    machine_watchpoint_match(cpu->machine, paddr_page,
 1781: 	    DYNTRANS_PAGESIZE)) {
 1782: #ifdef MODE32
 1783: 		cpu->cd.DYNTRANS_ARCH.host_store[index] = NULL;
 1784: #else
 1785: 		l3->host_store[x3] = NULL;
 1786: #endif
 1787: 	}
 1788: }
 1789: #endif	/*  DYNTRANS_UPDATE_TRANSLATION_TABLE  */
 1790: 
 1791: 
 1792: /*****************************************************************************/
 1793: 
 1794: 
 1795: #ifdef DYNTRANS_TO_BE_TRANSLATED_HEAD
 1796: 	/*
 1797: 	 *  Check for breakpoints.
 1798: 	 */
 1799: 	if (!single_step_breakpoint && !cpu->translation_readahead) {
 1800: 		MODE_uint_t curpc = cpu->pc;
 1801: 		int i;
 1802: 		for (i=0; i<cpu->machine->breakpoints.n; i++)
 1803: 			if (curpc == (MODE_uint_t)
 1804: 			    cpu->machine->breakpoints.addr[i]) {
 1805: 				/*
 1806: 				 *  #248: count every hit, and honor a
 1807: 				 *  per-breakpoint ignore-count so that
 1808: 				 *  "breakpoint add addr, N" runs past the
 1809: 				 *  first N hits before stopping. Setting
 1810: 				 *  single_step_breakpoint (without single_step)
 1811: 				 *  makes the TAIL execute this instruction once
 1812: 				 *  and mark it for re-translation, so the check
 1813: 				 *  fires again on the next hit.
 1814: 				 */
 1815: 				cpu->machine->breakpoints.hitcount[i] ++;
 1816: 				if (cpu->machine->breakpoints.ignore_left[i] > 0
 1817: #ifdef DYNTRANS_DELAYSLOT
 1818: 				    && cpu->delay_slot == NOT_DELAYED
 1819: #endif
 1820: 				    ) {
 1821: 					cpu->machine->breakpoints.
 1822: 					    ignore_left[i] --;
 1823: 					single_step_breakpoint = 1;
 1824: 					break;
 1825: 				}
 1826: 				if (!cpu->machine->instruction_trace) {
 1827: 					int tmp_old_quiet_mode = quiet_mode;
 1828: 					quiet_mode = 0;
 1829: 					DISASSEMBLE(cpu, ib, 1, 0);
 1830: 					quiet_mode = tmp_old_quiet_mode;
 1831: 				}
 1832: #ifdef MODE32
 1833: 				fatal("BREAKPOINT: pc = 0x%" PRIx32"\n(The "
 1834: 				    "instruction has not yet executed.)\n",
 1835: 				    (uint32_t)cpu->pc);
 1836: #else
 1837: 				fatal("BREAKPOINT: pc = 0x%" PRIx64"\n(The "
 1838: 				    "instruction has not yet executed.)\n",
 1839: 				    (uint64_t)cpu->pc);
 1840: #endif
 1841: #ifdef DYNTRANS_DELAYSLOT
 1842: 				if (cpu->delay_slot != NOT_DELAYED)
 1843: 					fatal("ERROR! Breakpoint in a delay"
 1844: 					    " slot! Not yet supported.\n");
 1845: #endif
 1846: 				single_step_breakpoint = 1;
 1847: 				single_step = true;
 1848: 				goto stop_running_translated;
 1849: 			}
 1850: 	}
 1851: #endif	/*  DYNTRANS_TO_BE_TRANSLATED_HEAD  */
 1852: 
 1853: 
 1854: /*****************************************************************************/
 1855: 
 1856: 
 1857: #ifdef DYNTRANS_TO_BE_TRANSLATED_TAIL
 1858: 	/*
 1859: 	 *  If we end up here, then an instruction was translated. Let's mark
 1860: 	 *  the page as containing a translation at this part of the page.
 1861: 	 */
 1862: 
 1863: 	/*  Make sure cur_physpage is in synch:  */
 1864: 	cpu->cd.DYNTRANS_ARCH.cur_physpage = (struct DYNTRANS_TC_PHYSPAGE *)
 1865: 	    cpu->cd.DYNTRANS_ARCH.cur_ic_page;
 1866: 
 1867: 	{
 1868: 		int x = addr & (DYNTRANS_PAGESIZE - 1);
 1869: 		int addr_per_translation_range = DYNTRANS_PAGESIZE / (8 *
 1870: 		    sizeof(cpu->cd.DYNTRANS_ARCH.cur_physpage->
 1871: 		    translations_bitmap));
 1872: 		x /= addr_per_translation_range;
 1873: 
 1874: 		cpu->cd.DYNTRANS_ARCH.cur_physpage->
 1875: 		    translations_bitmap |= ((uint32_t)1 << x);
 1876: 	}
 1877: 
 1878: 
 1879: 	/*
 1880: 	 *  Now it is time to check for combinations of instructions that can
 1881: 	 *  be converted into a single function call.
 1882: 	 *
 1883: 	 *  Note: Single-stepping or instruction tracing doesn't work with
 1884: 	 *  instruction combinations. For architectures with delay slots,
 1885: 	 *  we also ignore combinations if the delay slot is across a page
 1886: 	 *  boundary.
 1887: 	 */
 1888: 	if (!single_step && !single_step_breakpoint
 1889: 	    && !cpu->machine->instruction_trace
 1890: #ifdef DYNTRANS_DELAYSLOT
 1891: 	    && !in_crosspage_delayslot
 1892: #endif
 1893: 	    && cpu->cd.DYNTRANS_ARCH.combination_check != NULL
 1894: 	    && cpu->machine->allow_instruction_combinations) {
 1895: 		cpu->cd.DYNTRANS_ARCH.combination_check(cpu, ic,
 1896: 		    addr & (DYNTRANS_PAGESIZE - 1));
 1897: 	}
 1898: 
 1899: 	cpu->cd.DYNTRANS_ARCH.combination_check = NULL;
 1900: 
 1901: 	/*  An additional check, to catch some bugs:  */
 1902: 	if (ic->f == TO_BE_TRANSLATED) {
 1903: 		fatal("INTERNAL ERROR: ic->f not set!\n");
 1904: 		goto bad;
 1905: 	}
 1906: 	if (ic->f == NULL) {
 1907: 		fatal("INTERNAL ERROR: ic->f == NULL!\n");
 1908: 		goto bad;
 1909: 	}
 1910: 
 1911: 
 1912: 	/*
 1913: 	 *  ... and finally execute the translated instruction:
 1914: 	 */
 1915: 
 1916: 	/*  (Except when doing read-ahead!)  */
 1917: 	if (cpu->translation_readahead)
 1918: 		return;
 1919: 
 1920: 	/*
 1921: 	 *  Special case when single-stepping: Execute the translated
 1922: 	 *  instruction, but then replace it with a "to be translated"
 1923: 	 *  directly afterwards.
 1924: 	 */
 1925: 	if ((single_step_breakpoint && cpu->delay_slot == NOT_DELAYED)
 1926: #ifdef DYNTRANS_DELAYSLOT
 1927: 	    || in_crosspage_delayslot
 1928: #endif
 1929: 	    ) {
 1930: 		single_step_breakpoint = 0;
 1931: 		ic->f(cpu, ic);
 1932: 		ic->f = TO_BE_TRANSLATED;
 1933: 		return;
 1934: 	}
 1935: 
 1936: 
 1937: 	/*  Translation read-ahead:  */
 1938: 	if (!single_step && !cpu->machine->instruction_trace &&
 1939: 	    cpu->machine->breakpoints.n == 0) {
 1940: 		uint64_t baseaddr = cpu->pc;
 1941: 		uint64_t pagenr = DYNTRANS_ADDR_TO_PAGENR(baseaddr);
 1942: 		int i = 1;
 1943: 
 1944: 		cpu->translation_readahead = MAX_DYNTRANS_READAHEAD;
 1945: 
 1946: 		while (DYNTRANS_ADDR_TO_PAGENR(baseaddr +
 1947: 		    (i << DYNTRANS_INSTR_ALIGNMENT_SHIFT)) == pagenr &&
 1948: 		    cpu->translation_readahead > 0) {
 1949: 			void (*old_f)(struct cpu *,
 1950: 			    struct DYNTRANS_IC *) = ic[i].f;
 1951: 
 1952: 			/*  Already translated? Then abort:  */
 1953: 			if (old_f != TO_BE_TRANSLATED)
 1954: 				break;
 1955: 
 1956: 			/*  Translate the instruction:  */
 1957: 			ic[i].f(cpu, ic+i);
 1958: 
 1959: 			/*  Translation failed? Then abort.  */
 1960: 			if (ic[i].f == old_f)
 1961: 				break;
 1962: 
 1963: 			cpu->translation_readahead --;
 1964: 			++i;
 1965: 		}
 1966: 
 1967: 		cpu->translation_readahead = 0;
 1968: 	}
 1969: 
 1970: 
 1971: 	/*
 1972: 	 *  Finally finally :-), execute the instruction.
 1973: 	 *
 1974: 	 *  Note: The instruction might have changed during read-ahead, if
 1975: 	 *  instruction combinations are used.
 1976: 	 */
 1977: 
 1978: 	ic->f(cpu, ic);
 1979: 
 1980: 	return;
 1981: 
 1982: 
 1983: bad:	/*
 1984: 	 *  Nothing was translated. (Unimplemented or illegal instruction.)
 1985: 	 */
 1986: 
 1987: 	/*  Clear the translation, in case it was "half-way" done:  */
 1988: 	ic->f = TO_BE_TRANSLATED;
 1989: 
 1990: 	if (cpu->translation_readahead)
 1991: 		return;
 1992: 
 1993: 
 1994: 	/*
 1995: 	 *  Abort the emulation.  In principle, it may have been more accurate
 1996: 	 *  to treat invalid/unimplemented instructions as something that
 1997: 	 *  should cause e.g. an exception (depending on how the particular
 1998: 	 *  CPU works), but chances are that this is an unimplemented
 1999: 	 *  instruction that should be implemented for real.
 2000: 	 */
 2001: 
 2002: 	about_to_enter_single_step = true;
 2003: 
 2004: 	if (cpu->is_32bit)
 2005: 		debugmsg_cpu(cpu, SUBSYS_CPU, "", VERBOSITY_ERROR,
 2006: 		    "UNIMPLEMENTED instruction at 0x%" PRIx32, (uint32_t)cpu->pc);
 2007: 	else
 2008: 		debugmsg_cpu(cpu, SUBSYS_CPU, "", VERBOSITY_ERROR,
 2009: 		    "UNIMPLEMENTED instruction at 0x%" PRIx64, (uint64_t)cpu->pc);
 2010: 
 2011: 	if (!(single_step || cpu->machine->instruction_trace))
 2012: 		DISASSEMBLE(cpu, ib, 1, 0);
 2013: 
 2014: 	cpu->running = 0;
 2015: 
 2016: 	/*  Note: Single-stepping can jump here.  */
 2017: stop_running_translated:
 2018: 
 2019: 	// This makes sure that we stop in the debugger, even if e.g.
 2020: 	// "step 100" was executing and 50 steps remained.

