  880: 	x3 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N-DYNTRANS_L3N)) & mask3;
  881: 	l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
  882: 	l3 = l2->l3[x2];
