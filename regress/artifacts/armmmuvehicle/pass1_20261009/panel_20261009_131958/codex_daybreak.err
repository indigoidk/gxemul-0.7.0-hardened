1121:def grid_obs(path):
1122:    """[(kind, label, OLD, NEW, WANT)] for one path -- the whole generated table."""
1123:    labels = MSR_LABELS if path == "msr" else RESTORE_LABELS
1124:    obs = []
1125:
1126:    def add(kind, lab, new, pol):
1127:        old = lab if pol == 1 else (HI0 | lab)
1128:        newv = (HI1 | new) if pol == 1 else new
1129:        if kind == "acc":
1130:            want = newv
1131:        elif kind == "dec":
1132:            want = (newv & ~0x1F) | lab
1133:        else:                                    # non-restoring pop forms
1134:            want = old
1135:        obs.append((kind, lab, old, newv, want))
1136:
1137:    i = 0
1138:    for lab in labels:                           # G2 complement declines, both polarities
1139:        for pol in (1, 2):
1140:            add("dec", lab, lab ^ 0x1F, pol)
1141:    for m in UNMODELLED:                         # G3 every unmodelled value
1142:        add("dec", labels[i % len(labels)], m, 1 + (i % 2))
1143:        i += 1
1144:    j = 0
1145:    for lab in labels:                           # accepts: every modelled mode, both polarities,
1146:        for pol in (1, 2):                       # mode != label
1147:            cands = [m for m in MODELLED if m != lab]
1148:            add("acc", lab, cands[(j * 3) % len(cands)], pol)
1149:            j += 1
1150:    for m in MODELLED:                           # and every modelled mode as an accept target
1151:        lab = [l for l in labels if l != m][j % (len(labels) - 1)]
1152:        add("acc", lab, m, 1 + (j % 2))
1153:        j += 1
1154:    if path == "pop":                            # G4 the three non-restoring enclosing cells
1155:        for kind in ("ldm_pc", "ldm_r0_s", "ldm_r0"):
1156:            for pol in (1, 2):
1157:                add(kind, 0x13 if pol == 1 else 0x12, 0x1F, pol)
1158:    return obs
