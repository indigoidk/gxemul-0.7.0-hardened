1161:def grid_cov(path):
1162:    """Uncovered (outcome, bit, polarity) cells of path's observations, outside the named
1163:    equivalents.  Covered: some observation whose WANT bit == pol while the alternative differs --
1164:    OLD's bit for every non-mode bit and for accept mode bits, NEW's (the SPSR / operand's) bit
1165:    for decline mode bits.  Named equivalents: bit 4 polarity 0 (no modelled mode or label has it
1166:    clear), bit 4 on ACCEPT at either polarity (OLD's bit 4 is always 1, as is the accepted
1167:    mode's, so keep-old and force-1 equal the right answer), and bit 5 polarity 0 vs OLD (OLD T
1168:    is always 0: the guest runs ARM code)."""
1169:    miss = []
1170:    obs = grid_obs(path)
1171:    for outc in ("acc", "dec"):
1172:        for bit in range(32):
1173:            for pol in (0, 1):
1174:                if (bit == 4 and pol == 0) or (bit == 5 and pol == 0) or                         (bit == 4 and outc == "acc"):
1175:                    continue
1176:                ok = False
1177:                for kind, lab, old, new, want in obs:
1178:                    if kind != outc or ((want >> bit) & 1) != pol:
1179:                        continue
1180:                    alt = new if (outc == "dec" and bit < 5) else old
1181:                    if ((alt >> bit) & 1) != pol:
1182:                        ok = True
1183:                        break
1184:                if not ok:
1185:                    miss.append("%s/b%d/%d" % (outc, bit, pol))
1186:    return miss
