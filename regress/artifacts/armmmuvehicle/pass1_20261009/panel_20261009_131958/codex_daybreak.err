  180: 	 *  advances by offset & ~(datalen-1) -- the offset truncated down to a
  181: 	 *  multiple of the access size. When the offset is SMALLER than the access
  182: 	 *  size that advance is zero and the base is a FIXED POINT: base 0x10001
  183: 	 *  with offset 1 masks to 0x10000, adds 1, and writes back the value it
  184: 	 *  started from, so the loop never advanced at all. A larger non-multiple
  185: 	 *  offset is not a fixed point but still wrong -- offset 5 on a word access
  186: 	 *  advances by 4. Only the copy handed to memory is masked, below.
  187: 	 *
  188: 	 *  Declared only where a writeback exists: the p1_w0 (offset-addressing)
  189: 	 *  instantiations have no writeback block, and this file is #included once
  190: 	 *  per variant, so an unconditional local would warn per instantiation.
  191: 	 */
  192: #if !defined(A__P) || defined(A__W)
  193: 	const uint32_t wb_addr = addr;
  194: #endif
  195: 
  196: 	/*
  197: 	 *  #362: an unaligned word LOAD returns the aligned word ROTATED RIGHT by
  198: 	 *  8 * addr[1:0]. DDI 0100I A2.8 (p. A2-38) states it, and A4.1.23 LDR's
  199: 	 *  pseudocode is `data = Memory[address,4] Rotate_Right (8 * address[1:0])`
  200: 	 *  when the CP15 U bit is 0. This template masked and never rotated, so it
  201: 	 *  returned the aligned word unchanged -- measured wrong in 3 of the 4
  202: 	 *  low-bit cases.
  203: 	 *
  204: 	 *  LOADS ONLY: A4.1.99 says STR ignores the low two address bits, so stores
  205: 	 *  are already right, and A4.1.28 makes an unaligned halfword load's data
  206: 	 *  UNPREDICTABLE, so masking without rotating is permitted there. LDRD is
  207: 	 *  excluded automatically because A__LDRD does not define A__L.
  208: 	 *
  209: 	 *  Applied UNCONDITIONALLY rather than gated on architecture version, and
  210: 	 *  the reason is dominance rather than convenience: rotation is correct for
  211: 	 *  ARMv3/v4/v5 and for v6+ with U == 0, and where v6+ with U == 1 wants a
  212: 	 *  true unaligned access, masking and rotating are wrong equally -- so this
  213: 	 *  is never worse than what it replaces, in any combination. Gating would
  214: 	 *  also be unsound here: there is no architecture level in the CPU type
  215: 	 *  table (its own header says "TODO: Include ARM level" and "Most of these
  216: 	 *  are bogus"), deriving one from cpu_id[19:16] misclassifies ARM7500FE as
  217: 	 *  ARMv6 -- wrong in the direction that changes behaviour -- and no
  218: 	 *  ARM_CONTROL_U is defined anywhere. Recorded divergence: v6+ with U == 1.
  219: 	 *
  220: 	 *  #357's `wb_addr` cannot be reused for this: it exists only under
  221: 	 *  `!defined(A__P) || defined(A__W)`, and the plain offset-addressing word
  222: 	 *  load has neither. Captured here, after the address is computed and
  223: 	 *  before the mask.
  224: 	 */
  225: #if defined(A__L) && !defined(A__B) && !defined(A__H) && !defined(A__LDRD)
  226: 	const uint32_t rot_sh = 8 * (addr & 3);
  227: #endif
  228: 
  229: 	addr &= ~(datalen - 1);
  230: 
  231: #if defined(A__L) || defined(A__LDRD)
  232: 	/*  Load:  */
  233: 	if (!cpu->memory_rw(cpu, cpu->mem, addr, data, datalen,
  234: 	    MEM_READ, memory_rw_flags)) {
  235: 		/*  load failed, an exception was generated  */
  236: 		if (!cpu->running)
  237: 			cpu->cd.arm.next_ic = &nothing_call;
  238: 		return;
  239: 	}
  240: #if defined(A__B) && !defined(A__LDRD)
  241: 	reg(ic->arg[2]) =
  242: #ifdef A__SIGNED
  243: 	    (int32_t)(int8_t)
  244: #endif
  245: 	    data[0];
  246: #else
  247: #if defined(A__H) && !defined(A__LDRD)
  248: 	reg(ic->arg[2]) =
  249: #ifdef A__SIGNED
  250: 	    (int32_t)(int16_t)
  251: #endif
  252: 	    (cpu->byte_order == EMUL_LITTLE_ENDIAN
  253: 	    ? (data[0] + (data[1] << 8))
  254: 	    : (data[1] + (data[0] << 8)));
  255: #else
  256: #ifndef A__LDRD
  257: 	reg(ic->arg[2]) =
  258: 		cpu->byte_order == EMUL_LITTLE_ENDIAN
  259: 		? data[0] + (data[1] << 8) + (data[2] << 16) + (data[3] << 24)
  260: 		: data[3] + (data[2] << 8) + (data[1] << 16) + (data[0] << 24);
  261: 	/*  #362: rotate right by 8 * addr[1:0]; see the capture above. Guarded on
  262: 	    rot_sh so the aligned case emits no shift at all, and because a 32-bit
  263: 	    value shifted left by 32 is undefined in C.  */
  264: 	if (rot_sh)
  265: 		reg(ic->arg[2]) = (reg(ic->arg[2]) >> rot_sh) |
  320: 	i += cpu->byte_order == EMUL_LITTLE_ENDIAN ? 1 : -1;
  321: 	data[i] = reg(ic->arg[2]) >> 24;
  322: 	i += cpu->byte_order == EMUL_LITTLE_ENDIAN ? 1 : -1;
  323: #endif	/*  !A__H  */
  324: #endif	/*  !A__B  */
