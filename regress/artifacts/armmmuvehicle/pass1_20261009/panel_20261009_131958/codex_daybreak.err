  220: def session(cmds, nstep, label="", extra=None, disasm_upto=0,
  221:             binary=None, kernel=None, timeout=90):
  222:     """One cold-debugger session.  Returns (buf, alive, started).
  223: 
  224:     `started` is kept separate from `alive` ON PURPOSE.  A session that never
  225:     reached the debugger prompt ALSO reports alive=False, and scoring that as
  226:     "the guest access killed the host" would let a broken invocation -- missing
  227:     binary, missing image, host out of memory -- masquerade as a measurement.
  228:     P0 requires started of every session this run ever opened.
  229:     """
  230:     pid, fd = pty.fork()
  231:     if pid == 0:
  232:         argv = [binary, "-V", "-E", "landisk", "-M", "64"] + (extra or []) \
  233:                + [kernel]
