  235:             os.execvp(binary, argv)
  236:         except Exception:
  237:             pass
  238:         os._exit(127)
  239:     buf = ""
  240:     died = [False]
  241: 
  242:     def rd(t=0.4):
  243:         nonlocal buf
  244:         r, _, _ = select.select([fd], [], [], t)
  245:         if fd not in r:
