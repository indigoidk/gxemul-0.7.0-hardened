392:def dumped(t, addr):
393:    """The word stored at `addr', from the LAST aligned dump line in `t' (R2: callers pass the
394:    early or the late half, never the whole transcript).  Memory-order bytes, little-endian
395:    guest: assemble like sw() in arm_flags_probe.py."""
396:    label = "0x%08x" % (addr & ~0xF)
397:    idx = (addr & 0xF) // 4
398:    val = None
399:    for line in t.splitlines():
400:        if line.startswith(label):
401:            parts = line[12:48].split()
402:            if len(parts) == 4 and len(parts[idx]) == 8:
403:                val = int.from_bytes(bytes.fromhex(parts[idx]), "little")
404:    return val
