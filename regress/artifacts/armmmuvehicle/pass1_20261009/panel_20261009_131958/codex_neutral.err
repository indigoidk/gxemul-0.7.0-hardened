716:		r = c->memory_rw(c, mem, addr, &buf[0], sizeof(buf),
717:		    MEM_READ, CACHE_NONE | NO_EXCEPTIONS);
718:
719:		if (c->is_32bit)
720:			printf("0x%08" PRIx32"  ", (uint32_t) addr);
721:		else
722:			printf("0x%016" PRIx64"  ", (uint64_t) addr);
723:
724:		if (r == MEMORY_ACCESS_FAILED)
725:			printf("(memory access failed)\n");
726:		else {
727:			for (x=0; x<16; x++) {
728:				if (addr + x >= addr_start &&
729:				    addr + x < addr_end)
730:					printf("%02x%s", buf[x],
731:					    (x&3)==3? " " : "");
732:				else
733:					printf("  %s", (x&3)==3? " " : "");
734:			}
735:			printf(" ");
736:			for (x=0; x<16; x++) {
737:				if (addr + x >= addr_start &&
738:				    addr + x < addr_end)
739:					printf("%c", (buf[x]>=' ' &&
740:					    buf[x]<127)? buf[x] : '.');
741:				else
742:					printf(" ");
743:			}
744:			printf("\n");
745:		}
746:
747:		if (ctrl_c)
748:			return;
749:
750:		addr += sizeof(buf);
751:	}
