659:		CHECK_ALLOCATION(tmps = strdup(args));
660:
661:		/*  addr: (Note: spaces adjacent to operators belong to the
662:		    addr expression itself, e.g. "dump pc + 0x40", and do
663:		    not start the optional endaddr argument.)  */
664:		p = debugger_addr_range_separator(tmps);
