381:def dumpcmd(addr, end=None):
382:    """*** ALWAYS DUMP FROM THE 16-BYTE-ALIGNED BASE. ***  debugger_cmd_dump does
383:    `addr = addr_start & ~0xf' and blank-pads groups before addr_start (arm_bdt_probe.py
384:    read_mem32(), measured 2026-09-11)."""
385:    base = addr & ~0xF
386:    top = ((end if end is not None else addr) + 16) & ~0xF
387:    if top <= base:
388:        top = base + 16
389:    return "dump 0x%x 0x%x" % (base, top)
