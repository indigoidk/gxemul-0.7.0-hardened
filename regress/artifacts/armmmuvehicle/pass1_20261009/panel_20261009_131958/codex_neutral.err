688:	}
689:	mem = m->cpus[m->bootstrap_cpu]->mem;
690:
691:	addr_start = last_dump_addr;
692:
693:	if (addr_start == MAGIC_UNTOUCHED)
694:		addr_start = c->pc;
695:
696:	addr_end = addr_start + 16 * 16;
697:
698:	/*  endaddr:  */
699:	if (p != NULL) {
700:		while (*p == ' ' && *p)
701:			p++;
702:		r = debugger_parse_expression(m, p, 0, &addr_end);
703:		if (r == PARSE_NOMATCH || r == PARSE_MULTIPLE) {
704:			printf("Unparsable address: %s\n", args);
705:			return;
706:		}
707:	}
708:
709:	addr = addr_start & ~0xf;
710:
711:	ctrl_c = 0;
712:
713:	while (addr < addr_end) {
714:		unsigned char buf[16];
715:		memset(buf, 0, sizeof(buf));
716:		r = c->memory_rw(c, mem, addr, &buf[0], sizeof(buf),
717:		    MEM_READ, CACHE_NONE | NO_EXCEPTIONS);
