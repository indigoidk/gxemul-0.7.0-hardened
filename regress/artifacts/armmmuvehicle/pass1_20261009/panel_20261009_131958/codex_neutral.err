285:                       "0x%x:%s" % (CODE, STUB)])
286:        os._exit(127)
287:    buf = ""
288:    eof = False
289:
290:    def rd(t):
291:        nonlocal buf, eof
292:        end = time.time() + t
293:        while time.time() < end:
294:            try:
295:                r, _, _ = select.select([fd], [], [], 0.1)
296:            except OSError:
297:                eof = True
298:                return
299:            if not r:
300:                continue
301:            try:
302:                d = os.read(fd, 65536)
303:            except OSError:
304:                eof = True
305:                return
306:            if not d:
307:                eof = True
308:                return
309:            buf += d.decode("utf-8", "replace")
310:
311:    rd(settle)
312:    for c in cmds:
313:        if eof:
314:            break
315:        try:
316:            os.write(fd, (c + "\n").encode())
317:        except OSError:
318:            eof = True
319:            break
320:        rd(0.3)
321:    rd(spin)
322:
323:    #  *** POLL, NEVER SAMPLE ONCE. ***  rd() returns immediately on EOF, so a dying child must
324:    #  be given time to die.  On EOF reap with a long deadline; without EOF a short one (R7).
325:    alive = True
326:    deadline = time.time() + (12.0 if eof else 3.0)
327:    while time.time() < deadline:
328:        try:
329:            wpid, _st = os.waitpid(pid, os.WNOHANG)
330:        except ChildProcessError:
331:            alive = False
332:            break
333:        if wpid == pid:
334:            alive = False
335:            break
336:        time.sleep(0.05)
337:    if alive:
338:        try:
339:            os.kill(pid, signal.SIGKILL)
340:        except OSError:
341:            pass
342:        try:
343:            _w, st = os.waitpid(pid, 0)
344:            #  R7: if the child exited on its own between the last poll and our kill, the
345:            #  status says so -- do not leave alive=True for a process that died by itself.
346:            if os.WIFEXITED(st) or (os.WIFSIGNALED(st) and os.WTERMSIG(st) != signal.SIGKILL):
347:                alive = False
348:        except ChildProcessError:
349:            pass
350:    try:
351:        os.close(fd)
352:    except OSError:
353:        pass
354:    return buf.replace("\r", ""), alive
