415:def prologue():
416:    """POISON DEST..DEST+16 (the post-MSR stores must overwrite them) and point r4 at DEST."""
417:    return ["put w 0x%x, 0x%08x" % (DEST + o, POISON) for o in (0, 4, 8, 12, 16)] \
418:        + ["r4=0x%x" % DEST]
