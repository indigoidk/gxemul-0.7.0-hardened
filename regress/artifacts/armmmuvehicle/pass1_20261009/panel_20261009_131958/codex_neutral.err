799:	/*  Stop timers while interacting with the user:  */
800:	timer_stop();
801:
802:	exit_debugger = false;
803:	exit_debugger_to_continue_single_stepping = false;
804:
805:	while (!exit_debugger) {
806:		/*  Read a line from the terminal:  */
807:		cmd = debugger_readline();
808:
809:		cmd_len = strlen(cmd);
810:
811:		/*  Remove spaces:  */
812:		while (cmd_len > 0 && cmd[0]==' ')
813:			memmove(cmd, cmd+1, cmd_len --);
814:		while (cmd_len > 0 && cmd[cmd_len-1] == ' ')
815:			cmd[(cmd_len--)-1] = '\0';
816:
817:		/*  No command? Then try reading another line.  */
818:		if (cmd_len == 0) {
819:			/*  Special case for repeated commands:  */
820:			if (repeat_cmd[0] != '\0')
821:				strlcpy(cmd, repeat_cmd, MAX_CMD_BUFLEN);
822:			else
823:				continue;
824:		} else {
825:			last_cmd_index ++;
826:			if (last_cmd_index >= N_PREVIOUS_CMDS)
827:				last_cmd_index = 0;
828:
829:			repeat_cmd[0] = '\0';
830:		}
831:
832:		debugger_execute_cmd(cmd, cmd_len);
833:
834:		/*  Special hack for the "step" command:  */
835:		if (exit_debugger_to_continue_single_stepping)
836:			return;
837:	}
838:
839:	/*  Start up timers again:  */
840:	timer_start();
841:
842:	/*  ... and reset starttime, so that nr of instructions per second
843:	    can be calculated correctly:  */
844:	for (i=0; i<debugger_machine->ncpus; i++) {
845:		gettimeofday(&debugger_machine->cpus[i]->starttime, NULL);
846:		debugger_machine->cpus[i]->ninstrs_since_gettimeofday = 0;
847:	}
848:
849:	single_step = false;
850:	quiet_mode = old_quiet_mode;
851:}
