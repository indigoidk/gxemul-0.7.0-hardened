212:    "str_sp_8": 0xE584D008,              # str  r13,[r4,#8]
213:    "str_sp_c": 0xE584D00C,              # str  r13,[r4,#12]
214:    "str_sp_10": 0xE584D010,             # str  r13,[r4,#16]
215:    "mov_r0_2a": 0xE3A0002A,             # mov  r0, #0x2a
216:    "str_r0":   0xE5840000,              # str  r0, [r4]
