759:void debugger(void)
760:{
761:	int i, cmd_len;
762:	char *cmd;
763:
764:	/*  "step call": continue single-stepping, without interaction,
765:	    until a function call or return has been traced (or the user
766:	    has pressed CTRL-C):  */
767:	if (debugger_stepping_until_function_transition) {
768:		int transition = ctrl_c != 0;
769:
770:		for (i=0; i<debugger_machine->ncpus; i++)
771:			if (debugger_machine->cpus[i]->
772:			    last_was_function_transition)
773:				transition = 1;
