278:def session(cmds, settle=1.6, spin=1.6):
279:    """ONE FRESH PROCESS per scored row that executes a guest instruction.  Returns (t, alive);
280:    _session_split() turns the `@MARK' pseudo-command into the early/late split (R2)."""
281:    NSESS[0] += 1
282:    pid, fd = pty.fork()
283:    if pid == 0:
