357:def _session_split(cmds):
358:    #  Insert a unique, harmless marker command at MARK so the split survives \r stripping:
359:    #  `print 0x5eed5eed' is answered by the debugger (sh_intprio_probe.py measured `print
360:    #  0x1234'), and even if it were not, its echo carries the token.
361:    real = []
362:    for c in cmds:
363:        real.append("print 0x5eed5eed" if c == MARK else c)
364:    t, alive = session(real)
365:    i = t.find("5eed5eed")
366:    if i < 0:
367:        return t, "", alive, False
368:    #  late = everything after the marker's answer line (skip echo + answer)
369:    j = t.rfind("5eed5eed")
370:    nl = t.find("\n", j)
371:    late = t[nl + 1:] if nl >= 0 else ""
372:    return t[:i], late, alive, True
