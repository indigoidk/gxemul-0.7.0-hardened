283:			/*  TODO/Note: This must be large enough to hold
284:			    any instruction for any ISA:  */
285:			unsigned char instr[1 <<
286:			    DYNTRANS_INSTR_ALIGNMENT_SHIFT];
287:			if (!cpu->memory_rw(cpu, cpu->mem, cached_pc, &instr[0],
288:			    sizeof(instr), MEM_READ, CACHE_INSTRUCTION)) {
289:				fatal("XXX_run_instr(): could not read "
290:				    "the instruction\n");
291:			} else {
292:#ifdef DYNTRANS_DELAYSLOT
293:				int len =
294:#endif
295:				    cpu_disassemble_instr(
296:				    cpu->machine, cpu, instr, 1, cpu->pc);
297:#ifdef DYNTRANS_DELAYSLOT
298:				/*  Show the instruction in the delay slot,
299:				    if any:  */
300:				if (cpu->instruction_has_delayslot == NULL)
301:					fatal("WARNING: ihd func not yet"
302:					    " implemented?\n");
303:				else if (cpu->instruction_has_delayslot(cpu,
304:				    instr)) {
305:					int saved_delayslot = cpu->delay_slot;
306:					cpu->memory_rw(cpu, cpu->mem, cached_pc
307:					    + len, &instr[0],
308:					    sizeof(instr), MEM_READ,
309:					    CACHE_INSTRUCTION);
310:					cpu->delay_slot = DELAYED;
311:					cpu->pc += len;
312:					cpu_disassemble_instr(cpu->machine,
313:					    cpu, instr, 1, cpu->pc);
314:					cpu->delay_slot = saved_delayslot;
315:					cpu->pc -= len;
618: *  XXX_pc_to_pointers_generic():
619: *
620: *  Generic case. See DYNTRANS_PC_TO_POINTERS_FUNC below.
621: */
622:void DYNTRANS_PC_TO_POINTERS_GENERIC(struct cpu *cpu)
623:{
624:#ifdef MODE32
625:	uint32_t
626:#else
627:	uint64_t
628:#endif
629:	    cached_pc = cpu->pc, physaddr = 0;
630:	uint32_t physpage_ofs;
631:	int ok, pagenr, table_index;
632:	uint32_t *physpage_entryp;
633:	struct DYNTRANS_TC_PHYSPAGE *ppp;
634:
635:#ifdef MODE32
636:	int index = DYNTRANS_ADDR_TO_PAGENR(cached_pc);
637:#else
638:	const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
639:	const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
640:	const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
641:	uint32_t x1, x2, x3;
642:	struct DYNTRANS_L2_64_TABLE *l2;
643:	struct DYNTRANS_L3_64_TABLE *l3;
644:
645:	x1 = (cached_pc >> (64-DYNTRANS_L1N)) & mask1;
646:	x2 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
647:	x3 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N-DYNTRANS_L3N)) & mask3;
648:	/*  fatal("X3: cached_pc=%016" PRIx64" x1=%x x2=%x x3=%x\n",
649:	    (uint64_t)cached_pc, (int)x1, (int)x2, (int)x3);  */
650:	l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
651:	/*  fatal("  l2 = %p\n", l2);  */
652:	l3 = l2->l3[x2];
653:	/*  fatal("  l3 = %p\n", l3);  */
654:#endif
655:
656:	/*  Virtual to physical address translation:  */
657:	ok = 0;
658:#ifdef MODE32
659:	if (cpu->cd.DYNTRANS_ARCH.host_load[index] != NULL) {
660:		physaddr = cpu->cd.DYNTRANS_ARCH.phys_addr[index];
661:		ok = 1;
662:	}
663:#else
664:	if (l3->host_load[x3] != NULL) {
665:		physaddr = l3->phys_addr[x3];
666:		ok = 1;
667:	}
668:#endif
669:
670:	if (!ok) {
671:		uint64_t paddr;
672:		if (cpu->translate_v2p != NULL) {
673:			uint64_t vaddr =
674:#if defined(MODE32) && defined(DYNTRANS_MIPS)
675:			/*  32-bit MIPS is _sign_ extend, not zero.  */
676:			    (int32_t)
677:#endif
678:			    cached_pc;
679:			ok = cpu->translate_v2p(
680:			    cpu, vaddr, &paddr, FLAG_INSTR);
681:		} else {
682:			paddr = cached_pc;
683:			ok = 1;
684:		}
685:		if (!ok) {
686:			/*
687:			 *  The PC is now set to the exception handler.
688:			 *  Try to find the paddr in the translation arrays,
689:			 *  or if that fails, call translate_v2p for the
690:			 *  exception handler.
691:			 */
692:			/*  fatal("TODO: instruction vaddr=>paddr translation "
693:			    "failed. vaddr=0x%" PRIx64"\n", (uint64_t)cached_pc);
694:			fatal("!! cpu->pc=0x%" PRIx64"\n", (uint64_t)cpu->pc); */
695:
696:			/*  If there was an exception, the PC has changed.
697:			    Update cached_pc:  */
698:			cached_pc = cpu->pc;
699:
700:#ifdef MODE32
701:			index = DYNTRANS_ADDR_TO_PAGENR(cached_pc);
702:			if (cpu->cd.DYNTRANS_ARCH.host_load[index] != NULL) {
703:				paddr = cpu->cd.DYNTRANS_ARCH.phys_addr[index];
704:				ok = 1;
705:			}
706:#else
707:			x1 = (cached_pc >> (64-DYNTRANS_L1N)) & mask1;
708:			x2 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N))
709:			    & mask2;
710:			x3 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N
711:			    - DYNTRANS_L3N)) & mask3;
712:			l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
713:			l3 = l2->l3[x2];
714:			if (l3->host_load[x3] != NULL) {
715:				paddr = l3->phys_addr[x3];
716:				ok = 1;
717:			}
718:#endif
719:
720:			if (!ok) {
721:				ok = cpu->translate_v2p(cpu, cpu->pc, &paddr,
722:				    FLAG_INSTR);
723:			}
724:
725:			/*  printf("EXCEPTION HANDLER: vaddr = 0x%x ==> "
726:			    "paddr = 0x%x\n", (int)cpu->pc, (int)paddr);
727:			fatal("!? cpu->pc=0x%" PRIx64"\n", (uint64_t)cpu->pc); */
728:
729:			if (!ok) {
730:				fatal("FATAL: could not find physical"
731:				    " address of the exception handler?");
732:				exit(1);
733:			}
734:		}
735:
736:		physaddr = paddr;
737:	}
738:
739:	physaddr &= ~(DYNTRANS_PAGESIZE - 1);
740:
741:#ifdef MODE32
742:	if (cpu->cd.DYNTRANS_ARCH.host_load[index] == NULL) {
743:#else
744:	if (l3->host_load[x3] == NULL) {
745:#endif
746:		int q = DYNTRANS_PAGESIZE - 1;
747:		unsigned char *host_page = memory_paddr_to_hostaddr(cpu->mem,
748:		    physaddr, MEM_READ);
749:		if (host_page != NULL) {
750:			cpu->update_translation_table(cpu, cached_pc & ~q,
751:			    host_page, 0, physaddr);
752:		}
753:	}
754:
755:	if (cpu->translation_cache_cur_ofs >= dyntrans_cache_size) {
756:		debugmsg(SUBSYS_CPU, "dyntrans", VERBOSITY_INFO,
757:		    "resetting the translation cache");
758:
759:		cpu_create_or_reset_tc(cpu);
760:	}
761:
762:	pagenr = DYNTRANS_ADDR_TO_PAGENR(physaddr);
763:	table_index = PAGENR_TO_TABLE_INDEX(pagenr);
764:
765:	physpage_entryp = &(((uint32_t *)cpu->translation_cache)[table_index]);
766:	physpage_ofs = *physpage_entryp;
767:	ppp = NULL;
768:
769:	/*  Traverse the physical page chain:  */
770:	while (physpage_ofs != 0) {
771:		ppp = (struct DYNTRANS_TC_PHYSPAGE *)(cpu->translation_cache
772:		    + physpage_ofs);
773:
774:		/*  If we found the page in the cache, then we're done:  */
775:		if (ppp->physaddr == physaddr)
776:			break;
777:
778:		/*  Try the next page in the chain:  */
779:		physpage_ofs = ppp->next_ofs;
780:	}
781:
782:	/*
783:	 *  If the offset is 0, then no translation exists yet for this
784:	 *  physical address. Let's create a new page, and add it first in
785:	 *  the chain.
786:	 */
787:	if (physpage_ofs == 0) {
788:		uint32_t previous_first_page_in_chain;
789:
790:		/*  fatal("CREATING page %lli (physaddr 0x%" PRIx64"), table "
791:		    "index %i\n", (long long)pagenr, (uint64_t)physaddr,
792:		    (int)table_index);  */
793:
794:		previous_first_page_in_chain = *physpage_entryp;
795:
796:		/*  Insert the new page first in the chain:  */
797:		*physpage_entryp = physpage_ofs =
798:		    cpu->translation_cache_cur_ofs;
799:
800:		/*  Allocate a default page, with to_be_translated entries:  */
801:		DYNTRANS_TC_ALLOCATE(cpu, physaddr);
802:
803:		ppp = (struct DYNTRANS_TC_PHYSPAGE *)(cpu->translation_cache
804:		    + physpage_ofs);
805:
806:		/*  Point to the other pages in the same chain:  */
807:		ppp->next_ofs = previous_first_page_in_chain;
808:	}
809:
810:	/*  Here, ppp points to a valid physical page struct.  */
811:
812:#ifdef MODE32
813:	if (cpu->cd.DYNTRANS_ARCH.host_load[index] != NULL)
814:		cpu->cd.DYNTRANS_ARCH.phys_page[index] = ppp;
815:#else
816:	if (l3->host_load[x3] != NULL)
817:		l3->phys_page[x3] = ppp;
818:#endif
819:
820:	/*
821:	 *  If there are no translations yet on this page, then mark it
822:	 *  as non-writable. If there are already translations, then it
823:	 *  should already have been marked as non-writable.
824:	 */
825:	if (ppp->translations_bitmap == 0) {
826:		cpu->invalidate_translation_caches(cpu, physaddr,
827:		    JUST_MARK_AS_NON_WRITABLE | INVALIDATE_PADDR);
828:	}
829:
830:	cpu->cd.DYNTRANS_ARCH.cur_ic_page = &ppp->ics[0];
831:
832:	cpu->cd.DYNTRANS_ARCH.next_ic = cpu->cd.DYNTRANS_ARCH.cur_ic_page +
833:	    DYNTRANS_PC_TO_IC_ENTRY(cached_pc);
834:
835:	/*  printf("cached_pc=0x%016" PRIx64"  pagenr=%lli  table_index=%lli, "
836:	    "physpage_ofs=0x%016" PRIx64"\n", (uint64_t)cached_pc, (long long)
837:	    pagenr, (long long)table_index, (uint64_t)physpage_ofs);  */
838:}
839:
840:
841:/*
842: *  XXX_pc_to_pointers():
843: *
844: *  This function uses the current program counter (a virtual address) to
845: *  find out which physical translation page to use, and then sets the current
846: *  translation page pointers to that page.
847: *
848: *  If there was no translation page for that physical page, then an empty
849: *  one is created.
850: *
851: *  NOTE: This is the quick lookup version. See
852: *  DYNTRANS_PC_TO_POINTERS_GENERIC above for the generic case.
853: */
854:void DYNTRANS_PC_TO_POINTERS_FUNC(struct cpu *cpu)
855:{
856:#ifdef MODE32
857:	uint32_t
858:#else
859:	uint64_t
860:#endif
995:
996:
997:#ifdef DYNTRANS_INVAL_ENTRY
998:/*
999: *  XXX_invalidate_tlb_entry():
1000: *
1001: *  Invalidate one translation entry (based on virtual address).
1002: *
1003: *  If the JUST_MARK_AS_NON_WRITABLE flag is set, then the translation entry
1004: *  is just downgraded to non-writable (ie the host store page is set to
1005: *  NULL). Otherwise, the entire translation is removed.
1006: */
1007:static void DYNTRANS_INVALIDATE_TLB_ENTRY(struct cpu *cpu,
1008:#ifdef MODE32
1009:	uint32_t
1010:#else
1011:	uint64_t
1012:#endif
1013:	vaddr_page, int flags)
1014:{
1015:#ifdef MODE32
1016:	uint32_t index = DYNTRANS_ADDR_TO_PAGENR(vaddr_page);
1017:
1018:#ifdef DYNTRANS_ARM
1019:	cpu->cd.DYNTRANS_ARCH.is_userpage[index >> 5] &= ~((uint32_t)1 << (index & 31));
1020:#endif
1021:
1022:	if (flags & JUST_MARK_AS_NON_WRITABLE) {
1023:		/*  printf("JUST MARKING NON-W: vaddr 0x%08x\n",
1024:		    (int)vaddr_page);  */
1025:		cpu->cd.DYNTRANS_ARCH.host_store[index] = NULL;
1026:	} else {
1027:		int tlbi = cpu->cd.DYNTRANS_ARCH.vaddr_to_tlbindex[index];
1028:		cpu->cd.DYNTRANS_ARCH.host_load[index] = NULL;
1029:		cpu->cd.DYNTRANS_ARCH.host_store[index] = NULL;
1030:		cpu->cd.DYNTRANS_ARCH.phys_addr[index] = 0;
1031:		cpu->cd.DYNTRANS_ARCH.phys_page[index] = NULL;
1032:		if (tlbi > 0)
1033:			cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[tlbi-1].valid = 0;
1034:		cpu->cd.DYNTRANS_ARCH.vaddr_to_tlbindex[index] = 0;
1035:	}
1036:#else
1037:	// 64-bit:
1196: *  XXX_invalidate_translation_caches():
1197: *
1198: *  Invalidate all entries matching a specific physical address, a specific
1199: *  virtual address, or ALL entries.
1200: *
1201: *  flags should be one of
1202: *	INVALIDATE_PADDR  INVALIDATE_VADDR  or  INVALIDATE_ALL
1203: *
1204: *  In addition, for INVALIDATE_ALL, INVALIDATE_VADDR_UPPER4 may be set and
1205: *  bit 31..28 of addr are used to select the virtual addresses to invalidate.
1206: *  (This is useful for PowerPC emulation, when segment registers are updated.)
1207: *
1208: *  In the case when all translations are invalidated, paddr doesn't need
1209: *  to be supplied.
1210: *
1211: *  NOTE/TODO: When invalidating a virtual address, it is only cleared from
1212: *             the quick translation array, not from the linear
1213: *             vph_tlb_entry[] array.  Hopefully this is enough anyway.
1214: */
1215:void DYNTRANS_INVALIDATE_TC(struct cpu *cpu, uint64_t addr, int flags)
1216:{
1217:	int r;
1218:#ifdef MODE32
1219:	uint32_t
1220:#else
1221:	uint64_t
1222:#endif
1223:	    addr_page = addr & ~(DYNTRANS_PAGESIZE - 1);
1224:
1225:	/*  fatal("invalidate(): ");  */
1226:
1227:	/*  Quick case for _one_ virtual addresses: see note above.  */
1228:	if (flags & INVALIDATE_VADDR) {
1229:		/*  fatal("vaddr 0x%08x\n", (int)addr_page);  */
1230:
1231:#ifdef MODE32
1232:		DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, addr_page, flags);
1233:#else
1234:		// In principle, there can be multiple entries, and they must
1235:		// be invalidated based on the bits that matter. For example,
1236:		// using vaddr 0x00A0000012345678 and 0x00B000001234567c
1237:		// actually point to the same physical page, and if then
1238:		// the virtual address 0x0000000012345000 is to be invalidated,
1239:		// then both of those should be invalidated!
1240:		int n = 0;
1241:		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++)
1242:			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid &&
1243:			    (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page
1244:			    & cpu->vaddr_mask) == (addr_page & cpu->vaddr_mask)) {
1245:				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page, flags);
1246:				n ++;
1247:			}
1248:
1249:		if (n > 1)
1250:			debug("[ DYNTRANS_INVALIDATE_TC: CACHE COLLISION vaddr 0x%016llx! ]\n",
1251:				(long long)addr_page);
1252:#endif
1253:
1254:		return;
1255:	}
1256:
1257:	/*  Invalidate everything:  */
1258:#ifdef DYNTRANS_PPC
1259:	if (flags & INVALIDATE_ALL && flags & INVALIDATE_VADDR_UPPER4) {
1260:		/*  fatal("all, upper4 (PowerPC segment)\n");  */
1261:		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1262:			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid &&
1263:			    (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page
1264:			    & 0xf0000000) == addr_page) {
1265:				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.
1266:				    DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1267:				    0);
1268:				// Not needed: DYNTRANS_INVALIDATE_TLB_ENTRY should
1269:				// set valid to 0 anyway.
1270:				// cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid=0;
1271:			}
1272:		}
1273:		return;
1274:	}
1275:#endif
1276:	if (flags & INVALIDATE_ALL) {
1277:		/*  fatal("all\n");  */
1278:		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1279:			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid) {
1280:				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.
1281:				    DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1282:				    0);
1283:				// Not needed: DYNTRANS_INVALIDATE_TLB_ENTRY should
1284:				// set valid to 0 anyway.
1285:				// cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid=0;
1286:			}
1287:		}
1288:		return;
1289:	}
1290:
1291:	/*  Invalidate a physical page:  */
1292:
1293:	if (!(flags & INVALIDATE_PADDR))
1294:		fatal("HUH? Invalidate: Not vaddr, all, or paddr?\n");
1295:
1296:	/*  fatal("addr 0x%08x\n", (int)addr_page);  */
1297:
1298:	for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1299:		if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid && addr_page
1300:		    == cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].paddr_page) {
1301:			DYNTRANS_INVALIDATE_TLB_ENTRY(cpu,
1302:			    cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1303:			    flags);
1304:			if (flags & JUST_MARK_AS_NON_WRITABLE)
1305:				cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r]
1306:				    .writeflag = 0;
1307:			else
1308:				cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r]
1309:				    .valid = 0;
1310:		}
1311:	}
1312:}
1313:#endif	/*  DYNTRANS_INVALIDATE_TC  */
1314:
1315:
1316:
1317:#ifdef DYNTRANS_INVALIDATE_TC_CODE
1318:/*
1319: *  XXX_invalidate_code_translation():
1320: *
1321: *  Invalidate code translations for a specific physical address, a specific
1322: *  virtual address, or for all entries in the cache.
1323: */
1324:void DYNTRANS_INVALIDATE_TC_CODE(struct cpu *cpu, uint64_t addr, int flags)
1325:{
1326:	int r;
1327:#ifdef MODE32
1328:	uint32_t
1329:#else
1330:	uint64_t
1331:#endif
1332:	    vaddr_page, paddr_page;
1333:
1334:	addr &= ~(DYNTRANS_PAGESIZE-1);
1335:
1336:	/*  printf("DYNTRANS_INVALIDATE_TC_CODE addr=0x%08x flags=%i\n",
1337:	    (int)addr, flags);  */
1338:
1339:	if (flags & INVALIDATE_PADDR) {
1340:		int pagenr, table_index;
1341:		uint32_t physpage_ofs, *physpage_entryp;
1342:		struct DYNTRANS_TC_PHYSPAGE *ppp, *prev_ppp;
1343:
1344:		pagenr = DYNTRANS_ADDR_TO_PAGENR(addr);
1345:		table_index = PAGENR_TO_TABLE_INDEX(pagenr);
1346:
1347:		physpage_entryp = &(((uint32_t *)cpu->
1348:		    translation_cache)[table_index]);
1349:		physpage_ofs = *physpage_entryp;
1350:
1351:		/*  Return immediately if there is no code translation
1352:		    for this page.  */
1353:		if (physpage_ofs == 0)
1354:			return;
1355:
1356:		prev_ppp = ppp = NULL;
1357:
1358:		/*  Traverse the physical page chain:  */
1359:		while (physpage_ofs != 0) {
1360:			prev_ppp = ppp;
1361:			ppp = (struct DYNTRANS_TC_PHYSPAGE *)
1362:			    (cpu->translation_cache + physpage_ofs);
1363:
1364:			/*  If we found the page in the cache,
1365:			    then we're done:  */
1366:			if (ppp->physaddr == addr)
1367:				break;
1368:
1369:			/*  Try the next page in the chain:  */
1370:			physpage_ofs = ppp->next_ofs;
1371:		}
1372:
1373:		/*  If there is no translation, there is no need to go
1374:		    on and try to remove it from the vph_tlb_entry array:  */
1375:		if (physpage_ofs == 0)
1376:			return;
1377:
1378:#if 0
1379:		/*
1380:		 *  "Bypass" the page, removing it from the code cache.
1381:		 *
1382:		 *  NOTE/TODO: This gives _TERRIBLE_ performance with self-
1383:		 *  modifying code, or when a single page is used for both
1384:		 *  code and (writable) data.
1385:		 */
1386:		if (ppp != NULL) {
1387:			if (prev_ppp != NULL)
1388:				prev_ppp->next_ofs = ppp->next_ofs;
1389:			else
1390:				*physpage_entryp = ppp->next_ofs;
1391:		}
1392:#else
1393:		(void)prev_ppp;	// shut up compiler warning
1394:
1395:		/*
1396:		 *  Instead of removing the page from the code cache, each
1397:		 *  entry can be set to "to_be_translated". This is slow in
1398:		 *  the general case, but in the case of self-modifying code,
1399:		 *  it might be faster since we don't risk wasting cache
1400:		 *  memory as quickly (which would force unnecessary Restarts).
1401:		 */
