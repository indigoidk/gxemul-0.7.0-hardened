647:static void debugger_cmd_dump(struct machine *m, char *args)
648:{
649:	uint64_t addr, addr_start, addr_end;
650:	struct cpu *c;
651:	struct memory *mem;
652:	char *p = NULL;
653:	int x, r;
654:
655:	if (args[0] != '\0') {
