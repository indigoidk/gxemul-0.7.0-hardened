664: *  arm_exception():
665: */
666:void arm_exception(struct cpu *cpu, int exception_nr)
667:{
668:	int oldmode, newmode;
669:	uint32_t retaddr;
670:
671:	if (exception_nr < 0 || exception_nr >= N_ARM_EXCEPTIONS) {
672:		fatal("arm_exception(): exception_nr = %i\n", exception_nr);
673:		exit(1);
674:	}
675:
676:	retaddr = cpu->pc;
677:
678:	if (!quiet_mode) {
679:		debug("[ arm_exception(): ");
680:		switch (exception_nr) {
681:		case ARM_EXCEPTION_RESET:
682:			fatal("RESET: TODO");
683:			break;
684:		case ARM_EXCEPTION_UND:
685:			debug("UNDEFINED");
686:			break;
687:		case ARM_EXCEPTION_SWI:
688:			debug("SWI");
689:			break;
690:		case ARM_EXCEPTION_PREF_ABT:
691:			debug("PREFETCH ABORT");
692:			break;
693:		case ARM_EXCEPTION_IRQ:
694:			debug("IRQ");
695:			break;
696:		case ARM_EXCEPTION_FIQ:
697:			debug("FIQ");
698:			break;
699:		case ARM_EXCEPTION_DATA_ABT:
700:			debug("DATA ABORT, far=0x%08x fsr=0x%02x",
701:			    cpu->cd.arm.far, cpu->cd.arm.fsr);
702:			break;
703:		}
704:		debug(" ]\n");
705:	}
706:
707:	switch (exception_nr) {
708:	case ARM_EXCEPTION_RESET:
709:		cpu->running = 0;
710:		fatal("ARM RESET: TODO");
711:		exit(1);
712:	case ARM_EXCEPTION_DATA_ABT:
713:		retaddr += 4;
714:		break;
715:	}
716:
717:	retaddr += (cpu->cd.arm.cpsr & ARM_FLAG_T ? 2 : 4);
718:
719:	arm_save_register_bank(cpu);
720:
721:	cpu->cd.arm.cpsr &= 0x0fffffff;
722:	cpu->cd.arm.cpsr |= (cpu->cd.arm.flags << 28);
723:
724:	switch (arm_exception_to_mode[exception_nr]) {
725:	case ARM_MODE_SVC32:
726:		cpu->cd.arm.spsr_svc = cpu->cd.arm.cpsr; break;
727:	case ARM_MODE_ABT32:
728:		cpu->cd.arm.spsr_abt = cpu->cd.arm.cpsr; break;
729:	case ARM_MODE_UND32:
730:		cpu->cd.arm.spsr_und = cpu->cd.arm.cpsr; break;
731:	case ARM_MODE_IRQ32:
732:		cpu->cd.arm.spsr_irq = cpu->cd.arm.cpsr; break;
733:	case ARM_MODE_FIQ32:
734:		cpu->cd.arm.spsr_fiq = cpu->cd.arm.cpsr; break;
735:	default:fatal("arm_exception(): unimplemented exception nr\n");
736:		exit(1);
737:	}
738:
739:	/*
740:	 *  Disable Thumb mode (because exception handlers always execute
741:	 *  in ARM mode), set the exception mode, and disable interrupts:
742:	 */
743:	cpu->cd.arm.cpsr &= ~ARM_FLAG_T;
744:
745:	oldmode = cpu->cd.arm.cpsr & ARM_FLAG_MODE;
746:
747:	cpu->cd.arm.cpsr &= ~ARM_FLAG_MODE;
748:	cpu->cd.arm.cpsr |= arm_exception_to_mode[exception_nr];
749:
750:	/*
751:	 *  Usually, an exception should change modes (so that saved status
752:	 *  bits don't get lost). However, Linux on ARM seems to use floating
753:	 *  point instructions in the kernel (!), and it emulates those using
754:	 *  its own fp emulation code. This leads to a situation where we
755:	 *  sometimes change from SVC32 to SVC32.
756:	 */
757:	newmode = cpu->cd.arm.cpsr & ARM_FLAG_MODE;
758:	if (oldmode == newmode && oldmode != ARM_MODE_SVC32) {
759:		fatal("[ WARNING! Exception caused no mode change? "
760:		    "mode 0x%02x (pc=0x%x) ]\n", newmode, (int)cpu->pc);
761:		/*  exit(1);  */
762:	}
763:
764:	cpu->cd.arm.cpsr |= ARM_FLAG_I;
765:	if (exception_nr == ARM_EXCEPTION_RESET ||
766:	    exception_nr == ARM_EXCEPTION_FIQ)
767:		cpu->cd.arm.cpsr |= ARM_FLAG_F;
768:
769:	/*  Load the new register bank, if we switched:  */
770:	arm_load_register_bank(cpu);
771:
772:	/*
773:	 *  Set the return address and new PC.
774:	 *
775:	 *  NOTE: r[ARM_PC] is also set; see cpu_arm_instr_loadstore.c for
776:	 *  details. (If an exception occurs during a load into the pc
777:	 *  register, the code in that file assumes that the r[ARM_PC]
778:	 *  was changed to the address of the exception handler.)
779:	 */
780:	cpu->cd.arm.r[ARM_LR] = retaddr;
781:	cpu->pc = cpu->cd.arm.r[ARM_PC] = exception_nr * 4 +
782:	    ((cpu->cd.arm.control & ARM_CONTROL_V)? 0xffff0000 : 0);
783:	quick_pc_to_pointers(cpu);
784:}
