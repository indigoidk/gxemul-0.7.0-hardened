import ast, pathlib
out = []
for p in pathlib.Path('GXEMUL-SEC/regress').glob('*.py'):
    try:
        tree = ast.parse(p.read_bytes(), filename=str(p))
    except SyntaxError as e:
        print('PARSE_ERROR', p.name, e.lineno)
        continue
    scopes = {}
    def walk(n, scope):
        scopes[id(n)] = scope
        new_scope = scope + [getattr(n, 'name', '<lambda>')] if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda, ast.ClassDef)) else scope
        for c in ast.iter_child_nodes(n):
            walk(c, new_scope)
    walk(tree, [])
    calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == 'session']
    if calls:
        out.append((len(calls), sum(not scopes[id(n)] for n in calls), p.name))
for total, module, name in sorted(out, reverse=True)[:20]:
    print(f'{name}: session call sites={total}, module scope={module}, function scope={total-module}')
