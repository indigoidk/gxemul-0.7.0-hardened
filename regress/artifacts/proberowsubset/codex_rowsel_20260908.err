import ast
from pathlib import Path
for name in ('gdrom_default_probe.py','pcc2_width_probe.py','wdc_flood_probe.py','pcc2_c040_probe.py'):
 tree=ast.parse((Path('GXEMUL-SEC/regress')/name).read_bytes())
 def sessions(n):
  return [x for x in ast.walk(n) if isinstance(x, ast.Call) and isinstance(x.func,ast.Name) and x.func.id=='session']
 direct=[n for n in tree.body if isinstance(n,ast.Assign) and sessions(n)]
 nested=[n for n in tree.body if not isinstance(n,(ast.FunctionDef,ast.Assign)) and sessions(n)]
 print(name, 'direct assignments:',len(direct),'nested module call sites:',sum(len(sessions(n)) for n in nested))
 for n in nested:
  print(' ',type(n).__name__, n.lineno, 'to', n.end_lineno, 'session lines:',','.join(str(x.lineno) for x in sessions(n)))
