GXEMUL-SEC/regress/gate_arm.sh:1141:     for v in "live" "devsig" "lo_kill" "lo_decl" "lo_alive" "lo_sent" "lo_latch" "lo_kill2" "lo_decl2" "lo_alive2" "lo_sent2" "hi_draw" "hi_alive" "hi_rd_draw" "hi_rd_alive" "hi_rd_sent" "two_widths_n" "two_widths_1" "two_widths_2" "dec_switch" "hi_kill" "tail_acc" "tail_acc_x" "tail_acc_h" "acc4_last" "acc8_hi32" "acc8_lo32" "acc8_read" "re_first" "sharedlatch"; do
GXEMUL-SEC/regress/gate_arm.sh:1142:         check "sgi_de row: $v" "$(count "$DEWLOG" "^$v  .*ok$")" "1"
GXEMUL-SEC/regress/gate_arm.sh:1143:     done
GXEMUL-SEC/regress/gate_arm.sh:1144: 
GXEMUL-SEC/regress/gate_arm.sh:1145:     #  DENOMINATOR, SUMMED ARITHMETICALLY.  Two rows, not one: a single "22 ok" check
GXEMUL-SEC/regress/gate_arm.sh:1146:     #  cannot tell a LOST row from a FAILING one, and those need different responses.
GXEMUL-SEC/regress/gate_arm.sh:1147:     #  The sum is arithmetic rather than a string join -- concatenating two counts and
GXEMUL-SEC/regress/gate_arm.sh:1148:     #  comparing to "220" is satisfied by (22 ok, 0 FAIL) AND by (2 ok, 20 FAIL), which
GXEMUL-SEC/regress/gate_arm.sh:1149:     #  is a defect this gate has already shipped once.
GXEMUL-SEC/regress/gate_arm.sh:1150:     check "sgi_de rows emitted" \
GXEMUL-SEC/regress/gate_arm.sh:1151:           "$(( $(count "$DEWLOG" " ok$") + $(count "$DEWLOG" " FAIL$") ))" "30"
GXEMUL-SEC/regress/gate_arm.sh:1152:     check "sgi_de rows green" "$(count "$DEWLOG" " ok$")" "30"
GXEMUL-SEC/regress/gate_arm.sh:1153: fi
GXEMUL-SEC/regress/gate_arm.sh:1154: 
GXEMUL-SEC/regress/gate_arm.sh:1155: SGILOG=$LOGDIR/sgi_re_width.log
GXEMUL-SEC/regress/gate_arm.sh:1156: python3 sgi_re_width_probe.py "$PMAX" gate > "$SGILOG" 2>&1 || true
GXEMUL-SEC/regress/gate_arm.sh:1157: 
GXEMUL-SEC/regress/gate_arm.sh:1158: #  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
GXEMUL-SEC/regress/gate_arm.sh:1159: #  existence: a killed run loses every row and looks exactly like a run that produced none.
GXEMUL-SEC/regress/gate_arm.sh:1160: if ! grep -q "OPUS497T_DONE" "$SGILOG"; then
GXEMUL-SEC/regress/gate_arm.sh:1161:     note "sgi_re width probe did not reach its completion sentinel; last lines follow"
GXEMUL-SEC/regress/gate_arm.sh:1162:     tail -5 "$SGILOG" | sed 's/^/       /'
GXEMUL-SEC/regress/gate_arm.sh:1163:     check "sgi_re width probe completed" "no" "yes"
GXEMUL-SEC/regress/gate_arm.sh:1164: else
GXEMUL-SEC/regress/gate_arm.sh:1165:     grep -E " ok$| FAIL$" "$SGILOG" | sed 's/^/       /'
GXEMUL-SEC/regress/gate_arm.sh:1166: 
GXEMUL-SEC/regress/gate_arm.sh:1167:     #  CONTROLS BY NAME, not by count.  A green-row total lets a control go red while the
GXEMUL-SEC/regress/gate_arm.sh:1168:     #  sum stays acceptable -- and a run whose controls died is an APPARATUS failure, which
GXEMUL-SEC/regress/gate_arm.sh:1169:     #  must not be read as a wall of product failures.
GXEMUL-SEC/regress/gate_arm.sh:1170:     for c in "live" "devsig stat"; do
GXEMUL-SEC/regress/gate_arm.sh:1171:         check "sgi_re control: $c" "$(count "$SGILOG" "^$c  .*ok$")" "1"
GXEMUL-SEC/regress/gate_arm.sh:1172:     done
GXEMUL-SEC/regress/gate_arm.sh:1173:     check "sgi_re controls live" \
GXEMUL-SEC/regress/gate_arm.sh:1174:           "$(grep -q 'OPUS497T_CONTROL=OK' "$SGILOG" && echo yes || echo no)" "yes"
GXEMUL-SEC/regress/gate_arm.sh:1175: 
GXEMUL-SEC/regress/gate_arm.sh:1176:     #  PER-ROW PASS.  Checked individually rather than by a total, because a row that
GXEMUL-SEC/regress/gate_arm.sh:1177:     #  silently stops being tested is the padded-column class: a name as long as its column
GXEMUL-SEC/regress/gate_arm.sh:1178:     #  makes a check UNSATISFIABLE and the row quietly stops being tested.
GXEMUL-SEC/regress/gate_arm.sh:1179:     #  The list is ONE LINE on purpose -- a backslash-continued list assembled through
GXEMUL-SEC/regress/gate_arm.sh:1180:     #  nested quoting once gained a bogus word `n` and shipped a RED gate.
GXEMUL-SEC/regress/gate_arm.sh:1181:     for v in "live" "devsig stat" "tlb_a sw surv" "tlb_a sw lat1" "tlb_a lw surv" "tlb_a accept" "tlb_b sw surv" "tlb_b sw lat1" "tlb_b lw surv" "tlb_b accept" "tlb_c sw surv" "tlb_c sw lat1" "tlb_c lw surv" "tlb_c accept" "tex sw surv" "tex sw lat1" "tex lw surv" "tex accept" "linear_a sw surv" "linear_a sw lat1" "linear_a lw surv" "linear_a accept" "linear_b sw surv" "linear_b sw lat1" "linear_b lw surv" "linear_b accept" "xsite 6msg" "xsite order" "tlb_a ld kill" "tlb_b ld kill" "tlb_c ld kill" "tex ld kill" "linear_a ld kill" "linear_b ld kill" "other decl"; do
GXEMUL-SEC/regress/gate_arm.sh:1182:         check "sgi_re row: $v" "$(count "$SGILOG" "^$v  .*ok$")" "1"
GXEMUL-SEC/regress/gate_arm.sh:1183:     done
GXEMUL-SEC/regress/gate_arm.sh:1184: 
GXEMUL-SEC/regress/gate_arm.sh:1185:     #  DENOMINATOR PINNED TO A LITERAL.  A detector that loses rows must not be able to pass
GXEMUL-SEC/regress/gate_arm.sh:1186:     #  by shrinking, and the count is the only thing that says so.  Raise it DELIBERATELY.
GXEMUL-SEC/regress/gate_arm.sh:1187:     #  Both halves pinned: 35 rows emitted AND all 35 green.  Two rows rather than one,
GXEMUL-SEC/regress/gate_arm.sh:1188:     #  because a single "35 ok" check cannot tell a LOST row from a FAILING one -- and
GXEMUL-SEC/regress/gate_arm.sh:1189:     #  those need different responses.
GXEMUL-SEC/regress/gate_arm.sh:1190:     #  *** THE FIRST DRAFT OF THIS BLOCK HAD TWO DEFECTS, BOTH FOUND BY THE PASS-2 SEAT.
GXEMUL-SEC/regress/gate_arm.sh:1191:     #  (1) It ended in `|| true`, which is INERT: check() in lib.sh has no `return`, so
GXEMUL-SEC/regress/gate_arm.sh:1192:     #  it exits 0 on BOTH branches and the row counts into _fails regardless.  The
GXEMUL-SEC/regress/gate_arm.sh:1193:     #  suppression never existed -- but a reader would conclude that row was advisory,
GXEMUL-SEC/regress/gate_arm.sh:1194:     #  which is worse than either behaviour on its own.
GXEMUL-SEC/regress/gate_arm.sh:1195:     #  (2) The denominator concatenated two counts and compared to "350" -- satisfied by
GXEMUL-SEC/regress/gate_arm.sh:1196:     #  (35 ok, 0 FAIL) AND by (3 ok, 50 FAIL).  A string join is not an arithmetic
GXEMUL-SEC/regress/gate_arm.sh:1197:     #  identity, and it was redundant with the two rows below it anyway. ***
GXEMUL-SEC/regress/gate_arm.sh:1198:     #  *** AND THE FIRST REPAIR OF (2) REPRODUCED THE VERY DEFECT THE PANEL HAD JUST FOUND
GXEMUL-SEC/regress/gate_arm.sh:1199:     #  IN THIS ROUND'S BRIEF.  I wrote `count "$SGILOG" " ok$| FAIL$"` -- but count() is
GXEMUL-SEC/regress/gate_arm.sh:1200:     #  `grep -ac`, PLAIN grep, so `|` is a LITERAL and the pattern matches NOTHING.
GXEMUL-SEC/regress/gate_arm.sh:1201:     #  Measured: 0 against a log holding 35 rows.  The seats had flagged `grep -i
GXEMUL-SEC/regress/gate_arm.sh:1202:     #  'sgi|width'` in the brief for exactly this, one hour earlier. ***
GXEMUL-SEC/regress/gate_arm.sh:1203:     #
GXEMUL-SEC/regress/gate_arm.sh:1204:     #  Summed ARITHMETICALLY instead, which needs no regex dialect at all -- and unlike the
GXEMUL-SEC/regress/gate_arm.sh:1205:     #  string-concatenation form it replaces, it cannot be satisfied by (3 ok, 50 FAIL).
GXEMUL-SEC/regress/gate_arm.sh:1206:     check "sgi_re rows emitted" \
GXEMUL-SEC/regress/gate_arm.sh:1207:           "$(( $(count "$SGILOG" " ok$") + $(count "$SGILOG" " FAIL$") ))" "35"
GXEMUL-SEC/regress/gate_arm.sh:1208:     check "sgi_re rows green"   "$(count "$SGILOG" " ok$")"   "35"
GXEMUL-SEC/regress/gate_arm.sh:1209:     check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
GXEMUL-SEC/regress/gate_arm.sh:1210: 
GXEMUL-SEC/regress/gate_arm.sh:1211: fi
GXEMUL-SEC/regress/gate_arm.sh:1212: 
GXEMUL-SEC/regress/gate_arm.sh:1213: #  ---- *** MOVED OUT ONE NESTING LEVEL, 2026-08-31.  It was pasted INSIDE the
GXEMUL-SEC/regress/gate_arm.sh:1214: #  ---- sgi_re_width probe's success branch, so if THAT probe missed its sentinel this
GXEMUL-SEC/regress/gdrom_default_probe.py:250: #  *** THE ROW-NAME COLUMN IS 14 AND THE LONGEST NAME IS 12, WHICH IS NOT
GXEMUL-SEC/regress/gdrom_default_probe.py:251: #  SLACK -- IT IS THE DISCRIMINATOR. ***
GXEMUL-SEC/regress/gdrom_default_probe.py:252: #
GXEMUL-SEC/regress/gdrom_default_probe.py:253: #  gate_sh_rounding.sh counts rows with `^$v  .*ok$` -- TWO spaces after the
GXEMUL-SEC/regress/gdrom_default_probe.py:254: #  name.  Four names here are prefixes of others (`dma rd`/`dma rd x1`,
GXEMUL-SEC/regress/gdrom_default_probe.py:255: #  `dma rd`/`dma rdleak`, `dma alias`/`dma alias x1`, `scan`/`scan uniq`),
GXEMUL-SEC/regress/gdrom_default_probe.py:256: #  and they are unambiguous ONLY because %-14s leaves at least two spaces
GXEMUL-SEC/regress/gdrom_default_probe.py:257: #  after every one of them.  `dma rd` cannot match the `dma rdleak` row
GXEMUL-SEC/regress/gdrom_default_probe.py:258: #  because that row has an `l` where the pattern needs a space.
GXEMUL-SEC/regress/gdrom_default_probe.py:259: #
GXEMUL-SEC/regress/gdrom_default_probe.py:260: #  *** #490 L4: THIS SAID "13 or 14" AND 13 IS FINE.  THE LIMIT IS 13. ***
GXEMUL-SEC/regress/gdrom_default_probe.py:261: #  The format is `"%-14s %-12s ..."` -- a 14-column field PLUS a literal
GXEMUL-SEC/regress/gdrom_default_probe.py:262: #  space -- so the padding and that space add up like this, measured:
GXEMUL-SEC/regress/gdrom_default_probe.py:263: #
GXEMUL-SEC/regress/gdrom_default_probe.py:264: #      12 chars -> 3 trailing spaces   `^name  ` MATCHES
GXEMUL-SEC/regress/gdrom_default_probe.py:265: #      13 chars -> 2 trailing spaces   MATCHES  (the comment denied this)
GXEMUL-SEC/regress/gdrom_default_probe.py:266: #      14 chars -> 1 trailing space    UNSATISFIABLE
GXEMUL-SEC/regress/gdrom_default_probe.py:267: #
GXEMUL-SEC/regress/gdrom_default_probe.py:268: #  Found by the codex seat on #490's pass 1, which also caught that I had
GXEMUL-SEC/regress/gdrom_default_probe.py:269: #  copied the wrong bound ("<= 12") out of this comment and into a design
GXEMUL-SEC/regress/gdrom_default_probe.py:270: #  brief -- so the error had already propagated once before it was read.
GXEMUL-SEC/regress/gdrom_default_probe.py:271: #  The extra character is NOT slack to spend casually: at 13 the margin is
GXEMUL-SEC/regress/gdrom_default_probe.py:272: #  exactly the two spaces the gate needs, with nothing left over.
GXEMUL-SEC/regress/gdrom_default_probe.py:273: #
GXEMUL-SEC/regress/gdrom_default_probe.py:274: #  A row named 14 characters leaves fewer than two spaces and its
GXEMUL-SEC/regress/gdrom_default_probe.py:275: #  check becomes UNSATISFIABLE.  Checked, and this is the SAFE direction:
GXEMUL-SEC/regress/gdrom_default_probe.py:276: #  the count reads 0 against a wanted 1, so the gate fails LOUDLY rather
GXEMUL-SEC/regress/gdrom_default_probe.py:277: #  than quietly dropping the row -- the opposite of the padded-column trap
GXEMUL-SEC/regress/gdrom_default_probe.py:278: #  the carrier records, where a too-long name makes a row stop being
GXEMUL-SEC/regress/gdrom_default_probe.py:279: #  tested in silence.  Widen the column if a longer name is ever needed;
GXEMUL-SEC/regress/gdrom_default_probe.py:280: #  do not shorten the name to fit and leave the constraint unstated.
GXEMUL-SEC/regress/gdrom_default_probe.py:281: def row(name, got, want, note=""):
GXEMUL-SEC/regress/gdrom_default_probe.py:282:     ok = (got == want)
GXEMUL-SEC/regress/gdrom_default_probe.py:283:     rows.append((name, ok))
GXEMUL-SEC/regress/gdrom_default_probe.py:284:     print("%-14s %-12s %-12s %-34s %s" % (name, got, want, note,
GXEMUL-SEC/regress/gdrom_default_probe.py:285:                                           "ok" if ok else "FAIL"))
GXEMUL-SEC/regress/gdrom_default_probe.py:286:     return ok
