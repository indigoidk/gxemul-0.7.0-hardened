 110: void memory_writemax64(struct cpu *cpu, unsigned char *data, int len, uint64_t d)
 111: { (void)cpu; (void)data; (void)len; (void)d; }
 112: struct timer *timer_add(double freq, void (*f)(struct timer *, void *), void *e)
 113: { (void)f; (void)e; timer_adds++; last_timer_hz = freq; return (struct timer *)(void *)&timer_adds; }
 114: void timer_remove(struct timer *t) { (void)t; timer_removes++; }
 115: void timer_update_frequency(struct timer *t, double freq)
 116: { (void)t; timer_updates++; last_timer_hz = freq; }
