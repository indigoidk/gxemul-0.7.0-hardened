 132: /*
 133:  *  #432: ONE interpretation of the load register, used by BOTH consumers.
 134:  *
 135:  *  THE CRASH.  DEVICE_TICK computed `random() % timer_load[i]`, and TIMER_x_LOAD accepts a
 136:  *  guest-written zero (`idata & TIMER_MAX_VAL`), so a guest could divide by zero and take the
 137:  *  HOST process down -- reproduced as SIGFPE, exit 136, by two seats independently.
 138:  *
 139:  *  THERE ARE TWO ROUTES TO IT, and only one is ours.  Route 1: a zero load makes the rate
 140:  *  +INF, which before #427/#428 meant interval 0.0 and a catch-up loop that never advanced,
 141:  *  so the machine froze before this function ran; the clamp and the bound opened that path.
 142:  *  ROUTE 2 PREDATES BOTH: TIMER_x_LOAD does not clear pending_timer_interrupts (TIMER_x_CONTROL
 143:  *  below does), so an ORDINARY LEGAL timer accrues a backlog and a later write of zero divides
 144:  *  -- measured on the pre-#427 core, it crashes there too.  DEVICE_TICK runs from machine_run(),
 145:  *  the main loop, not from the signal handler, so the CPU reaches the divide between signals.
 146:  *
 147:  *  WHY A HELPER RATHER THAN TWO GUARDS.  Three seats converged on this independently, and the
 148:  *  measuring seat REFUTED each single-site alternative: guarding only this function still
 149:  *  SIGFPEs by route 2 (and is the most dangerous option precisely because it passes the obvious
 150:  *  test); guarding only the modulo leaves the backlog growing 1048576 per signal, reaching
 151:  *  INT_MAX in ~31 s; and normalising at the guest write corrupts read-back -- TIMER_x_LOAD
 152:  *  returns the stored value, so the guest would read something it never wrote, which invents an
 153:  *  answer to a question the hardware documentation we lack would have to settle.
 154:  *
 155:  *  THE REGISTER STAYS RAW.  timer_load[] keeps exactly what the guest wrote, masked to 24 bits.
 156:  *  Only the DERIVED quantities are interpreted here, and they are model-internal.
 157:  *
 158:  *  ZERO MEANS FULL PERIOD (2^24), and it is a CHOICE UNDER A DOCUMENTED UNKNOWN, not a fact.
 159:  *
 160:  *  The 21285 datasheet was obtained for this round (_scratchpad/dc21285.pdf, Intel order
 161:  *  278115-001, Sept 1998).  SS 7.3.39 (p. 7-50) specifies TimerNLoad and its reset value without
 162:  *  saying what a count of zero does, and a search of the full extraction for "minimum count" /
 163:  *  "nonzero" / "reaches zero" turns up no equivalent of the 8254's Figure 22.  So the absence is
 164:  *  MEASURED, not assumed -- a stronger thing to say than the guess it replaces.
 165:  *
 166:  *  BUT "SILENT" OVERSTATES IT BY HALF, and the pass-2 review caught that in this round's favour.
 167:  *  SS 7.3.41 bit 6 says a FREE-RUNNING timer "will wrap to FFFFFFh and continue to decrement",
 168:  *  which together with SS 6.4's 24-bit down counter DETERMINES the free-run case: a load of zero
 169:  *  gives a period of exactly 2^24, i.e. the mapping below is datasheet-IMPLIED there -- and
 170:  *  free-running is bit 6 == 0, the reset mode.  It is genuinely unknown only for PERIODIC.
 171:  *
 172:  *  The choice therefore rests on failure asymmetry, and there are THREE candidate truths rather
 173:  *  than the two first written here.  Implement full-period when the truth is "disabled" and a
 174:  *  guest gets a few unwanted interrupts on a timer it explicitly enabled -- noisy, visible,
 175:  *  recoverable.  Implement "disabled" when the truth is full-period and the guest waits forever
 176:  *  on a tick that never comes -- silent, and it hangs at boot.  And the third, which the first
 177:  *  draft omitted: read mechanically, PERIODIC mode with a zero load reloads zero and interrupts
 178:  *  every prescaled clock -- a max-rate storm, the DANGEROUS branch rather than the silent one.
 179:  *  Full-period is the only choice that survives all three, so the argument was understating its
 180:  *  own robustness.
 181:  *
 182:  *  A SECOND SUPPORT WAS ALSO WITHDRAWN, for the same reason as the third and by a seat whose
 183:  *  answer sat unread for a day.  It said the 24-bit mask aliases "a legitimate guest write of
 184:  *  0x1000000 -- one full wrap -- to zero, so this mapping keeps the rate continuous across the
 185:  *  register's own truncation".  The datasheet closes it: SS 7.3.39 gives TimerNLoad as bits 23:0
 186:  *  R/W with "31:24 -- R Read only as 0", so bit 24 is not a truncated write at all, it is OUTSIDE
 187:  *  THE WRITABLE FIELD.  There is no wrap to be continuous across, and continuity beyond a
 188:  *  register's own width is a modelling preference dressed up as arithmetic.  Zero -> 2^24 stands
 189:  *  on the three-way argument above and on nothing else; what silicon does with a zero load
 190:  *  remains UNKNOWN, and SS 7.3.39 is silent on it.
 191:  *
 192:  *  A THIRD ARGUMENT WAS WITHDRAWN WHEN THE DATASHEET ARRIVED, and it is recorded because the
 193:  *  withdrawal matters more than the argument did.  An earlier draft of this comment said
 194:  *  "devinit resets every load to TIMER_MAX_VAL, so the model's own convention is full width".
 195:  *  The datasheet says TimerNLoad and TimerNControl BOTH reset to 0 (SS 7.3.39, SS 7.3.41), so
 196:  *  this model's reset values are themselves wrong -- that line was citing a model bug as
 197:  *  evidence.  The divergence is filed; it is not fixed here.
 198:  *
 199:  *  THE WIDTH FIX IS NOT SEPARABLE FROM THE ZERO FIX.  The old `int cycles` with `cycles <<= 8`
 200:  *  overflowed for exactly half the legal 24-bit range (first bad load 0x800000), yielding a
 201:  *  NEGATIVE frequency that the core's floor clamp silently turned into one tick per ~3.2 years
 202:  *  -- reachable with NO load write at all, since the reset load is TIMER_MAX_VAL and a single
 203:  *  write of ENABLE|FCLK_256 gets there.  And mapping zero to 2^24 while leaving `int` gives
 204:  *  2^24 << 8 == 2^32 == 0, which is +INF AGAIN: the obvious zero-guard RE-CREATES the bug it
 205:  *  removes.  Hence uint64_t, and multiplication rather than a signed shift.  Found independently
 206:  *  by three seats.
 207:  *
 208:  *  (8253 maps a zero divisor to "disabled" instead -- and a pass-2 seat caught that an earlier
 209:  *  version of this parenthetical argued the point BACKWARDS.  It said the 8253's 16-bit counter
 210:  *  "has no equivalent of the 24-bit aliasing above", but writing 0x10000 to a 16-bit latch aliases
 211:  *  to zero in exactly the same way -- which is precisely WHY the Intel 8254 datasheet defines a
 212:  *  programmed count of 0 as 2^16 (231164-005, p. 17).  So the aliasing argument REINFORCES this
 213:  *  mapping rather than distinguishing it, and dev_8253.c's "disabled" is the one that looks wrong
 214:  *  against its own hardware.  Filed as its own item; not changed here.)
 215:  */
 216: /*
 217:  *  with_prescaler distinguishes the two consumers, and it is NOT a convenience flag -- getting
 218:  *  it wrong is a defect the measuring seat caught in its own first proposal.  The prescaler
 219:  *  slows the RATE; it does not widen the COUNTER.  Feeding the prescaled period to the modulo
 220:  *  put values up to 0x7fffca11 into a 24-bit register that the guest can read back -- measured,
 221:  *  19833 of 20000 ticks out of range.  So: the rate consumer prescales, the counter consumer
 222:  *  does not, and both get their never-zero span from this one function.
 223:  */
 224: static uint64_t footbridge_effective_cycles(uint32_t load, uint32_t control,
 225: 	int with_prescaler)
 226: {
 227: 	uint64_t cycles = load;
 228: 
 229: 	if (cycles == 0)
 230: 		cycles = (uint64_t)TIMER_MAX_VAL + 1;	/*  0x1000000 == 2^24  */
 231: 
 232: 	if (!with_prescaler)
 233: 		return cycles;
 234: 
 235: 	/*  The prescaler scales the PERIOD.  It must not be a signed shift, and the order
 236: 	    matters: TIMER_EXTERNAL is FCLK_16|FCLK_256, so test the pair first or 0x0C reads
 237: 	    as a bare FCLK_16 by luck of the `else if`.  */
 238: 	if ((control & (TIMER_FCLK_16 | TIMER_FCLK_256))
 239: 	    == (TIMER_FCLK_16 | TIMER_FCLK_256)) {
 240: 		/*  TIMER_EXTERNAL (0x0C): a LEGAL encoding, and this is now DATASHEET-BACKED
 241: 		    rather than inferred from the header.  The 21285 datasheet obtained for this
 242: 		    round gives TimerNControl bits 3:2 as 00=fclk_in, 01=fclk_in/16,
 243: 		    10=fclk_in/256, 11=External event (SS 7.3.41, p. 7-51; SS 6.4, p. 6-11 lists
 244: 		    the same four).  It used to reach fatal()+exit(1) below, so a CONFORMING guest
 245: 		    selecting the external clock source killed the host -- the same defect class as
 246: 		    the divide and arguably likelier, being a documented mode rather than a
 247: 		    malformed value.  The RATE an external source would give depends on a pin this
 248: 		    model has no signal for (irq_in_l), so it is genuinely not derivable here and
 249: 		    is NOT invented: the unprescaled period keeps the timer sane and the emulator
 250: 		    alive.  Modelling the external event properly is filed.  */
 251: 		;
 252: 	} else if (control & TIMER_FCLK_16)
 253: 		cycles *= 16;
 254: 	else if (control & TIMER_FCLK_256)
 255: 		cycles *= 256;
 256: 
 257: 	return cycles;
 258: }
 259: 
 260: 
 261: static void reload_timer_value(struct cpu *cpu, struct footbridge_data *d,
 262: 	int timer_nr)
 263: {
 264: 	double freq = (double)cpu->machine->emulated_hz;
 265: 
 266: 	freq /= (double) footbridge_effective_cycles(d->timer_load[timer_nr],
 267: 	    d->timer_control[timer_nr], 1);
 268: 
 269: 	d->timer_value[timer_nr] = d->timer_load[timer_nr];
 270: 
 271: 	/*
 272: 	 *  #442: one emulated second of THIS timer's delivered rate, clamped.
 273: 	 *
 274: 	 *  The ceiling is DERIVED, not chosen: TIMER_MAX_CATCHUP ticks per timer
 275: 	 *  per signal at TIMER_BASE_FREQUENCY signals per second is the most the
 276: 	 *  timer core can ever deliver to one timer in one wall second, so a cap
 277: 	 *  at that value can never throttle a legitimately fast timer.
 278: 	 *
 279: 	 *  IT IS ALSO NOT OPTIONAL, which a purely rate-relative bound hides.
 280: 	 *  MEASURED: with `-I 2147483647` and load 1 the requested rate is
 281: 	 *  2147483647.0, so (int)freq is INT_MAX and a bound of "the timer's own
 282: 	 *  rate" never fires -- the overflow returns, reachable through a
 283: 	 *  documented command-line flag.  Deleting these two lines is the
 284: 	 *  smallest edit that still passes the rung-3 probe.
 285: 	 *
 286: 	 *  Floor 1.  *** ITS ORIGINAL JUSTIFICATION WAS MEASURED FALSE and is
 287: 	 *  corrected here rather than quietly dropped: *** the comment claimed a
 288: 	 *  0.0116 Hz timer "would otherwise bound at 0 and the counter would be
 289: 	 *  pinned there".  With the floor PRESENT that case already reads peak 1,
 290: 	 *  and with the floor DELETED the harness output is BYTE-IDENTICAL -- a
 291: 	 *  bound of 0 and a bound of 1 both pin at 1.  The floor prevents nothing
 292: 	 *  today; it is kept as a guard against a future bound expression that
 293: 	 *  could go negative, and that is the honest reason.
 294: 	 *
 295: 	 *  The comparisons are negated, but NOT for the reason first written.
 296: 	 *  timer_clamp_freq() puts its FLOOR first deliberately (timer.c:80-82:
 297: 	 *  "the FLOOR is tested FIRST so a NaN lands SLOW rather than fast"), and
 298: 	 *  this tests the CEILING first -- the inverse.  Harmless, because NaN is
 299: 	 *  UNREACHABLE here: emulated_hz is an int (machine.h:191) and
 300: 	 *  footbridge_effective_cycles() is >= 1 by construction, so this is
 301: 	 *  finite / finite-nonzero.  The claim to "match timer_clamp_freq's idiom"
 302: 	 *  was false in the one respect that idiom is about.
 303: 	 *
 304: 	 *  Set before timer_add()/timer_update_frequency() below.  *** THE REASON
 305: 	 *  FIRST GIVEN HERE -- that a SIGALRM landing between them would find a
 306: 	 *  zero bound -- IS NOT LOAD-BEARING, measured. ***  On the FIRST arm the
 307: 	 *  timer is not in first_timer until timer_add() links it, and timer.c
 308: 	 *  publishes fully-initialised (next stored before first_timer); on later
 309: 	 *  arms the OLD bound is still a valid bound.  A mutant moving this store
 310: 	 *  below the switch is a ZERO-BYTE object delta and passes every row.
 311: 	 *
 312: 	 *  Kept in this order because it reads correctly and costs nothing, not
 313: 	 *  because it closes a window.  Note also that this and the DEVINIT seed
 314: 	 *  are REDUNDANT WITH EACH OTHER -- either alone removes the zero-bound
 315: 	 *  state -- and neither comment used to mention the other doing the work.
 316: 	 */
 317: 	{
 318: 		double bound = freq;
 319: 		if (!(bound <= (double)TIMER_MAX_CATCHUP * TIMER_BASE_FREQUENCY))
 320: 			bound = (double)TIMER_MAX_CATCHUP * TIMER_BASE_FREQUENCY;
 321: 		if (!(bound >= 1.0))
 322: 			bound = 1.0;
 323: 		d->pending_bound[timer_nr] = (int) bound;
 324: 	}
 325: 
 326: 	/*  printf("%i: %i -> %f Hz\n", timer_nr,
 327: 	    d->timer_load[timer_nr], freq);  */
 328: 
 329: 	if (d->timer[timer_nr] == NULL) {
 330: 		switch (timer_nr) {
 331: 		case 0:	d->timer[0] = timer_add(freq, timer_tick0, d); break;
 332: 		case 1:	d->timer[1] = timer_add(freq, timer_tick1, d); break;
 333: 		case 2:	d->timer[2] = timer_add(freq, timer_tick2, d); break;
 334: 		case 3:	d->timer[3] = timer_add(freq, timer_tick3, d); break;
 335: 		}
 336: 	} else {
 337: 		timer_update_frequency(d->timer[timer_nr], freq);
 338: 	}
 339: }
 340: 
 341: 
 342: /*
 343:  *  The 4 footbridge timers should decrease and cause interrupts. Periodic
 344:  *  interrupts restart as soon as they are acknowledged, non-periodic
 345:  *  interrupts need to be "reloaded" to restart.
 346:  *
 347:  *  TODO: Hm. I thought I had solved this, but it didn't quite work.
 348:  *        This needs to be re-checked against documentation, sometime.
 349:  */
 350: DEVICE_TICK(footbridge)
 351: {
 352: 	struct footbridge_data *d = (struct footbridge_data *) extra;
 353: 	int i;
 354: 
 355: 	for (i=0; i<N_FOOTBRIDGE_TIMERS; i++) {
 356: 		if (d->timer_control[i] & TIMER_ENABLE) {
 357: 			if (d->pending_timer_interrupts[i] > 0) {
 358: 				/*  #432: the same never-zero span, WITHOUT the
 359: 				    prescaler -- this is a 24-bit counter, and the
 360: 				    prescaler slows the rate rather than widening
 361: 				    it.  */
 362: 				d->timer_value[i] = random() %
 363: 				    footbridge_effective_cycles(d->timer_load[i],
 364: 				    d->timer_control[i], 0);
 365: 				INTERRUPT_ASSERT(d->timer_irq[i]);
 366: 			}
 367: 		}
 368: 	}
 369: }
 370: 
 371: 
 372: /*
 373:  *  footbridge_interrupt_assert():
 374:  */
 375: void footbridge_interrupt_assert(struct interrupt *interrupt)
 376: {
 377: 	struct footbridge_data *d = (struct footbridge_data *) interrupt->extra;
 378: 	d->irq_status |= interrupt->line;
 379: 
 380: 	// Patch from NetBSD:
 381: 	// "fix hang interrupt issue. Always assert the irq's even if we have
 382: 	//  already asserted the global irq for the device. prevents hangs with
 383: 	//  cats."
 384: 	if ((d->irq_status & d->irq_enable) /* && !d->irq_asserted */) {
 385: 		d->irq_asserted = 1;
 386: 		INTERRUPT_ASSERT(d->irq);
 387: 	}
 388: }
 389: 
 390: 
 391: /*
 392:  *  footbridge_interrupt_deassert():
 393:  */
 394: void footbridge_interrupt_deassert(struct interrupt *interrupt)
 395: {
 396: 	struct footbridge_data *d = (struct footbridge_data *) interrupt->extra;
 397: 	d->irq_status &= ~interrupt->line;
 398: 
 399: 	if (!(d->irq_status & d->irq_enable) && d->irq_asserted) {
 400: 		d->irq_asserted = 0;
 401: 		INTERRUPT_DEASSERT(d->irq);
 402: 	}
 403: }
 404: 
 405: 
 406: /*
 407:  *  Reading the byte at 0x79000000 is a quicker way to figure out which ISA
 408:  *  interrupt has occurred (and acknowledging it at the same time), than
 409:  *  dealing with the legacy 0x20/0xa0 ISA ports.
 410:  */
 411: DEVICE_ACCESS(footbridge_isa)
 412: {
 413: 	/*  struct footbridge_data *d = extra;  */
 414: 	uint64_t idata = 0, odata = 0;
 415: 	int x;
 416: 
 417: 	if (writeflag == MEM_WRITE) {
 418: 		idata = memory_readmax64(cpu, data, len);
 419: 		fatal("[ footbridge_isa: WARNING/TODO: write! idata = 0x%016" PRIx64" ]\n", idata);
 420: 	}
 421: 
 422: 	x = cpu->machine->isa_pic_data.last_int;
 423: 	if (x < 8)
 424: 		odata = cpu->machine->isa_pic_data.pic1->irq_base + x;
 425: 	else
 426: 		odata = cpu->machine->isa_pic_data.pic2->irq_base + x - 8;
 427: 
 428: 	if (writeflag == MEM_READ)
 429: 		memory_writemax64(cpu, data, len, odata);
 430: 
 431: 	return 1;
 432: }
 433: 
 434: 
 435: /*
 436:  *  Reset pin at ISA port 0x338, at least in the NetWinder:
 437:  *
 438:  *  TODO: NOT WORKING YET!
 439:  */
 440: DEVICE_ACCESS(footbridge_reset)
 441: {
 442: 	uint64_t idata = 0;
 443: 
 444: 	if (writeflag == MEM_WRITE) {
 445: 		idata = memory_readmax64(cpu, data, len);
 446: 		if (idata & 0x40) {
 447: 			debug("[ footbridge_reset: GP16: Halting. ]\n");
 448: 			/*  #220: (Codex/Fable) cpu->running=0 already halts cleanly;
 449: 			    the col-0 exit(1) was a debug hack that kills the host.  */
 450: 			cpu->running = 0;
 451: 		}
 452: 	}
 453: 
 454: 	return 1;
 455: }
 456: 
 457: 
 458: /*
 459:  *  The Footbridge PCI configuration space is implemented as a direct memory
 460:  *  space (i.e. not one port for addr and one port for data). This function
 461:  *  translates that into bus_pci calls.
 462:  */
 463: DEVICE_ACCESS(footbridge_pci)
 464: {
 465: 	struct footbridge_data *d = (struct footbridge_data *) extra;
 466: 	uint64_t idata = 0, odata = 0;
 467: 	int bus, dev, func, reg;
 468: 
 469: 	if (writeflag == MEM_WRITE)
 470: 		idata = memory_readmax64(cpu, data, len|MEM_PCI_LITTLE_ENDIAN);
 471: 
 472: 	/*  Decompose the (direct) address into its components:  */
 473: 	bus_pci_decompose_1(relative_addr, &bus, &dev, &func, &reg);
 474: 	bus_pci_setaddr(cpu, d->pcibus, bus, dev, func, reg);
 475: 
 476: 	if (bus == 255) {
 477: 		fatal("[ footbridge DEBUG ERROR: bus 255 unlikely,"
 478: 		    " pc (might not be updated) = 0x%08x ]\n", (int)cpu->pc);
 479: 		/*  #220: (Codex/Fable) don't exit() the host on a guest PCI
 480: 		    access to the (unlikely) bus 255; treat it as handled.  */
 481: 		return 1;
 482: 	}
 483: 
 484: 	debug("[ footbridge pci: %s bus %i, device %i, function %i, register "
 485: 	    "%i ]\n", writeflag == MEM_READ? "read from" : "write to", bus,
 486: 	    dev, func, reg);
 487: 
 488: 	bus_pci_data_access(cpu, d->pcibus, writeflag == MEM_READ?
 489: 	    &odata : &idata, len, writeflag);
 490: 
 491: 	if (writeflag == MEM_READ)
 492: 		memory_writemax64(cpu, data, len|MEM_PCI_LITTLE_ENDIAN, odata);
 493: 
 494: 	return 1;
 495: }
 496: 
 497: 
 498: DEVICE_ACCESS(footbridge)
 499: {
 500: 	struct footbridge_data *d = (struct footbridge_data *) extra;
 501: 	uint64_t idata = 0, odata = 0;
 502: 	int timer_nr = 0;
 503: 
 504: 	if (writeflag == MEM_WRITE)
 505: 		idata = memory_readmax64(cpu, data, len);
 506: 
 507: 	if (relative_addr >= TIMER_1_LOAD && relative_addr <= TIMER_4_CLEAR) {
 508: 		timer_nr = (relative_addr >> 5) & (N_FOOTBRIDGE_TIMERS - 1);
 509: 		relative_addr &= ~0x060;
 510: 	}
 511: 
 512: 	switch (relative_addr) {
 513: 
 514: 	case VENDOR_ID:
 515: 		odata = 0x1011;  /*  DC21285_VENDOR_ID  */
 516: 		break;
 517: 
 518: 	case DEVICE_ID:
 519: 		odata = 0x1065;  /*  DC21285_DEVICE_ID  */
 520: 		break;
 521: 
 522: 	case 0x04:
 523: 	case 0x0c:
 524: 	case 0x10:
 525: 	case 0x14:
 526: 	case 0x18:
 527: 		/*  TODO. Written to by Linux.  */
 528: 		break;
 529: 
 530: 	case REVISION:
 531: 		odata = 3;  /*  footbridge revision number  */
 532: 		break;
 533: 
 534: 	case PCI_ADDRESS_EXTENSION:
 535: 		/*  TODO: Written to by Linux.  */
 536: 		if (writeflag == MEM_WRITE && idata != 0)
 537: 			fatal("[ footbridge: TODO: write to PCI_ADDRESS_"
 538: 			    "EXTENSION: 0x%llx ]\n", (long long)idata);
 539: 		break;
 540: 
 541: 	case SA_CONTROL:
 542: 		/*  Read by Linux:  */
 543: 		odata = PCI_CENTRAL_FUNCTION;
 544: 		break;
 545: 
 546: 	case UART_DATA:
 547: 		if (writeflag == MEM_WRITE)
 548: 			console_putchar(d->console_handle, idata);
 549: 		break;
 550: 
 551: 	case UART_RX_STAT:
 552: 		/*  TODO  */
 553: 		odata = 0;
 554: 		break;
 555: 
 556: 	case UART_FLAGS:
 557: 		odata = UART_TX_EMPTY;
 558: 		break;
 559: 
 560: 	case IRQ_STATUS:
 561: 		if (writeflag == MEM_READ)
 562: 			odata = d->irq_status & d->irq_enable;
 563: 		else {
 564: 			fatal("[ WARNING: footbridge write to irq status? ]\n");
 565: 			exit(1);
 566: 		}
 567: 		break;
 568: 
 569: 	case IRQ_RAW_STATUS:
 570: 		if (writeflag == MEM_READ)
 571: 			odata = d->irq_status;
 572: 		else {
 573: 			fatal("[ footbridge write to irq_raw_status ]\n");
 574: 			exit(1);
 575: 		}
 576: 		break;
 577: 
 578: 	case IRQ_ENABLE_SET:
 579: 		if (writeflag == MEM_WRITE) {
 580: 			d->irq_enable |= idata;
 581: 			if (d->irq_status & d->irq_enable)
 582: 				INTERRUPT_ASSERT(d->irq);
 583: 			else
 584: 				INTERRUPT_DEASSERT(d->irq);
 585: 		} else {
 586: 			odata = d->irq_enable;
 587: 			fatal("[ WARNING: footbridge read from "
 588: 			    "ENABLE SET? ]\n");
 589: 			exit(1);
 590: 		}
 591: 		break;
 592: 
 593: 	case IRQ_ENABLE_CLEAR:
 594: 		if (writeflag == MEM_WRITE) {
 595: 			d->irq_enable &= ~idata;
 596: 			if (d->irq_status & d->irq_enable)
 597: 				INTERRUPT_ASSERT(d->irq);
 598: 			else
 599: 				INTERRUPT_DEASSERT(d->irq);
 600: 		} else {
 601: 			odata = d->irq_enable;
 602: 			fatal("[ WARNING: footbridge read from "
 603: 			    "ENABLE CLEAR? ]\n");
 604: 			exit(1);
 605: 		}
 606: 		break;
 607: 
 608: 	case FIQ_STATUS:
 609: 		if (writeflag == MEM_READ)
 610: 			odata = d->fiq_status & d->fiq_enable;
 611: 		else {
 612: 			fatal("[ WARNING: footbridge write to fiq status? ]\n");
 613: 			exit(1);
 614: 		}
 615: 		break;
 616: 
 617: 	case FIQ_RAW_STATUS:
 618: 		if (writeflag == MEM_READ)
 619: 			odata = d->fiq_status;
 620: 		else {
 621: 			fatal("[ footbridge write to fiq_raw_status ]\n");
 622: 			exit(1);
 623: 		}
 624: 		break;
 625: 
 626: 	case FIQ_ENABLE_SET:
 627: 		if (writeflag == MEM_WRITE)
 628: 			d->fiq_enable |= idata;
 629: 		break;
 630: 
 631: 	case FIQ_ENABLE_CLEAR:
 632: 		if (writeflag == MEM_WRITE)
 633: 			d->fiq_enable &= ~idata;
 634: 		break;
 635: 
 636: 	case TIMER_1_LOAD:
 637: 		if (writeflag == MEM_READ)
 638: 			odata = d->timer_load[timer_nr];
 639: 		else {
 640: 			d->timer_load[timer_nr] = idata & TIMER_MAX_VAL;
 641: 			reload_timer_value(cpu, d, timer_nr);
 642: 			/*  debug("[ footbridge: timer %i (1-based), "
 643: 			    "value %i ]\n", timer_nr + 1,
 644: 			    (int)d->timer_value[timer_nr]);  */
 645: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
 646: 		}
 647: 		break;
 648: 
 649: 	case TIMER_1_VALUE:
 650: 		if (writeflag == MEM_READ)
 651: 			odata = d->timer_value[timer_nr];
 652: 		else
 653: 			d->timer_value[timer_nr] = idata & TIMER_MAX_VAL;
 654: 		break;
 655: 
 656: 	case TIMER_1_CONTROL:
 657: 		if (writeflag == MEM_READ)
 658: 			odata = d->timer_control[timer_nr];
 659: 		else {
 660: 			d->timer_control[timer_nr] = idata;
 661: 			/*  #432: both prescaler bits set is TIMER_EXTERNAL
 662: 			    (0x0C, dc21285reg.h:364) -- a LEGAL named encoding,
 663: 			    and it used to reach fatal()+exit(1) right here, so a
 664: 			    guest selecting the external clock source KILLED THE
 665: 			    HOST.  Arguably likelier than the zero load, since it
 666: 			    is a documented mode rather than a malformed value.
 667: 			    The rate an external clock would actually give is
 668: 			    UNKNOWN and is NOT invented: footbridge_effective_cycles()
 669: 			    now gives the encoding a defined, survivable meaning
 670: 			    (the unprescaled period), and the real semantics are
 671: 			    filed for a round that has a datasheet.  */
 672: 			if (idata & TIMER_ENABLE) {
 673: 				reload_timer_value(cpu, d, timer_nr);
 674: 			} else {
 675: 				d->pending_timer_interrupts[timer_nr] = 0;
 676: 			}
 677: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
 678: 		}
 679: 		break;
 680: 
 681: 	case TIMER_1_CLEAR:
 682: 		/*  #474: a READ must not perform the clear.  This case carried no
 683: 		    writeflag test at all, while TIMER_1_CONTROL immediately above it
 684: 		    does -- so a guest READ reloaded the counter, decremented the
 685: 		    pending count and DEASSERTED the interrupt.  A guest that merely
 686: 		    read the register silently acknowledged a pending timer interrupt;
 687: 		    the guest-visible consequence is a LOST interrupt, not a bad value.
 688: 
 689: 		    FOUR addresses, not one: the fold above normalises 0x30C/0x32C/
 690: 		    0x34C/0x36C onto this single case.
 691: 
 692: 		    GUARD THE BODY, KEEP THE break.  An early return here would skip
 693: 		    the function's common tail, which writes odata back on a read, and
 694: 		    would hand a guest an untouched buffer -- a defect this code does
 695: 		    not currently have.  */
 696: 		if (writeflag == MEM_WRITE) {
 697: 			if (d->timer_control[timer_nr] & TIMER_MODE_PERIODIC) {
 698: 				reload_timer_value(cpu, d, timer_nr);
 699: 			}
 700: 
 701: 			if (d->pending_timer_interrupts[timer_nr] > 0) {
 702: 				d->pending_timer_interrupts[timer_nr] --;
 703: 			}
 704: 
 705: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
 706: 		}
 707: 		break;
 708: 
 709: 	case SDRAM_BA_MASK:
 710: 		if (writeflag == MEM_READ) {
 711: 			fatal("[ footbridge read from sdram_ba_mask ]\n");
 712: 			exit(1);
 713: 		} else {
 714: 			switch (idata) {
 715: 			case SDRAM_MASK_256KB:
 716: 			case SDRAM_MASK_512KB:
 717: 			case SDRAM_MASK_1MB:
 718: 			case SDRAM_MASK_2MB:
 719: 			case SDRAM_MASK_4MB:
 720: 			case SDRAM_MASK_8MB:
 721: 			case SDRAM_MASK_16MB:
 722: 			case SDRAM_MASK_32MB:
 723: 			case SDRAM_MASK_64MB:
 724: 			case SDRAM_MASK_128MB:
 725: 			case SDRAM_MASK_256MB:
 726: 				break;
 727: 			default:
 728: 				fatal("[ footbridge write to sdram_ba_mask "
 729: 				    "%#llx ]\n", (long long)idata);
 730: 				break;
 731: 			}
 732: 		}
 733: 		break;
 734: 	case SDRAM_BA_OFFSET:
 735: 		if (writeflag == MEM_READ) {
 736: 			fatal("[ footbridge read from sdram_ba_offset ]\n");
 737: 			exit(1);
 738: 		} else {
 739: 			if (idata != 0)
 740: 				fatal("[ footbridge write to sdram_ba_offset "
 741: 				    "%#llx ]\n", (long long)idata);
 742: 		}
 743: 		break;
 744: 
 745: 	default:if (writeflag == MEM_READ) {
 746: 			fatal("[ footbridge: read from 0x%x ]\n",
 747: 			    (int)relative_addr);
 748: 		} else {
 749: 			fatal("[ footbridge: write to 0x%x: 0x%llx ]\n",
 750: 			    (int)relative_addr, (long long)idata);
 751: 		}
 752: 	}
 753: 
 754: 	if (writeflag == MEM_READ)
 755: 		memory_writemax64(cpu, data, len, odata);
 756: 
 757: 	return 1;
 758: }
