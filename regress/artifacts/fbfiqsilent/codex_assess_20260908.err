 274: #  negative-control run (arm L with the three mcr/bic words replaced by nops) printed exactly
 275: #  that misdiagnosis.  A diagnostic that fires on the wrong branch is worse than none.  ***
 276: if not a1:
 277:     if not c2:
 278:         print("      *** THE MMU TRAP, and A1/A2 are NOT evidence about the device: arm L's")
 279:         print("      *** CP15 c1 bit 0 is still SET, so VA 0x42000000 aliased to PA 0x02000000")
 280:         print("      *** (machine_cats.c:131 -> cpu_arm.c:239-255 maps only the low 256 MB) and")
 281:         print("      *** nothing ever addressed the footbridge.  Fix the MMU-off sequence first.")
 282:     elif L["regs"].get(6) == 0:
 283:         print("      NOTE: r6 == 0 with C2 and C4 GREEN is not the MMU trap -- the guest really")
 284:         print("      NOTE: did address PA 0x42000000, so the device is absent or has stopped")
 285:         print("      NOTE: decoding there (memory_device_register / DM_ flags / machine_cats.c:64).")
 286: results.append(row("A2b", "the value the guest actually stored",
 287:                    L["regs"].get(2), 0x12345678))
 288: 
 289: #  ---- the kill pair: this probe's own failability control. ----
 290: l_ok = L["status"] == "SURVIVED" and L["exit"] == 0 and not L["fatals"]
 291: k_ok = any("ENABLE SET" in f for f in K["fatals"]) and K["exit"] == 1
 292: print("%-4s %-40s %-30s %s"
 293:       % ("I1", "isolation arm SURVIVES untouched",
 294:          "status=%s exit=%s" % (L["status"], L["exit"]), "ok" if l_ok else "FAIL"))
 295: print("%-4s %-40s %-30s %s"
 296:       % ("K1", "kill arm dies at 0x188, exit 1",
 297:          "exit=%s" % K["exit"], "ok" if k_ok else "FAIL"))
 298: print("      kill arm said: %s" % ((K["fatals"] or ["(nothing)"])[-1]))
 299: results.append(l_ok)
 300: results.append(k_ok)
 301: 
 302: nbad = sum(len(a["badis"]) for a in (L, T, K))
 303: print("%-4s %-40s %-30s %s"
 304:       % ("D1", "every planted word disassembled as meant",
 305:          "%d mismatches" % nbad, "ok" if nbad == 0 else "FAIL"))
 306: results.append(nbad == 0)
 307: 
 308: #  Named, not indexed.  The first version wrote `results[0] and results[1] ...`, which silently
 309: #  re-points at different rows the moment a row is inserted above -- the same class as pinning a
 310: #  row by an id that names a family.
 311: ctrl_ok = c1 and c2 and c3 and c4
 312: print()
 313: print("ROWS=%d of %d" % (sum(1 for r in results if r), len(results)))
 314: print("FOOTBRIDGE_SITES_CONTROL=%s" % ("OK" if ctrl_ok else "BAD"))
 315: print("FOOTBRIDGE_SITES_%s" % ("PASS" if all(results) else "FAIL"))
