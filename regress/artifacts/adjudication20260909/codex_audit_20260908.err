import json,pathlib,re
p=pathlib.Path('tools/pipeline/ledger.json')
s=p.read_text(encoding='utf-8'); rows=json.loads(s)['rows']
for rid in ['sgirandomcolour','sgirebufuninit','alphaswpctxreg','alphactxfail','alphapteprot','alphavmkill']:
 r=next(r for r in rows if r.get('id')==rid)
 loc=s.find('\"id\": \"'+rid+'\"')
 print('\\nROW',rid,'LINE',s[:loc].count('\\n')+1,'SEV',r.get('sev'),'STATE',r.get('state'))
 print('TITLE',ascii(r.get('title','')))
 for key in ['note','state_note']:
  v=r.get(key,'')
  print(key+' START',ascii(v[:750]))
  for m in list(re.finditer(r'(?i)sever|raised|med -> high|low -> high',v))[:10]: print(key,ascii(v[max(0,m.start()-140):m.end()+400]))
 print('HOLD',ascii(r.get('hold_question',''))[:2200])
 for e in r.get('entries',[]):
  print('ENTRY',json.dumps({k:e.get(k) for k in ('seat','phase','date','grade','ev','outcome') if k in e},ensure_ascii=True))
