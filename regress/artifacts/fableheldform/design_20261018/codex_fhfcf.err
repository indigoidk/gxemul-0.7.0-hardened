import subprocess,json,re,pathlib
base=json.loads(subprocess.check_output(['git','show','HEAD:tools/pipeline/ledger.json']))
rows={r['id']:r for r in base['rows']}
p=pathlib.Path('regress/artifacts/fableheldform/design_20261018/confirm/LEDGER_preview.txt')
rid=None
for i,l in enumerate(p.read_text(encoding='utf-8').splitlines(),1):
 if l.startswith('== '): rid=l.split()[1]
 if rid not in rows: continue
 row=rows[rid]
 if l.startswith('  hold_question (new): '):
  val=l.split(': ',1)[1]; old=row.get('hold_question','')
  print(i,rid,'prior hold_question preserved:',bool(old and old in val),'old length:',len(old))
 if 'note now begins:' in l:
  idx=int(re.search(r'entry \\[(\\d+)\\]',l).group(1))
  prefix=l.split('note now begins: ',1)[1]
  old=row['entries'][idx]
  tag=re.search(r'entry \\[\\d+\\] (\\w+) (\\w+) ([\\d-]+)',l)
  correct=list(tag.groups())==[old['seat'],old['phase'],old['date']]
  last=prefix.split('never an answer] ',1)[1]
  if last.startswith('(a later pass '): last=last.split(') ',1)[1]
  print(i,rid,idx,'date/phase/seat:',correct,'prose begins:',old.get('note','').startswith(last.lstrip()))
for rid in ['fableheldform','untokenedanswers']:
 print(rid,rows.get(rid,{'not':'present'}))
