exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "git --no-pager diff --stat -- tools/pipeline/ledger.json; git --no-pager diff -- tools/pipeline/ledger.json; rg -n '16:22|d42c76a8|FABLE_FHF_P1|fableheldform' regress/artifacts/ip30abortkill/close_20261018 regress/artifacts/fableheldform tools/pipeline/fable_queue.md" in C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC
 succeeded in 285ms:
