"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json,sys,copy,re,io,contextlib
from pathlib import Path
sys.path.insert(0,'tools/pipeline')
import stage_tokens as st
import check_stage_panels as h
ledger=json.loads(Path('tools/pipeline/ledger.json').read_text(encoding='utf-8'))
ids={'wiringcliff','sgirekills','sgirandomcolour','mapledmaaddr','xscaleinten','ppcrldimimask','ppcrlwimiwidth','ppcgateimageskip','cxlaunchquotation','dashokclass'}
ledger['rows']=[r for r in ledger['rows'] if r['id'] in ids]
pat=re.compile(r'NOT FIRED|SEAT FAILURE|walled|not tried|HTTP 429|Fable limit',re.I)
for r in ledger['rows']:
 for e in r.get('entries',[]):
  if e.get('seat')=='fable5' and e.get('date','')>='2026-10-17' and st.is_answer(e) and pat.search(e.get('note','')[:400]):
   e['note']='[HELD AWAITING SEAT: fable5] '+e['note']
h.open=lambda *args,**kwargs:io.StringIO(json.dumps(ledger))
out=io.StringIO()
with contextlib.redirect_stdout(out):
 result=h.main([])
print('In-memory only, nine states kept closed: rc',result)
for line in out.getvalue().splitlines():
 if 'CLOSED-WHILE-HELD' in line or line.startswith('check_stage_panels:'):print(line)
for r in ledger['rows']:
 if r['state']=='closed': r['state']='held'
out=io.StringIO()
with contextlib.redirect_stdout(out):
 result=h.main([])
print('In-memory only, nine states changed to held: rc',result)
print(out.getvalue().splitlines()[0])
