  349: say ""; say "T. seat outcomes: a CLOSED row's panel entries should be graded"
  350: #  SOFT ON PURPOSE, and the reason matters.  A hard gate here would force a grade at
  351: #  commit time, and a forced grade is a guessed grade -- which is precisely the recall
  352: #  bias seat_scorecard.py exists to replace.  What this does is make coverage VISIBLE
  353: #  every commit, so a seat's accuracy stops being something anyone has to remember.
  354: #  Introduced 2026-08-22 after the ledger, with 1525 entries across nine seats, could
  355: #  not answer "which seat is most accurate" -- it recorded participation and nothing
  356: #  else.
  357: #
  358: #  *** OWNER DECISION 2026-08-22: STAYS SOFT, AND THE REVIEW IS SCHEDULED. ***
  359: #  The pass-2 panel argued HARD, and the argument is good: a soft check ignored for six
  360: #  months yields 1.3% coverage forever, which is indistinguishable from not having the
  361: #  tool at all.  The counter is that a hard gate forces a grade at commit time, and a
  362: #  forced grade is a guessed grade -- the exact bias this tool replaces.
  363: #
  364: #  Neither side is measured, so it is settled BY MEASUREMENT rather than by argument:
  365: #  leave it soft and RE-CHECK COVERAGE AFTER ROUGHLY TEN MORE ROUNDS.  If it has not
  366: #  moved off the floor, the panel was right and this goes hard -- preferably in the
  367: #  closed-rows-only form, since closing a row is the moment its outcome is actually
  368: #  known.  Write the coverage number down when you check, so the next reader sees a
  369: #  trend instead of re-arguing it.
  370: #
  371: #  BASELINE AT THE DECISION: 1558 entries, 20 graded, 1.3%.
  372: SCARD=$_HERE/pipeline/seat_scorecard.py
  373: if [ ! -f "$SCARD" ]; then
  374: 	warn "seat_scorecard.py MISSING -- seat accuracy NOT tracked"
  375: else
  376: 	#  Grep the WHOLE output, not a tail window.  The first version took `tail -n 8`
  377: 	#  and broke the same day: adding the self-graded disclosure banner pushed the
  378: 	#  summary line out of the window, so the check reported "produced no summary"
  379: 	#  about a tool that was working perfectly.  A positional grep over another
  380: 	#  program's output is a brittle check, and this one proved it within hours.
  381: 	_sc=$(python "$SCARD" 2>&1 | grep -E "entries, [0-9]+ graded")
  382: 	if [ -n "$_sc" ]; then
  383: 		good "seat scorecard: $_sc"
  384: 	else
  385: 		warn "seat_scorecard.py produced no summary -- check it by hand"
  386: 	fi
  387: 	#  The row that JUST closed is the one whose outcome is actually known, so name
  388: 	#  closed rows whose panel entries are still ungraded.  That is the moment to grade.
  389: 	_ug=$(GRADING_CUTOFF_NOTE="$GRADING_CUTOFF_NOTE" python - "$_HERE/pipeline/ledger.json" <<'PYEOF'
  390: import json, io, os, sys
  391: GRADING_CUTOFF = os.environ.get("GRADING_CUTOFF_NOTE", "2026-08-23")
  392:                                 # seat_scorecard.py shipped MID-DAY on 2026-08-22 (8185920),
  393:                                 # so rows closed ON that day are a boundary this cannot
  394:                                 # resolve from dates alone -- grandfather the whole day
  395:                                 # rather than guess intra-day ordering.  From 08-23 the
  396:                                 # check is live and every closure carries its outcomes.
  397: d = json.load(io.open(sys.argv[1], encoding="utf-8"))
  398: bad, old = [], []
  399: for r in d.get("rows", []):
  400:     if r.get("state") != "closed":
  401:         continue
  402:     ents = [e for e in r.get("entries", []) if e.get("phase") in ("assess", "review")]
  403:     if len(ents) <= 1:
  404:         continue                      # filed, never panelled -- nothing to grade
  405:     #  *** UNVERIFIED IS NOT A GRADE, AND COUNTING IT AS ONE MADE THIS CHECK
  406:     #  VACUOUS. ***  A review seat found it by reading the predicate rather than
  407:     #  the docstring: `any(e.get("outcome"))` is true of the string the design
  408:     #  defines as NOT a grade, so writing UNVERIFIED everywhere would green the
  409:     #  check.  Latent rather than live -- zero rows trip it today -- but a check
  410:     #  that CAN be satisfied without doing the thing is the shape this project
  411:     #  calls vacuous, and it was in the tool built to refuse exactly that.
  412:     if any(e.get("outcome") not in (None, "UNVERIFIED") for e in ents):
  413:         continue
  414:     #  *** FORWARD-ONLY FROM THE DAY THE SCORECARD SHIPPED (8185920, 2026-08-22). ***
  415:     #
  416:     #  This check asked for something seat_scorecard.py's own banner FORBIDS: "Grade an
  417:     #  entry when its claim is CHECKED -- reconstructing grades later reproduces exactly
  418:     #  the recall bias this tool replaced."  Eight rows closed between 08-14 and 08-20,
  419:     #  before the tool existed, and every commit since has printed them as an ungraded
  420:     #  warning that CANNOT BE HONESTLY CLEARED -- only by the reconstruction the tool was
  421:     #  built to refuse.  A warning nobody can clear is a warning everybody learns to skip,
  422:     #  which is worse than not having it.
  423:     #
  424:     #  So they are GRANDFATHERED and COUNTED, in the idiom check_stage_panels.py already
  425:     #  uses -- named as a number rather than a to-do list, so the gap stays visible without
  426:     #  masquerading as an action item.  A row closed on or after the cutoff is still named
  427:     #  individually, because that IS the moment its outcome is known.
  428:     if max([e.get("date", "") for e in ents] or [""]) < GRADING_CUTOFF:
  429:         old.append(r["id"])
  430:         continue
  431:     bad.append(r["id"])
  432: #  Report the TOTAL, not just the first eight.  The original printed bad[:8]
  433: #  with no count, so 37 ungraded rows read as 8 -- a silent cap, which is the
  434: #  shape this project already refuses elsewhere ("silent truncation reads as
  435: #  covered-everything when it did not").
  436: print("%s|%d|%d" % (" ".join(bad[:8]), len(old), len(bad)))
  437: PYEOF
  438: )
  439: 	_ugnames=$(printf '%s' "$_ug" | cut -d'|' -f1)
  440: 	_ugold=$(printf '%s' "$_ug" | cut -d'|' -f2)
  441: 	_ugtot=$(printf '%s' "$_ug" | cut -d'|' -f3)
  442: 	if [ -n "$_ugnames" ]; then
  443: 		warn "closed rows with panel entries but NO seat outcomes: $_ugtot total, first 8: $_ugnames"
  444: 		warn "  grade them with an outcome + outcome_note; see seat_scorecard.py"
  445: 		warn "  ($_ugold more are GRANDFATHERED pre-$GRADING_CUTOFF_NOTE and not counted above)"
  446: 	elif [ "${_ugold:-0}" != "0" ]; then
  447: 		good "every post-cutoff closed row carries seat outcomes ($_ugold grandfathered
  448:           -- closed before seat_scorecard.py existed; grading them now would be the
  449:           reconstruction its own banner forbids)"
  450: 	else
  451: 		good "every closed-and-panelled row carries seat outcomes"
  452: 	fi
  453: fi
  454: 
  455: say ""; say "Q. matrix.html is current with ledger.json"
  456: GEND=$_HERE/pipeline/gen_dashboard.py
  457: if [ ! -f "$GEND" ]; then
  458: 	warn "gen_dashboard.py MISSING -- matrix freshness NOT verified"
  459: else
  460: 	_mx=$(mktemp)
  461: 	if python "$GEND" --out "$_mx" >/dev/null 2>&1 && cmp -s "$_mx" "$_HERE/pipeline/matrix.html"; then
  462: 		good "matrix.html matches a fresh render of ledger.json"
  463: 	else
  464: 		bad "matrix.html IS STALE -- run: python tools/pipeline/gen_dashboard.py"
  465: 		bad "  (and REPUBLISH the artifact; this check cannot see that half)"
  466: 	fi
  467: 	rm -f "$_mx"
  468: fi
  469: 
  470: #  ---- R ---------------------------------------------------------------------------
  471: #  A COMMITTED DETECTOR THAT NO GATE RUNS DEFENDS NOTHING BETWEEN BATTERIES.
  472: #
  473: #  Detector escapes in this project come in three shapes and TWO already had mechanical
  474: #  guards: gate_offline's SM/SC manifests catch a differential with no self-mutant control,
  475: #  and gate_hygiene's EXPECT_CONVERTED pin catches a probe that does not carry the #392 pty
  476: #  constructs.  The third had none -- NOBODY RUNS IT -- and it was the largest.  MEASURED at
  477: #  3d752b4: FOUR committed detectors totalling SIXTY-SIX rows executed in no gate at all.
  478: #    #439/#440 pit8253_latch_probe.py      18 rows         #441 sh4_bsc_width_probe.py  13
  479: #    #442      fbpending_drain_probe.py    11, report-only  #444 hpcmips_ctor_probe.py   24
  480: #  The finding that named the gap put it at 24 rows across two rounds; it is four rounds and
  481: #  66, because #444's detector landed after the census and nothing existed to notice.
  482: #
  483: #  THE MEASURE IS NAMED BECAUSE THE FIRST ONE WAS WRONG: `row()` call sites with a literal
  484: #  label, counted through python's `ast`.  A first pass grepped for 'row("R' and reported 56,
  485: #  having silently dropped every control row that is not R-prefixed.  The padded-column grep
  486: #  trap in another costume -- a number that looks right and counts the wrong set.
  487: #
  488: #  GATE 6's CENSUS PIN IS NOT THIS CHECK IN DIFFERENT CLOTHES, and the distinction is the
  489: #  same one this file already draws between G and H: the PIN asks whether the probe's SOURCE
  490: #  carries the right constructs, R asks whether anything EXECUTES it.  All four files above
  491: #  satisfy the pin today.  Neither catches the other's failure.
  492: #
  493: #  A MENTION IS NOT WIRING, and that is the whole difficulty.  gate_sh_rounding.sh:185
  494: #  mentions sh4_bsc_width_probe.py in a comment COMPLAINING that it is unwired; gate_hygiene
  495: #  mentions all four in its census annotations; and gate_hygiene.sh:331 carries a probe
  496: #  basename and the token `python3` on ONE non-comment line whose message is that the probe
  497: #  did NOT run.  A grep-for-the-name check scores every one of those as wired and prints
  498: #  green over the entire defect.  check_probe_wiring.py decides by COMMAND POSITION, derives
  499: #  the battery from run.sh's own GATES array, and PRINTS the file:line it found -- so the
  500: #  derivation is auditable rather than trusted.  It is the check_fable_queue substring bug
  501: #  from earlier the same day, refused in advance.
  502: #
  503: #  HARD, and retroactive rather than forward-only-by-date: the domain is 36 files in one
  504: #  flat directory, and a date cutoff would grandfather exactly the four files it exists for.
  505: #  Existing gaps are carried as DATED exemptions that EXPIRE (2026-09-20, chosen to fall due
  506: #  with gate_offline's fbpending_bound), never as silent grandfathering.
  507: #
  508: #  THE SELFTEST RUNS ONLY WHEN THE CHECKER ITSELF CHANGES.  --selftest applies 18 mutants to
  509: #  temp copies and asserts each exit status, which takes ~14 s -- too slow for every commit,
  510: #  and pointless when the checker did not move.  Firing it on the one commit that could break
  511: #  it is the section-E idea: a check nobody has to remember.
  512: say ""; say "R. every committed detector is run by a gate (or dated-exempt)"
  513: PWCHK=$_HERE/pipeline/check_probe_wiring.py
  514: if [ ! -f "$PWCHK" ]; then
  515: 	warn "check_probe_wiring.py MISSING -- probe wiring is NOT verified"
  516: else
  517: 	if out=$(python "$PWCHK" 2>&1); then
  518: 		good "$(printf '%s' "$out" | grep -E 'PROBEWIRING_PASS')"
  519: 		printf '%s\n' "$out" | grep -E '^  note ' | sed 's/^/        /'
  520: 	else
  521: 		bad "A COMMITTED DETECTOR IS RUN BY NO GATE (or an exemption expired):"
  522: 		printf '%s\n' "$out" | grep -E 'PROBEWIRING_FAIL|^  FAIL ' | sed 's/^/          /'
  523: 		bad "  wire it into a gate, or add a DATED line to EXEMPT naming the gate that owes it"
  524: 	fi
  525: 	#  UNTRACKED COUNTS AS TOUCHED.  The first version asked only `git diff` and
  526: 	#  `git diff --cached`, and reported "checker unchanged" on the very commit that
  527: 	#  INTRODUCED the checker -- it was untracked, so neither diff could see it, and the
  528: 	#  one commit that most needed the selftest was the one that skipped it.  Measured on
  529: 	#  this file's own first run.
  530: 	_pwtouched=$( { git diff --cached --name-only; git diff --name-only;
  531: 	                git ls-files --others --exclude-standard; } \
  532: 	              | grep -c 'tools/pipeline/check_probe_wiring\.py' )
  533: 	if [ "$_pwtouched" -gt 0 ]; then
  534: 		if stout=$(python "$PWCHK" --selftest 2>&1); then
  535: 			good "$(printf '%s' "$stout" | grep -E 'PROBEWIRING_SELFTEST_PASS')"
  536: 			#  *** THE EXIT CODE IS NOT ENOUGH, AND A SEAT NAMED THE GAP:
  537: 			#  "precommit checks the exit code, not the mutant census -- the
  538: 			#  suite goes green with MALFORMED-EXEMPTION coverage gone." ***
  539: 			#
  540: 			#  Every mutant that REMAINS can behave correctly while mutants
  541: 			#  that were DELETED say nothing at all.  The selftest itself now
  542: 			#  holds its denominator when a case cannot run (it appends a
  543: 			#  failure rather than skipping), but that only covers the SKIP
  544: 			#  path -- an edit that removes a case outright still exits 0.
  545: 			#
  546: 			#  So the count is pinned to a LITERAL here, which is the same
  547: 			#  discipline every gate row in this tree already uses for its own
  548: 			#  denominator: a suite that loses cases cannot pass by shrinking.
  549: 			#  Raise it DELIBERATELY when mutants are added, and never nudge it
  550: 			#  down to silence a red -- the count is the point.
  551: 			_stden=$(printf '%s' "$stout" \
  552: 			         | sed -n 's/.*PROBEWIRING_SELFTEST_PASS *[0-9]*\/\([0-9]*\).*/\1/p' \
  553: 			         | tail -1)
  554: 			if [ "${_stden:-0}" -eq 22 ] 2>/dev/null; then
  555: 				good "selftest mutant count is 22, the pinned value"
  556: 			else
  557: 				bad "THE PROBE-WIRING SELFTEST HAS LOST MUTANTS: ${_stden:-unparseable}, pinned 22."
  558: 				bad "  Every REMAINING mutant can behave correctly while DELETED ones say"
  559: 				bad "  nothing at all.  Raise the pin DELIBERATELY when mutants are added;"
  560: 				bad "  never nudge it down to silence a red -- the count is the point."
  561: 			fi
  562: 		else
  563: 			bad "THE PROBE-WIRING CHECKER CAN NO LONGER BE SHOWN TO FAIL:"
  564: 			printf '%s\n' "$stout" | grep -E 'SELFTEST_FAIL|^  FAIL ' | sed 's/^/          /'
  565: 		fi
  566: 	else
  567: 		good "checker unchanged -- selftest not re-run (fires when it is edited)"
  568: 	fi
  569: fi
  570: 
  571: #  ---- V ---------------------------------------------------------------------------
  572: #  THE VERDICT EXTRACTOR DECIDES WHETHER A PANEL WAS SPLIT OR UNANIMOUS, AND IT WAS
  573: #  WRONG ABOUT THAT FOR ITS WHOLE LIFE WITH NOTHING EXECUTING IT.
  574: #
  575: #  Two defects, both found by a seat READING the regex rather than running it: markdown
  576: #  emphasis made a LIVE seat's correct verdict read as a format miss, and a single-word
  577: #  capture collapsed SHIP against SHIP WITH CHANGES and every OPTION A/B/C into one
  578: #  token -- so every split panel this project ran was reported as unanimous.
  579: #
  580: #  Same shape as section R's selftest and wired the same way: it fires only when the
  581: #  extractor itself is touched, and UNTRACKED COUNTS AS TOUCHED, which is the lesson R
  582: #  paid for -- the first version reported "unchanged" on the very commit that
  583: #  introduced the file.
  584: say ""; say "V. the verdict extractor can still be shown to fail"
  585: SVCHK=$_HERE/pipeline/seat_verdicts.py
  586: if [ ! -f "$SVCHK" ]; then
  587: 	warn "seat_verdicts.py MISSING -- panel verdicts are NOT extracted"
  588: else
  589: 	_svtouched=$( { git diff --cached --name-only; git diff --name-only;
  590: 	                git ls-files --others --exclude-standard; } \
  591: 	              | grep -c 'tools/pipeline/seat_verdicts\.py' )
  592: 	if [ "$_svtouched" -gt 0 ]; then
  593: 		if svout=$(python "$SVCHK" --selftest 2>&1); then
  594: 			good "$(printf '%s' "$svout" | grep -E 'SEAT_VERDICTS_SELFTEST_PASS')"
  595: 		else
  596: 			bad "THE VERDICT EXTRACTOR CAN NO LONGER BE SHOWN TO FAIL:"
  597: 			printf '%s
  598: ' "$svout" | grep -E 'SELFTEST_FAIL|^  FAIL ' | sed 's/^/          /'
  599: 		fi
  600: 	else
  601: 		good "extractor unchanged -- selftest not re-run (fires when it is edited)"
  602: 	fi
  603: fi
  604: 
  605: #  ---- W ---------------------------------------------------------------------------
  606: #  A ROUND WAS NEARLY REDONE FROM SCRATCH BECAUSE A LEDGER ROW SAID `open` ON WORK
  607: #  THAT HAD SHIPPED HOURS EARLIER.
  608: #
  609: #  `sqreadtype` carried a witness field saying its warrant measurement was PENDING;
  610: #  the measurement is in its own CHANGELOG block and the round shipped as 3ff2138.
  611: #  It was caught by accident -- the row was picked as the next round and the source
  612: #  comment already said the fix was in.  The carrier names this class (a
  613: #  state-vs-substance mismatch) and nothing checked it.
  614: #
  615: #  *** THE FIRST DESIGN WAS VACUOUS AND ITS POSITIVE CONTROL SAID SO. ***  It looked
  616: #  for the row id in a commit SUBJECT; subjects here carry ROUND NUMBERS and name no
  617: #  row, so reinstating the defect did not flag it.  The association that works is the
  618: #  `witness` field, which exists for exactly this purpose: an open row naming a
  619: #  COMMITTED probe is claiming to be unstarted while its detector is in the tree.
  620: #  Negative-controlled both ways; opt out with a `state_note` that says what is left.

 succeeded in 169ms:
  621: #  W ALSO CHECKS THE QUEUE FILE NOW.  Section P checks ledger -> file; nothing
  622: #  checked file -> ledger, and SEVEN headings in OUTSTANDING_BUGS.md said `open` on
  623: #  work the ledger recorded as closed.  That is the EXPENSIVE direction: the
  624: #  carrier's first-stop procedure names that file as the live queue, so each stale
  625: #  heading offers shipped work to a fresh session, which has no reason to doubt it.
  626: #  Deliberately preserved originals are exempt, and the sweep measured exactly one
  627: #  of those against six genuine cases.
  628: say ""; say "W. a row's state agrees with what shipped"
  629: RSCHK=$_HERE/pipeline/check_row_states.py
  630: if [ ! -f "$RSCHK" ]; then
  631: 	bad "check_row_states.py MISSING -- stale row states are NOT verified"
  632: elif rsout=$(python "$RSCHK" 2>&1); then
  633: 	good "$(printf '%s' "$rsout" | grep -E 'ROW_STATES_PASS')"
  634: else
  635: 	bad "A LEDGER ROW SAYS open ON WORK THAT SHIPPED:"
  636: 	printf '%s\n' "$rsout" | grep -E 'STALE|ROW_STATES_FAIL|^ ' | sed 's/^/          /'
  637: fi
  638: 
  639: #  ---- X ---------------------------------------------------------------------------
  640: #  A CITED MEASUREMENT MUST EXIST.  The rule "a score claim names its artifact" was
  641: #  already in force and already being followed when it failed TWICE in one day:
  642: #
  643: #    * `#462` cited `probe_base.raw` for 52/52; a later 57-row table REUSED that name,
  644: #      so the claim became CONTRADICTED BY ITS OWN EVIDENCE, not merely unverifiable.
  645: #    * `#461`'s lethal mutant `m_dmarevert` (22/31) has NO per-row artifact at all --
  646: #      0 candidate lines across every `.out` in both scratchpads.  A retrospective audit
  647: #      of that detector was ATTEMPTED on 2026-08-24 and could not run.
  648: #
  649: #  EXISTENCE ONLY, and the scope cut is the safety argument.  It does not parse the log
  650: #  or re-derive the score: section U already checks DENOMINATORS against the gate pin,
  651: #  nothing mechanical can tell a measured numerator from a carried one, and a checker
  652: #  that tried would grow without bound -- the #392 shape.  A gate that stats cited paths
  653: #  cannot creep into policing scratch directories.
  654: #
  655: #  Specified by the fable5 adjudication of #462, Decision 4c, which set both the altitude
  656: #  ("checks committed records, never scratchpad state") and the scope cut.  Forward-only
  657: #  from round 462; earlier blocks predate the rule, and a red that no edit can clear is
  658: #  its own hazard.  NEGATIVE-CONTROLLED ON ITS FIRST RUN: it reported two missing
  659: #  artifacts, both real, and went green only after they were archived to a durable path.
  660: say ""; say "X. every measurement cited in a round block still exists"
  661: CACHK=$_HERE/pipeline/check_cited_artifacts.py
  662: if [ ! -f "$CACHK" ]; then
  663: 	bad "check_cited_artifacts.py MISSING -- cited measurements are NOT verified"
  664: elif caout=$(python "$CACHK" 2>&1); then
  665: 	good "$(printf '%s' "$caout" | grep -E 'CITED_ARTIFACTS_PASS')"
  666: else
  667: 	bad "A ROUND BLOCK CITES A MEASUREMENT THAT DOES NOT EXIST:"
  668: 	printf '%s\n' "$caout" | grep -E 'CITED_ARTIFACTS_FAIL|^    #' | sed 's/^/          /'
  669: 	bad "  restore the artifact, or correct the claim to say the log was not preserved"
  670: fi
  671: 
  672: #  THE SELFTEST FIRES ONLY WHEN THE CHECKER ITSELF CHANGES -- the section-R idiom, and
  673: #  wired the same way.  A completeness check found that this gate shipped WITHOUT one
  674: #  while both its siblings have them: the gate enforcing "every score names verifiable
  675: #  evidence" had no evidence of its own correctness, and the three false-green fixes it
  676: #  went through had nothing pinning them.  ***  IT FAILED ON ITS FIRST RUN AND FOUND A
  677: #  REAL BUG: *** `LOOSE` had been compiled with a literal BACKSPACE byte where `\\b`
  678: #  belonged, so the unenforced-mentions denominator matched NOTHING and had been printing
  679: #  a PHANTOM ZERO all evening -- in the counter added specifically to make phantom zeros
  680: #  visible.  UNTRACKED COUNTS AS TOUCHED, per section R's own scar.
  681: #  DETECT THE TOUCH INLINE, exactly as section R does -- `$CHANGED` is not defined
  682: #  until much later in this file, so the first version of this block never fired.
  683: #  UNTRACKED COUNTS AS TOUCHED: section R's own scar is that a checker was untracked
  684: #  on the very commit that introduced it, so neither diff could see it and the one
  685: #  commit that most needed the selftest was the one that skipped it.
  686: _catouched=$( { git diff --cached --name-only; git diff --name-only; git ls-files --others --exclude-standard; } | grep -c 'tools/pipeline/check_cited_artifacts\.py' )
  687: if [ "$_catouched" -gt 0 ]; then
  688: 	if stout=$(python "$CACHK" --selftest 2>&1); then
  689: 		good "$(printf '%s' "$stout" | grep -E 'SELFTEST_PASS')"
  690: 	else
  691: 		bad "check_cited_artifacts.py SELFTEST FAILED -- the gate is not trustworthy:"
  692: 		printf '%s\n' "$stout" | grep -E 'SELFTEST_FAIL|^    ' | sed 's/^/          /'
  693: 	fi
  694: else
  695: 	good "checker unchanged -- selftest not re-run (fires when it is edited)"
  696: fi
  697: 
  698: #  ---- J ---------------------------------------------------------------------------
  699: #  THE CARRIER IS TRACKED BY COPY, AND A COPY THAT NOTHING CHECKS GOES STALE.
  700: #
  701: #  Owner decision, 2026-08-17, asked as a question: track `CLAUDE.md` and `PIPELINE.md`
  702: #  rather than leave the files that direct every session outside version control.
  703: #
  704: #  The literal answer was "track them at the project root" -- and that is not possible,
  705: #  because the git root is GXEMUL-SEC/, one level BELOW the project root where the carrier
  706: #  must sit to be auto-loaded.  (The question's own diagram drew GXEMUL/ as the repo.  It
  707: #  was wrong.)  So the tracked form is a COPY under tools/, and the copy reintroduces
  708: #  exactly the divergence risk the owner rejected when rejecting the dated snapshot.
  709: #
  710: #  This check is what makes the copy safe: byte-identity, HARD, using check A's own `cmp`
  711: #  idiom.  A carrier edit that never reaches the repo is then a red commit rather than a
  712: #  copy that silently describes last week's process.
  713: #
  714: #  tools/ and not GXEMUL-SEC/ deliberately: Claude Code auto-loads CLAUDE.md from the cwd
  715: #  upward, and the session cwd DRIFTS -- it has sat in GXEMUL-SEC/regress for whole rounds.
  716: #  A copy at GXEMUL-SEC/CLAUDE.md would then load ALONGSIDE the root original, putting two
  717: #  copies of a 38 KB carrier in one context.  tools/ is never a cwd ancestor in practice.
  718: #
  719: #  An ABSENT original is not a failure: on a fresh clone the repo copy is the only one
  720: #  there is, and demanding a file that version control cannot deliver would make the check
  721: #  fail hardest in the one situation it exists to serve.
  722: say ""; say "J. tracked carrier copies match the originals"
  723: for _c in CLAUDE.md PIPELINE.md; do
  724: 	if [ ! -f "$SEC/tools/$_c" ]; then
  725: 		bad "$_c has no tracked copy at tools/$_c -- the carrier is untracked again"
  726: 	elif [ ! -f "$ROOT/$_c" ]; then
