  84:         s = io.open(os.path.join(REG, fn), encoding="utf-8",
  85:                     errors="replace", newline="").read()
  87:         code = re.sub(r"/\*.*?\*/", "", s, flags=re.S)
  88:         if not WATERMARK.search(code):
  89:             continue
  90:         stem = fn[5:-2]
  91:         measured.append(stem)
  92:         chunks = compile_line_for(stem, gate)
