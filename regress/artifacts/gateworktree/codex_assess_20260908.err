 108: def cited_pairs(ledger):
 109:     """(panel_dir, seat) and (panel_dir, filename) the ledger claims, plus the dirs in scope.
 111:     A file is counted as read if the entry NAMES IT, or -- for a seat with only one answer
 112:     file in that directory -- if the entry cites the directory and the seat.  The filename
 113:     form is what closes the two-answers-one-citation hole; the seat form is kept so older
 114:     entries that cite a directory without a filename still count.
 115:     """
 116:     pairs, files, dirs = set(), set(), set()
 117:     for row in ledger["rows"]:
 118:         for ent in row.get("entries", []):
 119:             blob = "%s %s" % (ent.get("ev", ""), ent.get("note", ""))
 120:             for d in PANEL_RE.findall(blob):
 121:                 dirs.add(d)
 122:                 pairs.add((d, ent.get("seat")))
 123:                 for fn in FILE2SEAT:
 124:                     if fn in blob:
 125:                         files.add((d, fn))
 126:     return pairs, files, dirs
 129: def answers_on_disk(panel_dir):
 130:     """(seat, filename) -> size, for one panel directory.
 132:     KEYED ON THE FILE, NOT THE SEAT, and that distinction is the whole point.  The first
 133:     version returned one entry per seat, so a seat with TWO substantial answers in the same
 134:     directory -- codex.txt from pass 1 and codex_pass2.txt from pass 2 -- was satisfied by a
 135:     single citation of either.  Measured: codex's 491 KB pass-1 answer on the m8sarpurge
 136:     panel was never read, and this check passed anyway, because the pass-2 file was cited.
 137:     The seat had answered twice and been read once.  Found when the owner asked for a full
 138:     panel per STAGE and the audit showed research at 8/9 with codex missing.
 139:     """
 140:     out = {}
 141:     base = os.path.join(PANELS, panel_dir)
 142:     for fn, seat in FILE2SEAT.items():
 143:         p = os.path.join(base, fn)
 144:         if os.path.exists(p) and os.path.getsize(p) >= MIN_ANSWER:
 145:             out[(seat, fn)] = os.path.getsize(p)
 146:     return out
 149: def main(argv):
 150:     listing = "--list" in argv
 151:     ledger = load()
 152:     pairs, files, dirs = cited_pairs(ledger)
 154:     if not dirs:
 155:         print("check_seats_read: no ledger entry cites a panel directory; nothing in scope.")
 156:         return 0
 158:     violations = []
 159:     checked = 0
 160:     for cited in sorted(dirs):
 166:         d = resolve_dir(cited)
 167:         if not os.path.isdir(os.path.join(PANELS, d)):
 170:             print("  --   %s: cited but NOT ON DISK; cannot verify" % d)
 171:             continue
 172:         onhand = answers_on_disk(d)
 176:         percount = {}
 177:         for (seat, fn) in onhand:
 178:             percount[seat] = percount.get(seat, 0) + 1
 179:         for (seat, fn), sz in sorted(onhand.items()):
 180:             checked += 1
 181:             named = (d, fn) in files or (cited, fn) in files
 182:             covered = named or (percount[seat] == 1
 183:                                 and ((d, seat) in pairs or (cited, seat) in pairs))
 184:             if not covered:
 185:                 violations.append((d, seat, sz, fn))
 186:             elif listing:
 187:                 print("  ok   %s / %-9s %7d b  (%s)" % (d, seat, sz, fn))
 189:     print("check_seats_read: %d substantial answers across %d cited panel dirs"
 190:           % (checked, len(dirs)))
 191:     if not violations:
 192:         print("SEATS_READ_PASS  every seat that answered in a cited panel is recorded")
 193:         return 0
 195:     print("SEATS_READ_FAIL  %d seat answers exist on disk and are recorded NOWHERE:"
 196:           % len(violations))
 197:     for d, seat, sz, fn in violations:
 198:         print("    %s / %-9s %8d b   (%s)" % (d, seat, sz, fn))
 199:     print()
 200:     print("  A seat that answered and was not recorded is NOT a seat failure and NOT")
 201:     print("  agreement -- it is an unread review, and this project has twice found real")
 202:     print("  defects sitting in one.  Read it and add a ledger entry, or if it truly had")
 203:     print("  nothing to say, record THAT with an explicit entry rather than a blank.")
 204:     return 1
 207: if __name__ == "__main__":
 208:     sys.exit(main(sys.argv[1:]))
