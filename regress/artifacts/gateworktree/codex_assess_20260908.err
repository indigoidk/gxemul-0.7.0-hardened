  91:         tag = "SHARED" if is_live else "ARCHIVED"
  92:         print("  %-9s %-13s x%d  %s" % (tag, rid, len(seats), ",".join(seats)))
  93:         print("                          %s..." % key[:72])
  95:     print()
  96:     print("  A note shared verbatim by several seats records that they were FIRED, not that")
  97:     print("  they AGREED. Give each seat its own sentence from its own file, or leave the")
  98:     print("  cell empty -- an empty cell is honest and a copied one is not.")
  99:     print()
 100:     if live:
