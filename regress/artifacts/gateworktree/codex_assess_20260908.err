1415: ASSIGN_RE = re.compile(r"^\s*([A-Za-z_]\w*)=(\S+)")
1418: def read(path):
1419:     with open(path, "r", encoding="utf-8", errors="replace") as fh:
1420:         return fh.read()
1423: def unquote(tok):
1424:     tok = tok.strip().rstrip(");,")
1425:     if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in "\"'":
1426:         tok = tok[1:-1]
