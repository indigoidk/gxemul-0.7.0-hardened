 878: #  The fallback matters: with nothing staged (an interactive run, or `git commit -a`), fall back
 879: #  to the full working tree, so a bare invocation still audits everything.  A check that silently
 880: #  audited nothing when run the ordinary way would be worse than the problem being fixed.
 881: CHANGED=$(git diff --cached --name-only)
 882: if [ -z "$CHANGED" ]; then
 883: 	CHANGED=$(git status --porcelain -z | tr '\0' '\n' | sed -e 's/^...//' -e 's/.* -> //')
 884: fi
 885: 
 886: #  ANNOUNCE what the narrowing means for this run, so a divergent file that is merely OUT OF
 887: #  SCOPE is never mistaken for one that was checked and passed.
 888: _unstaged_src=$(git diff --name-only -- 'src/*' | tr '\n' ' ')
 889: if [ -n "$_unstaged_src" ]; then
 890: 	warn "UNSTAGED src/ edits NOT audited by this run (they are when committed): $_unstaged_src"
 891: fi
1136: say ""; say "C. commit message vs diff (write messages FROM THE DIFF)"
1137: if [ -n "$MSGFILE" ] && [ -f "$MSGFILE" ]; then
1138: 	for p in $(grep -oE '\b(src|regress|man)/[A-Za-z0-9_./-]+\.(c|h|sh|1)\b' "$MSGFILE" | sort -u); do
1139: 		if printf '%s\n' $CHANGED | grep -qx "$p"; then good "message cites $p, and the diff touches it"
1140: 		else bad "message cites $p but NO HUNK TOUCHES IT -- the claim outruns the diff"; fi
1141: 	done
1142: 	[ -z "$(grep -oE '\b(src|regress|man)/[A-Za-z0-9_./-]+\.(c|h|sh|1)\b' "$MSGFILE")" ] &&
1143: 		good "message cites no source paths (nothing to cross-check)"
1144: else
1145: 	soft "no commit-message file passed -- check C skipped, NOT passed"
1156: say ""; say "D. added citations and self-invalidating counts"
1157: ADDED=$(git diff -U0 | grep '^+' | grep -v '^+++')
1158: CITES=$(printf '%s\n' "$ADDED" | grep -oE '\b[a-z0-9_]+\.(c|h)\b:[0-9]+' | sort -u)
1159: if [ -z "$CITES" ]; then good "no new file:line citations"; else
1160: 	for c in $CITES; do
1161: 		cf=${c%%:*}; cl=${c##*:}
1162: 		p=$(git ls-files "*/$cf" | head -1)
1163: 		if [ -z "$p" ]; then soft "cited $c -- file not found in the repo, check by hand"
1164: 		elif [ "$(wc -l < "$p")" -lt "$cl" ]; then bad "cited $c but $p has only $(wc -l < "$p") lines"
1165: 		else good "cited $c exists (READ THE LINE -- existence is not correctness)"; fi
1166: 	done
1240: nulhits=0
1241: nulscanned=0
1242: for f in $(git -C "$SEC" ls-files -- "*.c" "*.h" "*.py" "*.sh" "*.md" "*.json" "*.txt" "*.tsv" 2>/dev/null); do
1243: 	[ -f "$SEC/$f" ] || continue
1244: 	nulscanned=$((nulscanned+1))
1245: 	if [ "$(tr -cd "\000" < "$SEC/$f" | wc -c)" -gt 0 ]; then
1246: 		bad "$f contains a NUL byte -- grep will treat it as BINARY and go quiet"
1247: 		nulhits=$((nulhits+1))
1248: 	fi

