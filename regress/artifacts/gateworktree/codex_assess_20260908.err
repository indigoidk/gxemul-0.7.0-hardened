  55: def compile_line_for(stem, gate_text):
  56:     """Return the gate's compile invocation for diff_<stem>.c, or None."""
  58:     needle = "diff_%s.c" % stem
  59:     out = []
  60:     for i, line in enumerate(gate_text.split("\n")):
  61:         if needle not in line:
  62:             continue
  64:         lines = gate_text.split("\n")
  65:         j = i
  66:         while j > 0 and lines[j - 1].rstrip().endswith("\\"):
  67:             j -= 1
  68:         k = i
  69:         while lines[k].rstrip().endswith("\\") and k + 1 < len(lines):
  70:             k += 1
  71:         chunk = " ".join(lines[j:k + 1])
  72:         if "$CC" in chunk or "gcc" in chunk:
  73:             out.append(chunk)
  74:     return out
  77: def main(argv):
