1430: def gate_list(regress):
1431:     """The battery's OWN array is the authority on which scripts run.
1433:     Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
1434:     second-order property worth having: a gate script that exists but was dropped out of
1435:     GATES does not run, so every probe it owned becomes unwired here and this goes RED.
1436:     A glob would have called those probes gated forever.
1437:     """
1438:     run = os.path.join(regress, "run.sh")
1439:     if not os.path.isfile(run):
1440:         return None, "regress/run.sh is missing -- cannot tell which gates run"
1441:     m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
1442:     if not m:
1443:         return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
1444:     return [n + ".sh" for n in m.group(1).split()], None
1447: def exec_sites(regress, scripts):
1448:     """Return (hits, ignored, missing).
1450:     hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
1451:     ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
1452:     """
1453:     hits, ignored, missing = {}, [], []
1454:     for script in scripts:
1455:         path = os.path.join(regress, script)
1456:         if not os.path.isfile(path):
1457:             missing.append(script)
1458:             continue
1459:         lines = read(path).splitlines()
1464:         varmap = {}
1465:         for ln in lines:
1466:             if ln.lstrip().startswith("#"):
1467:                 continue
1468:             a = ASSIGN_RE.match(ln)
1469:             if a and ".py" in a.group(2):
1470:                 varmap[a.group(1)] = unquote(a.group(2))
1484:         body = set()
1485:         pend = None
1486:         for no, ln in enumerate(lines, 1):
1487:             if pend is not None:
1488:                 body.add(no)
1489:                 if ln.strip() == pend:
1490:                     pend = None
1491:                 continue
1492:             h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
1493:             if h and not ln.lstrip().startswith("#"):
1494:                 pend = h.group(1)
1496:         for no, ln in enumerate(lines, 1):
1497:             if ln.lstrip().startswith("#") or no in body:
1498:                 continue
1499:             for m in INTERP_RE.finditer(ln):
1500:                 if not CMDPOS_RE.match(ln[: m.start()]):
1501:                     continue
1502:                 toks = ln[m.end():].split()
1503:                 if toks and toks[0].startswith("-c"):
1504:                     continue          # an inline program, not a script invocation
1505:                 for tok in toks:
1506:                     t = unquote(tok)
1507:                     v = VAR_RE.match(t)
1508:                     if v:
1509:                         t = varmap.get(v.group(1), "")
1510:                     if not t.endswith(".py"):
1511:                         continue
1512:                     d, b = os.path.split(t)
1513:                     if d in HERE_DIRS:
1514:                         hits.setdefault(b, []).append("%s:%d" % (script, no))
1515:                     else:
1525:                         rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
1526:                         if os.path.isfile(os.path.join(regress, rel)):
1527:                             hits.setdefault(rel, []).append("%s:%d" % (script, no))
1528:                         else:
1529:                             ignored.append("%s:%d  %s" % (script, no, t))
1530:                     break             # the first .py argument is the script
1531:     return hits, ignored, missing
1540: _LBL_W = re.compile(r"(?<![\w-])witness(?![\w-])", re.I)
1541: _LBL_D = re.compile(r"(?<![\w-])detector(?![\w-])", re.I)
1544: def domain(regress):
1545:     """The .py artefacts this check governs, and (mode, why) describing how it decided.
1547:     *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
1548:     first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
1549:     round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
1550:     check went red -- correctly identifying a real unwired detector, but firing at a
1551:     file its author had not yet offered for commit, in someone else's working tree.
1553:     `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
1554:     add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
1555:     precisely when the author is present to classify it.  A scratch probe that is never
1556:     staged defends nothing in a fresh clone either, so it is honestly out of scope.
1558:     FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
1559:     git cannot answer, and a fallback that quietly changes what a check governs is the
1560:     kind of silent scope change this harness keeps being bitten by.  So the mode is
1561:     printed on the summary line.
1562:     """
1563:     try:
1564:         p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
1565:                            capture_output=True, text=True)
1566:         if p.returncode == 0:
1575:             files = sorted(f for f in p.stdout.split()
1576:                            if f.endswith(".py")
1577:                            and os.path.isfile(os.path.join(regress, f)))
1578:             if files:
1579:                 return files, "tracked-or-staged"
1580:     except OSError:
1581:         pass
1585:     found = []
1586:     for dirpath, dirnames, filenames in os.walk(regress):
1587:         dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
1588:         for f in filenames:
1589:             if f.endswith(".py"):
1590:                 rel = os.path.relpath(os.path.join(dirpath, f), regress)
1591:                 found.append(rel.replace(os.sep, "/"))
1592:     return sorted(found), "on-disk (git could not answer)"
1595: def self_label(path):
1596:     """The file's OWN summary line, for the SELFLABEL advisory only.  Never a verdict."""
1597:     try:
1598:         head = read(path).splitlines()[:6]
1599:     except OSError:
1600:         return None
1601:     for ln in head:
1602:         has_w, has_d = bool(_LBL_W.search(ln)), bool(_LBL_D.search(ln))
1603:         if has_w and not has_d:
1604:             return CLASS_WITNESS
1605:         if has_d and not has_w:
1606:             return CLASS_DETECTOR
1607:         if has_w and has_d:
1608:             return None
1609:     return None
