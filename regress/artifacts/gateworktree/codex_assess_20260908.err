  71:             if g not in GRADES:
  72:                 g = "UNVERIFIED"
  73:             per[s][g] += 1
  74:             if e.get("acted"):
  75:                 acted[s] += 1
  76:             if g == "UNVERIFIED":
  77:                 ungraded[s].append("%s/%s" % (row.get("id", "?"), e.get("phase", "?")))
  78:             if e.get("self_graded"):
