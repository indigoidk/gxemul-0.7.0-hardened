 167:     stamped-path discipline; a checker that greens a stamped path off a different
 168:     directory's same-named file has rebuilt the reuse defect inside itself.
 169:     """
 170:     want = name.replace("\\", "/").strip("/")
 171:     parts = want.split("/")
 172:     stamped = len(parts) > 1
 173:     for root in SEARCH:
 174:         direct = os.path.join(root, name)
 175:         if os.path.exists(direct):
 176:             return direct
 177:         if not os.path.isdir(root):
 178:             continue
 179:         for dirpath, _dirnames, filenames in os.walk(root):
 180:             if parts[-1] not in filenames:
