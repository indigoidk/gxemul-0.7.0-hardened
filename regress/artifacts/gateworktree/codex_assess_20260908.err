 100:             bad.append(stem)
 101:         print("  %-22s measures stack   pin: %s"
 102:               % (stem, "yes" if pinned else "*** NONE ***"))
 104:     if not measured:
 105:         print("  no differential uses the stack-watermark idiom")
 107:     print()
 108:     print("  %d of %d differentials measure stack by the known idiom" % (len(measured), len(diffs)))
 109:     print("  BLINDNESS, printed every run: this detects the STACK-WATERMARK idiom ONLY.")
 110:     print("  An allocation counter, an iteration count, a timing loop, or a future stack")
 111:     print("  idiom would all slip past.  A green line means 'no UNPINNED file uses the shape")
 112:     print("  that has actually bitten' -- NEVER 'no row follows the compiler'.")
 114:     if bad:
