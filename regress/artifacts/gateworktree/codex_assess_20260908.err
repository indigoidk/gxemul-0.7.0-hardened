2051: def main(argv):
2052:     verbose = "-v" in argv or "--verbose" in argv
2053:     if "--selftest" in argv:
2054:         return selftest(verbose)
2055:     regress = DEFAULT_REGRESS
2056:     today = None
2057:     for i, a in enumerate(argv):
2058:         if a == "--regress" and i + 1 < len(argv):
2059:             regress = os.path.abspath(argv[i + 1])
2060:         if a == "--today" and i + 1 < len(argv):
2061:             today = argv[i + 1]
2062:     if today is None:
2063:         import datetime
2064:         today = datetime.date.today().isoformat()
2066:     fails, notes = [], []
2068:     if not os.path.isdir(regress):
2069:         print("PROBEWIRING_FAIL  no regress dir at %s" % regress)
2070:         return 1
2072:     scripts, err = gate_list(regress)
2073:     if err:
2074:         print("  FAIL  %s" % err)
2075:         print("PROBEWIRING_FAIL  the battery could not be derived")
2076:         return 1
2077:     scripts = scripts + [s for s in ALWAYS if s not in scripts]
2079:     hits, ignored, missing = exec_sites(regress, scripts)
2080:     for s in missing:
2081:         fails.append("run.sh names %s and the file does not exist -- the battery is broken" % s)
2083:     on_disk, mode = domain(regress)
2085:     for f in on_disk:
2086:         if f not in MANIFEST:
2087:             fails.append("UNCLASSIFIED  %s is not in check_probe_wiring.py's MANIFEST.\n"
2088:                          "                classify it detector (green once fixed), witness "
2089:                          "(red once fixed) or tool." % f)
2090:     for f in sorted(MANIFEST):
2091:         if f not in on_disk:
2092:             fails.append("GHOST  the MANIFEST names %s and regress/ has no such file -- "
2093:                          "delete the entry" % f)
2095:     rows = []
2096:     for f in on_disk:
2097:         if f not in MANIFEST:
2098:             continue
2099:         cls, why = MANIFEST[f]
2100:         where = hits.get(f, [])
2101:         if cls not in CLASSES:
2102:             fails.append("BAD CLASS  %s is classified '%s'; want one of %s"
2103:                          % (f, cls, "/".join(CLASSES)))
2104:             continue
2106:         if cls == CLASS_TOOL and (f.endswith("_probe.py") or f.endswith("_witness.py")):
2107:             fails.append("MISFILED  %s is classified 'tool'. A file named *_probe.py or "
2108:                          "*_witness.py asserts something; classify it detector or witness."
2109:                          % f)
2111:         if cls == CLASS_DETECTOR:
2112:             if where:
2113:                 state = "RUN by " + ", ".join(where)
2114:                 if f in EXEMPT:
2115:                     fails.append("STALE EXEMPTION  %s is RUN by %s and still carries an "
2116:                                  "exemption dated %s -- the debt is paid, delete the line"
2117:                                  % (f, where[0], EXEMPT[f][0]))
2118:             elif f in EXEMPT:
2119:                 d = EXEMPT[f][0]
2120:                 if not DATE_RE.match(d or ""):
2121:                     fails.append("MALFORMED EXEMPTION  %s:'%s' is not YYYY-MM-DD. A date "
2122:                                  "nothing validates never expires -- refusing to guess."
2123:                                  % (f, d))
2124:                     state = "EXEMPT(BAD-DATE)"
2125:                 elif d < today:
2126:                     fails.append("EXPIRED EXEMPTION  %s came due %s (today %s) and is still "
2127:                                  "run by no gate" % (f, d, today))
2128:                     state = "EXEMPT(EXPIRED %s)" % d
2129:                 else:
2130:                     state = "EXEMPT until %s" % d
2131:             else:
2132:                 fails.append("UNWIRED DETECTOR  %s is run by NO gate and has no dated "
2133:                              "exemption.\n                wire it into a gate, or add a dated "
2134:                              "line to EXEMPT naming the gate that owes it." % f)
2135:                 state = "UNWIRED"
2136:         elif cls == CLASS_WITNESS:
2137:             if where:
2138:                 fails.append("GATED WITNESS  %s is invoked at %s. A witness asserts the "
2139:                              "PRE-FIX symptom, so it goes RED the day the fix lands -- "
2140:                              "gating it manufactures a regression." % (f, where[0]))
2141:                 state = "GATED (must not be): " + ", ".join(where)
2142:             else:
2143:                 state = "not run (correct)"
2144:         else:
2145:             state = ("RUN by " + ", ".join(where)) if where else "-"
2147:         if cls in (CLASS_DETECTOR, CLASS_WITNESS):
2148:             lbl = self_label(os.path.join(regress, f))
2149:             if lbl and lbl != cls:
2150:                 notes.append("SELFLABEL  %s: manifest says %s, its own summary line says %s. "
2151:                              "Advisory only -- self-labels are measurably unreliable in both "
2152:                              "directions." % (f, cls, lbl))
2153:         rows.append((cls, f, state, why))
2155:     for f in sorted(EXEMPT):
2156:         if f not in MANIFEST:
2157:             fails.append("ORPHAN EXEMPTION  %s is exempted and is not in the MANIFEST" % f)
2158:         elif MANIFEST[f][0] != CLASS_DETECTOR:
2159:             fails.append("ORPHAN EXEMPTION  %s is classified '%s'; only a detector can be "
2160:                          "exempted from being run" % (f, MANIFEST[f][0]))
2162:     print("  check_probe_wiring: %d python artefacts in %s/ [%s], %d battery scripts "
2163:           "from run.sh" % (len(on_disk), os.path.basename(regress), mode, len(scripts)))
2164:     if verbose:
2165:         for cls in CLASSES:
2166:             for c, f, state, why in rows:
2167:                 if c == cls:
2168:                     print("    %-8s %-28s %-38s %s" % (c, f, state, why))
2169:         for line in ignored:
2170:             print("    IGNORED  %s   (not the regress copy)" % line)
2171:     for n in notes:
2172:         print("  note  %s" % n)
2173:     for f in fails:
2174:         print("  FAIL  %s" % f)
2176:     det = [r for r in rows if r[0] == CLASS_DETECTOR]
2177:     run = [r for r in det if r[2].startswith("RUN")]
2178:     ex = [r for r in det if r[2].startswith("EXEMPT")]
2179:     wit = [r for r in rows if r[0] == CLASS_WITNESS]
2180:     if fails:
2181:         print("PROBEWIRING_FAIL  %d problem(s); %d/%d detectors run by a gate, %d dated-exempt"
2182:               % (len(fails), len(run), len(det), len(ex)))
2183:         return 1
2184:     print("PROBEWIRING_PASS  %d/%d detectors run by a gate, %d dated-exempt, %d witnesses "
2185:           "correctly ungated" % (len(run), len(det), len(ex), len(wit)))
2186:     return 0
2189: if __name__ == "__main__":
2190:     sys.exit(main(sys.argv[1:]))
