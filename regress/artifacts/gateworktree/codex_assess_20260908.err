  302: 	#  already been accepted twice here (GATE_MANIFEST, and SM_COVERED in
  303: 	#  gate_offline.sh), both times for exactly this reason.
  304: 	#
  305: 	#  A pin stops being SEEN when its literal is quoted (`"32"` for 32), when its
  306: 	#  label gains a word before the stem, or when the count moves to a variable --
  307: 	#  all of which leave the gate behaving identically.  That is why the count is
  308: 	#  asserted at all.
