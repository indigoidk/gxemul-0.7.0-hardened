  297: 	#  means editing BOTH lines.  That is the point."  Equality fails in BOTH
  298: 	#  directions -- shrinking means a pin was lost; growing means a new probe
  299: 	#  arrived and the number becomes a deliberate edit rather than silent drift.
  300: 	#
