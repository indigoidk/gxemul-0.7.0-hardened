  54: CUTOFF = "2026-08-20"
  57: def strip_seat(note, seat):
  58:     """Remove the seat's own name so identical text stops looking distinct."""
  59:     n = re.sub(r"^\s*%s\b[^.]*\.\s*" % re.escape(seat), "", note, count=1, flags=re.I)
  60:     return re.sub(r"\b%s\b" % re.escape(seat), "<seat>", n, flags=re.I).strip()
  63: def shared_notes(rows):
  64:     """[(row_id, [seats], excerpt)] for notes >= MIN_SEATS seats share."""
  65:     out = []
  66:     for rid, row in sorted(rows.items()):
  67:         buckets = collections.defaultdict(set)
  68:         for e in row.get("entries", []):
  69:             note, seat = e.get("note") or "", e.get("seat") or "?"
  70:             if len(note) < 80:
  71:                 continue                      # too short to carry a claim either way
  72:             buckets[strip_seat(note, seat)[:PREFIX].casefold()].add((seat, e.get("date") or ""))
  73:         for key, pairs in buckets.items():
  74:             seats = sorted({s for s, _ in pairs})
  75:             if len(seats) >= MIN_SEATS:
  79:                 live = all(dt > CUTOFF for _, dt in pairs if dt)
  80:                 out.append((rid, seats, key.replace("\n", " "), live))
  81:     return out
