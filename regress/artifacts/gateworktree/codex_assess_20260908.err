  91:         total = sum(c.values())
  92:         graded = total - c["UNVERIFIED"]
  93:         cov = (graded / total * 100) if total else 0.0
  94:         rate = ("%.0f%%" % (c["UPHELD"] / graded * 100)) if graded else "--"
  95:         print("%-12s %6d %7d %8d %8d %8d %8.0f%% %7d %6d  %s"
  96:               % (s, total, graded, c["UPHELD"], c["REFUTED"], c["PARTIAL"],
  97:                  cov, acted[s], selfg[s], ("upheld " + rate) if graded else ""))
