1766: def selftest(verbose=False):
1767:     import shutil
1768:     import subprocess
1769:     import tempfile
1770: 
1771:     src_regress = DEFAULT_REGRESS
1772:     me = os.path.abspath(__file__)
1773:     root = tempfile.mkdtemp(prefix="probewiring_selftest_")
1774:     results = []
1775: 
1776:     #  *** THE BASELINE MUST BE GREEN BY CONSTRUCTION, AND THE FIRST VERSION WAS NOT. ***
1777:     #  fresh() copied EVERY .py from the live tree, so when a concurrent round dropped an
1778:     #  unclassified probe into regress/, M0/M2b/M5a all went red and the selftest announced
1779:     #  "THE CHECKER CAN NO LONGER BE SHOWN TO FAIL".  Right colour, WRONG DIAGNOSIS: it
1780:     #  blamed the checker for an APPARATUS state -- gate_offline's F5 shape, and the
1781:     #  dangerous one, because it points the reader at the wrong file.
1782:     #
1783:     #  So the baseline copies exactly the MANIFEST set.  Live-tree content can no longer
1784:     #  perturb a mutant, and M6 still tests the unclassified-arrival path by ADDING one.
1785:     #  A MANIFEST entry with no source file is a SETUP FAULT here, never a mutant result --
1786:     #  absorb_census.py's rule that a crash is a fault and never a detection.
1787:     def fresh():
1788:         work = tempfile.mkdtemp(dir=root)
1789:         rg = os.path.join(work, "regress")
1790:         os.makedirs(rg)
1791:         #  #471: THE COPY MUST MIRROR THE TREE, NOT FLATTEN IT.  This loop was
1792:         #  `os.listdir`, so once the checker could see nested detectors the selftest
1793:         #  copy still could not -- and every nested MANIFEST entry became a GHOST in
1794:         #  the copy, reddening the unmutated M0 control.
1795:         #
1796:         #  That is the SAME blind spot one level up, inside the harness that tests
1797:         #  for it: a flat copy cannot exercise a recursive scan.
1798:         for f in os.listdir(src_regress):
1799:             if f.endswith(".sh"):
1800:                 shutil.copyfile(os.path.join(src_regress, f), os.path.join(rg, f))
1801:         for rel in MANIFEST:
1802:             if not rel.endswith(".py"):
1803:                 continue
1804:             src = os.path.join(src_regress, rel.replace("/", os.sep))
1805:             if not os.path.isfile(src):
1806:                 continue
1807:             dst = os.path.join(rg, rel.replace("/", os.sep))
1808:             os.makedirs(os.path.dirname(dst), exist_ok=True)
1809:             shutil.copyfile(src, dst)
1810:         chk = os.path.join(work, "check_probe_wiring.py")
1811:         shutil.copyfile(me, chk)
1812:         return rg, chk
1813: 
1814:     absent = [f for f in sorted(MANIFEST) if not os.path.isfile(os.path.join(src_regress, f))]
1815:     if absent:
1816:         print("PROBEWIRING_SELFTEST_SETUP  the MANIFEST names files regress/ does not have:")
1817:         for f in absent:
1818:             print("    %s" % f)
1819:         print("  fix the manifest first; a selftest on a broken baseline proves nothing.")
1820:         return 2
