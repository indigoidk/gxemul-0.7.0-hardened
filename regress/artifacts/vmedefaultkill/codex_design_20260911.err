   26:  *
   27:  *
   28:  *  Debug message functionality.
   29:  *
   30:  *  To print a debug message, use debugmsg() or debugmsg_cpu(). The _cpu
   31:  *  variant is if the message comes from a particular CPU. In that case, the
   32:  *  name of the machine and cpu id may be printed.
   33:  *
   34:  *  In addition to the actual message to be printed, a subsystem, a component
   35:  *  name, and a verbosity level also need to be supplied. The component name
   36:  *  may be empty.
   37:  *
   38:  *  If it is relatively expensive to construct the message, then it would be
   39:  *  a bad idea to do that every time the debugmsg is called in case it is
   40:  *  rarely shown anyway (due to verbosity level being higher than the current
   41:  *  setting). Then, the following construct may be used to quickly check before
   42:  *  constructing the message that it will be shown:
   43:  *
   44:  *	if (ENOUGH_VERBOSITY(SUBSYS_XXX, VERBOSITY_YYY)) {
   45:  *		char msg[....];
   46:  *		// Construct msg here...
   47:  *
   48:  *		debugmsg(SUBSYS_XXX, "component", VERBOSITY_YYY, "%s", msg);
   49:  *	}
   50:  *
   51:  *
   52:  *  TODO:
   53:  *	New debugger commands:
   54:  *		command for showing debug output in new xterms?
   55:  *
   56:  *	Convert existing debug() and fatal() calls to the new debugmsg() call.
   57:  *
   58:  *	Make sure that all the hardcoded subsystems are actually used, and/or
   59:  *	move registering to individual subsystems.
   60:  */
   61: 
   62: #include <stdarg.h>
   63: #include <stdbool.h>
   64: #include <stdio.h>
   65: #include <stdlib.h>
   66: #include <string.h>
   67: 
   68: #include "console.h"
   69: #include "cpu.h"
   70: #include "emul.h"
   71: #include "machine.h"
   72: #include "misc.h"
   73: 
   74: 
   75: int verbose = 0;
   76: int quiet_mode = 0;
   77: 
   78: extern bool emul_executing;
   79: extern bool single_step;
   80: extern bool about_to_enter_single_step;
   81: 
   82: size_t debugmsg_nr_of_subsystems = 0;
   83: static const char **debugmsg_subsystem_name = NULL;
   84: int *debugmsg_current_verbosity = NULL;
   85: 
   86: /*
   87:  *  Breakpoints on subsystem messages: for each subsystem, the verbosity
   88:  *  level at which messages trigger entry into the interactive debugger,
   89:  *  or -1 when no breakpoint is set for that subsystem. (Lower value =
   90:  *  more severe, so a message triggers when verbosity <= the level.)
   91:  *  debugmsg_n_breakpoints counts subsystems with a breakpoint set, so
   92:  *  that the common case (no breakpoints at all) is a single comparison.
   93:  */
   94: static int *debugmsg_breakpoint_level = NULL;
   95: static int debugmsg_n_breakpoints = 0;
   96: 
   97: /*
   98:  *  #261: opt-in, default-OFF global "break on any ERROR-level message".
   99:  *  Toggled by `breakpoint subsystem all error` / `... all off`, and checked
  100:  *  in debugmsg_va() alongside the per-subsystem levels. Default 0 = no-op.
  101:  */
  102: int debugmsg_break_on_error = 0;
  103: 
  104: static const int default_verbosity = VERBOSITY_INFO;
  105: 
  106: static size_t debug_indent = 0;
  107: static bool debug_old_currently_at_start_of_line = true;
  108: 
  109: #define	DEBUG_BUFSIZE		2048
  110: #define	DEBUG_INDENTATION	4
  111: 
  112: 
  113: /*
  114:  *  va_debug():
  115:  *
  116:  *  Used internally by the old debug() and fatal() functions.
  117:  */
  118: static void va_debug(va_list argp, const char *fmt)
  119: {
  120: 	char buf[DEBUG_BUFSIZE + 1];
  121: 	buf[0] = buf[DEBUG_BUFSIZE] = 0;
  122: 	vsnprintf(buf, DEBUG_BUFSIZE, fmt, argp);
  123: 
  124: 	char* s = buf;
  125: 	while (*s) {
  126: 		if (debug_old_currently_at_start_of_line) {
  127: 			for (size_t i = 0; i < debug_indent * DEBUG_INDENTATION; i++)
  128: 				printf(" ");
  129: 		}
  130: 
  131: 		printf("%c", *s);
  132: 
  133: 		debug_old_currently_at_start_of_line = false;
  134: 		if (*s == '\n' || *s == '\r')
  135: 			debug_old_currently_at_start_of_line = true;
  136: 		s++;
  137: 	}
  138: }
  139: 
  140: 
  141: /*
  142:  *  debugmsg_va():
  143:  *
  144:  *  Used internally by debugmsg().
  145:  */
  146: static void debugmsg_va(struct cpu* cpu, int subsystem,
  147: 	const char *name, int verbosity, va_list argp, const char *fmt)
  148: {
  149: 	bool subsystem_breakpoint = false;
  150: 
  151: 	/*
  152: 	 *  #261: opt-in global break on any ERROR-level message (covers every
  153: 	 *  subsystem, incl. ones registered after a per-subsystem breakpoint
  154: 	 *  was set). Default off = single false test = no-op.
  155: 	 */
  156: 	bool do_bp = (debugmsg_n_breakpoints > 0 &&
  157: 	    debugmsg_breakpoint_level[subsystem] >= 0 &&
  158: 	    verbosity <= debugmsg_breakpoint_level[subsystem]);
  159: 	if (debugmsg_break_on_error && verbosity <= VERBOSITY_ERROR)
  160: 		do_bp = true;
  161: 
  162: 	if (do_bp) {
  163: 		/*
  164: 		 *  This message triggers a breakpoint on subsystem messages:
  165: 		 *  make sure the message itself is shown (even if the current
  166: 		 *  verbosity setting would have suppressed it), and request
  167: 		 *  entry into the interactive debugger. The debugger is
  168: 		 *  entered after the current instruction batch, using the
  169: 		 *  same mechanism as normal breakpoints.
  170: 		 */
  171: 		subsystem_breakpoint = true;
  172: 
  173: 		if (!single_step && !about_to_enter_single_step) {
  174: 			fatal("[ subsystem breakpoint: %s ]\n",
  175: 			    debugmsg_subsystem_name[subsystem][0] != '\0'
  176: 			    ? debugmsg_subsystem_name[subsystem] : "(startup)");
  177: 			about_to_enter_single_step = true;
  178: 		}
  179: 	}
  180: 
  181: 	if (!subsystem_breakpoint && !single_step &&
  182: 	    !ENOUGH_VERBOSITY(subsystem, verbosity))
  183: 		return;
  184: 
  185: 	char buf[DEBUG_BUFSIZE];
  186: 
  187: 	buf[0] = buf[DEBUG_BUFSIZE - 1] = 0;
  188: 	vsnprintf(buf, DEBUG_BUFSIZE, fmt, argp);
  189: 
  190: 	char* s = buf;
  191: 	bool ss = single_step || about_to_enter_single_step;
  192: 	bool debug_currently_at_start_of_line = true;
  193: 	bool show_decorations = emul_executing && !ss;
  194: 
  195: 	if (console_are_slaves_allowed())
  196: 		show_decorations = false;
  197: 
  198: 	while (true) {
  199: 		if (debug_currently_at_start_of_line) {
  200: 			if (show_decorations) {
  201: 				color_normal();
  202: 				printf("[ ");
  203: 			} else {
  204: 				for (size_t i = 0; i < debug_indent * DEBUG_INDENTATION; ++i)
  205: 					printf(" ");
  206: 			}
  207: 
  208: 			bool print_subsystem_name =
  209: 			    debugmsg_subsystem_name[subsystem][0] != '\0' &&
  210: 			    (debug_indent == 0 || (name == NULL || name[0] == '\0'));
  211: 			bool print_colon = false;
  212: 
  213: 			if (cpu != NULL) {
  214: 				// With multiple machines being emulated in the
  215: 				// same emulation instance, print both the machine
  216: 				// name and cpu id. If it is just one machine,
  217: 				// only print the cpu id if there are multiple
  218: 				// CPUs in order to not clutter the output
  219: 				// needlessly.
  220: 				struct emul* emul = cpu->machine->emul;
  221: 				if (emul->n_machines > 1) {
  222: 					printf("machine \"%s\" cpu%i: ",
  223: 					    cpu->machine->name ? cpu->machine->name : "(no name)",
  224: 					    cpu->cpu_id);
  225: 					if (subsystem == SUBSYS_CPU)
  226: 						print_subsystem_name = false;
  227: 				} else if (cpu->machine->ncpus > 1) {
  228: 					printf("cpu%i: ", cpu->cpu_id);
  229: 					if (subsystem == SUBSYS_CPU)
  230: 						print_subsystem_name = false;
  231: 				}
  232: 			}
  233: 
  234: 			if (verbosity == VERBOSITY_ERROR)
  235: 				color_error(false);
  236: 			else
  237: 				color_debugmsg_subsystem();
  238: 
  239: 			if (print_subsystem_name) {
  240: 				printf("%s", debugmsg_subsystem_name[subsystem]);
  241: 				print_colon = true;
  242: 			}
  243: 
  244: 			if (name != NULL && name[0] != '\0') {
  245: 				if (print_subsystem_name)
  246: 					printf(" ");
  247: 
  248: 				if (verbosity != VERBOSITY_ERROR)
  249: 					color_debugmsg_name();
  250: 
  251: 				printf("%s", name);
  252: 
  253: 				print_colon = true;
  254: 			}
  255: 
  256: 			if (print_colon)
  257: 				printf(": ");
  258: 
  259: 			if (show_decorations) {
  260: 				for (size_t i = 0; i < debug_indent * DEBUG_INDENTATION; ++i)
  261: 					printf(" ");
  262: 			}
  263: 
  264: 			if (verbosity == VERBOSITY_ERROR)
  265: 				color_error(true);
  266: 			else
  267: 				color_normal();
  268: 		}
  269: 
  270: 		debug_currently_at_start_of_line = false;
  271: 
  272: 		if (!*s)
  273: 			break;
  274: 
  275: 		switch (*s) {
  276: 		case '\n':
  277: 			color_normal();
  278: 			if (show_decorations) {
  279: 				printf(" ]");
  280: 			}
  281: 
  282: 			debug_currently_at_start_of_line = true;
  283: 			printf("\n");
  284: 			break;
  285: 
  286: 		default:
  287: 			printf("%c", *s);
  288: 		}
  289: 
  290: 		s++;
  291: 	}
  292: 
  293: 	color_normal();
  294: 
  295: 	if (show_decorations)
  296: 		printf(" ]");
  297: 
  298: 	if (!debug_currently_at_start_of_line)
  299: 		printf("\n");
  300: }
  301: 
  302: 
  303: /*
  304:  *  debugmsg():
  305:  *
  306:  *  The main routine to call, when something should be printed.
  307:  */
  308: void debugmsg(int subsystem, const char *name,
  309: 	int verbosity_required, const char *fmt, ...)
  310: {
  311: 	va_list argp;
  312: 
  313: 	va_start(argp, fmt);
  314: 	debugmsg_va(NULL, subsystem, name, verbosity_required, argp, fmt);
  315: 	va_end(argp);
  316: }
  317: 
  318: 
  319: /*
  320:  *  debugmsg():
  321:  *
  322:  *  The main routine to call, when something should be printed and we are
  323:  *  in the context of a specific CPU.
  324:  */
  325: void debugmsg_cpu(struct cpu* cpu, int subsystem, const char *name,
  326: 	int verbosity_required, const char *fmt, ...)
  327: {
  328: 	va_list argp;
  329: 
  330: 	va_start(argp, fmt);
  331: 	debugmsg_va(cpu, subsystem, name, verbosity_required, argp, fmt);
  332: 	va_end(argp);
  333: }
  334: 
  335: 
  336: /*
  337:  *  debug_indentation():
  338:  *
  339:  *  Modify the debug indentation. diff should be +1 to increase, and -1 to
  340:  *  decrease after printing something.
  341:  *
  342:  *  This affects both the older debug() and fatal() functions, and the new
  343:  *  debugmsg/debugmsg_cpu() functions.
  344:  */
  345: void debug_indentation(int diff)
  346: {
  347: 	debug_indent += diff;
  348: 
  349: 	if ((ssize_t)debug_indent < 0) {
  350: 		fprintf(stderr, "WARNING: debug_indent too low!\n");
  351: 		debug_indent = 0;
  352: 	}
  353: }
  354: 
  355: 
  356: /*
  357:  *  debug() and fatal():
  358:  *
  359:  *  These are here because of all the legacy code that uses them. Basically,
  360:  *  debug() is mapped to something that is only displayed with verbosity
  361:  *  at the default level, and fatal() is used to always print stuff. With some
  362:  *  hacks to make it work reasonable with -q and when executing normally or
  363:  *  when executing single-stepping.
  364:  */
  365: void debug(const char *fmt, ...)
  366: {
  367: 	va_list argp;
  368: 	bool ss = single_step || about_to_enter_single_step;
  369: 	int v = verbose;
  370: 	if (emul_executing)
  371: 		v--;
  372: 	if (ss)
  373: 		v++;
  374: 
  375: 	if ((quiet_mode && !ss) || v < 0)
  376: 		return;
  377: 
  378: 	va_start(argp, fmt);
  379: 	va_debug(argp, fmt);
  380: 	va_end(argp);
  381: }
  382: 
  383: 
  384: void fatal(const char *fmt, ...)
  385: {
  386: 	va_list argp;
  387: 
  388: 	va_start(argp, fmt);
  389: 	va_debug(argp, fmt);
  390: 	va_end(argp);
  391: }
  392: 
  393: 
  394: void debugmsg_set_verbosity_level(int subsystem, int verbosity)
  395: {
  396: 	if (subsystem != SUBSYS_ALL)
  397: 		debugmsg_current_verbosity[subsystem] = verbosity;
  398: 	else
  399: 		for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i)
  400: 			debugmsg_current_verbosity[i] = verbosity;
  401: }
  402: 
  403: 
  404: void debugmsg_add_verbosity_level(int subsystem, int verbosity_delta)
  405: {
  406: 	if (subsystem != SUBSYS_ALL)
  407: 		debugmsg_current_verbosity[subsystem] += verbosity_delta;
  408: 	else
  409: 		for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i)
  410: 			debugmsg_current_verbosity[i] += verbosity_delta;
  411: 
  412: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i)
  413: 		if (debugmsg_current_verbosity[i] < 0)
  414: 			debugmsg_current_verbosity[i] = 0;
  415: }
  416: 
  417: 
  418: /*
  419:  *  debugmsg_register_subsystem():
  420:  *
  421:  *  Registers a new subsystem.
  422:  */
  423: int debugmsg_register_subsystem(const char* name)
  424: {
  425: 	// TODO: Another way would be to support multiple names with e.g.
  426: 	// a suffix. Such as "le0", "le1", "le2" for the name "le".
  427: 	// But for now, simply return the same subsystem for all of them.
  428: 	ssize_t subsys = -1;
  429: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i)
  430: 		if (strcmp(name, debugmsg_subsystem_name[i]) == 0)
  431: 			subsys = i;
  432: 
  433: 	if (subsys >= 0)
  434: 		return subsys;
  435: 	
  436: 	subsys = debugmsg_nr_of_subsystems;
  437: 
  438: 	debugmsg_nr_of_subsystems ++;
  439: 	debugmsg_subsystem_name = realloc(debugmsg_subsystem_name,
  440: 	    sizeof(char*) * debugmsg_nr_of_subsystems);
  441: 	debugmsg_current_verbosity = realloc(debugmsg_current_verbosity,
  442: 	    sizeof(int) * debugmsg_nr_of_subsystems);;
  443: 	debugmsg_breakpoint_level = realloc(debugmsg_breakpoint_level,
  444: 	    sizeof(int) * debugmsg_nr_of_subsystems);
  445: 
  446: 	debugmsg_subsystem_name[subsys] = strdup(name);
  447: 	debugmsg_breakpoint_level[subsys] = -1;
  448: 	debugmsg_set_verbosity_level(subsys, default_verbosity);
  449: 
  450: 	return subsys;
  451: }
  452: 
  453: 
  454: /*
  455:  *  debugmsg_change_settings():
  456:  *
  457:  *  Changes the current verbosity level settings for a given setting name.
  458:  */
  459: void debugmsg_change_settings(char *subsystem_name, char *n)
  460: {
  461: 	int ns = 0;
  462: 
  463: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i) {
  464: 		if (strcasecmp("ALL", subsystem_name) != 0) {
  465: 			if (strcmp(subsystem_name, debugmsg_subsystem_name[i]) != 0)
  466: 				continue;
  467: 		}
  468: 
  469: 		int v = atoi(n);
  470: 
  471: 		switch (*n) {
  472: 		case 'e':
  473: 		case 'E':
  474: 			v = 0;
  475: 			break;
  476: 		case 'w':
  477: 		case 'W':
  478: 			v = 1;
  479: 			break;
  480: 		case 'i':
  481: 		case 'I':
  482: 			v = 2;
  483: 			break;
  484: 		case 'd':
  485: 		case 'D':
  486: 			v = 3;
  487: 			break;
  488: 		}
  489: 		
  490: 		debugmsg_current_verbosity[i] = v;
  491: 
  492: 		++ns;
  493: 	}
  494: 
  495: 	if (ns == 0)
  496: 		printf("Unknown debugmsg subsystem name '%s'\n", subsystem_name);
  497: 	else
  498: 		debugmsg_print_settings(subsystem_name);
  499: }
  500: 
  501: 
  502: /*
  503:  *  debugmsg_print_settings():
  504:  *
  505:  *  Prints the current verbosity level settings.
  506:  */
  507: void debugmsg_print_settings(const char *subsystem_name)
  508: {
  509: 	int n = 0;
  510: 
  511: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i) {
  512: 		if (subsystem_name != NULL && subsystem_name[0] != '\0' &&
  513: 		    strcasecmp("ALL", subsystem_name) != 0) {
  514: 			if (strcmp(subsystem_name, debugmsg_subsystem_name[i]) != 0)
  515: 				continue;
  516: 		}
  517: 
  518: 		const char* name = debugmsg_subsystem_name[i];
  519: 		if (i == SUBSYS_STARTUP)
  520: 			name = "(startup related)";
  521: 
  522: 		char buf[100];
  523: 		switch (debugmsg_current_verbosity[i]) {
  524: 		case VERBOSITY_ERROR:
  525: 			snprintf(buf, sizeof(buf), "0: ERROR");
  526: 			break;
  527: 		case VERBOSITY_WARNING:
  528: 			snprintf(buf, sizeof(buf), "1: WARNING");
  529: 			break;
  530: 		case VERBOSITY_INFO:
  531: 			snprintf(buf, sizeof(buf), "2: INFO");
  532: 			break;
  533: 		case VERBOSITY_DEBUG:
  534: 			snprintf(buf, sizeof(buf), "3: DEBUG");
  535: 			break;
  536: 		default:
  537: 			snprintf(buf, sizeof(buf), "%i", debugmsg_current_verbosity[i]);
  538: 			break;
  539: 		}
  540: 
  541: 		if (n == 0)
  542: 			printf("Subsystem:          Level:\n");
  543: 
  544: 		printf("%17s   %s\n", name, buf);
  545: 
  546: 		++n;
  547: 	}
  548: 
  549: 	if (n == 0)
  550: 		printf("Unknown debugmsg subsystem name '%s'\n", subsystem_name);
  551: }
  552: 
  553: 
  554: /*
  555:  *  debugmsg_set_breakpoint():
  556:  *
  557:  *  Sets (level = VERBOSITY_ERROR .. VERBOSITY_DEBUG) or clears (level < 0)
  558:  *  a breakpoint on messages from a subsystem. When a message which is at
  559:  *  least as severe as the given level is printed for that subsystem, the
  560:  *  emulator enters the interactive debugger. E.g. level = VERBOSITY_WARNING
  561:  *  breaks on warnings and errors, but not on info/debug messages.
  562:  *
  563:  *  The subsystem name "ALL" (case insensitive) affects all subsystems.
  564:  *
  565:  *  Returns 1 if the subsystem name matched, 0 otherwise.
  566:  */
  567: int debugmsg_set_breakpoint(const char *subsystem_name, int level)
  568: {
  569: 	int n = 0;
  570: 
  571: 	if (level < 0)
  572: 		level = -1;
  573: 
  574: 	/*
  575: 	 *  #261: the "ALL" pseudo-subsystem also (dis)arms the global
  576: 	 *  break-on-ERROR toggle: `... all error` arms it, `... all off`
  577: 	 *  (level < 0) clears it. Only ERROR arms; warning/info/debug do not.
  578: 	 */
  579: 	if (strcasecmp("ALL", subsystem_name) == 0)
