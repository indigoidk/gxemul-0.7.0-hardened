61: 
62: /*  #568: a warned_unimpl narrower than VME2_MISC >> 2 + 1 bits would
63:     leave MISC's announce bit outside the field; make that a compile error
64:     (dev_pcc2.c's pcc2_w_fits_in_warned shape).  The 1ULL in the shifts
65:     below is not checked here.  */
66: typedef char vme_warned_fits[(VME2_MISC >> 2) <
67:     8 * sizeof(((struct vme_data *)0)->warned_unimpl) ? 1 : -1];
