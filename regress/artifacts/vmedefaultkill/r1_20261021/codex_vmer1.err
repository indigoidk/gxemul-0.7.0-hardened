682: ```sh
683: #  ------------------------------------------------------------ vmedefaultkill (#568)
684: #  dev_vme.c's default: ended the emulator (exit(1), announced only by debug() -- silent while
685: #  free-running) on any VME2 offset the switch did not name.  Now: the 26 header-named registers
686: #  the model does not implement DECLINE (reads served the preloaded word, writes dropped, one
687: #  latched fatal() per register); every other unmatched offset returns 0, and for a guest data load
688: #  or store memory_rw raises the m88k data-access exception.  The rung-3 witness
689: #  (regress/artifacts/vmedefaultkill/witness_20261020/, 7 of 7 guest sites rc 1 on 5dbc000e) is NOT
690: #  run here; this is its detector.  Needs only the binary: the probe constructs mvme88k/mvme187 with
691: #  -M 64 and a 4-byte dummy image at 0x10000 -- no PROM image.  Kill tables:
692: #  regress/artifacts/vmedefaultkill/killtable1_20261020/ (rev 2) and killtable2_20261021/ (rev 3).
693: VMEDLOG=$LOGDIR/vme_default.log
694: python3 -u vme_default_probe.py "$PMAX" gate > "$VMEDLOG" 2>&1 || true
695: if ! grep -q "VME_DEFAULT_PROBE_DONE" "$VMEDLOG"; then
696:     check "vme default probe completed" "no" "yes"
697: else
698:     check "vme default probe completed" "yes" "yes"
699:     vres=$(sed -n 's/^VME_DEFAULT_RESULT=//p' "$VMEDLOG")
700:     check "vme_default rows run"     "${vres#*/}" 38

