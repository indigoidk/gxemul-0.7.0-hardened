230: DEVINIT(vme)
231: {
232: 	struct vme_data *d;
233: 
234: 	CHECK_ALLOCATION(d = (struct vme_data *) malloc(sizeof(struct vme_data)));
235: 	memset(d, 0, sizeof(struct vme_data));
