            [(2, TCTLVAL), (7, VBRVAL), (8, T1CVAL), (11, VBR_SEED), (4, SENT), (5, SENT), (9, SENT),
             (10, SENT), (12, SENT), (30, SENT), (31, SENT)], len(prog) - 1)
