+    VME2_MISC >> 2; make that a compile error (dev_pcc2.c's
+    pcc2_w_fits_in_warned shape).  */
+typedef char vme_warned_fits[((VME2_MISC >> 2) <
+    8 * sizeof(((struct vme_data *)0)->warned_unimpl)
+    && (VME2_MISC >> 2) < 8 * sizeof(1ULL)) ? 1 : -1];
+
 
