   50:  *	  0xfff40000             = VME bus
   51:  *	  0xfff43000             = MEMC040 (Memory controller)
   52:  *	  0xfff45000             = CD2401 SCC SERIAL IO (cl0)
   53:  *	  0xfff46000             = 82596 Ethernet (ie0)
   54:  *	  0xfff47000             = 53C710 SCSI (osiop0)
   55:  *	  0xfffc0000             = MK48T08 (nvram0)
