438:     "rotldi r6,r3,8 -- mask is all-ones, so this is a PURE rotate")
439: row("rot8 rldicr", hex(regs.get(7, -1)), hex(want_rldicr(RS_VAL, 8, 63)),
440:     "DISCRIMINATING: the same pure rotate through the good sibling")
441: 
442: # --- what the NAIVE repair would produce, stated as a measurable prediction
443: # DERIVED, not measured here: what the "obvious" repair would produce.
444: _naive = rotl64(RS_VAL, 0) | mask_b_63(32)
445: row("naive fix wrong", "differs" if _naive != want_rldicl(RS_VAL, 0, 32) else "same",
446:     "differs",
447:     "DERIVED, arithmetic only: `&'->`|' ships OR-not-AND (0x%x).  Deleting the AND on the FIXED code ships ROTL alone -- see M_NOMASK" % _naive)
448: 
449: # ================================================ NEGATIVE APPARATUS CONTROL ==
450: # Prove `live' CAN go red.  A bogus machine name means no machine is built, so a
451: # green `live' would be a check that cannot fail.
452: nregs, _, nT, nhow = session(seed([(9, SENT)]), [LI(9, 0x1234)],
453:                              machine="nosuchmachine", timeout=60)
454: row("neg apparatus", "%s/%s" % (nhow, hex(nregs.get(9, -1))), "exit1/-0x1",
455:     "bogus machine -> no guest -> `live' MUST fail; the oracle is failable")
456: 
457: # ============================================ REACHABILITY CONTROL (32-bit) ===
458: # The decoder sends rld* to `bad' when bits == 32.  Same session, same encoding,
459: # a 32-bit CPU: the instruction must NOT execute as rldicl.
460: b32regs, _, b32T, b32how = session(
461:     seed([(SRC, RS_VAL), (4, SENT), (9, SENT)]),
462:     [LI(9, 0x1234), RLDICL(4, SRC, 0, 32)], timeout=60, machine="bareppc",
463:     cpu="PPC603")
464: open("/tmp/ppc_rldicl_32.txt", "w").write(b32T)
465: row("bits32 live", hex(b32regs.get(9, -1)), hex(0x1234),
466:     "PPC603 (32-bit): the guest still runs -- li executes")
467: row("bits32 rld bad", "TODO" if "TODO: rld" in b32T else "no-msg", "TODO",
468:     "decoder prints `TODO: rld* in 32-bit mode?' and goes to bad -- unreachable")
469: 
470: # ===================================================== VACUITY (question 3) ===
471: # A cell where the ARCHITECTURAL answer is itself zero: a detector row placed
472: # here could never fail, whatever the handler does.
473: # [#565, 2026-10-18: TOO STRONG.  It cannot fail on the ALWAYS-ZERO defect this file was
474: # written for, but it fails when the handler writes something else: under M_NOMASK it read
475: # 0xffffffff00000000 and was red (killtable_20260910/t2/probe_M_NOMASK.raw:18; GPT-6 Astra,
476: # #565 pass 2).]
477: RS_VAC = 0xFFFFFFFF00000000
478: vregs, _, vT, vhow = session(seed([(SRC, RS_VAC)] + [(r, SENT) for r in DESTS]),
479:                              [RLDICL(4, SRC, 0, 32), RLDICL(5, SRC, 0, 0)])
480: row("vacuous cell", hex(vregs.get(4, -1)), hex(want_rldicl(RS_VAC, 0, 32)),
481:     "rS=0xffffffff00000000, SH=0, MB=32: correct answer IS 0 -- GREEN on a")
482: row("vac neighbour", hex(vregs.get(5, -1)), hex(want_rldicl(RS_VAC, 0, 0)),
483:     "  broken build.  Its MB=0 neighbour on the same rS is not vacuous.")
484: 
485: # ============================================================ THE (SH,MB) CENSUS
486: # rS = all-ones, so ROTL64(rS,SH) = all-ones for every SH and the architectural
487: # answer is exactly MASK(MB,63), which is NONZERO for every MB in 0..63.  Every
488: # cell of this census is therefore provably non-vacuous by construction.
489: combos = []
490: for mb in range(64):
491:     combos.append((0, mb))                      # MB sweep at SH=0
492: for sh in range(1, 64):
493:     combos.append((sh, 0))                      # SH sweep at MB=0
494: for k in range(1, 64):
495:     combos.append((k, k))                       # the diagonal
496: seen = set()
497: uniq = []
498: for c in combos:
499:     if c not in seen:
500:         seen.add(c)
501:         uniq.append(c)
502: 
503: census_fail = 0
504: census_zero = 0
505: census_run = 0
506: for base in range(0, len(uniq), len(DESTS)):
507:     chunk = uniq[base:base + len(DESTS)]
508:     insns = [RLDICL(DESTS[i], SRC, sh, mb) for i, (sh, mb) in enumerate(chunk)]
509:     st = seed([(SRC, RS_ONES)] + [(r, SENT) for r in DESTS])
510:     cregs, cdis, cT, chow = session(st, insns)
511:     if chow != "exit0":
512:         print("CENSUS SESSION ABORTED how=%s at base=%d" % (chow, base))
513:         break
514:     # disassembler cross-check on every census word too
515:     for i, (sh, mb) in enumerate(chunk):
516:         disasm_checked += 1
517:         if i < len(cdis) and cdis[i][1] == "rldicl" and \
518:            cdis[i][2] == "r%d,r%d,%d,%d" % (DESTS[i], SRC, sh, mb):
519:             disasm_ok += 1
520:     for i, (sh, mb) in enumerate(chunk):
521:         census_run += 1
522:         got = cregs.get(DESTS[i], None)
523:         exp = want_rldicl(RS_ONES, sh, mb)
524:         if got != exp:
525:             census_fail += 1
526:         if got == 0:
527:             census_zero += 1
528: 
529: row("census run", census_run, len(uniq),
530:     "(SH,MB) cells driven: MB sweep + SH sweep + diagonal, rS=all-ones")
531: row("census wrong", census_fail, 0,
532:     "cells whose result differs from MASK(MB,63) -- want 0 after a fix")
533: row("census zero", census_zero, 0,
534:     "cells that returned EXACTLY ZERO -- want 0 after a fix")
535: row("disasm total", "%d/%d" % (disasm_ok, disasm_checked),
536:     "%d/%d" % (disasm_checked, disasm_checked),
537:     "the 196 control + census words checked against the tree's own disassembler")
538: 
539: # ================================ WHY THE SIBLING ROWS ARE NOT HERE =============
540: #
541: #  The witness this file is derived from is a FAMILY instrument: it also rows
542: #  X(rldimi) and X(rlwimi), which carry their OWN measured defects (ppcrldimimask,
543: #  ppcrlwimiwidth) that #522 does not touch and must not touch.  Shipping those rows
544: #  in a DETECTOR would make it PERMANENTLY RED until two unrelated rounds land --
545: #  a detector that cannot be green is a different fault from the one it was written
546: #  to catch, and a gate row over it would have to be ignored, which is how a gate
547: #  stops being read at all.
548: #
549: #  So this detector is scoped to X(rldicl).  The three sibling rows stay in the
550: #  witness at regress/artifacts/ppcrldiclzero/, which is the EVIDENCE for those two

