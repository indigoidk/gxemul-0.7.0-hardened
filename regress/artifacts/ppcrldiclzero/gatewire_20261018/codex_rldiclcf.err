100: if len(sys.argv) < 2:
101:     sys.stderr.write("usage: ppc_rldicl_witness.py <gxemul> [label]\n")
102:     sys.exit(2)
103: 
104: BIN = sys.argv[1]
105: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
106: DUMMY = "/tmp/ppc_rldicl_dummy.bin"
107: open(DUMMY, "wb").write(b"\x00\x00\x00\x00")
108: 
109: CODE = 0x10000
110: M64 = (1 << 64) - 1
111: SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into every destination
112: RS_ONES = M64                    # census source: makes EVERY cell non-vacuous
113: RS_VAL = 0xDEADBEEFCAFEF00D      # value source: exercises the rotate too
114: SRC = 3                          # rS is always r3; r3 is never a destination
115: DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session
116: 
117: rows = []
118: 
119: 
120: def row(name, got, want, note=""):
340: 
341: # ---------------------------------------------------------------------- sessions
342: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
343:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs.
344:        Returns (regs dict, disasm list, transcript, how)."""
345:     cmds = list(setup)
346:     for i, w in enumerate(insns):
347:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
348:     if insns:
349:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
350:     cmds.append("pc=0x%x" % CODE)
351:     if insns:
352:         cmds.append("step %d" % len(insns))
353:     cmds.append("reg")
354:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
355:     if cpu:
356:         argv += ["-C", cpu]
357:     argv += ["0x%x:%s" % (CODE, DUMMY)]
358:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
359:     try:
360:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
361:                            stderr=subprocess.STDOUT, timeout=timeout)
362:     except subprocess.TimeoutExpired as e:
363:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
364:         return {}, [], out, "TIMEOUT"
365:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
366:     rc = p.returncode
367:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
368:     # the LAST `reg' dump in the transcript
369:     idx = t.rfind("GXemul> reg")
370:     regs = {}
371:     if idx >= 0:
372:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
373:             regs[int(m.group(1))] = int(m.group(2), 16)
374:     dis = []
375:     di = t.find("GXemul> unassemble")
376:     if di >= 0:
377:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
378:                 else len(t)]
379:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
380:                              r"(?:\t(\S+))?", seg, re.M):
381:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
382:     return regs, dis, t, how
383: 
384: 
385: def seed(pairs):
386:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
