 162: # ---- ppcrldiclzero (#522) + #565: X(rldicl) wrote ZERO on every execution -- its 24-row detector --------
 163: # Shipped EXEMPT with e777ff06 (2026-09-10) and re-dated twice by owner ruling (2026-09-24 with the
 164: # other nine, then 04f3e7c0 on 2026-10-09) because no block here scored it; #565 discharges that
 165: # exemption.  BEFORE the NetBSD prerequisite for the reason the rlwimi block gives: `-E bareppc -M 64`
 166: # needs no image, so a red row is recorded first.  A stalled guest cannot hang the gate: the probe's
 167: # own subprocess backstops (90 s; 60 s for the bogus-machine and 32-bit sessions) turn it into
 168: # failing rows.  The probe prints no RESULT/CONTROL protocol, so it is scored as gate_arm.sh scores
 169: # mk48's: its completion sentinel, then EVERY row by name, then the run/green/red counts and its own
 170: # SCORE line, each pinned to a literal so a shrunk or renamed table cannot pass -- 30 checks when
 171: # green.  Names sit in a %-18s column and none is longer than 15, so `^name  ' cannot match a
 172: # neighbour (the padded-column trap).  The rows-run line is in the form check_score_claims.py pins.
 173: # CONTRACT: the block TRANSMITS the probe's verdicts and re-derives none -- each row's ok/FAIL and its
 174: # SCORE come from one comparison in the probe's row(), so an edit there (Grok 4.7's `ok = True', GPT-6
 175: # Astra's `>=', #565 pass 2) lets a mutant through, as it would through any block that scores only a
 176: # probe's ok/FAIL tokens (some gate_arm.sh blocks also pin a got= value; this one, like mk48's, does not).
 177: # The exit status is ignored on purpose: this probe exits 0 with failed rows (probeexitzero).
 178: # Floor (c), measured (regress/artifacts/ppcrldiclzero/gatewire_20261018/nullmedium/): an IDENTITY
 179: # BODY for X(rldicl) -- decode and retire, write nothing -- reds 11 of the 30 (identity/), and
 180: # /bin/true 22 of the 30.  An absent binary reds the sentinel check in this block's scoring text, but
 181: # in gate 13 need_exec turns it into a SKIP before any check.
 182: RLCLOG=$LOGDIR/ppc_rldicl.log
 183: python3 -u ppc_rldicl_probe.py "$PMAX" gate > "$RLCLOG" 2>&1 || true
 184: if [ "$(grep -cx 'PPC_RLDICL_PROBE_DONE' "$RLCLOG")" != 1 ]; then
 185:     note "ppc_rldicl: completion sentinel missing or duplicated; last lines follow"
 186:     tail -5 "$RLCLOG" | sed 's/^/       /'
 187:     check "ppc_rldicl probe completed" "no" "yes"
 188: else
 189:     check "ppc_rldicl probe completed" "yes" "yes"
 190:     for v in "session" "live" "seed holds" "src intact" "disasm xcheck" "zx32 rldicl" "zx32 rldicr" "rot8 rldicl" "rot8 rldicr" "naive fix wrong" "neg apparatus" "bits32 live" "bits32 rld bad" "vacuous cell" "vac neighbour" "census run" "census wrong" "census zero" "disasm total" "cand session" "cr parsed" "sh63 rldicl" "sh32 rldicl" "rc cr0"; do
 191:         check "ppc_rldicl row: $v" "$(count "$RLCLOG" "^$v  .*ok$")" "1"
 192:     done
 193:     rlcok=$(count "$RLCLOG" " ok$"); rlcbad=$(count "$RLCLOG" " FAIL$"); rlcrun=$((rlcok + rlcbad))
 194:     check "ppc_rldicl rows run"   "$rlcrun" 24
 195:     check "ppc_rldicl rows green" "$rlcok" 24
 196:     check "ppc_rldicl rows red"   "$rlcbad" 0
 197:     #  EVERY SCORE line is counted, then the one is read: counting only `SCORE 24/24' lines let an
 198:     #  appended contradictory `SCORE 0/24' pass (GPT-6 Astra, pass 1).
 199:     check "ppc_rldicl score lines"  "$(grep -c '^SCORE ' "$RLCLOG")" "1"
 200:     check "ppc_rldicl score 24/24"  "$(grep -c '^SCORE 24/24 ' "$RLCLOG")" "1"
 201: fi
 202: 
 203: need_file "$IMAGES/netbsd401-macppc-GENERIC"
 204: 
 205: note "binary : $PMAX"
 206: note "machine: macppc/G4, NetBSD kernel loaded so the machine constructs; never executed"
 207: note "cold debugger; big-endian (dump renders value order); msr=0x2000 required for FP"
 208: 
 209: python3 ppc_rounding_probe.py "$PMAX" "$IMAGES" > "$LOG" 2>&1 || true
 210: 
 211: if ! grep -q "PPC_CONV_RESULT=" "$LOG"; then
 212:     note "probe produced no result line; last lines follow"
 213:     tail -5 "$LOG" | sed 's/^/       /'
 214:     gate_skip "probe did not complete"
 215: fi
 216: 
 217: grep -E " ok$| FAIL$" "$LOG" | sed 's/^/       /'
 218: 
 219: # A probe whose control row failed has measured NOTHING, and no other row may be
 220: # believed -- this harness has been bitten by a probe that reported a defect off
 221: # sentinel reads while its guest code had never run.
 222: ctrl=$(grep -o "PPC_CONV_CONTROL=[A-Z]*" "$LOG" | tail -1 | cut -d= -f2)
 223: check "control rows prove the probe measures" "${ctrl:-missing}" "OK"
 224: 
 225: # The rounding-mode WRITE channel is proven once per mode, in its own sessions, by
 226: # reading FPSCR back through the guest's own mffs. Both numbers are asserted, because
 227: # "0 bad" is also what a probe reports when it never read FPSCR at all: the first
 228: # version parsed the debugger's plain `reg`, which does not print FPSCR on this CPU,
 229: # so the check passed vacuously on every run until a diff-review seat predicted the
 230: # hole and the rewrite measured it (43 rows of "unparsed").
 231: modebad=$(grep -o "PPC_CONV_MODEWRITES_BAD=[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
 232: modereads=$(grep -o "PPC_CONV_MODEREADS=[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
 233: check "every rounding-mode write took"    "${modebad:-missing}"   "0"
 234: check "all four modes read back by guest" "${modereads:-0}"       "4"
 235: 
 236: res=$(grep -o "PPC_CONV_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
 237: got=${res%/*}; want=${res#*/}
 238: check "rows run"     "$want" 138
 239: check "rows correct" "$got"  "$want"
 240: 
 241: # The table must keep enough of each class to be worth running: a gate whose rows are
 242: # all pins cannot detect a reverted fix, and one with no pins cannot detect collateral
 243: # damage. Both counts are asserted rather than trusted.
 244: disc=$(grep -c " DISC " "$LOG")
 245: pins=$(grep -c " PIN " "$LOG")
 246: # Both floors are set to the ACTUAL counts, not below them. They had drifted to 47/26
 247: # against real counts of 50/36, which means a whole class could have lost rows without
 248: # the floor noticing -- the same "a check that cannot fail" species this gate's header
 249: # warns about twice. The two numbers must also sum to the asserted `rows run` above
 250: # (94 + 44 = 138); if they stop summing, a row lost its class rather than the table
 251: # losing a row.
 252: # #335 added two DISC (fmadd/fmsub fusion) and one PIN (the 2by3+1 control that
 253: # proves the hand-assembled A-form register fields land where intended).
 254: check_min "discriminating rows present" "$disc" 94
 255: check_min "pinned rows present"         "$pins" 44
 256: 
 257: # The one row that records a divergence this round deliberately does NOT fix.
 258: div=$(grep -c " DIV " "$LOG")
 259: # #325 retired the one DIV row this gate carried: fctiwz of a NaN answered zero,
 260: # and now answers the most negative value the ISA owes. The count is asserted at
 261: # zero rather than the check being deleted -- a gate that stops counting a class
 262: # stops noticing when a member of it reappears.
 263: check "divergence rows recorded" "$div" 0
 264: 
 265: # Named rows, one per contract, so a single site reverting cannot hide behind a total.
 266: #
 267: # The pattern demands TWO spaces after the name, not one: the probe pads names to a
 268: # fixed column, so a name that is a PREFIX of another ("frsp qNaN" of "frsp qNaN
 269: # payload") matched both rows and the check counted 2 where it wanted 1. A check that
 270: # counts the wrong rows is the same species as a check that cannot fail -- it was
 271: # passing for the wrong reason the moment the table grew a longer name.
 272: for v in "frsp qNaN" "frsp sNaN" "frsp 1+3ulp/2 RZ" "frsp band RP" "frsp band- RM" \
 273:          "frsp tiny RP" "frsp 2^128 RZ" "frsp carry-up RZ" \
 274:          "stfs 2^-127" "stfs band tail" "stfs band-" "stfsx 2^-127" \
 275:          "stfs qNaN payload" "stfs sNaN passthrough" "stfsx qNaN payload" \
 276:          "lfs qNaN-" "composed frsp->stfs NaN" "lfsx qNaN-" "VXSNAN sticky" \
 277:          "fctiwz qNaN" "fctiwz -qNaN" "fctiwz 1.0 control" \
 278:          "fctiwz +Inf" "fctiwz -Inf" "fctiwz 2^31" "fctiwz -(2^31+1)" \
 279:          "fctiwz 1.9 RTZ" "fctiwz -1.9 RTZ" \
 280:          "VXISI fadd Inf-Inf" "VXIDI fdiv Inf/Inf" "VXZDZ fdiv 0/0" \
 281:          "VXIMZ fmul Inf-by-0" "ZX fdiv 1/0" "VXSNAN fadd sNaN" \
 282:          "VXSNAN fcmpu sNaN" "VXCVI fctiwz sNaN" "VXCVI fctiwz qNaN" \
 283:          "clean fadd qNaN" "clean fadd Inf+Inf" "clean fdiv Inf/0" \
 284:          "mtfsf FM=0xff" "mtfsf FM=0x80" "mtfsf FM=0x01" "mtfsf FM=0x0f" \
 285:          "mtfsf FM=0x40" "mtfsf clears" \
 286:          "VX falls on last clear" "VX rises on cause" \
 287:          "FEX rises on enable" "FEX falls with its cause" \
 288:          "FEX order: enable first" "FEX order: cause first" \
 289:          "FX latches once only" \
 290:          "lfsu value" "lfsu updates r3" "lfdu value" "lfdu updates r3" \
