 146: rlddone=$(grep -c '^PPC_RLDIMI_PROBE_DONE' "$RLDLOG")
 147: if [ "$rldres" = 1 ] && [ "$rldresok" = 1 ] && [ "$rldctl" = 1 ] && [ "$rldctlok" = 1 ] &&
 148:    [ "$rlddone" = 1 ] && grep -qx 'PPC_RLDIMI_PROBE_DONE' "$RLDLOG"; then
