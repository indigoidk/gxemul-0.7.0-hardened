1: """#536 edit to check_probe_wiring.py, applied identically to the HEAD-based staged blob and to the
2: working tree (which also carries #529's uncommitted MANIFEST hunk, not ours to ship).
3: 
4:   1. drop the EXEMPT entries of the two probes #536 wires into gate_arm.sh;
5:   2. re-date every remaining 2026-09-20 entry to 2026-09-27 (owner ruling 2026-09-18: wire 2,
6:      re-date 11);
7:   3. derive the selftest's M5a/M5b dates from the table instead of the literals 2026-09-19 and
8:      2026-09-21 -- which bracketed the old block and would turn M5b GREEN (and the selftest red)
9:      the moment the block moved.
10: 
11: Usage: python apply536_exempt.py <path-to-check_probe_wiring.py>.  Refuses unless it finds exactly
12: what it expects, and is NOT idempotent on purpose: a second run fails on step 1."""
13: import io, re, sys
14: 
15: p = sys.argv[1]
16: s = io.open(p, encoding="utf-8", newline="").read()
17: 
18: # ---- 1 + 2: the EXEMPT table -------------------------------------------------------------
19: i = s.index("EXEMPT = {"); j = s.index("\n}", i)
20: blk = s[i:j]
21: for name in ("mk48_nvram_probe.py", "hpcmips_ctor_probe.py"):
22:     m = re.search(r'\n    "%s":\s*\("2026-09-20",\n(?:\s+"[^\n]*\n)*?\s+"[^\n]*"\),' % re.escape(name), blk)
23:     if not m:
24:         m = re.search(r'\n    "%s":\s*\("2026-09-20",[^\n]*\),' % re.escape(name), blk)
25:     assert m, "entry not found: " + name
26:     blk = blk.replace(m.group(0), "", 1)
27: n = blk.count('("2026-09-20"')
28: assert n == 11, "expected 11 remaining 2026-09-20 entries, found %d" % n
29: blk = blk.replace('("2026-09-20"', '("2026-09-27"')
30: s = s[:i] + blk + s[j:]
31: 
32: # ---- 3: the selftest's M5a/M5b dates -----------------------------------------------------
33: OLD = (
34:     '    rg, chk = fresh()\n'
35:     '    case("M5a a live exemption is GREEN the day before", 0, "PROBEWIRING_PASS", chk, rg,\n'
36:     '         extra=("--today", "2026-09-19"))\n'
37:     '    case("M5b the same tree is RED the day after", 1, "EXPIRED EXEMPTION", chk, rg,\n'
38:     '         extra=("--today", "2026-09-21"))\n'
39: )
40: NEW = (
41:     '    #  #536: THE TWO DAYS ARE DERIVED FROM THE TABLE, NEVER LITERALS.  They were 2026-09-19 and\n'
42:     '    #  2026-09-21, the days either side of the block every dated exemption then shared -- so\n'
43:     '    #  the day that block was re-dated, M5b would have run on a tree with nothing expired, gone\n'
44:     '    #  GREEN, and failed the selftest.  The frozen-claim-about-a-table-designed-to-change that\n'
45:     '    #  _pick_exempt_detector() refuses for M1-M3, earlier in this selftest.  The\n'
46:     '    #  comparison is `d < today`, so an exemption is valid ON its stamped date: the earliest\n'
47:     '    #  DETECTOR date ITSELF is green and the day after is red.  M5a runs ON the date, not the\n'
48:     '    #  day before, because that is the one day on which `<` and `<=` differ: with `d <= today`\n'
49:     '    #  both day-before and day-after cases passed (codex, #536 pass 2, executed; Opus measured\n'
50:     '    #  22/22 -> 21/22 once M5a moved).  The day-before case\'s only UNIQUE kill was `!=` (M5b\n'
51:     '    #  still reds `>` and `>=`), and `!=` expires every exemption on every day except its\n'
52:     '    #  stamped date, so it cannot stay quiet in production -- and M0 and M2b, which read the\n'
53:     '    #  real clock, still catch it on any other day.  No dated detector exemption left is two\n'
54:     '    #  FAILS, never a skip -- the denominator must not shrink.\n'
55:     '    _m5 = sorted(EXEMPT[_n][0] for _n in EXEMPT\n'
56:     '                 if MANIFEST.get(_n, (None,))[0] == CLASS_DETECTOR\n'
57:     '                 and DATE_RE.match(EXEMPT[_n][0] or ""))\n'
58:     '    if not _m5:\n'
59:     '        results.extend([False, False])\n'
60:     '        print("  FAIL  M5a/M5b -- no well-formed dated DETECTOR exemption to derive the days from.")\n'
61:     '    else:\n'
62:     '        import datetime as _dt5\n'
63:     '        _d5 = _dt5.date.fromisoformat(_m5[0])\n'
64:     '        rg, chk = fresh()\n'
65:     '        case("M5a a live exemption is GREEN ON its stamped date", 0, "PROBEWIRING_PASS", chk, rg,\n'
66:     '             extra=("--today", _d5.isoformat()))\n'
67:     '        case("M5b the same tree is RED the day after", 1, "EXPIRED EXEMPTION", chk, rg,\n'
68:     '             extra=("--today", (_d5 + _dt5.timedelta(days=1)).isoformat()))\n'
69: )
70: k = s.count(OLD)
71: assert k == 1, "M5a/M5b block found %d times (want 1)" % k
72: s = s.replace(OLD, NEW)
73: 
