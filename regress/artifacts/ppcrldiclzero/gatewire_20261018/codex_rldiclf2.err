287: # -------------------------------------------------------------------- encodings
288: def enc_md(xo, rs, ra, sh, mbe, rc=0):
289:     """opcode 30 (rldicl/rldicr/rldimi).  Field placement derived from the manual's
290:        own instruction-format diagram at :29706-29734:
291:          0-5 opcode | 6-10 S | 11-15 A | 16-20 sh[0-4] | 21-26 mb[5]||mb[0-4]
292:          | 27-29 XO | 30 sh[5] | 31 Rc      (all big-endian bit numbers)"""
293:     assert 0 <= sh <= 63 and 0 <= mbe <= 63 and 0 <= xo <= 7
294:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
295:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
296:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
297: 
298: 
299: def RLDICL(ra, rs, sh, mb):
300:     return enc_md(0, rs, ra, sh, mb)
301: 
302: 
303: def RLDICR(ra, rs, sh, me):
304:     return enc_md(1, rs, ra, sh, me)
305: 
306: 
307: def RLDIMI(ra, rs, sh, mb):
308:     return enc_md(3, rs, ra, sh, mb)
309: 
310: 
311: def enc_m(op, rs, ra, sh, mb, me, rc=0):
312:     """opcode 20/21 (rlwimi/rlwinm): 0-5 op | 6-10 S | 11-15 A | 16-20 SH
313:        | 21-25 MB | 26-30 ME | 31 Rc."""
314:     return ((op << 26) | (rs << 21) | (ra << 16) | (sh << 11) | (mb << 6)
315:             | (me << 1) | rc) & 0xFFFFFFFF
316: 
317: 
318: def RLWINM(ra, rs, sh, mb, me):
319:     return enc_m(21, rs, ra, sh, mb, me)
320: 
321: 
322: def RLWIMI(ra, rs, sh, mb, me):
323:     return enc_m(20, rs, ra, sh, mb, me)
324: 
325: 
326: def LI(rd, simm):
327:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
328: 
329: 
330: def ORI(ra, rs, imm):
331:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
332: 
333: 
334: NOP = ORI(0, 0, 0)               # ori r0,r0,0 -- writes r0 only
