337: # ---------------------------------------------------------------------- sessions
338: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
339:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs.
340:        Returns (regs dict, disasm list, transcript, how)."""
341:     cmds = list(setup)
342:     for i, w in enumerate(insns):
343:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
344:     if insns:
345:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
346:     cmds.append("pc=0x%x" % CODE)
347:     if insns:
348:         cmds.append("step %d" % len(insns))
349:     cmds.append("reg")
350:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
351:     if cpu:
352:         argv += ["-C", cpu]
353:     argv += ["0x%x:%s" % (CODE, DUMMY)]
354:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
355:     try:
356:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
357:                            stderr=subprocess.STDOUT, timeout=timeout)
358:     except subprocess.TimeoutExpired as e:
359:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
360:         return {}, [], out, "TIMEOUT"
361:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
362:     rc = p.returncode
363:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
364:     # the LAST `reg' dump in the transcript
365:     idx = t.rfind("GXemul> reg")
366:     regs = {}
367:     if idx >= 0:
368:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
369:             regs[int(m.group(1))] = int(m.group(2), 16)
370:     dis = []
371:     di = t.find("GXemul> unassemble")
372:     if di >= 0:
373:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
374:                 else len(t)]
375:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
376:                              r"(?:\t(\S+))?", seg, re.M):
377:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
378:     return regs, dis, t, how
379: 
380: 
381: def seed(pairs):
382:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
