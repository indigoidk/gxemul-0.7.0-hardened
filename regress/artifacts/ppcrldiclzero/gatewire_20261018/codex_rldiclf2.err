"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "Get-Content -LiteralPath 'regress/artifacts/ppcrldiclzero/gatewire_20261018/brief_p2_body.md'" in C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC
