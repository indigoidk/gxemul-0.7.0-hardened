#!/bin/bash
# Shared helpers for the regression gates.
#
# Two rules encoded here, both learned by getting them wrong:
#
#  1. RUN UNBUFFERED. When gxemul's stdout is a pipe, libc switches to 4 KB block
#     buffering. `timeout` then kills it with SIGTERM and the partial block is lost, so a
#     guest that produced 3 KB of perfectly good boot output scores ZERO bytes while one
#     that produced 5 KB scores 4096. An early version of this harness compared those
#     numbers across builds and "found" a capability regression that was pure buffering.
#     Every emulator invocation goes through run_emu() or run_emu_progress(), both of which
#     force stdbuf -o0 -e0.  (#419 note: run_emu() itself now has NO CALLERS -- gate 7 was
#     its last one.  It is kept because the rule is general and a future gate will want the
#     simple form, but do not cite it as the universal path: run_emu_progress() is.)
#
#  2. A MISSING INPUT IS A HARD ERROR, NEVER A ZERO SCORE. The same early version had no
#     existence check on the baseline binaries, so a wrong path looked exactly like a
#     total behavioural failure. need_file() aborts the gate instead.
#
# Verdicts are PASS / FAIL / SKIP. A SKIP is never counted as a PASS.

ROOT=${ROOT:-/mnt/c/DocumentNoSnc/CC/GXEMUL}
IMAGES=$ROOT/_images
LOGDIR=${LOGDIR:-/tmp/gxregress}
#  d1: EXPORT, or the driver cannot see it.  A plain assignment here reaches the gates'
#  own shell redirections but NOT a python child, so drive_guest.py kept writing its two
#  pty logs to the hardcoded default while every other artefact relocated -- a mutation
#  census then poisoned the shared logs gate 6 grades.  Measured: without this line a
#  caller who writes `LOGDIR=x ./run.sh` propagates (env-prefixed vars are exported) but a
#  caller who writes `LOGDIR=x; ./run.sh` does not, so the defect was CONDITIONALLY silent.
export LOGDIR
mkdir -p "$LOGDIR"

#  #426: classify a rig's reported budget.  IT LIVES HERE, NOT IN THE GATE, so the branch
#  logic can be exercised offline by a selftest instead of only under a weekly rig boot.
#  Echoes ONE DISTINGUISHABLE TOKEN per case:
#    absent      the rig deliberately has no budget (landisk: its count nearly halves under
#                host load, so any ceiling would be invented rather than measured)
#    calibrated  a value inside the range measured for that rig
#    zeroed      ZERO ON A RIG THAT IS CALIBRATED -- the case that used to print a green
#                "deliberately absent".  MEASURED: a luna88k run reporting BUDGET=0 passed
#                11/11 while the row said something false about a 12 G rig, and the driver's
#                own ceiling went falsy at the same time.  RED, not a skip: the gate HOLDS the
#                calibration, so a skip would claim an ignorance it does not have.
#    out-of-range / unreported  as they say.
budget_class() {
    #  ${2-} because every gate here runs under `set -u`, where a one-argument call would
    #  abort the gate with "$2: unbound variable" instead of classifying.  A classifier that
    #  kills its caller on a malformed call is worse than one that says `unreported`.
    case "${1-}:${2-}" in
    landisk:0)   echo absent ;;
    luna88k:0)   echo zeroed ;;
    *:)          echo unreported ;;
    luna88k:*)   if [ "$2" -ge 8174849291 ] 2>/dev/null && [ "$2" -le 15571141508 ]
                 then echo calibrated; else echo out-of-range; fi ;;
    *:0)         echo absent ;;
    *)           echo uncalibrated-rig ;;
    esac
}

C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_SKIP=$'\033[33m'; C_OFF=$'\033[0m'
[ -t 1 ] || { C_OK=""; C_BAD=""; C_SKIP=""; C_OFF=""; }

# Exit codes. SKIP is 77, NOT 2, because bash exits 2 on a SYNTAX ERROR -- so with 2 as
# the skip code a typo in any gate was silently downgraded to "coverage gap" and run.sh
# still exited 0. Anything non-zero that is not 77 is a failure.
EXIT_SKIP=77

GATE_NAME=""
_fails=0
_checks=0

gate_begin() { GATE_NAME=$1; _fails=0; _checks=0
    echo "############################################################"
    echo "## GATE: $GATE_NAME"
    echo "############################################################"
}

# check <description> <actual> <expected>
check() {
    _checks=$((_checks+1))
    if [ "$2" = "$3" ]; then
        printf "  ${C_OK}ok${C_OFF}   %-52s %s\n" "$1" "$2"
    else
        printf "  ${C_BAD}FAIL${C_OFF} %-52s got=%s want=%s\n" "$1" "$2" "$3"
        _fails=$((_fails+1))
    fi
}

# check_min <description> <actual> <minimum>
check_min() {
    _checks=$((_checks+1))
    if [ "$2" -ge "$3" ] 2>/dev/null; then
        printf "  ${C_OK}ok${C_OFF}   %-52s %s (>= %s)\n" "$1" "$2" "$3"
    else
        printf "  ${C_BAD}FAIL${C_OFF} %-52s got=%s want>=%s\n" "$1" "$2" "$3"
        _fails=$((_fails+1))
    fi
}

note() { printf "  --   %s\n" "$*"; }

# A gate may declare that part of its coverage did not run (a rig whose image is absent,
# say). That must not be absorbed into a PASS: it downgrades the whole gate to SKIP, so a
# missing input can never be reported as evidence of correctness.
_degraded=0
degrade() { _degraded=1; printf "  ${C_SKIP}skip${C_OFF} %s\n" "$*"; }

gate_end() {
    echo
    if [ "$_checks" = 0 ]; then
        echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} (no checks ran)"; return $EXIT_SKIP
    elif [ "$_fails" != 0 ]; then
        echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks)"; return 1
    elif [ "$_degraded" != 0 ]; then
        echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} ($_checks checks passed, but part of the gate could not run)"
        return $EXIT_SKIP
    else
        echo "${C_OK}$GATE_NAME: PASS${C_OFF} ($_checks checks)"; return 0
    fi
}

#  #371: gate_skip() exits with the SKIP code, which run.sh maps to
#  REGRESS_PASS_WITH_GAPS -- a green-ish verdict. It never consulted the running
#  failure counter, so a gate that had ALREADY recorded red checks and then hit a
#  gate_skip (a probe that produced no result line, a missing rig image) reported
#  those reds as a skip and they vanished from the battery. Measured on a
#  synthetic gate: one FAIL then gate_skip exited 77, PASS_WITH_GAPS. This is the
#  same "a green row means nothing" class the gate rows themselves guard against,
#  in the harness's own control flow.
#
#  So a gate_skip AFTER failures is a FAIL, not a skip: the skip cannot un-record
#  what already failed. A gate_skip with a clean slate stays a genuine skip (a
#  preflight that could not run at all -- need_file/need_exec). degrade() was
#  already correct: gate_end() tests _fails before _degraded, so a degraded gate
#  with recorded failures already reports FAIL. Nothing there to change.
gate_skip() {
    echo
    if [ "${_fails:-0}" != 0 ]; then
        echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks failed" \
             "before this section could not run: $*)"
        exit 1
    fi
    echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} -- $*"; exit $EXIT_SKIP
}

need_file() {
    for f in "$@"; do
        [ -e "$f" ] || gate_skip "missing required input: $f"
    done
}

need_exec() {
    for f in "$@"; do
        [ -x "$f" ] || gate_skip "missing or non-executable binary: $f"
    done
}

# run_emu <seconds> <logfile> <binary> [args...]
# Always unbuffered, always with stdin closed so a guest prompt cannot wedge the run.
run_emu() {
    local secs=$1 log=$2; shift 2
    ( cd "$IMAGES" 2>/dev/null || cd /; timeout "$secs" stdbuf -o0 -e0 "$@" </dev/null ) \
        > "$log" 2>&1
    return 0
}

# run_emu_progress <backstop_s> <budget_instrs> <stall_s> <marker_re> <logfile> <binary> [args...]
#
# #419: run_emu()'s wall-clock budget is a LOAD-SENSITIVE ORACLE. Under host load the guest
# makes less progress in the same seconds, the marker never appears, and the row FAILs
# INDISTINGUISHABLY FROM A REAL CAPABILITY REGRESSION -- measured twice, from panel seats and
# from interactive greps. This runs the emulator against a budget of GUEST WORK instead, and
# -- the part that actually fixes the defect -- it REPORTS WHY IT STOPPED.
#
# Echoes one line: "reason=<MARKER|BUDGET|STALLED|BACKSTOP|EXITED|ABSENT> ninstrs=<N> wall=<S>"
#
#   MARKER    the regex matched. Stop AT ONCE: today's run burns its whole budget AFTER
#             login because the guest never exits, so this is also where the speed-up is.
#   BUDGET    the guest executed <budget_instrs> and still never matched. It was given a full
#             allowance of WORK, not of host seconds, so LOAD CANNOT EXPLAIN IT -> the caller
#             may score it FAIL with confidence.
#   STALLED   no instruction progress for <stall_s>. A slow host still executes instructions;
#             a WEDGED guest does not. Not universal -- a BUSY-LOOP hang executes for ever and
#             keeps emitting records, so this detects a wedge, not every hang. It is what makes
#             a wedged boot DISTINGUISHABLE from load,
#             and it is upstream 0.7.0's exact signature on luna88k.
#   BACKSTOP  wall clock expired while instructions were still advancing. The only genuinely
#             load-ambiguous outcome, and the only one a caller may treat as inconclusive.
#   EXITED    the emulator ended under its own power -- exited or crashed -- rather than
#!/usr/bin/env python3
"""ppcrldiclzero -- RUNG-3 WITNESS for X(rldicl) writing zero on every execution.

DEFECT.  src/cpus/cpu_ppc_instr.c, X(rldicl):

        uint64_t tmp = cpu->cd.ppc.gpr[rs], tmp2;
        while (sh-- != 0) { ... }              /*  rotate, into tmp        */
        tmp2 = 0;
        while (mb <= 63) {
                tmp |= ((uint64_t)1 << (63-mb));   /*  <-- tmp, not tmp2   */
                mb ++;
        }
        cpu->cd.ppc.gpr[ra] = tmp & tmp2;          /*  tmp2 is still 0     */

TWO TOKENS ARE WRONG, NOT ONE, and only the second is observable today:
  (1) the mask is ORed into `tmp' -- the ROTATED VALUE -- rather than into `tmp2',
      so the rotated data is destroyed by having the mask bits forced to 1;
  (2) `tmp2' is therefore never assigned after `= 0', so the AND yields 0.
Defect (2) hides defect (1).  The single-character repair `tmp |=' -> `tmp2 |='
fixes both at once.  TWO tempting edits are measured wrong, and they are wrong
DIFFERENTLY -- a distinction an earlier draft of this paragraph got wrong, and a
pass-2 seat caught it still standing here after the product comment was corrected:
  * replacing the `&' with `|' ships ROTL64(rS,SH) | MASK(MB,63), an OR where the
    architecture says AND -- 126 of 190 cells wrong.  That is the M_NAIVE leg.
  * deleting the `& tmp2' outright, ON THE FIXED CODE, ships ROTL64 ALONE with the
    mask IGNORED, measured as M_NOMASK -- 16/19 on the 19-row instrument (the pass-2
    seat: artifacts/ppcrldiclzero/pass2_20260910/opus_nomask.log) and 19/24 on the
    24 rows it carries now (killtable_20260910/t2/probe_M_NOMASK.raw).  (Before the fix
    it would have shipped the OR, because the mask was in `tmp'; witness_naive.out
    measured THAT function, not this one.)
*** THE `naive fix' ROW BELOW IS AN ARITHMETIC IDENTITY OVER THIS FILE'S OWN
CONSTANTS AND CANNOT FAIL UNDER ANY MUTATION OF THE EMULATOR. ***  It never touches
the binary, the registers or any session, and it is green in every leg of every table
run so far.  An earlier draft of this line said it 'exists to make that statement
measurable rather than argued'; it does not, and a pass-2 seat named it as the
check-that-cannot-fail shape sitting inside a detector whose whole purpose is to be
failable.  **THE M_NAIVE KILL-TABLE LEG is what makes the claim measurable.**  The row
is CARRIED-NOT-COUNTED, the disposition already used for `vacuous cell'.

ARCHITECTURE, read locally -- _scratchpad/ppc_pem_32and64_2005.txt:29736 (rldiclx):
        n <- sh[5] || sh[0-4]
        r <- ROTL[64](rS, n)
        b <- mb[5] || mb[0-4]
        m <- MASK(b, 63)
        rA <- r & m
and the prose at :29737 -- "A mask is generated having 1 bits from bit MB through
bit 63 and 0 bits elsewhere.  The rotated data is ANDed with the generated mask".
IBM bit numbering is big-endian, so MASK(b,63) is the LOW (64-b) bits: for b=32
that is 0x00000000ffffffff, which is why `rldicl rA,rS,0,32' is the canonical
32-bit zero-extend (`clrldi rA,rS,32', manual :29758).
EVERY `want' in this probe is computed from those five lines, never from the tree.

RUNG 3: real PowerPC instructions fetched from guest RAM, decoded by the real
decoder and executed by the real handler, on the UNMODIFIED in-tree `-E bareppc'.
No machine description edited, no device_add, no CPU model override -- bareppc's
own MACHINE_DEFAULT_CPU is PPC970, which is 64-bit in the in-tree CPU table, and
64-bit is what the decoder requires (`if (cpu->cd.ppc.bits == 32) goto bad').

THE ORACLE is a guest-visible wrong VALUE, not a process death, so it is read
directly out of the destination register.  Four controls:
  live          `li r9,0x1234' in the same session reads back 0x1234 -- the guest
                really executes and the readback path really works.
  seed holds    a destination register seeded with a sentinel and then stepped
                over a NON-WRITING instruction still holds the sentinel.  This is
                the control that makes a zero readback attributable: it proves 0
                means "rldicl wrote 0", not "nothing ever wrote this register".
  neg apparatus a bogus machine name must turn `live' RED.  Without this, `live'
                is a check that cannot fail.
  disasm xcheck every instruction word placed is disassembled by the tree's own
                disassembler (cpu_ppc.c, a DIFFERENT code path from the execute
                handler in cpu_ppc_instr.c) and compared against the operands the
                encoder intended.  Guards the hand-assembled-encoding trap.
  rldicr        the correctly-written sibling, same rotate-and-mask shape, same
                session -- attributes the failure to X(rldicl) rather than to the
                encoding, the machine, the rotate or this program.

TEST-FIRST SHAPE: every `want' is the ARCHITECTURAL value.  On the committed
pre-fix build the rldicl rows are RED; after `tmp |=' -> `tmp2 |=' the identical
script goes green.

Sentinel: PPC_RLDICL_PROBE_DONE
"""

import re
import subprocess
import sys
import time

if len(sys.argv) < 2:
    sys.stderr.write("usage: ppc_rldicl_witness.py <gxemul> [label]\n")
    sys.exit(2)

BIN = sys.argv[1]
LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
DUMMY = "/tmp/ppc_rldicl_dummy.bin"
open(DUMMY, "wb").write(b"\x00\x00\x00\x00")

CODE = 0x10000
M64 = (1 << 64) - 1
SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into every destination
RS_ONES = M64                    # census source: makes EVERY cell non-vacuous
RS_VAL = 0xDEADBEEFCAFEF00D      # value source: exercises the rotate too
SRC = 3                          # rS is always r3; r3 is never a destination
DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session

rows = []


def row(name, got, want, note=""):
    assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
    assert len(name) <= 17, name
    ok = (got == want)
    rows.append((name, ok))
    print("%-18s %-20s %-20s %-48s %s" % (name, str(got), str(want), note,
                                          "ok" if ok else "FAIL"))
    return ok


# ----------------------------------------------------------------- architecture
def rotl64(x, n):
    n &= 63
    return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64


def mask_b_63(b):
    """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
    assert 0 <= b <= 63
    return (1 << (64 - b)) - 1


def mask_0_e(e):
    """MASK(0,e), big-endian = the high (e+1) bits."""
    assert 0 <= e <= 63
    return (((1 << (e + 1)) - 1) << (63 - e)) & M64


def mask_range(b, e):
    """MASK(b,e) -- the architecture's own mask generator, INCLUSIVE and WRAPPING.

       PowerPC Book I v2.01, _scratchpad/ppc_uisa_book1_v201.txt:
         :578     "Mask having 1s in positions x through y (WRAPPING IF x > y)"
         :4015    "The mask is 64 bits long"
         :4022-29  if mstart <= mstop: mask[mstart..mstop] = ones
                   else:               mask[mstart..63] = ones ; mask[0..mstop] = ones
         :4031    "There is no way to specify an all-zero mask."   <-- the assert below

       *** THE WRAPPING BRANCH IS A UNION.  An INTERSECTION is EMPTY whenever b > e,
       which is exactly the all-zero mask :4031 says cannot exist -- and that was this
       file's want_rldimi for 2016 of 4096 (MB, SH) pairs.  See
       regress/artifacts/ppcwitnessmaskoracle/ENUMERATION_20260911.txt. ***"""
    assert 0 <= b <= 63 and 0 <= e <= 63
    m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
    assert m != 0, "MASK(%d,%d) came out all-zero, which the architecture forbids" % (b, e)
    #  *** THIS ASSERT IS DEAD, AND SAYING SO IS THE POINT.  Found by the glm seat, 2026-09-17,
    #  and verified: the assert above already constrains b, e to [0, 63], so the b <= e branch
    #  covers at least bit b and the wrapping branch covers at least bits b..63 AND 0..e.  Neither
    #  can produce zero, so this can never fire.
    #
    #  KEPT rather than deleted because it CARRIES A CITATION -- Book I :4031, "There is no way to
    #  specify an all-zero mask" -- and a future edit that widens the domain above would make it
    #  live again.  **But an assert that cannot fire is a check-that-cannot-fail, and this project
    #  files those as defects when they are passed off as guards.**  It is annotated as DEAD so no
    #  reader mistakes it for one.
    return m


#  *** CONTRACT, 2026-10-09 (owner ruling on Fable 5.1's 7n-3; GPT-6 Astra confirmed): NO ROW IN THIS FILE
#  CONSUMES want_rldimi, mask32, want_rlwinm OR want_rlwimi.  Every row calls want_rldicl / want_rldicr, which the
#  oracle repair below leaves unchanged -- re-derived over every (SH, MB) and (SH, ME) at four sources, with the
#  enumeration of the repaired helpers, in regress/artifacts/ppcwitnessmaskoracle/enumcheck_20261009.out.  The
#  repaired helpers stay here as the Book I definitions (this mask32 is now the same form as
#  regress/ppc_rlwimi_probe.py's), and they owe nothing until a row is wired to them: the oracle-correction bound
#  is one measured red per oracle a ROW consumes.  The red for rlwinm/rlwnm on committed HEAD is
#  regress/artifacts/ppcrlwhighhalf/witness_committed_20261009/. ***


def want_rldicl(rs_val, sh, mb):
    return rotl64(rs_val, sh) & mask_b_63(mb)


def want_rldicr(rs_val, sh, me):
    return rotl64(rs_val, sh) & mask_0_e(me)


def want_rldimi(rs_val, ra_val, sh, mb):
    """Book I :4319 -- m <- MASK(b, not n), i.e. MASK(MB, 63-SH): INCLUSIVE and WRAPPING.

       *** CORRECTED 2026-09-11.  This computed `mask_b_63(mb) & mask_0_e(63-sh)' -- the
       INTERSECTION -- which is EMPTY for every wrapping encoding: 2016 of 4096 (MB, SH)
       pairs, 49.2% of the space, produced the all-zero mask Book I :4031 forbids.  The
       oracle then returned the untouched destination and would have AGREED with any
       implementation that also omitted the wrap. ***

       The prose at :4323-4324 ("1 bits from bit MB through bit 63-SH") describes the
       NON-WRAPPING reading, and quoting it beside the formula is how the error got in;
       :4022-4029 is the definition that governs.  The PEM citation the old docstring
       carried (:29908) is superseded: PEM :302 names Book I as the defining manual."""
    m = mask_range(mb, (63 - sh) & 63)
    return (rotl64(rs_val, sh) & m) | (ra_val & (~m & M64))


def rotl32(x, n):
    """ROTL[32] per manual :6878 -- two copies of rS[32-63], then rotate."""
    lo = x & 0xFFFFFFFF
    n &= 31
    r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
    return (r32 << 32) | r32


def mask32(mb, me):
    """MASK(MB+32, ME+32) at SIXTY-FOUR bits -- NOT confined to the low word.

       *** CORRECTED 2026-09-11.  This was a low-32-confined loop, so want_rlwinm ANDed
       away the duplication rotl32 correctly produces, and want_rlwimi preserved ALL of
       [*** SENTENCE TRUNCATED.  The rest of this 2026-09-11 clause was lost when the
       correction block below was inserted AT A LINE BOUNDARY rather than a sentence
       boundary.  Found by the Opus 5 seat 2026-09-17, which found the SAME habit in
       mvme_pcctworeg.h in the same working set.  THE MISSING WORDS ARE NOT
       RECONSTRUCTED HERE -- inventing them would be the wrong repair in a file whose
       whole method is `quote what you refute', and the surviving fragment is the CLAIM
       BEING CORRECTED, cut off before it says what was wrong.  [2026-10-09: this note
       said to recover it with `git show' on the 2026-09-11 revision -- FALSE, that
       revision was never committed.  The clause survives verbatim in the brief that
       inlined the 2026-09-17 diff (_scratchpad/grokpush_20260917/BRIEF_ppcmask.md,
       lines 131-135); after "preserved ALL of" it read: <<RA's high half.  Measured
       against the SHIPPED X(rlwinm), the old helper agreed on 131072 of 131072 cells
       -- not "usually green" but INCAPABLE of red, against a defect this project has
       filed as ppcrlwhighhalf. ***>>  Its `Measured' is the claim corrected below.] ***]
       *** CORRECTED 2026-09-17 by the grok seat, which went and READ the artifact. ***
       An earlier wording here said this was "Measured against the SHIPPED X(rlwinm)" on
       "131072 of 131072 cells".  **THE WORD `Measured' IS NOT SUPPORTED BY THE ARTIFACT.**
       `artifacts/ppcwitnessmaskoracle/ENUMERATION_20260911.txt' contains ZERO occurrences of
       131072, and says of itself at :49: "it is a MODEL enumeration, not an emulator
       measurement.  No binary was built".  The identity is ALGEBRA -- the old `mask32' simply
       IS the shipped handler's mask-and-zero-extend, so the two agree by construction, for
       every source and not merely for 2^17 encodings.
       *** THE REPAIR IS STILL WARRANTED, AND BY A STRONGER ARGUMENT THAN THE NUMBER WAS. ***
       It is warranted by that IDENTITY WITH THE SHIPPED HANDLER -- an oracle that is a copy of
       the implementation it grades cannot go red against it, which is this project's
       check-that-cannot-fail shape in its purest form.  A count of agreeing cells was never the
       reason and, stated as a measurement, was a WRONG RECORD of the score-claim class: a number
       in a measured column that no run produced.

       Book I gives rlwinm at :4126-4128 and rlwimi at :4316-4318 with the IDENTICAL mask
       term, and ROTL32 (:501-504) produces the low word DUPLICATED into both halves.
       MB, ME are 5-bit, so mstart/mstop lie in 32..63; when MB > ME the mask covers
       MB+32..63 AND 0..ME+32, and that second range contains every position 0..31 -- the
       whole high half -- so the rotated word lands there.

       *** :4033-4035 IS NOT A COUNTER-TEXT, THOUGH IT READS LIKE ONE. ***  It says the
       mask "start and stop POSITIONS are always in the low-order 32 bits" -- true, they
       are 32..63 -- and says nothing about where the 1-bits reach.  :4015 says the mask
       is 64 bits long and :4026-4028 gives the wrap explicitly.

       BOOK I'S CLEARING SENTENCES ARE SCOPED; THE PEM'S IS UNCONDITIONAL.  Book I has
       TWO, at :4195-4196 (rlwinm) and :4291-4292 (rlwnm), each inside a Programming Note
       and each qualified "for all the uses given above" -- and every enumerated use fixes
       a NON-WRAPPING (MB, ME).  The 2005 PEM carries the qualified form at :30074 AND an
       unconditional one at :30065; it is the unconditional claim that Book I lacks.
       **Book I states no clearing for rlwimi at all** -- its entry (:4304-4358) is RTL only.

