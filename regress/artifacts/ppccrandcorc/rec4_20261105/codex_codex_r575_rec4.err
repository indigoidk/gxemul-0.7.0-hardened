359| # ================================= ROUND-3 WHOLE-CR ROWS: the read-mask constant, the set literal (pass 3, codex B1-B4) ==
360| #  Derived by simulation (regress/artifacts/ppccrandcorc/r3_20261105/CLOSURE3.md, v575c.py).  Each row compares the WHOLE CR
361| #  (the register dump, which must agree with mfcr r10) with the architectural CR, so a SET of any extra bit is seen -- a row
362| #  that checks only its destination cannot see one (codex B3-B4).  A read `(cr >> (31-x)) & m' with x = 31 shifts by 0, so
363| #  `& m' reads CR & m: one row with CR[0..30] = 1 (but the pre-set) sees EVERY mask m with a bit above bit 0 at that site.
364| #    64 crorc baread:   crorc 17,31,5 over 0xfffffffe: a = CR[31] = 0, b = CR[5] = 1 -> 0; CR[17] pre-set 1 (inverse).  Any BA
365| #                       read mask with a bit in 1..31 reads nonzero and gives 1 (B2's & 0x8001 reads CR[16] = 1 here, which
366| #                       `64 crorc bamask' holds at 0); every BA field mask 0..30, mask 16 included, reads CR[m] = 1 -> 1.
367| #    64 crorc bbread:   crorc 30,30,31 over 0xfffffffc: a = CR[30] = 0, b = CR[31] = 0 -> 1 at CR[30] (pre-set 0, inverse, and
368| #                       the a = 0 source at once).  Any BB read mask with a bit in 2..31 reads nonzero, !bb = 0 -> 0 (B1, k =
369| #                       2..31); bit 1 (& 3, & 7) is red on `64 crorc 00', whose BB = 2 read is 2.
370| #    64 crandc setbits: crandc 31,30,31 over 0x00000002: a = CR[30] = 1, b = CR[31] = 0 -> 1 at CR[31]; the set shifts by 0,
371| #                       so a literal 1+2^k also sets CR[31-k], a zero for k = 2..31 (B3); k = 1 lands on the source CR[30] = 1
372| #                       and is red on `64 crandc 01' (crandc 10,1,0 re-sets CR[9]).
373| #    64 crorc setbits:  crorc 31,0,31 over 0: a = b = 0 -> 1 at CR[31]; a literal 1+2^k sets CR[31-k], a zero for every k (B4).
374| def cr_row(name, op, bt, ba, bb, seed, want_cr, note):
375|     cregs, _, _, chow = session(seed, [XL(op, bt, ba, bb), MFCR(10)])
376|     ccr, cmf = cregs.get("cr", -1), cregs.get(10, -1)
377|     if chow != "exit0" or ccr < 0:
378|         got = "none"
379|     elif cmf != ccr:
380|         got = "cr=%s mfcr=%s" % (hex(ccr), hex(cmf))
381|     else:
382|         got = hex(ccr)
383|     row(name, got, hex(want_cr), note)
384| 
385| 
386| cr_row("64 crorc baread", "crorc", 17, 31, 5, 0xFFFFFFFE, 0xFFFFBFFE, "BA=31 over 0xfffffffe, whole CR: a=0 at the fix; a!=0 is red")
387| cr_row("64 crorc bbread", "crorc", 30, 30, 31, 0xFFFFFFFC, 0xFFFFFFFE, "BT=BA=30, BB=31 over 0xfffffffc, whole CR: bb=0")
388| cr_row("64 crandc setbits", "crandc", 31, 30, 31, 0x00000002, 0x00000003, "BT=31 over CR[30] only, whole CR: no extra set bit")
389| cr_row("64 crorc setbits", "crorc", 31, 0, 31, 0x00000000, 0x00000001, "BT=31 over 0, whole CR: no extra set bit")
390| 
391| # ================================================ THE TWO HANDLERS, 32-BIT ===
392| score_table("32", *table("32", ["crandc", "crorc"], 8, cpu="PPC603"), control=False)
393| 
