140| def setbit(cr, n, v):
141|     m = 1 << (31 - n)
142|     return (cr | m) if v else (cr & ~m & 0xFFFFFFFF)
143| 
144| 
145| # -------------------------------------------------------------------- encodings
146| def XL(op, bt, ba, bb):
147|     """Opcode 19 XL-form CR logical (Book I:1850 layout)."""
148|     assert op in XO and 0 <= bt <= 31 and 0 <= ba <= 31 and 0 <= bb <= 31
149|     return ((19 << 26) | (bt << 21) | (ba << 16) | (bb << 11) | (XO[op] << 1)) & 0xFFFFFFFF
150| 
151| 
152| def LI(rd, simm):
153|     return ((14 << 26) | (rd << 21) | (simm & 0xFFFF)) & 0xFFFFFFFF
154| 
155| 
156| def MFCR(rt):
157|     return ((31 << 26) | (rt << 21) | (19 << 1)) & 0xFFFFFFFF
158| 
159| 
160| NOP = (24 << 26)  # ori r0,r0,0
