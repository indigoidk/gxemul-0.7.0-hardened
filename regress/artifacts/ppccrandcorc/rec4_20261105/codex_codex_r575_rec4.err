87| def exec1(cr, op, bt, ba, bb, V):
88|     """One CR-logical handler (cpu_ppc_instr.c:2720-2782) on cr, under the single-edit variant V ({} = the fix)."""
89|     if V.get("identity"):
90|         return cr
91|     body = V.get("decode", op)
92|     if body != op:
93|         return exec1(cr, body, bt, ba, bb, {})
94|     bt, ba, bb = bt & V.get("mbt", 31), ba & V.get("mba", 31), bb & V.get("mbb", 31)
95|     fbt, fba, fbb = bt, ba, bb
96|     clr = V.get("clear", "and")
97|     clr_lit = V.get("clr_lit", 1)
98| 
99|     def idx(which, a_val, b_val):   # the index a `(31-x)' names at the clear/set: bt, or the READ VALUE held in ba/bb
100|         return {"bt": fbt, "ba": a_val, "bb": b_val}[which]
101| 
102|     def do_clear(cr, a_val, b_val):
103|         w = V.get("clr_idx", "bt")
104|         if w == "rbt":                                   # `~(1 << bt)': bit position bt = CR index 31-bt
105|             return cr & ~((clr_lit << fbt) & 0xFFFFFFFF) & 0xFFFFFFFF
106|         n = idx(w, a_val, b_val)
107|         if clr == "xor":
108|             return cr ^ bitof(n)
109|         return cr & ~((clr_lit << (31 - n)) & 0xFFFFFFFF) & 0xFFFFFFFF
110| 
111|     if clr == "early":
112|         cr = do_clear(cr, fba, fbb)
113|     read_a = lambda cr, a_val: (cr >> (31 - {"BA": fba, "BB": fbb, "BT": fbt}[V.get("ba_src", "BA")])) & V.get("rma", 1)
114|     read_b = lambda cr, a_val: (cr >> (31 - {"BB": fbb, "BA": a_val, "BT": fbt}[V.get("bb_src", "BB")])) & V.get("rmb", 1)
115|     if V.get("swap"):
116|         b = read_b(cr, fba)          # swapped: at the BB read `ba' still holds the field index
117|         a = read_a(cr, b)
118|     else:
119|         a = read_a(cr, fba)
120|         if clr == "mid":
121|             cr = do_clear(cr, a, fbb)
122|         b = read_b(cr, a)
123|     if clr in ("and", "xor"):
124|         cr = do_clear(cr, a, b)
125|     if V.get("cond", COND[op])(a, b, fbt):
126|         st = V.get("set", "or")
127|         w = V.get("set_idx", "bt")
128|         lit = V.get("set_lit", 1)
129|         if w == "rbt":
130|             m = (lit << fbt) & 0xFFFFFFFF
131|         else:
132|             m = (lit << (31 - idx(w, a, b))) & 0xFFFFFFFF
133|         if st == "or":
134|             cr |= m
135|         elif st == "xor":
136|             cr ^= m
137|     return cr
138| 
139| 
140| def run(cr, insns, VV):
141|     for op, bt, ba, bb in insns:
142|         cr = exec1(cr, op, bt, ba, bb, VV.get(op, {}))
143|     return cr
144| 
