               ("d3  ba & bb   (complement dropped)", lambda a, b, bt: (a & b) != 0, "if (ba & bb)"),
               ("d5  ba | !bb  (operator crossed)", lambda a, b, bt: (a | NOT(b)) != 0, "if (ba | !bb)"),
               ("r5a bt & !bb", lambda a, b, bt: (bt & NOT(b)) != 0, "if (bt & !bb)"),
