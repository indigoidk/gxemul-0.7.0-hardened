163| # ---------------------------------------------------------------------- sessions
164| def session(cr_seed, insns, timeout=90, machine="bareppc", cpu=None):
165|     """Seed CR (and r30), place `insns' at CODE, step them all, dump the registers."""
166|     cmds = ["cr=0x%x" % cr_seed, "r30=0x%x" % SENT]
167|     for i, w in enumerate(insns):
168|         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
169|     cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
170|     cmds.append("pc=0x%x" % CODE)
171|     cmds.append("step %d" % len(insns))
172|     cmds.append("reg")
173|     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
174|     if cpu:
175|         argv += ["-C", cpu]
176|     argv += ["0x%x:%s" % (CODE, DUMMY)]
177|     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
178|     try:
179|         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
180|                            stderr=subprocess.STDOUT, timeout=timeout)
181|     except subprocess.TimeoutExpired as e:
182|         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
183|         return {}, [], out, "TIMEOUT"
184|     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
185|     rc = p.returncode
186|     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
187|     idx = t.rfind("GXemul> reg")
188|     regs = {}
189|     if idx >= 0:
190|         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
191|             regs[int(m.group(1))] = int(m.group(2), 16)
192|         m_cr = re.search(r"\bcr\s*=\s*(0x[0-9a-fA-F]+)", t[idx:])
193|         if m_cr:
194|             regs["cr"] = int(m_cr.group(1), 16)
195|     dis = []
196|     di = t.find("GXemul> unassemble")
197|     if di >= 0:
198|         end = t.find("GXemul> pc=", di)
199|         seg = t[di:end if end > 0 else len(t)]
200|         for m in re.finditer(r"^[0-9a-f]{8,16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)(?:\t(\S+))?", seg, re.M):
201|             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
202|     return regs, dis, t, how
