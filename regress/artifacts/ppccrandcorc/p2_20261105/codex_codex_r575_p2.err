### 2b. regress/ppc_crlogic_probe.py (four rows, the records)

```diff
--- a/regress/ppc_crlogic_probe.py
+++ b/regress/ppc_crlogic_probe.py
@@ -24,10 +24,24 @@
 cror, crnor, creqv, crxor) run the same table as controls of the oracle and the encoder.

-CLAUSE (e) -- what this instrument does not cover:
+CLAUSE (e) -- what this instrument catches (test-variant table 1, regress/artifacts/ppccrandcorc/table1_20261105/table1/
+SCORES.txt, PRETABLE.out written before it with predictions computed by its v575.py simulator; 15 variants on these 62 rows,
+all 15 red, each exactly as predicted): each handler's defect restored (b1, b2); both bodies made identity (c, the ruled null
+medium of the handlers); the complement moved to BA, dropped, or the operator crossed between the two edited lines (d1-d6);
+the BA/BB field mask weakened to & 7 or & 15 (m1-m4: the `hi' rows alone); the BT field mask weakened to & 7 (t1, t2).  The
+pre-fix build scores 52/62 (the ten DISC rows); /bin/true 5/62 and /bin/false 1/62 score CONTROL=FAIL, and an absent binary
+stops the probe before any row with no sentinel.
+  and does not cover:
   (1) crnand (19/225) is not decoded at HEAD and stops the CPU; it is filed separately as
       `ppccrnandundec' and is not run here.
   (2) The dyntrans fast path for these handlers is the handler itself (no separate
       translation), so one cold run per instruction exercises it.
-  (3) The edge rows pin destination bits 0 and 31; the BA/BB edges are not separately rowed.
+  (3) The edge rows pin destination bits 0 and 31 and the `hi' rows pin the BA/BB field masks (BA, BB >= 16 with every
+      submask alias holding the opposite value); an input at index 0 or 31 is not separately rowed.
+  (4) The signed shift `1 << (31-bt)' at bt = 0 (all seven handlers) is `ppccrlogicshift', filed separately: on this
+      toolchain it gives the architectural result, so no row here can see it (the pass-1 ruling, R2).
+  (5) Not claimed (the pass-1 ruling: recommended, not owed): an extra CLEAR of a bit that is neither a source nor a
+      destination -- the table seeds hold no ones there, so `others' sees only extra sets; and a body that TOGGLES the
+      destination instead of clearing it -- every row pre-sets the destination to the inverse of the result, and toggling
+      the inverse gives the right value; a row pre-setting the destination EQUAL to a result of 0 would see it.

 Sentinel: PPC_CRLOGIC_PROBE_DONE (plus PPC_CRLOGIC_RESULT=n/N, PPC_CRLOGIC_CONTROL=OK|FAIL)
@@ -244,4 +258,32 @@
 row("edge others", hex(ecr & ~emask & 0xFFFFFFFF) if ecr >= 0 else "none",
     hex(eseed & ~emask & 0xFFFFFFFF), "no CR bit but bits 0 and 31 moved")
+#  The edge session runs mfcr and captures its disassembly like the table sessions; both are scored (pass-1 ruling R4: `edge
+#  disasm` is the only encoder pin at the BT field extremes).
+row("edge mfcr", hex(eregs.get(10, -1)), hex(ecr) if ecr >= 0 else "none", "mfcr r10 reads the same CR (second channel)")
+enames = [m for _, m, _ in edis[:2]]
+row("edge disasm", "%d/2" % sum(1 for i, op in enumerate(("crandc", "crorc")) if i < len(enames) and enames[i] == op), "2/2",
+    "the disassembler names both edge encodings", control=True)
+
+# =========================================== FIELD-MASK PINS (BA, BB >= 16; pass-1 ruling R4) ==
+#  Every table row uses BA in {0,1,2,4} and BB in {0,1,2,3,5}, so a decode mask weakened from `& 31` to `& 15`, `& 7`, `& 3` or
+#  `& 1` scored 58/58.  Here BA and BB are >= 16 and every proper-submask alias of each (index & 15, & 7, & 3, & 1) holds the
+#  OPPOSITE value, so a weakened mask reads a flipped input and the result flips.  crandc: BA=31 (1), BB=30 (0) -> 1, its aliases
+#  15, 7, 3, 1 = 0 and 14, 6, 2, 0 = 1, BT=20 pre-set 0.  crorc: BA=29 (0), BB=28 (1) -> 0, its aliases 13, 5, 1 = 1 and 12, 4, 0
+#  = 0, BT=21 pre-set 1.  Two sessions: the two alias sets disagree at bits 0 and 1.
+def hi_row(name, op, bt, ba, bb, ones, zeros, want):
+    seed = 0
+    for n in ones:
+        seed = setbit(seed, n, 1)
+    for n in zeros:
+        seed = setbit(seed, n, 0)
+    seed = setbit(seed, bt, 1 - want)
+    hregs, _, _, hhow = session(seed, [XL(op, bt, ba, bb), MFCR(10)])
+    hcr = hregs.get("cr", -1)
+    row(name, crbit(hcr, bt) if (hhow == "exit0" and hcr >= 0) else -1, want,
+        "BA=%d BB=%d BT=%d, every submask alias opposite" % (ba, bb, bt))
+
+
+hi_row("64 crandc hi", "crandc", 20, 31, 30, ones=[31, 14, 6, 2, 0], zeros=[30, 15, 7, 3, 1], want=1)
+hi_row("64 crorc hi", "crorc", 21, 29, 28, ones=[28, 13, 5, 1], zeros=[29, 12, 4, 0], want=0)

 # ================================================ THE TWO HANDLERS, 32-BIT ===
```

### 2c. regress/gate_ppc.sh (the new block)

```diff
--- a/regress/gate_ppc.sh
+++ b/regress/gate_ppc.sh
@@ -325,0 +326,30 @@
+fi
+
+# ---- ppccrandcorc (#575): crandc and crorc computed NAND and NOR -- its 62-row rung-3 detector ---------------------------------------
+# X(crandc) and X(crorc) set CR[BT] on !(CR[BA] & CR[BB]) and !(CR[BA] | CR[BB]); PowerPC Book I v2.01 defines CR[BA] & ~CR[BB] and
+# CR[BA] | ~CR[BB].  `-E bareppc -M 64` (PPC970) and `-C PPC603` run each CR logical instruction on a real guest through the real
+# decoder, CR seeded from the debugger and every destination pre-set to the INVERSE of the architectural result; the five correct
+# siblings run the same table as controls; edge rows pin BT 0 and 31; two rows pin the BA/BB field masks with every submask alias
+# seeded opposite.  BEFORE the NetBSD prerequisite, like the blocks above.  Test-variant table:
+# regress/artifacts/ppccrandcorc/table1_20261105/ (the pass-1 ruling: regress/artifacts/ppccrandcorc/adj_p1_20261105/).
+CLLOG=$LOGDIR/ppc_crlogic.log
+python3 -u ppc_crlogic_probe.py "$PMAX" gate > "$CLLOG" 2>&1 || true
+if [ "$(grep -cx 'PPC_CRLOGIC_PROBE_DONE' "$CLLOG")" != 1 ]; then
+    note "ppc_crlogic: completion sentinel missing or duplicated; last lines follow"
+    tail -5 "$CLLOG" | sed 's/^/       /'
+    check "ppc_crlogic probe completed" "no" "yes"
+else
+    check "ppc_crlogic probe completed" "yes" "yes"
+    check "ppc_crlogic sentinel is the last line" "$(tail -n 1 "$CLLOG")" "PPC_CRLOGIC_PROBE_DONE"
+    for k in RESULT CONTROL; do
+        check "ppc_crlogic $k= lines" "$(grep -c "^PPC_CRLOGIC_$k=" "$CLLOG")" "1"
+    done
+    check "ppc_crlogic RESULT=62/62" "$(grep -cx 'PPC_CRLOGIC_RESULT=62/62' "$CLLOG")" "1"
+    check "ppc_crlogic CONTROL=OK"   "$(grep -cx 'PPC_CRLOGIC_CONTROL=OK' "$CLLOG")" "1"
+    for v in "ctl session" "ctl live" "ctl seed holds" "ctl cr seed" "ctl mfcr" "neg apparatus" "64 session" "64 crandc 00" "64 crandc 01" "64 crandc 10" "64 crandc 11" "64 crorc 00" "64 crorc 01" "64 crorc 10" "64 crorc 11" "64 others" "64 mfcr" "64 disasm" "s64 session" "s64 crand 00" "s64 crand 01" "s64 crand 10" "s64 crand 11" "s64 cror 00" "s64 cror 01" "s64 cror 10" "s64 cror 11" "s64 crnor 00" "s64 crnor 01" "s64 crnor 10" "s64 crnor 11" "s64 creqv 00" "s64 creqv 01" "s64 creqv 10" "s64 creqv 11" "s64 crxor 00" "s64 crxor 01" "s64 crxor 10" "s64 crxor 11" "s64 others" "s64 mfcr" "s64 disasm" "edge session" "edge crandc bt0" "edge crorc bt31" "edge others" "edge mfcr" "edge disasm" "64 crandc hi" "64 crorc hi" "32 session" "32 crandc 00" "32 crandc 01" "32 crandc 10" "32 crandc 11" "32 crorc 00" "32 crorc 01" "32 crorc 10" "32 crorc 11" "32 others" "32 mfcr" "32 disasm"; do
+        check "ppc_crlogic row: $v" "$(count "$CLLOG" "^$v  .*ok$")" "1"
+    done
+    clok=$(count "$CLLOG" " ok$"); clbad=$(count "$CLLOG" " FAIL$"); clrun=$((clok + clbad))
+    check "ppc_crlogic rows run"   "$clrun" 62
+    check "ppc_crlogic rows green" "$clok" 62
+    check "ppc_crlogic rows red"   "$clbad" 0
```

