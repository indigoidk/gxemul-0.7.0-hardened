# X(crandc) and X(crorc) set CR[BT] on !(CR[BA] & CR[BB]) and !(CR[BA] | CR[BB]); PowerPC Book I v2.01 defines CR[BA] & ~CR[BB] and
# CR[BA] | ~CR[BB].  `-E bareppc -M 64` (PPC970) and `-C PPC603` run each CR logical instruction on a real guest through the real
# decoder, CR seeded from the debugger and every destination pre-set to the INVERSE of the architectural result; the five correct
# siblings run the same table as controls; edge rows pin BT 0 and 31; two rows pin the BA/BB field masks with every submask alias
# seeded opposite; four round-2 rows close every field mask 0..30, the BB read of CR[BT] and the read-before-clear order (the
# closure by simulation: regress/artifacts/ppccrandcorc/r2_20261105/CLOSURE.md).  BEFORE the NetBSD prerequisite, like the blocks
# above.  Test-variant tables: regress/artifacts/ppccrandcorc/table1_20261105/ and r2_20261105/ (the pass-1 ruling:
# regress/artifacts/ppccrandcorc/adj_p1_20261105/).
CLLOG=$LOGDIR/ppc_crlogic.log
python3 -u ppc_crlogic_probe.py "$PMAX" gate > "$CLLOG" 2>&1 || true
if [ "$(grep -cx 'PPC_CRLOGIC_PROBE_DONE' "$CLLOG")" != 1 ]; then
    note "ppc_crlogic: completion sentinel missing or duplicated; last lines follow"
    tail -5 "$CLLOG" | sed 's/^/       /'
    check "ppc_crlogic probe completed" "no" "yes"
else
    check "ppc_crlogic probe completed" "yes" "yes"
    check "ppc_crlogic sentinel is the last line" "$(tail -n 1 "$CLLOG")" "PPC_CRLOGIC_PROBE_DONE"
