```diff
--- a/regress/ppc_crlogic_probe.py (CODE ONLY)
+++ b/regress/ppc_crlogic_probe.py (CODE ONLY)
@@ -213,4 +213,5 @@
     hex(eseed & ~emask & 0xFFFFFFFF), "no CR bit but bits 0 and 31 moved")
