540: void sh_cpu_interrupt_assert(struct interrupt *interrupt)
541: {
542: 	struct cpu *cpu = (struct cpu *) interrupt->extra;
543: 	unsigned int irq_nr = interrupt->line;
544: 	unsigned int index = irq_nr / 0x20;
545: 	unsigned int prio;
546: 
547: 	/*  Assert the interrupt, and check its priority level:  */
548: 	cpu->cd.sh.int_prio_and_pending[index] |= SH_INT_ASSERTED;
549: 	prio = cpu->cd.sh.int_prio_and_pending[index] & SH_INT_PRIO_MASK;
550: 
551: 	/*
552: 	 *  #455: PRIORITY 0 IS A DOCUMENTED, GUEST-SELECTABLE STATE, and the
553: 	 *  comment that used to sit here -- "Interrupt not implemented? Hm."
554: 	 *  -- was wrong twice over: nothing is unimplemented, and ending the
555: 	 *  host process is not what the architecture asks for.
556: 	 *
557: 	 *  SH7750 Hardware Manual Rev.7.00 19.2, p. 828
558: 	 *  (_scratchpad/sh7750_hardware.txt:39887): "When level 0 is set, the
559: 	 *  interrupt is masked and interrupt requests are ignored."  And
560: 	 *  19.3.1 (:40193): "IPRA to IPRC are initialized to H'0000 ... by a
561: 	 *  reset" -- so EVERY on-chip source is priority 0 out of reset, which
562: 	 *  cpu_sh_init's own "All others are zero" already reproduces.  One
563: 	 *  ordinary guest store then ended the host.
564: 	 *
565: 	 *  SH_INT_ASSERTED IS DELIBERATELY LEFT SET.  "Ignored" is not
566: 	 *  "discarded": 19.4.1 says the controller selects the highest-priority
567: 	 *  request and "lower-priority interrupts are held pending"
568: 	 *  (19.4.1, sh7750_hardware.txt:40508).  Masking blocks ACCEPTANCE, not
569: 	 *  the request.  Stated narrowly on purpose: this entry point is
570: 	 *  generic, so the durable claim is only that masking must not clear
571: 	 *  the bit -- the line stays asserted until its matching deassert, and
572: 	 *  how any particular peripheral latches its own source flag is that
573: 	 *  device's business, not this function's.  Clearing the bit here would also make `sh4prioraise`
574: 	 *  unfixable -- a later rescan would find nothing to deliver -- so this
575: 	 *  is required rather than merely defensible.
576: 	 *
577: 	 *  Nothing is printed.  The sh4_val_first latch idiom used by #438,
578: 	 *  #441, #443, #447 and #449 does NOT apply: that family answers "the
579: 	 *  guest asked for a feature this model does not implement", whereas a
580: 	 *  masked interrupt is correct guest behaviour that a kernel performs
581: 	 *  routinely during early boot.  A diagnostic here would fire on it,
582: 	 *  and fatal() has no quiet_mode early-out (debugmsg.c:384-390) so it
583: 	 *  could not even be silenced with -q.
584: 	 *
585: 	 *  Selection below is already safe on its own terms: the deassert
586: 	 *  rescan cannot pick a prio-0 entry either, since `prio > int_level`
587: 	 *  is `0 > 0`.
588: 	 */
589: 	if (prio == 0)
590: 		return;
591: 
592: 	if (cpu->cd.sh.int_to_assert == 0 || prio > cpu->cd.sh.int_level) {
593: 		cpu->cd.sh.int_to_assert = irq_nr;
594: 		cpu->cd.sh.int_level = prio;
595: 	}
596: }
