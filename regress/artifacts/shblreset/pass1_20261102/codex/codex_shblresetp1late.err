201: /*
202:  *  SH_ALIGN_CHECK_LD / _ST:
203:  *
204:  *  SuperH requires naturally-aligned memory access. A misaligned load or
205:  *  store raises a CPU address-error exception (EXPEVT_ADDR_ERR_LD / _ST),
206:  *  with TEA set to the faulting address. amask is 1 for 16-bit accesses
207:  *  and 3 for 32-bit accesses. (8-bit accesses are always aligned.)
208:  */
209: #define SH_ALIGN_CHECK_LD(vaddr, amask)					\
210: 	if ((vaddr) & (amask)) {					\
211: 		SYNCH_PC;						\
212: 		sh_exception(cpu, EXPEVT_ADDR_ERR_LD, 0, (vaddr));	\
213: 		return;							\
214: 	}
215: #define SH_ALIGN_CHECK_ST(vaddr, amask)					\
216: 	if ((vaddr) & (amask)) {					\
217: 		SYNCH_PC;						\
218: 		sh_exception(cpu, EXPEVT_ADDR_ERR_ST, 0, (vaddr));	\
219: 		return;							\
220: 	}
221: 
222: 
223: /*
224:  *  nop: Nothing
225:  */
226: X(nop)
227: {
228: }
229: 
230: 
231: /*
232:  *  reserved:  An encoding this emulator does not implement.
233:  *
234:  *  #314: the decoder used to `goto bad` for these, which reaches the shared
235:  *  label in cpu_dyntrans.c and sets cpu->running = 0 -- so a guest executing
236:  *  any instruction missing from the tables stopped the whole emulator. Real
237:  *  silicon raises the general illegal-instruction exception, which is what
238:  *  the guest kernel is written to handle. Measured halting on this rig, among
239:  *  others: SLEEP, MAC.L, STC SGR, STC.L/LDC.L DBR, SYNCO, PREFI, ICBI,
240:  *  MOVLI.L and MOVCO.L.
241:  */
242: X(reserved)
243: {
244: 	SYNCH_PC;
245: 	sh_exception(cpu, EXPEVT_RES_INST, 0, 0);
246: }
247: 
248: 
249: /*
250:  *  sleep:  Wait for interrupt
251:  */
252: X(sleep)
253: {
254: 	RES_INST_IF_NOT_MD;
255: 
256: 	/*
257: 	 *  If there is an interrupt, then just return. Otherwise
258: 	 *  re-run the sleep instruction (after a delay).
259: 	 */
260: 	if (cpu->cd.sh.int_to_assert > 0 && !(cpu->cd.sh.sr & SH_SR_BL)
261: 	    && ((cpu->cd.sh.sr & SH_SR_IMASK) >> SH_SR_IMASK_SHIFT)
262: 	    < cpu->cd.sh.int_level)
263: 		return;
264: 
265: 	SYNCH_PC;
266: 	cpu->cd.sh.next_ic = ic;
267: 	cpu->is_halted = true;
268: 
269: 	cpu->wants_to_idle = true;
2825: 	RES_INST_IF_NOT_MD;
2826: 	sh_update_sr(cpu, reg(ic->arg[1]));
2827: 
2828: #if 0
2829: /*  NOTE: This code causes NetBSD/landisk to get past a point where it
2830:     otherwise hangs, but it causes Linux/Dreamcast to bug out instead. :/  */
2831: 
2832: 	if (!(cpu->cd.sh.sr & SH_SR_BL) && cpu->cd.sh.int_to_assert > 0 &&
2833: 	    ( (cpu->cd.sh.sr & SH_SR_IMASK) >> SH_SR_IMASK_SHIFT)
2834: 	    < cpu->cd.sh.int_level) {
2835: 		/*  Cause interrupt immediately, by dropping out of the
2836: 		    main dyntrans loop:  */
2837: 		cpu->cd.sh.next_ic = &nothing_call;
2838: 	}
2839: #endif
