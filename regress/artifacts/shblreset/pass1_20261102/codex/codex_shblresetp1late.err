 succeeded in 229ms:
226: #    * `tlbm sr` pre-sets SR to 0x40008000 so the reset transition's THIRD statement
227: #      is observable.  From the reset-default SR that statement is a NO-OP, which is
228: #      why an arm that sets pc and vbr and forgets it passes every other row.
229: #    * `tlbm single` gives entry 1 a different VPN so nothing should fire.  It is the
230: #      only row that sees a `n_hits >= 1` mutant, and it doubles as the liveness
231: #      control -- it proves the three stores execute and the session survives them.
232: #
233: #  landisk and not testsh, deliberately: landisk's PROM leaves vbr = 0x8c000000, so
234: #  `vbr == 0` is a real transition.  On testsh vbr is already 0 and that row would be
235: #  vacuous.
236: TMLOG=$LOGDIR/gate_sh_tlbmulti.log
237: #  *** -u ON ALL SIX PROBES IN THIS GATE. ***  `probeslow` recorded the streaming
238: #  mitigation as APPLIED and called it "the general fix" -- and it had been applied to
239: #  NONE of them: the -u lived only in ad-hoc measurement scripts.  These six are exactly
240: #  the six probes `probetimebased` names as having no prompt detection, so they are also
241: #  the six whose runs are longest and most worth not losing.  Redirected to a file,
242: #  stdout is block buffered and a killed run loses everything it had already measured.
243: python3 -u sh_tlbmulti_probe.py "$PMAX" "$KERNEL" > "$TMLOG" 2>&1 || true
244: 
245: if ! grep -q "SH_TLBMULTI_RESULT=" "$TMLOG"; then
246:     note "sh_tlbmulti probe produced no result line; last lines follow"
247:     tail -5 "$TMLOG" | sed 's/^/       /'
248:     check "sh_tlbmulti probe completed" "no" "yes"
249: else
250:     grep -E " ok$| FAIL$" "$TMLOG" | sed 's/^/       /'
251:     tmctrl=$(grep -o "SH_TLBMULTI_CONTROL=[A-Z]*" "$TMLOG" | tail -1 | cut -d= -f2)
252:     check "sh_tlbmulti control proves it measures" "${tmctrl:-missing}" "OK"
253:     tmres=$(grep -o "SH_TLBMULTI_RESULT=[0-9]*/[0-9]*" "$TMLOG" | tail -1 | cut -d= -f2)
254:     check "sh_tlbmulti rows run"     "${tmres#*/}" 6
255:     check "sh_tlbmulti rows correct" "${tmres%/*}" "${tmres#*/}"
256:     for v in "tlbm alive" "tlbm expevt" "tlbm pc" "tlbm vbr" "tlbm sr" "tlbm single"; do
257:         n=$(count "$TMLOG" "^$v  .*ok$")
258:         check "  $v" "$n" 1
259:     done
260: fi
261: 
262: # ---- #455: an interrupt at priority 0 ended the host process -----------------
263: #  Wired in the SAME commit as the fix.  Gate 6's structural note says a probe that
264: #  ships with its wiring cannot skip its census pin, because the wiring forces a
265: #  gate run -- #441's did not, and its pin then went latently red between two
266: #  commits.
267: #
268: #  This probe drives BOTH SH rigs, and which row uses which is forced rather than
269: #  stylistic.
987cb596:regress/gate_sh_rounding.sh:236:TMLOG=$LOGDIR/gate_sh_tlbmulti.log
987cb596:regress/gate_sh_rounding.sh:243:python3 -u sh_tlbmulti_probe.py "$PMAX" "$KERNEL" > "$TMLOG" 2>&1 || true
987cb596:regress/gate_sh_rounding.sh:245:if ! grep -q "SH_TLBMULTI_RESULT=" "$TMLOG"; then
987cb596:regress/gate_sh_rounding.sh:246:    note "sh_tlbmulti probe produced no result line; last lines follow"
987cb596:regress/gate_sh_rounding.sh:248:    check "sh_tlbmulti probe completed" "no" "yes"
987cb596:regress/gate_sh_rounding.sh:251:    tmctrl=$(grep -o "SH_TLBMULTI_CONTROL=[A-Z]*" "$TMLOG" | tail -1 | cut -d= -f2)
987cb596:regress/gate_sh_rounding.sh:252:    check "sh_tlbmulti control proves it measures" "${tmctrl:-missing}" "OK"
987cb596:regress/gate_sh_rounding.sh:253:    tmres=$(grep -o "SH_TLBMULTI_RESULT=[0-9]*/[0-9]*" "$TMLOG" | tail -1 | cut -d= -f2)
987cb596:regress/gate_sh_rounding.sh:254:    check "sh_tlbmulti rows run"     "${tmres#*/}" 6
