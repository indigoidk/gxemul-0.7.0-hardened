841: /*
842:  *  sh_update_sr():
843:  *
844:  *  Writes a new value to the status register.
845:  */
846: void sh_update_sr(struct cpu *cpu, uint32_t new_sr)
847: {
848: 	uint32_t old_sr = cpu->cd.sh.sr;
849: 
850: 	if ((new_sr & SH_SR_RB) != (old_sr & SH_SR_RB)) {
851: 		int i;
852: 		for (i=0; i<SH_N_GPRS_BANKED; i++) {
853: 			uint32_t tmp = cpu->cd.sh.r[i];
854: 			cpu->cd.sh.r[i] = cpu->cd.sh.r_bank[i];
855: 			cpu->cd.sh.r_bank[i] = tmp;
856: 		}
857: 	}
858: 
859: 	cpu->cd.sh.sr = new_sr;
860: }
