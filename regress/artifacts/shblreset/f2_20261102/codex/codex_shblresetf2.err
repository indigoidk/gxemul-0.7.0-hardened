381: void sh_update_interrupt_priorities(struct cpu *cpu)
382: {
383: 	int i;
384: 
385: 	/*
386: 	 *  Set priorities of known interrupts, without affecting the
387: 	 *  SH_INT_ASSERTED bit:
388: 	 */
389: 
390: 	for (i=SH4_INTEVT_IRQ0; i<=SH4_INTEVT_IRQ14; i+=0x20) {
391: 		cpu->cd.sh.int_prio_and_pending[i/0x20] &= ~SH_INT_PRIO_MASK;
392: 		cpu->cd.sh.int_prio_and_pending[i/0x20] |= (15 - ((i - 
393: 		    SH4_INTEVT_IRQ0) / 0x20));
394: 	}
395: 
396: 	/*  #458: IPRA -- TMU0 [15:12], TMU1 [11:8], TMU2 [7:4], RTC [3:0].  The
397: 	    RTC nibble was never read: a source in a register this function DOES
398: 	    consult, left permanently at priority 0.  */
399: 	sh_set_int_prio(cpu, SH_INTEVT_TMU0_TUNI0,
400: 	    (cpu->cd.sh.intc_ipra >> 12) & 0xf);
401: 	sh_set_int_prio(cpu, SH_INTEVT_TMU1_TUNI1,
402: 	    (cpu->cd.sh.intc_ipra >> 8) & 0xf);
403: 	sh_set_int_prio(cpu, SH_INTEVT_TMU2_TUNI2,
404: 	    (cpu->cd.sh.intc_ipra >> 4) & 0xf);
405: 	sh_set_int_prio(cpu, SH_INTEVT_TMU2_TICPI2,
406: 	    (cpu->cd.sh.intc_ipra >> 4) & 0xf);
407: 	sh_set_int_prio(cpu, SH_INTEVT_RTC_ATI, cpu->cd.sh.intc_ipra & 0xf);
408: 	sh_set_int_prio(cpu, SH_INTEVT_RTC_PRI, cpu->cd.sh.intc_ipra & 0xf);
409: 	sh_set_int_prio(cpu, SH_INTEVT_RTC_CUI, cpu->cd.sh.intc_ipra & 0xf);
410: 
411: 	/*  #458: IPRB -- WDT [15:12], REF [11:8], SCI [7:4], reserved [3:0].  */
412: 	sh_set_int_prio(cpu, SH_INTEVT_WDT_ITI,
413: 	    (cpu->cd.sh.intc_iprb >> 12) & 0xf);
414: 	sh_set_int_prio(cpu, SH_INTEVT_REF_RCMI,
