  57     `EXPEVT_RESET_MANUAL` with the multiple-hit code exempt; the BL rows at the end of
  58     this file pin both halves.
  59 """
  60 import os
  61 import pty
  62 import re
  63 import select
  64 import sys
  65 import time
  66 
  67 BIN = sys.argv[1]
  68 KERNEL = sys.argv[2]
  69 
  70 CODE = 0x8c010000
  71 UTLB_AA = 0xf6000000           # SH4_UTLB_AA, 16 MB window
  72 ENTRY0 = UTLB_AA + 0x000
  73 ENTRY1 = UTLB_AA + 0x100
  74 ASSOC = UTLB_AA + 0x080        # SH4_UTLB_A, the associative form
  75 VPN_A = 0x12345100             # VPN 0x12345000, ASID 0, V=1
  76 VPN_B = 0x22345100             # a DIFFERENT VPN -- the single-hit control
  77 
  78 MOV_L_R0_AT_R1 = 0x2102        # mov.l r0,@r1
  79 MOV_L_R4_AT_R5 = 0x2542        # mov.l r4,@r5
  80 MOV_L_R6_AT_R7 = 0x2762        # mov.l r6,@r7
  81 
  82 rows = []
  83 
  84 
  85 def row(name, got, want):
  86     ok = (got == want)
  87     rows.append(ok)
  88     print("%-14s %-24s %-24s %-10s %s"
  89           % (name, got, want, "#457", "ok" if ok else "FAIL"))
  90 
  91 
  92 def session(pre=(), entry1_vpn=VPN_A, settle=8.0, trigger=True, program=None, steps=None):
  93     """Install two UTLB entries then do the associative write. Returns (regs, died).
  94 
  95     `pre` runs before the trigger -- used to pre-set SR so the reset transition's
  96     SR update is observable.
  97     #577: `program` (a list of 16-bit words placed at CODE) and `steps` replace the
  98     three-store multiple-hit program for the BL rows; the default is that program.
  99     """
 100     pid, fd = pty.fork()
 101     if pid == 0:
 102         os.execv(BIN, [BIN, "-V", "-E", "landisk", "-M", "64", KERNEL])
 103         os._exit(127)
 104     buf = ""
 105 
 106     def rd(t):
 107         nonlocal buf
 108         end = time.time() + t
 109         while time.time() < end:
 110             r, _, _ = select.select([fd], [], [], 0.25)
 111             if not r:
 112                 continue
 113             try:
 114                 d = os.read(fd, 65536)
 115             except OSError:
 116                 return False
 117             if not d:
 118                 return False
 119             buf += d.decode("latin-1", "replace")
 120         return True
 121 
 122     alive = rd(settle)
 123     #  *** THE CONTROL MUST NOT RUN THE TRIGGER. ***  The first draft ran the three
 124     #  stores unconditionally, so the "does the session come up" control EXERCISED the
 125     #  defect and reported DEAD on the committed build -- a control failing for the
 126     #  very reason it exists to rule out.  Rule 4: did it fail for the reason under
 127     #  test?  It did not.
 128     if program is None:
 129         trig = ["r0=0x%08x" % VPN_A, "r1=0x%x" % ENTRY0,
 130                 "r4=0x%08x" % entry1_vpn, "r5=0x%x" % ENTRY1,
 131                 "r6=0x%08x" % VPN_A, "r7=0x%x" % ASSOC,
 132                 "put h 0x%x, 0x%04x" % (CODE, MOV_L_R0_AT_R1),
 133                 "put h 0x%x, 0x%04x" % (CODE + 2, MOV_L_R4_AT_R5),
 134                 "put h 0x%x, 0x%04x" % (CODE + 4, MOV_L_R6_AT_R7),
 135                 "pc=0x%x" % CODE, "step 3"]
 136     else:   # #577: an arbitrary short program; the caller seeds registers through `pre`
 137         trig = ["put h 0x%x, 0x%04x" % (CODE + 2 * i, w) for i, w in enumerate(program)]
 138         trig += ["pc=0x%x" % CODE, "step %d" % (steps if steps is not None else len(program))]
 139     cmds = list(pre) + ([] if not trigger else trig) + [
 140         #  `registers` does not exist as a command, and a bare dump would not show
 141         #  these anyway: cpu_sh.c prints expevt/vbr only under `coprocs & 2`.
 142         #  `print <name>` reads them through CPU_SETTINGS_ADD_REGISTER32.  Established
 143         #  by trying the candidates against a live session, not assumed.
 144         "print expevt", "print pc", "print vbr", "print sr"]
 145     for c in cmds:
 146         try:
 147             os.write(fd, (c + "\n").encode("latin-1"))
 148         except OSError:
 149             alive = False
 150             break
 151         if not rd(1.2):
 152             alive = False
 153             break
 154     try:
 155         os.write(fd, b"quit\n")
 156         time.sleep(0.2)
 157         os.kill(pid, 9)
 158         os.waitpid(pid, 0)
 159     except Exception:
 160         pass
 161     return buf, not alive
 162 
 163 
 164 def reg(t, name):
 165     """Read back one `print <name>`: the debugger echoes the command, then the value.
 166 
 167     Anchored to the ECHO rather than scanning for a bare hex word, because the
 168     transcript is full of addresses and the wrong one would be indistinguishable from
 169     the right one -- the same reason this project's verdict extractor anchors instead
 170     of grepping.
 171     """
 172     m = re.search(r"print\s+%s\s*\r?\n\s*0x([0-9a-f]+)" % re.escape(name), t)
 173     return ("0x%08x" % int(m.group(1), 16)) if m else "absent"
 174 
 175 
 176 #  ---- control: the session comes up at all ------------------------------------
 177 ctl, ctl_died = session(trigger=False)
 178 print("SH_TLBMULTI_CONTROL=%s" % ("DEAD" if ctl_died else "OK"))
 179 if ctl_died:
 180     print("SH_TLBMULTI_RESULT=0/0")
 181     sys.exit(0)
 182 
 183 #  ---- the trigger, at reset-default SR ----------------------------------------
 184 t, died = session()
 185 row("tlbm alive", "died" if died else "alive", "alive")
 186 row("tlbm expevt", reg(t, "expevt") if not died else "died", "0x00000140")
 187 row("tlbm pc", reg(t, "pc") if not died else "died", "0xa0000000")
 188 row("tlbm vbr", reg(t, "vbr") if not died else "died", "0x00000000")
 189 
 190 #  ---- the SR row: the ONLY row that sees a pc+vbr-only arm --------------------
 191 t2, died2 = session(pre=["sr=0x40008000"])
 192 row("tlbm sr", reg(t2, "sr") if not died2 else "died", "0x700000f0")
 193 
 194 #  ---- the single-hit control: the ONLY row that sees `n_hits >= 1` ------------
 195 #  A LIVENESS control too: it proves the three stores execute and the session
 196 #  survives them, so "died" on the rows above is the SECOND match and not the
 197 #  program.
 198 t3, died3 = session(entry1_vpn=VPN_B)
 199 row("tlbm single", "died" if died3 else reg(t3, "expevt"), "0x00000000")
 200 
 201 
 202 #  ---- #577: a general exception taken with SR.BL set is a MANUAL reset -----------
#!/bin/bash
# run_killtable577.sh -- #577 table: base (HEAD clone), fixed, then seven mutants in /tmp/gxmut577 (copy of the fixed clone per mutant,
# sentinel, deleted at the end).  No project tree is touched.
set -u
W=/mnt/c/DocumentNoSnc/CC/GXEMUL/_scratchpad/w577; K=$W/killtable_20261102; B=/tmp/gxdivw; F=/tmp/gxfix577; M=/tmp/gxmut577
LOG=$K/KILLTABLE.log
echo "killtable577 start $(date '+%F %T')" | tee "$LOG"
bash "$W/run_probe_leg577.sh" "$B/gxemul" base_head | tail -1 | tee -a "$LOG"
bash "$W/run_probe_leg577.sh" "$F/gxemul" fixed | tail -1 | tee -a "$LOG"
for mut in M_b M_c M_noex M_wrongex M_lt100 M_trapaonly M_power; do
    rm -rf "$M"; cp -a "$F" "$M"
    echo "MUTANT: src/cpus/cpu_sh.c $mut (scratch clone, #577 table)" > "$M/.MUTANT"
    if ! python3 "$W/mutate577.py" "$mut" "$M/src/cpus/cpu_sh.c" >> "$LOG" 2>&1; then echo "$mut APPLY-FAILED" | tee -a "$LOG"; continue; fi
    ( cd "$M" && rm -f src/cpus/cpu_sh*.o && make -j4 > "make_$mut.log" 2>&1 ); rc=$?
    if [ $rc != 0 ] || [ ! "$M/gxemul" -nt "$M/src/cpus/cpu_sh.c" ]; then echo "$mut BUILD-FAILED rc=$rc" | tee -a "$LOG"; tail -3 "$M/make_$mut.log" >> "$LOG"; continue; fi
    bash "$W/run_probe_leg577.sh" "$M/gxemul" "$mut" | tail -1 | tee -a "$LOG"
done
rm -rf "$M"
echo "KILLTABLE577_DONE $(date '+%F %T')" | tee -a "$LOG"
#!/bin/bash
# run_probe_leg577.sh <binary> <label> -- one leg of the #577 table with the extended tlbmulti probe (WSL).
set -u
BIN=$1; LABEL=$2
OUT=/mnt/c/DocumentNoSnc/CC/GXEMUL/_scratchpad/w577/killtable_20261102/$LABEL.raw
KERNEL=/mnt/c/DocumentNoSnc/CC/GXEMUL/_images/openbsd76-landisk-bsd.rd
PROBE=/mnt/c/DocumentNoSnc/CC/GXEMUL/_scratchpad/w577/sh_tlbmulti_probe.NEW.py
SRC=$(dirname "$BIN")/src/cpus/cpu_sh.c
{ echo "LEG $LABEL binary=$BIN $(ls -la --time-style=+%F_%T "$BIN" | awk '{print $5, $6}') md5=$(md5sum "$BIN" | cut -c1-12)";
  echo "binary newer than cpu_sh.c: $( [ "$BIN" -nt "$SRC" ] && echo yes || echo NO-STALE )";
  echo "sentinel: $(cat "$(dirname "$BIN")/.MUTANT" 2>/dev/null || echo none)"; } > "$OUT"
cd /tmp && python3 -u "$PROBE" "$BIN" "$KERNEL" >> "$OUT" 2>&1
echo "LEG_DONE $LABEL $(grep -E '^SH_TLBMULTI_RESULT=' "$OUT")" | tee -a "$OUT"

