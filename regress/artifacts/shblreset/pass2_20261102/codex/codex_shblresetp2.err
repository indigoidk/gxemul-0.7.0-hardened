  202  *  SH_ALIGN_CHECK_LD / _ST:
  203  *
  204  *  SuperH requires naturally-aligned memory access. A misaligned load or
  205  *  store raises a CPU address-error exception (EXPEVT_ADDR_ERR_LD / _ST),
  206  *  with TEA set to the faulting address. amask is 1 for 16-bit accesses
  207  *  and 3 for 32-bit accesses. (8-bit accesses are always aligned.)
  208  */
  209 #define SH_ALIGN_CHECK_LD(vaddr, amask)					\
  210 	if ((vaddr) & (amask)) {					\
