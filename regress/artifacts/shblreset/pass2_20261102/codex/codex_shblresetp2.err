  866  *  Writes a new value to the floating-point status/control register.
  867  */
  868 void sh_update_fpscr(struct cpu *cpu, uint32_t new_fpscr)
  869 {
  870 	uint32_t old_fpscr = cpu->cd.sh.fpscr;
  871 
  872 	if ((new_fpscr & SH_FPSCR_FR) != (old_fpscr & SH_FPSCR_FR)) {
  873 		int i;
  874 		for (i=0; i<SH_N_FPRS; i++) {
  875 			uint32_t tmp = cpu->cd.sh.fr[i];
  876 			cpu->cd.sh.fr[i] = cpu->cd.sh.xf[i];
  877 			cpu->cd.sh.xf[i] = tmp;
  878 		}
  879 	}
  880 
  881 	cpu->cd.sh.fpscr = new_fpscr;
  882 }
  883 
  884 
  885 /*
  886  *  sh_exception():
  887  *
  888  *  Causes a transfer of control to an exception or interrupt handler.
  889  *  If intevt > 0, then it is an interrupt, otherwise an exception.
  890  *
  891  *  vaddr contains the faulting address, on TLB exceptions.
  892  */
  893 void sh_exception(struct cpu *cpu, int expevt, int intevt, uint32_t vaddr)
  894 {
  895 	uint32_t vbr = cpu->cd.sh.vbr;
  896 
  897 	if (!quiet_mode) {
  898 		if (intevt > 0)
  899 			debug("[ interrupt 0x%03x", intevt);
  900 		else
  901 			debug("[ exception 0x%03x", expevt);
  902 
  903 		debug(", pc=0x%08" PRIx32" ", (uint32_t)cpu->pc);
  904 		if (intevt == 0)
  905 			debug("vaddr=0x%08" PRIx32" ", vaddr);
  906 
  907 		debug(" ]\n");
  908 	}
  909 
  910 	if (cpu->cd.sh.sr & SH_SR_BL) {
  911 		fatal("[ sh_exception(): BL bit already set. ]\n");
  912 
  913 		/*  This is actually OK in two cases: a User Break,
  914 		    or on NMI interrupts if a special flag is set?  */
  915 		/*  TODO  */
  916 
  917 		expevt = EXPEVT_RESET_POWER;
  918 	}
  919 
  920 	if (cpu->is_halted) {
  921 		/*
  922 		 *  If the exception occurred on a 'sleep' instruction, then let
  923 		 *  the instruction following the sleep instruction be the one
  924 		 *  where execution resumes when the interrupt service routine
  925 		 *  returns.
  926 		 */
  927 		cpu->is_halted = false;
  928 		cpu->pc += sizeof(uint16_t);
  929 	}
  930 
  931 	if (cpu->delay_slot) {
  932 		cpu->delay_slot = EXCEPTION_IN_DELAY_SLOT;
  933 		cpu->pc -= sizeof(uint16_t);
  934 	}
  935 
  936 
  937 	/*
  938 	 *  Stuff common to all exceptions:
  939 	 */
  940 
  941 	cpu->cd.sh.spc = cpu->pc;
  942 	cpu->cd.sh.ssr = cpu->cd.sh.sr;
  943 	cpu->cd.sh.sgr = cpu->cd.sh.r[15];
  944 
  945 	if (intevt > 0) {
  946 		cpu->cd.sh.intevt = intevt;
  947 		expevt = -1;
  948 	} else {
  949 		cpu->cd.sh.expevt = expevt;
  950 	}
  951 
  952 	sh_update_sr(cpu, cpu->cd.sh.sr | SH_SR_MD | SH_SR_RB | SH_SR_BL);
  953 
  954 	/*  Most exceptions set PC to VBR + 0x100.  */
  955 	cpu->pc = vbr + 0x100;
  956 
  957 
  958 	/*  Specific cases:  */
  959 	switch (expevt) {
  960 
  961 	case -1:	/*  Interrupt  */
  962 		cpu->pc = vbr + 0x600;
  963 		break;
  964 
  965 	/*
  966 	 *  #457: EXPEVT_RESET_TLB_MULTI_HIT joins this group, and joining it is
  967 	 *  the whole fix.  dev_sh4.c raises it when a guest ASSOCIATIVE write to
  968 	 *  the UTLB address array matches more than one entry; this switch had no
  969 	 *  arm for it, so it fell to the default below and ran exit(1).  Three
  970 	 *  ordinary privileged guest stores ended the host process.
  971 	 *
  972 	 *  The manual puts it in exactly this group.  **Table 5.2 Exceptions**
  973 	 *  (_scratchpad/sh7750_hardware.txt:11994, rows at :12006 and :12010) lists
  974 	 *  BOTH TLB multiple-hit exceptions as Reset / Abort category, vector
  975 	 *  H'A000 0000, code H'140 -- the same rows as power-on and manual reset.
  976 	 *
  977 	 *  The arm below is NOT Manual_reset() transcribed.  That routine (:12392)
  978 	 *  is ten statements and includes Initialize_CPU() and
  979 	 *  Initialize_Module(Manual); this arm is three, because EXPEVT and
  980 	 *  MD|RB|BL are already done by the common code above, and because NOT
  981 	 *  reinitialising the CPU is the faithful part here -- 3.6.4's software
  982 	 *  processing inspects the UTLB entries AFTER the reset, which a full
  983 	 *  re-init would destroy.
  984 	 *
  985 	 *  EXPEVT survives the grouping by construction: the common code above
  986 	 *  assigns cpu->cd.sh.expevt BEFORE this switch, so 0x140 is already
  987 	 *  latched and the guest's reset handler can tell a multiple hit from a
  988 	 *  power-on (0x000) or a manual reset (0x020).  A review seat asked
  989 	 *  whether grouping would clobber it; it does not.
  990 	 *
  991 	 *  *** DO NOT REWRITE THIS AS A SEPARATE ARM THAT SETS pc AND vbr ONLY. ***
  992 	 *  That is the likelier implementation than the fix itself, and it was
  993 	 *  MEASURED passing a witness that pins alive + expevt + pc + vbr -- because
  994 	 *  sh_update_sr() is a NO-OP from the reset-default SR (IMASK already 0xf,
  995 	 *  FD already clear).  It only becomes observable when the guest holds FD or
  996 	 *  a low IMASK at fault time, which is why the detector pre-sets SR and pins
  997 	 *  the result.  Figure 5.2 (:12228) specifies SR.{MD,RB,BL,FD,IMASK} <-
  998 	 *  11101111 for the reset transition, so the third statement is required,
  999 	 *  not decoration.
 1000 	 *
 1001 	 *  Deleting the detection instead was considered and is REFUTED by
 1002 	 *  **3.7.4 UTLB Address Array** (:10111, sentence at :10141-10143), which
 1003 	 *  both raises the exception AND supplies the ordering: "D and V specified
 1004 	 *  in the data field are written to that entry.  If there is more than one
 1005 	 *  matching entry, a data TLB multiple hit exception results."  Write first,
 1006 	 *  then raise -- so dev_sh4.c's update-before-count is faithful and a
 1007 	 *  scan-first rewrite would be less so.
 1008 	 *
 1009 	 *  (An earlier draft cited 3.6.4's "the contents of PPN ... may also be
 1010 	 *  corrupted" as that warrant.  A review seat pointed out it is the wrong
 1011 	 *  sentence: the device loop writes V and D, never PPN.  The conclusion was
 1012 	 *  right and the reason was not, which is the kind of thing that gets
 1013 	 *  reused.)
 1014 	 */
 1015 	case EXPEVT_RESET_POWER:
 1016 	case EXPEVT_RESET_MANUAL:
 1017 	case EXPEVT_RESET_TLB_MULTI_HIT:
 1018 		cpu->pc = 0xa0000000;
 1019 		cpu->cd.sh.vbr = 0x00000000;
 1020 		sh_update_sr(cpu, (cpu->cd.sh.sr | SH_SR_IMASK) & ~SH_SR_FD);
 1021 		break;
 1022 
 1023 	case EXPEVT_TLB_MISS_LD:
 1024 	case EXPEVT_TLB_MISS_ST:
 1025 		cpu->pc = vbr + 0x400;
 1026 		// fall through
 1027 	case EXPEVT_TLB_PROT_LD:
 1028 	case EXPEVT_TLB_PROT_ST:
 1029 	case EXPEVT_TLB_MOD:
 1030 		cpu->cd.sh.tea = vaddr;
 1031 		cpu->cd.sh.pteh &= ~SH4_PTEH_VPN_MASK;
 1032 		cpu->cd.sh.pteh |= (vaddr & SH4_PTEH_VPN_MASK);
 1033 		break;
 1034 
 1035 	case EXPEVT_TRAPA:
 1036 		/*
 1037 		 *  Note: The TRA register is already set by the implementation
 1038 		 *  of the trapa instruction. See cpu_sh_instr.c for details.
 1039 		 *  Here, spc is incremented, so that a return from the trap
 1040 		 *  handler transfers control to the instruction _following_
 1041 		 *  the trapa.
 1042 		 */
 1043 		cpu->cd.sh.spc += sizeof(uint16_t);
 1044 		break;
