2035:		    exception_names[exccode],
2036:		    w, (uint64_t) (cpu->is_32bit? (uint32_t)cpu->pc : cpu->pc),
2037:		    symbol? symbol : "(no symbol)");
2038:	}
2039:
2040:	/*  Clear the exception code bits of the cause register...  */
2041:	if (exc_model == EXC3K)
2042:		reg[COP0_CAUSE] &= ~R2K3K_CAUSE_EXCCODE_MASK;
2043:	else
2044:		reg[COP0_CAUSE] &= ~CAUSE_EXCCODE_MASK;
2045:
2046:	/*  ... and OR in the exception code:  */
2047:	reg[COP0_CAUSE] |= (exccode << CAUSE_EXCCODE_SHIFT);
2048:
2049:	/*  Always set CE (according to the R5000 manual):  */
2050:	reg[COP0_CAUSE] &= ~CAUSE_CE_MASK;
2051:	reg[COP0_CAUSE] |= (coproc_nr << CAUSE_CE_SHIFT);
2052:
2053:	if (tlb || (exccode >= EXCEPTION_MOD && exccode <= EXCEPTION_ADES) ||
2054:	    exccode == EXCEPTION_VCEI || exccode == EXCEPTION_VCED) {
2055:		reg[COP0_BADVADDR] = vaddr;
2056:		if (cpu->is_32bit)
2057:			reg[COP0_BADVADDR] = (int32_t)reg[COP0_BADVADDR];
2058:	}
2059:
2060:	/*  #211: (Codex/Fable) only TLB exceptions (Mod/TLBL/TLBS) update
2061:	    Context/EntryHi/XContext; an Address Error (AdEL/AdES) or a VCE
2062:	    updates only BadVAddr on real R3000/R4000 silicon, so don't pollute
2063:	    the CP0 fault fingerprint an auditor snapshots.  */
2064:	if (exccode >= EXCEPTION_MOD && exccode <= EXCEPTION_TLBS) {
2065:		if (exc_model == EXC3K) {
2066:			reg[COP0_CONTEXT] &= ~R2K3K_CONTEXT_BADVPN_MASK;
2067:			reg[COP0_CONTEXT] |= ((vaddr_vpn2 <<
2068:			    R2K3K_CONTEXT_BADVPN_SHIFT) &
2069:			    R2K3K_CONTEXT_BADVPN_MASK);
2070:
2071:			reg[COP0_ENTRYHI] = (vaddr & R2K3K_ENTRYHI_VPN_MASK)
2072:			    | (vaddr_asid << R2K3K_ENTRYHI_ASID_SHIFT);
2073:
2074:			/*  Sign-extend:  */
2075:			reg[COP0_CONTEXT] = (int64_t)(int32_t)reg[COP0_CONTEXT];
2076:			reg[COP0_ENTRYHI] = (int64_t)(int32_t)reg[COP0_ENTRYHI];
2077:		} else {
2078:			if (cpu->cd.mips.cpu_type.rev == MIPS_R4100) {
2079:				reg[COP0_CONTEXT] &=
2080:				    ~CONTEXT_BADVPN2_MASK_R4100;
2081:				reg[COP0_CONTEXT] |= ((vaddr_vpn2 <<
2082:				    CONTEXT_BADVPN2_SHIFT) &
2083:				    CONTEXT_BADVPN2_MASK_R4100);
2084:
2085:				/*  TODO:  fix these  */
2086:				reg[COP0_XCONTEXT] &= ~XCONTEXT_R_MASK;
2087:				reg[COP0_XCONTEXT] &= ~XCONTEXT_BADVPN2_MASK;
2088:				reg[COP0_XCONTEXT] |= (vaddr_vpn2 << XCONTEXT_BADVPN2_SHIFT) & XCONTEXT_BADVPN2_MASK;
2089:				reg[COP0_XCONTEXT] |= ((vaddr >> 62) & 0x3) << XCONTEXT_R_SHIFT;
2090:
2091:				/*  reg[COP0_PAGEMASK] = cpu->cd.mips.coproc[0]->tlbs[0].mask & PAGEMASK_MASK;  */
2092:
2093:				reg[COP0_ENTRYHI] = (vaddr & (ENTRYHI_R_MASK | ENTRYHI_VPN2_MASK | 0x1800)) | vaddr_asid;
2094:			} else {
2095:				reg[COP0_CONTEXT] &= ~CONTEXT_BADVPN2_MASK;
2096:				reg[COP0_CONTEXT] |= ((vaddr_vpn2 << CONTEXT_BADVPN2_SHIFT) & CONTEXT_BADVPN2_MASK);
2097:
2098:				reg[COP0_XCONTEXT] &= ~XCONTEXT_R_MASK;
2099:				reg[COP0_XCONTEXT] &= ~XCONTEXT_BADVPN2_MASK;
2100:				reg[COP0_XCONTEXT] |= (vaddr_vpn2 << XCONTEXT_BADVPN2_SHIFT) & XCONTEXT_BADVPN2_MASK;
2101:				reg[COP0_XCONTEXT] |= ((vaddr >> 62) & 0x3) << XCONTEXT_R_SHIFT;
2102:
2103:				/*  reg[COP0_PAGEMASK] = cpu->cd.mips.coproc[0]->tlbs[0].mask & PAGEMASK_MASK;  */
2104:
2105:				// Actually, the R10000 manual says:
2106:				// "When either a TLB refill, TLB invalid, or TLB modified exception occurs, the
2107:				//  EntryHi register is loaded with the virtual page number (VPN2) and the ASID of
2108:				//  the virtual address that did not have a matching TLB entry."
2109:				// Strange that it does not mention the 2 top bits (R).
2110:				//
2111:				// However, the MIPS64 manual says:
2112:				// "A TLB exception (TLB Refill, XTLB Refill, TLB Invalid, or TLB Modified) causes
2113:				//  the bits of the virtual address corresponding to the R and VPN2 fields to be
2114:				//  written into the EntryHi register."
2115:
2116:				if ((reg[COP0_ENTRYHI] & ENTRYHI_ASID) != (uint32_t)vaddr_asid)
2117:					fatal("[ huh? vaddr_asid 0x%02x not same as in ENTRYHI 0x%02x ]\n",
2118:						vaddr_asid, reg[COP0_ENTRYHI] & ENTRYHI_ASID);
2119:
2120:				if (cpu->cd.mips.cpu_type.mmu_model == MMU10K)
2121:					reg[COP0_ENTRYHI] = (vaddr & (ENTRYHI_R_MASK | ENTRYHI_VPN2_MASK_R10K)) | vaddr_asid;
2122:				else
2123:					reg[COP0_ENTRYHI] = (vaddr & (ENTRYHI_R_MASK | ENTRYHI_VPN2_MASK)) | vaddr_asid;
2124:			}
2125:		}
2126:	}
2127:
2128:	if (exc_model != EXC3K && reg[COP0_STATUS] & STATUS_EXL) {
2129:		/*
2130:		 *  Don't set EPC if STATUS_EXL is set, for R4000 and up.
2131:		 *  This actually happens when running IRIX and Ultrix, when
2132:		 *  they handle interrupts and/or tlb updates, I think, so
2133:		 *  printing this with debug() looks better than with fatal().
2134:		 */
2135:		/*  debug("[ warning: cpu%i exception while EXL is set,"
2136:		    " not setting EPC ]\n", cpu->cpu_id);  */
2137:	} else {
2138:		if (cpu->delay_slot) {
2139:			reg[COP0_EPC] = cpu->pc - 4;
2140:			reg[COP0_CAUSE] |= CAUSE_BD;
2141:		} else {
2142:			reg[COP0_EPC] = cpu->pc;
2143:			reg[COP0_CAUSE] &= ~CAUSE_BD;
2144:		}
2145:	}
2146:
2147:	if (cpu->delay_slot)
2148:		cpu->delay_slot = EXCEPTION_IN_DELAY_SLOT;
2149:	else
2150:		cpu->delay_slot = NOT_DELAYED;
2151:
2152:	/*  #210: (Codex/Fable) emit the exception on the trappable
2153:	    SUBSYS_EXCEPTION channel (MIPS was the only major CPU not doing so)
2154:	    with the fault signature now fully set -- lets `break exception`
2155:	    stop inside the TLB-miss path that the -p PC breakpoint cannot
2156:	    reach. Cheap: debugmsg early-returns when nothing is armed.  */
2157:	debugmsg_cpu(cpu, SUBSYS_EXCEPTION, exception_names[exccode],
2158:	    (exccode == EXCEPTION_ADEL || exccode == EXCEPTION_ADES ||
2159:	     exccode == EXCEPTION_RI || exccode == EXCEPTION_CPU)?
2160:	    VERBOSITY_WARNING : VERBOSITY_DEBUG,
2161:	    "epc=0x%" PRIx64 " vaddr=0x%" PRIx64 " cause=0x%" PRIx64,
2162:	    (uint64_t)reg[COP0_EPC], (uint64_t)vaddr, (uint64_t)reg[COP0_CAUSE]);
2163:
2164:	/*  TODO: This is true for MIPS64, but how about others?  */
2165:	if (reg[COP0_STATUS] & STATUS_BEV)
150:			cpu->running = 0;				\
1799:	if (!single_step_breakpoint && !cpu->translation_readahead) {
1857:#ifdef DYNTRANS_TO_BE_TRANSLATED_TAIL
1917:	if (cpu->translation_readahead)
1944:		cpu->translation_readahead = MAX_DYNTRANS_READAHEAD;
1948:		    cpu->translation_readahead > 0) {
1963:			cpu->translation_readahead --;
1967:		cpu->translation_readahead = 0;
1983:bad:	/*
1990:	if (cpu->translation_readahead)
2014:	cpu->running = 0;
2036:#endif	/*  DYNTRANS_TO_BE_TRANSLATED_TAIL  */
