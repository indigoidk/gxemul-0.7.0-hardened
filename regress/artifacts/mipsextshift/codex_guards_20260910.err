src/cpus/cpu_mips.c:85: *
src/cpus/cpu_mips.c:86: *  Returns 1 on success, 0 if there was no valid MIPS processor with
src/cpus/cpu_mips.c:87: *  a matching name.
src/cpus/cpu_mips.c:88: */
src/cpus/cpu_mips.c:89:int mips_cpu_new(struct cpu *cpu, struct memory *mem, struct machine *machine,
src/cpus/cpu_mips.c:90:	int cpu_id, char *cpu_type_name)
src/cpus/cpu_mips.c:91:{
src/cpus/cpu_mips.c:92:	int i, found, j, tags_size, n_cache_lines, size_per_cache_line;
src/cpus/cpu_mips.c:93:	struct mips_cpu_type_def cpu_type_defs[] = MIPS_CPU_TYPE_DEFS;
src/cpus/cpu_mips.c:94:	int x, linesize;
src/cpus/cpu_mips.c:95:
src/cpus/cpu_mips.c:96:	/*  Scan the cpu_type_defs list for this cpu type:  */
src/cpus/cpu_mips.c:97:	i = 0;
src/cpus/cpu_mips.c:98:	found = -1;
src/cpus/cpu_mips.c:99:	while (i >= 0 && cpu_type_defs[i].name != NULL) {
src/cpus/cpu_mips.c:100:		if (strcasecmp(cpu_type_defs[i].name, cpu_type_name) == 0) {
src/cpus/cpu_mips.c:101:			found = i;
src/cpus/cpu_mips.c:102:			break;
src/cpus/cpu_mips.c:103:		}
src/cpus/cpu_mips.c:104:		i++;
src/cpus/cpu_mips.c:105:	}
src/cpus/cpu_mips.c:106:
src/cpus/cpu_mips.c:107:	if (found == -1)
src/cpus/cpu_mips.c:108:		return 0;
src/cpus/cpu_mips.c:109:
src/cpus/cpu_mips.c:110:	cpu->memory_rw                = mips_memory_rw;
src/cpus/cpu_mips.c:111:	cpu->cd.mips.cpu_type         = cpu_type_defs[found];
src/cpus/cpu_mips.c:112:	cpu->name                     = strdup(cpu->cd.mips.cpu_type.name);
src/cpus/cpu_mips.c:113:	cpu->byte_order               = EMUL_LITTLE_ENDIAN;
src/cpus/cpu_mips.c:114:	cpu->cd.mips.gpr[MIPS_GPR_SP] = INITIAL_STACK_POINTER;
src/cpus/cpu_mips.c:115:
src/cpus/cpu_mips.c:116:	if (cpu->cd.mips.cpu_type.isa_level <= 2 ||
src/cpus/cpu_mips.c:117:	    cpu->cd.mips.cpu_type.isa_level == 32)
src/cpus/cpu_mips.c:118:		cpu->is_32bit = 1;
src/cpus/cpu_mips.c:119:
src/cpus/cpu_mips.c:120:	if (cpu->is_32bit) {
src/cpus/cpu_mips.c:121:		cpu->run_instr = mips32_run_instr;
src/cpus/cpu_mips.c:122:		cpu->update_translation_table = mips32_update_translation_table;
src/cpus/cpu_mips.c:123:		cpu->invalidate_translation_caches =
src/cpus/cpu_mips.c:124:		    mips32_invalidate_translation_caches;
src/cpus/cpu_mips.c:125:		cpu->invalidate_code_translation =
src/cpus/cpu_mips.c:126:		    mips32_invalidate_code_translation;
src/cpus/cpu_mips.c:127:	} else {
src/cpus/cpu_mips.c:128:		cpu->run_instr = mips_run_instr;
src/cpus/cpu_mips.c:129:		cpu->update_translation_table = mips_update_translation_table;
src/cpus/cpu_mips.c:130:		cpu->invalidate_translation_caches =
src/cpus/cpu_mips.c:131:		    mips_invalidate_translation_caches;
src/cpus/cpu_mips.c:132:		cpu->invalidate_code_translation =
src/cpus/cpu_mips.c:133:		    mips_invalidate_code_translation;
src/machines/machine_test.c:299:MACHINE_SETUP(baremips)
src/machines/machine_test.c:300:{
src/machines/machine_test.c:301:	machine->machine_name = strdup("Generic \"bare\" MIPS machine");
src/machines/machine_test.c:302:	cpu->byte_order = EMUL_BIG_ENDIAN;
src/machines/machine_test.c:303:}
src/machines/machine_test.c:304:
src/machines/machine_test.c:305:
src/machines/machine_test.c:306:MACHINE_SETUP(testmips)
src/machines/machine_test.c:307:{
src/machines/machine_test.c:308:	/*
src/machines/machine_test.c:309:	 *  A MIPS test machine. Originally, this was created as a way for
src/machines/machine_test.c:310:	 *  me to test my master's thesis code; since then it has both
src/machines/machine_test.c:311:	 *  evolved to support new things, and suffered bit rot so that it
src/machines/machine_test.c:312:	 *  no longer can run my thesis code. Well, well...
src/machines/machine_test.c:313:	 *
src/machines/machine_test.c:314:	 *  IRQ map:
src/machines/machine_test.c:315:	 *      7       CPU counter
src/machines/machine_test.c:316:	 *      6       SMP IPIs
src/machines/machine_test.c:317:	 *      5       not used yet
src/machines/machine_test.c:318:	 *      4       rtc
src/machines/machine_test.c:319:	 *      3       ethernet  
src/machines/machine_test.c:320:	 *      2       serial console
src/machines/machine_test.c:321:	 */
src/machines/machine_test.c:322:
src/machines/machine_test.c:323:	char tmpstr[300];
src/machines/machine_test.c:324:
src/machines/machine_test.c:325:	machine->machine_name = strdup("MIPS test machine");
src/machines/machine_test.c:326:	cpu->byte_order = EMUL_BIG_ENDIAN;
src/machines/machine_test.c:327:
src/machines/machine_test.c:328:	snprintf(tmpstr, sizeof(tmpstr), "cons addr=0x%" PRIx64" irq=%s."
src/machines/machine_test.c:329:	    "cpu[%i].2", (uint64_t) DEV_CONS_ADDRESS, machine->path,
src/machines/machine_test.c:330:	    machine->bootstrap_cpu);
src/machines/machine_test.c:397:		dev_ram_init(machine, 0x50000000ULL,
src/machines/machine_test.c:398:		    ((uint64_t) machine->physical_ram_in_mb - 256) * 1048576,
src/machines/machine_test.c:399:		    DEV_RAM_RAM, 0x0, "ram_high");
src/machines/machine_test.c:400:	}
src/machines/machine_test.c:401:}
src/machines/machine_test.c:402:
src/machines/machine_test.c:403:
src/machines/machine_test.c:404:MACHINE_DEFAULT_CPU(baremips)
src/machines/machine_test.c:405:{
src/machines/machine_test.c:406:	machine->cpu_name = strdup("5KE");
src/machines/machine_test.c:407:}
src/machines/machine_test.c:408:
src/machines/machine_test.c:409:
src/machines/machine_test.c:410:MACHINE_DEFAULT_CPU(testmips)
src/machines/machine_test.c:411:{
src/machines/machine_test.c:412:	machine->cpu_name = strdup("5KE");
src/machines/machine_test.c:413:}
src/machines/machine_test.c:414:
src/machines/machine_test.c:415:
src/machines/machine_test.c:416:MACHINE_REGISTER(baremips)
src/machines/machine_test.c:417:{
src/machines/machine_test.c:418:	MR_DEFAULT(baremips, "Generic \"bare\" MIPS machine",
src/machines/machine_test.c:419:	    MACHINE_BAREMIPS);
src/machines/machine_test.c:420:
src/machines/machine_test.c:421:	machine_entry_add_alias(me, "baremips");
src/machines/machine_test.c:422:}
src/machines/machine_test.c:423:
src/machines/machine_test.c:424:
src/machines/machine_test.c:425:MACHINE_REGISTER(testmips)
src/machines/machine_test.c:426:{
src/machines/machine_test.c:427:	MR_DEFAULT(testmips, "Test-machine for MIPS",
src/machines/machine_test.c:428:	    MACHINE_TESTMIPS);
src/machines/machine_test.c:429:
src/machines/machine_test.c:430:	machine_entry_add_alias(me, "testmips");
src/machines/machine_test.c:431:}
src/machines/machine_test.c:432:
src/machines/machine_vocore.c:43:MACHINE_SETUP(vocore)
src/machines/machine_vocore.c:44:{
src/machines/machine_vocore.c:45:	machine->machine_name = strdup("VoCore");
src/machines/machine_vocore.c:46:
src/machines/machine_vocore.c:47:	machine->emulated_hz = 360000000;
src/machines/machine_vocore.c:48:
src/machines/machine_vocore.c:49:	/*  Some devices mentioned in the Linux kernel (as shown using strings):
src/machines/machine_vocore.c:50:
src/machines/machine_vocore.c:51:		i/palmbus@10000000/spi@b00
src/machines/machine_vocore.c:52:		n/palmbus@10000000/spi@b40
src/machines/machine_vocore.c:53:		s/palmbus@10000000/uartlite@c00
src/machines/machine_vocore.c:54:		palmbus@10000000
src/machines/machine_vocore.c:55:		timer@100
src/machines/machine_vocore.c:56:		ethernet@10100000
src/machines/machine_vocore.c:57:		esw@10110000
src/machines/machine_vocore.c:58:		wmac@10180000
src/machines/machine_vocore.c:59:		ehci@101c0000
src/machines/machine_vocore.c:60:		ohci@101c1000
src/machines/machine_vocore.c:61:	*/
src/machines/machine_vocore.c:62:
src/machines/machine_vocore.c:63:	device_add(machine, "palmbus addr=0x10000000");
src/machines/machine_vocore.c:64:
src/machines/machine_vocore.c:65:	if (!machine->prom_emulation)
src/machines/machine_vocore.c:66:		return;
src/machines/machine_vocore.c:67:
src/machines/machine_vocore.c:68:	// TODO: uboot emulation?
src/machines/machine_vocore.c:69:}
src/machines/machine_vocore.c:70:
src/machines/machine_vocore.c:71:
src/machines/machine_vocore.c:72:MACHINE_DEFAULT_CPU(vocore)
src/machines/machine_vocore.c:73:{
src/machines/machine_vocore.c:74:	// According to http://vocore.io/v1d.html: RT5350, 360 MHz, MIPS 24K
src/machines/machine_vocore.c:75:	// According to Linux booting on my real machine:
src/machines/machine_vocore.c:76:	//	CPU revision is: 0001964c (MIPS 24KEc)
src/machines/machine_vocore.c:77:	//	Primary instruction cache 32kB, VIPT, 4-way, linesize 32 bytes.
src/machines/machine_vocore.c:78:	//	Primary data cache 16kB, 4-way, VIPT, no aliases, linesize 32 bytes
src/machines/machine_vocore.c:79:	machine->cpu_name = strdup("24KEc");
src/machines/machine_vocore.c:80:}
src/machines/machine_vocore.c:81:
src/machines/machine_vocore.c:82:
src/machines/machine_vocore.c:83:MACHINE_DEFAULT_RAM(vocore)
src/machines/machine_vocore.c:84:{
src/machines/machine_vocore.c:85:	machine->physical_ram_in_mb = 32;
src/machines/machine_vocore.c:86:}
src/machines/machine_vocore.c:87:
src/machines/machine_vocore.c:88:
src/machines/machine_vocore.c:89:MACHINE_REGISTER(vocore)
src/machines/machine_vocore.c:90:{
src/machines/machine_vocore.c:91:	MR_DEFAULT(vocore, "VoCore", MACHINE_VOCORE);
src/machines/machine_vocore.c:92:
src/machines/machine_vocore.c:93:	machine_entry_add_alias(me, "vocore");
src/machines/machine_vocore.c:94:
src/machines/machine_vocore.c:95:	me->set_default_ram = machine_default_ram_vocore;
src/machines/machine_vocore.c:96:}
src/machines/machine_vocore.c:97:
src/machines/machine_vocore.c:98:
doc/experiments.html:68:	<a href="http://gcc.gnu.org/">GCC</a> is usually a good compiler
doc/experiments.html:69:	choice, because it is portable and in wide-spread use.
doc/experiments.html:70:	(Other compilers should work too.)
doc/experiments.html:71:  <p>
doc/experiments.html:72:  <li>Compile the Hello World demo program for your chosen target, and run 
doc/experiments.html:73:	it in the emulator.
doc/experiments.html:74:</ul>
doc/experiments.html:75:
doc/experiments.html:76:<p>The Hello World demo program is included in the GXemul source
doc/experiments.html:77:code distribution, in the <a href="../demos/hello/"><tt>demos/hello/</tt></a>
doc/experiments.html:78:subdirectory. The README files in the demo directories have several 
doc/experiments.html:79:examples of how the demo programs can be built.
doc/experiments.html:80:
doc/experiments.html:81:<p>Once you have compiled the Hello World program into a binary,
doc/experiments.html:82:<tt>hello_mips</tt>, start it like this:
doc/experiments.html:83:<pre>
doc/experiments.html:84:	<b>gxemul -E testmips hello_mips</b>
doc/experiments.html:85:</pre>
doc/experiments.html:86:
doc/experiments.html:87:<p>Then you can experiment using the commands further up on this page.
doc/experiments.html:88:
doc/experiments.html:89:<p>If you start the emulator in the paused state, or if you press CTRL-C 
doc/experiments.html:90:during normal execution, you will end up with a <tt><b>GXemul></b></tt> 
doc/experiments.html:113:
doc/experiments.html:114:<p>Here are some examples of guest OSes that use or (have used) the test machine modes:
doc/experiments.html:115:
doc/experiments.html:116:<p>
doc/experiments.html:117:<ul>
doc/experiments.html:118:	<li><p><a name="helenos">HelenOS:</a>
doc/experiments.html:119:		<br>Old versions of <a href="http://www.helenos.org/">HelenOS</a> can run in GXemul's
doc/experiments.html:120:			<tt>testarm</tt> and <tt>testmips</tt> machine modes.<pre>
doc/experiments.html:121:	<b>ftp <a href="http://www.helenos.org/releases/HelenOS-0.5.0-arm32-GXemul.boot">http://www.helenos.org/releases/HelenOS-0.5.0-arm32-GXemul.boot</a></b>
doc/experiments.html:122:  	<b>gxemul -X -E testarm HelenOS-0.5.0-arm32-GXemul.boot</b>
