  681: 			if (writeflag == MEM_READ) {
  682: 				/*  Return all zeroes? (Or 0xff? TODO)  */
  683: 				memset(data, 0, len);
  684: 
  685: #if 0
  686: /*
  687:  *  NOTE: This code prevents a PROM image from a real 5000/200 from booting.
