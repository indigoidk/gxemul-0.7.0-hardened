 1491:  *  Update the virtual memory translation tables.
 1492:  */
 1493: void DYNTRANS_UPDATE_TRANSLATION_TABLE(struct cpu *cpu, uint64_t vaddr_page,
 1494: 	unsigned char *host_page, int writeflag, uint64_t paddr_page)
 1495: {
 1496: 	int found, r, useraccess = 0;
 1497: 
 1498: #ifdef MODE32
 1499: 	uint32_t index;
 1500: 	vaddr_page &= 0xffffffffULL;
 1501: 
 1502: 	if (paddr_page > 0xffffffffULL) {
 1503: 		fatal("update_translation_table(): v=0x%016" PRIx64", h=%p w=%i"
 1504: 		    " p=0x%016" PRIx64"\n", vaddr_page, host_page, writeflag,
 1505: 		    paddr_page);
 1506: 		exit(1);
 1507: 	}
 1508: 
 1509: 	/*  fatal("update_translation_table(): v=0x%x, h=%p w=%i"
 1510: 	    " p=0x%x\n", (int)vaddr_page, host_page, writeflag,
 1511: 	    (int)paddr_page);  */
 1512: #else	/*  !MODE32  */
 1513: 	const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
 1514: 	const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
 1515: 	const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
 1516: 	uint32_t x1, x2, x3;
 1517: 	struct DYNTRANS_L2_64_TABLE *l2;
 1518: 	struct DYNTRANS_L3_64_TABLE *l3;
