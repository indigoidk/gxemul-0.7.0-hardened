 1520: 	/*  fatal("update_translation_table(): v=0x%016" PRIx64", h=%p w=%i"
 1521: 	    " p=0x%016" PRIx64"\n", (uint64_t)vaddr_page, host_page, writeflag,
 1522: 	    (uint64_t)paddr_page);  */
 1523: #endif
 1524: 
 1525: 	assert((vaddr_page & (DYNTRANS_PAGESIZE-1)) == 0);
 1526: 	assert((paddr_page & (DYNTRANS_PAGESIZE-1)) == 0);
 1527: 
 1528: 	if (writeflag & MEMORY_USER_ACCESS) {
 1529: 		writeflag &= ~MEMORY_USER_ACCESS;
 1530: 		useraccess = 1;
 1531: 	}
 1532: 
 1533: 	(void)useraccess;  // shut up compiler warning about unused var
 1534: 
 1535: #ifdef DYNTRANS_M88K
 1536: 	/*  TODO  */
 1537: 	if (useraccess)
 1538: 		return;
 1539: #endif
 1540: 
 1541: 	/*  Scan the current TLB entries:  */
 1542: 
 1543: #ifdef MODE32
 1544: 	/*
 1545: 	 *  NOTE 1: vaddr_to_tlbindex is one more than the index, so that
 1546: 	 *          0 becomes -1, which means a miss.
 1547: 	 *
 1548: 	 *  NOTE 2: When a miss occurs, instead of scanning the entire tlb
 1549: 	 *          for the entry with the lowest time stamp, just choosing
 1550: 	 *          one at random will work as well.
 1551: 	 */
 1552: 	found = (int)cpu->cd.DYNTRANS_ARCH.vaddr_to_tlbindex[
 1553: 	    DYNTRANS_ADDR_TO_PAGENR(vaddr_page)] - 1;
 1554: #else
 1555: 	x1 = (vaddr_page >> (64-DYNTRANS_L1N)) & mask1;
 1556: 	x2 = (vaddr_page >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
 1557: 	x3 = (vaddr_page >> (64-DYNTRANS_L1N-DYNTRANS_L2N-DYNTRANS_L3N))
 1558: 	    & mask3;
 1559: 
 1560: 	l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
 1561: 	if (l2 == cpu->cd.DYNTRANS_ARCH.l2_64_dummy)
 1562: 		found = -1;
 1563: 	else {
 1564: 		l3 = l2->l3[x2];
 1565: 		if (l3 == cpu->cd.DYNTRANS_ARCH.l3_64_dummy)
 1566: 			found = -1;
 1567: 		else
 1568: 			found = (int)l3->vaddr_to_tlbindex[x3] - 1;
 1569: 	}
 1570: #endif
 1571: 
 1572: 	if (found < 0) {
 1573: 		/*  Create the new TLB entry, overwriting a "random" entry:  */
 1574: 		static unsigned int x = 0;
 1575: 		r = (x++) % DYNTRANS_MAX_VPH_TLB_ENTRIES;
 1576: 
 1577: 		if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid) {
 1578: 			/*  This one has to be invalidated first:  */
 1579: 			DYNTRANS_INVALIDATE_TLB_ENTRY(cpu,
 1580: 			    cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
 1581: 			    0);
 1582: 		}
 1583: 
 1584: 		cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid = 1;
