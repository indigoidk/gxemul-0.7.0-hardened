  173: OP_SB_T0_A3 = 0xa0e80000          # sb   $t0, 0($a3)   -- narrow, fires a _LEN latch
  174: OP_SW_T0_A3 = 0xace80000          # sw   $t0, 0($a3)
  175: OP_SD_T0_A3 = 0xfce80000          # sd   $t0, 0($a3)
