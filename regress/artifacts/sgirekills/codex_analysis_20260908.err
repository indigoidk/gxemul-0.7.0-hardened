  132:  ("tlb_a",    0xb5001000, "re_tlb_a",    0x000, 0, 0x1f8, 252, "hw"),
  133:  ("tlb_b",    0xb5001200, "re_tlb_b",    0x000, 0, 0x1f8, 252, "hw"),
