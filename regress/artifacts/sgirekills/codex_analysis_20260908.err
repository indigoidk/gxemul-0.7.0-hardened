  181: #  *** THE NAME COLUMN HAS ZERO MARGIN LEFT.  MEASURED 2026-09-08, before commit. ***
  182: #
  183: #  Rows print as %-18s, and gate_arm.sh matches each by name with the pattern
  184: #      count "$SGILOG" "^$v  .*ok$"
  185: #  -- caret, the name, TWO SPACES.  So a name may be at most 16 characters.  **The longest name in
  186: #  this probe is exactly 16** (`linear_a sw surv`, `linear_b sw surv`, `linear_a lw surv`,
  187: #  `linear_b lw surv`).  ONE more character and that gate row becomes
  188: #  UNSATISFIABLE and the row SILENTLY STOPS BEING TESTED -- the padded-column class, which this
  189: #  project has already paid for once.
  190: #
  191: #  A new row therefore needs <= 16 characters, or the %-18s here and the pattern in the gate must
  192: #  both widen, in the same commit.  The check that catches it is one command against a real run:
  193: #  compare the gate name list with the names actually emitted, both directions.
  194: def row(name, got, want, note=""):
  195:     ok = (got == want)
  196:     rows.append((name, ok))
  197:     print("%-18s %-12s %-12s %-46s %s" % (name, str(got), str(want), note,
  198:                                           "ok" if ok else "FAIL"))
  199:     return ok
  200: 
  201: def session(cmds, settle=1.5, spin=1.2):
  202:     pid, fd = pty.fork()
  203:     if pid == 0:
  204:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
  205:                        "0x80001000:" + DUMMY])
  206:         os._exit(127)
  207:     buf = ""
  208:     def rd(t):
  209:         nonlocal buf
  210:         end = time.time() + t
  211:         while time.time() < end:
  212:             r, _, _ = select.select([fd], [], [], 0.1)
  213:             if not r:
  214:                 continue
  215:             try:
  216:                 d = os.read(fd, 65536)
  217:                 if not d:
  218:                     return False
  219:                 buf += d.decode("latin-1", "replace")
  220:             except OSError:
  221:                 return False
  222:         return True
  223:     alive = rd(settle)
  224:     for i, c in enumerate(cmds):
  225:         try:
  226:             os.write(fd, (c + "\n").encode("latin-1"))
  227:         except OSError:
  228:             alive = False
  229:             break
  230:         if not rd(spin if i == len(cmds) - 1 else 0.25):
  231:             alive = False
  232:             break
  233:     try:
  234:         os.write(fd, b"quit\n"); rd(0.4)
  235:     except OSError:
  236:         pass
  237:     try:
  238:         os.close(fd)
  239:     except OSError:
  240:         pass
  241:     how = "nostatus"
  242:     try:
  243:         _, stat = os.waitpid(pid, 0)
  244:         if os.WIFSIGNALED(stat):
  245:             how = "sig%d" % os.WTERMSIG(stat)
  246:         elif os.WIFEXITED(stat):
  247:             how = "exit%d" % os.WEXITSTATUS(stat)
  248:     except OSError:
  249:         pass
  250:     return buf.replace("\r", ""), alive, how
  251: 
  252: def printed(t, reg):
  253:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  254:     if not m:
  255:         return "absent"
  256:     #  Normalise width: a 64-bit register may print sign/zero-extended, and a
  257:     #  row comparing raw strings would then fail on formatting rather than on
  258:     #  behaviour.
  259:     return "0x%x" % int(m.group(1), 16)
  260: 
  261: class Addr(object):
  262:     def __init__(self, base): self.a = base
  263:     def take(self, n):
  264:         got = self.a; self.a += 4 * (n + 2) + 0x20; return got
  265: 
  266: def run_ops(ops, at):
  267:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
  268:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
  269:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
  270:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
  271: 
  272: def store(A, addr, op=OP_SW_T0_A3, val="0x12345678"):
  273:     return ["a3=0x%x" % addr, "t0=%s" % val] + run_ops([op], A.take(1))
  274: 
  275: #  THE DESTINATION REGISTER IS PRESET TO A SENTINEL, NOT TO 0.
  276: #  Preset to 0 the row cannot tell "the common tail ran and wrote odata (0)"
  277: #  from "the load never completed at all" -- both leave v0 == 0.  With a
  278: #  sentinel the two separate: a declined read that reaches the tail yields 0,
  279: #  and a read that faulted or never landed yields the sentinel.
  280: SENTINEL = 0xdeadbeef
  281: 
  282: def load(A, addr, op=OP_LW_V0_AT):
  283:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
  284: 
  285: print("#497 widthkillclass DETECTOR -- binary=%s label=%s" % (BIN, LABEL))
  286: print("%-18s %-12s %-12s %-46s %s" % ("row", "got", "want", "note", ""))
  287: 
  288: # ------------------------------------------------ controls / identity  (c)
  289: A = Addr(CODE)
  290: t, alive, how = session(store(A, SCRATCH_RAM) + load(A, SCRATCH_RAM)
  291:                         + ["print v0"])
  292: row("live", printed(t, "v0") if alive else "died", "0x%x" % LIVE_VAL,
  293:     "LIVENESS: guest store then load, through RAM")
  294: 
  295: #  *** THE 64-BIT LIVENESS CONTROL, AND IT IS NOT DECORATION. ***  Every re-pinned
  296: #  ACCEPT row below asserts a 64-bit value read back through `print v0'.  On the
  297: #  COMMITTED build all of those rows DIE at the load, so a pre-fix run cannot tell
  298: #  a correct want-string from a mis-formatted one -- the red is explained by the
  299: #  kill either way.  This row exercises the identical sd/ld/print path through RAM,
  300: #  where nothing kills, so the format is pinned BEFORE the fix rather than after.
  301: A = Addr(CODE)
  302: t, alive, how = session(store(A, SCRATCH_RAM, OP_SD_T0_A3, "0x%016x" % VAL_LO)
  303:                         + load(A, SCRATCH_RAM, OP_LD_V0_AT) + ["print v0"])
  304: row("live64", printed(t, "v0") if alive else "died", "0x%x" % VAL_LO,
  305:     "LIVENESS: 64-bit sd/ld through RAM -- pins the re-pin want format")
  306: 
  307: A = Addr(CODE)
  308: t, alive, how = session(load(A, DE_STATUS) + ["print v0"])
  309: row("devsig stat", printed(t, "v0") if alive else "died", DE_STAT_VAL,
  310:     "DEVSIG: CRIME_DE_STATUS reads 0x1e000000; RAM would read 0")
  311: 
  312: print("OPUS497T_CONTROL=%s" % ("OK" if all(o for _, o in rows) else "DEAD"))
  313: print("")
  314: 
  315: # ------------------------------------------------ per site x 6
  316: for nm, base, sym, acctext in SITES:
  317:     lit = decl(sym)
  318: 
  319:     # 1. a len=4 WRITE must be DECLINED, not fatal
  320:     A = Addr(CODE)
  321:     t, alive, how = session(store(A, base))
  322:     row(nm + " sw surv", how, "exit0", "len=4 WRITE declined, host survives")
  323: 
  324:     # 2. the latch: TWO declined accesses in ONE session -> exactly ONE message
  325:     A = Addr(CODE)
  326:     t, alive, how = session(store(A, base) + store(A, base + 4))
  327:     row(nm + " sw lat1", t.count(lit), 1,
  328:         "(once): COUNT over 2 accesses -- presence would pass unlatched")
  329: 
  330:     # 3. a len=4 READ must ALSO be declined.
  331:     #    NOTE: the width arm is evaluated BEFORE the read arm, so a len=4 read
  332:     #    takes the (now declining) width arm and never reaches the still-live
  333:     #    read kill.  An 8-byte read still dies -- see `ld readkill' below.
  334:     #    *** BOTH HALVES FALSE SINCE #513: the 8-byte read is ACCEPTED (or, at TEX,
  335:     #    declined), and `ld readkill' no longer exists -- it is `<arm> ld lo|hi'.
  336:     #    This row is what kills M1 (`len != 8 && writeflag == MEM_WRITE').
  337:     A = Addr(CODE)
  338:     t, alive, how = session(load(A, base) + ["print v0"])
  339:     got = how + "/" + (printed(t, "v0") if alive else "died")
  340:     row(nm + " lw surv", got, "exit0/0x0",
  341:         "declined READ reaches the tail and returns a DEFINED 0")
  342: 
  343:     # 4. ACCEPT side (de-escalation clause).  Offset +8 has bit 3 SET on
  344:     #    purpose: a `|| (relative_addr & 8)' growth must redden this.
  345:     A = Addr(CODE)
  346:     t, alive, how = session(store(A, base + 8, OP_SD_T0_A3, ACC_VAL))
  347:     row(nm + " accept", "1" if acctext in t else "0", "1",
  348:         "LEGAL len=8 write still lands (probed at +8, bit 3 set)")
  349: 
  350: # ------------------------------------------------ cross-site  (M2 + anchor)
  351: A = Addr(CODE)
  352: cmds = []
  353: for nm, base, sym, _a in SITES:
  354:     cmds += store(A, base)
  355: t, alive, how = session(cmds, spin=2.0)
  356: present = [decl(sym) for _n, _b, sym, _a in SITES]
  357: n_present = sum(1 for lit in present if t.count(lit) == 1)
  358: row("xsite 6msg", n_present, 6,
  359:     "six windows, ONE session: 6 distinct latches (kills bit collision)")
  360: 
  361: pos = [t.find(lit) for lit in present]
  362: ordered = all(p >= 0 for p in pos) and pos == sorted(pos)
  363: row("xsite order", "1" if ordered else "0", "1",
  364:     "ANCHOR: message order == the order the guest issued them")
  365: 
  366: # ------------------------------------------------ the read arms  (sgirekills)
  367: #
  368: #  *** RE-PINNED FOR sgirekills.  SIX DEATH-ONLY ROWS BECOME FOURTEEN. ***
  369: #
  370: #  THE OLD ROWS were `row(nm + " ld kill", how + txt, "exit1+txt")' -- they asserted
  371: #  that a len == 8 READ still ends the host at each of the six windows.  That was a
  372: #  true and useful pin while the kills stood.  It cannot survive the fix, which is
  373: #  exactly the situation the oracle-correction rule governs: the rows are re-pinned
  374: #  FIRST and the committed build is measured RED under the new expectations, and only
  375: #  then is the device edited.  Same script, opposite colour.
  376: #
  377: #  *** WHAT REPLACED THEM, AND WHY IT IS NOT THE OBVIOUS SET. ***  My first design was
  378: #  one row per window at the window BASE, plus a #499-style decline row for TEX.  The
  379: #  design panel refused it with two floor-shaped holes and one oracle this file had
  380: #  already measured wrong:
  381: #
  382: #    (1) THE FAR BOUND WAS UNPINNED.  An accept row at a window's base tests the near
  383: #        bound twice and the far bound never -- so a shrink of the window's upper limit
  384: #        is invisible to it.  #499 measured that on this same device.  Hence TWO rows
  385: #        per ACCEPT arm, base and LAST SLOT.
  386: #
  387: #    (2) A LOAD-ONLY TEX DECLINE ROW WOULD HAVE BEEN VACUOUS, and this is the sharp one.
  388: #        Such a row wants `v0 == 0'.  If a later round converts TEX to an ACCEPT, it will
  389: #        read back the ZEROED array and yield 0 as well -- so the row could not redden at
  390: #        the very edit it exists to catch.  The TEX rows therefore STORE a non-zero value
  391: #        first: an ACCEPT would return it, and the row goes red.
  392: #
  393: #    (3) `how == "exit0"' IS THE WRONG ORACLE and #499 measured why -- an exit(0)
  394: #        reinstatement prints its message and then dies, scoring green with the process
  395: #        dead.  NO RE-PINNED READ ROW below reads exit status.  (An earlier wording said
  396: #        "no row below", which is FALSE: the pre-existing `other decl' row DOES read `how'
  397: #        and wants `exit0/txt/0x0'.  That row is #499's and is out of scope here; the claim
  398: #        belongs to the rows this round re-pinned.)  SURVIVAL IS IMPLIED BY THE VALUE:
  399: #        a dead session cannot print one.
  400: #
  401: for nm, base, arr, lo_off, lo_i, hi_off, hi_i, kind in REPIN:
  402:     for tag, off, idx, val in (("lo", lo_off, lo_i, VAL_LO),
  403:                                ("hi", hi_off, hi_i, VAL_HI)):
  404:         A = Addr(CODE)
  405:         addr = base + off
  406:         t, alive, how = session(store(A, addr, OP_SD_T0_A3, "0x%016x" % val)
  407:                                 + load(A, addr, OP_LD_V0_AT) + ["print v0"])
  408:         anc = anchor(arr, idx, val, kind)
  409:         got = (printed(t, "v0") if alive else "died") + ("+anc" if anc in t else "-anc")
  410:         row("%s ld %s" % (nm, tag), got, "0x%x+anc" % val,
  411:             "ACCEPT %s[%i]: value round-trips AND the store names the cell" % (arr, idx))
  412: 
  413: #  *** TEX IS THE ONE ARM THAT IS NOT AN ACCEPT. ***  The other five windows have a
  414: #  write path that already computes and stores the value, so reading it back is the
  415: #  ACCEPT member of the option set.  TEX's read is DECLINED instead, and these four
  416: #  rows pin the decline rather than a value.  *** THE STORE-FIRST SHAPE FROM (2) ABOVE IS
  417: #  ON TWO OF THEM, NOT FOUR: `tex ld lo' and `tex ld hi' store a non-zero value before
  418: #  loading, so a future ACCEPT of TEX reddens THEM WITH ACCEPT-SPECIFIC EVIDENCE -- the stored
  419: #  non-zero comes back, which distinguishes an ACCEPT from a merely DELETED message.
  420: #
  421: #  *** THE SENTENCE THAT USED TO SIT HERE OVERSHOT, AND TWO SEATS CAUGHT IT INDEPENDENTLY
  422: #  (grok and kimi, pass 4).  It said `tex rd lat1' and `tex xbit' "would not redden on an
  423: #  ACCEPT".  FALSE: both oracle the decline-message COUNT (`1' and `1/11'), and an ACCEPT
  424: #  drives that count to 0, so BOTH GO RED.  What they cannot do is tell an ACCEPT from a
  425: #  deleted message -- that is the value pair's job.  The correction understated the
  426: #  detection surface, which is the same wrong-record class this round has been fixing,
  427: #  this time INSIDE a correction.  It does not reopen a collision cell. ***
  428: for tag, off in (("lo", 0x000), ("hi", TEX_HI_OFF)):
  429:     A = Addr(CODE)
  430:     addr = TEX_BASE + off
  431:     val = VAL_LO if tag == "lo" else VAL_HI
  432:     t, alive, how = session(store(A, addr, OP_SD_T0_A3, "0x%016x" % val)
  433:                             + load(A, addr, OP_LD_V0_AT) + ["print v0"])
  434:     got = (printed(t, "v0") if alive else "died")
  435:     got += "+1msg" if t.count(TEX_RD_DECL) == 1 else "+%imsg" % t.count(TEX_RD_DECL)
  436:     row("tex ld " + tag, got, "0x0+1msg",
  437:         "DECLINE: reads 0 after a real store -- an ACCEPT would return the store")
  438: 
  439: #  THE LATCH: one announce per instance, not one per access.  Two reads at DIFFERENT
  440: #  offsets, so a latch keyed on the address rather than on the arm also reddens.
  441: A = Addr(CODE)
  442: t, alive, how = session(load(A, TEX_BASE, OP_LD_V0_AT)
  443:                         + load(A, TEX_BASE + TEX_HI_OFF, OP_LD_V0_AT))
  444: row("tex rd lat1", "%i" % t.count(TEX_RD_DECL) if alive else "died", "1",
  445:     "LATCH: two TEX reads at two offsets announce exactly once")
  446: 
  447: #  *** THE CROSS-BIT ROW.  #498 measured a latch shared between two arms scoring 23/25,
  448: #  and #490 measured the same collision in another file, so it is pinned here BEFORE it
  449: #  can bite: fire all SIX width latches -- CRIME_RE_TEX's own included -- with narrow
  450: #  writes, then read TEX.  If the read decline is given an existing bit rather than its
  451: #  own, its message is already suppressed and this row reds. ***
  452: #  *** CLASS CLOSURE ON THE LATCH-COLLISION AXIS -- pass 3. ***
  453: #
  454: #  This row USED TO fire only the six width latches (bits 0-5), and pass 3 showed why that is
  455: #  not enough: the mutation operator is `SGIRE_W_TEX_RD := <an already-used bit>' ON THE EDITED
  456: #  LINE, so bits 6, 7, 9 and 10 were the SAME operator on the SAME line and swept by nothing.
  457: #  Pass 2 found the bit-8 cell; pass 3 found the rest.  TWO CONSECUTIVE PASSES FINDING ONE CLASS
  458: #  is the trigger for closing the whole space in one diff rather than one cell per pass.
  459: #
  460: #      bit  latch              fired here by
  461: #      ---  -----------------  ---------------------------------------------------------
  462: #       0-5 *_LEN x6           a narrow (byte) store to each of the six RE windows
  463: #       6   SGIRE_W_DE_LEN     a BYTE store to the DE window -- its accept set is {4,8}
  464: #       7   SGIRE_W_UNMAP_WR   a store to OUTSIDE
  465: #       8   SGIRE_W_UNMAP_RD   a load  from OUTSIDE
  466: #       9   SGIRE_W_PRIM_OP    an unimplemented drawing op stored to PRIMITIVE|START
  467: #      10   SGIRE_W_BADMODE    an unimplemented DST MODE driven through a real rectangle
  468: #
  469: #  *** THE CLASS IS CLOSED, AND BITS 9 AND 10 WERE MEASURED OPEN BEFORE THEY WERE CLOSED. ***
  470: #  An earlier form of this row fired bits 0-8 and DISCLOSED 9 and 10 as unreachable-in-session,
  471: #  on the ground that a TEX-read session never enters the drawing-engine path.  That disclosure
  472: #  was MEASURED rather than asserted -- `M_bit9' and `M_bit10' both scored 46/46, a clean escape
  473: #  (CLASSVERIFY.txt) -- and two seats had called a measured-open cell on the edited line a breach
  474: #  whatever the contract says.  They were right, and the disclosure was answering the wrong
  475: #  question: not "does a TEX session normally draw?" but "CAN one?"  It can, in six stores.
  476: #  The settling fact I had written down as unknown turned out to be one grep away, in a shipped
  477: #  probe that already drives this path.
  478: A = Addr(CODE)
  479: cmds = []
  480: for _nm, _b, _sym, _a in SITES:
  481:     cmds += store(A, _b, OP_SB_T0_A3, "0x1")          # bits 0-5
  482: cmds += store(A, DE_BASE, OP_SB_T0_A3, "0x1")         # bit 6
  483: cmds += store(A, OUTSIDE, OP_SB_T0_A3, "0x1")         # bit 7
  484: cmds += load(A, OUTSIDE, OP_LW_V0_AT)                 # bit 8
  485: #  *** THE SIX CALLS BELOW ONCE PASSED THEIR VALUE AS THE OPCODE. ***  `store()' is
  486: #  `store(A, addr, op=OP_SW_T0_A3, val="0x12345678")', so `store(A, DE_MODE_DST, MODE_LIN_B)'
  487: #  assembled MODE_LIN_B as an INSTRUCTION and wrote the default value to the register.  All six
  488: #  were wrong the same way, and **the row still scored 46/46**, because its oracle is only the TEX
  489: #  decline count -- which garbage stores do not disturb.  A row that passes while doing nothing it
  490: #  claims is exactly the vacuity the floor exists to prevent; it was caught by a reading seat, not
  491: #  by a measurement.  Pass the value as `val', never positionally as `op'.
  492: #
  493: #  bit 10 SGIRE_W_BADMODE -- an unimplemented DST MODE driven through a REAL rectangle, so
  494: #  horrible_getputpixel is actually entered.  The vertex pair is (0,0)-(0,3): the HEIGHT is what
  495: #  makes the primitive iterate, which sgi_re_randompixel_probe.py measured and documents.
  496: cmds += store(A, DE_MODE_DST, OP_SW_T0_A3, "0x%x" % MODE_LIN_B)
  497: cmds += store(A, DE_DRAWMODE, OP_SW_T0_A3, "0x%x" % DRAWMODE)
  498: cmds += store(A, DE_XVERT_0,  OP_SW_T0_A3, "0x0")
  499: cmds += store(A, DE_XVERT_1,  OP_SW_T0_A3, "0x3")
  500: cmds += store(A, DE_PRIM_ST,  OP_SW_T0_A3, "0x%x" % PRIM_RECT)
  501: #  bit 9 SGIRE_W_PRIM_OP -- an unimplemented drawing OP.  draw_primitive's switch rejects it
  502: #  before any pixel work, so this needs no vertex setup of its own.
  503: cmds += store(A, DE_PRIM_ST,  OP_SW_T0_A3, "0x%x" % PRIM_BAD)
  504: cmds += load(A, TEX_BASE, OP_LD_V0_AT)
  505: t, alive, how = session(cmds, spin=4.0)
  506: 
  507: #  *** THE ROW PROVES ITS OWN SETUP.  This is the repair for the defect that made it vacuous. ***
  508: #  Counting only the TEX decline cannot distinguish "ten latches fired and TEX still announced"
  509: #  from "the setup did nothing and TEX announced".  Both give 1.  So the row also reports HOW MANY
  510: #  of the other announces it actually saw, and wants ALL of them: a setup that silently fails --
  511: #  a mistyped call, a moved register, a changed message -- now REDS this row instead of passing it.
  512: SETUP_LIT = ([decl(sym) for _n, _b, sym, _a in SITES] +          # bits 0-5, the six *_LEN
  513:              ["[ sgi_de: unimplemented len=",                    # bit 6  DE_LEN
  514:               "unimplemented write to address 0x1800",           # bit 7  UNMAP_WR
  515:               "unimplemented read from address 0x1800",          # bit 8  UNMAP_RD
  516:               "UNIMPLEMENTED drawing op",                        # bit 9  PRIM_OP
  517:               "unimplemented dst_mode"])                         # bit 10 BADMODE
  518: fired = sum(1 for lit in SETUP_LIT if lit in t)
  519: row("tex xbit", "%i/%i" % (t.count(TEX_RD_DECL), fired) if alive else "died",
  520:     "1/%i" % len(SETUP_LIT),
  521:     "CROSSBIT: all 11 other latches PROVEN fired; TEX read still announces once")
  522: 
  523: A = Addr(CODE)
  524: #  *** RE-PINNED BY #499, WHICH REMOVED THIS KILL.  Three channels replace one, and
  525: #  BOTH of the obvious oracles were measured VACUOUS before this one was chosen. ***
  526: #
  527: #  THE OLD ROW was `row("other kill", how, "exit1")' -- DEATH-ONLY.  It observed THAT
  528: #  the catch-all killed, never WHICH kill it was, so a change to the message that left
  529: #  exit(1) standing passed: MEASURED 35/35 against a matched control at 34/35.  Filed
  530: #  as `otherkilldeath', and its own note prescribed the repair used here.
  531: #
  532: #  THE OBVIOUS RE-PIN, `how == "exit0"', IS WORSE, and this is the part that had to be
  533: #  built rather than argued.  A one-token reinstatement of the death as exit(0) prints
  534: #  the announce and then dies; exit status CANNOT distinguish "declined, then quit"
  535: #  from "died with status 0".  MEASURED, variant `mexit0': the exit0+txt oracle scores
  536: #  GREEN (how=exit0, txt=True) while alive=False.  Filed as `exit0oracle'.
  537: #
  538: #  SO THE ROW PINS THREE THINGS:
  539: #    how    the host survives the declined WRITE;
  540: #    txt    ONE CONTIGUOUS literal, address and data field included.  Two independent
  541: #           substring tests are a weaker claim: "-- declined." is emitted by the six
  542: #           #497 width declines and by #498's sgi_de decline as well, and this probe's
  543: #           own decl() helper exists because a bare substring cross-matches;
  544: #    v0     a declined READ REACHES THE COMMON TAIL and lands a DEFINED 0.  v0 is
  545: #           preset to SENTINEL by load(), so "wrote odata (0)" and "never landed" are
  546: #           distinguishable -- the same reason the `lw surv' rows carry it.  This is
  547: #           what kills `mret0' (return 0 -> memory_rw.c coerces to -1 -> EXCEPTION_DBE)
  548: #           and `mrdexit0' (exit(0) in the READ branch only), neither of which any
  549: #           write-only oracle can see.
  550: #
  551: #  ORDER PROOF: the new oracle was measured RED on the COMMITTED pre-#499 build BEFORE
  552: #  the code changed -- table500b.out, variant `base', got=exit1/notxt/died against
  553: #  want=exit0/txt/0x0.  And it is not fitted to the fix either: it was PRE-REGISTERED
  554: #  by #497 in commit 112867a (2026-08-30 22:41), six hours before #499's baseline
  555: #  3ded1e8, in the very note this comment replaces.
  556: #
  557: #  CONTRACT -- so a later escape is a breach or an exclusion, not an argument.  This
  558: #  row covers the catch-all's WRITE announce and the READ tail-return.  It does NOT
  559: #  pin the LATCH (one access per direction here, so first == only) nor the READ
  560: #  announce text.  Those live in sgi_re_unmapped_probe.py (`wr lat1', `rd lat1',
  561: #  `rd decl'), WHICH MUST BE GATE-WIRED -- unwired, that coverage exists nowhere. ***
  562: DECL_W = ("unimplemented write to address 0x1800, "
  563:           "data=0x0000000012345678 -- declined.  (once) ]")
  564: t, alive, how = session(store(A, OUTSIDE) + load(A, OUTSIDE) + ["print v0"])
  565: got = "%s/%s/%s" % (how, "txt" if t.count(DECL_W) == 1 else "notxt",
  566:                    printed(t, "v0") if alive else "died")
  567: row("other decl", got, "exit0/txt/0x0",
  568:     "#499: declines, announces once, declined read lands a defined 0")
  569: 
  570: #  *** L2 -- A FLOOR BREACH FOUND BY THE PASS-2 PANEL, REPAIRED IN-ROUND. ***
  571: #
  572: #  Clause (d)'s DEPENDS-ON closure includes `d->warned', and -- AT THE TIME OF PASS 2 --
  573: #  `tex xbit' swept the six *_LEN bits only.  (It now fires bits 0-10; see that row.  The
  574: #  past tense is deliberate: this paragraph records why the repair was needed.)  The panel named the escape and predicted its score: give the TEX
  575: #  read decline an ALREADY-USED NON-LEN bit --
  576: #
  577: #      SGIRE_W_TEX_RD = 1 << 11   ->   1 << 8   (= SGIRE_W_UNMAP_RD)
  578: #
  579: #  -- and the 44-row detector scores a CLEAN SWEEP, because its four TEX-read scenarios
  580: #  and its unmapped-read scenario NEVER SHARE AN EMULATOR INSTANCE.  `tex xbit' sets bits
  581: #  0-5, so bit 8 is clear in every session that reads TEX.  M10 established detection of a
  582: #  WIDTH-bit collision, not of every existing-bit collision.
  583: #
  584: #  The repair is a SAME-INSTANCE sequence in BOTH orderings: whichever announce fires
  585: #  first must not suppress the other.  One ordering alone would leave the mirror open --
  586: #  the `#499' shape, where a repair closes the cell the mutant used and leaves its twin.
  587: DECL_R = "unimplemented read from address 0x1800 -- declined.  (once) ]"
  588: 
  589: for nm, first, second in (("tex/unmap", TEX_BASE, OUTSIDE),
  590:                           ("unmap/tex", OUTSIDE, TEX_BASE)):
  591:     A = Addr(CODE)
  592:     t, alive, how = session(load(A, first, OP_LD_V0_AT) + load(A, second, OP_LD_V0_AT))
  593:     got = "%i/%i" % (t.count(TEX_RD_DECL), t.count(DECL_R)) if alive else "died"
  594:     row(nm, got, "1/1",
  595:         "LATCH INDEPENDENCE: both announces fire in ONE instance, either order")
  596: 
  597: ok = sum(1 for _, o in rows if o)
  598: print("")
  599: print("OPUS497T_RESULT=%d/%d" % (ok, len(rows)))
  600: print("OPUS497T_LABEL=%s" % LABEL)
  601: print("OPUS497T_DONE")

