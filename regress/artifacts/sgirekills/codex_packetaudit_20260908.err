1160-if ! grep -q "OPUS497T_DONE" "$SGILOG"; then
1161-    note "sgi_re width probe did not reach its completion sentinel; last lines follow"
--
1223-    check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
1224-
1225-fi
1226-
1227-#  ---- *** MOVED OUT ONE NESTING LEVEL, 2026-08-31.  It was pasted INSIDE the
1228:#  ---- sgi_re_width probe's success branch, so if THAT probe missed its sentinel this
1229-#  ---- block was never invoked at all -- 28 rows, three denominators and its own
1230-#  ---- sentinel check evaporating while the gate reported one red row about a
1231-#  ---- different probe.  Silent coverage loss, and it defeated the very sentence
1232-#  ---- that justified the block (a committed detector no gate runs is a wrong
1233-#  ---- record).  Both sibling blocks sit at depth 0; the block's own zero
--
1235-#  ---- into a branch.  Found by the #499 pass-2 seat walking the brace depth. ***
1236-#  ---- #499's detector for the unmatched-address catch-all.  Wired IN THE SAME COMMIT as
1237-#  ---- the fix: a committed detector that no gate runs is a wrong record under the vacuity
1238-#  ---- floor's contract clause, and this one measured 18/28 on the pre-fix build and 28/28
1239-#  ---- on the fix, so it carries its own test-first evidence.
1240:#  ---- the coordinator's file.  Modelled on the sgi_re_width_probe block -- find it
1241:#  ---- with `grep -n 'sgi_re_width_probe.py "$PMAX"' gate_arm.sh`, NOT by line
1242-#  ---- number: the original citation said :1131, which is inside the sgi_de comment,
1243-#  ---- and this block has since moved once already.  A same-file line citation is
1244-#  ---- invalidated by your own edits to that file.
1245-UNMLOG=$LOGDIR/sgi_re_unmapped.log
1246-python3 sgi_re_unmapped_probe.py "$PMAX" gate > "$UNMLOG" 2>&1 || true
