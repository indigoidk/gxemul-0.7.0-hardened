1195: /*
1196:  *  XXX_invalidate_translation_caches():
1197:  *
1198:  *  Invalidate all entries matching a specific physical address, a specific
1199:  *  virtual address, or ALL entries.
1200:  *
1201:  *  flags should be one of
1202:  *	INVALIDATE_PADDR  INVALIDATE_VADDR  or  INVALIDATE_ALL
1203:  *
1204:  *  In addition, for INVALIDATE_ALL, INVALIDATE_VADDR_UPPER4 may be set and
1205:  *  bit 31..28 of addr are used to select the virtual addresses to invalidate.
1206:  *  (This is useful for PowerPC emulation, when segment registers are updated.)
1207:  *
1208:  *  In the case when all translations are invalidated, paddr doesn't need
1209:  *  to be supplied.
1210:  *
1211:  *  NOTE/TODO: When invalidating a virtual address, it is only cleared from
1212:  *             the quick translation array, not from the linear
1213:  *             vph_tlb_entry[] array.  Hopefully this is enough anyway.
1214:  */
1215: void DYNTRANS_INVALIDATE_TC(struct cpu *cpu, uint64_t addr, int flags)
1216: {
1217: 	int r;
1218: #ifdef MODE32
1219: 	uint32_t
1220: #else
1221: 	uint64_t
1222: #endif
1223: 	    addr_page = addr & ~(DYNTRANS_PAGESIZE - 1);
1224: 
1225: 	/*  fatal("invalidate(): ");  */
1226: 
1227: 	/*  Quick case for _one_ virtual addresses: see note above.  */
1228: 	if (flags & INVALIDATE_VADDR) {
1229: 		/*  fatal("vaddr 0x%08x\n", (int)addr_page);  */
1230: 
1231: #ifdef MODE32
1232: 		DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, addr_page, flags);
1233: #else
1234: 		// In principle, there can be multiple entries, and they must
1235: 		// be invalidated based on the bits that matter. For example,
1236: 		// using vaddr 0x00A0000012345678 and 0x00B000001234567c
1237: 		// actually point to the same physical page, and if then
1238: 		// the virtual address 0x0000000012345000 is to be invalidated,
1239: 		// then both of those should be invalidated!
1240: 		int n = 0;
1241: 		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++)
1242: 			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid &&
1243: 			    (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page
1244: 			    & cpu->vaddr_mask) == (addr_page & cpu->vaddr_mask)) {
1245: 				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page, flags);
1246: 				n ++;
1247: 			}
1248: 
1249: 		if (n > 1)
1250: 			debug("[ DYNTRANS_INVALIDATE_TC: CACHE COLLISION vaddr 0x%016llx! ]\n",
1251: 				(long long)addr_page);
1252: #endif
1253: 
1254: 		return;
1255: 	}
1256: 
1257: 	/*  Invalidate everything:  */
1258: #ifdef DYNTRANS_PPC
1259: 	if (flags & INVALIDATE_ALL && flags & INVALIDATE_VADDR_UPPER4) {
1260: 		/*  fatal("all, upper4 (PowerPC segment)\n");  */
1261: 		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1262: 			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid &&
1263: 			    (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page
1264: 			    & 0xf0000000) == addr_page) {
1265: 				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.
1266: 				    DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1267: 				    0);
1268: 				// Not needed: DYNTRANS_INVALIDATE_TLB_ENTRY should
1269: 				// set valid to 0 anyway.
1270: 				// cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid=0;
1271: 			}
1272: 		}
1273: 		return;
1274: 	}
1275: #endif
1276: 	if (flags & INVALIDATE_ALL) {
1277: 		/*  fatal("all\n");  */
1278: 		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1279: 			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid) {
1280: 				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.
1281: 				    DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1282: 				    0);
1283: 				// Not needed: DYNTRANS_INVALIDATE_TLB_ENTRY should
1284: 				// set valid to 0 anyway.
1285: 				// cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid=0;
1286: 			}
1287: 		}
1288: 		return;
1289: 	}
