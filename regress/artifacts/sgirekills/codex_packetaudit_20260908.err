 346: 
 347: pos = [t.find(lit) for lit in present]
 348: ordered = all(p >= 0 for p in pos) and pos == sorted(pos)
 349: row("xsite order", "1" if ordered else "0", "1",
 350:     "ANCHOR: message order == the order the guest issued them")
 351: 
 352: # ------------------------------------------------ the read arms  (sgirekills)
 353: #
 354: #  *** RE-PINNED FOR sgirekills.  SIX DEATH-ONLY ROWS BECOME FOURTEEN. ***
 355: #
 356: #  THE OLD ROWS were `row(nm + " ld kill", how + txt, "exit1+txt")' -- they asserted
 357: #  that a len == 8 READ still ends the host at each of the six windows.  That was a
 358: #  true and useful pin while the kills stood.  It cannot survive the fix, which is
 359: #  exactly the situation the oracle-correction rule governs: the rows are re-pinned
 360: #  FIRST and the committed build is measured RED under the new expectations, and only
 361: #  then is the device edited.  Same script, opposite colour.
 362: #
 363: #  *** WHAT REPLACED THEM, AND WHY IT IS NOT THE OBVIOUS SET. ***  My first design was
 364: #  one row per window at the window BASE, plus a #499-style decline row for TEX.  The
 365: #  design panel refused it with two floor-shaped holes and one oracle this file had
 366: #  already measured wrong:
 367: #
 368: #    (1) THE FAR BOUND WAS UNPINNED.  An accept row at a window's base tests the near
 369: #        bound twice and the far bound never -- so a shrink of the window's upper limit
 370: #        is invisible to it.  #499 measured that on this same device.  Hence TWO rows
 371: #        per ACCEPT arm, base and LAST SLOT.
 372: #
 373: #    (2) A LOAD-ONLY TEX DECLINE ROW WOULD HAVE BEEN VACUOUS, and this is the sharp one.
 374: #        Such a row wants `v0 == 0'.  If a later round converts TEX to an ACCEPT, it will
 375: #        read back the ZEROED array and yield 0 as well -- so the row could not redden at
 376: #        the very edit it exists to catch.  The TEX rows therefore STORE a non-zero value
 377: #        first: an ACCEPT would return it, and the row goes red.
 378: #
 379: #    (3) `how == "exit0"' IS THE WRONG ORACLE and #499 measured why -- an exit(0)
 380: #        reinstatement prints its message and then dies, scoring green with the process
 381: #        dead.  NO RE-PINNED READ ROW below reads exit status.  (An earlier wording said
 382: #        "no row below", which is FALSE: the pre-existing `other decl' row DOES read `how'
 383: #        and wants `exit0/txt/0x0'.  That row is #499's and is out of scope here; the claim
 384: #        belongs to the rows this round re-pinned.)  SURVIVAL IS IMPLIED BY THE VALUE:
 385: #        a dead session cannot print one.
 386: #
 387: for nm, base, arr, lo_off, lo_i, hi_off, hi_i, kind in REPIN:
 388:     for tag, off, idx, val in (("lo", lo_off, lo_i, VAL_LO),
 389:                                ("hi", hi_off, hi_i, VAL_HI)):
 390:         A = Addr(CODE)
 391:         addr = base + off
 392:         t, alive, how = session(store(A, addr, OP_SD_T0_A3, "0x%016x" % val)
 393:                                 + load(A, addr, OP_LD_V0_AT) + ["print v0"])
 394:         anc = anchor(arr, idx, val, kind)
 395:         got = (printed(t, "v0") if alive else "died") + ("+anc" if anc in t else "-anc")
 396:         row("%s ld %s" % (nm, tag), got, "0x%x+anc" % val,
 397:             "ACCEPT %s[%i]: value round-trips AND the store names the cell" % (arr, idx))
 398: 
 399: #  *** TEX IS THE ONE ARM THAT IS NOT AN ACCEPT. ***  The other five windows have a
 400: #  write path that already computes and stores the value, so reading it back is the
 401: #  ACCEPT member of the option set.  TEX's read is DECLINED instead, and these four
 402: #  rows pin the decline rather than a value.  *** THE STORE-FIRST SHAPE FROM (2) ABOVE IS
 403: #  ON TWO OF THEM, NOT FOUR: `tex ld lo' and `tex ld hi' store a non-zero value before
 404: #  loading, so a future ACCEPT of TEX reddens THEM.  `tex rd lat1' is two bare loads and
 405: #  `tex xbit' is a latch-collision row; neither stores, and neither would redden on an
 406: #  ACCEPT.  An earlier wording said "these four ... with the store-first shape". ***
 407: for tag, off in (("lo", 0x000), ("hi", TEX_HI_OFF)):
 408:     A = Addr(CODE)
 409:     addr = TEX_BASE + off
 410:     val = VAL_LO if tag == "lo" else VAL_HI
 411:     t, alive, how = session(store(A, addr, OP_SD_T0_A3, "0x%016x" % val)
 412:                             + load(A, addr, OP_LD_V0_AT) + ["print v0"])
 413:     got = (printed(t, "v0") if alive else "died")
 414:     got += "+1msg" if t.count(TEX_RD_DECL) == 1 else "+%imsg" % t.count(TEX_RD_DECL)
 415:     row("tex ld " + tag, got, "0x0+1msg",
 416:         "DECLINE: reads 0 after a real store -- an ACCEPT would return the store")
 417: 
 418: #  THE LATCH: one announce per instance, not one per access.  Two reads at DIFFERENT
 419: #  offsets, so a latch keyed on the address rather than on the arm also reddens.
 420: A = Addr(CODE)
 421: t, alive, how = session(load(A, TEX_BASE, OP_LD_V0_AT)
 422:                         + load(A, TEX_BASE + TEX_HI_OFF, OP_LD_V0_AT))
 423: row("tex rd lat1", "%i" % t.count(TEX_RD_DECL) if alive else "died", "1",
 424:     "LATCH: two TEX reads at two offsets announce exactly once")
 425: 
 426: #  *** THE CROSS-BIT ROW.  #498 measured a latch shared between two arms scoring 23/25,
 427: #  and #490 measured the same collision in another file, so it is pinned here BEFORE it
 428: #  can bite: fire all SIX width latches -- CRIME_RE_TEX's own included -- with narrow
 429: #  writes, then read TEX.  If the read decline is given an existing bit rather than its
 430: #  own, its message is already suppressed and this row reds. ***
 431: #  *** CLASS CLOSURE ON THE LATCH-COLLISION AXIS -- pass 3. ***
 432: #
 433: #  This row USED TO fire only the six width latches (bits 0-5), and pass 3 showed why that is
 434: #  not enough: the mutation operator is `SGIRE_W_TEX_RD := <an already-used bit>' ON THE EDITED
 435: #  LINE, so bits 6, 7, 9 and 10 were the SAME operator on the SAME line and swept by nothing.
 436: #  Pass 2 found the bit-8 cell; pass 3 found the rest.  TWO CONSECUTIVE PASSES FINDING ONE CLASS
 437: #  is the trigger for closing the whole space in one diff rather than one cell per pass.
 438: #
 439: #      bit  latch              fired here by
 440: #      ---  -----------------  ---------------------------------------------------------
 441: #       0-5 *_LEN x6           a narrow (byte) store to each of the six RE windows
 442: #       6   SGIRE_W_DE_LEN     a BYTE store to the DE window -- its accept set is {4,8}
 443: #       7   SGIRE_W_UNMAP_WR   a store to OUTSIDE
 444: #       8   SGIRE_W_UNMAP_RD   a load  from OUTSIDE
 445: #       9   SGIRE_W_PRIM_OP    an unimplemented drawing op stored to PRIMITIVE|START
 446: #      10   SGIRE_W_BADMODE    an unimplemented DST MODE driven through a real rectangle
 447: #
 448: #  *** THE CLASS IS CLOSED, AND BITS 9 AND 10 WERE MEASURED OPEN BEFORE THEY WERE CLOSED. ***
 449: #  An earlier form of this row fired bits 0-8 and DISCLOSED 9 and 10 as unreachable-in-session,
 450: #  on the ground that a TEX-read session never enters the drawing-engine path.  That disclosure
 451: #  was MEASURED rather than asserted -- `M_bit9' and `M_bit10' both scored 46/46, a clean escape
 452: #  (CLASSVERIFY.txt) -- and two seats had called a measured-open cell on the edited line a breach
 453: #  whatever the contract says.  They were right, and the disclosure was answering the wrong
 454: #  question: not "does a TEX session normally draw?" but "CAN one?"  It can, in six stores.
 455: #  The settling fact I had written down as unknown turned out to be one grep away, in a shipped
 456: #  probe that already drives this path.
 457: A = Addr(CODE)
 458: cmds = []
 459: for _nm, _b, _sym, _a in SITES:
 460:     cmds += store(A, _b, OP_SB_T0_A3, "0x1")          # bits 0-5
 461: cmds += store(A, DE_BASE, OP_SB_T0_A3, "0x1")         # bit 6
 462: cmds += store(A, OUTSIDE, OP_SB_T0_A3, "0x1")         # bit 7
 463: cmds += load(A, OUTSIDE, OP_LW_V0_AT)                 # bit 8
 464: #  *** THE SIX CALLS BELOW ONCE PASSED THEIR VALUE AS THE OPCODE. ***  `store()' is
 465: #  `store(A, addr, op=OP_SW_T0_A3, val="0x12345678")', so `store(A, DE_MODE_DST, MODE_LIN_B)'
 466: #  assembled MODE_LIN_B as an INSTRUCTION and wrote the default value to the register.  All six
 467: #  were wrong the same way, and **the row still scored 46/46**, because its oracle is only the TEX
 468: #  decline count -- which garbage stores do not disturb.  A row that passes while doing nothing it
 469: #  claims is exactly the vacuity the floor exists to prevent; it was caught by a reading seat, not
 470: #  by a measurement.  Pass the value as `val', never positionally as `op'.
 471: #
 472: #  bit 10 SGIRE_W_BADMODE -- an unimplemented DST MODE driven through a REAL rectangle, so
 473: #  horrible_getputpixel is actually entered.  The vertex pair is (0,0)-(0,3): the HEIGHT is what
 474: #  makes the primitive iterate, which sgi_re_randompixel_probe.py measured and documents.
 475: cmds += store(A, DE_MODE_DST, OP_SW_T0_A3, "0x%x" % MODE_LIN_B)
 476: cmds += store(A, DE_DRAWMODE, OP_SW_T0_A3, "0x%x" % DRAWMODE)
 477: cmds += store(A, DE_XVERT_0,  OP_SW_T0_A3, "0x0")
 478: cmds += store(A, DE_XVERT_1,  OP_SW_T0_A3, "0x3")
 479: cmds += store(A, DE_PRIM_ST,  OP_SW_T0_A3, "0x%x" % PRIM_RECT)
 480: #  bit 9 SGIRE_W_PRIM_OP -- an unimplemented drawing OP.  draw_primitive's switch rejects it
 481: #  before any pixel work, so this needs no vertex setup of its own.
 482: cmds += store(A, DE_PRIM_ST,  OP_SW_T0_A3, "0x%x" % PRIM_BAD)
 483: cmds += load(A, TEX_BASE, OP_LD_V0_AT)
 484: t, alive, how = session(cmds, spin=4.0)
 485: 
 486: #  *** THE ROW PROVES ITS OWN SETUP.  This is the repair for the defect that made it vacuous. ***
 487: #  Counting only the TEX decline cannot distinguish "ten latches fired and TEX still announced"
 488: #  from "the setup did nothing and TEX announced".  Both give 1.  So the row also reports HOW MANY
 489: #  of the other announces it actually saw, and wants ALL of them: a setup that silently fails --
 490: #  a mistyped call, a moved register, a changed message -- now REDS this row instead of passing it.
 491: SETUP_LIT = ([decl(sym) for _n, _b, sym, _a in SITES] +          # bits 0-5, the six *_LEN
 492:              ["[ sgi_de: unimplemented len=",                    # bit 6  DE_LEN
 493:               "unimplemented write to address 0x1800",           # bit 7  UNMAP_WR
 494:               "unimplemented read from address 0x1800",          # bit 8  UNMAP_RD
 495:               "UNIMPLEMENTED drawing op",                        # bit 9  PRIM_OP
 496:               "unimplemented dst_mode"])                         # bit 10 BADMODE
 497: fired = sum(1 for lit in SETUP_LIT if lit in t)
 498: row("tex xbit", "%i/%i" % (t.count(TEX_RD_DECL), fired) if alive else "died",
 499:     "1/%i" % len(SETUP_LIT),
 500:     "CROSSBIT: all 11 other latches PROVEN fired; TEX read still announces once")
 501: 
 502: A = Addr(CODE)
 503: #  *** RE-PINNED BY #499, WHICH REMOVED THIS KILL.  Three channels replace one, and
 504: #  BOTH of the obvious oracles were measured VACUOUS before this one was chosen. ***
 505: #
 506: #  THE OLD ROW was `row("other kill", how, "exit1")' -- DEATH-ONLY.  It observed THAT
 507: #  the catch-all killed, never WHICH kill it was, so a change to the message that left
 508: #  exit(1) standing passed: MEASURED 35/35 against a matched control at 34/35.  Filed
 509: #  as `otherkilldeath', and its own note prescribed the repair used here.
 510: #
 511: #  THE OBVIOUS RE-PIN, `how == "exit0"', IS WORSE, and this is the part that had to be
 512: #  built rather than argued.  A one-token reinstatement of the death as exit(0) prints
 513: #  the announce and then dies; exit status CANNOT distinguish "declined, then quit"
 514: #  from "died with status 0".  MEASURED, variant `mexit0': the exit0+txt oracle scores
 515: #  GREEN (how=exit0, txt=True) while alive=False.  Filed as `exit0oracle'.
 516: #
 517: #  SO THE ROW PINS THREE THINGS:
 518: #    how    the host survives the declined WRITE;
 519: #    txt    ONE CONTIGUOUS literal, address and data field included.  Two independent
 520: #           substring tests are a weaker claim: "-- declined." is emitted by the six
 521: #           #497 width declines and by #498's sgi_de decline as well, and this probe's
 522: #           own decl() helper exists because a bare substring cross-matches;
 523: #    v0     a declined READ REACHES THE COMMON TAIL and lands a DEFINED 0.  v0 is
 524: #           preset to SENTINEL by load(), so "wrote odata (0)" and "never landed" are
 525: #           distinguishable -- the same reason the `lw surv' rows carry it.  This is
 526: #           what kills `mret0' (return 0 -> memory_rw.c coerces to -1 -> EXCEPTION_DBE)
 527: #           and `mrdexit0' (exit(0) in the READ branch only), neither of which any
 528: #           write-only oracle can see.
 529: #
 530: #  ORDER PROOF: the new oracle was measured RED on the COMMITTED pre-#499 build BEFORE
 531: #  the code changed -- table500b.out, variant `base', got=exit1/notxt/died against
 532: #  want=exit0/txt/0x0.  And it is not fitted to the fix either: it was PRE-REGISTERED
 533: #  by #497 in commit 112867a (2026-08-30 22:41), six hours before #499's baseline
 534: #  3ded1e8, in the very note this comment replaces.
 535: #
 536: #  CONTRACT -- so a later escape is a breach or an exclusion, not an argument.  This
 537: #  row covers the catch-all's WRITE announce and the READ tail-return.  It does NOT
 538: #  pin the LATCH (one access per direction here, so first == only) nor the READ
 539: #  announce text.  Those live in sgi_re_unmapped_probe.py (`wr lat1', `rd lat1',
 540: #  `rd decl'), WHICH MUST BE GATE-WIRED -- unwired, that coverage exists nowhere. ***
 541: DECL_W = ("unimplemented write to address 0x1800, "
 542:           "data=0x0000000012345678 -- declined.  (once) ]")
 543: t, alive, how = session(store(A, OUTSIDE) + load(A, OUTSIDE) + ["print v0"])
 544: got = "%s/%s/%s" % (how, "txt" if t.count(DECL_W) == 1 else "notxt",
 545:                    printed(t, "v0") if alive else "died")
 546: row("other decl", got, "exit0/txt/0x0",
 547:     "#499: declines, announces once, declined read lands a defined 0")
 548: 
 549: #  *** L2 -- A FLOOR BREACH FOUND BY THE PASS-2 PANEL, REPAIRED IN-ROUND. ***
 550: #
 551: #  Clause (d)'s DEPENDS-ON closure includes `d->warned', and -- AT THE TIME OF PASS 2 --
 552: #  `tex xbit' swept the six *_LEN bits only.  (It now fires bits 0-10; see that row.  The
 553: #  past tense is deliberate: this paragraph records why the repair was needed.)  The panel named the escape and predicted its score: give the TEX
 554: #  read decline an ALREADY-USED NON-LEN bit --
 555: #
 556: #      SGIRE_W_TEX_RD = 1 << 11   ->   1 << 8   (= SGIRE_W_UNMAP_RD)
 557: #
 558: #  -- and the 44-row detector scores a CLEAN SWEEP, because its four TEX-read scenarios
 559: #  and its unmapped-read scenario NEVER SHARE AN EMULATOR INSTANCE.  `tex xbit' sets bits
 560: #  0-5, so bit 8 is clear in every session that reads TEX.  M10 established detection of a
 561: #  WIDTH-bit collision, not of every existing-bit collision.
 562: #
 563: #  The repair is a SAME-INSTANCE sequence in BOTH orderings: whichever announce fires
 564: #  first must not suppress the other.  One ordering alone would leave the mirror open --
 565: #  the `#499' shape, where a repair closes the cell the mutant used and leaves its twin.
 566: DECL_R = "unimplemented read from address 0x1800 -- declined.  (once) ]"
 567: 
 568: for nm, first, second in (("tex/unmap", TEX_BASE, OUTSIDE),
 569:                           ("unmap/tex", OUTSIDE, TEX_BASE)):
 570:     A = Addr(CODE)
 571:     t, alive, how = session(load(A, first, OP_LD_V0_AT) + load(A, second, OP_LD_V0_AT))
 572:     got = "%i/%i" % (t.count(TEX_RD_DECL), t.count(DECL_R)) if alive else "died"
 573:     row(nm, got, "1/1",
 574:         "LATCH INDEPENDENCE: both announces fire in ONE instance, either order")
 575: 
 576: ok = sum(1 for _, o in rows if o)
 577: print("")
 578: print("OPUS497T_RESULT=%d/%d" % (ok, len(rows)))
 579: print("OPUS497T_LABEL=%s" % LABEL)
 580: print("OPUS497T_DONE")
1155: SGILOG=$LOGDIR/sgi_re_width.log
1156: python3 sgi_re_width_probe.py "$PMAX" gate > "$SGILOG" 2>&1 || true
1157: 
1158: #  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
1159: #  existence: a killed run loses every row and looks exactly like a run that produced none.
1160: if ! grep -q "OPUS497T_DONE" "$SGILOG"; then
1161:     note "sgi_re width probe did not reach its completion sentinel; last lines follow"
1162:     tail -5 "$SGILOG" | sed 's/^/       /'
1163:     check "sgi_re width probe completed" "no" "yes"
1164: else
1165:     grep -E " ok$| FAIL$" "$SGILOG" | sed 's/^/       /'
1166: 
1167:     #  CONTROLS BY NAME, not by count.  A green-row total lets a control go red while the
1168:     #  sum stays acceptable -- and a run whose controls died is an APPARATUS failure, which
1169:     #  must not be read as a wall of product failures.
1170:     for c in "live" "live64" "devsig stat"; do
1171:         check "sgi_re control: $c" "$(count "$SGILOG" "^$c  .*ok$")" "1"
1172:     done
1173:     check "sgi_re controls live" \
1174:           "$(grep -q 'OPUS497T_CONTROL=OK' "$SGILOG" && echo yes || echo no)" "yes"
1175: 
1176:     #  PER-ROW PASS.  Checked individually rather than by a total, because a row that
1177:     #  silently stops being tested is the padded-column class: a name as long as its column
1178:     #  makes a check UNSATISFIABLE and the row quietly stops being tested.
1179:     #  The list is ONE LINE on purpose -- a backslash-continued list assembled through
1180:     #  nested quoting once gained a bogus word `n` and shipped a RED gate.
1181:     for v in "live" "devsig stat" "tlb_a sw surv" "tlb_a sw lat1" "tlb_a lw surv" "tlb_a accept" "tlb_b sw surv" "tlb_b sw lat1" "tlb_b lw surv" "tlb_b accept" "tlb_c sw surv" "tlb_c sw lat1" "tlb_c lw surv" "tlb_c accept" "tex sw surv" "tex sw lat1" "tex lw surv" "tex accept" "linear_a sw surv" "linear_a sw lat1" "linear_a lw surv" "linear_a accept" "linear_b sw surv" "linear_b sw lat1" "linear_b lw surv" "linear_b accept" "xsite 6msg" "xsite order" "other decl" "live64" "tlb_a ld lo" "tlb_a ld hi" "tlb_b ld lo" "tlb_b ld hi" "tlb_c ld lo" "tlb_c ld hi" "linear_a ld lo" "linear_a ld hi" "linear_b ld lo" "linear_b ld hi" "tex ld lo" "tex ld hi" "tex rd lat1" "tex xbit" "tex/unmap" "unmap/tex"; do
1182:         check "sgi_re row: $v" "$(count "$SGILOG" "^$v  .*ok$")" "1"
1183:     done
1184: 
1185:     #  DENOMINATOR PINNED TO A LITERAL.  A detector that loses rows must not be able to pass
1186:     #  by shrinking, and the count is the only thing that says so.  Raise it DELIBERATELY.
1187:     #  Both halves pinned: 46 rows emitted AND all 46 green.
1188:     #  *** RAISED 44 -> 46 ON THIS ROUND'S OWN PASS 2. ***  The panel found a clause-(d)
1189:     #  floor breach: giving the TEX read decline an already-used NON-LEN latch bit
1190:     #  (1 << 8 = SGIRE_W_UNMAP_RD) escapes a 44/44 sweep, because the detector's four
1191:     #  TEX-read scenarios and its unmapped-read scenario never share an emulator instance
1192:     #  -- `tex xbit' set bits 0-5 only AT THAT TIME (it now fires 0-10).  Repaired by two
1193:     #  SAME-INSTANCE rows asserting both
1194:     #  announces fire, in BOTH orderings; one ordering would leave the mirror open.
1195:     #  *** RAISED 35 -> 44 BY #513, DELIBERATELY, IN THE SAME COMMIT AS THE FIX. ***
1196:     #  The six `<arm> ld kill' rows are GONE -- they asserted that a len == 8 READ still
1197:     #  ends the host at each window, which was true until #513 removed those kills.  They
1198:     #  are replaced by TWO anchored ACCEPT rows per accepting arm (window base AND last
1199:     #  slot, because a row at the base tests the near bound twice and the far bound never),
1200:     #  four CRIME_RE_TEX decline rows, and a 64-bit liveness control.  Arithmetic:
1201:     #  35 - 6 + 14 + 1 = 44.  Two rows rather than one,
1202:     #  because a single "35 ok" check cannot tell a LOST row from a FAILING one -- and
1203:     #  those need different responses.
1204:     #  *** THE FIRST DRAFT OF THIS BLOCK HAD TWO DEFECTS, BOTH FOUND BY THE PASS-2 SEAT.
1205:     #  (1) It ended in `|| true`, which is INERT: check() in lib.sh has no `return`, so
1206:     #  it exits 0 on BOTH branches and the row counts into _fails regardless.  The
1207:     #  suppression never existed -- but a reader would conclude that row was advisory,
1208:     #  which is worse than either behaviour on its own.
1209:     #  (2) The denominator concatenated two counts and compared to "350" -- satisfied by
1210:     #  (35 ok, 0 FAIL) AND by (3 ok, 50 FAIL).  A string join is not an arithmetic
1211:     #  identity, and it was redundant with the two rows below it anyway. ***
1212:     #  *** AND THE FIRST REPAIR OF (2) REPRODUCED THE VERY DEFECT THE PANEL HAD JUST FOUND
1213:     #  IN THIS ROUND'S BRIEF.  I wrote `count "$SGILOG" " ok$| FAIL$"` -- but count() is
1214:     #  `grep -ac`, PLAIN grep, so `|` is a LITERAL and the pattern matches NOTHING.
1215:     #  Measured: 0 against a log holding 35 rows.  The seats had flagged `grep -i
1216:     #  'sgi|width'` in the brief for exactly this, one hour earlier. ***
1217:     #
1218:     #  Summed ARITHMETICALLY instead, which needs no regex dialect at all -- and unlike the
1219:     #  string-concatenation form it replaces, it cannot be satisfied by (3 ok, 50 FAIL).
1220:     check "sgi_re rows emitted" \
1221:           "$(( $(count "$SGILOG" " ok$") + $(count "$SGILOG" " FAIL$") ))" "46"
1222:     check "sgi_re rows green"   "$(count "$SGILOG" " ok$")"   "46"
1223:     check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
1224: 
1225: fi

exec
