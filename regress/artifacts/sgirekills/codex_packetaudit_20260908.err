   3: **Q1. Actual handler and comparison**
   4: 
   5: In [src/cpus/cpu_alpha_palcode.c:309](C:/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/src/cpus/cpu_alpha_palcode.c:309):
   6: 
   7: ```c
   8: 	case 0x33:	/*  PAL_OSF1_tbi  */
   9: 		/*
  10: 		 *  a0 = op, a1 = vaddr
  11: 		 *  a0 is ignored for now. TODO.
  12: 		 *	a0 = 1: ITB invalidate
  13: 		 *	a0 = 2: DTB invalidate
  14: 		 *	a0 = 3: both ITB and DTB
  15: 		 *	a0 = -1: invalidate everything with ASM=0.
  16: 		 *	a0 = -2: invalidate everything
  17: 		 */
  18: 		// debug("[ Alpha PALcode: PAL_OSF1_tbi: a0=%" PRIi64" a1=0x%"
  19: 		//    PRIx64" ]\n", (int64_t)a0, (uint64_t)a1);
  20: 		if (a0 >= 1)
  21: 			cpu->invalidate_translation_caches(cpu, a1, INVALIDATE_VADDR);
