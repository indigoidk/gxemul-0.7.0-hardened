755:		}
756:
757:		if (step_x != src_bufdepth || (step_y != 0 && step_y != 1)) {
758:			fatal("[ sgi_de: unimplemented XFER addr_src=0x%x src_bufdepth=%i "
759:				"strd_src=0x%x step_x=0x%x step_y=0x%x "
760:				"addr_dst=0x%x strd_dst=0x%x ]\n",
761:				addr_src, src_bufdepth, strd_src, step_x, step_y, addr_dst, strd_dst);
762:
763:			// exit(1);
764:		}
765:	}
766:
767:	if (!(drawmode & DE_DRAWMODE_PLANEMASK)) {
768:		printf("!DE_DRAWMODE_PLANEMASK: TODO\n");
769:	}
770:	
771:	if ((drawmode & DE_DRAWMODE_BYTEMASK) != DE_DRAWMODE_BYTEMASK) {
772:		printf("not all DE_DRAWMODE_BYTEMASK set: TODO\n");
773:	}
774:	
775:	// primitive rendering direction (not for Lines? and presumably
776:	// not for Points either :-)
777:	int dx = op & DE_PRIM_RL ? -1 :  1;
778:	int dy = op & DE_PRIM_TB ?  1 : -1;
779:
780:	uint16_t saved_src_x = src_x;
781:
782:	/*
783:	 *  Drawing is limited to 2048 x 2048 pixel space.
784:	 *
785:	 *  TODO: MAYBE it is really -2048 to 2027, i.e. 12 bits of
786:	 *  pixel space. Perhaps it is possible to figure out
787:	 *  experimentally some day, e.g. by drawing lines from
788:	 *  -10,10 to 500,20 and see whether the real hardware
789:	 *  interprets -10 as -10 or 0x800 - 10.
790:	 */
791:	uint16_t endx = (x2 + dx) & 0x7ff;
792:	uint16_t endy = (y2 + dy) & 0x7ff;
793:
794:	int lx = abs((int)(x2 - x1)), ly = abs((int)(y2 - y1));
795:	int linelen = lx > ly ? lx : ly;
796:
797:	switch (op & 0xff000000) {
798:	case DE_PRIM_LINE:
799:		if (drawmode & DE_DRAWMODE_XFER_EN)
800:			fatal("[ sgi_de: XFER_EN for LINE op? ]\n");
801:
802:		// The PROM uses width 32, but NetBSD documents it as "half pixels".
803:		// if ((op & DE_PRIM_LINE_WIDTH_MASK) != 2)
804:		//	fatal("[ sgi_de: LINE_WIDTH_MASK = %i ]\n", op & DE_PRIM_LINE_WIDTH_MASK);
805:
806:		if (linelen == 0)
807:			linelen ++;
808:
809:		for (int i = 0; i < ((op & DE_PRIM_LINE_SKIP_END)? linelen : linelen+1); ++i) {
810:			x = (x2 * i + x1 * (linelen-i)) / linelen;
811:			y = (y2 * i + y1 * (linelen-i)) / linelen;
812:
813:			uint32_t color = fg;
814:			uint32_t oldcolor = fg;
815:
816:			if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
817:				horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
818:
819:			int draw = 1;
820:			if (drawmode & DE_DRAWMODE_LINE_STIP) {
821:				if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
822:					color = (pattern & 0x80000000UL) ? fg : bg;
823:				else
824:					draw = (pattern & 0x80000000UL)? 1 : 0;
825:			}
826:
827:			// Raster-OP.
828:			// TODO: Other ops.
829:			// TODO: Should this be before or after other things?
830:			if (drawmode & DE_DRAWMODE_ROP) {
831:				switch (rop) {
832:				case OPENGL_LOGIC_OP_COPY:
833:					// color = color;
834:					break;
835:				case OPENGL_LOGIC_OP_XOR:
836:					color = oldcolor ^ color;
837:					break;
838:				case OPENGL_LOGIC_OP_COPY_INVERTED:
839:					color = 0xffffffff - oldcolor;
840:					break;
841:				default:{
842:						static char rop_used[256];
843:						static int first = 1;
844:
845:						if (first) {
846:							memset(rop_used, 0, sizeof(rop_used));
847:							first = 0;
848:						}
849:
850:						if (!rop_used[rop & 255]) {
851:							rop_used[rop & 255] = 1;
852:							fatal("[ sgi_de: LINE: rop[0x%02x] used! ]\n", rop & 255);
853:						}
854:
855:						if (rop >> 8) {
856:							fatal("[ sgi_de: LINE: rop > 255: 0x%08x ]\n", rop);
857:						}
858:					}
859:				}
860:			}
861:
862:			if (draw)
863:				horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
864:
865:			// Rotate the stipple pattern:
866:			pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
867:		}
868:		break;
869:
870:	case DE_PRIM_RECTANGLE:
871:		for (y = y1; y != endy; y = (y + dy) & 0x7ff) {
872:			src_x = saved_src_x;
873:			for (x = x1; x != endx; x = (x + dx) & 0x7ff) {
874:				uint32_t color = fg;
875:				uint32_t oldcolor = fg;
876:
877:				if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
878:					horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
879:
880:				// Pixel colors copied from another source.
881:				// (OpenBSD draws characters using this mechanism.)
882:				if (drawmode & DE_DRAWMODE_XFER_EN)
883:					horrible_getputpixel(0, cpu, d,	src_x, src_y, &color, src_mode);
884:
885:				int draw = 1;
886:				if (drawmode & DE_DRAWMODE_POLY_STIP) {
887:					if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
888:						color = (pattern & 0x80000000UL) ? fg : bg;
889:					else
890:						draw = (pattern & 0x80000000UL)? 1 : 0;
891:				}
892:
893:				// Raster-OP.
894:				// TODO: Other ops.
895:				// TODO: Should this be before or after other things?
896:				if (drawmode & DE_DRAWMODE_ROP) {
897:					switch (rop) {
898:					case OPENGL_LOGIC_OP_COPY:
899:						// color = color;
900:						break;
901:					case OPENGL_LOGIC_OP_XOR:
902:						color = oldcolor ^ color;
903:						break;
904:					case OPENGL_LOGIC_OP_COPY_INVERTED:
905:						color = 0xffffffff - oldcolor;
906:						break;
907:					default:{
908:							static char rop_used[256];
909:							static int first = 1;
910:
911:							if (first) {
912:								memset(rop_used, 0, sizeof(rop_used));
913:								first = 0;
914:							}
915:
916:							if (!rop_used[rop & 255]) {
917:								rop_used[rop & 255] = 1;
918:								fatal("[ sgi_de: RECT: rop[0x%02x] used! ]\n", rop & 255);
919:							}
920:
921:							if (rop >> 8) {
922:								fatal("[ sgi_de: RECT: rop > 255: 0x%08x ]\n", rop);
923:							}
924:						}
925:					}
926:				}
927:
928:				if (draw)
929:					horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
930:
931:				// Rotate the stipple pattern:
932:				pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
933:
934:				if (src_is_linear)
935:					src_x += step_x;
936:				else
937:					src_x = (src_x + dx) & 0x7ff;
938:			}
939:			
940:			src_y = (src_y + dy) & 0x7ff;
941:		}
942:		break;
943:
944:	default:
945:		/*  #500: a GUEST-WRITTEN drawing op ended the host process.
946:		    The switch discriminates on the TOP BYTE only, so the domain
947:		    is 256 values and only two are implemented -- DE_PRIM_LINE
948:		    (0x01) and DE_PRIM_RECTANGLE (0x03).
949:
950:		    *** THE TWO KILLERS THAT MATTER ARE NOT EXOTIC VALUES: THEY
951:		    ARE NAMED PRIMITIVES, AND ONE OF THEM IS THE RESET STATE. ***
952:		    crmfbreg.h defines them as FULL 32-BIT VALUES, not top-byte
953:		    indices: DE_PRIM_POINT 0x00000000, LINE 0x01000000,
954:		    TRIANGLE 0x02000000, RECTANGLE 0x03000000.  Writing them
955:		    as "0x01" invites a `case 0x02:' that can NEVER match,
956:		    since the switch compares `op & 0xff000000'.  POINT and
957:		    TRIANGLE land
958:		    here.  And dev_sgi_re_init memsets the whole device struct,
959:		    so CRIME_DE_PRIMITIVE reads 0 -- which IS POINT -- until a
960:		    guest writes it.  A guest that sets the START bit having
961:		    never written the primitive register at all therefore died
962:		    here.  It need not choose a bad value; it need only omit a
963:		    good one.
964:
965:		    Now a LATCHED DECLINE that falls out of the switch and
966:		    returns.  The diagnostic is kept in full -- it names the op
967:		    and the vertices, which is what a maintainer implementing
968:		    the primitive would want -- and gains `-- declined.  (once)'
969:		    so it cannot be mistaken for the old host kill and cannot
970:		    flood a guest loop.  */
971:		if (!(d->warned & SGIRE_W_PRIM_OP)) {
972:			d->warned |= SGIRE_W_PRIM_OP;
973:			fatal("[ sgi_de: UNIMPLEMENTED drawing op = 0x%08x,"
974:			    " x1=%i y1=%i x2=%i y2=%i fg=0x%x bg=0x%x"
975:			    " pattern=0x%08x -- declined.  (once) ]\n",
976:			    op, x1, y1, x2, y2, fg, bg, pattern);
977:		}
978:		break;
979:	}
980:}
981:
982:DEVICE_ACCESS(sgi_de)
983:{
984:	struct sgi_re_data *d = (struct sgi_re_data *) extra;
985:	uint64_t idata = 0, odata = 0;
986:	int regnr;
987:	int startFlag = relative_addr & CRIME_DE_START;
988:
989:	relative_addr &= ~CRIME_DE_START;
990:
991:	idata = memory_readmax64(cpu, data, len);
992:	regnr = relative_addr / sizeof(uint32_t);
993:
994:	relative_addr += 0x2000;
995:
996:	/*
997:	 *  Treat all registers as read/write, by default.  Sometimes these
998:	 *  are accessed as 32-bit words, sometimes as 64-bit words to access
999:	 *  two adjacent registers in one operation.
1000:	 */
1001:	if (len == 8) {
1002:		if (writeflag == MEM_WRITE) {
1003:			d->de_reg[regnr] = idata >> 32ULL;
1004:			d->de_reg[regnr+1] = idata;
1005:		} else
1006:			odata = ((uint64_t)d->de_reg[regnr] << 32ULL) +
1007:			    d->de_reg[regnr+1];
1008:	} else if (len == 4) {
1009:		if (writeflag == MEM_WRITE)
1010:			d->de_reg[regnr] = idata;
1011:		else
1012:			odata = d->de_reg[regnr];
1013:	} else {
1014:		/*
1015:		 *  #498: THIS USED TO END THE HOST PROCESS.  A guest choosing an
1016:		 *  access width is not an emulator error -- one `sb' anywhere in
1017:		 *  this 4 KB window did it.  Witnessed at rung 3 on an unmodified
1018:		 *  -E sgi -e ip32: sb, sh, lbu and lhu each gave exactly one
1019:		 *  "len = N not implemented" and exit(1), 4/4.
1020:		 *
1021:		 *  *** THE SHAPE IS NOT #497's SPLICE, AND THE DIFFERENCE IS
1022:		 *  MEASURED, NOT STYLISTIC. ***  #497's tail only answered a read.
1023:		 *  THIS function's tail also calls draw_primitive() when the guest
1024:		 *  set CRIME_DE_START, so falling through would run a rendering
1025:		 *  primitive for an access we just refused.
1026:		 *
1027:		 *  Clearing startFlag and falling through -- the obvious repair --
1028:		 *  scores 24/25: the declined access still reaches the switch
1029:		 *  below, which announces e.g. "TODO: non-zero CRIME_DE_SCISSOR"
1030:		 *  about a write THAT NEVER HAPPENED, from an idata this arm
1031:		 *  discarded.  Shipping a wrong record inside a diagnostic is the
1032:		 *  same class the ACCEPT member of the option set was found
1033:		 *  through.  The goto form scores 25/25.
1034:		 *
1035:		 *  `goto <label>' to a common exit is house idiom, not an
1036:		 *  invention: 10 device files use goto and 8 of those use it
1037:		 *  inside a DEVICE_ACCESS body (dc7085, i80321, le, mk48txx,
1038:		 *  ne2000, pvr, vr41xx, wdc).
1039:		 *
1040:		 *  It is not an early `return' either.  Control still reaches the
1041:		 *  common exit, so a declined READ is answered with odata (0) via
1042:		 *  memory_writemax64 and the function still returns 1.  `return 0'
1043:		 *  would be coerced to -1 by cpus/memory_rw.c and raise
1044:		 *  EXCEPTION_DBE -- turning a refusal into a guest bus error.
1045:		 */
1046:		if (!(d->warned & SGIRE_W_DE_LEN)) {
1047:			d->warned |= SGIRE_W_DE_LEN;
1048:			fatal("[ sgi_de: unimplemented len=%i -- declined."
1049:			    "  (once) ]\n", (int) len);
1050:		}
1051:		goto de_declined;
1052:	}
1053:
1054:	switch (relative_addr) {
1055:
1056:	case CRIME_DE_MODE_SRC:
1057:		debug("[ sgi_de: %s CRIME_DE_MODE_SRC: 0x%016llx ]\n",
1058:		    writeflag == MEM_WRITE ? "write to" : "read from",
1059:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1060:		break;
1061:
1062:	case CRIME_DE_MODE_DST:
1063:		debug("[ sgi_de: %s CRIME_DE_MODE_DST: 0x%016llx ]\n",
1064:		    writeflag == MEM_WRITE ? "write to" : "read from",
1065:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1066:		break;
1067:
1068:	case CRIME_DE_CLIPMODE:
1069:		debug("[ sgi_de: %s CRIME_DE_CLIPMODE: 0x%016llx ]\n",
1070:		    writeflag == MEM_WRITE ? "write to" : "read from",
1071:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1072:		if (writeflag == MEM_WRITE && idata != 0)
1073:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_CLIPMODE: 0x%016llx ]\n", idata);
1074:		break;
1075:
1076:	case CRIME_DE_DRAWMODE:
1077:		debug("[ sgi_de: %s CRIME_DE_DRAWMODE: 0x%016llx ]\n",
1078:		    writeflag == MEM_WRITE ? "write to" : "read from",
1079:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1080:		break;
1081:
1082:	case CRIME_DE_SCRMASK0:
1083:		debug("[ sgi_de: %s CRIME_DE_SCRMASK0: 0x%016llx ]\n",
1084:		    writeflag == MEM_WRITE ? "write to" : "read from",
1085:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1086:		if (writeflag == MEM_WRITE && idata != 0)
1087:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK0: 0x%016llx ]\n", idata);
1088:		break;
1089:
1090:	case CRIME_DE_SCRMASK1:
1091:		debug("[ sgi_de: %s CRIME_DE_SCRMASK1: 0x%016llx ]\n",
1092:		    writeflag == MEM_WRITE ? "write to" : "read from",
1093:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1094:		if (writeflag == MEM_WRITE && idata != 0)
1095:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK1: 0x%016llx ]\n", idata);
1096:		break;
1097:
1098:	case CRIME_DE_SCRMASK2:
1099:		debug("[ sgi_de: %s CRIME_DE_SCRMASK2: 0x%016llx ]\n",
1100:		    writeflag == MEM_WRITE ? "write to" : "read from",
1101:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1102:		if (writeflag == MEM_WRITE && idata != 0)
1103:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK2: 0x%016llx ]\n", idata);
1104:		break;
1105:
1106:	case CRIME_DE_SCRMASK3:
1107:		debug("[ sgi_de: %s CRIME_DE_SCRMASK3: 0x%016llx ]\n",
1108:		    writeflag == MEM_WRITE ? "write to" : "read from",
1109:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1110:		if (writeflag == MEM_WRITE && idata != 0)
1111:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK3: 0x%016llx ]\n", idata);
1112:		break;
1113:
1114:	case CRIME_DE_SCRMASK4:
1115:		debug("[ sgi_de: %s CRIME_DE_SCRMASK4: 0x%016llx ]\n",
1116:		    writeflag == MEM_WRITE ? "write to" : "read from",
1117:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1118:		if (writeflag == MEM_WRITE && idata != 0)
1119:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK4: 0x%016llx ]\n", idata);
1120:		break;
1121:
1122:	case CRIME_DE_SCISSOR:
1123:		debug("[ sgi_de: %s CRIME_DE_SCISSOR: 0x%016llx ]\n",
1124:		    writeflag == MEM_WRITE ? "write to" : "read from",
1125:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1126:		if (writeflag == MEM_WRITE && idata != 0)
1127:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCISSOR: 0x%016llx ]\n", idata);
1128:		break;
1129:
1130:	case CRIME_DE_SCISSOR + 4:
1131:		// NetBSD writes 0x3fff3fff here. "High" part of SCISSOR register?
1132:		debug("[ sgi_de: %s CRIME_DE_SCISSOR+4: 0x%016llx ]\n",
1133:		    writeflag == MEM_WRITE ? "write to" : "read from",
1134:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1135:		if (writeflag == MEM_WRITE && idata != 0x3fff3fff)
1136:			fatal("[ sgi_de: TODO: CRIME_DE_SCISSOR+4: 0x%016llx ]\n", idata);
1137:		break;
1138:
1139:	case CRIME_DE_PRIMITIVE:
1140:		debug("[ sgi_de: %s CRIME_DE_PRIMITIVE: 0x%016llx ]\n",
1141:		    writeflag == MEM_WRITE ? "write to" : "read from",
1142:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1143:		break;
1144:
1145:	case CRIME_DE_WINOFFSET_SRC:
1146:		debug("[ sgi_de: %s CRIME_DE_WINOFFSET_SRC: 0x%016llx ]\n",
1147:		    writeflag == MEM_WRITE ? "write to" : "read from",
1148:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1149:		if (writeflag == MEM_WRITE && idata != 0)
1150:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_WINOFFSET_SRC: 0x%016llx ]\n", idata);
1151:		break;
1152:
1153:	case CRIME_DE_WINOFFSET_DST:
1154:		debug("[ sgi_de: %s CRIME_DE_WINOFFSET_DST: 0x%016llx ]\n",
1155:		    writeflag == MEM_WRITE ? "write to" : "read from",
1156:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1157:		if (writeflag == MEM_WRITE && idata != 0)
1158:			fatal("[ sgi_de: TODO: non-zero CRIME_DE_WINOFFSET_DST: 0x%016llx ]\n", idata);
1159:		break;
1160:
1161:	case CRIME_DE_X_VERTEX_0:
1162:		debug("[ sgi_de: %s CRIME_DE_X_VERTEX_0: 0x%016llx ]\n",
1163:		    writeflag == MEM_WRITE ? "write to" : "read from",
1164:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1165:		break;
1166:
1167:	case CRIME_DE_X_VERTEX_1:
1168:		debug("[ sgi_de: %s CRIME_DE_X_VERTEX_1: 0x%016llx ]\n",
1169:		    writeflag == MEM_WRITE ? "write to" : "read from",
1170:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1171:		break;
1172:
1173:	case CRIME_DE_XFER_ADDR_SRC:
1174:		debug("[ sgi_de: %s CRIME_DE_XFER_ADDR_SRC: 0x%016llx ]\n",
1175:		    writeflag == MEM_WRITE ? "write to" : "read from",
1176:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1177:		break;
1178:
1179:	case CRIME_DE_XFER_STRD_SRC:
1180:		debug("[ sgi_de: %s CRIME_DE_XFER_STRD_SRC: 0x%016llx ]\n",
1181:		    writeflag == MEM_WRITE ? "write to" : "read from",
1182:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1183:		break;
1184:
1185:	case CRIME_DE_XFER_STEP_X:
1186:		debug("[ sgi_de: %s CRIME_DE_XFER_STEP_X: 0x%016llx ]\n",
1187:		    writeflag == MEM_WRITE ? "write to" : "read from",
1188:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1189:		break;
1190:
1191:	case CRIME_DE_XFER_STEP_Y:
1192:		debug("[ sgi_de: %s CRIME_DE_XFER_STEP_Y: 0x%016llx ]\n",
1193:		    writeflag == MEM_WRITE ? "write to" : "read from",
1194:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1195:		break;
1196:
1197:	case CRIME_DE_XFER_ADDR_DST:
1198:		debug("[ sgi_de: %s CRIME_DE_XFER_ADDR_DST: 0x%016llx ]\n",
1199:		    writeflag == MEM_WRITE ? "write to" : "read from",
1200:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1201:		break;
1202:
1203:	case CRIME_DE_XFER_STRD_DST:
