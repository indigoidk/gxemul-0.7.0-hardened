404:/*  pcc2widthkills: decline a wide WRITE to a byte register, announcing once per
405:    block per instance.  The caller `break's after this; the read side of the same
406:    block never reaches here.  */
407:static void pcc2_width_decline(struct pcc2_data *d, int bit, const char *name, int len)
408:{
409:	if (!(d->warned & (1u << bit))) {
410:		d->warned |= (1u << bit);
411:		fatal("[ pcc2: unimplemented len=%i write to %s -- declined."
412:		    "  (once) ]\n", len, name);
413:	}
414:}
