1501:DEVICE_ACCESS(sgi_mte)
1502:{
1503:	struct sgi_re_data *d = (struct sgi_re_data *) extra;
1504:	uint64_t idata = 0, odata = 0;
1505:	int regnr;
1506:	int startFlag = relative_addr & CRIME_DE_START;
1507:
1508:	relative_addr &= ~CRIME_DE_START;
1509:
1510:	idata = memory_readmax64(cpu, data, len);
1511:	regnr = relative_addr / sizeof(uint32_t);
1512:
1513:	relative_addr += 0x3000;
1514:
1515:	/*
1516:	 *  Treat all registers as read/write, by default.  Sometimes these
1517:	 *  are accessed as 32-bit words, sometimes as 64-bit words.
1518:	 *
1519:	 *  NOTE: The lowest bits are internally stored in the "low" (+0)
1520:	 *  register, and the higher bits are stored in the "+1" word.
1521:	 */
1522:	if (len == 4) {
1523:		if (writeflag == MEM_WRITE)
1524:			d->mte_reg[regnr] = idata;
1525:		else
1526:			odata = d->mte_reg[regnr];
1527:	} else if (len != 4) {
1528:		if (writeflag == MEM_WRITE) {
1529:			d->mte_reg[regnr+1] = idata >> 32;
1530:			d->mte_reg[regnr] = idata;
1531:		} else {
1532:			odata = ((uint64_t)d->mte_reg[regnr+1] << 32) +
1533:			    d->mte_reg[regnr];
1534:		}
1535:	} else {
1536:		fatal("[ sgi_mte: UNIMPLEMENTED read/write len %i ]\n", len);
1537:		exit(1);
1538:	}
1539:
1540:	switch (relative_addr) {
1541:
1542:	case CRIME_MTE_MODE:
1543:		debug("[ sgi_mte: %s CRIME_MTE_MODE: 0x%016llx ]\n",
1544:		    writeflag == MEM_WRITE ? "write to" : "read from",
1545:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1546:		break;
1547:
1548:	case CRIME_MTE_BYTEMASK:
1549:		debug("[ sgi_mte: %s CRIME_MTE_BYTEMASK: 0x%016llx ]\n",
1550:		    writeflag == MEM_WRITE ? "write to" : "read from",
1551:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1552:		break;
1553:
1554:	case CRIME_MTE_STIPPLEMASK:
1555:		fatal("[ sgi_mte: %s CRIME_MTE_STIPPLEMASK: 0x%016llx ]\n",
1556:		    writeflag == MEM_WRITE ? "write to" : "read from",
1557:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1558:		break;
1559:
1560:	case CRIME_MTE_BG:
1561:		debug("[ sgi_mte: %s CRIME_MTE_BG: 0x%016llx ]\n",
1562:		    writeflag == MEM_WRITE ? "write to" : "read from",
1563:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1564:		break;
1565:
1566:	case CRIME_MTE_SRC0:
1567:		debug("[ sgi_mte: %s CRIME_MTE_SRC0: 0x%016llx ]\n",
1568:		    writeflag == MEM_WRITE ? "write to" : "read from",
1569:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1570:		break;
1571:
1572:	case CRIME_MTE_SRC1:
1573:		debug("[ sgi_mte: %s CRIME_MTE_SRC1: 0x%016llx ]\n",
1574:		    writeflag == MEM_WRITE ? "write to" : "read from",
1575:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1576:		break;
1577:
1578:	case CRIME_MTE_DST0:
1579:		debug("[ sgi_mte: %s CRIME_MTE_DST0: 0x%016llx ]\n",
1580:		    writeflag == MEM_WRITE ? "write to" : "read from",
1581:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1582:		break;
1583:
1584:	case CRIME_MTE_DST1:
1585:		debug("[ sgi_mte: %s CRIME_MTE_DST1: 0x%016llx ]\n",
1586:		    writeflag == MEM_WRITE ? "write to" : "read from",
1587:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1588:		break;
1589:
1590:	case CRIME_MTE_SRC_Y_STEP:
1591:		debug("[ sgi_mte: %s CRIME_MTE_SRC_Y_STEP: 0x%016llx ]\n",
1592:		    writeflag == MEM_WRITE ? "write to" : "read from",
1593:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1594:		break;
1595:
1596:	case CRIME_MTE_DST_Y_STEP:
1597:		debug("[ sgi_mte: %s CRIME_MTE_DST_Y_STEP: 0x%016llx ]\n",
1598:		    writeflag == MEM_WRITE ? "write to" : "read from",
1599:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1600:		break;
1601:
1602:	case CRIME_MTE_NULL:
1603:		fatal("[ sgi_mte: %s CRIME_MTE_NULL: 0x%016llx ]\n",
1604:		    writeflag == MEM_WRITE ? "write to" : "read from",
1605:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1606:		break;
1607:
1608:	case CRIME_MTE_FLUSH:
1609:		fatal("[ sgi_mte: %s CRIME_MTE_FLUSH: 0x%016llx ]\n",
1610:		    writeflag == MEM_WRITE ? "write to" : "read from",
1611:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1612:		break;
1613:
1614:	default:
1615:		if (writeflag == MEM_WRITE)
1616:			fatal("[ sgi_mte: unimplemented write to "
1617:			    "address 0x%llx, data=0x%016llx ]\n",
1618:			    (long long)relative_addr, (long long)idata);
1619:		else
1620:			fatal("[ sgi_mte: unimplemented read from address"
1621:			    " 0x%llx ]\n", (long long)relative_addr);
1622:	}
1623:
1624:	if (startFlag)
1625:		do_mte_transfer(cpu, d);
1626:
1627:	if (writeflag == MEM_READ)
1628:		memory_writemax64(cpu, data, len, odata);
1629:
1630:	return 1;
1631:}
