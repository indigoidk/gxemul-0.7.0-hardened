 1178|     #  makes a check UNSATISFIABLE and the row quietly stops being tested.
 1179|     #  The list is ONE LINE on purpose -- a backslash-continued list assembled through
 1180|     #  nested quoting once gained a bogus word `n` and shipped a RED gate.
 1181|     for v in "live" "devsig stat" "tlb_a sw surv" "tlb_a sw lat1" "tlb_a lw surv" "tlb_a accept" "tlb_b sw surv" "tlb_b sw lat1" "tlb_b lw surv" "tlb_b accept" "tlb_c sw surv" "tlb_c sw lat1" "tlb_c lw surv" "tlb_c accept" "tex sw surv" "tex sw lat1" "tex lw surv" "tex accept" "linear_a sw surv" "linear_a sw lat1" "linear_a lw surv" "linear_a accept" "linear_b sw surv" "linear_b sw lat1" "linear_b lw surv" "linear_b accept" "xsite 6msg" "xsite order" "tlb_a ld kill" "tlb_b ld kill" "tlb_c ld kill" "tex ld kill" "linear_a ld kill" "linear_b ld kill" "other decl"; do
 1182|         check "sgi_re row: $v" "$(count "$SGILOG" "^$v  .*ok$")" "1"
 1183|     done
 1184| 
 1185|     #  DENOMINATOR PINNED TO A LITERAL.  A detector that loses rows must not be able to pass
 1186|     #  by shrinking, and the count is the only thing that says so.  Raise it DELIBERATELY.
 1187|     #  Both halves pinned: 35 rows emitted AND all 35 green.  Two rows rather than one,
 1188|     #  because a single "35 ok" check cannot tell a LOST row from a FAILING one -- and
 1189|     #  those need different responses.
 1190|     #  *** THE FIRST DRAFT OF THIS BLOCK HAD TWO DEFECTS, BOTH FOUND BY THE PASS-2 SEAT.
 1191|     #  (1) It ended in `|| true`, which is INERT: check() in lib.sh has no `return`, so
 1192|     #  it exits 0 on BOTH branches and the row counts into _fails regardless.  The
 1193|     #  suppression never existed -- but a reader would conclude that row was advisory,
 1194|     #  which is worse than either behaviour on its own.
 1195|     #  (2) The denominator concatenated two counts and compared to "350" -- satisfied by
 1196|     #  (35 ok, 0 FAIL) AND by (3 ok, 50 FAIL).  A string join is not an arithmetic
 1197|     #  identity, and it was redundant with the two rows below it anyway. ***
 1198|     #  *** AND THE FIRST REPAIR OF (2) REPRODUCED THE VERY DEFECT THE PANEL HAD JUST FOUND
 1199|     #  IN THIS ROUND'S BRIEF.  I wrote `count "$SGILOG" " ok$| FAIL$"` -- but count() is
 1200|     #  `grep -ac`, PLAIN grep, so `|` is a LITERAL and the pattern matches NOTHING.
 1201|     #  Measured: 0 against a log holding 35 rows.  The seats had flagged `grep -i
 1202|     #  'sgi|width'` in the brief for exactly this, one hour earlier. ***
 1203|     #
 1204|     #  Summed ARITHMETICALLY instead, which needs no regex dialect at all -- and unlike the
 1205|     #  string-concatenation form it replaces, it cannot be satisfied by (3 ok, 50 FAIL).
 1206|     check "sgi_re rows emitted" \
 1207|           "$(( $(count "$SGILOG" " ok$") + $(count "$SGILOG" " FAIL$") ))" "35"
 1208|     check "sgi_re rows green"   "$(count "$SGILOG" " ok$")"   "35"
 1209|     check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
 1210| 
 1211| fi
 1212| 
 1213| #  ---- *** MOVED OUT ONE NESTING LEVEL, 2026-08-31.  It was pasted INSIDE the
 1214| #  ---- sgi_re_width probe's success branch, so if THAT probe missed its sentinel this
  758|  *  store_64bit_word():
  759|  *
  760|  *  Stores a 64-bit word in emulated RAM.  Byte order is taken into account.
  761|  *  Helper function.
  762|  */
  763| int store_64bit_word(struct cpu *cpu, uint64_t addr, uint64_t data64)
  764| {
  765| 	unsigned char data[8];
  766| 	if ((addr >> 32) == 0)
  767| 		addr = (int64_t)(int32_t)addr;
  768| 	data[0] = (data64 >> 56) & 255;
  769| 	data[1] = (data64 >> 48) & 255;
  770| 	data[2] = (data64 >> 40) & 255;
  771| 	data[3] = (data64 >> 32) & 255;
  772| 	data[4] = (data64 >> 24) & 255;
  773| 	data[5] = (data64 >> 16) & 255;
  774| 	data[6] = (data64 >> 8) & 255;
  775| 	data[7] = (data64) & 255;
  776| 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  777| 		int tmp = data[0]; data[0] = data[7]; data[7] = tmp;
  778| 		tmp = data[1]; data[1] = data[6]; data[6] = tmp;
  779| 		tmp = data[2]; data[2] = data[5]; data[5] = tmp;
  780| 		tmp = data[3]; data[3] = data[4]; data[4] = tmp;
  781| 	}
  782| 	return cpu->memory_rw(cpu, cpu->mem,
  783| 	    addr, data, sizeof(data), MEM_WRITE, CACHE_DATA);
  784| }
  785| 
  786| 
