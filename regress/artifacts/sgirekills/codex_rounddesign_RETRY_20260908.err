 1516| DEVICE_ACCESS(sgi_mte)
 1517| {
 1518| 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
 1519| 	uint64_t idata = 0, odata = 0;
 1520| 	int regnr;
 1521| 	int startFlag = relative_addr & CRIME_DE_START;
 1522| 
 1523| 	relative_addr &= ~CRIME_DE_START;
 1524| 
 1525| 	idata = memory_readmax64(cpu, data, len);
 1526| 	regnr = relative_addr / sizeof(uint32_t);
 1527| 
 1528| 	relative_addr += 0x3000;
 1529| 
 1530| 	/*
 1531| 	 *  Treat all registers as read/write, by default.  Sometimes these
 1532| 	 *  are accessed as 32-bit words, sometimes as 64-bit words.
 1533| 	 *
 1534| 	 *  NOTE: The lowest bits are internally stored in the "low" (+0)
 1535| 	 *  register, and the higher bits are stored in the "+1" word.
 1536| 	 */
 1537| 	if (len == 4) {
 1538| 		if (writeflag == MEM_WRITE)
 1539| 			d->mte_reg[regnr] = idata;
 1540| 		else
 1541| 			odata = d->mte_reg[regnr];
 1542| 	} else if (len != 4) {
 1543| 		if (writeflag == MEM_WRITE) {
 1544| 			d->mte_reg[regnr+1] = idata >> 32;
 1545| 			d->mte_reg[regnr] = idata;
 1546| 		} else {
 1547| 			odata = ((uint64_t)d->mte_reg[regnr+1] << 32) +
 1548| 			    d->mte_reg[regnr];
 1549| 		}
 1550| 	} else {
 1551| 		fatal("[ sgi_mte: UNIMPLEMENTED read/write len %i ]\n", len);
 1552| 		exit(1);
 1553| 	}
