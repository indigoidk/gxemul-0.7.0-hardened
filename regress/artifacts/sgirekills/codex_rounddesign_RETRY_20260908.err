  671| 
  672| /*
  673|  *  dev_sgi_re_init():
  674|  */
  675| void dev_sgi_re_init(struct machine *machine, struct memory *mem, uint64_t baseaddr)
  676| {
  677| 	struct sgi_re_data *d;
  678| 
  679| 	CHECK_ALLOCATION(d = (struct sgi_re_data *) malloc(sizeof(struct sgi_re_data)));
  680| 	memset(d, 0, sizeof(struct sgi_re_data));
  681| 
  682| 	memory_device_register(mem, "sgi_re", baseaddr + 0x1000, DEV_SGI_RE_LENGTH,
  683| 	    dev_sgi_re_access, d, DM_DEFAULT, NULL);
  684| 
  685| 	dev_sgi_de_init(mem, baseaddr + 0x2000, d);
  686| 	dev_sgi_mte_init(mem, baseaddr + 0x3000, d);
  687| 	dev_sgi_de_status_init(mem, baseaddr + 0x4000, d);
  688| }
