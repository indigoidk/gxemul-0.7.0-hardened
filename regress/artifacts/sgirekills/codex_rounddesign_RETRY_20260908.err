 1555| 	switch (relative_addr) {
 1556| 
 1557| 	case CRIME_MTE_MODE:
 1558| 		debug("[ sgi_mte: %s CRIME_MTE_MODE: 0x%016llx ]\n",
 1559| 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1560| 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1561| 		break;
 1562| 
 1563| 	case CRIME_MTE_BYTEMASK:
 1564| 		debug("[ sgi_mte: %s CRIME_MTE_BYTEMASK: 0x%016llx ]\n",
 1565| 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1566| 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
