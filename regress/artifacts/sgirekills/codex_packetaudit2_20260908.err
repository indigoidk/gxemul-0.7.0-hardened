71: 	SGIRE_W_TLBC_LEN  = 1 << 2,
72: 	SGIRE_W_TEX_LEN   = 1 << 3,
73: 	SGIRE_W_LINA_LEN  = 1 << 4,
74: 	SGIRE_W_LINB_LEN  = 1 << 5,
75: 
76: 	/*  #498: sgi_de's width decline.  ONE bit, not six: the six above are one
77: 	    per SITE because six windows with six distinct message texts are walked
78: 	    in a single bring-up session, and one latch would report the first and
79: 	    silence five.  sgi_de has ONE guard and ONE message text, so the house
80: 	    per-message-site rule gives one bit.  Measured cost: `sb' then `sh' at
81: 	    one offset announces len=1 and never len=2 -- accepted, and small,
82: 	    because the message already prints the width.
83: 
84: 	    It must be its OWN bit.  Reusing SGIRE_W_TLBA_LEN scored 23/25: the
85: 	    four handlers share one malloc'd struct, so any odd-width access to
86: 	    sgi_re's TLB_A window would silence sgi_de's decline entirely.  */
87: 	SGIRE_W_DE_LEN    = 1 << 6,
88: 
89: 	/*  #499: the unmatched-address catch-all.  TWO bits, one per DIRECTION:
90: 	    a driver probing an unmapped window commonly reads and writes it in
91: 	    one pass, and one bit would announce the first and silence the other.
92: 
93: 	    PLACED AFTER SGIRE_W_DE_LEN ON PURPOSE.  An earlier draft inserted
94: 	    these two after SGIRE_W_LINB_LEN (1 << 5), which left the enum ending
95: 	    at 1 << 6 -- so a maintainer scanning to the LAST enumerator for the
96: 	    next free bit would take 1 << 7, WHICH THESE TWO LINES BELOW ALREADY
97: 	    USE.  A duplicate enumerator is legal C and silent, and all four
98: 	    handlers share one malloc'd struct, so the collision crosses devices.
99: 
100: 	    (Wording sharpened after a pass-2 seat read "which is already used"
101: 	    as a standalone claim about 1 << 7 and reported the comment as
102: 	    self-contradictory against the code three lines down.  The claim was
103: 	    right and the sentence did not say BY WHAT.)  */
104: 	SGIRE_W_UNMAP_WR  = 1 << 7,
105: 	SGIRE_W_UNMAP_RD  = 1 << 8,
106: 
107: 	/*  #500: draw_primitive()'s unimplemented drawing op.  ITS OWN BIT,
108: 	    for the reason #498 measured on SGIRE_W_DE_LEN: a latch shared with
109: 	    another site is silenced by that site's ordinary traffic, so the
110: 	    announce this fix exists to make would never fire.
111: 
112: 	    (This comment used to end "The next free bit is 1 << 10; the enum
113: 	    ends HERE on purpose so that a maintainer scanning to the last
114: 	    enumerator finds it."  BOTH HALVES WENT FALSE when sgirandompixel
115: 	    added SGIRE_W_BADMODE = 1 << 10 BELOW this line.  Demoted rather
116: 	    than deleted, because the REASONING is still why the convention
117: 	    exists -- and leaving it live would have pointed the next reader at
118: 	    a taken bit, which is the duplicate-enumerator collision #499
119: 	    already paid for and warns about four lines up.  The live
120: 	    next-free claim is on the LAST enumerator, where it belongs.)  */
121: 	SGIRE_W_PRIM_OP   = 1 << 9,
122: 
123: 	/*  sgirandompixel: horrible_getputpixel()'s unimplemented-mode arm.  ITS
124: 	    OWN BIT, for the reason #498 measured and #500 repeated -- the four
125: 	    handlers share one malloc'd struct, so a latch shared with another
126: 	    site is silenced by that site's ordinary traffic and the announce
127: 	    never fires.  This one matters more than most: the helper is
128: 	    PER-PIXEL, called inside line, rectangle and tiled-MTE loops, so an
129: 	    UNLATCHED announce is a per-pixel flood rather than a diagnostic.
130: 
131: 	    (This comment used to end "The next free bit is 1 << 11; the enum
132: 	    ends HERE on purpose, as above."  BOTH HALVES WENT FALSE when #513
133: 	    added SGIRE_W_TEX_RD = 1 << 11 BELOW this line -- the SAME failure,
134: 	    in the SAME enum, that the comment ten lines up already records
135: 	    happening to SGIRE_W_PRIM_OP.  Demoted rather than deleted, for that
136: 	    comment's own reason: the REASONING is still why the convention
137: 	    exists, and leaving the claim live would point the next reader at a
138: 	    TAKEN bit.  The live next-free claim is on the LAST enumerator.)  */
139: 	SGIRE_W_BADMODE   = 1 << 10,
140: 
141: 	/*
142: 	    #513: THE TEX READ DECLINE GETS ITS OWN BIT, not SGIRE_W_TEX_LEN.
143: 	    Sharing one was measured at 23/25 for SGIRE_W_DE_LEN in #498: an
144: 	    ordinary narrow write fires the width latch, and the read decline is
145: 	    then silently suppressed for the life of the instance.  The detector
146: 	    has a row for exactly this (`tex xbit', which fires all six width
147: 	    latches before reading).
148: 
149: 	    THE NEXT FREE BIT IS 1 << 12, AND THIS IS THE LAST ENUMERATOR --
150: 	    which is where that claim belongs, per the convention two comments
151: 	    up.  A maintainer adding a bit BELOW this line must move this
152: 	    sentence with it and demote the copy here, exactly as #513 had to
153: 	    demote SGIRE_W_BADMODE's.
154: 	 */
155: 	SGIRE_W_TEX_RD    = 1 << 11,
156: };
157: 
158: struct sgi_re_data {
159: 	// Rendering engine registers:
160: 	uint16_t	re_tlb_a[256];
161: 	uint16_t	re_tlb_b[256];
162: 	uint16_t	re_tlb_c[256];
163: 	uint16_t	re_tex[112];
164: 	// todo: clip_ids registers.
188: 	 */
189: 	uint32_t	warned;
190: };
191: 
192: 
193: /*
194:  *  horrible_getputpixel():
195:  *
196:  *  This routine gets/puts a pixel in one of the tiles, from the perspective of
197:  *  the rendering/drawing engine. Given x and y, it figures out which tile
198:  *  number it is, and then finally does a slow read/write to get/put the pixel
199:  *  at the correct sub-coordinates within the tile.
200:  *
201:  *  Tiles are always 512 _bytes_ wide, and 128 pixels high. For 32-bit color
202:  *  modes, for example, that means 128 x 128 pixels.
203:  *
204:  *  For "linear" modes, y is ignored and x is an offset to select which linear
205:  *  TLB entry to use.
206:  */
207: void horrible_getputpixel(int put, struct cpu* cpu, struct sgi_re_data* d,
208: 	int x, int y, uint32_t* color, int mode)
209: {
210: 	uint32_t color_mode = mode & DE_MODE_TYPE_MASK;
211: 	int bufdepth = 1 << ((mode >> 8) & 3); 
212: 
213: 	// dst_mode (see NetBSD's crmfbreg.h):
214: 	// #define DE_MODE_TLB_A           0x00000000
215: 	// #define DE_MODE_TLB_B           0x00000400
216: 	// #define DE_MODE_TLB_C           0x00000800
217: 	// #define DE_MODE_LIN_A           0x00001000
218: 	// #define DE_MODE_LIN_B           0x00001400
219: 	uint32_t tlb_mode = (mode >> 10) & 0x7;
220: 	int linear = tlb_mode > 3;
221: 
222: 	if (!linear && (x < 0 || y < 0 || x >= 2048 || y >= 2048))
223: 		return;
224: 
225: 	int tilewidth_in_pixels = 512 / bufdepth;
226: 	
227: 	int tile_nr_x = x / tilewidth_in_pixels;
228: 	int tile_nr_y = y >> 7;
229: 
230: 	unsigned int tile_nr = tile_nr_y * 16 + tile_nr_x;
231: 
232: 	y &= 127;
233: 	int xofs = (x % tilewidth_in_pixels) * bufdepth;
234: 	int ofs = 512 * y + xofs;
235: 
236: 	uint32_t tileptr = 0;
237: 
238: 	/*  #100: cases 0-2 index re_tlb_[abc][256] with a guest-derived
239: 	    tile_nr = (y>>7)*16 + x/tilewidth; bound it (case 4 self-checks).  */
240: 	if (tlb_mode <= 2 && tile_nr >= 256)
241: 		return;
242: 
243: 	switch (tlb_mode) {
244: 	case 0:	tileptr = d->re_tlb_a[tile_nr] << 16;
245: 		break;
246: 	case 1:	tileptr = d->re_tlb_b[tile_nr] << 16;
247: 		break;
248: 	case 2:	tileptr = d->re_tlb_c[tile_nr] << 16;
249: 		break;
250: 	case 4:	tile_nr = x >> 12;
251: 		if (tile_nr >= 32)
252: 			return;
253: 		tileptr = 0x80000000 | (d->re_linear_a[tile_nr] << 12);
254: 		ofs = x & 4095;
255: 		// TODO... probably not correct!
256: 		// printf("tileptr = %08x x = %i y = %i tile_nr = %i ofs = %i\n", tileptr, x, y, tile_nr, ofs);
257: 		break;
258: 	default:/*  sgirandompixel: this arm used to assign `*color = random()' -- with
259: 		    its exit(1) commented out -- so a failed GET handed the CALLER a
260: 		    random value, and draw_primitive() then wrote it to the destination
261: 		    in the same loop iteration, since `color' is shared by the XFER GET
262: 		    and the PUT.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes
263: 		    crmfbreg.h documents and extracts to tlb_mode 5, so this was
264: 		    reachable with a DOCUMENTED mode, not only with a junk one.
265: 		    MEASURED, rung 3: the destination received 0x4b1763a1, 0x2ee4b4df
272: 		    per-pixel.
273: 
274: 		    WHAT THIS DOES NOT DO, filed rather than silently omitted: the
275: 		    caller STILL PERFORMS its dependent PUT, so a declined GET still
276: 		    writes fg (row sgirandomskipput -- suppressing it needs a return
277: 		    value and every GET site changed, which is more than one site);
278: 		    LIN_B is still not implemented, and the panel refused to endorse
279: 		    implementing it as LIN_A-with-the-other-array on symmetry alone
280: 		    (row sgirelinb); and the COLOUR-mode switch below carries the same
281: 		    random() shape at its own default (row sgirandomcolour).  */
282: 		if (!(d->warned & SGIRE_W_BADMODE)) {
283: 			d->warned |= SGIRE_W_BADMODE;
284: 			/*  `dst_mode' is kept from the original text although the
285: 			    parameter is also passed as src_mode on a GET: the probe
286: 			    anchors on this literal, and rewording it here would be
287: 			    scope creep AND would move an oracle anchor mid-round,
288: 			    which is the laundering shape whatever the intent.
289: 			    Filed as sgirenamedstmode.  */
290: 			fatal("[ sgi_re: unimplemented dst_mode %i for "
291: 			    "horrible_getputpixel (%s), x=%i y=%i; declined "
292: 			    "(once) ]\n", mode, put ? "put" : "get", x, y);
293: 		}
294: 		return;
295: 	}
296: 
297: 	// The highest bit seems to be set for a "valid" tile pointer.
298: 	if (!(tileptr & 0x80000000)) {
299: 		//printf("dst_mode %i, tile_nr = %i,  tileptr = 0x%llx\n", dst_mode, tile_nr, (long long)tileptr);
300: 		//fatal("sgi gbe horrible_getputpixel: unexpected non-set high bit of tileptr?\n");
301: 		//exit(1);
302: 		return;
303: 	}
304: 	
305: 	tileptr &= ~0x80000000;
306: 
307: 	uint8_t buf[8];		/* #100: bufdepth can be 8 = 1<<((mode>>8)&3) */
308: 	if (put) {
309: 		switch (color_mode) {
310: 		case DE_MODE_TYPE_CI:
311: 			buf[0] = *color;
312: 			break;
313: 		case DE_MODE_TYPE_RGB:
314: 			buf[0] = *color >> 24;
315: 			buf[1] = *color >> 16;
316: 			buf[2] = *color >> 8;
317: 			buf[3] = 0;
318: 			break;
319: 		case DE_MODE_TYPE_RGBA:
320: 			buf[0] = *color >> 24;
321: 			buf[1] = *color >> 16;
322: 			buf[2] = *color >> 8;
323: 			buf[3] = *color;
324: 			break;
325: 		case DE_MODE_TYPE_ABGR:
326: 			buf[0] = *color;
327: 			buf[1] = *color >> 8;
328: 			buf[2] = *color >> 16;
329: 			buf[3] = *color >> 24;
330: 			break;
331: 		default:buf[0] = random();
332: 			buf[1] = random();
333: 			buf[2] = random();
334: 			buf[3] = random();
335: 			// TODO.
336: 			fatal("[ put: color mode = 0x%x ]\n", color_mode);
337: 		}
338: 
339: 		cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
340: 		    buf, bufdepth, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
341: 	} else {
342: 		cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
343: 		    buf, bufdepth, MEM_READ, NO_EXCEPTIONS | PHYSICAL);
344: 
345: 		switch (color_mode) {
346: 		case DE_MODE_TYPE_CI:
347: 			*color = buf[0];
348: 			break;
349: 		case DE_MODE_TYPE_RGB:
350: 			/*  #505: this read buf[1..3] while the PUT arm above
351: 			    writes the three channels at buf[0..2] and an
352: 			    explicit pad at buf[3] -- so an RGB pixel did not
353: 			    survive its own round trip, shifting one byte left
354: 			    with a zero fill on every RGB source read.
355: 
356: 			    The PUT arm is the authoritative one, and the
357: 			    warrant is OUTSIDE this function: dev_sgi_gbe.c's
358: 			    scanout reads the same tile memory back for display
359: 			    as (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3],
360: 			    then CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
361: 			    31..24, 23..16 and 15..8 -- byte 0 is R and byte 3
362: 			    is UNUSED.  So the pad sits at buf[3] because the
363: 			    consumer ignores buf[3], not because PUT writes a
364: 			    zero there; that is what makes this non-circular.
365: 			    The RGBA and ABGR PUT arms independently agree --
366: 			    both lay [R,G,B,x] in memory despite opposite
367: 			    register word orders -- which leaves this GET the
368: 			    lone container outlier among the 32-bit arms.
369: 
370: 			    The low byte stays ZERO on purpose: RGB carries
371: 			    three channels, so a corrected read of 0xaabbccdd
372: 			    yields 0xaabbcc00, NOT the source word.  */
373: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
374: 			break;
375: 		case DE_MODE_TYPE_RGBA:
376: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
377: 			break;
378: 		case DE_MODE_TYPE_ABGR:
379: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
380: 			break;
381: 		default:// Read "raw" 32-bit value:
382: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
383: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
384: 		}
385: 	}
386: }
387: 
388: 
389: /*
390:  *  SGI "re", NetBSD sources describes it as a "rendering engine".
391:  */
392: 
453: 	 *  rather than {8} (sgidewidth).
454: 	 */
455: 	if (relative_addr >= CRIME_RE_TLB_A && relative_addr < CRIME_RE_TLB_B) {
456: 		if (len != 8) {
457: 			if (!(d->warned & SGIRE_W_TLBA_LEN)) {
458: 				d->warned |= SGIRE_W_TLBA_LEN;
459: 				fatal("[ sgi_re: unimplemented len=%i for "
460: 				    "CRIME_RE_TLB_A -- declined.  (once) ]\n",
461: 				    (int) len);
462: 			}
463: 		} else if (writeflag == MEM_WRITE) {
464: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
465: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
466: 				d->re_tlb_a[tlbi] = data[hwi]*256 + data[hwi+1];
467: 				debug("d->re_tlb_a[%i] = 0x%04x\n", tlbi, d->re_tlb_a[tlbi]);
468: 				tlbi++;
469: 			}
470: 		} else {
471: 			/*
472: 			 *  #513: ACCEPT.  A guest read of a len == 8 TLB slot ended
473: 			 *  the host.  The write arm directly above already computes
474: 			 *  and stores the value, so the disposition is member 4 of
475: 			 *  the option set -- delete the kill and RETURN THE VALUE --
476: 			 *  rather than a decline: nothing is unimplemented here.
477: 			 *  This loop is the exact inverse of the write loop, cell for
478: 			 *  cell and shift for shift.
479: 			 *
480: 			 *  *** IT MUST WRITE odata, NOT data[]. ***  The function's
481: 			 *  common tail is
482: 			 *      if (writeflag == MEM_READ)
483: 			 *              memory_writemax64(cpu, data, len, odata);
484: 			 *  so anything stored into data[] here is overwritten before
485: 			 *  it reaches the guest.  A first draft of this fix filled
486: 			 *  data[] and would have returned zeroes while looking right.
487: 			 */
488: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
489: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
490: 				odata = (odata << 16) | d->re_tlb_a[tlbi];
491: 				tlbi++;
492: 			}
493: 		}
494: 	} else if (relative_addr >= CRIME_RE_TLB_B && relative_addr < CRIME_RE_TLB_C) {
495: 		if (len != 8) {
496: 			if (!(d->warned & SGIRE_W_TLBB_LEN)) {
497: 				d->warned |= SGIRE_W_TLBB_LEN;
498: 				fatal("[ sgi_re: unimplemented len=%i for "
499: 				    "CRIME_RE_TLB_B -- declined.  (once) ]\n",
500: 				    (int) len);
501: 			}
502: 		} else if (writeflag == MEM_WRITE) {
503: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
504: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
505: 				d->re_tlb_b[tlbi] = data[hwi]*256 + data[hwi+1];
506: 				debug("d->re_tlb_b[%i] = 0x%04x\n", tlbi, d->re_tlb_b[tlbi]);
507: 				tlbi++;
508: 			}
509: 		} else {
510: 			/*  #513: ACCEPT -- the inverse of the write loop.  See the
511: 			    CRIME_RE_TLB_A arm for why this sets odata, not data[].  */
512: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
513: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
514: 				odata = (odata << 16) | d->re_tlb_b[tlbi];
515: 				tlbi++;
516: 			}
517: 		}
518: 	} else if (relative_addr >= CRIME_RE_TLB_C && relative_addr < CRIME_RE_TLB_C + 0x200) {
519: 		if (len != 8) {
520: 			if (!(d->warned & SGIRE_W_TLBC_LEN)) {
521: 				d->warned |= SGIRE_W_TLBC_LEN;
522: 				fatal("[ sgi_re: unimplemented len=%i for "
523: 				    "CRIME_RE_TLB_C -- declined.  (once) ]\n",
524: 				    (int) len);
525: 			}
526: 		} else if (writeflag == MEM_WRITE) {
527: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
528: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
529: 				d->re_tlb_c[tlbi] = data[hwi]*256 + data[hwi+1];
530: 				debug("d->re_tlb_c[%i] = 0x%04x\n", tlbi, d->re_tlb_c[tlbi]);
531: 				tlbi++;
532: 			}
533: 		} else {
534: 			/*  #513: ACCEPT -- the inverse of the write loop.  See the
535: 			    CRIME_RE_TLB_A arm for why this sets odata, not data[].  */
536: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
537: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
538: 				odata = (odata << 16) | d->re_tlb_c[tlbi];
539: 				tlbi++;
540: 			}
541: 		}
542: 	} else if (relative_addr >= CRIME_RE_TEX && relative_addr < CRIME_RE_TEX + 0xe0) {
543: 		if (len != 8) {
544: 			if (!(d->warned & SGIRE_W_TEX_LEN)) {
545: 				d->warned |= SGIRE_W_TEX_LEN;
546: 				fatal("[ sgi_re: unimplemented len=%i for "
547: 				    "CRIME_RE_TEX -- declined.  (once) ]\n",
548: 				    (int) len);
549: 			}
550: 		} else if (writeflag == MEM_WRITE) {
551: 			int tlbi = ((relative_addr & 0xff) >> 3) & 0xff;
552: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
553: 				d->re_tex[tlbi] = data[hwi]*256 + data[hwi+1];
554: 				debug("d->re_tex[%i] = 0x%04x\n", tlbi, d->re_tex[tlbi]);
555: 				tlbi++;
556: 			}
557: 		} else {
558: 			/*
559: 			 *  #513: DECLINE + LATCHED ANNOUNCE -- and TEX is the ONE arm
560: 			 *  of the six that is NOT an accept.  The warrant is specific
561: 			 *  and is recorded as `sgitexindex':
562: 			 *
563: 			 *    - the write arm's index is `>> 3' where a flat
564: 			 *      uint16_t[112] incremented once per halfword needs the
565: 			 *      register number times four.  The SGI CRIME specification
566: 			 *      lists TLB.tex[28] as 28 separate 64-bit registers, so
567: 			 *      `>> 3' is the REGISTER number and the missing factor of
568: 			 *      four is the defect;
569: 			 *    - consequently only 31 of the 112 cells are reachable and
570: 			 *      consecutive registers overlap by three;
571: 			 *    - `re_tex' has NO consumer anywhere in this file -- it is
572: 			 *      written and debug-printed, never read back.
573: 			 *
574: 			 *  Accepting the read would therefore publish a mapping the
575: 			 *  project has already recorded as wrong, and turn a future
576: 			 *  sgitexindex fix into a breaking change to a shipped oracle.
577: 			 *  Declining costs nothing today (no consumer) and leaves that
578: 			 *  round free.  sgitexindex carries a standing do-not-code
579: 			 *  ruling, so this round does not touch the shift.
580: 			 */
581: 			if (!(d->warned & SGIRE_W_TEX_RD)) {
582: 				d->warned |= SGIRE_W_TEX_RD;
583: 				fatal("[ sgi_re: unimplemented read from "
584: 				    "CRIME_RE_TEX -- declined.  (once) ]\n");
585: 			}
586: 		}
587: 	} else if (relative_addr >= CRIME_RE_LINEAR_A && relative_addr < CRIME_RE_LINEAR_A + 0x80) {
1124: 	idata = memory_readmax64(cpu, data, len);
1125: 	regnr = relative_addr / sizeof(uint32_t);
1126: 
1127: 	relative_addr += 0x2000;
1128: 
1129: 	/*
1130: 	 *  Treat all registers as read/write, by default.  Sometimes these
