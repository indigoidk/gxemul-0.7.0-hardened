1453: 
1454: 	int lsb = (uint8_t)ic->arg[2];
1455: 	int msb = ic->arg[2] >> 16;
1456: 	int width = msb - lsb + 1;
1457: 
1458: 	x <<= lsb;
1459: 
1460: 	uint32_t mask = (1 << width) - 1;
1461: 
1462: 	mask <<= lsb;
1463: 
1464: 	reg(ic->arg[0]) &= ~mask;
1465: 	reg(ic->arg[0]) |= (x & mask);
1466: }
