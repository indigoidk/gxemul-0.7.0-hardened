  212: 
  213: 	// dst_mode (see NetBSD's crmfbreg.h):
  214: 	// #define DE_MODE_TLB_A           0x00000000
  215: 	// #define DE_MODE_TLB_B           0x00000400
  216: 	// #define DE_MODE_TLB_C           0x00000800
  217: 	// #define DE_MODE_LIN_A           0x00001000
  218: 	// #define DE_MODE_LIN_B           0x00001400
