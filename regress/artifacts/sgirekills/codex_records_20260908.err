  252: 			return;
  253: 		tileptr = 0x80000000 | (d->re_linear_a[tile_nr] << 12);
  254: 		ofs = x & 4095;
  255: 		// TODO... probably not correct!
  256: 		// printf("tileptr = %08x x = %i y = %i tile_nr = %i ofs = %i\n", tileptr, x, y, tile_nr, ofs);
  257: 		break;
  258: 	default:/*  sgirandompixel: this arm used to assign `*color = random()' -- with
  259: 		    its exit(1) commented out -- so a failed GET handed the CALLER a
  260: 		    random value, and draw_primitive() then wrote it to the destination
  261: 		    in the same loop iteration, since `color' is shared by the XFER GET
