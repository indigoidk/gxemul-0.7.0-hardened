 1783:  *  dev_sgi_mte_init():
 1784:  */
 1785: void dev_sgi_mte_init(struct memory *mem, uint64_t baseaddr, struct sgi_re_data *d)
 1786: {
 1787: 	memory_device_register(mem, "sgi_mte", baseaddr, DEV_SGI_MTE_LENGTH,
 1788: 	    dev_sgi_mte_access, (void *)d, DM_DEFAULT, NULL);
 1789: }
