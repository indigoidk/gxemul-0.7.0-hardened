  222: 	if (!linear && (x < 0 || y < 0 || x >= 2048 || y >= 2048))
  223: 		return;
  224: 
  225: 	int tilewidth_in_pixels = 512 / bufdepth;
  226: 	
  227: 	int tile_nr_x = x / tilewidth_in_pixels;
  228: 	int tile_nr_y = y >> 7;
  229: 
  230: 	unsigned int tile_nr = tile_nr_y * 16 + tile_nr_x;
  231: 
  232: 	y &= 127;
  233: 	int xofs = (x % tilewidth_in_pixels) * bufdepth;
  234: 	int ofs = 512 * y + xofs;
  235: 
  236: 	uint32_t tileptr = 0;
  237: 
  238: 	/*  #100: cases 0-2 index re_tlb_[abc][256] with a guest-derived
  239: 	    tile_nr = (y>>7)*16 + x/tilewidth; bound it (case 4 self-checks).  */
  240: 	if (tlb_mode <= 2 && tile_nr >= 256)
  241: 		return;
  242: 
  243: 	switch (tlb_mode) {
  244: 	case 0:	tileptr = d->re_tlb_a[tile_nr] << 16;
  245: 		break;
  246: 	case 1:	tileptr = d->re_tlb_b[tile_nr] << 16;
  247: 		break;
  248: 	case 2:	tileptr = d->re_tlb_c[tile_nr] << 16;
  249: 		break;
  250: 	case 4:	tile_nr = x >> 12;
