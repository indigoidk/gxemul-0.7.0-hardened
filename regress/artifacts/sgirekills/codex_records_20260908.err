 1623: 				if (entry & 0x80000000) {
 1624: 					entry &= ~0x80000000;
 1625: 					if (entry == starting_page) {
 1626: 						match = 1;
 1627: 						break;
 1628: 					}
 1629: 				}
 1630: 			}
 1631: 			
 1632: 			if (match) {
 1633: 				cpu->memory_rw(cpu, cpu->mem, fill_addr, zerobuf, fill_len,
 1634: 					MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
 1635: 			} else {
 1636: 				debug("[ sgi_mte: WARNING: address 0x%x not found in TLB? Ignoring fill. ]\n",
 1637: 					(long long)fill_addr);
 1638: 			}
 1639: 
 1640: 			fill_addr += fill_len;
 1641: 			dstlen -= (uint32_t)fill_len;	/* OB-23: subtract bytes actually filled */
 1642: 		}
 1643: 		break;
 1644: 	default:
 1645: 		fatal("[ sgi_mte: TODO! unimplemented dst_tlb 0x%x ]", dst_tlb);
 1646: 	}
 1647: }
 1648: 
 1649: DEVICE_ACCESS(sgi_mte)
 1650: {
 1651: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
 1652: 	uint64_t idata = 0, odata = 0;
 1653: 	int regnr;
 1654: 	int startFlag = relative_addr & CRIME_DE_START;
 1655: 
 1656: 	relative_addr &= ~CRIME_DE_START;
 1657: 
 1658: 	idata = memory_readmax64(cpu, data, len);
 1659: 	regnr = relative_addr / sizeof(uint32_t);
 1660: 
 1661: 	relative_addr += 0x3000;
 1662: 
 1663: 	/*
 1664: 	 *  Treat all registers as read/write, by default.  Sometimes these
 1665: 	 *  are accessed as 32-bit words, sometimes as 64-bit words.
 1666: 	 *
 1667: 	 *  NOTE: The lowest bits are internally stored in the "low" (+0)
 1668: 	 *  register, and the higher bits are stored in the "+1" word.
 1669: 	 */
 1670: 	if (len == 4) {
 1671: 		if (writeflag == MEM_WRITE)
 1672: 			d->mte_reg[regnr] = idata;
 1673: 		else
 1674: 			odata = d->mte_reg[regnr];
 1675: 	} else if (len != 4) {
 1676: 		if (writeflag == MEM_WRITE) {
 1677: 			d->mte_reg[regnr+1] = idata >> 32;
 1678: 			d->mte_reg[regnr] = idata;
 1679: 		} else {
 1680: 			odata = ((uint64_t)d->mte_reg[regnr+1] << 32) +
 1681: 			    d->mte_reg[regnr];
 1682: 		}
 1683: 	} else {
 1684: 		fatal("[ sgi_mte: UNIMPLEMENTED read/write len %i ]\n", len);
 1685: 		exit(1);
 1686: 	}
 1687: 
 1688: 	switch (relative_addr) {
 1689: 
 1690: 	case CRIME_MTE_MODE:
 1691: 		debug("[ sgi_mte: %s CRIME_MTE_MODE: 0x%016llx ]\n",
 1692: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1693: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1694: 		break;
 1695: 
 1696: 	case CRIME_MTE_BYTEMASK:
 1697: 		debug("[ sgi_mte: %s CRIME_MTE_BYTEMASK: 0x%016llx ]\n",
 1698: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1699: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1700: 		break;
 1701: 
 1702: 	case CRIME_MTE_STIPPLEMASK:
 1703: 		fatal("[ sgi_mte: %s CRIME_MTE_STIPPLEMASK: 0x%016llx ]\n",
 1704: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1705: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1706: 		break;
 1707: 
 1708: 	case CRIME_MTE_BG:
 1709: 		debug("[ sgi_mte: %s CRIME_MTE_BG: 0x%016llx ]\n",
 1710: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1711: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1712: 		break;
 1713: 
 1714: 	case CRIME_MTE_SRC0:
 1715: 		debug("[ sgi_mte: %s CRIME_MTE_SRC0: 0x%016llx ]\n",
 1716: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1717: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1718: 		break;
 1719: 
 1720: 	case CRIME_MTE_SRC1:
 1721: 		debug("[ sgi_mte: %s CRIME_MTE_SRC1: 0x%016llx ]\n",
 1722: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1723: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1724: 		break;
 1725: 
 1726: 	case CRIME_MTE_DST0:
 1727: 		debug("[ sgi_mte: %s CRIME_MTE_DST0: 0x%016llx ]\n",
 1728: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1729: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1730: 		break;
 1731: 
 1732: 	case CRIME_MTE_DST1:
 1733: 		debug("[ sgi_mte: %s CRIME_MTE_DST1: 0x%016llx ]\n",
 1734: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1735: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1736: 		break;
 1737: 
 1738: 	case CRIME_MTE_SRC_Y_STEP:
 1739: 		debug("[ sgi_mte: %s CRIME_MTE_SRC_Y_STEP: 0x%016llx ]\n",
 1740: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1741: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1742: 		break;
 1743: 
 1744: 	case CRIME_MTE_DST_Y_STEP:
 1745: 		debug("[ sgi_mte: %s CRIME_MTE_DST_Y_STEP: 0x%016llx ]\n",
 1746: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1747: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1748: 		break;
 1749: 
 1750: 	case CRIME_MTE_NULL:
 1751: 		fatal("[ sgi_mte: %s CRIME_MTE_NULL: 0x%016llx ]\n",
 1752: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1753: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1754: 		break;
 1755: 
 1756: 	case CRIME_MTE_FLUSH:
 1757: 		fatal("[ sgi_mte: %s CRIME_MTE_FLUSH: 0x%016llx ]\n",
 1758: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1759: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1760: 		break;
 1761: 
 1762: 	default:
 1763: 		if (writeflag == MEM_WRITE)
 1764: 			fatal("[ sgi_mte: unimplemented write to "
 1765: 			    "address 0x%llx, data=0x%016llx ]\n",
 1766: 			    (long long)relative_addr, (long long)idata);
 1767: 		else
 1768: 			fatal("[ sgi_mte: unimplemented read from address"
 1769: 			    " 0x%llx ]\n", (long long)relative_addr);
 1770: 	}
 1771: 
 1772: 	if (startFlag)
 1773: 		do_mte_transfer(cpu, d);
 1774: 
 1775: 	if (writeflag == MEM_READ)
 1776: 		memory_writemax64(cpu, data, len, odata);
 1777: 
 1778: 	return 1;
 1779: }
