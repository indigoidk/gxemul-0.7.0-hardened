  702: 			/*
  703: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  704: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  705: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  706: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  707: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  708: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  709: 			 *  alignment is supplied by two independent mechanisms, and both
  710: 			 *  were checked rather than assumed:
  711: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  712: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  713: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  714: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  715: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  716: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
  717: 			 *      three of its memory_rw calls, so it cannot deliver an
  718: 			 *      unaligned len == 8 either.
  719: 			 *  Narrower accesses carry len != 8 and are declined above, and
  720: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  721: 			 *  so no other CPU family reaches this handler.
  722: 			 *
  723: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  724: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  725: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  726: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  727: 			 *  the invariant above is stated for GUEST paths only.  It also
  728: 			 *  means `put d' must NOT be used to "witness" the over-run:
  729: 			 *  it bypasses the guest instruction path, so a reproduction
  730: 			 *  built on it would be laundering rather than witnessing.
  731: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  732: 			 *  NOT guest-reachable while this guard stands.
  733: 			 *
  734: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  735: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  736: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  737: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  738: 			 *  reaching a DRAWING-engine register from a rendering-engine
  739: 			 *  write -- not a wild write outside the allocation, and not
  740: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  741: 			 */
  742: 			if (!(d->warned & SGIRE_W_LINB_LEN)) {
  743: 				d->warned |= SGIRE_W_LINB_LEN;
  744: 				fatal("[ sgi_re: unimplemented len=%i for "
  745: 				    "CRIME_RE_LINEAR_B -- declined.  (once) ]\n",
  746: 				    (int) len);
  747: 			}
  748: 		} else if (writeflag == MEM_WRITE) {
  749: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
