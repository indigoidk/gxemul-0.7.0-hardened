 1428: 
 1429: #  ------------------------------------------------------------ pcc2defaultkill (#501)
 1430: #  The default: arm of DEVICE_ACCESS(pcc2) ended the host on any access to an uncased
 1431: #  offset, reads included.  Now: reads keep the served byte, writes are declined, one
 1432: #  latched announce per offset per instance.  The witness (regress/artifacts/pcc2defaultkill/
 1433: #  witness_20260905/, 7/13 on the committed build) is NOT run here; this is its detector.
 1434: PCC2DLOG=$LOGDIR/pcc2_default.log
 1435: python3 -u pcc2_default_probe.py "$PMAX" gate > "$PCC2DLOG" 2>&1 || true
 1436: if ! grep -q "PCC2D_PROBE_DONE" "$PCC2DLOG"; then
 1437:     check "pcc2 default probe completed" "no" "yes"
 1438: else
 1439:     check "pcc2 default probe completed" "yes" "yes"
 1440:     for v in "live" "devsig chipid" "named wr" "named wr msg" "named rd" "named rd msg" \
 1441:         "named rd srvd" "inword wr" "inword msg" "inword rdawr" "inword rd" "unnamed wr" \
 1442:         "unnamed msg" "unnamed rdawr" "unnamed rd" "ieicr rdawr" "ieerr rdawr" "sccerr rdawr" \
 1443:         "latch sameoff" "sameoff val" "latch twooff" "latch rw one" "latch rd rd" "latch rd wr" \
 1444:         "latch aba" "alias 0x6a" "alias msg" "dir wr text" "wr declined" "wr val text" \
 1445:         "dir rd text" "srvd val" "srvd val text" "srvd half text" "half wr rdawr" "srvd rd latch" \
 1446:         "srvd wr latch" "wide wr" "wide wr msg" "wide wr val" "wide rd" "wide rd srvd" \
 1447:         "genctl rt" "t1cmp word rt" "put b ctl" "put b ctl msg"; do
 1448:         check "pcc2 default row: $v" "$(count "$PCC2DLOG" "^$v  .*ok$")" "1"
 1449:     done
 1450:     check "pcc2 default rows emitted" "$(( $(count "$PCC2DLOG" " ok$") + $(count "$PCC2DLOG" " FAIL$") ))" "46"
 1451:     check "pcc2 default rows green"   "$(count "$PCC2DLOG" " ok$")"   "46"
 1452:     check "pcc2 default rows red"     "$(count "$PCC2DLOG" " FAIL$")" "0"
 1453: fi
 1454: 
 1455: 
 1456: PITLOG=$LOGDIR/pit8253_latch.log
 1457: python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PITLOG" 2>&1 || true
 1458: 
 1459: #  A PRESERVED LOG IS VERIFIED BY ITS COMPLETION SENTINEL, NOT BY ITS EXISTENCE.  The probe
 1460: #  gained PIT8253_LATCH_DONE specifically so this row could be written correctly the first
 1461: #  time -- before it, the last line was a bare "PASS", a word that occurs in dozens of other
 1462: #  contexts and cannot distinguish a COMPLETED run from a TRUNCATED one.
 1463: if ! grep -q "PIT8253_LATCH_DONE" "$PITLOG"; then
 1464:     note "pit8253 probe did not reach its completion sentinel; last lines follow"
 1465:     tail -5 "$PITLOG" | sed 's/^/       /'
 1466:     check "pit8253 probe completed" "no" "yes"
 1467: else
 1468:     grep -E "^  (ok|FAIL) " "$PITLOG" | sed 's/^/       /'
 1469: 
 1470:     #  THE THREE CONTROLS PLUS THE MMU-ON NEGATIVE CONTROL, each pinned by name.  A count of
 1471:     #  green rows would let a control go red while the total stayed acceptable.
 1472:     for c in "C1 liveness" "C2 MMU state" "A1 device signature" "T  MMU-ON control"; do
 1473:         check "pit8253 control: $c" \
 1474:               "$(grep -c "^  ok   $c" "$PITLOG")" "1"
 1475:     done
 1476: 
 1477:     #  Per-row presence.  A row that silently stops being tested is the padded-column class,
 1478:     #  so each is checked individually rather than by a total.  Eighteen rows: 4 controls +
 1479:     #  E/A2 apparatus + R0..R11.
 1480:     for v in "E  encodings" "A2 recompute stream" \
 1481:              "R0 the run produced data" "R1 latch preserves programming" \
 1482:              "R2 latch is not an error" "R3 latched read is not the reload" \
 1483:              "R4 16-bit readback is the reload" "R5 one recompute per write pair" \
 1484:              "R6 no transient count of zero" \
 1485:              "R7 read and write flip-flops are separate" \
 1486:              "R8 the latch is released by reading it" \
 1487:              "R9 a mid-pair latch completes the pair and lets go" \
 1488:              "R10 a Control Word rewinds the write flip-flop" \
 1489:              "R11 ...and it does so PER COUNTER, not just counter 0"; do
 1490:         check "pit8253 row green: $v" \
 1491:               "$(grep -c "^  ok   $v" "$PITLOG")" "1"
 1492:     done
 1493: 
 1494:     #  The denominator against a LITERAL: a probe that loses rows cannot pass by shrinking.
 1495:     check "pit8253 rows run" "$(grep -cE '^  (ok|FAIL) ' "$PITLOG")" "18"
 1496: fi
 1497: 
 1498: gate_end

