    1: #!/bin/bash
    2: # GATE 14 -- ARM subtract-family carry flags (#311) and undefined routing (#312).
    3: #
    4: # What this protects
    5: # -----------------
    6: # #311: the subtract family computed its carry-out as `a >= b`. That is
    7: # NOT-BORROW for SUB/CMP/RSB, which have no borrow-in, and WRONG for SBC/RSC,
    8: # whose result is `a - b - NOT(C)`. The two disagree exactly when `a == b` with
    9: # carry-in clear: `a - a - 1` borrows, so carry must be CLEAR, and `a >= b`
   10: # reported it SET. The fix takes the flag from the full 64-bit result the file
   11: # already computes (`c32 == c64`), which is the same answer as `a >= b` for the
   12: # three instructions that were already right.
   13: #
   14: # #312: ARM's permanently-undefined encodings reached `goto bad`, which sets
   15: # cpu->running = 0 (cpu_dyntrans.c) -- a legal-to-attempt instruction stopping
   16: # the whole emulator, the same halt class as #264/#309/#310. They now raise the
   17: # Undefined Instruction exception the silicon raises.
   18: #
   19: # This gate is known to be able to FAIL
   20: # ------------------------------------
   21: # It was run against the committed pre-fix build and scored 39 of the 56 rows it
   22: # had at that moment, failing in exactly the 17 places the three fixes were
   23: # predicted to flip and nowhere else. The two `subs rn=pc` pins were added after
   24: # that sweep and pass either way, so the same build on today's table would read
   25: # 41/58 -- stated exactly rather than restated as 39/58, because the count is
   26: # evidence and evidence does not get rounded to the number that sounds better.
   27: # That measurement is what shows these rows discriminate; gate 3's mutant
   28: # machinery does not reach here, because it operates on float_emul.c and this
   29: # gate measures the real emulator instead of a pure function.
   30: #
   31: # Swept again for #346 against a binary built from the parent commit: 162 of
   32: # 165, failing the three cache-clean rows the fix flips and nowhere else. The
   33: # two cache-clean CONTROL rows pass on both builds, which is what they are for.
   34: #
   35: # And again for #347 against a binary built from ITS parent (be6ea08): 168 of
   36: # 173, failing exactly the five `A cclean2 ... ` discriminators and nowhere
   37: # else. All three of that round's control/anti-clobber pins pass on both builds.
   38: #
   39: # And for round 99 (#348/#349/#350) against a binary built from the pre-fix
   40: # HEAD (dea2fef): 181 of 190, failing exactly the NINE new DISC rows -- the
   41: # two flags rows, the tail/zero/tail-V flag rows, the two fires rows,
   42: # `A cacheclean nonmult` reading "fold", and `A cacheclean zero n` reading
   43: # "none" -- and nowhere else. On the fixed build: 190/190. The retired
   44: # `A cclean2 still fold` control asserted the MISSING flags and was replaced
   45: # in the same change by the #349 marker rows, exactly as its own comment
   46: # required. The nonmult witness's first draft is itself a recorded lesson:
   47: # it expected a data abort at the top of RAM (measured false -- non-existent
   48: # reads log and continue) and compared a dump string unswapped, so it read
   49: # its own sentinel's parity; see run_cc_nonmult's docstring. Its "live"
   50: # verdict was then tightened in review to also demand load progress (r0
   51: # moved off 0x9120), closing a false pass against a guard that returns
   52: # without calling the load.
   53: #
   54: # Why most of this gate is PINs
   55: # ----------------------------
   56: # #311 rewrites ONE line that five instructions share, and two of them were
   57: # already correct. The pins are the point: they assert that SUB, RSB and CMP --
   58: # and the ADD/ADC arm of the same #if, which keeps its own `c32 != c64` test --
   59: # were not disturbed. A gate for this fix that checked only SBC and RSC would
   60: # not detect the regression that matters most.
   61: #
   62: # The decode-time row
   63: # ------------------
   64: # `udf cond-failed nop` is the strongest reachability statement here: a
   65: # conditional UDF whose condition is FALSE also stopped the committed
   66: # emulator, because `goto bad` fires during DECODE, before any condition is
   67: # evaluated. The guest never had to execute the instruction at all. That row
   68: # asserts execution continued AND no exception was raised as a SINGLE value,
   69: # because checking "no exception" alone would score a point on a build that
   70: # halted before reaching anything.
   71: set -u
   72: cd "$(dirname "$0")"
   73: . ./lib.sh
   74: 
   75: gate_begin "gate 14: ARM/Thumb flags (#311/#312/#319-#322/#328/#329)"
   76: 
   77: PMAX=${PMAX:-$ROOT/build/gxemul}
   78: LOG=$LOGDIR/gate_arm.log
   79: STUB=$LOGDIR/arm_stub.bin
   80: 
   81: need_exec "$PMAX"
   82: command -v python3 >/dev/null || gate_skip "python3 not available"
   83: 
   84: # `testarm` prints usage and exits without a file argument, so a four-byte raw
   85: # stub is loaded purely to make the machine construct. Every row overwrites it
   86: # before anything executes; it is scaffolding, not code under test.
   87: python3 -c "
   88: import struct, sys
   89: open(sys.argv[1], 'wb').write(struct.pack('<I', 0xe1a00000))
   90: " "$STUB" || gate_skip "could not write the load stub"
   91: 
   92: note "binary : $PMAX"
   93: note "machine: testarm/SA1110, cold debugger, RAM at 0"
   94: note "little-endian; every word read is byte-swapped back by the probe"
   95: note "flags read by the guest's own mrs r3,cpsr -- not a debugger register print"
   96: 
   97: python3 arm_flags_probe.py "$PMAX" "$STUB" > "$LOG" 2>&1 || true
   98: 
   99: if ! grep -q "ARM_FLAGS_RESULT=" "$LOG"; then
  100:     note "probe produced no result line; last lines follow"
  101:     tail -5 "$LOG" | sed 's/^/       /'
  102:     gate_skip "probe did not complete"
  103: fi
  104: 
  105: grep -E " ok$| FAIL$" "$LOG" | sed 's/^/       /'
  106: 
  107: # A probe whose control row failed has measured NOTHING and no other row may be
  108: # believed. This harness has been bitten by a probe that reported a defect off
  109: # sentinel reads while its guest code had never run.
  110: ctrl=$(grep -o "ARM_FLAGS_CONTROL=[A-Z]*" "$LOG" | tail -1 | cut -d= -f2)
  111: check "control row proves the probe measures" "${ctrl:-missing}" "OK"
  112: 
  113: res=$(grep -o "ARM_FLAGS_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
  114: got=${res%/*}; want=${res#*/}
  115: check "rows run"     "$want" 190
  116: check "rows correct" "$got"  "$want"
  117: 
  118: # Both classes must stay populated: a gate that is all pins cannot detect a
  119: # reverted fix, and one with no pins cannot detect collateral damage. The
  120: # floors track the deltas each round adds; a review seat noted they are far
  121: # below the actuals (112/78 after round 99) and so guard only against mass
  122: # reclassification, with `rows run` guarding deletion.
  123: disc=$(grep -c " DISC " "$LOG")
  124: pins=$(grep -c " PIN " "$LOG")
  125: check_min "discriminating rows present" "$disc" 58
  126: check_min "pinned rows present"         "$pins" 66
  127: 
  128: # Named rows, one contract each, so a single site reverting cannot hide behind
  129: # a total. Two spaces after the name: the probe pads names to a fixed column,
  130: # and a name that is a PREFIX of another would otherwise match both rows (the
  131: # trap that made three of gate 13's checks count the wrong rows).
  132: #
  133: # The SBC/RSC discriminators -- three different equal-operand values, because a
  134: # fix that special-cased one constant would pass a single row.
  135: # #340: the combiner rows. The two "combined" rows carry the defect; the two
  136: # "standalone" rows are the control that attributes it to the COMBINER rather
  137: # than to the instruction -- same encoding, same operands, no following branch;
  138: # and "flat C preserved" catches a fix that starts clobbering C on an
  139: # unrotated immediate, where the ISA preserves it. Named individually so one
  140: # reverting site cannot hide behind the total.
  141: for v in "A teq rot C combined" "A tst rot C combined" \
  142:          "A teq rot C standalone" "A tst rot C standalone" \
  143:          "A teq flat C preserved"; do
  144:     n=$(count "$LOG" "^$v  .*ok$")
  145:     check "  row: $v" "$n" 1
  146: done
  147: 
  148: # #342: the XOR-swap fold. The DISC row is its own proof that the fold
  149: # happened -- three standalone `eor rX,rX,rX` cannot leave a nonzero value, so
  150: # only X(xchg) could have produced the 0x5a the committed build returned.
  151: #
  152: # The swap rows are PINs in the shape the matcher actually accepts, Rm == Rd
  153: # (`eor X,Y,X`). The first version of them used Rn == Rd and so never matched
  154: # the combiner at all -- it was measuring three standalone EORs while claiming
  155: # to exercise the fold, which a review seat caught. They now run the FOLDED
  156: # handler on pass 2 and pin that its swap is correct, so a broken X(xchg) fails
  157: # here; they still cannot distinguish folded-and-correct from
  158: # not-folded-and-correct, which is why they are pins and not discriminators.
  159: for v in "A xchg same-reg zeroes" "A xchg same-reg r1 pin" \
  160:          "A xchg swap r0" "A xchg swap r1"; do
  161:     n=$(count "$LOG" "^$v  .*ok$")
  162:     check "  row: $v" "$n" 1
  163: done
  164: 
  165: # #345/#346/#348/#349/#350: the first cache-clean fold. Matcher probes, each
  166: # one field off the genuine `ldr r2,[r0],#32 / subs r1,r1,#0x20 / bne / mcr`,
  167: # so no row can be satisfied by the wrong guard:
  168: #
  169: #   r0/r1 intact  -- #345: base r5, counter r6. Its stride is 32 deliberately,
  170: #       so that #346's immediate check cannot block this fold and stand in for
  171: #       the register check the row exists to protect.
  172: #   imm4 r0/r2    -- #346: `ldr r2,[r0],#4` folded anyway and advanced r0 by 32,
  173: #       reading 0x9120 where the architecture returns 0x9104. r2 is the second
  174: #       half of that: the skipped load left it at its 0x77 seed.
  175: #   wrong Rd      -- `ldr r6,[r0],#32` folded and stranded r6 at 0x66.
  176: #
  177: # "fold r0" pins the closed form's arithmetic; "still folds" asserts the stale
  178: # r2, a defect deliberately unfixed (OUTSTANDING_BUGS), which makes it a fold
  179: # detector independent of #349's marker. The #348 rows ride a 0x40 counter --
  180: # at 0x20, a fix that skipped the r1 preload would be invisible:
  181: #
  182: #   flags         -- #348: seeded N|V (cmp r9,#0x80000000), the loop's zero
  183: #       exit owes Z|C = 0x6; the committed pre-fix build read the seed back.
  184: #   fold r1       -- the genuine counter result, 0, unasserted before round 99.
  185: #   nonmult       -- #350: a 0x21 counter re-entering the installed fold. The
  186: #       unguarded fold consumed it (r0 went odd: += 0x21); the guard falls
  187: #       back to the real loop, which never exits, and the session is forced
  188: #       back with ^C. The verdict is read from the registers: "fold" on an
  189: #       unaided exit with r0 odd, "live" only with the residue invariant
  190: #       AND r0 advanced off its phase-A value (load progress).
  191: #   quiet/fires   -- #349: the fold-fired marker, absent at default verbosity,
  192: #       present under `verbosity cpu 3` on the genuine loop only. The fires
  193: #       row is the channel's own positive control; ctrl proves selectivity.
  194: #   zero n        -- #350's r1 == 0 arm: the honest iteration count (2^27) is
  195: #       unassertable by any register or flag, so it is read off the marker
  196: #       text itself. A formula reverted to `r1 >> 5` prints 0 and fails.
  197: for v in "A cacheclean r0 intact" "A cacheclean r1 intact" \
  198:          "A cacheclean still folds" "A cacheclean fold r0" \
  199:          "A cacheclean imm4 r0" "A cacheclean imm4 r2" \
  200:          "A cacheclean wrong Rd" "A cacheclean flags" \
  201:          "A cacheclean fold r1" "A cacheclean nonmult" \
  202:          "A cacheclean quiet" "A cacheclean fires" \
  203:          "A cacheclean fires ctrl" "A cacheclean zero n"; do
  204:     n=$(count "$LOG" "^$v  .*ok$")
  205:     check "  row: $v" "$n" 1
  206: done
  207: 
  208: # #347/#348/#349: the SECOND cache-clean fold, which had BOTH halves of the
  209: # #347 defect -- `add rX,rX,#32 / subs rY,rY,#32` accepted for any X and Y,
  210: # and a handler that wrote no guest register at all -- and then the flags
  211: # defect #348 closed. Loops one field off the genuine
  212: # `mcr / mcr / add r0,r0,#32 / subs r1,r1,#32 / bhi`, plus counters for both
  213: # exits of the loop:
  214: #
  215: #   fold r0/r1    -- the genuine sequence. The committed #346-era handler
  216: #       returned r0 = 0x9100 and r1 = 0x40 for a loop that owes 0x9140 and 0.
  217: #   flags         -- #348: seeded N|V, the 0x40 counter's zero exit owes
  218: #       Z|C = 0x6. The pre-fix build read the seed back.
  219: #   base r5/r1    -- `add r5,r5,#32`: the fold fired anyway and stranded r5 at
  220: #       0x9100 and r1 at 0x40.
  221: #   cnt r6        -- `subs r6,r6,#32`: fired anyway, r6 left at 0x40.
  222: #   base r0 / cnt r1 -- the anti-clobber pins. They pass on the pre-fix build
  223: #       too, on purpose: they exist to catch the OPPOSITE error, a handler that
  224: #       now writes r[0]/r[1] by name behind a matcher that still takes any
  225: #       register. Without them the register guard could be dropped and only the
  226: #       rows above, which already pass, would notice.
  227: #   tail flags/r0/r1 -- the 0x30 counter exits on the subs BORROWING and owes
  228: #       N alone (0x8); the registers pin #347's closed form on the borrow
  229: #       path, which no earlier row covered. "tail V" repeats the run seeded
  230: #       V=1: V must come back 0 on the borrow exit too (it is structurally 0
  231: #       -- the final operand lies in [0, 0x20] for every uint32 counter).
  232: #   zero flags/r0/r1 -- counter 0, the one input where #347's `(r1 == 0 ||`
  233: #       disjunct is load-bearing: owes r0 += 0x20, r1 = 0xffffffe0, flags 0x8.
  234: #   quiet/fires   -- #349: the marker channel. The old `still fold` control
  235: #       asserted the MISSING flags (seeded N surviving) and was retired in the
  236: #       same change that fixed them, as its own comment required; the marker
  237: #       is its replacement as the only fold-fired detector, since post-#348
  238: #       the genuine sequence is architecturally transparent.
  239: for v in "A cclean2 fold r0" "A cclean2 fold r1" "A cclean2 flags" \
  240:          "A cclean2 base r5" "A cclean2 base r1" "A cclean2 base r0" \
  241:          "A cclean2 cnt r6" "A cclean2 cnt r1" "A cclean2 tail flags" \
  242:          "A cclean2 tail r0" "A cclean2 tail r1" "A cclean2 tail V" \
  243:          "A cclean2 zero flags" "A cclean2 zero r0" "A cclean2 zero r1" \
  244:          "A cclean2 quiet" "A cclean2 fires" "A cclean2 fires ctrl"; do
  245:     n=$(count "$LOG" "^$v  .*ok$")
  246:     check "  row: $v" "$n" 1
  247: done
  248: 
  249: for v in "sbcs eq C=0 C" "sbcs eq0 C=0 C" "sbcs eqmax C=0 C" "rscs eq C=0 C"; do
  250:     n=$(count "$LOG" "^$v  .*ok$")
  251:     check "  disc: $v" "$n" 1
  252: done
  253: 
  254: # The value rows on those same four: the arithmetic was ALWAYS right, and a
  255: # "fix" that repaired the flag by breaking the result must not pass.
  256: for v in "sbcs eq C=0 rd" "sbcs eq0 C=0 rd" "sbcs eqmax C=0 rd" "rscs eq C=0 rd"; do
  257:     n=$(count "$LOG" "^$v  .*ok$")
  258:     check "  value intact: $v" "$n" 1
  259: done
  260: 
  261: # The instructions the fix must NOT disturb.
  262: for v in "subs eq C" "subs lt C" "subs gt C" "subs zerominus C" \
  263:          "rsbs gt C" "rsbs lt C" \
  264:          "cmp eq NZCV" "cmp lt NZCV" "cmp gt NZCV" \
  265:          "subs rn=pc rd" "subs rn=pc C" \
  266:          "adds carry-out C" "adds no-carry C" \
  267:          "adcs carry-out C" "adcs no-carry C" \
  268:          "sbcs eq C=1 C" "sbcs gt C=0 C" "sbcs lt C=0 C" "sbcs lt C=1 C" \
  269:          "rscs gt C=0 C" "rscs lt C=0 C"; do
  270:     n=$(count "$LOG" "^$v  .*ok$")
  271:     check "  pin: $v" "$n" 1
  272: done
  273: 
  274: # #313: ADC was the ONE opcode listed in the outer V-update #if that matched
  275: # neither inner formula, so ADCS could only ever clear V. The paired adds rows
  276: # are what make these a statement about ADC rather than about V generally --
  277: # the identical overflow through ADDS was already correct.
  278: for v in "adcs V pos-ovf" "adcs V pos-ovf2" "adcs V neg-ovf"; do
  279:     n=$(count "$LOG" "^$v  .*ok$")
  280:     check "  disc: $v" "$n" 1
  281: done
  282: for v in "adcs V none" "adds V pos-ovf" "adds V none" "sbcs V ovf"; do
  283:     n=$(count "$LOG" "^$v  .*ok$")
  284:     check "  pin: $v" "$n" 1
  285: done
  286: 
  287: # #312's rows. The handler-ran row is the witness that the exception was
  288: # actually TAKEN; mode and lr prove it was entered as an exception rather than
  289: # branched into.
  290: #
  291: # The page-end row is not redundant with the first: X(und) reconstructs the
  292: # faulting PC with a hard-coded 4KB mask, and at page offset 0 both halves of
  293: # that arithmetic are zero, so only a row at the last slot of a page can catch
  294: # a wrong mask.
  295: for v in "udf handler ran" "udf UND32 mode" "udf lr=pc+4" \
  296:          "udf gdb-form handler ran" "udf gdb-form UND32 mode" \
  297:          "udf gdb-form lr=pc+4" \
  298:          "udf page-end handler ran" "udf page-end UND32 mode" \
  299:          "udf page-end lr=pc+4" "udf cond-failed nop"; do
  300:     n=$(count "$LOG" "^$v  .*ok$")
  301:     check "  undefined: $v" "$n" 1
  302: done
  303: 
  304: # ---- #319/#320/#321: rotations the decoder rejected, and MVNS's carry -------
  305: # Every row asserts a VALUE. `uxtah ROR 24` is the discriminating one of the
  306: # first group: a byte extract is the same under a rotate as under a shift at
  307: # every encodable amount, so the uxtab rows cannot tell those apart, while the
  308: # halfword form at 24 wraps rm's low byte into bits 15:8.
  309: #
  310: # `rotc zero C` is the row that never halted -- the old guard exempted an imm8
  311: # of zero, so that case shipped with the wrong carry rather than stopping, which
  312: # is why this group is a wrong-answer fix and not only a halt fix.
  313: #
  314: # All four MVNS bands are present because two of them would pass by coincidence:
  315: # the decoder rewrites `mvn #imm` to `mov #~imm`, and with S set the carry was
  316: # then read off the COMPLEMENT.
  317: for v in "uxtab ROR 8" "uxtab ROR 16" "uxtab ROR 24" \
  318:          "uxtah ROR 8" "uxtah ROR 16" "uxtah ROR 24" \
  319:          "rotc movs val" "rotc movs C" "rotc zero C" "rotc ands C" \
  320:          "rotc orrs val" "rotc bics val" "rotc tst C" \
  321:          "mvns rot0 C=0" "mvns rot0 C=1" "mvns b31=0 C" "mvns b31=1 C" \
  322:          "mvns value"; do
  323:     n=$(count "$LOG" "^$v  .*ok$")
  324:     check "  round 78: $v" "$n" 1
  325: done
  326: for v in "rotc pc src C"; do
  327:     n=$(count "$LOG" "^$v  .*ok$")
  328:     check "  round 78: $v" "$n" 1
  329: done
  330: for v in "uxtab ROR 0" "rot0 movs C" "mvn S-clear" "rot0 pc src C" \
  331:          "rotc pc gt255" "rotc bound 256"; do
  332:     n=$(count "$LOG" "^$v  .*ok$")
  333:     check "  round 78 pin: $v" "$n" 1
  334: done
  335: 
  336: # #328: the THUMB rows. Everything above is ARM-mode; the Thumb interpreter is a
  337: # separate implementation that #311 never touched, and it had THREE flag defects in
  338: # four near-identical blocks -- Z read off a 64-bit value, C derived from the carry
  339: # out of a negation (so subtracting zero reported a borrow), and V read from the sign
  340: # of the negated subtrahend (which breaks at 0x80000000, the one value that is its
  341: # own negation). Each row asserts the flags AND rd, because the value was already
  342: # right and a flags-only row could not tell a fixed flag from a broken result.
  343: for v in "T ctrl ADDS 2+3" "T ctrl SUBS 5-3" "T ctrl SUBS borrow"          "T Z subs equal" "T Z cmp imm equal" "T Z subs imm equal"          "T Z cmp reg equal" "T Z adds wrap"          "T C subs zero" "T C cmp imm 0" "T C subs imm 0" "T C cmp reg zero"          "T V 0-INT_MIN" "T V -1-INT_MIN" "T V INT_MIN-same"          "T alias subs rd==rm" \
  344:          "T Z adds imm8 wrap" "T Z adds imm3 wrap" "T C subs imm3 zero" \
  345:          "T V subs INT_MIN" "T V adds overflow" "T C subs 0-0" \
  346:          "T V adds INT_MIN x2"; do
  347:     n=$(count "$LOG" "^$v  .*ok$")
  348:     check "  thumb: $v" "$n" 1
  349:     n=$(count "$LOG" "^$v rd  .*ok$")
  350:     check "  thumb: $v rd" "$n" 1
  351: done
  352: 
  353: 
  354: # #329: the Thumb SHIFT rows. ASR-immediate took Z and N from a register chosen by the
  355: # shift amount; RORS never cleared Z/N; and LSR #0 / ASR #0 encode shift-by-32 rather
  356: # than shift-by-zero. The two LSL #0 rows are the control -- that encoding IS a genuine
  357: # no-op and its C must survive untouched, which is why they run at both carry-in values.
  358: # The positive-operand shift-32 rows only became measurable once the rig could preset
  359: # carry: against a build that never writes C they would pass on a cold machine anyway.
  360: for v in "T LSL #0 keeps C1" "T LSL #0 keeps C0" "T ASR #12 flags reg"          "T RORS clears Z" "T RORS clears N"          "T LSR #0 neg" "T LSR #0 pos" "T ASR #0 neg" "T ASR #0 pos"          "T LSR rd!=0"; do
  361:     n=$(count "$LOG" "^$v  .*ok$")
  362:     check "  shift: $v" "$n" 1
  363:     n=$(count "$LOG" "^$v rd  .*ok$")
  364:     check "  shift: $v rd" "$n" 1
  365: done
  366: 
  367: # ---- #351/#352/#353: netbsd_idle, via the READ-AHEAD install path -----------
  368: # A SEPARATE probe (arm_idle_probe.py), because every row here runs with NO
  369: # breakpoint so translation read-ahead is ON -- the install path a real guest
  370: # takes, and the one arm_flags_probe.py's breakpoint driver structurally cannot
  371: # reach (cpu_dyntrans.c:1939 gates read-ahead on breakpoints.n == 0). The
  372: # register-alias defect (c) and the forward-beq hang (d) are invisible under a
  373: # breakpoint, so they could only be witnessed here.
  374: #
  375: # Swept against a binary built from the pre-fix HEAD (704036e): 2 of 9, failing
  376: # exactly the seven DISC rows -- exit dest 0x77, exit flags 0x6, idle dest 0x77,
  377: # idle flags 0x8, `alias exits` 0x55 (fold took the wrong exit), `target
  378: # reached` deadbeef (the forward-beq HUNG the guest), and `fires` (no marker) --
  379: # and passing the two PINs. On the fixed build: 9/9.
  380: IDLELOG=$LOGDIR/gate_arm_idle.log
  381: python3 arm_idle_probe.py "$PMAX" "$STUB" > "$IDLELOG" 2>&1 || true
  382: 
  383: if ! grep -q "IDLE_RESULT=" "$IDLELOG"; then
  384:     note "idle probe produced no result line; last lines follow"
  385:     tail -5 "$IDLELOG" | sed 's/^/       /'
  386:     gate_skip "idle probe did not complete"
  387: fi
  388: 
  389: grep -E " ok$| FAIL$" "$IDLELOG" | sed 's/^/       /'
  390: 
  391: ictrl=$(grep -o "IDLE_CONTROL=[A-Z]*" "$IDLELOG" | tail -1 | cut -d= -f2)
  392: check "idle control proves the probe measures" "${ictrl:-missing}" "OK"
  393: 
  394: ires=$(grep -o "IDLE_RESULT=[0-9]*/[0-9]*" "$IDLELOG" | tail -1 | cut -d= -f2)
  395: igot=${ires%/*}; iwant=${ires#*/}
  396: check "idle rows run"     "$iwant" 9
  397: check "idle rows correct" "$igot"  "$iwant"
  398: 
  399: # Named rows, one contract each. The two PINs pass on both builds by design:
  400: # `quiet` asserts marker absence at default verbosity (boot-log hygiene), and
  401: # `alias -J ref` pins that the alias program's architectural answer really is
  402: # idle (so the DISC above attributes its 0x55 to the fold, not the program).
  403: for v in "A idle exit dest" "A idle exit flags" "A idle path dest" \
  404:          "A idle path flags" "A idle alias exits" "A idle target reached" \
  405:          "A idle fires" "A idle quiet" "A idle alias -J ref"; do
  406:     n=$(count "$IDLELOG" "^$v  .*ok$")
  407:     check "  idle row: $v" "$n" 1
  408: done
  409: 
  410: # ---- #354: netbsd_memcpy, via the READ-AHEAD install path -------------------
  411: # The memcpy fold did memcpy(dst,src,32) + advanced r0/r1 but never wrote
  412: # r3/r4/ip/lr, which the architecture leaves = the last 16 bytes loaded (the
  413: # final iteration's second ldmia). Same SEPARATE-probe / read-ahead-ON reason
  414: # as the idle rows. Owed words are full-width and distinct per register so a
  415: # byteswap or wrong index is self-evident.
  416: #
  417: # Swept against a binary built from the committed HEAD (pre-#354): 4 of 12,
  418: # failing exactly the eight DISC rows (r3/r4/ip/lr = seeds 0x33/0x44/0xcc/0xee
  419: # on both the 1-iteration and 2-iteration loops) and passing the four r0/r1
  420: # PINs (the advance was always correct). On the fixed build: 12/12.
  421: MEMLOG=$LOGDIR/gate_arm_memcpy.log
  422: python3 arm_memcpy_probe.py "$PMAX" "$STUB" > "$MEMLOG" 2>&1 || true
  423: 
  424: if ! grep -q "MEMCPY_RESULT=" "$MEMLOG"; then
  425:     note "memcpy probe produced no result line; last lines follow"
  426:     tail -5 "$MEMLOG" | sed 's/^/       /'
  427:     gate_skip "memcpy probe did not complete"
  428: fi
  429: 
  430: grep -E " ok$| FAIL$" "$MEMLOG" | sed 's/^/       /'
  431: 
  432: # The control proves the harness runs end-to-end (program assembled, guest
  433: # executed, dump parsed, byteswap convention right) against the GENUINE
  434: # instruction path under -J. It does NOT prove the measured sessions went
  435: # through the FOLD: post-#354 the fold and the genuine path agree by
  436: # construction, so nothing here would notice if a future change broke the
  437: # combiner registration -- the rows would keep passing via the real
  438: # instructions and the coverage would silently vanish. Only a #349/#352-style
  439: # fold-fired marker closes that; it is recorded in OUTSTANDING_BUGS, and the
  440: # historical pre-#354 sweep (4/12, the eight DISC rows red) is what establishes
  441: # that these rows discriminate at all.
  442: mctrl=$(grep -o "MEMCPY_CONTROL=[A-Z]*" "$MEMLOG" | tail -1 | cut -d= -f2)
  443: check "memcpy control: harness measures (not fold-fired)" "${mctrl:-missing}" "OK"
  444: 
  445: mres=$(grep -o "MEMCPY_RESULT=[0-9]*/[0-9]*" "$MEMLOG" | tail -1 | cut -d= -f2)
  446: mgot=${mres%/*}; mwant=${mres#*/}
  447: check "memcpy rows run"     "$mwant" 17
  448: check "memcpy rows correct" "$mgot"  "$mwant"
  449: 
  450: # The four r0/r1 PINs pass on both builds -- they guard against a fix that
  451: # regresses the advance while writing the registers (Codex's clobber concern:
  452: # r0/r1/r2 are outside the {r3,r4,ip,lr} reglist, so the exact-iword matcher
  453: # already forbids aliasing; these pins make that guarantee visible).
  454: #  #359: the five `dst` rows are the only assertions in this whole gate that
  455: #  read the BYTES the fold moved. Everything else here reads registers, and
  456: #  registers cannot see the copy size: r3/r4/ip/lr are published by a direct
  457: #  page read that bypasses the fold's memcpy call, and r0/r1 advance
  458: #  unconditionally. Measured, and this is why the rows exist: a build whose fold
  459: #  called memcpy with 16 instead of 32 -- half the bytes moved, same iteration
  460: #  count, same register advance -- passed this probe 12/12 and the whole of gate
  461: #  14 at 243 checks. With the dst rows it reads 15/17, red at exactly
  462: #  `1it dst w6` and `2it dst w14`, both showing the pre-fill sentinel where a
  463: #  source word was owed. They are PIN, not DISC: the genuine ldmia/stmia moves
  464: #  the same bytes, so the destination is identical folded or not -- what they
  465: #  discriminate is a broken copy. Note `2it dst w9` deliberately PASSES on that
  466: #  mutant (it lies in the first 16 bytes of the second iteration, which is still
  467: #  copied); the discriminator for a later iteration is w14, and keeping both
  468: #  makes the row set say which half of the copy failed.
  469: for v in "A memcpy 1it r3" "A memcpy 1it r4" "A memcpy 1it ip" \
  470:          "A memcpy 1it lr" "A memcpy 1it r0" "A memcpy 1it r1" \
  471:          "A memcpy 1it dst w1" "A memcpy 1it dst w6" \
  472:          "A memcpy 1it dst tail" \
  473:          "A memcpy 2it r3" "A memcpy 2it r4" "A memcpy 2it ip" \
  474:          "A memcpy 2it lr" "A memcpy 2it r0" "A memcpy 2it r1" \
  475:          "A memcpy 2it dst w9" "A memcpy 2it dst w14"; do
  476:     n=$(count "$MEMLOG" "^$v  .*ok$")
  477:     check "  memcpy row: $v" "$n" 1
  478: done
  479: 
  480: # ---- #355/#356: the strlen fold ---------------------------------------------
  481: # #355: COMBINE(strlen) never required the load's base and destination to
  482: # differ, so `ldrb r3,[r3,#1]!` folded. The genuine writeback overwrites the
  483: # loaded byte, so the cmps compares an ADDRESS and the loop runs on; the fold's
  484: # condition tests the byte and EXITS. The encoding is UNPREDICTABLE, so neither
  485: # answer is "wrong" -- but the emulator was giving two answers for one program
  486: # depending on whether the combination happened, and -J is this gate's own
  487: # architectural oracle.
  488: #
  489: # #356: the walk had no budget bound and ran the whole string inside ONE
  490: # dispatch -- host unresponsive for the duration, and n_translated_instrs (an
  491: # int, reset per run_instr, with a REPLAYABLE walk) drivable into signed
  492: # overflow with ~18-24 MB of non-NUL memory at the DEFAULT -M 64.
  493: #
  494: # The yield is witnessed WITHOUT a clock: the test machine's mp device exposes
  495: # cpu->ninstrs at 0x110000d0, and ninstrs is committed only when run_instr
  496: # returns, so a guest sampling it either side of a 16 KB walk reads ~0 if the
  497: # walk never left one dispatch. All numeric rows assert BANDS, because the exact
  498: # counts depend on N_SAFE_DYNTRANS_LIMIT (8191) and the 120-dispatch group
  499: # boundary -- named so a change to either moves the bands deliberately.
  500: #
  501: # Swept against a binary built from the pre-fix HEAD: 3 of 7, failing exactly
  502: # the four discriminators -- `yields` and `bill band` both read 0 (the walk
  503: # never left the dispatch), `alias exits` read 0x55 (the fold took the wrong
  504: # exit) and `alias moved` read "no" (it had exited after three bytes). The
  505: # three PINs pass on both builds. On the fixed build: 7/7.
  506: STRLOG=$LOGDIR/gate_arm_strlen.log
  507: python3 arm_strlen_probe.py "$PMAX" > "$STRLOG" 2>&1 || true
  508: 
  509: if ! grep -q "STRLEN_RESULT=" "$STRLOG"; then
  510:     note "strlen probe produced no result line; last lines follow"
  511:     tail -5 "$STRLOG" | sed 's/^/       /'
  512:     gate_skip "strlen probe did not complete"
  513: fi
  514: 
  515: grep -E " ok$| FAIL$" "$STRLOG" | sed 's/^/       /'
  516: 
  517: sctrl=$(grep -o "STRLEN_CONTROL=[A-Z]*" "$STRLOG" | tail -1 | cut -d= -f2)
  518: check "strlen control: -J reference walked and yielded" "${sctrl:-missing}" "OK"
  519: 
  520: sres=$(grep -o "STRLEN_RESULT=[0-9]*/[0-9]*" "$STRLOG" | tail -1 | cut -d= -f2)
  521: sgot=${sres%/*}; swant=${sres#*/}
  522: check "strlen rows run"     "$swant" 7
  523: check "strlen rows correct" "$sgot"  "$swant"
  524: 
  525: for v in "A strlen -J ref" "A strlen -J end addr" "A strlen yields" \
  526:          "A strlen bill band" "A strlen end addr" "A strlen alias exits" \
  527:          "A strlen alias moved"; do
  528:     n=$(count "$STRLOG" "^$v  .*ok$")
  529:     check "  strlen row: $v" "$n" 1
  530: done
  531: 
  532: # #357: the base writeback (cpu_arm_instr_loadstore.c)
  533: # -------------------------------------------------------------------------
  534: # The template computed one address, masked it for alignment, and wrote the
  535: # base register back FROM THE MASKED VALUE. ARM ARM DDI 0100I computes the
  536: # writeback from the unmasked Rn (A5.2.8 post-indexed, A5.2.5 pre-indexed;
  537: # A2-43 puts the truncation inside Memory[]).
  538: #
  539: # The reachable symptom is a loop that cannot make progress, not a wrong
  540: # value: with a word access and a post-index offset of 1 the masked writeback
  541: # is a FIXED POINT -- base 0x10001 masks to 0x10000, plus 1 is 0x10001, the
  542: # value it started from. Rows A/A2 run ten iterations and assert the exact
  543: # architectural result; the count lives in r3, so nothing here depends on how
  544: # far execution got or on host speed.
  545: #
  546: # WHICH ROW REACHES WHICH SITE -- #364 CORRECTED THIS TABLE, WHICH WAS INVERTED.
  547: # It used to say the fast path "only runs once the page is in the translation
  548: # array, so a single-execution row measures the GENERAL path and nothing else",
  549: # and it referred forward to a "CORRECTION below" that was never written. Both
  550: # are fixed here. MEASURED: no row in this probe reached the general path at
  551: # all -- a marker at the top of A__NAME__general counted ZERO hits on all 17
  552: # rows, including the x10 iterations and both re-seeded passes.
  553: #
  554: # The cause was the probe's own seeding. `put w` -> store_32bit_word ->
  555: # memory_rw(CACHE_DATA), and insertion is gated on !no_exceptions, so a page
  556: # seeded with `put w` is ALREADY warm before the guest runs. `put b` uses
  557: # CACHE_NONE | NO_EXCEPTIONS and does not insert. The old note had the two
  558: # backwards, and it was recorded as a verified mechanism, so two shipped rounds
  559: # leaned on it: #357's general-path writeback and #362's general-path rotation
  560: # were both unmeasured, and each was independently confirmed DELETABLE with this
  561: # whole gate still green at 358 checks.  (This said 261 until 2026-08-26 -- the count
  562: # grew when the gate took on `barearm` and `cats`, and commit 6014b7e's message records
  563: # "PASS 358 checks (was 261)".  The carrier carried the same stale number; both were
  564: # corrected together, because a number with two homes rots in both.)
  565: #
  566: # TWO AXES, kept apart. The first draft of this correction conflated them and
  567: # claimed the new cold rows cover "general post-index writeback". They do NOT:
  568: # their LDR is P=1/W=0, and the writeback is emitted only under (P and W) or
  569: # (not P), so an offset form has no writeback statement at all. Caught in review.
  570: #
  571: #   -- the four WRITEBACK sites (the `reg(ic->arg[0]) =` statements) --
  572: #   fast    post-index  every iteration of the x10 rows, plus the one-shot
  573: #                       post-index rows and the PIN rows (11 in total)
  574: #   fast    pre-index   "pre4 unal gen" AND "pre4 unal fast" (both passes)
  575: #   general post-index  UNCOVERED
  576: #   general pre-index   UNCOVERED
  577: #
  578: #   -- rows with NO writeback site (P=1/W=0 offset forms) --
  579: #   "pre4 no wb" and the three "rot word unal" rows   (fast function)
  580: #   the three "rot word cold" rows                    (general function)
  581: #
  582: #   -- which rows enter A__NAME__general AT ALL, the question this round answers --
  583: #   the three "rot word cold" rows, and nothing else: they exercise the
  584: #   load-and-rotate arm and the memory_rw slow path, which is a DATA site.
  585: #
  586: # So #357's general-path WRITEBACK fix still has no row reaching it. That is
  587: # recorded in OUTSTANDING_BUGS rather than papered over here.
  588: #
  589: # No line numbers here on purpose: the ones this table used to carry (:213/:216,
  590: # :338/:342) had gone stale by the round that corrected it -- the third time in
  591: # this file, whose own #357 note already says a numeric cite here has gone stale
  592: # twice before.
  593: #
  594: # "pre4 unal fast" still needs its two passes with the base re-seeded each pass:
  595: # without the re-seed, pass 1 leaves an ALIGNED base and the row has nothing
  596: # left to discriminate. Only its SITE attribution was wrong, not its design.
  597: # Loads and stores are separate instantiations of the template, so a load-only
  598: # set cannot see a store-side regression: hence the store row. Register-offset
  599: # forms are a third family: hence the regofs row.
  600: #
  601: # The control is the loaded-data row rather than a pass count: r1 starts at 0,
  602: # so a distinctive nonzero value proves the guest really executed and really
  603: # loaded. A wrong register field reads 0, and a row that accepts 0 accepts that
  604: # mistake by accident -- this harness has shipped exactly that defect before.
  605: #
  606: # DISC-M ("model") on the halfword row is deliberate: an unaligned halfword
  607: # load's DATA is UNPREDICTABLE (A4.1.28) while its writeback stays defined
  608: # (A5.3.6), so the row asserts the BASE only and pins the pseudocode model, not
  609: # a silicon mandate. Every other DISC row is a word form, i.e. mandated space.
  610: # There is no *unaligned* LDRD/STRD row on purpose: A2.8 makes an unaligned
  611: # doubleword access UNPREDICTABLE prior to ARMv6, so every base that would
  612: # exercise the ~7 mask makes the instruction unspecified -- covered by the
  613: # fix, not honestly assertable. [#389: ALIGNED LDRD/STRD byte-order rows now
  614: # live in the endian section below -- this note is scoped to the writeback/
  615: # unaligned axis only.]
  616: #
  617: # #364: the sentence that used to stand here -- "no row pins the unaligned
  618: # loaded DATA ... such a row would be inverted by the round that fixes
  619: # rotation" -- was falsified by #362, which added exactly three such rows, and
  620: # by #364, which added three more from a cold page. It is removed rather than
  621: # annotated. The ALIGNED data row remains, and remains correct for its own
  622: # reason: no rotation applies at offset 0 in any architecture version.
  623: #
  624: # Swept against a snapshot of the pre-fix binary: 5 of 14, with all nine DISC
  625: # rows failing at exactly the predicted masked values and all five PINs
  626: # passing. On the fixed build: 14/14. Read that 5/14 with the corrected table
  627: # above -- it is entirely a FAST-path result, since no row of that era entered
  628: # the general path. #362 took the set to 17, #364 to 20.
  629: WBLOG=$LOGDIR/gate_arm_writeback.log
  630: python3 arm_writeback_probe.py "$PMAX" > "$WBLOG" 2>&1 || true
  631: 
  632: if ! grep -q "WRITEBACK_RESULT=" "$WBLOG"; then
  633:     note "writeback probe produced no result line; last lines follow"
  634:     tail -5 "$WBLOG" | sed 's/^/       /'
  635:     gate_skip "writeback probe did not complete"
  636: fi
  637: 
  638: grep -E " ok$| FAIL$" "$WBLOG" | sed 's/^/       /'
  639: 
  640: wctrl=$(grep -o "WRITEBACK_CONTROL=[A-Z]*" "$WBLOG" | tail -1 | cut -d= -f2)
  641: check "writeback control: guest ran and loaded" "${wctrl:-missing}" "OK"
  642: 
  643: wres=$(grep -o "WRITEBACK_RESULT=[0-9]*/[0-9]*" "$WBLOG" | tail -1 | cut -d= -f2)
  644: wgot=${wres%/*}; wwant=${wres#*/}
  645: check "writeback rows run"     "$wwant" 22
  646: check "writeback rows correct" "$wgot"  "$wwant"
  647: 
  648: # #367: PATH ATTRIBUTION IS NOW A CHECKED QUANTITY, not a comment.
  649: #
  650: # Which of the two load/store paths a row takes was asserted in prose and was
  651: # wrong three rounds running: #364 found the `put w` / `put b` warming note
  652: # INVERTED and recorded as verified, with two shipped rounds leaning on it;
  653: # #364's own draft then mis-attributed a writeback site to an offset form that
  654: # compiles no writeback statement at all; and #365 found the general writeback
  655: # sites reached but UNDISCRIMINATED, since `ldrb` has datalen 1 so the alignment
  656: # mask is the identity for it. Each was rediscovered with a throwaway marker and
  657: # a scratch build, three times, because the instrument did not survive the round.
  658: #
  659: # The emulator now counts entries into A__NAME__general (cpu_arm.h ls_general),
  660: # and `tlbdump` -- previously an EMPTY stub on ARM while it printed on other
  661: # architectures -- reads it out. PULL-ONLY: nothing prints unless a session asks,
  662: # so the rows elsewhere in this gate that assert an ABSENCE of output are
  663: # untouched, and a free-running guest cannot be flooded.
  664: #
  665: # The aggregate carries the seventeen ZEROS -- exactly the claim #364 found
  666: # inverted -- so a warming assumption that silently changes turns this red even
  667: # though no named row below covers those rows individually.
  668: lsres=$(grep -o "LSGEN_RESULT=[0-9]*/[0-9]*" "$WBLOG" | tail -1 | cut -d= -f2)
  669: lsgot=${lsres%/*}; lswant=${lsres#*/}
  670: check "writeback path rows run"     "${lswant:-missing}" 22
  671: check "writeback path rows correct" "${lsgot:-missing}"  "$lswant"
  672: 
  673: # The five rows that must ENTER the general path, named individually so one
  674: # reverting cannot hide behind the total. The derivation, which matters more than
  675: # the numbers: the general path's own memory_rw SELF-WARMS, so a cold row is 1
  676: # and not N. The `ldrt` row is 1 despite its page being WARM, because the
  677: # is_userpage test precedes the page test and a kernel `put w` insert never sets
  678: # that bit -- which is what makes a T form general-path BY CONSTRUCTION and
  679: # immune to any future seeding change.
  680: for v in "A wb rot word cold plus1" "A wb rot word cold plus2" \
  681:          "A wb rot word cold plus3" "A wb word ldrt post4 unal" \
  682:          "A wb word cold pre4 unal"; do
  683:     n=$(count "$WBLOG" "^$v path  .*ok\$")
  684:     check "  writeback path: $v" "$n" 1
  685: done
  686: 
  687: # #358: fold-fired markers (netbsd_copyin / netbsd_copyout)
  688: # -------------------------------------------------------------------------
  689: # Both folds replace six user-mode transfers with one C function whose
  690: # registers, addresses and instruction billing are IDENTICAL to the
  691: # instructions replaced, so a row asserting their result passes whether or not
  692: # the fold fires. Until #357 one witness existed -- the template masked its base
  693: # writeback while these folds did not, so an unaligned base read 0x10019 folded
  694: # against 0x10018 genuine -- and #357 correctly removed it by fixing the
  695: # template. These two folds also had NO rows at all before this.
  696: #
  697: # The rows are FREE-RUNNING by necessity, not by style. Measured: a two-pass
  698: # program with a breakpoint one instruction before the folded window executes the
  699: # GENUINE sequence on both the default and the -J build, while the same program
  700: # with no breakpoint folds -- so a breakpoint suppresses the fold. A breakpoint ON
  701: # a slot is worse: that path re-marks its own slot for retranslation and the
  702: # matchers test ic[i].f, so a fold can never install there. Two passes are
  703: # required because the folds gate on is_userpage, which only the user-access
  704: # general handler sets -- the very handler the fold's bail-out delegates to.
  705: #
  706: # Each fold gets a pair so neither row can be vacuous in either direction. The
  707: # `fires` row demands the marker AND the verbosity echo AND the six transferred
  708: # values: without the echo a session whose verbosity raise silently failed would
  709: # report zero markers and look exactly like a dead fold, and without the values
  710: # the row would prove a line was printed rather than that work was done. The
  711: # `quiet` row asserts silence at default verbosity and must never be rewritten to
  712: # drive the guest with `step` -- single-step BYPASSES debugmsg's verbosity gate.
  713: #
  714: # Non-vacuity proven per fold on scratch trees built from this exact source.
  715: # Disabling ONLY netbsd_copyin's arming (by making its iword test unsatisfiable,
  716: # which keeps the statement structure intact) gives 3 of 4, with exactly
  717: # `A fold copyin fires` red and copyout's rows still green. An earlier attempt
  718: # replaced the arming assignment with a comment and left a dangling `if` that
  719: # swallowed the copyout arming, killing both folds -- one real reason and one
  720: # artifact, which is why the break is done by constant and not by deletion.
  721: FOLDLOG=$LOGDIR/gate_arm_foldmark.log
  722: python3 arm_fold_marker_probe.py "$PMAX" > "$FOLDLOG" 2>&1 || true
  723: 
  724: if ! grep -q "FOLDMARK_RESULT=" "$FOLDLOG"; then
  725:     note "fold-marker probe produced no result line; last lines follow"
  726:     tail -5 "$FOLDLOG" | sed 's/^/       /'
  727:     gate_skip "fold-marker probe did not complete"
  728: fi
  729: 
  730: grep -E " ok$| FAIL$" "$FOLDLOG" | sed 's/^/       /'
  731: 
  732: fres=$(grep -o "FOLDMARK_RESULT=[0-9]*/[0-9]*" "$FOLDLOG" | tail -1 | cut -d= -f2)
  733: fgot=${fres%/*}; fwant=${fres#*/}
  734: #  #360: the `warm`/`cold` pairs are the LIVE controls, and the difference from
  735: #  the `quiet` rows is visible in one measurement. On a build with ONLY
  736: #  netbsd_copyin's arming disabled, `A fold copyin quiet` still reads **ok** --
  737: #  it asserts an absence, and an absence is exactly what a dead fold produces --
  738: #  while `A fold copyin cold` goes red because it asserts a DECLINE occurred
  739: #  (install 1, fire 0, decline 1). Measured 5 of 8 on that build, red at exactly
  740: #  the three copyin rows, with copyout's four green.
  741: #
  742: #  The install count is what makes the diagnosis one-read: install 0 means the
  743: #  matcher declined; install 1 with fire 0 and decline 1 means the fold was
  744: #  reached and turned the operands down, and the decline text names the clause.
  745: #  Every arm also asserts the verbosity echo and that r0/r1 advanced by the full
  746: #  six transfers -- the latter holds folded or not, so it proves the program ran
  747: #  without presuming the fold, which is what stops the cold arm's zero from
  748: #  being meaningless. Measured: with verbosity off the guest ran perfectly and
  749: #  reported zero fires AND zero installs, so counting absences alone cannot tell
  750: #  a dead fold from a broken session.
  751: #  #361 adds rows for the last two folds that had #358 markers but nothing
  752: #  exercising them -- the scope debt #358 was criticised for. Two shapes, and
  753: #  they are NOT interchangeable:
  754: #    xchg  declines at the MATCHER (install 0), because #342's `a != b` term
  755: #          rejects the shape before anything is installed.
  756: #    scanc declines at a GUARD (install 1, decline 1), like copyin/copyout, and
  757: #          has TWO decline sites -- the second reachable only after the first
  758: #          passes, since the table address is computed from the byte just loaded.
  759: #          Both are exercised, with distinct reason spellings so a row can say
  760: #          which page missed.
  761: #
  762: #  `A fold xchg selective` is one row spanning BOTH xchg arms, and it exists
  763: #  because a measuring seat showed the negative arm is VACUOUS ALONE: install 0 /
  764: #  fire 0 reads identically on a healthy build and on one with xchg's arming
  765: #  removed, so by itself it cannot tell "the matcher rejected the shape" from
  766: #  "the matcher does not exist" -- the #360 defect again. Measured on an
  767: #  arming-dead build: `A fold xchg samereg` reads **ok** while
  768: #  `A fold xchg selective` goes red. The rejected alternative is recorded in the
  769: #  probe: relocating #342's term into the matched shape so the arm self-diagnoses
  770: #  works, but it edits a shipped correction's guard for instrumentation's sake.
  771: #
  772: #  scanc's r3 is a genuine three-way value witness -- 0x77 is table[4] when the
  773: #  fold runs, 0x66 is table[0] because an unmapped string load yields zero, and
  774: #  0x00 when the table page is the missing one -- plus an r5 sentinel proving the
  775: #  program reached its end. Measured: on a scanc-arming-dead build all three arms
  776: #  keep byte-identical register values and only the marker triple moves, so a
  777: #  value-only row would be vacuous for this fold.
  778: check "fold-marker rows run"     "$fwant" 21
  779: check "fold-marker rows correct" "$fgot"  "$fwant"
  780: 
  781: # #383: the four BE rows put the copyin/copyout folds' byte-order handling on
  782: # the test surface -- on barearm both folds install and fire (their matchers
  783: # gate on HOST endianness, not guest), so the value rows discriminate the fix.
  784: # The +1/+3 UNALIGNED copyin rows are the composition-order discriminators (a
  785: # fix swapping AFTER #362's rotation passes +0 but fails these). FOLDMARK_
  786: # CONTROL_BE is the fix-state-independent liveness pin (r1 ^ sl == the
  787: # architectural word on every build), so a dead barearm session cannot
  788: # false-green the BE group.
  789: fctrlbe=$(grep -o "FOLDMARK_CONTROL_BE=[A-Z]*" "$FOLDLOG" | tail -1 | cut -d= -f2)
  790: # #384: the control pins that the barearm rig ran, both passes executed, and
  791: # the rig is genuinely big-endian (an LE rig fails it). It does NOT prove the
  792: # fold fired -- that is the value rows' fire==1 -- so the name does not claim it.
  793: check "fold-marker BE control: barearm ran, rig is BE" "${fctrlbe:-missing}" "OK"
  794: 
  795: for v in "A fold copyin fires" "A fold copyin quiet" \
  796:          "A fold copyout fires" "A fold copyout quiet" \
  797:          "A fold copyin warm" "A fold copyin cold" \
  798:          "A fold copyout warm" "A fold copyout cold" \
  799:          "A fold xchg fires" "A fold xchg samereg" \
  800:          "A fold xchg selective" "A fold scanc fires" \
  801:          "A fold scanc nostr" "A fold scanc notbl" \
  802:          "A fold copyin rot plus1" "A fold copyin rot plus2" \
  803:          "A fold copyin rot plus3" \
  804:          "A fold copyin BE +0" "A fold copyin BE +1" \
  805:          "A fold copyin BE +3" "A fold copyout BE"; do
  806:     n=$(count "$FOLDLOG" "^$v  .*ok$")
  807:     check "  fold-marker row: $v" "$n" 1
  808: done
  809: 
  810: for v in "A wb word post1 unal x10" "A wb word post1 algn x10" \
  811:          "A wb word post4 unal" "A wb word pre4 unal gen" \
  812:          "A wb word pre4 unal fast" "A wb word postneg4 unal" \
  813:          "A wb store post1 unal x10" "A wb regofs post1 unal x10" \
  814:          "A wb halfword post1 unal" "A wb word post4 algn" \
  815:          "A wb algn load data" "A wb byte post1 unal" \
  816:          "A wb word pre4 no wb" "A wb wrap from zero" \
  817:          "A wb rot word unal plus1" "A wb rot word unal plus2" \
  818:          "A wb rot word unal plus3" \
  819:          "A wb rot word cold plus1" "A wb rot word cold plus2" \
  820:          "A wb rot word cold plus3" \
  821:          "A wb word ldrt post4 unal" "A wb word cold pre4 unal"; do
  822:     n=$(count "$WBLOG" "^$v  .*ok$")
  823:     check "  writeback row: $v" "$n" 1
  824: done
  825: 
  826: # #372: the general-path word STORE ignored cpu->byte_order.
  827: # ----------------------------------------------------------------------------
  828: # Its arm was UNCONDITIONALLY EMPTY -- guard `!A__B && !A__H && HOST_LE` with an
  829: # `#ifdef A__STRD`-only body, and A__STRD implies A__H, which the guard excludes.
  830: # So a plain word STR on an LE host emitted no bytes and memory_rw copied the
  831: # register's HOST bytes; the FAST path was always order-aware, so one STR wrote
  832: # guest order to a warm page and host order to a cold one, and every strt (always
  833: # general on its first access per page) was reversed.
  834: #
  835: # This probe runs BOTH byte orders. The six `be *` rows use -E barearm (BE) and
  836: # are the DISCriminators; the six `le *` rows use -E testarm (LE) and are
  837: # INVARIANCE CONTROLS -- on LE the broken code was accidentally right (host order
  838: # == guest order), so they pin nothing about #372 and exist only to catch a fix
  839: # that repairs BE by breaking LE. The `ldrb` witnesses are the purest form: a
  840: # byte load has no byte order, so it exposes the raw memory layout directly, and
  841: # the buggy column is the exact reverse of the arch column.
  842: #
  843: # #372's original sweep (its SIX BE + six LE rows): pre-fix 7 of 12 -- the five
  844: # cold BE rows red at the host-order values, the warm control and LE controls
  845: # green. Fixed: 12/12. #378 grew the section to 34 rows (22 BE / 12 LE) with the
  846: # INVERTED polarity -- its sweep numbers are in the named-row comment below; the
  847: # 12-row narrative above this line is #372 history, scoped as such by #379.
  848: # #386 grew it to 58: swp (the last word-sized ARM memory handler, LE-only on
  849: # both sides + raw unmasked address) and its swpb/aligned-LE/by-construction
  850: # controls; sweep numbers in the named-row comment below.
  851: ENDLOG=$LOGDIR/gate_arm_endian.log
  852: python3 arm_endian_probe.py "$PMAX" > "$ENDLOG" 2>&1 || true
  853: 
  854: if ! grep -q "ENDIAN_RESULT=" "$ENDLOG"; then
  855:     note "endian probe produced no result line; last lines follow"
  856:     tail -5 "$ENDLOG" | sed 's/^/       /'
  857:     gate_skip "endian probe did not complete"
  858: fi
  859: 
  860: grep -E " ok$| FAIL$" "$ENDLOG" | sed 's/^/       /'
  861: 
  862: # The control is the BE cold-word row's SIBLING warm row: it demands a
  863: # distinctive nonzero word through the order-aware fast path, proving the BE rig
  864: # (barearm) constructed and the program ran, before any DISC row is believed.
  865: ectrl=$(grep -o "ENDIAN_CONTROL=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  866: check "endian control: BE rig ran and stored" "${ectrl:-missing}" "OK"
  867: 
  868: # #378's own liveness pin: the multi-transfer cold rows go through bdt_*, which
  869: # swaps on EVERY build, so they read arch values on buggy and fixed builds
  870: # alike -- a dead rig, wrong register field or non-firing LDM reads 0/sentinel
  871: # instead. Distinct from ENDIAN_CONTROL so the two extensions fail separately.
  872: ectrl378=$(grep -o "ENDIAN_CONTROL378=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  873: check "endian control: multi rows ran (378)" "${ectrl378:-missing}" "OK"
  874: 
  875: # #379: the warm DISC rows depend on `put w` having warmed the pages, and a
  876: # silently failing put would flip them all to a FALSE GREEN on a buggy build
  877: # (bdt_* is architecturally correct on both arms). The probe checks every
  878: # put's echo for the debugger's FAILED marker.
  879: eputs=$(grep -o "PUT_STATUS=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  880: check "endian puts all landed (379)" "${eputs:-missing}" "OK"
  881: 
  882: eres=$(grep -o "ENDIAN_RESULT=[0-9]*/[0-9]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  883: egot=${eres%/*}; ewant=${eres#*/}
  884: #  #389's liveness pin: the LE LDRD/STRD rows are fix-state-independent (LE
  885: #  was always correct) and read the sentinel 0 if the instructions are dead.
  886: ectrld=$(grep -o "ENDIAN_CONTROL_D=[A-Z]*" "$ENDLOG" | tail -1 | cut -d= -f2)
  887: #  #389 pass-2 (Opus seat): the name used to read "ldrd/strd ran", which
  888: #  overclaimed -- BOTH pins behind ENDIAN_CONTROL_D are on the LE rig
  889: #  (testarm), so nothing here pins that LDRD/STRD executed on barearm. That is
  890: #  not a fixable omission: a liveness pin must be fix-state-INDEPENDENT, and on
  891: #  BE every LDRD/STRD row changes value with the fix by construction. The BE
  892: #  side is still fail-closed -- a dead BE rig reddens its ten DISC rows -- but
  893: #  the NAME must say what it actually pins.
  894: check "endian control: ldrd/strd ran on the LE rig (389)" "${ectrld:-missing}" "OK"
  895: 
  896: check "endian rows run"     "${ewant:-missing}" 102
  897: check "endian rows correct" "${egot:-missing}"  "$ewant"
  898: 
  899: # The BE discriminators named individually, so one reverting cannot hide
  900: # behind the total. #372's DISC rows are the COLD ones (general path was
  901: # wrong); #378's DISC rows are the WARM ones (LDM/STM fast path was wrong) --
  902: # the inverted polarity is the point, and the probe carries explicit per-row
  903: # kinds for exactly that reason. Swept against the pre-#378 build: 24/34, the
  904: # ten warm multi rows red at exactly the per-word-reversed values. Fixed: 34/34.
  905: # #386 grew the section 34 -> 58 (swp/swpb; X(swp) was LE-only both sides and
  906: # unrotated/unmasked). Swept against the pre-#386 build: 42/58, all 16 DISC

  925:          "be ldm warm r1" "be ldm warm r2" \
  926:          "swp be word" "swp be b0" "swp be b1" "swp be b2" "swp be b3" \
  927:          "swp be unal r2" "swp be unal b0" "swp be unal b1" \
  928:          "swp be unal b3" "swp be unal sent" \
  929:          "swp le unal r2" "swp le unal b0" "swp le unal b1" \
  930:          "swp le unal b2" "swp le unal b3" "swp le unal sent" \
  931:          "swp be un2 r2" "swp be un2 b0" "swp be un2 b1" \
  932:          "swp be un2 b2" "swp be un2 b3" "swp be un2 sent" \
  933:          "swp le un2 r2" "swp le un2 b0" "swp le un2 b1" \
  934:          "swp le un2 b2" "swp le un2 b3" "swp le un2 sent" \
  935:          "ldrd be r4" "ldrd be r5" \
  936:          "strd be b0" "strd be b1" "strd be b2" "strd be b3" \
  937:          "strd be b4" "strd be b5" "strd be b6" "strd be b7" \
  938:          "390 be base +8" "390 be base +12" \
  939:          "390 le base +8" "390 le base +12" \
  940:          "390 be bothpc" "390 le bothpc"; do
  941:     n=$(count "$ENDLOG" "^$v  *DISC .*ok$")
  942:     check "  endian row: $v" "$n" 1
  943: done
  944: 
  945: #  #390's CTRL rows, pinned by name so they cannot be quietly retyped or
  946: #  dropped -- a DISC pattern would never match them.  Two different reasons:
  947: #
  948: #  the DATA-role rows must pass on the PRE-fix build too, because they do not
  949: #  detect the defect; they detect a WRONG FIX that moves the stored R15 value
  950: #  off +12, which A2-9 forbids doing for some R15 stores and not others.
  951: #
  952: #  the LDRD rows are CTRL because the round's original claim about them was
  953: #  REFUTED by measurement: LDRD's base was never +12.  They began as DISC with
  954: #  a `buggy` column that turned out to be fiction -- the mutant battery left
  955: #  them green, and the actual pre-#390 parent reads the same values the fixed
  956: #  build does.  They are kept as standing evidence that LDRD with Rn == PC is
  957: #  unaffected, and they will redden if a future round drags it into that path.
  958: for v in "390 be data +12" "390 le data +12" \
  959:          "390 be ldrd r0" "390 be ldrd r1" \
  960:          "390 le ldrd r0" "390 le ldrd r1"; do
  961:     n=$(count "$ENDLOG" "^$v  *CTRL .*ok$")
  962:     check "  endian row: $v" "$n" 1
  963: done
  964: 
  965: # ---------------------------------------------------------------------------
  966: #  #432: THE FOOTBRIDGE'S FIRST REACHABILITY WITNESS OF ANY KIND.
  967: #
  968: #  Recorded before this probe existed: R6 was the ONLY code round in this tree with no
  969: #  reachability witness -- no rig boots a footbridge machine and there is no m8online analog.
  970: #  regress/diff_footbridge.c calls the device functions DIRECTLY, so it proves BEHAVIOUR and
  971: #  would stay green under a change that unmapped the device entirely.  This drives real guest
  972: #  ldr/str through the real address decode and the real memory_rw plumbing on a COLD DEBUGGER:
  973: #  measured 1.9 s for three arms, against a rig boot this tree does not have at all.
  974: #
  975: #  IT LIVES HERE, in the ARM gate, for the same reason m8820x_sites_probe.py lives in
  976: #  gate_m88k_rounding.sh: `cats` is an ARM machine and this gate already writes the four-byte
  977: #  raw stub that makes such a machine construct.  A new gate script would move GATE_MANIFEST,
  978: #  which is a bigger claim than one probe is worth.
  979: #
  980: #  THE TRAP IT GUARDS, and it nearly produced a confident wrong answer.  machine_cats.c:131
  981: #  maps only the low 256 MB and the footbridge is at PA 0x42000000, so under the boot-time MMU
  982: #  every device row reads 0x0 WITH A RAM LIVENESS ROW STILL GREEN -- which is exactly what an
  983: #  absent device looks like.  The probe's arm T runs the same program with the MMU-disable
  984: #  instructions replaced by nops and requires that it CANNOT produce the device's answer; arm L
  985: #  reads CP15 c1 back and requires bit 0 clear.  Negative-controlled in both directions.
  986: FBLOG=$LOGDIR/footbridge_sites.log
  987: python3 footbridge_sites_probe.py "$PMAX" "$STUB" > "$FBLOG" 2>&1 || true
  988: grep -E "^(  arm |C[0-9]|A[0-9]|I1|K1|D1)" "$FBLOG" | sed 's/^/       /'
  989: 
  990: if ! grep -q "FOOTBRIDGE_SITES_" "$FBLOG"; then
  991:     note "footbridge probe produced no verdict; last lines follow"
  992:     tail -5 "$FBLOG" | sed 's/^/       /'
  993:     check "footbridge probe completed" "no" "yes"
  994: else
  995:     #  THE CONTROL FIRST, and separately from the verdict.  A probe whose controls failed has
  996:     #  measured NOTHING, and this one has a control that a liveness row cannot substitute for.
  997:     check "footbridge: controls prove the probe measures" \
  998:           "$(grep -c 'FOOTBRIDGE_SITES_CONTROL=OK' "$FBLOG")" "1"
  999:     check "footbridge: every row green" \
 1000:           "$(grep -c 'FOOTBRIDGE_SITES_PASS' "$FBLOG")" "1"
 1001:     #  VALUES, NOT SURVIVAL.  0x1011 is DC21285_VENDOR_ID (dev_footbridge.c:423) and can only
 1002:     #  have come back through this device; an unmapped read survives too, it just returns 0.
 1003:     check "footbridge: VENDOR_ID 0x1011 through a real guest ldr" \
 1004:           "$(grep -cE '^A1 .*got=0x00001011 .*ok$' "$FBLOG")" "1"
 1005:     #  The vanishing top byte IS the handler's signature: :548 stores idata & TIMER_MAX_VAL.
 1006:     #  RAM, or any decode that merely absorbed the store, returns 0x12345678 unchanged.
 1007:     check "footbridge: TIMER_1_LOAD masked to 24 bits by the handler" \
 1008:           "$(grep -cE '^A2 .*got=0x00345678 .*ok$' "$FBLOG")" "1"
 1009:     #  THE PROBE'S OWN FAILABILITY CONTROL.  Arms L and K differ by ONE instruction; K reads
 1010:     #  IRQ_ENABLE_SET, an UNFIXED fatal()+exit(1) at :495-497.  Without it, "SURVIVED" on every
 1011:     #  row is satisfied by a probe whose guest code never reached the device at all.
 1012:     check "footbridge: the one-instruction kill arm still dies" \
 1013:           "$(grep -cE '^K1 .*ok$' "$FBLOG")" "1"
 1014:     #  The defence against the hand-assembled-encoding trap: every planted word is compared
 1015:     #  against the disassembly the emulator printed AS IT STEPPED IT.
 1016:     check "footbridge: no planted word failed its disassembly check" \
 1017:           "$(grep -c 'DISASSEMBLY MISMATCH' "$FBLOG")" "0"
 1018: fi
 1019: 
 1020: #  ---------------------------------------------------------------------------------------
 1021: #  #439/#440 PIT 8253 latch + LSB/MSB selector -- pitlatch / pitclobber.
 1022: #
 1023: #  WIRED HERE, ALONGSIDE footbridge_sites_probe.py, BECAUSE gate_hygiene.sh SAID SO.  Its
 1024: #  own 17 -> 18 bump note reads: "Wiring it into gate_arm.sh alongside
 1025: #  footbridge_sites_probe.py is the follow-up, and it wants an operator who can run that
 1026: #  gate."  The probe execs `-E cats` and hand-assembles ARM, so this is the only gate whose
 1027: #  machine it shares.
 1028: #
 1029: #  *** IT SHIPPED UNWIRED AND THE CARRIER SAID WHY THAT IS DANGEROUS: an unwired probe is
 1030: #  exactly what shipped latent in cf4b083. ***  It has been dated-exempt in
 1031: #  check_probe_wiring.py until 2026-09-20 (`wiringcliff`), and this discharges that debt --
 1032: #  the exemption line comes out in the same edit, which is what stops a stale exemption
 1033: #  outliving its cause.
 1034: #
 1035: #  CONTROLS FIRST AND SEPARATELY.  The probe's own header says it: "CONTROLS (if any is RED
 1036: #  every row below is meaningless)".  C1 is a RAM liveness through the same decode, C2 reads
 1037: #  CP15 c1 back to prove the MMU really went off, A1 is a device signature -- and arm T is
 1038: #  the negative control that runs the same program with the MMU-disable instructions
 1039: #  replaced by nops and requires it CANNOT produce the device's answer.  Under the boot-time
 1040: #  MMU the low 256 MB alone is mapped, so a device row reads 0x0 WITH A LIVENESS ROW STILL
 1041: #  GREEN, which is indistinguishable from an absent device.  That is why C2 and T exist and
 1042: #  why a liveness row cannot stand in for them.
 1043: #  ---------------------------------------------------------------- #497 widthkillclass
 1044: #  *** THIS PROBE IS FOR AN SGI/MIPS MACHINE AND IT IS WIRED INTO THE GATE NAMED `arm`.
 1045: #  That is following a precedent, not endorsing it. ***  This gate already runs
 1046: #  footbridge_sites_probe.py and pit8253_latch_probe.py -- neither of which is an ARM
 1047: #  instruction test either -- so it has become the tree's general DEVICE-probe gate by
 1048: #  accretion.  *** BUT THOSE TWO AT LEAST RUN THIS GATE'S OWN `-E cats` MACHINE, AND
 1049: #  THIS ONE DOES NOT: it is the FIRST probe here on a foreign machine AND CPU family.
 1050: #  The PIT wiring comment says outright that it was placed here BECAUSE this is the only
 1051: #  gate whose machine it shares. ***  So this is not a third instance of an existing
 1052: #  accretion; it is a new kind of one, and the sentence above is true while its
 1053: #  implication was generous to the decision it defends.  The architecture-named alternative, gate_mips.sh, is an 82-line RIG-BOOT
 1054: #  gate with no probe infrastructure at all; putting a 35-row detector there would change
 1055: #  what that gate is for.
 1056: #
 1057: #  Recorded rather than silently compounded: the right answer is a gate_devices.sh split,
 1058: #  which is a harness round of its own and owes its own controls.  FILED as
 1059: #  `gatedevicesplit`, with a forcing criterion: the NEXT device probe wired into
 1060: #  this gate converts it from filed to OWED.
 1061: #  *** #498 sgidewidth.  WIRING THIS PROBE FIRES A PRE-SPECIFIED TRIGGER, AND THE TRIGGER
 1062: #  IS HONOURED RATHER THAN QUIETLY PASSED. ***  The #497 block below filed `gatedevicesplit`
 1063: #  with a forcing criterion in its own words: "the NEXT device probe wired into this gate
 1064: #  converts it from filed to OWED."  This is that probe.  The row is moved to OWED in the
 1065: #  same commit -- a criterion that fires and is ignored is worse than one never written,
 1066: #  because the next reader trusts it.
 1067: #
 1068: #  It is wired HERE anyway, and deliberately: the split is a harness round owing its own
 1069: #  controls, and holding a HIGH device fix hostage to a gate refactor would be the tail
 1070: #  wagging the dog.  What is NOT acceptable is compounding it silently.
 1071: DEWLOG=$LOGDIR/sgi_de_width.log
 1072: python3 sgi_de_width_probe.py "$PMAX" gate > "$DEWLOG" 2>&1 || true
 1073: 
 1074: #  SENTINEL FIRST -- a preserved log is verified by its completion sentinel, never by its
 1075: #  existence.  A killed run loses every row and looks exactly like one that produced none.
 1076: if ! grep -q "OPUS498T_DONE" "$DEWLOG"; then
 1077:     note "sgi_de width probe did not reach its completion sentinel; last lines follow"
 1078:     tail -5 "$DEWLOG" | sed 's/^/       /'
 1079:     check "sgi_de width probe completed" "no" "yes"
 1080: else
 1081:     check "sgi_de width probe completed" "yes" "yes"
 1082: 
 1083:     #  CONTROLS BY NAME.  A detector whose liveness and device-signature rows are dead
 1084:     #  scores well on a corpse: every access row would read "no message" and pass.
 1085:     check "sgi_de controls live+devsig" \
 1086:           "$(grep -q 'OPUS498T_CONTROL=OK' "$DEWLOG" && echo yes || echo no)" "yes"
 1087: 
 1088:     #  PER-ROW PASS, one line, checked individually.  A row that silently stops being
 1089:     #  tested is the padded-column class -- a name as long as its column makes the check
 1090:     #  unsatisfiable and the row quietly stops being tested.
 1091:     #  *** `tail_acc_x' PINS A HOST DEATH ON PURPOSE AND WILL GO RED BY SUCCEEDING. ***
 1092:     #  It observes `sgideprimop' -- an accepted-width access with startFlag reaches
 1093:     #  draw_primitive(), whose default arm is fatal on 254 of 256 top-byte op classes,
 1094:     #  two of which (POINT 0x00, TRIANGLE 0x02) are DOCUMENTED primitives.
 1095:     #
 1096:     #  *** THE BLAST RADIUS HAS THREE TIERS, NOT ONE, AND THIS NOTE SAID `BOTH ROWS' UNTIL
 1097:     #  2026-08-31.  Corrected after the grok seat read the oracles against the code paths
 1098:     #  they exercise and found the overstatement. ***
 1099:     #
 1100:     #    tail_acc_x            CERTAIN red -- wants exit1, and the fix removes the death.
 1101:     #    tail_acc              CONDITIONAL -- it counts the DRAW message SUBSTRING and
 1102:     #                          wants 1.  A fix that LATCHES the text without REWORDING it
 1103:     #                          still prints the first occurrence, so the row stays GREEN.
 1104:     #                          It reds only if the message is reworded.
 1105:     #    hi_draw, hi_rd_draw   NEITHER red NOR safe.  Both want count(DRAW) == 0, so a
 1106:     #                          REWORD leaves them green because the string no longer
 1107:     #                          exists -- GREEN FOR THE WRONG REASON, i.e. VACUOUS BY
 1108:     #                          CONSTRUCTION.  A reword silently blinds them; it does not
 1109:     #                          fail them, and nothing would say so.
 1110:     #
 1111:     #  *** SO THE DESIGN CONSTRAINT IS: KEEP THE MESSAGE TEXT AND ADD `(once)'. ***  That
 1112:     #  costs ONE oracle re-pin (tail_acc_x).  Rewording costs two re-pins AND silently
 1113:     #  blinds two further rows -- which is the worse half and is invisible to any gate.
 1114:     #  *** AND THE OBVIOUS RE-PIN IS A TRAP.  DO NOT RE-PIN `tail_acc_x' ONTO `"exit0"'. ***
 1115:     #  Adjudicated 2026-08-31 by the flagship seat, which traced the channel rather than the
 1116:     #  intent.  The row wants `exit1' today; the natural correction is `exit0' ("the host now
 1117:     #  survives").  Trace what that oracle can see:
 1118:     #
 1119:     #    a future one-token death reinstatement -- `exit(0)' at the default arm instead of
 1120:     #    `exit(1)' -- prints the announce once and then DIES.  `how' is then "exit0", so a
 1121:     #    re-pinned tail_acc_x reads GREEN; `tail_acc' still counts its one message, GREEN;
 1122:     #    and no other session reaches draw_primitive() at all.  TOTAL ESCAPE, 29/29.
 1123:     #
 1124:     #  So the re-pin would MINT, at the exact site being fixed, the exact blindness the queue
 1125:     #  row `exit0oracle' was filed to describe: EXIT STATUS CANNOT VARY between `declined and
 1126:     #  then quit' and `died with status 0'.  That is knowable at WRITING time from the CHANNEL
 1127:     #  check -- name the mutant a row kills and the observable that differs under it -- and it
 1128:     #  is why that check is run before the table, not after.
 1129:     #
 1130:     #  RE-PIN ONTO A POSITIVE POST-DRAW OBSERVABLE INSTEAD: extend the session with a load
 1131:     #  through the device and assert the VALUE (`printed()' already exists in the probe and
 1132:     #  reads "died" when the host is gone).  An exit-status row may stay as a SECOND channel;
 1149:     #  is a defect this gate has already shipped once.
 1150:     check "sgi_de rows emitted" \
 1151:           "$(( $(count "$DEWLOG" " ok$") + $(count "$DEWLOG" " FAIL$") ))" "30"
 1152:     check "sgi_de rows green" "$(count "$DEWLOG" " ok$")" "30"
 1153: fi
 1154: 
 1155: SGILOG=$LOGDIR/sgi_re_width.log
 1156: python3 sgi_re_width_probe.py "$PMAX" gate > "$SGILOG" 2>&1 || true
 1157: 
 1158: #  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
 1159: #  existence: a killed run loses every row and looks exactly like a run that produced none.
 1160: if ! grep -q "OPUS497T_DONE" "$SGILOG"; then
 1161:     note "sgi_re width probe did not reach its completion sentinel; last lines follow"
 1162:     tail -5 "$SGILOG" | sed 's/^/       /'
 1163:     check "sgi_re width probe completed" "no" "yes"
 1164: else
 1165:     grep -E " ok$| FAIL$" "$SGILOG" | sed 's/^/       /'
 1166: 
 1167:     #  CONTROLS BY NAME, not by count.  A green-row total lets a control go red while the
 1168:     #  sum stays acceptable -- and a run whose controls died is an APPARATUS failure, which
 1169:     #  must not be read as a wall of product failures.
 1170:     for c in "live" "live64" "devsig stat"; do
 1171:         check "sgi_re control: $c" "$(count "$SGILOG" "^$c  .*ok$")" "1"
 1172:     done
 1173:     check "sgi_re controls live" \
 1174:           "$(grep -q 'OPUS497T_CONTROL=OK' "$SGILOG" && echo yes || echo no)" "yes"
 1175: 
 1176:     #  PER-ROW PASS.  Checked individually rather than by a total, because a row that
 1177:     #  silently stops being tested is the padded-column class: a name as long as its column
 1178:     #  makes a check UNSATISFIABLE and the row quietly stops being tested.
 1179:     #  The list is ONE LINE on purpose -- a backslash-continued list assembled through
 1180:     #  nested quoting once gained a bogus word `n` and shipped a RED gate.
 1181:     for v in "live" "devsig stat" "tlb_a sw surv" "tlb_a sw lat1" "tlb_a lw surv" "tlb_a accept" "tlb_b sw surv" "tlb_b sw lat1" "tlb_b lw surv" "tlb_b accept" "tlb_c sw surv" "tlb_c sw lat1" "tlb_c lw surv" "tlb_c accept" "tex sw surv" "tex sw lat1" "tex lw surv" "tex accept" "linear_a sw surv" "linear_a sw lat1" "linear_a lw surv" "linear_a accept" "linear_b sw surv" "linear_b sw lat1" "linear_b lw surv" "linear_b accept" "xsite 6msg" "xsite order" "other decl" "live64" "tlb_a ld lo" "tlb_a ld hi" "tlb_b ld lo" "tlb_b ld hi" "tlb_c ld lo" "tlb_c ld hi" "linear_a ld lo" "linear_a ld hi" "linear_b ld lo" "linear_b ld hi" "tex ld lo" "tex ld hi" "tex rd lat1" "tex xbit" "tex/unmap" "unmap/tex"; do
 1182:         check "sgi_re row: $v" "$(count "$SGILOG" "^$v  .*ok$")" "1"
 1183:     done
 1184: 
 1185:     #  DENOMINATOR PINNED TO A LITERAL.  A detector that loses rows must not be able to pass
 1186:     #  by shrinking, and the count is the only thing that says so.  Raise it DELIBERATELY.
 1187:     #  Both halves pinned: 46 rows emitted AND all 46 green.
 1188:     #  *** RAISED 44 -> 46 ON THIS ROUND'S OWN PASS 2. ***  The panel found a clause-(d)
 1189:     #  floor breach: giving the TEX read decline an already-used NON-LEN latch bit
 1190:     #  (1 << 8 = SGIRE_W_UNMAP_RD) escapes a 44/44 sweep, because the detector's four
 1191:     #  TEX-read scenarios and its unmapped-read scenario never share an emulator instance
 1192:     #  -- `tex xbit' sets bits 0-5 only.  Repaired by two SAME-INSTANCE rows asserting both
 1193:     #  announces fire, in BOTH orderings; one ordering would leave the mirror open.
 1194:     #  *** RAISED 35 -> 44 BY #513, DELIBERATELY, IN THE SAME COMMIT AS THE FIX. ***
 1195:     #  The six `<arm> ld kill' rows are GONE -- they asserted that a len == 8 READ still
 1196:     #  ends the host at each window, which was true until #513 removed those kills.  They
 1197:     #  are replaced by TWO anchored ACCEPT rows per accepting arm (window base AND last
 1198:     #  slot, because a row at the base tests the near bound twice and the far bound never),
 1199:     #  four CRIME_RE_TEX decline rows, and a 64-bit liveness control.  Arithmetic:
 1200:     #  35 - 6 + 14 + 1 = 44.  Two rows rather than one,
 1201:     #  because a single "35 ok" check cannot tell a LOST row from a FAILING one -- and
 1202:     #  those need different responses.
 1203:     #  *** THE FIRST DRAFT OF THIS BLOCK HAD TWO DEFECTS, BOTH FOUND BY THE PASS-2 SEAT.
 1204:     #  (1) It ended in `|| true`, which is INERT: check() in lib.sh has no `return`, so
 1205:     #  it exits 0 on BOTH branches and the row counts into _fails regardless.  The
 1206:     #  suppression never existed -- but a reader would conclude that row was advisory,
 1207:     #  which is worse than either behaviour on its own.
 1208:     #  (2) The denominator concatenated two counts and compared to "350" -- satisfied by
 1209:     #  (35 ok, 0 FAIL) AND by (3 ok, 50 FAIL).  A string join is not an arithmetic
 1210:     #  identity, and it was redundant with the two rows below it anyway. ***
 1211:     #  *** AND THE FIRST REPAIR OF (2) REPRODUCED THE VERY DEFECT THE PANEL HAD JUST FOUND
 1212:     #  IN THIS ROUND'S BRIEF.  I wrote `count "$SGILOG" " ok$| FAIL$"` -- but count() is
 1213:     #  `grep -ac`, PLAIN grep, so `|` is a LITERAL and the pattern matches NOTHING.
 1214:     #  Measured: 0 against a log holding 35 rows.  The seats had flagged `grep -i
 1215:     #  'sgi|width'` in the brief for exactly this, one hour earlier. ***
 1216:     #
 1217:     #  Summed ARITHMETICALLY instead, which needs no regex dialect at all -- and unlike the
 1218:     #  string-concatenation form it replaces, it cannot be satisfied by (3 ok, 50 FAIL).
 1219:     check "sgi_re rows emitted" \
 1220:           "$(( $(count "$SGILOG" " ok$") + $(count "$SGILOG" " FAIL$") ))" "46"
 1221:     check "sgi_re rows green"   "$(count "$SGILOG" " ok$")"   "46"
 1222:     check "sgi_re rows red"     "$(count "$SGILOG" " FAIL$")" "0"
 1223: 
 1224: fi
 1225: 
 1226: #  ---- *** MOVED OUT ONE NESTING LEVEL, 2026-08-31.  It was pasted INSIDE the
 1227: #  ---- sgi_re_width probe's success branch, so if THAT probe missed its sentinel this
 1228: #  ---- block was never invoked at all -- 28 rows, three denominators and its own
 1229: #  ---- sentinel check evaporating while the gate reported one red row about a
 1230: #  ---- different probe.  Silent coverage loss, and it defeated the very sentence
 1231: #  ---- that justified the block (a committed detector no gate runs is a wrong
 1232: #  ---- record).  Both sibling blocks sit at depth 0; the block's own zero
 1233: #  ---- indentation was the tell that it had been written top-level and pasted
 1234: #  ---- into a branch.  Found by the #499 pass-2 seat walking the brace depth. ***
 1235: #  ---- #499's detector for the unmatched-address catch-all.  Wired IN THE SAME COMMIT as
 1236: #  ---- the fix: a committed detector that no gate runs is a wrong record under the vacuity
 1237: #  ---- floor's contract clause, and this one measured 18/28 on the pre-fix build and 28/28
 1238: #  ---- on the fix, so it carries its own test-first evidence.
 1239: #  ---- the coordinator's file.  Modelled on the sgi_re_width_probe block -- find it
 1240: #  ---- with `grep -n 'sgi_re_width_probe.py "$PMAX"' gate_arm.sh`, NOT by line
 1241: #  ---- number: the original citation said :1131, which is inside the sgi_de comment,
 1242: #  ---- and this block has since moved once already.  A same-file line citation is
 1243: #  ---- invalidated by your own edits to that file.
 1244: UNMLOG=$LOGDIR/sgi_re_unmapped.log
 1245: python3 sgi_re_unmapped_probe.py "$PMAX" gate > "$UNMLOG" 2>&1 || true
 1246: 
 1247: #  SENTINEL FIRST.  A preserved log is verified by its completion sentinel, never by its
 1248: #  existence: a killed run loses every row and looks exactly like a run that produced none.
 1249: if ! grep -q "OPUS499T_DONE" "$UNMLOG"; then
 1250:     check "sgi_re unmapped probe completed" "no" "yes"
 1251: else
 1252:     check "sgi_re unmapped probe completed" "yes" "yes"
 1253:     check "sgi_re unmapped controls" "$(count "$UNMLOG" '^OPUS499T_CONTROL=OK$')" "1"
 1254:     for v in "live" "devsig" "wr surv" "wr kill" "wr decl" "rd surv" "rd kill" "rd decl" "rd sent" "rd nodbe" "wr lat1" "rd lat1" "wr rd 2msg" "xwin7 pre" "xwin wr" "xwin rd" "tlba acc lo" "tlba acc hi" "tlbb acc lo" "tlbb acc hi" "tlbc acc lo" "tlbc acc hi" "tex acc lo" "tex acc hi" "lina acc lo" "lina acc hi" "linb acc lo" "linb acc hi" "wr narrow surv" "wr narrow decl" "rd narrow surv" "rd narrow sent" "clip surv" "clip decl" "clip nar surv" "clip nar decl" "clip rd surv" "clip rd decl" "clip rd sent" "clip rdn surv" "clip rdn decl" "cliphi rd surv" "cliphi rd decl" "cliphi wr surv" "cliphi wr decl" "rd narrow decl" "wr zero surv" "wr zero decl" "wr then live" "clip wr live"; do
 1255:         check "sgi_re unmapped row: $v" "$(count "$UNMLOG" "^$v  .*ok$")" "1"
 1256:     done
 1257: 
 1258:     #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one: a single "28 ok" check
 1259:     #  cannot tell a LOST row from a FAILING one, and those need different responses.
 1260:     check "sgi_re unmapped rows emitted" \
 1261:           "$(( $(count "$UNMLOG" " ok$") + $(count "$UNMLOG" " FAIL$") ))" "50"
 1262:     check "sgi_re unmapped rows green" "$(count "$UNMLOG" " ok$")"   "50"
 1263:     check "sgi_re unmapped rows red"   "$(count "$UNMLOG" " FAIL$")" "0"
 1264: fi
 1265: 
 1266: #  ---- sgirandompixel: horrible_getputpixel()'s unimplemented-mode arm.
 1267: #
 1268: #  WHAT THIS PROTECTS.  That arm used to do `*color = random()' with its exit(1) commented out, so a failed
 1269: #  pixel GET handed the CALLER a random value and draw_primitive() wrote it to the destination in the same
 1270: #  loop iteration.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes crmfbreg.h documents and extracts to
 1271: #  tlb_mode 5, so it was reachable with a DOCUMENTED mode.  Now declined, with a latched announce.
 1272: #
 1273: #  The probe is BOTH the rung-3 WITNESS (7/8 red on the pre-fix build under the re-pinned oracle, preserved as
 1274: #  artifacts/sgirandompixel/witness_20260906/prefix_repinned_RED.out) and the DETECTOR (kill table in
 1275: #  artifacts/sgirandompixel/killtable/: five mutants, all killed, BASE 8/8 opening and closing).
 1276: #
 1277: #  `lin_b diag once' IS THE ROW THAT NEEDED THE MOST CARE and the reason the probe draws a 1x4 rectangle
 1278: #  rather than a single pixel: with one pixel an UNLATCHED announce also fires exactly once, the count channel
 1279: #  cannot vary, and M_NOLATCH escaped 8/8.  Height rather than width, because LIN_A addressing is
 1280: #  `ofs = x & 4095' -- y is ignored, so four rows rewrite one byte and the VALUE oracle survives.
 1281: RANDLOG=$LOGDIR/sgi_re_randompixel.log
 1282: python3 sgi_re_randompixel_probe.py "$PMAX" gate > "$RANDLOG" 2>&1 || true
 1283: 
 1284: if ! grep -q "SGIRAND_DONE" "$RANDLOG"; then
 1285:     check "sgi_re randompixel probe completed" "no" "yes"
 1286: else
 1287:     check "sgi_re randompixel probe completed" "yes" "yes"
 1288:     check "sgi_re randompixel witness verdict" "$(count "$RANDLOG" '^SGIRAND_WITNESS=PASS$')" "1"
 1289:     #  TWO SPACES AFTER $v, NOT ONE -- the sibling block above uses the same idiom and this block did not,
 1290:     #  which the gate caught on its first run: `lin_b diag' got=2, because `^lin_b diag .*ok$' also matches
 1291:     #  the row `lin_b diag once'.  That is the padded-column trap in its MATCHES-TWO-ROWS direction.
 1292:     #
 1293:     #  The probe prints names with "%-16s" followed by an explicit space, so a name of N chars is followed
 1294:     #  by (16-N)+1 spaces.  The longest name here is `lin_b diag once' at 15, leaving exactly two -- so this
 1295:     #  pattern has ONE CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s"
 1296:     #  in the same diff.
 1297:     #
 1298:     #  *** CORRECTED 2026-09-07 (#505 pass 2, the kimi substitute).  This used to say a name of 16 or
 1299:     #  more makes the pattern "UNSATISFIABLE, which is the same trap in its other, SILENT direction:
 1300:     #  the check stops testing anything and stays green."  THE SILENT PART IS FALSE. ***  `count'
 1301:     #  returns 0, `check' compares 0 against the wanted "1", and 0 != 1 FAILS -- loudly.  Measured
 1302:     #  over rendered rows at lengths 15/16/17.  An unsatisfiable pattern is silent only where a check
 1303:     #  wants ZERO, which no row check here does.  The dangerous direction is the ONE-SPACE form,
 1304:     #  which matched `lin_b diag once' from `lin_b diag' and is what this block was written for.
 1305:     for v in "live" "devsig" "copy lin_a" "lin_b not src" "lin_b is fg" "lin_b alive" "lin_b diag" "lin_b diag once"; do
 1306:         check "sgi_re randompixel row: $v" "$(count "$RANDLOG" "^$v  .*ok$")" "1"
 1307:     done
 1308: 
 1309:     #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one, for the sibling block's reason.
 1310:     check "sgi_re randompixel rows emitted" \
 1311:           "$(( $(count "$RANDLOG" " ok$") + $(count "$RANDLOG" " FAIL$") ))" "8"
 1312:     check "sgi_re randompixel rows green" "$(count "$RANDLOG" " ok$")"   "8"
 1313:     check "sgi_re randompixel rows red"   "$(count "$RANDLOG" " FAIL$")" "0"
 1314: fi
 1315: 
 1316: #  ------------------------------------------------------------ #505 sgirergbroundtrip
 1317: #  horrible_getputpixel()'s RGB GET read buf[1..3] while its RGB PUT writes the three channels at
 1318: #  buf[0..2] and an explicit pad at buf[3] -- so an RGB pixel did not survive its own round trip and
 1319: #  the red channel was dropped.  RGB was the ONLY 32-bit colour mode in the file failing this way.
 1320: #
 1321: #  THE ARM WAS CHOSEN ON EVIDENCE FROM A DIFFERENT DEVICE, which is what makes the warrant
 1322: #  non-circular: dev_sgi_gbe.c's scanout reads the same tile memory back as
 1323: #  (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3], and CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
 1324: #  31..24 / 23..16 / 15..8 -- byte 0 is R and byte 3 is UNUSED.  The pad sits at buf[3] because the
 1325: #  CONSUMER ignores buf[3], not because PUT writes a zero there.
 1326: #
 1327: #  `rgb depth64' IS NOT DECORATION -- IT CLOSES A MEASURED CLAUSE-(d) FLOOR BREACH.  The first kill
 1328: #  table's M6_cond (guard kept, repair conditioned on `bufdepth == 4') scored a CLEAN SWEEP 6/6,
 1329: #  because every session then used BUFDEPTH_32 and the mutant's fix branch was the only one the
 1330: #  detector ever executed.  Its mirror M7_cond8 (exempting bufdepth 8 instead) also dies, so the
 1331: #  WIDTH AXIS is closed rather than the one cell the mutant happened to use.
 1332: #
 1333: #  `rgb samemode' reaches the RGB *PUT* arm, which no other row executes -- every other session is
 1334: #  RGB->RGBA.  Measured, not assumed: M8_put corrupts that arm alone and reds exactly this row.
 1335: RGBLOG=$LOGDIR/sgi_re_rgb.log
 1336: python3 sgi_re_rgb_probe.py "$PMAX" gate > "$RGBLOG" 2>&1 || true
 1337: 
 1338: if ! grep -q "SGIRGB_DONE" "$RGBLOG"; then
 1339:     check "sgi_re rgb probe completed" "no" "yes"
 1340: else
 1341:     check "sgi_re rgb probe completed" "yes" "yes"
 1342:     check "sgi_re rgb witness verdict" "$(count "$RGBLOG" '^SGIRGB_WITNESS=PASS$')" "1"
 1343:     #  TWO SPACES AFTER $v, NOT ONE -- the sibling blocks above were both bitten by the one-space
 1344:     #  form, in both of its directions.  Pre-flighted mechanically for this row set before the gate
 1345:     #  ever ran: no name is a prefix of another, and every pattern matches exactly one rendered row.
 1346:     #
 1347:     #  The probe prints names with "%-16s" plus an explicit space, so a name of N chars is followed
 1348:     #  by (16-N)+1 spaces.  The longest here is `rgb not corrupt' at 15, leaving exactly two -- ONE
 1349:     #  CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s" in the same diff.
 1350:     #
 1351:     #  *** WHAT A TOO-LONG NAME ACTUALLY DOES: IT REDS, LOUDLY.  The sibling block above says it
 1352:     #  "silently stops testing anything while staying green", and an earlier draft of THIS block
 1353:     #  copied that sentence.  It is WRONG, and the pass-2 panel caught it. ***  `count' returns 0
 1354:     #  when the pattern matches nothing, `check' compares that 0 against a wanted "1", and 0 != 1
 1355:     #  FAILS.  Measured over rendered rows at lengths 15/16/17: 15 matches (ok), 16 and 17 match
 1356:     #  nothing (FAIL).  The UNSATISFIABLE direction of this trap is the SAFE one for a want-1 check;
 1357:     #  it is only silent where a check wants ZERO.  The genuinely dangerous direction remains the
 1358:     #  ONE-SPACE form, which matches a LONGER name's row as well and was measured on the sibling.
 1359:     for v in "live" "devsig" "copy lin_a" "rgb chan" "rgb not corrupt" "rgb alive" "rgb samemode" "rgb depth64" "rgb tiled" "rgb tiled64"; do
 1360:         check "sgi_re rgb row: $v" "$(count "$RGBLOG" "^$v  .*ok$")" "1"
 1361:     done
 1362: 
 1363:     #  DENOMINATOR, SUMMED ARITHMETICALLY: a row that stops being emitted at all is otherwise
 1364:     #  invisible -- its named check goes 0, but so does a check for a row that never existed.
 1365:     #  *** THE DENOMINATOR PINNED 8 WHILE THE PROBE EMITTED 9, AND THE ROW LIST NEVER NAMED
 1366:     #  `rgb tiled'.  A pass-3 seat found it by reading the gate against the probe rather than the
 1367:     #  probe against itself. ***  It would have failed LOUDLY -- emitted 9, wanted 8 -- which is the
 1368:     #  safe direction, but it would have shipped, and `rgb tiled' would have been unchecked BY NAME
 1369:     #  while appearing in the count.  Both new rows are named above and the pins are 10.
 1370:     check "sgi_re rgb rows emitted" \
 1371:           "$(( $(count "$RGBLOG" " ok$") + $(count "$RGBLOG" " FAIL$") ))" "10"
 1372:     check "sgi_re rgb rows green" "$(count "$RGBLOG" " ok$")"   "10"
 1373:     check "sgi_re rgb rows red"   "$(count "$RGBLOG" " FAIL$")" "0"
 1374: fi
 1375: 
 1376: #  ------------------------------------------------------------ #500 sgideprimop
 1377: #  draw_primitive()'s default arm ended the host on a guest-written drawing op.
 1378: #  Now a latched decline.  The detector is its OWN probe rather than rows bolted
 1379: #  onto sgi_de_width_probe.py, because that one is about WIDTH and owns the
 1380: #  `tail_acc*' rows that pin draw_primitive's REACHABILITY -- a different claim.
 1381: PRIMLOG=$LOGDIR/sgi_de_primop.log
 1382: python3 sgi_de_primop_probe.py "$PMAX" gate > "$PRIMLOG" 2>&1 || true
 1383: 
 1384: #  SENTINEL FIRST, for the reason the sibling block states: a preserved log is
 1385: #  verified by its completion sentinel, never by its existence.
 1386: if ! grep -q "OPUS500_DONE" "$PRIMLOG"; then
 1387:     check "sgi_de primop probe completed" "no" "yes"
 1388: else
 1389:     check "sgi_de primop probe completed" "yes" "yes"
 1390:     for v in "live" "devsig" "pt surv" "pt live" "pt decl" "tri surv" "tri live" "tri decl" "reset surv" "reset live" "reset decl" "two once" "two live" "rd surv" "rd decl" "xlatch decl" "xlatch live" "xlatch unm" "xlatch unliv" "xlatch all" "xlatch alliv" "xlatch pre" "acc rect" "acc live" "acc rect mod" "acc rect liv" "acc line mod" "acc line liv" "n25 nox" "n25 noxset" "dec b26" "dec b27" "dec b28" "dec b29" "dec b30" "dec b31" "dec hi liv" "dec low" "dec low liv" "dec ops" "dec ops liv" "dec flood" "dec flood liv" "dec regs" "dec regs liv" "dec regs set" "dec regs stip" "n25 rect" "n25 rectliv" "n25 rectset" "n25 line"; do
 1391:         check "sgi_de primop row: $v" "$(count "$PRIMLOG" "^$v  .*ok$")" "1"
 1392:     done
 1393: 
 1394:     #  DENOMINATOR, SUMMED -- a single "19 ok" check cannot tell a LOST row from a
 1395:     #  FAILING one, and those need different responses.
 1396:     check "sgi_de primop rows emitted"           "$(( $(count "$PRIMLOG" " ok$") + $(count "$PRIMLOG" " FAIL$") ))" "51"
 1397:     check "sgi_de primop rows green" "$(count "$PRIMLOG" " ok$")"   "51"
 1398:     check "sgi_de primop rows red"   "$(count "$PRIMLOG" " FAIL$")" "0"
 1399: fi
 1400: 
 1401: 
 1402: 
 1403: #  ------------------------------------------------------------ pcc2widthkills
 1404: #  Twelve width-guard blocks in DEVICE_ACCESS(pcc2) ended the host on a guest-chosen
 1405: #  access width.  Now a DIRECTION SPLIT: reads accept (the memcpy above the switch
 1406: #  already served them), writes decline with a per-instance latch.  The witness
 1407: #  (pcc2_width_witness.py, 4/10 on the committed build) is NOT run here -- its job was
 1408: #  to exist before the edit; this is the detector it grew into.
 1409: PCC2LOG=$LOGDIR/pcc2_width.log
 1410: python3 -u pcc2_width_probe.py "$PMAX" gate > "$PCC2LOG" 2>&1 || true
 1411: 
 1412: #  SENTINEL FIRST: a preserved log is verified by its completion sentinel, never by
 1413: #  its existence.
 1414: if ! grep -q "PCC2W_PROBE_DONE" "$PCC2LOG"; then
 1415:     check "pcc2 width probe completed" "no" "yes"
 1416: else
 1417:     check "pcc2 width probe completed" "yes" "yes"
 1418:     for v in "live" "devsig" "byte rd" "byte rd liv" "hrd genctl" "hrd genctl lv" "hrd genctl nod" "hwr genctl" "hwr genctl lv" "hrd t2ctl" "hrd t2ctl lv" "hrd t2ctl nod" "hwr t2ctl" "hwr t2ctl lv" "hrd t2icr" "hrd t2icr lv" "hrd t2icr nod" "hwr t2icr" "hwr t2icr lv" "hrd sccerr" "hrd sccerr lv" "hrd sccerr nod" "hwr sccerr" "hwr sccerr lv" "hrd scctx" "hrd scctx lv" "hrd scctx nod" "hwr scctx" "hwr scctx lv" "wrd sccerr" "wrd sccerr lv" "wrd sccerr nod" "wwr sccerr" "wwr sccerr lv" "wwr sccerr dcl" "val h genctl" "val w sccerr" "rb genctl" "rb genctl dcl" "rb vecbase" "rb t2ctl" "rb t2ctl dcl" "rb t2icr" "rb t2icr dcl" "rb scctx" "rb scctx dcl" "hwr sccerr dcl" "rb genctl lo" "latch same" "latch two" "latch aba" "latch same2" "rb2 genctl" "rb2 t2ctl" "rb2 t2icr" "rb2 scctx" "rb2 vecbase" "rb2 sccicr" "rb2 sccrx" "rb2 scsiicr" "rb2 mask" "pscale noig2" "ipl noig2" "hrd genctl rb" "hrd t2ctl rb" "hrd t2icr rb" "hrd scctx rb" "hrd ipl noro" "brd2 genctl" "brd2 vecbase" "brd2 t2ctl" "brd2 t2icr" "brd2 sccicr" "brd2 scctx" "brd2 sccrx" "brd2 scsiicr" "brd2 mask" "brd pscale noig" "brd ipl noro" "rb4 genctl" "rb8 genctl" "rb4 vecbase" "rbq vecbase" "rb8 vecbase" "rb4 t2ctl" "rb8 t2ctl" "rb4 t2icr" "rb8 t2icr" "rb4 sccicr" "rbq sccicr" "rb8 sccicr" "rb4 scctx" "rbq scctx" "rb8 scctx" "rb4 sccrx" "rbq sccrx" "rb8 sccrx" "rb4 scsiicr" "rbq scsiicr" "rb8 scsiicr" "rb4 mask" "rb8 mask" "pscale noig4" "pscale noig8" "ipl noig4" "ipl noig8" "latch samew" "latch samed" "latch all one" "pend2 arm" "pend2 decl" "pend2 rb" "pend2 rbi" "pend2 rb1" "pend2 rb1i" "pend2 rbc" "pend2 rbh" "pend2 rb1c" "pend2 rb1h" "pend2 huh" "pend2 zctl" "pend2 rbz" "pend1 arm" "pend1 decl" "pend1 rb" "pend1 rbi" "pend1 rb2" "pend1 rb2i" "pend1 rbc" "pend1 rbh" "pend1 rb2c" "pend1 rb2h" "pend1 huh" "pend1 zctl" "pend1 rbz" "ovf2 arm" "ovf2 decl" "ovf2 rb" "ovf2 rbv" "ovf2 rbx" "ovf2 rb1" "ovf2 rb1v" "ovf2 rb1x" "ovf2 huh" "ovf1 arm" "ovf1 decl" "ovf1 rb" "ovf1 rbv" "ovf1 rbx" "ovf1 rb2" "ovf1 rb2