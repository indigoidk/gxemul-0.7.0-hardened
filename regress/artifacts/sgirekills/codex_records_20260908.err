 1299:     #  more makes the pattern "UNSATISFIABLE, which is the same trap in its other, SILENT direction:
 1300:     #  the check stops testing anything and stays green."  THE SILENT PART IS FALSE. ***  `count'
 1301:     #  returns 0, `check' compares 0 against the wanted "1", and 0 != 1 FAILS -- loudly.  Measured
 1302:     #  over rendered rows at lengths 15/16/17.  An unsatisfiable pattern is silent only where a check
 1303:     #  wants ZERO, which no row check here does.  The dangerous direction is the ONE-SPACE form,
 1304:     #  which matched `lin_b diag once' from `lin_b diag' and is what this block was written for.
 1305:     for v in "live" "devsig" "copy lin_a" "lin_b not src" "lin_b is fg" "lin_b alive" "lin_b diag" "lin_b diag once"; do
 1306:         check "sgi_re randompixel row: $v" "$(count "$RANDLOG" "^$v  .*ok$")" "1"
 1307:     done
 1308: 
 1309:     #  DENOMINATOR, SUMMED ARITHMETICALLY -- two rows, not one, for the sibling block's reason.
 1310:     check "sgi_re randompixel rows emitted" \
 1311:           "$(( $(count "$RANDLOG" " ok$") + $(count "$RANDLOG" " FAIL$") ))" "8"
 1312:     check "sgi_re randompixel rows green" "$(count "$RANDLOG" " ok$")"   "8"
 1313:     check "sgi_re randompixel rows red"   "$(count "$RANDLOG" " FAIL$")" "0"
 1314: fi
 1315: 
 1316: #  ------------------------------------------------------------ #505 sgirergbroundtrip
 1317: #  horrible_getputpixel()'s RGB GET read buf[1..3] while its RGB PUT writes the three channels at
 1318: #  buf[0..2] and an explicit pad at buf[3] -- so an RGB pixel did not survive its own round trip and
 1319: #  the red channel was dropped.  RGB was the ONLY 32-bit colour mode in the file failing this way.
 1320: #
 1321: #  THE ARM WAS CHOSEN ON EVIDENCE FROM A DIFFERENT DEVICE, which is what makes the warrant
 1322: #  non-circular: dev_sgi_gbe.c's scanout reads the same tile memory back as
 1323: #  (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3], and CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
 1324: #  31..24 / 23..16 / 15..8 -- byte 0 is R and byte 3 is UNUSED.  The pad sits at buf[3] because the
 1325: #  CONSUMER ignores buf[3], not because PUT writes a zero there.
 1326: #
 1327: #  `rgb depth64' IS NOT DECORATION -- IT CLOSES A MEASURED CLAUSE-(d) FLOOR BREACH.  The first kill
 1328: #  table's M6_cond (guard kept, repair conditioned on `bufdepth == 4') scored a CLEAN SWEEP 6/6,
 1329: #  because every session then used BUFDEPTH_32 and the mutant's fix branch was the only one the
 1330: #  detector ever executed.  Its mirror M7_cond8 (exempting bufdepth 8 instead) also dies, so the
 1331: #  WIDTH AXIS is closed rather than the one cell the mutant happened to use.
 1332: #
 1333: #  `rgb samemode' reaches the RGB *PUT* arm, which no other row executes -- every other session is
 1334: #  RGB->RGBA.  Measured, not assumed: M8_put corrupts that arm alone and reds exactly this row.
 1335: RGBLOG=$LOGDIR/sgi_re_rgb.log
 1336: python3 sgi_re_rgb_probe.py "$PMAX" gate > "$RGBLOG" 2>&1 || true
 1337: 
 1338: if ! grep -q "SGIRGB_DONE" "$RGBLOG"; then
 1339:     check "sgi_re rgb probe completed" "no" "yes"
 1340: else
 1341:     check "sgi_re rgb probe completed" "yes" "yes"
 1342:     check "sgi_re rgb witness verdict" "$(count "$RGBLOG" '^SGIRGB_WITNESS=PASS$')" "1"
 1343:     #  TWO SPACES AFTER $v, NOT ONE -- the sibling blocks above were both bitten by the one-space
 1344:     #  form, in both of its directions.  Pre-flighted mechanically for this row set before the gate
 1345:     #  ever ran: no name is a prefix of another, and every pattern matches exactly one rendered row.
 1346:     #
 1347:     #  The probe prints names with "%-16s" plus an explicit space, so a name of N chars is followed
 1348:     #  by (16-N)+1 spaces.  The longest here is `rgb not corrupt' at 15, leaving exactly two -- ONE
 1349:     #  CHARACTER of margin.  If a name must grow past 15, widen the probe's "%-16s" in the same diff.
 1350:     #
 1351:     #  *** WHAT A TOO-LONG NAME ACTUALLY DOES: IT REDS, LOUDLY.  The sibling block above says it
 1352:     #  "silently stops testing anything while staying green", and an earlier draft of THIS block
 1353:     #  copied that sentence.  It is WRONG, and the pass-2 panel caught it. ***  `count' returns 0
 1354:     #  when the pattern matches nothing, `check' compares that 0 against a wanted "1", and 0 != 1
 1355:     #  FAILS.  Measured over rendered rows at lengths 15/16/17: 15 matches (ok), 16 and 17 match
 1356:     #  nothing (FAIL).  The UNSATISFIABLE direction of this trap is the SAFE one for a want-1 check;
 1357:     #  it is only silent where a check wants ZERO.  The genuinely dangerous direction remains the
 1358:     #  ONE-SPACE form, which matches a LONGER name's row as well and was measured on the sibling.
 1359:     for v in "live" "devsig" "copy lin_a" "rgb chan" "rgb not corrupt" "rgb alive" "rgb samemode" "rgb depth64" "rgb tiled" "rgb tiled64"; do
 1360:         check "sgi_re rgb row: $v" "$(count "$RGBLOG" "^$v  .*ok$")" "1"
 1361:     done
 1362: 
 1363:     #  DENOMINATOR, SUMMED ARITHMETICALLY: a row that stops being emitted at all is otherwise
 1364:     #  invisible -- its named check goes 0, but so does a check for a row that never existed.
 1365:     #  *** THE DENOMINATOR PINNED 8 WHILE THE PROBE EMITTED 9, AND THE ROW LIST NEVER NAMED
 1366:     #  `rgb tiled'.  A pass-3 seat found it by reading the gate against the probe rather than the
 1367:     #  probe against itself. ***  It would have failed LOUDLY -- emitted 9, wanted 8 -- which is the
 1368:     #  safe direction, but it would have shipped, and `rgb tiled' would have been unchecked BY NAME
 1369:     #  while appearing in the count.  Both new rows are named above and the pins are 10.
 1370:     check "sgi_re rgb rows emitted" \
 1371:           "$(( $(count "$RGBLOG" " ok$") + $(count "$RGBLOG" " FAIL$") ))" "10"
 1372:     check "sgi_re rgb rows green" "$(count "$RGBLOG" " ok$")"   "10"
 1373:     check "sgi_re rgb rows red"   "$(count "$RGBLOG" " FAIL$")" "0"
 1374: fi
