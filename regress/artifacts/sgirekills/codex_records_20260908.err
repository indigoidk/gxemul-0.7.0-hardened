    1: #!/usr/bin/env python3
    2: #
    3: #  #497 widthkillclass -- the detector.
    4: #
    5: #  CONTRACT (vacuity-floor clause (e)) -- which edits this detector is designed
    6: #  to catch, and which it is NOT:
    7: #
    8: #    CATCHES
    9: #      * removal or reinstatement of ANY of the six width kills, at any one of
   10: #        the six sites individually (the `sw surv' rows are per site);
   11: #      * narrowing the decline so it applies to writes only, i.e.
   12: #        `len != 8' -> `len != 8 && writeflag == MEM_WRITE'  (the `lw surv' rows);
   13: #      * ANY decline that does not reach the function's common tail -- an early
   14: #        `return', or `return 0' (which memory_rw coerces to -1 and turns into a
   15: #        guest EXCEPTION_DBE).  The `lw surv' rows check the VALUE the declined
   16: #        read returns, not merely that the host survived: the destination
   17: #        register is preset to a sentinel, so "tail ran, wrote 0" and "load
   18: #        never completed" are distinguishable.  A survival-only oracle at a
   19: #        refusal-effect site is vacuous by construction, and this row was one
   20: #        until the d_returnzero mutant was built;
   21: #      * deleting the latch, or dropping the `d->warned |= BIT' set, so the
   22: #        message floods  (the `sw lat1' rows COUNT; they do not test presence);
   23: #      * making two or more sites share a latch bit  (`xsite 6msg');
   24: #      * mis-attributing a window's message to another window (`xsite order');
   25: #      * growth of the width predicate that swallows LEGAL 8-byte accesses
   26: #        (the `accept' rows, probed at an offset with bit 3 SET so that a
   27: #        `|| (relative_addr & 8)' tightening reddens them);
   28: #      * silent removal of the six READ kills or of the final catch-all, which
   29: #        this round deliberately does NOT touch  (`<s> ld kill' x6, `other kill').
   30: #
   31: #    *** THE TWO PARAGRAPHS ABOVE ARE #497's AND #499's AND ARE NO LONGER TRUE OF THIS
   32: #        FILE.  #513 REMOVED ALL SIX READ KILLS -- five arms became ACCEPTs and
   33: #        CRIME_RE_TEX became a latched decline -- so `<s> ld kill' x6 NO LONGER EXIST
   34: #        as row names, and an 8-byte `ld' to those windows no longer ends the host.
   35: #        The contract below is the LIVE one; the text above is kept, with this
   36: #        correction beside it, because a reader arriving from #497's or #499's records
   37: #        needs to see which half moved and when.  Found by the pass-2 panel, which read
   38: #        the contract against the diff and reported it stale. ***
   39: #
   40: #    *** AND IT PINS THE ROUND'S CENTRAL DISCLOSURE, RATHER THAN ASSERTING IT.
   41: #        The width guard is evaluated FIRST, so after #497 a 4-byte read
   42: #        DECLINES -- but an ordinary 8-byte `ld' to each of the six windows
   43: #        STILL ENDS THE HOST, because len == 8 passes the width guard and falls
   44: #        into the read arm's exit(1) (dev_sgi_re.c lines 245 262 279 296 346
   45: #        362).  Fixing six width kills leaves EXACTLY six read kills at the same
   46: #        six offsets.  The `<s> ld kill' rows measure that at every window, so a
   47: #        future reader cannot conclude from `lw surv' that reads were made safe.
   48: #        Filed as sgirekills.  *** ITS WITNESS IS THIS FILE: the six `<site> ld kill`
   49: #        rows below ARE rung-3 symptom demonstrations of that defect, and the ledger's
   50: #        witness field names them.  This comment used to say the row `has no witness
   51: #        yet' -- written before those rows existed and left standing after they shipped,
   52: #        so the file denied being the witness it had become.  Found by the codex seat. ***
   53: #
   54: #    DOES NOT CATCH
   55: #      * anything in DEVICE_ACCESS(sgi_de) or (sgi_mte), including sgi_de's own
   56: #        width kill (accept set {4,8}, filed sgidewidth) and sgi_mte's
   57: #        unreachable one (filed sgimtewidth);
   58: #      * the LINEAR out-of-bounds index itself.  Observing re_linear_b[0] being
   59: #        clobbered needs a READ path, and every read arm here still exit(1)s.
   60: #        The aliasing is pinned by offsetof in PRETABLE.out section 1.2, not by
   61: #        a row.  Owed to sgirekills.
   62: #
   63: #    ONE THING THE CONTRACT UNDERSTATED, corrected before shipping rather than
   64: #    left as a modest-sounding false claim: an earlier draft said there is NO
   65: #    anchored cell-position row.  There is.  Each `accept' row matches the arm's
   66: #    own debug() text INCLUDING THE INDEX AND THE VALUE -- e.g.
   67: #    "d->re_tlb_a[4] = 0x1122" -- so it is anchored to a SPECIFIC cell by a
   68: #    channel outside the decode under test, which is clause (f)'s requirement.
   69: #    A re-map of the index arithmetic (>> 1 -> >> 2) or of the byte packing
   70: #    reddens it.  Window-level translations are additionally caught by the
   71: #    per-site attribution rows, since each checks the message naming ITS OWN
   72: #    symbol.  What remains genuinely uncovered is a re-map that preserves both
   73: #    index and symbol.
   74: #
   75: import os, pty, re, select, sys, time
   76: 
   77: BIN   = sys.argv[1]
   78: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
   79: DUMMY = "/tmp/dummy497.bin"
   80: if not os.path.exists(DUMMY):
   81:     with open(DUMMY, "wb") as f:
   82:         f.write(b"\0" * 16)
   83: 
   84: CODE        = 0x80001000
   85: SCRATCH_RAM = 0xa0001800
   86: LIVE_VAL    = 0x12345678
   87: DE_BASE     = 0xb5002000          # DEVICE_ACCESS(sgi_de); a BYTE access fires DE_LEN
   88: DE_STATUS   = 0xb5004000
   89: DE_STAT_VAL = "0x1e000000"
   90: OUTSIDE     = 0xb5001800          # past LINEAR_B -> the final else (straggler)
   91: ACC_VAL     = "0x1122334455667788"
   92: 
   93: #  *** THE RE-PIN VALUES (sgirekills).  VAL_HI differs from VAL_LO in every
   94: #  halfword lane.
   95: #
   96: #  AN EARLIER WORDING CALLED THAT "the point of having two", claiming a single
   97: #  value, or two sharing any lane, "would let such an edit through".  THAT
   98: #  OVERCLAIMED, and the pass-2 panel caught it: VAL_LO ALONE already has four
   99: #  DISTINCT halfwords (1122 3344 5566 7788), so it by itself reddens under a
  100: #  pure read-side lane permutation or duplication -- M11_lanerev reds the lo
  101: #  row as well as the hi one, which is the measurement that settles it.
  102: #
  103: #  What the SECOND value actually buys is narrower and still worth having: two
  104: #  rows cannot both be satisfied by a mutant returning one fixed constant, and
  105: #  the hi row exercises the window's LAST SLOT -- which is what M4 and M7
  106: #  measured, and neither is a lane property at all. ***
  107: VAL_LO      = 0x1122334455667788
  108: VAL_HI      = 0xa1b2c3d4e5f60718
  109: 
  110: #  Each ACCEPT window gets TWO rows: one at the window BASE and one at its LAST
  111: #  8-byte slot.  #499 measured on THIS DEVICE that one row per arm cannot do the
  112: #  job -- an accept row written at a base tests the near bound twice and the far
  113: #  bound never, and moving it to the top merely swaps which bound is blind.
  114: #
  115: #         nm          base          array          lo_off  lo_i  hi_off  hi_i  kind
  116: REPIN = [
  117:  ("tlb_a",    0xb5001000, "re_tlb_a",    0x000, 0, 0x1f8, 252, "hw"),
  118:  ("tlb_b",    0xb5001200, "re_tlb_b",    0x000, 0, 0x1f8, 252, "hw"),
  119:  ("tlb_c",    0xb5001400, "re_tlb_c",    0x000, 0, 0x1f8, 252, "hw"),
  120:  ("linear_a", 0xb5001700, "re_linear_a", 0x000, 0, 0x078,  30, "w"),
  121:  ("linear_b", 0xb5001780, "re_linear_b", 0x000, 0, 0x078,  30, "w"),
  122: ]
  123: 
  124: TEX_BASE    = 0xb5001600
  125: TEX_HI_OFF  = 0x0d8               # the last 8-byte slot inside CRIME_RE_TEX + 0xe0
  126: TEX_RD_DECL = "unimplemented read from CRIME_RE_TEX -- declined."
  127: 
  128: def anchor(arr, idx, val, kind):
  129:     """*** THE ANCHOR CHANNEL, clause (f). ***  The store's OWN debug() names the
  130:     INDEX it wrote, so this literal pins WHICH CELL the address resolved to --
  131:     not merely that some cell round-tripped.  A translation that slides the whole
  132:     window keeps every value distinct and still reddens here.  Nothing is added to
  133:     the READ path to make this work: the channel already exists on the write."""
  134:     if kind == "hw":
  135:         return "d->%s[%i] = 0x%04x" % (arr, idx, (val >> 48) & 0xffff)
  136:     return "[ d->%s[%i] = 0x%08x, [%i] = 0x%08x ]" % (
  137:         arr, idx, (val >> 32) & 0xffffffff, idx + 1, val & 0xffffffff)
  138: 
  139: #            name        base          symbol               accept-probe text
  140: SITES = [
  141:  ("tlb_a",    0xb5001000, "CRIME_RE_TLB_A",    "d->re_tlb_a[4] = 0x1122"),
  142:  ("tlb_b",    0xb5001200, "CRIME_RE_TLB_B",    "d->re_tlb_b[4] = 0x1122"),
  143:  ("tlb_c",    0xb5001400, "CRIME_RE_TLB_C",    "d->re_tlb_c[4] = 0x1122"),
  144:  ("tex",      0xb5001600, "CRIME_RE_TEX",      "d->re_tex[1] = 0x1122"),
  145:  ("linear_a", 0xb5001700, "CRIME_RE_LINEAR_A",
  146:               "d->re_linear_a[2] = 0x11223344, [3] = 0x55667788"),
  147:  ("linear_b", 0xb5001780, "CRIME_RE_LINEAR_B",
  148:               "d->re_linear_b[2] = 0x11223344, [3] = 0x55667788"),
  149: ]
  150: 
  151: def decl(sym):
  152:     """The literal a WIDTH decline emits.  Deliberately includes ' -- declined.'
  153:     so it cannot also match the read kill's 'TODO: read from <sym>'."""
  154:     return "for " + sym + " -- declined."
  155: 
  156: OP_NOP      = 0x00000000
  157: OP_B_SELF   = 0x1000ffff
  158: OP_SB_T0_A3 = 0xa0e80000          # sb   $t0, 0($a3)   -- narrow, fires a _LEN latch
  159: OP_SW_T0_A3 = 0xace80000          # sw   $t0, 0($a3)
  160: OP_SD_T0_A3 = 0xfce80000          # sd   $t0, 0($a3)
  161: OP_LW_V0_AT = 0x8c220000          # lw   $v0, 0($at)
  162: OP_LD_V0_AT = 0xdc220000          # ld   $v0, 0($at)
  163: 
  164: rows = []
  165: def row(name, got, want, note=""):
  166:     ok = (got == want)
  167:     rows.append((name, ok))
  168:     print("%-18s %-12s %-12s %-46s %s" % (name, str(got), str(want), note,
  169:                                           "ok" if ok else "FAIL"))
  170:     return ok
  171: 
  172: def session(cmds, settle=1.5, spin=1.2):
  173:     pid, fd = pty.fork()
  174:     if pid == 0:
  175:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
  176:                        "0x80001000:" + DUMMY])
  177:         os._exit(127)
  178:     buf = ""
  179:     def rd(t):
  180:         nonlocal buf
  181:         end = time.time() + t
  182:         while time.time() < end:
  183:             r, _, _ = select.select([fd], [], [], 0.1)
  184:             if not r:
  185:                 continue
  186:             try:
  187:                 d = os.read(fd, 65536)
  188:                 if not d:
  189:                     return False
  190:                 buf += d.decode("latin-1", "replace")
  191:             except OSError:
  192:                 return False
  193:         return True
  194:     alive = rd(settle)
  195:     for i, c in enumerate(cmds):
  196:         try:
  197:             os.write(fd, (c + "\n").encode("latin-1"))
  198:         except OSError:
  199:             alive = False
  200:             break
  201:         if not rd(spin if i == len(cmds) - 1 else 0.25):
  202:             alive = False
  203:             break
  204:     try:
  205:         os.write(fd, b"quit\n"); rd(0.4)
  206:     except OSError:
  207:         pass
  208:     try:
  209:         os.close(fd)
  210:     except OSError:
  211:         pass
  212:     how = "nostatus"
  213:     try:
  214:         _, stat = os.waitpid(pid, 0)
  215:         if os.WIFSIGNALED(stat):
  216:             how = "sig%d" % os.WTERMSIG(stat)
  217:         elif os.WIFEXITED(stat):
  218:             how = "exit%d" % os.WEXITSTATUS(stat)
  219:     except OSError:
  220:         pass
  221:     return buf.replace("\r", ""), alive, how
  222: 
  223: def printed(t, reg):
  224:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  225:     if not m:
  226:         return "absent"
  227:     #  Normalise width: a 64-bit register may print sign/zero-extended, and a
  228:     #  row comparing raw strings would then fail on formatting rather than on
  229:     #  behaviour.
  230:     return "0x%x" % int(m.group(1), 16)
  231: 
  232: class Addr(object):
  233:     def __init__(self, base): self.a = base
  234:     def take(self, n):
  235:         got = self.a; self.a += 4 * (n + 2) + 0x20; return got
  236: 
  237: def run_ops(ops, at):
  238:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
  239:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
  240:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
  241:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
  242: 
  243: def store(A, addr, op=OP_SW_T0_A3, val="0x12345678"):
  244:     return ["a3=0x%x" % addr, "t0=%s" % val] + run_ops([op], A.take(1))
  245: 
  246: #  THE DESTINATION REGISTER IS PRESET TO A SENTINEL, NOT TO 0.
  247: #  Preset to 0 the row cannot tell "the common tail ran and wrote odata (0)"
  248: #  from "the load never completed at all" -- both leave v0 == 0.  With a
  249: #  sentinel the two separate: a declined read that reaches the tail yields 0,
  250: #  and a read that faulted or never landed yields the sentinel.
  251: SENTINEL = 0xdeadbeef
  252: 
  253: def load(A, addr, op=OP_LW_V0_AT):
  254:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
  255: 
  256: print("#497 widthkillclass DETECTOR -- binary=%s label=%s" % (BIN, LABEL))
  257: print("%-18s %-12s %-12s %-46s %s" % ("row", "got", "want", "note", ""))
  258: 
  259: # ------------------------------------------------ controls / identity  (c)
  260: A = Addr(CODE)
  261: t, alive, how = session(store(A, SCRATCH_RAM) + load(A, SCRATCH_RAM)
  262:                         + ["print v0"])
  263: row("live", printed(t, "v0") if alive else "died", "0x%x" % LIVE_VAL,
  264:     "LIVENESS: guest store then load, through RAM")
  265: 
  266: #  *** THE 64-BIT LIVENESS CONTROL, AND IT IS NOT DECORATION. ***  Every re-pinned
  267: #  ACCEPT row below asserts a 64-bit value read back through `print v0'.  On the
  268: #  COMMITTED build all of those rows DIE at the load, so a pre-fix run cannot tell
  269: #  a correct want-string from a mis-formatted one -- the red is explained by the
  270: #  kill either way.  This row exercises the identical sd/ld/print path through RAM,
  271: #  where nothing kills, so the format is pinned BEFORE the fix rather than after.
  272: A = Addr(CODE)
  273: t, alive, how = session(store(A, SCRATCH_RAM, OP_SD_T0_A3, "0x%016x" % VAL_LO)
  274:                         + load(A, SCRATCH_RAM, OP_LD_V0_AT) + ["print v0"])
  275: row("live64", printed(t, "v0") if alive else "died", "0x%x" % VAL_LO,
  276:     "LIVENESS: 64-bit sd/ld through RAM -- pins the re-pin want format")
  277: 
  278: A = Addr(CODE)
  279: t, alive, how = session(load(A, DE_STATUS) + ["print v0"])
  280: row("devsig stat", printed(t, "v0") if alive else "died", DE_STAT_VAL,
  281:     "DEVSIG: CRIME_DE_STATUS reads 0x1e000000; RAM would read 0")
  282: 
  283: print("OPUS497T_CONTROL=%s" % ("OK" if all(o for _, o in rows) else "DEAD"))
  284: print("")
  285: 
  286: # ------------------------------------------------ per site x 6
  287: for nm, base, sym, acctext in SITES:
  288:     lit = decl(sym)
  289: 
  290:     # 1. a len=4 WRITE must be DECLINED, not fatal
  291:     A = Addr(CODE)
  292:     t, alive, how = session(store(A, base))
  293:     row(nm + " sw surv", how, "exit0", "len=4 WRITE declined, host survives")
  294: 
  295:     # 2. the latch: TWO declined accesses in ONE session -> exactly ONE message
  296:     A = Addr(CODE)
  297:     t, alive, how = session(store(A, base) + store(A, base + 4))
  298:     row(nm + " sw lat1", t.count(lit), 1,
  299:         "(once): COUNT over 2 accesses -- presence would pass unlatched")
  300: 
  301:     # 3. a len=4 READ must ALSO be declined.
  302:     #    NOTE: the width arm is evaluated BEFORE the read arm, so a len=4 read
  303:     #    takes the (now declining) width arm and never reaches the still-live
  304:     #    read kill.  An 8-byte read still dies -- see `ld readkill' below.
  305:     #    This row is what kills M1 (`len != 8 && writeflag == MEM_WRITE').
  306:     A = Addr(CODE)
  307:     t, alive, how = session(load(A, base) + ["print v0"])
  308:     got = how + "/" + (printed(t, "v0") if alive else "died")
  309:     row(nm + " lw surv", got, "exit0/0x0",
  310:         "declined READ reaches the tail and returns a DEFINED 0")
  311: 
  312:     # 4. ACCEPT side (de-escalation clause).  Offset +8 has bit 3 SET on
  313:     #    purpose: a `|| (relative_addr & 8)' growth must redden this.
  314:     A = Addr(CODE)
  315:     t, alive, how = session(store(A, base + 8, OP_SD_T0_A3, ACC_VAL))
  316:     row(nm + " accept", "1" if acctext in t else "0", "1",
  317:         "LEGAL len=8 write still lands (probed at +8, bit 3 set)")
  318: 
  319: # ------------------------------------------------ cross-site  (M2 + anchor)
  320: A = Addr(CODE)
  321: cmds = []
  322: for nm, base, sym, _a in SITES:
  323:     cmds += store(A, base)
  324: t, alive, how = session(cmds, spin=2.0)
  325: present = [decl(sym) for _n, _b, sym, _a in SITES]
  326: n_present = sum(1 for lit in present if t.count(lit) == 1)
  327: row("xsite 6msg", n_present, 6,
  328:     "six windows, ONE session: 6 distinct latches (kills bit collision)")
  329: 
  330: pos = [t.find(lit) for lit in present]
  331: ordered = all(p >= 0 for p in pos) and pos == sorted(pos)
  332: row("xsite order", "1" if ordered else "0", "1",
  333:     "ANCHOR: message order == the order the guest issued them")
  334: 
  335: # ------------------------------------------------ the read arms  (sgirekills)
  336: #
  337: #  *** RE-PINNED FOR sgirekills.  SIX DEATH-ONLY ROWS BECOME FOURTEEN. ***
  338: #
  339: #  THE OLD ROWS were `row(nm + " ld kill", how + txt, "exit1+txt")' -- they asserted
  340: #  that a len == 8 READ still ends the host at each of the six windows.  That was a
  341: #  true and useful pin while the kills stood.  It cannot survive the fix, which is
  342: #  exactly the situation the oracle-correction rule governs: the rows are re-pinned
  343: #  FIRST and the committed build is measured RED under the new expectations, and only
  344: #  then is the device edited.  Same script, opposite colour.
  345: #
  346: #  *** WHAT REPLACED THEM, AND WHY IT IS NOT THE OBVIOUS SET. ***  My first design was
  347: #  one row per window at the window BASE, plus a #499-style decline row for TEX.  The
  348: #  design panel refused it with two floor-shaped holes and one oracle this file had
  349: #  already measured wrong:
  350: #
  351: #    (1) THE FAR BOUND WAS UNPINNED.  An accept row at a window's base tests the near
  352: #        bound twice and the far bound never -- so a shrink of the window's upper limit
  353: #        is invisible to it.  #499 measured that on this same device.  Hence TWO rows
  354: #        per ACCEPT arm, base and LAST SLOT.
  355: #
  356: #    (2) A LOAD-ONLY TEX DECLINE ROW WOULD HAVE BEEN VACUOUS, and this is the sharp one.
  357: #        Such a row wants `v0 == 0'.  If a later round converts TEX to an ACCEPT, it will
  358: #        read back the ZEROED array and yield 0 as well -- so the row could not redden at
  359: #        the very edit it exists to catch.  The TEX rows therefore STORE a non-zero value
  360: #        first: an ACCEPT would return it, and the row goes red.
  361: #
  362: #    (3) `how == "exit0"' IS THE WRONG ORACLE and #499 measured why -- an exit(0)
  363: #        reinstatement prints its message and then dies, scoring green with the process
  364: #        dead.  No row below reads exit status.  SURVIVAL IS IMPLIED BY THE VALUE:
  365: #        a dead session cannot print one.
  366: #
  367: for nm, base, arr, lo_off, lo_i, hi_off, hi_i, kind in REPIN:
  368:     for tag, off, idx, val in (("lo", lo_off, lo_i, VAL_LO),
  369:                                ("hi", hi_off, hi_i, VAL_HI)):
  370:         A = Addr(CODE)
  371:         addr = base + off
  372:         t, alive, how = session(store(A, addr, OP_SD_T0_A3, "0x%016x" % val)
  373:                                 + load(A, addr, OP_LD_V0_AT) + ["print v0"])
  374:         anc = anchor(arr, idx, val, kind)
  375:         got = (printed(t, "v0") if alive else "died") + ("+anc" if anc in t else "-anc")
  376:         row("%s ld %s" % (nm, tag), got, "0x%x+anc" % val,
  377:             "ACCEPT %s[%i]: value round-trips AND the store names the cell" % (arr, idx))
  378: 
  379: #  *** TEX IS THE ONE ARM THAT IS NOT AN ACCEPT. ***  The other five windows have a
  380: #  write path that already computes and stores the value, so reading it back is the
  381: #  ACCEPT member of the option set.  TEX's read is DECLINED instead, and these four
  382: #  rows pin the decline rather than a value -- with the store-first shape from (2)
  383: #  above, so a future ACCEPT of TEX reddens them instead of sliding past.
  384: for tag, off in (("lo", 0x000), ("hi", TEX_HI_OFF)):
  385:     A = Addr(CODE)
  386:     addr = TEX_BASE + off
  387:     val = VAL_LO if tag == "lo" else VAL_HI
  388:     t, alive, how = session(store(A, addr, OP_SD_T0_A3, "0x%016x" % val)
  389:                             + load(A, addr, OP_LD_V0_AT) + ["print v0"])
  390:     got = (printed(t, "v0") if alive else "died")
  391:     got += "+1msg" if t.count(TEX_RD_DECL) == 1 else "+%imsg" % t.count(TEX_RD_DECL)
  392:     row("tex ld " + tag, got, "0x0+1msg",
  393:         "DECLINE: reads 0 after a real store -- an ACCEPT would return the store")
  394: 
  395: #  THE LATCH: one announce per instance, not one per access.  Two reads at DIFFERENT
  396: #  offsets, so a latch keyed on the address rather than on the arm also reddens.
  397: A = Addr(CODE)
  398: t, alive, how = session(load(A, TEX_BASE, OP_LD_V0_AT)
  399:                         + load(A, TEX_BASE + TEX_HI_OFF, OP_LD_V0_AT))
  400: row("tex rd lat1", "%i" % t.count(TEX_RD_DECL) if alive else "died", "1",
  401:     "LATCH: two TEX reads at two offsets announce exactly once")
  402: 
  403: #  *** THE CROSS-BIT ROW.  #498 measured a latch shared between two arms scoring 23/25,
  404: #  and #490 measured the same collision in another file, so it is pinned here BEFORE it
  405: #  can bite: fire all SIX width latches -- CRIME_RE_TEX's own included -- with narrow
  406: #  writes, then read TEX.  If the read decline is given an existing bit rather than its
  407: #  own, its message is already suppressed and this row reds. ***
  408: #  *** CLASS CLOSURE ON THE LATCH-COLLISION AXIS -- pass 3. ***
  409: #
  410: #  This row USED TO fire only the six width latches (bits 0-5), and pass 3 showed why that is
  411: #  not enough: the mutation operator is `SGIRE_W_TEX_RD := <an already-used bit>' ON THE EDITED
  412: #  LINE, so bits 6, 7, 9 and 10 were the SAME operator on the SAME line and swept by nothing.
  413: #  Pass 2 found the bit-8 cell; pass 3 found the rest.  TWO CONSECUTIVE PASSES FINDING ONE CLASS
  414: #  is the trigger for closing the whole space in one diff rather than one cell per pass.
  415: #
  416: #      bit  latch              fired here by
  417: #      ---  -----------------  ---------------------------------------------------------
  418: #       0-5 *_LEN x6           a narrow (byte) store to each of the six RE windows
  419: #       6   SGIRE_W_DE_LEN     a BYTE store to the DE window -- its accept set is {4,8}
  420: #       7   SGIRE_W_UNMAP_WR   a store to OUTSIDE
  421: #       8   SGIRE_W_UNMAP_RD   a load  from OUTSIDE
  422: #       9   SGIRE_W_PRIM_OP    *** NOT FIRED HERE -- see the contract note below ***
  423: #      10   SGIRE_W_BADMODE    *** NOT FIRED HERE -- see the contract note below ***
  424: #
  425: #  *** DELIBERATELY NOT COVERED, with the reason and the settling fact, per the class-closure
  426: #  amendment: bits 9 and 10 are set only from the DRAWING-ENGINE path (draw_primitive's
  427: #  unimplemented-op arm and horrible_getputpixel's unimplemented-mode arm).  Firing them needs
  428: #  the DE programmed and triggered, which is a different probe's machinery
  429: #  (sgi_re_randompixel_probe.py drives it).  A TEX-read session never enters that path, so the
  430: #  collision requires a guest that BOTH draws AND reads TEX.  Settling fact: whether a DE-driving
  431: #  session can also issue a TEX read in the same instance. ***
  432: A = Addr(CODE)
  433: cmds = []
  434: for _nm, _b, _sym, _a in SITES:
  435:     cmds += store(A, _b, OP_SB_T0_A3, "0x1")          # bits 0-5
  436: cmds += store(A, DE_BASE, OP_SB_T0_A3, "0x1")         # bit 6
  437: cmds += store(A, OUTSIDE, OP_SB_T0_A3, "0x1")         # bit 7
  438: cmds += load(A, OUTSIDE, OP_LW_V0_AT)                 # bit 8
  439: cmds += load(A, TEX_BASE, OP_LD_V0_AT)
  440: t, alive, how = session(cmds, spin=3.0)
  441: row("tex xbit", "%i" % t.count(TEX_RD_DECL) if alive else "died", "1",
  442:     "CROSSBIT: latch bits 0-8 all fired first; TEX read still announces once")
  443: 
  444: A = Addr(CODE)
  445: #  *** RE-PINNED BY #499, WHICH REMOVED THIS KILL.  Three channels replace one, and
  446: #  BOTH of the obvious oracles were measured VACUOUS before this one was chosen. ***
  447: #
  448: #  THE OLD ROW was `row("other kill", how, "exit1")' -- DEATH-ONLY.  It observed THAT
  449: #  the catch-all killed, never WHICH kill it was, so a change to the message that left
  450: #  exit(1) standing passed: MEASURED 35/35 against a matched control at 34/35.  Filed
  451: #  as `otherkilldeath', and its own note prescribed the repair used here.
  452: #
  453: #  THE OBVIOUS RE-PIN, `how == "exit0"', IS WORSE, and this is the part that had to be
  454: #  built rather than argued.  A one-token reinstatement of the death as exit(0) prints
  455: #  the announce and then dies; exit status CANNOT distinguish "declined, then quit"
  456: #  from "died with status 0".  MEASURED, variant `mexit0': the exit0+txt oracle scores
  457: #  GREEN (how=exit0, txt=True) while alive=False.  Filed as `exit0oracle'.
  458: #
  459: #  SO THE ROW PINS THREE THINGS:
  460: #    how    the host survives the declined WRITE;
  461: #    txt    ONE CONTIGUOUS literal, address and data field included.  Two independent
  462: #           substring tests are a weaker claim: "-- declined." is emitted by the six
  463: #           #497 width declines and by #498's sgi_de decline as well, and this probe's
  464: #           own decl() helper exists because a bare substring cross-matches;
  465: #    v0     a declined READ REACHES THE COMMON TAIL and lands a DEFINED 0.  v0 is
  466: #           preset to SENTINEL by load(), so "wrote odata (0)" and "never landed" are
  467: #           distinguishable -- the same reason the `lw surv' rows carry it.  This is
  468: #           what kills `mret0' (return 0 -> memory_rw.c coerces to -1 -> EXCEPTION_DBE)
  469: #           and `mrdexit0' (exit(0) in the READ branch only), neither of which any
  470: #           write-only oracle can see.
  471: #
  472: #  ORDER PROOF: the new oracle was measured RED on the COMMITTED pre-#499 build BEFORE
  473: #  the code changed -- table500b.out, variant `base', got=exit1/notxt/died against
  474: #  want=exit0/txt/0x0.  And it is not fitted to the fix either: it was PRE-REGISTERED
  475: #  by #497 in commit 112867a (2026-08-30 22:41), six hours before #499's baseline
  476: #  3ded1e8, in the very note this comment replaces.
  477: #
  478: #  CONTRACT -- so a later escape is a breach or an exclusion, not an argument.  This
  479: #  row covers the catch-all's WRITE announce and the READ tail-return.  It does NOT
  480: #  pin the LATCH (one access per direction here, so first == only) nor the READ
  481: #  announce text.  Those live in sgi_re_unmapped_probe.py (`wr lat1', `rd lat1',
  482: #  `rd decl'), WHICH MUST BE GATE-WIRED -- unwired, that coverage exists nowhere. ***
  483: DECL_W = ("unimplemented write to address 0x1800, "
  484:           "data=0x0000000012345678 -- declined.  (once) ]")
  485: t, alive, how = session(store(A, OUTSIDE) + load(A, OUTSIDE) + ["print v0"])
  486: got = "%s/%s/%s" % (how, "txt" if t.count(DECL_W) == 1 else "notxt",
  487:                    printed(t, "v0") if alive else "died")
  488: row("other decl", got, "exit0/txt/0x0",
  489:     "#499: declines, announces once, declined read lands a defined 0")
  490: 
  491: #  *** L2 -- A FLOOR BREACH FOUND BY THE PASS-2 PANEL, REPAIRED IN-ROUND. ***
  492: #
  493: #  Clause (d)'s DEPENDS-ON closure includes `d->warned', and `tex xbit' sweeps the six
  494: #  *_LEN bits only.  The panel named the escape and predicted its score: give the TEX
  495: #  read decline an ALREADY-USED NON-LEN bit --
  496: #
  497: #      SGIRE_W_TEX_RD = 1 << 11   ->   1 << 8   (= SGIRE_W_UNMAP_RD)
  498: #
  499: #  -- and the 44-row detector scores a CLEAN SWEEP, because its four TEX-read scenarios
  500: #  and its unmapped-read scenario NEVER SHARE AN EMULATOR INSTANCE.  `tex xbit' sets bits
  501: #  0-5, so bit 8 is clear in every session that reads TEX.  M10 established detection of a
  502: #  WIDTH-bit collision, not of every existing-bit collision.
  503: #
  504: #  The repair is a SAME-INSTANCE sequence in BOTH orderings: whichever announce fires
  505: #  first must not suppress the other.  One ordering alone would leave the mirror open --
  506: #  the `#499' shape, where a repair closes the cell the mutant used and leaves its twin.
  507: DECL_R = "unimplemented read from address 0x1800 -- declined.  (once) ]"
  508: 
  509: for nm, first, second in (("tex/unmap", TEX_BASE, OUTSIDE),
  510:                           ("unmap/tex", OUTSIDE, TEX_BASE)):
  511:     A = Addr(CODE)
  512:     t, alive, how = session(load(A, first, OP_LD_V0_AT) + load(A, second, OP_LD_V0_AT))
  513:     got = "%i/%i" % (t.count(TEX_RD_DECL), t.count(DECL_R)) if alive else "died"
  514:     row(nm, got, "1/1",
  515:         "LATCH INDEPENDENCE: both announces fire in ONE instance, either order")
  516: 
  517: ok = sum(1 for _, o in rows if o)
  518: print("")
  519: print("OPUS497T_RESULT=%d/%d" % (ok, len(rows)))
  520: print("OPUS497T_LABEL=%s" % LABEL)
  521: print("OPUS497T_DONE")

