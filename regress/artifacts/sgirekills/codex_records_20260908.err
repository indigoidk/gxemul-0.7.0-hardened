import ast, hashlib, pathlib, re
p=pathlib.Path('regress/sgi_re_width_probe.py')
data=p.read_bytes()
source=data.decode()
module=ast.parse(source)
store_fn=next(n for n in module.body if isinstance(n,ast.FunctionDef) and n.name=='store')
print('Store parameter order:', [arg.arg for arg in store_fn.args.args])
for node in ast.walk(module):
    if isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id=='store' and 453 <= node.lineno <= 463:
        print('Line',node.lineno,'positional arguments:',len(node.args),'third argument binds to op; explicit val provided:',len(node.args)>3 or any(kw.arg=='val' for kw in node.keywords))
names=[]
bindings={}
def literal(node, env):
    if isinstance(node,ast.Constant): return node.value
    if isinstance(node,ast.Name): return env[node.id]
    if isinstance(node,(ast.List,ast.Tuple)):
        values=[literal(x,env) for x in node.elts]
        return tuple(values) if isinstance(node,ast.Tuple) else values
    if isinstance(node,ast.BinOp):
        a,b=literal(node.left,env),literal(node.right,env)
        if isinstance(node.op,ast.Add): return a+b
        if isinstance(node.op,ast.Mod): return a%b
    raise ValueError()
def assign(node,value,env):
    if isinstance(node,ast.Name): env[node.id]=value
    elif isinstance(node,(ast.Tuple,ast.List)):
        for key,item in zip(node.elts,value): assign(key,item,env)
    else: raise ValueError()
def inspect_nodes(nodes,env):
    for node in nodes:
        if isinstance(node,ast.Assign):
            try:
                value=literal(node.value,env)
                for target in node.targets: assign(target,value,env)
            except (KeyError,ValueError,TypeError): pass
        elif isinstance(node,ast.For):
            for value in literal(node.iter,env):
                assign(node.target,value,env)
                inspect_nodes(node.body,env)
        elif isinstance(node,ast.Expr) and isinstance(node.value,ast.Call):
            call=node.value
            if isinstance(call.func,ast.Name) and call.func.id=='row': names.append(literal(call.args[0],env))
inspect_nodes(module.body,bindings)
gate=pathlib.Path('regress/gate_arm.sh').read_text()
block=gate.split('SGILOG="'$LOGDIR/sgi_re_width.log'"',1)[1].split('UNMLOG="'$LOGDIR/sgi_re_unmapped.log'"',1)[0]
gate_names=re.findall(r'\"(["'^"]+)"'"',re.search(r'for v in (.*?); do',block,re.S).group(1))
print('Static declared row count:',len(names),'unique:',len(set(names)))
print('Gate row count:',len(gate_names),'unique:',len(set(gate_names)))
print('Name sets match:',set(names)==set(gate_names))
rendered=['%-18s %-12s %-12s %-46s %s'%(name,'value','value','note','ok') for name in names]
print('All named patterns match exactly one formatted row:',all(sum(bool(re.search('"'^'"'+name+'  .*ok"'$'"',line)) for line in rendered)==1 for name in gate_names))
print('Reviewed probe SHA256:',hashlib.sha256(data).hexdigest())
