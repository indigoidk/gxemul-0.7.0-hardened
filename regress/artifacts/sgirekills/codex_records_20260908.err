 1419:         check "pcc2 width row: $v" "$(count "$PCC2LOG" "^$v  .*ok$")" "1"
 1420:     done
 1421: 
 1422:     #  DENOMINATOR, SUMMED -- a lost row and a failing row need different responses.
 1423:     check "pcc2 width rows emitted"           "$(( $(count "$PCC2LOG" " ok$") + $(count "$PCC2LOG" " FAIL$") ))" "251"
 1424:     check "pcc2 width rows green" "$(count "$PCC2LOG" " ok$")"   "251"
 1425:     check "pcc2 width rows red"   "$(count "$PCC2LOG" " FAIL$")" "0"
