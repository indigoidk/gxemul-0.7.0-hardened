  292:     t, alive, how = session(store(A, base))
  293:     row(nm + " sw surv", how, "exit0", "len=4 WRITE declined, host survives")
  294: 
  295:     # 2. the latch: TWO declined accesses in ONE session -> exactly ONE message
  296:     A = Addr(CODE)
  297:     t, alive, how = session(store(A, base) + store(A, base + 4))
  298:     row(nm + " sw lat1", t.count(lit), 1,
  299:         "(once): COUNT over 2 accesses -- presence would pass unlatched")
  300: 
  301:     # 3. a len=4 READ must ALSO be declined.
  302:     #    NOTE: the width arm is evaluated BEFORE the read arm, so a len=4 read
  303:     #    takes the (now declining) width arm and never reaches the still-live
  304:     #    read kill.  An 8-byte read still dies -- see `ld readkill' below.
  305:     #    This row is what kills M1 (`len != 8 && writeflag == MEM_WRITE').
  306:     A = Addr(CODE)
  307:     t, alive, how = session(load(A, base) + ["print v0"])
  308:     got = how + "/" + (printed(t, "v0") if alive else "died")
  309:     row(nm + " lw surv", got, "exit0/0x0",
  310:         "declined READ reaches the tail and returns a DEFINED 0")
  311: 
  312:     # 4. ACCEPT side (de-escalation clause).  Offset +8 has bit 3 SET on
  313:     #    purpose: a `|| (relative_addr & 8)' growth must redden this.
  314:     A = Addr(CODE)
  315:     t, alive, how = session(store(A, base + 8, OP_SD_T0_A3, ACC_VAL))
  316:     row(nm + " accept", "1" if acctext in t else "0", "1",
  317:         "LEGAL len=8 write still lands (probed at +8, bit 3 set)")
  318: 
  319: # ------------------------------------------------ cross-site  (M2 + anchor)
  320: A = Addr(CODE)

