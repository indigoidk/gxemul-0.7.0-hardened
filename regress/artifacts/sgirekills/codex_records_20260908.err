 1797: 
 1798: DEVICE_ACCESS(sgi_de_status)
 1799: {
 1800: 	// struct sgi_re_data *d = (struct sgi_re_data *) extra;
 1801: 	uint64_t idata = 0, odata = 0;
 1802: 
 1803: 	idata = memory_readmax64(cpu, data, len);
 1804: 
 1805: 	relative_addr += 0x4000;
 1806: 
 1807: 	switch (relative_addr) {
 1808: 
 1809: 	case CRIME_DE_STATUS:	// 0x4000
 1810: 		odata = CRIME_DE_IDLE |
 1811: 			CRIME_DE_SETUP_IDLE |
 1812: 			CRIME_DE_PIXPIPE_IDLE |
 1813: 			CRIME_DE_MTE_IDLE;
 1814: 
 1815: 		/*
 1816: 		 *  TODO: Actually simulate pipeline of a number of commands?
 1817: 		 */
 1818: 		break;
 1819: 
 1820: 	case 0x4008:
 1821: 		/*  Unknown. Ignore for now.  */
 1822: 		break;
 1823: 
 1824: 	default:
 1825: 		if (writeflag == MEM_WRITE)
 1826: 			debug("[ sgi_de_status: unimplemented write to "
 1827: 			    "address 0x%llx, data=0x%016llx ]\n",
 1828: 			    (long long)relative_addr, (long long)idata);
 1829: 		else
 1830: 			debug("[ sgi_de_status: unimplemented read from address"
 1831: 			    " 0x%llx ]\n", (long long)relative_addr);
 1832: 	}
 1833: 
 1834: 	if (writeflag == MEM_READ)
 1835: 		memory_writemax64(cpu, data, len, odata);
 1836: 
 1837: 	return 1;
 1838: }
