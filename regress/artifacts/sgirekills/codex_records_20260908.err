  441: #  (CLASSVERIFY.txt) -- and two seats had called a measured-open cell on the edited line a breach
  442: #  whatever the contract says.  They were right, and the disclosure was answering the wrong
  443: #  question: not "does a TEX session normally draw?" but "CAN one?"  It can, in six stores.
  444: #  The settling fact I had written down as unknown turned out to be one grep away, in a shipped
  445: #  probe that already drives this path.
  446: A = Addr(CODE)
  447: cmds = []
  448: for _nm, _b, _sym, _a in SITES:
  449:     cmds += store(A, _b, OP_SB_T0_A3, "0x1")          # bits 0-5
  450: cmds += store(A, DE_BASE, OP_SB_T0_A3, "0x1")         # bit 6
  451: cmds += store(A, OUTSIDE, OP_SB_T0_A3, "0x1")         # bit 7
  452: cmds += load(A, OUTSIDE, OP_LW_V0_AT)                 # bit 8
  453: #  bit 10 SGIRE_W_BADMODE -- an unimplemented DST MODE driven through a REAL rectangle, so
  454: #  horrible_getputpixel is actually entered.  The vertex pair is (0,0)-(0,3): the HEIGHT is what
  455: #  makes the primitive iterate, which sgi_re_randompixel_probe.py measured and documents.
  456: cmds += store(A, DE_MODE_DST, MODE_LIN_B)
  457: cmds += store(A, DE_DRAWMODE, DRAWMODE)
  458: cmds += store(A, DE_XVERT_0,  0x00000000)
  459: cmds += store(A, DE_XVERT_1,  0x00000003)
  460: cmds += store(A, DE_PRIM_ST,  PRIM_RECT)
  461: #  bit 9 SGIRE_W_PRIM_OP -- an unimplemented drawing OP.  draw_primitive's switch rejects it
  462: #  before any pixel work, so this needs no vertex setup of its own.
  463: cmds += store(A, DE_PRIM_ST,  PRIM_BAD)
  464: cmds += load(A, TEX_BASE, OP_LD_V0_AT)
  465: t, alive, how = session(cmds, spin=4.0)
  466: row("tex xbit", "%i" % t.count(TEX_RD_DECL) if alive else "died", "1",
  467:     "CROSSBIT: ALL ELEVEN other latch bits fired first; TEX read still announces once")
  468: 
  469: A = Addr(CODE)
  470: #  *** RE-PINNED BY #499, WHICH REMOVED THIS KILL.  Three channels replace one, and
  471: #  BOTH of the obvious oracles were measured VACUOUS before this one was chosen. ***
  472: #
  473: #  THE OLD ROW was `row("other kill", how, "exit1")' -- DEATH-ONLY.  It observed THAT
  474: #  the catch-all killed, never WHICH kill it was, so a change to the message that left
  475: #  exit(1) standing passed: MEASURED 35/35 against a matched control at 34/35.  Filed
  476: #  as `otherkilldeath', and its own note prescribed the repair used here.
  477: #
  478: #  THE OBVIOUS RE-PIN, `how == "exit0"', IS WORSE, and this is the part that had to be
  479: #  built rather than argued.  A one-token reinstatement of the death as exit(0) prints
  480: #  the announce and then dies; exit status CANNOT distinguish "declined, then quit"
  481: #  from "died with status 0".  MEASURED, variant `mexit0': the exit0+txt oracle scores
  482: #  GREEN (how=exit0, txt=True) while alive=False.  Filed as `exit0oracle'.
  483: #
  484: #  SO THE ROW PINS THREE THINGS:
  485: #    how    the host survives the declined WRITE;
  486: #    txt    ONE CONTIGUOUS literal, address and data field included.  Two independent
  487: #           substring tests are a weaker claim: "-- declined." is emitted by the six
  488: #           #497 width declines and by #498's sgi_de decline as well, and this probe's
  489: #           own decl() helper exists because a bare substring cross-matches;
  490: #    v0     a declined READ REACHES THE COMMON TAIL and lands a DEFINED 0.  v0 is
  491: #           preset to SENTINEL by load(), so "wrote odata (0)" and "never landed" are
  492: #           distinguishable -- the same reason the `lw surv' rows carry it.  This is
  493: #           what kills `mret0' (return 0 -> memory_rw.c coerces to -1 -> EXCEPTION_DBE)
  494: #           and `mrdexit0' (exit(0) in the READ branch only), neither of which any
  495: #           write-only oracle can see.
  496: #
  497: #  ORDER PROOF: the new oracle was measured RED on the COMMITTED pre-#499 build BEFORE
  498: #  the code changed -- table500b.out, variant `base', got=exit1/notxt/died against
  499: #  want=exit0/txt/0x0.  And it is not fitted to the fix either: it was PRE-REGISTERED
  500: #  by #497 in commit 112867a (2026-08-30 22:41), six hours before #499's baseline
  501: #  3ded1e8, in the very note this comment replaces.
  502: #
  503: #  CONTRACT -- so a later escape is a breach or an exclusion, not an argument.  This
  504: #  row covers the catch-all's WRITE announce and the READ tail-return.  It does NOT
  505: #  pin the LATCH (one access per direction here, so first == only) nor the READ
  506: #  announce text.  Those live in sgi_re_unmapped_probe.py (`wr lat1', `rd lat1',
  507: #  `rd decl'), WHICH MUST BE GATE-WIRED -- unwired, that coverage exists nowhere. ***
  508: DECL_W = ("unimplemented write to address 0x1800, "
  509:           "data=0x0000000012345678 -- declined.  (once) ]")
  510: t, alive, how = session(store(A, OUTSIDE) + load(A, OUTSIDE) + ["print v0"])
  511: got = "%s/%s/%s" % (how, "txt" if t.count(DECL_W) == 1 else "notxt",
  512:                    printed(t, "v0") if alive else "died")
  513: row("other decl", got, "exit0/txt/0x0",
  514:     "#499: declines, announces once, declined read lands a defined 0")
  515: 
  516: #  *** L2 -- A FLOOR BREACH FOUND BY THE PASS-2 PANEL, REPAIRED IN-ROUND. ***
  517: #
  518: #  Clause (d)'s DEPENDS-ON closure includes `d->warned', and `tex xbit' sweeps the six
  519: #  *_LEN bits only.  The panel named the escape and predicted its score: give the TEX
  520: #  read decline an ALREADY-USED NON-LEN bit --
  521: #
  522: #      SGIRE_W_TEX_RD = 1 << 11   ->   1 << 8   (= SGIRE_W_UNMAP_RD)
  523: #
  524: #  -- and the 44-row detector scores a CLEAN SWEEP, because its four TEX-read scenarios
  525: #  and its unmapped-read scenario NEVER SHARE AN EMULATOR INSTANCE.  `tex xbit' sets bits
  526: #  0-5, so bit 8 is clear in every session that reads TEX.  M10 established detection of a
  527: #  WIDTH-bit collision, not of every existing-bit collision.
  528: #
  529: #  The repair is a SAME-INSTANCE sequence in BOTH orderings: whichever announce fires
  530: #  first must not suppress the other.  One ordering alone would leave the mirror open --
  531: #  the `#499' shape, where a repair closes the cell the mutant used and leaves its twin.
  532: DECL_R = "unimplemented read from address 0x1800 -- declined.  (once) ]"
  533: 
  534: for nm, first, second in (("tex/unmap", TEX_BASE, OUTSIDE),
  535:                           ("unmap/tex", OUTSIDE, TEX_BASE)):
  536:     A = Addr(CODE)
  537:     t, alive, how = session(load(A, first, OP_LD_V0_AT) + load(A, second, OP_LD_V0_AT))
  538:     got = "%i/%i" % (t.count(TEX_RD_DECL), t.count(DECL_R)) if alive else "died"
  539:     row(nm, got, "1/1",
  540:         "LATCH INDEPENDENCE: both announces fire in ONE instance, either order")
  541: 
  542: ok = sum(1 for _, o in rows if o)
  543: print("")
  544: print("OPUS497T_RESULT=%d/%d" % (ok, len(rows)))
  545: print("OPUS497T_LABEL=%s" % LABEL)
  546: print("OPUS497T_DONE")

