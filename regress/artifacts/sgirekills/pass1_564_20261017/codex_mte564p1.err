285: def topbyte(s):
286:     if not s.startswith("0x"):
287:         return s
288:     return "0x%02x" % ((int(s, 16) >> 24) & 0xff)
289: 
290: def byte_n(s, n):
291:     """Byte n of the big-endian word, n = 0 at the LOWEST address."""
292:     if not s.startswith("0x"):
293:         return s
294:     return "0x%02x" % ((int(s, 16) >> (8 * (3 - n))) & 0xff)
