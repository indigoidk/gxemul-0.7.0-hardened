156: # ---------------------------------------------------------------- the MTE registers
157: #  CRIME RE base 0xb5000000; CRIME_MTE_* offsets from crmfbreg.h.
158: MTE_MODE       = 0xb5003000
159: MTE_BG         = 0xb5003018
160: MTE_DST0       = 0xb5003030
161: MTE_DST1_START = 0xb5003838       # CRIME_MTE_DST1 0x3038 | CRIME_DE_START 0x0800
162: #  `if (startFlag) do_mte_transfer(cpu, d);' sits at the END of DEVICE_ACCESS(sgi_mte), so any MTE
163: #  write with bit 0x800 in its ADDRESS fires the transfer.  DST1 is written last, with START.
164: 
165: #  dst_tlb = (mode & MTE_MODE_DST_BUF_MASK 0x1c) >> 2  -> MTE_TLB_A = 0
166: #  depth   = 8 << ((mode & 0x300) >> 8)                -> MTE_DEPTH_32 = 2 gives 32
167: #  MTE_MODE_COPY 0x800 CLEAR = fill.  (0x800 here is a MODE bit; the 0x800 in the address is START.)
168: MODE_TILED_FILL = 0x200
169: BG_VAL          = 0x11223344      # four distinct bytes, so dest[0] names which arm ran
170: CI_TOP          = 0x44            # what the DEFECT writes at dest[0]
171: RGBA_TOP        = 0x11            # what a CORRECT RGBA selection writes there
172: PAINT           = 0x99999999      # neither -- liveness only, NOT a tail oracle
173: PAINT_TOP       = 0x99
174: 
175: #  DEPTH IS AN AXIS, NOT A CONSTANT.  Two seats independently showed the six-row witness blind to
176: #  an OVER-REACH mutant: `depth >= 16' fires at 32 (so `fill top' stays green) and is cold at 8
177: #  (so `depth8 top' stays green).  The adjacent DOCUMENTED cell -- 16 -- is what catches it.
178: MODE_D8    = 0x000                # MTE_DEPTH_8  << MTE_DEPTH_SHIFT
179: MODE_D16   = 0x100                # MTE_DEPTH_16 << MTE_DEPTH_SHIFT
180: MODE_D32   = 0x200                # MTE_DEPTH_32 << MTE_DEPTH_SHIFT
181: #  *** FIELD VALUE 3.  The header defines NO MTE_DEPTH_64, but the code computes 8 << 3 = 64 for
182: #  it, and the branch under repair is reachable there.  A row here does NOT assert what 64bpp
183: #  OUGHT to do -- it asserts what this round does NOT CHANGE, exactly like depth8/depth16. ***
184: MODE_D64   = 0x300                # field value 3: undefined by the header, computed as 64
185: MODE_COPY  = 0x800                # MTE_MODE_COPY (a MODE bit; the 0x800 in an ADDRESS is START)
186: MTE_SRC0   = 0xb5003020           # CRIME_MTE_SRC0 0x3020 -- no 0x800, so it does not fire START
187: 
188: #  *** THE FIRST SOURCE BYTE IS DELIBERATELY BELOW 0x80. ***  The RGB and RGBA GET arms compute
189: #  `buf[0] << 24' on a uint8_t, which promotes to signed int -- so a first byte >= 0x80 shifts
190: #  past INT_MAX and is undefined behaviour.  That is a SEPARATE filed defect ([[sgirebufshiftub]],
191: #  re-derived independently by the pass-1 codex seat); this probe must not stand on it, so the
192: #  copy rows use 0x1a as byte 0.  Four distinct bytes, so each names its own position.
193: #  (An earlier draft said "EVERY GET arm".  False, and the pass-2 codex seat caught it: CI shifts
194: #  nothing at all, and ABGR and the default arm shift `buf[3]', not `buf[0]'.  Four of five arms,
195: #  two of them a different byte.  The filed [[sgirebufshiftub]] row's own TITLE carried the same
196: #  overclaim and is corrected there too.)
197: SRC_WORD   = 0x1a2b3c4d
198: SRC_B0     = 0x1a                 # what BOTH correct copy shapes put at dest[0]
199: SRC_B1     = 0x2b                 # what only a REAL RGBA copy puts at dest[1]
200: SRC_B3     = 0x4d                 # the byte RGB DROPS -- the only channel that sees it
201: SRC_PIX_X  = 4                    # src0's x field; /(depth/8) = 1 -> source byte offset 4
202: 
203: RE_TLB_A   = 0xb5001000
204: TLBA_TILE  = 0x8002               # re_tlb_a[0].  BIT 15 IS THE VALID BIT.
205: #  *** THE DESTINATION-LABEL AXIS, added 2026-09-09.  CRIME_RE_TLB_A/B/C are 0x1000/0x1200/0x1400
206: #  and MTE_DST_TLB_SHIFT is 2, so the mode word's DST_BUF field selects which of re_tlb_a/b/c
207: #  horrible_getputpixel() reads: `dst_mode = (dst_tlb << 10) + ...', and that helper's
208: #  `switch (tlb_mode)' cases 0/1/2 are the three arrays.  THE TILE VALUE IS THE SAME 0x8002 IN ALL
