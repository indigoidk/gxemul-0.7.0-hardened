296: def fill(A, depth=MODE_D32):
297:     """Program a tiled FILL at `depth' and fire it.  Every store is a REAL GUEST INSTRUCTION."""
298:     #  re_tlb_a[0] = 0x8002.  The RE TLB write walks `len' in halfwords from tlbi 0, so an `sd'
299:     #  carrying the tile in its TOP halfword lands it at index 0 -- the packing sgi_re_rgb_probe.py
300:     #  established, and getting it wrong leaves the valid bit clear and the transfer silent.
301:     c  = store(A, RE_TLB_A, TLBA_TILE << 48, op=OP_SD_T0_A3)
302:     c += store(A, DEST, PAINT)                     # pre-paint: liveness, NOT a tail oracle
303:     c += store(A, MTE_MODE, depth)
304:     c += store(A, MTE_BG,   BG_VAL)
305:     c += store(A, MTE_DST0, DST0)
306:     c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
307:     return c
308: 
309: def fill_at(A, tlbreg, dstsel):
310:     """`fill()' at a NON-DEFAULT destination TLB label.  Added 2026-09-09.
311: 
312:     Byte for byte the same instruction sequence as fill(depth=MODE_D32), with two constants
313:     changed: the tile goes into re_tlb_b[0] or re_tlb_c[0] instead of re_tlb_a[0], and the
314:     mode word carries MTE_MODE_DST_BUF so do_mte_transfer()'s `dst_tlb' is 1 or 2, not 0.
315: 
316:     The oracle address is UNCHANGED, because the tile value is the same.  So `fill top',
317:     `fill b top' and `fill c top' read the same byte of the same address after the same
318:     transfer, and differ in exactly one variable -- which is what makes them a closure of
319:     the label axis rather than three unrelated rows."""
320:     c  = store(A, tlbreg, TLBA_TILE << 48, op=OP_SD_T0_A3)
321:     c += store(A, DEST, PAINT)                     # pre-paint: a silent no-op reports 0x99
322:     c += store(A, MTE_MODE, MODE_D32 | dstsel)
323:     c += store(A, MTE_BG,   BG_VAL)
324:     c += store(A, MTE_DST0, DST0)
325:     c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
326:     return c
327: 
328: 
329: def copy(A):
330:     """Tiled 32-bit COPY of ONE pixel: source (1,0) -> dest (0,0), both in TLB_A's tile.
331: 
332:     These rows exist because a FILL never reads `src_mode': deleting only
333:     `src_mode |= DE_MODE_TYPE_RGBA' is invisible to every fill row.  Three seats confirmed both
334:     the prediction and the byte walk.  dest[0] is 0x1a under BOTH correct shapes -- so `copy top'
335:     distinguishes neither HEAD nor the fix, and that IS its job: it reds only under a ONE-SIDED
336:     edit (source-only -> 0x4d, dest-only -> 0x00).
337: 
338:     A note the kimi seat asked for, so a future reader does not "correct" the want: the
339:     dest-only cell gives 0x00 because the CI GET *assigns* `*color = buf[0]', zero-extending it.
340:     Had the GET left `bg' untouched, an RGBA PUT would have emitted bg>>24 instead.  The row is
341:     right; the reason is the assignment, not "the high byte of a low-byte colour" in general.
342: 
343:     The destination is PRE-PAINTED so that a transfer which silently does nothing (an invalid
344:     TLB entry, say) reports 0x99 rather than looking like a plausible byte."""
345:     c  = store(A, RE_TLB_A, TLBA_TILE << 48, op=OP_SD_T0_A3)
346:     c += store(A, DEST + 4, SRC_WORD)              # the source pixel, four distinct bytes
347:     c += store(A, DEST,     PAINT)                 # the destination, so a no-op is visible
348:     c += store(A, MTE_MODE, MODE_D32 | MODE_COPY)
349:     c += store(A, MTE_SRC0, SRC_PIX_X << 16)       # src x=4 -> pixel 1 at depth 32, y=0
350:     c += store(A, MTE_DST0, DST0)
351:     c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
352:     return c
