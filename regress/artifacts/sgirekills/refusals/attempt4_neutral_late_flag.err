  583: 			 *      unaligned len == 8 either.
  584: 			 *  Narrower accesses carry len != 8 and are declined above, and
  585: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  586: 			 *  so no other CPU family reaches this handler.
  587: 			 *
  588: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  589: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  590: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  591: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  592: 			 *  the invariant above is stated for GUEST paths only.  It also
  593: 			 *  means `put d' must NOT be used to "witness" the over-run:
  594: 			 *  it bypasses the guest instruction path, so a reproduction
  595: 			 *  built on it would be laundering rather than witnessing.
  596: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  597: 			 *  NOT guest-reachable while this guard stands.
  598: 			 *
  599: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  600: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  601: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  602: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  603: 			 *  reaching a DRAWING-engine register from a rendering-engine
  604: 			 *  write -- not a wild write outside the allocation, and not
  605: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  606: 			 */
  607: 			if (!(d->warned & SGIRE_W_LINB_LEN)) {
  608: 				d->warned |= SGIRE_W_LINB_LEN;
  609: 				fatal("[ sgi_re: unimplemented len=%i for "
  610: 				    "CRIME_RE_LINEAR_B -- declined.  (once) ]\n",
  611: 				    (int) len);
  612: 			}
  613: 		} else if (writeflag == MEM_WRITE) {
  614: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  615: 			d->re_linear_b[tlbi] = idata >> 32ULL;
  616: 			d->re_linear_b[tlbi+1] = idata;
  617: 			debug("[ d->re_linear_b[%i] = 0x%08x, [%i] = 0x%08x ]\n",
  618: 				tlbi, d->re_linear_b[tlbi], tlbi+1, d->re_linear_b[tlbi+1]);
  619: 		} else {
  620: 			fatal("TODO: read from CRIME_RE_LINEAR_B\n");
  621: 			exit(1);
  622: 		}
  623: 	} else {
  624: 		if (writeflag == MEM_WRITE) {
  625: 			if (!(d->warned & SGIRE_W_UNMAP_WR)) {
  626: 				d->warned |= SGIRE_W_UNMAP_WR;
  627: 				fatal("[ sgi_re: unimplemented write to "
  628: 				    "address 0x%llx, data=0x%016llx -- "
  629: 				    "declined.  (once) ]\n",
  630: 				    (long long)relative_addr, (long long)idata);
  631: 			}
  632: 		} else {
  633: 			if (!(d->warned & SGIRE_W_UNMAP_RD)) {
  634: 				d->warned |= SGIRE_W_UNMAP_RD;
  635: 				fatal("[ sgi_re: unimplemented read from address"
  636: 				    " 0x%llx -- declined.  (once) ]\n",
  637: 				    (long long)relative_addr);
  638: 			}
  639: 		}
  640: 	}
  641: 
  642: 	if (writeflag == MEM_READ)
  643: 		memory_writemax64(cpu, data, len, odata);
  644: 
  645: 	return 1;
  646: }
