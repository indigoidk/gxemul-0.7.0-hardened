  431: 		} else {
  432: 			fatal("TODO: read from CRIME_RE_TLB_B\n");
  433: 			exit(1);
  434: 		}
  435: 	} else if (relative_addr >= CRIME_RE_TLB_C && relative_addr < CRIME_RE_TLB_C + 0x200) {
  436: 		if (len != 8) {
  437: 			if (!(d->warned & SGIRE_W_TLBC_LEN)) {
  438: 				d->warned |= SGIRE_W_TLBC_LEN;
  439: 				fatal("[ sgi_re: unimplemented len=%i for "
  440: 				    "CRIME_RE_TLB_C -- declined.  (once) ]\n",
  441: 				    (int) len);
  442: 			}
  443: 		} else if (writeflag == MEM_WRITE) {
  444: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  445: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  446: 				d->re_tlb_c[tlbi] = data[hwi]*256 + data[hwi+1];
  447: 				debug("d->re_tlb_c[%i] = 0x%04x\n", tlbi, d->re_tlb_c[tlbi]);
  448: 				tlbi++;
  449: 			}
  450: 		} else {
  451: 			fatal("TODO: read from CRIME_RE_TLB_C\n");
  452: 			exit(1);
  453: 		}
  454: 	} else if (relative_addr >= CRIME_RE_TEX && relative_addr < CRIME_RE_TEX + 0xe0) {
  455: 		if (len != 8) {
  456: 			if (!(d->warned & SGIRE_W_TEX_LEN)) {
  457: 				d->warned |= SGIRE_W_TEX_LEN;
  458: 				fatal("[ sgi_re: unimplemented len=%i for "
  459: 				    "CRIME_RE_TEX -- declined.  (once) ]\n",
  460: 				    (int) len);
  461: 			}
  462: 		} else if (writeflag == MEM_WRITE) {
  463: 			int tlbi = ((relative_addr & 0xff) >> 3) & 0xff;
  464: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  465: 				d->re_tex[tlbi] = data[hwi]*256 + data[hwi+1];
  466: 				debug("d->re_tex[%i] = 0x%04x\n", tlbi, d->re_tex[tlbi]);
  467: 				tlbi++;
  468: 			}
  469: 		} else {
  470: 			fatal("TODO: read from CRIME_RE_TEX\n");
  471: 			exit(1);
  472: 		}
  473: 	} else if (relative_addr >= CRIME_RE_LINEAR_A && relative_addr < CRIME_RE_LINEAR_A + 0x80) {
  474: 		if (len != 8) {
  475: 			/*
  476: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  477: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  478: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  479: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  480: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  481: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  482: 			 *  alignment is supplied by two independent mechanisms, and both
  483: 			 *  were checked rather than assumed:
  484: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  485: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  486: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  487: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  488: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  489: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
  490: 			 *      three of its memory_rw calls, so it cannot deliver an
  491: 			 *      unaligned len == 8 either.
  492: 			 *  Narrower accesses carry len != 8 and are declined above, and
  493: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  494: 			 *  so no other CPU family reaches this handler.
  495: 			 *
  496: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  497: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  498: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  499: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  500: 			 *  the invariant above is stated for GUEST paths only.  It also
  501: 			 *  means `put d' must NOT be used to "witness" the over-run:
  502: 			 *  it bypasses the guest instruction path, so a reproduction
  503: 			 *  built on it would be laundering rather than witnessing.
  504: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  505: 			 *  NOT guest-reachable while this guard stands.
  506: 			 *
  507: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  508: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  509: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  510: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  511: 			 *  reaching a DRAWING-engine register from a rendering-engine
  512: 			 *  write -- not a wild write outside the allocation, and not
  513: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  514: 			 */
  515: 			if (!(d->warned & SGIRE_W_LINA_LEN)) {
  516: 				d->warned |= SGIRE_W_LINA_LEN;
  517: 				fatal("[ sgi_re: unimplemented len=%i for "
  518: 				    "CRIME_RE_LINEAR_A -- declined.  (once) ]\n",
  519: 				    (int) len);
  520: 			}
  521: 		} else if (writeflag == MEM_WRITE) {
  522: 			/*
  523: 			 *  Very interesting. NetBSD writes stuff such as:
  524: 			 *
  525: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173080001731
  526: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173280001733
  527: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173480001735
  528: 			 *  ...
  529: 			 *
  530: 			 *  but the PROM writes something which looks like wrongly
  531: 			 *  32-bit sign-extended words:
  532: 			 *
  533: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040001
  534: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040003
  535: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040005
  536: 			 *  ...
  537: 			 *
  538: 			 *  followed by
  539: 			 *  [ sgi_mte: STARTING TRANSFER: mode=0x00000011
  540: 			 *    dst0=0x0000000040000000, dst1=0x0000000040007fff
  541: 			 *    (length 0x8000), dst_y_step=0 bg=0x0, bytemask=0xffffffff ]
  542: 			 *
  543: 			 *  indicating that it really meant to put both 0x80040000
  544: 			 *  and 0x80040001 into the first LINEAR_A entry.
  545: 			 *
  546: 			 *  The first guess would be a bug in the implementation of
  547: 			 *  one or more instructions in the emulator while coming up
  548: 			 *  with those values, but debugging the PROM so far has NOT
  549: 			 *  revealed any such bug. It may even be that the PROM code
  550: 			 *  is buggy (?) and never really set the LINEAR entries
  551: 			 *  correctly. Perhaps the hardware simply ignores the
  552: 			 *  weird values and does not fill it (using the MTE)
  553: 			 *  when asked to.
  554: 			 */
  555: 			// printf("CRIME_RE_LINEAR_A IDATA = %016llx\n", (long long)idata);
  556: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  557: 			d->re_linear_a[tlbi] = idata >> 32ULL;
  558: 			d->re_linear_a[tlbi+1] = idata;
  559: 			debug("[ d->re_linear_a[%i] = 0x%08x, [%i] = 0x%08x ]\n",
  560: 				tlbi, d->re_linear_a[tlbi], tlbi+1, d->re_linear_a[tlbi+1]);
  561: 		} else {
  562: 			fatal("TODO: read from CRIME_RE_LINEAR_A\n");
  563: 			exit(1);
  564: 		}
  565: 	} else if (relative_addr >= CRIME_RE_LINEAR_B && relative_addr < CRIME_RE_LINEAR_B + 0x80) {
  566: 		if (len != 8) {
  567: 			/*
  568: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  569: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  570: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  571: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  572: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  573: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  574: 			 *  alignment is supplied by two independent mechanisms, and both
  575: 			 *  were checked rather than assumed:
  576: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  577: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  578: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  579: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  580: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  581: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
