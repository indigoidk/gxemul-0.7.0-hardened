from pathlib import Path
import ast,re
s=Path('src/devices/dev_sgi_re.c').read_text()
h=Path('src/include/thirdparty/crmfbreg.h').read_text()
c={n:int(v,0) for n,v in re.findall(r'"'^#define'"\\s+(\\w+)\\s+(0x[0-9a-fA-F]+|\\d+)\\b',h,re.M)}
windows=re.findall(r'if \\(relative_addr >= (CRIME_RE_\\w+) && relative_addr < (CRIME_RE_\\w+)(?: \\+ (0x[0-9a-f]+))?\\)',s)
all_offsets=[]
for name,end,extra in windows:
 offsets=[a for a in range(0x1000,0x2000) if c[name]<=a<c[end]+(int(extra,0) if extra else 0) and a%8==0]
 all_offsets+=offsets
 print(name,len(offsets),':',' '.join('%04x'%a for a in offsets))
print('Total aligned 8-byte starts:',len(all_offsets),'unique:',len(set(all_offsets)))
mod=ast.parse(Path('regress/sgi_re_width_probe.py').read_text())
sites=next(ast.literal_eval(n.value) for n in mod.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='SITES' for t in n.targets))
rows=[]
def extract(body,nm=None):
 for n in body:
  if isinstance(n,ast.Expr) and isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id=='row':
   arg=n.value.args[0]
   name=ast.literal_eval(arg) if isinstance(arg,ast.Constant) else nm+ast.literal_eval(arg.right)
   rows.append(name)
  if isinstance(n,ast.For) and isinstance(n.iter,ast.Name) and n.iter.id=='SITES':
   for name,*_ in sites: extract(n.body,name)
extract(mod.body)
print('Rows from probe AST:',len(rows)); print('\\n'.join('%2d %s'%(i,n) for i,n in enumerate(rows,1)))
print('Read-termination row stimulus addresses:',[(n,hex(b)) for n,b,*_ in sites])
print('Depth field enumeration:',[(v,8<<v) for v in range(4)])
print('Source field enumeration:',[(v,v>c['MTE_TLB_C']) for v in range(8)])
