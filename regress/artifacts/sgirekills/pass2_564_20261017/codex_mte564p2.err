t, alive, r = s.run()
row("stip a", kept(r["ta"]), "paint kept", "S1, tiled A fill at depth 32")
row("stip b", kept(r["tb"]), "paint kept", "S1, tiled B")
row("stip c", kept(r["tc"]), "paint kept", "S1, tiled C")
