1473: #  ---- #564 sgirekills (MTE half): do_mte_transfer()'s five refusals of an unsupported transfer parameter --
1474: #  ---- stipple, a source buffer past MTE_TLB_C, and COPY / depth != 8 / a partial BYTEMASK to a LINEAR
1475: #  ---- destination -- each DECLINE with a latched announcement, where each used to end the process.  Wired
1476: #  ---- IN THE SAME COMMIT as the fix.  Measured with one instrument: 8/53 on the pre-fix build (HEAD
1477: #  ---- 2951694f; only the controls and the five ACCEPT rows green) and 53/53 on the fix
1478: #  ---- (regress/artifacts/sgirekills/detector_564_20261017/).  Modelled on the sgi_re_width_probe block
1479: #  ---- (find it with `grep -n 'sgi_re_width_probe.py "$PMAX"' gate_arm.sh`), at depth 0 so a sibling
1480: #  ---- probe's missing sentinel cannot swallow it.
1481: MTELOG=$LOGDIR/sgi_mte_decline.log
1482: python3 sgi_mte_decline_probe.py "$PMAX" gate > "$MTELOG" 2>&1 || true
1483: 
1484: if ! grep -q "MTEDECL_DONE" "$MTELOG"; then
1485:     note "sgi_mte decline probe did not reach its completion sentinel; last lines follow"
1486:     tail -5 "$MTELOG" | sed 's/^/       /'
1487:     check "sgi_mte decline probe completed" "no" "yes"
1488: else
1489:     grep -E " ok$| FAIL$" "$MTELOG" | sed 's/^/       /'
1490: 
1491:     #  CONTROLS BY NAME: a run whose controls died is an APPARATUS failure, not 50 product failures.
1492:     for c in "live" "devsig" "mode rt"; do
1493:         check "sgi_mte control: $c" "$(count "$MTELOG" "^$c  .*ok$")" "1"
1494:     done
1495: 
1496:     #  PER ROW, ONE LINE.  The probe prints a name of at most 14 characters in a 16-column field, so every
1497:     #  name is followed by TWO spaces and "^<name>  " cannot match a longer name that starts with it.
1498:     for v in "live" "devsig" "mode rt" "stip a" "stip b" "stip c" "stip copy" "stip lin a" "stip lin b" "stip surv" "stip once" "src 3" "src 4" "src 5" "src 6" "src 7" "src 3 copy" "src 3 lin" "src c fill" "src c copy" "src surv" "src once" "copy lin a" "copy lin b" "copy surv" "copy once" "depth a 16" "depth a 32" "depth a 64" "depth b 16" "depth b 32" "depth b 64" "depth surv" "depth once" "mask unwritten" "mask unw surv" "mask 0000ffff" "mask fffffffe" "mask 7fffffff" "mask sweep" "mask lin b" "mask surv" "mask once" "lin fill a" "lin fill b" "lin fill ecc" "tile mask" "tile copy mask" "latch paint" "latch texts" "latch old bit" "after fill" "after status"; do
1499:         check "sgi_mte row: $v" "$(count "$MTELOG" "^$v  .*ok$")" "1"
1500:     done
1501: 
1502:     #  DENOMINATOR PINNED TO A LITERAL, summed arithmetically (count() is plain grep: a `|' would be literal).
1503:     check "sgi_mte rows emitted" \
1504:           "$(( $(count "$MTELOG" " ok$") + $(count "$MTELOG" " FAIL$") ))" "53"
1505:     check "sgi_mte rows green"   "$(count "$MTELOG" " ok$")"   "53"
1506:     check "sgi_mte rows red"     "$(count "$MTELOG" " FAIL$")" "0"
1507: fi
