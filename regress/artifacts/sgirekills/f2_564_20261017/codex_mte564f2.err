1697: 				fill_len = dstlen;
1698: 
1699: 			uint64_t starting_page = fill_addr & ~0xfff;
1700: 			uint64_t ending_page = (fill_addr + fill_len - 1) & ~0xfff;
1701: 			if (starting_page != ending_page) {
