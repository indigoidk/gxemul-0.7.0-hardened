arm_msrmode_probe -- binary=/tmp/gxmsr2/head/gxemul label=HEAD_probe2 machine=testarm
ARMMSRMODE_CONTROL=OK
  enc ok      got=clean              want=clean              ok   CONTROL=DEAD. Decoder match on the PLANTED literals: MSR-imm fra
  live        got=0x2a               want=0x2a               ok   CONTROL=DEAD. Plant, step and dump executed at all.
  pc adv      got=0x8008             want=0x8008             ok   CONTROL=DEAD. The words were translated as 4-byte ARM instructio
  armed       got=0xd3/0x3fff000     want=0xd3/0x3fff000     ok   CONTROL=DEAD. SVC32 privileged testarm -- not USR32, not barearm
  no cbit     got=m=13 sp            want=m=13 sp            ok   MSR CPSR_f writes the FLAGS byte, so the mode field is untouched
  kill 14     got=dead               want=m=13 if=0 sp once  FAIL MSR CPSR_c, #0x14 into a RESERVED mode reaches arm_load_register
  kill 15     got=dead               want=m=13 if=0 sp once  FAIL MSR CPSR_c, #0x15 into a RESERVED mode reaches arm_load_register
  save 2s     got=dead               want=m=13 sp once rt    FAIL #0x14 then #0x13 in one process. On HEAD it dies on the FIRST MS
  acc usr     got=m=10               want=m=10               ok   USR32 is ONE-WAY (the USR mask strips the c-byte). SP is the USR
  acc fiq     got=m=11/0/m=13/sp     want=m=11/0/m=13/sp     ok   ACCEPT + CANARY in one row: arrive mode/SP==0 (banked, BSS-zero)
  acc irq     got=m=12/0/m=13/sp     want=m=12/0/m=13/sp     ok   ACCEPT + CANARY in one row: arrive mode/SP==0 (banked, BSS-zero)
  acc abt     got=m=17/0/m=13/sp     want=m=17/0/m=13/sp     ok   ACCEPT + CANARY in one row: arrive mode/SP==0 (banked, BSS-zero)
  acc und     got=m=1b/0/m=13/sp     want=m=1b/0/m=13/sp     ok   ACCEPT + CANARY in one row: arrive mode/SP==0 (banked, BSS-zero)
  acc sys     got=m=1f/0/m=13/sp     want=m=1f/0/m=13/sp     ok   ACCEPT + CANARY in one row: arrive mode/SP==0 (banked, BSS-zero)
  same svc    got=m=13 sp            want=m=13 sp            ok   SAME-MODE: Load is not called, so SP-UNCHANGED *IS* the preserva
  usr mask    got=m=10               want=m=10               ok   In USR32 the c-byte is STRIPPED, so the following #0x14 must NOT
  kill 1e     got=dead               want=m=13 if=0 sp once  FAIL MSR CPSR_c, #0x1e: unmodelled, like 0x14/0x15. Kills a helper wi
  rst movs    got=dead               want=m=13 if=0 sp once  FAIL MSR SPSR_c,#0x14 then movs_pc_lr: the restore reaches Load's def
  rst ldm     got=dead               want=m=13 if=0 sp once  FAIL MSR SPSR_c,#0x14 then ldm_r5_pc_s: the restore reaches Load's de
  zero spsr   got=dead               want=m=13 if=0 sp once  FAIL MOVS pc,lr from boot SVC32 with spsr_svc never written (mode 0x0
  acc movs    got=m=1f if=0          want=m=1f if=0          ok   MSR SPSR_c,#0x1f then movs_pc_lr: SYS32 restored, SP from the us
  acc ldm     got=m=1f if=0          want=m=1f if=0          ok   MSR SPSR_c,#0x1f then ldm_r5_pc_s: SYS32 restored, SP from the u
  dbg save    got=dead               want=m=13 save          FAIL cpsr=0xd4 then MSR CPSR_c,#0x13: Save's default: (HEAD exit(1)) 
  dbg both    got=dead               want=m=14 sp save load  FAIL cpsr=0xd4 then MOVS pc,lr: no SPSR for 0x14, so BOTH Save's and 
  latch ind   got=dead               want=m=13 if=0 sp msr pop dpi FAIL MSR, LDM^ and MOVS declines in ONE session: three distinct latch
  row count   got=26                 want=26                 ok   identity row (floor clause (c)): the row set is complete.
ARMMSRMODE_RESULT=16/26
ARMMSRMODE_REDS=kill 14,kill 15,save 2s,kill 1e,rst movs,rst ldm,zero spsr,dbg save,dbg both,latch ind
  diag  kill 14: load mode 20 seen
  diag  kill 15: load mode 21 seen
  diag  save 2s: load=yes save=no
  diag  kill 1e: load mode 30
  diag  rst movs: load mode 20
  diag  rst ldm: load mode 20
  diag  zero spsr: load mode 0
  diag  dbg save: save mode 20
  diag  dbg both: save mode 20
  diag  latch ind: load mode 20
ARMMSRMODE_EXPECT_HEAD_REDS=kill 14,kill 15,save 2s,kill 1e,rst movs,rst ldm,zero spsr,dbg save,dbg both,latch ind
ARMMSRMODE_TALLY_MATCHES_HEAD_EXPECT=yes
ARMMSRMODE_DONE
