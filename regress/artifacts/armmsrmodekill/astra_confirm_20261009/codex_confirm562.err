#!/usr/bin/env python3
"""manifest562.py -- the check_probe_wiring.py MANIFEST lines #562's commit owes: the new DETECTOR entry for
regress/arm_msrmode_probe.py, and one line per .py file under regress/artifacts/armmsrmodekill/ that no line names
yet (derived from the tree at staging time, never listed by hand).  Adapted from manifest529.py.

usage: manifest562.py <checker.py> <out.py> <rows>   (reads checker.py -- normally HEAD's bytes --, writes out.py
                                                       with the block inserted above the #529 block; prints the plan)

CLASS: a measuring seat's script (the opus_pass* dirs) and a FROZEN instrument (probe_frozen.py, probe_closure*.py)
are RESEARCH -- preserved evidence; the implementation helper's mutators and builders (the killtable* dirs) are TOOL.
The checker refuses *_probe.py / *_witness.py as TOOL, so those are RESEARCH whatever their role.  The description
is the file's own docstring (first sentence), so it cannot drift from what the file says it is."""
import io, os, re, sys

SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
REG = os.path.join(SEC, "regress")
ROOT = "artifacts/armmsrmodekill/"
ANCHOR = "    #  #529 crimewidthkill, landed with the round: the detector and its untracked instruments.\n"


def doc(path):
    s = io.open(path, encoding="utf-8", errors="replace").read()
    m = re.search(r'[rR]?"""(.*?)"""', s, re.S)
    t = (m.group(1) if m else "").strip()
    t = " ".join(t.split())
    t = re.split(r"(?<=[.!?])\s", t, 1)[0] if t else "(no docstring)"
    return t.replace('"', "'").replace("\\", "/")[:150]


def plan(checker_text):
    out = []
    for d, _, files in os.walk(os.path.join(REG, *ROOT.rstrip("/").split("/"))):
        for f in sorted(files):
            if not f.endswith(".py"):
                continue
            rel = os.path.relpath(os.path.join(d, f), REG).replace(os.sep, "/")
            if '"%s"' % rel in checker_text:
                continue
            base = os.path.basename(rel)
            sub = rel.split("/")[2]
            seat = sub.startswith("opus_")
            frozen = base.startswith(("probe_frozen", "probe_closure"))
            is_tool = (not seat and not frozen and not base.endswith(("_probe.py", "_witness.py")))
            cls = "CLASS_TOOL" if is_tool else "CLASS_RESEARCH"
            who = ("the Opus 5.5 measuring seat's" if seat else
                   "the frozen instrument a table ran" if frozen else "the implementation helper's")
            out.append((rel, cls, "#562 %s %s: %s" % (sub, who, doc(os.path.join(d, f)))))
    return sorted(out)


def main():
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    src, dst, nrows = sys.argv[1], sys.argv[2], sys.argv[3]
    s = io.open(src, encoding="utf-8", newline="").read()
    if s.count(ANCHOR) != 1:
        sys.exit("REFUSED: the #529 anchor line is not unique (%d)" % s.count(ANCHOR))
    if '"arm_msrmode_probe.py"' in s:
        sys.exit("REFUSED: the detector entry already exists")
    rows = plan(s)
    det = ('    #  #562 armmsrmodekill, landed with the round: the detector and its preserved instruments.\n'
           '    "arm_msrmode_probe.py":\n'
           '        (CLASS_DETECTOR, "#562 armmsrmodekill: a privileged guest MSR, or an SPSR restore, naming a mode '
           'this model does not bank ended the emulator -- the mode field declined, announced once per site; %s rows '
           'on unmodified -E testarm, gate 14 (gate_arm.sh) pins %s"),\n' % (nrows, nrows))
    block = det + "".join('    "%s":\n        (%s, "%s"),\n' % r for r in rows)
    s = s.replace(ANCHOR, block + ANCHOR, 1)
    io.open(dst, "w", encoding="utf-8", newline="").write(s)
    print("detector entry + %d lines:" % len(rows))
    for r in rows:
        print("  %-9s %s" % (r[1][6:], r[0]))
    print("WROTE", dst)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""mk562_ledger.py <values.json> <out.json> -- #562's STAGED ledger: HEAD's bytes plus ONLY #562's five rows.

The working ledger also carries another session's uncommitted rows (lca*, alpha*, cxseatcheck, untrackeddetectors,
boilerplateprefix, measured 2026-10-08 against HEAD and the pre-#562 backup), so the staged file is built from HEAD,
never copied from the working tree.  commit_unit.py's 3-way merge puts the other session's lines back afterwards.

values.json: {"witness": ..., "closure_note": ..., "state_note_prefix": ...} -- the closing values, written when the
round's numbers are final.  Refuses on any placeholder, on a HEAD that does not round-trip byte-identically through
this serializer, and on any non-#562 row that differs from HEAD in the output."""
import io, json, re, subprocess, sys

SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
REL = "tools/pipeline/ledger.json"
MINE = ["armmsrmodekill", "armthumbabortkill", "armusrstop", "armspsrthumb", "armmmuvehicle", "armmsrmodedebt", "headerstaleobj"]
NEW = ["armusrstop", "armspsrthumb", "armmmuvehicle", "armmsrmodedebt", "headerstaleobj"]


def ser(L):
    return json.dumps(L, indent=1, ensure_ascii=False).replace("\n", "\r\n").encode("utf-8")


def main():
    vals = json.load(io.open(sys.argv[1], encoding="utf-8"))
    if re.search(r"<OWED|\(DRY\)", json.dumps(vals)):
        sys.exit("REFUSED: values.json carries a placeholder")
    head_b = subprocess.run(["git", "-C", SEC, "show", "HEAD:" + REL], capture_output=True, check=True).stdout
    H = json.loads(head_b.decode("utf-8"))
    if ser(H) != head_b:
        sys.exit("REFUSED: HEAD's ledger does not round-trip through this serializer -- the staged diff would not be "
                 "#562's rows alone")
    W = json.loads(io.open(SEC + "/" + REL, encoding="utf-8", newline="").read())
    w = {r["id"]: r for r in W["rows"]}
    out = json.loads(head_b.decode("utf-8"))
    ids = [r["id"] for r in out["rows"]]
    for rid in MINE:
        row = json.loads(json.dumps(w[rid]))
        if rid == "armmsrmodekill":
            row["state"] = "closed"
            row["witness"] = vals["witness"]
            row["closure"] = {"by": "opus5-mainloop", "badge": "A", "note": vals["closure_note"]}
            row["state_note"] = vals["state_note_prefix"] + row["state_note"]
            row["commits"] = row.get("commits") or []
        if rid in NEW:
            if rid in ids:
                sys.exit("REFUSED: %s is already in HEAD" % rid)
            out["rows"].append(row)
        else:
            out["rows"][ids.index(rid)] = row
    h = {r["id"]: r for r in H["rows"]}
    for r in out["rows"]:
        if r["id"] not in MINE and h.get(r["id"]) != r:
            sys.exit("REFUSED: non-#562 row %s differs from HEAD" % r["id"])
    b = ser(out)
    io.open(sys.argv[2], "wb").write(b)
    print("STAGED ledger: HEAD + %d #562 rows (%d new), %d bytes" % (len(MINE), len(NEW), len(b)))


if __name__ == "__main__":
    main()
