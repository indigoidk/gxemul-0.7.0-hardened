#!/bin/bash
# opuscheck.sh -- read-only: the Opus final-pass seat's lane results (top-level *.out of each lane dir only).
date +%H:%M
R=/tmp/gxopus562r5
for d in "$R"/LANE* "$R"/base "$R"/HEADL; do
    [ -d "$d" ] || continue
    for f in "$d"/*.out "$d"/*.log; do
        [ -f "$f" ] || continue
        echo "$(basename "$d")/$(basename "$f"): $(grep -o 'ARMMSRMODE_RESULT=[0-9/]*' "$f" | tail -n 1) $(tail -n 1 "$f" | cut -c1-60)"
    done
done
ls "$R" 2>/dev/null | tr '\n' ' '; echo
#!/usr/bin/env python3
"""post562.py -- commit_unit.py's post step for #562.  ledger.json and matrix.html are `no_merge`: the working ledger is
rebuilt from the pre-commit backup (it carries another session's uncommitted rows) with #562's five rows replaced by
the COMMITTED versions, and the working matrix.html is regenerated from it.  The dashboard is NOT published."""
import glob, json, os, subprocess, sys

C = os.path.dirname(os.path.abspath(__file__))
SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
L = os.path.join(SEC, "tools", "pipeline", "ledger.json")
MINE = ["armmsrmodekill", "armthumbabortkill", "armusrstop", "armspsrthumb", "armmmuvehicle", "armmsrmodedebt", "headerstaleobj"]
dump = lambda x: json.dumps(x, indent=1, ensure_ascii=False).replace("\n", "\r\n").encode("utf-8")

subj = subprocess.run(["git", "-C", SEC, "log", "-1", "--format=%s"], capture_output=True, text=True).stdout
if not subj.startswith("#562 "):
    sys.exit("REFUSED: HEAD is %r, not #562's commit" % subj[:60])
bks = [b for b in sorted(glob.glob(os.path.join(C, "bk_562_*"))) if os.path.isfile(os.path.join(b, "commit.out"))]
if not bks:
    sys.exit("REFUSED: no bk_562_* backup of a --go run")
raw = open(os.path.join(bks[-1], "tools", "pipeline", "ledger.json"), "rb").read()
W = json.loads(raw.decode("utf-8"))
if dump(W) != raw:
    sys.exit("REFUSED: the backup ledger does not round-trip byte-identical")
H = json.loads(subprocess.run(["git", "-C", SEC, "show", "HEAD:tools/pipeline/ledger.json"], capture_output=True,
                              check=True).stdout.decode("utf-8"))
h = {r["id"]: r for r in H["rows"]}
idx = {r["id"]: i for i, r in enumerate(W["rows"])}
for rid in MINE:
    W["rows"][idx[rid]] = h[rid]
open(L, "wb").write(dump(W))
print("working ledger rebuilt from %s: #562's %d rows set to the committed versions" % (bks[-1], len(MINE)))
r = subprocess.run([sys.executable, os.path.join(SEC, "tools", "pipeline", "gen_dashboard.py")], cwd=SEC,
                   capture_output=True, text=True)
print((r.stdout.strip() or r.stderr.strip())[-200:])
sys.exit(r.returncode)
