  183: 	if (userMode && !(
  184: 	    palcode == 0x80 || palcode == 0x81 || palcode == 0x83 ||
  185: 	    palcode == 0xae || palcode == 0xaa || palcode == 0x86 ||
  186: 	    palcode == 0x9e || palcode == 0x92 || palcode == 0x9f)) {
  187: 		// opDec fault.
  188: 		fatal("[ Privileged Alpha PALcode called from user mode: TODO ]");
