  191:     buf = ""
  192:     def rd(t):
  193:         nonlocal buf
  194:         end = time.time() + t
  195:         while time.time() < end:
  196:             r, _, _ = select.select([fd], [], [], 0.1)
  197:             if not r:
  198:                 continue
  199:             try:
  200:                 d = os.read(fd, 65536)
  201:                 if not d:
  202:                     return False
  203:                 buf += d.decode("latin-1", "replace")
  204:             except OSError:
  205:                 return False
  206:         return True
  207:     alive = rd(settle)
  208:     for i, c in enumerate(cmds):
  209:         try:
  210:             os.write(fd, (c + "\n").encode("latin-1"))
  211:         except OSError:
  212:             alive = False
  213:             break
  214:         if not rd(spin if i == len(cmds) - 1 else 0.22):
  215:             alive = False
  216:             break
  217:     try:
  218:         os.write(fd, b"quit\n"); rd(0.4)
  219:     except OSError:
  220:         pass
  221:     try:
  222:         os.close(fd)
  223:     except OSError:
  224:         pass
  225:     return buf.replace("\r", ""), alive
