  290: 			cpu->cd.alpha.pcb.apcb_decrsv1 = new_decrsv1;
  291: 
  292: 			// TODO: Don't invalidate EVERYTHING!
  293: 			cpu->invalidate_translation_caches(cpu, 0, INVALIDATE_ALL);
  294: 		}
  295: 		break;
  296: #if 0
  297: 	case 0x31:	/*  PAL_OSF1_wrval  */
