  173: 	 *	bugchk		kernel and user
  174: 	 *	callsys		user
  175: 	 *	clrfen		user
  176: 	 *	gentrap		kernel and user
  177: 	 *	imb		kernel and user
  178: 	 *	rdunique	kernel and user
  179: 	 *	urti		user
  180: 	 *	wrunique	kernel and user
  181: 	 */
