    c = ["put h 0x%x, 0x0009" % HANDLER,           # nop, so the fetch succeeds
         "put h 0x%x, 0xaffe" % (HANDLER + 2),     # bra .
         "put h 0x%x, 0x0009" % (HANDLER + 4),     # nop (delay slot)
