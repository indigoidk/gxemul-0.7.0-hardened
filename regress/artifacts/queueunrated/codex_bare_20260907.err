def dma_line(ch, val):
    return ("[ sh4: DMA channel %d: transfer count 0x%08x exceeds 24 bits"
            " -- write ignored.  (once per bit) ]" % (ch, val))


def icr_line(bits):
    return ("[ sh4: INTC: ICR IRLM bit 0x%04x not implemented -- write ignored."
            "  (once per bit) ]" % bits)


