FILE src/disk/diskimage.c
2325: /*
2326:  *  diskimage_sync():
2327:  *
2328:  *  #437: make a guest's SYNCHRONIZE CACHE actually durable.  The handler in
2329:  *  diskimage_scsicmd.c did fsync(fileno(d->f)) and nothing else, which was
2330:  *  wrong in two independent ways -- and its own TODO said so.
2331:  *
2332:  *  (a)  fsync() flushes the KERNEL's buffers.  Writes here go through stdio,
2333:  *       so the userspace buffer was never flushed.  The tree already knew:
2334:  *       overlay_set_block_in_use() does fflush-then-fsync under do_fsync at
2335:  *       :1207-1211 and its comment states the reason.  fwrite_helper()'s own
2336:  *       do_fsync blocks carry no such comment.  (The first version of this
2337:  *       note attributed the comment to fwrite_helper, which does not have it.)
2338:  *
2339:  *  (b)  With an overlay, fwrite_helper() writes ONLY to the overlay -- so
2340:  *       d->f, the file being fsynced, held none of the guest's data, and the
2341:  *       overlay and its bitmap were never synced at all.  Measured before the
2342:  *       fix: fsync_n=1 on the base fd, fflush_n=0 anywhere.
2343:  *
2344:  *  ORDER IS LOAD-BEARING, and getting it wrong is worse than the bug.  A
2345:  *  bitmap bit says "the overlay owns this block".  Publishing that bit while
2346:  *  the block's bytes are not durable makes a later read take the overlay's
2347:  *  HOLE instead of the base's good bytes -- measured: the guest reads zeros
2348:  *  where the base still held data, reported as a successful read, and it does
2349:  *  NOT fall through to the base.  So on a data-side failure we stop and do
2350:  *  NOT sync that overlay's bitmap.  (Not reachable in the current write path,
2351:  *  whose per-block fseeks keep the two in lockstep -- this is a constraint on
2352:  *  THIS function, not a pre-existing defect.)
2353:  *
2354:  *  d->f is synced only when there are NO overlays.  Under the R: prefix -- what
2355:  *  every rig uses -- d->f is opened "r" while the disk is writable, so d->f is
2356:  *  a READ-ONLY handle holding no dirty data: fflush() on it is undefined per
2357:  *  C99 7.21.5.2p2, fsync() on an O_RDONLY fd is unspecified across platforms,
2358:  *  and it costs a real fsync of a possibly huge untouched file.
2359:  *
2360:  *  Returns 1 if everything that could hold dirty data was flushed and synced,
2361:  *  0 otherwise.  A disk with nothing open returns 0 rather than 1: answering
2362:  *  "durable" for a disk that cannot be synced is the failure this fixes.
2363:  */
2364: int diskimage_sync(struct diskimage *d)
2365: {
2366: 	int ok = 1, i;
2367: 
2368: 	if (d == NULL)
2369: 		return 0;
2370: 
2371: 	if (d->nr_of_overlays == 0) {
2372: 		if (d->f == NULL)
2373: 			return 0;
2374: 
2375: 		/*  A disk with no overlay and no write permission holds nothing
2376: 		    dirty, so there is nothing to make durable and the request is
2377: 		    already satisfied.  Skipping is not an optimisation: this is
2378: 		    the "r"-mode handle the comment above refuses to touch under
2379: 		    R:, and doing it here anyway would apply fflush to a stream
2380: 		    whose last operation was input (undefined, C99 7.21.5.2p2)
2381: 		    and fsync to an O_RDONLY fd (rc 0 on glibc, unspecified
2382: 		    elsewhere).  Now that the result is CHECKED, a platform
2383: 		    returning nonzero would turn every CD-ROM's sync into a
2384: 		    spurious MEDIUM ERROR.  */
2385: 		if (!d->writable)
2386: 			return 1;
2387: 
2388: 		if (fflush(d->f) != 0)
2389: 			ok = 0;
2390: 		if (fsync(fileno(d->f)) != 0)
2391: 			ok = 0;
2392: 		return ok;
2393: 	}
2394: 
2395: 	for (i = 0; i < d->nr_of_overlays; i++) {
2396: 		if (d->overlays[i].f_data == NULL) {
2397: 			ok = 0;
2398: 			continue;
2399: 		}
2400: 
2401: 		if (fflush(d->overlays[i].f_data) != 0 ||
2402: 		    fsync(fileno(d->overlays[i].f_data)) != 0) {
2403: 			/*  Data is not durable, so do NOT publish the bitmap
2404: 			    that claims this overlay owns those blocks.  */
2405: 			ok = 0;
2406: 			continue;
2407: 		}
2408: 
2409: 		if (d->overlays[i].f_bitmap != NULL &&
2410: 		    (fflush(d->overlays[i].f_bitmap) != 0 ||
2411: 		    fsync(fileno(d->overlays[i].f_bitmap)) != 0))
2412: 			ok = 0;
2413: 	}
2414: 
2415: 	return ok;

