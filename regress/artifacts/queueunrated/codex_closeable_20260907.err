1: #!/bin/bash
2: #  #491's REAL claim is not "the warning is gone".  It is that the warning was
3: #  costing an entire gate, and removing it restores that coverage.
4: #
5: #  THE CASCADE, from the 2026-08-29 battery:
6: #    gate_build FAILS (2 warnings)  ->  it withdraws $RIG/gxsec-gxemul at start
7: #    and republishes only on success  ->  gate_mips need_exec's that binary and
8: #    reports `SKIP -- missing or non-executable binary`.
9: #
10: #  A whole gate's coverage lost and scored as SKIP, not FAIL.  Identical to what
11: #  one stale allowlist line cost on 2026-08-23.
12: #
13: #  So the test is TWO gates in sequence, in the order the battery runs them.
14: set -u
15: SEC=/mnt/c/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC
16: OUT=$SEC/regress/artifacts/diskimagesign/cascade_20260829
17: mkdir -p "$OUT"
18: cd "$SEC/regress" || exit 1
19: 
20: echo "=== BEFORE: is the arc rig binary present? ==="
21: ls -la /mnt/c/DocumentNoSnc/CC/GXEMUL/gxemul_arc_rig/gxsec-gxemul 2>/dev/null || echo "  ABSENT (withdrawn by the failed battery run)"
22: 
23: echo
