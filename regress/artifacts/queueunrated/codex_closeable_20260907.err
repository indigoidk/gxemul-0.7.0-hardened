26: echo "  exit=$?"
27: grep -E '^  FAIL|warnings|clean-build: (PASS|FAIL)' "$OUT/gate_build.log" | head -12 | sed 's/^/    /'
28: 
29: echo
30: echo "=== did it republish the shared arc binary? ==="
31: ls -la /mnt/c/DocumentNoSnc/CC/GXEMUL/gxemul_arc_rig/gxsec-gxemul 2>/dev/null | sed 's/^/  /' || echo "  STILL ABSENT"
32: 
33: echo
34: echo "=== gate 4: gate_mips -- SKIP or run? ==="
35: bash gate_mips.sh > "$OUT/gate_mips.log" 2>&1
36: echo "  exit=$?"
37: grep -E 'SKIP|mips-rigs: (PASS|FAIL)|^  FAIL' "$OUT/gate_mips.log" | head -8 | sed 's/^/    /'
38: 
39: echo
40: echo "CASCADE491_DONE"

