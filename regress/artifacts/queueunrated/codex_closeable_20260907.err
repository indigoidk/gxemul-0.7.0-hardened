191: /*
192:  *  diskimage_recalc_size():
193:  *
194:  *  Recalculate a disk's size by stat()-ing it.
195:  *  d is assumed to be non-NULL.
196:  */
197: bool diskimage_recalc_size(struct diskimage *d)
198: {
199: 	struct stat st;
200: 	int res;
201: 	int64_t size = 0;
202: 
203: 	if (d->nr_of_tracks > 0) {
204: 		/*
205: 		 *  Multi-track (CUE/BIN) image: the file named by d->fname
206: 		 *  is only the small cue sheet text file, so its size is
207: 		 *  meaningless here.  The logical size spans from the start
208: 		 *  of the first data track to the end of the disc, as
209: 		 *  computed when the cue sheet was parsed.
210: 		 */
211: 		size = (d->total_disc_sectors - d->first_data_track_lba)
212: 		    * CDROM_SECTOR_SIZE;
213: 	} else {
214: 		res = stat(d->fname, &st);
215: 		if (res)
216: 			return false;
217: 
218: 		size = st.st_size;
219: 
220: 		/*
221: 		 *  TODO:  CD-ROM devices, such as /dev/cd0c, how can one
222: 		 *  check how much data is on that cd-rom without reading it?
223: 		 *  For now, assume some large number, hopefully it will be
224: 		 *  enough to hold any cd-rom image.
225: 		 */
226: 		if (d->is_a_cdrom && size == 0)
227: 			size = 762048000;
228: 	}
229: 
230: 	d->total_size = size;
231: 
232: 	if (d->nr_of_tracks == 0 &&
233: 	    (d->total_size == 720*1024 || d->total_size == 1474560
234: 	    || d->total_size == 2949120 || d->total_size == 1228800)
235: 	    && d->type == DISKIMAGE_UNKNOWN)
236: 		d->type = DISKIMAGE_FLOPPY;
237: 
238: 	switch (d->type) {
239: 	case DISKIMAGE_FLOPPY:
240: 		if (d->total_size < 737280) {
241: 			debugmsg(SUBSYS_DISK, "", VERBOSITY_WARNING,
242: 			    "TODO: small (non-80-cylinder) floppies?");
243: 		}
244: 
245: 		if (!d->chs_override) {
246: 			d->heads = 2;
247: 			/*  #414: derive sectors-per-track from the byte count
248: 			    assigned at the top of this function.  The old
249: 			    expression read d->nr_of_logical_blocks, which this
250: 			    same function does not assign until below, so on the
251: 			    first call it was always 0 -- and stably 0, because a
252: 			    second call re-read the 0 it had just stored.  80
253: 			    cylinders and 2 heads are the documented floppy
254: 			    assumption (man/gxemul.1); the four sizes listed
255: 			    there divide by 80*2*512 exactly, giving 9, 15, 18
256: 			    and 36.  The clamp is load-bearing, not defensive:
257: 			    sectors_per_track reaches single-byte MODE SENSE
258: 			    fields, and no parser check can reach a value this
259: 			    arm COMPUTES.  */
260: 			d->sectors_per_track = d->total_size / (80 * 2 * 512);
261: 			if (d->sectors_per_track < 1)
262: 				d->sectors_per_track = 1;
263: 			if (d->sectors_per_track > DISKIMAGE_MAX_SPT)
264: 				d->sectors_per_track = DISKIMAGE_MAX_SPT;
265: 		}
266: 		break;
267: 
268: 	default:/*  Non-floppies:  */
269: 		if (!d->chs_override) {
270: 			d->heads = 16;
271: 			d->sectors_per_track = 63;
272: 		}
273: 	}
274: 
275: 	/*
276: 	 *  #414: cylinders are derived from the size for EVERY disk -- both
277: 	 *  arms, with or without a -d gH;S override.  Both assignments to
278: 	 *  d->cylinders used to sit inside "if (!d->chs_override)", and a
279: 	 *  census of the file showed those were the only two, so an override
280: 	 *  removed every write to the field that existed and left the zeroed
281: 	 *  0 in place.  The shared block below is what makes the override
282: 	 *  usable; it also removes a duplicated copy of the arithmetic.
283: 	 *
284: 	 *  bytespercyl is guarded ITSELF rather than only its factors: the
285: 	 *  factors are clamped above, but guarding the divisor is what stops
286: 	 *  a SIGFPE if a future non-parser caller sets heads or spt to 0.
287: 	 *  Guard and clamp do different jobs -- the guard prevents a crash,
288: 	 *  the clamp is what makes the answer right.
289: 	 */
