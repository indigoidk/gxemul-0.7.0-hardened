+	GDROM_W_OVERREAD_B,	/*  was 0x08  */
+	GDROM_W_DMANODATA_B,	/*  was 0x10  */
+	GDROM_W_DMAARM_B,	/*  was 0x20  */
+	GDROM_W_NBITS
+};
