392: 		/*
393: 		 *  SELFCHECK -- CAN THIS FILE'S COMPARATORS STILL FAIL?
394: 		 *
395: 		 *  Feed checks() and checkn() deliberate mismatches and require the failure
396: 		 *  counter to move, then un-record them so the rows are free.  If either has
397: 		 *  been stubbed or had its comparison edited away, every row that uses it is
398: 		 *  silently inert and the gate cannot tell -- the row count, the identity row
399: 		 *  and the verdict token all survive that edit unchanged.  diff_timer.c holds
400: 		 *  the full rationale and the four measurements behind this shape.
401: 		 *
402: 		 *  BOTH HELPERS ARE PROBED, because they are two comparators and not one: this
403: 		 *  file's trace rows go through checks() and its status rows through checkn(),
404: 		 *  so a sentinel that exercised only one would vouch for rows it never touched.
405: 		 *  The numeric probe uses 2^32 against 0 -- EQUAL in their low 32 bits -- so a
406: 		 *  checkn() narrowed to int passes it while the string probe still catches the
407: 		 *  comparator dying outright.
408: 		 *
409: 		 *  This does NOT prove any row is correct, and a comparator that special-cases
410: 		 *  these rows BY NAME is still invisible to it.  Liveness sentinel, nothing
411: 		 *  more.
412: 		 *
413: 		 *  @@SELFCHECK@@ IN THE ROW NAMES IS LOAD-BEARING: these are deliberate
414: 		 *  mismatches, so the helpers print FAIL for them on the HEALTHY path, and
415: 		 *  selfmutant.py filters exactly that token when it looks for the row its
416: 		 *  mutant killed.  gate_offline.sh greps the SUMMARY line below for presence.
417: 		 */
418: 		int sc_f = fails, sc_r = rows, sc_bad = 0;
419: 
420: 		checks("@@SELFCHECK@@/str", "a", "b");
421: 		if (fails <= sc_f)
422: 			sc_bad++;
423: 		fails = sc_f; rows = sc_r;
424: 
425: 		checkn("@@SELFCHECK@@/wide", 4294967296L, 0);
426: 		if (fails <= sc_f)
427: 			sc_bad++;
428: 		fails = sc_f; rows = sc_r;
429: 
430: 		if (sc_bad) {
431: 			printf("  FAIL  SELFCHECK the comparator no longer compares (%d of 2 "
432: 			    "mismatches went unnoticed) -- every row in this file is inert\n",
433: 			    sc_bad);
434: 			fails = sc_f + 1;
435: 			rows = sc_r;
436: 		} else {
437: 			printf("  ok    SELFCHECK the comparator can still fail       "
438: 			    "str+wide\n");
439: 		}
440: 	}

