25: gate_begin "cross-family-execution"
26: need_exec "$GX"
27: command -v python3 >/dev/null 2>&1 || gate_skip "python3 not on PATH"
28: 
29: # run_rig <rig> <image> <expected answer> <note>
30: # The expected answer is a LITERAL here, not a value read back out of the driver's own
31: # output. Comparing the driver's VALUES against the driver's VALUES_WANT meant that when
32: # the driver produced neither, the check compared "" with "" and printed ok.
33: run_rig() {
34:     local rig=$1 img=$2 want=$3 note_txt=$4
35:     if [ ! -f "$img" ]; then
36:         degrade "$rig: image absent, rig did not run (see images.md)"
37:         return
38:     fi
39: 
40:     note "$rig -- $note_txt"
41:     local out=$LOGDIR/rig_$rig.out
42:     #  a4: bracket the driver so the gate knows an interval that STRICTLY CONTAINS the
43:     #  driver's own.  A containment row holds under any host load -- both intervals dilate
44:     #  together -- which is how BOOT_WALL gets a real check without a wall-clock THRESHOLD.
45:     local t0w=$(date +%s)
46:     python3 -u "$HERE/drive_guest.py" "$rig" "$GX" > "$out" 2>&1
47:     local t1w=$(date +%s)
48:     sed 's/^/       /' "$out"
49: 
50:     v() { grep -E "^$1=" "$out" | head -1 | cut -d= -f2-; }
51:     # *** vall() EXISTS BECAUSE v() TAKES head -1. *** A rig declaring two expect_values had
52:     # only its FIRST compared literally: landisk prints VALUES=SH7751R and VALUES=42, and the
53:     # second rode on the aggregate VERDICT alone. The records claimed this was "not a live
54:     # false pass today -- landisk declares one value"; landisk declares TWO, so the record
55:     # contradicted itself and the false half was the exculpatory one. Comparing the joined
56:     # list makes every declared answer load-bearing.
57:     vall() { grep -E "^$1=" "$out" | cut -d= -f2- | paste -sd, -; }
58:     check "$rig: reached boot milestone" "$(v BOOT_REACHED)" "1"
59:     check "$rig: every computed answer"  "$(vall VALUES)"    "$want"
60:     check "$rig: verdict"                "$(v VERDICT)"      "PASS"
61: 
62:     # #420: the boot milestone is now waited for against a budget of GUEST WORK rather than
63:     # host seconds, and the driver reports WHY it stopped. The old 600 s wall budget was a
64:     # LOAD-SENSITIVE ORACLE: reproduced under 8 busy loops on 8 cores, the unmodified driver
65:     # gave BOOT_REACHED=0 and three red rows at 601 s on a boot that was entirely healthy --
66:     # panic/FATAL/trap all zero, ordinary late rc output, 63.4% of the way to login. With
67:     # room to finish, the same load reached login at 720.8 s with every marker and both
68:     # computed values correct.
69:     #
70:     # EVERY non-MARKER reason is a hard FAIL here, and BACKSTOP especially. Gate 7 can treat
71:     # a wall-clock expiry as inconclusive because it boots three builds in one run, so
72:     # prebatch reaching its marker is free evidence the host was healthy. THIS GATE BOOTS ONE
73:     # GUEST PER RIG: there is nothing to compare against, "the host might have been slow" is
74:     # not falsifiable BY A COMPARABLE WITNESS, and an excuse nothing can contradict must not
75:     # soften a verdict.  (An adjudicating seat corrected the earlier wording "unfalsifiable":
76:     # NINSTRS at the backstop does PARTIALLY falsify host starvation, and the two rigs'
77:     # relative slowdowns cross-witness each other.  The hard-FAIL decision stands -- a partial
78:     # witness is not an A/B baseline -- but the justification should not overstate itself.)
79:     check "$rig: boot stopped at the milestone, not a budget or a hang" "$(v REASON)" "MARKER"
80: 
81:     # *** ASSERT THE COUNT, NEVER THE REASON. *** Removing -N leaves the guest booting
82:     # perfectly: every marker matches, every value is right, and REASON is legitimately
83:     # MARKER -- there is nothing wrong with the boot. The only observable difference is that
84:     # the budget and stall detectors were never armed. Measured on landisk, which has no race

