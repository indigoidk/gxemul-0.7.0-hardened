"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json,collections,re
j=json.load(open('tools/pipeline/ledger.json',encoding='utf-8'))
rows=j['rows']
wanted=set('pcc2widthkills wdcaddtoinbufbound gdromdmawidth gdromwarnbits landiskdisk ovsync wiringcliff diskimagesign probetimebased seatthinkburn wdcfloodstale lunaabsentcpu wdcflood pitclobber asiceventaddr'.split())
print('states',dict(collections.Counter(r.get('state') for r in rows)))
active=[r for r in rows if r.get('state') in ('open','in work')]
has=[r for r in active if r.get('commits')]
cited=[r for r in active if re.search(r'#\\s*\\d+',str(r.get('note',''))+str(r.get('witness','')))]
print('active',len(active),'has commits',len(has),'top note/witness round',len(cited),'both',len([r for r in has if r in cited]))
print('has IDs',[(r['id'],r.get('commits')) for r in has])
for r in rows:
 if r['id'] in wanted:
  print(json.dumps({k:v for k,v in r.items() if k"'!='"'entries'},ensure_ascii=True))
  print('LATEST ENTRY',json.dumps(r.get('entries',[])[-1:] ,ensure_ascii=True))
