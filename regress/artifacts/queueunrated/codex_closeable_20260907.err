1441: 
1442: 
1443: PITLOG=$LOGDIR/pit8253_latch.log
1444: python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PITLOG" 2>&1 || true
1445: 
1446: #  A PRESERVED LOG IS VERIFIED BY ITS COMPLETION SENTINEL, NOT BY ITS EXISTENCE.  The probe
1447: #  gained PIT8253_LATCH_DONE specifically so this row could be written correctly the first
1448: #  time -- before it, the last line was a bare "PASS", a word that occurs in dozens of other
1449: #  contexts and cannot distinguish a COMPLETED run from a TRUNCATED one.
1450: if ! grep -q "PIT8253_LATCH_DONE" "$PITLOG"; then
1451:     note "pit8253 probe did not reach its completion sentinel; last lines follow"
1452:     tail -5 "$PITLOG" | sed 's/^/       /'
1453:     check "pit8253 probe completed" "no" "yes"
1454: else
1455:     grep -E "^  (ok|FAIL) " "$PITLOG" | sed 's/^/       /'
1456: 
1457:     #  THE THREE CONTROLS PLUS THE MMU-ON NEGATIVE CONTROL, each pinned by name.  A count of
1458:     #  green rows would let a control go red while the total stayed acceptable.
1459:     for c in "C1 liveness" "C2 MMU state" "A1 device signature" "T  MMU-ON control"; do
1460:         check "pit8253 control: $c" \
1461:               "$(grep -c "^  ok   $c" "$PITLOG")" "1"
1462:     done
1463: 
1464:     #  Per-row presence.  A row that silently stops being tested is the padded-column class,
1465:     #  so each is checked individually rather than by a total.  Eighteen rows: 4 controls +

