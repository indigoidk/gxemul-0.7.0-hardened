254: 
255: /*
256:  *  sh_translate_sq_v2p():
257:  *
258:  *  #318: translate a store-queue address for the WRITE-BACK, which is the one
259:  *  store-queue access that goes through the UTLB.
260:  *
261:  *  sh_translate_v2p() maps the 0xe0000000..0xe3ffffff range identically and
262:  *  deliberately: that is how ordinary guest stores reach the modelled queue
263:  *  SRAM, so the range must never be routed through the MMU there. The flush
264:  *  triggered by `pref` is the exception to that, and it needs its own way in
265:  *  rather than a flag on the general entry point -- which has one caller, the
266:  *  dyntrans hook, whose signature is fixed.
267:  *
268:  *  #454: JUDGED AS A READ.  This paragraph used to say "Judged as a WRITE" and
269:  *  argue it from the dirty bit; the manual says the opposite, and it was not in
270:  *  this tree when that argument was made.  SH7750 Hardware Manual Rev.7.00 4.7.4
271:  *  "SQ Protection", p. 144 -- `_scratchpad/sh7750_hardware.txt:11744-11746`, and
272:  *  identically in the SH-4 programming manual 4.6.4 at
273:  *  `sh4_programming.txt:3561-3563`:
274:  *
275:  *	"Write type exception judgment is performed for writes to the SQs, and
276:  *	 read type for transfer from the SQs to external memory (PREF
277:  *	 instruction), and a TLB miss exception, protection violation
278:  *	 exception, or initial page write exception is generated."
279:  *
280:  *  The old argument had ONE false premise, and it is worth naming because a
281:  *  wrong reason gets reused: it assumed the PREF is the only access judged
282:  *  against an SQ page's entry.  4.7.4's FIRST clause supplies the other one.
283:  *  The dirty bit does stay meaningful, and a guest kernel does track the page --
284:  *  but at the STORE INTO the queue, not at the flush out of it.  4.7.4 can list
285:  *  the initial-page-write exception and still call the PREF a read because the
286:  *  sentence covers both halves; 3.6.7 defines that exception as occurring on
287:  *  "a data access (write)", so a read-type access cannot raise it at all.
288:  *
289:  *  *** WHAT THIS COSTS, STATED RATHER THAN GLOSSED: this emulator does not judge
290:  *  the write half AT ALL. ***  sh_translate_v2p() maps 0xe0000000..0xe3ffffff
291:  *  identically and unconditionally, because that is how an ordinary guest store
292:  *  reaches the modelled queue SRAM.
293:  *
294:  *  Precisely which faults go away, because an earlier draft of this paragraph
295:  *  said "an SQ page raises no MMU fault of any kind" and THIS ROUND'S OWN
296:  *  DETECTOR DISPROVES THAT -- `sq miss evt` observes a read-type TLB miss
297:  *  (0x040) on the fixed build.  What the PREF can still raise is the READ-side
298:  *  set: TLB miss, and a protection violation for a PR/privilege combination that
299:  *  forbids reading.  What disappears is the WRITE-side set: the initial-page-
300:  *  write exception (3.6.7 requires "a data access (write)", so read-type
301:  *  judgement cannot produce it) and write-side protection.  Those are exactly
302:  *  the two the store half owes, and the store half never runs.
303:  *
304:  *  Measured, with liveness and device-signature controls: a store into the
305:  *  window succeeds against a PR=00 read-only entry and against a clean one
306:  *  alike.  Filed as `sh4sqwrite`, which #454 makes the sole carrier of the
307:  *  WRITE-side SQ-page semantics -- not of all of them -- rather than a footnote
308:  *  in an archived audit.
309:  *
310:  *  (A panel seat read this as a load back when the tree had no manual, and was
311:  *  overruled.  It was right.)
312:  *
313:  *  Same return values as sh_translate_v2p().
314:  */
315: int sh_translate_sq_v2p(struct cpu *cpu, uint64_t vaddr, uint64_t *return_paddr,
316: 	int flags)
317: {
318: 	return translate_via_mmu(cpu, (uint32_t) vaddr, return_paddr, flags);
319: }
320: 
321: 
322: /*
323:  *  sh_translate_v2p():
324:  *
325:  *  Return values:
326:  *
327:  *	0	No access to the virtual address.
328:  *	1	return_paddr contains the physical address, the page is
329:  *		available as read-only.
330:  *	2	Same as 1, but the page is available as read/write.
331:  */
332: int sh_translate_v2p(struct cpu *cpu, uint64_t vaddr64, uint64_t *return_paddr,
333: 	int flags)
334: {
335: 	int user = cpu->cd.sh.sr & SH_SR_MD? 0 : 1;
336: 	uint32_t vaddr = vaddr64;
337: 
338: 	/*  U0/P0: Userspace addresses, or P3: Kernel virtual memory.  */
339: 	if (!(vaddr & 0x80000000) ||
340: 	    (vaddr >= 0xc0000000 && vaddr < 0xe0000000)) {
341: 		/*  Address translation turned off?  */
342: 		if (!(cpu->cd.sh.mmucr & SH4_MMUCR_AT)) {
343: 			/*  Then return raw physical address:  */
344: 			*return_paddr = vaddr & 0x1fffffff;
345: 			return 2;
346: 		}
347: 
348: 		/*  Perform translation via the MMU:  */
349: 		return translate_via_mmu(cpu, vaddr, return_paddr, flags);
350: 	}
351: 
352: 	/*  Store queue region:  */
353: 	if (vaddr >= 0xe0000000 && vaddr < 0xe4000000) {
354: 		/*  Note/TODO: Take SH4_MMUCR_SQMD into account.  */
355: 		*return_paddr = vaddr;
356: 		return 2;
357: 	}
358: 
359: 	if (user) {
360: 		if (flags & FLAG_NOEXCEPTIONS) {
361: 			*return_paddr = 0;
362: 			return 2;
363: 		}
364: 
365: 		// Hopefully correct behavior; nbjoerg on #GXemul (FreeNode)
366: 		// noticed that this case was easily triggered inside a
367: 		// guest OS, by:  int main(void){ *(int *)-4 = 0; }
368: 		sh_exception(cpu, (flags & FLAG_WRITEFLAG)?
369: 		    EXPEVT_TLB_MISS_ST : EXPEVT_TLB_MISS_LD, 0, vaddr);
370: 		return 0;
371: 	}
372: 
373: 	/*  P1,P2: Direct-mapped physical memory.  */
374: 	if (vaddr >= 0x80000000 && vaddr < 0xc0000000) {
375: 		*return_paddr = vaddr & 0x1fffffff;
376: 		return 2;
377: 	}
378: 
379: 	if (flags & FLAG_INSTR) {
380: 		fatal("TODO: instr at 0x%08" PRIx32"\n", (uint32_t)vaddr);
381: 		exit(1);
382: 	}
383: 
384: 	/*  P4: Special registers mapped at 0xf0000000 .. 0xffffffff:  */
385: 	if ((vaddr & 0xf0000000) == 0xf0000000) {
386: 		*return_paddr = vaddr;
387: 		return 2;
388: 	}
389: 
390: 	if (flags & FLAG_NOEXCEPTIONS) {
391: 		*return_paddr = 0;
392: 		return 2;
393: 	}
394: 
395: 	/*  TODO  */
396: 
397: 	/*  The ugly 'if' is just here to fool Compaq CC.  */
398: 	if (!(flags & FLAG_NOEXCEPTIONS)) {
399: 		fatal("Unimplemented SH vaddr 0x%08" PRIx32"\n", vaddr);
400: 		exit(1);
401: 	}
402: 
403: 	return 0;
404: }
