3715: 			}
3716: 		}
3717: 
3718: 		/*
3719: 		 *  #318: with the MMU on, the destination comes from the UTLB
3720: 		 *  and QACR takes no part -- it composes the address only when
3721: 		 *  translation is off, so the extaddr built above is discarded
3722: 		 *  here. This used to run ABORT_EXECUTION, stopping the
3723: 		 *  emulator on the ordinary way store queues are used with
3724: 		 *  paging enabled.
3725: 		 *
3726: 		 *  The UNMASKED operand is what gets translated, and that is
3727: 		 *  load-bearing twice over. It gives the fault the guest's
3728: 		 *  actual address for TEA; and translate_via_mmu passes a
3729: 		 *  page's in-page bits through untranslated, so masking its
3730: 		 *  RESULT to the 32-byte block is what produces the
3731: 		 *  architectural composition -- translated bits above, the
3732: 		 *  operand's own [9:5] preserved, [4:0] zero. Translating an
3733: 		 *  already-aligned address instead would silently drop [9:5].
3734: 		 *
3735: 		 *  The block cannot straddle a page: it is 32-byte aligned and
3736: 		 *  the smallest page is 1K, so the masked and unmasked
3737: 		 *  addresses always resolve through the same entry.
3738: 		 *
3739: 		 *  #454: JUDGED AS A READ, and the flag here used to say the
3740: 		 *  opposite.  4.7.4: "read type for transfer from the SQs to
3741: 		 *  external memory (PREF instruction)".  A read is the ABSENCE
3742: 		 *  of FLAG_WRITEFLAG -- this tree has no FLAG_READFLAG, and
3743: 		 *  memory_rw.c:249 builds the same thing as
3744: 		 *  (writeflag? FLAG_WRITEFLAG : 0).
3745: 		 *
3746: 		 *  The claim that used to sit here -- "there is no read-only
3747: 		 *  success to mishandle" -- was true only of the write flag.
3748: 		 *  Read-type judgement returns 1 for a privileged PR=00 page
3749: 		 *  and for a clean one, and the test below accepts 1 and 2
3750: 		 *  alike, so both complete the transfer.  That is the intended
3751: 		 *  behaviour and it is pinned by `sq pr00 rdok`/`sq d0 rdok`.
3752: 		 *
3753: 		 *  Passing FLAG_NOEXCEPTIONS here would be silent CORRUPTION,
3754: 		 *  not a softer failure: memory_sh.c's exception: label returns
3755: 		 *  2 with *return_paddr = 0, which this test reads as success,
3756: 		 *  and the 32-byte payload then lands at physical zero.  The
3757: 		 *  EXPEVT rows exist to catch exactly that.
3758: 		 */
3759: 		uint64_t paddr;
