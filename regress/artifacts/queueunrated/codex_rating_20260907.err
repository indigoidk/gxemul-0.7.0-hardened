3701: 		extaddr |= (((cpu->cd.sh.qacr1 >> 2) & 7) << 26);
3702: 
3703: 	// fatal("[ SH4 pref: SQ extaddr = 0x%08x (pc = 0x%08x) ]\n", extaddr, (int)cpu->pc);
3704: 
3705: 	// Is the MMU turned on?
