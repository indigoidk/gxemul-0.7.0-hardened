1065: 		if (!d->warned_unimpl_cmd) {
1066: 			d->warned_unimpl_cmd = 1;
1067: 			fatal("[ wdc: WARNING! Unimplemented command 0x%02x "
1068: 			    "(drive %i, head %i, cyl %i, sector %i, nsecs %i)"
1069: 			    " ]\n", d->cur_command, d->drive, d->head,
1070: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
1071: 		}
1072: 	}
1073: }
1076: DEVICE_ACCESS(wdc)
1077: {
1078: 	struct wdc_data *d = (struct wdc_data *) extra;
1079: 	uint64_t idata = 0, odata = 0;
1080: 	int i;
1082: 	relative_addr /= d->addr_mult;
1084: 	if (!d->io_enabled)
1085: 		goto ret;
1087: 	if (writeflag == MEM_WRITE) {
1088: 		if (relative_addr == wd_data)
1089: 			idata = memory_readmax64(cpu, data, len);
1090: 		else {
1093: 			if (len != 1 && !d->warned_nonbyte_write) {
1094: 				d->warned_nonbyte_write = 1;
1095: 				fatal("[ wdc: WARNING! non-8-bit access on "
1096: 				    "WRITE! ]\n");
1097: 			}
1098: 			idata = data[0];
1099: 		}
1100: 	}
1102: 	switch (relative_addr) {
1104: 	case wd_data:	
1105: 		if (writeflag == MEM_READ) {
1106: 			odata = wdc_get_inbuf(d);
1108: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1109: 				if (len >= 2)
1110: 					odata += (wdc_get_inbuf(d) << 8);
1111: 				if (len == 4) {
1112: 					odata += (wdc_get_inbuf(d) << 16);
1113: 					odata += (wdc_get_inbuf(d) << 24);
1114: 				}
1115: 			} else {
1116: 				if (len >= 2)
1117: 					odata = (odata << 8) + wdc_get_inbuf(d);
1118: 				if (len == 4) {
1119: 					odata = (odata << 8) + wdc_get_inbuf(d);
1120: 					odata = (odata << 8) + wdc_get_inbuf(d);
1121: 				}
1122: 			}
1124: 			if (d->data_debug) {
1125: 				const char *s = "0x%04" PRIx64" ]\n";
1126: 				if (len == 1)
1127: 					s = "0x%02" PRIx64" ]\n";
1128: 				if (len == 4)
1129: 					s = "0x%08" PRIx64" ]\n";
1130: 				if (len == 8)
1131: 					s = "0x%016" PRIx64" ]\n";
1132: 				debug("[ wdc: read from DATA: ");
1133: 				debug(s, (uint64_t) odata);
1134: 			}
1136: 			if (d->atapi_cmd_in_progress) {

PIT DETECTOR
1: #!/usr/bin/env python3
2: """Rung-3 cold-debugger witness for `pitlatch` / `pitclobber` (dev_8253.c).
3: 
4: Real guest ARM instructions, real address decode, real memory_rw, on an UNMODIFIED
5: in-tree `-E cats`.  No boot, no disk image, no guest OS, no device_add of our own.
6: 
7: REACHABILITY: machine_cats.c -> dev_footbridge.c:730 ("ali_m1543") -> bus_pci.c:459/476
8: sets isa_portbase 0x7c000000; bus_isa.c:241 registers "8253 ... addr=isa_portbase+0x40".
9: So the PIT lives at PA 0x7c000040..0x7c000043 (CNTR0..2, MODE).
10: 
11: THE MMU TRAP (footbridge_sites_probe.py's header documents it): machine_cats.c calls
12: arm_setup_initial_translation_table(), which maps only the low 256 MB, ignoring the top
13: VA nibble.  PA 0x7c000000 is outside that window, so under the boot MMU the device is
14: UNREACHABLE and a load returns 0 -- which is exactly what the pre-fix symptom looks like.
15: So arm T (the same program with the three MMU-disable words replaced by NOPs) MUST NOT
16: produce the device's answer.  Without arm T a "0" row proves nothing at all.
17: 
18: THREE ARMS.  D and F differ by EXACTLY TWO IMMEDIATES (the counter bytes), which is what
19: makes F a discriminator rather than a second opinion:
20: 
21:   D  counter <- 0x2e9c   TIMER_DIV(100), what OpenBSD clock.c:162-166 programs
22:   F  counter <- 0xffff   what findcpuspeed() (clock.c:333-335) programs, and it then
23:                          divides by (0xffff - gettick()) at clock.c:344.  If a design
24:                          makes the latched read return the reload value, that divisor
25:                          is ZERO.  F measures the divisor, so the hazard is a number
26:                          this probe prints, not an argument.
27:   T  MMU left on         negative control
28: 
29: #440 adds four more arms.  None of P/Z/I latches anything, so they measure the
30: LSB/MSB selector alone; L measures the latch and the selector where they meet.
31: 
32:   P  two 16-bit write pairs, count 0x2e9c   the selector was ONE-WAY, so it stuck
33:                                             at MSB and pair 2 put BOTH bytes in
34:                                             the high half: a third recompute the
35:                                             guest never asked for, and a readback
36:                                             of 0x2e2e instead of 0x2e9c
37:   Z  the same with count 0x2e00             low byte 0x00, so that intermediate
38:                                             counter is EXACTLY 0 -- the device is
39:                                             driven to 0 Hz by a guest that never
40:                                             programs count 0.  This is the door
41:                                             onto the separately-filed count-0
42:                                             defect, which is why it gets its own
43:                                             arm rather than a comment.
44:   I  the i8254 p. 8 interleave              "read LSB, write new LSB, read MSB,
45:                                             write new MSB", a documented-valid
46:                                             sequence.  It is the row that
47:                                             separates TWO flip-flops (correct)
48:                                             from ONE shared one -- the plausible
49:                                             smaller fix, which passes P and Z.
50:   L  latch, read, read, read, read          #439 set latched[] and cleared it only
51:                                             on a mode write, so one latch command
52:                                             made every later read return 0 for
53:                                             ever.  Reads 3 and 4 must return the
54:                                             counter again.  (Found by the #439
55:                                             pass-2 review.)
56: 
57: usage: pit8253_latch_probe.py <gxemul-binary> <four-byte-raw-stub> [--learn]
58: """
59: import os, pty, re, select, sys, time
60: 
61: BIN   = sys.argv[1]
62: STUB  = sys.argv[2]
63: LEARN = "--learn" in sys.argv
64: 
65: CODE = 0x00008000
192: 
193:     Counter is programmed to (hi<<8)|lo, then steps 1-4 rewrite it to 0x4011.
194:     """
195:     return PROLOGUE + [
196:     (0x40, MOVR1(0x34), MOVTXT(0x34),           ""),
197:     (0x44, STRB43[0],   STRB43[1],              "MODE <- 0x34  (rewinds both flip-flops)"),
198:     (0x48, MOVR1(lo),   MOVTXT(lo),             ""),
199:     (0x4c, STRB40[0],   STRB40[1],              "write LSB"),
200:     (0x50, MOVR1(hi),   MOVTXT(hi),             ""),
201:     (0x54, STRB40[0],   STRB40[1],              "write MSB -> counter = 0x2e9c"),
202:     (0x58, 0xE5D06040,  "ldrb r6,[r0,#64]",     "I1: step 1, read LSB       expect 0x9c"),
203:     (0x5c, MOVR1(0x11), MOVTXT(0x11),           ""),
204:     (0x60, STRB40[0],   STRB40[1],              "I2: step 2, write new LSB -> 0x2e11"),
205:     (0x64, 0xE5D07040,  "ldrb r7,[r0,#64]",     "I3: step 3, read MSB       expect 0x2e"),
206:     (0x68, MOVR1(0x40), MOVTXT(0x40),           ""),
207:     (0x6c, STRB40[0],   STRB40[1],              "I4: step 4, write new MSB -> 0x4011"),
208:     (0x70, 0xE5D02040,  "ldrb r2,[r0,#64]",     "I5: readback LSB   expect 0x11"),
209:     (0x74, 0xE5D09040,  "ldrb r9,[r0,#64]",     "I6: readback MSB   expect 0x40"),
210:     ]
211: 
212: 
213: def body_rewind(lo, hi, port, cw):
214:     """#440 PASS 2: does a Control Word rewind the WRITE flip-flop, for THIS counter?
215: 
216:     *** THE ONLY ARM THAT COVERS THE CONTROL-WORD REWIND.  Without it, deleting
217: 
218:             d->wr_msb[d->counter_select] = 0;
219: 
220:     passes every other row in this file. ***  Two seats found that mutant independently -- one
221:     by building it (readback 0x1140 for 0x4011, and the guest gets 265 Hz where it asked for
222:     73), one by reading -- and neither the write-pair arms nor the interleave arm can see it,
223:     because a COMPLETE pair returns the flip-flop to LSB on its own.  Only an ABANDONED pair
224:     leaves it at MSB where the rewind is the thing that matters.
225: 
226:     The sequence is the datasheet's own convention 1 (p. 8: "the Control Word must be written
227:     before the initial count is written"), applied to a counter left mid-pair:
228: 
229:         Control Word, write LSB, Control Word, write LSB, write MSB
230: 
231:     A correct model rewinds at the second Control Word, so the last two bytes are LSB then MSB
232:     and the counter reads back 0x4011.  Without the rewind the third write is taken as an MSB
233:     and the bytes land swapped.
234: 
235:     PARAMETERISED BY COUNTER on purpose.  The sibling mutant replaces d->counter_select with a
236:     literal 0 in the rewind, which a counter-0-only arm cannot see -- it too passed all ten
237:     rows.  The comment in dev_8253.c claims the rewind is "per counter, like the hardware", so
238:     the detector has to exercise a second counter or that sentence is unbacked.
239:     """
240:     strb = (0xE5C01000 | port, "strb r1,[r0,#%d]" % port)
241:     ldrb = lambda rn: (0xE5D00000 | (rn << 12) | port, "ldrb r%d,[r0,#%d]" % (rn, port))
242:     return PROLOGUE + [
243:     (0x40, MOVR1(cw),   MOVTXT(cw),             ""),
244:     (0x44, STRB43[0],   STRB43[1],              "MODE <- 0x%02x  (16-bit, this counter)" % cw),
245:     (0x48, MOVR1(lo),   MOVTXT(lo),             ""),
246:     (0x4c, strb[0],     strb[1],                "write LSB -- pair now HALF DONE"),
247:     (0x50, MOVR1(cw),   MOVTXT(cw),             ""),
248:     (0x54, STRB43[0],   STRB43[1],              "MODE <- 0x%02x AGAIN: abandons the pair" % cw),
249:     (0x58, MOVR1(0x11), MOVTXT(0x11),           ""),
250:     (0x5c, strb[0],     strb[1],                "write LSB -- MSB iff the rewind happened"),
251:     (0x60, MOVR1(0x40), MOVTXT(0x40),           ""),
252:     (0x64, strb[0],     strb[1],                "write MSB -> counter = 0x4011"),
253:     (0x68, ldrb(6)[0],  ldrb(6)[1],             "W1: readback LSB   expect 0x11"),
254:     (0x6c, ldrb(7)[0],  ldrb(7)[1],             "W2: readback MSB   expect 0x40"),
255:     ]
256: 
257: 
258: def body_latch(lo, hi):
259:     """#440: does a latch command RELEASE?  Program the counter, latch it, then
260:     read FOUR times.  Reads 1-2 are the two bytes the 16-bit format calls for and
261:     are 0 (there is no captured count -- #439, deliberately, unchanged here).
262:     Reads 3-4 must be the counter again: i8254 p. 7, the count "is held in the
263:     latch until it is read by the CPU ... then unlatched automatically".
264: 
265:     #439 cleared latched[] only on a mode write, so reads 3-4 stayed 0 for ever.
266:     """
267:     return PROLOGUE + [
268:     (0x40, MOVR1(0x34), MOVTXT(0x34),           ""),
269:     (0x44, STRB43[0],   STRB43[1],              "MODE <- 0x34"),
270:     (0x48, MOVR1(lo),   MOVTXT(lo),             ""),
271:     (0x4c, STRB40[0],   STRB40[1],              "CNTR0 LSB"),
272:     (0x50, MOVR1(hi),   MOVTXT(hi),             ""),
273:     (0x54, STRB40[0],   STRB40[1],              "CNTR0 MSB -> counter = 0x2e9c"),
274:     (0x58, MOVR1(0x00), MOVTXT(0x00),           "TIMER_SEL0|TIMER_LATCH"),
275:     (0x5c, STRB43[0],   STRB43[1],              "MODE <- 0x00  (LATCH counter 0)"),
276:     (0x60, 0xE5D06040,  "ldrb r6,[r0,#64]",     "K1: latched byte 1   expect 0x00"),
277:     (0x64, 0xE5D07040,  "ldrb r7,[r0,#64]",     "K2: latched byte 2   expect 0x00, RELEASES"),
278:     (0x68, 0xE5D02040,  "ldrb r2,[r0,#64]",     "K3: AFTER the latch  expect 0x9c, not 0"),
279:     (0x6c, 0xE5D09040,  "ldrb r9,[r0,#64]",     "K4: AFTER the latch  expect 0x2e"),
280:     ]
281: 
282: 
283: def body_mid(lo, hi):
284:     """#440: the LATCH lands BETWEEN the two halves of a 16-bit read pair.
285: 
286:     This is the one sequence where #439 and #440 actually meet, so it is measured
287:     rather than reasoned about.  Read 1 takes the LSB and advances the read
288:     flip-flop; the latch command then arrives mid-pair; read 2 is therefore the
289:     MSB half, which is the last byte the format calls for, so it both completes
290:     the guest's pair AND releases the latch.  The pair that follows must read
291:     normally again.
292: 
293:     Real hardware would hand back the latched count's high byte at read 2 where
294:     this returns 0x00 -- that is the documented "there is no live count" limit
295:     (#439), NOT a state-machine defect.  What this arm asserts is the STATE
296:     MACHINE: that the pair completes and the latch lets go.
297:     """
298:     return PROLOGUE + [
299:     (0x40, MOVR1(0x34), MOVTXT(0x34),           ""),
300:     (0x44, STRB43[0],   STRB43[1],              "MODE <- 0x34"),
301:     (0x48, MOVR1(lo),   MOVTXT(lo),             ""),
302:     (0x4c, STRB40[0],   STRB40[1],              "CNTR0 LSB"),
303:     (0x50, MOVR1(hi),   MOVTXT(hi),             ""),
304:     (0x54, STRB40[0],   STRB40[1],              "CNTR0 MSB -> counter = 0x2e9c"),
305:     (0x58, 0xE5D06040,  "ldrb r6,[r0,#64]",     "N1: first half of a read pair  expect 0x9c"),
306:     (0x5c, MOVR1(0x00), MOVTXT(0x00),           ""),
307:     (0x60, STRB43[0],   STRB43[1],              "MODE <- 0x00: LATCH, MID-PAIR"),
308:     (0x64, 0xE5D07040,  "ldrb r7,[r0,#64]",     "N2: second half  expect 0x00, RELEASES"),
309:     (0x68, 0xE5D02040,  "ldrb r2,[r0,#64]",     "N3: next pair LSB  expect 0x9c"),
310:     (0x6c, 0xE5D09040,  "ldrb r9,[r0,#64]",     "N4: next pair MSB  expect 0x2e"),
311:     ]
312: 
313: 
314: def tail_for(b):
315:     """#440: landing pad one word past whichever body was built -- the bodies are
316:     no longer all the same length.  Planted, never stepped."""
317:     return [(b[-1][0] + 4, NOP, NOPTXT, "landing pad -- planted, never stepped")]
318: 
319: 
320: REGS_OF_INTEREST = (0, 1, 2, 3, 5, 6, 7, 8, 9)
321: COMPLAINT = "huh? reading from counter"
322: #  #440: every recompute the device logs.  The FIRST match in every body is the
323: #  A1 signature's own 0x55AA; the ones under test follow it.
324: RECOMPUTE = re.compile(r"8253: counter 0 set to (\d+) \((\d+) Hz\)")
325: MMUOFF = ("D", "F", "P", "Z", "I", "L", "M")
326: 
327: 
328: def run_arm(prog):
329:     pid, fd = pty.fork()
330:     if pid == 0:
331:         os.execvp(BIN, [BIN, "-V", "-T", "-E", "cats", "-M", "32",
332:                         "0x%x:%s" % (CODE, STUB)])
333:         os._exit(127)
334:     buf = ""
335:     dead = [False]
336: 
337:     def rd(t=0.4):
338:         nonlocal buf
339:         r, _, _ = select.select([fd], [], [], t)
340:         if fd not in r:
341:             return True
342:         try:
343:             d = os.read(fd, 65536)
344:         except OSError:
345:             dead[0] = True
346:             return False
347:         if not d:
348:             dead[0] = True
349:             return False
350:         buf += d.decode("latin1", "replace")
351:         return True
352: 
353:     #  gate_hygiene.sh pins the CANONICAL #392 call form as a literal
354:     #  `return wait(mark=_mark, echo=<x> if <x> else None)`; timeout goes last.
355:     def wait(mark=0, echo=None, timeout=60):
356:         t = time.time()
357:         while time.time() - t < timeout:
358:             if not rd():
359:                 return False
360:             resp = buf[mark:]
361:             if echo is not None and echo not in resp:
362:                 continue
363:             if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
364:                 return True
365:         return False
366: 
367:     def send(x, timeout=60):
368:         b = (x + "\n").encode("latin1")
369:         _mark = len(buf)
370:         n = 0
371:         try:
372:             while n < len(b):
373:                 n += os.write(fd, b[n:])
374:         except OSError:
375:             dead[0] = True
376:             return False
377:         return wait(mark=_mark, echo=x if x else None)
378: 
379:     status, regs, badis, seen = "?", {}, [], []
380:     if not wait(timeout=120):
381:         status = "NO-PROMPT"
382:     else:
383:         send("put w 0x%08x, 0x%08x" % (DATA, 0x11223344))
384:         for off, word, _t, _c in prog:
385:             send("put w 0x%08x, 0x%08x" % (CODE + off, word))
386:         send("pc=0x%08x" % CODE)
387:         status = "SURVIVED"
388:         for off, word, text, _c in prog[:-1]:
389:             mark = len(buf)
390:             if not send("step 1", timeout=30) or dead[0]:
391:                 status = "HOST-DIED"
392:                 break
393:             seg = buf[mark:]
394:             m = re.search(r"%08x:\s+%08x\s+([^\r\n<]+)" % (CODE + off, word), seg)
395:             got = re.sub(r"\s+", " ", m.group(1)).strip() if m else "(no step line)"
396:             seen.append((off, word, got))
397:             if text is not None and got != text:
398:                 badis.append("0x%02x planted 0x%08x -> %r, expected %r"
399:                              % (off, word, got, text))
400:         if status == "SURVIVED":
401:             mark = len(buf)
402:             if send("reg", timeout=30) and not dead[0]:
403:                 for n in REGS_OF_INTEREST:
404:                     mm = re.search(r"\br%d\s*=\s*0x([0-9a-fA-F]+)" % n, buf[mark:])
405:                     if mm:
406:                         regs[n] = int(mm.group(1), 16)
407:             else:
408:                 status = "HOST-DIED" if dead[0] else "NO-REG"
409: 
410:     lines = re.findall(r"(\[[^\r\n\]]*8253[^\r\n\]]*\])", buf)
411:     try:
412:         os.write(fd, b"quit\n")
413:         time.sleep(0.3)
414:     except OSError:
415:         pass
416:     try:
417:         os.close(fd)
418:     except OSError:
419:         pass
420:     try:
421:         os.waitpid(pid, 0)
422:     except Exception:
423:         pass
424:     return status, regs, lines, badis, seen
425: 
426: 
427: ARMS = [
428:     ("D", MMU_OFF, body,       0x9c, 0x2e, "MMU off, counter 0x2e9c = TIMER_DIV(100)"),
429:     ("F", MMU_OFF, body,       0xff, 0xff, "MMU off, counter 0xffff = findcpuspeed() shape"),
430:     ("T", MMU_NOP, body,       0x9c, 0x2e, "MMU LEFT ON -- negative control"),
431:     ("P", MMU_OFF, body_flip,  0x9c, 0x2e, "#440 pitflip: two write pairs, 0x2e9c"),
432:     ("Z", MMU_OFF, body_flip,  0x00, 0x2e, "#440 pitflip: two write pairs, 0x2e00 (low byte 0)"),
433:     ("I", MMU_OFF, body_ilv,   0x9c, 0x2e, "#440 pitflip: the i8254 p.8 read/write interleave"),
434:     ("L", MMU_OFF, body_latch, 0x9c, 0x2e, "#440: is the counter latch ever RELEASED?"),
435:     ("M", MMU_OFF, body_mid,   0x9c, 0x2e, "#440: a LATCH mid-way through a 16-bit read pair"),
436:     #  #440 pass 2: TWO counters, because two DIFFERENT one-line mutants passed all ten rows
437:     #  without them -- dropping the write rewind, and hardcoding counter 0 in it.  Counter 2
438:     #  (port 66, Control Word 0xb6) is what makes "per counter" a measurement.
439:     ("W", MMU_OFF, lambda lo, hi: body_rewind(lo, hi, 64, 0x34), 0x9c, 0x2e,
440:      "#440 pass 2: Control Word rewinds the WRITE flip-flop, counter 0"),
441:     ("X", MMU_OFF, lambda lo, hi: body_rewind(lo, hi, 66, 0xb6), 0x9c, 0x2e,
442:      "#440 pass 2: ...and counter 2, so the rewind is per-counter"),
443: ]
444: 
445: #  #440: what each write-pair arm programmed, for the readback rows.
446: EXPECT = {"P": 0x2e9c, "Z": 0x2e00}
447: 
448: 
449: def main():
450:     print("=" * 76)
451:     print("pit8253 latch probe -- %s" % BIN)
452:     print("=" * 76)
453:     R = {}
454:     for name, head, bodyfn, lo, hi, desc in ARMS:
455:         b = bodyfn(lo, hi)
456:         st, regs, lines, bad, seen = run_arm(head + b + tail_for(b))
457:         R[name] = (st, regs, lines, bad)
458:         print("\n--- arm %s : %s ---" % (name, desc))
459:         print("    status %s" % st)
460:         if LEARN:
461:             for off, word, got in seen:
462:                 print("      0x%02x  %08x  %s" % (off, word, got))
463:         if bad and name != "T":       # arm T aborts at the first device access by design
464:             print("    *** DISASSEMBLY MISMATCH (hand-assembled-encoding trap) ***")
465:             for b in bad:
466:                 print("        " + b)
467:         print("    regs " + ", ".join("r%d=0x%x" % (n, v) for n, v in sorted(regs.items())))
468:         for c in dict.fromkeys(lines):
469:             print("      %-58s x%d" % (c, lines.count(c)))
470: 
471:     stD, rD, lD, badD = R["D"]
472:     stF, rF, lF, _    = R["F"]
473:     stT, rT, lT, _    = R["T"]
474:     rP, rZ, rI, rL, rM = (R[a][1] for a in ("P", "Z", "I", "L", "M"))
475: 
476:     def recomputes(a):
477:         """#440: (count, hz) per recompute in arm `a`, A1's own signature DROPPED.
478: 
479:         A1's write pair is always the first and always 0x55AA=21930 at 54 Hz.
480:         That is ASSERTED rather than assumed: if it ever moves, every index here
481:         silently shifts, and a row that counts recomputes would be counting the
482:         wrong ones while still going green.  None means "did not lead with A1".
483:         """
484:         out = [(int(m.group(1)), int(m.group(2)))
485:                for m in (RECOMPUTE.search(l) for l in R[a][2]) if m]
486:         return out[1:] if out[:1] == [(21930, 54)] else None
487: 
488:     def gettick(r):
489:         return (r.get(7, 0) << 8) | r.get(6, 0)
490: 
491:     print("\n" + "=" * 76)
492:     print("CONTROLS  (if any is RED every row below is meaningless)")
493:     print("=" * 76)
494:     ok = True
495: 
496:     def row(tag, good, detail):
497:         nonlocal ok
498:         ok &= bool(good)
499:         print("  %-4s %-44s %s" % ("ok" if good else "FAIL", tag, detail))
500: 
501:     #  #440: the controls now cover EVERY MMU-off arm, not just D.  P/Z/I/L carry
502:     #  new hand-assembled encodings and make their own device accesses; a control
503:     #  proved only on arm D says nothing whatever about them.
504:     def per_arm(fmt, f):
505:         return " ".join(fmt % (a, f(R[a][1])) for a in MMUOFF)
506: 
507:     row("C1 liveness", all(R[a][1].get(5) == 0x11223344 for a in MMUOFF),
508:         "RAM through the same decode " + per_arm("%s=0x%x", lambda r: r.get(5, -1)))
509:     row("C2 MMU state", all((R[a][1].get(3, 1) & 1) == 0 for a in MMUOFF),
510:         "CP15 c1 bit0 " + per_arm("%s=0x%x", lambda r: r.get(3, -1)))
511:     row("A1 device signature", all(R[a][1].get(8) == 0xAA for a in MMUOFF),
512:         per_arm("%s=0x%x", lambda r: r.get(8, -1)) + "  (RAM 0x55, absent 0x00)")
513:     row("T  MMU-ON control", rT.get(8) != 0xAA and not lT,
514:         "r8=0x%x, 8253 log lines=%d" % (rT.get(8, -1), len(lT)))
515:     row("E  encodings", not any(R[a][3] for a in MMUOFF),
516:         "disassembly mismatches " + " ".join("%s=%d" % (a, len(R[a][3])) for a in MMUOFF))
517:     row("A2 recompute stream", all(recomputes(a) is not None for a in MMUOFF),
518:         "A1's own 0x55AA recompute leads every arm: " +
519:         " ".join("%s=%s" % (a, "y" if recomputes(a) is not None else "NO") for a in MMUOFF))
520: 
521:     print("\n" + "=" * 76)
522:     print("MEASURED")
523:     print("=" * 76)
524:     for nm, r, l in (("D", rD, lD), ("F", rF, lF)):
525:         n = sum(x.count(COMPLAINT) for x in l)
526:         print("  arm %s   M1 mode_byte after programming  0x%02x" % (nm, r.get(9, -1)))
527:         print("          M2 mode_byte after LATCH        0x%02x   <- pitclobber"
528:               % r.get(2, -1))
529:         print("          L1/L2 latched bytes             0x%02x 0x%02x   <- pitlatch"
530:               % (r.get(6, -1), r.get(7, -1)))
531:         print("          gettick() would return          0x%04x" % gettick(r))
532:         print("          '%s' lines        %d" % (COMPLAINT, n))
533:         if nm == "F":
534:             d = 0xffff - gettick(r)
535:             print("          clock.c:344 divisor (0xffff-gettick) = %d %s"
536:                   % (d, "*** ZERO -> guest divide-by-zero ***" if d == 0 else "(nonzero, safe)"))
537:         print()
538: 
539:     #  ---------------------------------------------------------- #440 arms
540:     for a in ("P", "Z"):
541:         r = R[a][1]
542:         print("  arm %s   readback (r7<<8)|r6            0x%04x   (programmed 0x%04x)"
543:               % (a, (r.get(7, 0) << 8) | r.get(6, 0), EXPECT[a]))
544:         print("          mode_byte after 2 pairs        0x%02x" % r.get(9, -1))
545:         print("          recomputes after A1's          %s" % (recomputes(a),))
546:         print()
547:     print("  arm I   step1 read LSB  r6=0x%02x  (expect 0x9c)" % rI.get(6, -1))
548:     print("          step3 read MSB  r7=0x%02x  (expect 0x2e)" % rI.get(7, -1))
549:     print("          readback        0x%04x  (expect 0x4011)"
550:           % ((rI.get(9, 0) << 8) | rI.get(2, 0)))
551:     print()
552:     print("  arm L   latched bytes   r6=0x%02x r7=0x%02x  (expect 0x00 0x00)"
553:           % (rL.get(6, -1), rL.get(7, -1)))
554:     print("          AFTER the latch r2=0x%02x r9=0x%02x  (expect 0x9c 0x2e)"
555:           % (rL.get(2, -1), rL.get(9, -1)))
556:     print()
557:     print("  arm M   pair half 1     r6=0x%02x  (expect 0x9c) <- BEFORE the latch"
558:           % rM.get(6, -1))
559:     print("          pair half 2     r7=0x%02x  (expect 0x00) <- latched, releases"
560:           % rM.get(7, -1))
561:     print("          next pair       r2=0x%02x r9=0x%02x  (expect 0x9c 0x2e)"
562:           % (rM.get(2, -1), rM.get(9, -1)))
563:     print()
564: 
565:     print("=" * 76)
566:     print("VERDICT ROWS")
567:     print("=" * 76)
568:     nD = sum(x.count(COMPLAINT) for x in lD)
569:     #  ABSENT DATA MUST FAIL, NOT PASS.  The first draft compared rD.get(2) to
570:     #  rD.get(9); when the emulator never started, both were the -1 default and the
571:     #  row reported ok on a run that had measured nothing.  Every value a row
572:     #  consults is required to be present first.
573:     #  #440: R0 now demands EVERY arm, not just D and F -- an arm that never ran
574:     #  leaves .get() defaults behind, which is the same absent-data trap again.
575:     have = (all(k in rD for k in (2, 9))
576:             and all(R[a][0] == "SURVIVED" for a, *_ in ARMS)
577:             and all(recomputes(a) is not None for a in MMUOFF))
578:     row("R0 the run produced data", have,
579:         " ".join("%s=%s" % (a, R[a][0]) for a, *_ in ARMS))
580:     #  R1/R2 fail on the PRE-FIX build (that is the reproduction).  R3 passes pre-fix
581:     #  and post-fix but fails on the plausible OVER-fix -- un-clobbering mode_byte
582:     #  without also declining to hand back the reload value.  A detector that only
583:     #  had R1/R2 would go green on that mutant, which is the vacuity trap.
584:     row("R1 latch preserves programming", have and rD.get(2) == rD.get(9),
585:         "mode_byte after latch 0x%02x, after programming 0x%02x"
586:         % (rD.get(2, -1), rD.get(9, -1)))
587:     row("R2 latch is not an error", have and nD == 0,
588:         "%d '%s' lines" % (nD, COMPLAINT))
589:     row("R3 latched read is not the reload", have and (0xffff - gettick(rF)) != 0,
590:         "findcpuspeed divisor = %d" % (0xffff - gettick(rF)))
591: 
592:     #  ------------------------------------------------------ #440 pitflip rows
593:     #  Every one of these FAILS on the committed pre-#440 build; that is the
594:     #  reproduction.  R7 additionally fails on the plausible SMALLER fix (one
595:     #  flip-flop shared by reads and writes), which R4/R5/R6 all pass -- so R7 is
596:     #  the row that stops this being over-modelled by taste rather than measured.
597:     rb = lambda a: (R[a][1].get(7, 0) << 8) | R[a][1].get(6, 0)
598:     row("R4 16-bit readback is the reload",
599:         have and all(rb(a) == EXPECT[a] for a in ("P", "Z")),
600:         " ".join("%s=0x%04x/0x%04x" % (a, rb(a), EXPECT[a]) for a in ("P", "Z")))
601:     row("R5 one recompute per write pair",
602:         have and all(len(recomputes(a)) == 2 for a in ("P", "Z")),
603:         " ".join("%s=%d" % (a, len(recomputes(a))) for a in ("P", "Z")))
604:     row("R6 no transient count of zero",
605:         have and not [x for a in ("P", "Z") for x in recomputes(a) if x[0] == 0],
606:         "arm Z recomputes %s" % (recomputes("Z"),))
607:     row("R7 read and write flip-flops are separate",
608:         have and rI.get(6) == 0x9c and rI.get(7) == 0x2e
609:         and ((rI.get(9, 0) << 8) | rI.get(2, 0)) == 0x4011,
610:         "i8254 p.8 interleave: r6=0x%02x r7=0x%02x readback=0x%04x"
611:         % (rI.get(6, -1), rI.get(7, -1), (rI.get(9, 0) << 8) | rI.get(2, 0)))
612:     #  R9 is the ONE sequence where #439 and #440 meet, so it is measured.  Half 1
613:     #  must still be the LSB (pre-fix the selector was stuck at MSB and returned
614:     #  0x2e), half 2 completes the guest's pair AND releases, and the pair after it
615:     #  must read normally -- pre-fix it stayed 0x00 for ever.
616:     row("R9 a mid-pair latch completes the pair and lets go",
617:         have and rM.get(6) == 0x9c and rM.get(7) == 0x00
618:         and rM.get(2) == 0x9c and rM.get(9) == 0x2e,
619:         "halves 0x%02x 0x%02x then next pair 0x%02x 0x%02x"
620:         % (rM.get(6, -1), rM.get(7, -1), rM.get(2, -1), rM.get(9, -1)))
621:     #  #440 pass 2.  R10/R11 are the ONLY rows covering the control-word rewind; two seats
622:     #  independently produced one-line mutants that passed R0-R9 while swapping a legal
623:     #  guest's counter bytes.  R11 exists separately from R10 because the sibling mutant
624:     #  (a literal 0 for d->counter_select in the rewind) leaves counter 0 CORRECT and breaks
625:     #  only the others -- so a single-counter row cannot see it.
626:     rW, rX = R["W"][1], R["X"][1]
627:     row("R10 a Control Word rewinds the write flip-flop",
628:         all(k in rW for k in (6, 7)) and rW.get(6) == 0x11 and rW.get(7) == 0x40,
629:         "counter 0 readback 0x%02x%02x (expect 0x4011)" % (rW.get(7, 0), rW.get(6, 0)))
630:     row("R11 ...and it does so PER COUNTER, not just counter 0",
631:         all(k in rX for k in (6, 7)) and rX.get(6) == 0x11 and rX.get(7) == 0x40,
632:         "counter 2 readback 0x%02x%02x (expect 0x4011)" % (rX.get(7, 0), rX.get(6, 0)))
633: 
634:     row("R8 the latch is released by reading it",
635:         have and rL.get(6) == 0x00 and rL.get(7) == 0x00
636:         and rL.get(2) == 0x9c and rL.get(9) == 0x2e,
637:         "latched 0x%02x 0x%02x then 0x%02x 0x%02x (must not stay 0)"
638:         % (rL.get(6, -1), rL.get(7, -1), rL.get(2, -1), rL.get(9, -1)))
639: 
640:     print("\n  %s" % ("PASS" if ok else "FAIL"))
641: 
642:     #  *** A COMPLETION SENTINEL, ADDED BEFORE THIS PROBE IS GATE-WIRED RATHER
643:     #  THAN AFTER. ***  Until now the last thing this printed was a bare "PASS" or
644:     #  "FAIL" -- a word that occurs in dozens of other contexts and is therefore not
645:     #  uniquely greppable, so nothing downstream could tell a COMPLETED run from a
646:     #  TRUNCATED one.
647:     #
648:     #  This project's rule is that a preserved log is verified by its completion
649:     #  sentinel and not by its existence, and its measured cost is real: kill drivers
650:     #  that read neither exit status nor sentinel scored a CRASHED mutant purely by
651:     #  how far it got (`killdrivercrash`), and a probe that printed a score and then
652:     #  died would have been scored normally.
653:     #
654:     #  This probe is scheduled for gate 14 by 2026-09-20 (`wiringcliff`).  Adding the
655:     #  sentinel now means the gate row that wires it can be written correctly the
656:     #  first time, instead of shipping a check that cannot see a truncation.
657:     print("PIT8253_LATCH_DONE")
658:     sys.exit(0 if ok else 1)
659: 
660: 
661: main()

