102:          0..95   +0x00/04/08  CORRECT   pending_irq[0..2]
103:         96..127  +0x0c        DROPPED   r == 3, falls to default:
104:        128..223  +0x10/14/18  CLOBBER   mask_13[0..2]
105:        224..255  +0x1c        DROPPED
106:        256..351  +0x20/24/28  CLOBBER   mask_11[0..2]
107:        352..383  +0x2c        DROPPED
108:        384..479  +0x30/34/38  CLOBBER   mask_9[0..2]
109:        480..2047              DROPPED
110:         >= 2048  +0x100 up    leaves the device window (>= 6144 reaches MAPLE)
111:     THE CLOBBER DOMAIN IS e IN [128,479] -- 352 values across NINE mask words.
112:     A clobber is worse than a drop: the raise both FAILS and DESTROYS the guest's
113:     programmed IRQ mask, because the mask cases carry no hack-bit discrimination
114:     and the store is a wholesale replacement, with the tick called immediately.
115:     No bounds check can see it -- the offset is VALID and only the MEANING is wrong.
116: 
117:     Max over the 21 defines above is 67 (67>>5 == 2), so this is LATENT.
118:     Adding an event >= 96 makes it live.  See dev_dreamcast_asic.c's #463
119:     invariant comment, which reasons about the r == 3 half from the other
120:     side.  Filed as `asiceventaddr`.  */
121: /*  #468/#469: evaluates to 0 for a legal event and fails to COMPILE otherwise.  The
122:     domain is [0,95] and BOTH ENDS are enforced.
123: 
124:     *** #468 GUARDED ONLY THE UPPER END, AND A PASS-2 SEAT MEASURED THE HOLE
125:     WITHIN THE HOUR. ***  The first form tested `(e) < 96`, which -1 satisfies,
126:     so `SYSASIC_EVENT_TO_ADDR(-1)` COMPILED CLEAN and produced 0x005f68fc --
127:     four bytes BELOW SYSASIC_BASE, because `4*((-1)>>5)` is -4.  Reproduced
128:     here before fixing: the guard passed and the address was out of range.
129: 
130:     A guard written from the DEFECT (events too large) rather than from the
131:     DOMAIN ([0,95]) covers one end and reads as if it covers both.  The
132:     bitfield form is preferred over a negative-size array because a runtime
133:     variable `e` silently degrades an array to a VLA, while a bitfield width
134:     must be an integer constant and hard-errors.  */
135: #define	SYSASIC_EVENT_RANGE_OK(e)				\
136: 	((int)sizeof(struct { int sysasic_event_in_range :\
137: 		((e) >= 0 && (e) < 96) ? 1 : -1; }) * 0)
138: 
139: #define	SYSASIC_EVENT_TO_ADDR(e)				\
140: 	(SYSASIC_BASE + 4*((e)>>5) + SYSASIC_EVENT_RANGE_OK(e))
141: #define	SYSASIC_EVENT_TO_BITMASK(e)	(1 << ((e) & 31))
142: 
143: #define	SYSASIC_TRIGGER_EVENT(e)	{				\
144: 	uint8_t buf[8];							\
145: 	uint64_t tmp1 = SYSASIC_EVENT_TO_ADDR(e);			\
146: 	uint64_t tmp2 = SYSASIC_EVENT_TO_BITMASK(e);			\
147: 	tmp2 |= 0x100000000ULL;		/*  Internal GXemul hack  */	\
148: 	memory_writemax64(cpu, buf, 8, tmp2);				\
149: 	cpu->memory_rw(cpu, cpu->mem, tmp1, buf, 8,			\
150: 	    MEM_WRITE, PHYSICAL);					\
151: 	}
