sys.stdout.reconfigure(encoding='utf-8')
for p,a,b in [('GXEMUL-SEC/regress/asic_badaddr_probe.py',1,211),('GXEMUL-SEC/regress/gdrom_data_probe.py',1,500)]:
 s=open(p,encoding='utf-8').read(); tree=ast.parse(s)
 doclines=set()
 for node in ast.walk(tree):
  if isinstance(node,ast.Expr) and isinstance(node.value,ast.Constant) and isinstance(node.value.value,str): doclines.update(range(node.lineno,node.end_lineno+1))
 print('\\nFILE',p)
 for n,l in enumerate(s.splitlines(),1):
  if a<=n<=b and n not in doclines and l.strip() and not l.lstrip().startswith('#'): print(f'{n}: {l}')
