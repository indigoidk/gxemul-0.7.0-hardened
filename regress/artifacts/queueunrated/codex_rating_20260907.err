602: void sh_cpu_interrupt_deassert(struct interrupt *interrupt)
603: {
604: 	struct cpu *cpu = (struct cpu *) interrupt->extra;
605: 	int irq_nr = interrupt->line;
606: 	int index = irq_nr / 0x20;
607: 
608: 	/*  Deassert the interrupt:  */
609: 	if (cpu->cd.sh.int_prio_and_pending[index] & SH_INT_ASSERTED) {
610: 		cpu->cd.sh.int_prio_and_pending[index] &= ~SH_INT_ASSERTED;
611: 
612: 		/*  Calculate new interrupt assertion:  #458 lifted this loop
613: 		    into sh_recalc_int_to_assert() so the recompute path and
