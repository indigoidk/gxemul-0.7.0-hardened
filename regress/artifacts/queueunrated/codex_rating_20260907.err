115: 		i_start = -SH_N_ITLB_ENTRIES;
116: 	else
117: 		i_start = 0;
118: 
119: 	for (i=i_start; i<SH_N_UTLB_ENTRIES; i++) {
120: 		if (i<0) {
121: 			hi = cpu->cd.sh.itlb_hi[i + SH_N_ITLB_ENTRIES];
122: 			lo = cpu->cd.sh.itlb_lo[i + SH_N_ITLB_ENTRIES];
123: 		} else {
124: 			hi = cpu->cd.sh.utlb_hi[i];
125: 			lo = cpu->cd.sh.utlb_lo[i];
126: 		}
127: 		mask = 0xfff00000;
128: 
129: 		v = lo & SH4_PTEL_V;
130: 		if (!v)
131: 			continue;
132: 
133: 		switch (lo & SH4_PTEL_SZ_MASK) {
134: 		case SH4_PTEL_SZ_1K:  mask = 0xfffffc00; break;
135: 		case SH4_PTEL_SZ_4K:  mask = 0xfffff000; break;
136: 		case SH4_PTEL_SZ_64K: mask = 0xffff0000; break;
137: 		/*  case SH4_PTEL_SZ_1M:  mask = 0xfff00000; break;  */
138: 		}
139: 
140: 		if ((hi & mask) != (vaddr & mask))
141: 			continue;
142: 
143: 		sh = lo & SH4_PTEL_SH;
144: 
145: 		if (!sh && require_asid_match) {
146: 			int asid = hi & SH4_PTEH_ASID_MASK;
147: 			if (asid != cur_asid)
148: 				continue;
149: 		}
150: 
151: 		/*  Note/TODO: Check for multiple matches is not implemented. */
152: 
153: 		break;
154: 	}
155: 
156: 	/*  Virtual address not found? Then it's a TLB miss.  */
157: 	if (i == SH_N_UTLB_ENTRIES)
158: 		goto tlb_miss;
159: 
160: 	/*  Matching address found! Let's see whether it is
161: 	    readable/writable, etc.:  */
162: 	d = lo & SH4_PTEL_D? 1 : 0;
163: 	pr = (lo & SH4_PTEL_PR_MASK) >> SH4_PTEL_PR_SHIFT;
164: 
165: 	*return_paddr = (vaddr & ~mask) | (lo & mask & 0x1fffffff);
166: 
167: 	if (flags & FLAG_INSTR) {
168: 		/*
169: 		 *  Instruction access:
170: 		 */
171: #if 0
172: 		/*  NOTE: Emulating the ITLB as exact as this is not
173: 			necessary... so I'm disabling it for now.  */
174: 		/*
175: 		 *  If a matching entry wasn't found in the ITLB, but in the
176: 		 *  UTLB, then copy it to a random place in the ITLB.
177: 		 */
178: 		if (i >= 0 && !(flags & FLAG_NOEXCEPTIONS)) {
179: 			int r = random() % SH_N_ITLB_ENTRIES;
180: 
181: 			/*  NOTE: Make sure that the old mapping for
182: 			    that itlb entry is invalidated:  */
183: 			cpu->invalidate_translation_caches(cpu,
184: 			    cpu->cd.sh.itlb_hi[r] & ~0xfff, INVALIDATE_VADDR);
185: 
186: 			cpu->invalidate_code_translation(cpu,
187: 			    cpu->cd.sh.utlb_lo[i] & ~0xfff, INVALIDATE_PADDR);
188: 
189: 			cpu->cd.sh.itlb_hi[r] = cpu->cd.sh.utlb_hi[i];
190: 			cpu->cd.sh.itlb_lo[r] = cpu->cd.sh.utlb_lo[i];
191: 		}
192: #endif
193: 
194: 		/*  Permission checks:  */
195: 		if (cpu->cd.sh.sr & SH_SR_MD)
196: 			return 1;
197: 		if (!(pr & 2))
198: 			goto protection_violation;
199: 
200: 		return 1;
201: 	}
202: 
203: 	/*  Data access:  */
204: 	if (cpu->cd.sh.sr & SH_SR_MD) {
205: 		/*  Kernel access:  */
206: 		switch (pr) {
207: 		case 0:
208: 		case 2:	if (wf)
209: 				goto protection_violation;
210: 			return 1;
211: 		case 1:
212: 		case 3:	if (wf && !d)
213: 				goto initial_write_exception;
214: 			return 1 + d;
215: 		}
216: 	}
217: 
218: 	/*  User access  */
219: 	switch (pr) {
220: 	case 0:
221: 	case 1:	goto protection_violation;
222: 	case 2:	if (wf)
223: 			goto protection_violation;
224: 		return 1;
225: 	case 3:	if (wf && !d)
226: 			goto initial_write_exception;
227: 		return 1 + d;
228: 	}
229: 
230: 
231: tlb_miss:
232: 	expevt = wf? EXPEVT_TLB_MISS_ST : EXPEVT_TLB_MISS_LD;
233: 	goto exception;
234: 
235: protection_violation:
236: 	expevt = wf? EXPEVT_TLB_PROT_ST : EXPEVT_TLB_PROT_LD;
237: 	goto exception;
238: 
239: initial_write_exception:
240: 	expevt = EXPEVT_TLB_MOD;
241: 
242: 
243: exception:
244: 	if (flags & FLAG_NOEXCEPTIONS) {
245: 		*return_paddr = 0;
246: 		return 2;
247: 	}
248: 
249: 	sh_exception(cpu, expevt, 0, vaddr);
250: 
251: 	return 0;
252: }
