380: 
381: void sh_update_interrupt_priorities(struct cpu *cpu)
382: {
383: 	int i;
384: 
385: 	/*
386: 	 *  Set priorities of known interrupts, without affecting the
387: 	 *  SH_INT_ASSERTED bit:
388: 	 */
389: 
390: 	for (i=SH4_INTEVT_IRQ0; i<=SH4_INTEVT_IRQ14; i+=0x20) {
391: 		cpu->cd.sh.int_prio_and_pending[i/0x20] &= ~SH_INT_PRIO_MASK;
392: 		cpu->cd.sh.int_prio_and_pending[i/0x20] |= (15 - ((i - 
393: 		    SH4_INTEVT_IRQ0) / 0x20));
394: 	}
395: 
396: 	/*  #458: IPRA -- TMU0 [15:12], TMU1 [11:8], TMU2 [7:4], RTC [3:0].  The
397: 	    RTC nibble was never read: a source in a register this function DOES
398: 	    consult, left permanently at priority 0.  */
399: 	sh_set_int_prio(cpu, SH_INTEVT_TMU0_TUNI0,
400: 	    (cpu->cd.sh.intc_ipra >> 12) & 0xf);
401: 	sh_set_int_prio(cpu, SH_INTEVT_TMU1_TUNI1,
402: 	    (cpu->cd.sh.intc_ipra >> 8) & 0xf);
403: 	sh_set_int_prio(cpu, SH_INTEVT_TMU2_TUNI2,
404: 	    (cpu->cd.sh.intc_ipra >> 4) & 0xf);
405: 	sh_set_int_prio(cpu, SH_INTEVT_TMU2_TICPI2,
406: 	    (cpu->cd.sh.intc_ipra >> 4) & 0xf);
407: 	sh_set_int_prio(cpu, SH_INTEVT_RTC_ATI, cpu->cd.sh.intc_ipra & 0xf);
408: 	sh_set_int_prio(cpu, SH_INTEVT_RTC_PRI, cpu->cd.sh.intc_ipra & 0xf);
409: 	sh_set_int_prio(cpu, SH_INTEVT_RTC_CUI, cpu->cd.sh.intc_ipra & 0xf);
410: 
411: 	/*  #458: IPRB -- WDT [15:12], REF [11:8], SCI [7:4], reserved [3:0].  */
412: 	sh_set_int_prio(cpu, SH_INTEVT_WDT_ITI,
413: 	    (cpu->cd.sh.intc_iprb >> 12) & 0xf);
414: 	sh_set_int_prio(cpu, SH_INTEVT_REF_RCMI,
415: 	    (cpu->cd.sh.intc_iprb >> 8) & 0xf);
416: 	sh_set_int_prio(cpu, SH_INTEVT_REF_ROVI,
417: 	    (cpu->cd.sh.intc_iprb >> 8) & 0xf);
418: 	for (i=SH_INTEVT_SCI_ERI; i<=SH_INTEVT_SCI_TEI; i+=0x20)
419: 		sh_set_int_prio(cpu, i, (cpu->cd.sh.intc_iprb >> 4) & 0xf);
420: 
421: 	/*
422: 	 *  #458: IPRC -- GPIO [15:12], DMAC [11:8], SCIF [7:4], H-UDI [3:0].
423: 	 *
424: 	 *  *** SCIF MOVES HERE FROM intc_intpri08, AND FIVE SOURCES AGREE. ***
425: 	 *  Table 19.5 (:40036) gives it per-source at :40144 as "IPRC (7-4)" -- and
426: 	 *  those four SCIF rows print UNSTAGGERED, names adjacent to codes, so this
427: 	 *  particular citation is immune to the layout artefact described above;
428: 	 *  Table 19.6 (:40231) agrees; the SH-4 programming manual 5.6 lists SCIF among the
429: 	 *  modules set "in the interrupt priority registers (IPRA-IPRC)"; and this
430: 	 *  tree's OWN header says so -- sh4_intcreg.h:91, `IPRC_SCIF_MASK 0x00f0`.
431: 	 *
432: 	 *  INTPRI08 does not exist.  A full enumeration of the 1074-page manual
433: 	 *  returns INTPRI00 sixteen times and no other INTPRI register at all;
434: 	 *  INTPRI00 is SH7750R-only and covers TMU3/TMU4.  The old layout came from
435: 	 *  the SH7760, which cpu_sh_init's own comment admits, and no SH7760 is in
436: 	 *  SH_CPU_TYPE_DEFS.
437: 	 *
438: 	 *  It was also unreachable: SH4_INTPRI00 is 0xfe080000, outside the single
439: 	 *  registered window (SH4_REG_BASE + 0x01000000), so dev_sh4.c's INTPRI
440: 	 *  cases are dead code and intc_intpri08 kept its init value forever.  A
441: 	 *  MEASURED landisk boot shows the cost: the guest writes IPRC = 0x00c0 --
442: 	 *  SCIF priority 12 -- as `scif0: cons` attaches, and the model delivered
443: 	 *  priority 3 on all fifteen SCIF asserts of that boot.
444: 	 */
445: 	sh_set_int_prio(cpu, SH_INTEVT_GPIOI,
446: 	    (cpu->cd.sh.intc_iprc >> 12) & 0xf);
447: 	for (i=SH_INTEVT_DMTE0; i<=SH_INTEVT_DMAE; i+=0x20)
448: 		sh_set_int_prio(cpu, i, (cpu->cd.sh.intc_iprc >> 8) & 0xf);
449: 	for (i=SH4_INTEVT_SCIF_ERI; i<=SH4_INTEVT_SCIF_TXI; i+=0x20)
450: 		sh_set_int_prio(cpu, i, (cpu->cd.sh.intc_iprc >> 4) & 0xf);
451: 	sh_set_int_prio(cpu, SH_INTEVT_HUDI, cpu->cd.sh.intc_iprc & 0xf);
500: 	 */
501: 
502: 	/*
503: 	 *  #458: a raised priority must be able to deliver a request that is already
504: 	 *  standing.  Rewriting the nibbles without this leaves int_to_assert stale,
505: 	 *  which is `sh4prioraise`.
506: 	 *
507: 	 *  THE LIFT IS NOT BEHAVIOURALLY VERBATIM, and that is recorded rather than
508: 	 *  changed.  sh_cpu_interrupt_assert() selects with `int_to_assert == 0 ||
509: 	 *  prio > int_level`; this rescan selects with `prio > int_level` from a
510: 	 *  zeroed base, ascending index -- so running it on every IPR write
511: 	 *  RE-ARBITRATES, and ties now resolve to the lowest INTEVT code.  WITHIN an
512: 	 *  IPR group that matches Table 19.5's "Default Priority within IPR Setting
513: 	 *  Unit" column exactly (RTC ATI>PRI>CUI, SCI ERI>RXI>TXI>TEI, SCIF
514: 	 *  ERI>..>TXI, TMU2 TUNI2>TICPI2 -- all "High" at the low code).  ACROSS
515: 	 *  groups it does not: 19.5 ranks SCIF 0x700 above WDT 0x560, and the scan
516: 	 *  picks WDT.  Unwitnessable today and PRE-EXISTING in the deassert path --
517: 	 *  but this diff makes that path run far more often, so it is written down.
518: 	 */
519: 	sh_recalc_int_to_assert(cpu);
520: }
