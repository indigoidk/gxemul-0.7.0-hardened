394:     check "sh_pclock probe completed" "no" "yes"
395: else
396:     grep -E " ok$| FAIL$" "$PCLOG" | sed 's/^/       /'
397:     pcctrl=$(grep -o "SH_PCLOCK_CONTROL=[A-Z]*" "$PCLOG" | tail -1 | cut -d= -f2)
