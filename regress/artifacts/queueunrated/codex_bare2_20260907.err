317: #  Two of these rows read the priority TABLE rather than a delivery, and that is not
318: #  decoration: WDT, REF, SCI, GPIO, DMAC, H-UDI and RTC have NO `INTERRUPT_ASSERT`
319: #  anywhere in this tree, so a mutant dropping their mapping scores a clean 10/10
320: #  against every behavioural row that can be written.  Nothing a guest can DO depends
321: #  on those priorities -- only what the table SAYS.
322: IBLOG=$LOGDIR/gate_sh_iprbcd.log
323: python3 -u sh_iprbcd_probe.py "$PMAX" "$KERNEL" > "$IBLOG" 2>&1 || true
324: 
325: if ! grep -q "IPRBCD_RESULT=" "$IBLOG"; then
326:     note "sh_iprbcd probe produced no result line; last lines follow"
327:     tail -5 "$IBLOG" | sed 's/^/       /'
328:     check "sh_iprbcd probe completed" "no" "yes"
329: else
330:     grep -E " ok$| FAIL$" "$IBLOG" | sed 's/^/       /'
331:     ibctrl=$(grep -o "IPRBCD_CONTROL=[A-Z]*" "$IBLOG" | tail -1 | cut -d= -f2)
332:     check "sh_iprbcd control proves it measures" "${ibctrl:-missing}" "OK"
333:     ibres=$(grep -o "IPRBCD_RESULT=[0-9]*/[0-9]*" "$IBLOG" | tail -1 | cut -d= -f2)
334:     check "sh_iprbcd rows run"     "${ibres#*/}" 18
335:     check "sh_iprbcd rows correct" "${ibres%/*}" "${ibres#*/}"
336:     #  `naive` is pinned deliberately as a LABELLED row: writing one IPR and expecting
337:     #  delivery is GREEN on the unfixed build, so it fails vacuity floor clause (a).  It
338:     #  ships so nobody re-invents it; `iprc_hi`/`iprc_lo`/`iprc_lo1` are what discriminate,
339:     #  by BRACKETING IMASK -- delivery needs IMASK < int_level, so a pair of rows at two
340:     #  IMASK values pins the level to a range instead of to "nonzero".
341:     #
342:     #  `iprb wdt` / `ipra rtc` are the two table-reading rows.  MEASURED: dropping the
343:     #  IPRB+RTC mapping reddens THESE TWO AND NOTHING ELSE (10/12 -- a TWELVE-ROW-ERA
344:     #  number, measured before the iprd pair was added), and dropping only the
345:     #  three RTC lines reddens `ipra rtc` alone.  Without them the settings exposure
387: #  self-announcing, so the rows below rebuild it deliberately on both sides.
388: PCLOG=$LOGDIR/gate_sh_pclock.log
