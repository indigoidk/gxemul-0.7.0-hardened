356: TMU_SPIN = 30.0
359: def landisk_tmu():
360:     """Arm TMU0's underflow interrupt with IPRA untouched, then free-run.
362:     TCR0 = TCR_UNIE, which PASSES #447's guard (TCR_UNIMPLEMENTED is 0x02DC and
363:     UNIE is 0x0020, not in that mask), so this is a legal write that a driver makes.
364:     TCOR0/TCNT0 are tiny so the first host callback underflows.  `bra .` parks the
365:     guest in a self-loop so the run is bounded by wall clock rather than by
366:     instructions.
367:     """
368:     c = ["r1=0xffd80010", "r2=0x00000020",          # TCR0  = UNIE
369:          "r3=0xffd80008", "r4=0x00000002",          # TCOR0 = 2
370:          "r5=0xffd8000c", "r6=0x00000002",          # TCNT0 = 2
371:          "r7=0xffd80004", "r8=0x00000001",          # TSTR  = start
372:          "put h 0x%x, 0x2122" % LANDISK_CODE,       # mov.l r2,@r1
373:          "put h 0x%x, 0x2342" % (LANDISK_CODE + 2),  # mov.l r4,@r3
374:          "put h 0x%x, 0x2562" % (LANDISK_CODE + 4),  # mov.l r6,@r5
375:          "put h 0x%x, 0x2782" % (LANDISK_CODE + 6),  # mov.l r8,@r7
376:          "put h 0x%x, 0xaffe" % (LANDISK_CODE + 8),  # bra .
377:          "put h 0x%x, 0x0009" % (LANDISK_CODE + 10),  # nop (delay slot)
378:          "pc=0x%x" % LANDISK_CODE, "step 4"]
379:     return c
