186: 
187: def store_code(at, reg, value, op=MOV_W_R8_AT_R7):
188:     """r7 <- reg, r8 <- value, one store, then spin."""
189:     return ["r7=0x%x" % reg, "r8=0x%08x" % value,
190:             "put h 0x%x, 0x%04x" % (at, op),
191:             "put h 0x%x, 0x%04x" % (at + 2, BRA_SELF),
192:             "put h 0x%x, 0x%04x" % (at + 4, NOP),
193:             "pc=0x%x" % at]
194: 
195: 
196: #  ---------------------------------------------------------------- controls
197: #  NEITHER control writes TCR.  If the trigger row goes red they stay green,
198: #  which is what makes the red attributable.
199: 
200: #  Read back through a GUEST LOAD, not the debugger's dump.  The first draft
201: #  dumped memory and compared against 0x12345678; it got 0x78563412, because a
202: #  byte dump is endian-ordered and the comparison was not.  A guest load and a
203: #  register read are endian-neutral by construction, and the asymmetric value is
204: #  what made the mistake visible at all.
