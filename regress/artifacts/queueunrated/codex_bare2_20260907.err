339: /*
340:  *  #458: set one source's priority nibble, leaving SH_INT_ASSERTED alone.
341:  */
342: static void sh_set_int_prio(struct cpu *cpu, int intevt, int prio)
343: {
344: 	cpu->cd.sh.int_prio_and_pending[intevt / 0x20] &= ~SH_INT_PRIO_MASK;
345: 	cpu->cd.sh.int_prio_and_pending[intevt / 0x20] |=
346: 	    prio & SH_INT_PRIO_MASK;
347: }
348: 
349: 
350: /*
351:  *  #458: recompute int_to_assert / int_level from the whole table.  Lifted
352:  *  VERBATIM out of sh_cpu_interrupt_deassert(), which now calls it too, so the
353:  *  two paths cannot drift apart.
354:  *
355:  *  No re-entrancy hazard: it touches only cpu->cd.sh.* and invokes no device
356:  *  callback and no INTERRUPT_ASSERT.  At init it yields 0/0, which is correct --
357:  *  but NOT because the table is empty: the hardwired loop has already written
358:  *  priorities 15..1 into the IRQ slots.  It yields 0/0 because the scan requires
359:  *  SH_INT_ASSERTED and nothing has asserted yet.  (Stated precisely because a
360:  *  wrong reason gets reused, and a priority alone must never arbitrate.)
361:  */
362: static void sh_recalc_int_to_assert(struct cpu *cpu)
363: {
364: 	int index;
365: 
366: 	cpu->cd.sh.int_to_assert = 0;
367: 	cpu->cd.sh.int_level = 0;
368: 
369: 	/*  NOTE/TODO: This is slow, but should hopefully work:  */
370: 	for (index=0; index<0x1000/0x20; index++) {
371: 		uint8_t x = cpu->cd.sh.int_prio_and_pending[index];
372: 		uint8_t prio = x & SH_INT_PRIO_MASK;
373: 		if (x & SH_INT_ASSERTED && prio > cpu->cd.sh.int_level) {
374: 			cpu->cd.sh.int_to_assert = index * 0x20;
375: 			cpu->cd.sh.int_level = prio;
376: 		}
377: 	}
378: }
