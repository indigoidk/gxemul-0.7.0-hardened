83:  *
84:  *  WHAT IT SAID: 'the extent and the guard are the same identifier, and that is
85:  *  the only structural defence there is', with GDROM_NKEYS used in BOTH the
86:  *  array declaration and the helper's guard.  At HEAD each NKEYS macro is used
87:  *  in exactly ONE place, and the guard is bound by `sizeof(arr) * 8` inside
88:  *  GDROM_UNIMPL_FIRST -- see the pass-2 block below, which explains why: the
89:  *  same-identifier property was true of the NUMBER and false of the BINDING,
90:  *  and a seat passed a matching count with a MISMATCHED array to prove it.
91:  *
92:  *  The reasoning below is kept because it is still correct and still the reason
93:  *  the macro exists:
94:  *  STRUCTURAL DEFENCE THERE IS. ***  A pass-1 seat measured that a bounds check
95:  *  written as a bare literal is DEAD CODE here: memory_rw.c gates dispatch on
96:  *  the registered range and then subtracts, so relative_addr < the window size
97:  *  is guaranteed before this device is ever entered, and `if (off >= 0x100)`
98:  *  can never fire.  #443 is safe only because its guard constant ALSO dimensions
99:  *  its array -- its own comment says the check is not what protects it.  So the
100:  *  macros below each name a key count.  (The claim that they are used in BOTH
101:  *  places belonged to the first design and is false at HEAD -- see above.)
102:  *
103:  *  WORD-GRANULAR KEYS, not per-byte.  The implemented offsets are ATA task-file
104:  *  registers at 4-byte stride, so a word key matches the hardware's own register
105:  *  granularity, and a byte scan yields 56 useful lines rather than 224.  It is
106:  *  also what makes the raw-address indexing mutant DETECTABLE -- under per-byte
107:  *  keying there is no granularity row to write and that mutant is invisible.
108:  *
109:  *  TWO DIRECTION CLASSES, and this was MEASURED against a 3-1 panel vote for
110:  *  one.  A read pass then a write pass over the same 31 declined offsets gives
111:  *  62 lines with direction keyed and 31 WITH ZERO WRITE DIAGNOSTICS without it:
112:  *  the read pass latches every offset first, so a guest's stores into
113:  *  unimplemented space are reported nowhere.  The write line is also the only
114:  *  one carrying `idata`, which is the value needed to model the register later.
115:  *
116:  *  SEPARATE ARRAYS PER WINDOW, not one shared.  The two windows' relative_addr
117:  *  ranges OVERLAP -- control is 0x00-0xff and DMA is 0x00-0x7f -- so a shared
118:  *  key would make a declined access at control+0x00 silence one at DMA+0x00,
119:  *  with the two keys being literally the same integer.  Invisible by
120:  *  construction, which is #451's hazard one level up.
121:  */
122: #define	GDROM_RD		0
123: #define	GDROM_WR		1
124: #define	GDROM_NDIR		2
125: #define	GDROM_NKEYS	(0x100 / sizeof(uint32_t))
126: #define	GDROM_DMA_NKEYS	(0x80 / sizeof(uint32_t))
127: #define	GDROM_BITWORDS(n)	(((n) + 31) / 32)
128: 
129: struct dreamcast_gdrom_data {
130: 	// 0x005f7000: GDROM control registers
131: 	uint8_t		busy;		/*  Busy status  */
132: 	uint8_t		stat;		/*  Status  */
133: 	int		cnt;		/*  Data length in bytes  */
134: 	uint8_t		cond;
135: 
136: 	int		cmd_count;
137: 	uint8_t		cmd[12];
138: 
139: 	uint8_t		*data;
140: 	int		data_len;
141: 	int		cur_data_offset;
142: 	int		cur_cnt;
143: 
144: 	/*
145: 	 *  #460: once-only diagnostic latch, ONE BIT PER SITE.
146: 	 *
147: 	 *  Modelled on dev_wdc.c's `warned_badlen` (#337) FOR THE MECHANISM ONLY
148: 	 *  -- note that dev_wdc.c SHARES one flag between its two sites (:731
149: 	 *  and :761), so the per-site decision below is this round's own measured
150: 	 *  warrant and must not be attributed to that precedent.  Not on
151: 	 *  sh4_val_first().  A review seat named the reason: dev_wdc.c is this
152: 	 *  tree's OTHER ATA/ATAPI data port and fixed this exact class the same
153: 	 *  way, while sh4_val_first() is an SH4 helper whose storage lives in
154: 	 *  sh4_data -- and the GD-ROM is on the Holly/G1 bus, not the SH4.
155: 	 *
156: 	 *  Per-site and not one shared bit, MEASURED: a shared bit scores
157: 	 *  identically on every row that drives ONE site per session -- which
158: 	 *  was every row this detector had -- and diverges only when two sites
159: 	 *  run in one session, where it loses the second diagnostic for good.
160: 	 */
161: 	uint32_t	warned;
162: 
163: 	/*
164: 	 *  #461: one bit per (direction, word) for each window's default arm.
165: 	 *  16 + 8 = 24 bytes.
166: 	 *
167: 	 *  KEPT SEPARATE FROM #460's `warned` ABOVE, deliberately: those four bits
168: 	 *  key on a CONDITION at a single offset (0x80), so an offset key cannot
169: 	 *  separate them.  #443 could unify its three classes only because all of
170: 	 *  them key on the register offset.  A reviewer will ask; this is why.
171: 	 */
172: 	uint32_t	unimpl_reported[GDROM_NDIR][GDROM_BITWORDS(GDROM_NKEYS)];
173: 	uint32_t	dma_unimpl_reported[GDROM_NDIR][GDROM_BITWORDS(GDROM_DMA_NKEYS)];
174: 
175: 	// 0x005f7400: GDROM DMA
176: 	uint32_t	dma_reg[NREGS_GDROM_DMA];
177: };
178: 
179: /*  Register offsets, from NetBSD:  */
180: #define	GDROM_BUSY		0x18
181: #define	GDROM_DATA		0x80
182: 
183: #define	GDROM_REGX		0x84
184: #define	GDROM_UNKNOWN_0x88	0x88
185: #define	GDROM_STAT		0x8c
186: #define	GDROM_CNTLO		0x90
187: #define	GDROM_CNTHI		0x94
188: #define	GDROM_COND		0x9c
189: 
190: /*
191:  *  #460: one warn-once bit per declined site.  Named constants rather than
192:  *  bare numbers, so a new site cannot silently reuse another's bit -- the
193:  *  duplicate-key hazard this project already paid for once in dev_sh4.c.
194:  */
195: /*
196:  *  *** THE PRE-SET TRIGGER BELOW HAS FIRED, AND THIS IS IT BEING DISCHARGED. ***  (It said
197:  *  ABOVE until 2026-08-28; the trigger is BELOW, at the `SIX OF EIGHT BITS` block.  A
198:  *  pointer naming the wrong direction is a small wrong record of the kind a future reader
199:  *  gives up on -- the opus seat caught it on this row's assess panel.)  It was
200:  *  written as "at the SEVENTH bit"; `gdromexitsix` Round 1 adds THREE latches to the six
201:  *  below, so the NINTH would be `1u << 8` -- truncating to zero in a uint8_t, never
202:  *  setting, and letting the diagnostic it guards FLOOD.  No compile error, no runtime
203:  *  complaint.  Two review seats reached it independently on that round's pass 1.
204:  *
205:  *  BIT POSITIONS, not hand-assigned masks: GDROM_W_NBITS is then correct BY CONSTRUCTION
206:  *  rather than by maintenance, and an ACCIDENTAL duplicate position is impossible to write.
207:  *  *** THAT CLAUSE READ "a duplicate is impossible to write" AND WAS TOO STRONG.  Corrected
208:  *  on the assess panel, where the opus and fable seats objected to it independently. ***  C
209:  *  permits an explicit duplicate enumerator, and nothing here stops a NEW SITE spelling a raw
210:  *  `d->warned |= 0x40` that collides with the seventh enumerator when it arrives.  What
211:  *  implicit numbering buys is that no two enumerators written in the normal way can collide,
212:  *  and that the count stays synchronised with them -- which is worth having and is less than
213:  *  the original sentence claimed.  The CAPACITY half is enforced separately, below.  The masks
214:  *  reproduce 0x01..0x20 exactly, in the same order -- checked mechanically by the script
215:  *  that made this edit, not asserted here.
216:  *
217:  *  `warned` widens from uint8_t to uint32_t in the same change, because an enum that can
218:  *  count past 8 is no use if the field it indexes cannot hold the bit.
219:  *
220:  *  Precedent transferred rather than invented: dev_sh4.c did the equivalent conversion for
221:  *  its value-class keys on its own pre-set trigger ("when a tenth class arrives").
222:  */
223: enum {
224: 	GDROM_W_LEN_B,	/*  was 0x01  */
225: 	GDROM_W_NODATA_B,	/*  was 0x02  */
226: 	GDROM_W_NOTWAIT_B,	/*  was 0x04  */
227: 	GDROM_W_OVERREAD_B,	/*  was 0x08  */
228: 	GDROM_W_DMANODATA_B,	/*  was 0x10  */
229: 	GDROM_W_DMAARM_B,	/*  was 0x20  */
230: 	GDROM_W_TOCLEN_B,	/*  #489: the SEVENTH, and the bit the trigger was set for  */
231: 	GDROM_W_FMT_B,		/*  #490: case 0x30's data-format decline  */
232: 	GDROM_W_CMD_B,		/*  #490: the default: unimplemented-command decline  */
233: 	GDROM_W_88VAL_B,	/*  #496: GDROM_UNKNOWN_0x88's bad-value decline  */
234: 	GDROM_W_CONDVAL_B,	/*  #496: GDROM_COND's bad-value decline  */
235: 	GDROM_W_NBITS
236: };
237: 
238: #define	GDROM_W_LEN	(1u << GDROM_W_LEN_B)
239: #define	GDROM_W_NODATA	(1u << GDROM_W_NODATA_B)
240: #define	GDROM_W_NOTWAIT	(1u << GDROM_W_NOTWAIT_B)
241: #define	GDROM_W_OVERREAD	(1u << GDROM_W_OVERREAD_B)
242: #define	GDROM_W_DMANODATA	(1u << GDROM_W_DMANODATA_B)
243: #define	GDROM_W_DMAARM	(1u << GDROM_W_DMAARM_B)
244: #define	GDROM_W_TOCLEN	(1u << GDROM_W_TOCLEN_B)
245: #define	GDROM_W_FMT	(1u << GDROM_W_FMT_B)
246: #define	GDROM_W_CMD	(1u << GDROM_W_CMD_B)
247: #define	GDROM_W_88VAL	(1u << GDROM_W_88VAL_B)
248: #define	GDROM_W_CONDVAL	(1u << GDROM_W_CONDVAL_B)
249: 
250: /*
251:  *  *** #490: TWO BITS, NOT ONE, AND THAT IS MEASURED RATHER THAN TIDY. ***
252:  *
253:  *  The measuring seat built the one-bit form (`M3shared`) and it ESCAPED a detector that
254:  *  otherwise passed: a session declining at BOTH sites sees the second site fall silent,
255:  *  because the first already latched.  Separate bits, and a row (`both sites`) that trips
256:  *  both in one session.
257:  *
258:  *  *** AND THE COLLISION SURFACE IS WIDER THAN THIS PAIR.  `d->warned` now has NINE
259:  *  writers sharing one field, and SIX of the pre-existing ones are set from inside
260:  *  DEVICE_ACCESS by ordinary guest register reads *** -- `GDROM_W_OVERREAD` is set by the
261:  *  benign TOC-then-Mount-then-read sequence a shipped probe already exercises.  So a bit
262:  *  COLLISION here is not announced by anything: the wrong bit is simply already set, and
263:  *  the decline goes silent under traffic that looks entirely normal.  `Ma_toclen` and
264:  *  `Mb_toclen` measured exactly that, and `crossbit` is the row that sees it.
265:  *
266:  *  Note the pre-table GUARD-FIELD check cannot catch this class: it asks where the guard
267:  *  field and the body field DIFFER, and here they are the SAME field.  For a shared
268:  *  bitfield the question is "who else writes this field, and can they set my bit?"
269:  */
270: 
271: /*
272:  *  *** THE COUNT-FITS-ITS-CARRIERS BOUND, AS A COMPILE ERROR RATHER THAN A SENTENCE. ***
273:  *  Added on the gdromwarnbits assess panel, where the OPUS and FABLE seats derived it
274:  *  independently and each MEASURED the case against it.
275:  *
276:  *  The comment above says GDROM_W_NBITS is "correct BY CONSTRUCTION".  That is true of the
277:  *  COUNT -- the compiler numbers the enumerators -- and it says nothing about whether those
278:  *  positions FIT.  Nothing in the product build enforced that, and the offline
279:  *  mask_equivalence_check.c cannot: it compiles a REPLICA of this enum, so adding bits to
280:  *  the product leaves the artifact's private NBITS at six forever.  A drift that matters
281:  *  therefore leaves the offline check completely GREEN.
282:  *
283:  *  *** THE OBVIOUS FORM WAS MEASURED WRONG AND IS NOT WHAT IS WRITTEN HERE. ***  A guard
284:  *  spelled `GDROM_W_NBITS <= 32` COMPILES CLEAN over a `uint8_t warned` carrying a live
285:  *  `1u << 8` truncation -- measured on this build's compiler at -std=c99 -pedantic-errors
286:  *  -Wall -Wextra.  It is written from the DEFECT (too many bits) instead of from the DOMAIN
287:  *  (the bits must fit the things that carry them), which is the exact failure
288:  *  thirdparty/dreamcast_sysasicvar.h names for #466: "a guard written from the DEFECT
289:  *  rather than from the DOMAIN covers one end and reads as if it covers both."
290:  *
291:  *  TWO clauses, because there are TWO carriers and storage width alone does not imply the
292:  *  other:
293:  *    1. `warned` must be able to HOLD the bit -- the half mask_equivalence_check.c is blind
294:  *       to, and the half a one-token revert of this diff (uint32_t -> uint8_t) attacks.
295:  *    2. `1u` must be able to PRODUCE it -- every mask above shifts `1u`, and `1u << 32` is
296:  *       undefined however wide `warned` becomes.  A `uint64_t` field would satisfy clause 1
297:  *       at 40 bits while clause 2 correctly refuses.
298:  *
299:  *  C99-legal and precedented in product code rather than invented here: the negative-size
300:  *  typedef is #388's shape at cpus/cpu_mips.c (two sites) and cpus/memory_rw.c, whose own
301:  *  licence sentence transfers verbatim -- "a static assertion costs nothing and covers the
302:  *  build the test cannot reach."  The bitfield spelling used by dreamcast_sysasicvar.h is
303:  *  needed only where the operand can be a runtime variable; an enum constant cannot be.
304:  *  (And "this tree is C99" is a portability policy, not a fact about what compiles --
305:  *  sysasicvar.h records the build compiler reporting __STDC_VERSION__ 202311L.)
306:  *
307:  *  *** AND THIS IS NOT AN ADDED GUARD.  IT IS GDROM_W_NBITS'S FIRST CONSUMER. ***  The
308:  *  opus seat measured that the count had ZERO references anywhere -- it sized nothing and
309:  *  bounded nothing, and DELETING it compiled clean.  So the "correct BY CONSTRUCTION"
310:  *  claim above rested on a decorative symbol.  Under this project's addition licence that
311:  *  matters: this is not accretion needing a warrant, it is the L4 repair that makes an
312:  *  already-shipped claim true.
313:  *
314:  *  *** THE dev_sh4.c PRECEDENT TRANSFERS ON SHAPE AND NOT ON THIS PROPERTY, which the
315:  *  comment above does not say. ***  SH4_VAL_NCLASS is load-bearing -- it SIZES
316:  *  val_reported[SH4_VAL_NCLASS][...] and bounds a runtime check -- so its own
317:  *  by-construction claim is true unaided.  GDROM_W_NBITS was not.  Same conversion, and
318:  *  the property it is cited for was present in one case and absent in the other.
319:  *
320:  *  MEASURED, not asserted: a hard compile error at nine bits over a uint8_t and at
321:  *  thirty-three over a uint32_t; CLEAN on the shipped source and at nine over uint32_t,
322:  *  so it is not a check that cannot fail.  Controls preserved at
323:  *  regress/artifacts/gdromwarnbits/bound_assert_controls{.sh,_20260828.out}.  It emits no
324:  *  object code -- verified with the filename held constant: the object differs in exactly
325:  *  two bytes, both __LINE__ immediates displaced by this comment block.
326:  */
327: typedef char gdrom_w_fits_its_carriers[
328:     (GDROM_W_NBITS <= 8 * sizeof(((struct dreamcast_gdrom_data *)0)->warned) &&
329:      GDROM_W_NBITS <= 8 * sizeof(1u)) ? 1 : -1];
330: 
331: /*
332:  *  #490: THE MASKS MUST BE PAIRWISE DISJOINT, AS A COMPILE ERROR RATHER THAN AS
333:  *  A ROW.  Added on owner decision after the pass-2 ask-again MEASURED an escape
334:  *  that no row could see.
335:  *
336:  *  THE ESCAPE, measured at 20/20 with the mutant's whole row block byte-identical
337:  *  to base -- a total escape, not a tie:
338:  *
339:  *      E1_aliasover   #define GDROM_W_FMT (1u << GDROM_W_OVERREAD_B)
340:  *
341:  *  `crossbit` is the row written for exactly this class and it stages only a
342:  *  short TOC, so it can see a collision with GDROM_W_TOCLEN and with nothing
343:  *  else -- ONE of the seven pre-existing bits.  No session in the detector takes
344:  *  the OVERREAD, LEN, NODATA, NOTWAIT, DMANODATA or DMAARM path, so an alias
345:  *  onto any of those six is invisible to every row.
346:  *
347:  *  *** WHY A DECLARATION AND NOT TWELVE MORE MUTANTS. ***  Closing the class by
348:  *  rows costs one build and one probe run per bit per site and still only
349:  *  enumerates today's bits.  This closes it for ALL bits, present and future,
350:  *  and it FAILS CLOSED: add a tenth bit without extending the sum below and
351:  *  file stops compiling.  The addition-licence bar is a MEASURED DELTA, and the
352:  *  delta here is E1 going from 20/20 (escaped) to not building at all.
353:  *
354:  *  MEASURED IN EIGHT STATES AGAINST BOTH OPERATOR FORMS, on the real file,
355:  *  preserved at regress/artifacts/gdromexitsix/supp_p2_20260829/ (see its
356:  *  README.md; the PRE/POST files carry md5s).  `|` is the form this
357:  *  declaration ORIGINALLY shipped with; `+` is what is above.
358:  *
359:  *                                                    with |     with +
360:  *      unmodified source ........................... COMPILES   COMPILES
361:  *      #define FMT -> OVERREAD_B  (E1 as built) ..... REFUSED    REFUSED
362:  *      enum CMD_B = FMT_B  (one token) ............... ESCAPES    REFUSED
363:  *      enum FMT_B = OVERREAD_B, RELOCATED ............ ESCAPES    REFUSED
364:  *      enum FMT_B = OVERREAD_B, in place ............. REFUSED    REFUSED
365:  *      FMT redefined as a 2-bit SUPERSET ............. ESCAPES    REFUSED
366:  *      tenth bit at BACK, sum not extended ........... REFUSED    REFUSED
367:  *      tenth bit at FRONT, sum not extended .......... REFUSED    REFUSED
368:  *
369:  *  *** THE `|` FORM HAD THREE ESCAPES AND THIS COMMENT CLAIMED IT HAD NONE.
370:  *  ***  The earlier table here listed five states, all synthetic and all
371:  *  ***  against `|`, and read them as a clean sweep.  It missed the whole
372:  *  ***  ENUM-side door: an explicit enumerator initialiser renumbers every
373:  *  ***  later enumerator, so GDROM_W_NBITS falls in lockstep with the lost
374:  *  ***  bit and the equality RE-BALANCES.  An OR test proves coverage
375:  *  ***  relative to a bound derived from the same possibly-aliased enum it
376:  *  ***  is checking -- both sides move together.  That is the vacuity
377:  *  ***  floor's ANCHOR RULE (clause (f)) one level down, in a constant
378:  *  ***  expression: a RELATIVE check where an ANCHORED one was needed.
379:  *  ***  `+` is anchored because a sum cannot absorb a duplicate.
380:  *
381:  *  Note the third and fifth rows are the SAME SHAPE in two spellings, and
382:  *  they disagree under `|`: the #define spelling was refused while the enum
383:  *  spelling compiled.  A control that varies only the #define block cannot
384:  *  see this class at all, which is why the earlier five-state table missed
385:  *  it -- it was measuring the wrong half of the file.
386:  *
387:  *  The in-place-vs-relocated pair matters for the same reason: an alias left
388:  *  in its original position keeps NBITS where it was, so the OR equality
389:  *  still breaks.  Moving it is what lets the bound follow the bit down.
390:  *
391:  *  A NEGATIVE CONTROL was run in the earlier set and still holds: E1's alias
392:  *  WITH THE ASSERT REMOVED compiles, proving this declaration is what
393:  *  refuses and not something else in the file.  gcc's diagnostic is
394:  *  "size of array 'gdrom_w_masks_disjoint' is negative".
395:  *
396:  *  Note the three grounds on which a disjointness assert was REJECTED for
397:  *  dev_sh4.c do not hold here, and each was checked rather than assumed: those
398:  *  classes had pervasively overlapping bit-domains (these are one-bit masks by
399:  *  construction), their separation rested on array INDICES rather than on the
400:  *  constants (this rests on the constants themselves), and for the one disjoint
401:  *  pair the values were hardware register layouts that could not legitimately
402:  *  change (these are private latch bits that change whenever a round adds one).
403:  */
404: /*
405:  *  *** THE OPERATOR IS `+` AND NOT `|`, AND THAT IS A MEASURED CHOICE. ***  A
406:  *  pass-2 seat found the gap and the delta was then measured:
407:  *
408:  *      case                                  with |     with +
409:  *      correct single-bit masks              COMPILES   COMPILES
410:  *      E1: FMT aliased onto OVERREAD_B       REFUSED    REFUSED
411:  *      FMT as a MULTI-BIT LITERAL            COMPILES   REFUSED   <- the delta
412:  *
413:  *  With `|`, redefining a mask as a SUPERSET -- say
414:  *  `((1u << GDROM_W_FMT_B) | (1u << GDROM_W_OVERREAD_B))` -- still ORs to
415:  *  all-ones, so the assert passes while FMT quietly sets OVERREAD's bit too.
416:  *  With `+` the duplicated bit carries and the sum overshoots all-ones.
417:  *
418:  *  So `sum == all-ones` is EXACT: it holds if and only if the masks are
419:  *  pairwise disjoint AND cover every bit.  Overflow is impossible at these
420:  *  widths -- nine bits sum to 511 against an unsigned int.
421:  *
422:  *  Under `|` the single-bit-ness was carried by the `(1u << _B)` IDIOM rather
423:  *  than by the assert; under `+` the assert carries it alone, so a future edit
424:  *  that abandons the idiom is caught rather than trusted.
425:  *
426:  *  *** AND `+` CATCHES A SECOND, INDEPENDENTLY-FOUND ESCAPE BY A DIFFERENT
427:  *  MECHANISM -- which is the strongest argument for it. ***  A later seat
428:  *  proposed aliasing the ENUMERATOR rather than the mask:
429:  *
430:  *      GDROM_W_CMD_B = GDROM_W_FMT_B,
431:  *
432:  *  Measured: COMPILES under `|`, REFUSED under `+`.  The reason `|` cannot see
433:  *  it is worth stating, because it is not the multi-bit case again -- aliasing
434:  *  an enumerator collapses GDROM_W_NBITS from 9 to 8, so the RIGHT-HAND SIDE
435:  *  SHRINKS IN STEP WITH THE OR and the two stay equal at 0xff.  **An OR-based
436:  *  test proves coverage relative to a count derived from the possibly-aliased
437:  *  enum, so it cannot count masks independently.**  The SUM can: the duplicated
438:  *  bit carries, 1+2+4+8+16+32+64+128+128 = 383 against 255.
439:  *
440:  *  HONEST LIMIT, so this is not read as more than it is: `sum == all-ones` is
441:  *  exact for DISJOINTNESS-AND-COVERAGE of the masks as written.  It is not a
442:  *  general one-hot proof of each mask in isolation, and two seats correctly
443:  *  described the `|` form as an exhaustiveness check rather than a pairwise
444:  *  disjointness proof.  A future boundary also exists and is loud rather than
445:  *  silent: at GDROM_W_NBITS == 32 the `1u << GDROM_W_NBITS` here is undefined,
446:  *  and gcc emits `left shift count >= width of type` -- a warning, not an
447:  *  error, so a build that suppresses warnings would not stop.  ELEVEN bits today
448:  *  (#496 added GDROM_W_88VAL_B and GDROM_W_CONDVAL_B); the carriers assert above
449:  *  is what bounds the growth.
450:  *
451:  *  *** THIS COUNT SAID "Nine bits today" AFTER #496 MADE IT ELEVEN, and it was
452:  *  caught by a panel seat rather than by anything mechanical.  The count is left
453:  *  here rather than deleted BECAUSE IT HAS A DERIVER, and this is the THIRD
454:  *  spelling of it -- the first two were both wrong, in opposite directions:
455:  *
456:  *      grep -c '^[[:blank:]]GDROM_W_.*_B,' src/devices/dev_dreamcast_gdrom.c
457:  *
458:  *  RUN IT: 11.  Verified by running, not by reading, because the previous two
459:  *  spellings were verified by reading and both were wrong.
460:  *
461:  *  A number in a durable record names the command that produces it, or it becomes
462:  *  a wrong record on the next edit -- which is exactly what this one did. ***
463:  *
464:  *  *** AND THE FIRST DERIVER SHIPPED HERE WAS ITSELF WRONG, IN THE MOST INSTRUCTIVE
465:  *  WAY AVAILABLE: it was the bare `_B,` pattern, which matches MORE THAN THE ELEVEN
466:  *  -- mutant-table comments, plus THIS COMMENT, whose quotation of the pattern MATCHES
467:  *  THE PATTERN. ***
468:  *
469:  *  *** THE NUMBER IS DELIBERATELY NOT WRITTEN HERE, AND THAT IS THE WHOLE POINT.
470:  *  It was "FIFTEEN" when the defect was found.  A seat re-derived it hours later and
471:  *  got SEVENTEEN, because the commit repairing the defect had itself added two more
472:  *  comment lines quoting `_B,`.  By the next reading it was EIGHTEEN.  **The
473:  *  cautionary count decays every time anyone WRITES ABOUT IT** -- it is a
474:  *  self-referential quantity, and pinning it in prose is the exact frozen-number
475:  *  defect this comment exists to describe, reproduced inside the description. ***  A deriver shipped to repair a wrong count, contaminated by the
476:  *  same comment-inclusion the repair was about, and self-matching besides.  Caught
477:  *  by a seat re-deriving rather than reading.
478:  *
479:  *  Two properties make the form above safe, and both were CHECKED BY RUNNING IT:
480:  *  `^[[:blank:]]` requires the very next character after ONE blank to be `G`, which a
481:  *  comment line cannot satisfy because it has `*` there -- so the eleven matches are
482:  *  the eleven enumerators and nothing else, zero comment lines among them; and the
483:  *  `_B,` suffix excludes the GDROM_W_NBITS terminator, which is not a bit.
484:  *
485:  *  *** AND THE SECOND SPELLING WAS BROKEN BY THE ATTEMPT TO DEFANG IT. ***  It read
486:  *  `grep -c '^<TAB>GDROM_W_.*_B,'` -- with <TAB> spelled out, on the theory that a
487:  *  literal tab would make this comment self-match.  **A literal `<TAB>` means nothing
488:  *  to grep: as written it matched ZERO lines.**  So the first spelling counted fifteen
489:  *  by matching comments including itself, and the "fix" counted zero by being inert.
490:  *  Caught by the codex seat, which RAN it.
491:  *
492:  *  The lesson is not about tabs.  **A DERIVER IS A COMMAND, AND A COMMAND IN A
493:  *  DURABLE RECORD IS ONLY WORTH THE RUN THAT PRODUCED ITS NUMBER.**  Both broken
494:  *  spellings were verified by READING, and reading is exactly what cannot distinguish
495:  *  a pattern that matches too much from one that matches nothing -- the two failures
496:  *  this file already records for greps, arriving here in the same comment, twice.
497:  */
498: typedef char gdrom_w_masks_disjoint[
499:     ((GDROM_W_LEN + GDROM_W_NODATA + GDROM_W_NOTWAIT + GDROM_W_OVERREAD +
500:       GDROM_W_DMANODATA + GDROM_W_DMAARM + GDROM_W_TOCLEN + GDROM_W_FMT +
501:       GDROM_W_CMD + GDROM_W_88VAL + GDROM_W_CONDVAL) ==
502:      ((1u << GDROM_W_NBITS) - 1u)) ? 1 : -1];
503: 
504: /*
505:  *  *** THIS TRIGGER HAS FIRED AND IS DISCHARGED -- see the enum ABOVE.  EVERYTHING IN
506:  *  THE PRESENT TENSE BELOW IS THE PRE-DISCHARGE STATE AND IS KEPT ONLY AS THE TRIGGER'S
507:  *  ORIGINAL TEXT. ***
508:  *
509:  *  It read "SIX OF EIGHT BITS ARE USED, AND THE NINTH FAILS SILENTLY", and it survived
510:  *  the discharge VERBATIM AND IN THE PRESENT TENSE -- so for one commit this file
511:  *  asserted "six of eight" (it is now six of THIRTY-TWO) and "truncates to 0 in a
512:  *  uint8_t" (the field is now uint32_t), sixty lines below a note saying the trigger had
513:  *  fired.  Caught by the opus seat on the discharge's own assess panel; no other seat of
514:  *  the nine mentioned it.
515:  *
516:  *  *** A DISCHARGED TRIGGER MUST BE RETIRED IN THE SAME EDIT THAT DISCHARGES IT. ***  A
517:  *  trigger is written to be read by a FUTURE round, so leaving it live-sounding aims the
518:  *  next reader at work that is already done -- and its numbers go false at exactly the
519:  *  moment it stops applying.  That is the wrong-record class in the artifact whose whole
520:  *  job is to be believed.
521:  *
522:  *  --- THE TRIGGER AS ORIGINALLY WRITTEN (historical; do not act on it) ---
523:  *
524:  *  Filed as `gdromwarnbits` with a PRE-SET TRIGGER: at the SEVENTH bit, widen
525:  *  `warned` and convert these to an enum of bit POSITIONS ending in a
526:  *  GDROM_W_NBITS count, with each mask defined as `1u << ..._B`.
527:  *
528:  *  Why it was worth a trigger rather than a note: `warned |= (1u << 8)`
529:  *  truncated to 0 in the then-uint8_t field, so the latch never set, the guard stayed
530:  *  true forever, and the diagnostic FLOODS -- which is the one behaviour
531:  *  every latch here exists to prevent, arriving with no compile error and
532:  *  no runtime complaint.  A duplicate hand-assigned mask fails the same way
533:  *  for a different reason: the second site is silenced by the first.
534:  *
535:  *  dev_sh4.c:124-263 already did the equivalent conversion for its
536:  *  SH4_VAL_* classes -- 'correct by construction instead of by
537:  *  maintenance' -- and it landed on time because ITS trigger was set in
538:  *  advance too.  Setting this one now costs nothing.
539:  */
540: 
541: 
542: // See the interrupt routine (gdrom_intr()) in NetBSD's dreamcast/dev/gdrom.c:
543: #define	COND_DATA_AVAIL		0x08
544: 
545: 
546: /*
547:  *  #461: report an unimplemented offset ONCE per (direction, word).
548:  *
549:  *  `nkeys` is passed rather than assumed so the two windows cannot share a
550:  *  bound by accident, and it is the SAME macro that dimensions the caller's
551:  *  array.  The check is therefore live: it is not defending against a guest
552:  *  (registration already does that) but against a future edit that changes
553:  *  one window's size without the other -- and against the measured mutant
554:  *  that indexes by raw address, which lands past the latch rows and
555:  *  directly on dma_reg[].
556:  *
557:  *  *** THE MAGNITUDE WAS OVERSTATED AND A SEAT MEASURED IT. ***  This
558:  *  said "five words past a [2][2] array ... the two fields that authorise
559:  *  a transfer".  A guardless bits[k] reaches dma_reg[0..3] -- count,
560:  *  destination and length -- but NOT dma_reg[5], the ENABLE, which needs
561:  *  word index 11 against a reachable maximum of 9.  Three of the four,
562:  *  not two; and the overreach is 4 words for the read row and 6 for the
563:  *  write row, not five for both.  The defect is real either way; the
564:  *  sentence was not.
565:  */
566: static int gdrom_unimpl_first(uint32_t *bits, size_t nkeys, uint32_t off)
567: {
568: 	size_t k = off / sizeof(uint32_t);
569: 	uint32_t bit;
570: 
571: 	if (k >= nkeys)
572: 		return 0;
573: 
574: 	bit = 1u << (k & 31);
575: 	if (bits[k >> 5] & bit)
576: 		return 0;
577: 
578: 	bits[k >> 5] |= bit;
579: 	return 1;
580: }
581: 
582: /*
583:  *  #461 pass 2: BIND THE EXTENT TO THE ARRAY, not merely to a number that
584:  *  happens to match it.
585:  *
586:  *  The round claimed its structural defence was that GDROM_NKEYS both sizes
587:  *  the array and guards the helper, so the number is never written twice.
588:  *  *** A PASS-2 SEAT MEASURED THAT CLAIM TRUE OF THE NUMBER AND FALSE OF THE
589:  *  BINDING. ***  `bits` and `nkeys` are two independent arguments, so pointing
590:  *  the CONTROL arm at d->dma_unimpl_reported while keeping GDROM_NKEYS passes
591:  *  every row AND writes one word past the shorter row -- onto dma_reg[0].
592:  *  ASan cannot see it either: it is member-to-member inside one malloc.
593:  *
594:  *  sizeof(arr) * 8 derives the extent FROM the array named in the same
595:  *  expression, so the two cannot disagree.  8 bytes * 8 = 64 keys for the
596:  *  control window, 4 * 8 = 32 for DMA -- exact for both, and a future window
597:  *  gets its own for free.  `arr` is evaluated twice but is side-effect-free
598:  *  (a member selection and a constant-index subscript).
599:  *
600:  *  *** `arr` MUST BE A uint32_t[] -- TWO PASS-3 SEATS FLAGGED THIS
601:  *  INDEPENDENTLY. ***  `sizeof(arr) * 8` is element-type-agnostic and would
602:  *  compute the right BIT COUNT for any array, but gdrom_unimpl_first takes
603:  *  `uint32_t *bits` and indexes `bits[k >> 5]` with `1u << (k & 31)`.  Hand
604:  *  it a uint8_t[] and the count would be right while the indexing is wrong.
605:  *
606:  *  *** THE 'SILENT' HALF OF THAT WARNING IS MEASURED FALSE ON THIS TOOLCHAIN,
607:  *  and a seat built both forms to check. ***  An earlier draft called it 'the
608:  *  worst combination, because the obvious sanity check passes'.  Both
609:  *  uint8_t[] and uint64_t[] are HARD BUILD ERRORS at both call sites (GCC
610:  *  15.2.1; -Wincompatible-pointer-types has been an error by default since
611:  *  GCC 14), so the mistake cannot reach a running binary here.
612:  *
613:  *  The constraint is still worth stating -- it holds for a pre-GCC-14
614:  *  compiler and this tree targets portable C99 -- but as a PORTABILITY
615:  *  caution, not as a silent-corruption hazard on the compiler in use.
616:  *
617:  *  Stated rather than asserted.  *** THE REASON GIVEN HERE WAS "`_Static_assert` is C11 and
618:  *  this tree is C99", AND THAT IS REFUTED -- INSIDE THIS FILE'S OWN TRANSLATION UNIT.
619:  *  Corrected 2026-08-28; found by the opus seat, which was the only one of nine to look. ***
620:  *
621:  *  `#include "thirdparty/dreamcast_sysasicvar.h"` at the top of this file brings in
622:  *  SYSASIC_EVENT_RANGE_OK, a C99 compile-time bound assert, and every
623:  *  SYSASIC_TRIGGER_EVENT() call here expands it -- FOUR of them, compiled on every build,
624:  *  two hundred lines below this sentence claiming the technique is unavailable.  The
625:  *  build also passes no `-std=` at all and the compiler reports __STDC_VERSION__ 202311L,
626:  *  so "this tree is C99" is a PORTABILITY POLICY, not a fact about what compiles.
627:  *  sysasicvar.h records both legs of exactly this rationale being refuted by measurement
628:  *  on #466's pass 2 -- one day before this comment shipped.
629:  *
630:  *  The claim is therefore narrowed to what survives: an assert here is not IMPOSSIBLE,
631:  *  it is merely NOT YET WRITTEN, and the constraint is visible at every call site because
632:  *  the two existing callers both pass uint32_t[N][M] members declared a few lines above.
633:  *  (The count-fits-its-carriers bound near the warn-bit enum IS now asserted; this
634:  *  paragraph governs a DIFFERENT constraint -- GDROM_UNIMPL_FIRST's array type -- and the
635:  *  two were conflated once already, in a brief that cited this comment for that bound.)
636:  */
637: #define	GDROM_UNIMPL_FIRST(arr, off)	\
638: 	gdrom_unimpl_first((arr), sizeof(arr) * 8, (off))
639: 
640: 
641: static void alloc_data(struct dreamcast_gdrom_data *d)
642: {
643: 	d->data_len = d->cnt;
644: 
645: 	CHECK_ALLOCATION(d->data = (uint8_t *) malloc(d->data_len));
646: 	memset(d->data, 0, d->data_len);
647: }
648: 
649: 
650: /*  #465: alloc_data()'s exact counterpart.  data and data_len are set together
651:     above, but the two release sites cleared only the POINTER -- leaving data_len
652:     describing a buffer that no longer exists.  Later readers test one field and
653:     index with the other, so a stale length is a read of freed or absent memory.
654:     Releasing both here makes every release path restore the invariant before it
655:     returns.  (#465's own record first claimed this made the disagreeing state
656:     UNREPRESENTABLE.  The pass-2 seat corrected that overclaim: the two fields
657:     stay independent, and alloc_data() itself sets the length before the
658:     pointer, so a transient disagreement remains representable.)  */
659: static void free_data(struct dreamcast_gdrom_data *d)
660: {
661: 	if (d->data != NULL)
662: 		free(d->data);
663: 
664: 	d->data = NULL;
665: 	d->data_len = 0;
666: }
667: 
668: 
669: static void handle_command(struct cpu *cpu, struct dreamcast_gdrom_data *d)
670: {
671: 	int64_t sector_nr, sector_count;
672: 	int i, res;
673: 
674: 	debug("[ GDROM cmd: ");
675: 	for (i=0; i<12; i++)
676: 		debug("%02x ", d->cmd[i]);
677: 	debug("(cnt=%i) ]\n", d->cnt);
678: 
679: 	free_data(d);				/*  #465  */
680: 	d->cur_data_offset = 0;
681: 	d->cur_cnt = 0;
682: 
683: 	switch (d->cmd[0]) {
684: 
685: 	case 0x14:
686: 		/*
687: 		 *  Read Table-Of-Contents:
688: 		 *
689: 		 *  See NetBSD's sys/arch/dreamcast/dev/gdrom.c: gdrom_read_toc().
690: 		 */
691: 		/*
692: 		 *  #489: was fatal() + exit(1).  `d->cnt` is GUEST-SUPPLIED -- two
693: 		 *  16-bit stores to GDROM_CNTLO/GDROM_CNTHI -- so an ordinary guest
694: 		 *  register access ended the host process.  MEASURED on the committed
695: 		 *  build before this edit: cnt=407 and cnt=0 both exit(1), while
696: 		 *  cnt=408 synthesizes a real TOC and survives
697: 		 *  (regress/artifacts/gdromexitsix/repro_20260828/).
698: 		 *
699: 		 *  *** THE GUARD IS LOAD-BEARING AND THIS IS A DECLINE, NOT A DELETION. ***
700: 		 *  alloc_data() mallocs `d->cnt`, but the writer below uses HARDCODED
701: 		 *  indices -- `grep -oE 'd->data\[[0-9]+\*4(\+[0-9])?\]'` gives a highest
702: 		 *  byte index of 407 -- so it needs 408 bytes REGARDLESS of cnt.  Deleting
703: 		 *  the exit(1) would turn a host kill into a GUEST-CONTROLLED HEAP OVERFLOW
704: 		 *  of up to 408 bytes, with malloc(0) at cnt == 0.  So the decline must come
705: 		 *  BEFORE the guarded statement, not after it.
706: 		 *
707: 		 *  *** THE PREDICATE IS THE ORIGINAL `!= 408` ON PURPOSE.  DO NOT "SIMPLIFY"
708: 		 *  IT TO `< 408`. ***  A de-fatalisation must not change the ACCEPT SET: this
709: 		 *  edit converts the DEATH into a decline and touches nothing else, so the
710: 		 *  values that produce a TOC are byte-for-byte what they were before.
711: 		 *  `< 408` would additionally start HONOURING over-length requests -- and
712: 		 *  note it is not a memory-safety question, which is why it is easy to talk
713: 		 *  yourself into: above 408 the malloc is larger than the writer needs and
714: 		 *  nothing overflows.  It changes the disposition of 65,527 of the 65,536
715: 		 *  possible values, silently.  `over cond` in the detector exists to catch it;
716: 		 *  `zero cond` catches the mirror form `!= 408 && != 0`, which re-opens the
717: 		 *  overflow above at cnt == 0 while the host stays alive.
718: 		 *
719: 		 *  `break` and not `return`: the common tail is load-bearing.  free_data()
720: 		 *  at the top of this function left d->data NULL, so the tail takes its else
721: 		 *  branch, sets d->cnt = 0, clears COND_DATA_AVAIL and still fires
722: 		 *  SYSASIC_TRIGGER_EVENT -- "the command produced no data", reported
723: 		 *  properly.  An early return would skip that event and leave the guest
724: 		 *  waiting forever.  `case 0x30` already ships this idiom twice -- grep
725: 		 *  this file for "OB-20: was exit(1)" -- so the shape is in-tree
726: 		 *  precedent in this very function, not something invented here.
727: 		 *
728: 		 *  LATCHED, per the house idiom -- N = 1 per device instance with an
729: 		 *  explicit (once) marker -- because fatal() cannot be silenced by -q and an
730: 		 *  unlatched guest-drivable diagnostic is a flood.  This is the SEVENTH warn
731: 		 *  bit, which is the condition gdromwarnbits' pre-set trigger was written
732: 		 *  for; the enum and its compile-time carrier bound landed first.
733: 		 */
734: 		if (d->cnt != 408) {
735: 			if (!(d->warned & GDROM_W_TOCLEN)) {
736: 				d->warned |= GDROM_W_TOCLEN;
737: 				fatal("[ dreamcast_gdrom: Read TOC with"
738: 				    " cnt=%i, not 408 -- declined.  (once) ]\n",
739: 				    (int) d->cnt);
740: 			}
741: 			break;
742: 		}
743: 		alloc_data(d);
744: 
745: 		/*
746: 		 *  From David Brownlee:
747: 		 *  "TOC from test booted real CD image on NetBSD/dreamcast
748: 		 *  01000096,41002e4c,ffffffff * 97,01010000,41020000,6100e641,"
749: 		 *
750: 		 *  TODO: Perhaps generalize this in the future, to support
751: 		 *  disk images with multiple TOCs and/or tracks.
752: 		 */
753: 		memset(d->data, 0xff, d->cnt); /* Default data to 0xff */
754: 
755: 		d->data[0*4]   = 0x10;  /* Track 1 */
756: 		d->data[0*4+1] = 0;
757: 		d->data[0*4+2] = 0;
758: 		d->data[0*4+3] = 0x96;
759: 
760: 		d->data[1*4]   = 0x41;  /* Track 2 */
761: 		d->data[1*4+1] = 0;
762: 		d->data[1*4+2] = 0x2e;
763: 		d->data[1*4+3] = 0x4c;
764: 
765: 		d->data[99*4]   = 0x01; /*  First track  */
766: 		d->data[99*4+1] = 0x01;
767: 		d->data[99*4+2] = 0;
768: 		d->data[99*4+3] = 0;
769: 
770: 		d->data[100*4]   = 0x41; /*  Last track  */
771: 		d->data[100*4+1] = 0x02;
772: 		d->data[100*4+2] = 0;
773: 		d->data[100*4+3] = 0;
774: 
775: 		d->data[101*4]   = 0x61; /*  Leadout  */
776: 		d->data[101*4+1] = 0;
777: 		d->data[101*4+2] = 0xe6;
778: 		d->data[101*4+3] = 0x41;
779:  
780: 		break;
781: 
782: 	case 0x30:
783: 		/*
784: 		 *  Read sectors:
785: 		 *
786: 		 *  See NetBSD's sys/arch/dreamcast/dev/gdrom.c: gdrom_read_sectors().
787: 		 */
788: 		if (d->cmd[1] == 0x24) {
789: 			fatal("GDROM unimplemented data format 0x%02x. Continuing anway.\n", d->cmd[1]);
790: 		} else if (d->cmd[1] != 0x20) {
791: 			/*
792: 			 *  #490: a guest-chosen data format ended the host
793: 			 *  process.  Decline instead, announced ONCE per
794: 			 *  device instance behind its own latch bit -- the
795: 			 *  house idiom, and the same shape #489 shipped for
796: 			 *  the TOC length guard in this file.
797: 			 *
798: 			 *  *** THE `break` IS INSIDE THIS ARM AND OUTSIDE THE
799: 			 *  LATCH `if`, AND BOTH PLACEMENTS ARE MEASURED. ***
800: 			 *  Inside the arm: the 0x24 branch above stays
801: 			 *  byte-identical (it is verbatim pristine-2021
802: 			 *  upstream, typo included, and unsettleable here),
803: 			 *  and the 0x20 path never enters this arm at all.
804: 			 *  Outside the latch `if`: a `break` INSIDE it makes
805: 			 *  the FIRST bad format decline and every LATER one
806: 			 *  fall through into `sector_nr` -- `M_braceA`,
807: 			 *  measured escaping a 13-row detector because
808: 			 *  "announces once" reads the same either way.
809: 			 *
810: 			 *  It must be `break` and not `return`: the common
811: 			 *  tail below zeroes d->cnt, clears COND_DATA_AVAIL
812: 			 *  and fires the completion event.  `M_retA` measured
813: 			 *  a `return` leaving cnt at 0x98, which hands the
814: 			 *  guest a count for a command that produced nothing.
815: 			 */
816: 			if (!(d->warned & GDROM_W_FMT)) {
817: 				d->warned |= GDROM_W_FMT;
818: 				fatal("[ dreamcast_gdrom: unimplemented data"
819: 				    " format 0x%02x -- declined.  (once) ]\n",
820: 				    d->cmd[1]);
821: 			}
822: 			break;
823: 		}
824: 		sector_nr = d->cmd[2] * 65536 + d->cmd[3] * 256 + d->cmd[4];
825: 		sector_count = d->cmd[8] * 65536 + d->cmd[9] * 256 + d->cmd[10];
826: 
827: 		// NetBSD/dreamcast uses correct length, but the Dreamcast PROM
828: 		// uses len = 0 (!), but sector count = 7,
829: 		// which means len = 0x3800. It also sets up DMA to
830: 		// transfer 0x3800 bytes, so I'm assuming that the
831: 		// sector count is to be trusted more than the length.
832: 		if (sector_count <= 0 ||	/* OB-20 */
833: 		    sector_count > GDROM_MAX_TRANSFER_BYTES / 2048) {
834: 			fatal("GDROM: rejecting sector_count=%i\n",
835: 			    (int)sector_count);
836: 			break;
837: 		}
838: 
839: 		if (d->cnt == 0)
840: 			d->cnt = 2048 * (int)sector_count;
841: 
842: 		if (sector_count * 2048 != d->cnt) {
843: 			fatal("Huh? GDROM data_len=0x%x, but sector_count"
844: 			    "=0x%x\n", (int)d->cnt, (int)sector_count);
845: 			break;	/* OB-20: was exit(1) */
846: 		}
847: 
848: 		alloc_data(d);
849: 
850: 		// Hm. This is an ugly hack to make a NetBSD/dreamcast
851: 		// live-cd work. It should be fixed (i.e. removed).
852: 		// When running with -Q (i.e. no PROM software emulation),
853: 		// experiments with the Dreamcast PROM can be made instead.
854: 		if (cpu->machine->prom_emulation) {
855: 			// printf("sector nr step 1 = %i\n", (int)sector_nr);
856: 
857: 			// Hack to get NetBSD/dreamcast to work:
858: 			// See the variable "openpart_start" in NetBSD's
859: 			// sys/arch/dreamcast/dev/gdrom.c:
860: 			sector_nr -= 150;
861: 
862: 			// printf("sector nr step 2 = %i\n", (int)sector_nr);
863: 		} else {
864: 			// printf("sector nr step 1 = %i\n", (int)sector_nr);
865: 			sector_nr -= 45150;
866: 			// printf("sector nr step 2 = %i\n", (int)sector_nr);
867: 			sector_nr += (diskimage_get_baseoffset(cpu->machine, 0, DISKIMAGE_IDE) / 2048);
868: 			// printf("sector nr step 3 = %i\n", (int)sector_nr);
869: 		}
870: 
871: 		res = diskimage_access(cpu->machine, 0, DISKIMAGE_IDE,
872: 		    0, sector_nr * 2048, d->data, d->data_len);
873: 		if (!res) {
874: 			fatal("GDROM: diskimage_access failed? TODO\n");
875: 			free_data(d);			/*  #465  */
876: 		}
877: 
878: 		/* {
879: 			printf("(Dump of GDROM sector %i: \"", (int)sector_nr);
880: 			for (int k = 0; k < 256; ++k)
881: 				printf("%c", d->data[k] >= 32 ? d->data[k] : '.');
882: 			printf("\")\n");
883: 		} */
884: 
885: 		break;
886: 
887: 	case 0x70:
888: 		/*
889: 		 *  Mount:
890: 		 *
891: 		 *  See NetBSD's sys/arch/dreamcast/dev/gdrom.c: gdrom_mount_disk().
892: 		 */
893: 
894: 		// Note/TODO: This is ignored for now.
895: 		break;
896: 
897: 	default:/*
898: 		 *  #490: an unimplemented command byte ended the host process.
899: 		 *  Decline, announced ONCE behind its own latch bit.
900: 		 *
901: 		 *  A SEPARATE bit from Site A's, measured: `M3shared` folded
902: 		 *  both onto one bit and ESCAPED -- a session declining at both
903: 		 *  sites saw the second fall silent because the first had
904: 		 *  latched.
905: 		 *
906: 		 *  `break` and not `return`, and here the reason is subtler
907: 		 *  than at Site A: this is the LAST arm, so deleting exit(1)
908: 		 *  with no break would fall out of the switch into the tail
909: 		 *  anyway.  The `break` is house idiom rather than load-bearing
910: 		 *  -- but a `return` is NOT equivalent, because the tail below
911: 		 *  zeroes d->cnt, clears COND_DATA_AVAIL and fires the
912: 		 *  completion event.  An early return skips that event and
913: 		 *  leaves a guest waiting for a completion that never comes.
914: 		 */
915: 		if (!(d->warned & GDROM_W_CMD)) {
916: 			d->warned |= GDROM_W_CMD;
917: 			fatal("[ dreamcast_gdrom: handle_command:"
918: 			    " unimplemented command 0x%02x -- declined."
919: 			    "  (once) ]\n", d->cmd[0]);
920: 		}
921: 		break;
922: 	}
923: 
924: 	// Any resulting data? Then set COND_DATA_AVAIL. Otherwise, clear
925: 	// that bit, and set count to zero.
926: 	if (d->data != NULL) {
927: 		d->cond |= COND_DATA_AVAIL;
928: 	} else {
929: 		d->cnt = 0;
930: 		d->cond &= ~COND_DATA_AVAIL;
931: 	}
932: 
933: 	// NetBSD seems to sometimes request 32 sectors (2048 bytes each), i.e.
934: 	// 65536 bytes. That is represented as count = 0x0000 (when NetBSD reads
935: 	// from the CNTHI and CNTLO registers). That does not work very well.
936: 	// This is a hack/workaround for that.
937: 	if (d->cnt == 65536)
938: 		d->cnt = 32768;
939: 
940: 	SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
941: }
942: 
943: void dreamcast_gdrom_update_stat(struct cpu *cpu, struct dreamcast_gdrom_data *d)
944: {
945: 	// See NetBSD's gdrom.c.
946: 	d->stat = 6;
947: 
948: 	if (diskimage_exist(cpu->machine, 0, DISKIMAGE_IDE)) {
949: 		d->stat = 0;
950: 	}
951: }
952: 
953: 
954: DEVICE_ACCESS(dreamcast_gdrom)
955: {
956: 	struct dreamcast_gdrom_data *d = (struct dreamcast_gdrom_data *) extra;
957: 	uint64_t idata = 0, odata = 0;
958: 
959: 	if (writeflag == MEM_WRITE)
960: 		idata = memory_readmax64(cpu, data, len);
961: 
962: 	switch (relative_addr) {
963: 
964: 	case GDROM_BUSY:
965: 		if (writeflag == MEM_READ) {
966: 			odata = d->busy;
967: 		} else {
968: 			// fatal("[ Write to GDROM_BUSY: 0x%08x ]\n", (int)idata);
969: 			// I'm assuming that writing bits to BUSY clears them.
970: 			d->busy &= ~idata;
971: 		}
972: 		break;
973: 
974: 	case GDROM_DATA:
975: 		/*
976: 		 *  #460: THIS SITE LOGS AND CONTINUES; the other three decline.
977: 		 *  The difference is measured, not stylistic.
978: 		 *
979: 		 *  BEFORE THIS FIX, `len` appeared exactly once in the whole arm --
980: 		 *  in the guard that was here -- and no index expression consulted
981: 		 *  it.  (It appears three times now: this fix's own format string
982: 		 *  and argument.  Stated in the past tense because the claim is
983: 		 *  about the code the measurement was taken against, and a seat
984: 		 *  caught the present tense going false the moment it shipped.)
985: 		 *  Measured:
986: 		 *  byte, word and longword reads all consume exactly two bytes
987: 		 *  and return the same odata, and six BYTE stores assemble the
988: 		 *  12-byte packet and DISPATCH the command, reaching handle_command
989: 		 *  exactly as six word stores do.
990: 		 *
991: 		 *  *** BUT THE CONTINUATION IS NOT WIDTH-TRANSPARENT, and an earlier
992: 		 *  draft said it was. ***  `idata >> 8` is zero for a byte store, so
993: 		 *  EVERY ODD COMMAND BYTE IS FORGED TO ZERO.  That is harmless for
994: 		 *  the TOC packet 0x14, whose odd bytes are already zero -- which is
995: 		 *  exactly why the measurement that produced the earlier claim did
996: 		 *  not see it.  Command 0x30 needs cmd[1] in {0x20,0x24} and a
997: 		 *  byte-store packet can never satisfy it, so it reaches
998: 		 *  handle_command's data-format arm.
999: 		 *
1000: 		 *  *** THIS SENTENCE READ "so it reaches handle_command's own
1001: 		 *  exit(1).  MEASURED: this build dies there and a DECLINING
1002: 		 *  build survives."  #490 MADE ITS OWN ANTECEDENT FALSE and the
1003: 		 *  claim with it: there is no longer ANY exit(1) in
1004: 		 *  handle_command, so a byte-store packet now reaches the
1005: 		 *  LATCHED DECLINE and the build survives.  The comment even
1006: 		 *  named the outcome -- "a DECLINING build survives" -- which is
1007: 		 *  exactly what this build now is.  Caught by a pass-2 seat;
1008: 		 *  corrected in-round because a WRONG RECORD is one of the two
1009: 		 *  things the stopping rule fixes rather than files, and a claim
1010: 		 *  labelled MEASURED is the worst kind to leave stale. ***
1011: 		 *
1012: 		 *  That is a RELOCATION, not a regression -- before this fix the
1013: 		 *  same byte store died at the width guard, one step earlier -- but
1014: 		 *  it means "dropping the guard changes NO BOUND" is the MEMORY
1015: 		 *  safety argument and not the whole safety story.  Memory safety
1016: 		 *  does hold: no index consults len, cur_data_offset advances by two
1017: 		 *  regardless, and no mutant produced an out-of-bounds access.
1018: 		 *
1019: 		 *  Dropping the guard changes no bound -- which is
1020: 		 *  precisely the warrant dev_pvr.c:1577-1581 (#187) states for
1021: 		 *  the same class on this same machine.
1022: 		 *
1023: 		 *  *** DO NOT "EMULATE" NARROW ACCESS INSTEAD. ***  A pass-1
1024: 		 *  panel split on that, and it was MEASURED ACTIVELY HARMFUL:
1025: 		 *  letting cmd_count step by 1 makes eleven byte writes plus one
1026: 		 *  word write go 11 -> 13, SKIPPING the `== 12` equality below,
1027: 		 *  so busy&0x08 never clears and the next write reaches the
1028: 		 *  "Too much GDROM_DATA" exit -- otherwise unreachable.  It also
1029: 		 *  writes cmd[12], one past the array.  A fix that re-opens a
1030: 		 *  dead site is worse than the defect, and only a build saw it.
1031: 		 *
1032: 		 *  DE-ESCALATION: this round removes FOUR host-fatal predicates and
1033: 		 *  the detector carries accept rows for THREE.  *** THIS ONE IS
1034: 		 *  EXEMPT, AND THE EXEMPTION IS STATED RATHER THAN LEFT AS A GAP. ***
1035: 		 *  The clause's accept-row obligation applies to predicates a guest
1036: 		 *  store can feed; this predicate tests the ACCESS WIDTH against a
1037: 		 *  compile-time constant, and no guest store reaches its operand --
1038: 		 *  the same failability carve-out the project already applies to
1039: 		 *  read-only and never-set-by-device bits.  The other three (the two
1040: 		 *  read predicates and the busy mask) DO carry rows.
1041: 		 */
1042: 		if (len != sizeof(uint16_t)) {
1043: 			if (!(d->warned & GDROM_W_LEN)) {
1044: 				d->warned |= GDROM_W_LEN;
1045: 				fatal("[ dreamcast_gdrom: non-16bit"
1046: 				    " GDROM_DATA access, len=%i -- handled"
1047: 				    " as 16-bit.  (once) ]\n", (int) len);
1048: 			}
1049: 		}
1050: 
1051: 		if (writeflag == MEM_READ) {
1052: 			if (!(d->cond & COND_DATA_AVAIL)) {
1053: 				/*  #460: was exit(1).  `cond` is zero on a fresh
1054: 				    device, so the FIRST guest load ended the host.  */
1055: 				if (!(d->warned & GDROM_W_NODATA)) {
1056: 					d->warned |= GDROM_W_NODATA;
1057: 					fatal("[ dreamcast_gdrom: read from"
1058: 					    " GDROM_DATA with no data"
1059: 					    " available -- returning 0xffff."
1060: 					    "  (once) ]\n");
1061: 				}
1062: 				/*  0xffff because a released ATA/ATAPI data bus
1063: 				    reads as all-ones, which dev_wdc.c:155-167 also
1064: 				    returns.  NOTE THE COLLISION: this device's TOC is
1065: 				    memset(0xff), so 0xffff is LEGITIMATE PAYLOAD here
1066: 				    and no returned value is self-identifying.  The
1067: 				    DIAGNOSTIC is the truthfulness channel, not the
1068: 				    value -- which is also why the latch is per-site.  */
1069: 				odata = 0xffff;
1070: 				break;
1071: 			}
1072: 
1073: 			if (d->cur_data_offset < d->data_len) {
1074: 				odata = d->data[d->cur_data_offset ++];
1075: 				odata |= (d->data[d->cur_data_offset ++] << 8);
1076: 				d->cur_cnt += sizeof(uint16_t);
1077: 				if (d->cur_cnt >= d->cnt) {
1078: 					if (d->cur_data_offset >= d->data_len) {
1079: 						d->cond &= ~COND_DATA_AVAIL;
1080: 					} else {
1081: 						d->cnt = d->data_len - d->cur_data_offset;
1082: 						d->cur_cnt = 0;
1083: 					}
1084: 
1085: 					SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
1086: 				}
1087: 			} else {
1088: 				/*  #460: joined on the merits -- this and the
1089: 				    COND_DATA_AVAIL site above are ONE predicate
1090: 				    family, "read when there is nothing to give".
1091: 				    Fixing one and leaving the other fatal gives a
1092: 				    device where a declined read is safe in one
1093: 				    state and lethal in another.  */
1094: 				if (!(d->warned & GDROM_W_OVERREAD)) {
1095: 					d->warned |= GDROM_W_OVERREAD;
1096: 					fatal("[ dreamcast_gdrom: read past"
1097: 					    " the end of the GDROM_DATA"
1098: 					    " buffer -- returning 0xffff."
1099: 					    "  (once) ]\n");
1100: 				}
1101: 				odata = 0xffff;
1102: 				break;
1103: 			}
1104: 		} else {
1105: 			if (d->busy & 0x08) {
1106: 				if (d->cmd_count >= 12) {
1107: 					fatal("Too much GDROM_DATA?\n");
1108: 					exit(1);
1109: 				}
1110: 				/*  Add data to cmd:  */
1111: 				d->cmd[d->cmd_count++] = idata;
1112: 				d->cmd[d->cmd_count++] = idata >> 8;
1113: 				if (d->cmd_count == 12) {
1114: 					d->busy &= ~0x08;
1115: 					handle_command(cpu, d);
1116: 				}
1117: 			} else {
1118: 				/*  #460: was exit(1).  `busy` is zero on a fresh
1119: 				    device, so the FIRST guest store ended the host.  */
1120: 				if (!(d->warned & GDROM_W_NOTWAIT)) {
1121: 					d->warned |= GDROM_W_NOTWAIT;
1122: 					fatal("[ dreamcast_gdrom: write to"
1123: 					    " GDROM_DATA while not waiting"
1124: 					    " for data -- ignored.  (once) ]\n");
1125: 				}
1126: 			}
1127: 		}
1128: 		break;
1129: 
1130: 	case GDROM_REGX:
1131: 		if (writeflag == MEM_READ) {
1132: 			debug("[ Read to GDROM_REGX? ]\n");
1133: 		} else {
1134: 			/*  NetBSD/dreamcast writes 0 here.  */
1135: 			if (idata != 0)
1136: 				debug("[ Write 0x%x to GDROM_REGX? ]\n", (int)idata);
1137: 		}
1138: 		break;
1139: 
1140: 	case GDROM_UNKNOWN_0x88:
1141: 		if (writeflag == MEM_READ) {
1142: 			fatal("Read from GDROM_UNKNOWN_0x88?\n");
1143: 			// exit(1);
1144: 		} else {
1145: 			if (idata != 0xb) {
1146: 				/*
1147: 				 *  #496: a guest write of any value but
1148: 				 *  0x0b ENDED THE HOST PROCESS here.  One
1149: 				 *  store, from an ordinary driver, on an
1150: 				 *  unmodified -E dreamcast.
1151: 				 *
1152: 				 *  The model implements NO behaviour for
1153: 				 *  this register: 0x0b is accepted and is
1154: 				 *  a no-op, touching no device state.  So
1155: 				 *  an unmodelled value is declined, not
1156: 				 *  fatal.  The announce is kept because
1157: 				 *  the accepted set is what ONE boot ROM
1158: 				 *  happens to write, not a documented
1159: 				 *  register contract -- so an unmodelled
1160: 				 *  value is a fact about the guest worth
1161: 				 *  reporting, and the decline itself is
1162: 				 *  the only channel that ever reports it.
1163: 				 *
1164: 				 *  The message carries idata: this is the
1165: 				 *  only line that has the value a later
1166: 				 *  round would need to model the register.
1167: 				 */
1168: 				if (!(d->warned & GDROM_W_88VAL)) {
1169: 					d->warned |= GDROM_W_88VAL;
1170: 					fatal("[ dreamcast_gdrom: write of"
1171: 					    " 0x%02x to GDROM_UNKNOWN_0x88;"
1172: 					    " only 0x0b is modelled --"
1173: 					    " ignored.  (once) ]\n",
1174: 					    (int)idata);
1175: 				}
1176: 			}
1177: 		}
1178: 		break;
1179: 
1180: 	case GDROM_STAT:
1181: 		if (writeflag == MEM_READ) {
1182: 			dreamcast_gdrom_update_stat(cpu, d);
1183: 			odata = d->stat;
1184: 		} else {
1185: 			fatal("[ Write to GDROM_STAT? ]\n");
1186: /*			exit(1);  */
1187: 		}
1188: 		break;
1189: 
1190: 	case GDROM_CNTLO:
1191: 		if (writeflag == MEM_READ) {
1192: 			odata = d->cnt & 0xff;
1193: 		} else {
1194: 			d->cnt = (d->cnt & 0xff00) | (idata & 0xff);
1195: 		}
1196: 		break;
1197: 
1198: 	case GDROM_CNTHI:
1199: 		if (writeflag == MEM_READ) {
1200: 			odata = (d->cnt >> 8) & 0xff;
1201: 		} else {
1202: 			d->cnt = (d->cnt & 0x00ff) | ((idata & 0xff) << 8);
1203: 		}
1204: 		break;
1205: 
1206: 	case GDROM_COND:
1207: 		if (writeflag == MEM_READ) {
1208: 			odata = d->cond;
1209: 		} else {
1210: 			/*
1211: 			 *  NetBSD/dreamcast writes 0xa0 to GDROM_COND to
1212: 			 *  start a command. See gdrom_do_command() in NetBSD's
1213: 			 *  sys/arch/dreamcast/dev/gdrom.c.
1214: 			 *
1215: 			 *  Before sending anything, NetBSD expects:
1216: 			 *   o) the lowest 4 bits of STAT to not be 6.
1217: 			 *
1218: 			 *  After writing 0xa0 to GDROM_COND, NetBSD expects:
1219: 			 *   o) (BUSY & 0x88) to be 0x08.
1220: 			 *
1221: 			 *  NetBSD then sends 6 16-bit data words to GDROM_DATA.
1222: 			 */
1223: 			/*
1224: 			 *  #496: an unmodelled value ENDED THE HOST
1225: 			 *  PROCESS here -- one guest store, through
1226: 			 *  real decode, on an unmodified machine.
1227: 			 *
1228: 			 *  *** THE STORE OF idata MOVED IN HERE, INTO
1229: 			 *  THE ACCEPTED ARMS, AND THAT IS THE HALF OF
1230: 			 *  THIS FIX THAT IS NOT ABOUT exit(). ***  It
1231: 			 *  used to run UNCONDITIONALLY above this
1232: 			 *  dispatch, so merely de-fatalising the else
1233: 			 *  arm would leave every unmodelled value a
1234: 			 *  direct write to d->cond -- and COND_DATA_AVAIL
1235: 			 *  (0x08) is a bit of that same byte, which
1236: 			 *  GATES THE ENTIRE GDROM_DATA READ PATH.
1237: 			 *  A declined write could therefore FORGE
1238: 			 *  data-available when no command produced any,
1239: 			 *  or REVOKE a genuine one -- a worse defect
1240: 			 *  than the kill it replaced, because it is
1241: 			 *  silent.
1242: 			 *
1243: 			 *  Stated as readiness rather than as a NULL
1244: 			 *  deref on purpose: with d->data NULL the read
1245: 			 *  path does not fault today, because
1246: 			 *  `cur_data_offset < data_len` is 0 < 0 and
1247: 			 *  falls into the OVERREAD arm.  The harm is a
1248: 			 *  guest told to read a buffer that never
1249: 			 *  existed, and a genuine transfer silently
1250: 			 *  cancelled -- not a crash.
1251: 			 *
1252: 			 *  Accepted values keep their old semantics
1253: 			 *  byte for byte, store included and in the
1254: 			 *  same order.
1255: 			 *
1256: 			 *  NO COMPLETION EVENT ON THE DECLINE, and the
1257: 			 *  two precedents in this file disagree, so the
1258: 			 *  choice is stated rather than assumed: the
1259: 			 *  handle_command() default arm FIRES one
1260: 			 *  because a guest that has SENT a packet is
1261: 			 *  waiting on it, while the DMA arm refuses one
1262: 			 *  because a completion on a declined transfer
1263: 			 *  is a false success.
1264: 			 *
1265: 			 *  This declined write ACCEPTED NO NEW COMMAND
1266: 			 *  OR PACKET, so it must not synthesize a
1267: 			 *  completion; any pre-existing command state
1268: 			 *  is left untouched.  Stated that way on
1269: 			 *  purpose -- an earlier draft said "the guest
1270: 			 *  has sent no packet", which is too broad:
1271: 			 *  nothing stops a bad COND write arriving
1272: 			 *  AFTER a 0xa0, or midway through a partially
1273: 			 *  assembled packet.  The warrant is that THIS
1274: 			 *  write began nothing, not that nothing is in
1275: 			 *  flight.
1276: 			 */
1277: 			if (idata == 0xa0) {
1278: 				d->cond = idata;
1279: 				d->stat = 0;	/*  TODO  */
1280: 				d->busy |= 0x08;
1281: 				d->cmd_count = 0;
1282: 			} else if (idata == 0xef) {
1283: 				d->cond = idata;
1284: 				debug("dreamcast_gdrom: ROM: TODO\n");
1285: 				SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM);
1286: 			} else {
1287: 				if (!(d->warned & GDROM_W_CONDVAL)) {
1288: 					d->warned |= GDROM_W_CONDVAL;
1289: 					fatal("[ dreamcast_gdrom:"
1290: 					    " unimplemented GDROM_COND ="
1291: 					    " 0x%02x -- declined, and"
1292: 					    " d->cond left unchanged."
1293: 					    "  (once) ]\n", (int)idata);
1294: 				}
1295: 			}
1296: 		}
1297: 		break;
1298: 
1299: 	/*
1300: 	 *  #461: EIGHT offsets are implemented and this arm took the other ~248 --
1301: 	 *  a read OR a write, at any width -- and ended the host process.  MEASURED
1302: 	 *  on an unmodified -E dreamcast: 21 offsets sampled, 19 died here.  A
1303: 	 *  driver or diagnostic scanning the register space dies on its first
1304: 	 *  unhandled address.
1305: 	 *
1306: 	 *  Declined reads return 0, and that is the value that claims LEAST rather
1307: 	 *  than the value that reads best.  #452 already settled this shape in this
1308: 	 *  tree for unimplemented sub-windows: reads return 0, writes are ignored.
1309: 	 *  dev_wdc.c's all-ones is a claim about a RELEASED BUS with no responder;
1310: 	 *  here a responder exists and simply does not model the register, so
1311: 	 *  all-ones would be a strictly stronger claim and a false one.
1312: 	 *
1313: 	 *  `odata` is already 0 -- memory_rw.c memsets the caller's buffer before
1314: 	 *  every device read (#95) and odata is initialised at the top -- so the
1315: 	 *  assignment below is EXPLICIT BUT NOT LOAD-BEARING and deliberately
1316: 	 *  carries no detector row: a mutant deleting it is equivalent.  #452
1317: 	 *  records the same for its own site.
1318: 	 */
1319: 	/*
1320: 	 *  *** WHY THIS WINDOW NEEDS NO ALIGNMENT GUARD, and why adding one was
1321: 	 *  DECLINED rather than overlooked.  Two pass-3 seats asked for it. ***
1322: 	 *
1323: 	 *  The DMA arm below carries `if (relative_addr & 3) return 1;` because its
1324: 	 *  tail STORES through a truncating index, so an unaligned access aliases an
1325: 	 *  implemented word.  This arm has no tail at all: `odata` is a fresh local
1326: 	 *  0, nothing here is indexed by `relative_addr` except the latch bitmap,
1327: 	 *  and that is bounds-guarded from its own array's sizeof.
1328: 	 *
1329: 	 *  So the same guard here would be DEAD CODE, and this round has already
1330: 	 *  rejected one dead bounds check for exactly that reason -- `if (off >=
1331: 	 *  0x100)` can never fire, because memory_rw gates on the registered range
1332: 	 *  and subtracts before the device is entered.  A guard that cannot fire is
1333: 	 *  not insurance; it is a claim that something is checked when nothing is.
1334: 	 *
1335: 	 *  *** THE INVARIANT IS THE THING TO WATCH: if a store tail is ever added
1336: 	 *  to this arm, the injectivity argument at the DMA site must be re-derived
1337: 	 *  HERE and a guard added with it. ***  Written down because the safety is
1338: 	 *  structural rather than guarded, and structure is what a later edit
1339: 	 *  silently changes.
1340: 	 */
1341: 	default:if (GDROM_UNIMPL_FIRST(d->unimpl_reported[
