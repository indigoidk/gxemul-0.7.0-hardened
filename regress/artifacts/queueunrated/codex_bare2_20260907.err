1367: DEVICE_ACCESS(dreamcast_gdrom_dma)
1368: {
1369: 	struct dreamcast_gdrom_data *d = (struct dreamcast_gdrom_data *) extra;
1370: 	uint64_t idata = 0, odata = 0;
1371: 
1372: 	if (writeflag == MEM_WRITE)
1373: 		idata = memory_readmax64(cpu, data, len);
1374: 
1375: 	/*  Default read:  */
1376: 	if (writeflag == MEM_READ)
1377: 		odata = d->dma_reg[relative_addr / sizeof(uint32_t)];
1378: 
1379: 	switch (relative_addr) {
1380: 
1381: 	case 0x04:	// destination address? e.g. 0x8c008000
1382: 	case 0x08:	// DMA length in bytes? e.g. 0x3800
1383: 	case 0x0c:	// count? e.g. 1
1384: 	case 0x14:	// "enable"?
1385: 		break;
1386: 
1387: 	case 0x18:
1388: 		// GDROM DMA start?
1389: 		if (idata != 0) {
1390: 			if (d->dma_reg[0x0c / sizeof(uint32_t)] == 1 &&
1391: 			    d->dma_reg[0x14 / sizeof(uint32_t)] == 1) {
1392: 				// GDROM DMA transfer.
1393: 				uint32_t dst = d->dma_reg[0x04 / sizeof(uint32_t)];
1394: 				int length = d->dma_reg[0x08 / sizeof(uint32_t)];
1395: 				if (d->data == NULL) {
1396: 					/*
1397: 					 *  #462: was exit(1).  A guest can reach this WITHOUT
1398: 					 *  doing anything wrong: Linux's gdrom_readdisk_dma
1399: 					 *  programs the four DMA registers BEFORE sending its
1400: 					 *  packet, so if diskimage_access fails on a short image
1401: 					 *  -- or OB-20's sector clamp refuses the request --
1402: 					 *  handle_command leaves d->data NULL and the guest,
1403: 					 *  told nothing it checks, triggers anyway.  Two shipped
1404: 					 *  defensive declines were feeding a host kill.
1405: 					 *
1406: 					 *  *** THE `idata = 0` IS LOAD-BEARING AND THE OBVIOUS
1407: 					 *  FIX OMITS IT. ***  The tail store below writes idata
1408: 					 *  into dma_reg[6] after every aligned break, and the
1409: 					 *  SUCCESS arm clears it for exactly that reason -- which
1410: 					 *  is why a completed transfer polls idle.  Drop the
1411: 					 *  exit(1) and simply break, as #447/#459/#460/#461 all
1412: 					 *  did at their sites, and the guest's trigger value 1
1413: 					 *  reaches the shadow: +0x18 then reads BUSY FOREVER.
1414: 					 *  Linux survives that (its waits are time-bounded), and it
1415: 					 *  is the guest this claim rests on: mainline byte-reads
1416: 					 *  +0x18 to poll completion, per this tree's own
1417: 					 *  `gdromdmawidth` assessment.
1418: 					 *
1419: 					 *  *** THIS COMMENT USED TO CITE NetBSD, AND THAT CITATION
1420: 					 *  WAS WRONG. ***  It said NetBSD's status waits are
1421: 					 *  unbounded spins, exhibiting
1422: 					 *  `while ((GDROM_BUSY & 0x88) != 0x08) ;`.  That loop exits
1423: 					 *  only when bit 3 is SET and bit 7 CLEAR, and +0x18 is
1424: 					 *  {0 idle, 1 busy} -- neither ANDs to 0x08, so it would
1425: 					 *  hang on CORRECT hardware.  It is the command-start
1426: 					 *  handshake on the CONTROL window's BUSY register: see
1427: 					 *  the GDROM_COND case in this same file, which documents
1428: 					 *  it and sets `d->busy |= 0x08` in reply.  The exhibit was
1429: 					 *  lifted from there and re-pointed at a register it says
1430: 					 *  nothing about.  Filed as `gdromdriverclaims`.
1431: 					 *
1432: 					 *  *** AND THE COMPLETION EVENT MUST NOT FIRE. ***  A
1433: 					 *  completion on a DECLINED transfer would be a FALSE SUCCESS;
1434: 					 *  the mechanism, and why a detectable stall is the honest
1435: 					 *  failure, are in the `As reported` paragraph below.
1436: 					 *  (This sentence was severed mid-word when that block was
1437: 					 *  inserted after its opening `A`.  A first repair restated
1438: 					 *  the whole argument here and duplicated it ~24 lines apart
1439: 					 *  in one comment block; the words were right, they belong
1440: 					 *  once.)
1441: 					 *
1442: 					 *  *** THE THREE DRIVER CLAIMS IN THIS COMMENT ARE
1443: 					 *  SEAT-REPORTED, NOT VERIFIED LOCALLY.  There is no copy
1444: 					 *  of Linux's drivers/cdrom/gdrom.c or NetBSD's
1445: 					 *  sys/arch/dreamcast/dev/gdrom.c anywhere in this tree, so
1446: 					 *  nothing here can be re-derived by a later reader. ***
1447: 					 *  This is the #357/#362/#365 shape -- DDI 0100I page numbers
1448: 					 *  that came from panel output rather than a local manual and
1449: 					 *  held by luck.  If the claim below is wrong, the choice to
1450: 					 *  decline WITHOUT signalling completion is wrong.  Filed as
1451: 					 *  `gdromdriverclaims`; obtaining the two sources is cheap and
1452: 					 *  is what settled the SH case.
1453: 					 *
1454: 					 *  As reported: gdrom_dma_interrupt() clears
1455: 					 *  gd.transfer UNCONDITIONALLY and inspects no error
1456: 					 *  bit, so signalling completion on an empty transfer
1457: 					 *  ends the wait with BLK_STS_OK -- the block layer is
1458: 					 *  told the read SUCCEEDED while zero bytes moved, and
1459: 					 *  the guest consumes the destination page as disk data.
1460: 					 *  That is #460's invented-behaviour class at the block
1461: 					 *  layer.  The driver has ONE error channel, its 7-second
1462: 					 *  timeout, so guest-visible EIO is not a compromise --
1463: 					 *  it is the only honest signal available here.
1464: 					 */
1465: 					if (!(d->warned & GDROM_W_DMANODATA)) {
1466: 						d->warned |= GDROM_W_DMANODATA;
1467: 						fatal("[ dreamcast_gdrom_dma: DMA start with no"
1468: 						    " staged data -- declined, the transfer does"
1469: 						    " not run.  (once) ]\n");
1470: 					}
1471: 					idata = 0;
1472: 					break;
1473: 				}
1474: 
1475: 				/*
1476: 				 *  *** AND IT SAT ABOVE THE `d->data == NULL` TEST, so the DECLINED
1477: 				 *  path announced a transfer it never ran -- while the comment below
1478: 				 *  claimed this line prints "the count actually transferred".  Three
1479: 				 *  seats found it independently on the pass-2 diff.
1480: 				 *
1481: 				 *  Moved BELOW the check, and left ABOVE the `dst &= 0x0fffffff` mask,
1482: 				 *  so the ADDRESS it prints is unchanged by the move.
1483: 				 *
1484: 				 *  (This said "the round is only fixing WHEN it says it", which the
1485: 				 *  diff refutes: a separate hunk also changes WHAT it says, `length`
1486: 				 *  -> `d->data_len` plus the `guest asked for` clause.  Corrected in
1487: 				 *  the CHANGELOG first and HERE second -- the sibling this file's own
1488: 				 *  grep-for-siblings rule exists to catch.)
1489: 				 *
1490: 				 *  Pinned by `nodata notx`, MEASURED RED on the pre-move build
1491: 				 *  (50/51, sole red -- probe_pre51.raw).
1492: 				 */
1493: 				/*  #462: prints data_len, the count actually transferred.  It
1494: 				    printed `length` -- the guest's +0x08 register -- while the
1495: 				    memory_rw below moves d->data_len, so the line lied in
1496: 				    exactly the sessions where the two disagree.  */
1497: 				fatal("[ dreamcast_gdrom_dma: Transfering %i bytes to 0x%08"
1498: 				    PRIx32 " (guest asked for %i) ]\n",
1499: 				    (int) d->data_len, dst, length);
1500: 
1501: 				dst &= 0x0fffffff;	// 0x8c008000 => 0x0c008000
1502: 				cpu->memory_rw(cpu, cpu->mem, dst,
1503: 				    d->data, d->data_len, MEM_WRITE, PHYSICAL);
1504: 
1505: 				SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_GDROM_DMA);
1506: 
1507: 				idata = 0;
1508: 			} else {
1509: 				/*
1510: 				 *  #462: was exit(1).  MEASURED on the pre-fix build:
1511: 				 *  ONE guest store of 1 to +0x18 on a fresh device ends
1512: 				 *  the host process, because count and enable are both 0
1513: 				 *  and this arm runs.  The device-signature control --
1514: 				 *  the identical store to the implemented +0x04 -- leaves
1515: 				 *  the host alive.
1516: 				 *
1517: 				 *  Same `idata = 0` requirement as the sibling above, and
1518: 				 *  the same reason: without it the trigger value sticks in
1519: 				 *  the shadow and +0x18 reads busy forever.
1520: 				 */
1521: 				if (!(d->warned & GDROM_W_DMAARM)) {
1522: 					d->warned |= GDROM_W_DMAARM;
1523: 					fatal("[ dreamcast_gdrom_dma: DMA start with dst"
1524: 					    " 0x%08x len 0x%x count %i enable %i --"
1525: 					    " unsupported arming, declined.  (once) ]\n",
1526: 					    /*  #462 pass 2: %x requires unsigned int; a seat pointed out
1527: 					        that (int) is UB by the C format rules even though common
1528: 					        ABIs print the expected bits.  The count and enable args
1529: 					        below are %i and correctly stay int.  */
1530: 					    (unsigned int) d->dma_reg[4 / sizeof(uint32_t)],
1531: 					    (unsigned int) d->dma_reg[8 / sizeof(uint32_t)],
1532: 					    (int) d->dma_reg[0xc / sizeof(uint32_t)],
1533: 					    (int) d->dma_reg[0x14 / sizeof(uint32_t)]);
1534: 				}
1535: 				idata = 0;
1536: 			}
1537: 		}
1538: 		break;			
1539: 
1540: 	/*
1541: 	 *  #461: the SIBLING ARM, and it joined this round on a measurement.  It
1542: 	 *  was named in no filing and no brief until a seat enumerated the file --
1543: 	 *  the round's own scope list said 'two DMA sites' when there are three,
1544: 	 *  and this is the only one in the same semantic class as the arm above.
1545: 	 *  MEASURED: a 32-bit read scan of this window died on the first offset on
1546: 	 *  committed HEAD, and died again on a build that fixed only the control
1547: 	 *  window.
1548: 	 *
1549: 	 *  *** ONE FIX DESIGN IS TRUE OF THE LATCH AND FALSE OF THE DECLINE. ***
1550: 	 *  Above, `odata` is a local starting at 0, so declining means the tail
1551: 	 *  returns 0 and a declined write does nothing.  HERE, odata is already
1552: 	 *  loaded from the shadow register file before the switch, and the tail
1553: 	 *  STORES a declined write into that file.  So 'decline' in this window
1554: 	 *  means store-and-return, not discard -- which is what the five
1555: 	 *  implemented cases already do, and is kept deliberately.
1556: 	 *
1557: 	 *  *** THAT NEARLY SHIPPED A WORSE DEFECT THAN THE ONE IT FIXES, AND A
1558: 	 *  PASS-2 SEAT CAUGHT IT. ***  An earlier draft of this comment claimed
1559: 	 *  "no declined offset can reach a load-bearing one".  THAT IS FALSE, and
1560: 	 *  the reason is one character: the tail store indexes with TRUNCATING
1561: 	 *  division, `dma_reg[relative_addr / sizeof(uint32_t)]`.
1562: 	 *
1563: 	 *  A byte access at +0x05 does not match `case 0x04` -- the switch tests
1564: 	 *  the exact value -- so it reaches this arm, is declined and latched, and
1565: 	 *  THEN the tail stores it into dma_reg[1].  The same alias exists at
1566: 	 *  +0x09..0x0b -> dma_reg[2], +0x0d..0x0f -> dma_reg[3] and
1567: 	 *  +0x15..0x17 -> dma_reg[5].
1568: 	 *
1569: 	 *  Those four ARE the transfer: `case 0x18` reads dma_reg[3] (count) and
1570: 	 *  dma_reg[5] (enable) as its arming condition, then dma_reg[1] as the
1571: 	 *  destination and dma_reg[2] as the length.  So a guest could arm and AIM
1572: 	 *  a DMA transfer entirely through declined offsets, bypassing every check
1573: 	 *  the implemented cases perform.  PRE-FIX each of those accesses exited
1574: 	 *  instead, so this fix would have CREATED the capability -- the same shape
1575: 	 *  as #460's Option C, which was rejected for exactly this reason.
1576: 	 *
1577: 	 *  THE RULE: an UNALIGNED access never stores.  Alignment alone separates
1578: 	 *  "unimplemented word" from "misaligned access to an implemented one",
1579: 	 *  and only the first keeps store-and-return.
1580: 	 *
1581: 	 *  WHY THAT IS SOUND, as a proof rather than an appeal to intuition about
1582: 	 *  switch statements -- and INDEPENDENTLY RE-DERIVED by a review seat
1583: 	 *  before it was believed.  On multiples of 4 the map off -> off/4 is
1584: 	 *  INJECTIVE, so an aligned offset reaching this arm cannot share an index
1585: 	 *  with any implemented case: if it did, it would BE that case and the
1586: 	 *  switch would have matched it.  The implemented DMA offsets are
1587: 	 *  0x04/0x08/0x0c/0x14/0x18, i.e. indices 1/2/3/5/6; every aligned offset
1588: 	 *  reaching here yields 0, 4, or 7..31.  Disjoint by construction, not by
1589: 	 *  inspection.  Truncation can only collide for UNALIGNED addresses, which
1590: 	 *  is exactly what the guard rejects.
1591: 	 *
1592: 	 *  *** A FUTURE `case` AT AN ALIGNED OFFSET KEEPS THIS TRUE AUTOMATICALLY;
1593: 	 *  ONE AT AN UNALIGNED OFFSET WOULD BREAK IT. ***  There is no such thing
1594: 	 *  in this device, and the same seat checked the CONTROL window: its
1595: 	 *  default arm has no store tail at all, so there is no aliasing channel
1596: 	 *  there to guard, which is why the rule is stated only here.
1597: 	 *
1598: 	 *  The bitmap's own bounds guard does NOT help here -- it protects the
1599: 	 *  latch array, and dma_reg is a different array reached by a different
1600: 	 *  index.  Two arrays, two bounds problems, and only one of them was
1601: 	 *  guarded before a seat read the tail.
1602: 	 */
1603: 	default:if (GDROM_UNIMPL_FIRST(d->dma_unimpl_reported[
1604: 		    writeflag == MEM_READ ? GDROM_RD : GDROM_WR],
1605: 		    relative_addr)) {
1606: 			if (writeflag == MEM_READ)
1607: 				fatal("[ dreamcast_gdrom_dma: read from"
1608: 				    " addr 0x%x -- unimplemented, returning %s."
1609: 				    "  (once per offset per direction) ]\n", (int)relative_addr,
1610: 				    (relative_addr & (sizeof(uint32_t) - 1)) ?
1611: 				    "0" : "the shadow value");
1612: 			else
1613: 				fatal("[ dreamcast_gdrom_dma: write to addr"
1614: 				    " 0x%x: 0x%x -- unimplemented, %s."
1615: 				    "  (once per offset per direction) ]\n",
1616: 				    (int)relative_addr, (int)idata,
1617: 				    (relative_addr & (sizeof(uint32_t) - 1)) ?
1618: 				    "dropped" : "stored but inert");
1619: 		}
1620: 
1621: 		/*  #461 pass 2: an UNALIGNED declined access must not reach the
1622: 		    tail, whose truncating index would alias an implemented word.
1623: 		    Returning here skips BOTH tails; a declined unaligned READ
1624: 		    therefore also stops leaking the aliased word's value, which
1625: 		    is the same defect pointing the other way.  */
1626: 		if (relative_addr & (sizeof(uint32_t) - 1)) {
1627: 			if (writeflag == MEM_READ)
1628: 				memory_writemax64(cpu, data, len, 0);
1629: 			return 1;
1630: 		}
1631: 
1632: 		break;
1633: 	}
1634: 
1635: 	/*  Default write:  */
1636: 	/*
1637: 	 *  *** THIS STORE IS WIDTH-BLIND, AND THAT IS ASSESSED-NOT-CHANGED RATHER
1638: 	 *  THAN OVERLOOKED.  `gdromdmawidth`, adjudicated 2026-08-23. ***
1639: 	 *
1640: 	 *  `len` is used ONLY to marshal bytes (memory_readmax64 in, memory_writemax64
1641: 	 *  out).  An ALIGNED narrow write to an IMPLEMENTED offset therefore widens
1642: 	 *  to 32 bits zero-extended.  MEASURED on this build: seed +0x04 with
1643: 	 *  0x11223344 (32-bit), then byte-write 0xff at +0x04, then read back ->
1644: 	 *  0x000000ff.  Liveness control in the same run returned 0x12345678.
1645: 	 *
1646: 	 *  *** THE #461 ALIGNMENT RULE ABOVE NEITHER CAUSES NOR EXCUSES THIS. ***
1647: 	 *  That rule says an ALIGNED offset reaching the DEFAULT arm is genuinely an
1648: 	 *  unimplemented word.  It says nothing about an aligned NARROW access to an
1649: 	 *  IMPLEMENTED offset, which is a separate WIDTH question -- address
1650: 	 *  decoding and width validation are independent axes.  Written here
1651: 	 *  because a reader who applies that rule to this store would conclude the
1652: 	 *  site is safe.
1653: 	 *
1654: 	 *  NOT FIXED, and the reason is an ABSENT ORACLE, not laziness.  0x005f74xx
1655: 	 *  is Sega's Holly ASIC, outside the SH7750 manual, and this project holds
1656: 	 *  NO documentation for it -- so "real hardware preserves the upper bits"
1657: 	 *  would be an oracle from plausibility, the #357/#362 shape this tree has
1658: 	 *  already been burned by once.
1659: 	 *
1660: 	 *  *** AND MAINLINE LINUX CONSTRAINS ANY FUTURE FIX, WHICH IS THE FINDING
1661: 	 *  THAT KILLED THE PANEL'S UNANIMOUS ANSWER. ***  drivers/cdrom/gdrom.c
1662: 	 *  BYTE-WRITES this window's +0x18 to trigger every DMA transfer, and
1663: 	 *  BYTE-READS it to poll for completion; the four VALUE registers it uses
1664: 	 *  (+0x04/08/0c/14) are always 32-bit.  So the width-blind code delivers
1665: 	 *  exactly what the one real narrow user needs, and a blanket "decline
1666: 	 *  narrow writes" would BREAK a booting Linux.
1667: 	 *
1668: 	 *  THE DECIDED DESIGN, if a fix is ever warranted: decline with a latched
1669: 	 *  diagnostic at the four VALUE registers ONLY, keeping +0x18 byte-capable.
1670: 	 *  The discriminating row is seed 0x11223344 / byte 0xff / read back:
1671: 	 *  0x000000ff today, 0x11223344 declined, 0x112233ff merged.  It must NOT
1672: 	 *  ship as a green row pinning 0x000000ff -- that would enshrine this
1673: 	 *  model's own behaviour as an oracle.
1674: 	 */
1675: 	if (writeflag == MEM_WRITE)
1676: 		d->dma_reg[relative_addr / sizeof(uint32_t)] = idata;
1677: 
1678: 	if (writeflag == MEM_READ)
1679: 		memory_writemax64(cpu, data, len, odata);
1680: 
1681: 	return 1;
1682: }
1683: 
