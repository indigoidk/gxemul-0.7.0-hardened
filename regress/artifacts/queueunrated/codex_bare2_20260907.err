187: 		CPU_SETTINGS_ADD_REGISTER32(tmpstr, cpu->cd.sh.fr[i]);
188: 		snprintf(tmpstr, sizeof(tmpstr), "xf%i", i);
189: 		CPU_SETTINGS_ADD_REGISTER32(tmpstr, cpu->cd.sh.xf[i]);
190: 	}
191: 	for (i=0; i<SH_N_ITLB_ENTRIES; i++) {
192: 		char tmpstr[15];
193: 		snprintf(tmpstr, sizeof(tmpstr), "itlb_hi_%i", i);
194: 		CPU_SETTINGS_ADD_REGISTER32(tmpstr, cpu->cd.sh.itlb_hi[i]);
195: 		snprintf(tmpstr, sizeof(tmpstr), "itlb_lo_%i", i);
196: 		CPU_SETTINGS_ADD_REGISTER32(tmpstr, cpu->cd.sh.itlb_lo[i]);
197: 	}
198: 	for (i=0; i<SH_N_UTLB_ENTRIES; i++) {
199: 		char tmpstr[15];
200: 		snprintf(tmpstr, sizeof(tmpstr), "utlb_hi_%i", i);
201: 		CPU_SETTINGS_ADD_REGISTER32(tmpstr, cpu->cd.sh.utlb_hi[i]);
202: 		snprintf(tmpstr, sizeof(tmpstr), "utlb_lo_%i", i);
203: 		CPU_SETTINGS_ADD_REGISTER32(tmpstr, cpu->cd.sh.utlb_lo[i]);
204: 	}
205: 
206: 	/*  Register the CPU's interrupts:  */
207: 	if (cpu->cd.sh.cpu_type.arch == 4) {
208: 		for (i=SH_INTEVT_NMI; i<0x1000; i+=0x20) {
209: 			struct interrupt templ;
210: 			char name[100];
211: 			snprintf(name, sizeof(name), "%s.irq[0x%x]",
212: 			    cpu->path, i);
213: 			memset(&templ, 0, sizeof(templ));
214: 			templ.line = i;
215: 			templ.name = name;
216: 			templ.extra = cpu;
217: 			templ.interrupt_assert = sh_cpu_interrupt_assert;
218: 			templ.interrupt_deassert = sh_cpu_interrupt_deassert;
219: 			interrupt_handler_register(&templ);
220: 		}
221: 	} else {
222: 		struct interrupt templ;
223: 		memset(&templ, 0, sizeof(templ));
224: 		templ.line = i;
225: 		templ.name = cpu->path;
226: 		templ.extra = cpu;
227: 		templ.interrupt_assert = sh3_cpu_interrupt_assert;
228: 		templ.interrupt_deassert = sh3_cpu_interrupt_deassert;
229: 		interrupt_handler_register(&templ);
230: 	}
231: 
232: 	/*  SH4-specific memory mapped registers, TLBs, caches, etc:  */
233: 	if (cpu->cd.sh.cpu_type.arch == 4) {
234: 		cpu->cd.sh.pcic_pcibus = (struct pci_data *) device_add(machine, "sh4");
235: 
236: 		/*
237: 		 *  Interrupt Controller initial values, according to the
238: 		 *  SH7760 manual:
239: 		 */
240: 		cpu->cd.sh.intc_iprd = 0xda74;
241: 		cpu->cd.sh.intc_intmsk00 = 0xf3ff7fff;
242: 		cpu->cd.sh.intc_intmsk04 = 0x00ffffff;
243: 		/*  All others are zero.  */
244: 
245: 		/*  TODO: Initial priorities?  */
246: 		cpu->cd.sh.intc_intpri00 = 0x33333333;
247: 		cpu->cd.sh.intc_intpri04 = 0x33333333;
248: 		cpu->cd.sh.intc_intpri08 = 0x33333333;
249: 		cpu->cd.sh.intc_intpri0c = 0x33333333;
250: 	}
251: 
252: 	sh_update_interrupt_priorities(cpu);
253: 
254: 	return 1;
255: }
