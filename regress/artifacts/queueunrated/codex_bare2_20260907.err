1501: 				dst &= 0x0fffffff;	// 0x8c008000 => 0x0c008000
1502: 				cpu->memory_rw(cpu, cpu->mem, dst,
1503: 				    d->data, d->data_len, MEM_WRITE, PHYSICAL);
