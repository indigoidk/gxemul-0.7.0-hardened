223:     "0x%x" % IPRD_RESET, "IPRD reset value, served by the sh4 device")
224: 
225: print("SH_PCLOCK_CONTROL=%s" % ("OK" if all(ok for _, ok in rows) else "DEAD"))
226: 
227: #  ---------------------------------------------------------------- the trigger
228: #  One 16-bit store to TCR0.  On the committed build this ends the host process.
229: 
230: KILL = re.compile(r"pclock must be set", re.I)
231: 
232: #  THREE machines, not two.  A pass-1 seat caught that the brief had
233: #  attributed machine_test.c:535 to testsh; :535 is MACHINE_DEFAULT_CPU(baresh)
234: #  and :541 is MACHINE_DEFAULT_CPU(testsh) -- two separate machines, both
235: #  naming SH7750 and neither assigning pclock.  Five sites in the tree name an
236: #  arch-4 SH CPU; dreamcast and landisk set pclock, these three do not.
237: for mach, flag, label in (("jornada680", "-e", "hpcsh"),
238:                           ("baresh", "-E", "baresh"),
239:                           ("testsh", "-E", "testsh")):
240:     t, alive = session(store_code(CODE[mach], SH4_TCR0, 0x0000) + ["step 1"],
241:                        machine=mach, flag=flag)
242:     #  `alive` is the discriminator: exit(1) closes the pty, so the write of the
243:     #  NEXT command raises OSError.  The diagnostic text is the corroboration --
244:     #  it must BOTH die and say why, or the row is measuring something else.
245:     row("%s kill" % label, "survived" if alive else "died", "survived",
246:         "one mov.w to SH4_TCR0 (0xffd80010)")
247:     row("%s diag" % label, "quiet" if not KILL.search(t) else "pclock-fatal",
248:         "quiet", "the INTERNAL ERROR text must be gone")
249: 
250: #  ---------------------------------------------------------------- accept side
251: #
252: #  *** THE DE-ESCALATION CLAUSE'S COST, PAID UP FRONT. ***
253: #
