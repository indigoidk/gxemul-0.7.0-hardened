566: static int gdrom_unimpl_first(uint32_t *bits, size_t nkeys, uint32_t off)
567: {
568: 	size_t k = off / sizeof(uint32_t);
569: 	uint32_t bit;
570: 
571: 	if (k >= nkeys)
572: 		return 0;
573: 
574: 	bit = 1u << (k & 31);
575: 	if (bits[k >> 5] & bit)
576: 		return 0;
577: 
578: 	bits[k >> 5] |= bit;
579: 	return 1;
580: }
