rg --files GXEMUL-SEC/regress -g '*.py' -g '"'!artifacts'"' -g '"'!__pycache__'"' | rg 'sh_|sh4|gdrom|gate|build'
Get-Content -LiteralPath GXEMUL-SEC/regress/gate_build.sh | Select-Object -Last 45" in C:\DocumentNoSnc\CC\GXEMUL
