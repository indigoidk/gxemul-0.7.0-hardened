176: def dumped(t, addr):
177:     """Read back a word the guest stored, from the debugger's own dump."""
178:     m = re.search(r"%08x[^\r\n]*?\b([0-9a-f]{8})\b" % addr, t, re.I)
179:     return ("0x" + m.group(1).lower()) if m else "absent"
180: 
181: 
182: def printed(t, reg):
183:     m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
184:     return m.group(1) if m else "absent"
