1: #!/usr/bin/env python3
2: """DETECTOR for sh4pclock, which also carries the round's witness measurement.
3: 
4: Its rows assert the POST-fix state -- the write is declined, the host survives,
5: the refusal names itself once per timer, and the write does not land -- so it is
6: green after the fix and safe to gate.  The WITNESS is the recorded fact that this
7: same script scored 6/16 on the pre-fix build; a probe whose rows asserted the
8: pre-fix symptom would go red the day the fix landed, and gating it would
9: manufacture a regression.  The two roles are distinct and this file is the
10: second one.
11: 
12: The defect: one guest TCR store ended the host on machines that never set pclock.
13: 
14: THE CHAIN, four links, each read rather than assumed:
15: 
16:   1. The sh4 device is added BY THE CPU -- cpu_sh.c, `device_add(machine, "sh4")`
17:      -- so every arch-4 SH CPU carries the TCR handler whatever machine booted.
18:   2. Only TWO machines assign pclock: machine_dreamcast.c:51 (50000000) and
19:      machine_landisk.c:81 (33333333).
20:   3. But FIVE machine sites name an arch-4 CPU: dreamcast and landisk (which set
21:      it), plus machine_hpcsh.c:89, and machine_test.c:535 and :541 -- which are
22:      TWO SEPARATE MACHINES, baresh and testsh.  (An earlier draft of this line
23:      said FOUR, two sentences above the paragraph that announces the correction.
24:      Those two are the strdup lines; the MACHINE_DEFAULT_CPU labels are :533/:539.)
25:   4. So on -e jornada680, -E baresh and -E testsh, pclock is 0, and BEFORE #459 the
26:      TCR write arm ran `fatal(...); exit(1);`.  (Past tense on purpose: that code is
27:      gone, and citing its old line numbers here would rot on the next edit.)
28: 
29: *** THREE machine types, not two, and the brief that opened this round said two. ***
30: Two pass-1 seats independently caught it: `machine_test.c:535` is
31: `MACHINE_DEFAULT_CPU(baresh)` and `:541` is `MACHINE_DEFAULT_CPU(testsh)` -- two
32: separate registered machines inside one file.  FIVE registered SH machine types name
33: an arch-4 CPU; dreamcast and landisk assign pclock, the other three do not.
34: 
35: Rung 3 by the witness ladder: a real guest instruction through real address
36: decode, on an UNMODIFIED in-tree machine description.  Nothing is added to reach
37: the site -- the site is reached by an ordinary store to 0xffd80010.
38: 
39: *** THE CONTROLS RUN IN THEIR OWN SESSIONS AND DO NOT TOUCH TCR. ***  A previous
40: probe in this tree put its "does the session come up" control in the same session
41: as the trigger, so the control exercised the defect and reported DEAD on a correct
42: build.  Here `live` and `devsig` never write TCR, so a red `kill` row cannot be
43: confused with a broken session.
44: 
45: The device signature is IPRD's reset value H'DA74 (SH7750 Hardware Manual
46: Rev.7.00, stated at :39856, :40194 and :48567).  RAM would answer differently,
47: and an unmapped address would report `non-existant paddr` -- so a correct read
48: proves the sh4 device is present and serving, which is link 1 of the chain.
49: """
50: import os
51: import pty
52: import re
53: import select
54: import sys
55: import time
56: 
57: BIN = sys.argv[1] if len(sys.argv) > 1 else "../../build/gxemul"
58: KERNEL = sys.argv[2] if len(sys.argv) > 2 else "../../_images/openbsd76-landisk-bsd.rd"
59: 
60: #  Every SH machine here needs a file argument to construct at all -- bare
61: #  `-e jornada680` exits with "No filename given" before any device is added.
62: #  The kernel is only a construction argument: nothing boots, the debugger
63: #  stops cold, and the guest instruction is planted by hand.  hpcsh also warns
64: #  about missing -X, which is harmless for a cold-debugger probe.
65: 
66: #  *** EACH MACHINE NEEDS ITS OWN ADDRESS, AND GETTING THIS WRONG VOIDS THE ROW
67: #  SILENTLY. ***  hpcsh RAM is 32 MB at 0x0c000000 (machine_hpcsh.c:77-80 -- :76 is
68: #  the comment line above the dev_ram_init calls), so P1 is
69: #  0x8c000000; testsh has RAM at physical 0, so P1 is 0x80000000.  A previous
70: #  attempt at this defect reused one machine's scratch on the other, the store
71: #  never landed, and the machine read as NOT REPRODUCING -- which is a false
72: #  NEGATIVE, the direction that quietly closes a live defect.
73: CODE = {"jornada680": 0x8c001000, "testsh": 0x80001000,
74:         "baresh": 0x80001000, "landisk": 0x8c001000,
75:         "dreamcast": 0x8c001000}
76: #  Only jornada680 is listed: the liveness control runs on that machine alone, and a
77: #  seat flagged the other entries as dead weight that reads like coverage.
78: SCRATCH = {"jornada680": 0x8c002000}
79: 
80: SH4_TCR0 = 0xffd80010          # Timer Control Register 0 (sh4_tmureg.h:54)
81: SH4_TCR1 = 0xffd8001c          # Timer Control Register 1 (sh4_tmureg.h:57)
82: SH4_IPRD = 0xffd00010          # reset value 0xda74 -- the device signature
83: IPRD_RESET = 0xda74
84: LIVE = 0x12345678              # asymmetric on purpose: a palindrome once hid a
85:                                # byte-order defect in another probe's own parser
86: 
87: MOV_W_R8_AT_R7 = 0x2781        # mov.w r8,@r7
88: MOV_L_R8_AT_R7 = 0x2782        # mov.l r8,@r7
89: MOV_L_AT_R1_R2 = 0x6212        # mov.l @r1,r2
90: MOV_W_AT_R1_R2 = 0x6211        # mov.w @r1,r2
91: 
92: TCR_TPSC_P4 = 0x0000           # sh4_tmureg.h:85
93: TCR_TPSC_P16 = 0x0001          # sh4_tmureg.h:86
94: LANDISK_PCLOCK = 33333333      # machine_landisk.c:81
95: DREAMCAST_PCLOCK = 50000000    # machine_dreamcast.c:51
96: LANDISK_CODE = 0x8c001000
97: DREAMCAST_CODE = 0x8c001000    # dreamcast RAM is 16 MB at 0x0c000000
98: BRA_SELF = 0xaffe
99: NOP = 0x0009
100: 
101: rows = []
102: 
103: 
104: def row(name, got, want, note=""):
105:     ok = (got == want)
106:     rows.append((name, ok))
107:     print("%-14s %-12s %-12s %-34s %s" % (name, got, want, note,
108:                                           "ok" if ok else "FAIL"))
109:     return ok
110: 
111: 
112: def session(cmds, machine="jornada680", flag="-e", settle=6.0, spin=2.0):
113:     """Run one cold-debugger session.  Returns (transcript, process_survived)."""
114:     pid, fd = pty.fork()
115:     if pid == 0:
116:         #  *** DREAMCAST NEEDS -x OR IT EXITS BEFORE THE DEBUGGER PROMPT. ***
117:         #  It brings up TWO console inputs -- "SH4 SCIF" and "maple" -- and
118:         #  console.c:994-1007 makes that fatal unless allow_slaves is set.  The
119:         #  first draft of the dreamcast row read "died" and that was NOT the
120:         #  defect: it is the same shape as the trigger rows, so it would have
121:         #  been scored as a second reproduction.  -x only sets allow_slaves
122:         #  (console.c:985 returns immediately); no xterm is spawned, because a
123:         #  cold-debugger probe never drives a slave console.  Verified headless.
124:         args = [BIN, "-V"]
125:         if machine == "dreamcast":
126:             args.append("-x")
127:         args += [flag, machine, "-M", "64", KERNEL]
128:         os.execv(BIN, args)
129:         os._exit(127)
130:     buf = ""
131: 
132:     def rd(t):
133:         nonlocal buf
134:         end = time.time() + t
135:         while time.time() < end:
136:             r, _, _ = select.select([fd], [], [], 0.25)
137:             if not r:
138:                 continue
139:             try:
140:                 d = os.read(fd, 65536)
141:             except OSError:
142:                 return False
143:             if not d:
144:                 return False
145:             buf += d.decode("latin-1", "replace")
146:         return True
147: 
148:     alive = rd(settle)
149:     for i, c in enumerate(cmds):
150:         try:
151:             os.write(fd, (c + "\n").encode("latin-1"))
152:         except OSError:
153:             alive = False
154:             break
155:         #  Only the LAST command gets the long wait; applying it to every command
156:         #  once made a single session take ~510 s instead of 30.
157:         if not rd(spin if i == len(cmds) - 1 else 0.35):
158:             alive = False
159:             break
160:     try:
161:         os.write(fd, b"quit\n")
162:         rd(0.6)
163:     except OSError:
164:         pass
165:     try:
166:         os.close(fd)
167:     except OSError:
168:         pass
169:     try:
170:         _, st = os.waitpid(pid, 0)
171:     except OSError:
172:         st = 0
173:     return buf, alive
174: 
175: 
176: def dumped(t, addr):
177:     """Read back a word the guest stored, from the debugger's own dump."""
178:     m = re.search(r"%08x[^\r\n]*?\b([0-9a-f]{8})\b" % addr, t, re.I)
179:     return ("0x" + m.group(1).lower()) if m else "absent"
180: 
181: 
182: def printed(t, reg):
183:     m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
184:     return m.group(1) if m else "absent"
185: 
186: 
187: def store_code(at, reg, value, op=MOV_W_R8_AT_R7):
188:     """r7 <- reg, r8 <- value, one store, then spin."""
189:     return ["r7=0x%x" % reg, "r8=0x%08x" % value,
190:             "put h 0x%x, 0x%04x" % (at, op),
191:             "put h 0x%x, 0x%04x" % (at + 2, BRA_SELF),
192:             "put h 0x%x, 0x%04x" % (at + 4, NOP),
193:             "pc=0x%x" % at]
194: 
195: 
196: #  ---------------------------------------------------------------- controls
197: #  NEITHER control writes TCR.  If the trigger row goes red they stay green,
198: #  which is what makes the red attributable.
199: 
200: #  Read back through a GUEST LOAD, not the debugger's dump.  The first draft
201: #  dumped memory and compared against 0x12345678; it got 0x78563412, because a
202: #  byte dump is endian-ordered and the comparison was not.  A guest load and a
203: #  register read are endian-neutral by construction, and the asymmetric value is
204: #  what made the mistake visible at all.
205: AT = CODE["jornada680"]
206: t, alive = session(["r7=0x%x" % SCRATCH["jornada680"], "r8=0x%08x" % LIVE, "r1=0x%x" % SCRATCH["jornada680"],
207:                     "r2=0",
208:                     "put h 0x%x, 0x%04x" % (AT, MOV_L_R8_AT_R7),
209:                     "put h 0x%x, 0x%04x" % (AT + 2, MOV_L_AT_R1_R2),
210:                     "put h 0x%x, 0x%04x" % (AT + 4, BRA_SELF),
211:                     "put h 0x%x, 0x%04x" % (AT + 6, NOP),
212:                     "pc=0x%x" % AT, "step 2", "print r2"])
213: row("live", printed(t, "r2") if alive else "died", "0x%x" % LIVE,
214:     "RAM: guest store then guest load")
215: 
216: t, alive = session(["r1=0x%x" % SH4_IPRD, "r2=0",
217:                     "put h 0x%x, 0x%04x" % (AT, MOV_L_AT_R1_R2),
218:                     "put h 0x%x, 0x%04x" % (AT + 2, BRA_SELF),
219:                     "put h 0x%x, 0x%04x" % (AT + 4, NOP),
220:                     "pc=0x%x" % AT, "step 1", "print r2"])
221: got = printed(t, "r2") if alive else "died"
222: row("devsig", ("0x%x" % (int(got, 16) & 0xffff)) if got.startswith("0x") else got,
223:     "0x%x" % IPRD_RESET, "IPRD reset value, served by the sh4 device")
224: 
225: print("SH_PCLOCK_CONTROL=%s" % ("OK" if all(ok for _, ok in rows) else "DEAD"))
226: 
227: #  ---------------------------------------------------------------- the trigger
228: #  One 16-bit store to TCR0.  On the committed build this ends the host process.
229: 
230: KILL = re.compile(r"pclock must be set", re.I)
231: 
232: #  THREE machines, not two.  A pass-1 seat caught that the brief had
233: #  attributed machine_test.c:535 to testsh; :535 is MACHINE_DEFAULT_CPU(baresh)
234: #  and :541 is MACHINE_DEFAULT_CPU(testsh) -- two separate machines, both
235: #  naming SH7750 and neither assigning pclock.  Five sites in the tree name an
236: #  arch-4 SH CPU; dreamcast and landisk set pclock, these three do not.
237: for mach, flag, label in (("jornada680", "-e", "hpcsh"),
238:                           ("baresh", "-E", "baresh"),
239:                           ("testsh", "-E", "testsh")):
240:     t, alive = session(store_code(CODE[mach], SH4_TCR0, 0x0000) + ["step 1"],
241:                        machine=mach, flag=flag)
242:     #  `alive` is the discriminator: exit(1) closes the pty, so the write of the
243:     #  NEXT command raises OSError.  The diagnostic text is the corroboration --
244:     #  it must BOTH die and say why, or the row is measuring something else.
245:     row("%s kill" % label, "survived" if alive else "died", "survived",
246:         "one mov.w to SH4_TCR0 (0xffd80010)")
247:     row("%s diag" % label, "quiet" if not KILL.search(t) else "pclock-fatal",
248:         "quiet", "the INTERNAL ERROR text must be gone")
249: 
250: #  ---------------------------------------------------------------- accept side
251: #
252: #  *** THE DE-ESCALATION CLAUSE'S COST, PAID UP FRONT. ***
253: #
254: #  Whatever this round does about the machines that never set pclock, it is a
255: #  fatal->survive change at a guard, and the project's rule is that such a fix
256: #  DELETES the accidental tripwire that made guard growth self-announcing.
257: #  Before the change, widening this predicate meant exit(1) on the first legal
258: #  write -- unmissable.  After it, the same edit means a silently refused write
259: #  and NOTHING anywhere notices.  So the accept side has to be pinned.
260: #
261: #  These rows are OPTION-INDEPENDENT: landisk assigns pclock = 33333333
262: #  (machine_landisk.c:81) and must keep accepting TCR writes no matter what is
263: #  decided for hpcsh and testsh.  They are GREEN on the committed build by
264: #  construction -- an accept row that is red before the fix is measuring the
265: #  defect, not the accept side.
266: #
267: #  Two channels, because one is not enough.  The frequency print is computed
268: #  from pclock and so proves the RATE was installed; the TCR read-back proves
269: #  the WRITE LANDED at all.  #447's own comment cites the read-back as the way
270: #  "the guest can see the rejection", so it is the channel a refusal moves.
271: 
272: t, alive = session(["r7=0x%x" % SH4_TCR0, "r8=0x%04x" % TCR_TPSC_P4,
273:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE, MOV_W_R8_AT_R7),
274:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE + 2, BRA_SELF),
275:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE + 4, NOP),
276:                     "pc=0x%x" % LANDISK_CODE, "step 1"],
277:                    machine="landisk", flag="-E")
278: want_hz = LANDISK_PCLOCK / 4.0
279: m = re.search(r"sh4 timer 0 clock set to ([0-9.]+) Hz", t)
280: row("accept hz", (m.group(1) if m else "absent") if alive else "died",
281:     "%f" % want_hz, "landisk TPSC=P4 -> pclock/4")
282: 
283: #  Read TCR0 back through a guest load, in the same session as the write, so
284: #  the two halves cannot disagree about which store they are describing.
285: t, alive = session(["r7=0x%x" % SH4_TCR0, "r8=0x%04x" % TCR_TPSC_P16,
286:                     "r1=0x%x" % SH4_TCR0, "r2=0",
287:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE, MOV_W_R8_AT_R7),
288:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE + 2, MOV_W_AT_R1_R2),
289:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE + 4, BRA_SELF),
290:                     "put h 0x%x, 0x%04x" % (LANDISK_CODE + 6, NOP),
291:                     "pc=0x%x" % LANDISK_CODE, "step 2", "print r2"],
292:                    machine="landisk", flag="-E")
293: got = printed(t, "r2") if alive else "died"
294: row("accept tcr", ("0x%x" % (int(got, 16) & 0xffff)) if got.startswith("0x") else got,
295:     "0x%x" % TCR_TPSC_P16, "landisk: the write LANDS and reads back")
296: 
297: #  *** TWO CLOCK VALUES, NOT ONE, AND THAT IS THE WHOLE POINT OF THE SECOND. ***
298: #  A pass-1 seat observed that a single accept row pinned at 33.33 MHz is passed
299: #  by a mutant that HARDCODES 33333333 in place of cpu->cd.sh.pclock -- the row
300: #  cannot tell "reads the machine's clock" from "happens to agree with landisk".
301: #  Dreamcast's 50 MHz is the discriminator: a hardcode cannot satisfy both.
302: t, alive = session(["r7=0x%x" % SH4_TCR0, "r8=0x%04x" % TCR_TPSC_P4,
303:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE, MOV_W_R8_AT_R7),
304:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE + 2, BRA_SELF),
305:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE + 4, NOP),
306:                     "pc=0x%x" % DREAMCAST_CODE, "step 1"],
307:                    machine="dreamcast", flag="-E")
308: m = re.search(r"sh4 timer 0 clock set to ([0-9.]+) Hz", t)
309: row("accept dc hz", (m.group(1) if m else "absent") if alive else "died",
310:     "%f" % (DREAMCAST_PCLOCK / 4.0), "dreamcast TPSC=P4 -> pclock/4")
311: 
312: #  Landisk had BOTH channels and dreamcast only the frequency -- asymmetric
313: #  coverage on the two rows that carry the whole de-escalation clause, caught by
314: #  a measuring seat.  Both machines now pin both channels.
315: t, alive = session(["r7=0x%x" % SH4_TCR0, "r8=0x%04x" % TCR_TPSC_P16,
316:                     "r1=0x%x" % SH4_TCR0, "r2=0",
317:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE, MOV_W_R8_AT_R7),
318:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE + 2, MOV_W_AT_R1_R2),
319:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE + 4, BRA_SELF),
320:                     "put h 0x%x, 0x%04x" % (DREAMCAST_CODE + 6, NOP),
321:                     "pc=0x%x" % DREAMCAST_CODE, "step 2", "print r2"],
322:                    machine="dreamcast", flag="-E")
323: got = printed(t, "r2") if alive else "died"
324: row("accept dc tcr", ("0x%x" % (int(got, 16) & 0xffff)) if got.startswith("0x") else got,
325:     "0x%x" % TCR_TPSC_P16, "dreamcast: the write LANDS and reads back")
326: 
327: #  ------------------------------------------------- the decline is OBSERVABLE
328: #
329: #  *** THE `diag` ROWS ABOVE ONLY CHECK THAT THE OLD TEXT IS GONE, AND ON THEIR
330: #  OWN THAT IS VACUOUS. ***  A mutant that deletes the whole guard body and just
331: #  falls through -- or one that declines SILENTLY with no diagnostic at all --
332: #  passes every row above.  #459 removed a host-fatal guard, and the project's
333: #  de-escalation clause says such a fix DELETES the accidental tripwire that made
334: #  the behaviour self-announcing.  These four rows are that tripwire, rebuilt on352:              "pc=0x%x" % at, "step %d" % len(regs)]
353:     return cmds
354: 
355: 
356: t, alive = session(tcr_writes([SH4_TCR0]))
357: row("hpcsh says", ("said" if SAYS.search(t) else "silent") if alive else "died",
358:     "said", "the refusal must NAME itself, once")
359: 
360: t, alive = session(tcr_writes([SH4_TCR0, SH4_TCR0]))
361: row("hpcsh once", ("%d" % len(SAYS.findall(t))) if alive else "died", "1",
362:     "SAME timer twice -> exactly one line")
363: 
364: t, alive = session(tcr_writes([SH4_TCR0, SH4_TCR1]))
365: row("hpcsh pertmr", ("%d" % len(SAYS.findall(t))) if alive else "died", "2",
366:     "TCR0 then TCR1 -> two lines, one per timer")
367: 
368: #  #447's own comment cites the read-back as how "the guest can see the
369: #  rejection".  This is the channel a guest has; the diagnostic is the operator's.
370: t, alive = session(["r7=0x%x" % SH4_TCR0, "r8=0x%04x" % TCR_TPSC_P16,
371:                     "r1=0x%x" % SH4_TCR0, "r2=0xffff",
372:                     "put h 0x%x, 0x%04x" % (AT, MOV_W_R8_AT_R7),
373:                     "put h 0x%x, 0x%04x" % (AT + 2, MOV_W_AT_R1_R2),
374:                     "put h 0x%x, 0x%04x" % (AT + 4, BRA_SELF),
375:                     "put h 0x%x, 0x%04x" % (AT + 6, NOP),
376:                     "pc=0x%x" % AT, "step 2", "print r2"])
377: got = printed(t, "r2") if alive else "died"
378: row("hpcsh unlatch", ("0x%x" % (int(got, 16) & 0xffff)) if got.startswith("0x") else got,
379:     "0x0", "the refused write must NOT land: TCR reads back 0")
380: 
381: n = sum(1 for _, ok in rows if ok)
382: print("SH_PCLOCK_RESULT=%d/%d" % (n, len(rows)))
383: print("SH_PCLOCK_VECTOR=" + ",".join(("1" if ok else "0") for _, ok in rows))

