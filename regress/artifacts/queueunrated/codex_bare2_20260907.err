 succeeded in 283ms:
1: #!/usr/bin/env python3
2: """DETECTOR for sh4iprbcd (IPRB/IPRC/IPRD never read) + sh4prioraise (no rescan).
3: 
4: Its rows assert the POST-fix state, which is why it is gated; the witness is the
5: recorded 6/10 (10-row era) pre-fix measurement, not the rows themselves.  That 6/10 was taken
6: against the then 10-row pin and is quoted here as HISTORY -- the detector has
7: since grown to 18 rows, and no pre-fix number has been measured at that count.
8: Saying so is the point: `6/10 (10-row era)` and a stale claim are the same three characters,
9: so the era has to be written down or a reader cannot tell them apart.
10: 
11: Route: SCIF TXI (INTEVT 0x760) on landisk.  It is the ONE Table 19.6 source in
12: this tree that a device asserts SYNCHRONOUSLY inside a guest store --
13: dev_sh4.c:2535+, `case SH4_SCIF_BASE + SCIF_SSR:` writes scif_ssr and calls
14: scif_reassert_interrupts(), which INTERRUPT_ASSERTs scif_tx_irq when
15: SCSCR2.TIE && SCSSR2.(TDFE|TEND).  So the assert can be produced under `step`,
16: where debugger.c:800 has stopped the host timers.
17: 
18: Delivery itself must be observed FREE-RUNNING: cpu_dyntrans.c:204-206 refuses to
19: deliver interrupts while single-stepping.  Discriminator = a breakpoint at
20: VBR+0x600.  Delivered -> the vector is reached, the breakpoint stops the guest,
21: the debugger answers `print 0x1234`.  Refused -> the guest spins in `bra .`
22: forever and never returns to a prompt.
23: 
24: Rows are IMASK-BRACKETED in both directions on purpose.  cpu_dyntrans.c:247-249
25: delivers only when `IMASK < int_level`, so a pair of rows at IMASK=k pins the
26: level to a range rather than to "nonzero".  A single "did something deliver" row
27: is passed by any nonzero priority, which is exactly the escape this file exists
28: to close: PRE-FIX, SCIF sits at 3 unconditionally, from
29: `(intc_intpri08 >> 16) & 0xf` with intpri08 initialised to 0x33333333.
30: """
31: import os
32: import pty
33: import re
34: import select
35: import sys
36: import time
37: 
38: BIN = sys.argv[1]
39: KERNEL = sys.argv[2]
40: 
41: LANDISK_CODE = 0x8c010000
42: SCRATCH = 0x8c010200
43: VBR = 0x8c020000
44: HANDLER = VBR + 0x600
45: LIVE = 0x12345678
46: 
47: SH4_IPRA = 0xffd00004
48: SH4_IPRC = 0xffd0000c
49: SH4_IPRD = 0xffd00010          # reset value 0xda74 -- the device signature
50: SCSCR2 = 0xffe80008            # TIE = 0x0080
51: SCSSR2 = 0xffe80010            # TDFE|TEND = 0x0060
52: #  MEASURED, not assumed: `mov.w @Rn,R0` SIGN-EXTENDS, so the 0xda74 the device
53: #  answers arrives in R0 as 0xffffda74.  Asymmetric under byte swap either way,
54: #  which is what the control needs.
55: IPRD_RESET = 0xffffda74
56: 
57: MOV_W_R2_AT_R1 = 0x2121
58: MOV_W_R4_AT_R3 = 0x2341
59: MOV_W_R6_AT_R5 = 0x2561
60: MOV_W_R8_AT_R7 = 0x2781
61: MOV_L_R0_AT_R1 = 0x2102
62: MOV_W_AT_R1_R0 = 0x6011        # mov.w @r1,r0  (sign-extending 16-bit load)
63: MOV_L_R0_AT_R2 = 0x2202
64: BRA_SELF = 0xaffe
65: NOP = 0x0009
66: 
67: 
68: def session(cmds, settle=8.0, spin=6.0, verify=True, machine="landisk"):
69:     pid, fd = pty.fork()
70:     if pid == 0:
71:         os.execv(BIN, [BIN, "-V", "-E", machine, "-M", "64", KERNEL])
72:         os._exit(127)
73:     buf = ""
74: 
75:     def rd(t):
76:         nonlocal buf
77:         end = time.time() + t
78:         while time.time() < end:
79:             r, _, _ = select.select([fd], [], [], 0.25)
80:             if not r:
81:                 continue
82:             try:
83:                 d = os.read(fd, 65536)
84:             except OSError:
85:                 return False
86:             if not d:
87:                 return False
88:             buf += d.decode("latin-1", "replace")
89:         return True
90: 
91:     alive = rd(settle)
92:     for i, c in enumerate(cmds):
93:         try:
94:             os.write(fd, (c + "\n").encode("latin-1"))
95:         except OSError:
96:             alive = False
97:             break
98:         if not rd(spin if i == len(cmds) - 1 else 0.9):
99:             alive = False
100:             break
101:     if alive and verify:
102:         mark = len(buf)
103:         try:
104:             os.write(fd, b"print 0x1234\n")
105:             rd(1.5)
106:             alive = "0x1234" in buf[mark:] or "4660" in buf[mark:]
107:         except OSError:
108:             alive = False
109:     try:
110:         os.write(fd, b"quit\n")
111:         time.sleep(0.2)
112:         os.kill(pid, 9)
113:         os.waitpid(pid, 0)
114:     except Exception:
115:         pass
116:     return buf, alive
117: 
118: 
119: def handler_stub():
120:     return ["put h 0x%x, 0x%04x" % (HANDLER, NOP),
121:             "put h 0x%x, 0x%04x" % (HANDLER + 2, BRA_SELF),
122:             "put h 0x%x, 0x%04x" % (HANDLER + 4, NOP)]
123: 
124: 
125: def scif_assert_code(iprc, at=LANDISK_CODE):
126:     """Three synchronous stores: IPRC, then SCSCR2.TIE, then SCSSR2.TDFE|TEND."""
127:     return (["r1=0x%x" % SH4_IPRC, "r2=0x%08x" % iprc,
128:              "r3=0x%x" % SCSCR2, "r4=0x00000080",
129:              "r5=0x%x" % SCSSR2, "r6=0x00000060",
130:              "put h 0x%x, 0x%04x" % (at, MOV_W_R2_AT_R1),
131:              "put h 0x%x, 0x%04x" % (at + 2, MOV_W_R4_AT_R3),
132:              "put h 0x%x, 0x%04x" % (at + 4, MOV_W_R6_AT_R5),
133:              "put h 0x%x, 0x%04x" % (at + 6, BRA_SELF),
134:              "put h 0x%x, 0x%04x" % (at + 8, NOP),
135:              "pc=0x%x" % at, "step 3"])
136: 
137: 
138: def run_deliver(iprc, imask, extra_after=None):
139:     """Assert SCIF TX with IPRC=<iprc>, then free-run at SR.IMASK=<imask>."""
140:     c = handler_stub() + scif_assert_code(iprc)
141:     if extra_after:
142:         c += extra_after
143:     c += ["sr=0x%08x" % (0x40000000 | (imask << 4)),
144:           "vbr=0x%x" % VBR,
145:           "breakpoint add 0x%x" % HANDLER,
146:           "continue"]
147:     _, alive = session(c)
148:     return "delivered" if alive else "refused"
149: 
150: 
151: def raise_iprc(new, at=LANDISK_CODE + 0x40):
152:     """A SECOND, LATER guest store to IPRC -- after the line is already asserted."""
153:     return ["r7=0x%x" % SH4_IPRC, "r8=0x%08x" % new,
154:             "put h 0x%x, 0x%04x" % (at, MOV_W_R8_AT_R7),
155:             "put h 0x%x, 0x%04x" % (at + 2, BRA_SELF),
156:             "put h 0x%x, 0x%04x" % (at + 4, NOP),
157:             "pc=0x%x" % at, "step 1",
158:             "pc=0x%x" % (LANDISK_CODE + 6)]     # park back in the bra . self-loop
159: 
160: 
161: def prewrite_iprc(v, at=LANDISK_CODE + 0x60):
162:     """A guest store to IPRC BEFORE the asserting sequence runs."""
163:     return ["r7=0x%x" % SH4_IPRC, "r8=0x%08x" % v,
164:             "put h 0x%x, 0x%04x" % (at, MOV_W_R8_AT_R7),
165:             "put h 0x%x, 0x%04x" % (at + 2, BRA_SELF),
166:             "put h 0x%x, 0x%04x" % (at + 4, NOP),
167:             "pc=0x%x" % at, "step 1"]
168: 
169: 
170: def deassert_scif(at=LANDISK_CODE + 0x80):
171:     """Clear SCSSR2 -- scif_reassert_interrupts() then INTERRUPT_DEASSERTs."""
172:     return ["r7=0x%x" % SCSSR2, "r8=0x00000000",
173:             "put h 0x%x, 0x%04x" % (at, MOV_W_R8_AT_R7),
174:             "put h 0x%x, 0x%04x" % (at + 2, BRA_SELF),
175:             "put h 0x%x, 0x%04x" % (at + 4, NOP),
176:             "pc=0x%x" % at, "step 1",
177:             "pc=0x%x" % (LANDISK_CODE + 6)]
178: 
179: 
180: def run_deliver2(pre, iprc, imask, extra_after=None):
181:     """Same as run_deliver but with an optional IPRC store BEFORE the assert."""
182:     c = handler_stub() + (prewrite_iprc(pre) if pre is not None else [])
183:     c += scif_assert_code(iprc)
184:     if extra_after:
185:         c += extra_after
186:     c += ["sr=0x%08x" % (0x40000000 | (imask << 4)),
187:           "vbr=0x%x" % VBR,
188:           "breakpoint add 0x%x" % HANDLER,
189:           "continue"]
190:     _, alive = session(c)
191:     return "delivered" if alive else "refused"
192: 
193: 
194: rows = []
195: 
196: 
197: def row(name, got, want, note=""):
198:     """*** THE VERDICT MUST BE THE LAST FIELD ON THE LINE. ***
199: 
200:     Measured, not assumed: an earlier draft of this file printed the note AFTER
201:     `ok`/`FAIL`, and `gate_sh_rounding.sh`'s established idiom is
202:     `grep -E " ok$| FAIL$"` plus `count "$LOG" "^$v  .*ok$"`.  Against the
203:     note-last format BOTH match ZERO lines, so every row would have been reported
204:     as absent while the probe itself printed a correct 6/10 (10-row era) and 10/10.  A gate
205:     that greps nothing scores the same as a gate whose rows all pass.
206:     """
207:     ok = (got == want)
208:     rows.append((name, ok))
209:     print("%-14s %-12s %-12s %-34s %s" % (name, got, want, note,
210:                                           "ok" if ok else "FAIL"))
211: 
212: 
213: def dumped(transcript, alive):
214:     if not alive:
215:         return "died"
216:     m = re.search(r"0x0*[0-9a-f]+\s+([0-9a-f]{8})", transcript.split("dump")[-1])
217:     if not m:
218:         return "nodump"
219:     return "0x%08x" % int.from_bytes(bytes.fromhex(m.group(1)), "little")
220: 
221: 
222: #  ---- control ---------------------------------------------------------------
223: _, ctl_alive = session([], spin=1.0)
224: print("IPRBCD_CONTROL=%s" % ("OK" if ctl_alive else "DEAD"))
225: if not ctl_alive:
226:     print("IPRBCD_RESULT=0/0")
227:     sys.exit(0)
228: 
229: #  ---- R1: LIVENESS control (a known value through the same decode) -----------
230: t, a = session(["r0=0x%08x" % LIVE, "r1=0x%x" % SCRATCH,
231:                 "put w 0x%x, 0xdeadbeef" % SCRATCH,
232:                 "put h 0x%x, 0x%04x" % (LANDISK_CODE, MOV_L_R0_AT_R1),
233:                 "pc=0x%x" % LANDISK_CODE, "step 1",
234:                 "dump 0x%x 0x%x" % (SCRATCH, SCRATCH + 4)], spin=1.5)
235: row("live", dumped(t, a), "0x%08x" % LIVE, "RAM through a guest store")
236: 
237: #  ---- R2: DEVICE-SIGNATURE control ------------------------------------------
238: #  A guest 16-bit load of IPRD returns cpu_sh.c's reset value 0xda74, which RAM
239: #  at that address could not produce and which only the INTC case in dev_sh4.c
240: #  can answer.  This proves the P4 INTC decode path -- the very path the rows
241: #  below drive -- is live, independently of any interrupt being delivered.
242: t, a = session(["r1=0x%x" % SH4_IPRD, "r2=0x%x" % SCRATCH,
243:                 "put w 0x%x, 0xdeadbeef" % SCRATCH,
244:                 "put h 0x%x, 0x%04x" % (LANDISK_CODE, MOV_W_AT_R1_R0),
245:                 "put h 0x%x, 0x%04x" % (LANDISK_CODE + 2, MOV_L_R0_AT_R2),
246:                 "pc=0x%x" % LANDISK_CODE, "step 2",
247:                 "dump 0x%x 0x%x" % (SCRATCH, SCRATCH + 4)], spin=1.5)
248: row("devsig", dumped(t, a), "0x%08x" % IPRD_RESET, "IPRD reset value via P4")
249: 
250: #  ---- THE NAIVE WITNESS, kept as a row so its weakness is visible ------------
251: #  "Write one IPR and expect delivery."  Question 4 of the brief.  Recorded here
252: #  so the kill matrix shows, in one column, every mutant it lets through.
253: row("naive", run_deliver(0x00f0, 0), "delivered", "ONE IPR write, IMASK=0")
254: 
255: #  ---- sh4iprbcd: SCIF's priority must come from IPRC[7:4] --------------------
256: #  HI: IPRC says 15, IMASK 3.  Pre-fix SCIF is 3 -> 3 < 3 is false -> refused.
257: row("iprc_hi", run_deliver(0x00f0, 3), "delivered", "IPRC[7:4]=15, IMASK=3")
258: #  LO: IPRC says 1, IMASK 1.  Pre-fix SCIF is 3 -> 1 < 3 -> delivered.
259: row("iprc_lo", run_deliver(0x0010, 1), "refused", "IPRC[7:4]=1, IMASK=1")
260: #  A third point, so the pair cannot be satisfied by a constant that happens to
261: #  bracket: IPRC says 1, IMASK 0 -> level 1 is admitted, so it MUST deliver.
262: row("iprc_lo1", run_deliver(0x0010, 0), "delivered", "IPRC[7:4]=1, IMASK=0")
263: 
264: #  ---- sh4prioraise: a raised priority must deliver a STANDING request --------
265: #  IPRC=0 at assert time, so post-fix the line is masked and int_to_assert is
266: #  never set (cpu_sh.c:350 `if (prio == 0) return;`).  A LATER store raises it.
267: row("raise", run_deliver(0x0000, 3, raise_iprc(0x00f0)), "delivered",
268:     "assert masked, then IPRC[7:4]:=15")
269: #  The companion: the rescan must use the NEW value, not merely fire.
270: row("raise_lo", run_deliver(0x0000, 3, raise_iprc(0x0010)), "refused",
271:     "assert masked, then IPRC[7:4]:=1, IMASK=3")
272: 
273: #  ---- the nibble must be CLEARED, not merely OR-ed -------------------------
274: #  A priority that only ever RISES passes every row above, because IPRC resets to
275: #  0x0000 so within one session `|=` and `=` agree.  This row writes 15 first and
276: #  1 second: an OR-only update leaves 15 and delivers at IMASK=1.
277: row("lower", run_deliver2(0x00f0, 0x0010, 1), "refused",
278:     "IPRC[7:4]:=15 then :=1, IMASK=1")
279: 
280: #  ---- the rescan must ZERO int_to_assert/int_level before scanning -----------
281: #  Dropping those two zeroings passes every raise row (the scan can only climb),
282: #  but breaks DEASSERT: the stale winner survives and a cleared source is still
283: #  delivered.  Assert, then clear SCSSR2 (dev_sh4.c:2528-2535 deasserts), then
284: #  free-run at IMASK=0 -- nothing may be delivered.
285: row("deassert", run_deliver(0x00f0, 0, deassert_scif()), "refused",
286:     "assert at 15 then clear SCSSR2, IMASK=0")
287: 
288: #  ---- the two rows NO BEHAVIOURAL TEST CAN REPLACE ---------------------------
289: #  *** MEASURED: dropping the IPRB/IPRC blocks, and dropping the three RTC lines,
290: #  each score a CLEAN 10/10 (10-row era) against every row above. ***  Not because those rows
291: #  are weak -- because WDT, REF, SCI, GPIO, DMAC, H-UDI and RTC have no
292: #  INTERRUPT_ASSERT anywhere in this tree.  Nothing a guest can DO depends on
293: #  their priorities, so no behavioural row can ever tell the difference.
294: #
295: #  #458 exposes int_prio_and_pending[] through the settings interface precisely
296: #  so a row can ask what a source's priority WOULD be, without needing anything
297: #  to raise it.  These two rows are the reason that exposure exists; without them
298: #  it is an unused convenience, and with them the escape class is closed.
299: SH4_IPRB = 0xffd00008
300: 
301: 
302: def write_ipr_then_read(reg, value, slot, at=LANDISK_CODE + 0xa0, slots=None):
303:     """One guest store to an IPR, then read the resulting priority nibble(s).
304: 
305:     `slots` reads several in ONE session, which is how the IPRD pair below
306:     shares a boot: the row and its control must see the SAME store.
307:     """
308:     return (["r7=0x%x" % reg, "r8=0x%08x" % value,
309:              "put h 0x%x, 0x%04x" % (at, MOV_W_R8_AT_R7),
310:              "put h 0x%x, 0x%04x" % (at + 2, BRA_SELF),
311:              "put h 0x%x, 0x%04x" % (at + 4, NOP),
312:              "pc=0x%x" % at, "step 1"]
313:             + ["print iprio_%x" % x for x in (slots or (slot,))])
314: 
315: 
316: def prio_of(t, slot):
317:     m = re.search(r"print\s+iprio_%x\s*\r?\n\s*0x([0-9a-f]+)" % slot, t)
318:     return ("0x%x" % (int(m.group(1), 16) & 0xf)) if m else "absent"
319: 
320: 
321: #  WDT lives in IPRB[15:12].  Nothing asserts it, so this is unobservable any
322: #  other way -- and it is the sole killer of the drop-the-IPRB/IPRC mutant.
323: t_b, alive_b = session(write_ipr_then_read(SH4_IPRB, 0xa000, 0x560), spin=1.0)
324: row("iprb wdt", prio_of(t_b, 0x560) if alive_b else "died", "0xa",
325:     "IPRB[15:12]=10 -> WDT slot 0x560")
326: 
327: #  RTC lives in IPRA[3:0] -- a nibble of a register the function ALREADY read,
328: #  and the sole killer of the drop-the-RTC-lines mutant.
329: t_a, alive_a = session(write_ipr_then_read(SH4_IPRA, 0x000c, 0x480), spin=1.0)
330: row("ipra rtc", prio_of(t_a, 0x480) if alive_a else "died", "0xc",
331:     "IPRA[3:0]=12 -> RTC ATI slot 0x480")
332: 
333: #  *** THE ROW THAT DEFENDS THE ROUND'S CENTRAL DECISION. ***
334: #
335: #  #458 declines to read IPRD, and a pass-2 seat pointed out that the decision
336: #  lived ONLY IN A COMMENT: it predicted that `m_iprdread` -- the obvious "read
337: #  all four registers per Table 19.6" completion -- escapes every other row here
338: #  while masking four PCIC lines on landisk.  MEASURED and confirmed: with this
339: #  pair present `m_iprdread` scores 13/14, red on `iprd hold` alone.
340: #
341: #  The kill is cheap because the settings channel is already paid for.  IPRD's
342: #  four nibbles alias IRL0-3 = 0x240/0x2a0/0x300/0x360, which are ALSO
343: #  IRQ2/5/8/11 (sh4_exception.h:137-140 vs :144-154), owned by the hardwired
344: #  15..1 ramp.  So a guest `IPRD := 0` -- the exact store OpenBSD/landisk 7.6
345: #  makes at boot -- must leave slot 0x240 at 0xd.
346: #
347: #  `iprd ctl` is the discriminator, not decoration: IRQ10 (the wdc) is NOT one
348: #  of IPRD's four slots, so it stays 0x5 under both the fix and the mutant.  A
349: #  red `iprd hold` with a green `iprd ctl` says IPRD specifically, rather than
350: #  "the session broke".
351: t_d, alive_d = session(
352:     write_ipr_then_read(SH4_IPRD, 0x0000, 0x240, slots=(0x240, 0x340)),
353:     spin=1.0)
354: row("iprd hold", prio_of(t_d, 0x240) if alive_d else "died", "0xd",
355:     "IPRD:=0 must NOT move IRQ2/IRL0 slot 0x240")
356: row("iprd ctl", prio_of(t_d, 0x340) if alive_d else "died", "0x5",
357:     "control: IRQ10/wdc is outside IPRD, unmoved")
358: 
359: #  *** THE ONE ESCAPE THAT WAS NOT COVERAGE DEBT. ***
360: #
361: #  A pass-2 measuring seat built `m_sciftxonly` -- narrow the IPRC SCIF loop to
362: #  `for (i = SH4_INTEVT_SCIF_TXI; i <= SH4_INTEVT_SCIF_TXI; ...)`, one identifier
363: #  -- and MEASURED it at 14/14.  Every other escape found this round reaches a
364: #  slot nothing in the tree asserts; this one does not.
365: #
366: #  SCIF RXI (0x720) IS LIVE.  dev_sh4.c:250-256 asserts scif_rx_irq whenever
367: #  SCSCR2.RIE && SCSSR2.DR, connected at :1912.  That is CONSOLE INPUT on
368: #  landisk, the only SH machine this project boots.  Measured on both builds at
369: #  IPRC=0x00f0, SCSCR2=0x40, SCSSR2=0x01, IMASK=3:
370: #
371: #      fix            iprio_720 = 0x1f (asserted, prio 15)   RX delivered
372: #      m_sciftxonly   iprio_720 = 0x10 (asserted, prio  0)   RX refused
373: #
374: #  So the mutant silently deletes console input and the detector stays green.
375: #  The ten behavioural rows all drive TXI (0x760) -- scif_assert_code() writes
376: #  SCSCR2.TIE + SCSSR2.TDFE|TEND, the TX arm -- so nothing touched the RX side.
377: #
378: #  These four rows pin the WHOLE membership of the loop in one session, which
379: #  kills every narrowing of it rather than just the measured one.  This is the
380: #  de-escalation clause's own shape: the round was pinning the accept side of a
381: #  four-member loop at exactly one member.
382: t_c, alive_c = session(
383:     write_ipr_then_read(SH4_IPRC, 0x00f0, 0x700,
384:                         slots=(0x700, 0x720, 0x740, 0x760)),
385:     spin=1.0)
386: for _slot, _nm in ((0x700, "eri"), (0x720, "rxi"), (0x740, "bri"), (0x760, "txi")):
387:     row("scif %s" % _nm, prio_of(t_c, _slot) if alive_c else "died", "0xf",
388:         "IPRC[7:4]=15 -> SCIF slot 0x%x" % _slot)
389: 
390: n = sum(1 for _, ok in rows if ok)
391: print("IPRBCD_RESULT=%d/%d" % (n, len(rows)))
392: print("IPRBCD_VECTOR=" + ",".join(("1" if ok else "0") for _, ok in rows))

