    print("SH_INTPRIO_RESULT=0/0")
    sys.exit(0)

#  ---- R1: the witness ---------------------------------------------------------
#  TWO assertions on purpose.  "alive" alone is satisfied by a mutant that drops
#  the exit() and leaves the fatal() -- and fatal() has no quiet_mode early-out
