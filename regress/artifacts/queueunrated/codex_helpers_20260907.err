row("lo_sent", printed(t, "v0") if alive else "died", "0x0",
    "declined READ answers 0, not the sentinel")

A = Addr(CODE)
t, alive, how = session(store(A, DE + 0x0d0, op=OP_SB_T0_A3, val="0x01")
                        + store(A, DE + 0x0e4, op=OP_SB_T0_A3, val="0x02"))
