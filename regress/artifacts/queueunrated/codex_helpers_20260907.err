    "artifacts/gdromexitsix/opus_r2table_20260828/mkfix.py": (CLASS_TOOL,
                                    "#490 R2: applies the CANDIDATE product fix (both sites "
                                    "de-fatalised) to a scratch clone.  Preserved because the "
