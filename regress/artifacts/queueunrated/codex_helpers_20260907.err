176:def fill(A):
177:    """Program a tiled 32-bit FILL and fire it.  Every store is a REAL GUEST INSTRUCTION."""
178:    #  re_tlb_a[0] = 0x8002.  The RE TLB write walks `len' in halfwords from tlbi 0, so an `sd'
179:    #  carrying the tile in its TOP halfword lands it at index 0 -- the packing sgi_re_rgb_probe.py
180:    #  established, and getting it wrong leaves the valid bit clear and the transfer silent.
181:    c  = store(A, RE_TLB_A, TLBA_TILE << 48, op=OP_SD_T0_A3)
182:    c += store(A, DEST, PAINT)                     # pre-paint: liveness, NOT a tail oracle
183:    c += store(A, MTE_MODE, MODE_TILED_FILL)
184:    c += store(A, MTE_BG,   BG_VAL)
185:    c += store(A, MTE_DST0, DST0)
186:    c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
187:    return c
