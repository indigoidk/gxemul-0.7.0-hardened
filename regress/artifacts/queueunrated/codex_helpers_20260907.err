         #  exceptions are not blocked.  Reset leaves IMASK at 15, which would
         #  refuse a priority-1 interrupt and make this row vacuous.
         "sr=0x40000000", "vbr=0x%x" % VBR,
         "breakpoint add 0x%x" % HANDLER]
    return c


