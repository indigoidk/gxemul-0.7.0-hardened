A = Addr(CODE)
t, alive, how = session(packet(BAD_CMD, A) + load32(SYSASIC_PEND1, A))
g = printed(t, "r2")
row("unk event", ("set" if (int(g, 16) & SYSASIC_GDROM_BIT) else "clear")
