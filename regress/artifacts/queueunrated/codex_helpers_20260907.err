A = Addr(CODE)
t, alive, how = session(packet(BAD_FMT, A))
row("fmt surv", how, "exit0", "a bad data format must not end the host")
row("fmt says", "%d" % len(FMT_DECL.findall(t)), "1",
    "and it announces itself, exactly once")

