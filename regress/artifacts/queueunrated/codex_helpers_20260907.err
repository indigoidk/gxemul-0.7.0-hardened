GDROM_COND  = 0xa05f709c
GDROM_DATAP = 0xa05f7080      # ...and the CONTROL window's data port (+0x80)
SYSASIC_PEND = 0xa05f6900     # pending_irq[0], guest-READABLE (dev_dreamcast_asic.c:130)
