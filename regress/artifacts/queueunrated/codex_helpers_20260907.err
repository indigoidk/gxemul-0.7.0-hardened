1416:#  ------------------------------------------------------------ pcc2defaultkill (#501)
1417:#  The default: arm of DEVICE_ACCESS(pcc2) ended the host on any access to an uncased
1418:#  offset, reads included.  Now: reads keep the served byte, writes are declined, one
1419:#  latched announce per offset per instance.  The witness (regress/artifacts/pcc2defaultkill/
1420:#  witness_20260905/, 7/13 on the committed build) is NOT run here; this is its detector.
1421:PCC2DLOG=$LOGDIR/pcc2_default.log
1422:python3 -u pcc2_default_probe.py "$PMAX" gate > "$PCC2DLOG" 2>&1 || true
1423:if ! grep -q "PCC2D_PROBE_DONE" "$PCC2DLOG"; then
1424:    check "pcc2 default probe completed" "no" "yes"
1425:else
1426:    check "pcc2 default probe completed" "yes" "yes"
1427:    for v in "live" "devsig chipid" "named wr" "named wr msg" "named rd" "named rd msg" \
1428:        "named rd srvd" "inword wr" "inword msg" "inword rdawr" "inword rd" "unnamed wr" \
1429:        "unnamed msg" "unnamed rdawr" "unnamed rd" "ieicr rdawr" "ieerr rdawr" "sccerr rdawr" \
1430:        "latch sameoff" "sameoff val" "latch twooff" "latch rw one" "latch rd rd" "latch rd wr" \
1431:        "latch aba" "alias 0x6a" "alias msg" "dir wr text" "wr declined" "wr val text" \
1432:        "dir rd text" "srvd val" "srvd val text" "srvd half text" "half wr rdawr" "srvd rd latch" \
1433:        "srvd wr latch" "wide wr" "wide wr msg" "wide wr val" "wide rd" "wide rd srvd" \
1434:        "genctl rt" "t1cmp word rt" "put b ctl" "put b ctl msg"; do
1435:        check "pcc2 default row: $v" "$(count "$PCC2DLOG" "^$v  .*ok$")" "1"
1436:    done
1437:    check "pcc2 default rows emitted" "$(( $(count "$PCC2DLOG" " ok$") + $(count "$PCC2DLOG" " FAIL$") ))" "46"
1438:    check "pcc2 default rows green"   "$(count "$PCC2DLOG" " ok$")"   "46"
1439:    check "pcc2 default rows red"     "$(count "$PCC2DLOG" " FAIL$")" "0"
1440:fi
