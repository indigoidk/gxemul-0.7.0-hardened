A = Addr(CODE)
t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
                        + store16(GDROM_COND, 0x01ef, A)
                        + load16(GDROM_COND, A, dest=2)
                        + load32(SYSASIC_PEND1, A, dest=3))
m = COND_RE.search(t)
