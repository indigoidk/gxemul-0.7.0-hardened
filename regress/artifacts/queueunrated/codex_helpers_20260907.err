        "put h 0x%x, 0x%04x" % (at + 2, op2),
        "put h 0x%x, 0x%04x" % (at + 4, BRA_SELF),
        "put h 0x%x, 0x%04x" % (at + 6, NOP),
        "pc=0x%x" % at, "step 2"]


