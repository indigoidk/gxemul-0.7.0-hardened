regress\pcc2_default_probe.py:177:row("named rd msg", t.count(MSG) if alive else "n/a", 18, "the read announce fires once per offset too")
regress\pcc2_default_probe.py:178:row("named rd srvd", t.count("served 0x") if alive else "n/a", 18, "the read announce says what happened -- SERVED, never 'ignored' (the VALUE is pinned by `srvd val text')")
regress\pcc2_default_probe.py:181:row("inword msg", t.count(MSG) if alive else "n/a", 12, "...twelve announces for twelve offsets; the SECOND write to 0x06 and the read-back are silent: the latch is per offset in THIS class too (Opus M_LATCHOFF)")
regress\pcc2_default_probe.py:187:row("unnamed msg", t.count(MSG) if alive else "n/a", 13, "...thirteen announces; the second write to 0x21 and its read-back are silent (per-offset latch, unnamed class)")
regress\pcc2_default_probe.py:200:row("latch sameoff", t.count(MSG) if alive else "n/a", 1, "two writes to one offset announce ONCE: an unlatched arm prints 3 -- both writes and the appended read-back (silent under the fix: bit set); measured 3 in table 4")
regress\pcc2_default_probe.py:203:row("latch twooff", t.count(MSG) if alive else "n/a", 2, "two offsets announce TWICE: a single whole-arm latch bit prints 1")
regress\pcc2_default_probe.py:205:row("latch rw one", t.count(MSG) if alive else "n/a", 1, "a write then a read at ONE offset announce once: the WRITE sets the bit the READ tests")
regress\pcc2_default_probe.py:207:row("latch rd rd", t.count(MSG) if alive else "n/a", 1, "two READS at one offset announce once: a latch SET only on writes prints 2 (grok A) -- the setter x tester cell rw one cannot see")
regress\pcc2_default_probe.py:209:row("latch rd wr", t.count(MSG) if alive else "n/a", 1, "a READ then a write at one offset announce once: the read's bit silences the write (the fourth setter x tester cell)")
regress\pcc2_default_probe.py:211:row("latch aba", t.count(MSG) if alive else "n/a", 2, "A,B,A announces TWICE: `|=' -> `=' forgets A when B announces and prints 3 (codex) -- earlier bits survive a new offset")
regress\pcc2_default_probe.py:215:row("alias msg", t.count("offset 0x2a") if alive else "n/a", 1, "...and the announce names the FOLDED offset 0x2a: a changed fold names another")
regress\pcc2_default_probe.py:217:row("dir wr text", t.count("unimplemented write to") if alive else "n/a", 1, "the announce says WRITE for a store (an inverted writeflag test in the text says read)")
regress\pcc2_default_probe.py:218:row("wr declined", t.count("declined") if alive else "n/a", 1, "...and the word is DECLINED (no other row counts it: `ignored' would pass every count row)")
regress\pcc2_default_probe.py:219:row("wr val text", t.count("0x30 (len 1): 0x5a -- declined") if alive else "n/a", 1, "...and the announced VALUE is the byte written: the mirror of `srvd val text' on the write arm -- `idata -> 0' printed 0x0 and passed 36 rows (Opus M_WRVAL0, MEASURED)")
regress\pcc2_default_probe.py:221:row("dir rd text", t.count("unimplemented read from") if alive else "n/a", 1, "...and READ for a load")
regress\pcc2_default_probe.py:225:row("srvd val text", t.count("0x5 (len 1) -- served 0x34") if alive else "n/a", 1, "...and the announce prints THAT byte (data[0], what was served) WITH its width: `served 0x%02x' of 0 passed 23 rows (Opus M_O1, MEASURED); `(len 1)' -> `(len 4)' passed 36 (codex)")
regress\pcc2_default_probe.py:226:row("srvd half text", t.count("0x6 (len 2) -- served 0x56") if alive else "n/a", 1, "a len-2 default read at 0x06 is announced from its FIRST byte (0x56 of 0x5678): data[len-1] says 0x78 (Opus M_LASTBYTE, MEASURED 36/36); a len-2 re-kill dies here")
regress\pcc2_default_probe.py:227:row("half wr rdawr", (printed(t, "r6") if alive else fate(alive, how)), "0x5678", "...then st.h 0xaabb at 0x06 is DECLINED (silent: the bit is set) and ld.hu reads 0x5678 back: len-2 disposition; a byte-truncated backed store reads 0xbb78")
regress\pcc2_default_probe.py:228:row("srvd rd latch", (printed(t, "r8") if alive else fate(alive, how)), "0x34", "a SECOND read at 0x05 -- its bit set by the FIRST READ -- still receives 0x34: a latched-path read whose response is zeroed passes count rows (codex M_LATCH_RD_ZERO)")
regress\pcc2_default_probe.py:229:row("srvd wr latch", (printed(t, "r9") if alive else fate(alive, how)), "0x78", "st.b 0xbb at 0x07 (declined, announced) then ld.bu at 0x07 -- its bit set by a WRITE -- receives 0x78: the response is preserved on the latched path whichever direction set the bit")
regress\pcc2_default_probe.py:233:row("wide wr msg", t.count("offset 0x28 (len 4)") if alive else "n/a", 1, "...announced once, with the width; the ld.w at the same offset is silenced by the per-offset bit")
regress\pcc2_default_probe.py:234:row("wide wr val", t.count("(len 4): 0x5a5a5a5a -- declined") if alive else "n/a", 1, "...and the announced value is the WHOLE word: printing data[0] instead of idata says 0x5a (Opus M_WRDATA0, MEASURED 36/36)")
regress\pcc2_default_probe.py:237:row("wide rd srvd", t.count("(len 4) -- served 0x00") if alive else "n/a", 1, "...and the announce names the width and the first served byte")
regress\pcc2_default_probe.py:245:row("put b ctl msg", t.count(MSG) if alive else "n/a", 0, "...so it prints nothing -- not a witness, a control")
