#  offset terminates the host; it says nothing about what a declined offset RETURNS.
sweep_cmds = ["put h 0x%x, 0x%04x" % (CODE, MOV_B_AT_R1_R2),
              "put h 0x%x, 0x%04x" % (CODE + 2, BRA_SELF)]
for _off in range(0x100):
