row("two sites", "survived" if alive else "died", "survived",
    "no-data then not-waiting, ONE session")
row("two sites x2",
    ("%d" % (len(SAYS["nodata"].findall(t)) + len(SAYS["notwait"].findall(t))))
    if alive else "died", "2",
    "DIFFERENT sites -> TWO diagnostics, not one")

#  ---------------------------------------------------------------- accept side
#
