#  (0xa0000000..0xbfffffff), which memory_sh.c maps as `vaddr & 0x1fffffff` with no
#  UTLB involvement, so the row does not depend on MMU state.
IPI = 0xb10000a0
MPMEM = 0xb1000090            # DEV_MP_MEMORY -- returns ram_mb * 1048576
CODE = 0x80010000
