    "artifacts/gdromexitsix/opus_r2table_20260828/mkmut.py": (CLASS_TOOL,
                                    "#490 R2: builds the six mutants (M1ret, M2nolatch, "
                                    "M3shared, M4nobreakA, M5outerA, M6cond) as single minimal "
