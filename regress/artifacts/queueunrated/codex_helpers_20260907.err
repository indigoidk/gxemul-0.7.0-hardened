                        + run([MOVL_ST(7, 8)], A.take(1))
                        + ["r1=0x%x" % SCRATCH, "r2=0"]
                        + run([0x6002 | (1 << 4) | (2 << 8)], A.take(1)) + ["print r2"])
row("live", printed(t, "r2") if alive else "died", "0x%x" % LIVE,
    "LIVENESS: a guest store then a guest load, through RAM")

