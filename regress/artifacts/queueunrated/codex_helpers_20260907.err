def MOVW_ST(n, m):
    return 0x2001 | (n << 8) | (m << 4)


def MOVW_LD(n, m):
    return 0x6001 | (n << 8) | (m << 4)


def MOVL_ST(n, m):
    return 0x2002 | (n << 8) | (m << 4)


class Addr(object):
    """Hands out non-overlapping code addresses so planted runs cannot collide."""

    def __init__(self, base):
        self.a = base

    def take(self, n_ops):
        got = self.a
        self.a += 2 * (n_ops + 2) + 0x20
        return got


