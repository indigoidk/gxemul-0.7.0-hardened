from pathlib import Path
import re, json, subprocess, collections
root=Path(\"GXEMUL-SEC/src\")
paths=sorted(Path(p) for p in subprocess.check_output([\"rg\",\"--files\",str(root/\"devices\"),str(root/\"cpus\")],text=True).splitlines() if Path(p).suffix in (\".c\",\".h\",\".cc\",\".cpp\"))
def blank(m):
    return re.sub(r\"["'^'"\\n]\", \" \", m.group())
def clean(s):
    return re.sub(r'/\\*[\\s\\S]*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',blank,s)
raw={p:p.read_text(errors=\"replace\") for p in paths}
src={p:clean(s) for p,s in raw.items()}
def out(p,n,line):
    print(str(p.relative_to(root))+\":\"+str(n)+\":\"+line.strip())

cmp=re.compile(r\"\\b([A-Za-z_]\\w*)\\s*(==|"'!=|<=|>=|<|>)'"\\s*(0[xX][0-9a-fA-F]+|[01248])\\b\")
stats=collections.Counter()
for p,s in src.items():
 if p.name.startswith(\"tmp_\"): continue
 depth=0;start=0; blocks=[]
 for i,c in enumerate(s):
  if c==\"{\":
   if depth==0:start=i
   depth+=1
  elif c==\"}\":
   depth-=1
   if depth==0:blocks.append((start,i+1))
 for lo,hi in blocks:
  body=s[lo:hi]
  for m in cmp.finditer(body):
   stats[\"comparisons\"]+=1
   var,op,num=m.groups();n=int(num,0)
   assigns=list(re.finditer(r\"\\b\"+re.escape(var)+r\"\\s*(?<"'![!=<>])=(?!=)'"\\s*(["'^;,'"\\n]+)\",body))
   hints=[]
   for a in assigns:
    expr=a[1].strip()
    mask=re.search(r\"(?<"'!&)&'"\\s*(0x[\\da-fA-F]+|\\d+)\\s*\\)*"'$",expr)
    shift=re.match(r"('"\\d+)\\s*<<\",expr)
    if mask:
     val=int(mask[1],0)
     if (op in (\"==\",\""'!=") and (n&val)!=n) or (op==">" and n>=val) or (op==">=" and n>val):
      hints.append(expr)
    if shift and op in ("==","!=") and 0<n<int(shift[1]):
     hints.append(expr)
   if hints:
    line=s.count("'"\\n\",0,lo+m.start())+1
    out(p,line,m.group()+\" | defs \"+repr([(s.count(\"\\n\",0,lo+a.start())+1,a[1]) for a in assigns]))
