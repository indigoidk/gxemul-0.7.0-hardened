from pathlib import Path
import re, json, subprocess, collections
root=Path(\"GXEMUL-SEC/src\")
paths=sorted(Path(p) for p in subprocess.check_output([\"rg\",\"--files\",str(root/\"devices\"),str(root/\"cpus\")],text=True).splitlines() if Path(p).suffix in (\".c\",\".h\",\".cc\",\".cpp\"))
def blank(m):
    return re.sub(r\"["'^'"\\n]\", \" \", m.group())
def clean(s):
    return re.sub(r'/\\*[\\s\\S]*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',blank,s)
raw={p:p.read_text(errors=\"replace\") for p in paths}
src={p:clean(s) for p,s in raw.items()}
def out(p,n,line):
    print(str(p.relative_to(root))+\":\"+str(n)+\":\"+line.strip())

def show(name,ranges):
 p=root/name; ls=p.read_text(errors=\"replace\").splitlines(); cs=clean(\"\\n\".join(ls)).splitlines()
 print(str(p.relative_to(root)))
 for lo,hi in ranges:
  print(\"RANGE\",lo,hi)
  for n in range(lo,min(hi,len(ls))+1):
   if cs[n-1].strip(): print(str(n)+\": \"+ls[n-1].rstrip())

show(\"devices/dev_dec21143.c\",[(661,819)])
show(\"devices/dev_px.c\",[(130,152),(383,432),(496,551),(746,790)])
show(\"devices/dev_fb.c\",[(301,380),(832,910)])

