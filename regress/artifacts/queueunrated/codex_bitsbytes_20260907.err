  if isinstance(t,ast.Constant) and isinstance(t.value,int):return {t.value}
  if isinstance(t,ast.UnaryOp):
   x=v(t.operand)
   if x is None:return None
   fn={ast.Invert:operator.invert,ast.USub:operator.neg,ast.UAdd:operator.pos}.get(type(t.op))
   return {fn(i) for i in x} if fn else None
  if isinstance(t,ast.BinOp):
   x,y=v(t.left),v(t.right)
   if isinstance(t.op,ast.BitAnd) and ((x is None) "'!= (y is None)):
    z=y if x is None else x
    if len(z)==1:
     mask=next(iter(z))
     if mask>=0 and mask.bit_count()<=10:
      bits=[1<<i for i in range(mask.bit_length()) if mask & (1<<i)]
      r={0}
      for b in bits:r|={i|b for i in r}
      return r
   if x is None or y is None or len(x)*len(y)>16384:return None
   fn={ast.Add:operator.add,ast.Sub:operator.sub,ast.Mult:operator.mul,ast.Div:lambda a,b:int(a/b),ast.FloorDiv:operator.floordiv,ast.Mod:operator.mod,ast.LShift:operator.lshift,ast.RShift:operator.rshift,ast.BitAnd:operator.and_,ast.BitOr:operator.or_,ast.BitXor:operator.xor}.get(type(t.op))
   if not fn:return None
   try:
    if isinstance(t.op,(ast.LShift,ast.RShift)) and any(j<0 or j>63 for j in y):return None
    r={fn(i,j) for i in x for j in y}
    return r if len(r)<=16384 else None
   except (ValueError,ZeroDivisionError):return None
  return None
