def show(name,ranges):
 p=root/name; ls=p.read_text(errors=\"replace\").splitlines(); cs=clean(\"\\n\".join(ls)).splitlines()
 print(str(p.relative_to(root)))
 for lo,hi in ranges:
  print(\"RANGE\",lo,hi)
  for n in range(lo,min(hi,len(ls))+1):
   if cs[n-1].strip(): print(str(n)+\": \"+ls[n-1].rstrip())

