68: int riscv_cpu_new(struct cpu *cpu, struct memory *mem,
69: 	struct machine *machine, int cpu_id, char *cpu_type_name)
70: {
71: 	int bits;
73: 	if (strncmp(cpu_type_name, "RV32", 4) == 0) {
74: 		bits = 32;
75: 	} else if (strncmp(cpu_type_name, "RV64", 4) == 0) {
76: 		bits = 64;
77: 	} else if (strncmp(cpu_type_name, "RV128", 4) == 0) {
78: 		bits = 128;
79: 	} else
80: 		return 0;
82: 	if (bits == 128) {
83: 		debugmsg_cpu(cpu, SUBSYS_CPU, "riscv_cpu_new", VERBOSITY_ERROR,
84: 	    	    "TODO: 128-bit");
85: 	    	return 0;
86: 	}
89: 	const char *p = cpu_type_name + strlen("RVxx");
90: 	cpu->cd.riscv.extensions = 0;
91: 	while (*p) {
92: 		char c = *p;
93: 		if (c == 'G') {
94: 			cpu->cd.riscv.extensions |= RISCV_EXT_G;
95: 		} else {
96: 			int i = 0;
97: 			while (riscv_extension_names[i] != NULL) {
98: 				if (c == riscv_extension_names[i][0])
99: 					cpu->cd.riscv.extensions |= 1 << i;
101: 				++ i;
102: 			}
103: 		}
105: 		++p;
106: 	}
108: 	if (cpu->cd.riscv.extensions & RISCV_EXT_E) {
109: 		if (bits != 32) {
110: 			debugmsg_cpu(cpu, SUBSYS_CPU, "riscv_cpu_new", VERBOSITY_ERROR,
111: 		    	    "the E extension only works with RV32");
112: 		    	return 0;
113: 		}
115: 		if (cpu->cd.riscv.extensions & RISCV_EXT_I) {
116: 			debugmsg_cpu(cpu, SUBSYS_CPU, "riscv_cpu_new", VERBOSITY_ERROR,
117: 		    	    "the E extension can not be combined with I");
118: 		    	return 0;
119: 		}
120: 	} else {
121: 		if (!(cpu->cd.riscv.extensions & RISCV_EXT_I)) {
122: 			debugmsg_cpu(cpu, SUBSYS_CPU, "riscv_cpu_new", VERBOSITY_ERROR,
123: 		    	    "either the I or E extensions must be present");
124: 		    	return 0;
125: 		}
126: 	}
128: 	cpu->name = strdup(cpu_type_name);
130: 	cpu->byte_order = EMUL_BIG_ENDIAN;
131: 	cpu->memory_rw = riscv_memory_rw;
133: 	if (bits == 32) {
134: 		cpu->is_32bit        = 1;
135: 		cpu->vaddr_mask = 0x00000000ffffffffULL;
136: 		cpu->run_instr = riscv32_run_instr;
137: 		cpu->update_translation_table = riscv32_update_translation_table;

codex
The final checks found three dead transmit-size guards in DEC21143: its descriptor masks limit `bufsize` to 0–2047, so the negative checks and the first-segment `> 65536` check cannot fire. I also found a separate ARM bit-field issue: both extraction handlers can evaluate `1 << width` with `width == 32`. Neither finding is a bits/bytes mix-up.
