from pathlib import Path
import re, json, subprocess, collections
root=Path(\"GXEMUL-SEC/src\")
paths=sorted(Path(p) for p in subprocess.check_output([\"rg\",\"--files\",str(root/\"devices\"),str(root/\"cpus\")],text=True).splitlines() if Path(p).suffix in (\".c\",\".h\",\".cc\",\".cpp\"))
def blank(m):
    return re.sub(r\"["'^'"\\n]\", \" \", m.group())
def clean(s):
    return re.sub(r'/\\*[\\s\\S]*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',blank,s)
raw={p:p.read_text(errors=\"replace\") for p in paths}
src={p:clean(s) for p,s in raw.items()}
def out(p,n,line):
    print(str(p.relative_to(root))+\":\"+str(n)+\":\"+line.strip())

pat=re.compile(r\"(?<"'![<>=!])(?:==|!=|<=|>=|<(?!<)|>(?!>))'"\\s*(?:1|2|4|8)\\b\")
count=0
for p,s in src.items():
 if p.parent.name==\"cpus\":continue
 hits=[(i,l) for i,l in enumerate(s.splitlines(),1) if pat.search(l)]
 if hits:
  print(p.relative_to(root))
  for i,l in hits: print(str(i)+\": \"+raw[p].splitlines()[i-1].strip()); count+=1
print(\"LINES\",count)

