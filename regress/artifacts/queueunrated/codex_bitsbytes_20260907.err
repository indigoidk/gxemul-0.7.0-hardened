The first pass found several similar bit-depth and transfer-size calculations in both directories. I’m filtering out register shifts and byte packing, then checking the remaining comparisons against their defining masks and assignments.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
import re, json, subprocess, collections
root=Path(\"GXEMUL-SEC/src\")
paths=sorted(Path(p) for p in subprocess.check_output([\"rg\",\"--files\",str(root/\"devices\"),str(root/\"cpus\")],text=True).splitlines() if Path(p).suffix in (\".c\",\".h\",\".cc\",\".cpp\"))
def blank(m):
    return re.sub(r\"["'^'"\\n]\", \" \", m.group())
def clean(s):
    return re.sub(r'/\\*[\\s\\S]*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',blank,s)
raw={p:p.read_text(errors=\"replace\") for p in paths}
src={p:clean(s) for p,s in raw.items()}
def out(p,n,line):
    print(str(p.relative_to(root))+\":\"+str(n)+\":\"+line.strip())

print(\"COUNTS\",dict(collections.Counter(p.parent.name for p in paths)), \"TOTAL\",len(paths))
print(\"GENERATED\",sum(p.name.startswith(\"tmp_\") for p in paths))
pat=re.compile(r\"\\b(?:bit_?depth|depth|bpp|bits_?per_?pixel|bytes_?per_?pixel|nbytes|nbits|bit_?width)\\b\",re.I)
for p,s in src.items():
    hits=[(i,l) for i,l in enumerate(s.splitlines(),1) if pat.search(l)]
    if hits:
        print(\"FILE\",p.name,\"HITS\",len(hits))
        for i,l in hits: out(p,i,raw[p].splitlines()[i-1])

