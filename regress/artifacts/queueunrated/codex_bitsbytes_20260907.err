"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
import re, json, subprocess, collections
root=Path(\"GXEMUL-SEC/src\")
paths=sorted(Path(p) for p in subprocess.check_output([\"rg\",\"--files\",str(root/\"devices\"),str(root/\"cpus\")],text=True).splitlines() if Path(p).suffix in (\".c\",\".h\",\".cc\",\".cpp\"))
def blank(m):
    return re.sub(r\"["'^'"\\n]\", \" \", m.group())
def clean(s):
    return re.sub(r'/\\*[\\s\\S]*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',blank,s)
raw={p:p.read_text(errors=\"replace\") for p in paths}
src={p:clean(s) for p,s in raw.items()}
def out(p,n,line):
    print(str(p.relative_to(root))+\":\"+str(n)+\":\"+line.strip())

done=set([\"devices/dev_sgi_re.c\",\"devices/dev_sgi_gbe.c\",\"devices/dev_px.c\",\"devices/dev_vga.c\",\"devices/fb_include.c\",\"devices/dev_fb.c\",\"cpus/cpu_dyntrans.c\",\"devices/dev_dec21030.c\",\"devices/dev_dec21143.c\",\"devices/dev_sh4.c\",\"devices/dev_mb8696x.c\",\"cpus/cpu_ppc_instr.c\",\"cpus/cpu_arm_instr.c\",\"devices/dev_pvr.c\",\"cpus/cpu_riscv.c\",\"cpus/cpu_alpha_instr_alu.c\",\"devices/dev_dreamcast_gdrom.c\",\"devices/dev_pcc2.c\"])
pat=re.compile(r\"(?:(?:/=?|\\*=?)\\s*8\\b|(?:>>=?|<<=?)\\s*3\\b|\\b8\\s*(?:\\*|<<)|\\b\\w*(?:BITS|BYTES)\\w*\\b)\")
count=0
for p,s in src.items():
 if p.parent.name==\"cpus\" or p.relative_to(root).as_posix() in done:continue
 hits=[(i,l) for i,l in enumerate(s.splitlines(),1) if pat.search(l)]
 if hits:
  print(p.relative_to(root))
  for i,l in hits:print(str(i)+\": \"+raw[p].splitlines()[i-1].strip());count+=1
print(\"LINES\",count)

