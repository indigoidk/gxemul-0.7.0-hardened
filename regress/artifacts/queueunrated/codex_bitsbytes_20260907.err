from pathlib import Path
import re, json, subprocess, collections
root=Path(\"GXEMUL-SEC/src\")
paths=sorted(Path(p) for p in subprocess.check_output([\"rg\",\"--files\",str(root/\"devices\"),str(root/\"cpus\")],text=True).splitlines() if Path(p).suffix in (\".c\",\".h\",\".cc\",\".cpp\"))
def blank(m):
    return re.sub(r\"["'^'"\\n]\", \" \", m.group())
def clean(s):
    return re.sub(r'/\\*[\\s\\S]*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',blank,s)
raw={p:p.read_text(errors=\"replace\") for p in paths}
src={p:clean(s) for p,s in raw.items()}
def out(p,n,line):
    print(str(p.relative_to(root))+\":\"+str(n)+\":\"+line.strip())

import ast, operator
def values(e):
 e=e.strip()
 e=re.sub(r\"\\((?:u?int\\d+_t|size_t|int|unsigned(?: int)?|signed(?: int)?|uint|long|short)\\)\\s*\",\"\",e)
 e=re.sub(r\"(?<=\\d)[uUlL]+\\b\",\"\",e).replace(\"->\",\".\")
 try: a=ast.parse(e,mode=\"eval\").body
 except (SyntaxError,ValueError): return None
 def v(t):
  if isinstance(t,ast.Constant) and isinstance(t.value,int):return {t.value}
  if isinstance(t,ast.UnaryOp):
   x=v(t.operand)
   if x is None:return None
   fn={ast.Invert:operator.invert,ast.USub:operator.neg,ast.UAdd:operator.pos}.get(type(t.op))
   return {fn(i) for i in x} if fn else None
  if isinstance(t,ast.BinOp):
   x,y=v(t.left),v(t.right)
   if isinstance(t.op,ast.BitAnd) and ((x is None) "'!= (y is None)):
    z=y if x is None else x
    if len(z)==1:
     mask=next(iter(z))
     if mask>=0 and mask.bit_count()<=10:
      bits=[1<<i for i in range(mask.bit_length()) if mask & (1<<i)]
      r={0}
      for b in bits:r|={i|b for i in r}
      return r
   if x is None or y is None or len(x)*len(y)>16384:return None
   fn={ast.Add:operator.add,ast.Sub:operator.sub,ast.Mult:operator.mul,ast.Div:lambda a,b:int(a/b),ast.FloorDiv:operator.floordiv,ast.Mod:operator.mod,ast.LShift:operator.lshift,ast.RShift:operator.rshift,ast.BitAnd:operator.and_,ast.BitOr:operator.or_,ast.BitXor:operator.xor}.get(type(t.op))
   if not fn:return None
   try:
    if isinstance(t.op,(ast.LShift,ast.RShift)) and any(j<0 or j>63 for j in y):return None
    r={fn(i,j) for i in x for j in y}
    return r if len(r)<=16384 else None
   except (ValueError,ZeroDivisionError):return None
  return None
 return v(a)
def blocks(s):
 depth=0;start=0
 for i,c in enumerate(s):
  if c=="{":
   if depth==0:start=i
   depth+=1
  elif c=="}":
   depth-=1
   if depth==0:yield start,i+1

cmp=re.compile(r"(?<![<>=!])(?:==|!=|<=|>=|<(?!<)|>(?!>))'"\\s*(0[xX][0-9a-fA-F]+|\\d+)\\b\")
cnt=collections.Counter()
for p,s in src.items():
 if p.name.startswith(\"tmp_\"):continue
 for m in cmp.finditer(s):
  pos=m.start()-1
  while pos>=0 and s[pos].isspace():pos-=1
  if pos<0 or s[pos]"'!=")":continue
  end=pos+1;dep=1;pos-=1
  while pos>=0 and dep:
   if s[pos]==")":dep+=1
   elif s[pos]=="(":dep-=1
   pos-=1
  expr=s[pos+1:end]
  if not re.search(r"[&|]|<<|>>",expr):continue
  vs=values(expr)
  if vs is None or len(vs)>1024:continue
  cnt["bounded_mask_expressions"]+=1
  n=int(m[1],0);op=m.group().split()[0] if " " in m.group() else re.match(r"[!=<>]+",m.group())[0]
  op=re.match(r"[!=<>]+",m.group())[0]
  fn={"==":operator.eq,"!=":operator.ne,"<":operator.lt,">":operator.gt,"<=":operator.le,">=":operator.ge}[op]
  outcomes={fn(v,n) for v in vs}
  if len(outcomes)==1:
   out(p,s.count("'"\\n\",0,pos+1)+1,expr+\" \"+m.group()+\" | VALUES \"+str(sorted(vs))+\" | \"+str(outcomes))
   cnt[\"constant_comparisons\"]+=1
print(dict(cnt))

