def values(e):
 e=e.strip()
 e=re.sub(r\"\\((?:u?int\\d+_t|size_t|int|unsigned(?: int)?|signed(?: int)?|uint|long|short)\\)\\s*\",\"\",e)
 e=re.sub(r\"(?<=\\d)[uUlL]+\\b\",\"\",e).replace(\"->\",\".\")
