from pathlib import Path
ranges = {
    'cpus/cpu_arm_instr.c': [(2150,2185)],
    'cpus/cpu_m88k_instr.c': [(60,90),(490,543),(3425,3438),(3485,3530)],
}
for rel, spans in ranges.items():
    lines = (Path('GXEMUL-SEC/src')/rel).read_text(encoding='utf-8',errors='replace').splitlines()
    for lo, hi in spans:
        print('\\n'+rel+':'+str(lo)+'-'+str(hi))
        for n in range(lo,hi+1):
            print(f'{n}: {lines[n-1]}')
