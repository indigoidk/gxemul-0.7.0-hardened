"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
from collections import Counter
import re
base = Path('GXEMUL-SEC/src')
strip = re.compile(r'/\\*.*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\'(?:\\\\.|["'^'"\\'\\\\])*\\'', re.S)
operators = re.compile(r'<<=?|>>=?')
for group in ('cpus', 'devices'):
    files = sorted(p for p in (base/group).rglob('*') if p.is_file() and p.suffix in ('.c', '.h'))
    totals = Counter()
    active = 0
    left_active = 0
    line_total = 0
    for p in files:
        raw = p.read_text(encoding='utf-8', errors='replace')
        raw = re.sub(r'\\\\\\r?\\n', '', raw)
        clean = strip.sub(lambda m: '\\n' * m.group(0).count('\\n'), raw)
        matches = list(operators.finditer(clean))
        counts = Counter(m.group(0) for m in matches)
        totals.update(counts)
        active += bool(counts)
        left_active += bool(counts['<<'] + counts['<<='])
        line_total += len({clean.count('\\n', 0, m.start()) for m in matches})
    print(group, 'C/H files', len(files), 'files with shifts', active, 'files with left shifts', left_active, 'operators', dict(totals), 'lines with shifts', line_total)
print('Width-pair arithmetic:', dict(Counter('negative' if msb-lsb+1 < 0 else 'zero' if msb-lsb+1 == 0 else 'positive' for msb in range(32) for lsb in range(32))))
