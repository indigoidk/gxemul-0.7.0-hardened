from pathlib import Path
from collections import Counter
import re
base = Path('GXEMUL-SEC/src')
strip = re.compile(r'/\\*.*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\'(?:\\\\.|["'^'"\\'\\\\])*\\'', re.S)
operators = re.compile(r'<<=?|>>=?')
grands = Counter()
for group in ('cpus', 'devices'):
    files = sorted(p for p in (base/group).rglob('*') if p.is_file() and p.suffix in ('.c', '.h'))
    counts = Counter()
    for p in files:
        source = re.sub(r'\\\\\\r?\\n', '', p.read_text(encoding='utf-8',errors='replace'))
        clean = strip.sub(lambda m: re.sub(r'["'^'"\\n]', ' ', m.group(0)), source)
        counts.update(operators.findall(clean))
    grands.update(counts)
    print(group, 'files', len(files), 'operators', dict(counts), 'left', counts['<<']+counts['<<='], 'right', counts['>>']+counts['>>='], 'total', sum(counts.values()))
print('total', dict(grands), 'all', sum(grands.values()))
for rel, lo, hi in [('devices/dev_bebox.c',237,246),('devices/dev_cpc700.c',208,219),('devices/dev_footbridge.c',821,833)]:
    lines = (base/rel).read_text(encoding='utf-8',errors='replace').splitlines()
    print('\\n'+rel)
    for n in range(lo, min(hi,len(lines))+1):
        print(f'{n}: {lines[n-1]}')
