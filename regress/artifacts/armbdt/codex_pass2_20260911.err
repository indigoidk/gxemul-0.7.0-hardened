2095: 	unsigned char *page;
2096: 	uint32_t addr;
2097: 
2098: 	do {
2099: 		addr = cpu->cd.arm.r[ARM_IP];
2100: 
2101: 		instr(subs)(cpu, ic);
2102: 
2103: 		if (((cpu->cd.arm.flags & ARM_F_N)?1:0) !=
2104: 		    ((cpu->cd.arm.flags & ARM_F_V)?1:0)) {
2105: 			cpu->n_translated_instrs += 16;
2106: 			/*  Skip the store multiples:  */
2107: 			cpu->cd.arm.next_ic = &ic[17];
2108: 			return;
2109: 		}
2110: 
2111: 		/*  Crossing a page boundary? Then continue non-combined.  */
2112: 		if ((addr & 0xfff) + 128 > 0x1000)
2113: 			return;
2114: 
2115: 		/*  R2/R3 non-zero? Not allowed here.  */
2116: 		if (cpu->cd.arm.r[2] != 0 || cpu->cd.arm.r[3] != 0)
2117: 			return;
2118: 
2119: 		/*  printf("addr = 0x%08x\n", addr);  */
2120: 
2121: 		page = cpu->cd.arm.host_store[addr >> 12];
2122: 		/*  No page translation? Continue non-combined.  */
2123: 		if (page == NULL)
2124: 			return;
2125: 
2126: 		/*  Clear:  */
2127: 		memset(page + (addr & 0xfff), 0, 128);
2128: 		cpu->cd.arm.r[ARM_IP] = addr + 128;
2129: 		cpu->n_translated_instrs += 16;
2130: 
2131: 		/*  Branch back if greater:  */
2132: 		cpu->n_translated_instrs += 1;
2133: 	} while (((cpu->cd.arm.flags & ARM_F_N)?1:0) ==
2134: 	    ((cpu->cd.arm.flags & ARM_F_V)?1:0) &&
2135: 	    !(cpu->cd.arm.flags & ARM_F_Z));
2136: 
2137: 	/*  Continue at the instruction after the bgt:  */
2138: 	cpu->cd.arm.next_ic = &ic[18];
2139: }
2140: 
2141: 
2142: /*
2143:  *  netbsd_memcpy:
2144:  *
2145:  *  The core of a NetBSD/arm memcpy.
2146:  *
2147:  *  f01bc530:  e8b15018     ldmia   r1!,{r3,r4,ip,lr}
2148:  *  f01bc534:  e8a05018     stmia   r0!,{r3,r4,ip,lr}
2149:  *  f01bc538:  e8b15018     ldmia   r1!,{r3,r4,ip,lr}
2150:  *  f01bc53c:  e8a05018     stmia   r0!,{r3,r4,ip,lr}
2151:  *  f01bc540:  e2522020     subs    r2,r2,#0x20
2152:  *  f01bc544:  aafffff9     bge     0xf01bc530
2153:  */
2154: X(netbsd_memcpy)
2155: {
2156: 	unsigned char *page_0, *page_1;
2157: 	uint32_t addr_r0, addr_r1;
2158: 	/*
2159: 	 *  #358: count the 32-byte iterations this call actually folded, so the
2160: 	 *  marker can be COUNT-AND-SUMMARISE. Unlike the other four marked folds
2161: 	 *  this handler has a real loop, so one DISPATCH emits one line however
2162: 	 *  many iterations it folded. A copy that never straddles a page is a
2163: 	 *  single dispatch and therefore a single line; a straddling copy bails,
2164: 	 *  runs one genuine iteration, and the back-branch re-dispatches this
2165: 	 *  slot, so it costs roughly one line per crossing. (An earlier draft of
2166: 	 *  this comment said "one line per call by construction", which is false
2167: 	 *  for exactly the straddling case the next paragraph describes -- a 1 MB
2168: 	 *  copy bails about 512 times. The flood conclusion survives: lines track
2169: 	 *  crossings, not the 32-byte iterations, and stay far below the
2170: 	 *  per-dispatch volume accepted for the loopless folds.)
2171: 	 *
2172: 	 *  The guard on the mid-loop markers below is about TRUTHFULNESS, not
2173: 	 *  flood control, and must not be confused with strlen's `n_loops > 1`
2174: 	 *  guard, which exists to suppress low-information lines. Both of this
2175: 	 *  fold's bail-outs are INSIDE the loop: a bail on the first iteration
2176: 	 *  folded nothing, while a bail on iteration k > 1 follows k-1 completed
2177: 	 *  32-byte copies. So a summary-only marker would under-report every
2178: 	 *  page-straddling copy (a 1 MB copy bails about 512 times), and an
2179: 	 *  unguarded bail marker would over-report the zero-work entries at page
2180: 	 *  ends. Reporting the count is what makes a row able to check that the
2181: 	 *  pieces sum to the copy the register advance implies.
2182: 	 */
2183: 	unsigned n_iter = 0;
2184: 
2185: 	do {
2186: 		addr_r0 = cpu->cd.arm.r[0];
2187: 		addr_r1 = cpu->cd.arm.r[1];
2188: 
2189: 		/*  printf("addr_r0 = %08x  r1 = %08x\n", addr_r0, addr_r1);  */
2190: 
2191: 		/*  Crossing a page boundary? Then continue non-combined.  */
2192: 		if ((addr_r0 & 0xfff) + 32 > 0x1000 ||
2193: 		    (addr_r1 & 0xfff) + 32 > 0x1000) {
2194: 			if (n_iter)			/*  #358  */
2195: 				debugmsg_cpu(cpu, SUBSYS_CPU, "netbsd_memcpy",
2196: 				    VERBOSITY_DEBUG,
2197: 				    "combined %u iterations, page boundary",
2198: 				    n_iter);
2199: 			instr(multi_0x08b15018)(cpu, ic);
2200: 			return;
2201: 		}
2202: 
2203: 		page_0 = cpu->cd.arm.host_store[addr_r0 >> 12];
2204: 		page_1 = cpu->cd.arm.host_store[addr_r1 >> 12];
2205: 
2206: 		/*  No page translations? Continue non-combined.  */
2207: 		if (page_0 == NULL || page_1 == NULL) {
2208: 			if (n_iter)			/*  #358  */
2209: 				debugmsg_cpu(cpu, SUBSYS_CPU, "netbsd_memcpy",
2210: 				    VERBOSITY_DEBUG,
2211: 				    "combined %u iterations, no page", n_iter);
2212: 			instr(multi_0x08b15018)(cpu, ic);
2213: 			return;
2214: 		}
2215: 
2216: 		/*  #354: the real `ldmia r1!,{r3,r4,ip,lr}` leaves those four
2217: 		    registers holding the LAST 16 bytes loaded -- the final
2218: 		    iteration's SECOND ldmia (src+16..+31). The fold moved the
2219: 		    bytes with memcpy but never wrote the registers, so the guest
2220: 		    read them stale ("publishes only r0/r1"). Direct host read,
2221: 		    NO byteswap, base masked to a word -- matching the handler
2222: 		    this fold emulates (multi_0x08b15018, generated by
2223: 		    generate_arm_multi.c:117: `addr &= 0xffc`, then a plain
2224: 		    `r[k] = p[k]`) and the page-cross / NULL-page bail-outs above,
2225: 		    which delegate to that same handler. So fold == handler ==
2226: 		    bail-out: an on-page copy cannot leave different registers
2227: 		    than an identical copy that straddles a page. Each iteration
2228: 		    overwrites r3/r4/ip/lr, so the final iteration's block
2229: 		    persists, as the architecture leaves it.
2230: 
2231: 		    The mask is NOT cosmetic. ARM's LDM ignores addr[1:0] rather
2232: 		    than requiring alignment, and this matcher matches code SHAPE,
2233: 		    not register values, so a guest with r1 & 3 != 0 does fold:
2234: 		    measured at r1 = SRC+1, the masked read publishes what the
2235: 		    genuine sequence publishes, while `& 0xfff` would publish
2236: 		    byte-rotated words. `(r1 & 0xfff) + 16 <= 0xff0` rules out a
2237: 		    carry past bit 11, so (r1 & 0xffc) + 16 is bit-for-bit the
2238: 		    address the real second ldmia reads. Bound: the entry guard
2239: 		    gives (r1 & 0xfff) <= 0xfe0, and masking only lowers that, so
2240: 		    +16..+31 stays inside the page.
2241: 
2242: 		    Published BEFORE the memcpy, and NOT because that makes
2243: 		    overlap safe -- it does not. The real second ldmia runs AFTER
2244: 		    the first stmia, so on a FORWARD overlap it loads post-store
2245: 		    bytes, which no placement around a single memcpy can
2246: 		    reproduce (measured: dst = src+16 diverges either way). The
2247: 		    reason is determinism: publish-after would read bytes a
2248: 		    UB-on-overlap memcpy had just written, so the registers would
2249: 		    depend on the host memcpy's direction and vector width.
2250: 		    Publish-before is identical to publish-after in every case
2251: 		    this fold is correct in (no overlap) and deterministic
2252: 		    otherwise. The overlap and unaligned-copy divergences are
2253: 		    pre-existing and recorded in OUTSTANDING_BUGS.
2254: 
2255: 		    #378: "NO byteswap" above is safe ONLY because this matcher
2256: 		    can no longer fire for a big-endian guest: it requires
2257: 		    instr(multi_0x08b15018) installed at ic[-5], and the
2258: 		    dispatcher now installs the multi fast path only when
2259: 		    cpu->byte_order == EMUL_LITTLE_ENDIAN (a BE guest gets
2260: 		    bdt_load there, the matcher declines, and this raw pw[] block
2261: 		    is unreachable). If a future round re-enables the fast path
2262: 		    for BE (the S4 _le/_be shape), these four publishes must gain
2263: 		    the same swap in the SAME change or fold and handler diverge
2264: 		    -- exactly the class the #354 invariant above forbids.  */
2265: 		{
2266: 			uint32_t *pw = (uint32_t *)
2267: 			    (page_1 + (addr_r1 & 0xffc) + 16);
2268: 			cpu->cd.arm.r[3]      = pw[0];   /* +16 */
2269: 			cpu->cd.arm.r[4]      = pw[1];   /* +20 */
2270: 			cpu->cd.arm.r[ARM_IP] = pw[2];   /* +24  (r12) */
2271: 			cpu->cd.arm.r[ARM_LR] = pw[3];   /* +28  (r14) */
2272: 		}
2273: 
2274: 		memcpy(page_0 + (addr_r0 & 0xfff),
2275: 		    page_1 + (addr_r1 & 0xfff), 32);
2276: 		cpu->cd.arm.r[0] = addr_r0 + 32;
2277: 		cpu->cd.arm.r[1] = addr_r1 + 32;
2278: 		n_iter ++;				/*  #358  */
2279: 
2280: 		cpu->n_translated_instrs += 4;
2281: 
2282: 		instr(subs)(cpu, ic + 4);
2283: 		cpu->n_translated_instrs ++;
2284: 
2285: 		/*  Loop while greater or equal:  */
2286: 		cpu->n_translated_instrs ++;
2287: 	} while (((cpu->cd.arm.flags & ARM_F_N)?1:0) ==
2288: 	    ((cpu->cd.arm.flags & ARM_F_V)?1:0));
2289: 
2290: 	/*  #358: normal exit -- summarise. Unguarded, because reaching here means
2291: 	    the loop body ran at least once (the bail-outs return early), so the
2292: 	    count is always >= 1.  */
2293: 	debugmsg_cpu(cpu, SUBSYS_CPU, "netbsd_memcpy",
2294: 	    VERBOSITY_DEBUG, "combined %u iterations", n_iter);
2295: 
2296: 	/*  Continue at the instruction after the bge:  */
2297: 	cpu->cd.arm.next_ic = &ic[6];
2298: 	cpu->n_translated_instrs --;
2299: }
2300: 
2301: 
2302: /*
2303:  *  netbsd_cacheclean:
2304:  *
2305:  *  The core of a NetBSD/arm cache clean routine, variant 1:
2306:  *
2307:  *  f015f88c:  e4902020     ldr     r2,[r0],#32
2308:  *  f015f890:  e2511020     subs    r1,r1,#0x20
2309:  *  f015f894:  1afffffc     bne     0xf015f88c
2310:  *  f015f898:  ee070f9a     mcr     15,0,r0,cr7,cr10,4
2311:  */
2312: X(netbsd_cacheclean)
2313: {
2314: 	uint32_t r1 = cpu->cd.arm.r[1];
2315: 	uint32_t n;
2316: 
2317: 	/*  #350: a counter that is not a multiple of 32 never reaches zero,
2318: 	    so the real bne loop never exits -- the closed form below would
2319: 	    terminate a loop the architecture does not terminate. Fall back
2320: 	    to the genuine load handler (the netbsd_memcpy bail-out shape,
2321: 	    cf. :2028): r1 mod 32 is invariant under the loop's -0x20, so
2322: 	    every re-entry falls back too and the guest keeps its infinite
2323: 	    loop, its loads, its faults and its interruptibility. r1 == 0
2324: 	    stays folded: that loop terminates, after 2^27 iterations whose
2325: 	    2^32 bytes of base advance wrap r0 to itself.  */
2326: 	if (r1 & 0x1f) {
2327: 		instr(load_w0_word_u1_p0_imm)(cpu, ic);
2328: 		return;
2329: 	}
2330: 
2331: 	n = r1 == 0 ? (uint32_t)1 << 27 : r1 >> 5;
2332: 
2333: 	/*  #349: fold-fired marker. Once #348 made this fold write the
2334: 	    loop's true exit state, the genuine sequence became
2335: 	    architecturally transparent, so gate 14's fold detector reads
2336: 	    this DEBUG-gated line (and the stale r2, while the skipped load
2337: 	    stays unfixed). Deliberately NOT pre-gated with
2338: 	    ENOUGH_VERBOSITY(), per the #278 convention: a pre-gate would
2339: 	    hide it under -V step and keep `breakpoint subsystem cpu` from
2340: 	    firing here.  */
2780: 	reg(ic[0].arg[0]) = reg(ic[1].arg[0]);
2781: 	reg(ic[1].arg[0]) = tmp;
2782: }
2783: 
2784: 
2785: /*
2786:  *  netbsd_copyin:
2787:  *
2788:  *  e4b0a004     ldrt    sl,[r0],#4
2789:  *  e4b0b004     ldrt    fp,[r0],#4
2790:  *  e4b06004     ldrt    r6,[r0],#4
2791:  *  e4b07004     ldrt    r7,[r0],#4
2792:  *  e4b08004     ldrt    r8,[r0],#4
2793:  *  e4b09004     ldrt    r9,[r0],#4
2794:  */
2795: X(netbsd_copyin)
2796: {
2797: 	uint32_t r0 = cpu->cd.arm.r[0], ofs = (r0 & 0xffc), index = r0 >> 12;
2798: 	unsigned char *p = cpu->cd.arm.host_load[index];
2799: 	uint32_t *p32 = (uint32_t *) p, *q32;
2800: 	int ok = cpu->cd.arm.is_userpage[index >> 5] & (1 << (index & 31));
2801: 
2802: 	/*
2803: 	 *  #360: name the reason this fold declined, in the SAME expression the
2804: 	 *  guard tests, so the diagnosis cannot drift away from the condition it
2805: 	 *  describes. Duplicating the three terms in a separate print would be a
2806: 	 *  second thing to keep in sync; a short-circuit chain evaluated once
2807: 	 *  cannot disagree with itself.
2808: 	 *
2809: 	 *  Why a bail marker at all: with only the #358 fire marker, a red row is
2810: 	 *  ambiguous between causes that need different fixes. Adding this one and
2811: 	 *  the install marker in COMBINE() below makes the triple readable in one
2812: 	 *  look -- install 1 / fire 1 / bail 0 is healthy; install 1 / fire 0 /
2813: 	 *  bail 1 means the fold was reached and DECLINED, and the text says which
2814: 	 *  clause; install 1 / fire 0 / bail 0 means the slot was never dispatched
2815: 	 *  (a misplaced breakpoint); install 0 means the matcher declined -- or the
2816: 	 *  session itself broke, which is why every row also asserts the verbosity
2817: 	 *  echo and a value witness.
2818: 	 *
2819: 	 *  The text deliberately avoids the word "combined": the probes count fire
2820: 	 *  markers by matching "<name>: combined", and a bail line containing it
2821: 	 *  would be tallied as a fold that fired.
2822: 	 */
2823: 	const char *why = ofs > 0x1000 - 6*4 ? "page-end" :
2824: 	    !ok ? "not-user" : p == NULL ? "no-page" : NULL;
2825: 
2826: 	if (why != NULL) {
2827: 		debugmsg_cpu(cpu, SUBSYS_CPU, "netbsd_copyin", VERBOSITY_DEBUG,
2828: 		    "declined (%s) ofs=0x%x user=%d", why, (unsigned) ofs,
2829: 		    ok ? 1 : 0);
2830: 		instr(load_w1_word_u1_p0_imm)(cpu, ic);
2831: 		return;
2832: 	}
2833: 
2834: 	/*
2835: 	 *  #358: fold-fired marker. This fold is otherwise UNOBSERVABLE: its
2836: 	 *  registers, the addresses it reads and its instruction billing are all
2837: 	 *  identical to the six genuine ldrt's, so a harness row asserting its
2838: 	 *  result passes whether or not the fold ever fires. #357 removed the one
2839: 	 *  witness that existed -- before it, the template masked its base
2840: 	 *  writeback while this fold did not, so an unaligned base gave r0 =
2841: 	 *  0x10019 folded against 0x10018 genuine. That one-bit difference was
2842: 	 *  the detector; now both paths agree, and any row asserting "the fold
2843: 	 *  fired" is unsatisfiable without this line.
2844: 	 *
2845: 	 *  Placed AFTER the bail-out on purpose. The bail-out delegates the first
2846: 	 *  ldrt to the genuine handler and returns without setting next_ic, so
2847: 	 *  the remaining five run genuinely too; a marker before it would report
2848: 	 *  a fold that did no folding. Not pre-gated with ENOUGH_VERBOSITY(), per
2849: 	 *  the #278 convention, so `breakpoint subsystem cpu` catches a fold in
2850: 	 *  flight -- which is also why a static first-N latch was rejected here:
2851: 	 *  it would gate the breakpoint path too and kill that capability after
2852: 	 *  N folds. This fold has no internal loop, so there is nothing to
2853: 	 *  summarise and no information-content guard analogous to strlen's
2854: 	 *  `n_loops > 1`; the volume is accepted and the rows copy blocks, not
2855: 	 *  megabytes.
2856: 	 */
2857: 	debugmsg_cpu(cpu, SUBSYS_CPU, "netbsd_copyin",
2858: 	    VERBOSITY_DEBUG, "combined 6 loads");
2859: 
2860: 	q32 = &cpu->cd.arm.r[6];
2861: 	ofs >>= 2;
2862: 	q32[0] = p32[ofs+2];
2863: 	q32[1] = p32[ofs+3];
2864: 	q32[2] = p32[ofs+4];
2865: 	q32[3] = p32[ofs+5];
2866: 	q32[4] = p32[ofs+0];
2867: 	q32[5] = p32[ofs+1];
2868: 
2869: 	/*
2870: 	 *  #383 copyin-order: the six moves above are raw HOST words. The general
2871: 	 *  handler this fold delegates to on a decline assembles per cpu->byte_order
2872: 	 *  (cpu_arm_instr_loadstore.c load word arm, order-aware since #372), so on
2873: 	 *  a big-endian guest they were byte-reversed -- the #342/#355 self-
2874: 	 *  contradiction class, and the divergence the #354 invariant forbids.
2875: 	 *  q32 = &r[6] IS the destination register block, so the swap is in place.
2876: 	 *  Idiom open-coded from arm_push/arm_pop (bdt_load), not SWAP32, so the two
2877: 	 *  paths cannot drift. BEFORE the #362 rotation: DDI 0100I p. A4-44 rotates
2878: 	 *  the value assembled in the memory system's order, not the raw host word.
2879: 	 *  This fold is not reached on a big-endian HOST (the matcher is
2880: 	 *  #ifdef HOST_LITTLE_ENDIAN), so the #else arm is written only for symmetry.
2881: 	 */
2882: #ifdef HOST_LITTLE_ENDIAN
2883: 	if (cpu->byte_order == EMUL_BIG_ENDIAN) {
2884: #else
2885: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
2886: #endif
2887: 		int k;
2888: 		for (k = 0; k < 6; k++) {
2889: 			uint32_t v = q32[k];
2890: 			q32[k] = ((v & 0xff) << 24) | ((v & 0xff00) << 8) |
2891: 			    ((v & 0xff0000) >> 8) | ((v & 0xff000000) >> 24);
2892: 		}
2893: 	}
2894: 
2895: 	/*
2896: 	 *  #362: the six ldrt's this replaces are word LOADS, so an unaligned base
2897: 	 *  rotates each of them right by 8 * r0[1:0]. Without this the fold would
2898: 	 *  disagree with the very template it delegates to on a decline -- and the
2899: 	 *  measured form of that is sharper than a fold-versus-`-J` differential:
2900: 	 *  on ONE binary with r0 = 0x10001, pass 1 declines (not-user), runs
2901: 	 *  genuinely and yields 0x44112233, while pass 2 folds and yields
2902: 	 *  0x11223344. The emulator would contradict itself inside a single guest
2903: 	 *  loop, which is the #342/#355 class.
2904: 	 *
2905: 	 *  This matters because the matcher inspects only the preceding slots'
2906: 	 *  handler, base register and offset -- never r0's VALUE -- so an unaligned
2907: 	 *  base folds. The data offsets are masked (`r0 & 0xffc`) and the
2908: 	 *  `ofs > 0x1000 - 6*4` bound is computed from the masked value, so both are
2909: 	 *  unaffected; only the assembled words rotate.
2910: 	 */
2911: 	if (r0 & 3) {
2912: 		const uint32_t rot = 8 * (r0 & 3);
2913: 		int k;
2914: 		for (k = 0; k < 6; k++)
2915: 			q32[k] = (q32[k] >> rot) | (q32[k] << (32 - rot));
4690: 		}
4691: 		imm = iword & 0xfff;
4692: 		if (main_opcode < 6)
4693: 			ic->arg[1] = imm;
4694: 		else
4695: 			ic->arg[1] = (size_t)(void *)arm_r[iword & 0xfff];
4696: 		/*  Special case: pc-relative load within the same page:  */
4697: 		if (rn == ARM_PC && rd != ARM_PC && main_opcode < 6 && l_bit) {
4698: 			unsigned char *p = page;
4699: 			int ofs = (addr & 0xfff) + 8, max = 0xffc;
4700: 			int b_bit = iword & 0x00400000;
4701: 			if (b_bit)
4702: 				max = 0xfff;
4703: 			if (u_bit)
4704: 				ofs += (iword & 0xfff);
4705: 			else
4706: 				ofs -= (iword & 0xfff);
4707: 			/*  NOTE/TODO: This assumes 4KB pages,
4708: 			    it will not work with 1KB pages.  */
4709: 			if (ofs >= 0 && ofs <= max && p != NULL) {
4710: 				unsigned char cbuf[4];
4711: 				int len = b_bit? 1 : 4;
4712: 				uint32_t x, a = (addr & 0xfffff000) | ofs;
4713: 				/*  ic->f = cond_instr(mov);  */
4714: 				ic->f = arm_dpi_instr[condition_code + 16*0xd];
4715: 				ic->arg[2] = (size_t)(&cpu->cd.arm.r[rd]);
4716: 
4717: 				memcpy(cbuf, p + (a & 0xfff), len);
4718: 
4719: 				if (b_bit) {
4720: 					x = cbuf[0];
4721: 				} else {
4722: 					if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
4723: 						x = cbuf[0] + (cbuf[1]<<8) +
4724: 						    (cbuf[2]<<16) + (cbuf[3]<<24);
4725: 					else
4726: 						x = cbuf[3] + (cbuf[2]<<8) +
4727: 						    (cbuf[1]<<16) + (cbuf[0]<<24);
4728: 				}
4729: 				
4730: 				ic->arg[1] = x;
4731: 			}
4732: 		}
