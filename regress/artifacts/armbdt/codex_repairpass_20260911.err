1599: /*
1600:  *  Shared between regular ARM and the THUMB encoded 'pop'.
1601:  */
1602: void arm_pop(struct cpu* cpu, uint32_t* np, int p_bit, int u_bit, int s_bit, int w_bit, uint32_t iw)
1603: {
1604: 	uint32_t addr = *np;
1605: 	unsigned char data[4];
1606: 	unsigned char *page;
1607: 	int i, return_flag = 0;
1608: 	uint32_t new_values[16];
1609: 
1610: 	if (s_bit) {
1611: 		/*  Load to USR registers:  */
1612: 		if ((cpu->cd.arm.cpsr & ARM_FLAG_MODE) == ARM_MODE_USR32) {
1613: 			fatal("[ bdt_load: s-bit: in usermode? ]\n");
1614: 			s_bit = 0;
1615: 		}
1616: 		if (iw & 0x8000) {
1617: 			s_bit = 0;
1618: 			return_flag = 1;
1619: 		}
1620: 	}
1621: 
1622: 	for (i=(u_bit? 0 : 15); i>=0 && i<=15; i+=(u_bit? 1 : -1)) {
1623: 		uint32_t value;
1624: 
1625: 		if (!((iw >> i) & 1)) {
1626: 			/*  Skip register i:  */
1627: 			continue;
1628: 		}
1629: 
1630: 		if (p_bit) {
1631: 			if (u_bit)
1632: 				addr += sizeof(uint32_t);
1633: 			else
1634: 				addr -= sizeof(uint32_t);
1635: 		}
1636: 
1637: 		page = cpu->cd.arm.host_load[addr >> 12];
1638: 		if (page != NULL) {
1639: 			uint32_t *p32 = (uint32_t *) page;
1640: 			value = p32[(addr & 0xfff) >> 2];
1641: 			/*  Change byte order of value if
1642: 			    host and emulated endianness differ:  */
1643: #ifdef HOST_LITTLE_ENDIAN
1644: 			if (cpu->byte_order == EMUL_BIG_ENDIAN)
1645: #else
1646: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
1647: #endif
1648: 				value = ((value & 0xff) << 24) |
1649: 				    ((value & 0xff00) << 8) |
1650: 				    ((value & 0xff0000) >> 8) |
1651: 				    ((value & 0xff000000) >> 24);
1652: 		} else {
1653: 			/*  #524 (armbdt): MASK THE ACCESS, NEVER THE RUNNING
1654: 			    `addr'.
1655: 
1656: 			    *** THE ARCHITECTURAL RULE IS QUALIFIED AND AN EARLIER
1657: 			    DRAFT OF THIS COMMENT STATED IT FLAT.  ddi0100i.txt
1658: 			    :7954-7959: "For CP15_reg1_Ubit == 0, the Load
1659: 			    Multiple instructions ignore the least significant two
1660: 			    bits of the address.  If an implementation includes a
1661: 			    System Control coprocessor, an address with bits[1:0]
1662: 			    != 0b00 causes an alignment exception IF ALIGNMENT
1663: 			    CHECKING IS ENABLED.  For CP15_reg1_Ubit == 1, all
1664: 			    non-word aligned accesses cause an alignment fault."
1665: 			    So ignore-the-low-two-bits holds for Ubit == 0 with
1666: 			    checking DISABLED, and not otherwise. ***
1667: 
1668: 			    AND THE FORK IS INTERNALLY INCONSISTENT ABOUT THAT
1669: 			    TODAY, which is why the qualification is not academic:
1670: 			    cpu_arm.c:129 SETS ARM_CONTROL_ALIGN in the default
1671: 			    control register and :474 only PRINTS it ("enabled");
1672: 			    nothing consults it.  So the model announces alignment
1673: 			    checking and enforces none.  Modelling the fault is a
1674: 			    SEPARATE round -- this fix makes the two paths agree
1675: 			    with each other and with the Ubit == 0 / checking-off
1676: 			    reading the fork already implements on its fast path.
1677: 
1678: 			    THE DEFECT: the FAST path gets the truncation free from
1679: 			    `(addr & 0xfff) >> 2', and this slow path passed the
1680: 			    RAW addr to memory_rw, whose `offset = paddr &
1681: 			    offset_mask' is PAGE-granularity and whose transfer is
1682: 			    a raw memcpy -- so an unaligned base SPLICED BYTES
1683: 			    ACROSS A WORD BOUNDARY and the same instruction
1684: 			    returned different bytes according to host page-cache
1685: 			    warmth, a condition invisible to the guest.
1686: 
1687: 			    The mask must NOT move to the function entry: `*np =
1688: 			    addr' at the writeback below uses the unmasked running
1689: 			    value, and Mode 4 writeback derives from unmasked Rn.
1690: 			    MEASURED: an entry-mask mutant scores 20/25 on this
1691: 			    round's detector, killed by the writeback rows alone
1692: 			    (probe_M_ENTRY.raw).  It is additionally invisible to
1693: 			    the pre-existing arm_writeback_probe.py BY
1694: 			    CONSTRUCTION -- that probe scopes itself to the
1695: 			    single-register path, a different generator, and never
1696: 			    reaches these helpers.  *** THAT SECOND CLAIM IS NOT A
1697: 			    MEASUREMENT AND AN EARLIER DRAFT WROTE IT AS ONE: the
1698: 			    figure "22/22" appears in no .raw and in no SCORES.txt,
1699: 			    only in briefs and seat answers.  Stated here by
1700: 			    construction, which is what the evidence supports. ***
1701: 			    The generated fast dispatch already separates access
1702: 			    from writeback the same way (generate_arm_multi.c,
1703: 			    `addr &= 0xffc').  */
1704: 			if (!cpu->memory_rw(cpu, cpu->mem, addr & 0xfffffffc, data,
1705: 			    sizeof(data), MEM_READ, CACHE_DATA)) {
1706: 				/*  load failed  */
1707: 				return;
1708: 			}
1709: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1710: 				value = data[0] +
1711: 				    (data[1] << 8) + (data[2] << 16)
1712: 				    + ((uint32_t)data[3] << 24);
1713: 			} else {
1714: 				value = data[3] +
1715: 				    (data[2] << 8) + (data[1] << 16)
1716: 				    + ((uint32_t)data[0] << 24);
1717: 			}
1718: 		}
1719: 
1720: 		new_values[i] = value;
1721: 
1722: 		if (!p_bit) {
1723: 			if (u_bit)
1724: 				addr += sizeof(uint32_t);
1725: 			else
1726: 				addr -= sizeof(uint32_t);
1727: 		}
1728: 	}
1729: 
1730: 	for (i=(u_bit? 0 : 15); i>=0 && i<=15; i+=(u_bit? 1 : -1)) {
1731: 		if (!((iw >> i) & 1)) {
1732: 			/*  Skip register i:  */
1733: 			continue;
1734: 		}
1735: 
1736: 		if (!s_bit) {
1737: 			cpu->cd.arm.r[i] = new_values[i];
1738: 		} else {
1739: 			switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
1740: 			case ARM_MODE_USR32:
1741: 			case ARM_MODE_SYS32:
1742: 				cpu->cd.arm.r[i] = new_values[i];
1743: 				break;
1744: 			case ARM_MODE_FIQ32:
1745: 				if (i >= 8 && i <= 14)
1746: 					cpu->cd.arm.default_r8_r14[i-8] =
1747: 					    new_values[i];
1748: 				else
1749: 					cpu->cd.arm.r[i] = new_values[i];
1750: 				break;
1751: 			case ARM_MODE_SVC32:
1752: 			case ARM_MODE_ABT32:
1753: 			case ARM_MODE_UND32:
1754: 			case ARM_MODE_IRQ32:
1755: 				if (i >= 13 && i <= 14)
1756: 					cpu->cd.arm.default_r8_r14[i-8] =
1757: 					    new_values[i];
1758: 				else
1759: 					cpu->cd.arm.r[i] = new_values[i];
1760: 				break;
1761: 			}
1762: 		}
1763: 	}
1764: 
1765: 	if (w_bit)
1766: 		*np = addr;
1767: 
1768: 	if (return_flag) {
1769: 		uint32_t new_cpsr;
1770: 		int switch_register_banks;
1771: 
1772: 		switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
1773: 		case ARM_MODE_FIQ32:
1774: 			new_cpsr = cpu->cd.arm.spsr_fiq; break;
1775: 		case ARM_MODE_ABT32:
1776: 			new_cpsr = cpu->cd.arm.spsr_abt; break;
1777: 		case ARM_MODE_UND32:
1778: 			new_cpsr = cpu->cd.arm.spsr_und; break;
1779: 		case ARM_MODE_IRQ32:
1780: 			new_cpsr = cpu->cd.arm.spsr_irq; break;
1781: 		case ARM_MODE_SVC32:
1782: 			new_cpsr = cpu->cd.arm.spsr_svc; break;
1783: 		default:fatal("bdt_load: unimplemented mode %i\n",
1784: 			    cpu->cd.arm.cpsr & ARM_FLAG_MODE);
1785: 			cpu->running = 0;
1786: 			cpu->cd.arm.next_ic = &nothing_call;
1787: 			return;
1788: 		}
1789: 
1790: 		switch_register_banks = (cpu->cd.arm.cpsr & ARM_FLAG_MODE) !=
1791: 		    (new_cpsr & ARM_FLAG_MODE);
1792: 
1793: 		if (switch_register_banks)
1794: 			arm_save_register_bank(cpu);
1795: 
1796: 		cpu->cd.arm.cpsr = new_cpsr;
1797: 		cpu->cd.arm.flags = cpu->cd.arm.cpsr >> 28;
1798: 
1799: 		if (switch_register_banks)
1800: 			arm_load_register_bank(cpu);
1801: 	}
1802: 
1803: 	/*  NOTE: Special case: Loading the PC  */
1804: 	if (iw & 0x8000) {
1805: 		cpu->pc = cpu->cd.arm.r[ARM_PC] & 0xfffffffc;
1806: 		if (cpu->machine->show_trace_tree)
1807: 			cpu_functioncall_trace_return(cpu);
1808: 		/*  TODO: There is no need to update the
1809: 		    pointers if this is a return to the
1810: 		    same page!  */
1811: 		/*  Find the new physical page and update the
1812: 		    translation pointers:  */
1813: 		quick_pc_to_pointers_arm(cpu);
1814: 	}
1815: }
