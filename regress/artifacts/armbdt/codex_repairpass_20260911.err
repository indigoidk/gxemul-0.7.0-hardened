1918: /*
1919:  *  bdt_load:  Block Data Transfer, Load
1920:  *
1921:  *  arg[0] = pointer to uint32_t in host memory, pointing to the base register
1922:  *  arg[1] = 32-bit instruction word. Most bits are read from this.
1923:  */
1924: X(bdt_load)
1925: {
1926: 	uint32_t *np = (uint32_t *)ic->arg[0];
1927: 	uint32_t low_pc;
1928: 	uint32_t iw = ic->arg[1];  /*  xxxx100P USWLnnnn llllllll llllllll  */
1929: 	int p_bit = iw & 0x01000000;
1930: 	int u_bit = iw & 0x00800000;
1931: 	int s_bit = iw & 0x00400000;
1932: 	int w_bit = iw & 0x00200000;
1933: 
1934: #ifdef GATHER_BDT_STATISTICS
1935: 	if (!s_bit)
1936: 		update_bdt_statistics(iw);
1937: #endif
1938: 
1939: 	/*  Synchronize the program counter:  */
1940: 	low_pc = ((size_t)ic - (size_t)
1941: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
1942: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
1943: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
1944: 
1945: 	arm_pop(cpu, np, p_bit, u_bit, s_bit, w_bit, (uint16_t)iw);
1946: }
1947: Y(bdt_load)
