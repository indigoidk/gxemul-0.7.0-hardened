1818: /*
1819:  *  Shared between regular ARM and the THUMB encoded 'push'.
1820:  */
1821: void arm_push(struct cpu* cpu, uint32_t* np, int p_bit, int u_bit, int s_bit, int w_bit, uint16_t regs)
1822: {
1823: 	int i;
1824: 	uint32_t value, addr = *np;
1825: 	unsigned char data[4];
1826: 	unsigned char *page;
1827: 
1828: 	for (i=(u_bit? 0 : 15); i>=0 && i<=15; i+=(u_bit? 1 : -1)) {
1829: 		if (!((regs >> i) & 1)) {
1830: 			/*  Skip register i:  */
1831: 			continue;
1832: 		}
1833: 
1834: 		value = cpu->cd.arm.r[i];
1835: 
1836: 		if (s_bit) {
1837: 			switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
1838: 			case ARM_MODE_FIQ32:
1839: 				if (i >= 8 && i <= 14)
1840: 					value = cpu->cd.arm.default_r8_r14[i-8];
1841: 				break;
1842: 			case ARM_MODE_ABT32:
1843: 			case ARM_MODE_UND32:
1844: 			case ARM_MODE_IRQ32:
1845: 			case ARM_MODE_SVC32:
1846: 				if (i >= 13 && i <= 14)
1847: 					value = cpu->cd.arm.default_r8_r14[i-8];
1848: 				break;
1849: 			case ARM_MODE_USR32:
1850: 			case ARM_MODE_SYS32:
1851: 				break;
1852: 			}
1853: 		}
1854: 
1855: 		/*  NOTE/TODO: 8 vs 12 on some ARMs  */
1856: 		if (i == ARM_PC)
1857: 			value = cpu->pc + 12;
1858: 
1859: 		if (p_bit) {
1860: 			if (u_bit)
1861: 				addr += sizeof(uint32_t);
1862: 			else
1863: 				addr -= sizeof(uint32_t);
1864: 		}
1865: 
1866: 		page = cpu->cd.arm.host_store[addr >> 12];
1867: 		if (page != NULL) {
1868: 			uint32_t *p32 = (uint32_t *) page;
1869: 			/*  Change byte order of value if
1870: 			    host and emulated endianness differ:  */
1871: #ifdef HOST_LITTLE_ENDIAN
1872: 			if (cpu->byte_order == EMUL_BIG_ENDIAN)
1873: #else
1874: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
1875: #endif
1876: 				value = ((value & 0xff) << 24) |
1877: 				    ((value & 0xff00) << 8) |
1878: 				    ((value & 0xff0000) >> 8) |
1879: 				    ((value & 0xff000000) >> 24);
1880: 			p32[(addr & 0xfff) >> 2] = value;
1881: 		} else {
1882: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1883: 				data[0] = value;
1884: 				data[1] = value >> 8;
1885: 				data[2] = value >> 16;
1886: 				data[3] = value >> 24;
1887: 			} else {
1888: 				data[0] = value >> 24;
1889: 				data[1] = value >> 16;
1890: 				data[2] = value >> 8;
1891: 				data[3] = value;
1892: 			}
1893: 			/*  #524 (armbdt): the STM side of the same defect; see
1894: 			    the LDM site in arm_pop() for the full reasoning.
1895: 			    STM(1) p.A4-190 carries the identical
1896: 			    ignore-the-low-two-bits rule, and `*np = addr' below
1897: 			    must keep seeing the UNMASKED running value.  */
1898: 			if (!cpu->memory_rw(cpu, cpu->mem, addr & 0xfffffffc, data,
1899: 			    sizeof(data), MEM_WRITE, CACHE_DATA)) {
1900: 				/*  store failed  */
1901: 				return;
1902: 			}
1903: 		}
1904: 
1905: 		if (!p_bit) {
1906: 			if (u_bit)
1907: 				addr += sizeof(uint32_t);
1908: 			else
1909: 				addr -= sizeof(uint32_t);
1910: 		}
1911: 	}
1912: 
1913: 	if (w_bit)
1914: 		*np = addr;
1915: }
