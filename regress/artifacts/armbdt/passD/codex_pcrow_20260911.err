107: /*
108:  *  Helper definitions:
109:  *
110:  *  Each instruction is defined like this:
111:  *
112:  *	X(foo)
113:  *	{
114:  *		code for foo;
115:  *	}
1570: extern void (*arm_load_store_instr_pc[1024])(struct cpu *,
1571: 	struct arm_instr_call *);
1572: 
1573: extern void (*arm_load_store_instr_3[2048])(struct cpu *,
1574: 	struct arm_instr_call *);
1575: 
1576: extern void (*arm_load_store_instr_3_pc[2048])(struct cpu *,
1577: 	struct arm_instr_call *);
1578: 
1579: extern uint32_t (*arm_r[8192])(struct cpu *, struct arm_instr_call *);
1580: extern uint32_t arm_r_r3_t0_c0(struct cpu *cpu, struct arm_instr_call *ic);
1581: 
1582: extern void (*arm_dpi_instr[2 * 2 * 2 * 16 * 16])(struct cpu *,
