172:     print(f"=== ARM BLOCK DATA TRANSFER WITNESS (armbdt)  LEG={LEG} ===")
173:     print(f"Binary: {BIN}")
174:     print("Core symptom: Unaligned base splices bytes across word boundary on cold host pages")
175:     print("Mandatory writeback: Unmasked Rn arithmetic preserved under W=1 Mode 4 transfers")
176:     print("")
