1: #!/usr/bin/env python3
2: """
3: arm_bdt_probe.py -- Rung-3 witness for ARM block data transfer (armbdt).
4: 
5: Tests all four callers of arm_pop / arm_push:
6:   1. X(bdt_load)          (ARM LDM)
7:   2. X(bdt_store)         (ARM STM)
8:   3. Thumb POP            (cpu_arm.c:1677)
9:   4. Thumb PUSH           (cpu_arm.c:1670)
10: 
11: Under cold debugger on unmodified in-tree machine testarm.
12: Core row shape: identical instruction against identical unaligned base executed
13: COLD and WARM, asserting both produce identical architecturally-correct bytes.
14: Discriminates writeback (W=1) unmasked arithmetic result to kill mask-at-entry mutant.
15: Includes liveness control and attribution control asserting specific byte splice.
16: 
17: PROMOTED 2026-09-11 from regress/artifacts/armbdt/agy_armbdt_witness_20260911.py,
18: which stays in place as the AS-RUN record of tables 1-5.  This copy is the one
19: that evolves and that gate_arm.sh executes; editing the artifact copy would
20: falsify what those tables actually measured.
21: 
22: *** read_mem32() DUMPS FROM THE 16-BYTE-ALIGNED BASE.  An unaligned dump start
23: still carries the aligned line label but BLANK-PADS the leading word groups,
24: and .split() then shifts every column index -- so the read silently returns a
25: NEIGHBOURING word.  That defect corrupted 8 of 10 legs of table 4 and made a
26: CORRECT fix report a red BASE row.  Row: probereadalign. ***
27: """
28: 
29: import os, sys, pty, select, time, re
30: 
31: BIN = sys.argv[1] if len(sys.argv) > 1 else "/tmp/gxarmbdt_clone/gxemul"
32: LEG = sys.argv[2] if len(sys.argv) > 2 else "BASE"
33: STUB = "/tmp/stub_armbdt.bin"
34: if not os.path.exists(STUB):
35:     with open(STUB, "wb") as f:
36:         f.write((0xE1A00000).to_bytes(4, "little"))
37: 
38: CODE = 0x00008000
39: PAGE_LDM = 0x00020000
40: PAGE_STM = 0x00021000
41: PAGE_TPOP = 0x00022000
42: PAGE_TPUSH = 0x00023000
43: 
44: class GXemulSession:
45:     def __init__(self, bin_path, timeout=30):
46:         self.bin_path = bin_path
47:         self.pid, self.fd = pty.fork()
48:         if self.pid == 0:
49:             os.execvp(bin_path, [bin_path, "-V", "-A", "-T", "-E", "testarm", "-M", "64", "0x%x:%s" % (CODE, STUB)])
50:             os._exit(127)
51:         self.buf = ""
52:         self.dead = False
53:         self.wait_prompt(timeout)
54: 
55:     def rd(self, t=0.2):
56:         r, _, _ = select.select([self.fd], [], [], t)
57:         if self.fd not in r:
58:             return False
59:         try:
60:             d = os.read(self.fd, 65536)
61:         except OSError:
62:             self.dead = True
63:             return False
64:         if not d:
65:             self.dead = True
66:             return False
67:         self.buf += d.decode("latin1", "replace")
68:         return True
69: 
70:     def wait_prompt(self, timeout=20):
71:         t0 = time.time()
72:         while time.time() - t0 < timeout:
73:             if self.dead:
74:                 return False
75:             self.rd(0.1)
76:             if self.buf.rstrip().endswith("GXemul>"):
77:                 return True
78:         return False
79: 
80:     def send(self, cmd_str, timeout=15):
81:         if self.dead:
82:             return ""
83:         mark = len(self.buf)
84:         b = (cmd_str + "\n").encode("latin1")
85:         try:
86:             os.write(self.fd, b)
87:         except OSError:
88:             self.dead = True
89:             return ""
90:         t0 = time.time()
91:         while time.time() - t0 < timeout:
92:             if self.dead:
93:                 return ""
94:             self.rd(0.1)
95:             if len(self.buf) > mark and self.buf[mark:].rstrip().endswith("GXemul>"):
96:                 return self.buf[mark:]
97:         return ""
98: 
99:     def run_prog(self, prog_words, timeout=3.0):
100:         for i, w in enumerate(prog_words):
101:             self.send("put w 0x%x, 0x%08x" % (CODE + 4*i, w))
102:         self.send("pc=0x%x" % CODE)
103:         mark = len(self.buf)
104:         try:
105:             os.write(self.fd, b"continue\n")
106:         except OSError:
107:             self.dead = True
108:             return False
109:         t0 = time.time()
110:         while time.time() - t0 < timeout:
111:             self.rd(0.1)
112:         try:
113:             os.write(self.fd, b"\x03")
114:         except OSError:
115:             pass
116:         return self.wait_prompt(timeout=5)
117: 
118:     def get_reg(self, rname):
119:         raw = self.send("print %s" % rname)
120:         m = re.search(r"0x([0-9a-fA-F]+)", raw)
121:         return int(m.group(1), 16) if m else None
122: 
123:     def read_mem32(self, addr):
124:         #  *** DUMP FROM THE 16-BYTE-ALIGNED BASE, ALWAYS. ***  Measured
125:         #  2026-09-11: `dump` at an UNALIGNED start still labels the line
126:         #  with the aligned address but BLANK-PADS the leading word groups:
127:         #    aligned    0x00021000  00000000 44332211
128:         #    unaligned  0x00021000           44332211 00000000
129:         #  `.split()` collapses that padding, so every group index shifts
130:         #  and parts[idx] silently returns a NEIGHBOURING word.  Dumping
131:         #  from the aligned base keeps all four groups present, which is
132:         #  what the idx arithmetic below already assumes.
133:         base = addr & ~0xF
134:         raw = self.send("dump 0x%x 0x%x" % (base, base + 16))
135:         hex_addr = "0x%08x" % (addr & ~0xF)
136:         offset_in_16 = addr & 0xF
137:         for line in raw.splitlines():
138:             if line.startswith(hex_addr):
139:                 parts = line[12:48].split()
140:                 idx = offset_in_16 // 4
141:                 if idx < len(parts):
142:                     hex_str = parts[idx]
143:                     if len(hex_str) == 8:
144:                         b0 = int(hex_str[0:2], 16)
145:                         b1 = int(hex_str[2:4], 16)
146:                         b2 = int(hex_str[4:6], 16)
147:                         b3 = int(hex_str[6:8], 16)
148:                         return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
149:         return None
150: 
151:     def get_tlb_page(self, vaddr):
152:         raw = self.send("tlbdump 0,r")
153:         hex_addr = "0x%08x" % (vaddr & ~0xFFF)
154:         for line in raw.splitlines():
155:             if hex_addr in line:
156:                 m_load = re.search(r"load=([yn])", line)
157:                 m_store = re.search(r"store=([yn])", line)
158:                 load_ok = (m_load.group(1) == "y") if m_load else False
159:                 store_ok = (m_store.group(1) == "y") if m_store else False
160:                 return True, load_ok, store_ok
161:         return False, False, False
162: 
163:     def close(self):
164:         try:
165:             self.send("quit", timeout=2)
166:             os.kill(self.pid, 9)
167:             os.waitpid(self.pid, 0)
168:         except Exception:
169:             pass
170: 
