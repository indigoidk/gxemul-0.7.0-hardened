1598: 
1599: /*
1600:  *  Shared between regular ARM and the THUMB encoded 'pop'.
1601:  */
1602: void arm_pop(struct cpu* cpu, uint32_t* np, int p_bit, int u_bit, int s_bit, int w_bit, uint32_t iw)
1603: {
1604: 	uint32_t addr = *np;
1605: 	unsigned char data[4];
1606: 	unsigned char *page;
1607: 	int i, return_flag = 0;
1608: 	uint32_t new_values[16];
1609: 
1610: 	if (s_bit) {
1611: 		/*  Load to USR registers:  */
1612: 		if ((cpu->cd.arm.cpsr & ARM_FLAG_MODE) == ARM_MODE_USR32) {
1613: 			fatal("[ bdt_load: s-bit: in usermode? ]\n");
1614: 			s_bit = 0;
1615: 		}
1616: 		if (iw & 0x8000) {
1617: 			s_bit = 0;
1618: 			return_flag = 1;
1619: 		}
1620: 	}
1621: 
1622: 	for (i=(u_bit? 0 : 15); i>=0 && i<=15; i+=(u_bit? 1 : -1)) {
1623: 		uint32_t value;
1624: 
1625: 		if (!((iw >> i) & 1)) {
1626: 			/*  Skip register i:  */
1627: 			continue;
1628: 		}
1629: 
1630: 		if (p_bit) {
1631: 			if (u_bit)
1632: 				addr += sizeof(uint32_t);
1633: 			else
1634: 				addr -= sizeof(uint32_t);
1635: 		}
1636: 
1637: 		page = cpu->cd.arm.host_load[addr >> 12];
1638: 		if (page != NULL) {
1639: 			uint32_t *p32 = (uint32_t *) page;
1640: 			value = p32[(addr & 0xfff) >> 2];
1641: 			/*  Change byte order of value if
1642: 			    host and emulated endianness differ:  */
1643: #ifdef HOST_LITTLE_ENDIAN
1644: 			if (cpu->byte_order == EMUL_BIG_ENDIAN)
1645: #else
1646: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
1647: #endif
1648: 				value = ((value & 0xff) << 24) |
1649: 				    ((value & 0xff00) << 8) |
1650: 				    ((value & 0xff0000) >> 8) |
1651: 				    ((value & 0xff000000) >> 24);
1652: 		} else {
1653: 			/*  #524 (armbdt): MASK THE ACCESS, NEVER THE RUNNING
1654: 			    `addr'.
1655: 
1656: 			    *** THE ARCHITECTURAL RULE IS QUALIFIED AND AN EARLIER
1657: 			    DRAFT OF THIS COMMENT STATED IT FLAT.  ddi0100i.txt
1658: 			    :7954-7959: "For CP15_reg1_Ubit == 0, the Load
1659: 			    Multiple instructions ignore the least significant two
1660: 			    bits of the address.  If an implementation includes a
1661: 			    System Control coprocessor, an address with bits[1:0]
1662: 			    != 0b00 causes an alignment exception IF ALIGNMENT
1663: 			    CHECKING IS ENABLED.  For CP15_reg1_Ubit == 1, all
1664: 			    non-word aligned accesses cause an alignment fault."
1665: 			    So ignore-the-low-two-bits holds for Ubit == 0 with
1666: 			    checking DISABLED, and not otherwise. ***
1667: 
1668: 			    AND THE FORK IS INTERNALLY INCONSISTENT ABOUT THAT
1669: 			    TODAY, which is why the qualification is not academic:
1670: 			    cpu_arm.c:129 SETS ARM_CONTROL_ALIGN in the default
1671: 			    control register and :474 only PRINTS it ("enabled");
1672: 			    nothing consults it.  So the model announces alignment
1673: 			    checking and enforces none.  Modelling the fault is a
1674: 			    SEPARATE round -- this fix makes the two paths agree
1675: 			    with each other and with the Ubit == 0 / checking-off
1676: 			    reading the fork already implements on its fast path.
1677: 
1678: 			    THE DEFECT: the FAST path gets the truncation free from
1679: 			    `(addr & 0xfff) >> 2', and this slow path passed the
1680: 			    RAW addr to memory_rw, whose `offset = paddr &
1681: 			    offset_mask' is PAGE-granularity and whose transfer is
1682: 			    a raw memcpy -- so an unaligned base SPLICED BYTES
1683: 			    ACROSS A WORD BOUNDARY and the same instruction
1684: 			    returned different bytes according to host page-cache
1685: 			    warmth, a condition invisible to the guest.
1686: 
1687: 			    The mask must NOT move to the function entry: `*np =
1688: 			    addr' at the writeback below uses the unmasked running
1689: 			    value, and Mode 4 writeback derives from unmasked Rn.
1690: 			    MEASURED: an entry-mask mutant scores 27/32 on the
1691: 			    SHIPPED 32-row detector, killed by the five WB_UNAL rows
1692: 			    alone (killtable_20260911e/probe_M_ENTRY.raw).
1693: 			    *** THIS READ "20/25 ... (probe_M_ENTRY.raw)" UNTIL
1694: 			    2026-09-11.  BOTH HALVES WERE WRONG. ***  20/25 is TABLE
1695: 			    1's figure, carried forward while the detector grew
1696: 			    25 -> 29 -> 32 rows; and the bare filename names FIVE
1697: 			    different files with FIVE different scores -- 20/25,
1698: 			    20/25, 24/29, 26/32, 27/32 -- so the citation could not
1699: 			    be resolved even in principle.  That is the
1700: 			    durable-path rule failing by AMBIGUITY rather than by
1701: 			    overwrite, which is a shape this project had not
1702: 			    recorded.  A score claim names the DIRECTORY, not just
1703: 			    the file.  Found by the Opus pass-C measuring seat.
1704: 			    It is additionally invisible to
1705: 			    the pre-existing arm_writeback_probe.py BY
1706: 			    CONSTRUCTION -- that probe scopes itself to the
1707: 			    single-register path, a different generator, and never
1708: 			    reaches these helpers.  *** THAT SECOND CLAIM IS NOT A
1709: 			    MEASUREMENT AND AN EARLIER DRAFT WROTE IT AS ONE: the
1710: 			    figure "22/22" appears in no .raw and in no SCORES.txt,
1711: 			    only in briefs and seat answers.  Stated here by
1712: 			    construction, which is what the evidence supports. ***
1713: 			    The generated fast dispatch already separates access
1714: 			    from writeback the same way (generate_arm_multi.c,
1715: 			    `addr &= 0xffc').  */
1716: 			if (!cpu->memory_rw(cpu, cpu->mem, addr & 0xfffffffc, data,
1717: 			    sizeof(data), MEM_READ, CACHE_DATA)) {
1718: 				/*  load failed  */
1719: 				return;
1720: 			}
1721: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1722: 				value = data[0] +
1723: 				    (data[1] << 8) + (data[2] << 16)
1724: 				    + ((uint32_t)data[3] << 24);
1725: 			} else {
1726: 				value = data[3] +
1727: 				    (data[2] << 8) + (data[1] << 16)
1728: 				    + ((uint32_t)data[0] << 24);
1729: 			}
1730: 		}
1731: 
1732: 		new_values[i] = value;
1733: 
1734: 		if (!p_bit) {
1735: 			if (u_bit)
1736: 				addr += sizeof(uint32_t);
1737: 			else
1738: 				addr -= sizeof(uint32_t);
1739: 		}
1740: 	}
1741: 
1742: 	for (i=(u_bit? 0 : 15); i>=0 && i<=15; i+=(u_bit? 1 : -1)) {
1743: 		if (!((iw >> i) & 1)) {
1744: 			/*  Skip register i:  */
1745: 			continue;
1746: 		}
1747: 
1748: 		if (!s_bit) {
1749: 			cpu->cd.arm.r[i] = new_values[i];
1750: 		} else {
1751: 			switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
1752: 			case ARM_MODE_USR32:
1753: 			case ARM_MODE_SYS32:
1754: 				cpu->cd.arm.r[i] = new_values[i];
1755: 				break;
1756: 			case ARM_MODE_FIQ32:
1757: 				if (i >= 8 && i <= 14)
1758: 					cpu->cd.arm.default_r8_r14[i-8] =
1759: 					    new_values[i];
1760: 				else
1761: 					cpu->cd.arm.r[i] = new_values[i];
1762: 				break;
1763: 			case ARM_MODE_SVC32:
1764: 			case ARM_MODE_ABT32:
1765: 			case ARM_MODE_UND32:
1766: 			case ARM_MODE_IRQ32:
1767: 				if (i >= 13 && i <= 14)
1768: 					cpu->cd.arm.default_r8_r14[i-8] =
1769: 					    new_values[i];
1770: 				else
1771: 					cpu->cd.arm.r[i] = new_values[i];
1772: 				break;
1773: 			}
1774: 		}
1775: 	}
1776: 
1777: 	if (w_bit)
1778: 		*np = addr;
1779: 
1780: 	if (return_flag) {
1781: 		uint32_t new_cpsr;
1782: 		int switch_register_banks;
1783: 
1784: 		switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
1785: 		case ARM_MODE_FIQ32:
1786: 			new_cpsr = cpu->cd.arm.spsr_fiq; break;
1787: 		case ARM_MODE_ABT32:
1788: 			new_cpsr = cpu->cd.arm.spsr_abt; break;
1789: 		case ARM_MODE_UND32:
1790: 			new_cpsr = cpu->cd.arm.spsr_und; break;
1791: 		case ARM_MODE_IRQ32:
1792: 			new_cpsr = cpu->cd.arm.spsr_irq; break;
1793: 		case ARM_MODE_SVC32:
1794: 			new_cpsr = cpu->cd.arm.spsr_svc; break;
1795: 		default:fatal("bdt_load: unimplemented mode %i\n",
1796: 			    cpu->cd.arm.cpsr & ARM_FLAG_MODE);
1797: 			cpu->running = 0;
1798: 			cpu->cd.arm.next_ic = &nothing_call;
1799: 			return;
1800: 		}
1801: 
1802: 		switch_register_banks = (cpu->cd.arm.cpsr & ARM_FLAG_MODE) !=
1803: 		    (new_cpsr & ARM_FLAG_MODE);
1804: 
1805: 		if (switch_register_banks)
1806: 			arm_save_register_bank(cpu);
1807: 
1808: 		cpu->cd.arm.cpsr = new_cpsr;
1809: 		cpu->cd.arm.flags = cpu->cd.arm.cpsr >> 28;
1810: 
1811: 		if (switch_register_banks)
1812: 			arm_load_register_bank(cpu);
1813: 	}
1814: 
1815: 	/*  NOTE: Special case: Loading the PC  */
1816: 	if (iw & 0x8000) {
1817: 		cpu->pc = cpu->cd.arm.r[ARM_PC] & 0xfffffffc;
1818: 		if (cpu->machine->show_trace_tree)
1819: 			cpu_functioncall_trace_return(cpu);
1820: 		/*  TODO: There is no need to update the
1821: 		    pointers if this is a return to the
1822: 		    same page!  */
1823: 		/*  Find the new physical page and update the
1824: 		    translation pointers:  */
1825: 		quick_pc_to_pointers_arm(cpu);
1826: 	}
1827: }
1828: 
1829: 
1830: /*
1831:  *  Shared between regular ARM and the THUMB encoded 'push'.
1832:  */
1833: void arm_push(struct cpu* cpu, uint32_t* np, int p_bit, int u_bit, int s_bit, int w_bit, uint16_t regs)
1834: {
1835: 	int i;
1836: 	uint32_t value, addr = *np;
1837: 	unsigned char data[4];
1838: 	unsigned char *page;
1839: 
1840: 	for (i=(u_bit? 0 : 15); i>=0 && i<=15; i+=(u_bit? 1 : -1)) {
1841: 		if (!((regs >> i) & 1)) {
1842: 			/*  Skip register i:  */
1843: 			continue;
1844: 		}
1845: 
1846: 		value = cpu->cd.arm.r[i];
1847: 
1848: 		if (s_bit) {
1849: 			switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
1850: 			case ARM_MODE_FIQ32:
1851: 				if (i >= 8 && i <= 14)
1852: 					value = cpu->cd.arm.default_r8_r14[i-8];
1853: 				break;
1854: 			case ARM_MODE_ABT32:
1855: 			case ARM_MODE_UND32:
1856: 			case ARM_MODE_IRQ32:
1857: 			case ARM_MODE_SVC32:
1858: 				if (i >= 13 && i <= 14)
1859: 					value = cpu->cd.arm.default_r8_r14[i-8];
1860: 				break;
1861: 			case ARM_MODE_USR32:
1862: 			case ARM_MODE_SYS32:
1863: 				break;
1864: 			}
1865: 		}
1866: 
1867: 		/*  NOTE/TODO: 8 vs 12 on some ARMs  */
1868: 		if (i == ARM_PC)
1869: 			value = cpu->pc + 12;
1870: 
1871: 		if (p_bit) {
1872: 			if (u_bit)
1873: 				addr += sizeof(uint32_t);
1874: 			else
1875: 				addr -= sizeof(uint32_t);
1876: 		}
1877: 
1878: 		page = cpu->cd.arm.host_store[addr >> 12];
1879: 		if (page != NULL) {
1880: 			uint32_t *p32 = (uint32_t *) page;
1881: 			/*  Change byte order of value if
1882: 			    host and emulated endianness differ:  */
1883: #ifdef HOST_LITTLE_ENDIAN
1884: 			if (cpu->byte_order == EMUL_BIG_ENDIAN)
1885: #else
1886: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
1887: #endif
1888: 				value = ((value & 0xff) << 24) |
1889: 				    ((value & 0xff00) << 8) |
1890: 				    ((value & 0xff0000) >> 8) |
1891: 				    ((value & 0xff000000) >> 24);
1892: 			p32[(addr & 0xfff) >> 2] = value;
1893: 		} else {
1894: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1895: 				data[0] = value;
1896: 				data[1] = value >> 8;
1897: 				data[2] = value >> 16;
1898: 				data[3] = value >> 24;
1899: 			} else {
1900: 				data[0] = value >> 24;
1901: 				data[1] = value >> 16;
1902: 				data[2] = value >> 8;
1903: 				data[3] = value;
1904: 			}
1905: 			/*  #524 (armbdt): the STM side of the same defect; see
1906: 			    the LDM site in arm_pop() for the full reasoning.
1907: 			    STM(1) p.A4-190 carries the identical
1908: 			    ignore-the-low-two-bits rule, and `*np = addr' below
1909: 			    must keep seeing the UNMASKED running value.  */
1910: 			if (!cpu->memory_rw(cpu, cpu->mem, addr & 0xfffffffc, data,
1911: 			    sizeof(data), MEM_WRITE, CACHE_DATA)) {
1912: 				/*  store failed  */
1913: 				return;
1914: 			}
1915: 		}
1916: 
1917: 		if (!p_bit) {
1918: 			if (u_bit)
1919: 				addr += sizeof(uint32_t);
1920: 			else
1921: 				addr -= sizeof(uint32_t);
1922: 		}
1923: 	}
1924: 
1925: 	if (w_bit)
1926: 		*np = addr;
1927: }
1928: 
1929: 
1930: /*
1931:  *  bdt_load:  Block Data Transfer, Load
1932:  *
1933:  *  arg[0] = pointer to uint32_t in host memory, pointing to the base register
1934:  *  arg[1] = 32-bit instruction word. Most bits are read from this.
1935:  */
1936: X(bdt_load)
1937: {
1938: 	uint32_t *np = (uint32_t *)ic->arg[0];
1939: 	uint32_t low_pc;
1940: 	uint32_t iw = ic->arg[1];  /*  xxxx100P USWLnnnn llllllll llllllll  */
1941: 	int p_bit = iw & 0x01000000;
1942: 	int u_bit = iw & 0x00800000;
1943: 	int s_bit = iw & 0x00400000;
1944: 	int w_bit = iw & 0x00200000;
1945: 
1946: #ifdef GATHER_BDT_STATISTICS
1947: 	if (!s_bit)
1948: 		update_bdt_statistics(iw);
1949: #endif
1950: 
1951: 	/*  Synchronize the program counter:  */
1952: 	low_pc = ((size_t)ic - (size_t)
1953: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
1954: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
1955: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
1956: 
1957: 	arm_pop(cpu, np, p_bit, u_bit, s_bit, w_bit, (uint16_t)iw);
1958: }
1959: Y(bdt_load)
1960: 
1961: 
1962: /*
1963:  *  bdt_store:  Block Data Transfer, Store
1964:  *
1965:  *  arg[0] = pointer to uint32_t in host memory, pointing to the base register
1966:  *  arg[1] = 32-bit instruction word. Most bits are read from this.
1967:  */
1968: X(bdt_store)
1969: {
1970: 	uint32_t *np = (uint32_t *)ic->arg[0];
1971: 	uint32_t low_pc;
1972: 	uint32_t iw = ic->arg[1];  /*  xxxx100P USWLnnnn llllllll llllllll  */
1973: 	int p_bit = iw & 0x01000000;
1974: 	int u_bit = iw & 0x00800000;
1975: 	int s_bit = iw & 0x00400000;
1976: 	int w_bit = iw & 0x00200000;
1977: 
1978: #ifdef GATHER_BDT_STATISTICS
1979: 	if (!s_bit)
1980: 		update_bdt_statistics(iw);
1981: #endif
1982: 
1983: 	/*  Synchronize the program counter:  */
1984: 	low_pc = ((size_t)ic - (size_t)
1985: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
1986: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
1987: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
1988: 
1989: 	arm_push(cpu, np, p_bit, u_bit, s_bit, w_bit, (uint16_t)iw);
1990: }
1991: Y(bdt_store)
1992: 
1993: 
1994: /*
1995:  *  Load Register Exclusive (ARM "load linked"):
1996:  *
1997:  *  A Load Register Exclusive instruction initiates a RMW (read-modify-write)
1998:  *  sequence.
1999:  *
