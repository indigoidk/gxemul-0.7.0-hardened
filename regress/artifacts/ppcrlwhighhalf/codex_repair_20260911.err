2406: 
2407: /*
2408:  *  mfsrin, mtsrin:  Move From/To Segment Register Indirect
2409:  *
2410:  *  arg[0] = sr number, or for indirect mode: ptr to rb
2411:  *  arg[1] = ptr to rt
2412:  */
2413: X(mfsr)
2414: {
2415: 	/*  TODO: This only works for 32-bit mode  */
2416: 	reg(ic->arg[1]) = cpu->cd.ppc.sr[ic->arg[0]];
2417: }
2418: X(mfsrin)
2419: {
2420: 	/*  TODO: This only works for 32-bit mode  */
2421: 	uint32_t sr_num = reg(ic->arg[0]) >> 28;
2422: 	reg(ic->arg[1]) = cpu->cd.ppc.sr[sr_num];
2423: }
