4512: 	case PPC_HI6_RLWNM:
4513: 	case PPC_HI6_RLWINM:
4514: 		ra = (iword >> 16) & 31;
4515: 		mb = (iword >> 6) & 31;
4516: 		me = (iword >> 1) & 31;   
4517: 		rc = iword & 1;
4518: 		mask = 0;
4519: 		for (;;) {
4520: 			mask |= ((uint32_t)0x80000000 >> mb);
4521: 			if (mb == me)
