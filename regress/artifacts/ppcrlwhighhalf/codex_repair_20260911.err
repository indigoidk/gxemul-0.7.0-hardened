2511: 	int ra = (ic->arg[0] >> 16) & 31;
2512: 	int sh = ((ic->arg[0] >> 11) & 31) | ((ic->arg[0] & 2) << 4);
2513: 	int me = ((ic->arg[0] >> 6) & 31) | (ic->arg[0] & 0x20);
2514: 	int rc = ic->arg[0] & 1;
