26:  *
27:  *
28:  *  POWER/PowerPC instructions.
29:  *
30:  *  Individual functions should keep track of cpu->n_translated_instrs.
31:  *  (If no instruction was executed, then it should be decreased. If, say, 4
32:  *  instructions were combined into one function and executed, then it should
33:  *  be increased by 3.)
34:  */
35: 
36: 
37: #include "float_emul.h"
38: 
39: /*  #330: which invalid-operation rule a two-operand op follows.  */
40: #define	PPC_INVOP_ADD	0
41: #define	PPC_INVOP_SUB	1
42: #define	PPC_INVOP_MUL	2
43: #define	PPC_INVOP_DIV	3
44: 
45: #ifndef PPC_FP_CLASSIFY_INCLUDED
46: #define PPC_FP_CLASSIFY_INCLUDED
47: /*
48:  *  #330: operand CLASSIFICATION for the exception causes.
49:  *
50:  *  These read the RAW 64-bit pattern, never `struct ieee_float_value`, and
51:  *  that is forced rather than preferred: ieee_interpret_float_value() collapses
52:  *  every NaN to the host's NAN and takes a path that skips the sign, so the
53:  *  struct cannot tell a signalling NaN from a quiet one -- taking VXSNAN from
54:  *  its `nan` field would raise on every quiet NaN.
55:  *
56:  *  ppc_is_snan() also carries its own NaN-class guard. frsp tests the quiet
57:  *  bit bare, which is correct only because it sits inside an already-NaN
58:  *  branch; copied out of that context the same test calls INFINITY a
59:  *  signalling NaN, since Inf has an all-ones exponent and a clear bit 51.
60:  */
61: static int ppc_is_nan(uint64_t x)
62: {
63: 	return (x & 0x7ff0000000000000ULL) == 0x7ff0000000000000ULL
64: 	    && (x & 0x000fffffffffffffULL) != 0;
65: }
66: 
67: static int ppc_is_snan(uint64_t x)
68: {
69: 	return ppc_is_nan(x) && !(x & 0x0008000000000000ULL);
70: }
71: 
72: static int ppc_is_inf(uint64_t x)
73: {
74: 	return (x & 0x7fffffffffffffffULL) == 0x7ff0000000000000ULL;
75: }
76: 
77: static int ppc_is_zero(uint64_t x)
78: {
79: 	return (x & 0x7fffffffffffffffULL) == 0;
80: }
81: 
82: /*
83:  *  The invalid-operation cause owed by a two-operand arithmetic instruction,
84:  *  as a mask for ppc_fpscr_raise(). Detection is from the OPERANDS, never from
85:  *  the host result: for an fmadd whose product overflows the host, the host
86:  *  computes a NaN while the ISA's unrounded intermediate is an infinity and no
87:  *  exception is owed at all, so a result-driven test would invent one.
88:  *
89:  *  A signalling operand takes precedence and is the only cause in that case
90:  *  for add/sub/mul; the class-specific causes apply to numerically invalid
91:  *  combinations of non-signalling operands.
92:  */
93: static uint32_t ppc_invalid_cause(uint64_t a, uint64_t b, int op)
94: {
95: 	if (ppc_is_snan(a) || ppc_is_snan(b))
96: 		return PPC_FPSCR_VXNAN;
97: 
98: 	/*  A quiet NaN operand propagates and raises nothing.  */
99: 	if (ppc_is_nan(a) || ppc_is_nan(b))
100: 		return 0;
101: 
102: 	switch (op) {
103: 	case PPC_INVOP_ADD:	/*  Inf + (-Inf)  */
104: 		if (ppc_is_inf(a) && ppc_is_inf(b)
105: 		    && ((a ^ b) >> 63) != 0)
106: 			return PPC_FPSCR_VXISI;
107: 		break;
108: 	case PPC_INVOP_SUB:	/*  Inf - Inf, same sign  */
109: 		if (ppc_is_inf(a) && ppc_is_inf(b)
110: 		    && ((a ^ b) >> 63) == 0)
111: 			return PPC_FPSCR_VXISI;
112: 		break;
113: 	case PPC_INVOP_MUL:	/*  Inf * 0, either order  */
114: 		if ((ppc_is_inf(a) && ppc_is_zero(b))
115: 		    || (ppc_is_zero(a) && ppc_is_inf(b)))
116: 			return PPC_FPSCR_VXIMZ;
117: 		break;
118: 	case PPC_INVOP_DIV:
119: 		if (ppc_is_inf(a) && ppc_is_inf(b))
120: 			return PPC_FPSCR_VXIDI;
121: 		if (ppc_is_zero(a) && ppc_is_zero(b))
122: 			return PPC_FPSCR_VXZDZ;
123: 		break;
124: 	}
125: 
126: 	return 0;
127: }
128: /*
129:  *  ppc_invalid_cause_fma():  #343
130:  *
131:  *  An FMA computes (frA x frC) +/- frB and can owe MORE THAN ONE invalid
132:  *  cause at once, which is why it cannot reuse ppc_invalid_cause(): that one
133:  *  returns a single cause and, correctly for a two-operand instruction,
134:  *  abandons the operation-specific test the moment it sees any NaN.
135:  *
136:  *  The three conditions are independent:
137:  *
138:  *    VXNAN   any of frA, frC, frB is a signalling NaN.
139:  *    VXIMZ   the MULTIPLY is Inf x 0, either order. This depends only on frA
140:  *            and frC, so a NaN ADDEND does not suppress it -- Inf*0 with an
141:  *            sNaN addend owes VXIMZ | VXNAN, the case cpu_ppc.c already
142:  *            documents and the reason this function exists at all.
143:  *    VXISI   the product is infinite AND the addend is an infinity that
144:  *            cancels it. Inf x 0 is excluded first: there is no product for an
145:  *            addend to disagree with.
146:  *
147:  *  fmsub subtracts frB, so its addend's effective sign is inverted -- the same
148:  *  operands that make fmadd invalid make fmsub clean, and the gate rows are a
149:  *  2x2 on exactly that.
150:  */
151: static uint32_t ppc_invalid_cause_fma(uint64_t a, uint64_t c, uint64_t b,
152: 	int subtract)
153: {
154: 	uint32_t cause = 0;
155: 	int prodneg, addneg;
156: 
157: 	if (ppc_is_snan(a) || ppc_is_snan(c) || ppc_is_snan(b))
158: 		cause |= PPC_FPSCR_VXNAN;
159: 
160: 	/*  VXIMZ: the multiply operands alone decide it.  */
161: 	if (!ppc_is_nan(a) && !ppc_is_nan(c) &&
162: 	    ((ppc_is_inf(a) && ppc_is_zero(c)) ||
163: 	     (ppc_is_zero(a) && ppc_is_inf(c))))
164: 		return cause | PPC_FPSCR_VXIMZ;
165: 
166: 	/*  Beyond this point a NaN anywhere means there is no infinite product
167: 	    to cancel, and a NaN addend cannot cancel one.  */
168: 	if (ppc_is_nan(a) || ppc_is_nan(c) || ppc_is_nan(b))
169: 		return cause;
170: 
171: 	if ((ppc_is_inf(a) || ppc_is_inf(c)) && ppc_is_inf(b)) {
172: 		prodneg = (int) (((a ^ c) >> 63) & 1);
173: 		addneg = (int) ((b >> 63) & 1);
174: 		if (subtract)
175: 			addneg = !addneg;
176: 		if (prodneg != addneg)
177: 			cause |= PPC_FPSCR_VXISI;
178: 	}
179: 
180: 	return cause;
181: }
182: 
183: #endif	/*  PPC_FP_CLASSIFY_INCLUDED  */
184: 
185: 
186: 
187: /*
188:  *  #326: FDOT -- the floating-point twin of DOT0/1/2 below.
189:  *
190:  *  Every opcode-59/63 form with Rc=1 used to reach `goto bad`, which does not
191:  *  raise a program exception: it stops the emulator. That meant `fadd.`,
192:  *  `frsp.`, `fmr.` and the rest killed the machine, including the record
193:  *  forms of instructions that worked perfectly with Rc=0 -- and a compiler
194:  *  emits them whenever a floating-point result feeds a condition test.
195:  *
196:  *  CHECK_FOR_FPU_EXCEPTION comes FIRST, before the base handler, and that
197:  *  ordering is load-bearing rather than tidy. The base handler's own check
198:  *  returns from the BASE on MSR[FP]=0, which would leave this wrapper to
199:  *  write CR1 on top of a just-entered exception context, for an instruction
200:  *  that never executed. NetBSD/macppc does lazy FP -- MSR[FP] is clear on
201:  *  every process's first floating-point instruction -- so that is the
202:  *  ordinary path, not a corner. Checking here returns before the base runs;
203:  *  when FP is available the base's identical check simply passes again.
204:  */
205: #define FDOT(n) X(n ## _dot) { CHECK_FOR_FPU_EXCEPTION; \
206: 	instr(n)(cpu,ic); update_cr1(cpu); }
207: 
208: #define DOT0(n) X(n ## _dot) { instr(n)(cpu,ic); \
209: 	update_cr0(cpu, reg(ic->arg[0])); }
210: #define DOT1(n) X(n ## _dot) { instr(n)(cpu,ic); \
211: 	update_cr0(cpu, reg(ic->arg[1])); }
212: #define DOT2(n) X(n ## _dot) { instr(n)(cpu,ic); \
213: 	update_cr0(cpu, reg(ic->arg[2])); }
214: 
215: #ifndef CHECK_FOR_FPU_EXCEPTION
216: #define CHECK_FOR_FPU_EXCEPTION { if (!(cpu->cd.ppc.msr & PPC_MSR_FP)) { \
217: 		/*  Synchronize the PC, and cause an FPU exception:  */  \
218: 		uint64_t low_pc = ((size_t)ic -				 \
219: 		    (size_t)cpu->cd.ppc.cur_ic_page)			 \
220: 		    / sizeof(struct ppc_instr_call);			 \
221: 		cpu->pc = (cpu->pc & ~((PPC_IC_ENTRIES_PER_PAGE-1) <<	 \
222: 		    PPC_INSTR_ALIGNMENT_SHIFT)) + (low_pc <<		 \
223: 		    PPC_INSTR_ALIGNMENT_SHIFT);				 \
224: 		ppc_exception(cpu, PPC_EXCEPTION_FPU);			 \
225: 		return; } }
226: #endif
227: 
228: 
229: 
230: /*
231:  *  nop:  Do nothing.
232:  */
233: X(nop)
234: {
235: }
236: 
237: 
238: /*
239:  *  invalid:  To catch bugs.
240:  */
241: X(invalid)
242: {
243: 	fatal("PPC: invalid(): INTERNAL ERROR\n");
244: 	exit(1);
245: }
