4040: /*
4041:  *  ppc_instr_to_be_translated():
4042:  *
4043:  *  Translate an instruction word into a ppc_instr_call. ic is filled in with
4044:  *  valid data for the translated instruction, or a "nothing" instruction if
4045:  *  there was a translation failure. The newly translated instruction is then
4046:  *  executed.
4047:  */
4048: X(to_be_translated)
4049: {
4050: 	uint64_t addr, low_pc, tmp_addr;
4051: 	uint32_t iword, mask;
4052: 	unsigned char *page;
4053: 	unsigned char ib[4];
4054: 	int main_opcode, rt, rs, ra, rb, rc, aa_bit, l_bit, lk_bit, spr, sh,
4055: 	    xo, imm, load, size, update, zero, bf, bo, bi, bh, oe_bit, n64=0,
4056: 	    bfa, fp, byterev, nb, mb, me;
4057: 	void (*samepage_function)(struct cpu *, struct ppc_instr_call *);
4058: 	void (*rc_f)(struct cpu *, struct ppc_instr_call *);
4059: 
4060: 	/*  Figure out the (virtual) address of the instruction:  */
4061: 	low_pc = ((size_t)ic - (size_t)cpu->cd.ppc.cur_ic_page)
4062: 	    / sizeof(struct ppc_instr_call);
4063: 	addr = cpu->pc & ~((PPC_IC_ENTRIES_PER_PAGE-1)
4064: 	    << PPC_INSTR_ALIGNMENT_SHIFT);
4065: 	addr += (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);
4066: 	cpu->pc = addr;
4067: 	addr &= ~((1 << PPC_INSTR_ALIGNMENT_SHIFT) - 1);
4068: 
4069: 	/*  Read the instruction word from memory:  */
4070: #ifdef MODE32
4071: 	page = cpu->cd.ppc.host_load[((uint32_t)addr) >> 12];
4072: #else
4073: 	{
4074: 		const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
4075: 		const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
4076: 		const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
4077: 		uint32_t x1 = (addr >> (64-DYNTRANS_L1N)) & mask1;
4078: 		uint32_t x2 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
4079: 		uint32_t x3 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N-
4080: 		    DYNTRANS_L3N)) & mask3;
4081: 		struct DYNTRANS_L2_64_TABLE *l2 = cpu->cd.ppc.l1_64[x1];
4082: 		struct DYNTRANS_L3_64_TABLE *l3 = l2->l3[x2];
4083: 		page = l3->host_load[x3];
4084: 	}
4085: #endif
