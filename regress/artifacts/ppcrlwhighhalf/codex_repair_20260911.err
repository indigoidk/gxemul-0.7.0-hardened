2537: 	int rs = (iw >> 21) & 31, ra = (iw >> 16) & 31;
2538: 	int sh = ((iw >> 11) & 31) | ((iw & 2) << 4);
2539: 	int mb = ((iw >> 6) & 31) | (iw & 0x20);
2540: 	int rc = ic->arg[0] & 1;
2541: 	int m;
2542: 	uint64_t tmp, s = cpu->cd.ppc.gpr[rs];
2543: 	/*  TODO: Fix this, its performance is awful:  */
2544: 	while (sh-- != 0) {
2545: 		int b = (s >> 63) & 1;
2546: 		s = (s << 1) | b;
2547: 	}
2548: 	m = mb; tmp = 0;
2549: 	do {
2550: 		tmp |= ((uint64_t)1 << (63-m));
2551: 		m ++;
2552: 	} while (m != 63 - sh);
2553: 	cpu->cd.ppc.gpr[ra] &= ~tmp;
2554: 	cpu->cd.ppc.gpr[ra] |= (tmp & s);
2555: 	if (rc)
2556: 		update_cr0(cpu, cpu->cd.ppc.gpr[ra]);
2557: }
