1840:               "$(grep -c 'the SLAVE reports its own capacity' "$WDCLOG")" "1"
1841:     check     "wdc IDENTIFY: the word-49 capability row is present" \
1842:               "$(grep -c 'no unimplemented capability claimed' "$WDCLOG")" "1"
1843:     check     "wdc IDENTIFY: the oracle sweeps the full 16-bit range" \
1844:               "$(grep -c 'of 65535 contradict their geometry' "$WDCLOG")" "1"
1845:     #  #408: two more named rows, each closing a mutant class that survived the
1846:     #  twelve. The slave row previously asserted only CAPACITY, so four mutants
1847:     #  reading drive 0's cylinders/heads/spt went unnoticed; and base_drive -- which
1848:     #  dev_wdc_init sets to 2 for the SECONDARY controller, so it is live, not
1849:     #  hypothetical -- was ungated at all three call sites.
1850:     check     "wdc IDENTIFY: the slave row covers geometry, not just capacity" \
1851:               "$(grep -c 'the SLAVE reports its own' "$WDCLOG")" "1"
1852:     check     "wdc IDENTIFY: the base_drive row is present" \
1853:               "$(grep -c 'base_drive reaches the diskimage id' "$WDCLOG")" "1"
1854:     #  #409: two further rows, each closing mutants that survived the thirteen.
1855:     #    identity  <- is_a_cdrom and getname still IGNORED `id`, so four mutants
1856:     #                 lived. The stub now poisons BY INVERSION: every id except
1857:     #                 this drive's is a CD-ROM. Pinning ONE specific id does not
1858:     #                 work -- a wrong id simply misses it and still reads "not a
1859:     #                 CD-ROM", which is how the first attempt at this row failed.
1860:     #    wide      <- no fixture pushed heads or spt past 255, so the `>> 8` half
1861:     #                 of words 3 and 6 was never non-zero and could be replaced by
1862:     #                 a literal 0 undetected.
1863:     #  #410: grep a string the row prints WHETHER IT PASSES OR FAILS. The #409
1864:     #  version matched 'the right id', which appears only in the ok line -- so a
1865:     #  genuinely FAILING row also reported "not present", turning one red row into
1866:     #  two and making a failure indistinguishable from a deletion. That is the
1867:     #  phantom-regression shape this harness's own vacuity taxonomy warns about.
1868:     check     "wdc IDENTIFY: the identity row is present" \
1869:               "$(grep -c 'the right id\|not the CD-ROM next to it' "$WDCLOG")" "1"
1870:     #  #410: the ATAPI branch was DELETABLE with every row green -- #409's
1871:     #  inverted poison made the drive under test the only non-CD-ROM, so the row
1872:     #  could observe nothing but the negative answer. This row takes the other
1873:     #  branch and asserts word 0 == 0x8580.
1874:     check     "wdc IDENTIFY: the ATAPI-flags row is present" \
1875:               "$(grep -c 'announces itself as one' "$WDCLOG")" "1"
1876:     check     "wdc IDENTIFY: the wide-geometry row is present" \
1877:               "$(grep -c 'high byte' "$WDCLOG")" "1"
1878: fi
