2645: DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
2646: 
2647: 
2648: #  *** A PYTHON DICT LITERAL ACCEPTS A DUPLICATE KEY IN SILENCE, AND THE LAST ONE WINS.
2649: #  MEASURED ON THIS FILE, HOURS AFTER IT WAS WRITTEN. ***
2650: #
2651: #  Two rounds added `sgi_eaddr_probe.py` to MANIFEST independently -- the author of this
2652: #  checker, and the #446 round whose probe it was.  Both landed, four lines apart, and
2653: #  `len(MANIFEST)` reported ONE entry.  Nothing complained, because nothing can: by the
2654: #  time the module object exists the earlier entry is already gone.  Here the two agreed
2655: #  on CLASS, so the behaviour was identical and the only damage was a stale line.  Had
2656: #  they disagreed -- one DETECTOR, one TOOL -- the file would have carried a visible,
2657: #  reviewed, *tracked* classification that the checker silently did not use, and the
2658: #  filename tooth that refuses `*_probe.py` in class `tool` would have been reading the
2659: #  wrong entry while looking correct in the diff.
2660: #
2661: #  It has to be caught by re-reading THIS FILE'S SOURCE TEXT, because the data structure
2662: #  cannot represent the fault it suffers from.  A duplicate is a SETUP FAULT, not a
2663: #  finding: it exits before any wiring is derived, so it can never be confused with a
2664: #  probe that is genuinely unwired.
2665: #  The open() is INLINE rather than a call to read() below: this guard runs at import time,
2666: #  fifty lines before read() is defined, and the first draft died with a NameError proving it.
2667: #  It failed loudly, which is luck -- a guard placed in a branch would have failed silently.
2668: def _refuse_duplicate_keys():
2669:     with open(os.path.abspath(__file__), "r", encoding="utf-8", errors="replace") as fh:
2670:         src = fh.read()
2671:     #  *** AN ANCHOR THAT NO LONGER MATCHES IS ITSELF A SETUP FAULT, NOT A REASON TO SKIP,
2672:     #  AND THE FIRST VERSION OF THIS GUARD DID `continue`. ***  A flagship review MEASURED
2673:     #  the consequence: `MANIFEST =  {` -- one extra space, valid Python, invisible to a
2674:     #  reader -- makes a literal find() miss, the guard skips, and a planted duplicate key
2675:     #  runs GREEN.  That is this file's own thesis turned on itself: a fault in a guard does
2676:     #  not fail loudly, it stops guarding.  The regex tolerates whitespace, and a miss is
2677:     #  now reported rather than shrugged at.
2678:     for name in ("MANIFEST", "EXEMPT"):
2679:         m = re.search(r"^%s\s*=\s*\{" % re.escape(name), src, re.M)
2680:         if m is None:
2681:             print("PROBEWIRING_SETUP_FAULT  the %s literal could not be located in this"
2682:                   " file's own source." % name)
2683:             print("  The duplicate-key guard cannot run, and a duplicate would pass"
2684:                   " UNSEEN.  Fix the anchor, do not delete the check.")
2685:             sys.exit(2)
2686:         i = m.start()
2687:         j = src.find("\n}", i)
2688:         seen, dupes = set(), []
2689:         for k in re.findall(r'^\s*"([^"]+)"\s*:', src[i:j], re.M):
2690:             (dupes.append(k) if k in seen else None)
2691:             seen.add(k)
2692:         if dupes:
2693:             print("PROBEWIRING_SETUP_FAULT  %s names the same key twice; a dict literal" % name)
2694:             print("  keeps only the LAST and says nothing.  Delete the stale line(s):")
2695:             for k in sorted(set(dupes)):
2696:                 print("    %s" % k)
2697:             sys.exit(2)
2698: 
