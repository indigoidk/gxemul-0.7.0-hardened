v2goff=apply_diff(blob(\"regress/gate_offline.sh\"), \"regress/artifacts/exemptredate_20260925/diff550v2_goff.diff\")
v3goff=apply_diff(v2goff, \"regress/artifacts/exemptredate_20260925/f2b/diff550_v2_v3_goff.diff\")
a551goff=apply_diff(v2goff,\"regress/artifacts/wdcidselfcheck_20260925/diff551_goff_on550.diff\")
b551goff=apply_diff(a551goff,\"regress/artifacts/wdcidselfcheck_20260925/f2b/diff551_a_b_goff.diff\")
