from pathlib import Path
import ast, hashlib, re, subprocess, sys
root = Path.cwd()
def blob(path, ref=\"f4f601c4\"):
    return subprocess.check_output([\"git\", \"show\", ref+\":\"+path]).decode(\"utf-8\")
def read(path):
    return Path(path).read_text(encoding=\"utf-8\")
def apply_diff(src, path):
    old = src.splitlines(keepends=True)
    diff = read(path).splitlines(keepends=True)
    out = []
    pos = 0
    i = 0
    while i < len(diff):
        m = re.match(r\"@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@\", diff[i])
        if not m:
            i += 1
            continue
        start = int(m[1])-1
        assert start >= pos, (path, start, pos)
        out.extend(old[pos:start])
        pos = start
        i += 1
        while i < len(diff) and diff[i][:1] in (\" \", \"+\", \"-\") and not diff[i].startswith((\"--- \", \"+++ \")):
            op, line = diff[i][0], diff[i][1:]
            if op in (\" \", \"-\"):
                assert old[pos] == line, (path, pos+1, old[pos], line)
                pos += 1
            if op in (\" \", \"+\"):
                out.append(line)
            i += 1
    out.extend(old[pos:])
    return \"\".join(out)
orig551=blob(\"regress/diff_wdc_identify.c\")
a551=apply_diff(orig551, \"regress/artifacts/wdcidselfcheck_20260925/diff551_wdcid.diff\")
b551=apply_diff(a551, \"regress/artifacts/wdcidselfcheck_20260925/f2b/diff551_a_b_wdcid.diff\")
