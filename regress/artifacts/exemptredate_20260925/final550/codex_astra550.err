chk("R7 memcpy arm: occupancy did not COLLAPSE",       (gx_occ(&d) >= occ_before) ? 1 : 0, 1);
chk("R8 bulk edge: head never reaches tail",       (d.inbuf_head == d.inbuf_tail) ? 0 : 1, 1);
