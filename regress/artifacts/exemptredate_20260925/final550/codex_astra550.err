222:     #  *** POLL, NEVER SAMPLE ONCE.  MEASURED 2026-09-17, and the first run of this probe
223:     #  reported `alive' for a process that SIGABRT'd 0.6 s later. ***
224:     #  `rd()' RETURNS IMMEDIATELY ON EOF rather than waiting out its timeout, so `spin' --
225:     #  which exists precisely to give a dying child time to die -- is SKIPPED EXACTLY WHEN THE
226:     #  CHILD DIES.  A single waitpid(WNOHANG) then lands ~0 s after EOF while the kernel is
227:     #  still writing a 6 MB core, reports "still running", and THE KILL ROW GOES GREEN ON A
228:     #  LIVE HOST DEATH.  That is the false-green this probe exists to refuse.
229:     alive = True
230:     deadline = time.time() + 12.0
231:     while time.time() < deadline:
232:         try:
233:             wpid, status = os.waitpid(pid, os.WNOHANG)
234:         except ChildProcessError:
235:             alive = False
236:             break
237:         if wpid == pid:
238:             alive = False
239:             break
240:         time.sleep(0.05)
241:     if alive:
242:         try:
243:             os.kill(pid, signal.SIGKILL)
244:             os.waitpid(pid, 0)
245:         except OSError:
246:             pass
247:     try:
248:         os.close(fd)
249:     except OSError:
250:         pass
251:     return buf, alive
