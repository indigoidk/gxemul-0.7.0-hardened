108:         python check_probe_wiring.py --selftest [-v]
109: Exit 0 and print PROBEWIRING_PASS, or exit 1 and print PROBEWIRING_FAIL.
110: """
111: import os
112: import re
113: import subprocess
114: import sys
115: 
116: HERE = os.path.dirname(os.path.abspath(__file__))
117: DEFAULT_REGRESS = os.path.normpath(os.path.join(HERE, "..", "..", "regress"))
118: 
119: #  Scripts that are part of the battery but are not in the GATES array: run.sh drives it and
120: #  lib.sh is sourced by every gate, so an invocation placed in either really would run.
121: ALWAYS = ("run.sh", "lib.sh")
122: 
123: #  A script argument is only a REPO probe if its directory is the regress dir.  gate_offline
124: #  runs `python3 "$ACDIR/selftest_absorb.py"` on a MUTATED COPY in the log dir -- counting
125: #  that as "the repo file is gated" would be the absorb-control mutant vouching for the
126: #  artefact it was built to attack.  Anything else is reported under IGNORED rather than
127: #  dropped, so a legitimate new spelling shows up as a line to read instead of a silent red.
128: HERE_DIRS = ("", ".", "$HERE", "${HERE}")
129: 
130: CLASS_DETECTOR = "detector"
131: CLASS_WITNESS = "witness"
132: CLASS_TOOL = "tool"
133: CLASS_RESEARCH = "research"
2860:     found = []
2861:     for dirpath, dirnames, filenames in os.walk(regress):
2862:         dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
2863:         for f in filenames:
2864:             if f.endswith(".py"):
2865:                 rel = os.path.relpath(os.path.join(dirpath, f), regress)
2866:                 found.append(rel.replace(os.sep, "/"))
2867:     return sorted(found), "on-disk (git could not answer)"
2868: 
2869: 
2870: def self_label(path):
2871:     """The file's OWN summary line, for the SELFLABEL advisory only.  Never a verdict."""
2872:     try:
2873:         head = read(path).splitlines()[:6]
2874:     except OSError:
2875:         return None
2876:     for ln in head:
2877:         has_w, has_d = bool(_LBL_W.search(ln)), bool(_LBL_D.search(ln))
2878:         if has_w and not has_d:
2879:             return CLASS_WITNESS
2880:         if has_d and not has_w:
2881:             return CLASS_DETECTOR
2882:         if has_w and has_d:
2883:             return None
2884:     return None
2885: 
2886: 
2887: #  =======================================================================================
2888: #  SELFTEST.  Mutants are applied to COPIES in a temp dir; nothing in the repository is
2889: #  touched, so no .MUTANT sentinel is needed.  EXIT STATUS IS TAKEN FROM THE PROCESS: this
2890: #  project lost a whole battery result to `cmd | tail`, which reports tail's status, so a
2891: #  KILLED run read as exit 0.  subprocess.run(...).returncode cannot make that mistake.
2892: #
2893: #  A CHECKER-SOURCE MUTANT THAT DOES NOT APPLY EXACTLY ONCE IS A FAULT, NEVER A PASS --
2894: #  absorb_census.py's rule, and it is what keeps this selftest from silently going vacuous
2895: #  after someone reformats the manifest below.
2896: #
2897: #  *** AND IT FIRED ON ITS OWN AUTHOR, FIRST RUN. ***  The mutants below started life as
2898: #  plain string literals, which meant the text they searched for existed TWICE in this file:
2899: #  once in the manifest and once in the selftest.  _st_apply refused ("x2 ... want 1") rather
2900: #  than mutating both, which would have silently mutated the selftest instead of the subject.
2901: #  So every mutant target is BUILT from its parts and never written out whole.
2902: def _lit(*parts):

