199:             try:
200:                 r, _, _ = select.select([fd], [], [], 0.1)
201:             except OSError:
202:                 return
203:             if not r:
204:                 continue
205:             try:
206:                 d = os.read(fd, 65536)
207:             except OSError:
208:                 return
209:             if not d:
210:                 return
211:             buf += d.decode("utf-8", "replace")
