137: def run_cd(binary, tag, out):
138:     import re
139:     argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
140:             "-d", W.DISK_PREFIX + DISK, "0x%x:%s" % (W.BASE, W.RAWBIN)]
141:     out("  command   " + " ".join(argv))
142:     emu = W.Emu(argv)
143:     dis = emu.send("unassemble 0x%x 0x%x" % (W.BASE, W.BASE + len(W.prog) * 4), wait=3.0)
144:     seen = {}
145:     for line in dis.splitlines():
146:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
147:         if m:
148:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
149:     w_ok = 0
150:     for i, (w, want_mn) in enumerate(W.prog):
151:         hit = seen.get((W.BASE + i * 4) & 0xffffffff)
152:         if hit and hit[0] == "%08x" % w:
153:             w_ok += 1
154:     out("  CONTROL 0 encodings: %d of %d WORDS agree with the emulator's own disassembler"
155:         % (w_ok, len(W.prog)))
156:     cd = emu.send("print cpu", wait=0.4)
157:     emu.send("breakpoint add 0x%x" % W.HALT_ADDR, wait=0.5)
158:     emu.send("continue", wait=1.0)
159:     import time as _t
160:     deadline = _t.time() + 60
161:     parked = False
162:     while _t.time() < deadline:
163:         emu.drain(0.5)
164:         #  *** MATCH THE HIT LINE, NOT THE BARE WORD. ***  This read
165:         #  `if "BREAKPOINT" in <tail>.upper():` until 2026-08-30, and the
166:         #  transcript contains the probe's OWN echoed setup command,
167:         #  `breakpoint add 0x...`.  The check matched its own input and could
168:         #  never return False.  It was right by accident in every run where the
169:         #  guest parked, and silently wrong in the first run where it did not:
170:         #  a mutant returning 0 from the device handler raises EXCEPTION_DBE, the
171:         #  guest re-executes the faulting store forever, and the probe still
172:         #  reported `breakpoint reached: True` with every register reading ??.
173:         #  That was scored as a KILL -- a failed run counted as a table result.
174:         #  The emulator prints `BREAKPOINT: pc = 0x...` on a real hit.
175:         if "BREAKPOINT: PC" in bytes(emu.buf[-4000:]).decode("latin1", "replace").upper():
176:             parked = True
177:             break
178:     out("  parked at the halt breakpoint: %s" % ("yes" if parked else "*** NO ***"))
179:     got = {}
180:     for nm in W.REGS:
181:         v = W.reg(emu, nm)
182:         got[nm] = None if v is None else (v & 0xff)
183:     whole = bytes(emu.buf).decode("latin1", "replace")
184:     iscd = "CD-ROM" in whole or "cdrom" in whole.lower()
185:     out("  the emulator's own startup listing calls the image a CD-ROM: %s" % iscd)
186:     emu.close(os.path.join(OUTDIR, "transcript_sig_%s.log" % tag))
187:     return got, w_ok, parked, iscd
188: 
189: 
190: lines = []
191: 
192: 
193: def out(s=""):
194:     lines.append(s)
195:     print(s)
196:     sys.stdout.flush()
197: 
198: 
199: out("=" * 100)
200: out("wdcaltoffset SIGNATURE detector -- the channel the DRQ/ring rows cannot see")
201: out("=" * 100)
202: out("date        %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
203: out("instrument  %s/wdc_altoffset_probe.py encoder + Emu, IMPORTED" % WIT)
204: out("program     %d guest instructions" % len(W.prog))
205: out("rig         evbmips -e malta, image %s attached ciR:  -- the 'c' prefix is what" % DISK)
206: out("            makes diskimage_is_a_cdrom() true and the signature channel LIVE")
207: out()
208: 
209: res = {}
210: for tag, binary in LEGS:
211:     out("-" * 100)
212:     out("LEG %s   %s" % (tag, binary))
213:     out("-" * 100)
214:     got, w_ok, parked, iscd = run_cd(binary, tag, out)
215:     res[tag] = dict(got=got, w=w_ok, parked=parked, iscd=iscd)
216:     out()
217: 
218: out("=" * 100)
219: out("THE TABLE")
220: out("=" * 100)

