117: # ----------------------------------------------------------------- architecture
118: def rotl64(x, n):
119:     n &= 63
120:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
121: 
122: 
123: def mask_b_63(b):
124:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
125:     assert 0 <= b <= 63
126:     return (1 << (64 - b)) - 1
127: 
128: 
129: def mask_0_e(e):
130:     """MASK(0,e), big-endian = the high (e+1) bits."""
131:     assert 0 <= e <= 63
132:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
133: 
134: 
135: def want_rldicl(rs_val, sh, mb):
136:     return rotl64(rs_val, sh) & mask_b_63(mb)
137: 
138: 
139: def want_rldicr(rs_val, sh, me):
140:     return rotl64(rs_val, sh) & mask_0_e(me)
141: 
142: 
143: def want_rldimi(rs_val, ra_val, sh, mb):
144:     """manual :29908 -- m <- MASK(b, ~n); prose :29909 "1 bits from bit MB
145:        through bit 63 - SH"."""
146:     m = mask_b_63(mb) & mask_0_e((63 - sh) & 63)
147:     return (rotl64(rs_val, sh) & m) | (ra_val & (~m & M64))
148: 
149: 
150: def rotl32(x, n):
151:     """ROTL[32] per manual :6878 -- two copies of rS[32-63], then rotate."""
152:     lo = x & 0xFFFFFFFF
153:     n &= 31
154:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
155:     return (r32 << 32) | r32
156: 
157: 
158: def mask32(mb, me):
159:     """MASK(mb+32, me+32) confined to the low 32 bits, PowerPC wrap-around form."""
160:     m = 0
161:     b = mb
162:     while True:
163:         m |= 1 << (31 - b)
164:         if b == me:
165:             break
166:         b = (b + 1) & 31
167:     return m
168: 
169: 
170: def want_rlwinm(rs_val, sh, mb, me):
171:     return rotl32(rs_val, sh) & mask32(mb, me)
172: 
173: 
174: def want_rlwimi(rs_val, ra_val, sh, mb, me):
175:     m = mask32(mb, me)
176:     return (rotl32(rs_val, sh) & m) | (ra_val & (~m & M64))
177: 
178: 
179: # -------------------------------------------------------------------- encodings
180: def enc_md(xo, rs, ra, sh, mbe, rc=0):
181:     """opcode 30 (rldicl/rldicr/rldimi).  Field placement derived from the manual's
182:        own instruction-format diagram at :29706-29734:
183:          0-5 opcode | 6-10 S | 11-15 A | 16-20 sh[0-4] | 21-26 mb[5]||mb[0-4]
184:          | 27-29 XO | 30 sh[5] | 31 Rc      (all big-endian bit numbers)"""
185:     assert 0 <= sh <= 63 and 0 <= mbe <= 63 and 0 <= xo <= 7
186:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
187:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
188:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
189: 
190: 
191: def RLDICL(ra, rs, sh, mb):
192:     return enc_md(0, rs, ra, sh, mb)
193: 
194: 
195: def RLDICR(ra, rs, sh, me):
196:     return enc_md(1, rs, ra, sh, me)
197: 
198: 
199: def RLDIMI(ra, rs, sh, mb):
200:     return enc_md(3, rs, ra, sh, mb)
201: 
202: 
203: def enc_m(op, rs, ra, sh, mb, me, rc=0):
204:     """opcode 20/21 (rlwimi/rlwinm): 0-5 op | 6-10 S | 11-15 A | 16-20 SH
205:        | 21-25 MB | 26-30 ME | 31 Rc."""
206:     return ((op << 26) | (rs << 21) | (ra << 16) | (sh << 11) | (mb << 6)
207:             | (me << 1) | rc) & 0xFFFFFFFF
208: 
209: 
210: def RLWINM(ra, rs, sh, mb, me):
211:     return enc_m(21, rs, ra, sh, mb, me)
212: 
213: 
214: def RLWIMI(ra, rs, sh, mb, me):
215:     return enc_m(20, rs, ra, sh, mb, me)
216: 
217: 
218: def LI(rd, simm):
219:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
220: 
221: 
222: def ORI(ra, rs, imm):
223:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
224: 
225: 
226: NOP = ORI(0, 0, 0)               # ori r0,r0,0 -- writes r0 only
227: 
228: 
229: # ---------------------------------------------------------------------- sessions
230: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
231:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs.
232:        Returns (regs dict, disasm list, transcript, how)."""
233:     cmds = list(setup)
234:     for i, w in enumerate(insns):
235:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
236:     if insns:
237:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
238:     cmds.append("pc=0x%x" % CODE)
239:     if insns:
240:         cmds.append("step %d" % len(insns))
241:     cmds.append("reg")
242:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
243:     if cpu:
244:         argv += ["-C", cpu]
245:     argv += ["0x%x:%s" % (CODE, DUMMY)]
246:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
247:     try:
248:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
249:                            stderr=subprocess.STDOUT, timeout=timeout)
250:     except subprocess.TimeoutExpired as e:
251:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
252:         return {}, [], out, "TIMEOUT"
253:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
254:     rc = p.returncode
255:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
256:     # the LAST `reg' dump in the transcript
257:     idx = t.rfind("GXemul> reg")
258:     regs = {}
259:     if idx >= 0:
260:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
261:             regs[int(m.group(1))] = int(m.group(2), 16)
262:     dis = []
263:     di = t.find("GXemul> unassemble")
264:     if di >= 0:
265:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
266:                 else len(t)]
267:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
268:                              r"(?:\t(\S+))?", seg, re.M):
269:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
270:     return regs, dis, t, how
271: 
272: 
273: def seed(pairs):
274:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
275: 
276: 
277: print("ppcrldiclzero RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
278: print("machine: -E bareppc -M 64 (UNMODIFIED in-tree; MACHINE_DEFAULT_CPU=PPC970,"
279:       " 64-bit)")
280: print("wants derived from _scratchpad/ppc_pem_32and64_2005.txt:29736 (rldiclx),"
281:       " :6878 (ROTL32)")
282: print("%-18s %-20s %-20s %-48s %s" % ("row", "got", "want", "note", ""))
283: t0 = time.time()
284: disasm_checked = 0
285: disasm_ok = 0
286: 
287: # ============================================================ CONTROL SESSION ==
288: ctl_insns = [
289:     LI(9, 0x1234),                       # liveness
290:     NOP,                                 # seed-holds probe steps over this

FILE HEAD:regress/wdc_altoffset_probe.py
1: """wdcaltoffset -- RUNG-3 WITNESS AND DETECTOR.  Real guest instructions, real address
2: decode, real memory_rw, on an UNMODIFIED in-tree machine description (evbmips -e malta).
3: 
4: THE DEFECT.  DEVICE_ACCESS(wdc_altstatus) in src/devices/dev_wdc.c reads relative_addr
5: ZERO times, while dev_wdc_init registers its region TWO BYTES WIDE.  The durable keys are
6: grep anchors, not line numbers:
7: 
8:     grep -n 'DEVICE_ACCESS(wdc_altstatus)'   src/devices/dev_wdc.c
9:     grep -n '"wdc_altstatus",'               src/devices/dev_wdc.c
10: 
11:         memory_device_register(..., "wdc_altstatus", alt_status_addr, 2,
12:             dev_wdc_altstatus_access, d, DM_DEFAULT, NULL);
13: 
14:     offset 0  ->  0x3f6  Device Control      (write: nIEN, SRST, 4BIT)
15:     offset 1  ->  0x3f7  Drive Address Reg   READ-ONLY on real ATA hardware
16: 
17: Both offsets land in the same handler body, so a guest STORE to 0x3f7 is executed as a
18: store to Device Control.  Since #481 corrected the arm's bit to WDCTL_RST and wired in
19: wdc_new_command_reset(), that store now performs a full soft reset: write_in_progress is
20: cleared and the input ring is purged.  A write to a register the guest is not even
21: allowed to write aborts a live ATA WRITE SECTORS and destroys its staged bytes.
22: 
23: THE MACHINE IS NOT MODIFIED AND NO DEVICE IS ADDED.  malta carries a wdc through its own
24: committed path: machine_evbmips.c bus_pci_add(..., "piix4_ide") -> bus_pci.c
25: PCIINIT(piix4_ide), which does device_add(machine, "wdc addr=<isa_portbase+0x1f0> ...")
26: whenever an IDE image is attached; isa_portbase = 0x18000000.  Attaching a disk image is
27: ordinary operation, not a machine edit.
28: 
29:     wdc registers      physical 0x180001f0 + N  ->  KSEG1 0xffffffffb80001f0 + N
30:     wdc_altstatus      physical 0x180003f6      ->  KSEG1 0xffffffffb80003f6
31:     the read-only reg  physical 0x180003f7      ->  KSEG1 0xffffffffb80003f7
32: 
33: THE SHAPE OF THE WITNESS -- FOUR phases, IDENTICAL except for the address of one
34: store (phases 2 and 4 differ only in the VALUE stored).
35: 
36:     PHASE 1  poke 0x06 (nIEN|SRST) at 0x3f6, the REAL Device Control register.
37:              A legitimate soft reset.  BOTH builds must abort the armed write.
38:              This is the ACCEPT control the de-escalation clause demands: it proves the
39:              fix leg does not disable the register it is supposed to leave alone, and it
40:              proves the reset machinery this probe observes is alive.
41: 
42:     PHASE 2  poke the SAME 0x06 at 0x3f7, the READ-ONLY Drive Address Register.
43:              *** THE DEFECT.  Committed build: identical to phase 1.  Fix leg: nothing
44:              happens. ***
45: 
46:     PHASE 3  poke 0x02 (nIEN alone, WDCTL_RST clear) at 0x3f7.
47:              Neither build resets.  This is the discriminator that says the defect is
48:              the RESET BIT reaching a register that has none, rather than "any store to
49:              0x3f7 does something".
50: 
465:             return int(m[-1], 16)
466:         emu.drain(0.25)
467:     return None
468: 
469: 
470: def run_one(binary, tag, out):
471:     argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
472:             "-d", DISK_PREFIX + DISK, "0x%x:%s" % (BASE, RAWBIN)]
473:     out("  command   " + " ".join(argv))
474:     emu = Emu(argv)
475: 
476:     #  CONTROL 0 -- every hand-encoded word checked against the emulator's own
477:     #  disassembler.  Addresses are printed WITHOUT an 0x prefix.  The WORD is the
478:     #  authoritative check; the mnemonic is a rendering and is counted separately so a
479:     #  spelling this file guessed wrong cannot masquerade as a bad encoding.
480:     dis = emu.send("unassemble 0x%x 0x%x" % (BASE, BASE + len(prog) * 4), wait=3.0)
481:     seen = {}
482:     for line in dis.splitlines():
483:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
484:         if m:
485:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
486: 
487:     w_ok = m_ok = 0
488:     bad = []
489:     for i, (w, want_mn) in enumerate(prog):
490:         addr = (BASE + i * 4) & 0xffffffff
491:         hit = seen.get(addr)
492:         if hit is None:
493:             bad.append("  BAD  0x%08x  no disassembly line" % addr)
494:             continue
495:         gotw, gotmn = hit
496:         norm = " ".join(gotmn.replace("\t", " ").split())
497:         if gotw == "%08x" % w:
498:             w_ok += 1
499:         else:
500:             bad.append("  BAD  0x%08x  word %s vs %08x" % (addr, gotw, w))
501:         if norm.startswith(" ".join(want_mn.split())):
502:             m_ok += 1
503:         else:
504:             bad.append("  MNEMONIC 0x%08x  got %r want %r" % (addr, norm, want_mn))
505:     out("  CONTROL 0 encodings: %d of %d WORDS and %d of %d mnemonics agree with the"
506:         " emulator's own disassembler" % (w_ok, len(prog), m_ok, len(prog)))
507:     for l in bad:
508:         out(l)
509: 
510:     pc0 = reg(emu, "pc")
511:     out("  pc at entry = %s (want 0x%016x)"
512:         % (("0x%016x" % pc0) if pc0 is not None else "UNREADABLE", BASE))
513: 
514:     emu.send("breakpoint add 0x%x" % HALT_ADDR, wait=0.5)
515:     t = time.time()
516:     emu.send("continue", wait=1.0)
517:     deadline = time.time() + 120
518:     hit = False
519:     while time.time() < deadline:
520:         emu.drain(0.5)
521:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
522:         #  *** MATCH THE HIT LINE, NOT THE BARE WORD. ***  This read
523:         #  `if "BREAKPOINT" in <tail>.upper():` until 2026-08-30, and the
524:         #  transcript contains the probe's OWN echoed setup command,
525:         #  `breakpoint add 0x...`.  The check matched its own input and could
526:         #  never return False.  It was right by accident in every run where the
527:         #  guest parked, and silently wrong in the first run where it did not:
528:         #  a mutant returning 0 from the device handler raises EXCEPTION_DBE, the
529:         #  guest re-executes the faulting store forever, and the probe still
530:         #  reported `breakpoint reached: True` with every register reading ??.
531:         #  That was scored as a KILL -- a failed run counted as a table result.
532:         #  The emulator prints `BREAKPOINT: pc = 0x...` on a real hit.
533:         if "BREAKPOINT: PC" in tail.upper():
534:             hit = True
535:             break
536:     elapsed = time.time() - t
537:     out("  parked at the halt breakpoint: %s   (%.2f s)"
538:         % ("yes" if hit else
539:            "*** NO -- the guest never reached 0x%016x ***" % HALT_ADDR, elapsed))
540: 
541:     got = {}
542:     for nm in REGS:
543:         v = reg(emu, nm)
544:         got[nm] = None if v is None else (v & 0xff)
545: 
546:     whole = bytes(emu.buf).decode("latin1", "replace")
547:     diags = {n: whole.count(n) for n in
548:              ("write to DATA, but not", "reading too much", "wdc inbuf overrun",
549:               "wdc inbuf full", "write to ALT. CTRL", "DRIVE ADDRESS")}
550:     emu.close(os.path.join(OUTDIR, "transcript_%s.log" % tag))
551:     return got, w_ok, m_ok, hit, diags
552: 
553: 
554: def main():
555:     global RAWBIN
556:     os.makedirs(OUTDIR, exist_ok=True)
557:     RAWBIN = os.path.join(OUTDIR, "wdcaltoff.bin")
558:     with open(RAWBIN, "wb") as f:
