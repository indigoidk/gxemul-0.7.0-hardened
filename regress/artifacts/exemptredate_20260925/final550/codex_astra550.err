537: else
538: 	if out=$(python "$PWCHK" 2>&1); then
539: 		good "$(printf '%s' "$out" | grep -E 'PROBEWIRING_PASS')"
540: 		printf '%s\n' "$out" | grep -E '^  note ' | sed 's/^/        /'
541: 	else
542: 		bad "A COMMITTED DETECTOR IS RUN BY NO GATE (or an exemption expired):"
543: 		printf '%s\n' "$out" | grep -E 'PROBEWIRING_FAIL|^  FAIL ' | sed 's/^/          /'
