627:     out("-" * 94)
628:     for label, rn, wb, wf, gb, gf in changed:
629:         out("  %-56s %-4s  %02x -> %02x   %s"
630:             % (label, rn, gb if gb is not None else 0, gf if gf is not None else 0,

FILE HEAD:regress/wdc_altoffset_sig_probe.py
1: """wdcaltoffset TABLE C -- is m3's ESCAPE a real defect, or an equivalent mutant?
2: 
3:     python3 table_c.py <outdir> <cdrom-image> <tag>=<binary> [<tag>=<binary> ...]
4: 
5: *** A MUTANT THAT WILL NOT DIE IS A RESULT, NOT NOISE, and it has exactly three
6: explanations: the mutant is mis-built, the target is dead, or the row is mis-cut.  m3
7: escaped the shipped detector with a CLEAN SWEEP.  This table decides which. ***
8: 
9: CONTRACT -- vacuity-floor clause (e).  This probe pins ONE channel: the ATAPI
10: signature (cyl_lo/cyl_hi reading 0x14/0xeb), which the device returns only when
11: `cur_command == COMMAND_RESET` AND the attached image is a CD-ROM.  It catches
12: edits that let a store addressed at offset 1 set cur_command while sparing the
13: ring -- the shape the main detector passes at 36 of 36 row predictions.
14: 
15:   REQUIRES a ciR: rig.  The `c` is what makes diskimage_is_a_cdrom() true; on a
16:   plain disk this channel is DEAD and every row here is vacuous while still
17:   printing a verdict.  The L1/L2 controls exist to make that visible: if the
18:   legal 0x3f6 poke does not latch 14/eb, the run measured nothing.
19: 
20:   DOES NOT OBSERVE DRQ, the input ring, or any read of the alt region.
21: 
22: 
23: WHAT m3 IS.  It keeps the committed arm and guards only the destructive call:
24: 
25:         if (idata & WDCTL_RST) {
26:                 d->cur_command = COMMAND_RESET;
27:                 if (relative_addr == 0)              <-- m3 adds this
28:                         wdc_new_command_reset(d);
29:         }
30: 
31: so a guest store to the READ-ONLY 0x3f7 no longer purges the ring -- and STILL sets
32: d->cur_command = COMMAND_RESET.
33: 
34: WHY THE SHIPPED WITNESS CANNOT SEE IT.  Its two defect rows observe DRQ (s4) and the
35: input ring (s5).  Both are functions of write_in_progress and inbuf_head/tail, which
36: wdc_new_command_reset() clears and which m3 no longer reaches.  cur_command is not
37: cleared by that helper at all -- it is assigned by the CALLER -- so the shipped rows
38: are blind to it BY CONSTRUCTION, not by accident.
39: 
40: THE CHANNEL cur_command HAS.  dev_wdc.c reads COMMAND_RESET at exactly two sites, in
41: the wd_cyl_lo and wd_cyl_hi read arms, and both return the ATAPI signature 0xEB14 --
42: BUT ONLY WHEN diskimage_is_a_cdrom() is true for the selected drive.  The shipped
43: witness attaches a plain IDE disk, so on ITS rig the channel is dead.  That is a RIG
44: choice, not a property of the defect: attach the same bytes with the 'c' prefix and
45: the channel is live.
46: 
47:   L1  cyl_lo/cyl_hi round-trip 0x55/0x66 before the poke      (liveness; #481's idiom)
48:   L2  the 0x3f6 poke DOES latch the signature on every leg    (the channel is alive,
49:                                                                so a quiet 0x3f7 row is
50:                                                                a refusal and not a
51:                                                                dead path)
52:   D   the 0x3f7 poke latches the signature -- committed and m3 YES, fix NO
53: 
54: A row that shows 0x14/0xeb here is showing a guest write to a register the guest may
55: not write changing what two OTHER registers report.
56: """
57: import os
58: import sys
59: import time
60: 
61: OUTDIR = sys.argv[1]
62: DISK = sys.argv[2]
63: LEGS = [a.split("=", 1) for a in sys.argv[3:]]
64: 
65: HERE = os.path.dirname(os.path.abspath(__file__))
66: WIT = HERE                       # the COMMITTED detector, not the frozen witness copy
67: os.makedirs(OUTDIR, exist_ok=True)
68: sys.argv = [sys.argv[0]]
69: sys.path.insert(0, WIT)
70: import wdc_altoffset_probe as W            # noqa: E402  -- the shipped encoder + Emu
71: 
72: #  The `c` is not cosmetic: it is what makes diskimage_is_a_cdrom() true, and the
73: #  ATAPI signature channel is DEAD without it.  Set through the parameter rather
74: #  than by shimming run_one(), which is what the measuring seat had to do.
75: W.DISK_PREFIX = "ciR:"
76: 
77: W.prog[:] = []
78: t0, t1, t2 = W.t0, W.t1, W.t2
79: v0, v1, a0, a1, a2, a3 = W.v0, W.v1, W.a0, W.a1, W.a2, W.a3
80: s0, s1, s2, s3 = W.s0, W.s1, W.s2, W.s3
81: 
82: W.emit(W.lui(t0, W.WDC_HI), "lui t0,0xb800")
83: W.emit(W.ori(t0, t0, W.WDC_LO), "ori t0,t0,0x01f0")
84: W.emit(W.lui(t1, W.ALT_HI), "lui t1,0xb800")
85: W.emit(W.ori(t1, t1, W.ALT_LO), "ori t1,t1,0x03f6")
86: W.emit(W.lui(t2, W.RAM_HI), "lui t2,0x8020")
87: 
88: #  RAM liveness.
89: W.e_store(0x55, 0, t2)
90: W.e_lbu(v0, 0, t2)
91: 
92: #  L1 -- the cylinder registers round-trip while cur_command is NOT COMMAND_RESET.
93: W.e_store(0xa0, W.R_SDH, t0)
94: W.e_store(0x55, W.R_CYL_LO, t0)
95: W.e_store(0x66, W.R_CYL_HI, t0)
96: W.e_lbu(v1, W.R_CYL_LO, t0)        # want 55 on every leg
97: W.e_lbu(a0, W.R_CYL_HI, t0)        # want 66 on every leg
98: 
99: #  D -- poke 0x3f7 with the reset bit, then read the cylinder registers again.
100: W.e_store(W.SRST_POKE, 1, t1)
101: W.e_lbu(a1, W.R_CYL_LO, t0)        # committed/m3: 14   fix: 55
102: W.e_lbu(a2, W.R_CYL_HI, t0)        # committed/m3: eb   fix: 66
103: 
104: #  L2 -- rewrite the cylinder registers, then poke 0x3f6 (the LEGAL control write).
105: #  Every leg must latch the signature here.  Without this row a quiet D row could be a
106: #  dead channel rather than a declined write.
107: W.e_store(0x55, W.R_CYL_LO, t0)
108: W.e_store(0x66, W.R_CYL_HI, t0)
109: W.e_lbu(a3, W.R_CYL_LO, t0)        # want 14 on EVERY leg once 0x3f6 has been poked?
110: #  (read BEFORE the 0x3f6 poke on the fix leg the latch is still clear from D; on the
111: #  committed and m3 legs it is already set.  a3 is therefore recorded, not predicted --
112: #  the predicted row is s0/s1 below.)
113: W.e_store(W.SRST_POKE, 0, t1)
114: W.e_store(0x55, W.R_CYL_LO, t0)
115: W.e_store(0x66, W.R_CYL_HI, t0)
116: W.e_lbu(s0, W.R_CYL_LO, t0)        # want 14 on EVERY leg
117: W.e_lbu(s1, W.R_CYL_HI, t0)        # want eb on EVERY leg
118: 
119: HALT = len(W.prog)
120: W.emit(W.beq(W.zero, W.zero, -1), "b 0x")
121: W.emit(W.NOP, "nop")
122: W.HALT_ADDR = W.BASE + HALT * 4
123: W.REGS = ("v0", "v1", "a0", "a1", "a2", "a3", "s0", "s1")
124: 
125: W.DISK = DISK
126: W.OUTDIR = OUTDIR
127: W.RAWBIN = os.path.join(OUTDIR, "wdcaltoff_sig.bin")
128: with open(W.RAWBIN, "wb") as f:
129:     for w, _ in W.prog:
130:         f.write(bytes([w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff]))
131: 
132: #  the shipped run_one() hardcodes the iR: prefix; this table needs the CD-ROM prefix,
133: #  so the argv is built here and run_one's body is otherwise reused via a thin shim.
134: _orig = W.run_one
135: 
136: 
137: def run_cd(binary, tag, out):
138:     import re
139:     argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
