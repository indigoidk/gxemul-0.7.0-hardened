1: #!/usr/bin/env python3
2: """Assemble #550's COMMITTED versions into a staging mirror -- no write to the working tree.
3: 
4: usage: prep550.py <astra-verdict> <astra-ev-path>        (after the 07:01 Astra run)
5:        prep550.py --dry                                  (a test assembly: placeholders allowed, a dummy Astra entry)
6: 
7: Out: <records>/stage550/<repo-relative path> for every file the commit writes, plus stage550/MANIFEST.txt (md5s and
8: the diff-vs-HEAD numstat).  Every input is checked: HEAD must be f4f601c4; the files built from a scratchpad version
9: must be HEAD plus exactly the round's hunks (their md5s are pinned); the CHANGELOG block may carry no `<OWED`.
10: """
11: import hashlib
12: import io
13: import os
14: import subprocess
15: import sys
16: 
17: SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
18: SPD = r"C:\Users\User00\AppData\Local\Temp\claude\C--DocumentNoSnc-cc-GXEMUL\8e474f41-4d47-4c99-bf11-3406a84c4fcd\scratchpad"
19: REC = os.path.join(SPD, "records")
20: ST = os.path.join(REC, "stage550")
21: HEAD_WANT = "f4f601c4"
22: PINNED = {  # repo path -> (scratchpad source, md5)
23:     "tools/pipeline/check_probe_wiring.py": (os.path.join(SPD, "exempt550", "cpw_550v3_onHEAD.py"), "96efac51"),
24:     "tools/precommit_check.sh": (os.path.join(SPD, "exempt550", "pcc_550v2_onHEAD.sh"), "2892ed93"),
25:     "regress/gate_offline.sh": (os.path.join(SPD, "exempt550", "goff_550v3.sh"), "1ace834e"),
26: }
27: 
28: 
29: def git(*a, binary=False):
30:     r = subprocess.run(["git", "-C", SEC] + list(a), capture_output=True)
31:     if r.returncode:
32:         sys.exit("REFUSED: git %s: %s" % (" ".join(a), r.stderr.decode("utf-8", "replace")))
33:     return r.stdout if binary else r.stdout.decode("utf-8")
34: 
35: 
36: def md5(b):
37:     return hashlib.md5(b).hexdigest()[:8]
38: 
39: 
40: def put(rel, data):
41:     p = os.path.join(ST, *rel.split("/"))
42:     os.makedirs(os.path.dirname(p), exist_ok=True)
43:     open(p, "wb").write(data)
44:     return p
45: 
46: 
47: def main():
48:     dry = sys.argv[1:] == ["--dry"]
49:     if not dry and len(sys.argv) != 3:
50:         sys.exit(__doc__)
51:     head = git("rev-parse", "--short=8", "HEAD").strip()
52:     if head != HEAD_WANT:
53:         sys.exit("REFUSED: HEAD is %s, not %s -- re-derive the committed versions on the new HEAD" % (head, HEAD_WANT))
54:     if os.path.isdir(ST):
55:         for root, dirs, files in os.walk(ST, topdown=False):
56:             for f in files:
57:                 os.remove(os.path.join(root, f))
58:             for d in dirs:
59:                 os.rmdir(os.path.join(root, d))
60:     os.makedirs(ST, exist_ok=True)
61:     man = []
62: 
63:     # 1. the three scratchpad-built files, md5-pinned
64:     for rel, (src, want) in PINNED.items():
65:         b = open(src, "rb").read()
66:         if md5(b) != want:
67:             sys.exit("REFUSED: %s is %s, pinned %s" % (src, md5(b), want))
68:         put(rel, b)
69: 
70:     # 2. CHANGELOG.md: the #550 block on top of HEAD's
71:     blk = io.open(os.path.join(REC, "changelog550.md"), encoding="utf-8", newline="").read()
72:     if "<OWED" in blk and not dry:
73:         sys.exit("REFUSED: changelog550.md still carries an <OWED placeholder")
74:     cl = git("show", "HEAD:CHANGELOG.md", binary=True).decode("utf-8")
75:     put("CHANGELOG.md", (blk.rstrip("\n") + "\n\n" + cl).encode("utf-8"))
76: 
77:     # 3. OUTSTANDING_BUGS.md: #550's section appended to HEAD's
78:     ob = git("show", "HEAD:OUTSTANDING_BUGS.md", binary=True).decode("utf-8")
79:     sec = io.open(os.path.join(REC, "bugs550.md"), encoding="utf-8", newline="").read()
80:     put("OUTSTANDING_BUGS.md", (ob.rstrip("\n") + "\n" + sec).encode("utf-8"))
81: 
82:     # 4. pass2_ledger.tsv: HEAD's plus #548's pending receipt, taken from the working tree
83:     pl = git("show", "HEAD:regress/pass2_ledger.tsv", binary=True).decode("utf-8")
84:     work = io.open(os.path.join(SEC, "regress", "pass2_ledger.tsv"), encoding="utf-8", newline="").read()
85:     rec = [l for l in work.splitlines(True) if l.startswith("f4f601c4\t")]
86:     if len(rec) != 1 or "f4f601c4\t" in pl:
87:         sys.exit("REFUSED: want exactly one working f4f601c4 receipt absent from HEAD (%d)" % len(rec))
88:     put("regress/pass2_ledger.tsv", (pl if pl.endswith("\n") else pl + "\n").encode("utf-8") + rec[0].encode("utf-8"))
89: 
90:     # 5. ledger.json: HEAD's + records550 + the Astra entry; matrix.html regenerated from it
91:     lp = put("tools/pipeline/ledger.json", git("show", "HEAD:tools/pipeline/ledger.json", binary=True))
92:     env = dict(os.environ, LEDGER_PATH=lp)
93:     for args in (["records550"],
94:                  ["astra", "550", "DRY-RUN" if dry else sys.argv[1],
95:                   "regress/artifacts/exemptredate_20260925/final550/codex_astra550.txt" if dry else sys.argv[2]]):
96:         r = subprocess.run([sys.executable, os.path.join(REC, "ledger_550_551.py")] + args, env=env,
97:                            capture_output=True, text=True)
98:         if r.returncode:
99:             sys.exit("REFUSED: ledger %s: %s%s" % (args[0], r.stdout, r.stderr))
100:         man.append("ledger: " + r.stdout.strip())
101:     mp = os.path.join(ST, "tools", "pipeline", "matrix.html")
102:     r = subprocess.run([sys.executable, os.path.join(SEC, "tools", "pipeline", "gen_dashboard.py"), "--out", mp],
103:                        env=dict(os.environ, GXLEDGER=lp), capture_output=True, text=True)
104:     if r.returncode or not os.path.isfile(mp):
105:         sys.exit("REFUSED: gen_dashboard: %s%s" % (r.stdout, r.stderr))
106: 
107:     # 6. the manifest: md5 and a numstat against HEAD for every staged file
108:     for root, _, files in os.walk(ST):
109:         for f in sorted(files):
110:             p = os.path.join(root, f)
111:             rel = os.path.relpath(p, ST).replace(os.sep, "/")
112:             if rel == "MANIFEST.txt":
113:                 continue
114:             new = open(p, "rb").read()
115:             old = git("show", "HEAD:" + rel, binary=True)
116:             a, b = old.decode("utf-8", "replace").splitlines(), new.decode("utf-8", "replace").splitlines()
117:             import difflib
118:             d = list(difflib.unified_diff(a, b, lineterm="", n=0))
119:             plus = sum(1 for l in d if l.startswith("+") and not l.startswith("+++"))
120:             minus = sum(1 for l in d if l.startswith("-") and not l.startswith("---"))
121:             man.append("%s  %-40s +%d -%d  (HEAD %s)" % (md5(new), rel, plus, minus, md5(old)))
122:     man.insert(0, "# #550 staged committed versions -- %s -- HEAD %s%s" % (
123:         subprocess.run(["date", "+%F %T"], capture_output=True, text=True).stdout.strip(), head, "  (DRY)" if dry else ""))
124:     io.open(os.path.join(ST, "MANIFEST.txt"), "w", encoding="utf-8", newline="\n").write("\n".join(man) + "\n")
125:     print("\n".join(man))
126: 
127: 
128: if __name__ == "__main__":
129:     main()

FILE commit550.sh
1: #!/bin/bash
2: #  COMMIT #550 (exemptredate) -- LOCAL GIT ONLY, NEVER PUSH.  Owner ruling 2026-09-25: NOTHING is committed until the
3: #  GPT-6 Astra adjudicator has CONFIRMED.  Run prep550.py <verdict> <ev> first (it refuses on an <OWED placeholder),
4: #  read stage550/MANIFEST.txt, then:   bash commit550.sh --go
5: #  bash commit550.sh --precheck   runs the pre-commit hook in the EXACT commit state and then UNDOES everything (no
6: #                                 commit); a DRY stage is allowed there.
7: #
8: #  THE SWAP.  The working tree carries other units' uncommitted lines, and the hook reads the WORKING TREE:
9: #  * the committed versions (stage550/) are copied over the working files the commit writes, then staged BY NAME;
10: #  * NEUTRAL files -- other rounds' uncommitted gate scripts whose pins the hook's section U counts (#529's in
11: #    gate_arm.sh, #549's in gate_mips_folds.sh) -- read as HEAD's while the hook runs: 32 pinned probes against the
12: #    committed manifest's 30 would red U (measured 2026-09-25: precommit baseline, and section U's equality rule);
13: #  * after the commit every working file is REBUILT: three-way merges for the checker and precommit (tested clean), the
14: #    ledger re-derived from the backup plus this round's records, gate_offline.sh set to #551g (built on #550 v3), the
15: #    neutral files restored byte-for-byte, matrix.html regenerated.  If the hook FAILS, everything is UNDONE.
16: set -euo pipefail
17: MODE=${1:-}
18: [ "$MODE" = "--go" ] || [ "$MODE" = "--precheck" ] || { echo "usage: commit550.sh --go | --precheck"; exit 9; }
19: SEC=/c/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC
20: SP=/c/Users/User00/AppData/Local/Temp/claude/C--DocumentNoSnc-cc-GXEMUL/8e474f41-4d47-4c99-bf11-3406a84c4fcd/scratchpad
21: ST=$SP/records/stage550
22: BK=$SP/records/bk550_$(date +%Y%m%d_%H%M%S)
23: FILES="CHANGELOG.md OUTSTANDING_BUGS.md regress/gate_offline.sh regress/pass2_ledger.tsv tools/precommit_check.sh tools/pipeline/check_probe_wiring.py tools/pipeline/ledger.json tools/pipeline/matrix.html"
24: NEUTRAL="regress/gate_arm.sh regress/gate_mips_folds.sh"
25: ART=regress/artifacts/exemptredate_20260925
26: cd "$SEC"
27: 
28: # 0. preconditions
29: [ "$(git rev-parse --short=8 HEAD)" = f4f601c4 ] || { echo "REFUSED: HEAD moved"; exit 9; }
30: git diff --cached --quiet || { echo "REFUSED: the index is not empty"; exit 9; }
31: [ -f "$ST/MANIFEST.txt" ] || { echo "REFUSED: stage550 is missing"; exit 9; }
32: if [ "$MODE" = "--go" ]; then
33:     grep -q '(DRY)' "$ST/MANIFEST.txt" && { echo "REFUSED: stage550 is a DRY assembly"; exit 9; }
34:     grep -q '<OWED' "$ST/CHANGELOG.md" && { echo "REFUSED: an <OWED placeholder is staged"; exit 9; }
35:     [ -f "$SP/records/msg550.txt" ] || { echo "REFUSED: no commit message (msg550.txt)"; exit 9; }
36:     grep -q "<ASTRA" "$SP/records/msg550.txt" && { echo "REFUSED: the commit message still carries the <ASTRA placeholder"; exit 9; }
37:     for x in verdict ev; do [ -s "$SP/records/astra550.$x" ] || { echo "REFUSED: records/astra550.$x is missing or empty"; exit 9; }; done
38: fi
39: for f in $FILES; do [ -f "$ST/$f" ] || { echo "REFUSED: $f not staged"; exit 9; }; done
40: [ -z "$(git status --porcelain -- "$ART" | grep -v '^??')" ] || { echo "REFUSED: $ART has tracked changes"; exit 9; }
41: 
42: #  the run OVERWRITES these two and never restores them (they must equal the commit afterwards): refuse rather than
43: #  silently discard an edit made after the stage was assembled.  pass2_ledger.tsv must be exactly the staged one.
44: git diff --quiet HEAD -- CHANGELOG.md OUTSTANDING_BUGS.md || { echo "REFUSED: CHANGELOG.md/OUTSTANDING_BUGS.md carry working edits this run would overwrite"; exit 9; }
45: cmp -s regress/pass2_ledger.tsv "$ST/regress/pass2_ledger.tsv" || { echo "REFUSED: the working pass2_ledger.tsv is not the staged one"; exit 9; }
46: 
47: # 1. back up every working file the run touches
48: mkdir -p "$BK"
49: for f in $FILES $NEUTRAL; do mkdir -p "$BK/$(dirname "$f")"; cp -p "$f" "$BK/$f"; done
50: ( md5sum $FILES $NEUTRAL ) > "$BK/MD5.before"
51: echo "backed up to $BK"
52: 
53: undo() {   # unstage and put every backed-up working file back, verified
54:     git reset -q -- $FILES "$ART" 2>/dev/null || true
55:     for f in $FILES $NEUTRAL; do cp -p "$BK/$f" "$f"; done
56:     ( md5sum $FILES $NEUTRAL ) > "$BK/MD5.after"
57:     if diff -q "$BK/MD5.before" "$BK/MD5.after" > /dev/null; then echo "UNDONE: working tree restored, md5-verified";
58:     else echo "*** UNDO MISMATCH -- compare $BK/MD5.before and MD5.after BY HAND ***"; fi
59: }
60: 
61: # 2. the committed versions over the working files; the neutral files read as HEAD's
62: for f in $FILES; do cp "$ST/$f" "$f"; cmp -s "$ST/$f" "$f" || { echo "COPY FAILED $f"; undo; exit 9; }; done
63: for f in $NEUTRAL; do git show "HEAD:$f" > "$f"; done
64: 
65: # 3. stage BY NAME -- the files and the round's artifacts dir; never -A
66: git add -- $FILES "$ART"
67: if git diff --cached --name-only | grep -vE "^($(echo $FILES | tr ' ' '|')|$ART/)"; then echo "REFUSED: something else is staged"; undo; exit 9; fi
68: git diff --cached --stat | tail -2
69: 
70: if [ "$MODE" = "--precheck" ]; then
71:     set +e
72:     bash tools/precommit_check.sh > "$BK/precheck.out" 2>&1; rc=$?
73:     set -e
74:     grep -E '^  FAIL|PRECOMMIT_' "$BK/precheck.out" | head -20
75:     echo "PRECHECK rc=$rc (the hook's own output: $BK/precheck.out)"
76:     undo
77:     exit $rc
78: fi
79: 
80: # 4. commit (the hook runs; never --no-verify).  A failed hook UNDOES everything.
81: if ! git commit -F "$SP/records/msg550.txt"; then echo "COMMIT FAILED -- undoing"; undo; exit 9; fi
82: NEW=$(git rev-parse --short=8 HEAD)
83: echo "COMMITTED $NEW"
84: 
85: # 5. rebuild the working files
86: for f in $NEUTRAL; do cp -p "$BK/$f" "$f"; done
87: T=$(mktemp -d)
88: git merge-file -p "$ST/tools/pipeline/check_probe_wiring.py" "$SP/exempt550/cpw_550v2_onHEAD.py" "$BK/tools/pipeline/check_probe_wiring.py" > "$T/cpw" \
89:     || { echo "MERGE CONFLICT in check_probe_wiring.py -- working copy left as committed; backup in $BK"; exit 9; }
90: cp "$T/cpw" tools/pipeline/check_probe_wiring.py
91: git merge-file -p "$ST/tools/precommit_check.sh" "$SP/exempt550/pcc_550v2_onHEAD.sh" "$BK/tools/precommit_check.sh" > "$T/pcc" \
92:     || { echo "MERGE CONFLICT in precommit_check.sh -- backup in $BK"; exit 9; }
93: cp "$T/pcc" tools/precommit_check.sh
94: cp "$SP/wdc551/goff_551g.sh" regress/gate_offline.sh
95: cp "$BK/tools/pipeline/ledger.json" "$T/ledger.json"
96: LEDGER_PATH="$(cygpath -w "$T/ledger.json")" python "$SP/records/ledger_550_551.py" records550
97: LEDGER_PATH="$(cygpath -w "$T/ledger.json")" python "$SP/records/ledger_550_551.py" astra 550 "$(cat "$SP/records/astra550.verdict")" "$(cat "$SP/records/astra550.ev")"
98: cp "$T/ledger.json" tools/pipeline/ledger.json
99: python tools/pipeline/gen_dashboard.py
100: 
101: # 6. verify: the docs files equal the commit; the neutral files are back; the merged files differ only by others' lines
102: for f in CHANGELOG.md OUTSTANDING_BUGS.md regress/pass2_ledger.tsv; do git diff --quiet HEAD -- "$f" || { echo "UNEXPECTED DIFF $f"; exit 9; }; done
103: for f in $NEUTRAL; do cmp -s "$BK/$f" "$f" || { echo "NEUTRAL FILE NOT RESTORED $f"; exit 9; }; done
104: git diff --numstat HEAD -- tools/pipeline/check_probe_wiring.py tools/precommit_check.sh regress/gate_offline.sh tools/pipeline/ledger.json
105: echo "COMMIT550_DONE $NEW"

