  108: 	int no_exceptions = flags & FLAG_NOEXCEPTIONS;
  109: 	int exception_type = instr? M88K_EXCEPTION_INSTRUCTION_ACCESS
  110: 	    : M88K_EXCEPTION_DATA_ACCESS;
