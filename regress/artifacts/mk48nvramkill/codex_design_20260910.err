   22:  *  HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
   23:  *  LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
   24:  *  OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
   25:  *  SUCH DAMAGE.
   26:  *   
   27:  *
   28:  *  COMMENT: RICOH RS5C313 Real Time Clock
   29:  *
   30:  *  The RS5C313 has 16 registers, see rs5c313reg.h for details. These registers
   31:  *  are addressed at byte offsets.
   32:  *
   33:  *  Note: The only use for this device so far is in the Landisk, connected to
   34:  *        the SH4 SCI pins. In the Landisk machine, the RS5C313 is placed at
   35:  *        a fake (high) address in memory.
   36:  */
   37: 
   38: #include <stdio.h>
   39: #include <stdlib.h>
   40: #include <string.h>
   41: #include <time.h>
   42: 
   43: #include "cpu.h"
   44: #include "device.h"
   45: #include "machine.h"
   46: #include "memory.h"
   47: #include "misc.h"
   48: 
   49: #include "thirdparty/rs5c313reg.h"
   50: 
   51: 
   52: #define	DEV_RS5C313_LENGTH	16
   53: 
   54: struct rs5c313_data {
   55: 	uint8_t		reg[DEV_RS5C313_LENGTH];
   56: };
   57: 
   58: 
   59: /*
   60:  *  rs5c313_update_time():
   61:  *
   62:  *  Set the RS5C313 registers to correspond to the host's clock.
   63:  */
   64: static void rs5c313_update_time(struct rs5c313_data *d)
   65: {
   66: 	struct tm *tmp;
   67: 	time_t timet;
   68: 
   69: 	timet = time(NULL);
   70: 	tmp = gmtime(&timet);
   71: 
   72: 	d->reg[RS5C313_SEC1]   = tmp->tm_sec % 10;
   73: 	d->reg[RS5C313_SEC10]  = tmp->tm_sec / 10;
   74: 	d->reg[RS5C313_MIN1]   = tmp->tm_min % 10;
   75: 	d->reg[RS5C313_MIN10]  = tmp->tm_min / 10;
   76: 	d->reg[RS5C313_HOUR1]  = tmp->tm_hour % 10;
   77: 	d->reg[RS5C313_HOUR10] = tmp->tm_hour / 10;
   78: 
   79: 	/*  WDAY. Zero-based. TODO: Is this correct?  */
   80: 	d->reg[RS5C313_WDAY]   = tmp->tm_wday;
   81: 
   82: 	d->reg[RS5C313_DAY1]   = tmp->tm_mday % 10;
   83: 	d->reg[RS5C313_DAY10]  = tmp->tm_mday / 10;
   84: 	d->reg[RS5C313_MON1]   = (tmp->tm_mon + 1) % 10;
   85: 	d->reg[RS5C313_MON10]  = (tmp->tm_mon + 1) / 10;
   86: 	d->reg[RS5C313_YEAR1]  = tmp->tm_year % 10;
   87: 	d->reg[RS5C313_YEAR10] = (tmp->tm_year / 10) % 10;
   88: }
   89: 
   90: 
   91: /*
   92:  *  #404: THE GUEST CANNOT SET THIS CLOCK, AND THAT IS RECORDED HERE RATHER THAN
   93:  *  FIXED. Measured against this function, not inferred.
   94:  *
   95:  *  rs5c313_update_time() below runs before the read/write dispatch, so every
   96:  *  access rewrites all thirteen time registers from the host. A write does store
   97:  *  its own nibble afterwards, but the other twelve were just overwritten -- a
   98:  *  guest sets the clock one register at a time, so each write reverts the twelve
   99:  *  it is not touching. Measured: one write of 9 to SEC1 from an all-zero file
  100:  *  moved 12 of 12 non-target time registers to host digits. And a read refreshes
  101:  *  first, so a readback at the SAME INSTANT returns host time, not the written
  102:  *  value. The survivors are exactly TINT, CTRL and TEST.
  103:  *
  104:  *  *** WHAT THAT MEANS IS NARROWER THAN IT LOOKS, AND THE MEASUREMENT MATTERS. ***
  105:  *  A variant that ignores writes to all thirteen clock registers outright is
  106:  *  GUEST-INDISTINGUISHABLE from what ships today. So is one that refreshes only
  107:  *  on reads -- 0 mismatches in 248,581 reads. This is therefore not corruption
  108:  *  of a value the guest could otherwise rely on; it is a MISSING FEATURE. The
  109:  *  clock is not settable, and never has been.
  110:  *
  111:  *  A correct fix needs an offset model (host time plus a guest-applied delta),
  112:  *  reached by elimination rather than by preference. It is not attempted, for a
  113:  *  reason that is measured rather than cautious:
  114:  *
  115:  *    - rs5c313reg.h:64-67 names CTRL_BSY/CTRL_ADJ and CTRL_XSTP/CTRL_WTEN, which
  116:  *      look like a hold/busy protocol this device ignores entirely. But the
  117:  *      header supplies BIT NAMES ONLY. It does not say that WTEN gates writes,
  118:  *      what event commits a staged time, or whether the counter holds meanwhile.
  119:  *    - The house pattern argues AGAINST guessing here, not for it.
  120:  *      dev_mk48txx.c:98-106 gates on a latch that ITS OWN header documents
  121:  *      (mk48txxreg.h:101, "freeze clock"). dev_mc146818.c:532-540 does the same
  122:  *      with MC_REGB_SET. rs5c313reg.h carries no equivalent statement, so the
  123:  *      analogy would be to a different chip.
  124:  *    - AND A WRONG GUESS CAN REGRESS A BOOTING MACHINE: implementing
  125:  *      "hold while WTEN is set" is guest-DISTINGUISHABLE from today, 64,687
  126:  *      divergent reads in a differential. This is not a free improvement.  136:  *  WDAY is left exactly as it is. Both sibling RTCs use tm_wday + 1  152: 	rs5c313_update_time(d);
  153: 
  154: 	/*  Generic register read/write:  */
  155: 	if (writeflag == MEM_WRITE) {
  156: 		idata = memory_readmax64(cpu, data, len);
  157: 		d->reg[relative_addr] = idata & 0x0f;
  158: 	} else {
  159: 		odata = d->reg[relative_addr] & 0x0f;
  160: 		memory_writemax64(cpu, data, len, odata);
  161: 	}
  162: 
  163: 	return 1;
  164: }
  165: 
  166: 
  167: DEVINIT(rs5c313)
  168: {
  169: 	struct rs5c313_data *d;
  170: 
  171: 	CHECK_ALLOCATION(d = (struct rs5c313_data *) malloc(sizeof(struct rs5c313_data)));
  172: 	memset(d, 0, sizeof(struct rs5c313_data));
  173: 
  174: 	/*  Default values:  */
  175: 	d->reg[RS5C313_CTRL] = CTRL_24H;
  176: 
  177: 	memory_device_register(devinit->machine->memory, devinit->name,
  178: 	    devinit->addr, DEV_RS5C313_LENGTH,
  179: 	    dev_rs5c313_access, (void *)d, DM_DEFAULT, NULL);
  180: 
  181: 	return 1;
  182: }
