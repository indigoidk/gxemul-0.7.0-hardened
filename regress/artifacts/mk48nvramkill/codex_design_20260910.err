  102: 				/*  Switching the read bit from 0 to 1 causes
  103: 				    registers to be "froozen". In the emulator,
  104: 				    simply updating them with data from the
  105: 				    host should be good enough.  */
  106: 				mk48txx_update_regs(d);
  107: 			}
  108: 			d->reg[relative_addr] = idata;
