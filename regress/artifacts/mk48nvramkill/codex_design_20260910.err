   42: /*
   43:  * Mostek MK48Txx clocks.
   44:  *
   45:  * The MK48T02 has 2KB of non-volatile memory. The time-of-day clock
   46:  * registers start at offset 0x7f8.
   47:  *
   48:  * The MK48T08 and MK48T18 have 8KB of non-volatile memory
   49:  *
   50:  * The MK48T59 also has 8KB of non-volatile memory but in addition it
   51:  * has a battery low detection bit and a power supply wakeup alarm for
   52:  * power management.  It's at offset 0x1ff0 in the NVRAM.
   53:  */
   54: 
   55: /*
   56:  * Mostek MK48TXX register definitions
   57:  */
   58: 
   59: /*
   60:  * The first bank of eight registers at offset (nvramsz - 16) is
   61:  * available only on more recent (which??) MK48Txx models.
   62:  */
   63: #define MK48TXX_IFLAGS	0	/* flags */
   64: /*			1	   unused on MK48T59 */
   65: #define MK48TXX_IASEC	2	/* alarm seconds (0..59; BCD) */
   66: #define MK48TXX_IAMIN	3	/* alarm minutes (0..59; BCD) */
   67: #define MK48TXX_IAHOUR	4	/* alarm hour (0..23; BCD) */
   68: #define MK48TXX_IADAY	5	/* alarm day (1..31; BCD) */
   69: #define MK48TXX_IINTR	6	/* interrupts */
   70: #define MK48TXX_IWDOG	7	/* watchdog */
   71: #define MK48TXX_ICSR	8	/* control register */
   72: #define MK48TXX_ISEC	9	/* seconds (0..59; BCD) */
   73: #define MK48TXX_IMIN	10	/* minutes (0..59; BCD) */
   74: #define MK48TXX_IHOUR	11	/* hour (0..23; BCD) */
   75: #define MK48TXX_IWDAY	12	/* weekday (1..7) */
   76: #define MK48TXX_IDAY	13	/* day in month (1..31; BCD) */
   77: #define MK48TXX_IMON	14	/* month (1..12; BCD) */
   78: #define MK48TXX_IYEAR	15	/* year (0..99; BCD) */
   79: 
   80: /* Bits in the flags register */
   81: #define MK48TXX_FLAGS_WDF	0x80	/* watchdog flag */
   82: #define MK48TXX_FLAGS_ALARM	0x40	/* alarm flag */
   83: #define MK48TXX_FLAGS_BATTLOW	0x10	/* battery low */
   84: 
   85: /* Bits in the interrupt register */
   86: #define MK48TXX_INTR_AFE	0x80	/* alarm flag enable */
   87: #define MK48TXX_INTR_ABE	0x20	/* alarm in battery backup enable */
   88: 
   89: /* Bits in the watchdog register */
   90: #define MK48TXX_WDOG_WDS	0x80	/* watchdog steering */
   91: #define MK48TXX_WDOG_BMB_MASK	0x7c	/* watchdog multiplier bits */
   92: #define MK48TXX_WDOG_BMB_SHIFT	2
   93: #define MK48TXX_WDOG_RES_MASK	0x03	/* watchdog resolution bits */
   94: #define MK48TXX_WDOG_RES_1_16S	0x00	/*   1/16 seconds */
   95: #define MK48TXX_WDOG_RES_1_4S	0x01	/*   1/4 seconds */
   96: #define MK48TXX_WDOG_RES_1S  	0x02	/*   1 second */
   97: #define MK48TXX_WDOG_RES_4S	0x03	/*   4 seconds */
   98: 
   99: /* Bits in the control register */
  100: #define MK48TXX_CSR_WRITE	0x80	/* want to write */
  101: #define MK48TXX_CSR_READ	0x40	/* want to read (freeze clock) */
  102: 
  103: /* Bit in the weekday register */
  104: #define MK48TXX_WDAY_FT		0x40	/* freq test: toggle sec[0] at 512Hz */
  105: 					/* next two are on MK48T59 only */
  106: #define MK48TXX_WDAY_CEB	0x20	/* century enable */
  107: #define MK48TXX_WDAY_CB		0x10	/* century bit */
  108: 
  109: /* Bit in the seconds register */
  110: #define MK48TXX_SEC_STOP	0x80	/* stop the oscillator */
  111: 
  112: #define MK48T02_CLKSZ		2048
  113: #define MK48T02_CLKOFF		0x7f0
  114: 
  115: #define MK48T08_CLKSZ		8192
  116: #define MK48T08_CLKOFF		0x1ff0
  117: 
  118: #define MK48T18_CLKSZ		8192
