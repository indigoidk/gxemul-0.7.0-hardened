e_type); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 169, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "if (d->cur_output_offset < 2) { | fatal(\"[ adb: WEIRD output length: %i ]\\n\", | d->cur_output_offset); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 203, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "/*  ADBLISTEN:  */ | if ((d->output_buf[1] >> 4) != d->kbd_dev) { | fatal(\"[ adb: ADBLISTEN not to kbd ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 208, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "if (d->output_buf[3] != 0xfe || | (d->output_buf[2] & 0xf0) != 0x60) { | fatal(\"[ adb: unknown ADBLISTEN ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 214, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "d->kbd_dev = new_dev_pos; | } else { | fatal(\"[ adb: unknown ADB command? ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 241, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "d->output_buf[1] == 0x11) { | /*  Reboot.  */ | fatal(\"[ adb: reboot. TODO: make this nicer ]\\n\"); | exit(1); | } else {"}, {"p": "src/devices/dev_adb.c", "n": 244, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "exit(1); | } else { | fatal(\"[ adb: UNIMPLEMENTED PRAM/RTC command ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 250, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": " | default:fatal(\"[ adb: UNKNOWN command type 0x%02x ]\\n\", | d->output_buf[0]); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 428, "fn": "} DEVICE_ACCESS(adb)", "context": "fatal(\"[ adb: WRITE to UNIMPLEMENTED %s: 0x%x ]\\n\", | via_regname[relative_addr >> VIA_REG_SHIFT], | (int)idata); | exit(1); | }"}, {"p": "src/devices/dev_algor.c", "n": 211, "fn": "} DEVINIT(algor)", "context": "d->base_addr = devinit->addr; | if (devinit->addr != 0x1ff00000) { | fatal(\"The Algor base address should be 0x1ff00000.\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_bebox.c", "n": 213, "fn": "} DEVINIT(bebox)", "context": "if (i >= machine->ncpus) { | fatal(\"FATAL ERROR: The machine seem to be \" | \"lacking cpu nr %i (0-based)\\n\", i); | exit(1); | }"}, {"p": "src/devices/dev_clmpcc.c", "n": 164, "fn": "} DEVICE_ACCESS(clmpcc)", "context": "} else { | fatal(\"clmpcc: unimplemented STCR byte \" | \"0x%02x\\n\", (int) idata); | exit(1); | }"}, {"p": "src/devices/dev_clmpcc.c", "n": 252, "fn": "} DEVICE_ACCESS(clmpcc)", "context": "else | fatal(\"[ clmpcc: unimplemented WRITE to offset 0x%x: \" | \"0x%x ]\\n\", (int)relative_addr, (int)idata); | exit(1); | }"}, {"p": "src/devices/dev_cons.c", "n": 80, "fn": "} DEVICE_ACCESS(cons)", "context": "return 1;  */ | /*  TODO: this doesn't work yet. for now, let's | simply use exit()  */ | exit(0); | }"}, {"p": "src/devices/dev_cpc700.c", "n": 234, "fn": "} DEVINIT(cpc700)", "context": " | default:fatal(\"!\\n! WARNING: cpc700 for non-implemented machine\" | \" type\\n!\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_dreamcast_g2.c", "n": 164, "fn": "#define\tEXTDMA_STAT_STATUS\t0xcc DEVICE_ACCESS(dreamcast_g2_extdma)", "context": "\" CHAN_ENABLE = 0x%08x ]\\n\", cha