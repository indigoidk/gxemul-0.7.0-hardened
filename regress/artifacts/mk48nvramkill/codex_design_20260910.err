, "n": 333, "fn": "*  Intel 80321 coprocessor 6. */ void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "else { | cpu->cd.arm.i80321_isrc = cpu->cd.arm.r[rd]; | fatal(\"TODO: XScale int ack?\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 419, "fn": "*  Intel 80321 coprocessor 6. */ void arm_coproc_i80321_6(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "unknown: | fatal(\"arm_coproc_i80321_6: unimplemented opcode1=%i opcode2=%i crn=\" | \"%i crm=%i rd=%i l=%i)\\n\", opcode1, opcode2, crn, crm, rd, l_bit); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_coproc.c", "n": 530, "fn": "*  XScale coprocessor 14, Performance Monitoring Unit. */ void arm_coproc_xscale_14(struct cpu *cpu, int opcode1, int opcode2, int l_bit, int crn, int crm, int rd)", "context": "fatal(\"arm_coproc_xscale_14: unimplemented opcode1=%i opcode2=\" | \"%i crn=%i crm=%i rd=%i l=%i)\\n\", opcode1, opcode2, crn, | crm, rd, l_bit); | exit(1); | }"}, {"p": "src/cpus/cpu_arm_instr.c", "n": 72, "fn": "* *  uniq -c bdt_statistics.txt|sort -nr|head -256|cut -f 2 > cpu_arm_multi.txt */ static void update_bdt_statistics(uint32_t iw)", "context": "f = fopen(\"bdt_statistics.txt\", \"w\"); | if (f == NULL) { | fprintf(stderr, \"update_bdt_statistics(): :-(\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 732, "fn": "* *  Generic case. See DYNTRANS_PC_TO_POINTERS_FUNC below. */ void DYNTRANS_PC_TO_POINTERS_GENERIC(struct cpu *cpu)", "context": "if (!ok) { | fatal(\"FATAL: could not find physical\" | \" address of the exception handler?\"); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1079, "fn": "} #ifdef BUGHUNT", "context": "if (x1 != x1b && | l2 == cpu->cd.DYNTRANS_ARCH.l1_64[x1b]) { | fatal(\"L2 reuse: %p\\n\", l2); | exit(1); | }"}, {"p": "src/cpus/cpu_dyntrans.c", "n": 1092, "fn": "} } /*  Count how many pages are actually in use:  */", "context": "n++; | i