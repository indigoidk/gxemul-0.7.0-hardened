.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 2169, "fn": "* *  MIPS TLB write random (tlbwr) and write indexed (tlbwi) instructions. */ void coproc_tlbwri(struct cpu *cpu, int randomflag)", "context": "if (cp->tlbs[index].lo0 & ENTRYLO_V || | cp->tlbs[index].lo1 & ENTRYLO_V) { | fatal(\"1KB pages don't work with dyntrans.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_coproc.c", "n": 2489, "fn": "*  TODO:  This is a mess and should be restructured (again). */ void coproc_function(struct cpu *cpu, struct mips_coproc *cp, int cpnr, uint32_t function, int unassemble_only, int running)", "context": "if (!unassemble_only) { | fatal(\"FATAL INTERNAL ERROR: Should be implemented\" | \" with dyntrans instead.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_instr.c", "n": 123, "fn": "/* *  invalid:  For catching bugs. */ X(invalid)", "context": "fatal(\"FATAL ERROR: An internal error occured in the MIPS\" | \" dyntrans code. Please contact the author with detailed\" | \" repro steps on how to trigger this bug.\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_instr.c", "n": 2650, "fn": "/* *  promemul:  PROM software emulation. */ X(promemul)", "context": "res = yamon_emul(cpu); | break; | default:fatal(\"TODO: Unimplemented machine type for PROM magic trap\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_mips_instr.c", "n": 3798, "fn": "} X(end_of_page2)", "context": "return; |  | fatal(\"end_of_page2: fatal error, we're in a delay slot\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_ppc_instr.c", "n": 244, "fn": "/* *  invalid:  To catch bugs. */ X(invalid)", "context": "X(invalid) | { | fatal(\"PPC: invalid(): INTERNAL ERROR\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_ppc_instr.c", "n": 2307, "fn": "* *  arg[0] = copy of the instruction word. */ X(llsc)", "context": "if (load) { | if (rc) { | fatal(\"ll: rc-bit set?\\n\"); | exit(1); | }"}, {"p": "src/cpus/cpu_ppc_instr.c", "n": 2333, "fn": "* *  arg[0] = copy of the instruction word. */ X(llsc)", "c