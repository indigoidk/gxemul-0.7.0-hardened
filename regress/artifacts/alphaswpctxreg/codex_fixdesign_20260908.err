 232: static void alpha_print_imm16_disp(int imm, int rb)
 233: {
 234: 	imm = (int16_t)imm;
 235: 
 236: 	if (imm < 0) {
 237: 		debug("-");
 238: 		imm = -imm;
 239: 	}
 240: 	if (imm <= 256)
 241: 		debug("%i", imm);
 242: 	else
 243: 		debug("0x%x", imm);
 244: 	if (rb != ALPHA_ZERO)
 245: 		debug("(%s)", alpha_regname[rb]);
 246: }
