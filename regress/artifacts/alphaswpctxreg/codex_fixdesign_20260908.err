 215: void alpha_irq_interrupt_assert(struct interrupt *interrupt)
 216: {
 217: 	struct cpu *cpu = (struct cpu *) interrupt->extra;
 218: 	cpu->cd.alpha.irq_asserted = 1;
 219: }
 220: void alpha_irq_interrupt_deassert(struct interrupt *interrupt)
 221: {
 222: 	struct cpu *cpu = (struct cpu *) interrupt->extra;
 223: 	cpu->cd.alpha.irq_asserted = 0;
 224: }
