1641: /*
1642:  *  debugger_cmd_reg():
1643:  */
1644: static void debugger_cmd_reg(struct machine *m, char *args)
1645: {
1646: 	int cpuid = debugger_cur_cpu, coprocnr = -1;
1647: 	int gprs, coprocs;
1648: 	char *p;
1649: 
1650: 	/*  [cpuid][,c]  */
1651: 	if (args[0] != '\0') {
1652: 		if (args[0] != ',') {
1653: 			cpuid = strtoull(args, NULL, 0);
1654: 			if (cpuid < 0 || cpuid >= m->ncpus) {
1655: 				printf("cpu%i doesn't exist.\n", cpuid);
1656: 				return;
1657: 			}
1658: 		}
1659: 		p = strchr(args, ',');
1660: 		if (p != NULL) {
1661: 			coprocnr = atoi(p + 1);
1662: 			if (coprocnr < 0 || coprocnr >= 4) {
1663: 				printf("Invalid coprocessor number.\n");
1664: 				return;
1665: 			}
1666: 		}
1667: 	}
1668: 
1669: 	gprs = (coprocnr == -1)? 1 : 0;
1670: 	coprocs = (coprocnr == -1)? 0x0 : (1 << coprocnr);
1671: 
1672: 	cpu_register_dump(m, m->cpus[cpuid], gprs, coprocs);
1673: }
