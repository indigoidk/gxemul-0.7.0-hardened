1064: 		 *  already in this tree -- `trapa` in a delay slot, and the
1065: 		 *  FPU-availability macro when the FPU is disabled and
1066: 		 *  cpu->delay_slot is set -- but neither had a case here, so
1067: 		 *  each fell to the default below and called exit(). A guest
1068: 		 *  putting a trapa or an FP instruction in a branch delay slot
1069: 		 *  killed the host process outright; both were measured doing
1070: 		 *  exactly that. They take the same general vector as their
1071: 		 *  non-slot counterparts, which is already set up above.
1072: 		 */
1073: 		break;
1074: 
1075: 	case EXPEVT_ADDR_ERR_LD:
1076: 	case EXPEVT_ADDR_ERR_ST:
1077: 		/*  CPU address error (misaligned access). Sets TEA to
1078: 		    the faulting address; uses the general exception
1079: 		    vector (VBR + 0x100) already set above.  */
1080: 		cpu->cd.sh.tea = vaddr;
1081: 		break;
1082: 
1083: 	default:fatal("sh_exception(): exception 0x%x is not yet "
1084: 		    "implemented.\n", expevt);
1085: 		exit(1);
1086: 	}
1087: 
1088: 	sh_pc_to_pointers(cpu);
1089: }
