399: 		cmmu->reg[CMMU_PFAR] = 0;
400: 		break;
401: 
402: 	case CMMU_PFSR_SUPER:
403: 	case CMMU_PFSR_SFAULT:
404: 	case CMMU_PFSR_PFAULT:
405: 		cmmu->reg[CMMU_PFAR] = pfar;
