90: 	    NO-OP.  ALPHA HAS NO INTERRUPT DELIVERY AT ALL. ***  `cd.alpha.irq_asserted'
91: 	    is written by `cpu_alpha.c' and read NOWHERE.  `cpu_dyntrans.c' turns a
92: 	    pending interrupt into a delivered one for FIVE architectures -- ARM and
93: 	    M88K and PPC through their own `irq_asserted', MIPS through the COP0
94: 	    exception model, and SH through `int_to_assert' -- and ALPHA IS ABSENT
95: 	    FROM THAT LIST.  (An earlier draft of this comment said "ARM, M88K and
96: 	    PPC only": that enumeration was made by grepping for `irq_asserted', which
97: 	    is a CORRELATE of delivering rather than the property, and it missed the
98: 	    two architectures that deliver by another mechanism.  The Alpha conclusion
99: 	    is unchanged and is strengthened -- it is the outlier among five, not
100: 	    three.)  Calling `cpu_interrupt()' here would set
101: 	    a field nothing consumes.  Implementing delivery is a SUBSYSTEM -- the
102: 	    dyntrans dispatch, the PALcode entry and the IPL check -- and is its own
103: 	    round, not this one.
104: 
105: 	    So the disposition is DECLINE plus a bounded announce, and what it buys is
106: 	    stated narrowly on purpose: THE HOST STOPS DYING.  Interrupts do not start
107: 	    working; they were never delivered on this architecture and still are not.
108: 
109: 	    The latch is PER-INSTANCE (`interrupt->extra'), not function-static: a
110: 	    function-static bit would let one guest access to one device instance
111: 	    silence the diagnostic for every other instance, which is a class already
112: 	    filed against this tree.  */
113: 	if (d != NULL && !(d->warned & (1u << LCA_W_IRQ_ASSERT))) {	/*  #516  */
114: 		d->warned |= 1u << LCA_W_IRQ_ASSERT;
115: 		fatal("[ lca: ISA interrupt assert not implemented (Alpha has no "
116: 		    "interrupt delivery); ignored  (once) ]\n");
117: 	}
118: }
119: 
120: 
121: /*
122:  *  lca_interrupt_deassert():
123:  *
124:  *  Line 0 = ISA interrupt.
125:  */
126: void lca_interrupt_deassert(struct interrupt *interrupt)
127: {
128: 	struct lca_data *d = (struct lca_data *) interrupt->extra;	/*  #516  */
129: 
130: 	/*  #516: the sibling of lca_interrupt_assert() above, same reasoning.  A
131: 	    SEPARATE latch bit, so the two are distinguishable: a driver normally
132: 	    reaches both within one interrupt cycle, and one shared bit would report
133: 	    whichever arrived first and hide the other entirely.  */
134: 	if (d != NULL && !(d->warned & (1u << LCA_W_IRQ_DEASSERT))) {	/*  #516  */
135: 		d->warned |= 1u << LCA_W_IRQ_DEASSERT;
136: 		fatal("[ lca: ISA interrupt deassert not implemented (Alpha has no "
137: 		    "interrupt delivery); ignored  (once) ]\n");
138: 	}
139: }
