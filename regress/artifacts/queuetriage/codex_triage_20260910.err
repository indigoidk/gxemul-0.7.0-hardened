199: 		d->add_to_rx_queue(d->add_data, MOUSE_START_FRAME +
200: 		    MOUSE_X_SIGN*xsign + MOUSE_Y_SIGN*ysign +
201: 		    (mouse_buttons & 7), DCMOUSE_PORT);
202: 		d->add_to_rx_queue(d->add_data, xdelta, DCMOUSE_PORT);
203: 		d->add_to_rx_queue(d->add_data, ydelta, DCMOUSE_PORT);
204: 		break;
205: 
206: 	default:
207: 		/*  TODO:  prompt mode and perhaps more stuff  */
208: 		fatal("[ lk201: mouse mode 0x%02x unknown: TODO ]\n",
209: 		    d->mouse_mode);
210: 		exit(1);
211: 	}
212: 
213: 	return 1;
214: }

