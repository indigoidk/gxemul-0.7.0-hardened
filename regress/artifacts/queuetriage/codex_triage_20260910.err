406: void pcctwo_interrupt_common(struct interrupt *interrupt, int assert)
407: {
408: 	struct pcc2_data *d = (struct pcc2_data *) interrupt->extra;
409: 
410: 	switch (interrupt->line) {
411: 
412: 	case PCC2V_SCSI:
413: 		if (assert)
414: 			d->pcctwo_reg[PCCTWO_SCSIICR] |= PCC2_IRQ_INT;
415: 		else
416: 			d->pcctwo_reg[PCCTWO_SCSIICR] &= ~PCC2_IRQ_INT;
417: 		break;
418: 
419: 	case PCC2V_SCC_TX:
420: 		if (assert)
421: 			d->pcctwo_reg[PCCTWO_SCCTX] |= PCC2_IRQ_INT;
422: 		else
423: 			d->pcctwo_reg[PCCTWO_SCCTX] &= ~PCC2_IRQ_INT;
424: 		break;
425: 
426: 	case PCC2V_SCC_RX:
427: 		if (assert)
428: 			d->pcctwo_reg[PCCTWO_SCCRX] |= PCC2_IRQ_INT;
429: 		else
430: 			d->pcctwo_reg[PCCTWO_SCCRX] &= ~PCC2_IRQ_INT;
431: 		break;
432: 
433: 	default:fatal("[ pcctwo_interrupt_common: TODO: line = %i ]\n",
434: 		    interrupt->line);
435: 		exit(1);
436: 	}
