1027: 	case EXPEVT_TLB_PROT_LD:
1028: 	case EXPEVT_TLB_PROT_ST:
1029: 	case EXPEVT_TLB_MOD:
1030: 		cpu->cd.sh.tea = vaddr;
1031: 		cpu->cd.sh.pteh &= ~SH4_PTEH_VPN_MASK;
1032: 		cpu->cd.sh.pteh |= (vaddr & SH4_PTEH_VPN_MASK);
1033: 		break;
1034: 
1035: 	case EXPEVT_TRAPA:
1036: 		/*
1037: 		 *  Note: The TRA register is already set by the implementation
1038: 		 *  of the trapa instruction. See cpu_sh_instr.c for details.
1039: 		 *  Here, spc is incremented, so that a return from the trap
1040: 		 *  handler transfers control to the instruction _following_
1041: 		 *  the trapa.
1042: 		 */
1043: 		cpu->cd.sh.spc += sizeof(uint16_t);
1044: 		break;
1045: 
1046: 	case EXPEVT_RES_INST:
1047: 		/*
1048: 		 *  Note: Having this code here makes it possible to catch
1049: 		 *  reserved instructions; during normal instruction execution,
1050: 		 *  these are not very common.
1051: 		 */
1052: 		/*  #217: (Codex/Fable) a guest reserved instruction must take the
