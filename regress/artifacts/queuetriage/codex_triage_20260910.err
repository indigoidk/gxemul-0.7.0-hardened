356: 		return 2;
357: 	}
358: 
359: 	if (user) {
360: 		if (flags & FLAG_NOEXCEPTIONS) {
361: 			*return_paddr = 0;
362: 			return 2;
363: 		}
364: 
365: 		// Hopefully correct behavior; nbjoerg on #GXemul (FreeNode)
