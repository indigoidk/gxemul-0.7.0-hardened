import subprocess,re,collections,json
rev='4eac0b1'
files=subprocess.check_output(['git','ls-tree','-r','--name-only',rev],text=True).splitlines()
files=[p for p in files if re.fullmatch(r'src/(devices|cpus|machines)/["'^/]+'"\\.c',p)]
pat=re.compile(r'/\\*.*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\x27(?:\\\\.|["'^'"\\x27\\\\])*\\x27',re.S)
sums=collections.defaultdict(lambda:[0,0,0]); total=[]
for p in files:
 s=subprocess.check_output(['git','show',rev+':'+p],text=True,encoding='utf-8',errors='replace')
 raw=sum('exit(' in l for l in s.splitlines())
 clean=pat.sub(lambda m: ''.join('\\n' if c=='\\n' else ' ' for c in m[0]),s)
 calls=[s.count('\\n',0,m.start())+1 for m in re.finditer(r'\\bexit\\s*\\(',clean)]
 key=p.split('/')[1]; sums[key][0]+=raw; sums[key][1]+=len(calls); sums[key][2]+=s.count('exit(')
 if raw or calls: total.append((p,raw,calls))
print('TOTALS group:[literal lines,lexical calls,literal occurrences]',dict(sums))
for p,raw,calls in total: print(p,'raw='+str(raw),'calls='+str(len(calls)),','.join(map(str,calls)))
