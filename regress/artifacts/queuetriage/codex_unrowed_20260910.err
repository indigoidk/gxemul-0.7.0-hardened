767: 				d->vram_z[ofs] = z;
768: 
769: 				int fbofs = fb_base + ofs * d->bytes_per_pixel;
770: 
771: 				// Get color from texture:
772: 				int texturex = u * texture_xsize;
773: 				texturex &= (texture_xsize-1);
774: 				int texturey = v * texture_ysize;
775: 				texturey &= (texture_ysize-1);
805: 				{
806: 				case 0:	// ARGB1555:
807: 					{
808: 						int color = d->vram[addr] + (d->vram[addr+1] << 8);
809: 						a = (color >> 15) & 0x1 ? 255 : 0;
810: 						r = (color >> 10) & 0x1f;
811: 						g = ((color >> 5) & 0x1f) << 1;
812: 						b = (color) & 0x1f;
813: 					}
