629: /*  Ugly quick-hack:  */
630: static void line(struct pvr_data *d, int x1, int y1, int x2, int y2)
631: {
632: 	int fb_base = REG(PVRREG_FB_RENDER_ADDR1);
633: 	int i;
634: 	for (i=0; i<256; i++) {
635: 		int px = (i * x2 + (256-i) * x1) >> 8;
636: 		int py = (i * y2 + (256-i) * y1) >> 8;
637: 		if (px > 0 && py > 0 && px < d->xsize && py < d->ysize) {
638: 			int ofs = fb_base + (px + py * d->xsize) *
639:                             d->bytes_per_pixel;
640: 			d->vram[(ofs+0) % VRAM_SIZE] = 255;
641: 			d->vram[(ofs+1) % VRAM_SIZE] = 255;
642: 		}
643: 	}
644: }
645: #endif
