139: 		upper = *ep;
140: 		upper = BE32_TO_HOST(upper);
141: 
142: 		/*  Valid PTE, and correct api and vsid?  */
143: 		if (upper == cmp) {
144: 			uint32_t lo = ep[1];
145: 			lo = BE32_TO_HOST(lo);
146: 			*lowp = lo;
147: 			return 1;
148: 		}
149: 	}
150: 
151: 	return 0;
152: }
