648: // Ugly quick-hack z-buffer line drawer, for triangles.
649: // Assumes 16-bit color.
650: static void simpleline(struct pvr_data *d, int y, double x1, double x2,
651: 	double z1, double z2, double r1, double r2, double g1, double g2,
652: 	double b1, double b2)
653: {
654: 	if (y < 0 || y >= d->ysize || (x1 < 0 && x2 < 0)
655: 	     || (x1 >= d->xsize && x2 >= d->xsize))
656: 		return;
657: 
658: 	int fb_base = REG(PVRREG_FB_RENDER_ADDR1);
659: 	if (x1 > x2) {
660: 		double tmpf = x1; x1 = x2; x2 = tmpf;
661: 		tmpf = z1; z1 = z2; z2 = tmpf;
662: 		tmpf = r1; r1 = r2; r2 = tmpf;
663: 		tmpf = g1; g1 = g2; g2 = tmpf;
664: 		tmpf = b1; b1 = b2; b2 = tmpf;
665: 	}
666: 
667: 	// uint32_t fogDensity = REG(PVRREG_FOG_DENSITY);
668: 	// double scale_factor = 255.0;	// TODO: take fogDensity into account.
669: 	// uint32_t fogColor = REG(PVRREG_FOG_TABLE_COL);
670: 	// int fog_r = (fogColor >> 16) & 255;
671: 	// int fog_g = (fogColor >> 8) & 255;
672: 	// int fog_b = fogColor & 255;
673: 
674: 	double dz12 = (x2 - x1 != 0) ? ( (double)(z2 - z1) / (double)(x2 - x1) ) : 0;
675: 	double dr12 = (x2 - x1 != 0) ? ( (double)(r2 - r1) / (double)(x2 - x1) ) : 0;
676: 	double dg12 = (x2 - x1 != 0) ? ( (double)(g2 - g1) / (double)(x2 - x1) ) : 0;
677: 	double db12 = (x2 - x1 != 0) ? ( (double)(b2 - b1) / (double)(x2 - x1) ) : 0;
678: 	double z = z1, r = r1, g = g1, b = b1;
679: 	for (int x = x1; x <= x2; ++x) {
680: 		if (x > 0 && x < d->xsize) {
681: 			int ofs = x + y * d->xsize;
682: 			if (d->vram_z[ofs] <= z) {
683: 				d->vram_z[ofs] = z;
684: 
685: 				// z = 1/w
695: 				// NOTE/TODO: Hardcoded for 565 pixelformat.
696: 				int ri = r, gi = g, bi = b;
697: 				// int a = (fogvalues >> 8) & 255;
698: 				// ri = ((fog_r * a) + (ri * (255 - a))) >> 8;
699: 				// gi = ((fog_g * a) + (gi * (255 - a))) >> 8;
700: 				// bi = ((fog_b * a) + (bi * (255 - a))) >> 8;
701: 
702: 				if (ri < 0) ri = 0;
703: 				if (ri > 255) ri = 255;
704: 				if (gi < 0) gi = 0;
705: 				if (gi > 255) gi = 255;
706: 				if (bi < 0) bi = 0;
707: 				if (bi > 255) bi = 255;
708: 				int color = ((ri >> 3) << 11) + ((gi >> 2) << 5) + (bi >> 3);
709: 
710: 				int fbofs = fb_base + ofs * d->bytes_per_pixel;
711: 				d->vram[(fbofs+0) % VRAM_SIZE] = color & 255;
712: 				d->vram[(fbofs+1) % VRAM_SIZE] = color >> 8;
713: 			}
714: 		}
715: 		
716: 		z += dz12; r += dr12; g += dg12; b += db12;
717: 	}
718: }
