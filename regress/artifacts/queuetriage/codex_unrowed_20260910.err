155: static int lk201_send_mouse_update_sequence(struct lk201_data *d, int xdelta,
156: 	int ydelta, int mouse_buttons, int mouse_fb_nr)
157: {
158: 	int xsign, ysign, m;
159: 
160: 	/*  If no change, then don't send any update!  */
161: 	if (xdelta == 0 && ydelta == 0 && d->mouse_buttons == mouse_buttons)
162: 		return 0;
163: 
164: 	m = 50;
165: 
166: 	if (xdelta > m)
167: 		xdelta = m;
168: 	if (xdelta < -m)
169: 		xdelta = -m;
170: 	if (ydelta > m)
171: 		ydelta = m;
172: 	if (ydelta < -m)
173: 		ydelta = -m;
174: 
175: 	d->mouse_buttons = mouse_buttons;
176: 
177: 	/*
178: 	 *  TODO: Update d->mouse_framebuffer_nr some way!
179: 	 */
180: 
181: 	xsign = xdelta < 0? 1 : 0;
182: 	ysign = ydelta < 0? 1 : 0;
183: 
184: 	switch (d->mouse_mode) {
185: 
186: 	case 0:
187: 		/*  Do nothing (before the mouse is initialized)  */
188: 		return 0;
189: 
190: 	case MOUSE_INCREMENTAL:
191: 		if (xdelta < 0)
192: 			xdelta = -xdelta;
193: 		if (ydelta < 0)
194: 			ydelta = -ydelta;
195: 
196: 		/*  Reverse sign of x:  (this is needed for some reason)  */
197: 		xsign ^= 1;
198: 
199: 		d->add_to_rx_queue(d->add_data, MOUSE_START_FRAME +
200: 		    MOUSE_X_SIGN*xsign + MOUSE_Y_SIGN*ysign +
201: 		    (mouse_buttons & 7), DCMOUSE_PORT);
202: 		d->add_to_rx_queue(d->add_data, xdelta, DCMOUSE_PORT);
203: 		d->add_to_rx_queue(d->add_data, ydelta, DCMOUSE_PORT);
204: 		break;
205: 
206: 	default:
207: 		/*  TODO:  prompt mode and perhaps more stuff  */
208: 		fatal("[ lk201: mouse mode 0x%02x unknown: TODO ]\n",
209: 		    d->mouse_mode);
210: 		exit(1);
211: 	}
212: 
213: 	return 1;
214: }
