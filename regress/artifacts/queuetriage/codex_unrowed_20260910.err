815:  *  arg[0] = immediate value
816:  *  arg[1] = mask
817:  *  arg[2] = pointer to rm
818:  *
819:  *  msr_imm and msr_imm_spsr use arg[1] and arg[0].
820:  *  msr and msr_spsr use arg[1] and arg[2].
821:  */
822: X(msr_imm)
823: {
824: 	uint32_t mask = ic->arg[1];
825: 
826: 	if ((cpu->cd.arm.cpsr & ARM_FLAG_MODE) == ARM_MODE_USR32) {
827: 		mask &= 0xff000000;
828: 	}
829: 
830: 	int switch_register_banks = (mask & ARM_FLAG_MODE) &&
831: 	    ((cpu->cd.arm.cpsr & ARM_FLAG_MODE) !=
832: 	    (ic->arg[0] & ARM_FLAG_MODE));
833: 	uint32_t new_value = ic->arg[0];
834: 
835: 	cpu->cd.arm.cpsr &= 0x0fffffff;
836: 	cpu->cd.arm.cpsr |= (cpu->cd.arm.flags << 28);
837: 
838: 	if (switch_register_banks)
839: 		arm_save_register_bank(cpu);
840: 
841: 	cpu->cd.arm.cpsr &= ~mask;
842: 	cpu->cd.arm.cpsr |= (new_value & mask);
843: 
844: 	cpu->cd.arm.flags = cpu->cd.arm.cpsr >> 28;
845: 
846: 	if (switch_register_banks)
847: 		arm_load_register_bank(cpu);
848: }
849: Y(msr_imm)
850: X(msr)
851: {
852: 	ic->arg[0] = reg(ic->arg[2]);
853: 	instr(msr_imm)(cpu, ic);
905: /*
906:  *  mrs: Move from status/flag register to a normal register.
907:  *
908:  *  arg[0] = pointer to rd
909:  */
910: X(mrs)
911: {
912: 	cpu->cd.arm.cpsr &= 0x0fffffff;
913: 	cpu->cd.arm.cpsr |= (cpu->cd.arm.flags << 28);
914: 	reg(ic->arg[0]) = cpu->cd.arm.cpsr;
915: }
916: Y(mrs)
917: 
918: 
919: /*
920:  *  mrs: Move from saved status/flag register to a normal register.
921:  *
922:  *  arg[0] = pointer to rd
923:  */
924: X(mrs_spsr)
925: {
926: 	switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
927: 	case ARM_MODE_FIQ32: reg(ic->arg[0]) = cpu->cd.arm.spsr_fiq; break;
928: 	case ARM_MODE_ABT32: reg(ic->arg[0]) = cpu->cd.arm.spsr_abt; break;
929: 	case ARM_MODE_UND32: reg(ic->arg[0]) = cpu->cd.arm.spsr_und; break;
930: 	case ARM_MODE_IRQ32: reg(ic->arg[0]) = cpu->cd.arm.spsr_irq; break;
931: 	case ARM_MODE_SVC32: reg(ic->arg[0]) = cpu->cd.arm.spsr_svc; break;
932: 	case ARM_MODE_USR32:
933: 	case ARM_MODE_SYS32: reg(ic->arg[0]) = 0; break;
934: 	default:fatal("mrs_spsr: unimplemented mode %i\n", cpu->cd.arm.cpsr & ARM_FLAG_MODE);
935: 		cpu->running = 0;
936: 		cpu->cd.arm.next_ic = &nothing_call;
937: 	}
938: }
939: Y(mrs_spsr)
940: 
941: 
942: /*
943:  *  mcr_mrc:  Coprocessor move
944:  *  cdp:      Coprocessor operation
945:  *
946:  *  arg[0] = copy of the instruction word
947:  */
948: X(mcr_mrc) {
949: 	uint32_t low_pc = ((size_t)ic - (size_t)
950: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
951: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
952: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
953: 	arm_mcr_mrc(cpu, ic->arg[0]);
954: }
955: Y(mcr_mrc)
956: X(cdp) {
957: 	uint32_t low_pc = ((size_t)ic - (size_t)
958: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
959: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
960: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
961: 	arm_cdp(cpu, ic->arg[0]);
962: }
963: Y(cdp)
