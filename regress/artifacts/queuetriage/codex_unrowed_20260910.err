131: static int get_pte_low(struct cpu *cpu, uint64_t pteg_select,
132: 	uint32_t *lowp, uint32_t cmp)
133: {
134: 	unsigned char *d = memory_paddr_to_hostaddr(cpu->mem, pteg_select, 1);
