295: 			case LED_1:
296: 			case LED_2:
297: 				break;
298: 			case LED_3:
299: 				break;
300: 			case LED_4:
301: 				break;
302: 			case LK_KBD_ENABLE:	/*  0x8b  */
303: 				break;
304: 			case LED_ALL:		/*  0x8f  */
305: 				break;
306: 			case LK_RING_BELL:	/*  0xa7  */
307: 				break;
308: 			case 0xab:	/*  Get Keyboard ID:  */
309: 				/*
310: 				 *  First byte:
311: 				 *	1 = LK201
