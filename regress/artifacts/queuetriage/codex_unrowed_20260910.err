import subprocess,json,re,collections
j=json.loads(subprocess.check_output(['git','show','4eac0b1:tools/pipeline/ledger.json']))
needle=r'adb|clmpcc|dreamcast_g2|maple|fbctrl|igsfb|i80321|7seg|mb8696|mk48|mvme187|dev_vme|osiop|dev_pvr|rtl8139|sgi_ip32|sgirekills|mte.*(exit|kill)|armcop|armbank|armvm|armdomain|armmode|ppc.*(exit|kill)|mips.*(1.?KB|exit|kill)|sh.*prom|dyntrans|lcaisalane|lcabadval|alphavmkill|"'^n6 '"'
for r in j['rows']:
 text=r.get('title','')+' '+r.get('id','')
 if re.search(needle,text,re.I): print(json.dumps({k:r.get(k) for k in ['id','sev','state','title','note','state_note','witness','commits']},ensure_ascii=True))
