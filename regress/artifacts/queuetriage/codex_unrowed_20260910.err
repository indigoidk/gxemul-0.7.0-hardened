import subprocess,re,collections
for rev in ['1ce8296','4eac0b1']:
 files=subprocess.check_output(['git','ls-tree','-r','--name-only',rev],text=True).splitlines(); totals=collections.defaultdict(lambda:[0,0,0,0]); differences=[]
 for p in files:
  if not re.fullmatch(r'src/(devices|cpus|machines)/["'^/]+'"\\.c',p): continue
  s=subprocess.check_output(['git','show',rev+':'+p],text=True,encoding='utf-8',errors='replace')
  pats=[r'exit\\(',r'\\bexit\\(',r'\\bexit\\s*\\(']
  nums=[sum(bool(re.search(pat,l)) for l in s.splitlines()) for pat in pats]
  # Independent finite-state C lexer. Preserve positions, consume escaped characters.
  out=list(s); i=0
  while i<len(s):
   start=i
   if s.startswith('//',i):
    i=s.find('\\n',i)
    if i<0: i=len(s)
   elif s.startswith('/*',i):
    z=s.find('*/',i+2); i=len(s) if z<0 else z+2
   elif s[i] in ['\"',chr(39)]:
    quote=s[i]; i+=1
    while i<len(s):
     if s[i]=='\\\\': i+=2
     elif s[i]==quote: i+=1; break
     else: i+=1
   else: i+=1; continue
   for j in range(start,min(i,len(s))):
    if s[j]"'!='"'\\n': out[j]=' '
  clean=''.join(out); calls=list(re.finditer(r'\\bexit\\s*\\(',clean)); nums.append(len(calls))
  totals[p.split('/')[1]]=[a+b for a,b in zip(totals[p.split('/')[1]],nums)]
  if nums[0]"'!=nums[1]: differences.append((p,nums[:2]))
 print(rev,dict(totals),'"'literal-without-word-boundary differences',differences)
