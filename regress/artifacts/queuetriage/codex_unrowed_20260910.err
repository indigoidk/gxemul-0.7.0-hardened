293: 	else
294: 		debug("framebuffer_blockcopyfill(COPY, %i,%i, %i,%i, from "
295: 		    "%i,%i)\n", x1,y1, x2,y2, from_x,from_y);
296: 
297: 	/*  Clip x:  */
298: 	if (x1 < 0)		x1 = 0;
299: 	if (x1 >= d->xsize)	x1 = d->xsize-1;
300: 	if (x2 < 0)		x2 = 0;
301: 	if (x2 >= d->xsize)	x2 = d->xsize-1;
302: 
303: 	/*
304: 	 *  Clip y, mirroring the x clip above: the loops below only WRITE
305: 	 *  rows inside [0, d->ysize-1] (per-iteration guard), but without
306: 	 *  this clamp a huge caller-supplied y range (these coordinates can
307: 	 *  come from the emulated guest) makes them spin up to ~2^31
308: 	 *  iterations doing nothing. When clipping the top in copy mode,
309: 	 *  advance the source row equally so the copy stays aligned
310: 	 *  (saturate to d->ysize: any source row >= d->ysize just selects
311: 	 *  the "source outside fb => fill with zeroes" case, as before).
312: 	 */
313: 	if (y1 < 0) {
314: 		int64_t new_from_y = (int64_t) from_y - y1;
315: 		from_y = new_from_y > d->ysize ? d->ysize : (int) new_from_y;
316: 		y1 = 0;
317: 	}
318: 	if (y2 >= d->ysize)
319: 		y2 = d->ysize-1;
320: 
321: 	/*
322: 	 *  Nothing to do if the clipped horizontal or vertical span is empty.
323: 	 *  Without this guard, (x2 - x1 + 1) can be <= 0 and, since 'linelen'
324: 	 *  is a size_t, it would wrap to a huge value -- turning the
325: 	 *  memset()/copy below into an out-of-bounds write past the
326: 	 *  framebuffer. (These coordinates can come from the emulated guest.)
327: 	 */
328: 	if (x2 < x1 || y2 < y1)
329: 		return;
330: 
331: 	dest_ofs = d->bytes_per_line * y1 + (d->bit_depth/8) * x1;
332: 	linelen = (x2-x1 + 1) * (d->bit_depth/8);
333: 	/*  NOTE: linelen is nr of bytes, not pixels  */
334: 
335: 	if (fillflag) {
336: 		for (y=y1; y<=y2; y++) {
337: 			if (y>=0 && y<d->ysize) {
338: 				unsigned char *buf =
339: 				    d->framebuffer + dest_ofs;
340: 
341: 				if (d->bit_depth == 24) {
342: 					/*  Fill the whole line: 'buf' is a
343: 					    pointer, so the old "x < sizeof(buf)"
344: 					    bound only painted 8 bytes/line.  */
345: 					for (x=0; x+2 < (ssize_t)linelen; x += 3) {
346: 						buf[x] = fill_r;
347: 						buf[x+1] = fill_g;
348: 						buf[x+2] = fill_b;
349: 					}
350: 				} else if (d->bit_depth == 8) {
351: 					/*  For 8-bit, linelen == (x2-x1+1).
352: 					    Use the bounded expression so the
353: 					    size is provably non-negative.  */
354: 					memset(buf, fill_r,
355: 					    (size_t)(x2 - x1 + 1));
356: 				} else {
357: 					fatal("Unimplemented bit-depth (%i)"
358: 					    " for fb fill\n", d->bit_depth);
359: 					exit(1);
360: 				}
361: 			}
362: 
363: 			dest_ofs += d->bytes_per_line;
364: 		}
