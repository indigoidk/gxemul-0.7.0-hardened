720: static void texturedline(struct pvr_data *d,
721: 	int texture_pixelformat, int twiddled, int stride,
722: 	int texture, int texture_xsize, int texture_ysize,
723: 	int y, int x1, int x2, double z1, double z2,
724: 	double u1, double u2, double v1, double v2)
