757: 	double dz12 = (x2 - x1 != 0) ? ( (double)(z2 - z1) / (double)(x2 - x1) ) : 0;
758: 	double du12 = (x2 - x1 != 0) ? ( (double)(u2 - u1) / (double)(x2 - x1) ) : 0;
759: 	double dv12 = (x2 - x1 != 0) ? ( (double)(v2 - v1) / (double)(x2 - x1) ) : 0;
760: 
761: 	double z = z1, u = u1, v = v1;
762: 
763: 	for (int x = x1; x <= x2; ++x) {
764: 		if (x > 0 && x < d->xsize) {
765: 			int ofs = x + y * d->xsize;
