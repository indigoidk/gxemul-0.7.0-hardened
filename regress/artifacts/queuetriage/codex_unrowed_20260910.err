FILE src/cpus/cpu_arm.c
520:  *  arm_save_register_bank():
521:  */
522: void arm_save_register_bank(struct cpu *cpu)
523: {
524: 	/*  Save away current registers:  */
525: 	switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
526: 	case ARM_MODE_USR32:
527: 	case ARM_MODE_SYS32:
528: 		memcpy(cpu->cd.arm.default_r8_r14,
529: 		    &cpu->cd.arm.r[8], sizeof(uint32_t) * 7);
530: 		break;
531: 	case ARM_MODE_FIQ32:
532: 		memcpy(cpu->cd.arm.fiq_r8_r14,
533: 		    &cpu->cd.arm.r[8], sizeof(uint32_t) * 7);
534: 		break;
535: 	case ARM_MODE_IRQ32:
536: 		memcpy(cpu->cd.arm.default_r8_r14,
537: 		    &cpu->cd.arm.r[8], sizeof(uint32_t) * 5);
538: 		cpu->cd.arm.irq_r13_r14[0] = cpu->cd.arm.r[13];
539: 		cpu->cd.arm.irq_r13_r14[1] = cpu->cd.arm.r[14];
540: 		break;
541: 	case ARM_MODE_SVC32:
542: 		memcpy(cpu->cd.arm.default_r8_r14,
543: 		    &cpu->cd.arm.r[8], sizeof(uint32_t) * 5);
544: 		cpu->cd.arm.svc_r13_r14[0] = cpu->cd.arm.r[13];
545: 		cpu->cd.arm.svc_r13_r14[1] = cpu->cd.arm.r[14];
546: 		break;
547: 	case ARM_MODE_ABT32:
548: 		memcpy(cpu->cd.arm.default_r8_r14,
549: 		    &cpu->cd.arm.r[8], sizeof(uint32_t) * 5);
550: 		cpu->cd.arm.abt_r13_r14[0] = cpu->cd.arm.r[13];
551: 		cpu->cd.arm.abt_r13_r14[1] = cpu->cd.arm.r[14];
552: 		break;
553: 	case ARM_MODE_UND32:
554: 		memcpy(cpu->cd.arm.default_r8_r14,
555: 		    &cpu->cd.arm.r[8], sizeof(uint32_t) * 5);
556: 		cpu->cd.arm.und_r13_r14[0] = cpu->cd.arm.r[13];
557: 		cpu->cd.arm.und_r13_r14[1] = cpu->cd.arm.r[14];
558: 		break;
559: 	default:fatal("arm_save_register_bank: unimplemented mode %i\n",
560: 		    cpu->cd.arm.cpsr & ARM_FLAG_MODE);
561: 		exit(1);
562: 	}
563: }
564: 
565: 
566: /*
567:  *  arm_load_register_bank():
568:  */
569: void arm_load_register_bank(struct cpu *cpu)
570: {
571: 	/*  Load new registers:  */
572: 	switch (cpu->cd.arm.cpsr & ARM_FLAG_MODE) {
573: 	case ARM_MODE_USR32:
574: 	case ARM_MODE_SYS32:
575: 		memcpy(&cpu->cd.arm.r[8],
576: 		    cpu->cd.arm.default_r8_r14, sizeof(uint32_t) * 7);
577: 		break;
578: 	case ARM_MODE_FIQ32:
579: 		memcpy(&cpu->cd.arm.r[8], cpu->cd.arm.fiq_r8_r14,
580: 		    sizeof(uint32_t) * 7);
581: 		break;
582: 	case ARM_MODE_IRQ32:
583: 		memcpy(&cpu->cd.arm.r[8],
584: 		    cpu->cd.arm.default_r8_r14, sizeof(uint32_t) * 5);
585: 		cpu->cd.arm.r[13] = cpu->cd.arm.irq_r13_r14[0];
586: 		cpu->cd.arm.r[14] = cpu->cd.arm.irq_r13_r14[1];
587: 		break;
588: 	case ARM_MODE_SVC32:
589: 		memcpy(&cpu->cd.arm.r[8],
590: 		    cpu->cd.arm.default_r8_r14, sizeof(uint32_t) * 5);
591: 		cpu->cd.arm.r[13] = cpu->cd.arm.svc_r13_r14[0];
592: 		cpu->cd.arm.r[14] = cpu->cd.arm.svc_r13_r14[1];
593: 		break;
594: 	case ARM_MODE_ABT32:
595: 		memcpy(&cpu->cd.arm.r[8],
596: 		    cpu->cd.arm.default_r8_r14, sizeof(uint32_t) * 5);
597: 		cpu->cd.arm.r[13] = cpu->cd.arm.abt_r13_r14[0];
598: 		cpu->cd.arm.r[14] = cpu->cd.arm.abt_r13_r14[1];
599: 		break;
600: 	case ARM_MODE_UND32:
601: 		memcpy(&cpu->cd.arm.r[8],
602: 		    cpu->cd.arm.default_r8_r14, sizeof(uint32_t) * 5);
603: 		cpu->cd.arm.r[13] = cpu->cd.arm.und_r13_r14[0];
604: 		cpu->cd.arm.r[14] = cpu->cd.arm.und_r13_r14[1];
605: 		break;
606: 	default:fatal("arm_load_register_bank: unimplemented mode %i\n",
607: 		    cpu->cd.arm.cpsr & ARM_FLAG_MODE);
608: 		exit(1);
609: 	}
610: }
