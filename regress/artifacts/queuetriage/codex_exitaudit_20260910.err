125: static int osiop_get_scsi_phase(struct osiop_data *d)
126: {
127: 	return OSIOP_PHASE(d->reg[OSIOP_SOCL]);
128: }
129: 
130: 
131: static void osiop_set_scsi_phase(struct osiop_data *d, int phase)
132: {
133: 	int mask = OSIOP_MSG | OSIOP_CD | OSIOP_IO;
134: 	d->reg[OSIOP_SOCL] &= ~mask;
135: 	d->reg[OSIOP_SOCL] |= (phase & mask);
136: }
