ess, the page is read/write */ int ppc_translate_v2p(struct cpu *cpu, uint64_t vaddr, uint64_t *return_paddr, int flags)", "context": "} else { | /*  htaborg = sdr1 & 0xfffffffffffc0000ULL;  */ | fatal(\"TODO: ppc 64-bit translation\\n\"); | exit(1); | }"}, {"p": "src/cpus/memory_sh.c", "n": 381, "fn": "*\t2\tSame as 1, but the page is available as read/write. */ int sh_translate_v2p(struct cpu *cpu, uint64_t vaddr64, uint64_t *return_paddr, int flags)", "context": " | if (flags & FLAG_INSTR) { | fatal(\"TODO: instr at 0x%08\" PRIx32\"\\n\", (uint32_t)vaddr); | exit(1); | }"}, {"p": "src/cpus/memory_sh.c", "n": 400, "fn": "*\t2\tSame as 1, but the page is available as read/write. */ int sh_translate_v2p(struct cpu *cpu, uint64_t vaddr64, uint64_t *return_paddr, int flags)", "context": "/*  The ugly 'if' is just here to fool Compaq CC.  */ | if (!(flags & FLAG_NOEXCEPTIONS)) { | fatal(\"Unimplemented SH vaddr 0x%08\" PRIx32\"\\n\", vaddr); | exit(1); | }"}, {"p": "src/devices/bus_pci.c", "n": 197, "fn": "*  Sets the address in preparation for a PCI register transfer. */ void bus_pci_setaddr(struct cpu *cpu, struct pci_data *pci_data, int bus, int device, int function, int reg)", "context": "{ | if (cpu == NULL || pci_data == NULL) { | fatal(\"bus_pci_setaddr(): NULL ptr\\n\"); | exit(1); | }"}, {"p": "src/devices/bus_pci.c", "n": 235, "fn": "*/ void bus_pci_add(struct machine *machine, struct pci_data *pci_data, struct memory *mem, int bus, int device, int function, const char *name)", "context": "pd->function == function) { | fatal(\"bus_pci_add(): (bus %i, device %i, function\" | \" %i) already in use\\n\", bus, device, function); | exit(1); | }"}, {"p": "src/devices/bus_pci.c", "n": 266, "fn": "*/ void bus_pci_add(struct machine *machine, struct pci_data *pci_data, struct memory *mem, int bus, int device, int function, const char *name)", "context": " | if (init == NULL) { | fatal(\"No init function for PCI device \\\"%s\\\"?\\n\", name); | exit(1); | }"}, {"p": "