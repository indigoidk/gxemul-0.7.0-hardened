import subprocess,re,json,sys
sys.stdout.reconfigure(encoding='utf-8')
def get(p):return subprocess.check_output(['git','show','HEAD:'+p]).decode('utf-8','replace')
def show(p,a=1,b=None):
 ls=get(p).splitlines()
 print('\\nFILE',p)
 for i in range(a-1,min(b or len(ls),len(ls))):print(str(i+1)+': '+ls[i])

for f in ['regress/arm_endian_probe.py','regress/gdrom_default_probe.py','regress/sgi_de_width_probe.py','regress/pcc2_default_probe.py','regress/ppc_halt_probe.py']:
 ls=get(f).splitlines();print('\\nPROBE',f)
