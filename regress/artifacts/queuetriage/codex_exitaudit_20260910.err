123:                  xo10=(iw >> 1) & 1023, xo5=(iw >> 1) & 31, rc=iw & 1))
124: 
125: 
126: def run(iword):
127:     """Step one instruction; return "alive", "HALTED", or "DEAD"."""
128:     pid, fd = pty.fork()
129:     if pid == 0:
130:         os.chdir(IMAGES)
131:         os.execvp(BIN, [BIN, "-V", "-E", "macppc", "-e", "g4", "-M", "64",
132:                         KERNEL])
133:         os._exit(127)
134:     buf = ""
135: 
136:     def rd(t=0.4):
137:         nonlocal buf
138:         r, _, _ = select.select([fd], [], [], t)
139:         if fd not in r:
140:             return True
141:         try:
142:             d = os.read(fd, 65536)
143:         except OSError:
144:             return False
145:         if not d:
146:             return False
147:         buf += d.decode("latin1", "replace")
148:         return True
149: 
150:     def wait(timeout=45, mark=0, echo=None):
151:         t = time.time()
152:         while time.time() - t < timeout:
153:             if not rd():
154:                 return False
155:             resp = buf[mark:]
156:             #  #392: the ECHO first -- a prompt in the slice proves
157:             #  nothing until the debugger has taken the command.
