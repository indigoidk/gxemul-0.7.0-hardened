2275: 
2276: 
2277: /*
2278:  *  netbsd_cacheclean:
2279:  *
2280:  *  The core of a NetBSD/arm cache clean routine, variant 1:
2281:  *
2282:  *  f015f88c:  e4902020     ldr     r2,[r0],#32
2283:  *  f015f890:  e2511020     subs    r1,r1,#0x20
2284:  *  f015f894:  1afffffc     bne     0xf015f88c
2285:  *  f015f898:  ee070f9a     mcr     15,0,r0,cr7,cr10,4
2286:  */
2287: X(netbsd_cacheclean)
2288: {
2289: 	uint32_t r1 = cpu->cd.arm.r[1];
2290: 	uint32_t n;
2291: 
2292: 	/*  #350: a counter that is not a multiple of 32 never reaches zero,
2293: 	    so the real bne loop never exits -- the closed form below would
2294: 	    terminate a loop the architecture does not terminate. Fall back
2295: 	    to the genuine load handler (the netbsd_memcpy bail-out shape,
2296: 	    cf. :2028): r1 mod 32 is invariant under the loop's -0x20, so
2297: 	    every re-entry falls back too and the guest keeps its infinite
2298: 	    loop, its loads, its faults and its interruptibility. r1 == 0
2299: 	    stays folded: that loop terminates, after 2^27 iterations whose
2300: 	    2^32 bytes of base advance wrap r0 to itself.  */
2301: 	if (r1 & 0x1f) {
2302: 		instr(load_w0_word_u1_p0_imm)(cpu, ic);
2303: 		return;
2304: 	}
2305: 
2306: 	n = r1 == 0 ? (uint32_t)1 << 27 : r1 >> 5;
2307: 
2308: 	/*  #349: fold-fired marker. Once #348 made this fold write the
2309: 	    loop's true exit state, the genuine sequence became
2310: 	    architecturally transparent, so gate 14's fold detector reads
2311: 	    this DEBUG-gated line (and the stale r2, while the skipped load
2312: 	    stays unfixed). Deliberately NOT pre-gated with
2313: 	    ENOUGH_VERBOSITY(), per the #278 convention: a pre-gate would
2314: 	    hide it under -V step and keep `breakpoint subsystem cpu` from
