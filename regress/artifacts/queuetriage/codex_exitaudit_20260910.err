65: 	    machine->path, machine->bootstrap_cpu, 28);
66: 	device_add(machine, tmpstr);
67: 
68: 	/*  0xa0000000 = physical ram, 0xc0000000 = uncached  */
69: 	dev_ram_init(machine, 0xa0000000, 0x20000000, DEV_RAM_MIRROR, 0x0, NULL);
70: 	dev_ram_init(machine, 0xc0000000, 0x20000000, DEV_RAM_MIRROR, 0x0, NULL);
71: 
72: 	/*  0xe0000000 and 0xff000000 = cache flush regions  */
73: 	dev_ram_init(machine, 0xe0000000, 0x100000, DEV_RAM_RAM, 0x0, NULL);
74: 	dev_ram_init(machine, 0xff000000, 0x100000, DEV_RAM_RAM, 0x0, NULL);
