9, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "if (d->cur_output_offset < 2) { | fatal(\"[ adb: WEIRD output length: %i ]\\n\", | d->cur_output_offset); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 203, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "/*  ADBLISTEN:  */ | if ((d->output_buf[1] >> 4) != d->kbd_dev) { | fatal(\"[ adb: ADBLISTEN not to kbd ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 208, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "if (d->output_buf[3] != 0xfe || | (d->output_buf[2] & 0xf0) != 0x60) { | fatal(\"[ adb: unknown ADBLISTEN ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 214, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "d->kbd_dev = new_dev_pos; | } else { | fatal(\"[ adb: unknown ADB command? ]\\n\"); | exit(1); | }"}, {"p": "src/devices/dev_adb.c", "n": 241, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "d->output_buf[1] == 0x11) { | /*  Reboot.  */ | fatal(\"[ adb: reboot. TODO: make this nicer ]\\n\"); | exit(1); | } else {"}, {"p": "src/devices/dev_adb.c", "n": 244, "fn": "*  This function should be called whenever a complete ADB command has been *  received. */ static void adb_process_cmd(struct cpu *cpu, struct adb_data *d)", "context": "exit(1); | } else { | fatal(\"[ adb: UNIMPLEMENTED PRAM/RTC command ]\\n\"); | exit(1); | }"}, {"p": "src/devices