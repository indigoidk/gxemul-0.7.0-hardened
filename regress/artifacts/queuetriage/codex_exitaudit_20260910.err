FILE src/devices/dev_mb8696x.c
55: 
56: 	/*
57: 	 *  Registers:
58: 	 *
59: 	 *  reg contains 32 registers. However, registers 8..15 are bank-
60: 	 *  switched, based on a setting in FE_DLCR7. mar_8_15 are "multicast
61: 	 *  address registers", and bmpr_8_15 are "buffer memory port
62: 	 *  registers".
63: 	 */
64: 	uint8_t		reg[MB8696X_NREGS];
65: 	uint8_t		mar_8_15[8];
66: 	uint8_t		bmpr_8_15[8];
67: 
68: 	/*  EEPROM contents and internal state during a read operation:  */
69: 	uint8_t		eeprom[FE_EEPROM_SIZE];
70: 	int		eeprom_state;
71: 	uint8_t		eeprom_bit_count;
72: 	uint8_t		eeprom_command;
73: 	uint16_t	eeprom_data;
74: };
75: 
76: #define	EEPROM_STATE_NOTHING	0
77: #define	EEPROM_STATE_READY	1	/*  Waiting for start bit  */
78: #define	EEPROM_STATE_COMMAND	2	/*  Waiting for 8 command bits  */
79: #define	EEPROM_STATE_READ	3
80: 
81: 
82: DEVICE_ACCESS(mb8696x)
83: {
84: 	struct mb8696x_data *d = (struct mb8696x_data *) extra;
85: 	uint64_t idata = 0, odata = 0;
86: 	uint8_t *reg_ptr;
87: 
88: 	if (writeflag == MEM_WRITE)
89: 		idata = memory_readmax64(cpu, data, len);
90: 
91: 	relative_addr /= d->addr_mult;
92: 
93: 	/*
94: 	 *  Default result on reads:  (Note special treatment of banked regs.)
95: 	 */
96: 	reg_ptr = &d->reg[relative_addr];
97: 	if (relative_addr >= 8 && relative_addr <= 15 &&
98: 	    (d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_MAR)
99: 		reg_ptr = &d->mar_8_15[relative_addr - 8];
100: 	if (relative_addr >= 8 && relative_addr <= 15 &&
101: 	    (d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_BMPR)
102: 		reg_ptr = &d->bmpr_8_15[relative_addr - 8];
103: 
104: 	odata = *reg_ptr;
105: 
106: 
107: 	switch (relative_addr) {
108: 
109: 	case FE_DLCR0:	/*  TX interrupt status  */
110: 	case FE_DLCR1:	/*  RX interrupt status  */
111: 		/*  Write-1-to-clear:  */
112: 		if (writeflag == MEM_WRITE)
113: 			(*reg_ptr) &= ~idata;
114: 
115: /*  TODO: reassert interrupts  */
116: 
117: 		break;
118: 
119: 	case FE_DLCR2:	/*  TX interrupt control  */
120: 	case FE_DLCR3:	/*  RX interrupt control  */
121: 		if (writeflag == MEM_WRITE)
122: 			(*reg_ptr) = idata;
123: 
124: /*  TODO: reassert interrupts  */
125: 
126: 		break;
127: 
128: 	case FE_DLCR6:
129: 	case FE_DLCR8:	/*  Ethernet addr byte 0  */
130: 	case FE_DLCR9:	/*  Ethernet addr byte 1  */
131: 	case FE_DLCR10:	/*  Ethernet addr byte 2  */
132: 	case FE_DLCR11:	/*  Ethernet addr byte 3  */
133: 	case FE_DLCR12:	/*  Ethernet addr byte 4  */
134: 	case FE_DLCR13:	/*  Ethernet addr byte 5  */
135: 		if (writeflag == MEM_WRITE)
136: 			(*reg_ptr) = idata;
137: 		break;
138: 
139: 	case FE_DLCR7:
140: 		if (writeflag == MEM_WRITE) {
141: 			/*  Identification cannot be overwritten:  */
142: 			(*reg_ptr) &= FE_D7_IDENT;
143: 			(*reg_ptr) |= (idata & ~FE_D7_IDENT);
144: 		}
145: 		break;
146: 
147: 	case FE_BMPR16:
148: 		/*  EEPROM control  */
149: 		if (writeflag == MEM_WRITE) {
150: 			if (idata & ~(FE_B16_DOUT | FE_B16_DIN |
151: 			    FE_B16_SELECT | FE_B16_CLOCK)) {
152: 				fatal("mb8696x: UNIMPLEMENTED bits when "
153: 				    "writing to FE_BMPR16: 0x%02x\n",
154: 				    (int)idata);
155: 				exit(1);
156: 			}
157: 
158: 			/*  Dropped out of select state?  */
159: 			if (!(idata & FE_B16_SELECT))
160: 				d->eeprom_state = EEPROM_STATE_NOTHING;
161: 
162: 			/*  Switching to select state?  */
163: 			if (!((*reg_ptr) & FE_B16_SELECT) &&
164: 			    idata & FE_B16_SELECT)
165: 				d->eeprom_state = EEPROM_STATE_READY;
166: 
167: 			/*  Bit clock?  */
168: 			if (!((*reg_ptr) & FE_B16_CLOCK) &&
169: 			    idata & FE_B16_CLOCK) {
170: 				int bit = d->reg[FE_BMPR17] & FE_B17_DATA? 1:0;
171: 				switch (d->eeprom_state) {
172: 				case EEPROM_STATE_READY:
173: 					d->eeprom_state = EEPROM_STATE_COMMAND;
174: 					d->eeprom_bit_count = 0;
175: 					break;
176: 				case EEPROM_STATE_COMMAND:
177: 					d->eeprom_bit_count ++;
178: 					d->eeprom_command <<= 1;
179: 					d->eeprom_command |= bit;
180: 					if (d->eeprom_bit_count == 8) {
181: 						int addr = (d->eeprom_command
182: 						    & 0x7f) << 1;
183: 						/*  addr is a guest-derived index;
184: 						    bound it to the 32-byte EEPROM
185: 						    so eeprom[addr]/[addr+1] below
186: 						    can't read past the array.  */
187: 						addr &= (FE_EEPROM_SIZE - 2);
188: 						/*  printf("COMMAND=%08x\n",
189: 						    d->eeprom_command);  */
190: 						if (!(d->eeprom_command&0x80)) {
191: 							fatal("WRITES to the "
192: 							    "EEPROM are not yet"
193: 							    " implemented.\n");
194: 							exit(1);
195: 						}
196: 						/*  This is a read command.  */
197: 						d->eeprom_bit_count = 0;
198: 						d->eeprom_state =
199: 						    EEPROM_STATE_READ;
200: 						d->eeprom_data = d->eeprom[addr]
201: 						    * 256 + d->eeprom[addr+1];
202: 					}
203: 					break;
204: 				case EEPROM_STATE_READ:
205: 					d->reg[FE_BMPR17] = 0;
206: 					if (d->eeprom_data & 0x8000)
207: 						d->reg[FE_BMPR17] = FE_B17_DATA;
208: 					d->eeprom_data <<= 1;
209: 					d->eeprom_bit_count ++;
210: 					if (d->eeprom_bit_count > 16)
211: 						fatal("[ WARNING: more than 16"
212: 						    " bits of EEPROM data "
213: 						    "read? ]\n");
214: 					break;
215: 				}
216: 			}
217: 
218: 			(*reg_ptr) = idata;
219: 		}
220: 		break;
221: 
222: 	case FE_BMPR17:
223: 		/*  EEPROM data  */
224: 		if (writeflag == MEM_WRITE) {
225: 			if (idata & ~FE_B17_DATA) {
226: 				fatal("mb8696x: UNIMPLEMENTED bits when "
227: 				    "writing to FE_BMPR17: 0x%02x\n",
228: 				    (int)idata);
229: 				exit(1);
230: 			}
231: 			(*reg_ptr) = idata;
232: 		}
233: 		break;
234: 
235: 	default:
236: 		{
237: 			const char *bank = "";
238: 			if ((d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_MAR)
239: 				bank = " (bank MAR)";
240: 			if ((d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_BMPR)
241: 				bank = " (bank BMPR)";
242: 			if (writeflag == MEM_READ) {
243: 				fatal("[ mb8696x: read from UNIMPLEMENTED reg "
244: 				    "%i%s ]\n", (int)relative_addr, bank);
245: 			} else {
246: 				fatal("[ mb8696x: write to UNIMPLEMENTED reg "
247: 				    "%i%s: 0x%02x ]\n", (int)relative_addr,
248: 				    bank, (int)idata);
249: 			}
250: 
251: 			// exit(1);
252: 		}
253: 	}
254: 
255: 	if (writeflag == MEM_READ)

