100: #  for the datum; loads use at (reg 1) and v0 (reg 2).
101: OP_NOP = 0x00000000
102: OP_B_SELF = 0x1000ffff
103: OP_SB_T0_A3 = 0xa0e80000             # sb   $t0, 0($a3)   101000 00111 01000
104: OP_SH_T0_A3 = 0xa4e80000             # sh   $t0, 0($a3)   101001 00111 01000
105: OP_SW_T0_A3 = 0xace80000             # sw   $t0, 0($a3)   101011 00111 01000
106: OP_SD_T0_A3 = 0xfce80000             # sd   $t0, 0($a3)   111111 00111 01000
107: OP_LBU_V0_AT = 0x90220000            # lbu  $v0, 0($at)   100100 00001 00010
108: OP_LHU_V0_AT = 0x94220000            # lhu  $v0, 0($at)   100101 00001 00010
109: OP_LW_V0_AT = 0x8c220000             # lw   $v0, 0($at)   100011 00001 00010
110: OP_LD_V0_AT = 0xdc220000             # ld   $v0, 0($at)   110111 00001 00010
111: 
112: DECL = "sgi_de: unimplemented len="          # the fix's decline announcement
113: KILL = "sgi_de: len = "                      # the pre-fix host kill
114: DRAW = "sgi_de: UNIMPLEMENTED drawing op"    # sgideprimop, the SECOND kill
115: SCIS = "sgi_de: TODO: non-zero CRIME_DE_SCISSOR"
116: RE_DECL = "sgi_re: unimplemented len=1 for CRIME_RE_TLB_A"
117: 
118: SENTINEL = 0xdeadbeef
119: 
120: rows = []
121: 
122: 
123: def row(name, got, want, note=""):
124:     ok = (got == want)
125:     rows.append((name, ok))
126:     print("%-16s %-14s %-14s %-44s %s" % (name, str(got), str(want), note,
127:                                           "ok" if ok else "FAIL"))
128:     return ok
129: 
130: 
131: def session(cmds, settle=1.5, spin=1.2):
132:     pid, fd = pty.fork()
133:     if pid == 0:
134:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
135:                        "0x80001000:" + DUMMY])
136:         os._exit(127)
137:     buf = ""
138: 
139:     def rd(t):
140:         nonlocal buf
141:         end = time.time() + t
142:         while time.time() < end:
143:             r, _, _ = select.select([fd], [], [], 0.1)
144:             if not r:
145:                 continue
146:             try:
147:                 d = os.read(fd, 65536)
148:                 if not d:
149:                     return False
150:                 buf += d.decode("latin-1", "replace")
151:             except OSError:
152:                 return False
153:         return True
154: 
155:     alive = rd(settle)
156:     for i, c in enumerate(cmds):
157:         try:
158:             os.write(fd, (c + "\n").encode("latin-1"))
159:         except OSError:
160:             alive = False
161:             break
162:         if not rd(spin if i == len(cmds) - 1 else 0.25):
163:             alive = False
164:             break
165:     try:
166:         os.write(fd, b"quit\n")
167:         rd(0.4)
168:     except OSError:
169:         pass
170:     try:
171:         os.close(fd)
172:     except OSError:
173:         pass
174:     how = "nostatus"
175:     try:
176:         _, stat = os.waitpid(pid, 0)
177:         if os.WIFSIGNALED(stat):
178:             how = "sig%d" % os.WTERMSIG(stat)
179:         elif os.WIFEXITED(stat):
180:             how = "exit%d" % os.WEXITSTATUS(stat)
181:     except OSError:
182:         pass
183:     return buf.replace("\r", ""), alive, how
