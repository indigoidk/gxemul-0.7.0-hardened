import subprocess,tarfile,io,re,json,collections,sys
sys.stdout.reconfigure(encoding='utf-8')
a=tarfile.open(fileobj=io.BytesIO(subprocess.check_output(['git','archive','HEAD','src'])))
files={m.name:a.extractfile(m).read().decode('utf-8','replace') for m in a.getmembers() if m.isfile() and m.name.endswith(('.c','.h'))}
tok=re.compile(r'/\\*.*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\'(?:\\\\.|["'^'"\\'\\\\])*\\'',re.S)
def clean(s):return tok.sub(lambda m:re.sub(r'["'^'"\\n]',' ',m.group()),s)

for pat in [r'osiop_set_scsi_phase\\(',r'SOCL\\].*=',r'dev_fb_access_blockcopyfill\\(',r'reg\\[OSIOP_SOCL\\]',r'cur_output_offset',r'RESET.*GUN',r'R4100|VR41']:
 print('\\nSEARCH',pat)
 for p,s in files.items():
  if pat=='cur_output_offset' and 'dev_adb' not in p:continue
  if pat==r'R4100|VR41' and not p.startswith('src/machines/'):continue
  for i,l in enumerate(clean(s).splitlines(),1):
   if re.search(pat,l):print(p+':'+str(i)+': '+s.splitlines()[i-1].strip())

