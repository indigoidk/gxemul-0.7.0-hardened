def scan(s):
 out=list(s);i=0;n=len(s)
 while i<n:
  if s.startswith('/*',i):
   j=s.find('*/',i+2);j=n if j<0 else j+2
  elif s.startswith('//',i):
   j=s.find('\\n',i+2);j=n if j<0 else j
  elif s[i] in ('\"',\"'\"):
