1135: 		    device_add(machine, tmpstr);
1136: 	}
1137: 
1138: 	if (diskimage_exist(machine, 2, DISKIMAGE_IDE) ||
1139: 	    diskimage_exist(machine, 3, DISKIMAGE_IDE)) {
1140: 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx irq=%s."
1141: 		    "isa.%i", (long long)(pd->pcibus->isa_portbase + 0x170),
