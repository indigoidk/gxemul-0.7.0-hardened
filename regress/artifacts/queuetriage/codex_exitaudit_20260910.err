950: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
951: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
952: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
953: 	arm_mcr_mrc(cpu, ic->arg[0]);
