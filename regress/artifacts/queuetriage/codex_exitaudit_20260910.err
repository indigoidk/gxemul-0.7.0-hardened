958: 	    cpu->cd.arm.cur_ic_page) / sizeof(struct arm_instr_call);
959: 	cpu->pc &= ~((ARM_IC_ENTRIES_PER_PAGE-1) << ARM_INSTR_ALIGNMENT_SHIFT);
960: 	cpu->pc += (low_pc << ARM_INSTR_ALIGNMENT_SHIFT);
961: 	arm_cdp(cpu, ic->arg[0]);
962: }
