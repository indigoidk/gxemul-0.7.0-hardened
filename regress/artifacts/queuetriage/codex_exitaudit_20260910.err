162:         return False
163: 
164:     def send(s):
165:         b = (s + "\n").encode("latin1")
166:         _mark = len(buf)
167:         n = 0
168:         while n < len(b):
169:             n += os.write(fd, b[n:])
170:         return wait(mark=_mark, echo=s if s else None)
