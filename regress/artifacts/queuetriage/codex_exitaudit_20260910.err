HEAD is exactly `4eac0b1`. The working tree has source and ledger edits, so I’m reading committed blobs for this audit. I also confirmed that the earlier “370” count covered only immediate `.c` files in `devices`, `cpus`, and `machines`; it was not a whole-project count.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import subprocess,tarfile,io,re,json,collections,sys
sys.stdout.reconfigure(encoding='utf-8')
a=tarfile.open(fileobj=io.BytesIO(subprocess.check_output(['git','archive','HEAD','src'])))
files={m.name:a.extractfile(m).read().decode('utf-8','replace') for m in a.getmembers() if m.isfile() and m.name.endswith(('.c','.h'))}
tok=re.compile(r'/\\*.*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\'(?:\\\\.|["'^'"\\'\\\\])*\\'',re.S)
def clean(s):return tok.sub(lambda m:re.sub(r'["'^'"\\n]',' ',m.group()),s)
rows=[];tot={}
for p,s in files.items():
 c=clean(s); raw=len(re.findall(r'exit\\(',s)); calls=list(re.finditer(r'\\bexit\\s*\\(',c))
 if not raw and not calls:continue
 tot[p]={'raw':raw,'rawlines':sum('exit(' in l for l in s.splitlines()),'lex':len(calls)}
 if re.fullmatch(r'src/(devices|cpus|machines)/["'^/]+'"\\.c',p):
  lines=s.splitlines();cs=c.splitlines()
  for m in calls:
   n=c.count('\\n',0,m.start())+1
   prev=' | '.join(l.strip() for l in lines[max(0,n-4):n+1])
   fn=''
   for j in range(n-1,-1,-1):
    if cs[j].startswith('{'):
     fn=' '.join(x.strip() for x in lines[max(0,j-4):j] if x.strip());break
   rows.append({'p':p,'n':n,'fn':fn,'context':prev})
print(json.dumps({'totals':tot,'rows':rows}))

