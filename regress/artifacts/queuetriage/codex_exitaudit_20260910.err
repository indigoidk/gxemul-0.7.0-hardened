181: #endif
182: 			d2 = ((d2 & 0xff) << 24) | ((d2 & 0xff00) << 8) |
183: 			     ((d2 & 0xff0000) >> 8) | ((d2 & 0xff000000) >> 24);
184: 
185: 		switch (d2 & 3) {
186: 		case 0:	fs = FAULT_TRANS_P;
187: 			goto exception_return;
188: 		case 1:	/*  16KB page:  */
189: 			ap = (d2 >> 4) & 255;
