import subprocess,tarfile,io,re,collections,sys
sys.stdout.reconfigure(encoding='utf-8')
for rev in ['HEAD','1ce8296']:
 a=tarfile.open(fileobj=io.BytesIO(subprocess.check_output(['git','archive',rev,'src/devices','src/cpus','src/machines'])))
 t=collections.defaultdict(collections.Counter)
 for m in a.getmembers():
  if not re.fullmatch(r'src/(devices|cpus|machines)/["'^/]+'"\\.c',m.name):continue
  s=a.extractfile(m).read().decode('utf-8','replace')
  for key,pat in [('substring',r'exit\\('),('word',r'\\bexit\\('),('space',r'\\bexit\\s*\\(')]: t[m.name.split('/')[1]][key]+=len(re.findall(pat,s))
 print(rev,dict(t))
