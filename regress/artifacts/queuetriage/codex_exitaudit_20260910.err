378: /*
379:  *  lk201_init():
380:  *
381:  *  Initialize lk201 keyboard/mouse settings.
382:  */
383: void lk201_init(struct lk201_data *d, int use_fb,
384: 	int (*space_available_in_queue)(void *,int),
385: 	void (*add_to_rx_queue)(void *,int,int),
386: 	int console_handle, void *add_data)
387: {
388: 	memset(d, 0, sizeof(struct lk201_data));
389: 
390: 	d->space_available_in_queue = space_available_in_queue;
391: 	d->add_to_rx_queue = add_to_rx_queue;
392: 	d->add_data = add_data;
393: 
394: 	d->use_fb = use_fb;
395: 	d->mouse_mode = 0;
396: 	d->mouse_revision = 0;	/*  0..15  */
397: 	d->console_handle = console_handle;
398: 
399: 	/*
400: 	 *  Power up self-test result, as per
401: 	 *  https://www.netbsd.org/docs/Hardware/Machines/DEC/lk201.html#power_up
402: 	 */
403: 	if (d->use_fb) {
404: 		d->add_to_rx_queue(d->add_data, 0x01, DCKBD_PORT);
405: 		d->add_to_rx_queue(d->add_data, 0x00, DCKBD_PORT);

