1152: /*
1153:  *  Realtek 8139C+ PCI ethernet.
1154:  */
1155: 
1156: #define PCI_VENDOR_REALTEK		0x10ec
1157: #define	PCI_PRODUCT_REALTEK_RT8139	0x8139
1158: 
1159: PCIINIT(rtl8139c)
1160: {
1161: 	uint64_t port, memaddr;
1162: 	int pci_int_line = 0x101, irq = 0;
1163: 	char irqstr[1000];
1164: 	char tmpstr[2000];
1165: 
1166: 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_REALTEK,
1167: 	    PCI_PRODUCT_REALTEK_RT8139));
1168: 
1169: 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_NETWORK,
1170: 	    PCI_SUBCLASS_NETWORK_ETHERNET, 0x00) + 0x20);
1171: 
1172: 	switch (machine->machine_type) {
1173: 	case MACHINE_LANDISK:
1174: 		irq = 5;
1175: 		pci_int_line = 0x105;
1176: 		break;
1177: 	default:fatal("rtl8139c for this machine has not been "
1178: 		    "implemented yet\n");
1179: 		exit(1);
1180: 	}
1181: 
1182: 	PCI_SET_DATA(PCI_INTERRUPT_REG, 0x28140000 | pci_int_line);
1183: 
1184: 	allocate_device_space(pd, 0x100, 0, &port, &memaddr);
1185: 
1186: 	snprintf(irqstr, sizeof(irqstr), "%s.%i",
1187: 	    pd->pcibus->irq_path_pci, irq);
1188: 
1189: 	snprintf(tmpstr, sizeof(tmpstr), "rtl8139c addr=0x%llx "
1190: 	    "irq=%s pci_little_endian=1", (long long)port, irqstr);
1191: 
1192: 	device_add(machine, tmpstr);
1193: }
