330: int osiop_execute_scripts_instr(struct cpu *cpu, struct osiop_data *d)
331: {
332: 	uint32_t *dsap = (uint32_t*) &d->reg[OSIOP_DSA];
333: 	uint32_t *dnadp = (uint32_t*) &d->reg[OSIOP_DNAD];
334: 	uint32_t *dbcp = (uint32_t*) &d->reg[OSIOP_DBC];
335: 	uint32_t *dspsp = (uint32_t*) &d->reg[OSIOP_DSPS];
336: 	uint32_t *dspp = (uint32_t*) &d->reg[OSIOP_DSP];
337: 	uint32_t *tempp = (uint32_t*) &d->reg[OSIOP_TEMP];
338: 
339: 	uint32_t dspOrig = *dspp;
340: 	uint32_t instr1 = osiop_get_next_scripts_word(cpu, d);
341: 	uint32_t instr2 = osiop_get_next_scripts_word(cpu, d);
342: 	uint32_t dbc, target_addr = 0;
343: 	uint8_t dcmd;
344: 	int32_t reladdr;
345: 	int opcode, phase, relative_addressing, table_indirect_addressing;
346: 	int select_with_atn, scsi_ids_to_select = -1, scsi_id_to_select;
347: 	int test_carry, compare_data, compare_phase;
348: 	int jump_if_true, wait_for_valid_phase;
349: 	int comparison = 0, interrupt_instead_of_branch = 0;
350: 	
351: 	/*
352: 	 *  According to the 53C710 manual, chapter 5 (introduction): the first
353: 	 *  32-bit word is always loaded into DCMD and DBC, the second into
354: 	 *  DSPS, the third (only used by memory move instructions) is loaded
355: 	 *  into the TEMP register.
356: 	 */
357: 
358: 	if (!d->scripts_running) {	/* #118: host-page fault during SCRIPTS fetch above */
359: 		*dspp = dspOrig;	/* leave DSP at the faulting instr; don't fake progress */
360: 		return 0;
361: 	}
362: 
363: 	dcmd = d->reg[OSIOP_DCMD] = instr1 >> 24;
364: 	dbc = *dbcp = instr1 & 0x00ffffff;
365: 	*dspsp = instr2;
366: 
367: 	reladdr = (instr2 << 8);
368: 	reladdr >>= 8;
369: 
370: 	opcode = (dcmd >> 3) & 7;
371: 	phase = dcmd & 7;
372: 
373: 	if (osiop_debug)
374: 		debug("{ SCRIPTS @ 0x%08x:  0x%08x 0x%08x",
375: 		    (int) dspOrig, (int) instr1, (int) instr2);
376: 
377: 	switch (dcmd & 0xc0) {
378: 
379: 	case 0x00:
380: 		{
381: 			int ofs1 = instr1 & 0x00ffffff;
382: 			int ofs2 = instr2 & 0x00ffffff;
383: 			int indirect_addressing = dcmd & 0x20;
384: 			uint32_t dsa = *dsap;
385: 			uint32_t addr, xfer_byte_count, xfer_addr;
386: 			int32_t tmp = ofs2 << 8;
387: 			int res;
388: 			size_t i;
389: 
390: 			tmp >>= 8;
391: 			table_indirect_addressing = dcmd & 0x10;
392: 			
393: 			opcode = (dcmd >> 3) & 1;
394: 
395: 			switch (opcode) {
396: 			case 0: if (osiop_debug)
397: 					debug(": CHMOV");
398: 				break;
399: 			case 1: if (osiop_debug)
400: 					debug(": MOVE");
401: 				break;
402: 			}
403: 
404: 			if (indirect_addressing) {
405: 				fatal("osiop: TODO: indirect_addressing move\n");
406: 				exit(1);
407: 			}
408: 
409: 			if (!table_indirect_addressing) {
410: 				fatal("osiop: TODO: !table_indirect_addressing move\n");
411: 				exit(1);
412: 			}
413: 			
414: 			if (osiop_debug)
415: 				debug(" FROM %i", tmp);
416: 			
417: 			if (ofs1 != ofs2) {
418: 				fatal("osiop: TODO: move ofs1!=ofs2\n");
419: 				exit(1);
420: 			}
421: 			
422: 			if (phase != osiop_get_scsi_phase(d)) {
423: 				fatal("osiop: TODO: move: wait for phase. "
424: 				    "phase = %i, osiop_get_scsi_phase = %i\n",
425: 				    phase, osiop_get_scsi_phase(d));
426: 				exit(1);
427: 			}
428: 
429: 			if (osiop_debug)			
430: 				debug(" WHEN %s", phases[phase]);
431: 
432: 			addr = dsa + tmp;
433: 			xfer_byte_count = read_word(d, cpu, addr) & 0x00ffffff;
434: 			xfer_addr = read_word(d, cpu, addr+4);
435: 
436: 			if (!d->scripts_running)	/* #118: host-page fault reading the MOVE descriptor */
437: 				return 1;
438: 
439: 			/*  A guest can drive the controller into a data phase
440: 			    without a selection having set up a transfer; guard
441: 			    the dereferences of d->xferp below.  */
442: 			if (d->xferp == NULL) {
443: 				/*  #114 (refined, Codex+agy course-correction): a guest
444: 				    drove a data phase with no active transfer. Warn
445: 				    loudly-once and STOP this controller's script -- do NOT
446: 				    fall through to the "Transfer complete" register updates
447: 				    below (which would fake a successful move), and do NOT
448: 				    exit the emulator.  */
449: 				static int warned = 0;
450: 				if (!warned) {
451: 					fatal("[ osiop: SCSI data phase with no active "
452: 					    "transfer; stopping script (no fake "
453: 					    "completion) ]\n");
454: 					warned = 1;
455: 				}
456: 				d->scripts_running = 0;
457: 				return 1;
458: 			} else
459: 			switch (phase) {
460: 

