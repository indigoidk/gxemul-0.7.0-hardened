import subprocess,tarfile,io,re,json,collections,sys
sys.stdout.reconfigure(encoding='utf-8')
a=tarfile.open(fileobj=io.BytesIO(subprocess.check_output(['git','archive','HEAD','src'])))
files={m.name:a.extractfile(m).read().decode('utf-8','replace') for m in a.getmembers() if m.isfile() and m.name.endswith(('.c','.h'))}
tok=re.compile(r'/\\*.*?\\*/|//["'^'"\\n]*|\"(?:\\\\.|["'^"'"\\\\])*\"|\\'(?:\\\\.|["'^'"\\'\\\\])*\\'',re.S)
def clean(s):return tok.sub(lambda m:re.sub(r'["'^'"\\n]',' ',m.group()),s)

scoped={p:s for p,s in files.items() if re.fullmatch(r'src/(devices|cpus|machines)/["'^/]+'"\\.c',p)}
def lex2(s):
 out=list(s); i=0;n=len(s)
 while i<n:
  if s.startswith('/*',i):
   j=s.find('*/',i+2);j=n if j<0 else j+2
  elif s.startswith('//',i):
   j=s.find('\\n',i+2);j=n if j<0 else j
  elif s[i] in ['\"',\"'\"]:
   q=s[i];j=i+1
   while j<n:
    if s[j]=='\\\\':j+=2;continue
    if s[j]==q:j+=1;break
    j+=1
  else:i+=1;continue
  for k in range(i,min(j,n)):
   if out[k]"'!='"'\\n':out[k]=' '
  i=j
 return ''.join(out)
for group in ['devices','cpus','machines']:
 subset={p:s for p,s in scoped.items() if '/'+group+'/' in p}
 nums=[sum(s.count('exit(') for s in subset.values()),
       sum(s.count('exit(1)') for s in subset.values()),
       sum(len(re.findall(r'\\bexit\\s*\\(',clean(s))) for s in subset.values()),
       sum(len(re.findall(r'\\bexit\\s*\\(\\s*1\\s*\\)',clean(s))) for s in subset.values())]
 print(group,nums)
diff=[]
for p,s in scoped.items():
 a=[m.start() for m in re.finditer(r'\\bexit\\s*\\(',clean(s))]
 b=[m.start() for m in re.finditer(r'\\bexit\\s*\\(',lex2(s))]
 if a"'!=b:diff.append(p)
print('"'independent lexer source-position differences:',diff)
print('HEAD',subprocess.check_output(['git','rev-parse','HEAD']).decode().strip())

