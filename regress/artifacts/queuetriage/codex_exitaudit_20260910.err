110: 
111: /*  Allocate memory for a new transfer.  */
112: static void osiop_new_xfer(struct osiop_data *d, int target_scsi_id)
113: {
114: 	if (d->xferp != NULL) {
115: 		fatal("WARNING! osiop_new_xfer(): freeing previous"
116: 		    " transfer\n");
117: 		osiop_free_xfer(d);
118: 	}
119: 
120: 	d->selected_id = target_scsi_id;
121: 	d->xferp = scsi_transfer_alloc();
122: }
