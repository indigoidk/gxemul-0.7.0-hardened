358:     out = {"__put_ok": put_ok}
359:     for rn in regs:
360:         mark = len(buf)
361:         send("print %s" % rn)
362:         m = re.search(r"(?m)^0x([0-9a-fA-F]+)\s*$", buf[mark:])
363:         if m:
364:             out[rn] = int(m.group(1), 16)
365:     try:
366:         os.write(fd, b"quit\n"); time.sleep(0.2)
367:         os.kill(pid, 9); os.waitpid(pid, 0)
368:     except Exception:
369:         pass
370:     return out
371: 

