   259: /*
   260:  *  m88k_cpu_register_dump():
   261:  *
   262:  *  Dump cpu registers in a relatively readable format.
   263:  *  
   264:  *  gprs: set to non-zero to dump GPRs and some special-purpose registers.
   265:  *  coprocs: set bit 0..3 to dump registers in coproc 0..3.
   266:  */
   267: void m88k_cpu_register_dump(struct cpu *cpu, int gprs, int coprocs)
   268: {
   269: 	char *symbol;
   270: 	uint64_t offset;
   271: 	int i, x = cpu->cpu_id;
   272: 
   273: 	if (gprs) {
   274: 		symbol = get_symbol_name(&cpu->machine->symbol_context,
   275: 		    cpu->pc, &offset);
   276: 		debug("cpu%i:  pc  = 0x%08" PRIx32, x, (uint32_t)cpu->pc);
   277: 		debug("  <%s>\n", symbol != NULL? symbol : " no symbol ");
   278: 
   279: 		for (i=0; i<N_M88K_REGS; i++) {
   280: 			if ((i % 4) == 0)
   281: 				debug("cpu%i:", x);
   282: 			if (i == 0)
   283: 				debug("                  ");
   284: 			else
   285: 				debug("  r%-2i = 0x%08" PRIx32,
   286: 				    i, cpu->cd.m88k.r[i]);
   287: 			if ((i % 4) == 3)
   288: 				debug("\n");
   289: 		}
   290: 	}
   291: 
   292: 	if (coprocs & 1) {
   293: 		int n_control_regs = 32;
   294: 
   295: 		/*  Hm. Is this really MVME197 specific? TODO  */
   296: 		if (cpu->machine->machine_subtype == MACHINE_MVME88K_197)
   297: 			n_control_regs = 64;
   298: 
   299: 		for (i=0; i<n_control_regs; i++) {
   300: 			if ((i % 4) == 0)
   301: 				debug("cpu%i:", x);
   302: 			debug("  %4s=0x%08" PRIx32,
   303: 			    m88k_cr_name(cpu, i), cpu->cd.m88k.cr[i]);
   304: 			if ((i % 4) == 3)
   305: 				debug("\n");
   306: 		}
   307: 	}
   308: 
   309: 	if (coprocs & 2) {
   310: 		int n_fpu_control_regs = 64;
   311: 
   312: 		for (i=0; i<n_fpu_control_regs; i++) {
   313: 			if ((i % 4) == 0)
   314: 				debug("cpu%i:", x);
   315: 			debug("  %5s=0x%08" PRIx32,
   316: 			    m88k_fcr_name(cpu, i), cpu->cd.m88k.fcr[i]);
   317: 			if ((i % 4) == 3)
   318: 				debug("\n");
   319: 		}
   320: 	}
   321: }
