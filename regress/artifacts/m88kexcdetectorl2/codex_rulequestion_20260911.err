   324: /*
   325:  *  m88k_cpu_tlbdump():
   326:  *
   327:  *  Called from the debugger to dump the TLB in a readable format.
   328:  *
   329:  *  If rawflag is nonzero, then the TLB contents isn't formated nicely,
   330:  *  just dumped.
   331:  */
   332: void m88k_cpu_tlbdump(struct cpu* cpu, int rawflag)
   333: {
   334: 	int cpu_nr = -1, cmmu_nr, i;
   335: 
   336: 	for (i = 0; i < cpu->machine->ncpus; ++i)
   337: 		if (cpu == cpu->machine->cpus[i])
   338: 			cpu_nr = i;
   339: 
   340: 	/*  #380: the idle-fold counters print FIRST, before the CMMU loop --
   341: 	    on the test machines every cmmu[] slot is NULL, so this line is
   342: 	    the only tlbdump output there, and the probe regexes depend on it.  */
   343: 	printf("cpu%i: idle_fold installs=%" PRIu64 "/%" PRIu64 "/%" PRIu64
   344: 	    " n_taken_plain=%" PRIu64 " n_taken_n=%" PRIu64
   345: 	    " slot_runs=%" PRIu64 " in_delayslot=%" PRIu64 "\n", cpu_nr,
   346: 	    cpu->cd.m88k.idle_fold_installs[0],
   347: 	    cpu->cd.m88k.idle_fold_installs[1],
   348: 	    cpu->cd.m88k.idle_fold_installs[2],
   349: 	    cpu->cd.m88k.idle_fold_n_taken_plain,
   350: 	    cpu->cd.m88k.idle_fold_n_taken_n,
   351: 	    cpu->cd.m88k.idle_fold_slot_runs,
   352: 	    cpu->cd.m88k.idle_fold_in_delayslot);
   353: 
   354: 	for (cmmu_nr = 0; cmmu_nr < MAX_M8820X_CMMUS; cmmu_nr++) {
   355: 		struct m8820x_cmmu *cmmu = cpu->cd.m88k.cmmu[cmmu_nr];
   356: 		if (cmmu == NULL)
   357: 			continue;
   358: 
   359: 		printf("cpu%i: CMMU %i (%s)\n", cpu_nr, cmmu_nr,
   360: 		    cmmu_nr & 1? "data" : "instruction");
   361: 
   362: 		/*  BATC:  */
   363: 		for (i = 0; i < N_M88200_BATC_REGS; i++) {
   364: 			uint32_t b = cmmu->batc[i];
   365: 			printf("cpu%i: BATC[%2i]: ", cpu_nr, i);
   366: 			printf("v=0x%08" PRIx32, b & 0xfff80000);
   367: 			printf(", p=0x%08" PRIx32,
   368: 			    (b << 13) & 0xfff80000);
   369: 			printf(", %s %s %s %s %s %s\n",
   370: 			    b & BATC_SO? "SP " : "!sp",
   371: 			    b & BATC_WT? "WT " : "!wt",
   372: 			    b & BATC_GLOBAL? "G  " : "!g ",
   373: 			    b & BATC_INH? "CI " : "!ci",
   374: 			    b & BATC_PROT? "WP " : "!wp",
   375: 			    b & BATC_SO? "V " : "!v");
   376: 		}
   377: 
   378: 		/*  PATC:  */
   379: 		for (i = 0; i < N_M88200_PATC_ENTRIES; i++) {
   380: 			uint32_t v = cmmu->patc_v_and_control[i];
   381: 			uint32_t p = cmmu->patc_p_and_supervisorbit[i];
   382: 
   383: 			printf("cpu%i: patc[%2i]: ", cpu_nr, i);
   384: 			if (p & M8820X_PATC_SUPERVISOR_BIT)
   385: 				printf("superv");
   386: 			else
   387: 				printf("user  ");
   388: 			printf(" v=0x%08" PRIx32, v & 0xfffff000);
   389: 			printf(", p=0x%08" PRIx32, p & 0xfffff000);
   390: 
   391: 			printf("  %s %s %s %s %s %s %s",
   392: 			    v & PG_U1?   "U1 " : "!u1",
   393: 			    v & PG_U0?   "U0 " : "!u0",
   394: 			    v & PG_SO?   "SP " : "!sp",
   395: 			    v & PG_M?    "M "  : "!m",
   396: 			    v & PG_U?    "U "  : "!u",
   397: 			    v & PG_PROT? "WP " : "!wp",
   398: 			    v & PG_V?    "V "  : "!v");
   399: 
   400: 			if (i == cmmu->patc_update_index)
   401: 				printf(" <--");
   402: 			printf("\n");
   403: 		}
   404: 	}
   405: }
   406: 
   407: 
   408: /*
   409:  *  m88k_irq_interrupt_assert():
   410:  *  m88k_irq_interrupt_deassert():
   411:  */
   412: void m88k_irq_interrupt_assert(struct interrupt *interrupt)
   413: {
   414: 	struct cpu *cpu = (struct cpu *) interrupt->extra;
   415: 	cpu->cd.m88k.irq_asserted = 1;
   416: }
   417: void m88k_irq_interrupt_deassert(struct interrupt *interrupt)
   418: {
   419: 	struct cpu *cpu = (struct cpu *) interrupt->extra;
   420: 	cpu->cd.m88k.irq_asserted = 0;
   421: }
   422: 
   423: 
   424: /*
   425:  *  m88k_ldcr():
   426:  *
   427:  *  Read from a control register. Store the resulting value in a register
   428:  *  (pointed to by r32ptr).
   429:  */
   430: void m88k_ldcr(struct cpu *cpu, uint32_t *r32ptr, int cr)
   431: {
   432: 	uint32_t retval = cpu->cd.m88k.cr[cr];
   433: 
   434: 	switch (cr) {
   435: 
   436: 	case M88K_CR_PID:
   437: 	case M88K_CR_PSR:
   438: 	case M88K_CR_EPSR:
   439: 	case M88K_CR_SSBR:
   440: 	case M88K_CR_SXIP:
   441: 	case M88K_CR_SNIP:
   442: 	case M88K_CR_SFIP:
   443: 	case M88K_CR_VBR:
   444: 	case M88K_CR_DMD0:
   445: 	case M88K_CR_DMD1:
   446: 	case M88K_CR_DMD2:
   447: 	case M88K_CR_SR0:
   448: 	case M88K_CR_SR1:
   449: 	case M88K_CR_SR2:
   450: 	case M88K_CR_SR3:
   451: 		break;
   452: 
   453: 	case M88K_CR_DMT0:
   454: 	case M88K_CR_DMT1:
   455: 	case M88K_CR_DMT2:
   456: 		/*
   457: 		 *  Catch some possible internal errors in the emulator:
   458: 		 *
   459: 		 *  For valid memory Load transactions, the Destination Register
   460: 		 *  should not be zero.
   461: 		 *
   462: 		 *  The Byte Order bit should be the same as the CPU's.
   463: 		 */
   464: 		if (retval & DMT_VALID && !(retval & DMT_WRITE)) {
   465: 			if (DMT_DREGBITS(retval) == M88K_ZERO_REG) {
   466: 				debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   467: 				    "ldcr: DMT DREG = zero? Internal error.");
   468: 				cpu->running = false;
   469: 				return;
   470: 			}
   471: 		}
   472: 		if (!!(cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_BO)
   473: 		    != !!(retval & DMT_BO) && retval & DMT_VALID) {
   474: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   475: 			    "ldcr: DMT byte order not same as CPUs?");
   476: 			cpu->running = false;
   477: 			return;
   478: 		}
   479: 
   480: 		break;
   481: 
   482: 	case M88K_CR_DMA0:
   483: 	case M88K_CR_DMA1:
   484: 	case M88K_CR_DMA2:
   485: 		/*
   486: 		 *  Catch some possible internal errors in the emulator:
   487: 		 *  The lowest 2 bits of the transaction address registers
   488: 		 *  should always be zero.
   489: 		 */
   490: 		if (retval & 3) {
   491: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   492: 			    "ldcr: DMAx not word-aligned? Internal error.");
   493: 			cpu->running = false;
   494: 			return;
   495: 		}
   496: 
   497: 		break;
   498: 
   499: 	default:debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   500: 		    "ldcr: UNIMPLEMENTED cr = 0x%02x (%s)\n",
   501: 		    cr, m88k_cr_name(cpu, cr));
   502: 		cpu->running = false;
   503: 		return;
   504: 	}
   505: 
   506: 	*r32ptr = retval;
   507: }
   508: 
   509: 
   510: /*
   511:  *  m88k_stcr():
   512:  *
   513:  *  Write to a control register.
   514:  *  (Used by both the stcr and rte instructions.)
   515:  */
   516: void m88k_stcr(struct cpu *cpu, uint32_t value, int cr, int rte)
   517: {
   518: 	uint32_t old = cpu->cd.m88k.cr[cr];
   519: 
   520: 	switch (cr) {
   521: 
   522: 	case M88K_CR_PSR:	/*  Processor Status Register  */
   523: 		if ((cpu->byte_order == EMUL_LITTLE_ENDIAN
   524: 		    && !(value & M88K_PSR_BO)) ||
   525: 		    (cpu->byte_order == EMUL_BIG_ENDIAN
   526: 		    && (value & M88K_PSR_BO))) {
   527: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   528: 			    "stcr: TODO: attempt to change endianness by flipping"
   529: 			    " the endianness bit in the PSR. How should this"
   530: 			    " be handled? Aborting.");
   531: 			cpu->running = false;
   532: 			return;
   533: 		}
   534: 
   535: 		if (!rte && old & M88K_PSR_MODE && !(value & M88K_PSR_MODE))
   536: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_WARNING,
   537: 			    "stcr: WARNING! the PSR_MODE bit is being"
   538: 			    " cleared; this should be done using the RTE "
   539: 			    "instruction only, according to the M88100 "
   540: 			    "manual! Continuing anyway.");
   541: 
   542: 		if (value & M88K_PSR_MXM) {
   543: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   544: 			    "stcr: TODO: MXM support");
   545: 			cpu->running = false;
   546: 			return;
   547: 		}
   548: 
   549: 		if ((old & M88K_PSR_MODE) != (value & M88K_PSR_MODE))
   550: 			cpu->invalidate_translation_caches(
   551: 			    cpu, 0, INVALIDATE_ALL);
   552: 
   553: 		cpu->cd.m88k.cr[cr] = value;
   554: 		break;
   555: 
   556: 	case M88K_CR_EPSR:
   557: 		cpu->cd.m88k.cr[cr] = value;
   558: 		break;
   559: 
   560: 	case M88K_CR_SXIP:
   561: 	case M88K_CR_SNIP:
   562: 	case M88K_CR_SFIP:
   563: 		cpu->cd.m88k.cr[cr] = value;
   564: 		break;
   565: 
   566: 	case M88K_CR_SSBR:	/*  Shadow ScoreBoard Register  */
   567: 		if (value & 1)
   568: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_WARNING,
   569: 			    "stcr: WARNING! bit 0 non-zero when"
   570: 			    " writing to SSBR (?)");
   571: 
   572: 		cpu->cd.m88k.cr[cr] = value;
   573: 		break;
   574: 
   575: 	case M88K_CR_VBR:
   576: 		if (value & 0x00000fff)
   577: 			debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_WARNING,
   578: 			    "stcr: WARNING! bits 0..11 non-zero when"
   579: 			    " writing to VBR (?)");
   580: 
   581: 		cpu->cd.m88k.cr[cr] = value;
   582: 		break;
   583: 
   584: 	case M88K_CR_DMT0:
   585: 	case M88K_CR_DMT1:
   586: 	case M88K_CR_DMT2:
   587: 		cpu->cd.m88k.cr[cr] = value;
   588: 		break;
   589: 
   590: 	case M88K_CR_SR0:	/*  Supervisor Storage Registers 0..3  */
   591: 	case M88K_CR_SR1:
   592: 	case M88K_CR_SR2:
   593: 	case M88K_CR_SR3:
   594: 		cpu->cd.m88k.cr[cr] = value;
   595: 		break;
   596: 
   597: 	default:debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_ERROR,
   598: 		    "stcr: UNIMPLEMENTED cr = 0x%02x (%s)",
   599: 		    cr, m88k_cr_name(cpu, cr));
   600: 		cpu->running = false;
   601: 		return;
   602: 	}
   603: }
   604: 
   605: 
   606: /*
   607:  *  m88k_fstcr():
   608:  *
   609:  *  Write to a floating-point control register.
   610:  */
   611: void m88k_fstcr(struct cpu *cpu, uint32_t value, int fcr)
   612: {
   613: 	switch (fcr) {
   614: 
   615: 	case 63:
   616: 		/*  #298: the FPCR's RM field (bits 15:14) is now decoded by
   617: 		    the single-precision result stores, so a guest calling
   618: 		    fpsetround() -- which writes exactly this field -- is
   619: 		    doing something IMPLEMENTED, and warning "UNIMPLEMENTED"
   620: 		    for it would be dishonest (a panel seat's finding, same
   621: 		    class as #270). Warn only for bits outside RM, which
   622: 		    really are ignored.  */
   623: 		if ((value & ~(uint32_t)M88K_FPCR_RM_MASK) == 0)
   624: 			break;
   625: 
   626: 		// fall through
   627: 
   628: 	case 0:
   629: 	case 62:
   630: 		// Don't warn for writes with the value zero for these, for now.
   631: 		if (value == 0)
   632: 			break;
   633: 
   634: 		// fall through
   635: 
   636: 	default:debugmsg_cpu(cpu, SUBSYS_CPU, "m88k", VERBOSITY_WARNING,
   637: 		    "WARNING: fstcr: write 0x%08x to UNIMPLEMENTED fcr = 0x%02x (%s)",
   638: 		    value, fcr, m88k_fcr_name(cpu, fcr));
   639: 	}
   640: 
   641: 	cpu->cd.m88k.fcr[fcr] = value;
   642: }
   643: 
   644: 
   645: /*
   646:  *  m88k_memory_transaction_debug_dump():
   647:  *
   648:  *  Debug dump of the memory transaction registers of a cpu.
   649:  */
   650: static void m88k_memory_transaction_debug_dump(struct cpu *cpu, int n)
   651: {
   652: 	uint32_t dmt = cpu->cd.m88k.dmt[n];
   653: 
   654: 	debug("[ DMT%i: ", n);
   655: 	if (dmt & DMT_VALID) {
   656: 		if (dmt & DMT_BO)
   657: 			debug("Little-Endian, ");
   658: 		else
   659: 			debug("Big-Endian, ");
   660: 		if (dmt & DMT_DAS)
   661: 			debug("Supervisor, ");
   662: 		else
   663: 			debug("User, ");
   664: 		if (dmt & DMT_DOUB1)
   665: 			debug("DOUB1, ");
   666: 		if (dmt & DMT_LOCKBAR)
   667: 			debug("LOCKBAR, ");
   668: 		if (dmt & DMT_WRITE)
   669: 			debug("store, ");
   670: 		else {
   671: 			debug("load.%c(r%i), ",
   672: 			    dmt & DMT_SIGNED? 's' : 'u',
   673: 			    DMT_DREGBITS(dmt));
   674: 		}
   675: 		debug("bytebits=0x%x ]\n", DMT_ENBITS(dmt));
   676: 
   677: 		debug("[ DMD%i: 0x%08" PRIx32"; ", n, cpu->cd.m88k.dmd[n]);
   678: 		debug("DMA%i: 0x%08" PRIx32" ]\n", n, cpu->cd.m88k.dma[n]);
   679: 	} else
   680: 		debug("not valid ]\n");
   681: }
   682: 
   683: 
   684: /*
   685:  *  m88k_exception():
   686:  *
   687:  *  Cause an exception.
   688:  */
   689: void m88k_exception(struct cpu *cpu, int vector, int is_trap)
   690: {
   691: 	bool update_shadow_regs = true;
   692: 	bool implemented = false;
   693: 
   694: 	// TODO: Use a const char * instead or something like that, inside the switch...
   695: 
   696: 	switch (vector) {
   697: 
   698: 	case M88K_EXCEPTION_RESET:
   699: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "RESET", VERBOSITY_INFO, "");
   700: 		implemented = true;
   701: 		break;
   702: 
   703: 	case M88K_EXCEPTION_INTERRUPT:
   704: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "INTERRUPT", VERBOSITY_INFO, "");
   705: 		implemented = true;
   706: 		break;
   707: 
   708: 	case M88K_EXCEPTION_INSTRUCTION_ACCESS:
   709: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "INSTRUCTION_ACCESS", VERBOSITY_INFO, "");
   710: 		implemented = true;
   711: 		break;
   712: 
   713: 	case M88K_EXCEPTION_DATA_ACCESS:
   714: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "DATA_ACCESS", VERBOSITY_INFO, "");
   715: 		implemented = true;
   716: 		break;
   717: 
   718: 	case M88K_EXCEPTION_MISALIGNED_ACCESS:
   719: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "MISALIGNED_ACCESS", VERBOSITY_INFO, "");
   720: 		implemented = true;	/*  m88kexcdeliver  */
   721: 		break;
   722: 
   723: 	case M88K_EXCEPTION_UNIMPLEMENTED_OPCODE:
   724: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "UNIMPLEMENTED_OPCODE", VERBOSITY_INFO, "");
   725: 		implemented = true;	/*  m88kexcdeliver  */
   726: 		break;
   727: 
   728: 	case M88K_EXCEPTION_PRIVILEGE_VIOLATION:
   729: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "PRIVILEGE_VIOLATION", VERBOSITY_INFO, "");
   730: 		implemented = true;	/*  m88kexcdeliver  */
   731: 		break;
   732: 
   733: 	case M88K_EXCEPTION_BOUNDS_CHECK_VIOLATION:
   734: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "BOUNDS_CHECK_VIOLATION", VERBOSITY_INFO, "");
   735: 		implemented = true;	/*  m88kexcdeliver  */
   736: 		break;
   737: 
   738: 	case M88K_EXCEPTION_ILLEGAL_INTEGER_DIVIDE:
   739: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "ILLEGAL_INTEGER_DIVIDE", VERBOSITY_INFO, "");
   740: 		implemented = true;	/*  m88kexcdeliver  */
   741: 		break;
   742: 
   743: 	case M88K_EXCEPTION_INTEGER_OVERFLOW:
   744: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "INTEGER_OVERFLOW", VERBOSITY_INFO, "");
   745: 		implemented = true;	/*  m88kexcdeliver  */
   746: 		break;
   747: 
   748: 	case M88K_EXCEPTION_ERROR:
   749: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "ERROR", VERBOSITY_INFO, "");
   750: 		implemented = true;	/*  m88kexcdeliver  */
   751: 		break;
   752: 
   753: 	case M88K_EXCEPTION_SFU1_PRECISE:
   754: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "SFU1_PRECISE", VERBOSITY_ERROR, "");
   755: 		break;
   756: 
   757: 	case M88K_EXCEPTION_SFU1_IMPRECISE:
   758: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "SFU1_IMPRECISE", VERBOSITY_ERROR, "");
   759: 		break;
   760: 
   761: 	case 0x80:	/*  up to OpenBSD 5.2  */
   762: 	case 0x1c2:	/*  from OpenBSD 5.3 and forward...  */
   763: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "syscall", VERBOSITY_INFO,
   764: 		    "r13=%i", cpu->cd.m88k.r[13]);
   765: #if 0
   766: 		fatal("[ syscall %i(", cpu->cd.m88k.r[13]);
   767: 		m88k_cpu_functioncall_trace(cpu, 8);
   768: 		fatal(") ]\n");
   769: #endif
   770: 		break;
   771: 
   772: 	case MVMEPROM_VECTOR:
   773: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "MVMEPROM_VECTOR", VERBOSITY_INFO, "");
   774: 		break;
   775: 
   776: 	default:
   777: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "unknown vector",
   778: 		    vector < M88K_EXCEPTION_USER_TRAPS_START ? VERBOSITY_ERROR
   779: 		    : VERBOSITY_INFO, "0x%03x", vector);
   780: 	}
   781: 
   782: 	/*
   783: 	 *  m88kexcdeliver (2026-09-05): the seven trap-like classes above are
   784: 	 *  DELIVERED (VBR + 8*vector, SXIP = the faulting instruction, SNIP = the
   785: 	 *  next one, destination register unchanged -- MC88100 UM 6.4.3/6.5/6.6/
   786: 	 *  6.8.3), like the four this fallback never covered.  Before, any of them
   787: 	 *  stopped EVERY guest CPU here: one divu by zero, in either mode, ended
   788: 	 *  the emulation (measured: regress/m88k_exc_probe.py rows div0/udiv0).
   789: 	 *  Pre-existing upstream code (this fallback is the 0.7.0 import),
   790: 	 *  surfaced by the 2026-09-05 retrospective of #380.  What still lands
   791: 	 *  here, by design: SFU1_PRECISE/IMPRECISE (114/115; row m88kexcsfu1 --
   792: 	 *  faithful delivery needs the rest of the SFU1 exception state, which
   793: 	 *  the fork does not write) and vectors 11..113/116..127 (117 vectors
   794: 	 *  with the two SFU1 ones), which no literal-constant raise site names
   795: 	 *  but a supervisor tb0/tb1/tcnd can name directly (row
   796: 	 *  m88kexctaildefault; the probe's resid50/sfu1h rows pin that they
   797: 	 *  STILL halt).
   798: 	 */
   799: 	if (vector < M88K_EXCEPTION_USER_TRAPS_START && !implemented) {
   800: 		debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "unimplemented",
   801: 		    VERBOSITY_ERROR, "vector=0x%03x pc=0x%08x",
   802: 			vector,
   803: 			(int)cpu->pc);
   804: 		for (int j = 0; j < cpu->machine->ncpus; ++j)
   805: 			cpu->machine->cpus[j]->running = false;
   806: 		m88k_pc_to_pointers(cpu);
   807: 		return;
   808: 	}
   809: 
   810: 	/*  Stuff common for all exceptions:  */
   811: 	if (cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_SFRZ) {
   812: 		/*
   813: 		 *  Non-trap exceptions when the shadow freeze bit is already
   814: 		 *  set result in an Error exception:
   815: 		 */
   816: 		if (!is_trap) {
   817: 			vector = M88K_EXCEPTION_ERROR;
   818: 			fatal("[ SFRZ already set in PSR => ERROR ]\n");
   819: 		}
   820: 
   821: 		update_shadow_regs = false;
   822: 	} else {
   823: 		/*  Freeze shadow registers, and save the PSR:  */
   824: 		cpu->cd.m88k.cr[M88K_CR_EPSR] = cpu->cd.m88k.cr[M88K_CR_PSR];
   825: 	}
   826: 
   827: 	m88k_stcr(cpu, cpu->cd.m88k.cr[M88K_CR_PSR]
   828: 	    | M88K_PSR_SFRZ	/*  Freeze shadow registers,          */
   829: 	    | M88K_PSR_IND	/*  disable interrupts,               */
   830: 	    | M88K_PSR_SFD1	/*  disable the floating point unit,  */
   831: 	    | M88K_PSR_MODE,	/*  and switch to supervisor mode.    */
   832: 	    M88K_CR_PSR, 0);
   833: 
   834: 	if (update_shadow_regs) {
   835: 		cpu->cd.m88k.cr[M88K_CR_SSBR] = 0;
   836: 
   837: 		cpu->cd.m88k.cr[M88K_CR_SXIP] = cpu->pc | M88K_XIP_V;
   838: 
   839: 		/*  SNIP is the address to return to, when executing rte:  */
   840: 		if (cpu->delay_slot) {
   841: 			if (vector == M88K_EXCEPTION_DATA_ACCESS) {
   842: 				cpu->cd.m88k.cr[M88K_CR_SNIP] = cpu->cd.m88k.delay_target | M88K_NIP_V;
   843: 				cpu->cd.m88k.cr[M88K_CR_SFIP] = cpu->cd.m88k.cr[M88K_CR_SNIP]+4;
   844: 			} else if (vector == M88K_EXCEPTION_INSTRUCTION_ACCESS) {
   845: 				/*  If we are in a delay slot, then pc is
   846: 				    something like 0xc6000 here (not 0xc5ffc).  */
   847: 				cpu->cd.m88k.cr[M88K_CR_SNIP] = cpu->cd.m88k.delay_target | M88K_NIP_V;
   848: 				cpu->cd.m88k.cr[M88K_CR_SFIP] = 0;
   849: 			} else {
   850: 				/*  Perhaps something like this could work:  */
   851: 				cpu->cd.m88k.cr[M88K_CR_SNIP] = (cpu->pc + 4) | M88K_NIP_V;
   852: 				cpu->cd.m88k.cr[M88K_CR_SFIP] = cpu->cd.m88k.delay_target | M88K_NIP_V;
   853: 			}
   854: 		} else {
   855: 			cpu->cd.m88k.cr[M88K_CR_SNIP] = (cpu->pc + 4) | M88K_NIP_V;
   856: 			cpu->cd.m88k.cr[M88K_CR_SFIP] = cpu->cd.m88k.cr[M88K_CR_SNIP]+4;
   857: 		}
   858: 
   859: 		if (vector == M88K_EXCEPTION_INSTRUCTION_ACCESS)
   860: 			cpu->cd.m88k.cr[M88K_CR_SXIP] |= M88K_XIP_E;
   861: 	}
   862: 
   863: 	cpu->pc = cpu->cd.m88k.cr[M88K_CR_VBR] + 8 * vector;
   864: 
   865: 	if (cpu->delay_slot)
   866: 		cpu->delay_slot = EXCEPTION_IN_DELAY_SLOT;
   867: 	else
   868: 		cpu->delay_slot = NOT_DELAYED;
   869: 
   870: 	/*  Default to no memory transactions:  */
   871: 	cpu->cd.m88k.cr[M88K_CR_DMT0] = 0;
   872: 	cpu->cd.m88k.cr[M88K_CR_DMD0] = 0;
   873: 	cpu->cd.m88k.cr[M88K_CR_DMA0] = 0;
   874: 	cpu->cd.m88k.cr[M88K_CR_DMT1] = 0;
   875: 	cpu->cd.m88k.cr[M88K_CR_DMD1] = 0;
   876: 	cpu->cd.m88k.cr[M88K_CR_DMA1] = 0;
   877: 	cpu->cd.m88k.cr[M88K_CR_DMT2] = 0;
   878: 	cpu->cd.m88k.cr[M88K_CR_DMD2] = 0;
   879: 	cpu->cd.m88k.cr[M88K_CR_DMA2] = 0;   880:    889: 			break;
   890: 
   891: 		case M88K_EXCEPTION_INTERRUPT:
   892: 			/*  When returning with rte, we want to re-  */
   893: 			/*  execute the interrupted instruction:  */
   894: 			cpu->cd.m88k.cr[M88K_CR_SNIP] -= 4;
   895: 			cpu->cd.m88k.cr[M88K_CR_SFIP] -= 4;
   896: 			break;
   897: 
   898: 		case M88K_EXCEPTION_INSTRUCTION_ACCESS:
   899: 			/*  When returning with rte, we want to re-  */
   900: 			/*  execute the instruction in SXIP, not SNIP/SFIP,  */
   901: 			/*  (unless the exception was in a delay-slot):  */
   902: 			if (!(cpu->delay_slot & EXCEPTION_IN_DELAY_SLOT)) {
   903: 				cpu->cd.m88k.cr[M88K_CR_SNIP] = 0;
   904: 				cpu->cd.m88k.cr[M88K_CR_SFIP] = 0;
   905: 			}
   906: 			break;
   907: 
   908: 		case M88K_EXCEPTION_DATA_ACCESS:
   909: 			/*  Update the memory transaction registers:  */
   910: 			cpu->cd.m88k.cr[M88K_CR_DMT0] = cpu->cd.m88k.dmt[0];
   911: 			cpu->cd.m88k.cr[M88K_CR_DMD0] = cpu->cd.m88k.dmd[0];
   912: 			cpu->cd.m88k.cr[M88K_CR_DMA0] = cpu->cd.m88k.dma[0];
   913: 			cpu->cd.m88k.cr[M88K_CR_DMT1] = cpu->cd.m88k.dmt[1];
   914: 			cpu->cd.m88k.cr[M88K_CR_DMD1] = cpu->cd.m88k.dmd[1];
   915: 			cpu->cd.m88k.cr[M88K_CR_DMA1] = cpu->cd.m88k.dma[1];
   916: 			cpu->cd.m88k.cr[M88K_CR_DMT2] = 0;
   917: 			cpu->cd.m88k.cr[M88K_CR_DMD2] = 0;
   918: 			cpu->cd.m88k.cr[M88K_CR_DMA2] = 0;
   919: 			m88k_memory_transaction_debug_dump(cpu, 0);
   920: 			m88k_memory_transaction_debug_dump(cpu, 1);
   921: 			break;
   922: 
   923: 		case M88K_EXCEPTION_MISALIGNED_ACCESS:
   924: 		case M88K_EXCEPTION_UNIMPLEMENTED_OPCODE:
   925: 		case M88K_EXCEPTION_PRIVILEGE_VIOLATION:
   926: 		case M88K_EXCEPTION_BOUNDS_CHECK_VIOLATION:
   927: 		case M88K_EXCEPTION_ILLEGAL_INTEGER_DIVIDE:
   928: 		case M88K_EXCEPTION_INTEGER_OVERFLOW:
   929: 		case M88K_EXCEPTION_ERROR:
   930: 			/*  m88kexcdeliver: OUTSIDE A DELAY SLOT the common path above
   931: 			    is already the architectural contract for these -- SXIP =
   932: 			    the faulting instruction, SNIP = the next one, SFIP = SNIP+4,
   933: 			    and rte resumes at SNIP (UM 6.4.3.1.4: "the processor
   934: 			    hardware does not use the SXIP on return from an exception"),
   935: 			    so the upstream doubt that sat here in an #if 0 ("should the
   936: 			    PC be backed up one step?") is answered NO: 6.5.x/6.8.3 say
   937: 			    the destination register is unchanged (6.6: and the carry
   938: 			    bit, for the overflow case), and a handler that wants
   939: 			    re-execution arranges SNIP/SFIP itself.  INSIDE a delay slot
   940: 			    the else-arm above ("Perhaps something like this could
   941: 			    work") is upstream's guess and the manual disagrees (Table
   942: 			    6-3: the shadows copy XIP/NIP/FIP, and UM 6.2 defines FIP as
   943: 			    the taken branch's target while the branch executes, so for
   944: 			    a fault in its delay slot NIP = target, FIP = target+4) --
   945: 			    pre-existing, now reachable by ordinary faults, row
   946: 			    m88kdslotshadow.
   947: 			    Without these labels the classes reached the default: below,
   948: 			    which stops the cpu -- the one-site fix was measured to do
   949: 			    exactly that; with them, nothing below 128 reaches that
   950: 			    default any more (it is unreachable code kept as the
   951: 			    tripwire for an eighth class).  ERROR arrives here by TWO
   952: 			    routes: the SFRZ re-route above (a fault inside a handler,
   953: 			    shadows deliberately frozen at the FIRST fault's values --
   954: 			    SXIP then names that first fault, not this one) and a
   955: 			    supervisor tb0/tb1/tcnd naming vector 10 directly (shadows
   956: 			    updated normally when that trap is taken UNFROZEN; inside a
   957: 			    handler it takes the is_trap exemption above and arrives
   958: 			    here with the shadows frozen).  Not modelled, disclosed: scoreboard
   959: 			    capture (the shadow-update path writes SSBR = 0; a frozen
   960: 			    SSBR keeps its old value) and fcr2/fcr4/fcr5 for the divide.  */
   961: 			break;
   962: 
   963: #if 0
   964: 		// TODO: Read up more about SFU1 exceptions and how the
   965: 		// control registers look when they happen.
   966: 		case M88K_EXCEPTION_SFU1_PRECISE:
   967: 			cpu->cd.m88k.cr[M88K_CR_SNIP] = 0; //?
   968: 			cpu->cd.m88k.cr[M88K_CR_SFIP] = 0;
   969: 			//cpu->cd.m88k.cr[M88K_CR_SNIP] -= 4;
   970: 			//cpu->cd.m88k.cr[M88K_CR_SFIP] -= 4;
   971: 			break;
   972: #endif
   973: 
   974: 		default:debugmsg_cpu(cpu, SUBSYS_EXCEPTION, "m88k",
   975: 			    VERBOSITY_ERROR, "internal error");
   976: 			cpu->running = false;
   977: 		}
   978: 	}
   979: 
   980: 	m88k_pc_to_pointers(cpu);
   981: }
   982: 
   983: 
   984: /*
   985:  *  m88k_cpu_disassemble_instr():
   986:  *
   987:  *  Convert an instruction word into human readable format, for instruction
   988:  *  tracing.
   989:  *              
   990:  *  If running is 1, cpu->pc should be the address of the instruction.
   991:  *
   992:  *  If running is 0, things that depend on the runtime environment (eg.
   993:  *  register contents) will not be shown, and dumpaddr will be used instead of
   994:  *  cpu->pc for relative addresses.
   995:  */                     
   996: int m88k_cpu_disassemble_instr(struct cpu *cpu, unsigned char *ib,
   997:         int running, uint64_t dumpaddr)
   998: {
   999: 	int supervisor = cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_MODE;
  1000: 	uint32_t iw;
  1001: 	const char *symbol, *mnem = NULL;
  1002: 	uint64_t offset;
  1003: 	uint32_t op26, op10, op11, d, s1, s2, w5, cr6, imm16;
  1004: 	int32_t d16, d26;
  1005: 
  1006: 	if (running)
  1007: 		dumpaddr = cpu->pc;
  1008: 
  1009: 	symbol = get_symbol_name(&cpu->machine->symbol_context,
  1010: 	    dumpaddr, &offset);
  1011: 	if (symbol != NULL && offset == 0 && supervisor)
  1012: 		debug("<%s>\n", symbol);
  1013: 
  1014: 	if (cpu->machine->ncpus > 1 && running)
  1015: 		debug("cpu%i:\t", cpu->cpu_id);
  1016: 
  1017: 	debug("%c%08" PRIx32": ",
  1018: 	    cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_MODE? 's' : 'u',
  1019: 	    (uint32_t) dumpaddr);
  1020: 
  1021: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
  1022: 		iw = ib[0] + (ib[1]<<8) + (ib[2]<<16) + ((uint32_t)ib[3]<<24);
  1023: 	else
  1024: 		iw = ib[3] + (ib[2]<<8) + (ib[1]<<16) + ((uint32_t)ib[0]<<24);
  1025: 
  1026: 	debug("%08" PRIx32, (uint32_t) iw);
  1027: 
  1028: 	if (running && cpu->delay_slot)
  1029: 		debug(" (d)");
  1030: 	else
  1031: 		debug("    ");
  1032: 
  1033: 	cpu_print_pc_indicator_in_disassembly(cpu, running, dumpaddr);
  1034: 
  1035: 	op26   = (iw >> 26) & 0x3f;
  1036: 	op11   = (iw >> 11) & 0x1f;
  1037: 	op10   = (iw >> 10) & 0x3f;
  1038: 	d      = (iw >> 21) & 0x1f;
  1039: 	s1     = (iw >> 16) & 0x1f;
  1040: 	s2     =  iw        & 0x1f;
  1041: 	imm16  = iw & 0xffff;
  1042: 	w5     = (iw >>  5) & 0x1f;
  1043: 	cr6    = (iw >>  5) & 0x3f;
  1044: 	d16    = ((int16_t) (iw & 0xffff)) * 4;
  1045: 	d26    = ((int32_t)((iw & 0x03ffffff) << 6)) >> 4;
  1046: 
  1047: 	switch (op26) {
  1048: 
  1049: 	case 0x00:	/*  xmem.bu  */
  1050: 	case 0x01:	/*  xmem     */
  1051: 	case 0x02:	/*  ld.hu    */
  1052: 	case 0x03:	/*  ld.bu    */
  1053: 	case 0x04:	/*  ld.d     */
  1054: 	case 0x05:	/*  ld       */
  1055: 	case 0x06:	/*  ld.h     */
  1056: 	case 0x07:	/*  ld.b     */
  1057: 	case 0x08:	/*  st.d     */
  1058: 	case 0x09:	/*  st       */
  1059: 	case 0x0a:	/*  st.h     */
  1060: 	case 0x0b:	/*  st.b     */
  1061: 		if (iw == 0x00000000) {
  1062: 			debug("-\n");
  1063: 			break;
  1064: 		}
  1065: 		switch (op26) {
  1066: 		case 0x00:  debug("xmem.bu"); break;
  1067: 		case 0x01:  debug("xmem"); break;
  1068: 		case 0x02:  debug("ld.hu"); break;
  1069: 		case 0x03:  debug("ld.bu"); break;
  1070: 		default:    debug("%s%s", op26 >= 0x08? "st" : "ld",
  1071: 				memop[op26 & 3]);
  1072: 		}
  1073: 		debug("\tr%i,r%i,0x%x", d, s1, imm16);
  1074: 		if (running) {
  1075: 			uint32_t tmpaddr = cpu->cd.m88k.r[s1] + imm16;
  1076: 			symbol = get_symbol_name(&cpu->machine->symbol_context,
  1077: 			    tmpaddr, &offset);
  1078: 			if (symbol != NULL && supervisor)
  1079: 				debug("\t; [<%s>]", symbol);
  1080: 			else
  1081: 				debug("\t; [0x%08" PRIx32"]", tmpaddr);
  1082: 			if (op26 >= 0x08) {
  1083: 				/*  Store:  */
  1084: 				debug(" = ");
  1085: 				switch (op26 & 3) {
  1086: 				case 0:	debug("0x%016" PRIx64, (uint64_t)
  1087: 					    ((((uint64_t) cpu->cd.m88k.r[d])
  1088: 					    << 32) + ((uint64_t)
  1089: 					    cpu->cd.m88k.r[d+1])) );
  1090: 					break;
  1091: 				case 1:	debug("0x%08" PRIx32,
  1092: 					    (uint32_t) cpu->cd.m88k.r[d]);
  1093: 					break;
  1094: 				case 2:	debug("0x%04" PRIx16,
  1095: 					    (uint16_t) cpu->cd.m88k.r[d]);
  1096: 					break;
  1097: 				case 3:	debug("0x%02" PRIx8,
  1098: 					    (uint8_t) cpu->cd.m88k.r[d]);
  1099: 					break;
  1100: 				}
  1101: 			} else {
  1102: 				/*  Load:  */
  1103: 				/*  TODO  */
  1104: 			}
  1105: 		} else {
  1106: 			/*
  1107: 			 *  Not running, but the following instruction
  1108: 			 *  sequence is quite common:
  1109: 			 *
  1110: 			 *  or.u      rX,r0,A
  1111: 			 *  st_or_ld  rY,rX,B
  1112: 			 */
  1113: 
  1114: 			/*  Try loading the instruction before the
  1115: 			    current one.  */
  1116: 			uint32_t iw2 = 0;
  1117: 			cpu->memory_rw(cpu, cpu->mem,
  1118: 			    dumpaddr - sizeof(uint32_t), (unsigned char *)&iw2,
  1119: 			    sizeof(iw2), MEM_READ, CACHE_INSTRUCTION
  1120: 			    | NO_EXCEPTIONS);
  1121: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
  1122: 				 iw2 = LE32_TO_HOST(iw2);
  1123: 			else
  1124: 				 iw2 = BE32_TO_HOST(iw2);
  1125: 			if ((iw2 >> 26) == 0x17 &&	/*  or.u  */
  1126: 			    ((iw2 >> 21) & 0x1f) == s1) {
  1127: 				uint32_t tmpaddr = (iw2 << 16) + imm16;
  1128: 				symbol = get_symbol_name(
  1129: 				    &cpu->machine->symbol_context,
  1130: 				    tmpaddr, &offset);
  1131: 				if (symbol != NULL && supervisor)
  1132: 					debug("\t; [<%s>]", symbol);
  1133: 				else
  1134: 					debug("\t; [0x%08" PRIx32"]", tmpaddr);
  1135: 			}
  1136: 		}
  1137: 		debug("\n");
  1138: 		break;
  1139: 
  1140: 	case 0x10:	/*  and     */
  1141: 	case 0x11:	/*  and.u   */
  1142: 	case 0x12:	/*  mask    */
  1143: 	case 0x13:	/*  mask.u  */
  1144: 	case 0x14:	/*  xor     */
  1145: 	case 0x15:	/*  xor.u   */
  1146: 	case 0x16:	/*  or      */
  1147: 	case 0x17:	/*  or.u    */
  1148: 		if (d == M88K_ZERO_REG)
  1149: 			debug("nop");
  1150: 
  1151: 		switch (op26) {
  1152: 		case 0x10:
  1153: 		case 0x11:	mnem = "and"; break;
  1154: 		case 0x12:
  1155: 		case 0x13:	mnem = "mask"; break;
  1156: 		case 0x14:
  1157: 		case 0x15:	mnem = "xor"; break;
  1158: 		case 0x16:
  1159: 		case 0x17:	mnem = "or"; break;
  1160: 		}
  1161: 
  1162: 		if (d != M88K_ZERO_REG || op26 != 0x16 || s1 != M88K_ZERO_REG) {
  1163: 			if (d == M88K_ZERO_REG)
  1164: 				debug("\t\t; weird nop encoding: ");
  1165: 			debug("%s%s\t", mnem, op26 & 1? ".u" : "");
  1166: 			debug("r%i,r%i,0x%x", d, s1, imm16);
  1167: 		}
  1168: 
  1169: 		if (op26 == 0x16 && d != M88K_ZERO_REG) {
  1170: 			/*
  1171: 			 *  The following instruction sequence is common:
  1172: 			 *
  1173: 			 *  or.u   rX,r0,A
  1174: 			 *  or     rY,rX,B	; rY = AAAABBBB
  1175: 			 */
  1176: 
  1177: 			/*  Try loading the instruction before the
  1178: 			    current one.  */
  1179: 			uint32_t iw2 = 0;
  1180: 			cpu->memory_rw(cpu, cpu->mem,
  1181: 			    dumpaddr - sizeof(uint32_t), (unsigned char *)&iw2,
  1182: 			    sizeof(iw2), MEM_READ, CACHE_INSTRUCTION
  1183: 			    | NO_EXCEPTIONS);
  1184: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
  1185: 				 iw2 = LE32_TO_HOST(iw2);
  1186: 			else
  1187: 				 iw2 = BE32_TO_HOST(iw2);
  1188: 			if ((iw2 >> 26) == 0x17 &&	/*  or.u  */
  1189: 			    ((iw2 >> 21) & 0x1f) == s1) {
  1190: 				uint32_t tmpaddr = (iw2 << 16) + imm16;
  1191: 				symbol = get_symbol_name(
  1192: 				    &cpu->machine->symbol_context,
  1193: 				    tmpaddr, &offset);
  1194: 				debug("\t; ");
  1195: 				if (symbol != NULL && supervisor)
  1196: 					debug("<%s>", symbol);
  1197: 				else
  1198: 					debug("0x%08" PRIx32, tmpaddr);
  1199: 			}
  1200: 		}
  1201: 
  1202: 		debug("\n");
  1203: 		break;
  1204: 
  1205: 	case 0x18:	/*  addu    */
  1206: 	case 0x19:	/*  subu    */
  1207: 	case 0x1a:	/*  divu    */
  1208: 	case 0x1b:	/*  mulu    */
  1209: 	case 0x1c:	/*  add    */
  1210: 	case 0x1d:	/*  sub    */
  1211: 	case 0x1e:	/*  div    */
  1212: 	case 0x1f:	/*  cmp    */
  1213: 		switch (op26) {
  1214: 		case 0x18:	mnem = "addu"; break;
  1215: 		case 0x19:	mnem = "subu"; break;
  1216: 		case 0x1a:	mnem = "divu"; break;
  1217: 		case 0x1b:	mnem = "mulu"; break;
  1218: 		case 0x1c:	mnem = "add"; break;
  1219: 		case 0x1d:	mnem = "sub"; break;
  1220: 		case 0x1e:	mnem = "div"; break;
  1221: 		case 0x1f:	mnem = "cmp"; break;
  1222: 		}
  1223: 		debug("%s\tr%i,r%i,%i\n", mnem, d, s1, imm16);
  1224: 		break;
  1225: 
  1226: 	case 0x20:
  1227: 		if ((iw & 0x001ff81f) == 0x00004000) {
  1228: 			debug("ldcr\tr%i,%s", d, m88k_cr_name(cpu, cr6));
  1229: 			if (running)
  1230: 				debug("\t\t; %s = 0x%08x", m88k_cr_name(cpu, cr6), cpu->cd.m88k.cr[cr6]);
  1231: 			debug("\n");
  1232: 		} else if ((iw & 0x001ff81f) == 0x00004800) {
  1233: 			debug("fldcr\tr%i,%s\n", d, m88k_fcr_name(cpu, cr6));
  1234: 		} else if ((iw & 0x03e0f800) == 0x00008000) {
  1235: 			debug("stcr\tr%i,%s", s1, m88k_cr_name(cpu, cr6));
  1236: 			if (s1 != s2)
  1237: 				debug("\t\t; NOTE: weird encoding: "
  1238: 				    "low 5 bits = 0x%02x", s2);
  1239: 			if (running)
  1240: 				debug("\t\t; r%i = 0x%08x", s1, cpu->cd.m88k.r[s1]);
  1241: 			debug("\n");
  1242: 		} else if ((iw & 0x03e0f800) == 0x00008800) {
  1243: 			debug("fstcr\tr%i,%s", s1,
  1244: 			    m88k_fcr_name(cpu, cr6));
  1245: 			if (s1 != s2)
  1246: 				debug("\t\t; NOTE: weird encoding: "
  1247: 				    "low 5 bits = 0x%02x", s2);
  1248: 			debug("\n");
  1249: 		} else if ((iw & 0x0000f800) == 0x0000c000) {
  1250: 			debug("xcr\tr%i,r%i,%s", d, s1,
  1251: 			    m88k_cr_name(cpu, cr6));
  1252: 			if (s1 != s2)
  1253: 				debug("\t\t; NOTE: weird encoding: "
  1254: 				    "low 5 bits = 0x%02x", s2);
  1255: 			debug("\n");
  1256: 		} else if ((iw & 0x0000f800) == 0x0000c800) {
  1257: 			debug("fxcr\tr%i,r%i,%s", d, s1,
  1258: 			    m88k_fcr_name(cpu, cr6));
  1259: 			if (s1 != s2)
  1260: 				debug("\t\t; NOTE: weird encoding: "
  1261: 				    "low 5 bits = 0x%02x", s2);
  1262: 			debug("\n");
  1263: 		} else {
  1264: 			debug("UNIMPLEMENTED 0x20\n");
  1265: 		}
  1266: 		break;
  1267: 
  1268: 	case 0x21:
  1269: 		switch (op11) {
  1270: 		case 0x00:	/*  fmul  */
  1271: 		case 0x05:	/*  fadd  */
  1272: 		case 0x06:	/*  fsub  */
  1273: 		case 0x07:	/*  fcmp  */
  1274: 		case 0x0e:	/*  fdiv  */
  1275: 			switch (op11) {
  1276: 			case 0x00: mnem = "fmul"; break;
  1277: 			case 0x05: mnem = "fadd"; break;
  1278: 			case 0x06: mnem = "fsub"; break;
  1279: 			case 0x07: mnem = "fcmp"; break;
  1280: 			case 0x0e: mnem = "fdiv"; break;
  1281: 			}
  1282: 			debug("%s.%c%c%c r%i,r%i,r%i\n",
  1283: 			    mnem,
  1284: 			    ((iw >> 5) & 1)? 'd' : 's',
  1285: 			    ((iw >> 9) & 1)? 'd' : 's',
  1286: 			    ((iw >> 7) & 1)? 'd' : 's',
