    95: /*
    96:  *  m88k_cpu_new():
    97:  *
    98:  *  Create a new M88K cpu object by filling the CPU struct.
    99:  *  Return 1 on success, 0 if cpu_type_name isn't a valid M88K processor.
   100:  */
   101: int m88k_cpu_new(struct cpu *cpu, struct memory *mem,
   102: 	struct machine *machine, int cpu_id, char *cpu_type_name)
   103: {
   104: 	int i, found;
   105: 	struct m88k_cpu_type_def cpu_type_defs[] = M88K_CPU_TYPE_DEFS;
   106: 
   107: 	/*  Scan the list for this cpu type:  */
   108: 	i = 0; found = -1;
   109: 	while (i >= 0 && cpu_type_defs[i].name != NULL) {
   110: 		if (strcasecmp(cpu_type_defs[i].name, cpu_type_name) == 0) {
   111: 			found = i;
   112: 			break;
   113: 		}
   114: 		i++;
   115: 	}
   116: 	if (found == -1)
   117: 		return 0;
   118: 
   119: 	cpu->run_instr = m88k_run_instr;
   120: 	cpu->memory_rw = m88k_memory_rw;
   121: 	cpu->update_translation_table = m88k_update_translation_table;
   122: 	cpu->invalidate_translation_caches =
   123: 	    m88k_invalidate_translation_caches;
   124: 	cpu->invalidate_code_translation = m88k_invalidate_code_translation;
   125: 	cpu->translate_v2p = m88k_translate_v2p;
   126: 
   127: 	cpu->cd.m88k.cpu_type = cpu_type_defs[found];
   128: 	cpu->name            = strdup(cpu->cd.m88k.cpu_type.name);
   129: 	cpu->is_32bit        = 1;
   130: 	cpu->byte_order      = EMUL_BIG_ENDIAN;
   131: 
   132: 	cpu->instruction_has_delayslot = m88k_cpu_instruction_has_delayslot;
   133: 
   134: 	cpu->vaddr_mask = 0x00000000ffffffffULL;
   135: 
   136: 
   137: 	/*
   138: 	 *  Add register names as settings:
   139: 	 */
   140: 
   141: 	CPU_SETTINGS_ADD_REGISTER64("pc", cpu->pc);
   142: 
   143: 	for (i=0; i<N_M88K_REGS; i++) {
   144: 		char name[10];
   145: 		snprintf(name, sizeof(name), "r%i", i);
   146: 		CPU_SETTINGS_ADD_REGISTER32(name, cpu->cd.m88k.r[i]);
   147: 	}
   148: 
   149: 	for (i=0; i<N_M88K_CONTROL_REGS; i++) {
   150: 		char name[10];
   151: 		snprintf(name, sizeof(name), "%s", m88k_cr_name(cpu, i));
   152: 		CPU_SETTINGS_ADD_REGISTER32(name, cpu->cd.m88k.cr[i]);
   153: 	}
   154: 
   155: 	for (i=0; i<N_M88K_FPU_CONTROL_REGS; i++) {
   156: 		char name[10];
   157: 		snprintf(name, sizeof(name), "%s", m88k_fcr_name(cpu, i));
   158: 		CPU_SETTINGS_ADD_REGISTER32(name, cpu->cd.m88k.fcr[i]);
   159: 	}
   160: 
   161: 
   162: 	/*  Register the CPU interrupt pin:  */
   163: 	{
   164: 		struct interrupt templ;
   165: 		char name[50];
   166: 		snprintf(name, sizeof(name), "%s", cpu->path);
   167: 
   168: 		memset(&templ, 0, sizeof(templ));
   169: 		templ.line = 0;
   170: 		templ.name = name;
   171: 		templ.extra = cpu;
   172: 		templ.interrupt_assert = m88k_irq_interrupt_assert;
   173: 		templ.interrupt_deassert = m88k_irq_interrupt_deassert;
   174: 		interrupt_handler_register(&templ);
   175: 	}
   176: 
   177: 	/*  Set the Processor ID:  */
   178: 	cpu->cd.m88k.cr[M88K_CR_PID] = cpu->cd.m88k.cpu_type.pid | M88K_PID_MC;
   179: 
   180: 	/*  Start in supervisor mode, with interrupts disabled.  */
   181: 	cpu->cd.m88k.cr[M88K_CR_PSR] = M88K_PSR_MODE | M88K_PSR_IND;
   182: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
   183: 		cpu->cd.m88k.cr[M88K_CR_PSR] |= M88K_PSR_BO;
   184: 
   185: 	/*  Initial stack pointer:  */
   186: 	cpu->cd.m88k.r[31] = 1048576 * cpu->machine->physical_ram_in_mb - 1024;
   187: 
   188: 	return 1;
   189: }
