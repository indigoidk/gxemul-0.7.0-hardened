   205:  *  m88k_cpu_list_available_types():
   206:  *
   207:  *  Print a list of available M88K CPU types.
   208:  */
   209: void m88k_cpu_list_available_types(void)
   210: {
   211: 	int i, j;
   212: 	struct m88k_cpu_type_def tdefs[] = M88K_CPU_TYPE_DEFS;
   213: 
   214: 	i = 0;
   215: 	while (tdefs[i].name != NULL) {
   216: 		debug("%s", tdefs[i].name);
   217: 		for (j=13 - strlen(tdefs[i].name); j>0; j--)
   218: 			debug(" ");
   219: 		i++;
   220: 		if ((i % 5) == 0 || tdefs[i].name == NULL)
   221: 			debug("\n");
   222: 	}
   223: }
