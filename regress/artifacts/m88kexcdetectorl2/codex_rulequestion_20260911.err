   423:     #
   424:     #  IT IS KEPT PENDING THE 2026-09-09 ADJUDICATION, and the reason is the same seat's own next paragraph:
   425:     #  after removal, SFD1 coverage rests entirely on trapfrozenuser, whose PSR_FRZUSER (0x03) is SHARED with
   426:     #  errpriv and errunimpl -- so changing it to 0x0b would preserve THEIR routes while silently removing the
   427:     #  only SFD1-clear stimulus, and BASE alone would not notice.  Remove-or-keep is a RULE QUESTION about what
   428:     #  the addition licence authorises when redundancy buys a failure signature, and the carrier sends rule
   429:     #  questions to the flagship seat at the next round boundary.  Row m88ksfd1row carries it.
   430:     #
   431:     #  WHATEVER IS DECIDED: any edit to PSR_FRZUSER owes a re-check of the pre-trap bit values and a repeat of
   432:     #  BOTH named mutant measurements.  That obligation is independent of the row's fate.
   433:     ("trapfrozenuser", [DIVU_R2_R3_R0],         {"r3": 0x11, "r5": PSR_FRZUSER},  V_USER0,   0x10004, PSR_RESET,
   434:                  [STCR_R5_CR1, TB1_0_R3_128]),                # frozen handler drops to USER mode, then a user trap at
   435:                                                               # 128: >= USER_TRAPS_START so the fallback does not claim
   436:                                                               # it, and X(tb1) checks privilege only for vector < 128 --
   437:                                                               # so the re-route sees is_trap with MODE CLEAR.  r3 = 0x11:
   438:                                                               # bit 0 must be SET or tb1 does not trap at all
   439:     ("trapfrozensfd1", [DIVU_R2_R3_R0],         {"r3": 0x11, "r5": PSR_FRZSUP},   V_BOUNDS,  0x10004, PSR_RESET,
   440:                  [STCR_R5_CR1, TB1_0_R3_7]),                  # frozen, SFD1 CLEAR, same trap as trapfrozenind
   441:     ("usfu1",    [STCR_R5_CR1, DIVU_R6_R5_R4],  {"r5": PSR_USERSFD1, "r4": 0x10}, V_SFU1,    0x10008, PSR_USERSFD1, None),
   442:     ("sfu1h",    [DIVU_R2_R3_R0],               {"r3": 0x10, "r5": 0x60, "r4": 0x10}, V_SFU1, 0x10004, PSR_RESET,
   443:                  [DIVU_R6_R5_R4]),                             # handler at 0x40: a legal divu with SFD1 set -> SFU1 (114) -> fallback HALT
   444:     ("live",     [DIVU_R2_R3_R4],               {"r3": 0x60, "r4": 0x10},        None,       None,    None,      None),
   445:     ("attrib",   [DIVU_R2_R3_R4],               {"r3": 0x10, "r4": 0x10},        None,       None,    None,      None),
