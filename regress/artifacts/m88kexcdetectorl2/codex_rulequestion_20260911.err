   226: /*
   227:  *  m88k_cpu_instruction_has_delayslot():
   228:  *
   229:  *  Returns 1 if an opcode has a delay slot after it, 0 otherwise.
   230:  */
   231: int m88k_cpu_instruction_has_delayslot(struct cpu *cpu, unsigned char *ib)
   232: {
   233: 	uint32_t iword = *((uint32_t *)&ib[0]);
   234: 
   235: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
   236: 		iword = LE32_TO_HOST(iword);
   237: 	else
   238: 		iword = BE32_TO_HOST(iword);
   239: 
   240: 	switch (iword >> 26) {
   241: 	case 0x31:	/*  br.n  */
   242: 	case 0x33:	/*  bsr.n  */
   243: 	case 0x35:	/*  bb0.n  */
   244: 	case 0x37:	/*  bb1.n  */
   245: 	case 0x3b:	/*  bcnd.n  */
   246: 		return 1;
   247: 	case 0x3d:
   248: 		switch ((iword >> 8) & 0xff) {
   249: 		case 0xc4:	/*  jmp.n  */
   250: 		case 0xcc:	/*  jsr.n  */
   251: 			return 1;
   252: 		}
   253: 	}
   254: 
   255: 	return 0;
   256: }
