   447: EXPECT_R2 = {"live": 6, "attrib": 1}
   448: VBR_OF = {"vbrtb": VBR_TEST}                     # rows that relocate the vector table; every other row runs with VBR == 0
   449: #  NEGATIVE CONTROLS: rows whose CORRECT result is the fallback HALT.  They pin the boundary the diff keeps on purpose --
   450: #  vectors 11..113/116..127 and SFU1 (114/115) still stop the machine -- and separate the shipped D1 form from the rejected
   451: #  D4 (tail-default-delivers) and from delivering SFU1 (row m88kexcsfu1).  A mutant that delivers them turns these rows RED.
   452: EXPECT_RESULT = {"resid50": "HALT", "resid127": "HALT", "resid11": "HALT", "resid50ind": "HALT", "resid50c": "HALT", "resid50ser": "HALT", "sfu1h": "HALT", "usfu1": "HALT"}
   453: PSR_WANT = {"errc": 0x9000000b,   # v14: exception entry ORs MODE|SFRZ|IND|SFD1 and leaves C alone (mc88100 manual: "the shadow freeze,
   454:                                   #      SFD1, and IND bits of the PSR are set"), so the C-set handler row keeps C -- table 11 BASE read
   455:                                   #      45/46 bad=psr on this row before any mutant: a MIS-CUT ROW, not the fix (case 3)
   456:             "ovfc": 0x9000000b,                  # MODE | C | SFD1 | IND | SFRZ: carry PRESERVED through the exception path
   457:             "unimpltbc": 0xb000000b, "privtbc": 0xb000000b, "boundstbc": 0xb000000b,
   458:             "div0tbc": 0xb000000b, "errortbc": 0xb000000b, "ovftbser": 0xb000000b,   # v17: entry ORs MODE|SFRZ|IND|SFD1 onto
   459:                                                  # 0xb0000000 and leaves BOTH C and SER alone -- the same fact ovfc pinned for C
   460:             "trapfrozenc": 0x9000000b,           # a frozen trap keeps the carry it was given
   461:             "trapfrozenser": 0xa000000b,         # ... and keeps SER, which the common path also leaves alone
   462:             "errser": 0xa000000b}                # v17: the non-trap re-route with SER set -- also the MISALIGNED x SER cell
   463: #  indclr wants the default PSR_EXC (0x8000000b): IND was CLEAR before the fault and must be SET by the exception path;
   464: #  EPSR keeps the pre-fault 0x80000000.  A write that drops `| M88K_PSR_IND' leaves 0x80000009 -> bad=psr.
   465: EXPECT_VECTOR = {"resid50": 0x032, "resid127": 0x07f, "resid11": 0x00b, "resid50ind": 0x032, "resid50c": 0x032, "resid50ser": 0x032, "sfu1h": 0x072, "usfu1": 0x072}
   466: #  (the vector the fallback diagnostic must NAME for an expected-HALT row -- the comment that used to trail the dict above)
   467: #  refatal: the re-route prints `[ SFRZ already set in PSR => ERROR ]' (fatal() is a plain print in this fork); a re-routed non-trap row
   468: #  must SEE it, a frozen-trap row must NOT -- the channel that tells the exemption arm from the re-route arm when both land on 0x50
   469: #  (kimi, pass 6: the class-10 "equivalent" disclosure was false for the composite).
   470: REFATAL = "SFRZ already set in PSR"
   471: REFATAL_EXPECT = {"error": True, "errovf": True, "errdiv0": True, "errpriv": True, "errunimpl": True, "errind": True, "errc": True, "errser": True,
   472:                   "trapfrozen": False, "trapfrozen4": False, "trapfrozen5": False, "trapfrozen6": False, "trapfrozen8": False,
   473:                   "trapfrozen9": False, "trapfrozen10": False, "trapfrozen128": False, "trapfrozen450": False, "trapfrozen496": False, "trapfrozen511": False,
   474:                   "trapfrozenind": False, "trapfrozenc": False, "trapfrozenser": False,
   475:                   "trapfrozenuser": False, "trapfrozensfd1": False}   # v19: the exemption must hold with MODE and
   476:                   #      SFD1 clear too -- and this is the CHANNEL that makes the two rows non-vacuous, because the
   477:                   #      mutant re-routes the trap and the diagnostic then APPEARS where these expect none
   478: #  (v12 COPIED this dict's trailing comment up to EXPECT_VECTOR, where it belongs, and claimed to have REMOVED it here.
   479: #   It had not: the file carried it twice.  v16 then tried to delete it with a find-text that was only a PREFIX of the
   480: #   old sentence, so `.replace()` left the tail behind and produced the nonsense `claimed tognostic must NAME for an
   481: #   expected-HALT row'.  Found by grok on pass 9, reading the shipped file rather than the diff.  THE LESSON IS THE
   482: #   SECOND FAILURE, not the first: a correction is not safer than the thing it corrects, and this one shipped a worse
   483: #   sentence than the duplicate it was removing.  A deletion whose find-text is a PREFIX must match to end-of-line.)
   484: 
   485: class Sess:
   486:     def __init__(self):
   487:         stub = "/tmp/gx_m88k_exc_%d.bin" % os.getpid()
   488:         with open(stub, "wb") as f:
   489:             f.write(struct.pack(">I", 0xf4005800))          # or r0,r0,r0 so the machine constructs
   490:         self.pid, self.fd = pty.fork()
   491:         if self.pid == 0:
   492:             os.execvp(BIN, [BIN, "-V", "-E", "testm88k", "-M", "64", "0x10000:%s" % stub])
   493:             os._exit(127)
   494:         self.buf = ""
   495:     def rd(self, t=0.4):
   496:         r, _, _ = select.select([self.fd], [], [], t)
   497:         if self.fd not in r:
   498:             return True
   499:         try:
   500:             d = os.read(self.fd, 65536)
   501:         except OSError:
   502:             return False
   503:         if not d:
   504:             return False
   505:         self.buf += d.decode("latin1", "replace")
   506:         return True
   507:     def wait_prompt(self, mark, timeout=30):
   508:         t = time.time()
   509:         while time.time() - t < timeout:
   510:             if not self.rd():
   511:                 return False
   512:             if len(self.buf) > mark and self.buf[mark:].rstrip().endswith("GXemul>"):
   513:                 return True
   514:         return False
   515:     def send(self, sx, timeout=30):
   516:         mark = len(self.buf)
   517:         b = (sx + "\n").encode("latin1"); n = 0
   518:         while n < len(b):
   519:             n += os.write(self.fd, b[n:])
   520:         self.wait_prompt(mark, timeout)
   521:         return mark
   522:     def cr(self, name):
   523:         m = self.send("reg 0,0")
   524:         mm = re.search(r"(?<![A-Z])%s=0x([0-9a-f]{8})" % name, self.buf[m:])
   525:         return int(mm.group(1), 16) if mm else None
   526:     def gpr(self, n):
   527:         m = self.send("reg")
   528:         mm = re.search(r"r%-2d\s*=\s*0x([0-9a-f]{8})" % n, self.buf[m:])
   529:         return int(mm.group(1), 16) if mm else None
   530:     def pc(self):
   531:         m = self.send("reg")
   532:         mm = re.search(r"pc\s*=\s*0x([0-9a-f]{8})", self.buf[m:])
   533:         return int(mm.group(1), 16) if mm else None
   534:     def close(self):
   535:         try:
   536:             os.write(self.fd, b"quit\n"); time.sleep(0.3); os.kill(self.pid, 9); os.waitpid(self.pid, 0)
   537:         except Exception:
   538:             pass
   539: 
   540: def fmt(v):
   541:     return ("0x%08x" % v) if isinstance(v, int) else str(v)
   542: 
   543: def run_row(name, prog, regs, vector, fault_pc, epsr_exp, handler, grace=6.0, handler_at=None):
   544:     if handler_at is None:
   545:         handler_at = V_DIV0                              # the first fault of every two-fault row is DIV0 unless the row says otherwise
   546:     s = Sess()
   547:     if not s.wait_prompt(0, 60):
   548:         s.close(); return dict(result="NOBOOT")
   549:     vbr = VBR_OF.get(name, 0)
   550:     entry = (vbr + 8 * vector) if vector is not None else None
   551:     words = [MARK] + prog + [SELF]
   552:     for i, w in enumerate(words):
   553:         s.send("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
   554:     for base in sorted({0, vbr}):                       # every entry spins unless a handler is planted (both tables if relocated)
   555:         for v in VECTORS:
   556:             s.send("put w 0x%x, 0x%08x" % (base + 8 * v, SELF))
   557:     if entry is not None:
   558:         s.send("put w 0x%x, 0x%08x" % (entry, SELF))
   559:     if handler:
   560:         for i, w in enumerate(handler):
   561:             s.send("put w 0x%x, 0x%08x" % (8 * handler_at + 4 * i, w))
   562:         s.send("put w 0x%x, 0x%08x" % (8 * handler_at + 4 * len(handler), SELF))
   563:     s.send("put w 0x%x, 0x%08x" % (DATA, 0x0badf00d))
   564:     for r, v in regs.items():
   565:         s.send("%s=0x%x" % (r, v))
   566:     s.send("r10=0x12345678"); s.send("r2=0xdeadbeef")
   567:     if vector is not None:
   568:         s.send("breakpoint add 0x%x" % entry)
   569:     s.send("pc=0x%x" % CODE)
   570:     mark = len(s.buf)
   571:     os.write(s.fd, b"continue\n")
   572:     t = time.time()
   573:     while time.time() - t < grace:
   574:         s.rd(0.3)
   575:         if s.buf[mark:].rstrip().endswith("GXemul>"):
   576:             break
   577:     if not s.buf[mark:].rstrip().endswith("GXemul>"):
   578:         os.write(s.fd, b"\x03"); s.wait_prompt(len(s.buf), 15)
   579:     tr = s.buf[mark:]
   580:     #  HALT is the fallback's diagnostic AND the machine-stopped observation (codex, pass 3: a mutant that keeps the
   581:     #  message and drops the stop would otherwise classify as HALT); an expected-HALT row must also see ITS vector named.
   582:     diag = re.search(r"unimplemented[^\r\n]*vector=0x([0-9a-f]+)", tr)
   583:     stopped = "machines stopped" in tr           # emul.c's `All machines stopped.' -- the ONE stop observation (pass 4:
   584:     halted = diag is not None and stopped        # an `or "stopped" in tr' disjunct had made the exact term dead code)
   585:     if halted and name in EXPECT_VECTOR and int(diag.group(1), 16) != EXPECT_VECTOR[name]:
   586:         halted = False                              # halted on some OTHER vector: not the row's answer
   587:     #  LEVEL channel (Fable review seat, pass 2): main.c lowers every subsystem to WARNING after startup, so a
   588:     #  free-running `continue' prints an ERROR-level `[ exception <CLASS>: ]' line and stays silent at INFO.  A
   589:     #  delivered row that carries the line has the pre-fix level (M_LEVEL) -- #261's opt-in break-on-ERROR would
   590:     #  then stop the emulator into the debugger on a user process's divide by zero.
   591:     levelmsg = re.search(r"exception (MISALIGNED_ACCESS|UNIMPLEMENTED_OPCODE|PRIVILEGE_VIOLATION|"
   592:                          r"BOUNDS_CHECK_VIOLATION|ILLEGAL_INTEGER_DIVIDE|INTEGER_OVERFLOW|ERROR)", tr) is not None
   593:     tailhalt = "internal error" in tr
   594:     pc = s.pc(); r2 = s.gpr(2); r9 = s.gpr(9)
   595:     sxip, snip, sfip, psr, epsr = s.cr("SXIP"), s.cr("SNIP"), s.cr("SFIP"), s.cr("PSR"), s.cr("EPSR")
   596:     s.close()
   597:     started = (r9 == 0x12345678)
   598:     res = dict(pc=pc, sxip=sxip, snip=snip, sfip=sfip, psr=psr, epsr=epsr, r2=r2, transcript=tr)
   599:     if not started:
   600:         res["result"] = "NOSTART"; return res
   601:     if vector is None:
   602:         ok = (not stopped) and r2 == EXPECT_R2[name]
   603:         res["result"] = "DONE" if ok else ("STOP" if stopped else "BADREGS"); return res
   604:     if halted:
   605:         res["result"] = "HALT"
   606:         if name == "sfu1h" and pc != 8 * V_DIV0:
   607:             res["result"] = "BADREGS"; res["bad"] = ["stage1"]   # halted before the handler ran (the pre-fix shape)
   608:     elif tailhalt:
   609:         res["result"] = "TAILHALT"
   610:     elif stopped:
   611:         res["result"] = "STOP"
   612:     elif pc != entry:
   613:         res["result"] = "STOP"          # ran past its grace without the entry breakpoint firing
   614:     else:
   615:         want = dict(sxip=(fault_pc | XIP_V), psr=PSR_WANT.get(name, PSR_EXC), epsr=epsr_exp, r2=0xdeadbeef)
   616:         if name in ("error", "trapfrozen", "errovf", "errdiv0", "errpriv", "errunimpl", "errind", "errc", "errser",
   617:                     "trapfrozen4", "trapfrozen5", "trapfrozen6", "trapfrozen8", "trapfrozen9", "trapfrozen10", "trapfrozen128",
   618:                     "trapfrozen450", "trapfrozen496", "trapfrozen511",
   619:                     "trapfrozenind", "trapfrozenc", "trapfrozenser", "trapfrozenuser", "trapfrozensfd1"):
   620:             # the second fault runs with SFRZ set: the shadows stay FROZEN at the first fault's values.  For
   621:             # `trapfrozen' the second fault is a TRAP, which the manual (:8633-8636, 6.10 :10613-10614) exempts from
   622:             # the ERROR re-route: it must deliver to ITS OWN vector (0x38), shadows still frozen.  M_SFRZTRAP sends it to 0x50.
   623:             want.update(sxip=(0x10004 | XIP_V), snip=(0x10008 | XIP_V), sfip=(0x1000c | XIP_V), epsr=PSR_RESET)
   624:         elif name == "dslot":
   625:             # the else-arm of the delay-slot branch: SNIP = (pc + 4) | V, SFIP = delay_target | V.  br.n +16 puts
   626:             # delay_target at 0x10014 while slot_pc+4 is 0x1000c, so the two channels are DIFFERENT numbers (with
   627:             # br.n +8 they were both 0x1000e and M_SFIPNOTGT / M_DSLOTSWAP escaped 10/10 -- Opus, pass 2).
   628:             want.update(snip=((fault_pc + 4) | XIP_V), sfip=((CODE + 4 + 16) | XIP_V))
   629:             assert want["snip"] != want["sfip"], "dslot geometry collapsed: SNIP and SFIP would be one number"
   630:         else:
   631:             want.update(snip=((fault_pc + 4) | XIP_V), sfip=((fault_pc + 8) | XIP_V))
   632:         bad = [k for k, v in want.items() if res.get(k) != v]
   633:         if name in REFATAL_EXPECT and ((REFATAL in tr) != REFATAL_EXPECT[name]):
   634:             bad.append("refatal")                      # the re-route's diagnostic present where the exemption should hold, or absent where the re-route fired
   635:         if levelmsg:
   636:             bad.append("level")
   637:         res["result"] = "DELIVER" if not bad else "BADREGS"
   638:         res["bad"] = bad
   639:     return res
   640: 
   641: def selftest():
   642:     s = Sess()
   643:     ok = s.wait_prompt(0, 60)
   644:     psr = s.cr("PSR") if ok else None
   645:     s.close()
   646:     return psr == PSR_RESET, psr
   647: 
   648: def main():
   649:     ok, psr = selftest()
   650:     print("M88KEXC_SELFTEST=%s psr_at_reset=%s (want 0x80000002)" % ("OK" if ok else "FAIL", fmt(psr)), flush=True)
   651:     delivered = 0; total = 0; controls_bad = []
   652:     for row in ROWS:
   653:         name, prog, regs, vector, fault_pc, epsr_exp, handler = row[:7]
   654:         handler_at = row[7] if len(row) > 7 else V_DIV0
   655:         res = run_row(name, prog, regs, vector, fault_pc, epsr_exp, handler, handler_at=handler_at)
   656:         print("M88KEXC_ROW=%-9s RESULT=%-8s pc=%s sxip=%s snip=%s sfip=%s psr=%s epsr=%s r2=%s%s" % (
   657:             name, res.get("result"), fmt(res.get("pc")), fmt(res.get("sxip")), fmt(res.get("snip")),
   658:             fmt(res.get("sfip")), fmt(res.get("psr")), fmt(res.get("epsr")), fmt(res.get("r2")),
   659:             (" bad=" + ",".join(res["bad"])) if res.get("bad") else ""), flush=True)
   660:         if vector is not None:
   661:             total += 1
   662:             if res.get("result") == EXPECT_RESULT.get(name, "DELIVER"):
   663:                 delivered += 1
   664:         elif res.get("result") != "DONE":
   665:             controls_bad.append(name)
   666:         if os.environ.get("M88KEXC_VERBOSE"):
   667:             print("---- transcript ----"); print(res.get("transcript", "")[-1200:]); print("--------------------")
   668:     print("M88KEXC_RESULT=%d/%d" % (delivered, total), flush=True)
   669:     if controls_bad:
   670:         print("M88KEXC_CONTROLS=BAD %s" % ",".join(controls_bad), flush=True)
   671:     print("M88KEXC_DONE", flush=True)
   672:     #  exit status: the gate can rely on it (a row printing a failure word while the process exits 0 was a pass-2 finding)
   673:     sys.exit(0 if (ok and delivered == total and not controls_bad) else 1)
   674: 
   675: if __name__ == "__main__":
   676:     main()

