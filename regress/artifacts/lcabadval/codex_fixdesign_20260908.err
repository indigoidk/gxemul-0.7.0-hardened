#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#include "cpu.h"
#include "device.h"
#include "devices.h"
#include "machine.h"
#include "memory.h"
#include "misc.h"

#include "thirdparty/alpha_autoconf.h"
#include "thirdparty/alpha_rpb.h"


MACHINE_SETUP(alpha)
{
	struct rpb rpb;
	struct crb crb;
	struct ctb ctb;
	struct mddt mddt;
	struct pcs *pcs = (struct pcs *) malloc(sizeof(struct pcs) * machine->ncpus);
	int i;

	switch (machine->machine_subtype) {

	case ST_ALPHABOOK1:
		machine->machine_name = strdup("AlphaBook 1");
		if (machine->emulated_hz == 0)
			machine->emulated_hz = 233000000;
		device_add(machine, "lca");
		break;

	case ST_DEC_4100:
		machine->machine_name = strdup("AlphaServer 4100");
		break;

	case ST_DEC_3000_300:
		machine->machine_name = strdup("DEC 3000/300");
		machine->main_console_handle = (size_t)device_add(machine,
		    "z8530 addr=0x1b0200000 irq=0 addr_mult=4");
		break;

	case ST_EB164:
		machine->machine_name = strdup("EB164");
		break;

	default:fatal("Unimplemented Alpha machine type %i\n",
		    machine->machine_subtype);
		exit(1);
	}

	if (!machine->prom_emulation)
		return;

	/*  These are used by NetBSD/alpha:  */
	/*  a0 = First free Page Frame Number  */
	/*  a1 = PFN of current Level 1 page table  */
	/*  a2 = Bootinfo magic  */
	/*  a3 = Bootinfo pointer  */
	/*  a4 = Bootinfo version  */
	cpu->cd.alpha.r[ALPHA_A0] = 16*1024*1024 / 8192;
	cpu->cd.alpha.r[ALPHA_A1] = 0;	/*  TODO  */
	cpu->cd.alpha.r[ALPHA_A2] = 0;	/*  Note: NOT ALPHA_BOOTINFO_MAGIC  */
	cpu->cd.alpha.r[ALPHA_A3] = 0;	/*  TODO  */
355: 
356: /*
357:  *  debug() and fatal():
358:  *
359:  *  These are here because of all the legacy code that uses them. Basically,
360:  *  debug() is mapped to something that is only displayed with verbosity
361:  *  at the default level, and fatal() is used to always print stuff. With some
362:  *  hacks to make it work reasonable with -q and when executing normally or
363:  *  when executing single-stepping.
364:  */
365: void debug(const char *fmt, ...)
366: {
367: 	va_list argp;
368: 	bool ss = single_step || about_to_enter_single_step;
369: 	int v = verbose;
370: 	if (emul_executing)
371: 		v--;
372: 	if (ss)
373: 		v++;
374: 
375: 	if ((quiet_mode && !ss) || v < 0)
376: 		return;
377: 
378: 	va_start(argp, fmt);
379: 	va_debug(argp, fmt);
380: 	va_end(argp);
381: }
382: 
383: 
384: void fatal(const char *fmt, ...)
385: {
386: 	va_list argp;
387: 
388: 	va_start(argp, fmt);
389: 	va_debug(argp, fmt);
390: 	va_end(argp);
391: }
