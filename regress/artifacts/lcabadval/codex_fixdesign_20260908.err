from pathlib import Path
import re, collections
counts=collections.Counter()
by_file=collections.defaultdict(collections.Counter)
lex=re.compile(r'//["'^'"\\n]*|/\\*.*?\\*/|\"(?:\\\\.|["'^"'"\\\\])*\"|\\'(?:\\\\.|["'^'"\\'\\\\])*\\'',re.S)
for path in Path('src/devices').rglob('*.c'):
    source=path.read_text(encoding='utf-8',errors='replace')
    stripped=lex.sub(lambda m: ('\\n'*m.group().count('\\n') if m.group().startswith(('/',)) else m.group()),source)
    for m in re.finditer(r'\"(?:\\\\.|["'^"'"\\\\])*\"(?:\\s*\"(?:\\\\.|["'^"'"\\\\])*\")*',stripped):
        msg=''.join(s[1:-1] for s in re.findall(r'\"(?:\\\\.|["'^"'"\\\\])*\"',m.group()))
        for marker in re.findall(r'\\(["'^)]*(?:once|suppress)[''^)]*'"\\)',msg,re.I):
            counts[marker]+=1
            by_file[marker][path.name]+=1
print('C string literals only; adjacent strings joined; comments excluded')
for marker,n in counts.most_common():
    print(n,repr(marker),dict(by_file[marker]))
