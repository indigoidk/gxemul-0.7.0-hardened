src\devices\dev_sh4.c:1022: 	uint64_t idata = 0, odata = 0;
src\devices\dev_sh4.c:1023: 	int e;
src\devices\dev_sh4.c:1024: 
src\devices\dev_sh4.c:1025: 	/*
src\devices\dev_sh4.c:1026: 	 *  #452: this ended the host process on one guest access.  What the model can
src\devices\dev_sh4.c:1027: 	 *  honestly say is only what the code says: array 2 is not implemented.  So the
src\devices\dev_sh4.c:1028: 	 *  access is CONSUMED with a defined result -- reads produce zero, writes are
src\devices\dev_sh4.c:1029: 	 *  discarded -- rather than aliased onto array 1, which would let a guest probing
src\devices\dev_sh4.c:1030: 	 *  da2 read and CORRUPT real translation entries through the shared `e`.
src\devices\dev_sh4.c:1031: 	 *
src\devices\dev_sh4.c:1032: 	 *  `return 1` and not 0, and the REASON is not the obvious one.  memory_rw.c:595
src\devices\dev_sh4.c:1033: 	 *  turns a 0 into -1 and :603 raises an architecture-specific fault -- but that block
src\devices\dev_sh4.c:1034: 	 *  has arms for MEM_MIPS and MEM_M88K ONLY.  `MEM_SH` appears nowhere in that file,
src\devices\dev_sh4.c:1035: 	 *  so on this architecture nothing is raised: the access just returns
src\devices\dev_sh4.c:1036: 	 *  MEMORY_ACCESS_FAILED, and cpu_sh_instr.c's load path (X(load_l_rm_rn), :739) then
src\devices\dev_sh4.c:1037: 	 *  returns WITHOUT ever assigning the destination register, leaving whatever it held.
src\devices\dev_sh4.c:1038: 	 *  Its own comment there claims an Exception, and no SH exception runs.
