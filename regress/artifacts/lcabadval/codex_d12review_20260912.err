   1: #!/usr/bin/env python3
   2: #
   3: #  lcabadval -- RUNG-3 WITNESS: SIX value-guarded write arms in `dev_lca.c' end the host process
   4: #  on values the 21066/21066A hardware manual makes LEGAL, one of which the manual REQUIRES SROM
   5: #  to write.
   6: #
   7: #  THE DEFECT.  `DEVICE_ACCESS(lca_ioc)' has six write arms of this shape:
   8: #
   9: #      case LCA_IOC_W_MASK0:
  10: #              ...
  11: #              d->window_mask_0 = idata;          <-- STORED FIRST, unconditionally
  12: #              if (idata != 0x700000ULL) {
  13: #                      fatal("TODO: LCA_IOC_W_MASK0 value differs (0x%" PRIx64") from the only"
  14: #                            " implemented value\n", (uint64_t)idata);
  15: #                      exit(1);                   <-- then the process ends
  16: #              }
  17: #
  18: #  The accepted sets, as enumerated from the predicates themselves (NOT from a table):
  19: #
  20: #      arm         offset   predicate                              accepted set
  21: #      IOC_CONF    +0x020   idata & ~1                             {0, 1}
  22: #      IOC_TB_ENA  +0x0a0   idata & ~IOC_TB_ENA_TEN   (~0x80)      {0, 0x80}
  23: #      W_BASE0     +0x100   idata != 0 && idata != 0x300800000     {0, 0x300800000}
  24: #      W_MASK0     +0x140   idata != 0x700000                      {0x700000}
  25: #      W_BASE1     +0x120   idata != 0x240000000                   {0x240000000}
  26: #      W_MASK1     +0x160   idata != 0x3ff00000                    {0x3ff00000}
  27: #
  28: #  *** THE GUARDS ARE WRONG, NOT MERELY HARSH, AND THE MANUAL IS WHAT SAYS SO. ***  Every `legal'
  29: #  row below drives a value the 21066/21066A HRM documents as legal for that register, and each
  30: #  one cites its own line in `_scratchpad/21066_66a_hrm.txt'.  The sharpest is W_BASE1: S6.4.14
  31: #  item 3 (:10791-10792) says SROM "Prevents the IOC from responding to itself by writing zero to
  32: #  the IOC_W_BASE1 and IOC_W_BASE0 registers".  ZERO IS THE VALUE THE INITIALISATION SEQUENCE IS
  33: #  REQUIRED TO WRITE, and at W_BASE1 it ends the emulator.  It is also the value the model's own
  34: #  register reads back before anyone writes it, so writing back what you just read is fatal.
  35: #
  36: #  THE MANUAL VALUES USED, each verified by reading the cited lines rather than taken from a seat:
  37: #
  38: #    CONF    -> 2      Table 6-10 (:10246-10254): bits <1:0> are the CFG AD<1:0> FIELD, so all
  39: #                      four encodings are legal.  S6.2.9 (:9217) says the same from the other end.
  40: #                      The guard accepts HALF of a documented two-bit field.
  41: #    TB_ENA  -> 0x81   Table 6-13 (:10443, :10453): bits 63:8 and 6:0 are RES of type X, and the
  42: #                      manual's own type legend (:985-988) defines X as "return UNPREDICTABLE
  43: #                      results when read and are IGNORED ON WRITE OPERATIONS".  0x81 differs from
  44: #                      the accepted 0x80 in exactly one bit the hardware is documented to IGNORE.
  45: #    W_BASE0 -> 0x280000000    Figure 6-9 (:10556-10560) and Table 6-16 (:10562-10583): WEN is
  46: #                      bit 33, SG bit 32, W_BASE<31:20> bits 31:20.  So this is WEN set, direct
  47: #                      mapping (SG clear), window base 0x80000000 -- naturally aligned to any
  48: #                      window size up to 2 GB, as :10538-10539 requires, and not overlapping the
  49: #                      base the fork accepts at the sibling register (:10540-10541).  Zero cannot
  50: #                      be used here: W_BASE0's guard is the one arm of the six that accepts it.
  51: #    W_MASK0 -> 0x100000       Table 6-6 (:9587), encoding `0000 0000 0001' = 2 MB window.
  52: #    W_BASE1 -> 0              S6.4.14 item 3 (:10791-10792), the SROM-required value.
  53: #    W_MASK1 -> 0xfff00000     Table 6-6 (:9598), encoding `1111 1111 1111' = 4 GB window.
  54: #
  55: #  Table 6-6 lists THIRTEEN legal W_MASK encodings (:9586-9598).  W_MASK0 accepts one of them and
  56: #  W_MASK1 accepts a different one, so TWELVE OF THIRTEEN are fatal at each register and neither
  57: #  register accepts the other's value.  DERIVE IT, do not trust this sentence:
  58: #      awk 'NR>=9586 && NR<=9598' _scratchpad/21066_66a_hrm.txt | wc -l      -> 13
  59: #  and each arm's predicate is a single `!=' against one constant, so the accepted set has size 1.
  60: #  (Note 1 MB is the encoding `0000 0000 0000' = 0x0, so writing ZERO to either mask register is a
  61: #  legal window size and is also fatal.)
  62: #
  63: #  *** THE FIGURE/TABLE STAGGER WAS CHECKED, NOT ASSUMED. ***  `pdftotext -layout' staggers
  64: #  Table 6-16's descriptions against its bit rows (:10566-10583 reads WEN's description beside
  65: #  SG's row), which is the extraction artefact the carrier warns about.  It is NOT relied on: the
  66: #  UNSTAGGERED Figure 6-9 (:10556-10560) gives the layout directly, and this tree's own
  67: #  `alpha_lcareg.h' independently pins IOC_W_BASE_WEN = bit 33, IOC_W_BASE_SG = bit 32,
  68: #  IOC_W_BASE_W_BASE = bits 31:20.  Three sources agree, so no single calibration point is
  69: #  load-bearing here.
  70: #
  71: #  ---------------------------------------------------------------------------------------------
  72: #  *** WHAT THIS IS AND IS NOT.  IT IS A WITNESS, NOT A DETECTOR. ***
  73: #
  74: #  It establishes: on unmodified `alphabook1', ONE ordinary guest `stq' of a manual-legal value to
  75: #  a documented LCA IOC register ends the host process, with that arm's own diagnostic as
  76: #  evidence, after the SAME register at the SAME width through the SAME path has just been proven
  77: #  live in the SAME process.  It does NOT establish that any shipped guest writes these values,
  78: #  and it is NOT a detector of the repair: `alive' greens equally for a silent accept, for a
  79: #  latched announce, for a decline that discards the value, and for a full implementation.  A fix
  80: #  round owes rows that discriminate those -- at minimum a readback row per arm proving what the
  81: #  repair did with the value, and a latch-count row if the disposition is a bounded announce.
  82: #
  83: #  THE STORE-BEFORE-CHECK IS VISIBLE IN THE SOURCE AND IS DELIBERATELY NOT ROWED HERE.  Every arm
  84: #  assigns `d->field = idata' before testing it, so on HEAD the rejected value is already in the
  85: #  struct when exit(1) runs -- but the process ends, so no guest can observe it and no row can
  86: #  either.  It becomes observable only once the kill goes, which makes it a FIX-round row (does
  87: #  the repair leave the register holding the refused value?), not a witness row.  Recorded so the
  88: #  fix round does not have to rediscover it.
  89: #
  90: #  ---------------------------------------------------------------------------------------------
  91: #  SHAPE: ONE PROCESS PER ARM, CONTROL FIRST, and every element of it was paid for by a sibling
  92: #  probe in this tree.
  93: #
  94: #    1.  ONE PROCESS, NOT TWO.  [A] pre-read, [B] accepted store, [C] read-back and [D] the
  95: #        killing store all happen in the SAME emulator run, so between the store that LIVES and
  96: #        the store that DIES only the VALUE differs -- not the address, not the width, not the
  97: #        path, not the process.  Two sessions would leave a residual that something else differed.
  98: #    2.  THE PAIR IS THE ORACLE.  A bare "the register read back 0x700000" row would be weak;
  99: #        UNMAPPED space and a missed device both read 0 (`memory_rw.c''s #95 pre-zero), and a
 100: #        bare zero proves nothing.  `<arm> live' asserts the TRANSITION 0x0 -> <accepted value>
 101: #        from the same address in the same process, which nothing but the device can produce.
 102: #        All six accepted values are NONZERO, so every `live' row carries a device signature.
 103: #    3.  STAY ON `step'.  #516 de-fatalised the two ISA interrupt stubs, so they are no longer
 104: #        confounders -- but `continue' would still let a host-timer tick reach code this probe is
 105: #        not testing, and the witness costs nothing by stepping.
 106: #    4.  EVERY ACCESS IS A GUEST INSTRUCTION.  Debugger `dump' skips DM_DEFAULT handlers and
 107: #        `lca_ioc' is registered DM_DEFAULT, so `dump' would read the pre-zero and make the
 108: #        window look unmapped.  A debugger `put d' of a killing value IS a host kill but is NOT a
 109: #        guest access and witnesses nothing.  Every `put d' below targets SCRATCH, which is RAM.
 110: #    5.  ATTRIBUTION IS BY THE ARM'S OWN TEXT, NEVER BY EXIT STATUS.  A wrong offset would fall
 111: #        into `default:' and die with "[ lca_ioc: unimplemented write to offset ... ]" -- a death
 112: #        for a DIFFERENT reason, which is a FAILED reproduction.  Each `<arm> attrib' row is green
 113: #        in both directions by construction and reds only if the host died WITHOUT that arm's
 114: #        diagnostic.  All six literals were verified unique in `src/' (one hit each).
 115: #
 116: #  THE NEGATIVE CONTROL IS `W_T_BASE0' (+0x180), and the VALUE is chosen to make it work hard:
 117: #  it is written 0x100000 -- the very value that kills at W_MASK0 two rows up.  W_T_BASE0 is an
 118: #  implemented case in the same switch, in the same handler, with no value guard, so the pair
 119: #  attributes the deaths to THE ARM'S PREDICATE rather than to the value, to the width, to K0SEG,
 120: #  or to writing into the IOC window at all.  (0x100000 is also a legal page-table base for that
 121: #  register: IOC_W_T_BASE is bits 31:10, so a 1 MB-aligned value is well-formed.)
 122: #
 123: #  Usage:  lca_badval_probe.py <gxemul-binary> [label]
 124: import os, sys, pty, select, time, re
 125: 
 126: BIN   = sys.argv[1]
 127: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
 128: MACH  = "alphabook1"          #  device_add(machine, "lca") is ST_ALPHABOOK1 ONLY
 129: 
 130: rows = []
 131: def row(name, got, want, note=""):
 132:     ok = (got == want)
 133:     rows.append((name, ok))
 134:     print("%-14s %-24s %-24s %-52s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
 135:     return ok
 136: 
 137: # ---------------------------------------------------------------- encoder (memory format only)
 138: ZERO, T0, T1, T2, T3, T4, T5 = 31, 1, 2, 3, 4, 5, 6
 139: #  T5 is the highest used.  A probe reaching for an undefined register name dies with a NameError
 140: #  rather than emitting a bad encoding, which is the safe direction (#516 found this the hard way).
 141: 
 142: def mem(op, ra, rb, disp):
 143:     assert -32768 <= disp <= 32767, "displacement %d out of range" % disp
 144:     return (op << 26) | (ra << 21) | (rb << 16) | (disp & 0xffff)
 145: 
 146: def LDA (ra, disp, rb=ZERO): return mem(0x08, ra, rb, disp)
 147: def LDAH(ra, disp, rb=ZERO): return mem(0x09, ra, rb, disp)
 148: def LDQ (ra, disp, rb):      return mem(0x29, ra, rb, disp)
 149: def STQ (ra, disp, rb):      return mem(0x2d, ra, rb, disp)
 150: #  QUADWORD ONLY, and that is architectural rather than a preference: HRM S6.4 says the IOC
 151: #  registers are accessed with quadword operations, so LDL/STL are excluded by the manual.
 152: 
 153: def load_const(reg, val):
 154:     #  32-bit only, and deliberately so: this builds the SCRATCH pointer, never a 64-bit operand.
 155:     #  Every operand this probe drives is 64-bit-capable and arrives via `put d' + LDQ.
 156:     lo = val & 0xffff
 157:     hi = (val >> 16) & 0xffff
 158:     if lo >= 0x8000:
 159:         hi = (hi + 1) & 0xffff
 160:     ops = [LDAH(reg, hi if hi < 0x8000 else hi - 0x10000)]
 161:     if lo:
 162:         ops.append(LDA(reg, lo if lo < 0x8000 else lo - 0x10000, reg))
 163:     return ops
 164: 
 165: # ---------------------------------------------------------------- addresses (ALL RAM < 64 MB)
 166: K0SEG        = 0xfffffc0000000000
 167: def k0(p):   return K0SEG | p
 168: 
 169: LCA_IOC_BASE  = 0x180000000              # alpha_lcareg.h; DEVINIT maps 0x20000000 bytes here
 170: IOC_CONF      = LCA_IOC_BASE + 0x020
 171: IOC_TB_ENA    = LCA_IOC_BASE + 0x0a0
 172: IOC_W_BASE0   = LCA_IOC_BASE + 0x100
 173: IOC_W_BASE1   = LCA_IOC_BASE + 0x120
 174: IOC_W_MASK0   = LCA_IOC_BASE + 0x140
 175: IOC_W_MASK1   = LCA_IOC_BASE + 0x160
 176: IOC_W_T_BASE0 = LCA_IOC_BASE + 0x180     # the negative control: implemented, NO value guard
 177: 
 178: SCRATCH      = 0x01020000
 179: CODE         = 0x01040000
 180: 
 181: assert max(SCRATCH, CODE) < 64 * 1024 * 1024, "scratch/code must be inside RAM"
 182: 
 183: DUMMY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "alpha_dummy.bin")
 184: if not os.path.exists(DUMMY):
 185:     with open(DUMMY, "wb") as f:
 186:         f.write(b"\0" * 8)
 187: 
 188: # ---------------------------------------------------------------- session
 189: def session(cmds, settle=1.6, spin=2.2):
 190:     pid, fd = pty.fork()
 191:     if pid == 0:
 192:         os.execv(BIN, [BIN, "-V", "-x", "-E", "alpha", "-e", MACH, "-M", "64",
 193:                        "0x20000000:" + DUMMY])
 194:         os._exit(127)
 195:     buf = ""
 196:     def rd(t):
 197:         nonlocal buf
 198:         end = time.time() + t
 199:         while time.time() < end:
 200:             r, _, _ = select.select([fd], [], [], 0.1)
 201:             if not r:
 202:                 continue
 203:             try:
 204:                 d = os.read(fd, 65536)
 205:                 if not d:
 206:                     return False
 207:                 buf += d.decode("latin-1", "replace")
 208:             except OSError:
 209:                 return False
 210:         return True
 211:     alive = rd(settle)
 212:     for i, c in enumerate(cmds):
 213:         try:
 214:             os.write(fd, (c + "\n").encode("latin-1"))
 215:         except OSError:
 216:             alive = False; break
 217:         if not rd(spin if i == len(cmds) - 1 else 0.35):
 218:             alive = False; break
 219:     try:
 220:         os.write(fd, b"quit\n"); rd(0.4)
 221:     except OSError:
 222:         pass
 223:     try:
 224:         os.close(fd)
 225:     except OSError:
 226:         pass
 227:     return buf.replace("\r", ""), alive
 228: 
 229: def printed(t, reg):
 230:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
 231:     return "absent" if not m else "0x%x" % int(m.group(1), 16)
 232: 
 233: # ---------------------------------------------------------------- the per-arm driver
 234: #  Register discipline, copied from lca_confbus_probe.py: T0 holds the SCRATCH base and is read
 235: #  for the LAST time by the third LDQ, so every operand is in a register before anything else
 236: #  happens.  The four accesses are labelled [A]..[D] here and in the report.
 237: def arm(addr, accepted, legal, settle=1.6, spin=2.2):
 238:     setup = ["put d 0x%x, 0x%x" % (SCRATCH + 0,  k0(addr)),
 239:              "put d 0x%x, 0x%x" % (SCRATCH + 8,  accepted),
 240:              "put d 0x%x, 0x%x" % (SCRATCH + 16, legal)]
 241:     prologue = load_const(T0, SCRATCH) + [
 242:         LDQ(T1, 0,  T0),    # t1 = k0(register)
 243:         LDQ(T4, 8,  T0),    # t4 = the ACCEPTED value
 244:         LDQ(T5, 16, T0),    # t5 = the manual-LEGAL value  (T0 is dead after this)
 245:         LDQ(T2, 0,  T1),    # [A] PRE-read       -- must be 0 (the model memsets its state)
 246:         STQ(T4, 0,  T1),    # [B] ACCEPTED store -- must survive
 247:         LDQ(T3, 0,  T1)]    # [C] READ-BACK      -- must echo the accepted value
 248:     armed = [STQ(T5, 0, T1)]  # [D] the manual-LEGAL store -- ends the host on HEAD
 249:     cmds = setup + ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op)
 250:                     for i, op in enumerate(prologue + armed)]
 251:     cmds += ["pc=0x%x" % k0(CODE),
 252:              "step %d" % len(prologue),   # up to and including the read-back
 253:              "print t2",                  # [A], while the host is certainly still alive
 254:              "print t3",                  # [C], likewise
 255:              "step %d" % len(armed)]      # [D]
 256:     txt, alive = session(cmds, settle, spin)
 257:     return txt, alive, printed(txt, "t2"), printed(txt, "t3")
 258: 
 259: def evidence(txt):
 260:     #  *** ECHO THE EVIDENCE INTO THIS LOG. ***  lca_confbus_probe.py shipped an attribution row
 261:     #  whose only evidence was a pty buffer nobody preserved -- a green row a later reader cannot
 262:     #  check.  Every diagnostic this handler can emit is printed here instead.
 263:     for _l in txt.split(chr(10)):
 264:         if "TODO:" in _l or "lca_ioc:" in _l or "[ lca:" in _l:
 265:             print("  EVIDENCE: %s" % _l.strip())
 266: 
 267: print("lca_badval_probe -- binary=%s label=%s machine=%s" % (BIN, LABEL, MACH))
 268: print("%-14s %-24s %-24s %-52s %s" % ("row", "got", "want", "note", ""))
 269: 
 270: # ---------------------------------------------------------------- the six arms

