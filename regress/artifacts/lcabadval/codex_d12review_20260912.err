 415: 	case LCA_IOC_W_T_BASE0:
 416: 		if (writeflag == MEM_READ) {
 417: 			odata = d->window_t_base_0;
 418: 		} else {
 419: 			d->window_t_base_0 = idata;
 420: 			/*  TODO: Actually implement this.  */
 421: 		}
 422: 		break;
 423: 
 424: 	case LCA_IOC_W_BASE1:
 425: 		if (writeflag == MEM_READ) {
 426: 			odata = d->window_base_1;
 427: 		} else {
 428: 			/*  #518: was a ONE-value whitelist + exit(1) -- and the one value
