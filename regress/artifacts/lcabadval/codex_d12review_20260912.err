 332: 		idata = memory_readmax64(cpu, data, len);
 333: 
 334: 	switch (relative_addr + LCA_IOC_BASE) {
 335: 
 336: 	case LCA_IOC_BASE:
 337: 		/*  Ignore? Linux reads from the base at startup.  */
 338: 		break;
 339: 
 340: 	case LCA_IOC_CONF:
 341: 		if (writeflag == MEM_READ) {
 342: 			odata = d->ioc_conf;
 343: 		} else {
 344: 			/*  #518: was `if (idata & ~1) { fatal(); exit(1); }' with the
 345: 			    store BEFORE the check (#506 had widened its diagnostic).
 346: 			    HRM S6.2.9: IOC_CONF<1:0> select the configuration cycle
 347: 			    TYPE; everything above is reserved and is IGNORED, not
 348: 			    fatal.  Bit 0 selects type-1 cycles and is what lca_pci_conf
 349: 			    reads (#515); bit 1 selects the CFG AD<1:0> encodings 10/11,
 350: 			    which are not configuration-cycle types -- stored and
 351: 			    announced once, not modelled.  (Pass 2: this comment first
 352: 			    called bit 1 the type-1 select; grok read lca_pci_conf.)  */
 353: 			d->ioc_conf = idata & 0x3ULL;
 354: 			if (idata & 0x2ULL)
 355: 				lca_ioc_announce(d, LCA_W_IOC_CONF_CFG1, "IOC_CONF<1> set"
 356: 				    " (CFG AD<1:0> = 10/11, not a configuration-cycle type):"
 357: 				    " stored, not modelled", idata);
 358: 		}
 359: 		break;
 360: 
 361: 	case LCA_IOC_TBIA:
 362: 		/*  TLB Invalidate All.  */
 363: 		/*  TODO: For now, let's just ignore it.  */
 364: 		break;
 365: 
 366: 	case LCA_IOC_TB_ENA:
 367: 		if (writeflag == MEM_READ) {
 368: 			odata = d->tlb_enable;
 369: 		} else {
