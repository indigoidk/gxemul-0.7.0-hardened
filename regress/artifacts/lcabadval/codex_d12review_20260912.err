 371: 			    the rest are type X -- IGNORED on write, never fatal.  The
 372: 			    old arm stored the whole value and then died on it.  */
 373: 			d->tlb_enable = idata & IOC_TB_ENA_TEN;
 374: 		}
 375: 		break;
 376: 
 377: 	case LCA_IOC_W_BASE0:
 378: 		if (writeflag == MEM_READ) {
 379: 			odata = d->window_base_0;
 380: 		} else {
 381: 			/*  #518: was a two-value whitelist + exit(1).  The HRM defines
 382: 			    this register by FIELDS -- W_BASE<31:20>, SG<32>, WEN<33> --
 383: 			    not by a list of numbers, and S6.4.14 REQUIRES SROM to write
 384: 			    zero here.  Store the fields (reserved bits dropped); the
 385: 			    window is not translated by this model, which is announced
 386: 			    once when any window is ENABLED.  */
 387: 			d->window_base_0 = idata & (IOC_W_BASE_W_BASE | IOC_W_BASE_SG | IOC_W_BASE_WEN);
 388: 			if (idata & IOC_W_BASE_WEN)
 389: 				lca_ioc_announce(d, LCA_W_IOC_WEN, "a DMA window was"
 390: 				    " enabled; window translation is not modelled", idata);
 391: 		}
 392: 		break;
 393: 
 394: 	case LCA_IOC_W_MASK0:
 395: 		if (writeflag == MEM_READ) {
 396: 			odata = d->window_mask_0;
 397: 		} else {
