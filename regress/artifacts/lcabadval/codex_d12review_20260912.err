 667: #  any OTHER reserved bit read back clean everywhere (codex, table-5 design, 2026-09-12 -- the
 668: #  closure-at-one-cell-leaves-its-symmetric-cell-open shape, a fifth time).  Same trick as D11: the
 669: #  seed sets every architected bit, the 64-bit COMPLEMENT sets every reserved bit.
 670: S_CONF  = 0xfffffffffffffffc       # ~0x3
 671: S_TBENA = 0xffffffffffffff7f       # ~0x80
 672: txt, alive, vals = seq([k0(IOC_CONF), 0x3, S_CONF,                # slots 0,1,2
 673:                         k0(IOC_TB_ENA), 0x80, S_TBENA],           # slots 3,4,5
 674:                        [[("st", 0, 1), ("ld", 0, 0)],             # R7 seed:  CONF both field bits
 675:                         [("st", 0, 2), ("ld", 0, 0)],             # R7 final: CONF complement
 676:                         [("st", 3, 4), ("ld", 3, 3)],             # R8 seed:  TB_ENA TEN
 677:                         [("st", 3, 5), ("ld", 3, 3)]])            # R8 final: TB_ENA complement
 678: row("conf filter", pair(0), "0x3/0x0",
 679:     "CONF: both CFG AD bits store, then the complement (bits 2-63 set, 0-1 clear) stores ZERO.  Reds "
 680:     "on a store mask widened by any reserved bit or narrowed by either field bit")
 681: row("tbena filter", pair(2), "0x80/0x0",
 682:     "TB_ENA: TEN stores, then the complement (every bit but 7) stores ZERO.  Reds on a store mask "
 683:     "widened by any type-X bit or narrowed off TEN")
 684: evidence(txt)
 685: 
 686: 
 687: # ---------------------------------------------------------------- summary
 688: #  Computed adjacent to the print on purpose: #516 shipped a probe whose numerator was counted
 689: #  over an older row set while the denominator was evaluated at print time, and every row said
 690: #  `ok' beside a summary that did not.
 691: ok = sum(1 for _, o in rows if o)
 692: print("")
 693: print("LCABADVAL_ARMS=%d" % len(ARMS))
 694: print("LCABADVAL_RESULT=%d/%d" % (ok, len(rows)))
 695: print("LCABADVAL_WITNESS=%s" % ("PASS" if ok == len(rows) else "FAIL"))
 696: print("LCABADVAL_DONE")
 697: sys.exit(0 if ok == len(rows) else 1)

