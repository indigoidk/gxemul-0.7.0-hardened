 431: 			d->window_base_1 = idata & (IOC_W_BASE_W_BASE | IOC_W_BASE_SG | IOC_W_BASE_WEN);
 432: 			if (idata & IOC_W_BASE_WEN)
 433: 				lca_ioc_announce(d, LCA_W_IOC_WEN, "a DMA window was"
 434: 				    " enabled; window translation is not modelled", idata);
 435: 		}
 436: 		break;
 437: 
 438: 	case LCA_IOC_W_MASK1:
 439: 		if (writeflag == MEM_READ) {
 440: 			odata = d->window_mask_1;
 441: 		} else {
 442: 			/*  #518: was `!= 0x3ff00000ULL' + exit(1): ONE accepted value where
 443: 			    HRM Table 6-6 lists THIRTEEN (W_MASK<31:20> = 0, 1, 3, 7, ...
 444: 			    0xfff: a contiguous low-ones field), and the old arm STORED
 445: 			    before it checked.  Validate the field, store only when it is
 446: 			    legal, decline once otherwise with the previous value kept.  */
 447: 			{
 448: 				uint64_t v = idata & 0xfff00000ULL, f = v >> 20;
 449: 				if ((f & (f + 1)) == 0)
 450: 					d->window_mask_1 = v;
 451: 				else
 452: 					lca_ioc_announce(d, LCA_W_IOC_WMASK1, "unsupported"
 453: 					    " IOC_W_MASK1 encoding declined (HRM Table 6-6);"
 454: 					    " previous value kept", idata);
 455: 			}
 456: 		}
 457: 		break;
 458: 
 459: 	case LCA_IOC_W_T_BASE1:
 460: 		if (writeflag == MEM_READ) {
 461: 			odata = d->window_t_base_1;
 462: 		} else {
 463: 			d->window_t_base_1 = idata;
 464: 			/*  TODO: Actually implement this.  */
 465: 		}
 466: 		break;
 467: 
 468: 	default:
