 532: 	    LCA_PCI_CONF, 0x20000000, dev_lca_pci_conf_access, (void *)d,
 533: 	    DM_DEFAULT, NULL);
 534: 
 535: 	memory_device_register(devinit->machine->memory, "lca_isa",
 536: 	    LCA_PCI_SIO, 0x10000 << 5, dev_lca_isa_access, (void *)d,
 537: 	    DM_DEFAULT, NULL);
 538: 
 539: 	memory_device_register(devinit->machine->memory, "lca_ioc",
 540: 	    LCA_IOC_BASE, 0x20000000, dev_lca_ioc_access, (void *)d,
 541: 	    DM_DEFAULT, NULL);
 542: 
 543: 	CHECK_ALLOCATION(interrupt_path = (char *)
 544: 	    malloc(strlen(devinit->machine->path) + 10));
 545: 	snprintf(interrupt_path, strlen(devinit->machine->path) + 10,
 546: 	    "%s.lca", devinit->machine->path);
