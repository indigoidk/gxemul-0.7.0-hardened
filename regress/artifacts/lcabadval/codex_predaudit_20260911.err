  624: 					return MEMORY_ACCESS_FAILED;
  625: 				}
  626: 				goto do_return_ok;
  627: 			}
  628: 
  629: 			if (paddr < mem->devices[i].baseaddr)
  630: 				end = i - 1;
  631: 			if (paddr >= mem->devices[i].endaddr)
  632: 				start = i + 1;
  633: 			i = (start + end) >> 1;
