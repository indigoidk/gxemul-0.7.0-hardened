  538: 						    dyntrans_write_low)
  539: 							mem->devices[i].
  540: 							dyntrans_write_low =
  541: 							    paddr &~offset_mask;
  542: 						if (paddr >= mem->devices[i].
  543: 						    dyntrans_write_high)
  544: 							mem->devices[i].
  545: 						 	dyntrans_write_high =
  546: 							    paddr | offset_mask;
  547: 					}
  548: 
  549: 					if (mem->devices[i].flags &
  550: 					    DM_EMULATED_RAM) {
