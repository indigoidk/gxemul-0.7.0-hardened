  167: def k0(p):   return K0SEG | p
  168: 
  169: LCA_IOC_BASE  = 0x180000000              # alpha_lcareg.h; DEVINIT maps 0x20000000 bytes here
  170: IOC_CONF      = LCA_IOC_BASE + 0x020
  171: IOC_TB_ENA    = LCA_IOC_BASE + 0x0a0
  172: IOC_W_BASE0   = LCA_IOC_BASE + 0x100
  173: IOC_W_BASE1   = LCA_IOC_BASE + 0x120
  174: IOC_W_MASK0   = LCA_IOC_BASE + 0x140
  175: IOC_W_MASK1   = LCA_IOC_BASE + 0x160
  176: IOC_W_T_BASE0 = LCA_IOC_BASE + 0x180     # the negative control: implemented, NO value guard
  177: 
  178: SCRATCH      = 0x01020000
  179: CODE         = 0x01040000
  180: 
  181: assert max(SCRATCH, CODE) < 64 * 1024 * 1024, "scratch/code must be inside RAM"
  182: 
  183: DUMMY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "alpha_dummy.bin")
  184: if not os.path.exists(DUMMY):
  185:     with open(DUMMY, "wb") as f:
  186:         f.write(b"\0" * 8)
  187: 
  188: # ---------------------------------------------------------------- session
  189: def session(cmds, settle=1.6, spin=2.2):
  190:     pid, fd = pty.fork()
  191:     if pid == 0:
  192:         os.execv(BIN, [BIN, "-V", "-x", "-E", "alpha", "-e", MACH, "-M", "64",
  193:                        "0x20000000:" + DUMMY])
  194:         os._exit(127)
  195:     buf = ""
  196:     def rd(t):
  197:         nonlocal buf
  198:         end = time.time() + t
  199:         while time.time() < end:
  200:             r, _, _ = select.select([fd], [], [], 0.1)
  201:             if not r:
  202:                 continue
  203:             try:
  204:                 d = os.read(fd, 65536)
  205:                 if not d:
  206:                     return False
  207:                 buf += d.decode("latin-1", "replace")
  208:             except OSError:
  209:                 return False
  210:         return True
  211:     alive = rd(settle)
  212:     for i, c in enumerate(cmds):
  213:         try:
  214:             os.write(fd, (c + "\n").encode("latin-1"))
  215:         except OSError:
  216:             alive = False; break
  217:         if not rd(spin if i == len(cmds) - 1 else 0.35):
  218:             alive = False; break
  219:     try:
  220:         os.write(fd, b"quit\n"); rd(0.4)
  221:     except OSError:
  222:         pass
  223:     try:
  224:         os.close(fd)
  225:     except OSError:
  226:         pass
  227:     return buf.replace("\r", ""), alive
  228: 
  229: def printed(t, reg):
  230:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  231:     return "absent" if not m else "0x%x" % int(m.group(1), 16)
  232: 
  233: # ---------------------------------------------------------------- the per-arm driver
  234: #  Register discipline, copied from lca_confbus_probe.py: T0 holds the SCRATCH base and is read
  235: #  for the LAST time by the third LDQ, so every operand is in a register before anything else
  236: #  happens.  The four accesses are labelled [A]..[D] here and in the report.
  237: def arm(addr, accepted, legal, settle=1.6, spin=2.2):
  238:     setup = ["put d 0x%x, 0x%x" % (SCRATCH + 0,  k0(addr)),
  239:              "put d 0x%x, 0x%x" % (SCRATCH + 8,  accepted),
  240:              "put d 0x%x, 0x%x" % (SCRATCH + 16, legal)]
  241:     prologue = load_const(T0, SCRATCH) + [
  242:         LDQ(T1, 0,  T0),    # t1 = k0(register)
  243:         LDQ(T4, 8,  T0),    # t4 = the ACCEPTED value
  244:         LDQ(T5, 16, T0),    # t5 = the manual-LEGAL value  (T0 is dead after this)
  245:         LDQ(T2, 0,  T1),    # [A] PRE-read       -- must be 0 (the model memsets its state)
  246:         STQ(T4, 0,  T1),    # [B] ACCEPTED store -- must survive
  247:         LDQ(T3, 0,  T1)]    # [C] READ-BACK      -- must echo the accepted value
  248:     armed = [STQ(T5, 0, T1)]  # [D] the manual-LEGAL store -- ends the host on HEAD
  249:     cmds = setup + ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op)
  250:                     for i, op in enumerate(prologue + armed)]
  251:     cmds += ["pc=0x%x" % k0(CODE),
  252:              "step %d" % len(prologue),   # up to and including the read-back
  253:              "print t2",                  # [A], while the host is certainly still alive
  254:              "print t3",                  # [C], likewise
  255:              "step %d" % len(armed)]      # [D]
  256:     txt, alive = session(cmds, settle, spin)
  257:     return txt, alive, printed(txt, "t2"), printed(txt, "t3")
  258: 
  259: def evidence(txt):
  260:     #  *** ECHO THE EVIDENCE INTO THIS LOG. ***  lca_confbus_probe.py shipped an attribution row
  261:     #  whose only evidence was a pty buffer nobody preserved -- a green row a later reader cannot
  262:     #  check.  Every diagnostic this handler can emit is printed here instead.
  263:     for _l in txt.split(chr(10)):
  264:         if "TODO:" in _l or "lca_ioc:" in _l or "[ lca:" in _l:
  265:             print("  EVIDENCE: %s" % _l.strip())
  266: 
  267: print("lca_badval_probe -- binary=%s label=%s machine=%s" % (BIN, LABEL, MACH))
  268: print("%-14s %-24s %-24s %-52s %s" % ("row", "got", "want", "note", ""))
  269: 
  270: # ---------------------------------------------------------------- the six arms
  271: #  (label, address, accepted value, manual-legal value, this arm's UNIQUE fatal() literal,
  272: #   the note that says what the `legal' row proves)
  273: ARMS = [
  274:     ("conf",   IOC_CONF,    0x1,          0x2,
  275:      "Write to unimplemented bit of",
  276:      "CFG AD<1:0> is a 2-bit FIELD (T6-10 :10250); 2 of 4 encodings kill"),
  277:     ("tbena",  IOC_TB_ENA,  0x80,         0x81,
  278:      "LCA_IOC_TB_ENA value",
  279:      "bit 0 is RES type X = IGNORED ON WRITE (legend :985, T6-13 :10453)"),
  280:     ("wbase0", IOC_W_BASE0, 0x300800000,  0x280000000,
  281:      "LCA_IOC_W_BASE0 value differs",
  282:      "WEN + base 0x80000000, aligned (F6-9 :10556; :10538-10539)"),
  283:     ("wmask0", IOC_W_MASK0, 0x700000,     0x100000,
  284:      "LCA_IOC_W_MASK0 value differs",
  285:      "2 MB window, Table 6-6 :9587 -- 12 of 13 legal encodings kill"),
  286:     ("wbase1", IOC_W_BASE1, 0x240000000,  0x0,
  287:      "LCA_IOC_W_BASE1 value differs",
  288:      "*** THE SROM-REQUIRED VALUE, S6.4.14 item 3 :10791-10792 ***"),
  289:     ("wmask1", IOC_W_MASK1, 0x3ff00000,   0xfff00000,
  290:      "LCA_IOC_W_MASK1 value differs",
  291:      "4 GB window, Table 6-6 :9598 -- MASK0's own value kills here too"),
  292: ]
  293: 
  294: for label, addr, accepted, legal, sig, why in ARMS:
  295:     txt, alive, pre, post = arm(addr, accepted, legal)
  296: 
  297:     #  ---- LIVENESS + DEVICE SIGNATURE, in one row -------------------------------------------
  298:     #  The PAIR is the oracle: unmapped space and a missed device both read 0 forever, so only a
  299:     #  live device can turn 0x0 into a nonzero value it was just handed.  This also proves the
  300:     #  ACCEPTED store did not kill -- which is what makes the death two rows down attributable to
  301:     #  the VALUE and to nothing else about the access.
  302:     row("%s live" % label, "%s->%s" % (pre, post), "0x0->0x%x" % accepted,
  303:         "LIVENESS+DEVSIG: same addr/width/process; only a device echoes this")
  304: 
  305:     #  ---- THE DEFECT ROW ---------------------------------------------------------------------
  306:     #  ORACLE POLARITY: the witness ladder requires the symptom on the PRE-FIX build and green
  307:     #  post-fix with the SAME script, so this asserts the CORRECT behaviour.
  308:     #  PRE-FIX -> "dead" -> RED.   POST-FIX -> "alive" -> GREEN.
  309:     row("%s legal" % label, "alive" if alive else "dead", "alive", why)
  310: 
  311:     #  ---- ATTRIBUTION: if it died, it died HERE ----------------------------------------------
  312:     #  Green in BOTH directions by construction; RED only if the host died WITHOUT this arm's
  313:     #  diagnostic -- i.e. "did it fail for the reason under test?"  A wrong offset lands in
  314:     #  `default:' and reds this row instead of quietly passing as a reproduction.
  315:     hit = (sig in txt)
  316:     row("%s attrib" % label, "yes" if (alive or hit) else "died-elsewhere", "yes",
  317:         "ATTRIBUTION: a death here must carry THIS arm's unique diagnostic")
  318:     evidence(txt)
  319: 
  320: # ---------------------------------------------------------------- the negative control
  321: #  W_T_BASE0 is an implemented case in the SAME switch with NO value guard, and it is handed the
  322: #  value that kills at W_MASK0.  If this died too, the deaths above would be about the window or
  323: #  the width rather than about the predicates, and the whole witness would be void.
  324: CTLVAL = 0x100000
  325: txtc, alivec, prec, postc = arm(IOC_W_T_BASE0, CTLVAL, CTLVAL)
  326: 
  327: row("ctl noguard", "alive" if alivec else "dead", "alive",
  328:     "CONTROL: same window, same width, an arm with NO value guard")
  329: row("ctl echo", "%s->%s" % (prec, postc), "0x0->0x%x" % CTLVAL,
  330:     "CONTROL: the value that KILLS at W_MASK0 is stored and echoed here")
  331: evidence(txtc)
  332: 
  333: # ================================================================ #518 DETECTOR ROWS
  334: #  The rows above are the WITNESS (RED on HEAD 74daefd at 14/20, GREEN on the fix with the same
  335: #  script).  The rows below DEFEND the fix -- they are what a kill table is scored against -- and
  336: #  each names the mutant it kills and the observable that differs (the CHANNEL line).
  337: #
  338: #  CONTRACT (clause (e)).  Designed to catch, per arm: (b) the verbatim kill reinstated (the
  339: #  `stored' rows die); (d) the STORE MASK narrowed (CONF `& 0x3' -> `& 0x1' loses bit 1; TB_ENA
  340: #  storing the raw value keeps 0x81; W_BASE dropping WEN/SG or truncating to 32 bits; W_MASK
  341: #  `& 0xfff00000' widened or narrowed); (d) the W_MASK FIELD RULE weakened (`f != 0' accepts
  342: #  0x500000; `f == 1' declines 0xfff00000) or the old STORE-BEFORE-CHECK order reinstated (the
  343: #  declined value is kept instead of the previous one); (d) the latch bits COLLAPSED (the second
  344: #  register's, or the second direction's, announce never prints) or the latch REMOVED (a second
  345: #  identical write announces twice); (d) the default arm declining reads to nonzero or writing
  346: #  state.  NOT rowed, disclosed: the SG bit's effect (nothing consumes it), the W_T_BASE arms
  347: #  (unchanged, and the negative control already pins one), the reserved bits ABOVE bit 33 of
  348: #  W_BASE (dropped by the same mask as the ones below it -- one row per mask, not per bit), and
  349: #  the `ofs > len' exit in lca_isa, which belongs to lcaisalane.  Every value here is QUADWORD.
  350: #
  351: #  WHAT THE READ-BACKS ARE, stated so nobody reads them as architecture (grok, pass 2): the HRM
  352: #  types these registers WO, readback UNPREDICTABLE (:980-988).  The model has always echoed the
  353: #  stored value; every `stored'/`widen'/`declined' row tests THAT ECHO POLICY, which is what the
  354: #  fix wrote into and what a mutant would change -- it is not a claim about hardware readback.
  355: #
  356: #  Session shape: T0 = SCRATCH base (live throughout), T1 = address, T2 = value, T3 = read-back;
  357: #  each phase reloads T1/T2 from a `put d' slot, so eight registers are never a constraint.  A
  358: #  phase is stepped as a block and its read-back printed while the host is certainly alive.
  359: 
  360: def seq(consts, phases, settle=1.6, spin=2.2):
  361:     """consts: list of 64-bit values -> SCRATCH slots 0,8,16,...  phases: list of lists of
  362:     (op, addr_slot, val_slot) with op in {'st', 'ld'}; each phase ends with `print t3'.
  363:     Returns (txt, alive, [read-backs in phase order as strings])."""
  364:     setup = ["put d 0x%x, 0x%x" % (SCRATCH + 8 * i, v) for i, v in enumerate(consts)]
  365:     prog = load_const(T0, SCRATCH)
  366:     lens = [len(prog)]
  367:     for ph in phases:
  368:         ops = []
  369:         for op, a, v in ph:
  370:             ops.append(LDQ(T1, 8 * a, T0))
  371:             if op == "st":
  372:                 ops.append(LDQ(T2, 8 * v, T0))
  373:                 ops.append(STQ(T2, 0, T1))
  374:             else:
  375:                 ops.append(LDQ(T3, 0, T1))
  376:         prog += ops
  377:         lens.append(len(ops))
  378:     cmds = setup + ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op) for i, op in enumerate(prog)]
  379:     cmds += ["pc=0x%x" % k0(CODE), "step %d" % lens[0]]
  380:     for n in lens[1:]:
  381:         cmds += ["step %d" % n, "print t3"]
  382:     txt, alive = session(cmds, settle, spin)
  383:     vals = ["0x%x" % int(m, 16) for m in
  384:             re.findall(r"print\s+t3\s*\n\s*(0x[0-9a-f]+)", txt)]
  385:     return txt, alive, vals
  386: 
  387: def nth(vals, i):
  388:     return vals[i] if i < len(vals) else "absent"
  389: 
  390: def announces(txt, needle):
  391:     return txt.count(needle)
  392: 
  393: #  ---- D1: the STORED value per arm -- accepted, then manual-legal, then read back -------------
  394: #  KILLS: (b) reinstated kill (dies); (d) mask narrowed / raw store / declined-not-stored (reads
  395: #  the accepted value or the raw one).  Writing the accepted value FIRST makes a skipped LATER store
  396: #  visible only where the accepted and the normalized legal values DIFFER -- at TB_ENA they are both
  397: #  0x80, which is why `tbena clear' exists (round 2); it does not cover an arm whose store is
  398: #  deleted outright (the accepted write is skipped too -- `<arm> live' reds there).  The want is the NORMALIZED legal value: for TB_ENA 0x81
  399: #  reads back 0x80, which is the reserved-bit rule in one row.
  400: NORMAL = {"conf": 0x2, "tbena": 0x80, "wbase0": 0x280000000, "wmask0": 0x100000,
  401:           "wbase1": 0x0, "wmask1": 0xfff00000}
  402: for label, addr, accepted, legal, sig, why in ARMS:
  403:     txt, alive, vals = seq([k0(addr), accepted, legal],
  404:                            [[("st", 0, 1)], [("st", 0, 2), ("ld", 0, 0)]])
  405:     row("%s stored" % label, nth(vals, 1) if alive else "dead", "0x%x" % NORMAL[label],
  406:         "accepted then legal: reads back the NORMALIZED legal value (fields kept, RES dropped)")
  407:     evidence(txt)
  408: 
  409: #  ---- D2: unsupported W_MASK encodings are DECLINED, the previous value KEPT, once per register --
  410: #  KILLS: field rule weakened to `f != 0' (0x500000 stored); store-before-check reinstated (reads
  411: #  0x500000); latch removed (two announces); MASK0/MASK1 latch bits collapsed (MASK1 never
  412: #  announces after MASK0 did, in the SAME session).
  413: DECL0, DECL1 = "IOC_W_MASK0 encoding declined", "IOC_W_MASK1 encoding declined"
  414: txt, alive, vals = seq([k0(IOC_W_MASK0), 0x100000, 0x500000, 0x900000,
  415:                         k0(IOC_W_MASK1), 0xfff00000, 0x200000],
  416:                        [[("st", 0, 1), ("st", 0, 2), ("ld", 0, 0)],      # phase 0: legal, bad, read
  417:                         [("st", 0, 3), ("ld", 0, 0)],                     # phase 1: second bad, read
  418:                         [("st", 4, 5), ("st", 4, 2), ("st", 4, 3), ("ld", 4, 4)],   # phase 2: MASK1 legal, bad, bad, read
  419:                         [("st", 0, 6), ("ld", 0, 0)]])                            # phase 3 (codex): f = 2 at MASK0
  420: row("wmask0 declined", nth(vals, 0) if alive else "dead", "0x100000",
  421:     "0x500000 (field 101b) declined: previous legal value KEPT, host alive")
  422: row("wmask0 once", announces(txt, DECL0) if alive else "dead", 1,
  423:     "TWO unsupported writes announce EXACTLY ONCE -- the (once) latch")
  424: row("wmask0 kept2", nth(vals, 1) if alive else "dead", "0x100000",
  425:     "the second unsupported write also leaves the previous value")
  426: row("wmask1 declined", nth(vals, 2) if alive else "dead", "0xfff00000",
  427:     "MASK1: 0x500000 declined after 0xfff00000 stored")
  428: row("wmask1 indep", announces(txt, DECL1) if alive else "dead", 1,
  429:     "MASK1 still announces after MASK0 did -- independent latch bits")
  430: row("wmask0 f2", nth(vals, 3) if alive else "dead", "0x100000",
  431:     "PASS 2 (codex): field 0b10 is NOT a Table 6-6 encoding; a rule weakened to admit it (== 0 -> <= 2) stores 0x200000")
  432: row("wmask1 once", announces(txt, DECL1) if alive else "dead", 1,
  433:     "PASS 2 (glm): TWO unsupported MASK1 writes announce ONCE -- pins MASK1 latch REMOVED, not only shared")
  434: evidence(txt)
  435: 
  436: #  ---- D3: IOC_CONF reserved bits dropped, bit 1 kept and announced once ----------------------
  437: #  KILLS: mask narrowed to bit 0 (reads 0x0 or 0x1); raw store (reads 0x100000002); latch removed.
  438: CFG1 = "IOC_CONF<1> set"
  439: txt, alive, vals = seq([k0(IOC_CONF), 0x1, 0x100000002, 0x2],
  440:                        [[("st", 0, 1), ("st", 0, 2), ("ld", 0, 0)],
  441:                         [("st", 0, 3), ("ld", 0, 0)]])
  442: row("conf reserved", nth(vals, 0) if alive else "dead", "0x2",
  443:     "0x100000002: reserved bit 32 DROPPED, CFG<1> kept")
  444: row("conf once", announces(txt, CFG1) if alive else "dead", 1,
  445:     "two writes with CFG<1> set announce EXACTLY ONCE")
  446: evidence(txt)
  447: 
  448: #  ---- D4: enabling a window announces ONCE across both registers; BASE0 accepts SROM's zero ---
  449: #  KILLS: WEN latch removed (two announces); per-register WEN latches (also two); BASE0 zero
  450: #  refused.  0x240000000 has bit 33 (WEN) set, so the accepted W_BASE1 value enables a window.
  451: WEN = "a DMA window was enabled"
  452: txt, alive, vals = seq([k0(IOC_W_BASE0), 0x280000000, k0(IOC_W_BASE1), 0x240000000, 0x0],
  453:                        [[("st", 0, 1), ("st", 2, 3), ("ld", 2, 2)],
  454:                         [("st", 0, 4), ("ld", 0, 0)]])
  455: row("wen once", announces(txt, WEN) if alive else "dead", 1,
  456:     "BASE0 then BASE1 both with WEN: the not-modelled announce prints ONCE")
  457: row("wbase1 wen", nth(vals, 0) if alive else "dead", "0x240000000",
  458:     "BASE1's accepted value round-trips with WEN (bit 33) intact")
  459: row("wbase0 zero", nth(vals, 1) if alive else "dead", "0x0",
  460:     "SROM's required zero lands at BASE0 too (S6.4.14 item 3)")
  461: evidence(txt)
  462: 
  463: #  ---- D5: the default arm -- write declined, read answers zero, each direction latched -------
  464: #  KILLS: reinstated kill; a default arm that stores or returns nonzero; the two direction
  465: #  latches collapsed (the read never announces after the write did); latch removed (two writes
  466: #  announce twice).  +0x1e0 is inside DEVINIT's window and names no register in alpha_lcareg.h.
  467: UNL = LCA_IOC_BASE + 0x1e0
  468: DEFW, DEFR = "unimplemented write to offset 0x1e0", "unimplemented read to offset 0x1e0"
  469: txt, alive, vals = seq([k0(UNL), 0x5a5a5a5a5a5a],
  470:                        [[("st", 0, 1), ("st", 0, 1)],
  471:                         [("ld", 0, 0), ("ld", 0, 0)]])   # PASS 2: TWO reads, so the read latch REMOVED is pinned too
  472: row("def alive", "alive" if alive else "dead", "alive",
  473:     "two writes to an unlisted IOC offset survive")
  474: row("def w once", announces(txt, DEFW) if alive else "dead", 1,
  475:     "the declined write announces EXACTLY ONCE for two writes")
  476: #  PASS 2 (kimi substitute): this read nth(vals, 0) -- the print after the STORE-ONLY phase 0, a
  477: #  STALE t3 -- so M20_def_echo passed it.  The load is in phase 1; index 1 is the read-back.
  478: row("def width", "yes" if (": 0x5a5a5a5a5a5a -- declined" in txt) else "no", "yes",
  479:     "the declined-write ANNOUNCE carries the full 64-bit value (round 4: the first form matched the echoed put-d command too)")
  480: row("def read0", nth(vals, 1) if alive else "dead", "0x0",
  481:     "a read of the unlisted offset answers ZERO, not the written value")
  482: row("def r once", announces(txt, DEFR) if alive else "dead", 1,
  483:     "two reads announce ONCE on the read direction OWN latch bit, after the write did")
  484: evidence(txt)
  485: 
  486: 
  487: #  ---- D6 (PASS 2 additions, 2026-09-10): the mask cells the first block did not drive -----------
  488: #  Named by four packet-fed seats against my own enumeration.  KILLS: SG dropped from the W_BASE
  489: #  mask (three seats said no row drove bit 32 -- WRONG, codex: `wbase0 live's accepted 0x300800000
  490: #  carries SG, so this row is a SECOND pin at BASE0; BASE1 gets its own below); masks WIDENED (minimax: CONF `& 0x3' -> `& 0x7';
  491: #  W_BASE keeping bit 34; W_MASK `& 0xfff00000' -> `& 0xfffff000'); the field taken from idata
  492: #  instead of v (glm: `f = idata >> 20' declines a legal value that carries bit 32); a TB_ENA
  493: #  no-store (kimi: the accepted 0x80 equals the normalized legal value, so `tbena stored' cannot see
  494: #  a skipped store -- this row writes 0x80 then the reserved-only 0x01 and wants TEN CLEAR).
  495: txt, alive, vals = seq([k0(IOC_CONF), 0x6, k0(IOC_TB_ENA), 0x80, 0x01,
  496:                         k0(IOC_W_BASE0), 0x380000000, 0x680000000,
  497:                         k0(IOC_W_MASK0), 0x1f0000, 0x100100000, 0x700000, 0x82],
  498:                        [[("st", 0, 1), ("ld", 0, 0)],                 # conf 0x6 -> 0x2
  499:                         [("st", 2, 3), ("st", 2, 4), ("ld", 2, 2)],   # tbena 0x80 then 0x01 -> 0x0
  500:                         [("st", 5, 6), ("ld", 5, 5)],                 # wbase0 SG|WEN|base -> same
  501:                         [("st", 5, 7), ("ld", 5, 5)],                 # wbase0 bit 34 set -> dropped
  502:                         [("st", 8, 9), ("ld", 8, 8)],                 # wmask0 low bits -> dropped
  503:                         [("st", 8, 11), ("st", 8, 10), ("ld", 8, 8)],  # wmask0: 0x700000 THEN bit-32 value -> 0x100000
  504:                         [("st", 2, 3), ("st", 2, 12), ("ld", 2, 2)]])  # tbena 0x80 then 0x82 -> 0x80 (round 3)
  505: row("conf widen", nth(vals, 0) if alive else "dead", "0x2",
  506:     "0x6 reads 0x2: a mask WIDENED to bit 2 stores it (minimax)")
  507: row("tbena clear", nth(vals, 1) if alive else "dead", "0x0",
  508:     "0x80 then 0x01 reads 0x0: TEN cleared by a reserved-only write; a NO-STORE reads 0x80 (kimi)")
  509: row("wbase0 sg", nth(vals, 2) if alive else "dead", "0x380000000",
  510:     "SG|WEN|base round-trips: the SG bit (32) is stored (deepseek)")
  511: row("wbase0 widen", nth(vals, 3) if alive else "dead", "0x280000000",
  512:     "bit 34 set reads dropped: reserved bits ABOVE 33 are not stored (deepseek Q6, minimax)")
  513: row("wmask0 widen", nth(vals, 4) if alive else "dead", "0x100000",
  514:     "0x1f0000 reads 0x100000: bits 19:16 below the mask are not stored (minimax); first draft wrote 0x100f0000 = bit 28, declined")
  515: row("wmask0 hif", nth(vals, 5) if alive else "dead", "0x100000",
  516:     "0x700000 then 0x100100000 reads 0x100000: bit 32 masked BEFORE the field test; a decline would keep 0x700000 (round 3)")
  517: row("tbena b1", nth(vals, 6) if alive else "dead", "0x80",
  518:     "0x82 reads 0x80: a reserved bit OTHER than bit 0 is dropped (table 1 M27 `& ~1' kept it)")
  519: row("wen base0", announces(txt, WEN) if alive else "dead", 1,
  520:     "BASE0 ALONE enables (twice) in this session: the announce prints once -- pins BASE0's own announce (grok)")
  521: evidence(txt)
  522: 
  523: #  ---- D7 (PASS 2): all six announces in ONE process -- any two latch bits shared reds the later --
  524: #  kimi Q4.5: D2/D5 armed only a SIBLING's bit before the firing write; a cross-arm collision
  525: #  (conf<->wen, mask<->def, ...) was unrowed.  One session fires every announce; each needle once.
  526: txt, alive, vals = seq([k0(IOC_CONF), 0x2, k0(IOC_W_BASE0), 0x280000000,
  527:                         k0(IOC_W_MASK0), 0x500000, k0(IOC_W_MASK1), 0x500000, k0(UNL), 0x5a5a],
  528:                        [[("st", 0, 1), ("st", 2, 3), ("st", 4, 5), ("st", 6, 7), ("st", 8, 9), ("ld", 8, 8),
  529:                          ("st", 0, 1), ("st", 4, 5)]])   # codex: REPEAT conf and mask0 after the others
  530: for _n, _needle in (("all conf", CFG1), ("all wen", WEN), ("all m0", DECL0), ("all m1", DECL1),
  531:                     ("all defw", DEFW), ("all defr", DEFR)):
  532:     row(_n, announces(txt, _needle) if alive else "dead", 1,
  533:         "six announces in one process, then conf and mask0 REPEATED: prints once (bits neither shared nor erased by `=')")
  534: evidence(txt)
  535: 
  536: 
  537: #  ---- D8 (PASS 2, grok): BASE1 ALONE enables a window -- the per-label WEN announce ------------
  538: #  D4 enables BASE0 first, so deleting BASE1's announce (or BASE0's) still gives `wen once' = 1.
  539: #  The shared latch bit is the JOIN the 7g-1 discriminator warns about, reached through a shared
  540: #  bit rather than a fall-through label.  Together with `wen base0' (D6) each label's announce is
  541: #  pinned on its own.
  542: txt, alive, vals = seq([k0(IOC_W_BASE1), 0x240000000],
  543:                        [[("st", 0, 1), ("ld", 0, 0)]])
  544: row("wen base1", announces(txt, WEN) if alive else "dead", 1,
  545:     "BASE1 ALONE enables: the announce prints once -- pins BASE1's own announce (grok)")
  546: row("wbase1 alone", nth(vals, 0) if alive else "dead", "0x240000000",
  547:     "and the value round-trips in a session that never touched BASE0")
  548: evidence(txt)
  549: 
  550: 
  551: #  ---- D9 (round 3, from table 1's own mutants): SILENCE rows -------------------------------------
  552: #  M32 (`if (idata | WEN)') and M33 (`if (idata | 0x2)') announce on EVERY write; M37 (`== 0x2')
  553: #  announces only on the exact value.  No earlier session wrote W_BASE without WEN, or CONF without
  554: #  bit 1, and asserted SILENCE; none wrote a bit-1 CONF value other than 0x2 on its own.
  555: #  Two sessions, because announces() counts the WHOLE transcript: the silence rows must live in a
  556: #  session that never writes an announcing value (the first draft put 0x6 in the same session and
  557: #  `conf silent' read 1 on the correct build -- 63/64, the row refusing its own construction).
  558: txt, alive, vals = seq([k0(IOC_W_BASE0), 0x80000000, k0(IOC_CONF), 0x1],
  559:                        [[("st", 0, 1), ("ld", 0, 0)],          # BASE0 without WEN/SG
  560:                         [("st", 2, 3), ("ld", 2, 2)]])         # CONF 0x1: bit 1 clear
  561: row("wen silent", announces(txt, WEN) if alive else "dead", 0,
  562:     "a W_BASE0 write WITHOUT WEN announces NOTHING (kills `&' -> `|' on the WEN test)")
  563: row("wbase0 nowen", nth(vals, 0) if alive else "dead", "0x80000000",
  564:     "and the WEN-clear base value round-trips")
  565: row("conf silent", announces(txt, CFG1) if alive else "dead", 0,
  566:     "CONF 0x1 (bit 1 clear) announces NOTHING in a session that writes nothing else (kills `&' -> `|')")
  567: evidence(txt)
  568: txt, alive, vals = seq([k0(IOC_CONF), 0x6],
  569:                        [[("st", 0, 1), ("ld", 0, 0)]])         # CONF 0x6 alone: bit 1 set, != 0x2
  570: row("conf ann6", announces(txt, CFG1) if alive else "dead", 1,
  571:     "CONF 0x6 ALONE (bit 1 set, != 0x2) announces ONCE (kills `& 0x2' -> `== 0x2')")
  572: row("conf 6 stored", nth(vals, 0) if alive else "dead", "0x2",
  573:     "and 0x6 stores 0x2 in this session too")
  574: evidence(txt)
  575: 
  576: 
  577: #  ---- D10 (round 4, from the records audit): the cells codex's saved answer named as still absent ----
  578: txt, alive, vals = seq([k0(IOC_W_MASK0), 0x700000, 0x0, k0(IOC_W_BASE1), 0x340000000,
  579:                         k0(UNL), 0x77],
  580:                        [[("st", 0, 1), ("st", 0, 2), ("ld", 0, 0)],      # MASK0: 0x700000 then ZERO (f = 0, legal)
  581:                         [("st", 3, 4), ("ld", 3, 3)],                   # BASE1 with SG|WEN|base
  582:                         [("st", 0, 1), ("st", 5, 6), ("ld", 0, 0)]])    # MASK0 legal, then a DEFAULT-arm write, read MASK0
  583: row("wmask0 zero", nth(vals, 0) if alive else "dead", "0x0",
  584:     "field 0 (Table 6-6's 1 MB encoding, :9587) is LEGAL and stores after a nonzero (a rule that rejects f == 0 keeps 0x700000)")
  585: row("wbase1 sg", nth(vals, 1) if alive else "dead", "0x340000000",
  586:     "SG|WEN|base round-trips at BASE1 (`wbase0 live' pins SG at BASE0 only -- codex, t2 M45)")
  587: row("def state", nth(vals, 2) if alive else "dead", "0x700000",
  588:     "a named register survives a DEFAULT-arm write to an unlisted offset: no IOC register-value change (the announce latch is the only state that moves)")
  589: evidence(txt)
  590: 
  591: #  ---- D11 (round 5): the CLASS CLOSURE for the stored-bit filtering class -------------------
  592: #  WHY A CLASS CLOSURE RATHER THAN TWO MORE ROWS.  Table 4 came back clean and the ask-again then
  593: #  found filtering escapes at MASK0 and BASE1 -- the SECOND consecutive pass to find one breach of
  594: #  one class, which is the carrier's trigger to stop buying cells one at a time and enumerate the
  595: #  whole space in ONE diff.  The space is {MASK, BASE} x {window 0, window 1} x {reserved-bit
  596: #  filtering, field-source selection, zero acceptance, invalid-field rejection}, and the cells that
  597: #  no existing row held are R1-R6 below.
  598: #
  599: #  THE INPUTS ARE THE 64-BIT COMPLEMENTS OF THE STORE MASKS, and that is the whole trick:
  600: #      ~0xfff00000  == 0xffffffff000fffff   (MASK: architected bits 20-31)
  601: #      ~0x3fff00000 == 0xfffffffc000fffff   (BASE: W_BASE 20-31, SG 32, WEN 33)
  602: #  so EVERY reserved bit is set and EVERY architected bit is clear.  A store mask widened by even
  603: #  one bit therefore reads back that bit instead of zero, and a mask NARROWED by one bit is caught
  604: #  at the SEED readback, whose value sets every architected bit.  One pair of writes per register
  605: #  covers narrowing and widening in both directions.
  606: #
  607: #  AND THE FIELD-SOURCE CELL FALLS OUT OF THE SAME INPUT.  With the shipped normalisation
  608: #  f = (idata & 0xfff00000) >> 20 the complement gives f = 0, f & (f+1) = 0, LEGAL, stored as 0.
  609: #  Validate the RAW input instead and f = 0xffffffff000, f & (f+1) = 0xffffffff000 != 0, DECLINED --
  610: #  so the seed value is retained and the row reds.  Reserved input bits 32-63 become deciding field
  611: #  bits 12-43 under raw validation, which is why the complement separates the two readings and a
  612: #  merely-large legal value would not.
  613: #
  614: #  Each row scores the PAIR (seed readback, final readback): the seed is not a free-standing row
  615: #  because a rule that rejects the seed and a rule that rejects the final write are different
  616: #  mutants, and one row that names both states separates them without inflating the denominator.
  617: S_MASK = 0xffffffff000fffff        # ~0xfff00000
  618: S_BASE = 0xfffffffc000fffff        # ~0x3fff00000
  619: txt, alive, vals = seq([k0(IOC_W_MASK0), 0xfff00000, S_MASK,      # slots 0,1,2
  620:                         k0(IOC_W_MASK1), 0x700000, 0x200000,      # slots 3,4,5
  621:                         k0(IOC_W_BASE0), 0x1fff00000, S_BASE,     # slots 6,7,8
  622:                         k0(IOC_W_BASE1)],                         # slot 9
  623:                        [[("st", 0, 1), ("ld", 0, 0)],             # R1 seed:  MASK0 all-ones field
  624:                         [("st", 0, 2), ("ld", 0, 0)],             # R1 final: MASK0 complement
  625:                         [("st", 3, 1), ("ld", 3, 3)],             # R2 seed:  MASK1 all-ones field
  626:                         [("st", 3, 2), ("ld", 3, 3)],             # R2 final: MASK1 complement
  627:                         [("st", 3, 4), ("ld", 3, 3)],             # R3 seed:  MASK1 field 7
  628:                         [("st", 3, 5), ("ld", 3, 3)],             # R3 final: MASK1 field 2 (illegal)
  629:                         [("st", 6, 7), ("ld", 6, 6)],             # R4 seed:  BASE0 W_BASE|SG
  630:                         [("st", 6, 8), ("ld", 6, 6)],             # R4 final: BASE0 complement
  631:                         [("st", 9, 7), ("ld", 9, 9)],             # R5 seed:  BASE1 W_BASE|SG
  632:                         [("st", 9, 8), ("ld", 9, 9)]])            # R5 final: BASE1 complement
  633: def pair(i):
  634:     return (nth(vals, i) + "/" + nth(vals, i + 1)) if alive else "dead"
  635: 
  636: row("wmask0 filter", pair(0), "0xfff00000/0x0",
  637:     "MASK0: the all-ones field stores whole, then its 64-bit COMPLEMENT stores ZERO.  Reds on a "
  638:     "store mask widened by any reserved bit (reads that bit), narrowed by any architected bit "
  639:     "(the seed loses it), or validating the RAW idata instead of the normalised field (f becomes "
  640:     "0xffffffff000, declines, and the seed is retained)")
  641: row("wmask1 filter-zero", pair(2), "0xfff00000/0x0",
  642:     "the same pair at MASK1 -- the sibling window, whose filtering had no row at all.  It also "
  643:     "carries the NORMALISED-ZERO acceptance cell: f == 0 after masking is legal (HRM Table 6-6's "
  644:     "1 MB encoding), so a rule excluding zero keeps 0xfff00000 here")
  645: row("wmask1 f2", pair(4), "0x700000/0x700000",
  646:     "MASK1 invalid-field rejection at FIELD 2, which `wmask1 declined' does not drive (it uses 5 "
  647:     "and 9): 2 & 3 == 2, so bit 1 of the predicate result is what separates `== 0' from `<= 2'.  "
  648:     "A predicate relaxed to `<= 2' stores 0x200000 and reds this row")
  649: row("wbase0 filter", pair(6), "0x1fff00000/0x0",
  650:     "BASE0: W_BASE|SG stores whole (SG at bit 32 and every W_BASE bit), then the complement stores "
  651:     "ZERO.  Bits 0-19 and 34-63 are set in that write, so any reserved bit added to the store mask "
  652:     "reads back")
  653: row("wbase1 filter", pair(8), "0x1fff00000/0x0",
  654:     "the same pair at BASE1.  M47 -- the store mask extended to bit 34 -- retains exactly "
  655:     "0x400000000 here, which is the escape the ask-again found and which no BASE1 row could see")
  656: row("wen silent both", announces(txt, WEN) if alive else "dead", 0,
  657:     "ZERO WEN announces across a session that writes BOTH windows' BASE registers four times with "
  658:     "WEN clear.  `wen silent' touches BASE0 only, so a `idata & WEN' -> `idata | WEN' edit at the "
  659:     "BASE1 arm alone was unrowed -- a sibling gap, not clause-(e) debt")
  660: evidence(txt)
  661: 
  662: 
  663: # ---------------------------------------------------------------- summary
  664: #  Computed adjacent to the print on purpose: #516 shipped a probe whose numerator was counted
  665: #  over an older row set while the denominator was evaluated at print time, and every row said
  666: #  `ok' beside a summary that did not.
  667: ok = sum(1 for _, o in rows if o)
  668: print("")
  669: print("LCABADVAL_ARMS=%d" % len(ARMS))
  670: print("LCABADVAL_RESULT=%d/%d" % (ok, len(rows)))
  671: print("LCABADVAL_WITNESS=%s" % ("PASS" if ok == len(rows) else "FAIL"))
  672: print("LCABADVAL_DONE")
  673: sys.exit(0 if ok == len(rows) else 1)

