                valid=(f & (f+1))==0
                rule=mut.get('rules',{}).get(reg)
                if rule=='nozero': valid=valid and f"'!=0
                if rule=='"'allow2': valid=valid or f==2
            if valid:
                if mut.get('skip_reserved')==reg and value"'!=v: pass
                elif mut.get('"'or_store')==reg: state[reg] |= v
                else: state[reg]=v
            else: announce(reg)
            if reg=='conf' and value&2: announce('conf')
            if reg.startswith('wbase') and value&0x200000000:
                if mut.get('skip_wen')"'!=reg: announce('"'wen')
            return 0
        def read(addr):
            a=physical(addr)
            return access(a) if base<=a<base+0x20000000 else ram.get(a,0)
        def write(addr,value):
            a=physical(addr)
            if base<=a<base+0x20000000: access(a,True,value)
            else: ram[a]=value
        for cmd in cmds:
            output.append(cmd)
            if cmd.startswith('put '):
                kind,addr,value=re.fullmatch(r'put ([dw]) (0x[0-9a-f]+), (0x[0-9a-f]+)',cmd).groups()
                ram[physical(int(addr,16))]=int(value,16)
            elif cmd.startswith('pc='): pc=physical(int(cmd[3:],16))
            elif cmd.startswith('step '):
