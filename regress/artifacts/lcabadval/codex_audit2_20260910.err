        def physical(a): return a & 0x3ffffffffff
        def announce(reason):
            bit=mut.get('share',{}).get(reason,bits[reason])
            if bit in warned and reason not in mut.get('nolatch',[]): return
            warned.add(bit); output.append(texts[reason])
        def access(addr,write=False,value=0):
            ofs=addr-base
            if ofs in (0,0x80): return 0
            reg=names.get(ofs)
            if reg is None:
                announce('defw' if write else 'defr')
                if write and mut.get('def_clobber'): state['conf']=1
                return mut.get('def_read',0)
            if not write: return state[reg]
            writes[reg].add(value)
            mask=mut.get('masks',{}).get(reg,masks[reg])
