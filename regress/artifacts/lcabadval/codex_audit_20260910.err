                        [("st", 4, 5), ("st", 4, 2), ("st", 4, 3), ("ld", 4, 4)],   # phase 2: MASK1 legal, bad, bad, read
                        [("st", 0, 6), ("ld", 0, 0)]])                            # phase 3 (codex): f = 2 at MASK0
