#!/usr/bin/env python3
#  #518 lcabadval kill-table SUMMARIZER.  Reads every <mutant>.raw in this directory and prints
#  score + the rows that REDDENED, by parsing the probe's own fixed-width row format
#  ("%-14s %-24s %-24s %-52s %s") -- the row NAME is columns 0..13, which is why this does not
#  split on whitespace: three row names ("def w once", "def r once") are three words.
#
#  A log whose last line is not LCABADVAL_DONE is reported as NO-SENTINEL and its score is NOT
#  read: a preserved log is verified by its completion sentinel, not by its existence.
import os, re, sys

HERE = os.path.dirname(os.path.abspath(__file__))
ORDER = ["BASE"] + ["M%d" % i for i in range(1, 40)] + ["BASE2"]


def rows_of(path):
    txt = open(path, encoding="latin-1").read()
    lines = txt.split(chr(10))
    red, tot = [], 0
    for l in lines:
        #  A ROW LINE, and nothing else: the probe prints rows as "%-14s %-24s %-24s %-52s %s",
        #  so a row is >= 70 chars with a blank at column 14.  Without that shape test the
        #  summary line LCABADVAL_WITNESS=FAIL is scored as a reddened row -- which it is not,
        #  and which would inflate every mutant's red list by one.
        if len(l) >= 70 and not l.startswith("LCABADVAL"):
            if not (l.rstrip().endswith("FAIL") or l.rstrip().endswith(" ok")):
                continue
            #  The name field is "%-14s" plus a literal space -- but TWO row names
            #  ("wmask0 declined", "wmask1 declined") are FIFTEEN chars and OVERFLOW it, so a
            #  fixed l[:14] slice silently drops exactly those two rows.  Caught by the
            #  denominator: the parser saw 38 rows in a 40-row log.
            name = l[:14].rstrip() if l[14] == " " else l[:l.index(" ", 14)]
            if not name or name == "row":
                continue
            tot += 1
            if l.rstrip().endswith("FAIL"):
                got = l[15:39].strip()
                want = l[40:64].strip()
                red.append("%s[got %s want %s]" % (name, got, want))
    m = re.search(r"LCABADVAL_RESULT=(\d+)/(\d+)", txt)
    done = lines[-1].strip() == "LCABADVAL_DONE" or (
        len(lines) > 1 and lines[-2].strip() == "LCABADVAL_DONE")
    return (m.group(0) if m else "NO-SCORE"), red, done, tot


def key(fn):
    b = fn[:-4]
    m = re.match(r"M(\d+)_", b)
    if b == "BASE":
        return (0, 0)
    if b == "BASE2":
        return (2, 0)
    return (1, int(m.group(1)) if m else 999)


def main():
    out = []
    for fn in sorted(os.listdir(HERE), key=key):
        if not fn.endswith(".raw"):
            continue
        sc, red, done, tot = rows_of(os.path.join(HERE, fn))
        tag = "" if done else "  *** NO SENTINEL ***"
        out.append("%-24s %-22s %s%s" % (fn[:-4], sc, ("SWEPT CLEAN -- no row reddened"
                   if not red else "; ".join(red)), tag))
    print("%-24s %-22s %s" % ("mutant", "score", "reddened rows"))
    print("-" * 118)
    for l in out:
        print(l)


#  gen_table1.py imports this module for rows_of().  Without the guard the whole summary table
#  printed as a side effect of that import, on top of the generated file.
if __name__ == "__main__":
    main()
#!/usr/bin/env python3
#
#  #518 table 2 -- turn the <mutant>.raw logs into TABLE2.out.
#
#  ROW NAMES ARE ZIPPED POSITIONALLY, NOT PARSED OUT OF THE LINE.  The probe prints
#  "%-14s %-24s %-24s %-52s %s" and several row names are LONGER than their 14-column field
#  ("wmask0 declined" is 15), so a column-based split silently mis-cuts exactly the rows the
#  padded-column trap warns about.  Every row line ends in " ok" or " FAIL" and the rows are
#  emitted in one fixed order, so the honest reading is: collect the status tokens in order and
#  zip them against the ordered name list below -- and REFUSE (loudly) if the count is not 58,
#  which is the denominator that makes the search checkable.
import os, re, sys

NAMES = []
for a in ("conf", "tbena", "wbase0", "wmask0", "wbase1", "wmask1"):
    NAMES += ["%s live" % a, "%s legal" % a, "%s attrib" % a]
NAMES += ["ctl noguard", "ctl echo"]
NAMES += ["%s stored" % a for a in ("conf", "tbena", "wbase0", "wmask0", "wbase1", "wmask1")]
NAMES += ["wmask0 declined", "wmask0 once", "wmask0 kept2", "wmask1 declined", "wmask1 indep",
          "wmask0 f2", "wmask1 once"]
NAMES += ["conf reserved", "conf once"]
NAMES += ["wen once", "wbase1 wen", "wbase0 zero"]
NAMES += ["def alive", "def w once", "def width", "def read0", "def r once"]
NAMES += ["conf widen", "tbena clear", "wbase0 sg", "wbase0 widen", "wmask0 widen",
          "wmask0 hif", "wen base0"]
NAMES += ["all conf", "all wen", "all m0", "all m1", "all defw", "all defr"]
NAMES += ["wen base1", "wbase1 alone"]
assert len(NAMES) == 58, len(NAMES)

ROW = re.compile(r"^(?P<body>\S.*?)\s+(?P<st>ok|FAIL)$")


def read_one(path):
    """-> (score_str, [failing row names], done_sentinel_ok, n_row_lines)"""
    txt = open(path, errors="replace").read()
    lines = txt.split(chr(10))
    done = any(l.strip() == "LCABADVAL_DONE" for l in lines)
    sts = []
    for l in lines:
        m = ROW.match(l.rstrip())
        if m and not m.group("body").startswith("row "):
            sts.append(m.group("st"))
    score = "?"
    for l in lines:
        if l.startswith("LCABADVAL_RESULT="):
            score = l.split("=", 1)[1].strip()
    fails = []
    if len(sts) == len(NAMES):
        fails = [NAMES[i] for i, s in enumerate(sts) if s == "FAIL"]
    return score, fails, done, len(sts)


def main(d):
    names = []
    for f in sorted(os.listdir(d)):
        if f.endswith(".raw"):
            names.append(f[:-4])

    def key(n):
        if n == "BASE":
            return (0, 0)
        m = re.match(r"M(\d+)", n)
        return (1, int(m.group(1)) if m else 999)
    names.sort(key=key)

    for n in names:
        score, fails, done, nrows = read_one(os.path.join(d, n + ".raw"))
        flag = "" if done else "  *** NO LCABADVAL_DONE SENTINEL ***"
        if nrows != 58:
            flag += "  *** %d row lines, expected 58 -- names NOT attributable ***" % nrows
        print("%-24s %-8s  rows=%d  reds=%d%s" % (n, score, nrows, len(fails), flag))
        if fails:
            print("      reddened: %s" % ", ".join(fails))


if __name__ == "__main__":
    main(sys.argv[1] if len(sys.argv) > 1 else ".")
