import ast, pathlib, hashlib, re, json
root=pathlib.Path('.')
p=root/'regress/artifacts/lcabadval/killtable_20260910/t4/lca_badval_probe.REPAIRED67.asrun.py'
tree=ast.parse(p.read_text())
env={}; sessions=[]
def val(n, e):
    if isinstance(n,ast.Constant): return n.value
    if isinstance(n,ast.Name): return e[n.id]
    if isinstance(n,(ast.List,ast.Tuple)): return [val(x,e) for x in n.elts]
    if isinstance(n,ast.Dict): return {val(k,e):val(v,e) for k,v in zip(n.keys,n.values)}
    if isinstance(n,ast.BinOp):
        a,b=val(n.left,e),val(n.right,e)
        if isinstance(n.op,ast.Add):return a+b
        if isinstance(n.op,ast.BitOr):return a|b
        if isinstance(n.op,ast.Mod):return a % tuple(b) if isinstance(b,list) else a % b
    if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='k0':return e['K0SEG']|val(n.args[0],e)
    raise ValueError(ast.dump(n)[:150])
def walk(nodes,e):
    for n in nodes:
        if isinstance(n,ast.Assign):
            if isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id in ('arm','seq'):
                a=[val(x,e) for x in n.value.args]; kind=n.value.func.id
                if kind=='arm': writes=[(a[0],a[1]),(a[0],a[2])]
                else: writes=[(a[0][ad]&~e['K0SEG'],a[0][v]) for phase in a[1] for op,ad,v in phase if op=='st']
                sessions.append({'line':n.lineno,'kind':kind,'writes':writes,'rows':[]})
            else:
                try:
                    v=val(n.value,e)
                    for target in n.targets:
                        if isinstance(target,ast.Name):e[target.id]=v
                        elif isinstance(target,ast.Tuple):
                            for t,x in zip(target.elts,v):e[t.id]=x
                except (ValueError,KeyError,TypeError):pass
        elif isinstance(n,ast.For):
            try: items=val(n.iter,e)
            except (ValueError,KeyError,TypeError):continue
            for item in items:
                ee=e.copy()
                if isinstance(n.target,ast.Name):ee[n.target.id]=item
                else:
                    for target,x in zip(n.target.elts,item):ee[target.id]=x
                walk(n.body,ee)
        elif isinstance(n,ast.Expr) and isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id=='row':
            sessions[-1]['rows'].append(val(n.value.args[0],e))
walk(tree.body,env)
print('STATIC AST ONLY: did not import or execute probe')
print('sessions',len(sessions),'assertion_rows',sum(len(s['rows']) for s in sessions))
for reg in ['IOC_W_MASK0','IOC_W_MASK1','IOC_W_BASE0','IOC_W_BASE1']:
    addr=env[reg]; values=sorted({v for s in sessions for a,v in s['writes'] if a==addr})
    print(reg,'values',','.join(hex(v) for v in values))
    if 'MASK' in reg:
        print('fields',','.join(hex(f) for f in sorted({(v&0xfff00000)>>20 for v in values})))
        print('bit12_set_inputs',[hex(v) for v in values if v&(1<<12)])
    for s in sessions:
        ws=[hex(v) for a,v in s['writes'] if a==addr]
        if ws:print(' line',s['line'],'writes',ws,'rows',s['rows'])
for a,b in [(root/'regress/lca_badval_probe.py',p),(root/'src/devices/dev_lca.c',root/'regress/artifacts/lcabadval/killtable_20260910/t4/BASELINE_round4.c')]:
    aa,bb=a.read_bytes(),b.read_bytes(); print('EQUAL',str(a),str(b),aa==bb,'md5',hashlib.md5(aa).hexdigest(),hashlib.md5(bb).hexdigest())
for log in sorted(p.parent.glob('*.raw')):
    lines=log.read_text().splitlines(); status=[x for x in lines if re.search(r'\\s(?:ok|FAIL)"'$'"',x)]
    print('LOG',log.name,'rows',len(status),'pass',sum(x.endswith(' ok') for x in status),'tail',lines[-1],'FAIL',[re.split(r'\\s{2,}',x)[0] for x in status if x.endswith('FAIL')])
