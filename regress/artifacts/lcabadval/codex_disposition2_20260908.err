 367| DEVINIT(lca)
 368| {
 369| 	char *interrupt_path;
 370| 	struct interrupt interrupt_template;
 371| 	struct lca_data *d;
 372| 
 373| 	CHECK_ALLOCATION(d = (struct lca_data *) malloc(sizeof(struct lca_data)));
 374| 	memset(d, 0, sizeof(struct lca_data));
 375| 
 376| 	/*  Register a PCI bus:  */
 377| 	d->pci_data = bus_pci_init(
 378| 	    devinit->machine,
 379| 	    "TODO: irq"		/*  pciirq: TODO  */,
 380| 	    LCA_PCI_SIO,	/*  pci device io offset  */
 381| 	    0x00000000,		/*  pci device mem offset: TODO  */
 382| 	    0x00000000,		/*  PCI portbase: TODO  */
 383| 	    0x00000000,		/*  PCI membase: TODO  */
 384| 	    "TODO: pci irq base",	/*  PCI irqbase: TODO  */
 385| 	    LCA_ISA_BASE,	/*  ISA portbase  */
 386| 	    LCA_ISA_MEMBASE,	/*  ISA membase  */
 387| 	    "TODO: irqbase isa");                /*  ISA irqbase: TODO  */
 388| 
 389| 	/*  Add the "sio0" controller (as seen by NetBSD):  */
 390| 	bus_pci_add(devinit->machine, d->pci_data, devinit->machine->memory,
 391| 	    0, 7, 0, "i82378zb");
 392| 
 393| 	memory_device_register(devinit->machine->memory, "lca_pci_conf",
 394| 	    LCA_PCI_CONF, 0x20000000, dev_lca_pci_conf_access, (void *)d,
 395| 	    DM_DEFAULT, NULL);
 396| 
 397| 	memory_device_register(devinit->machine->memory, "lca_isa",
 398| 	    LCA_PCI_SIO, 0x10000 << 5, dev_lca_isa_access, (void *)d,
 399| 	    DM_DEFAULT, NULL);
 400| 
 401| 	memory_device_register(devinit->machine->memory, "lca_ioc",
 402| 	    LCA_IOC_BASE, 0x20000000, dev_lca_ioc_access, (void *)d,
 403| 	    DM_DEFAULT, NULL);
 404| 
 405| 	CHECK_ALLOCATION(interrupt_path = (char *)
 406| 	    malloc(strlen(devinit->machine->path) + 10));
 407| 	snprintf(interrupt_path, strlen(devinit->machine->path) + 10,
 408| 	    "%s.lca", devinit->machine->path);
 409| 
 410| 	memset(&interrupt_template, 0, sizeof(interrupt_template));
 411| 	interrupt_template.line = 0;
 412| 	interrupt_template.name = interrupt_path;
 413| 	interrupt_template.extra = d;
 414| 	interrupt_template.interrupt_assert = lca_interrupt_assert;
 415| 	interrupt_template.interrupt_deassert = lca_interrupt_deassert;
 416| 	interrupt_handler_register(&interrupt_template);
 417| 
 418| 	bus_isa_init(devinit->machine, interrupt_path,
 419| 	    BUS_ISA_IDE0 | BUS_ISA_IDE1, LCA_ISA_BASE, LCA_ISA_MEMBASE);
 420| 
 421| 	return 1;
 422| }
