  51| struct lca_data {
  52| 	struct pci_data		*pci_data;
  53| 
  54| 	uint64_t		ioc_conf;
  55| 	uint64_t		tlb_enable;
  56| 	uint64_t		window_base_0;
  57| 	uint64_t		window_mask_0;
  58| 	uint64_t		window_t_base_0;
  59| 	uint64_t		window_base_1;
