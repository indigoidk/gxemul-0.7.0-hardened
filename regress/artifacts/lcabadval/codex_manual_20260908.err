1698:static int sh4_val_first(struct sh4_data *d, int cls, int instance, uint32_t bits)
1699:{
1700:	uint32_t fresh;
1701:
1702:	/*  Unreachable by construction: every caller passes a class from the SH4_VAL_*
1703:	    list and an instance bounded by its own `case` fall-through.  Kept because
1704:	    getting it wrong would be an out-of-bounds WRITE, not a wrong message, and
1705:	    because it is free.  It SILENCES rather than reports, matching
1706:	    sh4_pcic_first(); an unbounded key must not become an unbounded print.  */
1707:	if (cls < 0 || cls >= SH4_VAL_NCLASS ||
1708:	    instance < 0 || instance >= N_SH4_VAL_INST)
1709:		return 0;
1710:
1711:	fresh = bits & ~d->val_reported[cls][instance];
1712:	d->val_reported[cls][instance] |= bits;
