  103: 		    dev->function == pci_data->cur_func &&
  104: 		    dev->device   == pci_data->cur_device)
  105: 			break;
  106: 		dev = dev->next;
  107: 	}
  108: 
  109: 	/*  No device? Then return emptiness.  */
  110: 	if (dev == NULL) {
  111: 		if (writeflag == MEM_READ) {
  112: 			if (pci_data->cur_reg == 0)
  113: 				*data = (uint64_t) -1;
