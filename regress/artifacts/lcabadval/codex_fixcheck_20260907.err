638:			if (!w) { fatal("[ pcc2: write to read-only PCCTWO_IPL; "
639:			    "ignored ]\n"); w = 1; }
640:		} else {
641:			if (d->pcctwo_reg[PCCTWO_IPL] == 0) {
642:				static int w = 0;	/* #119: was exit(1) */
643:				if (!w) { fatal("[ pcc2: IPL == 0 on read ]\n");
644:				    w = 1; }
645:			}
646:		}
647:		break;
648:
649:	case PCCTWO_MASK:
650:		/*  pcc2widthkills: was a #119 `static int w' -- process-global, and it
651:		    said "ignored" about a READ the memcpy above had already served.
652:		    Now per-instance, write-only, like the ten blocks above -- that is
653:		    the WIDTH latch.  (pcc2widthkills pass 7: this comment once claimed a
654:		    #119 static of MASK's own "below" -- there is none; the body stores
655:		    the byte and reasserts.  The static belongs to IPL's arm above.)  */
656:		if (len != 1 && writeflag == MEM_WRITE) {
657:			pcc2_width_decline(d, PCC2_W_MASK_LEN, "PCCTWO_MASK", len);
658:			break;
659:		}
660:		if (writeflag == MEM_WRITE) {
661:			d->pcctwo_reg[relative_addr] = idata;
662:			reassert_interrupts(d);
663:		}
664:		break;
665:
666:	default:
667:		/*  #501 (pcc2defaultkill): this arm ended the host with exit(1) on ANY
668:		    access to an offset with no case -- 43 of the 0x40 byte offsets:
669:		    eighteen documented registers the model does not implement (IEICR,
670:		    IEERR, IEBERR, GPIO, SCSIERR, the printer block, SPEED, the *IACKs),
671:		    the bytes inside the four counter/compare words, and the unnamed
672:		    ones -- READS included, though the memcpy above the switch had
673:		    already served them.  A guest ld.bu or st.b at any of them was a host
674:		    kill (rung-3 witness).  Now: a READ keeps the served byte (the array's
675:		    current byte, said so -- inside a running COUNT word that is the
676:		    tick's value, not a default); a WRITE is DECLINED.  Not a
677:		    backed store: the cased siblings contradict one (SCCERR clears on
678:		    write, the ICRs mask and reassert, PSCALECNT/SPEED/the IACKs are
679:		    read-only), no inspected OpenBSD driver path reaches them (if_ie never
680:		    attaches: unreadable sits at its 82596 address), and a store from the
681:		    one arm 43 offsets reach would add a bounded-write surface.  One
682:		    latched fatal() per offset per instance, the house `(once)' shape --
683:		    unlike PSCALEADJ's UNLATCHED print above (pcc2pscaleflood).  The
684:		    IACK offsets 0x23/0x25 are declined like the rest: modelling them (on
685:		    the SCCRXIACK shape) would open two new entries into the C040 path,
686:		    so pcc2c040kill goes first.  The %= fold above IS the real part's:
687:		    Motorola VMESBCP2 Table 6-1 lists $FFF42040-$FFF42FFF as repeated
688:		    PCCchip2 registers.  */
689:		if (!(d->warned_unimpl & (1ULL << relative_addr))) {
690:			d->warned_unimpl |= 1ULL << relative_addr;
691:			if (writeflag == MEM_WRITE)
692:				fatal("[ pcc2: unimplemented write to offset "
693:				    "0x%x (len %d): 0x%x -- declined.  (once) ]\n",
694:				    (int) relative_addr, (int) len, (int) idata);
695:			else
696:				/*  data[0] is the byte actually SERVED; a reload of the
697:				    array could differ: on the end-span path (zero-filled,
698:				    the array byte kept) and inside a running COUNT word,
699:				    whose SIGALRM-driven tick (timer.c) can land between
700:				    the copy and this line.  A wide read is labelled.  */
701:				fatal("[ pcc2: unimplemented read from offset "
702:				    "0x%x (len %d) -- served 0x%02x.  (once) ]\n",
703:				    (int) relative_addr, (int) len, data[0]);
704:		}
705:		break;
706:	}
707:
708:	return 1;
709:}
