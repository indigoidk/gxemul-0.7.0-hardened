359:
360:	memory_device_register(devinit->machine->memory, "lca_pci_conf",
361:	    LCA_PCI_CONF, 0x20000000, dev_lca_pci_conf_access, (void *)d,
362:	    DM_DEFAULT, NULL);
363:
364:	memory_device_register(devinit->machine->memory, "lca_isa",
365:	    LCA_PCI_SIO, 0x10000 << 5, dev_lca_isa_access, (void *)d,
366:	    DM_DEFAULT, NULL);
367:
368:	memory_device_register(devinit->machine->memory, "lca_ioc",
369:	    LCA_IOC_BASE, 0x20000000, dev_lca_ioc_access, (void *)d,
370:	    DM_DEFAULT, NULL);
371:
372:	CHECK_ALLOCATION(interrupt_path = (char *)
373:	    malloc(strlen(devinit->machine->path) + 10));
