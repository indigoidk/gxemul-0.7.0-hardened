383:	interrupt_handler_register(&interrupt_template);
384:
385:	bus_isa_init(devinit->machine, interrupt_path,
386:	    BUS_ISA_IDE0 | BUS_ISA_IDE1, LCA_ISA_BASE, LCA_ISA_MEMBASE);
387:
388:	return 1;
389:}
