375:	    "%s.lca", devinit->machine->path);
376:
377:	memset(&interrupt_template, 0, sizeof(interrupt_template));
378:	interrupt_template.line = 0;
379:	interrupt_template.name = interrupt_path;
380:	interrupt_template.extra = d;
