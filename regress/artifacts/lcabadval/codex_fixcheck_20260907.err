182:DEVICE_ACCESS(lca_ioc)
183:{
184:	uint64_t idata = 0, odata = 0;
185:	struct lca_data *d = (struct lca_data *) extra;
186:
187:	if (writeflag == MEM_WRITE)
188:		idata = memory_readmax64(cpu, data, len);
189:
190:	switch (relative_addr + LCA_IOC_BASE) {
191:
192:	case LCA_IOC_BASE:
193:		/*  Ignore? Linux reads from the base at startup.  */
194:		break;
195:
196:	case LCA_IOC_CONF:
197:		if (writeflag == MEM_READ) {
198:			odata = d->ioc_conf;
199:		} else {
200:			d->ioc_conf = idata;
201:			/*  Only bit 0 is implemented so far, the PCI bus 0 vs
202:			    bus non-0 selection bit.  */
203:			if (idata & ~1) {
204:				/*  #506: was `0x%x', (int)idata -- a 64-bit guarded value
205:				    narrowed to 32 in the KILL diagnostic, so a write of
206:				    0x100000000 trips `idata & ~1' and then reports "0x0",
207:				    which is a value this same guard ACCEPTS.  The five
208:				    sibling arms below already print the full width this
209:				    way; this arm was the outlier among the VALUE-guard
210:				    diagnostics.  (Not the file's only narrowing site --
211:				    the default arm below has the same cast, and this
212:				    round fixes it too.)  */
213:				fatal("TODO: Write to unimplemented bit of"
214:				    " IOC_CONF: 0x%" PRIx64 "\n", (uint64_t)idata);
215:				exit(1);
216:			}
217:		}
218:		break;
219:
220:	case LCA_IOC_TBIA:
221:		/*  TLB Invalidate All.  */
222:		/*  TODO: For now, let's just ignore it.  */
223:		break;
224:
225:	case LCA_IOC_TB_ENA:
226:		if (writeflag == MEM_READ) {
227:			odata = d->tlb_enable;
228:		} else {
229:			d->tlb_enable = idata;
230:			/*  TODO: Actually implement this.  */
231:			if (idata & ~IOC_TB_ENA_TEN) {
232:				fatal("TODO: LCA_IOC_TB_ENA value "
233:				    " (0x%" PRIx64") has unimplemented "
234:				    "bits.\n", (uint64_t)idata);
235:				exit(1);
236:			}
237:		}
238:		break;
239:
240:	case LCA_IOC_W_BASE0:
241:		if (writeflag == MEM_READ) {
242:			odata = d->window_base_0;
243:		} else {
244:			d->window_base_0 = idata;
245:			/*  TODO: Actually implement this.  */
246:			if (idata != 0ULL && idata != 0x300800000ULL) {
247:				fatal("TODO: LCA_IOC_W_BASE0 value differs"
248:				    " (0x%" PRIx64") from the only implemented"
249:				    " values\n", (uint64_t)idata);
250:				exit(1);
251:			}
252:		}
253:		break;
254:
255:	case LCA_IOC_W_MASK0:
256:		if (writeflag == MEM_READ) {
257:			odata = d->window_mask_0;
258:		} else {
259:			d->window_mask_0 = idata;
260:			/*  TODO: Actually implement this.  */
261:			if (idata != 0x700000ULL) {
262:				fatal("TODO: LCA_IOC_W_MASK0 value differs"
263:				    " (0x%" PRIx64") from the only implemented"
264:				    " value\n", (uint64_t)idata);
265:				exit(1);
266:			}
267:		}
268:		break;
269:
270:	case LCA_IOC_W_T_BASE0:
271:		if (writeflag == MEM_READ) {
272:			odata = d->window_t_base_0;
273:		} else {
274:			d->window_t_base_0 = idata;
275:			/*  TODO: Actually implement this.  */
276:		}
277:		break;
278:
279:	case LCA_IOC_W_BASE1:
280:		if (writeflag == MEM_READ) {
281:			odata = d->window_base_1;
282:		} else {
283:			d->window_base_1 = idata;
284:			/*  TODO: Actually implement this.  */
285:			if (idata != 0x240000000ULL) {
286:				fatal("TODO: LCA_IOC_W_BASE1 value differs"
287:				    " (0x%" PRIx64") from the only implemented"
288:				    " value\n", (uint64_t)idata);
289:				exit(1);
290:			}
291:		}
292:		break;
293:
294:	case LCA_IOC_W_MASK1:
295:		if (writeflag == MEM_READ) {
296:			odata = d->window_mask_1;
297:		} else {
298:			d->window_mask_1 = idata;
299:			/*  TODO: Actually implement this.  */
300:			if (idata != 0x3ff00000ULL) {
301:				fatal("TODO: LCA_IOC_W_MASK1 value differs"
302:				    " (0x%" PRIx64") from the only implemented"
303:				    " value\n", (uint64_t)idata);
304:				exit(1);
305:			}
306:		}
307:		break;
308:
309:	case LCA_IOC_W_T_BASE1:
310:		if (writeflag == MEM_READ) {
311:			odata = d->window_t_base_1;
312:		} else {
313:			d->window_t_base_1 = idata;
314:			/*  TODO: Actually implement this.  */
315:		}
316:		break;
317:
318:	default:fatal("[ lca_ioc: unimplemented %s to offset 0x%x",
319:		    writeflag == MEM_WRITE? "write" : "read", (int)
320:		    relative_addr);
321:		if (writeflag == MEM_WRITE)
322:			fatal(": 0x%" PRIx64, (uint64_t)idata);	/*  #506  */
323:		fatal(" ]\n");
324:		exit(1);
325:	}
326:
327:	if (writeflag == MEM_READ)
328:		memory_writemax64(cpu, data, len, odata);
329:
330:	return 1;
331:}
