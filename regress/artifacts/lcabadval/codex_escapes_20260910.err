import ast, pathlib, collections, difflib, hashlib
root = pathlib.Path('.')
p = root/'regress/artifacts/lcabadval/killtable_20260910/t4/lca_badval_probe.REPAIRED67.asrun.py'
s = p.read_text()
t = ast.parse(s)
env = {}
def literal(n):
    if isinstance(n, ast.Constant): return n.value
    if isinstance(n, ast.Name): return env[n.id]
    if isinstance(n, (ast.List, ast.Tuple)): return [literal(x) for x in n.elts]
    if isinstance(n, ast.BinOp):
        a,b = literal(n.left),literal(n.right)
        if isinstance(n.op, ast.Add): return a+b
        if isinstance(n.op, ast.Mult): return a*b
        if isinstance(n.op, ast.BitOr): return a|b
    if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == 'k0': return env['K0SEG']|literal(n.args[0])
    raise ValueError(type(n).__name__)
for n in t.body:
    if isinstance(n, ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0], ast.Name):
        try: env[n.targets[0].id] = literal(n.value)
        except (ValueError, KeyError, TypeError): pass
writes = collections.defaultdict(set)
for arm in env['ARMS']:
    writes[arm[1]].update(arm[2:4])
for n in t.body:
    if isinstance(n, ast.Assign) and isinstance(n.value, ast.Call) and isinstance(n.value.func, ast.Name) and n.value.func.id == 'seq':
        consts, phases = [literal(x) for x in n.value.args[:2]]
        for phase in phases:
            for op,a,v in phase:
                if op == 'st': writes[consts[a] & ~env['K0SEG']].add(consts[v])
print('STATIC AST: register writes extracted without importing or executing the probe')
for key in ['IOC_W_MASK0','IOC_W_MASK1','IOC_W_BASE0','IOC_W_BASE1']:
    vals=sorted(writes[env[key]])
    print(key, ', '.join(hex(v) for v in vals))
    if 'MASK' in key: print('  f:', ', '.join(hex(v) for v in sorted({(v&0xfff00000)>>20 for v in vals})))
    anybits=0
    for v in vals: anybits |= v
    print('  set bits seen:', [b for b in range(64) if anybits & (1<<b)])
print('STATIC SNAPSHOT COMPARISONS')
for lhs,rhs in [('src/devices/dev_lca.c','regress/artifacts/lcabadval/killtable_20260910/t4/BASELINE_round4.c'),('regress/lca_badval_probe.py',str(p)),('regress/artifacts/lcabadval/killtable_20260910/t2/BASELINE_t2.c','regress/artifacts/lcabadval/killtable_20260910/t4/BASELINE_round4.c')]:
    a,b=pathlib.Path(lhs).read_bytes(),pathlib.Path(rhs).read_bytes()
    print(lhs,'vs',rhs, 'IDENTICAL' if a==b else 'DIFFERENT')
    print('MD5',hashlib.md5(a).hexdigest(),hashlib.md5(b).hexdigest())
    if a"'!=b:
        print('"''.join(difflib.unified_diff(a.decode().splitlines(True),b.decode().splitlines(True),fromfile=lhs,tofile=rhs)))
for p in sorted((root/'regress/artifacts/lcabadval/killtable_20260910/t4').glob('*.raw')):
    lines=p.read_text().splitlines()
    print('LOG',p.name,'rows',sum(x.endswith(' ok') or x.endswith(' FAIL') for x in lines),'reds',sum(x.endswith(' FAIL') for x in lines),'tail',lines[-1])
