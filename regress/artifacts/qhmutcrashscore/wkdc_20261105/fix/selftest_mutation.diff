--- HEAD:regress/selftest_mutation.sh
+++ fix/selftest_mutation.sh
@@ -166,10 +166,16 @@
     [ $? -eq 0 ] && echo ok || echo FAIL
 }
 
-build_and_run() {   # label, source file -> prints DIFF_PASS count
+build_and_run() {   # label, source file -> prints DIFF_PASS count, BUILDFAIL, or NOLOG rc=<n>
     $CC -O2 -I"$TREE/src/include" -o "$T/$1" \
         "$HERE/diff_ieee_store.c" "$2" -lm > "$T/$1.build" 2>&1 || { echo "BUILDFAIL"; return; }
     "$T/$1" > "$T/$1.out" 2>&1
+    local rc=$?
+    #  killdrivercrash (task #55): a run that never printed its verdict is NOT a detection.
+    #  Counting DIFF_PASS alone scored a mutant that crashed, called exit(1) or printed
+    #  nothing as "DETECTED" -- measured: with all seven mutants killed by SIGFPE this gate
+    #  went PASS.  The verdict line is the differential's last line, so it is the sentinel.
+    grep -qE '^DIFF_(PASS|FAIL)' "$T/$1.out" || { echo "NOLOG rc=$rc"; return; }
     grep -c 'DIFF_PASS' "$T/$1.out"
 }
 
