955: 
956: /*
957:  *  cmplwi:  Compare Word immediate, logical
958:  *
959:  *  arg[0] = ptr to ra
960:  *  arg[1] = int32_t imm
961:  *  arg[2] = 28 - 4*bf
962:  */
963: X(cmplwi)
964: {
965: 	uint32_t tmp = reg(ic->arg[0]), imm = ic->arg[1];
966: 	int bf_shift = ic->arg[2], c;
967: 	if (tmp < imm)
968: 		c = 8;
969: 	else if (tmp > imm)
970: 		c = 4;
971: 	else
972: 		c = 2;
973: 	/*  SO bit, copied from XER  */
974: 	c |= ((cpu->cd.ppc.spr[SPR_XER] >> 31) & 1);
975: 	cpu->cd.ppc.cr &= ~((uint32_t)0xf << bf_shift);
976: 	cpu->cd.ppc.cr |= ((uint32_t)c << bf_shift);
