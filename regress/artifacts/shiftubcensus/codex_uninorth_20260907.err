2289: 		break;
2290: 	case PPC_31_STDCX_DOT:
2291: 		len = 8;
2292: 	case PPC_31_STWCX_DOT:
2293: 		break;
2294: 	}
2295: 
2296: 	rt = (iw >> 21) & 31;
2297: 	ra = (iw >> 16) & 31;
2298: 	rb = (iw >> 11) & 31;
