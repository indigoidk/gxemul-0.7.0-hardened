2343: 			cpu->cd.ppc.cr &= 0x0fffffff;
2344: 			if (old_so)
2345: 				cpu->cd.ppc.cr |= 0x10000000;
2346: 			cpu->cd.ppc.ll_bit = 0;
2347: 			return;
2348: 		}
2349: 
2350: 		for (i=0; i<len; i++) {
2351: 			if (cpu->byte_order == EMUL_BIG_ENDIAN)
2352: 				d[len - 1 - i] = value >> (8*i);
2353: 			else
2354: 				d[i] = value >> (8*i);
2355: 		}
2356: 
2357: 		if (cpu->memory_rw(cpu, cpu->mem, addr, d, len,
2358: 		    MEM_WRITE, CACHE_DATA) != MEMORY_ACCESS_OK) {
2359: 			/*  #216: (Codex/Fable) memory_rw() raised a DSI on the
2360: 			    faulting stwcx. address; let it proceed instead of
2361: 			    exit()ing the host.  */
2362: 			return;
2363: 		}
2364: 
2365: 		cpu->cd.ppc.cr &= 0x0fffffff;
2366: 		cpu->cd.ppc.cr |= 0x20000000;	/*  success!  */
2367: 		if (old_so)
2368: 			cpu->cd.ppc.cr |= 0x10000000;
2369: 
2370: 		/*  Clear _all_ CPUs' ll_bits:  */
2371: 		for (i=0; i<cpu->machine->ncpus; i++)
2372: 			cpu->machine->cpus[i]->cd.ppc.ll_bit = 0;
2373: 	}
2374: }
