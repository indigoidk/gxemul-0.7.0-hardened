172:CODE = 0x80001000
173:SENTINEL = 0x5a5a5a5a
174:RAMPLANT = 0x11223344
175:
176:#  KSEG1 (uncached), sign-extended the way the file's own :113 comment prints it:
177:#  "Address: 0xffffffffaff10018".  base 0x0ff00000 -> 0xffffffffaff00000.
178:BASE = 0xFFFFFFFFAFF00000
179:A_BANKCFG = BASE + 0x00020     # case 0x20    -> 0x80010000, the DEVICE SIGNATURE
180:A_IMASK0 = BASE + 0x10000      # case 0x10000 -> implemented r/w
181:A_R10018 = BASE + 0x10018      # case 0x10018 -> implemented r/w
182:A_SETISR = BASE + 0x10020      # case 0x10020 -> PREDICTED KILL, and no writeflag test
183:A_CLRISR = BASE + 0x10028      # case 0x10028 -> PREDICTED KILL, and no writeflag test
184:A_ISR = BASE + 0x10030         # case 0x10030 -> writeflag-TESTED; READ predicted SERVICED
185:A_C20000 = BASE + 0x20000    # case 0x20000 -> implemented r/w counter
186:A_C30000 = BASE + 0x30000    # case 0x30000 -> implemented r/w
187:A_RAM = 0xFFFFFFFF80002000     # KSEG0 RAM, for the liveness control
188:
189:OP_LW_V0_AT = 0x8C220000       # lw   $v0, 0($at)
190:OP_SW_T0_A3 = 0xACE80000       # sw   $t0, 0($a3)
191:#  *** 64-BIT FORMS ARE NOT OPTIONAL FOR imask0.  `case 0x10000' does
192:#  `d->imask0 = idata' with `idata = memory_readmax64(cpu, data, len)', so a 4-BYTE
193:#  `sw' CAPS idata BELOW 2^32 AND BIT 50 CAN NEVER BE SET.  Measured: sw 0xffffffff
194:#  + 70000 steps -> ALIVE.  A tick row built with OP_SW_T0_A3 would arm NOTHING,
195:#  stay alive, and score GREEN ON A LIVE HOST DEATH. ***
196:OP_SD_T0_A3 = 0xFCE80000       # sd   $t0, 0($a3)   -- REQUIRED to reach bit 50
197:OP_LD_V0_AT = 0xDC220000       # ld   $v0, 0($at)   -- its readback
198:OP_B_SELF = 0x1000FFFF         # b    .
199:OP_NOP = 0x00000000
