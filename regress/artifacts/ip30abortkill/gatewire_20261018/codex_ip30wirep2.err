337:# ------------------------------------------------------------------ CONTROL=DEAD set
338:#  If any of these reds the vehicle is not the vehicle, and NO kill row may be scored.
339:t, alive = session(["put w 0x%x, 0x%08x" % (A_RAM & 0xFFFFFFFF, RAMPLANT)]
340:                   + guest_load(A_RAM))
341:live_got = printed(t, "v0") if alive else "died"
342:row("live", live_got, "0x%x" % RAMPLANT,
343:    "LIVENESS: a known value planted in RAM returns through a guest load. If this reds, plant "
344:    "or step or print never executed and nothing below is evidence.")
345:
346:t, alive = session(guest_load(A_BANKCFG))
347:devsig_got = printed(t, "v0") if alive else "died"
348:row("devsig", devsig_got, "0xffffffff80010000",
349:    "DEVICE-SIGNATURE: case 0x20 answers 0x80010000 and `lw' SIGN-EXTENDS it to "
350:    "0xffffffff80010000 on this 64-bit R10000 -- a value RAM cannot produce. One control is "
351:    "NOT enough: the footbridge probe's first draft returned 0x0 everywhere with its RAM "
352:    "control green.")
353:
354:# ------------------------------------------------------------------ accept side
355:t, alive = session(guest_store(A_R10018, 0xDEADBEEF) + guest_load(A_R10018))
356:row("acc 18", (printed(t, "v0") if alive else "died"), "0xffffffffdeadbeef",
357:    "case 0x10018 is IMPLEMENTED r/w (the PROM complains without it). An accept control, and "
358:    "the de-escalation clause's accept row for this arm.  *** THE WANT IS SIGN-EXTENDED: `lw' sign-extends on this 64-bit R10000, so 0xdeadbeef comes back as 0xffffffffdeadbeef.  My first oracle wanted the truncated form and reddened a CORRECT device -- the apparatus was wrong, not the model. ***")
359:
360:t, alive = session(guest_load(A_ISR))
361:row("acc 30 rd", ("alive" if alive else "died"), "alive",
362:    "case 0x10030 IS writeflag-tested, so its READ returns d->isr and must NOT die. This is "
363:    "the row that proves the three arms are NOT uniform.")
364:
365:#  ---------------------------------------------------------------- de-escalation accept rows
366:#  A fatal->survive fix DELETES the accidental tripwire that made guard growth self-announcing,
367:#  so the detector shipping WITH the fix owes the ACCEPT SIDE of every predicate that used to
368:#  gate death.  These are owed under EVERY candidate member, which is why they are written
369:#  before the disposition is settled -- they cannot be wasted work.
370:#  *** THIS ROW EXPECTED A COUNTER NOT TO COUNT, SO IT WAS RED ON A CORRECT BUILD.  L1
371:#  construction repair, 2026-09-17, found by running the pre-fix baseline. ***
372:#
373:#  Measured: stored 0x1234, read back 0x161c -- and 0x161c - 0x1234 = 0x3e8 = 1000 EXACTLY,
374:#  which is `d->reg_0x20000 += 1000' in DEVICE_TICK.  The DEVICE was right and the ROW was
375:#  wrong: as written it manufactured a phantom failure on a correct build, so it could never
376:#  signal the defect this probe exists for.  (The file's own `/*  A counter  */' comment on
377:#  case 0x20000 says so; the access arm alone reads like a plain r/w register.)
378:#
379:#  THE REPAIRED ORACLE IS STRICTLY STRONGER THAN THE ONE IT REPLACES.  The counter is always
380:#  a multiple of 1000 (it starts at 0 and only ever += 1000), and 0x1234 = 4660 is NOT a
381:#  multiple of 1000 -- so:
382:#      store LANDED    -> readback - 0x1234 == N*1000, an exact multiple
383:#      store LOST      -> readback is some M*1000, and M*1000 - 4660 is NEVER a multiple
384:#  The row therefore pins THAT THE STORE REACHED reg_0x20000, which the old literal compare
385:#  only did by accident on a tickless run, while tolerating any number of ticks.
386:t, alive = session(guest_store(A_C20000, 0x1234) + guest_load(A_C20000))
387:_v20000 = printed(t, "v0")
388:_got20000 = "ABSENT"
389:if alive and _v20000 != "ABSENT":
390:    _d20000 = int(_v20000, 16) - 0x1234
391:    _got20000 = ("stored+N*1000" if (_d20000 >= 0 and _d20000 % 1000 == 0)
392:                 else _v20000)
393:row("acc 20000", (_got20000 if alive else "died"), "stored+N*1000",
394:    "case 0x20000 is writeflag-tested r/w AND is incremented 1000 per DEVICE_TICK, so the "
395:    "oracle pins that the STORE LANDED (the residue is an exact multiple of the tick stride) "
396:    "rather than that a counter stood still.  A neighbour that must keep working.")
397:
398:t, alive = session(guest_store(A_C30000, 0x5678) + guest_load(A_C30000))
399:row("acc 30000", (printed(t, "v0") if alive else "died"), "0x5678",
400:    "case 0x30000, writeflag-tested r/w. Second neighbour.")
