286:def guest_load(addr):
287:    """A REAL guest instruction through real decode and real memory_rw -- rung 3.
288:    NOT `dump': all four ip30 registrations are DM_DEFAULT, so dump BYPASSES the handler
289:    and would prove nothing about the device at all."""
290:    return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT]) + ["print v0"]
291:
292:
293:def guest_store(addr, val):
294:    return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([OP_SW_T0_A3])
295:
296:
297:def guest_store64(addr, val):
298:    """A 64-BIT store.  The ONLY way to reach imask0 bit 50 -- see OP_SD_T0_A3."""
299:    return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([OP_SD_T0_A3])
300:
301:
302:def guest_load64(addr):
303:    return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LD_V0_AT]) + ["print v0"]
304:
305:
306:def printed_last(t, reg):
307:    """*** THE LAST `print <reg>', NOT THE FIRST. ***  L1 repair 2026-09-17.
308:
309:    `printed()' uses `re.search', which returns the FIRST match.  A row that issues
310:    MORE THAN ONE guest_load therefore reads the WRONG load's value, silently -- and
311:    `isr keep' does three commands ending in the read-back it actually wants.
312:
313:    PRE-FIX THE BUG WAS INVISIBLE because the row's seeding write aborted and the row
314:    read `died'; the construction defect only surfaced once the fix let the session
315:    survive.  A row that cannot pass even on a correct fix is vacuous, so this is L1
316:    construction, repaired in-round rather than filed."""
317:    m = re.findall(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
318:    return m[-1] if m else "ABSENT"
319:
320:
321:def counted(t, needle):
322:    """*** HOW MANY TIMES DID THIS ANNOUNCE FIRE? ***  Added by the #531 class closure.
323:
324:    Presence is not enough for the LATCH cells.  A defeated latch (mask -> 0) announces on
325:    EVERY access and a presence oracle reads `yes' either way -- the CHANNEL vacuity, one
326:    level along.  Only a COUNT varies under that mutant."""
327:    return t.count(needle)
328:
329:
330:def printed(t, reg):
331:    """`print <reg>' emits a BARE 0x... -- `reg' is the command that carries the `r0 = ' prefix.
332:    Copied from regress/lca_isalane_probe.py rather than invented."""
333:    m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
334:    return m.group(1) if m else "ABSENT"
