208:def session(cmds, settle=2.0, spin=2.5):
209:    """One fresh process per SESSION -- most sessions score one row, but
210:    `tick 50`/`tick 50 txt` and `xbit isr`/`xbit tick` each score two rows from
211:    one process, by design (the cross-bit mutant needs both announce classes in
212:    one device lifetime) (#561).  Returns (transcript, alive)."""
213:    pid, fd = pty.fork()
214:    if pid == 0:
215:        os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip30", "-M", "64",
216:                       "0x%x:" % CODE + DUMMY])
217:        os._exit(127)
218:    buf = ""
219:
220:    def rd(t):
221:        nonlocal buf
222:        end = time.time() + t
223:        while time.time() < end:
224:            try:
225:                r, _, _ = select.select([fd], [], [], 0.1)
226:            except OSError:
227:                return
228:            if not r:
229:                continue
230:            try:
231:                d = os.read(fd, 65536)
232:            except OSError:
233:                return
234:            if not d:
235:                return
236:            buf += d.decode("utf-8", "replace")
237:
238:    rd(settle)
239:    for c in cmds:
240:        try:
241:            os.write(fd, (c + "\n").encode())
242:        except OSError:
243:            break
244:        rd(0.35)
245:    rd(spin)
246:
247:    #  *** POLL, NEVER SAMPLE ONCE.  MEASURED 2026-09-17, and the first run of this probe
248:    #  reported `alive' for a process that SIGABRT'd 0.6 s later. ***
249:    #  `rd()' RETURNS IMMEDIATELY ON EOF rather than waiting out its timeout, so `spin' --
250:    #  which exists precisely to give a dying child time to die -- is SKIPPED EXACTLY WHEN THE
251:    #  CHILD DIES.  A single waitpid(WNOHANG) then lands ~0 s after EOF while the kernel is
252:    #  still writing a 6 MB core, reports "still running", and THE KILL ROW GOES GREEN ON A
253:    #  LIVE HOST DEATH.  That is the false-green this probe exists to refuse.
254:    alive = True
255:    deadline = time.time() + 12.0
256:    while time.time() < deadline:
257:        try:
258:            wpid, status = os.waitpid(pid, os.WNOHANG)
259:        except ChildProcessError:
260:            alive = False
261:            break
262:        if wpid == pid:
263:            alive = False
264:            break
265:        time.sleep(0.05)
266:    if alive:
267:        try:
268:            os.kill(pid, signal.SIGKILL)
269:            os.waitpid(pid, 0)
270:        except OSError:
271:            pass
272:    try:
273:        os.close(fd)
274:    except OSError:
275:        pass
276:    return buf, alive
277:
278:
279:def run_ops(ops, at=CODE):
280:    put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
281:    put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
282:            "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
283:    return put + ["pc=0x%x" % at, "step %d" % len(ops)]
