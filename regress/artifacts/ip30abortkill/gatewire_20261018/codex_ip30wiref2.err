1:#!/bin/bash
2:#  legs566.sh -- #566's measurement legs for the ip30_abort gate block, run in a SCRATCH CLONE of build/
3:#  (/tmp/gx566), never in build/ itself (the 2026-08-28 kill-table default).
4:#
5:#  BASELINE: SEC HEAD.  build/ carries five uncommitted files of another session (alpha/lca/pcc2/sh4 and
6:#  mvme_pcctworeg.h); the clone has those five set back to HEAD before anything is built, and the clone's
7:#  dev_sgi_ip30.c is checked byte-identical to HEAD's.
8:#
9:#  LEGS (each scored by the block's own scoring text, extracted from the working tree's gate_arm.sh):
10:#    base    HEAD, rebuilt in the clone                         -> must be GREEN (all checks)
11:#    prefix  HEAD with dev_sgi_ip30.c set to 686d179c^ (= the     -> must RED   (clause (a); it is also the
12:#            upstream import, the only other version) -- the        verbatim reinstatement of every fixed
13:#            four abort() calls back                                site, clause (b), since #531 touched no
14:#                                                                    other source file)
15:#    absent  /nonexistent/gxemul                                -> must RED   (clause (c), null medium)
16:#    nonemu  /bin/true                                          -> must RED   (clause (c), null medium)
17:set -u
18:SEC=/mnt/c/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC
19:B=/mnt/c/DocumentNoSnc/cc/GXEMUL/build
20:W=/mnt/c/Users/User00/AppData/Local/Temp/claude/C--DocumentNoSnc-cc-GXEMUL/8e474f41-4d47-4c99-bf11-3406a84c4fcd/scratchpad/w566
21:C=/tmp/gx566
22:OUT=$SEC/regress/artifacts/ip30abortkill/gatewire_20261018/legs
23:mkdir -p "$OUT"
24:echo "LEGS566 start $(date '+%F %T')"
25:echo "probe md5 $(md5sum < "$SEC/regress/artifacts/ip30abortkill/ip30_abort_probe.py" | cut -c1-32)  gate_arm.sh md5 $(md5sum < "$SEC/regress/gate_arm.sh" | cut -c1-32)"
26:
27:rm -rf "$C"
28:cp -a "$B" "$C" || { echo "CLONE FAILED"; exit 9; }
29:echo "SCRATCH CLONE of build/ (#566): five shared sources set to HEAD; dev_sgi_ip30.c is mutated by the prefix leg" > "$C/.MUTANT"
30:for f in src/cpus/cpu_alpha_palcode.c src/devices/dev_lca.c src/devices/dev_pcc2.c src/devices/dev_sh4.c src/include/thirdparty/mvme_pcctworeg.h; do
31:    cp "$W/headsrc/$f" "$C/$f" || { echo "COPY FAILED $f"; exit 9; }
32:    echo "set to HEAD: $f"
33:done
34:rm -f "$C/src/devices/dev_lca.o" "$C/src/devices/dev_pcc2.o" "$C/src/devices/dev_sh4.o" \
35:      "$C/src/devices/dev_clmpcc.o" "$C/src/machines/machine_mvme88k.o"
36:cmp -s "$W/head_dev_sgi_ip30.c" "$C/src/devices/dev_sgi_ip30.c" && echo "clone dev_sgi_ip30.c == HEAD" \
37:    || { echo "clone dev_sgi_ip30.c is NOT HEAD -- stop"; exit 9; }
38:
39:build() {
40:    (cd "$C" && rm -f src/cpus/*.o src/devices/dev_sgi_ip30.o && make -j4 > "$OUT/build_$1.log" 2>&1)
41:    echo "make rc=$? ($1)"
42:    for f in src/devices/dev_sgi_ip30.c src/devices/dev_lca.c src/devices/dev_pcc2.c src/devices/dev_sh4.c \
43:             src/cpus/cpu_alpha_palcode.c src/include/thirdparty/mvme_pcctworeg.h; do
44:        [ "$C/gxemul" -nt "$C/$f" ] || { echo "BINARY NOT NEWER THAN $f ($1) -- stop"; exit 9; }
45:    done
46:    echo "binary fresh ($1): $(ls -la --time-style=+%T "$C/gxemul" | awk '{print $6, $5}')"
47:}
48:run() {
49:    t0=$(date +%s)
50:    (cd "$SEC/regress" && timeout 1500 python3 -u artifacts/ip30abortkill/ip30_abort_probe.py "$2" gate > "$OUT/probe_$1.log" 2>&1)
51:    prc=$?
52:    echo "$prc" > "$OUT/probe_$1.rc"
53:    echo "probe $1: rc=$prc $(( $(date +%s) - t0 ))s  $(grep -a '^IP30ABORT_RESULT=' "$OUT/probe_$1.log" | tr '\n' ' ') last=[$(tail -1 "$OUT/probe_$1.log")]"
54:}
55:
56:build base
57:run base "$C/gxemul"
58:cp "$W/upstream_dev_sgi_ip30.c" "$C/src/devices/dev_sgi_ip30.c"
59:echo "clone dev_sgi_ip30.c := 686d179c^ (the upstream import): $(grep -c 'abort()' "$C/src/devices/dev_sgi_ip30.c") abort() calls"
60:build prefix
61:run prefix "$C/gxemul"
62:run absent /nonexistent/gxemul
63:run nonemu /bin/true
