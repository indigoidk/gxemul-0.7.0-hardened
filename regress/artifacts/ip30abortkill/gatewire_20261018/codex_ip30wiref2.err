tools/pipeline/stage_tokens.py
1:"""THE ONE PLACE A LEDGER STAGE TOKEN IS SPELLED OR CLASSIFIED.  #534, 2026-09-18.
2:
3:WHY THIS FILE EXISTS.  Four tools read ledger entries and each carried its own copy of the tokens:
4:check_stage_panels.py knew four, check_fable_queue.py was never taught RE_READ, gen_dashboard.py
5:filtered HELD markers it had no business filtering, and check_fix_seats.py knew only HELD -- so it
6:credited a stage-exemption entry written under `seat: fable5' as a FLAGSHIP ANSWER, and the row that
7:introduced the newest token passed its own flagship mandate on that token (#532 pass 2, Opus seat,
8:MEASURED).  One cause every time: a token added where it was needed and never mirrored.  So the
9:literals AND the classification live here, and precommit_check.sh refuses a token literal anywhere
10:else in tools/pipeline/.  *** THREE of those four readers ship with #534 and are covered by its controls;
11:check_fix_seats.py is another round's untracked, unwired draft -- it imports is_answer from here but NO
12:control covers it until it ships (fable5, #534 last seat: this sentence overclaimed until then). ***
13:
14:AN ENTRY HAS TWO INDEPENDENT PROPERTIES, and the #532 code conflated them:
15:
16:  is_answer(e)     -- does this entry count as the seat answering?
17:  exempts_stage(e) -- does this entry exempt its WHOLE (row, phase) stage from the panel rule?
18:
19:                    is_answer   exempts_stage
20:    HELD             no           no          (a promise; handled by its own rules)
21:    ANNOTATION       no           yes         (pre-2026-08-16 policy)
22:    RE_READ          YES          yes         (a real single-seat re-read -- fable measured one
23:                                               rendering as agreement pre-#532, rightly)
24:    NOPANEL          no           yes         (no panel was convened on this stage)
25:    NOTSEAT          no           NO          (THIS ENTRY is a main-loop record, not a seat
26:                                               answer; it can never silence other entries)
27:    anything else    yes          no
28:
29:NOTSEAT IS THE ENTRY-SCOPED MARKER, and it is the one to reach for by default.  #532 used the
30:stage-scoped NOPANEL for six records that meant only "this entry is not a seat answer"; on those
31:rows any panel LATER recorded under the same phase would have been silently exempted in advance
32:(fable5, #532 pass 2, R2).  A stage exemption is a claim about everything in the stage and must be
33:earned; see stage_token_problems() for the guard.
34:"""
35:import re
36:
37:HELD = "[HELD AWAITING SEAT:"
38:ANNOTATION = "[RUN UNDER THE PRE-2026-08-16 POLICY]"
39:RE_READ = "[NOT A PANEL STAGE: SINGLE-SEAT RE-READ]"
40:NOPANEL = "[NOT A PANEL STAGE: NO PANEL CONVENED]"
41:NOTSEAT = "[NOT A SEAT ANSWER]"
42:
43:STAGE_EXEMPT = (ANNOTATION, RE_READ, NOPANEL)
44:ALL = (HELD, ANNOTATION, RE_READ, NOPANEL, NOTSEAT)
45:
46:PANEL_DIR = re.compile(r"panel_\d{8}_\d{6}")
47:
48:
49:def _note(e):
50:    return e.get("note") or ""
51:
52:
53:def is_held(e):
54:    return HELD in _note(e)
55:
56:
57:def exempts_stage(e):
58:    n = _note(e)
59:    #  HELD and NOTSEAT both dominate: a hold is a promise and NOTSEAT says "this entry only" -- an
60:    #  entry carrying either can never exempt the stage, whatever else it quotes (minimax, #534 pass 2:
61:    #  the docstring promised this of NOTSEAT and the code did not deliver it).
62:    return (not is_held(e)) and NOTSEAT not in n and any(t in n for t in STAGE_EXEMPT)
63:
64:
65:def is_answer(e):
66:    n = _note(e)
67:    if HELD in n or NOTSEAT in n or ANNOTATION in n or NOPANEL in n:
68:        return False
69:    return True          # RE_READ entries ARE answers; so is every untokened entry
70:
71:
72:HELD_SEATS = re.compile(re.escape(HELD) + r"[ \t]*([a-z0-9_]+(?:[ \t]*,[ \t]*[a-z0-9_]+)*)[ \t]*\]")
73:#  case-SENSITIVE, like is_held() -- they disagreed until the #534 F2 pass (codex); the ledger holds
74:#  zero non-canonical spellings, so this changes no real reading
75:
76:
77:MALFORMED = "?malformed-hold"
78:POLICY_CUTOFF = "2026-08-16"   # full panel on every stage; work before it is not judged by it
79:
80:
81:def held_seats(e):
82:    """The seats a HELD entry names, in order, or [] if it names none in the strict shape."""
83:    m = HELD_SEATS.search(_note(e))
84:    return [x.strip().lower() for x in m.group(1).split(",")] if m else []
85:
86:
87:def live_holds(entries):
88:    """Seats still awaited in one (row, phase): named by a HELD entry and NOT answered by that seat
89:    in this stage at a STRICTLY LATER date -- the carrier's discharge rule, applied here so every
90:    reader agrees on it.  (#534 pass 2, codex + Opus: two of the three stages that showed a full count
91:    over a hold were DISCHARGED holds, and one was live; a reader must tell them apart.)"""
92:    out = []
93:    for h in entries:
94:        if not is_held(h):
95:            continue
96:        hd = h.get("date") or ""
97:        named = held_seats(h)
98:        if not named:
99:            #  a hold in no parseable shape can never be discharged by an answer -- it holds until
100:            #  someone writes it properly; a malformed marker must not read as "nothing owed"
101:            #  (codex, #534 F2 pass: `[HELD AWAITING SEAT: glm,]` let a closed row pass H and I)
102:            if MALFORMED not in out:
103:                out.append(MALFORMED)
104:            continue
105:        for seat in named:
106:            done = any((e.get("seat") or "").lower() == seat and is_answer(e)
107:                       and (e.get("date") or "") > hd for e in entries)
108:            if not done and seat not in out:
109:                out.append(seat)
110:    return out
111:
112:
113:def stage_token_problems(entries):
114:    """Why a stage's exemption must be REFUSED, or [] if it stands.  `entries' = one (row, phase).
115:
116:    (i)  STRICTLY LATER -- EVERY exemption token: a tallied answer dated after the newest exemption
117:         entry.  An exemption is a claim about the stage AS IT STOOD; material recorded afterwards is
118:         new, and nothing about a token's vintage makes it cover the future (#534 pass 2: codex, Opus,
119:         deepseek, minimax, kimi all refused the NOPANEL-only scope; Opus measured that clause (i) was
120:         never the part that refused the legacy stages).
121:    (ii) UNCITED PANEL -- NOPANEL ONLY: a tallied answer cites a panel dir that no exemption entry
122:         names.  This clause IS the retroactive one: annotations and re-reads were written before an
123:         exemption had to name its panels, and applying it to them refused seven legacy stages for a
124:         requirement nobody owed at the time.  (A stage whose answers cite no panel dir passes it --
125:         Opus fixture G, a DISCLOSED escape.)
126:
127:    Brief-TITLE matching is deliberately absent: a correlate that missed BOTH real disputed cases
128:    (fable5, #532 pass 2, R4)."""
129:    tok = [e for e in entries if exempts_stage(e)]
130:    if not tok:
131:        return []
132:    newest_tok = max((e.get("date") or "") for e in tok)
133:    nop = [e for e in tok if NOPANEL in _note(e)]
134:    cited = set()
135:    for e in nop:
136:        cited |= set(PANEL_DIR.findall(_note(e) + " " + (e.get("ev") or "")))
137:    out = []
138:    for e in entries:
139:        if not is_answer(e) or e in tok:
140:            continue
141:        d = e.get("date") or ""
142:        #  a later answer that itself PREDATES the full-panel directive is not judged by it: the
143:        #  pre-policy stage it joined was grandfathered, and stays so (kimi, #534 F2 pass)
144:        if d > newest_tok and d >= POLICY_CUTOFF:
145:            out.append("answer by %s dated %s is LATER than the exemption (%s)"
146:                       % (e.get("seat"), d, newest_tok))
147:        if nop:
148:            for p in PANEL_DIR.findall(e.get("ev") or ""):
149:                if p not in cited:
150:                    out.append("answer by %s cites %s, which the exemption does not name"
151:                               % (e.get("seat"), p))
152:    return out
153:
154:
155:_CORES = {HELD: ("HELD AWAITING SEAT",), ANNOTATION: ("PRE-2026-08-16 POLICY", "RUN UNDER THE PRE"),
tools/pipeline/check_fable_queue.py
1:#!/usr/bin/env python3
2:"""FABLE WORK THAT IS OWED MUST BE QUEUED, NOT MERELY UNDONE.
3:
4:Owner directive, 2026-08-17: "make sure to gate and queue up any fable work; don't skip it."
5:
6:Two standing directives make some work only the flagship seat's, so it cannot be reassigned
7:when its quota is short:
8:
9:  * `regress` is FABLE-ONLY -- only the flagship seat reviews regression, batched.
10:  * FULL PANEL ON EVERY STAGE -- Fable is one of the nine, so a stage without it is short.
11:
12:When Fable is unavailable the honest move is to HOLD the stage and queue the job. The
13:dishonest move is to let the gap sit silently, and before this check existed there was
14:nothing between the two: `check_stage_panels.py` reports a HELD stage as waiting, but it
15:never asked whether anyone had written the job down. **A HELD marker with no queue entry is
16:a promise nobody recorded**, and it reads on the dashboard exactly like a promise kept.
17:
18:THREE RULES, each closing a different way to lose the work:
19:
20:  1. A stage that RAN (two or more seats) and lacks fable5 must carry a HELD marker, or be
21:     grandfathered. Otherwise it is a stage that simply proceeded without the flagship seat.
22:  2. Every HELD marker's row must be NAMED IN THE QUEUE FILE. This is the rule the directive
23:     actually asks for: holding and queueing are one action, not two.
24:  3. A CLOSED row that changed code and has no `regress` entry owes a regression review. It
25:     must be named in the queue. A round may not be finished and unreviewed at the same time.
26:
27:Exit 0 clean, 1 on violations. `--list` shows everything examined.
28:"""
29:import io
30:import json
31:import os
32:import re
33:import sys
34:
35:HERE = os.path.dirname(os.path.abspath(__file__))
36:#  Overridable so the negative controls can run against COPIES.  A check whose inputs are
37:#  hardcoded can only be negative-controlled by mutating the real ledger and restoring it --
38:#  and this project has already had a crashed mutation run leave a tree dirty, with the next
39:#  run's "original" backup capturing the mutant.  Copies cannot fail that way.
40:LEDGER = os.environ.get("GXLEDGER") or os.path.join(HERE, "ledger.json")
41:QUEUE = os.environ.get("GXQUEUE") or os.path.join(HERE, "fable_queue.md")
42:
43:FLAGSHIP = "fable5"
44:#  #534 (R5): every stage token is spelled and classified ONCE, in stage_tokens.py.  This file used
45:#  to carry its own copies, and it was the second of four tools to be blind to a token the others
46:#  knew (RE_READ, until 2026-09-18).  The history of that miss is in stage_tokens.py's docstring.
47:sys.path.insert(0, HERE)
48:import stage_tokens as st  # noqa: E402
49:
50:#  Directive dates.  Work that predates a directive cannot be judged by it.
51:CUTOFF_FULL_PANEL = "2026-08-16"   # full panel on every stage
52:CUTOFF_REGRESS_FABLE = "2026-08-15"  # regress becomes flagship-only
53:
54:
55:def main(argv):
56:    listing = "--list" in argv
57:    with open(LEDGER, encoding="utf-8") as f:
58:        ledger = json.load(f)
59:    #  *** THIS WAS A RAW SUBSTRING TEST OVER THE WHOLE FILE, AND THE GATE WENT GREEN OVER
60:    #  EXACTLY THE STATE IT EXISTS TO REDDEN. ***  Found 2026-08-21 by the flagship seat in a
61:    #  batched regress pass: check_fable_queue printed
62:    #        ok    sh4pcicexit    regress   owed and queued
63:    #  while the ONLY occurrence of that id in fable_queue.md was a PARENTHETICAL CROSS-REFERENCE
64:    #  on line 217, inside a different entry ("...one-instruction kills remain in the same file
65:    #  (`sh4pcicexit`)").  A MENTION satisfied "named in the queue" -- so the round with the worst
66:    #  detector prior in this project's history (seven of seven mutants escaped, one reinstating
67:    #  a host kill) had its regress review silently recorded as owed-and-queued when nothing was
68:    #  written down at all.
69:    #
70:    #  The fix idiom already existed three files away and had already been paid for: gate_offline's
71:    #  SM/SC manifests match stems EXACTLY in a loop, after being bitten by "a stem that is merely
72:    #  a prefix of another" (gate_offline.sh:1019-1023).  This is the same genus one directory up.
73:    #
74:    #  So an id counts as queued in exactly TWO places, and prose is not one of them:
75:    #    * it HEADS a hand-written entry -- `### <n>. \`id\`` or `### \`id\``;
76:    #    * or it appears inside the MACHINE-GENERATED wall block, which is a deliberate
77:    #      enumeration written by gen_codex_wall.py from the ledger, not commentary.
78:    #
79:    #  Scoping to the generated block matters and was not obvious: tightening to headings ALONE
80:    #  turned 0 unqueued holds into 35, because the bulk of held stages are legitimately carried
81:    #  by that block rather than by prose entries.  A check that reddens on correct state is as
82:    #  useless as one that greens on wrong state -- the first draft of this fix did exactly that
83:    #  for one run, and the 35 are the reason this comment exists.
84:    _raw = io.open(QUEUE, encoding="utf-8").read() if os.path.exists(QUEUE) else ""
85:    _BEGIN = "<!-- BEGIN GENERATED: codex-wall"
86:    _END = "<!-- END GENERATED: codex-wall -->"
87:    _gen = ""
88:    if _BEGIN in _raw and _END in _raw:
89:        _gen = _raw[_raw.index(_BEGIN):_raw.index(_END)]
90:    queue = set(re.findall(r"^###\s*(?:\d+\.\s*)?`([A-Za-z0-9_]+)`", _raw, re.M))
91:    queue |= set(re.findall(r"`([A-Za-z0-9_]+)`", _gen))
92:    if not queue:
93:        print("check_fable_queue: FABLE_QUEUE_FAIL  no queue file at %s" % QUEUE)
94:        return 1
95:
96:    short, unqueued_holds, unreviewed = [], [], []
97:    holds = 0
98:
99:    for row in ledger["rows"]:
100:        rid, state = row["id"], row.get("state", "?")
101:        stages, phases_seen = {}, set()
102:        for ent in row.get("entries", []):
103:            ph = ent.get("phase")
104:            phases_seen.add(ph)
105:            note = ent.get("note", "")
106:            d = stages.setdefault(ph, {"seats": set(), "newest": "", "held": False,
107:                                       "annotated": False, "all": []})
108:            d["all"].append(ent)
109:            #  #534: exempting the stage and being an answer are INDEPENDENT (a single-seat
110:            #  re-read is both), so they are asked separately -- never as one if/continue.
111:            if st.exempts_stage(ent):
112:                d["annotated"] = True
113:            if st.is_held(ent):
114:                d["held"] = True
115:                continue
116:            if not st.is_answer(ent):
117:                continue
118:            d["seats"].add(ent.get("seat"))
119:            d["newest"] = max(d["newest"], ent.get("date", ""))
120:
121:        for ph, d in stages.items():
122:            if ph == "regress":
123:                continue          # flagship-only by directive; rule 3 covers its absence
124:            if len(d["seats"]) < 2:
125:                continue          # a one-seat stage is a FILING, not a stage that ran
126:            if FLAGSHIP in d["seats"]:
127:                continue
128:            #  #534 (R4): an exemption that a later answer or an uncited panel contradicts does not
129:            #  exempt -- the same refusal check_stage_panels.py applies, from the same function.
130:            if d["annotated"] and not st.stage_token_problems(d["all"]):
131:                continue
132:            if d["newest"] < CUTOFF_FULL_PANEL:
133:                continue          # predates the directive
134:            #  #534 F2 pass (codex): a hold only counts while it is LIVE -- a discharged marker left a
135:            #  short, flagship-less stage passing section I as "held and queued"
136:            if d["held"] and st.live_holds(d["all"]):
137:                holds += 1
138:                if rid not in queue:
139:                    unqueued_holds.append((rid, ph))
140:                elif listing:
141:                    print("  ok    %-14s %-9s HELD and queued" % (rid, ph))
142:            else:
143:                short.append((rid, state, ph, len(d["seats"])))
144:
145:        #  Rule 3: a closed row that changed code owes a regression review.
146:        #  `or ""` NOT `.get(..., "")`: a row closed on a MEASURED ZERO carries `commits: null`
147:        #  (it changed no code, so it names no commit), and the default only covers an ABSENT key.
148:        #  `multilabelfloor` was the first, and it crashed this checker with an AttributeError --
149:        #  taking the whole precommit gate down rather than failing one row.  2026-09-10.
150:        if state == "closed" and (row.get("commits") or "").strip():
151:            newest = max([e.get("date", "") for e in row.get("entries", [])] or [""])
152:            if "regress" not in phases_seen and newest >= CUTOFF_REGRESS_FABLE:
