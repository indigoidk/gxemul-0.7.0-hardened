1510:#  ---- #566 ip30abortkill (#531, 686d179c): dev_sgi_ip30.c's four guest-reachable abort() calls -- a guest load or
1511:#  ---- store at 0x0ff10020 or 0x0ff10028, a store to 0x0ff10030, and DEVICE_TICK once a legal imask0 write sets bit
1512:#  ---- 50 -- are gone since #531: the two loads decline silently, the 0x10020/0x10028 stores keep their effect, the
1513:#  ---- 0x10030 store is dropped, and the three stores announce once between them (one shared ISR latch) and the tick
1514:#  ---- once (its own).  Its detector shipped with that fix and ran in no gate:
1515:#  ---- check_probe_wiring.py held it EXEMPT, dated 2026-09-20 and re-dated three times (eec0f4a3 to 09-27, #550's
1516:#  ---- 04500deb to 10-15, 7b23b785 on 2026-10-16 to 10-30), and HEAD's checker run with --today 2026-10-31 FAILS on it
1517:#  ---- (measured 2026-10-18).  This block discharges that exemption.  The probe's CONTRACT, its MEASURED ESCAPES and
1518:#  ---- its DOES NOT CATCH list are in its header; its kill tables are in regress/artifacts/ip30abortkill/.  At depth 0,
1519:#  ---- so another probe's missing sentinel cannot swallow it.
1520:#  ----
1521:#  ---- RUN TIME, about 9.5 minutes -- 568 s on build/gxemul (#550), 567 s on a HEAD rebuild (#566) -- because every
1522:#  ---- session that survives waits out the probe's 12 s death poll.  That poll is what stops a slow abort reading as
1523:#  ---- `alive', so it is not shortened here.  Every wait is wall-clock up to that poll's SIGKILL; the reap after it
1524:#  ---- blocks, and nothing here times the probe out.  A load stall is NOT always a red.  A session the poll kills
1525:#  ---- reports `alive' with only the transcript read before the poll began (nothing printed during it is collected),
1526:#  ---- so it reads like a run whose remaining accesses never happened.  Rows that want `alive' or `no' then read green:
1527:#  ---- `acc 30 rd', `tick 49' and both rows of the `kill 20 rd' and `kill 28 rd' sessions read a stall green outright --
1528:#  ---- the read sessions on a build that would have aborted -- while the write-arm and bit-50 tick sessions also score
1529:#  ---- an announce row that wants `yes', which reds.  The count rows that want ONE announce (`latch 1x', `latch 28wr',
1530:#  ---- `latch 30wr', `latch tick', `xbit rev', `xbit rev2') read a stall before their second access as green; on
1531:#  ---- V2_assigntick only `xbit rev2' reds, so a stall in that session leaves all 41 checks green on that mutant.
1532:#  ---- Filed as ip30stallgreen.  gate_arm.sh runs in the weekly battery, alone, and as an attended targeted gate --
1533:#  ---- never per commit.
1534:#  ----
1535:#  ---- Run from its artifacts path, as gate_sh_rounding.sh runs gdrom_pio_null_probe.py; a missing file fails the parse
1536:#  ---- check below -- a FAIL, never a SKIP.
1537:IP30LOG=$LOGDIR/ip30_abort.log
1538:ip30rc=0
1539:python3 -u artifacts/ip30abortkill/ip30_abort_probe.py "$PMAX" gate > "$IP30LOG" 2>&1 || ip30rc=$?
1540:
1541:#  PARSE BEFORE SCORE: exactly one well-formed RESULT, CONTROL and DONE line.  A crash or kill before the report, or a
1542:#  missing file, leaves none and reds here; a death AFTER the report passes here and reds `probe exit status' below.
1543:if [ "$(grep -c '^IP30ABORT_RESULT=' "$IP30LOG")" != "1" ] ||
1544:   ! grep -Eq '^IP30ABORT_RESULT=(0|[1-9][0-9]*)/(0|[1-9][0-9]*)$' "$IP30LOG" ||
1545:   [ "$(grep -c '^IP30ABORT_CONTROL=' "$IP30LOG")" != "1" ] ||
1546:   ! grep -Eq '^IP30ABORT_CONTROL=(OK|DEAD)$' "$IP30LOG" ||
1547:   [ "$(grep -cx 'IP30ABORT_DONE' "$IP30LOG")" != "1" ]; then
1548:    note "ip30_abort probe produced no unique, valid completion record; last lines follow"
1549:    tail -5 "$IP30LOG" | sed 's/^/       /'
1550:    check "ip30_abort probe output parses" "no" "yes"
1551:else
1552:    check "ip30_abort probe output parses" "yes" "yes"
1553:    grep -E '^  .* got=.* want=.* FAIL  ' "$IP30LOG" | sed 's/^/       /'
1554:    #  CONTROLS: `live' (a RAM plant returns through a guest load) and `devsig' (0x20 answers 0x80010000, which RAM
1555:    #  cannot).  A DEAD vehicle prints a zero-row RESULT and rows with no status token, so every row check below reds too.
1556:    check "ip30_abort controls" "$(sed -n 's/^IP30ABORT_CONTROL=//p' "$IP30LOG")" "OK"
1557:    check "ip30_abort probe exit status" "$ip30rc" "0"
1558:
1559:    #  EVERY ROW BY NAME, EXACTLY ONCE -- identity and uniqueness, which the counts below cannot give.  The probe prints
1560:    #  `  %-12s got=%-12s want=%-12s <ok|FAIL>  <note>': the status token is NOT at the end of the line, so ` ok$'
1561:    #  matches nothing here, and six names (`kill 20 rd txt', `isr 20 rd val', ...) are longer than their 12-column
1562:    #  field.  So a row is matched by position -- its name, the got= and want= tokens (no value carries a space), then
1563:    #  the status and its two trailing spaces -- and `^  <name>  *got=' cannot match a longer name beginning with this
1564:    #  one (`kill 20 rd' / `kill 20 rd txt', `xbit rev' / `xbit rev2').  count() is plain grep: every `*' is BRE.
1565:    for v in "live" "devsig" "acc 18" "acc 30 rd" "acc 20000" "acc 30000" "acc imask" "kill 20 rd" "kill 20 rd txt" "kill 28 rd" "kill 28 rd txt" "kill 30 wr" "kill 30 txt" "tick 50" "tick 50 txt" "tick 49" "kill 20 wr" "kill 20 wr txt" "kill 28 wr" "kill 28 wr txt" "isr keep" "isr clr" "isr drop 30" "xbit isr" "xbit tick" "latch 1x" "isr 20 rd val" "isr 28 rd val" "latch 28wr" "latch 30wr" "latch tick" "xbit rev" "xbit rev2"; do
1566:        check "ip30_abort row: $v" "$(count "$IP30LOG" "^  $v  *got=[^ ]*  *want=[^ ]*  *ok  ")" "1"
1567:    done
1568:
1569:    #  DENOMINATORS, pinned to LITERALS: `rows run' is the probe's own count (RESULT's), `rows emitted' the row lines it
1570:    #  printed -- two, because one cannot tell a LOST row from a failing one.  `[^=]*' stops at the first `=', which in a
1571:    #  row line is got='s.  All 33 green on build/gxemul, measured before these pins were written
1572:    #  (regress/artifacts/ip30abortkill/gatewire_20261018/).
1573:    ip30res=$(sed -n 's/^IP30ABORT_RESULT=//p' "$IP30LOG")
1574:    ip30ok=$(count "$IP30LOG" '^  [^=]* got=[^ ]*  *want=[^ ]*  *ok  ')
1575:    ip30bad=$(count "$IP30LOG" '^  [^=]* got=[^ ]*  *want=[^ ]*  *FAIL  ')
1576:    check "ip30_abort rows run"     "${ip30res#*/}" 33
1577:    check "ip30_abort rows correct" "${ip30res%/*}" "33"
1578:    check "ip30_abort rows emitted" "$((ip30ok + ip30bad))" "33"
1579:    check "ip30_abort rows green"   "$ip30ok" "33"
1580:    check "ip30_abort rows red"     "$ip30bad" "0"
1581:fi
