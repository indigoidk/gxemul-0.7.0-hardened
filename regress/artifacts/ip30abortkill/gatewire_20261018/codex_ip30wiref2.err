1:#!/bin/bash
2:#  launch_f2.sh <seat> -- fire ONE seat (astra | grok | glm) on the ip30 gate-wiring shared-findings pass (#566), F2.
3:set -u
4:H=$(cd "$(dirname "$0")" && pwd)
5:R=$(cd "$H/../../../.." && pwd)
6:case "${1:-}" in
7:astra)
8:    bash "$R/tools/cxlaunch.sh" "$H/astra_pointer_f2.md" "$H" ip30wiref2 > "$H/astra_launch_f2.log" 2>&1
9:    echo "launcher rc=$?" >> "$H/astra_launch_f2.log"; cat "$H/astra_launch_f2.log" ;;
10:grok)
11:    G=$(sed -n 's/^GROK_MODEL="\([^"]*\)".*/\1/p' "$R/tools/panel.sh")
12:    ~/.grok/bin/grok --prompt-file "$H/packet_f2_GROK.md" -m "$G" --effort xhigh --permission-mode plan \
13:        --cwd "$R" < /dev/null > "$H/grok_f2.txt" 2> "$H/grok_f2.err"
14:    echo "rc=$?" > "$H/grok_f2.exit"; echo "grok ($G) $(cat "$H/grok_f2.exit") stdout $(wc -c < "$H/grok_f2.txt") b" ;;
15:glm)
16:    M=$(sed -n 's/^OLLAMA1="\([^"]*\)".*/\1/p' "$R/tools/panel.sh")
17:    python "$R/tools/panel_ollama.py" "$M" "$H/glm_f2.txt" "$H/packet_f2_GLM.md"
18:    echo "rc=$?" > "$H/glm_f2.exit"; echo "glm ($M) $(cat "$H/glm_f2.exit") out $(wc -c < "$H/glm_f2.txt") b" ;;
19:*) echo "usage: launch_f2.sh astra|grok|glm"; exit 2 ;;
20:esac

