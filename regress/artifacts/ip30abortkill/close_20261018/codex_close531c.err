"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import sys, json, subprocess, pathlib, io
from unittest.mock import patch
sys.path.insert(0, str(pathlib.Path('tools/pipeline').resolve()))
import stage_tokens as st
import check_stage_panels as csp
ledger = json.loads(subprocess.check_output(['git','show','HEAD:tools/pipeline/ledger.json']))
p = pathlib.Path('regress/artifacts/ip30abortkill/close_20261018/draft_r3/LEDGER_preview.txt')
lines = p.read_text(encoding='utf-8').splitlines()
entries = [json.loads(s.strip()) for s in lines if s.strip().startswith('{')]
row = next(r for r in ledger['rows'] if r['id'] == 'ip30abortkill')
print('HEAD', {k:row.get(k) for k in ('id','state','phase','hold_question','closure')})
row['state']='held'
row.pop('closure', None)
row['hold_question']=lines[11].strip()
row['entries'].extend(entries)
for i,e in enumerate(entries):
    print('ENTRY', i, e['seat'], e['ev'].split('/')[-1], 'is_answer=', st.is_answer(e), 'is_held=', st.is_held(e))
print('LIVE_REVIEW_HOLDS', st.live_holds([e for e in row['entries'] if e.get('phase')=='review']))
unit = dict(ledger, rows=[row])
realopen = open
def memopen(path, *a, **kw):
    if str(path)==str(csp.LEDGER): return io.StringIO(json.dumps(unit))
    return realopen(path,*a,**kw)
with patch('builtins.open', memopen):
    print('CHECK_STAGE_PANELS_RC', csp.main(['--list']))
print('NEW_DRAFT_ENTRIES', len(entries))
