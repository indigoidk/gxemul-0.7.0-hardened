1208: 		case "$hcw" in
1209: 		"0 wrong") good "wsl-dollar hook controls: $hcn" ;;
1210: 		*)         bad  "wsl-dollar hook controls: $hcn, $hcw -- the guard regressed" ;;
1211: 		esac
