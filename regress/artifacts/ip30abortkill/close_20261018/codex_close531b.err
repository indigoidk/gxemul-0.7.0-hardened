   1: #!/bin/bash
   2: #  legb531.sh -- #531's clause (b) leg, measured at ip30abortkill's closure (2026-10-18): the removed fatal()+abort()
   3: #  pair re-inserted VERBATIM at each fixed site of HEAD's dev_sgi_ip30.c (mutant_b_dev_sgi_ip30.c.txt), built in the
   4: #  scratch clone /tmp/gx566 (at HEAD, both clearance parts verified before this run), the shipped 33-row probe run
   5: #  against it, the log scored by gate 14's own block text, then the clone restored to HEAD, rebuilt, and both parts
   6: #  re-verified before its sentinel is cleared.  build/ is not touched.
   7: set -u
   8: SEC=/mnt/c/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC
   9: O=$SEC/regress/artifacts/ip30abortkill/close_20261018
  10: H=/mnt/c/Users/User00/AppData/Local/Temp/claude/C--DocumentNoSnc-cc-GXEMUL/8e474f41-4d47-4c99-bf11-3406a84c4fcd/scratchpad/c531
  11: C=/tmp/gx566
  12: F=src/devices/dev_sgi_ip30.c
  13: echo "LEGB start $(date '+%F %T')"
  14: [ -e "$C/.MUTANT" ] && { echo "clone already carries a sentinel -- stop"; exit 9; }
  15: cmp -s "$H/head_dev_sgi_ip30.c" "$C/$F" || { echo "clone's $F is not HEAD -- stop"; exit 9; }
  16: echo "SCRATCH CLONE (#531 closure): $F carries the clause (b) mutant" > "$C/.MUTANT"
  17: cp "$O/mutant_b_dev_sgi_ip30.c.txt" "$C/$F"
  18: build() {
  19:     (cd "$C" && rm -f src/cpus/*.o src/devices/dev_sgi_ip30.o && make -j4 > "$O/build_$1.log" 2>&1)
  20:     echo "make rc=$? ($1)"
  21:     [ "$C/gxemul" -nt "$C/$F" ] || { echo "BINARY NOT NEWER THAN $F ($1) -- stop, sentinel kept"; exit 9; }
  22:     echo "binary fresh ($1): md5 $(md5sum < "$C/gxemul" | cut -c1-32)"
  23: }
  24: build mutant_b
  25: echo "probe md5 $(md5sum < "$SEC/regress/artifacts/ip30abortkill/ip30_abort_probe.py" | cut -c1-32)"
  26: t0=$(date +%s)
  27: (cd "$SEC/regress" && timeout 1500 python3 -u artifacts/ip30abortkill/ip30_abort_probe.py "$C/gxemul" clause_b > "$O/probe_b.log" 2>&1)
  28: prc=$?
  29: echo "probe b: rc=$prc $(( $(date +%s) - t0 ))s  $(grep -a '^IP30ABORT_RESULT=' "$O/probe_b.log") last=[$(tail -1 "$O/probe_b.log")]"
  30: T=$(mktemp -d)
  31: awk '/python3 -u artifacts\/ip30abortkill\/ip30_abort_probe.py/{on=1; next} on{print} on && /^fi$/{exit}' "$SEC/regress/gate_arm.sh" > "$T/score.sh"
  32: grep -q '^fi$' "$T/score.sh" || { echo "EXTRACT FAILED"; exit 9; }
  33: echo "gate_arm.sh md5 $(md5sum < "$SEC/regress/gate_arm.sh" | cut -c1-32), scoring text md5 $(md5sum < "$T/score.sh" | cut -c1-32)"
  34: count() { [ -f "$1" ] || { echo 0; return; }; local c; c=$(grep -ac -- "$2" "$1" 2>/dev/null); echo "${c:-0}"; }
  35: check() { _checks=$((_checks+1)); [ "$2" = "$3" ] || { _fails=$((_fails+1)); _red="$_red [$1 got=$2]"; }; }
  36: note() { :; }
  37: IP30LOG=$O/probe_b.log; ip30rc=$prc; _checks=0; _fails=0; _red=""
  38: . "$T/score.sh" > /dev/null 2>&1
  39: echo "LEG b  gate checks=$_checks fails=$_fails $([ "$_fails" -gt 0 ] && echo 'RED (clause b holds)' || echo 'GREEN (CLAUSE B BREACH)')"
  40: echo "     red:$_red"
  41: rm -rf "$T"
  42: echo "--- restore"
  43: cp "$H/head_dev_sgi_ip30.c" "$C/$F"
  44: build restore
  45: cmp -s "$H/head_dev_sgi_ip30.c" "$C/$F" && echo "part 1: $F == HEAD" || { echo "part 1 FAILED -- sentinel kept"; exit 9; }
  46: [ "$C/gxemul" -nt "$C/$F" ] && echo "part 2: binary newer than $F" || { echo "part 2 FAILED -- sentinel kept"; exit 9; }
  47: rm -f "$C/.MUTANT"; echo "sentinel cleared"
  48: echo "LEGB end $(date '+%F %T')"
  49: echo LEGB_DONE

