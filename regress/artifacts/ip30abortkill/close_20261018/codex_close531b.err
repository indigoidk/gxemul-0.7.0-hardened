 130: 
 131: #  *** A STAGE DELIBERATELY HELD FOR A NAMED SEAT IS NOT A STAGE THAT MOVED ON. ***
 132: #
 133: #  Added 2026-08-17.  Fable usage ran high and the owner said to queue Fable work and carry on
 134: #  with the rest.  That is the honest thing to do -- eight seats can answer now and the ninth
 135: #  when quota returns -- but the first version of this check reported the resulting 8/9 as
 136: #  "moved on without the full panel", which is exactly wrong: nothing moved on, the round is
 137: #  explicitly open and waiting.  Two different states rendering the same is the defect this
 138: #  whole layer exists to prevent, so it must not be committed BY this layer.
 139: #
 140: #  A HELD marker is an explicit ledger entry carrying this token and NAMING the awaited seats.
 141: #  It is reported separately, not as a violation.
 142: #
 143: #  THE ANTI-LOOPHOLE, and it is the whole reason this is safe to add: a held stage on a CLOSED
 144: #  row is a HARD violation.  You may wait for a seat; you may not close a round while waiting
 145: #  for one.  Without that clause "HELD" would be a way to mark any gap and walk away, which is
 146: #  worse than the conflation it replaces.
 147: HELD = st.HELD      # #534: spelled once, in stage_tokens.py
 148: 
 149: 
 150: def main(argv):
 151:     listing = "--list" in argv
 152:     with open(LEDGER, encoding="utf-8") as f:
 153:         ledger = json.load(f)
 154:     seats = [s["id"] for s in ledger["seats"]]
 155:     n_seats = len(seats)
 156: 
 157:     #  A stage with exactly ONE seat is a FILING, not a panel that ran short.  Items enter
 158:     #  the queue when a seat raises them during some other round's panel, which leaves a
 159:     #  one-seat `assess` entry; the item has not started yet.  Counted and REPORTED
 160:     #  separately rather than waved through, because "filed, awaiting its panel" and "we ran
 161:     #  a panel and it came up short" are different states and the whole point of this layer
 162:     #  is that different states must not render the same.
 163:     violations, grandfathered, complete, filed, held = [], 0, 0, [], []
 164: 
 165:     for row in ledger["rows"]:
 166:         by_stage = {}
 167:         for ent in row.get("entries", []):
 168:             by_stage.setdefault(ent.get("phase"), {}).setdefault("_all", []).append(ent)
 169:             if st.exempts_stage(ent):
 170:                 by_stage[ent.get("phase")]["_annotated"] = True
 171:             if st.is_held(ent):
 172:                 d = by_stage.setdefault(ent.get("phase"), {})
 173:                 #  A LIST, NOT A SLOT.  This assigned a single value until 2026-08-17, so a
 174:                 #  stage held for TWO seats kept only the LAST marker and reported one.
 175:                 #  Found the day it first mattered: exitsweep's assess stage is held for BOTH
 176:                 #  codex (a measured quota wall) and fable5 (deliberate conservation), and the
 177:                 #  gate printed "awaiting: fable5" -- silently dropping codex.
 178:                 #
 179:                 #  It UNDER-REPORTS THE DEBT, which is the one direction this gate must never
 180:                 #  fail in: a stage that looks like it waits for one seat gets completed a
 181:                 #  seat early, and the missing seat's blank then reads as agreement.
 182:                 d.setdefault("_held", []).append(ent.get("note", ""))
 183:                 continue
 184:             if not st.is_answer(ent):
 185:                 continue           # ANNOTATION / NOPANEL / NOTSEAT entries are not seat answers
 186:             d = by_stage.setdefault(ent.get("phase"), {})
 187:             d.setdefault("seats", set()).add(ent.get("seat"))
 188:             d["newest"] = max(d.get("newest", ""), ent.get("date", ""))
 189: 
 190:         for stage in STAGES:
 191:             info = by_stage.get(stage)
 192:             if not info:
 193:                 continue                       # stage never ran; not this check's business
 194:             if "seats" not in info:
 195:                 #  #534 F2 pass (codex, Opus): a stage whose only entry is a LIVE hold was skipped
 196:                 #  here, before any hold test, so a CLOSED row could carry one with H green.
 197:                 live0 = st.live_holds(info.get("_all", []))
 198:                 if live0 and row.get("state") == "closed":
 199:                     violations.append((row["id"], "CLOSED-WHILE-HELD", stage, 0,
 200:                                        ["a round may not close while a stage awaits a seat"]))
 201:                 elif live0:
 202:                     held.append((row["id"], stage, 0, ", ".join(live0), "",
 203:                                  (row.get("hold_question") or "").strip()))
 204:                 continue
 205:             got, newest = info["seats"], info.get("newest", "")
 206:             #  #534 (heldmasked, an L3 of this round per its pass 2): a LIVE hold -- a named seat not
 207:             #  answered in this stage at a strictly later date -- beats a full count.  Before this,
 208:             #  the count test ran first, so an owner-decision hold over nine misdirected answers
 209:             #  reported `ok 9/9` and the row could be CLOSED with H, I and the wall all green
 210:             #  (Opus, measured).  A DISCHARGED marker does not hold a full stage.
 211:             live = st.live_holds(info.get("_all", []))
 212:             if len(got) >= n_seats and not live:
 213:                 complete += 1
 214:                 if listing:
 215:                     print("  ok    %-14s %-9s %d/%d" % (row["id"], stage, len(got), n_seats))
 216:                 continue
 217:             #  HELD is checked BEFORE the one-seat "filed" shortcut, so a stage that is
 218:             #  genuinely waiting on a named seat is reported as waiting even if only one
 219:             #  other seat has answered so far.
 220:             #  ... and ONLY a live hold holds a SHORT stage either.  A marker every named seat has
 221:             #  since answered is history: treating it as a hold printed "awaiting: fable5" over
 222:             #  pcc2c040kill's 8/9 review whose real gap is agy (codex + Opus, #534 F2 pass).
 223:             if live:
 224:                 if row.get("state") == "closed":
 225:                     violations.append((row["id"], "CLOSED-WHILE-HELD", stage, len(got),
 226:                                        ["a round may not close while a stage awaits a seat"]))
 227:                 else:
 228:                     #  Every marker, de-duplicated, order preserved -- so two holds report
 229:                     #  two seats and the operator sees the whole debt.
 230:                     names = list(live)
 231:                     held.append((row["id"], stage, len(got), ", ".join(names),
 232:                                      newest, (row.get("hold_question") or "").strip()))
 233:                 continue
 234:             if len(got) == 1:
 235:                 filed.append((row["id"], stage))
tools/pipeline/stage_tokens.py
   1: """THE ONE PLACE A LEDGER STAGE TOKEN IS SPELLED OR CLASSIFIED.  #534, 2026-09-18.
   2: 
   3: WHY THIS FILE EXISTS.  Four tools read ledger entries and each carried its own copy of the tokens:
   4: check_stage_panels.py knew four, check_fable_queue.py was never taught RE_READ, gen_dashboard.py
   5: filtered HELD markers it had no business filtering, and check_fix_seats.py knew only HELD -- so it
   6: credited a stage-exemption entry written under `seat: fable5' as a FLAGSHIP ANSWER, and the row that
   7: introduced the newest token passed its own flagship mandate on that token (#532 pass 2, Opus seat,
   8: MEASURED).  One cause every time: a token added where it was needed and never mirrored.  So the
   9: literals AND the classification live here, and precommit_check.sh refuses a token literal anywhere
  10: else in tools/pipeline/.  *** THREE of those four readers ship with #534 and are covered by its controls;
  11: check_fix_seats.py is another round's untracked, unwired draft -- it imports is_answer from here but NO
  12: control covers it until it ships (fable5, #534 last seat: this sentence overclaimed until then). ***
  13: 
  14: AN ENTRY HAS TWO INDEPENDENT PROPERTIES, and the #532 code conflated them:
  15: 
  16:   is_answer(e)     -- does this entry count as the seat answering?
  17:   exempts_stage(e) -- does this entry exempt its WHOLE (row, phase) stage from the panel rule?
  18: 
  19:                     is_answer   exempts_stage
  20:     HELD             no           no          (a promise; handled by its own rules)
  21:     ANNOTATION       no           yes         (pre-2026-08-16 policy)
  22:     RE_READ          YES          yes         (a real single-seat re-read -- fable measured one
  23:                                                rendering as agreement pre-#532, rightly)
  24:     NOPANEL          no           yes         (no panel was convened on this stage)
  25:     NOTSEAT          no           NO          (THIS ENTRY is a main-loop record, not a seat
  26:                                                answer; it can never silence other entries)
  27:     anything else    yes          no
  28: 
  29: NOTSEAT IS THE ENTRY-SCOPED MARKER, and it is the one to reach for by default.  #532 used the
  30: stage-scoped NOPANEL for six records that meant only "this entry is not a seat answer"; on those
  31: rows any panel LATER recorded under the same phase would have been silently exempted in advance
  32: (fable5, #532 pass 2, R2).  A stage exemption is a claim about everything in the stage and must be
  33: earned; see stage_token_problems() for the guard.
  34: """
  35: import re
  36: 
  37: HELD = "[HELD AWAITING SEAT:"
  38: ANNOTATION = "[RUN UNDER THE PRE-2026-08-16 POLICY]"
  39: RE_READ = "[NOT A PANEL STAGE: SINGLE-SEAT RE-READ]"
  40: NOPANEL = "[NOT A PANEL STAGE: NO PANEL CONVENED]"
  41: NOTSEAT = "[NOT A SEAT ANSWER]"
  42: 
  43: STAGE_EXEMPT = (ANNOTATION, RE_READ, NOPANEL)
  44: ALL = (HELD, ANNOTATION, RE_READ, NOPANEL, NOTSEAT)
  45: 
  46: PANEL_DIR = re.compile(r"panel_\d{8}_\d{6}")
  47: 
  48: 
  49: def _note(e):
  50:     return e.get("note") or ""
  51: 
  52: 
  53: def is_held(e):
  54:     return HELD in _note(e)
  55: 
  56: 
  57: def exempts_stage(e):
  58:     n = _note(e)
  59:     #  HELD and NOTSEAT both dominate: a hold is a promise and NOTSEAT says "this entry only" -- an
  60:     #  entry carrying either can never exempt the stage, whatever else it quotes (minimax, #534 pass 2:
  61:     #  the docstring promised this of NOTSEAT and the code did not deliver it).
  62:     return (not is_held(e)) and NOTSEAT not in n and any(t in n for t in STAGE_EXEMPT)
  63: 
  64: 
  65: def is_answer(e):
  66:     n = _note(e)
  67:     if HELD in n or NOTSEAT in n or ANNOTATION in n or NOPANEL in n:
  68:         return False
  69:     return True          # RE_READ entries ARE answers; so is every untokened entry
  70: 
  71: 
  72: HELD_SEATS = re.compile(re.escape(HELD) + r"[ \t]*([a-z0-9_]+(?:[ \t]*,[ \t]*[a-z0-9_]+)*)[ \t]*\]")
  73: #  case-SENSITIVE, like is_held() -- they disagreed until the #534 F2 pass (codex); the ledger holds
  74: #  zero non-canonical spellings, so this changes no real reading
  75: 
  76: 
  77: MALFORMED = "?malformed-hold"
  78: POLICY_CUTOFF = "2026-08-16"   # full panel on every stage; work before it is not judged by it
  79: 
  80: 
  81: def held_seats(e):
  82:     """The seats a HELD entry names, in order, or [] if it names none in the strict shape."""
  83:     m = HELD_SEATS.search(_note(e))
  84:     return [x.strip().lower() for x in m.group(1).split(",")] if m else []
  85: 
  86: 
  87: def live_holds(entries):
  88:     """Seats still awaited in one (row, phase): named by a HELD entry and NOT answered by that seat
  89:     in this stage at a STRICTLY LATER date -- the carrier's discharge rule, applied here so every
  90:     reader agrees on it.  (#534 pass 2, codex + Opus: two of the three stages that showed a full count
  91:     over a hold were DISCHARGED holds, and one was live; a reader must tell them apart.)"""
  92:     out = []
  93:     for h in entries:
  94:         if not is_held(h):
  95:             continue
  96:         hd = h.get("date") or ""
  97:         named = held_seats(h)
  98:         if not named:
  99:             #  a hold in no parseable shape can never be discharged by an answer -- it holds until
 100:             #  someone writes it properly; a malformed marker must not read as "nothing owed"
 101:             #  (codex, #534 F2 pass: `[HELD AWAITING SEAT: glm,]` let a closed row pass H and I)
 102:             if MALFORMED not in out:
 103:                 out.append(MALFORMED)
 104:             continue
 105:         for seat in named:
 106:             done = any((e.get("seat") or "").lower() == seat and is_answer(e)
 107:                        and (e.get("date") or "") > hd for e in entries)
 108:             if not done and seat not in out:
 109:                 out.append(seat)
 110:     return out
 111: 
 112: 
 113: def stage_token_problems(entries):
 114:     """Why a stage's exemption must be REFUSED, or [] if it stands.  `entries' = one (row, phase).
 115: 
 116:     (i)  STRICTLY LATER -- EVERY exemption token: a tallied answer dated after the newest exemption
 117:          entry.  An exemption is a claim about the stage AS IT STOOD; material recorded afterwards is
 118:          new, and nothing about a token's vintage makes it cover the future (#534 pass 2: codex, Opus,
 119:          deepseek, minimax, kimi all refused the NOPANEL-only scope; Opus measured that clause (i) was
 120:          never the part that refused the legacy stages).
 121:     (ii) UNCITED PANEL -- NOPANEL ONLY: a tallied answer cites a panel dir that no exemption entry
 122:          names.  This clause IS the retroactive one: annotations and re-reads were written before an
 123:          exemption had to name its panels, and applying it to them refused seven legacy stages for a
 124:          requirement nobody owed at the time.  (A stage whose answers cite no panel dir passes it --
 125:          Opus fixture G, a DISCLOSED escape.)
 126: 
 127:     Brief-TITLE matching is deliberately absent: a correlate that missed BOTH real disputed cases
 128:     (fable5, #532 pass 2, R4)."""
 129:     tok = [e for e in entries if exempts_stage(e)]
 130:     if not tok:
 131:         return []
 132:     newest_tok = max((e.get("date") or "") for e in tok)
 133:     nop = [e for e in tok if NOPANEL in _note(e)]
 134:     cited = set()
 135:     for e in nop:
 136:         cited |= set(PANEL_DIR.findall(_note(e) + " " + (e.get("ev") or "")))
 137:     out = []
 138:     for e in entries:
 139:         if not is_answer(e) or e in tok:
 140:             continue
 141:         d = e.get("date") or ""
 142:         #  a later answer that itself PREDATES the full-panel directive is not judged by it: the
 143:         #  pre-policy stage it joined was grandfathered, and stays so (kimi, #534 F2 pass)
 144:         if d > newest_tok and d >= POLICY_CUTOFF:
 145:             out.append("answer by %s dated %s is LATER than the exemption (%s)"
 146:                        % (e.get("seat"), d, newest_tok))
 147:         if nop:
 148:             for p in PANEL_DIR.findall(e.get("ev") or ""):
 149:                 if p not in cited:
 150:                     out.append("answer by %s cites %s, which the exemption does not name"
 151:                                % (e.get("seat"), p))
 152:     return out
 153: 
 154: 
 155: _CORES = {HELD: ("HELD AWAITING SEAT",), ANNOTATION: ("PRE-2026-08-16 POLICY", "RUN UNDER THE PRE"),
 156:           RE_READ: ("SINGLE-SEAT RE-READ",), NOPANEL: ("NO PANEL CONVENED",),
 157:           NOTSEAT: ("NOT A SEAT ANSWER",)}
 158: 
 159: 
 160: def literal_offenders(paths):
 161:     """(path, line, token) for every CODE string constant outside this module that spells a token.
 162: 
 163:     The control fable5 required with R5: the literals live here or nowhere.  Docstrings and comments
 164:     are exempt -- they DESCRIBE tokens, and a prose mention never classified an entry.  An AST walk,
 165:     not a grep, because a grep cannot tell a docstring from a constant and would either flag every
 166:     history paragraph or be loosened until it flagged nothing."""
 167:     import ast
 168:     out = []
 169:     for p in paths:
 170:         src = open(p, encoding="utf-8").read()
 171:         tree = ast.parse(src, p)
 172:         docs = set()
 173:         for n in ast.walk(tree):
 174:             if isinstance(n, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
 175:                 b = getattr(n, "body", None)
 176:                 if b and isinstance(b[0], ast.Expr) and isinstance(b[0].value, ast.Constant):
 177:                     docs.add(id(b[0].value))
 178:         def fold(n):
 179:             """a string built by explicit `+' of constants, folded -- or None"""
 180:             if isinstance(n, ast.Constant) and isinstance(n.value, str):
 181:                 return n.value
 182:             if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
 183:                 a, b = fold(n.left), fold(n.right)
 184:                 return a + b if a is not None and b is not None else None
 185:             return None
 186:         for n in ast.walk(tree):
 187:             if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add):
 188:                 v = fold(n)
 189:                 hit = [t for t in ALL if v is not None and any(c in v for c in _CORES[t])]
 190:                 if hit:
 191:                     #  #534 F2 pass (kimi, minimax, deepseek): "NOT A SEAT " + "ANSWER]" escaped the
 192:                     #  per-constant match; fold the concatenation and test the whole
 193:                     out.append((p, n.lineno, hit[0]))
 194:                 continue
 195:             if isinstance(n, ast.Constant) and isinstance(n.value, str) and id(n) not in docs:
 196:                 for t in ALL:
 197:                     #  Matched on the token's CORE PHRASE, brackets and punctuation stripped: a
 198:                     #  fragment like "PRE-2026-08-16 POLICY" or "HELD AWAITING SEAT" classifies just
 199:                     #  as well as the whole literal, and a whole-literal match missed it (Opus, #534
 200:                     #  pass 2: `or "PRE-2026-08-16 POLICY" in note' passed this check).
 201:                     if any(c in n.value for c in _CORES[t]):
 202:                         out.append((p, n.lineno, t))
 203:                         break
 204:     return out
 205: 
 206: 
 207: if __name__ == "__main__":
 208:     import glob
 209:     import os
 210:     import sys
 211:     if sys.argv[1:2] == ["--census"]:
 212:         #  fable5 F2 (#534): #532 stated this population three ways ("nine", "eleven of twelve",
 213:         #  and the true 17 stages / 23 entries) because each was counted by hand.  This is the one
