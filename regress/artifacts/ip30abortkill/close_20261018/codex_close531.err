71: 	/*  ip30:  */
72: 	uint64_t                imask0;         /*  0x10000  */
73: 	int                     warned;         /*  #531: IP30_W_* latches  */
74: 	uint64_t                reg_0x10018;
75: 	uint64_t                isr;            /*  0x10030  */
76: 	uint64_t                reg_0x20000;
77: 	uint64_t                reg_0x30000;
78: 
79: 	/*  ip30_2:  */
80: 	uint64_t                reg_0x0029c;
81: 
82: 	/*  ip30_3:  */
83: 	uint64_t                reg_0x00284;
84: 
85: 	/*  ip30_4:  */
