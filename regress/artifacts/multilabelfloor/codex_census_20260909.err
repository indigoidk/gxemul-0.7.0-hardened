67: /*  pcc2widthkills: TWELVE width-guard blocks in DEVICE_ACCESS(pcc2) -- TEN of them
68:     `fatal(); exit(1)' kills that ended the host on a guest-chosen access width, and
69:     two (IPL, MASK) #119 warn-once latches that declined it process-globally -- an ordinary aligned halfword load of a documented
458: 
459: /*  pcc2widthkills: decline a wide WRITE to a byte register, announcing once per
460:     block per instance.  The caller `break's after this; the read side of the same
461:     block never reaches here.  */
462: static void pcc2_width_decline(struct pcc2_data *d, int bit, const char *name, int len)
463: {
464: 	if (!(d->warned & (1u << bit))) {
465: 		d->warned |= (1u << bit);
466: 		fatal("[ pcc2: unimplemented len=%i write to %s -- declined."
467: 		    "  (once) ]\n", len, name);
468: 	}
469: }
