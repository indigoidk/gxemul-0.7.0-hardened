1216:     t, alive, how = session(setup(r5=pre) + program([ST_B(5, off)]) + ["put w 0x%x, 0xaab8ccdd" % (PCC2 + off)]
1217:                             + program([LD_BU(4, off)], at=CODE + 0x100) + ["print r4"])
1218:     row("rb4 " + nm, printed(t, "r4") if alive else "died", want, "%s unchanged after a declined 4-byte write" % nm.upper())
