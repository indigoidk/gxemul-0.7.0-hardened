1229:                           ("t2icr", T2ICR, "0x13", "0x13"),      # &= ~0x17; |= (v & 0x17)
1230:                           ("scctx", SCCTX, "0x1f", "0x1f"),      # = v & 0x1f
1231:                           ("sccerr", SCCERR, "0x5a", "0x0")):    # any write clears to 0
1232:     t, alive, how = session(setup(r5=wr) + program([ST_B(5, off), LD_BU(4, off)]) + ["print r4"])
1233:     row("acc " + nm, printed(t, "r4") if alive else "died", rdv,
1234:         "st.b %s at the legal width lands through its own mask" % nm.upper())
1235:     row("acc %s nod" % nm, t.count(DECL), 0, "...with NO decline message")
1236: 
1237: # ------------------------------- OPERATOR path: the seven odd blocks via `put h'
1238: #  The m88k alignment check makes these guest-unreachable; the debugger warns on a
1239: #  misaligned put and stores anyway, straight to the handler (MEASURED pre-fix: exit1).
1240: for nm, off in (("vecbase", VECBASE), ("pscale", PSCALEADJ), ("t1ctl", T1CTL),
1241:                 ("t1icr", T1ICR), ("sccicr", SCCICR), ("sccrx", SCCRX), ("scsiicr", SCSIICR)):
1242:     t, alive, how = session(["put h 0x%x, 0x0303" % (PCC2 + off)])
1243:     row("op " + nm, how, "exit0", "debugger put h at odd %s survives" % nm.upper())
1244:     row("op %s dcl" % nm, t.count(DECL), 1, "...and was declined once")
1245: 
1246: #  --------- the odd arms' FALL-THROUGH channel (pass 3, ruled a floor breach, not a disclosure)
1247: #  The block above proves each odd arm ANNOUNCES; it cannot see a guard that announces AND
1248: #  then lets the halfword land (the M_FALL shape -- decline nulled, guard kept: clause (d)).
1249: #  PRETABLE Section 2 had disclosed that as "a sentence owed".  The measuring seat asked
1250: #  whether a disclosure can discharge a floor clause; it cannot, or every breach becomes a
1251: #  sentence.  So each of the four arms gets the channel its body offers:
1252: #    SCCICR/SCCRX/SCSIICR store `idata & mask' then reassert_interrupts(): set 0x1f by
1253: #      byte (legal under both masks), decline a wide 0xaab8, read the byte back -- a landed
1254: #      write leaves 0x18 (& 0x1f) or 0x98 (& 0xdf) in an INTERRUPT CONTROL register.
1255: #    PSCALEADJ stores nothing; its write body only prints "ignored (value ...)".  A landed
1256: #      wide write therefore prints that line -- the message is the only channel, and the
1257: #      row counts it at ZERO.
1320: row("acc ipl ro", t.count("write to read-only PCCTWO_IPL"), 1,
1321:     "a legal byte write to IPL reaches its body -- the read-only print fires once")
1322: #  The T1 labels of the two SHARED blocks (deepseek, pass 3): their readbacks above are at
1323: #  the T2 offsets, so a fall-through reaching only the T1 half of a split block would leave
1324: #  `op t1ctl dcl' at 1 with nothing reading T1CTL back.  Operator path, own readbacks:
1325: #  (`want' is the value as the debugger PRINTS it -- 0x03 comes back as `0x3'.  The first
1326: #  part-3 BASE run reddened this row on the fix for exactly that string mismatch, 95/96;
