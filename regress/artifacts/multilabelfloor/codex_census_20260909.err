90: # ---------------------------------------------------------------- the MTE registers
91: #  CRIME RE base 0xb5000000; CRIME_MTE_* offsets from crmfbreg.h.
92: MTE_MODE       = 0xb5003000
93: MTE_BG         = 0xb5003018
94: MTE_DST0       = 0xb5003030
95: MTE_DST1_START = 0xb5003838       # CRIME_MTE_DST1 0x3038 | CRIME_DE_START 0x0800
96: #  `if (startFlag) do_mte_transfer(cpu, d);' sits at the END of DEVICE_ACCESS(sgi_mte), so any MTE
97: #  write with bit 0x800 in its ADDRESS fires the transfer.  DST1 is written last, with START.
98: 
99: #  dst_tlb = (mode & MTE_MODE_DST_BUF_MASK 0x1c) >> 2  -> MTE_TLB_A = 0
100: #  depth   = 8 << ((mode & 0x300) >> 8)                -> MTE_DEPTH_32 = 2 gives 32
101: #  MTE_MODE_COPY 0x800 CLEAR = fill.  (0x800 here is a MODE bit; the 0x800 in the address is START.)
102: MODE_TILED_FILL = 0x200
103: BG_VAL          = 0x11223344      # four distinct bytes, so dest[0] names which arm ran
104: CI_TOP          = 0x44            # what the DEFECT writes at dest[0]
113: MODE_D16   = 0x100                # MTE_DEPTH_16 << MTE_DEPTH_SHIFT
114: MODE_D32   = 0x200                # MTE_DEPTH_32 << MTE_DEPTH_SHIFT
115: #  *** FIELD VALUE 3.  The header defines NO MTE_DEPTH_64, but the code computes 8 << 3 = 64 for
116: #  it, and the branch under repair is reachable there.  A row here does NOT assert what 64bpp
117: #  OUGHT to do -- it asserts what this round does NOT CHANGE, exactly like depth8/depth16. ***
118: MODE_D64   = 0x300                # field value 3: undefined by the header, computed as 64
119: MODE_COPY  = 0x800                # MTE_MODE_COPY (a MODE bit; the 0x800 in an ADDRESS is START)
120: MTE_SRC0   = 0xb5003020           # CRIME_MTE_SRC0 0x3020 -- no 0x800, so it does not fire START
121: 
122: #  *** THE FIRST SOURCE BYTE IS DELIBERATELY BELOW 0x80. ***  The RGB and RGBA GET arms compute
123: #  `buf[0] << 24' on a uint8_t, which promotes to signed int -- so a first byte >= 0x80 shifts
124: #  past INT_MAX and is undefined behaviour.  That is a SEPARATE filed defect ([[sgirebufshiftub]],
125: #  re-derived independently by the pass-1 codex seat); this probe must not stand on it, so the
219: def fill(A, depth=MODE_D32):
220:     """Program a tiled FILL at `depth' and fire it.  Every store is a REAL GUEST INSTRUCTION."""
221:     #  re_tlb_a[0] = 0x8002.  The RE TLB write walks `len' in halfwords from tlbi 0, so an `sd'
222:     #  carrying the tile in its TOP halfword lands it at index 0 -- the packing sgi_re_rgb_probe.py
223:     #  established, and getting it wrong leaves the valid bit clear and the transfer silent.
224:     c  = store(A, RE_TLB_A, TLBA_TILE << 48, op=OP_SD_T0_A3)
225:     c += store(A, DEST, PAINT)                     # pre-paint: liveness, NOT a tail oracle
226:     c += store(A, MTE_MODE, depth)
227:     c += store(A, MTE_BG,   BG_VAL)
228:     c += store(A, MTE_DST0, DST0)
229:     c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
230:     return c
231: 
232: def copy(A):
233:     """Tiled 32-bit COPY of ONE pixel: source (1,0) -> dest (0,0), both in TLB_A's tile.
234: 
235:     These rows exist because a FILL never reads `src_mode': deleting only
236:     `src_mode |= DE_MODE_TYPE_RGBA' is invisible to every fill row.  Three seats confirmed both
237:     the prediction and the byte walk.  dest[0] is 0x1a under BOTH correct shapes -- so `copy top'
238:     distinguishes neither HEAD nor the fix, and that IS its job: it reds only under a ONE-SIDED
239:     edit (source-only -> 0x4d, dest-only -> 0x00).
240: 
241:     A note the kimi seat asked for, so a future reader does not "correct" the want: the
242:     dest-only cell gives 0x00 because the CI GET *assigns* `*color = buf[0]', zero-extending it.
243:     Had the GET left `bg' untouched, an RGBA PUT would have emitted bg>>24 instead.  The row is
244:     right; the reason is the assignment, not "the high byte of a low-byte colour" in general.
245: 
246:     The destination is PRE-PAINTED so that a transfer which silently does nothing (an invalid
247:     TLB entry, say) reports 0x99 rather than looking like a plausible byte."""
248:     c  = store(A, RE_TLB_A, TLBA_TILE << 48, op=OP_SD_T0_A3)
249:     c += store(A, DEST + 4, SRC_WORD)              # the source pixel, four distinct bytes
250:     c += store(A, DEST,     PAINT)                 # the destination, so a no-op is visible
251:     c += store(A, MTE_MODE, MODE_D32 | MODE_COPY)
252:     c += store(A, MTE_SRC0, SRC_PIX_X << 16)       # src x=4 -> pixel 1 at depth 32, y=0
253:     c += store(A, MTE_DST0, DST0)
254:     c += store(A, MTE_DST1_START, DST1)            # START fires do_mte_transfer()
255:     return c
256: 
257: print("sgi_mte_fill_probe -- binary=%s label=%s machine=sgi/ip32" % (BIN, LABEL))
258: print("%-12s %-14s %-16s %-52s %s" % ("row", "got", "want", "note", ""))
