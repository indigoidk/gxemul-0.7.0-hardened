src/devices/dev_pcc2.c:575: 			pcc2_width_decline(d, PCC2_W_TXICR_LEN, "PCCTWO_TxICR", len);
src/devices/dev_pcc2.c:576: 			break;
src/devices/dev_pcc2.c:577: 		}
src/devices/dev_pcc2.c:578: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:579: 			d->pcctwo_reg[relative_addr] &= ~0x17;
src/devices/dev_pcc2.c:580: 			d->pcctwo_reg[relative_addr] |= (idata & 0x17);
src/devices/dev_pcc2.c:581: 
src/devices/dev_pcc2.c:582: 			if (relative_addr == PCCTWO_T1ICR &&
src/devices/dev_pcc2.c:583: 			    !(idata & PCC2_TTIRQ_IEN))
src/devices/dev_pcc2.c:584: 				d->pending_timer1_interrupts = 0;
src/devices/dev_pcc2.c:585: 			if (relative_addr == PCCTWO_T2ICR &&
src/devices/dev_pcc2.c:586: 			    !(idata & PCC2_TTIRQ_IEN))
src/devices/dev_pcc2.c:587: 				d->pending_timer2_interrupts = 0;
src/devices/dev_pcc2.c:588: 
src/devices/dev_pcc2.c:589: 			if (relative_addr == PCCTWO_T1ICR && (idata & PCC2_TTIRQ_ICLR)
src/devices/dev_pcc2.c:590: 			    && d->pcctwo_reg[relative_addr] & PCC2_TTIRQ_INT
src/devices/dev_pcc2.c:591: 			    && d->pending_timer1_interrupts > 0)
src/devices/dev_pcc2.c:592: 				d->pending_timer1_interrupts --;
src/devices/dev_pcc2.c:593: 
src/devices/dev_pcc2.c:594: 			if (relative_addr == PCCTWO_T2ICR && (idata & PCC2_TTIRQ_ICLR)
src/devices/dev_pcc2.c:595: 			    && d->pcctwo_reg[relative_addr] & PCC2_TTIRQ_INT
src/devices/dev_pcc2.c:596: 			    && d->pending_timer2_interrupts > 0)
src/devices/dev_pcc2.c:597: 				d->pending_timer2_interrupts --;
src/devices/dev_pcc2.c:598: 
src/devices/dev_pcc2.c:599: 			if (idata & PCC2_TTIRQ_ICLR)
src/devices/dev_pcc2.c:600: 				d->pcctwo_reg[relative_addr] &= ~PCC2_TTIRQ_INT;
src/devices/dev_pcc2.c:601: 
src/devices/dev_pcc2.c:602: 			if (idata & 0xe0)
src/devices/dev_pcc2.c:603: 				fatal("[ pcc2: HUH? write to PCCTWO_TxICR"
src/devices/dev_pcc2.c:604: 				    " with value 0x%02x. ]\n", (int) idata);
src/devices/dev_pcc2.c:605: 
src/devices/dev_pcc2.c:606: 			reassert_interrupts(d);
src/devices/dev_pcc2.c:607: 		}
src/devices/dev_pcc2.c:608: 		break;
src/devices/dev_pcc2.c:609: 
src/devices/dev_pcc2.c:610: 	case PCCTWO_SCCERR:
src/devices/dev_pcc2.c:611: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:612: 			pcc2_width_decline(d, PCC2_W_SCCERR_LEN, "PCCTWO_SCCERR", len);
src/devices/dev_pcc2.c:613: 			break;
src/devices/dev_pcc2.c:614: 		}
src/devices/dev_pcc2.c:615: 		if (writeflag == MEM_WRITE)
src/devices/dev_pcc2.c:616: 			d->pcctwo_reg[relative_addr] = 0;	/*  clear  */
src/devices/dev_pcc2.c:617: 		break;
src/devices/dev_pcc2.c:618: 
src/devices/dev_pcc2.c:619: 	case PCCTWO_SCCICR:
src/devices/dev_pcc2.c:620: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:621: 			pcc2_width_decline(d, PCC2_W_SCCICR_LEN, "PCCTWO_SCCICR", len);
src/devices/dev_pcc2.c:622: 			break;
src/devices/dev_pcc2.c:623: 		}
src/devices/dev_pcc2.c:624: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:625: 			d->pcctwo_reg[relative_addr] = idata & 0x1f;
src/devices/dev_pcc2.c:626: 			if (idata & ~0x1f)
src/devices/dev_pcc2.c:627: 				fatal("[ pcc2: HUH? write to PCCTWO_SCCICR"
src/devices/dev_pcc2.c:628: 				    " with value 0x%02x. ]\n", (int) idata);
src/devices/dev_pcc2.c:629: 			reassert_interrupts(d);
src/devices/dev_pcc2.c:630: 		}
src/devices/dev_pcc2.c:631: 		break;
src/devices/dev_pcc2.c:632: 
src/devices/dev_pcc2.c:633: 	case PCCTWO_SCCTX:
src/devices/dev_pcc2.c:634: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:635: 			pcc2_width_decline(d, PCC2_W_SCCTX_LEN, "PCCTWO_SCCTX", len);
src/devices/dev_pcc2.c:636: 			break;
src/devices/dev_pcc2.c:637: 		}
src/devices/dev_pcc2.c:638: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:639: 			d->pcctwo_reg[relative_addr] = idata & 0x1f;
src/devices/dev_pcc2.c:640: 			if (idata & ~0x1f)
src/devices/dev_pcc2.c:641: 				fatal("[ pcc2: HUH? write to PCCTWO_SCCTX"
src/devices/dev_pcc2.c:642: 				    " with value 0x%02x. ]\n", (int) idata);
src/devices/dev_pcc2.c:643: 			reassert_interrupts(d);
src/devices/dev_pcc2.c:644: 		}
src/devices/dev_pcc2.c:645: 		break;
src/devices/dev_pcc2.c:646: 
src/devices/dev_pcc2.c:647: 	case PCCTWO_SCCRX:
src/devices/dev_pcc2.c:648: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:649: 			pcc2_width_decline(d, PCC2_W_SCCRX_LEN, "PCCTWO_SCCRX", len);
src/devices/dev_pcc2.c:650: 			break;
src/devices/dev_pcc2.c:651: 		}
src/devices/dev_pcc2.c:652: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:653: 			d->pcctwo_reg[relative_addr] = idata & 0xdf;
src/devices/dev_pcc2.c:654: 			if (idata & ~0xdf)
src/devices/dev_pcc2.c:655: 				fatal("[ pcc2: HUH? write to PCCTWO_SCCRX"
src/devices/dev_pcc2.c:656: 				    " with value 0x%02x. ]\n", (int) idata);
src/devices/dev_pcc2.c:657: 			reassert_interrupts(d);
src/devices/dev_pcc2.c:658: 		}
src/devices/dev_pcc2.c:659: 		break;
src/devices/dev_pcc2.c:660: 
src/devices/dev_pcc2.c:661: 	case PCCTWO_SCCRXIACK:
src/devices/dev_pcc2.c:662: 		/*  TODO. Hm. Is this enough?  */
src/devices/dev_pcc2.c:663: 		d->pcctwo_reg[PCCTWO_SCCRX] &= ~PCC2_IRQ_INT;
src/devices/dev_pcc2.c:664: 		reassert_interrupts(d);
src/devices/dev_pcc2.c:665: 		break;
src/devices/dev_pcc2.c:666: 
src/devices/dev_pcc2.c:667: 	case PCCTWO_SCSIICR:
src/devices/dev_pcc2.c:668: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:669: 			pcc2_width_decline(d, PCC2_W_SCSIICR_LEN, "PCCTWO_SCSIICR", len);
src/devices/dev_pcc2.c:670: 			break;
src/devices/dev_pcc2.c:671: 		}
src/devices/dev_pcc2.c:672: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:673: 			d->pcctwo_reg[relative_addr] = idata & 0xdf;
src/devices/dev_pcc2.c:674: 			if (idata & ~0xdf)
src/devices/dev_pcc2.c:675: 				fatal("[ pcc2: HUH? write to PCCTWO_SCSIICR"
src/devices/dev_pcc2.c:676: 				    " with value 0x%02x. ]\n", (int) idata);
src/devices/dev_pcc2.c:677: 			reassert_interrupts(d);
src/devices/dev_pcc2.c:678: 		}
src/devices/dev_pcc2.c:679: 		break;
src/devices/dev_pcc2.c:680: 
src/devices/dev_pcc2.c:681: 	case PCCTWO_IPL:
src/devices/dev_pcc2.c:682: 		/*  pcc2widthkills: was a #119 `static int w' -- process-global, and it
src/devices/dev_pcc2.c:683: 		    said "ignored" about a READ the memcpy above had already served.
src/devices/dev_pcc2.c:684: 		    Now per-instance, write-only, like the ten blocks above -- that is
src/devices/dev_pcc2.c:685: 		    the WIDTH latch; the body's own #119 `static int w' below stays
src/devices/dev_pcc2.c:686: 		    process-global (pcc2pscaleflood's family; not this round's).  */
src/devices/dev_pcc2.c:687: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:688: 			pcc2_width_decline(d, PCC2_W_IPL_LEN, "PCCTWO_IPL", len);
src/devices/dev_pcc2.c:689: 			break;
src/devices/dev_pcc2.c:690: 		}
src/devices/dev_pcc2.c:691: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:692: 			static int w = 0;	/* #119: was exit(1) (IPL is read-only) */
src/devices/dev_pcc2.c:693: 			if (!w) { fatal("[ pcc2: write to read-only PCCTWO_IPL; "
src/devices/dev_pcc2.c:694: 			    "ignored ]\n"); w = 1; }
src/devices/dev_pcc2.c:695: 		} else {
src/devices/dev_pcc2.c:696: 			if (d->pcctwo_reg[PCCTWO_IPL] == 0) {
src/devices/dev_pcc2.c:697: 				static int w = 0;	/* #119: was exit(1) */
src/devices/dev_pcc2.c:698: 				if (!w) { fatal("[ pcc2: IPL == 0 on read ]\n");
src/devices/dev_pcc2.c:699: 				    w = 1; }
src/devices/dev_pcc2.c:700: 			}
src/devices/dev_pcc2.c:701: 		}
src/devices/dev_pcc2.c:702: 		break;
src/devices/dev_pcc2.c:703: 
src/devices/dev_pcc2.c:704: 	case PCCTWO_MASK:
src/devices/dev_pcc2.c:705: 		/*  pcc2widthkills: was a #119 `static int w' -- process-global, and it
src/devices/dev_pcc2.c:706: 		    said "ignored" about a READ the memcpy above had already served.
src/devices/dev_pcc2.c:707: 		    Now per-instance, write-only, like the ten blocks above -- that is
src/devices/dev_pcc2.c:708: 		    the WIDTH latch.  (pcc2widthkills pass 7: this comment once claimed a
src/devices/dev_pcc2.c:709: 		    #119 static of MASK's own "below" -- there is none; the body stores
src/devices/dev_pcc2.c:710: 		    the byte and reasserts.  The static belongs to IPL's arm above.)  */
src/devices/dev_pcc2.c:711: 		if (len != 1 && writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:712: 			pcc2_width_decline(d, PCC2_W_MASK_LEN, "PCCTWO_MASK", len);
src/devices/dev_pcc2.c:713: 			break;
src/devices/dev_pcc2.c:714: 		}
src/devices/dev_pcc2.c:715: 		if (writeflag == MEM_WRITE) {
src/devices/dev_pcc2.c:716: 			d->pcctwo_reg[relative_addr] = idata;
src/devices/dev_pcc2.c:717: 			reassert_interrupts(d);
src/devices/dev_pcc2.c:718: 		}
src/devices/dev_pcc2.c:719: 		break;
src/devices/dev_pcc2.c:720: 
src/devices/dev_pcc2.c:721: 	default:
src/devices/dev_pcc2.c:722: 		/*  #501 (pcc2defaultkill): this arm ended the host with exit(1) on ANY
src/devices/dev_pcc2.c:723: 		    access to an offset with no case -- 43 of the 0x40 byte offsets:
src/devices/dev_pcc2.c:724: 		    eighteen documented registers the model does not implement (IEICR,
src/devices/dev_pcc2.c:725: 		    IEERR, IEBERR, GPIO, SCSIERR, the printer block, SPEED, the *IACKs),
src/devices/dev_pcc2.c:726: 		    the bytes inside the four counter/compare words, and the unnamed
src/devices/dev_pcc2.c:727: 		    ones -- READS included, though the memcpy above the switch had
src/devices/dev_pcc2.c:728: 		    already served them.  A guest ld.bu or st.b at any of them was a host
src/devices/dev_pcc2.c:729: 		    kill (rung-3 witness).  Now: a READ keeps the served byte (the array's
src/devices/dev_pcc2.c:730: 		    current byte, said so -- inside a running COUNT word that is the
src/devices/dev_pcc2.c:731: 		    tick's value, not a default); a WRITE is DECLINED.  Not a
src/devices/dev_pcc2.c:732: 		    backed store: the cased siblings contradict one (SCCERR clears on
src/devices/dev_pcc2.c:733: 		    write, the ICRs mask and reassert, PSCALECNT/SPEED/the IACKs are
src/devices/dev_pcc2.c:734: 		    read-only), no inspected OpenBSD driver path reaches them (if_ie never
src/devices/dev_pcc2.c:735: 		    attaches: unreadable sits at its 82596 address), and a store from the
src/devices/dev_pcc2.c:736: 		    one arm 43 offsets reach would add a bounded-write surface.  One
src/devices/dev_pcc2.c:737: 		    latched fatal() per offset per instance, the house `(once)' shape --
src/devices/dev_pcc2.c:738: 		    unlike PSCALEADJ's UNLATCHED print above (pcc2pscaleflood).  The
src/devices/dev_pcc2.c:739: 		    IACK offsets 0x23/0x25 are declined like the rest: modelling them (on
src/devices/dev_pcc2.c:740: 		    the SCCRXIACK shape) would open two new entries into the C040 path,
src/devices/dev_pcc2.c:741: 		    so pcc2c040kill goes first.  The %= fold above IS the real part's:
src/devices/dev_pcc2.c:742: 		    Motorola VMESBCP2 Table 6-1 lists $FFF42040-$FFF42FFF as repeated
src/devices/dev_pcc2.c:743: 		    PCCchip2 registers.  */
src/devices/dev_pcc2.c:744: 		if (!(d->warned_unimpl & (1ULL << relative_addr))) {
src/devices/dev_pcc2.c:745: 			d->warned_unimpl |= 1ULL << relative_addr;
src/devices/dev_pcc2.c:746: 			if (writeflag == MEM_WRITE)
src/devices/dev_pcc2.c:747: 				fatal("[ pcc2: unimplemented write to offset "
src/devices/dev_pcc2.c:748: 				    "0x%x (len %d): 0x%x -- declined.  (once) ]\n",
src/devices/dev_pcc2.c:749: 				    (int) relative_addr, (int) len, (int) idata);
src/devices/dev_pcc2.c:750: 			else
src/devices/dev_pcc2.c:751: 				/*  data[0] is the byte actually SERVED; a reload of the
src/devices/dev_pcc2.c:752: 				    array could differ: on the end-span path (zero-filled,
src/devices/dev_pcc2.c:753: 				    the array byte kept) and inside a running COUNT word,
src/devices/dev_pcc2.c:754: 				    whose SIGALRM-driven tick (timer.c) can land between
src/devices/dev_pcc2.c:755: 				    the copy and this line.  A wide read is labelled.  */
src/devices/dev_pcc2.c:756: 				fatal("[ pcc2: unimplemented read from offset "
src/devices/dev_pcc2.c:757: 				    "0x%x (len %d) -- served 0x%02x.  (once) ]\n",
src/devices/dev_pcc2.c:758: 				    (int) relative_addr, (int) len, data[0]);
src/devices/dev_pcc2.c:759: 		}
src/devices/dev_pcc2.c:760: 		break;
src/devices/dev_pcc2.c:761: 	}
src/devices/dev_pcc2.c:762: 
src/devices/dev_pcc2.c:763: 	return 1;
src/devices/dev_pcc2.c:764: }
src/devices/dev_footbridge.c:498: DEVICE_ACCESS(footbridge)
src/devices/dev_footbridge.c:499: {
src/devices/dev_footbridge.c:500: 	struct footbridge_data *d = (struct footbridge_data *) extra;
src/devices/dev_footbridge.c:501: 	uint64_t idata = 0, odata = 0;
src/devices/dev_footbridge.c:502: 	int timer_nr = 0;
src/devices/dev_footbridge.c:503: 
src/devices/dev_footbridge.c:504: 	if (writeflag == MEM_WRITE)
src/devices/dev_footbridge.c:505: 		idata = memory_readmax64(cpu, data, len);
src/devices/dev_footbridge.c:506: 
src/devices/dev_footbridge.c:507: 	if (relative_addr >= TIMER_1_LOAD && relative_addr <= TIMER_4_CLEAR) {
src/devices/dev_footbridge.c:508: 		timer_nr = (relative_addr >> 5) & (N_FOOTBRIDGE_TIMERS - 1);
src/devices/dev_footbridge.c:509: 		relative_addr &= ~0x060;
src/devices/dev_footbridge.c:510: 	}
src/devices/dev_footbridge.c:511: 
src/devices/dev_footbridge.c:512: 	switch (relative_addr) {
src/devices/dev_footbridge.c:513: 
src/devices/dev_footbridge.c:514: 	case VENDOR_ID:
src/devices/dev_footbridge.c:515: 		odata = 0x1011;  /*  DC21285_VENDOR_ID  */
src/devices/dev_footbridge.c:636: 	case TIMER_1_LOAD:
src/devices/dev_footbridge.c:637: 		if (writeflag == MEM_READ)
src/devices/dev_footbridge.c:638: 			odata = d->timer_load[timer_nr];
src/devices/dev_footbridge.c:639: 		else {
src/devices/dev_footbridge.c:640: 			d->timer_load[timer_nr] = idata & TIMER_MAX_VAL;
src/devices/dev_footbridge.c:641: 			reload_timer_value(cpu, d, timer_nr);
src/devices/dev_footbridge.c:642: 			/*  debug("[ footbridge: timer %i (1-based), "
src/devices/dev_footbridge.c:643: 			    "value %i ]\n", timer_nr + 1,
src/devices/dev_footbridge.c:644: 			    (int)d->timer_value[timer_nr]);  */
src/devices/dev_footbridge.c:645: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
src/devices/dev_footbridge.c:646: 		}
src/devices/dev_footbridge.c:647: 		break;
src/devices/dev_footbridge.c:648: 
src/devices/dev_footbridge.c:649: 	case TIMER_1_VALUE:
src/devices/dev_footbridge.c:650: 		if (writeflag == MEM_READ)
src/devices/dev_footbridge.c:651: 			odata = d->timer_value[timer_nr];
src/devices/dev_footbridge.c:652: 		else
src/devices/dev_footbridge.c:653: 			d->timer_value[timer_nr] = idata & TIMER_MAX_VAL;
src/devices/dev_footbridge.c:654: 		break;
src/devices/dev_footbridge.c:655: 
src/devices/dev_footbridge.c:656: 	case TIMER_1_CONTROL:
src/devices/dev_footbridge.c:657: 		if (writeflag == MEM_READ)
src/devices/dev_footbridge.c:658: 			odata = d->timer_control[timer_nr];
src/devices/dev_footbridge.c:659: 		else {
src/devices/dev_footbridge.c:660: 			d->timer_control[timer_nr] = idata;
src/devices/dev_footbridge.c:661: 			/*  #432: both prescaler bits set is TIMER_EXTERNAL
src/devices/dev_footbridge.c:662: 			    (0x0C, dc21285reg.h:364) -- a LEGAL named encoding,
src/devices/dev_footbridge.c:663: 			    and it used to reach fatal()+exit(1) right here, so a
src/devices/dev_footbridge.c:664: 			    guest selecting the external clock source KILLED THE
src/devices/dev_footbridge.c:665: 			    HOST.  Arguably likelier than the zero load, since it
src/devices/dev_footbridge.c:666: 			    is a documented mode rather than a malformed value.
src/devices/dev_footbridge.c:667: 			    The rate an external clock would actually give is
src/devices/dev_footbridge.c:668: 			    UNKNOWN and is NOT invented: footbridge_effective_cycles()
src/devices/dev_footbridge.c:669: 			    now gives the encoding a defined, survivable meaning
src/devices/dev_footbridge.c:670: 			    (the unprescaled period), and the real semantics are
src/devices/dev_footbridge.c:671: 			    filed for a round that has a datasheet.  */
src/devices/dev_footbridge.c:672: 			if (idata & TIMER_ENABLE) {
src/devices/dev_footbridge.c:673: 				reload_timer_value(cpu, d, timer_nr);
src/devices/dev_footbridge.c:674: 			} else {
src/devices/dev_footbridge.c:675: 				d->pending_timer_interrupts[timer_nr] = 0;
src/devices/dev_footbridge.c:676: 			}
src/devices/dev_footbridge.c:677: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
src/devices/dev_footbridge.c:678: 		}
src/devices/dev_footbridge.c:679: 		break;
src/devices/dev_footbridge.c:680: 
src/devices/dev_footbridge.c:681: 	case TIMER_1_CLEAR:
src/devices/dev_footbridge.c:682: 		/*  #474: a READ must not perform the clear.  This case carried no
src/devices/dev_footbridge.c:683: 		    writeflag test at all, while TIMER_1_CONTROL immediately above it
src/devices/dev_footbridge.c:684: 		    does -- so a guest READ reloaded the counter, decremented the
src/devices/dev_footbridge.c:685: 		    pending count and DEASSERTED the interrupt.  A guest that merely
src/devices/dev_footbridge.c:686: 		    read the register silently acknowledged a pending timer interrupt;
src/devices/dev_footbridge.c:687: 		    the guest-visible consequence is a LOST interrupt, not a bad value.
src/devices/dev_footbridge.c:688: 
src/devices/dev_footbridge.c:689: 		    FOUR addresses, not one: the fold above normalises 0x30C/0x32C/
src/devices/dev_footbridge.c:690: 		    0x34C/0x36C onto this single case.
src/devices/dev_footbridge.c:691: 
src/devices/dev_footbridge.c:692: 		    GUARD THE BODY, KEEP THE break.  An early return here would skip
src/devices/dev_footbridge.c:693: 		    the function's common tail, which writes odata back on a read, and
src/devices/dev_footbridge.c:694: 		    would hand a guest an untouched buffer -- a defect this code does
src/devices/dev_footbridge.c:695: 		    not currently have.  */
src/devices/dev_footbridge.c:696: 		if (writeflag == MEM_WRITE) {
src/devices/dev_footbridge.c:697: 			if (d->timer_control[timer_nr] & TIMER_MODE_PERIODIC) {
