    assert extra & 0x80000 and n % 2 == 0
    assert seed['fr'+str(n)]==seed['fr'+str(n+1)]==0xdeadbeef
    print('ROW',name,'DR'+str(n), 'DN='+str(not bool(extra & 0x80000000)),hex(word & 0xffff))
for p in sorted(table.glob('*.raw')):
    text = p.read_text()
