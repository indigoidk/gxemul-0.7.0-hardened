_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:1:#!/usr/bin/env python3
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:45:#  fmov.s FRm,@Rn  = 1111 nnnn mmmm 1010.  Rn = r1 throughout.
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:54:#  name, fpscr extra bits, register seed, packed instruction word, {mode: expected}
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:55:#  A vector may carry an OPTIONAL sixth element: a second 32-bit instruction word placed
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:56:#  at CODE+4 (stepped as 3 instructions instead of 2). ftrc needs it: the result lands in
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:57:#  FPUL, so the guest runs `ftrc ; sts fpul,r2` then `mov.l r2,@r1`.
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:150:    #  isfinite() guard existed; this row keeps the rig honest about the same contract.
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:219:    #  (fraction MSB = 1, manual :4980-4989), hence `snan'.  Disclosed, not rowed: finite
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:221:    #  input, and +0 (the one fixed point of the removed cast, which no row can observe).
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:347:# A vector whose two modes want the SAME answer cannot detect a reverted fix. Report the
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:348:# count of genuinely discriminating vectors so the gate can assert on it rather than
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:349:# trusting that the table was written correctly. The ftrc rows are REQUIRED to be
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:350:# mode-independent (truncation by architecture), so this count doubles as the tripwire
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:351:# for anyone accidentally wiring ftrc to FPSCR.RM.
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:352:# [#556, 2026-10-02 -- a records correction; the text above is kept as it was written] The ftrc rows are
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:353:# mode-independent by architecture; discriminating counts static vector dictionary entries (len(set(v[4].values()))
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:354:# > 1) to ensure the table retains mode discriminators, but does not observe emulator execution or tripwire ftrc
_scratchpad/w576/sh_rounding_probe.ASRUN_1716.py:355:# source changes.  (hbundle_regress25:F2: regress/artifacts/astraretro_harness_20260926/HARNESS_DISPOSITIONS.md)
_scratchpad/w576/gate_sh_rounding.NEW.sh:1:#!/bin/bash
_scratchpad/w576/gate_sh_rounding.NEW.sh:2:# GATE 10 -- SuperH floating-point rounding mode, measured on real guest instructions.
_scratchpad/w576/gate_sh_rounding.NEW.sh:3:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:4:# What this protects
_scratchpad/w576/gate_sh_rounding.NEW.sh:5:# -----------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:6:# #296 wired FPSCR.RM into thirteen of the sixteen single-precision store sites in
_scratchpad/w576/gate_sh_rounding.NEW.sh:7:# cpu_sh_instr.c. Before it, the field was guest-writable and decoded NOWHERE: every store
_scratchpad/w576/gate_sh_rounding.NEW.sh:8:# truncated. Truncation is round-toward-zero, which is the mode the SH-4 resets into, so
_scratchpad/w576/gate_sh_rounding.NEW.sh:9:# there was no visible defect until you look at a guest that CHANGES the mode -- and
_scratchpad/w576/gate_sh_rounding.NEW.sh:10:# OpenBSD/landisk installs round-to-nearest at every exec.
_scratchpad/w576/gate_sh_rounding.NEW.sh:11:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:12:# Why the vectors look the way they do
_scratchpad/w576/gate_sh_rounding.NEW.sh:13:# -----------------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:14:# Each one runs under BOTH modes and expects DIFFERENT answers, so reverting #296 turns the
_scratchpad/w576/gate_sh_rounding.NEW.sh:15:# gate red. Two vectors are deliberately mode-INDEPENDENT and named PIN: they record limits
_scratchpad/w576/gate_sh_rounding.NEW.sh:16:# that are real and are NOT fixed (double precision cannot be fixed at the store, and the
_scratchpad/w576/gate_sh_rounding.NEW.sh:17:# host-double double-rounding is shared by every CPU core). A pin failing means someone
_scratchpad/w576/gate_sh_rounding.NEW.sh:18:# changed a known limitation without updating the record -- which is worth knowing either
_scratchpad/w576/gate_sh_rounding.NEW.sh:19:# way, and is the opposite of a check that cannot fail.
_scratchpad/w576/gate_sh_rounding.NEW.sh:20:# [#556, 2026-10-02 -- a records correction; the text above is kept as it was written] Two vectors were formerly
_scratchpad/w576/gate_sh_rounding.NEW.sh:21:# mode-independent PINs until #299 (fsub band) and #300 (D-division) fixed both and made them discriminating.
_scratchpad/w576/gate_sh_rounding.NEW.sh:22:# (hgateshrounding:F12: regress/artifacts/astraretro_harness_20260926/HARNESS_DISPOSITIONS.md)
_scratchpad/w576/gate_sh_rounding.NEW.sh:23:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:24:# The gate asserts on the number of discriminating vectors as well as on the results,
_scratchpad/w576/gate_sh_rounding.NEW.sh:25:# because a table where every vector wants the same answer in both modes would pass
_scratchpad/w576/gate_sh_rounding.NEW.sh:26:# vacuously. That is the failure mode this harness has now been bitten by five times.
_scratchpad/w576/gate_sh_rounding.NEW.sh:59:# 52 vector-mode pairs since #576 (eight two-mode FCNVSD rows added to the 36 below).  The 36: 17 vectors x 2 modes (9 from #296, 6 ftrc rows from #297, and
_scratchpad/w576/gate_sh_rounding.NEW.sh:60:# #299 turned the double-rounding PIN into a discriminating row and added the fmac
_scratchpad/w576/gate_sh_rounding.NEW.sh:61:# tie-band witness) + #303's two single-mode subnormal-operand rows (RN pinned; DN
_scratchpad/w576/gate_sh_rounding.NEW.sh:62:# STRIPPED by their NODN marker -- a DN=1 numeric expectation would bless a value
_scratchpad/w576/gate_sh_rounding.NEW.sh:63:# real silicon flushes; committed bytes 0x32000001 / 0x3f800001 measured live).
_scratchpad/w576/gate_sh_rounding.NEW.sh:64:#  #576: 36 -> 52.  Eight FCNVSD rows (six FPUL readbacks + the two DRn halves) at two modes each; see the
_scratchpad/w576/gate_sh_rounding.NEW.sh:65:#  probe's #576 block.  EQUALITY on purpose: a row that silently vanishes reds here instead of passing a floor.
_scratchpad/w576/gate_sh_rounding.NEW.sh:66:check     "vector-mode pairs run"                  "$want" 52
_scratchpad/w576/gate_sh_rounding.NEW.sh:67:check     "vector-mode pairs correct"              "$got"  "$want"
_scratchpad/w576/gate_sh_rounding.NEW.sh:68:# EXACTLY 9 of the 25 vectors (17 until #576 added eight single-value FCNVSD rows) discriminate between the two modes: the 7 from #296 plus
_scratchpad/w576/gate_sh_rounding.NEW.sh:69:# the #299-fixed fsub band row and the #300-fixed D-division row (each a PIN until its
_scratchpad/w576/gate_sh_rounding.NEW.sh:70:# fix landed; each flip was that fix's acceptance test). If this number drops, someone weakened the table; if it RISES,
_scratchpad/w576/gate_sh_rounding.NEW.sh:71:# someone made a mode-independent row (an ftrc row, or the fmac tie whose two modes
_scratchpad/w576/gate_sh_rounding.NEW.sh:72:# genuinely agree) depend on FPSCR.RM, which is drift in the other direction.
_scratchpad/w576/gate_sh_rounding.NEW.sh:73:# (#303's two rows are single-mode by design and cannot enter this count.)
_scratchpad/w576/gate_sh_rounding.NEW.sh:76:# Per-instruction closure: naming them individually means a single site silently reverting
_scratchpad/w576/gate_sh_rounding.NEW.sh:77:# cannot hide behind an aggregate count. The ftrc rows are #297's regression checks; the
_scratchpad/w576/gate_sh_rounding.NEW.sh:78:# "fsub band" and "fmactie" rows are #299's (the pre-#299 build fails the band's RZ arm
_scratchpad/w576/gate_sh_rounding.NEW.sh:79:# and the tie's RN arm).
_scratchpad/w576/gate_sh_rounding.NEW.sh:88:# #303's subnormal rows are SINGLE-mode (RN pinned; see the probe) -- one line each.
_scratchpad/w576/gate_sh_rounding.NEW.sh:94:# ---- #314: legal encodings must not stop the emulator ------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:95:# The SH decoder answered an unimplemented encoding with `goto bad`, which sets
_scratchpad/w576/gate_sh_rounding.NEW.sh:96:# cpu->running = 0. All eight rows below were measured HALTING the committed
_scratchpad/w576/gate_sh_rounding.NEW.sh:97:# build; three of them are BASE ISA (MAC.L, MAC.W, TST.B), present since
_scratchpad/w576/gate_sh_rounding.NEW.sh:98:# SH-1/SH-2 and legal on the SH7751R this rig models -- so this is not a
_scratchpad/w576/gate_sh_rounding.NEW.sh:99:# question about accepting SH-4A extensions on an SH-4 core.
_scratchpad/w576/gate_sh_rounding.NEW.sh:100:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:101:# The probe classifies the outcome from the dyntrans halt MESSAGE, not from a
_scratchpad/w576/gate_sh_rounding.NEW.sh:102:# memory marker: after the fix the exception is raised and any store placed
_scratchpad/w576/gate_sh_rounding.NEW.sh:103:# after the test instruction is legitimately never reached, so a marker-only
_scratchpad/w576/gate_sh_rounding.NEW.sh:104:# check called every repaired row a failure (and called SLEEP, which is
_scratchpad/w576/gate_sh_rounding.NEW.sh:105:# implemented and simply sleeps, a halt). See the probe's header.
_scratchpad/w576/gate_sh_rounding.NEW.sh:128:# Named, so one encoding regressing cannot hide behind a total. Two spaces after
_scratchpad/w576/gate_sh_rounding.NEW.sh:129:# the name: the probe pads to a fixed column and a name that is a PREFIX of
_scratchpad/w576/gate_sh_rounding.NEW.sh:130:# another would otherwise match both rows (the trap that made two of gate 14's
_scratchpad/w576/gate_sh_rounding.NEW.sh:131:# checks unsatisfiable and two of gate 13's count the wrong rows).
_scratchpad/w576/gate_sh_rounding.NEW.sh:137:# ---- #315/#316/#317: execute-time halts, and one dropped store ---------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:138:# These need a state prologue (FPSCR.SZ/PR, SR.FD, a branch), so the bare
_scratchpad/w576/gate_sh_rounding.NEW.sh:139:# encoding sweep above is structurally blind to them -- which is why they
_scratchpad/w576/gate_sh_rounding.NEW.sh:140:# outlived #314. Three of them killed the gxemul PROCESS rather than setting
_scratchpad/w576/gate_sh_rounding.NEW.sh:141:# cpu->running = 0, so the probe distinguishes a host exit from an emulator
_scratchpad/w576/gate_sh_rounding.NEW.sh:142:# halt from a live run; a check that only looked for the halt message would
_scratchpad/w576/gate_sh_rounding.NEW.sh:143:# have scored those as passes.
_scratchpad/w576/gate_sh_rounding.NEW.sh:144:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:145:# The two XD rows are load-bearing. The register-pair handlers redirect an ODD
_scratchpad/w576/gate_sh_rounding.NEW.sh:146:# register field to the XF bank, and an earlier draft computed that redirect
_scratchpad/w576/gate_sh_rounding.NEW.sh:147:# then still transferred through the original pointer -- which every DR test
_scratchpad/w576/gate_sh_rounding.NEW.sh:148:# passes. Only a row that seeds fr and xf differently can tell them apart.
_scratchpad/w576/gate_sh_rounding.NEW.sh:149:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:150:# `movca.l` carries its own trap: r12 is the DECODER's default source for that
_scratchpad/w576/gate_sh_rounding.NEW.sh:151:# encoding, so the row seeds r12 with a decoy and fails if the R0 override is
_scratchpad/w576/gate_sh_rounding.NEW.sh:152:# ever dropped.
_scratchpad/w576/gate_sh_rounding.NEW.sh:153:# ---- #318: the store-queue flush with the MMU on -----------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:154:# `pref` into the SQ range is a write-back, and with MMUCR.AT set the
_scratchpad/w576/gate_sh_rounding.NEW.sh:155:# destination comes from the UTLB, not from QACR. That path used to run
_scratchpad/w576/gate_sh_rounding.NEW.sh:156:# ABORT_EXECUTION.
_scratchpad/w576/gate_sh_rounding.NEW.sh:157:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:158:# The probe installs the UTLB entry and MMUCR through GUEST stores to the
_scratchpad/w576/gate_sh_rounding.NEW.sh:159:# architectural MMIO windows, because the debugger's register names for those
_scratchpad/w576/gate_sh_rounding.NEW.sh:160:# fields exist but do not reach them -- an earlier version set them by name,
_scratchpad/w576/gate_sh_rounding.NEW.sh:161:# never entered the AT branch, and would have passed against an unfixed build.
_scratchpad/w576/gate_sh_rounding.NEW.sh:162:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:163:# `sq at1 ok` is the composition witness, not just a survival check: the operand
_scratchpad/w576/gate_sh_rounding.NEW.sh:164:# has nonzero bits in BOTH [9:5] and [4:0], and the architectural destination is
_scratchpad/w576/gate_sh_rounding.NEW.sh:165:# the translated page plus [9:5] with [4:0] zeroed -- an address that is neither
_scratchpad/w576/gate_sh_rounding.NEW.sh:166:# the operand nor the page base.
_scratchpad/w576/gate_sh_rounding.NEW.sh:167:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:168:# *** THIS BLOCK USED TO PIN THE OPPOSITE OF THE MANUAL, and it said so plainly:
_scratchpad/w576/gate_sh_rounding.NEW.sh:169:# "a build that judged this access as a read would complete the copy and fail
_scratchpad/w576/gate_sh_rounding.NEW.sh:170:# this row alone."  It would have.  Corrected in #454. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:171:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:172:# SH7750 Hardware Manual Rev.7.00 4.7.4 "SQ Protection", p. 144 --
_scratchpad/w576/gate_sh_rounding.NEW.sh:173:# `_scratchpad/sh7750_hardware.txt:11744-11746`, identically in the SH-4
_scratchpad/w576/gate_sh_rounding.NEW.sh:174:# programming manual 4.6.4 at `sh4_programming.txt:3561-3563`:
_scratchpad/w576/gate_sh_rounding.NEW.sh:175:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:176:#     "Write type exception judgment is performed for writes to the SQs, and
_scratchpad/w576/gate_sh_rounding.NEW.sh:177:#      read type for transfer from the SQs to external memory (PREF
_scratchpad/w576/gate_sh_rounding.NEW.sh:178:#      instruction), and a TLB miss exception, protection violation exception,
_scratchpad/w576/gate_sh_rounding.NEW.sh:179:#      or initial page write exception is generated."
_scratchpad/w576/gate_sh_rounding.NEW.sh:180:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:181:# Quoted in full because these rows were previously pinned to a panel VERDICT
_scratchpad/w576/gate_sh_rounding.NEW.sh:182:# rather than to a document, and a future seat must be able to re-derive them
_scratchpad/w576/gate_sh_rounding.NEW.sh:183:# without trusting this round.  The manual was not in the tree when they were
_scratchpad/w576/gate_sh_rounding.NEW.sh:184:# first pinned; it is now.
_scratchpad/w576/gate_sh_rounding.NEW.sh:185:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:186:# So `sq pr00 rdok` and `sq d0 rdok` FLUSH: privileged read is permitted by
_scratchpad/w576/gate_sh_rounding.NEW.sh:187:# PR=00 and is indifferent to D.  The three `evt` rows carry the exception
_scratchpad/w576/gate_sh_rounding.NEW.sh:188:# channel, which is the only channel that can see the change once the copy
_scratchpad/w576/gate_sh_rounding.NEW.sh:189:# completes either way -- and MEASURED, two one-token mutants scored full marks
_scratchpad/w576/gate_sh_rounding.NEW.sh:190:# without them, one of which lands the payload at PHYSICAL ZERO in silence.
_scratchpad/w576/gate_sh_rounding.NEW.sh:191:# The two `itlb` rows kill FLAG_INSTR, which escapes the value rows AND the
_scratchpad/w576/gate_sh_rounding.NEW.sh:192:# EXPEVT rows because it also yields 0x040.
_scratchpad/w576/gate_sh_rounding.NEW.sh:193:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:194:# *** `sq at0 qacr` WAS CALLED "the regression guard: the QACR composition must be
_scratchpad/w576/gate_sh_rounding.NEW.sh:195:# exactly as before".  MEASURED FALSE in #454 -- the composition can be DELETED
_scratchpad/w576/gate_sh_rounding.NEW.sh:196:# OUTRIGHT and that row stays green. ***  It pins `addr & 0x03ffffe0` and nothing
_scratchpad/w576/gate_sh_rounding.NEW.sh:197:# more.  Two structural reasons, neither of them bad luck: no row in the probe ever
_scratchpad/w576/gate_sh_rounding.NEW.sh:198:# wrote QACR0 or QACR1 and dev_sh4.c seeds them nowhere, so the term under test was
_scratchpad/w576/gate_sh_rounding.NEW.sh:199:# identically ZERO in every row; and every SQ operand had bit 5 SET, so `sq_nr` was
_scratchpad/w576/gate_sh_rounding.NEW.sh:200:# 1 in all ten rows and QACR0 was never the register consulted, ever.
_scratchpad/w576/gate_sh_rounding.NEW.sh:201:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:202:# The three `sq qacr*` rows are the real guard, and they were added because the
_scratchpad/w576/gate_sh_rounding.NEW.sh:203:# escape is WITNESSED guest-visible corruption rather than a hypothesis: with AT=0,
_scratchpad/w576/gate_sh_rounding.NEW.sh:204:# the ordinary store-queue mode without paging, the destination AREA comes entirely
_scratchpad/w576/gate_sh_rounding.NEW.sh:205:# from QACR, so dropping the term or swapping the two registers lands 32 bytes on
_scratchpad/w576/gate_sh_rounding.NEW.sh:206:# the wrong physical page.  Measured 34/34 on the fix, 31/34 on each mutant.
_scratchpad/w576/gate_sh_rounding.NEW.sh:207:#  Row names are capped at 13 CHARACTERS and that is not cosmetic: the probe
_scratchpad/w576/gate_sh_rounding.NEW.sh:208:#  prints them through %-14s and this pattern demands two spaces after the name,
_scratchpad/w576/gate_sh_rounding.NEW.sh:209:#  so a 14-character name leaves ONE and the check becomes unsatisfiable -- it
_scratchpad/w576/gate_sh_rounding.NEW.sh:210:#  counts 0 against an expected 1 and reddens for a reason unrelated to the code.
_scratchpad/w576/gate_sh_rounding.NEW.sh:211:#  Two of #454's first-draft names broke it.  Measure after any rename.
_scratchpad/w576/gate_sh_rounding.NEW.sh:224:# ---- #457: a UTLB associative write matching two entries ended the host -------
_scratchpad/w576/gate_sh_rounding.NEW.sh:225:#  Wired in the SAME commit as the fix, per gate 6's structural note.
_scratchpad/w576/gate_sh_rounding.NEW.sh:226:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:227:#  SIX ROWS, and two of them exist because a survival-only oracle was MEASURED
_scratchpad/w576/gate_sh_rounding.NEW.sh:228:#  passing six different mutants.  `expevt` + `pc` kills four of them; the other two
_scratchpad/w576/gate_sh_rounding.NEW.sh:229:#  need rows nothing else provides:
_scratchpad/w576/gate_sh_rounding.NEW.sh:230:#    * `tlbm sr` pre-sets SR to 0x40008000 so the reset transition's THIRD statement
_scratchpad/w576/gate_sh_rounding.NEW.sh:231:#      is observable.  From the reset-default SR that statement is a NO-OP, which is
_scratchpad/w576/gate_sh_rounding.NEW.sh:232:#      why an arm that sets pc and vbr and forgets it passes every other row.
_scratchpad/w576/gate_sh_rounding.NEW.sh:233:#    * `tlbm single` gives entry 1 a different VPN so nothing should fire.  It is the
_scratchpad/w576/gate_sh_rounding.NEW.sh:234:#      only row that sees a `n_hits >= 1` mutant, and it doubles as the liveness
_scratchpad/w576/gate_sh_rounding.NEW.sh:235:#      control -- it proves the three stores execute and the session survives them.
_scratchpad/w576/gate_sh_rounding.NEW.sh:236:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:237:#  landisk and not testsh, deliberately: landisk's PROM leaves vbr = 0x8c000000, so
_scratchpad/w576/gate_sh_rounding.NEW.sh:238:#  `vbr == 0` is a real transition.  On testsh vbr is already 0 and that row would be
_scratchpad/w576/gate_sh_rounding.NEW.sh:239:#  vacuous.
_scratchpad/w576/gate_sh_rounding.NEW.sh:241:#  *** -u ON ALL SIX PROBES IN THIS GATE. ***  `probeslow` recorded the streaming
_scratchpad/w576/gate_sh_rounding.NEW.sh:242:#  mitigation as APPLIED and called it "the general fix" -- and it had been applied to
_scratchpad/w576/gate_sh_rounding.NEW.sh:243:#  NONE of them: the -u lived only in ad-hoc measurement scripts.  These six are exactly
_scratchpad/w576/gate_sh_rounding.NEW.sh:244:#  the six probes `probetimebased` names as having no prompt detection, so they are also
_scratchpad/w576/gate_sh_rounding.NEW.sh:245:#  the six whose runs are longest and most worth not losing.  Redirected to a file,
_scratchpad/w576/gate_sh_rounding.NEW.sh:246:#  stdout is block buffered and a killed run loses everything it had already measured.
_scratchpad/w576/gate_sh_rounding.NEW.sh:266:# ---- #455: an interrupt at priority 0 ended the host process -----------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:267:#  Wired in the SAME commit as the fix.  Gate 6's structural note says a probe that
_scratchpad/w576/gate_sh_rounding.NEW.sh:268:#  ships with its wiring cannot skip its census pin, because the wiring forces a
_scratchpad/w576/gate_sh_rounding.NEW.sh:269:#  gate run -- #441's did not, and its pin then went latently red between two
_scratchpad/w576/gate_sh_rounding.NEW.sh:270:#  commits.
_scratchpad/w576/gate_sh_rounding.NEW.sh:271:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:272:#  This probe drives BOTH SH rigs, and which row uses which is forced rather than
_scratchpad/w576/gate_sh_rounding.NEW.sh:273:#  stylistic.
_scratchpad/w576/gate_sh_rounding.NEW.sh:274:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:275:#  The PRIMARY witness is `-E testsh`, where the kill is reached SYNCHRONOUSLY --
_scratchpad/w576/gate_sh_rounding.NEW.sh:276:#  one guest store to the mp device's IPI register -- because the test machine wires
_scratchpad/w576/gate_sh_rounding.NEW.sh:277:#  its whole interrupt tree to a line the priority loop never assigns.  Being
_scratchpad/w576/gate_sh_rounding.NEW.sh:278:#  synchronous is what lets a cheap `step` see it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:279:#  [#556, 2026-10-02 -- a records correction; the text above is kept as it was written] The testsh witness uses
_scratchpad/w576/gate_sh_rounding.NEW.sh:280:#  IRQ14 (priority 1); synchronous delivery and masking are tested here, while priority-zero coverage uses TMU.
_scratchpad/w576/gate_sh_rounding.NEW.sh:281:#  (hgateshrounding:F13: regress/artifacts/astraretro_harness_20260926/HARNESS_DISPOSITIONS.md)
_scratchpad/w576/gate_sh_rounding.NEW.sh:282:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:283:#  The SECONDARY rows (`prio0 tmu`, `prio0 tmuq`) drive the landisk TMU route and
_scratchpad/w576/gate_sh_rounding.NEW.sh:284:#  must FREE-RUN, because a TMU underflow is produced by a HOST timer and
_scratchpad/w576/gate_sh_rounding.NEW.sh:285:#  debugger.c stops those for the duration of a `step`.  They exist because a
_scratchpad/w576/gate_sh_rounding.NEW.sh:286:#  MEASURED mutant that repaired only the testsh route scored full marks without
_scratchpad/w576/gate_sh_rounding.NEW.sh:287:#  them.  See the probe header.
_scratchpad/w576/gate_sh_rounding.NEW.sh:322:# ------------------------------------------------------------------ #458 sh4_iprbcd
_scratchpad/w576/gate_sh_rounding.NEW.sh:323:#  sh_update_interrupt_priorities() read two of the four IPR registers, and took SCIF
_scratchpad/w576/gate_sh_rounding.NEW.sh:324:#  from INTPRI00 -- an SH7750R/SH7760 register this machine never even MAPS, so SCIF's
_scratchpad/w576/gate_sh_rounding.NEW.sh:325:#  priority was a guest-immutable 3 while the boot witness shows OpenBSD asking for 12.
_scratchpad/w576/gate_sh_rounding.NEW.sh:326:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:327:#  Two of these rows read the priority TABLE rather than a delivery, and that is not
_scratchpad/w576/gate_sh_rounding.NEW.sh:328:#  decoration: WDT, REF, SCI, GPIO, DMAC, H-UDI and RTC have NO `INTERRUPT_ASSERT`
_scratchpad/w576/gate_sh_rounding.NEW.sh:329:#  anywhere in this tree, so a mutant dropping their mapping scores a clean 10/10
_scratchpad/w576/gate_sh_rounding.NEW.sh:330:#  against every behavioural row that can be written.  Nothing a guest can DO depends
_scratchpad/w576/gate_sh_rounding.NEW.sh:331:#  on those priorities -- only what the table SAYS.
_scratchpad/w576/gate_sh_rounding.NEW.sh:387:# ------------------------------------------------------------------ #459 sh4_pclock
_scratchpad/w576/gate_sh_rounding.NEW.sh:388:#  ONE ORDINARY GUEST STORE to 0xffd80010 ended the host process on every SH machine
_scratchpad/w576/gate_sh_rounding.NEW.sh:389:#  whose board never assigned a peripheral clock.  cpu_sh.c:233-234 adds the sh4 device
_scratchpad/w576/gate_sh_rounding.NEW.sh:390:#  from `arch == 4`, so the CPU brings the TMU and the BOARD brings the clock, and
_scratchpad/w576/gate_sh_rounding.NEW.sh:391:#  nothing checked that the two agree.  MEASURED dead on THREE machine types --
_scratchpad/w576/gate_sh_rounding.NEW.sh:392:#  -e jornada680, -E baresh and -E testsh -- while dreamcast and landisk, the only two
_scratchpad/w576/gate_sh_rounding.NEW.sh:393:#  that assign pclock, were fine.
_scratchpad/w576/gate_sh_rounding.NEW.sh:394:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:395:#  This gate section is the de-escalation clause's cost, paid in full.  #459 removed a
_scratchpad/w576/gate_sh_rounding.NEW.sh:396:#  host-fatal guard, which DELETES the accidental tripwire that made the behaviour
_scratchpad/w576/gate_sh_rounding.NEW.sh:397:#  self-announcing, so the rows below rebuild it deliberately on both sides.
_scratchpad/w576/gate_sh_rounding.NEW.sh:437:# ------------------------------------------------------------------ #460 gdrom_data
_scratchpad/w576/gate_sh_rounding.NEW.sh:438:#  FOUR guest-reachable exit(1) sites in ONE register's access arm.  `cond` and `busy`
_scratchpad/w576/gate_sh_rounding.NEW.sh:439:#  are both zero on a fresh device, so THERE WAS NO LEGAL FIRST TOUCH of GDROM_DATA:
_scratchpad/w576/gate_sh_rounding.NEW.sh:440:#  any non-16-bit access in either direction, the first 16-bit read, and the first
_scratchpad/w576/gate_sh_rounding.NEW.sh:441:#  16-bit write each ended the host process.  Measured 5/23 pre-fix, 23/23 post-fix,
_scratchpad/w576/gate_sh_rounding.NEW.sh:442:#  the pre-fix build rebuilt from `git show HEAD:` and not from build/.
_scratchpad/w576/gate_sh_rounding.NEW.sh:443:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:444:#  Dreamcast needs -x or it exits before the debugger prompt (two console inputs,
_scratchpad/w576/gate_sh_rounding.NEW.sh:445:#  console.c:994-1007).  Without it a session dies for a CONFIGURATION reason and
_scratchpad/w576/gate_sh_rounding.NEW.sh:446:#  prints the same "died" the defect prints -- that cost #459 a false positive.
_scratchpad/w576/gate_sh_rounding.NEW.sh:475:    #  `accept d0`/`accept d1` are the de-escalation accept for four removed
_scratchpad/w576/gate_sh_rounding.NEW.sh:486:# --------------------------------------------------------------- #461 gdrom_default
_scratchpad/w576/gate_sh_rounding.NEW.sh:487:#  dev_dreamcast_gdrom.c registers a 0x100 window and implements EIGHT offsets; every
_scratchpad/w576/gate_sh_rounding.NEW.sh:488:#  other address fell to a `default:` arm that printed then exit(1)ed -- a read OR a
_scratchpad/w576/gate_sh_rounding.NEW.sh:489:#  write, at any width.  MEASURED: 21 offsets sampled, 19 died.  One predicate, roughly
_scratchpad/w576/gate_sh_rounding.NEW.sh:490:#  248 of 256 byte offsets lethal, so a driver scanning the register space died on its
_scratchpad/w576/gate_sh_rounding.NEW.sh:491:#  first unhandled address.  The DMA window's own default arm joined the round on a
_scratchpad/w576/gate_sh_rounding.NEW.sh:492:#  measurement: it died on committed HEAD AND on a build that fixed only the control
_scratchpad/w576/gate_sh_rounding.NEW.sh:493:#  window.  *** 9/32 pre-fix, 32/32 post-fix, both measured AT 32 ROWS (pre461f.out).
_scratchpad/w576/gate_sh_rounding.NEW.sh:494:#  ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:495:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:496:#  This line asserted `8/32 ... BOTH MEASURED` before that run existed, and the carried
_scratchpad/w576/gate_sh_rounding.NEW.sh:497:#  8 was wrong as well as unmeasured -- the real figure is 9, because `dma accept`
_scratchpad/w576/gate_sh_rounding.NEW.sh:498:#  reads five IMPLEMENTED DMA offsets and those work on the pre-fix build.  A seat
_scratchpad/w576/gate_sh_rounding.NEW.sh:499:#  predicted 9 from the code and the measurement returned it.  Hence the carrier rule
_scratchpad/w576/gate_sh_rounding.NEW.sh:500:#  that a score claim names its log: section U checks the DENOMINATOR against this
_scratchpad/w576/gate_sh_rounding.NEW.sh:501:#  file's own pin, and nothing can check a NUMERATOR that was never run.
_scratchpad/w576/gate_sh_rounding.NEW.sh:502:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:503:#  This line said "7/27 pre-fix, 27/27 post-fix -- both MEASURED at the final row
_scratchpad/w576/gate_sh_rounding.NEW.sh:504:#  count, not carried over" while citing the earlier carried-over incident as the
_scratchpad/w576/gate_sh_rounding.NEW.sh:505:#  thing it had learned from.  A seat found it FALSE THREE WAYS: the final count is
_scratchpad/w576/gate_sh_rounding.NEW.sh:506:#  32, not 27; NO 7/27 measurement ever existed (the runs on record are 7/21, 7/25
_scratchpad/w576/gate_sh_rounding.NEW.sh:507:#  and 8/32); and the honest pre-fix number is 8, not 7, because `dma seed` passes
_scratchpad/w576/gate_sh_rounding.NEW.sh:508:#  pre-fix -- the implemented +0x04 always worked.
_scratchpad/w576/gate_sh_rounding.NEW.sh:509:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:510:#  Third generation of the frozen-number defect, inside the sentence memorialising
_scratchpad/w576/gate_sh_rounding.NEW.sh:511:#  the first two.  Section U now checks the DENOMINATOR against this file's own pin
_scratchpad/w576/gate_sh_rounding.NEW.sh:512:#  mechanically; the NUMERATOR and the word "measured" still cannot be checked by
_scratchpad/w576/gate_sh_rounding.NEW.sh:513:#  anything but a reader, which is exactly how this one survived.
_scratchpad/w576/gate_sh_rounding.NEW.sh:514:#  after the probe had grown to 25, which is the stale-score class a seat caught
_scratchpad/w576/gate_sh_rounding.NEW.sh:515:#  mid-answer and section U now checks mechanically.
_scratchpad/w576/gate_sh_rounding.NEW.sh:517:#  -u IS LOAD-BEARING.  `probeslow` recorded the streaming mitigation as APPLIED;
_scratchpad/w576/gate_sh_rounding.NEW.sh:518:#  it was applied only in ad-hoc measurement scripts, never HERE -- and this is
_scratchpad/w576/gate_sh_rounding.NEW.sh:519:#  the invocation that runs weekly.  Redirected to a file, stdout is block
_scratchpad/w576/gate_sh_rounding.NEW.sh:520:#  buffered and the probe (no flush anywhere, a few KB of output) loses EVERY
_scratchpad/w576/gate_sh_rounding.NEW.sh:521:#  row if the run is killed.  A killed run then looks like a run that produced
_scratchpad/w576/gate_sh_rounding.NEW.sh:522:#  nothing, which is the silence this row was filed about.
_scratchpad/w576/gate_sh_rounding.NEW.sh:600:#  ---------------------------------------------------------------- #463
_scratchpad/w576/gate_sh_rounding.NEW.sh:601:#  asic_badaddr: dev_dreamcast_asic.c ended the host process on a SINGLE
_scratchpad/w576/gate_sh_rounding.NEW.sh:602:#  guest load.  `r = (relative_addr / 4) & 3` then `exit(1)` when r == 3 --
_scratchpad/w576/gate_sh_rounding.NEW.sh:603:#  above the switch and above the writeflag test, so no store, no staging
_scratchpad/w576/gate_sh_rounding.NEW.sh:604:#  and no command sequence was needed.
_scratchpad/w576/gate_sh_rounding.NEW.sh:605:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:606:#  THE DENOMINATOR IS 14 -- it read 13 until 2026-09-06, when the retrospective
_scratchpad/w576/gate_sh_rounding.NEW.sh:607:#  re-check found the loop below naming thirteen of the probe's fourteen rows and
_scratchpad/w576/gate_sh_rounding.NEW.sh:608:#  omitting `sweep 256' (the byte-load of all 256 offsets), which is now added.  An
_scratchpad/w576/gate_sh_rounding.NEW.sh:609:#  unlisted row is not a failing row: it silently stops being checked while the gate
_scratchpad/w576/gate_sh_rounding.NEW.sh:610:#  stays green, which is this file's own padded-column hazard reached by a different
_scratchpad/w576/gate_sh_rounding.NEW.sh:611:#  road.  FOUR OF THOSE ROWS EXIST BECAUSE A PANEL FOUND
_scratchpad/w576/gate_sh_rounding.NEW.sh:612:#  THE FIRST NINE INSUFFICIENT.  `alias`, `alias2` and `crossarr` pin the INDEXING
_scratchpad/w576/gate_sh_rounding.NEW.sh:613:#  half of the bound on r; the other nine pin the kill and the accept side.
_scratchpad/w576/gate_sh_rounding.NEW.sh:614:#  They are COMPLEMENTARY on purpose -- neither catches the other's mutant:
_scratchpad/w576/gate_sh_rounding.NEW.sh:615:#    & 3 -> & 2  aliases +0x14 onto +0x10   -> only `alias` sees it
_scratchpad/w576/gate_sh_rounding.NEW.sh:616:#    & 3 -> & 7  reaches mask_13[4], which IS mask_11[1] (the struct declares
_scratchpad/w576/gate_sh_rounding.NEW.sh:617:#                pending_irq[3], mask_13[3], mask_11[3], mask_9[3]
_scratchpad/w576/gate_sh_rounding.NEW.sh:618:#                CONSECUTIVELY) -> only `crossarr` sees it
_scratchpad/w576/gate_sh_rounding.NEW.sh:619:#    & 3 -> & 1  aliases +0x18 onto +0x10   -> only `alias2` sees it
_scratchpad/w576/gate_sh_rounding.NEW.sh:620:#    / 4 -> / 2  aliases +0x18 onto +0x10   -> only `alias2` sees it
_scratchpad/w576/gate_sh_rounding.NEW.sh:621:#  A same-array distinctness row CANNOT see `& 7`: under it the three mask_13
_scratchpad/w576/gate_sh_rounding.NEW.sh:622:#  words map to [4],[5],[6], three distinct cells that still round-trip.
_scratchpad/w576/gate_sh_rounding.NEW.sh:623:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:624:#  THE UNIT OF COVERAGE IS THE COLLISION PAIR, not "aliasing" in the abstract.
_scratchpad/w576/gate_sh_rounding.NEW.sh:625:#  Three register words admit distinct pairs and ONE distinctness row pins ONE
_scratchpad/w576/gate_sh_rounding.NEW.sh:626:#  pair.  `alias` pins words 0 and 1; `& 1` and `/ 2` both collide words 0 and
_scratchpad/w576/gate_sh_rounding.NEW.sh:627:#  TWO, so it was blind to both until `alias2` was added.  Four seats found
_scratchpad/w576/gate_sh_rounding.NEW.sh:628:#  these four escapes against a table that was already green.
_scratchpad/w576/gate_sh_rounding.NEW.sh:629:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:630:#  -u IS LOAD-BEARING, for the reason the gdrom section above records: with
_scratchpad/w576/gate_sh_rounding.NEW.sh:631:#  stdout redirected to a file it is block buffered, and a killed run then
_scratchpad/w576/gate_sh_rounding.NEW.sh:632:#  loses every row and looks like a run that produced nothing.
_scratchpad/w576/gate_sh_rounding.NEW.sh:710:#  NOTE ON CHECK NAMING: the sections above use `check "  $v"`, a bare padded
_scratchpad/w576/gate_sh_rounding.NEW.sh:711:#  row name. Every section has a `live` row, so those names COLLIDE in the
_scratchpad/w576/gate_sh_rounding.NEW.sh:712:#  gate's own output and a reader cannot tell which section a failing `live`
_scratchpad/w576/gate_sh_rounding.NEW.sh:713:#  belongs to. This section prefixes with `asic_badaddr` deliberately.
_scratchpad/w576/gate_sh_rounding.NEW.sh:715:# ------------------------------------------------------------------ #443 sh4_pcic
_scratchpad/w576/gate_sh_rounding.NEW.sh:716:#  A guest 32-bit LOAD to an unimplemented PCIC offset used to END THE HOST PROCESS.  A
_scratchpad/w576/gate_sh_rounding.NEW.sh:717:#  MEASURED census of all 137 word offsets in both directions found 116 killing on a read
_scratchpad/w576/gate_sh_rounding.NEW.sh:718:#  and 125 on a write; post-fix both are 0.
_scratchpad/w576/gate_sh_rounding.NEW.sh:719:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:720:#  *** WIRED HERE IN THE SAME COMMIT AS THE PROBE, WHICH IS THE WHOLE POINT. ***  Both
_scratchpad/w576/gate_sh_rounding.NEW.sh:721:#  sh_halt_probe.py above and sh4_bsc_width_probe.py (#441) shipped UNWIRED, and gate 6's
_scratchpad/w576/gate_sh_rounding.NEW.sh:722:#  own structural note says a probe that ships with its wiring cannot skip its census pin,
_scratchpad/w576/gate_sh_rounding.NEW.sh:723:#  because the wiring forces a gate run.  #441's did not, and the pin then went latently
_scratchpad/w576/gate_sh_rounding.NEW.sh:724:#  red between two commits.
_scratchpad/w576/gate_sh_rounding.NEW.sh:725:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:726:#  Note the existing halt probe is blind to this by construction: it classifies from the
_scratchpad/w576/gate_sh_rounding.NEW.sh:727:#  dyntrans HALT message, and exit(1) is not a halt.
_scratchpad/w576/gate_sh_rounding.NEW.sh:749:# ------------------------------------------------------------------ #447 sh4 value guards
_scratchpad/w576/gate_sh_rounding.NEW.sh:750:#  A SIBLING OF THE BLOCK ABOVE, NOT AN EXTENSION OF IT -- and the reason is the row title
_scratchpad/w576/gate_sh_rounding.NEW.sh:751:#  three lines up.  That check is named "sh4_pcic: no offset kills the host".  Folding
_scratchpad/w576/gate_sh_rounding.NEW.sh:752:#  #447's rows under it would make the gate's own check name UNTRUE, because these are four
_scratchpad/w576/gate_sh_rounding.NEW.sh:753:#  DIFFERENT sites (TCR, DMATCR, ICR, RCR1) reached by VALUE rather than by offset.  A check
_scratchpad/w576/gate_sh_rounding.NEW.sh:754:#  whose title does not describe what it checks is the same defect as a green row that means
_scratchpad/w576/gate_sh_rounding.NEW.sh:755:#  nothing, and it is harder to see because the number still moves.
_scratchpad/w576/gate_sh_rounding.NEW.sh:756:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:757:#  WHAT #447 FIXED: four guards in DEVICE_ACCESS(sh4) called exit(1) on a value the model
_scratchpad/w576/gate_sh_rounding.NEW.sh:758:#  does not implement.  A guest STORE of an unmodelled bit ended the host process.  They now
_scratchpad/w576/gate_sh_rounding.NEW.sh:759:#  DIAGNOSE AND SURVIVE, latched per (class, INSTANCE, offending BIT) -- three parts, each
_scratchpad/w576/gate_sh_rounding.NEW.sh:760:#  earned: per-class alone reports timer 0 and silences timers 1-2 and channels 1-7, and
_scratchpad/w576/gate_sh_rounding.NEW.sh:761:#  per-(class,instance) still swallows the second feature at one register, because RCR1's
_scratchpad/w576/gate_sh_rounding.NEW.sh:762:#  single guard covers TWO features and TCR's covers SIX.
_scratchpad/w576/gate_sh_rounding.NEW.sh:763:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:764:#  THE STORE POSITION DIFFERS THREE WAYS OUT OF FOUR, which is why "move the store below the
_scratchpad/w576/gate_sh_rounding.NEW.sh:765:#  guard" is not a file-wide rule: DMATCR's store is already downstream, ICR has no store on
_scratchpad/w576/gate_sh_rounding.NEW.sh:766:#  any path, RCR1's was upstream (the #443 shape), and TCR is a third case -- `timer_hz` is
_scratchpad/w576/gate_sh_rounding.NEW.sh:767:#  set from `idata & 3` BEFORE the guard, so a naive fix would install pclock/4 for a write
_scratchpad/w576/gate_sh_rounding.NEW.sh:768:#  asking for a clock source the model cannot provide, turning a loud fault into a silent one.
_scratchpad/w576/gate_sh_rounding.NEW.sh:786:# ------------------------------------------------------------------ #448 CHCR decoders
_scratchpad/w576/gate_sh_rounding.NEW.sh:787:#  A THIRD SIBLING, and the same reasoning that kept #447 out of #443's block keeps this
_scratchpad/w576/gate_sh_rounding.NEW.sh:788:#  out of both: the checks above are named "no offset kills the host" and "no guest VALUE
_scratchpad/w576/gate_sh_rounding.NEW.sh:789:#  kills the host", and these four sites are reached by neither -- they are CHCR FIELD
_scratchpad/w576/gate_sh_rounding.NEW.sh:790:#  ENCODINGS decoded inside sh4_dmac_transfer(), on the far side of a call.
_scratchpad/w576/gate_sh_rounding.NEW.sh:791:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:792:#  *** THIS WAS EASIER TO REACH THAN ANYTHING #447 REPAIRED. ***  Only `case 0x200:`
_scratchpad/w576/gate_sh_rounding.NEW.sh:793:#  survives the CHCR_RS switch, so fifteen of the sixteen resource-select encodings ended
_scratchpad/w576/gate_sh_rounding.NEW.sh:794:#  the host -- and a wholly legal configuration (4-byte transfers, both addresses
_scratchpad/w576/gate_sh_rounding.NEW.sh:795:#  incrementing) died on its resource-select alone.
_scratchpad/w576/gate_sh_rounding.NEW.sh:796:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:797:#  THE ACCEPT-SIDE ROWS (A1-A4) ARE THE DE-ESCALATION CLAUSE, and this is the first round
_scratchpad/w576/gate_sh_rounding.NEW.sh:798:#  to owe them: a fatal->survive fix DELETES the accidental tripwire that made guard growth
_scratchpad/w576/gate_sh_rounding.NEW.sh:799:#  self-announcing, so the detector must pin that legal encodings are still ACCEPTED, not
_scratchpad/w576/gate_sh_rounding.NEW.sh:800:#  merely that illegal ones are declined.  #447 shipped without those rows and a review
_scratchpad/w576/gate_sh_rounding.NEW.sh:801:#  seat then found a ONE-IDENTIFIER escape scoring full marks.
_scratchpad/w576/gate_sh_rounding.NEW.sh:829:# ------------------------------------------------------------------ #449 RTCSR refresh
_scratchpad/w576/gate_sh_rounding.NEW.sh:830:#  A FOURTH SIBLING, and it is the first in this file whose defect is NOT at a store.
_scratchpad/w576/gate_sh_rounding.NEW.sh:831:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:832:#  *** THE GUEST WRITE LANDS AND RETURNS NORMALLY.  THE HOST DIED ~9 ms LATER, INSIDE
_scratchpad/w576/gate_sh_rounding.NEW.sh:833:#  sh4_timer_tick() AT 110 Hz. ***  Every other probe wired above -- #443's, #447's, #448's
_scratchpad/w576/gate_sh_rounding.NEW.sh:834:#  -- observes the STORE SITE: issue one store, ask whether the host survived that
_scratchpad/w576/gate_sh_rounding.NEW.sh:835:#  instruction.  All three are blind to this by construction, and the witness keeps a row
_scratchpad/w576/gate_sh_rounding.NEW.sh:836:#  (S0) recording exactly that: the store alone leaves the host alive.
_scratchpad/w576/gate_sh_rounding.NEW.sh:837:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:838:#  F1 IS THE ROW THAT NEEDED THE NEW SHAPE.  The diagnostic comes from a callback that
_scratchpad/w576/gate_sh_rounding.NEW.sh:839:#  fires many times during one free run, and fatal() has no quiet_mode early-out, so an
_scratchpad/w576/gate_sh_rounding.NEW.sh:840:#  unlatched complaint is a flood -q cannot stop.  F1 spins long enough for many ticks and
_scratchpad/w576/gate_sh_rounding.NEW.sh:841:#  requires EXACTLY ONE line.  No store-site row can measure that: none lets the callback
_scratchpad/w576/gate_sh_rounding.NEW.sh:842:#  run twice.
_scratchpad/w576/gate_sh_rounding.NEW.sh:843:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:844:#  The TMU half is covered OFFLINE instead, in gate 2: regress/diff_sh4_tmu.c's
_scratchpad/w576/gate_sh_rounding.NEW.sh:845:#  `rtcsr_falls_through` row sets CMIE and requires the timer to keep counting, which is
_scratchpad/w576/gate_sh_rounding.NEW.sh:846:#  what catches an early `return` -- the obvious fix, and the wrong one.  Measured there:
_scratchpad/w576/gate_sh_rounding.NEW.sh:847:#  clean 0 failures, early-return 1 failure.  It costs microseconds and needs no pty.
_scratchpad/w576/gate_sh_rounding.NEW.sh:866:#  #451: the two command-byte validators in sh4_sci_cmd().  This is the first SH-4 site
_scratchpad/w576/gate_sh_rounding.NEW.sh:867:#  in this tree that a single store CANNOT reach -- the guest must clock a byte in through
_scratchpad/w576/gate_sh_rounding.NEW.sh:868:#  SHREG_SCSPTR, seventeen mov.b stores, and only the eighth rising edge calls the
_scratchpad/w576/gate_sh_rounding.NEW.sh:869:#  function.  Every SH-4 probe before it observes a store site, so all of them were blind.
_scratchpad/w576/gate_sh_rounding.NEW.sh:870:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:871:#  *** THE ORACLE IS THE TRANSFER, NOT SURVIVAL, and that is the whole design. ***  This
_scratchpad/w576/gate_sh_rounding.NEW.sh:872:#  fix deleted two exit(1) calls, and with them the accidental tripwire that made a
_scratchpad/w576/gate_sh_rounding.NEW.sh:873:#  missing `return` or a grown guard LOUD.  After it, both are silent: a missing `return`
_scratchpad/w576/gate_sh_rounding.NEW.sh:874:#  performs an invented transfer against the RS5C313 and says nothing.  So the rows watch
_scratchpad/w576/gate_sh_rounding.NEW.sh:875:#  dev_sh4.c:664/:685's `[ SCI: read|write addr=.. data=.. ]` lines, with a legal pair
_scratchpad/w576/gate_sh_rounding.NEW.sh:876:#  (0xa5 sets address 5, 0x9c writes data c) proving the oracle is LIVE -- otherwise every
_scratchpad/w576/gate_sh_rounding.NEW.sh:877:#  "no transfer occurred" row would pass for the wrong reason rather than the right one.
_scratchpad/w576/gate_sh_rounding.NEW.sh:878:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:879:#  MEASURED KILL TABLE, 14 mutants, no survivors.  Two carry a lesson worth the line:
_scratchpad/w576/gate_sh_rounding.NEW.sh:880:#    *  M2 (site 1 `return` deleted) is invisible to byte 0x00 -- 0x00 also fails site 2,
_scratchpad/w576/gate_sh_rounding.NEW.sh:881:#       which catches what site 1 dropped.  Row R1 uses 0x10 instead: bit 7 clear but a
_scratchpad/w576/gate_sh_rounding.NEW.sh:882:#       LEGAL transfer field, so the fall-through reaches the write arm and really writes.
_scratchpad/w576/gate_sh_rounding.NEW.sh:883:#       Three pass-1 seats converged on this independently.
_scratchpad/w576/gate_sh_rounding.NEW.sh:884:#    *  M9 (the `sci_bits_outputed = 0` moved into the callee below the returns) was first
_scratchpad/w576/gate_sh_rounding.NEW.sh:885:#       built at the TOP of the callee, where it runs on every call -- an EQUIVALENT
_scratchpad/w576/gate_sh_rounding.NEW.sh:886:#       mutant that "survived".  Rebuilt as described, it jams the shifter and row J
_scratchpad/w576/gate_sh_rounding.NEW.sh:887:#       reddens.  A mutant that does not model the defect measures the detector's silence,
_scratchpad/w576/gate_sh_rounding.NEW.sh:888:#       not its blindness.
_scratchpad/w576/gate_sh_rounding.NEW.sh:902:#  #452: the two TLB data-array-2 sites.  Both `da1` devices are registered for SIXTEEN
_scratchpad/w576/gate_sh_rounding.NEW.sh:903:#  megabytes and each handler ended the host on `relative_addr & 0x800000` -- EIGHT
_scratchpad/w576/gate_sh_rounding.NEW.sh:904:#  megabytes, the upper half of a range the device itself claimed.  One guest load or
_scratchpad/w576/gate_sh_rounding.NEW.sh:905:#  store was enough, and the guard sat ABOVE the writeflag test so direction did not
_scratchpad/w576/gate_sh_rounding.NEW.sh:906:#  matter.  The discriminator is a single ADDRESS BIT, sharper than any earlier SH-4
_scratchpad/w576/gate_sh_rounding.NEW.sh:907:#  round here: the same device at the same width answers at 0xf3000000 and died at
_scratchpad/w576/gate_sh_rounding.NEW.sh:908:#  0xf3800000.
_scratchpad/w576/gate_sh_rounding.NEW.sh:909:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:910:#  MEASURED KILL TABLE, 10 mutants: 9 die, 1 is EQUIVALENT.  Two are worth the lines:
_scratchpad/w576/gate_sh_rounding.NEW.sh:911:#    *  M1 -- dropping the declined-read's memory_writemax64() -- was predicted by THREE
_scratchpad/w576/gate_sh_rounding.NEW.sh:912:#       seats to hand the guest stale host bytes.  It does not, and the reason is in this
_scratchpad/w576/gate_sh_rounding.NEW.sh:913:#       tree: memory_rw.c:484-491, correction #95, already zeroes the caller's buffer
_scratchpad/w576/gate_sh_rounding.NEW.sh:914:#       before every device read.  Measured in five contexts, identical on both builds.
_scratchpad/w576/gate_sh_rounding.NEW.sh:915:#       It carries NO row, because a row that cannot fail is decoration.
_scratchpad/w576/gate_sh_rounding.NEW.sh:916:#    *  G1 -- the guard grown from 0x800000 to 0xc00000, with its latch operand widened
_scratchpad/w576/gate_sh_rounding.NEW.sh:917:#       jointly -- reddens A3 and NOTHING ELSE.  A1/A2 sit at offset 0 and cannot see it;
_scratchpad/w576/gate_sh_rounding.NEW.sh:918:#       A3 sits at +0x400000, bit 22 set, which is exactly the range such a growth starts
_scratchpad/w576/gate_sh_rounding.NEW.sh:919:#       refusing.  That is the de-escalation clause discharged by measured kill.
_scratchpad/w576/gate_sh_rounding.NEW.sh:933:#  sh4_tlbda2_witness.py is DELIBERATELY NOT RUN HERE -- same rule as the four below it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:934:#  7/7 pre-fix and 4/7 after, the three differences being exactly the three kill rows
_scratchpad/w576/gate_sh_rounding.NEW.sh:935:#  (an ITLB load, a UTLB load, and an ITLB store).  Its two controls assert EQUALITY with
_scratchpad/w576/gate_sh_rounding.NEW.sh:936:#  the value each device's own mask folds 0xffffffff to -- 0x1ffffdfa and 0x1ffffdff,
_scratchpad/w576/gate_sh_rounding.NEW.sh:937:#  which DIFFER -- after a panel seat pointed out that the first draft asserted only
_scratchpad/w576/gate_sh_rounding.NEW.sh:938:#  INEQUALITY against three wrong values, which any fourth wrong value would have passed.
_scratchpad/w576/gate_sh_rounding.NEW.sh:940:#  sh4_sci_witness.py is DELIBERATELY NOT RUN HERE -- same rule as the three below it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:941:#  8/8 pre-fix, 5/8 after, the three differences being exactly the three bytes that used
_scratchpad/w576/gate_sh_rounding.NEW.sh:942:#  to end the host (0x00, 0x80 and 0xb0).  0xb0 was NOT in the first draft of that witness:
_scratchpad/w576/gate_sh_rounding.NEW.sh:943:#  a pass-1 seat pointed out that `(cmd & 0x30)` reaches the else arm for BOTH 0x00 and
_scratchpad/w576/gate_sh_rounding.NEW.sh:944:#  0x30, so the second site had two reachable faults and only one of them was measured.
_scratchpad/w576/gate_sh_rounding.NEW.sh:946:#  sh4_rtcsr_witness.py is DELIBERATELY NOT RUN HERE: 8/8 pre-fix, 6/8 after, the two
_scratchpad/w576/gate_sh_rounding.NEW.sh:947:#  differences being the two kill rows.  A gated witness reddens the day its fix lands.
_scratchpad/w576/gate_sh_rounding.NEW.sh:949:#  sh4_chcr_witness.py is DELIBERATELY NOT RUN HERE, for the same reason as #447's:
_scratchpad/w576/gate_sh_rounding.NEW.sh:950:#  it asserts the PRE-FIX symptom (13/13 pre-fix, 8/13 post-fix, the five differences
_scratchpad/w576/gate_sh_rounding.NEW.sh:951:#  being exactly the five sites repaired) and would go red the day its fix landed.
_scratchpad/w576/gate_sh_rounding.NEW.sh:953:#  sh4_val_witness.py is DELIBERATELY NOT RUN HERE.  It asserts the PRE-FIX symptom -- that
_scratchpad/w576/gate_sh_rounding.NEW.sh:954:#  the host process dies -- so it correctly goes RED the moment the fix is present.  Wiring
_scratchpad/w576/gate_sh_rounding.NEW.sh:955:#  a witness into a gate manufactures a phantom regression on the day the fix lands, and
_scratchpad/w576/gate_sh_rounding.NEW.sh:956:#  check_probe_wiring.py treats a gated witness as a HARD failure for exactly that reason.
_scratchpad/w576/gate_sh_rounding.NEW.sh:959:#  ------------------------------------------------------------------ wdcflood
_scratchpad/w576/gate_sh_rounding.NEW.sh:960:#  Six unlatched fatal() in dev_wdc.c, each guest-drivable without bound.  Measured
_scratchpad/w576/gate_sh_rounding.NEW.sh:961:#  pre-fix: 20 stores -> 20 host lines with AND without -q, and the OVER-READ site at
_scratchpad/w576/gate_sh_rounding.NEW.sh:962:#  500 iterations produced 2000 lines / 158,449 bytes.  Artifacts live at
_scratchpad/w576/gate_sh_rounding.NEW.sh:963:#  regress/artifacts/wdcflood/witness_20260825/{fr_no__q,fr_with__q,n3}.out.
_scratchpad/w576/gate_sh_rounding.NEW.sh:964:#  (An earlier wording said "the read path", which points at the non-8-bit READ guard;
_scratchpad/w576/gate_sh_rounding.NEW.sh:965:#  n3.out is 2000x "reading too much", i.e. the ring over-read.  Same numbers, wrong
_scratchpad/w576/gate_sh_rounding.NEW.sh:966:#  site named.)  fatal() has no early-out (core/debugmsg.c:384-390 against debug()'s
_scratchpad/w576/gate_sh_rounding.NEW.sh:967:#  at :375), so -q cannot silence it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:968:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:969:#  THE DENOMINATOR IS 26 AND TWELVE OF THOSE ROWS EXIST BECAUSE A PANEL OR A KILL TABLE
_scratchpad/w576/gate_sh_rounding.NEW.sh:970:#  FOUND THE FIRST FOURTEEN INSUFFICIENT.  Every one of the twelve closes a MEASURED or
_scratchpad/w576/gate_sh_rounding.NEW.sh:971:#  PREDICTED escape, and each is the only row that sees its own:
_scratchpad/w576/gate_sh_rounding.NEW.sh:972:#    overrun x2  the :145 reinstatement -- an L2 FLOOR BREACH until this row existed
_scratchpad/w576/gate_sh_rounding.NEW.sh:973:#    interleave  a latch reset on a NORMAL operation, invisible to back-to-back rows
_scratchpad/w576/gate_sh_rounding.NEW.sh:974:#    w16 reset   a latch operand a guest can CLEAR between fires
_scratchpad/w576/gate_sh_rounding.NEW.sh:975:#    r16 reset   the same at the READ site -- sibling parity, and it was missing
_scratchpad/w576/gate_sh_rounding.NEW.sh:976:#    fire3       a period-N latch; a two-fire oracle cannot see period 2
_scratchpad/w576/gate_sh_rounding.NEW.sh:977:#    w32/r32     the width rows probed 16-bit only
_scratchpad/w576/gate_sh_rounding.NEW.sh:978:#    r16/w16 value  BOTH fires, because a `return` after a latched fatal() corrupts
_scratchpad/w576/gate_sh_rounding.NEW.sh:979:#                   the FIRST access and an earlier one-value form was VACUOUS
_scratchpad/w576/gate_sh_rounding.NEW.sh:980:#    wr indep    TWO SITES IN ONE SESSION -- the only row that can see flag pairing
_scratchpad/w576/gate_sh_rounding.NEW.sh:981:#    w mixed     a width-KEYED latch: alternating mov.w/mov.l floods forever, and no
_scratchpad/w576/gate_sh_rounding.NEW.sh:982:#    r mixed     single-width row can see it.  Both came from the capped ask-again,
_scratchpad/w576/gate_sh_rounding.NEW.sh:983:#                fired against a table that was already clean at 24 rows.
_scratchpad/w576/gate_sh_rounding.NEW.sh:984:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:985:#  -u IS LOAD-BEARING, for the reason the gdrom section above records: with stdout
_scratchpad/w576/gate_sh_rounding.NEW.sh:986:#  redirected to a file it is block buffered, and a killed run then loses every row and
_scratchpad/w576/gate_sh_rounding.NEW.sh:987:#  looks like a run that produced nothing.
_scratchpad/w576/gate_sh_rounding.NEW.sh:988:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:989:#  THE DISK IS REQUIRED AND ITS ABSENCE IS A SKIP, NEVER A PASS.  wdc_command()
_scratchpad/w576/gate_sh_rounding.NEW.sh:990:#  early-returns before the opcode switch when no IDE image exists (grep
_scratchpad/w576/gate_sh_rounding.NEW.sh:991:#  `but no disk image`), so without it the :583 rows cannot fire at all and would read
_scratchpad/w576/gate_sh_rounding.NEW.sh:992:#  as green-on-nothing.  An earlier form cited :461-468, which is wdc_status() and was
_scratchpad/w576/gate_sh_rounding.NEW.sh:993:#  wrong even before the fix moved every line in this file.
_scratchpad/w576/gate_sh_rounding.NEW.sh:994:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:995:#  THAT EARLY RETURN'S OWN debug() REPEATS ONCE PER FAILED COMMAND and is NOT latched
_scratchpad/w576/gate_sh_rounding.NEW.sh:996:#  here.  It is a DIFFERENT CHANNEL, and the reason is stronger than -q: debug()
_scratchpad/w576/gate_sh_rounding.NEW.sh:997:#  computes v = verbose - (emul_executing ? 1 : 0) + (stepping ? 1 : 0) and returns at
_scratchpad/w576/gate_sh_rounding.NEW.sh:998:#  core/debugmsg.c:375 when v < 0.  FREE-RUNNING AT DEFAULT VERBOSITY THAT IS v == -1,
_scratchpad/w576/gate_sh_rounding.NEW.sh:999:#  so the arm emits NOTHING AT ALL; it becomes one line per command only under -v or
_scratchpad/w576/gate_sh_rounding.NEW.sh:1000:#  under stepping.  fatal() has no such early-out.  Outside this round's scope rather
_scratchpad/w576/gate_sh_rounding.NEW.sh:1001:#  than a missed site; it rides with `floodclass`.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1002:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1003:#  (An earlier wording said FLOODS IDENTICALLY, full stop -- an overstatement, and the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1004:#  qualifier was not missing from the evidence but from the summary: the original
_scratchpad/w576/gate_sh_rounding.NEW.sh:1005:#  filing already read "invisible free-running at verbosity 0".  Caught by the pass-2
_scratchpad/w576/gate_sh_rounding.NEW.sh:1006:#  codex seat re-deriving from debugmsg.c what our own record already said.)
_scratchpad/w576/gate_sh_rounding.NEW.sh:1007:#  ---------------------------------------------------------------- #465 gdrom PIO
_scratchpad/w576/gate_sh_rounding.NEW.sh:1008:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1009:#  A DETECTOR NO GATE RUNS IS NOT A DETECTOR.  The gdrompionull probe shipped under
_scratchpad/w576/gate_sh_rounding.NEW.sh:1010:#  regress/artifacts/ and NOTHING IN THE BATTERY EXECUTED IT -- found by grepping the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1011:#  gates for the probe's own name before writing the round record, which is the check
_scratchpad/w576/gate_sh_rounding.NEW.sh:1012:#  that should run on every "we shipped a detector" claim.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1013:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1014:#  What it pins, and the evidence is four preserved logs beside the probe:
_scratchpad/w576/gate_sh_rounding.NEW.sh:1015:#    prefix_HEAD_13of13.raw   pre-fix, OLD pin   13/13  the defect reproduces
_scratchpad/w576/gate_sh_rounding.NEW.sh:1016:#    repin_HEAD_RED.raw       pre-fix, NEW pin   12/13  the re-pin measured RED first
_scratchpad/w576/gate_sh_rounding.NEW.sh:1017:#    postfix_465.raw          post-fix           11/13  crash gone, witness rows stale
_scratchpad/w576/gate_sh_rounding.NEW.sh:1018:#    postfix_465_final.raw    post-fix           13/13  detector complete
_scratchpad/w576/gate_sh_rounding.NEW.sh:1019:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1020:#  The two trigger rows were WITNESS rows pinned to "sig11" and are now DETECTOR rows
_scratchpad/w576/gate_sh_rounding.NEW.sh:1021:#  pinned to "exit0".  That inversion is licensed by the preserved pre-fix logs -- same
_scratchpad/w576/gate_sh_rounding.NEW.sh:1022:#  script, same row names, opposite colour -- and not by the new binary.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1023:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1024:#  `staged quiet` was RE-PINNED from "0 of 8" to "1 of 8" in the mandated order: the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1025:#  oracle changed FIRST, the committed build measured RED under it, and only then did
_scratchpad/w576/gate_sh_rounding.NEW.sh:1026:#  the code change.  The fix IS louder by one line, because the repaired state routes
_scratchpad/w576/gate_sh_rounding.NEW.sh:1027:#  into #460's once-latched overread decline.  The round's earlier prose claimed it
_scratchpad/w576/gate_sh_rounding.NEW.sh:1028:#  "invents no new behaviour"; that was false and is corrected in the probe's
_scratchpad/w576/gate_sh_rounding.NEW.sh:1029:#  `staged quiet` row comment -- NOT its header, which is where this line first said
_scratchpad/w576/gate_sh_rounding.NEW.sh:1030:#  it was.  A pass-2 seat caught the mislocation: a pointer naming the wrong place is
_scratchpad/w576/gate_sh_rounding.NEW.sh:1031:#  a small wrong record, but it is the kind a future reader gives up on.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1084:#  ------------------------------------------------------------------ #489 gdrom TOC length
_scratchpad/w576/gate_sh_rounding.NEW.sh:1085:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1086:#  The `case 0x14` TOC length guard used to end the host on a GUEST-SUPPLIED cnt.  The
_scratchpad/w576/gate_sh_rounding.NEW.sh:1087:#  WITNESS for it is deliberately NOT run here -- it pins the PRE-fix symptom, so gating it
_scratchpad/w576/gate_sh_rounding.NEW.sh:1088:#  would manufacture a regression the day the fix landed.  It lives ungated at
_scratchpad/w576/gate_sh_rounding.NEW.sh:1089:#  artifacts/gdromexitsix/gdrom_toclen_witness.py and is registered CLASS_WITNESS.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1090:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1091:#  The row worth knowing about here is `bad cond`.  A survive-only row set is VACUOUS at this
_scratchpad/w576/gate_sh_rounding.NEW.sh:1092:#  site: weakening the guard from `!= 408` to `> 408` lets cnt=407 reach alloc_data(407)
_scratchpad/w576/gate_sh_rounding.NEW.sh:1093:#  while the TOC writer indexes byte 407, and that one-byte overflow need not fault -- so
_scratchpad/w576/gate_sh_rounding.NEW.sh:1094:#  "did the host survive?" scores the mutant GREEN with the defect back.  `bad cond` reads
_scratchpad/w576/gate_sh_rounding.NEW.sh:1095:#  COND_DATA_AVAIL instead: declined leaves it CLEAR (0xa0), the mutant SETS it (0xa8).
_scratchpad/w576/gate_sh_rounding.NEW.sh:1148:#  ---------------------------------------------------------------- #490 gdromdecline
_scratchpad/w576/gate_sh_rounding.NEW.sh:1149:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1150:#  The two de-fatalised sites in dev_dreamcast_gdrom.c's handle_command(): the case 0x30
_scratchpad/w576/gate_sh_rounding.NEW.sh:1151:#  data-format guard and the default: arm.  Both were fatal() + exit(1) reached by an
_scratchpad/w576/gate_sh_rounding.NEW.sh:1152:#  ordinary guest store.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1153:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1154:#  ITS OWN SECTION AND ITS OWN DENOMINATOR, deliberately.  Bolting these rows onto the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1155:#  58-row gdrom_default probe would edit two coupled places -- a literal and a 58-name list
_scratchpad/w576/gate_sh_rounding.NEW.sh:1156:#  that must agree -- for every row added.  #489 set that precedent and this follows it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1157:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1158:#  THE ROWS WORTH KNOWING ABOUT HERE ARE `crossbit` AND `latch cond`, because both were
_scratchpad/w576/gate_sh_rounding.NEW.sh:1159:#  MEASURED escaping an earlier plan:
_scratchpad/w576/gate_sh_rounding.NEW.sh:1160:#    * `crossbit` -- d->warned now has NINE writers sharing one field, and SIX of the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1161:#      pre-existing ones are set from inside DEVICE_ACCESS by ordinary guest register reads.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1162:#      If either new latch bit ALIASES an existing one, a prior TOC decline silences a whole
_scratchpad/w576/gate_sh_rounding.NEW.sh:1163:#      site and the guest gets a mute refusal.  Measured as Ma_toclen / Mb_toclen.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1164:#    * `latch cond` -- moving the `break` INSIDE the latch `if` lets the SECOND identical bad
_scratchpad/w576/gate_sh_rounding.NEW.sh:1165:#      format fall through into sector_nr.  The announce count reads 1 either way, so this
_scratchpad/w576/gate_sh_rounding.NEW.sh:1166:#      row reads a DECLINE channel after the second command instead.  Measured as M_braceA.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1218:#  ---------------------------------------------------------------------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:1219:#  #496 gdromcondlies -- GDROM_UNKNOWN_0x88 and GDROM_COND bad-value declines.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1220:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1221:#  Two guest-reachable host kills de-fatalised, plus -- at GDROM_COND only -- the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1222:#  `d->cond = idata;` store MOVED from above the dispatch into the two accepted arms.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1223:#  That relocation is the half of the fix that is not about exit(): COND_DATA_AVAIL
_scratchpad/w576/gate_sh_rounding.NEW.sh:1224:#  (0x08) is a bit of d->cond and the GDROM_DATA read path is gated on it, so leaving
_scratchpad/w576/gate_sh_rounding.NEW.sh:1225:#  the store where it was would let any declined value forge or revoke data-available.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1226:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1227:#  *** NO **ACCEPT-SIDE** ROW HERE MAY READ SURVIVAL. ***  Post-fix every accepted access
_scratchpad/w576/gate_sh_rounding.NEW.sh:1228:#  exits 0, so a survival oracle at a refusal-EFFECT site answers the same whether or not
_scratchpad/w576/gate_sh_rounding.NEW.sh:1229:#  the guard is right.  The round's WITNESS does use survival -- correctly, it ran BEFORE
_scratchpad/w576/gate_sh_rounding.NEW.sh:1230:#  the fix -- and its accept rows are deliberately NOT carried into this detector.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1231:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1232:#  *** THE BAN WAS WRITTEN WITHOUT THE QUALIFIER AND THAT WAS ITSELF A CLAUSE-(b) FLOOR
_scratchpad/w576/gate_sh_rounding.NEW.sh:1233:#  BREACH.  Corrected 2026-09-06 by the retrospective re-check (batch 8b), against the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1234:#  probe rather than against this comment. ***  The DECLINE rows R1 and R2 read the exit
_scratchpad/w576/gate_sh_rounding.NEW.sh:1235:#  status on purpose -- `row("R2 cond says", ... , "55|exit0", ...)` -- and
_scratchpad/w576/gate_sh_rounding.NEW.sh:1236:#  gdrom_cond_probe.py's own docstring gives the reason at its anchor `R1 and R2 assert
_scratchpad/w576/gate_sh_rounding.NEW.sh:1237:#  announced AND survived`: a presence-only decline row cannot see exit(1) being
_scratchpad/w576/gate_sh_rounding.NEW.sh:1238:#  reinstated, because fatal() PRINTS AND THEN THE PROCESS DIES.  Count 1, byte correct,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1239:#  row green, defect back.  So the rule is: an ACCEPT row may not rest on survival
_scratchpad/w576/gate_sh_rounding.NEW.sh:1240:#  (guarded and unguarded code both survive); a DECLINE row MUST carry it (it is the only
_scratchpad/w576/gate_sh_rounding.NEW.sh:1241:#  channel that distinguishes announce-and-continue from announce-and-die).
_scratchpad/w576/gate_sh_rounding.NEW.sh:1242:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1243:#  `R5 cond keep` is the KEYSTONE and it is ANCHORED: a fresh device has cond == 0, so
_scratchpad/w576/gate_sh_rounding.NEW.sh:1244:#  the naive "write 0x55, read back 0" is satisfied by the correct fix AND by a mutant
_scratchpad/w576/gate_sh_rounding.NEW.sh:1245:#  that zeroes cond on decline.  The row drives an ACCEPTED 0xef first, so the value it
_scratchpad/w576/gate_sh_rounding.NEW.sh:1246:#  requires back is one only the accept arm can have placed there.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1319:#  ---------------------------------------------------------------------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:1320:#  #441 SH4 BSC non-16-bit access -- sh4bcr.  A guest choosing an access WIDTH used to end
_scratchpad/w576/gate_sh_rounding.NEW.sh:1321:#  the host at BCR2/BCR3; the fix services the access and diagnoses it once per site.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1322:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1323:#  WIRED HERE because the probe execs `-E landisk`, which is this gate's machine, and its
_scratchpad/w576/gate_sh_rounding.NEW.sh:1324:#  exemption in check_probe_wiring.py is DELETED in the same edit -- a wired probe that
_scratchpad/w576/gate_sh_rounding.NEW.sh:1325:#  keeps an exemption is a STALE EXEMPTION and the checker reds on it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1326:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1327:#  *** THE PROBE GAINED `SH4_BSC_WIDTH_DONE` IN THIS SAME COMMIT, BEFORE BEING WIRED. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1328:#  It already printed `SH4_BSC_WIDTH_PASS` or `_FAIL`, but those are MUTUALLY EXCLUSIVE, so a
_scratchpad/w576/gate_sh_rounding.NEW.sh:1329:#  gate keyed on either cannot tell A RUN THAT FAILED from A RUN THAT DIED BEFORE PRINTING.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1330:#  The sentinel is unconditional, so completion and outcome are separate questions here --
_scratchpad/w576/gate_sh_rounding.NEW.sh:1331:#  which is what lets the two rows below say different things.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1332:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1333:#  NOTE THE ROW NAMES ARE LONGER THAN THEIR COLUMN.  The probe prints `"  %-4s %-58s"` and
_scratchpad/w576/gate_sh_rounding.NEW.sh:1334:#  several names exceed 58 characters, so those lines carry NO trailing padding.  The anchors
_scratchpad/w576/gate_sh_rounding.NEW.sh:1335:#  below therefore must NOT require trailing whitespace -- `^  ok   <name>` and nothing more.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1336:#  This is the padded-column trap approached from the other side: the usual failure is a name
_scratchpad/w576/gate_sh_rounding.NEW.sh:1337:#  as long as its column making a check unsatisfiable, and here the check is written to be
_scratchpad/w576/gate_sh_rounding.NEW.sh:1338:#  insensitive to it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1444:# ---------------------------------------------------------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:1445:# #525 (wdcaltdigin): the wdc alt-ctrl handler never decoded its offset ON THE
_scratchpad/w576/gate_sh_rounding.NEW.sh:1446:# READ SIDE.  `relative_addr' was tested in exactly ONE place -- inside the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1447:# `else' of `writeflag == MEM_READ' -- so a READ of offset 1, the Drive Address
_scratchpad/w576/gate_sh_rounding.NEW.sh:1448:# register, returned the ALT-STATUS byte: a different register's value, from an
_scratchpad/w576/gate_sh_rounding.NEW.sh:1449:# offset the handler never looked at.  THE SYMMETRIC CELL OF #494, which closed
_scratchpad/w576/gate_sh_rounding.NEW.sh:1450:# the WRITE half of that same `if' and left this one open.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1451:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1452:# ATA-2 X3T10/0948D Note 1 recommends a device NOT RESPOND to a read here and,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1453:# if it does, NOT DRIVE DD7.  `odata = 0' leaves bit 7 clear, so the returned
_scratchpad/w576/gate_sh_rounding.NEW.sh:1454:# value satisfies the one constraint the standard places on a device that
_scratchpad/w576/gate_sh_rounding.NEW.sh:1455:# answers; WHICH non-DD7 value is emulator policy, and the comment says so.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1456:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1457:# THE STATUS BYTE BEING NONZERO IS LOAD-BEARING, NOT INCIDENTAL.  The mutant
_scratchpad/w576/gate_sh_rounding.NEW.sh:1458:# that keeps the offset guard and deletes `odata = 0' returns the status byte S;
_scratchpad/w576/gate_sh_rounding.NEW.sh:1459:# if S were 0 the fixed and broken builds would return the same byte and the row
_scratchpad/w576/gate_sh_rounding.NEW.sh:1460:# would be vacuous.  d->error = 1 at init gives S = 0x51, armed 0x58.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1461:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1462:# Measured in regress/artifacts/wdcaltdigin/killtable_20260911/: HEAD 14/16,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1463:# fix 16/16, M_REINSTATE = HEAD, M_NULL_MEDIUM fails a DIFFERENT pair (the two
_scratchpad/w576/gate_sh_rounding.NEW.sh:1464:# ACCEPT rows) -- all four legs score 14/16, so the discrimination lives in the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1465:# ROW IDENTITY and not the score.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1466:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1467:# *** THIS BLOCK SAID "Clause (d) is N/A-WITH-REASON ... the enumeration is EMPTY".
_scratchpad/w576/gate_sh_rounding.NEW.sh:1468:# BOTH HALVES WERE WRONG, AND THE COMMIT THAT CARRIED THE SENTENCE REFUTED IT. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1469:#   (1) The body reading nothing does not empty the floor: DEPENDS-ON crosses the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1470:#       guard's predicates with the state the REPAIR PATH reads, and `odata' is
_scratchpad/w576/gate_sh_rounding.NEW.sh:1471:#       composed from four independently settable sources (image present, DRQ
_scratchpad/w576/gate_sh_rounding.NEW.sh:1472:#       sources, d->error).  (2) "`!= 0' admits no weakening" answers only the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1473:#       OPERAND-weakening form.  The canonical clause-(d) shape is an ADDED
_scratchpad/w576/gate_sh_rounding.NEW.sh:1474:#       CONJUNCT -- `if (odata & WDCS_DRDY)' -- which this very round built and
_scratchpad/w576/gate_sh_rounding.NEW.sh:1475:#       scored 18/19, forty lines below the sentence that declared it impossible.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1476:#   Found by the ninth seat, which then BUILT `&& (odata & (WDCS_DRDY|WDCS_DRQ))'
_scratchpad/w576/gate_sh_rounding.NEW.sh:1477:#   and scored it 19/19 -- a total escape the per-bit audit could not see, because
_scratchpad/w576/gate_sh_rounding.NEW.sh:1478:#   the predicate is a DISJUNCTION whose negation held in no row.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1479:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1480:# THE ENUMERATION IS NOT EMPTY; IT IS FIFTEEN MASKS AND IT IS CLOSED.  Every
_scratchpad/w576/gate_sh_rounding.NEW.sh:1481:# `if (odata & X)' over the four settable status bits was derived against the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1482:# five MEASURED CORE statuses {0x51 0x58 0x08 0x01 0x50}: 12 die, 3 survive and
_scratchpad/w576/gate_sh_rounding.NEW.sh:1483:# all 3 are EQUIVALENT (they differ only at 0x00, where leak == decline, or at
_scratchpad/w576/gate_sh_rounding.NEW.sh:1484:# DSC-without-DRDY, which status_byte() cannot produce).  The derivation and the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1485:# measured legs: regress/artifacts/wdcaltdigin/killtable_20260912_closure/.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1531:# ---------------------------------------------------------------------------
_scratchpad/w576/gate_sh_rounding.NEW.sh:1532:# #572 (wdclbaaddr): the wdc SDH taskfile decoded the ATA LBA flag from BIT 5
_scratchpad/w576/gate_sh_rounding.NEW.sh:1533:# (0x20) instead of BIT 6 (0x40 = WDSD_LBA), and the LBA28 offset formula was
_scratchpad/w576/gate_sh_rounding.NEW.sh:1534:# `#if 0'd out at both wdc__read and wdc__write, so an LBA-mode request was served
_scratchpad/w576/gate_sh_rounding.NEW.sh:1535:# from the CHS reading of the same taskfile bytes.  The fix decodes lba from bit 6,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1536:# keeps the SDH read-back byte-exact through the renamed reserved field sdh_resv,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1537:# and enables the 64-bit LBA28 arm at BOTH sites.  WIRED IN THE SAME COMMIT AS THE
_scratchpad/w576/gate_sh_rounding.NEW.sh:1538:# PROBE, so it cannot ship unwired and let its pin drift red between commits.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1539:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1540:# rung 3 on UNMODIFIED `evbmips -e malta`: real MIPS PIO through the committed
_scratchpad/w576/gate_sh_rounding.NEW.sh:1541:# piix4_ide path, device-signature tags (word0,word1) = (n, ~n) that no RAM cell
_scratchpad/w576/gate_sh_rounding.NEW.sh:1542:# holds.  Pre-fix witness: regress/artifacts/wdclbaaddr/witness_20261024/ (base leg
_scratchpad/w576/gate_sh_rounding.NEW.sh:1543:# 19/19 vs HEAD, the five lba* rows RED vs the FIX column).  Kill table and the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1544:# two-leg / GATE / dead-run measurements: regress/artifacts/wdclbaaddr/detector_20261024/.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1583:#  *** A SOURCE GREP, BECAUSE A STEP-BASED PROBE CANNOT SEE CHANNEL SEMANTICS. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1584:#  `fatal(` -> `debug(` at any of the six sites scores a CLEAN SWEEP against every row
_scratchpad/w576/gate_sh_rounding.NEW.sh:1585:#  above: they all single-step, and debug() always prints under stepping (its early-out
_scratchpad/w576/gate_sh_rounding.NEW.sh:1586:#  at core/debugmsg.c:375 fires on `v < 0`, which free-running at verbose 0 gives and
_scratchpad/w576/gate_sh_rounding.NEW.sh:1587:#  stepping does not).  A production guest would get SILENCE while the detector stayed
_scratchpad/w576/gate_sh_rounding.NEW.sh:1588:#  green -- quietly reversing this fork's own warrant for keeping fatal() (dev_asc.c:248-257:
_scratchpad/w576/gate_sh_rounding.NEW.sh:1589:#  under -q verbosity settles at VERBOSITY_ERROR, so a WARNING-level debugmsg is invisible
_scratchpad/w576/gate_sh_rounding.NEW.sh:1590:#  to the boot-log hygiene grep and an ERROR-level one trips #261's break-on-ERROR).
_scratchpad/w576/gate_sh_rounding.NEW.sh:1591:#  Named by a file-reading seat on the pass-2 panel.  Textual, cheap, and the only guard
_scratchpad/w576/gate_sh_rounding.NEW.sh:1592:#  that exists for this class.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1593:#  [#556, 2026-10-02 -- a records correction; the text above is kept as it was written] fatal( -> debug( downgrades
_scratchpad/w576/gate_sh_rounding.NEW.sh:1594:#  are blind under stepping; overrun x2 free-runs, but stepped rows cannot distinguish debug() from fatal().
_scratchpad/w576/gate_sh_rounding.NEW.sh:1595:#  (hgateshrounding:F15: regress/artifacts/astraretro_harness_20260926/HARNESS_DISPOSITIONS.md)
_scratchpad/w576/gate_sh_rounding.NEW.sh:1596:#  *** PIN ON THE OPENING STRING LITERAL, AND THE REASON IS A NEAR MISS WORTH RECORDING. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1597:#  A first draft pinned `grep -c 'fatal('` at 12.  That counts COMMENT lines mentioning
_scratchpad/w576/gate_sh_rounding.NEW.sh:1598:#  fatal() and gives 15 -- an UNSATISFIABLE check, red forever.  Narrowing to
_scratchpad/w576/gate_sh_rounding.NEW.sh:1599:#  `^[[:space:]]+fatal\(` gives 12 and looks correct -- but TWO of those matches are
_scratchpad/w576/gate_sh_rounding.NEW.sh:1600:#  comment CONTINUATION lines that happen to start with whitespace then "fatal()".  The
_scratchpad/w576/gate_sh_rounding.NEW.sh:1601:#  number would have been right BY COINCIDENCE, and any edit to that comment block would
_scratchpad/w576/gate_sh_rounding.NEW.sh:1602:#  have broken a check nobody would suspect.  `fatal("` cannot match a comment, and 10 is
_scratchpad/w576/gate_sh_rounding.NEW.sh:1603:#  the true census: 4 call sites latched by #337, 6 by this round.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1604:#  *** THIS WAS AN EQUALITY PINNED AT 10 AND IT WAS RED FROM #476 UNTIL 2026-08-27,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1605:#      WHICH IS TWO ROUNDS AND NOBODY SAW IT.  The grep returns 12: #476 added the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1606:#      no-ATAPI DATA read, #478 added the refused-drain announce, and neither round
_scratchpad/w576/gate_sh_rounding.NEW.sh:1607:#      moved the pin.  It hid because this row lives in the WEEKLY battery -- every
_scratchpad/w576/gate_sh_rounding.NEW.sh:1608:#      commit since was green on its own targeted gate while this was failing. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1609:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1610:#  IT IS A FLOOR NOW, AND THAT IS THE PIN THIS CHECK ALWAYS WANTED.  Read the reason
_scratchpad/w576/gate_sh_rounding.NEW.sh:1611:#  above: it exists to catch a DOWNGRADE, `fatal(` -> `debug(`, which REDUCES the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1612:#  count.  An equality catches that -- and also breaks on every legitimate ADDITION,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1613:#  which is what actually happened.  A floor catches the downgrade it was built for and
_scratchpad/w576/gate_sh_rounding.NEW.sh:1614:#  is immune to the growth that defeated it twice.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1615:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1616:#  Negative-controlled both ways on the day it changed: deleting one call site reds it,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1617:#  adding one leaves it green.  The number is a FLOOR, not a census -- do not "correct"
_scratchpad/w576/gate_sh_rounding.NEW.sh:1618:#  it upward when sites are added; that is the failure mode this replaces.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1621:#  *** THAT COMPANION PIN CLAIMED IMMUNITY TO GROWTH AND CALLED THAT "THE WHOLE
_scratchpad/w576/gate_sh_rounding.NEW.sh:1622:#      LESSON".  IT READ 15 AGAINST A PINNED 12.  The claim survived FOUR HOURS. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1623:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1624:#      Its exact words were: "it ENUMERATES SIX NAMED LATCHES in its regex instead
_scratchpad/w576/gate_sh_rounding.NEW.sh:1625:#      of counting an open set.  The device carries ELEVEN warned_ latches today;
_scratchpad/w576/gate_sh_rounding.NEW.sh:1626:#      this pin still reads 12 because growth cannot reach it."
_scratchpad/w576/gate_sh_rounding.NEW.sh:1627:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1628:#      Growth reached it by TWO routes the sentence did not consider, and a third
_scratchpad/w576/gate_sh_rounding.NEW.sh:1629:#      dimension nobody had named at all:
_scratchpad/w576/gate_sh_rounding.NEW.sh:1630:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1631:#        05ec21e  14:00 2026-08-27   the immunity comment lands
_scratchpad/w576/gate_sh_rounding.NEW.sh:1632:#        cf300c0  17:59 2026-08-27   #484 adds a SECOND guarded site re-using
_scratchpad/w576/gate_sh_rounding.NEW.sh:1633:#                                    warned_inbuf_overrun               -> +2
_scratchpad/w576/gate_sh_rounding.NEW.sh:1634:#        d819188  19:29 2026-08-27   #485 adds a COMMENT naming
_scratchpad/w576/gate_sh_rounding.NEW.sh:1635:#                                    warned_unimpl_cmd                  -> +1
_scratchpad/w576/gate_sh_rounding.NEW.sh:1636:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1637:#      MEMBERS was closed, and correctly so -- a new latch NAME cannot reach it.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1638:#      OCCURRENCES was open: grep -c counts LINES, so a new SITE re-using a named
_scratchpad/w576/gate_sh_rounding.NEW.sh:1639:#      latch increments it.  And TEXT-vs-CODE was never considered: a sentence of
_scratchpad/w576/gate_sh_rounding.NEW.sh:1640:#      prose counted as a guard.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1641:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1642:#      The comment's own closing rule was right and was not followed:
_scratchpad/w576/gate_sh_rounding.NEW.sh:1643:#      "Never an equality over a set the codebase is expected to add to."
_scratchpad/w576/gate_sh_rounding.NEW.sh:1644:#      d->warned_X OCCURRENCES are exactly such a set.  The members were named,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1645:#      and then an equality was used over their occurrences anyway.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1646:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1647:#  *** A BARE FLOOR (>= 12) WAS PROPOSED AND MEASURED VACUOUS, so it is not what
_scratchpad/w576/gate_sh_rounding.NEW.sh:1648:#      replaced it.  Deleting ONE latch's two-line guard pair scores 13 and PASSES,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1649:#      restoring the unbounded flood #464 fixed.  Six per-latch ">= 2" rows were
_scratchpad/w576/gate_sh_rounding.NEW.sh:1650:#      also refuted: >= 2 is satisfied by TWO READS AND NO SET. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1651:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1652:#      REPLACED BY TWO EQUALITIES OVER THE NAMED CLOSED SET, per-latch presence,
_scratchpad/w576/gate_sh_rounding.NEW.sh:1653:#      counted over COMMENT-STRIPPED code.  Equality is right for MEMBERS (that set
_scratchpad/w576/gate_sh_rounding.NEW.sh:1654:#      does not grow); what broke was an equality over OCCURRENCES, which this does
_scratchpad/w576/gate_sh_rounding.NEW.sh:1655:#      not count.  Stripping defeats the text-vs-code dimension by CLASS -- an anchor
_scratchpad/w576/gate_sh_rounding.NEW.sh:1656:#      tuned to today's comment survives only by its missing brace.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1657:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1658:#      MEASURED (artifacts/batteryreds/row5_20260829/killtable.out):
_scratchpad/w576/gate_sh_rounding.NEW.sh:1659:#        BASE 6/6 ok | M1 delete guard pair 5/6 KILLED | M2 gut+comment 5/6 KILLED
_scratchpad/w576/gate_sh_rounding.NEW.sh:1660:#        M4 delete SET keep READ 5/6 KILLED | M3 null medium 0/0 KILLED
_scratchpad/w576/gate_sh_rounding.NEW.sh:1661:#        M5 absent file 0/0 and reports WDC_LATCH_FILE=MISSING, so a missing file
_scratchpad/w576/gate_sh_rounding.NEW.sh:1662:#        and a file with no latches do not render the same.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1663:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1664:#      Proposed by the opus5 seat; adopted by the fable5 adjudicator over its own
_scratchpad/w576/gate_sh_rounding.NEW.sh:1665:#      twelve-row alternative, 2026-08-29.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1674:#  *** THE TWO ROWS BELOW CLOSE AN L2 FLOOR BREACH THAT THE FIRST VERSION OF THIS
_scratchpad/w576/gate_sh_rounding.NEW.sh:1675:#  BLOCK SHIPPED, and its kill table was CLEAN while the breach was live. ***
_scratchpad/w576/gate_sh_rounding.NEW.sh:1676:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1677:#  Presence alone (SET/READ above) is blind to a MULTI-SITE latch losing one site.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1678:#  Every mutant in the first table happened to target a single-site latch, so the
_scratchpad/w576/gate_sh_rounding.NEW.sh:1679:#  table ran on a population that structurally could not exhibit the defect:
_scratchpad/w576/gate_sh_rounding.NEW.sh:1680:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1681:#      if (!d->warned_inbuf_overrun) {  ->  if (1) {     at ONE of its TWO sites
_scratchpad/w576/gate_sh_rounding.NEW.sh:1682:#      => set=2 read=1, SET=6 READ=6, gate GREEN, producer flood unbounded again
_scratchpad/w576/gate_sh_rounding.NEW.sh:1683:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1684:#  Floor clause (b) demands failure on reinstatement at EVERY fixed site, so that is
_scratchpad/w576/gate_sh_rounding.NEW.sh:1685:#  L2.  Note the inversion: the OLD pin counted OCCURRENCES, so a second site moved
_scratchpad/w576/gate_sh_rounding.NEW.sh:1686:#  it -- loud and wrong but alive.  Presence-only made losing one of two INVISIBLE.
_scratchpad/w576/gate_sh_rounding.NEW.sh:1687:#
_scratchpad/w576/gate_sh_rounding.NEW.sh:1688:#  BALANCED is RELATIONAL (set_count == read_count per latch), so growth increments
_scratchpad/w576/gate_sh_rounding.NEW.sh:1689:#  both sides and it is growth-invariant BY CONSTRUCTION -- not an equality against a
_scratchpad/w576/gate_sh_rounding.NEW.sh:1690:#  frozen literal needing hand-bumps, which is what broke here in the first place.
