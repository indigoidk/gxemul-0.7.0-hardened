import ast, pathlib, re, subprocess, struct
root = pathlib.Path('.')
table = root/'GXEMUL-SEC/regress/artifacts/shfcnvsdfpul/killtable_20261102'
def vectors(text):
    tree = ast.parse(text)
    keep = []
    for node in tree.body:
        if isinstance(node, ast.Assign) and any(isinstance(t,ast.Name) and t.id in {'DN','PR','NODN','RN','RZ','ST','VECTORS'} for t in node.targets):
            keep.append(node)
        elif isinstance(node, ast.FunctionDef) and node.name == 'instr':
            keep.append(node)
    ns = {}
    exec(compile(ast.Module(body=keep,type_ignores=[]), '<vectors>', 'exec'),ns)
    return ns['VECTORS']
base = subprocess.check_output(['git','-C','GXEMUL-SEC','show','987cb596:regress/sh_rounding_probe.py'],text=True)
asrun = (table/'sh_rounding_probe.ASRUN_1716.py').read_text()
new = (table/'sh_rounding_probe.NEW.py').read_text()
bv,av,nv = map(vectors,[base,asrun,new])
print('VECTORS base/asrun/new:',len(bv),len(av),len(nv))
print('mode sessions:',*[sum(len(v[4]) for v in vs) for vs in [bv,av,nv]])
print('discriminating:',*[sum(len(set(v[4].values()))>1 for v in vs) for vs in [bv,av,nv]])
print('ASRUN inherited vectors identical to base:',av[:len(bv)]==bv)
print('ASRUN/new FCNVSD tuples identical:',av[-8:]==nv[-8:])
print('ASRUN/new whole table differences:',[(a[0],n[0]) for a,n in zip(av,nv) if a"'!=n])
print('"'binary32 0.1 widened:', struct.pack('>d',struct.unpack('>f', bytes.fromhex('3dcccccd'))[0]).hex())
for v in av[-8:]:
    name,extra,seed,word,want=v[:5]
