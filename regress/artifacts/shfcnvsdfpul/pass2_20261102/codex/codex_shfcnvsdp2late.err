#!/usr/bin/env python3
"""mutate576.py <mutant> <path-to-cpu_sh_instr.c>  -- apply ONE #576 kill-table mutant to the FIXED handler (scratch clone only).
Every mutant is a small edit of X(fcnvsd_fpul_drn) as fixed; the find-text must occur exactly once or the script fails (a
MUTANT-TEXT-NOT-FOUND is a FAIL, so each find-text is also a presence pin)."""
import io, sys
m, p = sys.argv[1], sys.argv[2]
s = io.open(p, encoding="utf-8").read()
INTERP = "\tieee_interpret_float_value(cpu->cd.sh.fpul, &op1, IEEE_FMT_S);\n"
STORES = ("\treg(ic->arg[0]) = (uint32_t) (ieee >> 32);\n"
          "\treg(ic->arg[0] + sizeof(uint32_t)) = (uint32_t) ieee;\n")
LINE = "\tcpu->cd.sh.fpul = (int32_t) op1.f;\n"
assert s.count(INTERP) == 1 and s.count(STORES) == 1, (s.count(INTERP), s.count(STORES))
if m == "M_b":      # (b) verbatim reinstatement of the removed store
    s = s.replace(INTERP, INTERP + LINE)
elif m == "M_c":    # (c) identity body: decode and retire, write nothing
    a = s.index(INTERP); b = s.index(STORES) + len(STORES)
    s = s[:a] + "\t(void) op1; (void) ieee;\t/* M_c identity */\n" + s[b:]
elif m == "M_d":    # specials only
    s = s.replace(INTERP, INTERP + "\tif (op1.nan || isinf(op1.f)) cpu->cd.sh.fpul = 0x80000000;\n")
elif m == "M_f":    # only with DN clear (FPSCR bit 18)
    s = s.replace(INTERP, INTERP + "\tif (!(cpu->cd.sh.fpscr & 0x00040000)) cpu->cd.sh.fpul = (int32_t) op1.f;\n")
elif m == "M_g":    # only for a destination other than DR0
    s = s.replace(INTERP, INTERP + "\tif (ic->arg[0] != (size_t)&cpu->cd.sh.fr[0]) cpu->cd.sh.fpul = (int32_t) op1.f;\n")
elif m == "M_gm":   # the MIRROR of M_g: only for destination DR0 -- the cell the `0.1' DR0 row exists for
    s = s.replace(INTERP, INTERP + "\tif (ic->arg[0] == (size_t)&cpu->cd.sh.fr[0]) cpu->cd.sh.fpul = (int32_t) op1.f;\n")
elif m == "M_h":    # the low half of the result lands in FPUL after the store
    s = s.replace(STORES, STORES + "\tcpu->cd.sh.fpul = (uint32_t) ieee;\n")
elif m == "M_i":    # the two halves exchanged
    s = s.replace(STORES, "\treg(ic->arg[0]) = (uint32_t) ieee;\n\treg(ic->arg[0] + sizeof(uint32_t)) = (uint32_t) (ieee >> 32);\n")
elif m == "M_z":    # store zero on a zero operand
    s = s.replace(INTERP, INTERP + "\tif (op1.f == 0.0) cpu->cd.sh.fpul = 0;\n")
else:
    sys.exit("unknown mutant " + m)
io.open(p, "w", encoding="utf-8", newline="\n").write(s)
print("applied", m)
#!/bin/bash
# run_killtable.sh -- #576 table: waits for the base leg, then the FIXED leg, then eight mutants built in /tmp/gxmut576 (a copy of
# the fixed clone, re-created per mutant, carrying a .MUTANT sentinel; deleted at the end).  No project tree is touched.
set -u
W=/mnt/c/DocumentNoSnc/CC/GXEMUL/_scratchpad/w576; K=$W/killtable_20261102; F=/tmp/gxfix576; M=/tmp/gxmut576
LOG=$K/KILLTABLE.log
echo "killtable start $(date '+%F %T')" | tee "$LOG"
while ! grep -q '^LEG_DONE base_head' "$K/base_head.raw" 2>/dev/null; do sleep 20; done
echo "base leg done; fixed leg next $(date '+%T')" | tee -a "$LOG"
bash "$W/run_probe_leg.sh" "$F/gxemul" fixed | tail -1 | tee -a "$LOG"
for mut in M_b M_c M_d M_f M_g M_h M_i M_z; do
    rm -rf "$M"; cp -a "$F" "$M"
    echo "MUTANT: src/cpus/cpu_sh_instr.c $mut (scratch clone, #576 table)" > "$M/.MUTANT"
    if ! python3 "$W/mutate576.py" "$mut" "$M/src/cpus/cpu_sh_instr.c" >> "$LOG" 2>&1; then echo "$mut APPLY-FAILED" | tee -a "$LOG"; continue; fi
    ( cd "$M" && rm -f src/cpus/cpu_sh*.o && make -j4 > "make_$mut.log" 2>&1 ); rc=$?
    if [ $rc != 0 ] || [ ! "$M/gxemul" -nt "$M/src/cpus/cpu_sh_instr.c" ]; then echo "$mut BUILD-FAILED rc=$rc" | tee -a "$LOG"; tail -3 "$M/make_$mut.log" >> "$LOG"; continue; fi
    bash "$W/run_probe_leg.sh" "$M/gxemul" "$mut" | tail -1 | tee -a "$LOG"
done
rm -rf "$M"
echo "KILLTABLE_DONE $(date '+%F %T')" | tee -a "$LOG"
#!/bin/bash
# run_probe_leg.sh <binary> <label> -- one leg of the #576 table: the extended probe against one scratch binary.
# Output: /mnt/c/.../w576/killtable_20261102/<label>.raw (full probe output + a header naming the binary and its freshness).
set -u
BIN=$1; LABEL=$2
OUT=/mnt/c/DocumentNoSnc/CC/GXEMUL/_scratchpad/w576/killtable_20261102/$LABEL.raw
KERNEL=/mnt/c/DocumentNoSnc/CC/GXEMUL/_images/openbsd76-landisk-bsd.rd
PROBE=/mnt/c/DocumentNoSnc/CC/GXEMUL/_scratchpad/w576/sh_rounding_probe.NEW.py
SRC=$(dirname "$BIN")/src/cpus/cpu_sh_instr.c
{ echo "LEG $LABEL binary=$BIN $(ls -la --time-style=+%F_%T "$BIN" | awk '{print $5, $6}') md5=$(md5sum "$BIN" | cut -c1-12)";
  echo "binary newer than cpu_sh_instr.c: $( [ "$BIN" -nt "$SRC" ] && echo yes || echo NO-STALE )";
  echo "sentinel: $(cat "$(dirname "$BIN")/.MUTANT" 2>/dev/null || echo none)"; } > "$OUT"
cd /tmp && python3 -u "$PROBE" "$BIN" "$KERNEL" >> "$OUT" 2>&1
echo "LEG_DONE $LABEL $(grep -E '^SH_ROUND_RESULT=' "$OUT")" | tee -a "$OUT"
