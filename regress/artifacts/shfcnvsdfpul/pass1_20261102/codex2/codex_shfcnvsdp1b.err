35:#include <float.h>
36:
37:#include "float_emul.h"
38:#include "misc.h"
39:
40:
41:/*  #define IEEE_DEBUG  */
42:
43:
44:/*
45: *  #279: one-shot latches for the two "unimplemented format" diagnostics
46: *  below.  Both were printed by ungated fatal() from a path a guest repeats at
47: *  will: on MIPS every fmt outside {S,D,W,L} maps to 0 here (see
48: *  mips_fmt_to_ieee_fmt[] in cpu_mips_coproc.c) and cpu_mips_instr.c admits PS
49: *  to the slow COP1 path, so ONE add.ps produced 8 host lines -- 6 from
50: *  ieee_interpret_float_value() (three sites, two operands) and 2 from
51: *  ieee_store_float_value() -- measured identically on R3000 and R4000.
52: *
53: *  A latch, not a verbosity gate.  The guest is told nothing here: fd is
54: *  silently written 0, so this line is the only record that the emulator met a
55: *  format it does not model, and exactly one of them should survive into a -q
56: *  run, where a VERBOSITY_DEBUG gate would be invisible.  (#276 gates its
57: *  message instead -- there the guest IS answered, so the line is noise rather
58: *  than a deficiency tripwire.)  fatal() is kept because neither function has
59: *  a cpu or a machine pointer in scope, so debugmsg_cpu() is not available.
60: *
61: *  These flags are PROCESS-GLOBAL, not per-instance like #269's and #277's:
62: *  float_emul.c is a stateless helper with no struct to hang state on.  The
63: *  cost is that with more than one emulated machine only the first one's bad
64: *  format is reported.  That is a deliberate deviation, stated here rather
65: *  than left to be discovered.  One flag per distinct message and never one
66: *  shared flag -- a shared flag would let whichever message fires first mask
67: *  the other one for good.
68: */
69:static int interpret_badfmt_warned = 0;
70:static int store_badfmt_warned = 0;
71:
72:
73:/*
74: *  ieee_interpret_float_value():
75: *
76: *  Interprets a float value from binary IEEE format into an ieee_float_value
77: *  struct.
78: */
79:void ieee_interpret_float_value(uint64_t x, struct ieee_float_value *fvp,
80:	int fmt)
81:{
82:	memset(fvp, 0, sizeof(struct ieee_float_value));
83:
84:	int n_frac = 0, n_exp = 0;
85:	int i, nan, sign = 0, exponent;
86:	int exp_biased = 1;	/*  #303: biased exponent, saved so the S/D
87:				    fraction arm can tell a subnormal (0) from
88:				    a normal.  1 is a safe "normal" sentinel
89:				    for the W/L formats, which have none.  */
90:	double fraction;
91:
92:	/*  n_frac and n_exp:  */
93:	switch (fmt) {
94:	case IEEE_FMT_S:	n_frac = 23; n_exp = 8; break;
95:	case IEEE_FMT_W:	n_frac = 31; n_exp = 0; break;
96:	case IEEE_FMT_D:	n_frac = 52; n_exp = 11; break;
97:	case IEEE_FMT_L:	n_frac = 63; n_exp = 0; break;
98:	default:/*  #279  */
99:		if (!interpret_badfmt_warned) {
100:			interpret_badfmt_warned = 1;
101:			fatal("ieee_interpret_float_value(): "
102:			    "unimplemented format %i\n", fmt);
103:		}
104:	}
105:
106:	/*  Get the Exponent:  */
107:	exponent = 0;
108:	switch (fmt) {
109:	case IEEE_FMT_W:
110:		x &= 0xffffffffULL;
111:	case IEEE_FMT_L:
112:		break;
113:	case IEEE_FMT_S:
114:		x &= 0xffffffffULL;
115:		// fall through
116:	case IEEE_FMT_D:
117:		exp_biased = (x >> n_frac) & ((1 << n_exp) - 1);  /*  #303  */
118:		exponent = exp_biased - ((1 << (n_exp-1)) - 1);
119:		break;
120:	default:/*  #279  */
121:		if (!interpret_badfmt_warned) {
122:			interpret_badfmt_warned = 1;
123:			fatal("ieee_interpret_float_value(): unimplemented "
124:			    "format %i\n", fmt);
125:		}
126:	}
127:
128:	/*  Is this a Not-A-Number?  */
129:	nan = 0;
130:	switch (fmt) {
131:	case IEEE_FMT_S:
132:		sign = (x >> 31) & 1;
133:		if ((x & ~0x80000000ULL) == 0x7f800000ULL) {
134:			fvp->f = INFINITY;
135:			goto zero_or_no_reasonable_result;
136:		}
137:		if ((x & 0x7f800000ULL) == 0x7f800000ULL)
138:			nan = 1;
139:		break;
140:	case IEEE_FMT_D:
141:		sign = (x >> 63) & 1;
142:		if ((x & ~0x8000000000000000ULL) == 0x7ff0000000000000ULL) {
143:			fvp->f = INFINITY;
144:			goto zero_or_no_reasonable_result;
145:		}
146:		if ((x & 0x7ff0000000000000ULL) == 0x7ff0000000000000ULL)
147:			nan = 1;
148:		break;
149:	}
150:
151:	if (nan) {
152:		fvp->f = NAN;
153:		goto no_reasonable_result;
154:	}
155:
156:	/*  Calculate the fraction:  */
157:	fraction = 0.0;
158:
159:	switch (fmt) {
160:
161:	case IEEE_FMT_W:
162:		{
163:			int32_t r_int = x;
164:			fraction = r_int;
165:		}
166:		break;
167:
168:	case IEEE_FMT_L:
169:		{
170:			int64_t r_int = x;
171:			fraction = r_int;
172:		}
173:		break;
174:
175:	case IEEE_FMT_S:
176:	case IEEE_FMT_D:
