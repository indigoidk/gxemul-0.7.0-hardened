2914:/*
2915: *  float_fpul_frn:  Load FPUL into float register.
2916: *
2917: *  arg[0] = ptr to float register, or float register pair
2918: */
2919:X(float_fpul_frn)
2920:{
2921:	int32_t fpul = cpu->cd.sh.fpul;
2922:
2923:	FLOATING_POINT_AVAILABLE_CHECK;
2924:
2925:	if (cpu->cd.sh.fpscr & SH_FPSCR_PR) {
2926:		/*  Double-precision, using a pair of registers:  */
2927:		uint64_t ieee = ieee_store_float_value(fpul, IEEE_FMT_D);
2928:		reg(ic->arg[0]) = (uint32_t) (ieee >> 32);
2929:		reg(ic->arg[0] + sizeof(uint32_t)) = (uint32_t) ieee;
2930:	} else {
2931:		/*  Single-precision:  */
2932:		uint32_t ieee = ieee_store_float_value_rm(fpul, IEEE_FMT_S, sh_fp_rm(cpu));
2933:		reg(ic->arg[0]) = (uint32_t) ieee;
2934:	}
2935:}
