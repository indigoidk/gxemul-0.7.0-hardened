3088: *  arg[0] = ptr to single-precision float register pair
3089: */
3090:X(fsca_fpul_drn)
3091:{
3092:	double fpulAngle = ((double)cpu->cd.sh.fpul) * 2.0 * M_PI / 65536.0;
