3043:/*
3044: *  fcnvsd_fpul_drn:  Convert single-precision to double-precision.
3045: *  fcnvds_drm_fpul:  Convert double-precision to single-precision.
3046: *
3047: *  arg[0] = ptr to destination (double- or single-precision float)
3048: */
3049:X(fcnvsd_fpul_drn)
3050:{
3051:	struct ieee_float_value op1;
3052:	int64_t ieee;
3053:
3054:	FLOATING_POINT_AVAILABLE_CHECK;
3055:
3056:	ieee_interpret_float_value(cpu->cd.sh.fpul, &op1, IEEE_FMT_S);
3057:	cpu->cd.sh.fpul = (int32_t) op1.f;
3058:
3059:	/*  Store double-precision result:  */
3060:	ieee = ieee_store_float_value(op1.f, IEEE_FMT_D);
3061:	reg(ic->arg[0]) = (uint32_t) (ieee >> 32);
3062:	reg(ic->arg[0] + sizeof(uint32_t)) = (uint32_t) ieee;
3063:}
3064:X(fcnvds_drm_fpul)
3065:{
3066:	struct ieee_float_value op1;
3067:	int64_t r1;
3068:
3069:	FLOATING_POINT_AVAILABLE_CHECK;
3070:
3071:	r1 = reg(ic->arg[0] + sizeof(uint32_t)) +
3072:	    ((uint64_t)reg(ic->arg[0]) << 32);
3073:	ieee_interpret_float_value(r1, &op1, IEEE_FMT_D);
3074:
3075:	cpu->cd.sh.fpul = ieee_store_float_value_rm(op1.f, IEEE_FMT_S, sh_fp_rm(cpu));
3076:}
