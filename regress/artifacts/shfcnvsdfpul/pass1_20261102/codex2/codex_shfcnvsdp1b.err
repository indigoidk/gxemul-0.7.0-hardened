68:#ifndef	SH_FP_ROUNDING_MODE_INCLUDED
69:#define	SH_FP_ROUNDING_MODE_INCLUDED
70:/*
71: *  #296: the rounding mode for a single-precision store.
72: *
73: *  FPSCR.RM was stored, guest-writable, and decoded NOWHERE -- the mask in
74: *  cpu_sh.h was referenced only by its own #define, so every store
75: *  truncated. Truncation IS round-toward-zero, which is the mode the SH-4
76: *  resets into (RM = 01), and that is exactly why #292 left this core on
77: *  the legacy entry point: under the reset mode there was no wrong answer
78: *  to reproduce. (Round-toward-zero of the value handed to the store, to be
79: *  precise -- not of the infinitely-precise result. Every core here
80: *  evaluates in host double and then narrows, so a cancellation finer than
125: *  mode, which #292 established is not straightforward.
126: *
127: *  The guard is future-proofing, not present necessity, and saying so is
128: *  the point. tmp_sh_tail.c includes this file at :63 and again at :118,
129: *  but the second include sits under #ifdef DYNTRANS_DUALMODE_32, which
130: *  cpu_sh.c does not define (it defines only DYNTRANS_32; MIPS, PPC and
131: *  RISC-V are the dual-mode cores). So there is exactly ONE live inclusion
132: *  for SH today and the guard is inert. It is kept because a future
133: *  dual-mode SH build would otherwise get a duplicate definition, and
134: *  because this is the idiom cpu_mips_instr.c already uses for its shared
135: *  helpers, where two inclusions really are live. Both inclusions land in
136: *  one translation unit, so the first definition stays in scope for the
137: *  second; were that not so it would be a hard compile error, not silent
138: *  breakage.
139: */
140:static int sh_fp_rm(struct cpu *cpu)
141:{
142:	return (cpu->cd.sh.fpscr & SH_FPSCR_RM_MASK) == SH_FPSCR_RM_NEAREST?
143:	    IEEE_RM_RN : IEEE_RM_RZ;
144:}
145:
146:
147:/*
148: *  sh_dn():  #334  --  FPSCR.DN, the denormalization mode.
149: *
150: *  SH-4 never delivers a subnormal ARITHMETIC RESULT.  With DN=1 it writes a
151: *  signed zero; with DN=0 the silicon raises an FPU error instead of computing
152: *  one.  SH_FPSCR_DN_ZERO has been defined since the port was written and was
153: *  read by NOTHING -- the flush happened to be correct only because the shared
154: *  encoder flushed unconditionally, which #331 stopped.  Without this, every
155: *  SH guest would begin seeing gradual underflow, and FPSCR RESETS TO 0x40001
156: *  (cpu_sh.c), i.e. DN=1, so that would be the DEFAULT configuration rather
157: *  than an exotic one.
158: *
159: *  DN=0 delivers the IEEE value here rather than raising the FPU error, which
160: *  is this tree's established modelling depth for SH FP exceptions -- the same
161: *  choice #303 made on the operand side, and the reason the two committed
162: *  gate-10 rows deliberately clear DN.  It is a NAMED divergence, recorded in
163: *  OUTSTANDING_BUGS, not an oversight; the exception model is its own queued
164: *  round.
165: *
166: *  Applied uniformly to every FP result store in this file through the two
167: *  macros below, rather than hand-edited into twenty-three call sites.  That
168: *  is the safer construction and not merely the shorter one: a per-site edit
169: *  can MISS a site silently, whereas this cannot, and the function is a no-op
170: *  for everything except a value that is subnormal in the destination -- the
171: *  integer W/L formats and every normal, zero, Inf and NaN result pass through
172: *  bit-identical.  The parenthesised callee suppresses the macro so the real
173: *  function is still what gets called.
174: */
175:static uint64_t sh_dn(struct cpu *cpu, uint64_t ieee, int fmt)
176:{
177:	int n_frac, signofs;
178:	uint64_t mag;
179:
180:	if (fmt != IEEE_FMT_S && fmt != IEEE_FMT_D)
181:		return ieee;
182:	if (!(cpu->cd.sh.fpscr & SH_FPSCR_DN_ZERO))
183:		return ieee;
184:
185:	n_frac = fmt == IEEE_FMT_S ? 23 : 52;
186:	signofs = fmt == IEEE_FMT_S ? 31 : 63;
187:	mag = ieee & ~((uint64_t)1 << signofs);
188:
189:	if (mag == 0 || (mag >> n_frac) != 0)
190:		return ieee;
191:
192:	return ieee & ((uint64_t)1 << signofs);
193:}
194:
195:#define	ieee_store_float_value(v, fmt)					\
196:	sh_dn(cpu, (ieee_store_float_value)((v), (fmt)), (fmt))
197:#define	ieee_store_float_value_rm(v, fmt, rm)				\
198:	sh_dn(cpu, (ieee_store_float_value_rm)((v), (fmt), (rm)), (fmt))
199:#endif
