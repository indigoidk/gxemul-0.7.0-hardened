3279:	if (cpu->cd.sh.fpscr & SH_FPSCR_PR) {
3280:		/*
3281:		 *  #316: FSRRA is defined for single precision only, so PR=1
3282:		 *  is a reserved mode combination. It used to run
3283:		 *  ABORT_EXECUTION, stopping the emulator; it now takes the
3284:		 *  illegal-instruction exception, or its delay-slot variant if
3285:		 *  that is where the guest put it -- the same order the
3286:		 *  FPU-availability macro above uses, and the same shape
3287:		 *  `trapa` uses. FPU-disabled still wins over both, because
3288:		 *  FLOATING_POINT_AVAILABLE_CHECK has already returned by here.
3289:		 */
3290:		SYNCH_PC;
