1:#!/usr/bin/env python3
2:"""Gate 10's measuring instrument: SuperH floating-point rounding, on real guest code.
3:
4:Prints one line per vector:  <name> <mode> <got> <want> ok|FAIL
5:and a final SH_ROUND_RESULT=<passed>/<total>. gate_sh_rounding.sh does the asserting.
6:
7:Why it is built this way
8:------------------------
9:Nothing here trusts a debugger convenience. `reg` does not print floating-point registers
10:on this core, and `dump`/`examine` reads do not route through device handlers -- so every
11:vector has the GUEST execute the instruction and store the result to memory with its own
12:fmov.s, and the value is recovered from a memory dump. Dump output is in memory order and
13:landisk is little-endian, so the four bytes are byte-swapped back.
14:
15:No media, no console, no boot. The SuperH serial port drops host->guest writes
16:non-deterministically (the defect behind #293), so anything typed at a guest shell would be
17:intermittent; the debugger prompt does not go through it. A real kernel is named on the
18:command line only because the SH loader rejects hand-made ELFs and `-E landisk` with no
19:file at all never constructs the machine -- it is never executed.
20:
21:Every vector must DISCRIMINATE: its two modes must want different answers, or it must be
22:explicitly marked a pin. Otherwise reverting #296 would leave the gate green.
23:"""
24:import os
25:import pty
26:import re
27:import select
28:import sys
29:import time
30:
31:BIN = sys.argv[1]
32:KERNEL = sys.argv[2]
33:
34:CODE = 0x8c010000
35:DEST = 0x8c010100
36:
37:DN = 0x00040000            # FPSCR.DN, set at reset
38:PR = 0x00080000            # double precision
39:NODN = 0x80000000          # #303 row marker, NOT an FPSCR bit: the harness strips
40:                           # DN for rows whose operands are denormal (see the #303
41:                           # rows for why a DN=1 numeric expectation would be wrong)
42:RN = 0x0                   # round to nearest
43:RZ = 0x1                   # round to zero
44:
45:#  fmov.s FRm,@Rn  = 1111 nnnn mmmm 1010.  Rn = r1 throughout.
46:ST = {n: (0xf10a | (n << 4)) for n in range(16)}
47:
48:
49:def instr(op, store_reg):
50:    """Pack the operation and the store into one 32-bit little-endian write."""
51:    return (ST[store_reg] << 16) | op
52:
53:
54:#  name, fpscr extra bits, register seed, packed instruction word, {mode: expected}
55:#  A vector may carry an OPTIONAL sixth element: a second 32-bit instruction word placed
56:#  at CODE+4 (stepped as 3 instructions instead of 2). ftrc needs it: the result lands in
57:#  FPUL, so the guest runs `ftrc ; sts fpul,r2` then `mov.l r2,@r1`.
58:VECTORS = [
59:    # ---- the reported defect: FDIV, cpu_sh_instr.c fdiv single arm -------------------
60:    ("fdiv 1.0/3.0", 0,
61:     {"fr0": 0x3f800000, "fr1": 0x40400000},
62:     instr(0xf013, 0),                       # fdiv fr1,fr0
63:     {RN: 0x3eaaaaab, RZ: 0x3eaaaaaa}),
64:
65:    # ---- FLOAT: int32 -> single, the one case where the SOURCE is the wide one -------
66:    #  16777219 = 2^24 + 3, exactly between 16777218 and 16777220.
67:    ("float 2^24+3", 0,
68:     {"fpul": 0x01000003},
69:     instr(0xf02d, 0),                       # float fpul,fr0
70:     {RN: 0x4b800002, RZ: 0x4b800001}),
71:
72:    # ---- FADD: 1.0 + 1.5*2^-24, three quarters of the way up one ulp ----------------
105:     {RN: 0x7f800000, RZ: 0x7f7fffff}),
106:
107:    # ---- D-format directed rounding, FIXED by #300 and now discriminating -----------
108:    #  This row was a PIN from #296 to #299: the D store is a pure re-encode, so wiring
109:    #  the STORE could never fix it, and both modes measured the host-nearest 9a. #300
110:    #  corrects the ARITHMETIC instead -- one fma residual recovers which neighbour the
111:    #  host's nearest result landed on -- so toward-zero now yields the true 99. The pin
112:    #  flipped exactly as its own comment required, by the only mechanism that could.
113:    ("Ddiv 1.0/10.0 low", PR,
114:     {"fr0": 0x3ff00000, "fr1": 0x00000000,
115:      "fr2": 0x40240000, "fr3": 0x00000000},
116:     instr(0xf023, 1),                       # fdiv dr2,dr0 ; store fr1 = low half
117:     {RN: 0x9999999a, RZ: 0x99999999}),
155:
156:    # ---- #297: ftrc's value ladder. DELIBERATELY mode-independent -- VERIFIED
157:    #  2026-08-22 against a real manual: FTRC's own Description section says flatly
158:    #  "The rounding mode is always truncation."  Another no-manual-era claim that
159:    #  held.  the manual says
160:    #  "the rounding mode is always truncation", so these rows run under both modes and
161:    #  must agree; if someone ever wires ftrc to RM, the discriminating-count check
162:    #  catches the drift. Before #297 the conversion was a raw C cast (UB on the
163:    #  specials): +Inf and +2^40 measured 0x80000000 on x86 where the manual owes +MAX.
164:    #  sequence: ftrc fr0,fpul (0xf03d) ; sts fpul,r2 (0x025a) ; mov.l r2,@r1 (0x2122)
165:    ("ftrcS-inf +Inf",   0, {"fr0": 0x7f800000},
166:     (0x025a << 16) | 0xf03d, {RN: 0x7fffffff, RZ: 0x7fffffff},
167:     (0x0009 << 16) | 0x2122),
168:    ("ftrcS-ovf +2^40",  0, {"fr0": 0x53800000},
169:     (0x025a << 16) | 0xf03d, {RN: 0x7fffffff, RZ: 0x7fffffff},
170:     (0x0009 << 16) | 0x2122),
171:    #  A positive NaN also exceeds the positive range bound; the manual routes it to
172:    #  -MAX. This row is what catches a ladder with the checks in the wrong order.
173:    ("ftrcS-nan qNaN+",  0, {"fr0": 0x7fc00000},
174:     (0x025a << 16) | 0xf03d, {RN: 0x80000000, RZ: 0x80000000},
175:     (0x0009 << 16) | 0x2122),
176:    #  The S bound is STRICT: 0x4effffff itself is NORM and truncates to 2147483520.
177:    ("ftrcS-edge 4effffff", 0, {"fr0": 0x4effffff},
178:     (0x025a << 16) | 0xf03d, {RN: 0x7fffff80, RZ: 0x7fffff80},
179:     (0x0009 << 16) | 0x2122),
180:    #  The D bound is >=: exactly 2^31 is already Invalid -> +MAX.
181:    ("ftrcD-2p31 exact", PR, {"fr0": 0x41e00000, "fr1": 0x00000000},
182:     (0x025a << 16) | 0xf03d, {RN: 0x7fffffff, RZ: 0x7fffffff},
183:     (0x0009 << 16) | 0x2122),
184:    #  The NEGATIVE D bound is -(2^31+1): -2147483648.5 is still NORM and truncates to
185:    #  -2^31 -- a defined cast, not the invalid arm (same stored bits, different route).
186:    ("ftrcD-neghalf -2^31-0.5", PR, {"fr0": 0xc1e00000, "fr1": 0x00100000},
187:     (0x025a << 16) | 0xf03d, {RN: 0x80000000, RZ: 0x80000000},
188:     (0x0009 << 16) | 0x2122),
189:
190:    # ---- #303: subnormal OPERANDS decode to their true IEEE value -------------------
191:    #  Every other row in this table runs under DN=1 (the reset default this probe
192:    #  ORs in), which is honest for them -- none has a denormal operand. These two DO,
193:    #  and a numeric true-IEEE expectation under DN=1 would bless a value real
194:    #  silicon flushes to zero, so they carry NODN: the harness STRIPS the DN bit and
195:    #  the architectural claim is DN=0-with-kernel-completion (which computes exactly
196:    #  this decode; the FPU-error trap itself stays unmodelled -- the #296/#297
197:    #  precedent). RM is pinned by the row's single mode key; SH-4 resets to RZ, so
198:    #  an unpinned mode would make the fdiv byte ambiguous (panel pass-2).
199:    #  Committed-build bytes, measured live before the fix: 0x32000001, 0x3f800001.
200:    #  The results here are NORMAL, so the #287/#292 store flush is never involved.
201:    ("subn fmul S-min*2^100", NODN, {"fr0": 0x00000001, "fr1": 0x71800000},
202:     instr(0xf012, 0),                       # fmul fr1,fr0
203:     {RN: 0x27000000}),
204:    #  quotient of garbles was ~1.0 (0x3f800001 under RN); true quotient is exactly 2.
205:    ("subn fdiv 2ulp/1ulp", NODN, {"fr0": 0x00000002, "fr1": 0x00000001},
206:     instr(0xf013, 0),                       # fdiv fr1,fr0
207:     {RN: 0x40000000}),
208:]
209:
210:
211:def run(fpscr, seed, word, word2=None):
212:    pid, fd = pty.fork()
213:    if pid == 0:
214:        os.execvp(BIN, [BIN, "-V", "-E", "landisk", "-M", "64", KERNEL])
215:        os._exit(127)
216:    buf = ""
217:
218:    def rd(t=0.4):
219:        nonlocal buf
220:        r, _, _ = select.select([fd], [], [], t)
221:        if fd not in r:
222:            return True
223:        try:
224:            d = os.read(fd, 65536)
225:        except OSError:
226:            return False
227:        if not d:
228:            return False
229:        buf += d.decode("latin1", "replace")
230:        return True
231:
232:    def wait(timeout=40, mark=0, echo=None):
233:        t = time.time()
234:        while time.time() - t < timeout:
235:            if not rd():
236:                return False
237:            resp = buf[mark:]
238:            #  #392: the ECHO first -- a prompt in the slice proves
239:            #  nothing until the debugger has taken the command.
240:            if echo is not None and echo not in resp:
241:                continue
242:            if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
243:                return True
244:        return False
245:
246:    def send(s):
247:        b = (s + "\n").encode("latin1")
248:        _mark = len(buf)
249:        n = 0
250:        while n < len(b):
251:            n += os.write(fd, b[n:])
252:        return wait(mark=_mark, echo=s if s else None)
253:
254:    if not wait(90):
255:        try:
256:            os.kill(pid, 9)
257:            os.waitpid(pid, 0)
258:        except Exception:
259:            pass
260:        return None
261:
262:    cmds = ["fpscr=0x%08x" % fpscr]
263:    cmds += ["%s=0x%08x" % (k, v) for k, v in seed.items()]
264:    cmds += ["r1=0x%08x" % DEST,
265:             "put w 0x%08x, 0x%08x" % (DEST, 0xdeadbeef)]   # sentinel
266:    cmds += ["put w 0x%08x, 0x%08x" % (CODE, word)]
267:    if word2 is not None:
268:        cmds += ["put w 0x%08x, 0x%08x" % (CODE + 4, word2)]
269:    cmds += ["pc=0x%08x" % CODE,
270:             "step %d" % (3 if word2 is not None else 2)]
271:    for c in cmds:
272:        send(c)
273:    mark = len(buf)
274:    send("dump 0x%08x 0x%08x" % (DEST, DEST + 4))
275:    tail = buf[mark:]
276:    try:
277:        os.write(fd, b"quit\n")
278:        time.sleep(0.4)
279:        os.kill(pid, 9)
280:        os.waitpid(pid, 0)
281:    except Exception:
282:        pass
283:
284:    m = re.search(r"0x0*%x\s+([0-9a-f]{8})" % DEST, tail)
285:    if not m:
286:        return None
287:    # dump renders bytes in memory order; landisk is little-endian.
288:    return int.from_bytes(bytes.fromhex(m.group(1)), "little")
289:
290:
291:passed = total = 0
292:for vec in VECTORS:
293:    name, extra, seed, word, want = vec[:5]
294:    word2 = vec[5] if len(vec) > 5 else None
295:    for mode, expect in sorted(want.items()):
296:        total += 1
297:        fps = DN | (extra & ~NODN) | mode
298:        if extra & NODN:
299:            fps &= ~DN          # #303 rows: denormal operands, DN must be clear
300:        got = run(fps, seed, word, word2)
301:        label = "nearest" if mode == RN else "toward-zero"
302:        if got is None:
303:            print("%-28s %-12s %-10s %-10s FAIL(no-readback)"
304:                  % (name, label, "None", "0x%08x" % expect))
305:            continue
306:        ok = (got == expect)
307:        passed += ok
308:        print("%-28s %-12s 0x%08x 0x%08x %s"
309:              % (name, label, got, expect, "ok" if ok else "FAIL"))
310:
311:# A vector whose two modes want the SAME answer cannot detect a reverted fix. Report the
312:# count of genuinely discriminating vectors so the gate can assert on it rather than
313:# trusting that the table was written correctly. The ftrc rows are REQUIRED to be
314:# mode-independent (truncation by architecture), so this count doubles as the tripwire
315:# for anyone accidentally wiring ftrc to FPSCR.RM.
316:# [#556, 2026-10-02 -- a records correction; the text above is kept as it was written] The ftrc rows are
317:# mode-independent by architecture; discriminating counts static vector dictionary entries (len(set(v[4].values()))
318:# > 1) to ensure the table retains mode discriminators, but does not observe emulator execution or tripwire ftrc
319:# source changes.  (hbundle_regress25:F2: regress/artifacts/astraretro_harness_20260926/HARNESS_DISPOSITIONS.md)
320:discriminating = sum(1 for v in VECTORS if len(set(v[4].values())) > 1)
321:print("SH_ROUND_DISCRIMINATING=%d" % discriminating)
322:print("SH_ROUND_RESULT=%d/%d" % (passed, total))
323:
