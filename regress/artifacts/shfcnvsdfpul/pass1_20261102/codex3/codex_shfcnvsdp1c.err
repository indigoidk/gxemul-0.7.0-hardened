272:	if (sign)
273:		fvp->f = -fvp->f;
274:
275:no_reasonable_result:
276:	fvp->nan = nan;
277:
278:#ifdef IEEE_DEBUG
279:	fatal("nan=%i (f=%f) }\n", nan, fvp->f);
280:#endif
281:}
430:	/*  n_frac and n_exp:  */
