1:#!/usr/bin/env python3
2:"""Gate 10's measuring instrument: SuperH floating-point rounding, on real guest code.
3:
4:Prints one line per vector:  <name> <mode> <got> <want> ok|FAIL
5:and a final SH_ROUND_RESULT=<passed>/<total>. gate_sh_rounding.sh does the asserting.
6:
7:Why it is built this way
8:------------------------
9:Nothing here trusts a debugger convenience. `reg` does not print floating-point registers
10:on this core, and `dump`/`examine` reads do not route through device handlers -- so every
11:vector has the GUEST execute the instruction and store the result to memory with its own
12:fmov.s, and the value is recovered from a memory dump. Dump output is in memory order and
13:landisk is little-endian, so the four bytes are byte-swapped back.
14:
15:No media, no console, no boot. The SuperH serial port drops host->guest writes
16:non-deterministically (the defect behind #293), so anything typed at a guest shell would be
17:intermittent; the debugger prompt does not go through it. A real kernel is named on the
18:command line only because the SH loader rejects hand-made ELFs and `-E landisk` with no
19:file at all never constructs the machine -- it is never executed.
20:
21:Every vector must DISCRIMINATE: its two modes must want different answers, or it must be
22:explicitly marked a pin. Otherwise reverting #296 would leave the gate green.
23:"""
24:import os
25:import pty
26:import re
27:import select
28:import sys
29:import time
30:

exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "rg --files GXEMUL-SEC/src -g '*debugger*' -g '*settings*' -g '*dyntrans*'; rg -n 'CPU_SETTINGS_ADD_REGISTER32|SETTINGS_TYPE_UINT32|SETTINGS_TYPE_UINT' GXEMUL-SEC/src/include GXEMUL-SEC/src/core; rg -n -C 3 'X\\(fipr|X\\(ftrv|X\\(fsrra|X\\(fldi|SH_FPSCR_PR|reserved' GXEMUL-SEC/src/cpus/cpu_sh_instr.c | Select-Object -First 170" in C:\DocumentNoSnc\CC\GXEMUL
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$p = '"'GXEMUL-SEC/src/cpus/cpu_sh_instr.c'; "'$s = Get-Content -LiteralPath $p; foreach ($r in @(@(3078,3208), @(3468,3552), @(1433,1490), @(4278,4302), @(1,39))) { for ($i = $r[0]; $i -le $r[1]; $i++) { '"'{0}:{1}' -f "'$i,$s[$i-1] } }' in C:\DocumentNoSnc\CC\GXEMUL
