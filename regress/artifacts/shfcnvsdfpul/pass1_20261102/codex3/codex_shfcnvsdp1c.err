3491:		    ((uint64_t)reg(ic->arg[0]) << 32);
3492:		r2 = reg(ic->arg[1] + sizeof(uint32_t)) +
3493:		    ((uint64_t)reg(ic->arg[1]) << 32);
3494:		ieee_interpret_float_value(r1, &op1, IEEE_FMT_D);
3495:		ieee_interpret_float_value(r2, &op2, IEEE_FMT_D);
3496:
3497:		/*
3498:		 *  IEEE division by zero yields +/-Inf (or NaN for 0/0); C
3499:		 *  floating-point division does not trap, so compute it
