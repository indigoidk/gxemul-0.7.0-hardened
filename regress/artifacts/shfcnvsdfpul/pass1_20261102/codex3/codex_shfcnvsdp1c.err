545:					nf -= 1.0;
546:				}
547:			}
548:
549:			/*  #292: what remains in nf after the loop is the exact
550:			    remainder, in units of one ulp of the destination:
551:			    every step is a multiply by 2 (exact) or a subtraction
552:			    of 1 from a value in [1,2) (exact by Sterbenz), so
553:			    nf == 0.5 is a true half-way tie, exactly.  Round the
554:			    assembled word as a UNIT -- the carry must be allowed
555:			    to run out of the fraction into the exponent, or
556:			    2 - 2^-24 would wrap to 1.0 instead of rounding to
