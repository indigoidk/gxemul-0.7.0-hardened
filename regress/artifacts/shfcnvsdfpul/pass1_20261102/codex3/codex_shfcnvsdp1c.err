147-/*
148: *  sh_dn():  #334  --  FPSCR.DN, the denormalization mode.
149- *
150- *  SH-4 never delivers a subnormal ARITHMETIC RESULT.  With DN=1 it writes a
151- *  signed zero; with DN=0 the silicon raises an FPU error instead of computing
152- *  one.  SH_FPSCR_DN_ZERO has been defined since the port was written and was
153- *  read by NOTHING -- the flush happened to be correct only because the shared
154- *  encoder flushed unconditionally, which #331 stopped.  Without this, every
155- *  SH guest would begin seeing gradual underflow, and FPSCR RESETS TO 0x40001
156- *  (cpu_sh.c), i.e. DN=1, so that would be the DEFAULT configuration rather
157- *  than an exotic one.
158- *
--
165- *
166- *  Applied uniformly to every FP result store in this file through the two
167- *  macros below, rather than hand-edited into twenty-three call sites.  That
168- *  is the safer construction and not merely the shorter one: a per-site edit
169- *  can MISS a site silently, whereas this cannot, and the function is a no-op
170- *  for everything except a value that is subnormal in the destination -- the
171- *  integer W/L formats and every normal, zero, Inf and NaN result pass through
172- *  bit-identical.  The parenthesised callee suppresses the macro so the real
173- *  function is still what gets called.
174- */
175:static uint64_t sh_dn(struct cpu *cpu, uint64_t ieee, int fmt)
176-{
177-	int n_frac, signofs;
178-	uint64_t mag;
179-
180-	if (fmt != IEEE_FMT_S && fmt != IEEE_FMT_D)
181-		return ieee;
182-	if (!(cpu->cd.sh.fpscr & SH_FPSCR_DN_ZERO))
183-		return ieee;
184-
185-	n_frac = fmt == IEEE_FMT_S ? 23 : 52;
186-	signofs = fmt == IEEE_FMT_S ? 31 : 63;
187-	mag = ieee & ~((uint64_t)1 << signofs);
188-
189-	if (mag == 0 || (mag >> n_frac) != 0)
190-		return ieee;
191-
192-	return ieee & ((uint64_t)1 << signofs);
193-}
194-
195:#define	ieee_store_float_value(v, fmt)					\
196:	sh_dn(cpu, (ieee_store_float_value)((v), (fmt)), (fmt))
197:#define	ieee_store_float_value_rm(v, fmt, rm)				\
198:	sh_dn(cpu, (ieee_store_float_value_rm)((v), (fmt), (rm)), (fmt))
199-#endif
