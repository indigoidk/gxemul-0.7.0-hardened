432:	case IEEE_FMT_S:	n_frac = 23; n_exp = 8; signofs = 31; break;
433:	case IEEE_FMT_W:	n_frac = 31; n_exp = 0; signofs = 31; break;
434:	case IEEE_FMT_D:	n_frac = 52; n_exp = 11; signofs = 63; break;
435:	case IEEE_FMT_L:	n_frac = 63; n_exp = 0; signofs = 63; break;
