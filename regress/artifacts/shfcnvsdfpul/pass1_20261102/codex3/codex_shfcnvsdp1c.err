2938:/*
2939: *  ftrc_frm_fpul:  Truncate a float register into FPUL.
2940: *
2941: *  arg[0] = ptr to float register, or float register pair
2942: */
2943:X(ftrc_frm_fpul)
2944:{
2945:	struct ieee_float_value op1;
2946:
2947:	FLOATING_POINT_AVAILABLE_CHECK;
2948:
2949:	/*  #297: the conversion was a raw C cast, `(int32_t) op1.f`.  For NaN,
2950:	 *  infinity and out-of-range values that cast is UNDEFINED BEHAVIOUR --
2951:	 *  the guest-visible result depended on the HOST cpu.  On x86 the cast
2952:	 *  happens to deliver 0x80000000 for every special case; the SH-4
2953:	 *  manual (E602156 rev 5.0, FTRC pseudocode + special-case table)
2954:	 *  instead delivers +MAX 0x7fffffff for +Inf and positive overflow.
2955:	 *  Reproduced on the committed build before this edit: ftrc of +Inf
2956:	 *  and of 2^40 both stored 0x80000000 where the manual owes 0x7fffffff.
2957:	 *
2958:	 *  The ladder below mirrors the manual's ftrc_single_type_of /
2959:	 *  ftrc_double_type_of on the raw bits, constants included:
2960:	 *
2961:	 *    single: NaN if bits > 0x7f800000 (checked FIRST -- a positive NaN
2962:	 *            also exceeds the range bound, and the manual routes it to
2963:	 *            NINF, i.e. 0x80000000, NOT to +MAX); positive out-of-range
2964:	 *            and +Inf if bits > 0x4effffff (P_INT_SINGLE_RANGE,
2965:	 *            strict); negative side if magnitude > 0x4f000000
2966:	 *            (N_INT_SINGLE_RANGE), which covers -Inf, negative NaN and
2967:	 *            negative overflow alike.
2968:	 *    double: NaN if the high word says so; positive bound is
2969:	 *            0x41e0000000000000 (2^31) with >=; negative bound is
2970:	 *            magnitude >= 0x41e0000000200000, i.e. -(2^31+1), also >=,
2971:	 *            so -2147483648.5 is still NORM and truncates to -2^31.
2972:	 *
2973:	 *  ALL NaN deliver 0x80000000 regardless of sign -- the panel seat that
2974:	 *  claimed +MAX for positive NaN was refuted by the pseudocode itself.
2975:	 *  Every invalid case delivers the VALUE only.  The manual's
2976:	 *  ftrc_invalid sets the FPSCR.V cause bit unconditionally before the
2977:	 *  enable check; this model does not, and the honest reason is
2978:	 *  internal consistency, not scope hand-waving: NO instruction in this
2979:	 *  core sets ANY FPSCR cause bit (see the TODO at the fdiv arm), so a
2980:	 *  lone V here would be the one flag a guest could observe, implying
2981:	 *  the others work.  The deviation is guest-visible -- STS FPSCR after
2982:	 *  ftrc(+Inf) reads V=0 where hardware reads 1, and a guest that
2983:	 *  enables the trap gets a value where hardware traps with FPUL
2984:	 *  preserved -- and is tracked in OUTSTANDING_BUGS with the rest of
2985:	 *  the missing SH FPU exception model.  (#273 is precedent only for
2986:	 *  the values-only SCOPE on MIPS; its all-0x7fffffff result table is
2987:	 *  MIPS-specific and must not be copied here -- SH documents the
2988:	 *  A�MAX split this ladder implements.)
2989:	 *  In the NORM arm the truncated value fits int32 by construction, so
2990:	 *  the cast there is defined C and byte-identical to the old path.  */
2991:	if (cpu->cd.sh.fpscr & SH_FPSCR_PR) {
2992:		/*  Double-precision, using a pair of registers:  */
2993:		uint64_t r1 = ((uint64_t)reg(ic->arg[0]) << 32) +
2994:		    reg(ic->arg[0] + sizeof(uint32_t));
2995:		uint32_t hi = (uint32_t) (r1 >> 32);
2996:		if (!(r1 & 0x8000000000000000ULL)) {
2997:			if (hi > 0x7ff00000 ||
2998:			    (hi == 0x7ff00000 && (uint32_t)r1 != 0)) {
2999:				cpu->cd.sh.fpul = 0x80000000;	/*  NaN  */
3000:				return;
3001:			}
3002:			if (r1 >= 0x41e0000000000000ULL) {
3003:				/*  out of range, +Inf:  */
3004:				cpu->cd.sh.fpul = 0x7fffffff;
3005:				return;
3006:			}
3007:		} else {
3008:			if ((r1 & 0x7fffffffffffffffULL) >=
3009:			    0x41e0000000200000ULL) {
3010:				/*  out of range, -Inf, NaN:  */
3011:				cpu->cd.sh.fpul = 0x80000000;
3012:				return;
3013:			}
3014:		}
3015:		ieee_interpret_float_value(r1, &op1, IEEE_FMT_D);
3016:		cpu->cd.sh.fpul = (int32_t) op1.f;
3017:	} else {
3018:		/*  Single-precision:  */
3019:		uint32_t r1 = reg(ic->arg[0]);
3020:		if (!(r1 & 0x80000000)) {
3021:			if (r1 > 0x7f800000) {
3022:				cpu->cd.sh.fpul = 0x80000000;	/*  NaN  */
3023:				return;
3024:			}
3025:			if (r1 > 0x4effffff) {
3026:				/*  out of range, +Inf:  */
3027:				cpu->cd.sh.fpul = 0x7fffffff;
3028:				return;
3029:			}
3030:		} else {
3031:			if ((r1 & 0x7fffffff) > 0x4f000000) {
3032:				/*  out of range, -Inf, NaN:  */
3033:				cpu->cd.sh.fpul = 0x80000000;
3034:				return;
3035:			}
3036:		}
3037:		ieee_interpret_float_value(r1, &op1, IEEE_FMT_S);
3038:		cpu->cd.sh.fpul = (int32_t) op1.f;
3039:	}
3040:}
3041:
3042:
3043:/*
3044: *  fcnvsd_fpul_drn:  Convert single-precision to double-precision.
3045: *  fcnvds_drm_fpul:  Convert double-precision to single-precision.
3046: *
3047: *  arg[0] = ptr to destination (double- or single-precision float)
3048: */
3049:X(fcnvsd_fpul_drn)
3050:{
3600:		ieee_interpret_float_value(r1, &op1, IEEE_FMT_S);
3601:		ieee_interpret_float_value(r2, &op2, IEEE_FMT_S);
3602:	}
3603:
3604:	if (op2.f > op1.f)
3605:		cpu->cd.sh.sr |= SH_SR_T;
3606:	else
3607:		cpu->cd.sh.sr &= ~SH_SR_T;
3608:}
