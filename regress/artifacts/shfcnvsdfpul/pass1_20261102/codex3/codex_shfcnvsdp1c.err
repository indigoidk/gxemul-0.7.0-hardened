3540:	r1 = reg(ic->arg[0]), r2 = reg(ic->arg[1]);
3541:	ieee_interpret_float_value(fr0, &op0, IEEE_FMT_S);
3542:	ieee_interpret_float_value(r1, &op1, IEEE_FMT_S);
3543:	ieee_interpret_float_value(r2, &op2, IEEE_FMT_S);
3544:	/*  #299: the product of two singles is EXACT in double (48 bits), so
3545:	    fmac reduces to one round-to-odd sum -- which also delivers the
3546:	    manual's rounds-ONCE semantics under plain nearest, where the old
3547:	    two-rounding path picked the wrong side of a tie band (measured:
3548:	    (0x3fc00003 * 0x33fffffc) + 1.0 gave 0x3f800002, nearest owes
3549:	    0x3f800001).  */
3550:	ieee = ieee_store_float_value_rm(
3551:	    ieee_sum_round_to_odd(op0.f * op1.f, op2.f, sh_fp_rm(cpu)),
3552:	    IEEE_FMT_S, sh_fp_rm(cpu));
