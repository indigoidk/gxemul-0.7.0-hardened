2881:/*
2882: *  fmov_frm_frn:  Copy one floating-point register (or pair) to another.
2883: *
2884: *  arg[0] = ptr to source float register or pair
2885: *  arg[1] = ptr to destination float register or pair
2886: */
2887:X(fmov_frm_frn)
2888:{
2889:	size_t r0, r1;
2890:	int ofs0, ofs1;
2891:
2892:	FLOATING_POINT_AVAILABLE_CHECK;
2893:
2894:	/*  Simplest case, single-precision:  */
2895:	if (!(cpu->cd.sh.fpscr & SH_FPSCR_SZ)) {
2896:		reg(ic->arg[1]) = reg(ic->arg[0]);
2897:		return;
2898:	}
2899:
2900:	/*  Double-precision:  */
2901:	r0 = ic->arg[0]; r1 = ic->arg[1];
2902:	ofs0 = (r0 - (size_t)&cpu->cd.sh.fr[0]) / sizeof(uint32_t);
2903:	ofs1 = (r1 - (size_t)&cpu->cd.sh.fr[0]) / sizeof(uint32_t);
2904:	if (ofs0 & 1)
2905:		r0 = (size_t)&cpu->cd.sh.xf[ofs0 & ~1];
2906:	if (ofs1 & 1)
2907:		r1 = (size_t)&cpu->cd.sh.xf[ofs1 & ~1];
2908:
2909:	reg(r1) = reg(r0);
2910:	reg(r1 + 4) = reg(r0 + 4);
2911:}
