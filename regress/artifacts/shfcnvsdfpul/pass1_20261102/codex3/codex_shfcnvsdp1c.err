3518:		ieee_interpret_float_value(r2, &op2, IEEE_FMT_S);
3519:
3520:		/*
3521:		 *  IEEE division by zero yields +/-Inf (or NaN for 0/0); C
3522:		 *  floating-point division does not trap, so compute it
3523:		 *  directly instead of silently returning 0.0. FPSCR
3524:		 *  exception-enable (DIV0 trap) handling remains a TODO.
3525:		 */
3526:		result = op2.f / op1.f;
3527:
3528:		ieee = ieee_store_float_value_rm(result, IEEE_FMT_S, sh_fp_rm(cpu));
