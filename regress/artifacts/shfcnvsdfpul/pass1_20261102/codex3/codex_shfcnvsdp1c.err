493:		r2 = r3;
494:		r |= r2;
495:		break;
517:		case FP_NORMAL:
518:			if (signbit(nf))
519:				nf = -nf;
520:
521:			/*
522:			 *  How to convert back from double to exponent + fraction:
523:			 *  The fraction should be 1.xxx, that is
524:			 *  1.0 <= fraction < 2.0
525:			 *
526:			 *  This method is very slow but should work:
527:			 *  (TODO: Fix the performance problem!)
