from pathlib import Path
import re, collections
r=Path('GXEMUL-SEC/regress/artifacts/fbctrlportkill_20260924')
txt=(r/'table6/TABLE.out').read_text()
rows={m[1]:m for m in re.finditer(r'"'^('"\\S+) md5=(\\w+) rc=(\\d+) FBCTRLP_RESULT=(\\d+)/(\\d+) FBCTRLP_CONTROL=(\\w+) FBCTRLP_DONE \\|\\s*(.*)"'$'"',txt,re.M)}
preds={m[1]:m[2] for m in re.finditer(r'"'^('"\\S+)\\s+t[56]\\s+(GREEN\\(\\w+\\)|RED)',(r/'table6/MANIFEST.out').read_text(),re.M)}
print('TABLE 6:',len(rows),'edit records',len(preds),'predictions')
print('Counts:',collections.Counter('GREEN' if int(m[4])==int(m[5]) else 'RED' for m in rows.values()))
print('Missing/extra IDs:',sorted(set(rows)"'^set(preds)))
print('"'Prediction mismatches:',[k for k,m in rows.items() if (preds[k].startswith('GREEN')) "'!= (m[3]=='"'0' and m[4]==m[5])])
print('All denominators:',collections.Counter(m[5] for m in rows.values()))
print('Full-score edits:')
for k,m in rows.items():
 if m[4]==m[5]: print(k,'md5='+m[2],preds[k])
print('Single-bit B-width discrepancies:')
for k,m in rows.items():
 if k.startswith('MKB_') or k=='MK_b8_ctl':
  b=int(k[4:]) if k.startswith('MKB_') else 8
  got=set(re.findall(r'B refuse every single bit .*? \\((s[bhdw])\\)',m[7]))
  want={w for w,n in [('sb',8),('sh',16),('sw',32),('sd',64)] if b<n}
  if got"'!=want: print(k,got,want)
print('"'Widths and range examples:')
for k,m in rows.items():
 if k.startswith('MKW_') or k.startswith('MK_') or k=='M_revert': print(m[0])
for n in [3,4,5]:
 t=(r/f'table{n}/TABLE.out').read_text()
 rs=re.findall(r'"'^('"\\S+) md5=.*?rc=(\\d+).*?FBCTRLP_RESULT=(\\d+)/(\\d+)',t,re.M)
 print('table',n,'edits',len(rs),'denominators',collections.Counter(x[3] for x in rs),'base header',t.splitlines()[:4])
