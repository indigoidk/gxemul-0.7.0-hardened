FILE opus549_measured\f2v6\scripts\u_sessions.py.txt
    1: #!/usr/bin/env python3
    2: """A prototype of D1's repair (NOT a proposed probe edit): one FRESH device per single-bit value, so each value's refusal
    3: is that device's FIRST -- the latch is clear.  Each session: PORT=<anchor> (legal, leaves the latch clear), a store of
    4: 2^k (sw below bit 32, sd from 32 up), then a PORT read into a poisoned register.  Checks per session: PORT keeps the
    5: anchor; exactly one announce right after the refusal; the announce names 2^k; and the session's own controls (it
    6: survived, every step ran, the disassembly matched).  Uses the frozen v6 probe's own session().
    7: usage: u_sessions.py <gxemul> <frozen v6 probe> [anchor=7] [bits: all | 58]"""
    8: import importlib.util
    9: import os
   10: import sys
   11: import time
   12: 
   13: BIN, PROBE = sys.argv[1], sys.argv[2]
   14: ANCHOR = int(sys.argv[3]) if len(sys.argv) > 3 else 7
   15: WHICH = sys.argv[4] if len(sys.argv) > 4 else "all"
   16: sys.argv = [PROBE, BIN]
   17: spec = importlib.util.spec_from_file_location("fbp", PROBE)
   18: fbp = importlib.util.module_from_spec(spec)
   19: spec.loader.exec_module(fbp)
   20: BITS = list(range(3, 64)) if WHICH == "all" else [k for k in range(3, 64) if k not in (3, 8, 32)]
   21: stub = fbp.stub_path()
   22: t0 = time.time()
   23: bad_ctl, bad_keep, bad_once, bad_name = [], [], [], []
   24: try:
   25:     for k in BITS:
   26:         w = "sw" if k < 32 else "sd"
   27:         S = fbp.session("U%02d" % k, [("sw", "a0", 0, None), (w, "t1", 0, "u"), ("lw", "s0", 0, None)],
   28:                         [("t0", fbp.FBCTRL), ("a0", ANCHOR), ("t1", 1 << k), ("s0", 0xdead)], ["s0"], stub)
   29:         got = S["vals"].get("s0")
   30:         if S["status"] != "SURVIVED" or S["steps"] != 3 or S["badis"]:
   31:             bad_ctl.append("%d:%s/%d/%d" % (k, S["status"], S["steps"], len(S["badis"])))
   32:         if got != ANCHOR:
   33:             bad_keep.append("%d:%s" % (k, fbp.hx(got)))
   34:         if S["once_after"].get("u") != 1:
   35:             bad_once.append("%d:%s" % (k, S["once_after"].get("u")))
   36:         if fbp.first_val(S) != "0x%x" % (1 << k):
   37:             bad_name.append("%d:%s" % (k, fbp.first_val(S)))
   38: finally:
   39:     os.unlink(stub)
   40: print("U_ANCHOR=%d U_SESSIONS=%d U_WALL=%.1fs" % (ANCHOR, len(BITS), time.time() - t0))
   41: print("U_CONTROL_BAD=%d %s" % (len(bad_ctl), " ".join(bad_ctl)))
   42: print("U_KEEP_BAD=%d %s" % (len(bad_keep), " ".join(bad_keep)))
   43: print("U_ONCE_BAD=%d %s" % (len(bad_once), " ".join(bad_once)))
   44: print("U_NAME_BAD=%d %s" % (len(bad_name), " ".join(bad_name)))
   45: print("U_DONE")
