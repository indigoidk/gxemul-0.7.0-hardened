  178: 	    DEV_FB_ADDRESS, VFB_GENERIC, 640, 480, 640, DEV_FBCTRL_MAXY(640),
  179: 	    24, "generic");
  180: 
  181: 	memory_device_register(devinit->machine->memory, devinit->name,
  182: 	    devinit->addr, DEV_FBCTRL_LENGTH, dev_fbctrl_access, d,
  183: 	    DM_DEFAULT, NULL);
