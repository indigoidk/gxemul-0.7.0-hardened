    1: #!/usr/bin/env python3
    2: """A static walk of the v6 probe's own programs (imported, not transcribed) under the FIX's semantics, to enumerate,
    3: for every refused value, the previous selectors at which a refusal of it is OBSERVED -- i.e. followed, before the next
    4: accepted PORT store, by a PORT or DATA load whose register survives to be printed.  A value observed at only ONE
    5: selector admits a refusal-time constant write equal to that selector (D2 / N21).  Also lists the latch-clear refusals
    6: (D1 / N1).  usage: sim_anchors.py <v6 probe>"""
    7: import importlib.util
    8: import sys
    9: 
   10: PROBE = sys.argv[1]
   11: sys.argv = [PROBE, "/bin/true"]
   12: spec = importlib.util.spec_from_file_location("fbp", PROBE)
   13: fbp = importlib.util.module_from_spec(spec)
   14: spec.loader.exec_module(fbp)
   15: M64 = (1 << 64) - 1
   16: WIDTH = dict(sb=1, sh=2, sw=4, sd=8)
   17: READS = dict(C=["t4", "t5", "s2", "s3"], A=fbp.READS_A, P=fbp.READS_P, R=["s1"], K=["s0", "s1"], F=["t2"],
   18:              V=fbp.READS_V, W=fbp.READS_W, Y=["s0", "s1", "s2"], Z=["s0"], B=fbp.READS_B)
   19: SESS = dict(C=(fbp.PROG_C, fbp.REGS_C), A=(fbp.PROG_A, fbp.REGS_A), P=(fbp.PROG_P, fbp.REGS_P),
   20:             R=(fbp.PROG_R, fbp.REGS_R), K=(fbp.PROG_K, fbp.REGS_K), F=(fbp.PROG_F, fbp.REGS_F),
   21:             V=(fbp.PROG_V, fbp.REGS_V), W=(fbp.PROG_W, fbp.REGS_W), Y=(fbp.PROG_Y, fbp.REGS_Y),
   22:             Z=(fbp.PROG_Z, fbp.REGS_Z), B=(fbp.PROG_B, fbp.REGS_B))
   23: for lab, k, w, v in fbp.X_CELLS:
   24:     prog, regs = fbp.prog_x(k, w, v)
   25:     SESS[lab] = (prog, regs)
   26:     READS[lab] = ["s0"]
   27: 
   28: observed = {}      # value -> set of anchors
   29: unobserved = []    # refusals no printed load observes
   30: latch_clear = []   # (session, value, width, anchor, observed?)
   31: for lab, (prog, regs) in SESS.items():
   32:     R = {r: 0 for r in fbp.REG}
   33:     for r, v in regs:
   34:         R[r] = v & M64
   35:     cur, latched = 0, False
   36:     # pass 1: which load steps survive to be printed (last writer of each printed register)
   37:     last = {}
   38:     for i, (op, rt, off, _t) in enumerate(prog):
   39:         if op in fbp.LOADS or op == "dsll":
   40:             last[rt] = i
   41:     printed_loads = {last[r] for r in READS[lab] if r in last}
   42:     pending = []   # refusals awaiting an observation: (value, width, anchor, latch_was_clear)
   43:     for i, (op, rt, off, _t) in enumerate(prog):
   44:         if op == "dsll":
   45:             R[rt] = (R[rt] << off) & M64
   46:             continue
   47:         if op in WIDTH and off == 0:                      # a PORT store
   48:             val = R[rt] & ((1 << (8 * WIDTH[op])) - 1)
   49:             if val >= 8:
   50:                 pending.append((val, op, cur, not latched))
   51:                 latched = True
   52:             else:
   53:                 for p in pending:
   54:                     unobserved.append((lab,) + p)
   55:                     if p[3]:
   56:                         latch_clear.append((lab, p[0], p[1], p[2], False))
   57:                 pending = []
   58:                 cur = val
   59:         elif op in fbp.LOADS:                              # a PORT or DATA load
   60:             if i in printed_loads and pending:
   61:                 for p in pending:
   62:                     observed.setdefault(p[0], set()).add(p[2])
   63:                     if p[3]:
   64:                         latch_clear.append((lab, p[0], p[1], p[2], True))
   65:                 pending = []
   66:             if op in fbp.LOADS:
   67:                 R[rt] = 0                                   # value irrelevant here
   68:     for p in pending:
   69:         unobserved.append((lab,) + p)
   70:         if p[3]:
   71:             latch_clear.append((lab, p[0], p[1], p[2], False))
   72: 
   73: print("REFUSED VALUES AND THE ANCHORS THAT OBSERVE THEM")
   74: single = []
   75: for v in sorted(observed):
   76:     a = sorted(observed[v])
   77:     print("  0x%-18x anchors %s" % (v, a))
   78:     if len(a) == 1:
   79:         single.append((v, a[0]))
   80: print("SINGLE-ANCHOR VALUES (a refusal-time write of that anchor escapes): %d" % len(single))
   81: print("  " + " ".join("0x%x@%d" % s for s in single))
   82: sb = [v for v, a in single if v & (v - 1) == 0]
   83: print("  of which single-bit: %d  bits %s" % (len(sb), sorted(v.bit_length() - 1 for v in sb)))
   84: print("UNOBSERVED REFUSALS (no printed load before the next accepted PORT store): %d" % len(unobserved))
   85: for u in unobserved:
   86:     print("  %s 0x%x by %s at %d latch-clear=%s" % u)
   87: print("LATCH-CLEAR REFUSALS: %d" % len(latch_clear))
   88: for lc in latch_clear:
   89:     print("  %-3s 0x%-18x by %s at %d observed=%s" % lc)
   90: bits_alone = sorted({(v & ~7).bit_length() - 1 for _l, v, _w, _a, ob in latch_clear
   91:                      if ob and (v & ~7) and ((v & ~7) & ((v & ~7) - 1)) == 0})
   92: print("TESTED BITS HELD ALONE AT LATCH-CLEAR (observed): %s -> %d of 61" % (bits_alone, len(bits_alone)))
   93: print("SIM_DONE")
