FILE GXEMUL-SEC\regress\gate_mips_folds.sh
    1: #!/bin/bash
    2: # GATE 16 -- MIPS instruction-combiner ("fold") witness (#388).
    3: #
    4: # What this protects
    5: # -----------------
    6: # The nine MIPS COMBINE sites install 34 fold-handler variants, and before #388
    7: # NOTHING could witness one firing: most folds are architecturally transparent
    8: # by construction, so any result-asserting row passes whether or not the fold
    9: # fires -- the recorded vacuity mode. #388 added pull-only install/fire counters
   10: # (cpu_mips.h) printed by tlbdump as a prefix-bound MFOLD block. This gate runs
   11: # regress/mips_fold_probe.py, whose rows drive real fold loops free-running
   12: # (never step -- combining gates on !single_step) with a breakpoint AFTER each
   13: # sequence on a NON-ARMING instruction, and grades the counters as EQUALITIES
   14: # derived from the read-ahead rule (a breakpoint anywhere disables read-ahead
   15: # machine-wide, so fire == passes-1; the derivations live in the probe's rows).
   16: #
   17: # Non-vacuity: deleting the bne_samepage_nop replacement sub-arm (incl. its
   18: # install++) in a scratch build flips exactly that fold to (0,0) and reddens
   19: # its two rows while every other row stays green -- measured 2026-08-12
   20: # (M388MUT_PASS), the per-variant attribution -J cannot give.
   21: #
   22: # The BE rows are the first big-endian MIPS guest executions in this harness;
   23: # the mlw2v* value rows additionally witness the _be generated body's BE32
   24: # assembly + sign extension, not just its selection.
   25: set -u
   26: cd "$(dirname "$0")"
   27: . ./lib.sh
   28: 
   29: gate_begin "gate 16: MIPS fold witness (#388)"
   30: 
   31: PMAX=${PMAX:-$ROOT/build/gxemul}
   32: PMAX_KERNEL=$ROOT/gxemul_pmax_rig/bsd
   33: 
   34: if [ ! -x "$PMAX" ]; then gate_skip "no gxemul binary at $PMAX"; fi
   35: 
   36: #  ---------------------------------------------------------------------------------------
   37: #  #549 fbctrlportkill: dev_fbctrl.c's PORT selector, on -E testmips.  Before #549 the PORT
   38: #  arm STORED the selector as an int with only a warning: 9 made the next DATA access end the
   39: #  emulator in the DATA arm's range check, and a wide value was truncated onto a legal port.
   40: #  #549 refuses any selector >= 8 (the previous one is kept) and announces the refusal once.
   41: #  regress/fbctrl_port_probe.py drives real guest sb/sh/sw/sd/lw/ld on an unmodified
   42: #  testmips -- no kernel, no rig image -- so it runs BEFORE
   43: #  this gate's pmax-kernel check: a missing kernel still skips the fold rows below, and
   44: #  gate_skip reports FAIL, not SKIP, if an fbctrl row failed first.
   45: #
   46: #  THE CONTRACT is the probe's header (its ENUMERATION and NOT CLAIMED).  Variant table 6
   47: #  (regress/artifacts/fbctrlportkill_20260924/table6/TABLE.out) built 297 edits -- table 5's
   48: #  212 (one one-axis edit GENERATED for every cell the header lists, table5/CELLMAP.out), the
   49: #  verifying pass's equivalents and behaviour changers, its three bit-range narrowings of the
   50: #  compare and their control, a one-bit narrowing for EVERY bit 3-63 (60 edits, bit 8's being the
   51: #  control MK_b8_ctl), four one-width
   52: #  narrowings, and three measured disclosures -- each with its prediction written first
   53: #  (table6/MANIFEST.out): the 267 the contract does not disclose are ALL red, HEAD's own arm
   54: #  among them (M_revert, 54/117 here, and sessions K and R ended the process); the 30 it
   55: #  discloses score 117/117 -- a process-global latch, a serial-number condition, three edits of
   56: #  the DATA arm's kept check, two joint cells, one value no row writes, thirteen equivalent
   57: #  edits, two DATA-width edits, three refusal-time cell writes no row reads back, three announce
   58: #  forms keyed to one value, a value range or a value class no first refusal belongs to, and the
   59: #  announce without its trailing newline.  Every RED/GREEN prediction held, and every one-bit and
   60: #  one-width narrowing reddened session B's rows at exactly the widths that carry its bit, as the
   61: #  pre-table addendum named (PRETABLE_ADDENDUM_t6.out) -- other sessions' rows red too where their
   62: #  refused value is decisive on that bit alone.  Two more classes are disclosed after table 6,
   63: #  each measured at the full score: the latch crossed with one bit (NOT CLAIMED (0)) and a refusal
   64: #  that writes a value's only anchor (NOT CLAIMED (3)) -- opus549_measured/f2v6/TABLE_f2v6.out.  Session B -- every single-bit value at each width -- is v6's
   65: #  repair of a floor breach the verifying pass MEASURED: the compare narrowed to ignore bits 9-31
   66: #  scored the full 111 rows of v5 and brought back the DATA arm's exit
   67: #  (opus549_measured/c3/TABLE_mask.out).  The device still ends the process through its command
   68: #  and offset defaults, which are filed, not claimed.
   69: #
   70: #  `gatedevicesplit` is OWED (#498): one more device probe in a CPU gate, as #548 added to
   71: #  gate 14.  Recorded, not compounded silently.
   72: FBCLOG=$LOGDIR/fbctrl_port_probe.log
   73: fbrc=0
   74: python3 -u fbctrl_port_probe.py "$PMAX" > "$FBCLOG" 2>&1 || fbrc=$?
   75: if [ "$(grep -cx 'FBCTRLP_DONE' "$FBCLOG")" != "1" ] ||
   76:    [ "$(grep -c '^FBCTRLP_RESULT=' "$FBCLOG")" != "1" ] ||
   77:    ! grep -Eq '^FBCTRLP_RESULT=(0|[1-9][0-9]*)/(0|[1-9][0-9]*)$' "$FBCLOG" ||
   78:    [ "$(grep -c '^FBCTRLP_CONTROL=' "$FBCLOG")" != "1" ] ||
   79:    ! grep -Eq '^FBCTRLP_CONTROL=(OK|FAILED)$' "$FBCLOG"; then
   80:     note "fbctrl probe produced no unique, complete record; last lines follow"
   81:     tail -5 "$FBCLOG" | sed 's/^/       /'
   82:     check "fbctrl probe output parses" "no" "yes"
   83: else
   84:     check "fbctrl probe output parses" "yes" "yes"
   85:     grep -E '^  FAIL ' "$FBCLOG" | sed 's/^/       /'
   86:     check "fbctrl probe controls" "$(sed -n 's/^FBCTRLP_CONTROL=//p' "$FBCLOG")" "OK"
   87:     #  The probe exits nonzero on a crash OR a red row (#549 F2), so this is a second catcher
   88:     #  of a red score, not only of a Python failure.
   89:     check "fbctrl probe exit 0 (nonzero: a crash or a red row)" "$fbrc" "0"
   90:     fbres=$(sed -n 's/^FBCTRLP_RESULT=//p' "$FBCLOG")
   91:     #  Pinned UNQUOTED under a one-token stem, so check_score_claims.py sees the pin.  The
   92:     #  quoted numerator is inert to that tool BY DESIGN -- it reads only the denominator's
   93:     #  line -- and the exit row above and the two reconciliation rows below are what catch a
   94:     #  red or an edited score.
   95:     check "fbctrl_port rows run" "${fbres#*/}" 117
   96:     check "fbctrl_port rows correct" "${fbres%/*}" "117"
   97:     check "fbctrl_port rows failed" "$(grep -c '^  FAIL ' "$FBCLOG")" "0"
   98:     #  RECONCILE the rows the probe PRINTED with the trailer it printed (#549 F2, measured by
   99:     #  the Opus seat): checking the trailer alone, a log with one row deleted and its
  100:     #  RESULT line intact passed every check above.
  101:     check "fbctrl_port rows emitted match the trailer total" \
  102:           "$(grep -cE '^  (ok|FAIL) ' "$FBCLOG")" "${fbres#*/}"
  103:     check "fbctrl_port ok rows match the trailer count" \
  104:           "$(grep -c '^  ok ' "$FBCLOG")" "${fbres%/*}"
  105:     #  And each row name prints ONCE: a row replaced by a copy of another keeps every count
  106:     #  above intact (the closing pass's grok seat), and only the names can tell.
  107:     check "fbctrl_port row names are unique" \
  108:           "$(grep -E '^  (ok|FAIL) ' "$FBCLOG" | sed -E 's/^  (ok|FAIL) +//; s/ +got=.*//' |
  109:              sort | uniq -d | wc -l)" "0"
  110: fi
  111: 
  112: if [ ! -f "$PMAX_KERNEL" ]; then gate_skip "no pmax kernel at $PMAX_KERNEL"; fi
  113: 
  114: FLOG=$LOGDIR/gate_mips_folds.log
  115: python3 mips_fold_probe.py "$PMAX" "$PMAX_KERNEL" > "$FLOG" 2>&1 || true
  116: 
  117: #  #388 pass-2 (four seats convergent): a probe that STARTED but produced no
  118: #  result line is a failure of the thing under test (crash, dead emulator,
  119: #  unwritable /tmp), not preflight -- it must FAIL, not skip (lib.sh's #371
  120: #  doctrine: skip = could-not-run-at-all; the binary/kernel checks above are
  121: #  the real preflight). A silent skip here would report
  122: #  REGRESS_PASS_WITH_GAPS while removing all fold coverage.
  123: if ! grep -q "MFOLDPROBE_RESULT=" "$FLOG"; then
  124:     note "fold probe produced no result line; last lines follow"
  125:     tail -5 "$FLOG" | sed 's/^/       /'
  126: fi
  127: check "fold probe completed (result line present)" \
  128:       "$(grep -q 'MFOLDPROBE_RESULT=' "$FLOG" && echo yes || echo no)" "yes"
  129: 
  130: grep -E " ok$| FAIL$" "$FLOG" | sed 's/^/       /'
  131: 
  132: #  Every row named individually (the %-24s column keeps two-space anchoring
  133: #  satisfiable; no name is a prefix of another).
  134: for v in "bne_nop_3max" "bne_nop_tm64" "lui_ori_3max" \
  135:          "mlw2_le_3max" "mlw2v0_le_3max" "mlw2v1_le_3max" \
  136:          "mlw2_be_tm64" "mlw2v0_be_tm64" "mlw2v1_be_tm64" \
  137:          "mlw2_be_tm32" "mlw2v0_be_tm32" "mlw2v1_be_tm32" \
  138:          "mlw2_dev_tm64" "memset_3max"; do
  139:     n=$(count "$FLOG" "^$v  *.*ok$")
  140:     check "  fold row: $v" "$n" 1
