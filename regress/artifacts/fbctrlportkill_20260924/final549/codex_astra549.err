  398: 
  399: M64 = 0xffffffffffffffff
  400: 
  401: # ---------------------------------------------------------------- sessions
  402: PROG_C = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("lw", "t4", 16, None), ("lw", "t5", 0, None),
  403:           ("sw", "t6", 0, None), ("sw", "t7", 16, None),               # PORT=1 (X1), X1 = 123
  404:           ("sw", "s1", 0, None), ("sw", "t7", 16, None),               # PORT=2 (Y1), Y1 = 123
  405:           ("sw", "s0", 0, None), ("sw", "s1", 16, None),               # PORT=0 (COMMAND), DATA=2: GET_RESOLUTION
  406:           ("sw", "t6", 0, None), ("lw", "s2", 16, None),               # read X1
  407:           ("sw", "s1", 0, None), ("lw", "s3", 16, None)]               # read Y1
  408: REGS_C = [("t0", FBCTRL), ("t1", 5), ("t3", 0x2a), ("t6", 1), ("t7", 123), ("s0", 0), ("s1", 2),
  409:           ("t4", 0xdead), ("t5", 0xdead), ("s2", 0xdead), ("s3", 0xdead)]
  410: 
  411: #  A: selector p written at a rotating width and read back through PORT into s<k> (poisoned 0xdead first, so a
  412: #  read that never ran cannot pass -- selector 0 would otherwise match a register's reset value); DATA value 0x11*p
  413: #  for p >= 1, read back through DATA INTO THE SELECTOR REGISTER, which holds p before the read, never 0x11*p.
  414: #  Port 0 is COMMAND: written with NOP (0, from zr) only.
  415: ACC = [(0, "sw"), (1, "sb"), (2, "sh"), (3, "sw"), (4, "sd"), (5, "sb"), (6, "sh"), (7, "sd")]
  416: SEL_REG = ["t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8"]           # the selector values
  417: VAL_REG = ["zr", "a0", "a1", "a2", "a3", "v0", "v1", "t9"]           # the DATA values (port 0 gets zr = NOP)
  418: PORT_RB = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7"]           # PORT read-backs
  419: PROG_A, REGS_A = [], [("t0", FBCTRL)]
  420: for k, (p, w) in enumerate(ACC):
  421:     REGS_A.append((SEL_REG[k], p))
  422:     REGS_A.append((PORT_RB[k], 0xdead))
  423:     if k:
  424:         REGS_A.append((VAL_REG[k], 0x11 * p))
  425:     PROG_A.append((w, SEL_REG[k], 0, None))                            # PORT = p at width w
  426:     PROG_A.append(("lw", PORT_RB[k], 0, None))                         # read PORT
  427:     PROG_A.append(("sw", VAL_REG[k], 16, None))                        # DATA = 0x11*p (NOP for port 0)
  428: #  the DATA read-backs, one per port 1..7: re-select p, read DATA into the selector register
  429: for k, (p, w) in enumerate(ACC):
  430:     if k:
  431:         PROG_A.append(("sw", SEL_REG[k], 0, None))
  432:         PROG_A.append(("lw", SEL_REG[k], 16, None))
  433: READS_A = PORT_RB + SEL_REG[1:]
  434: 
  435: #  P: previous selector 5, then nine refusals with read-backs (the FIRST is 8), two count-only refusals, and the
  436: #  twelfth after PORT=7.  The count is sampled after the twelfth, so a latch re-armed every N refusals, N <= 11, reds.
  437: REFUSE = [("sw", "t2", 8, "8 (sw)"), ("sw", "t1", 9, "9 (sw)"), ("sw", "t3", 16, "16 (sw)"),
  438:           ("sd", "t4", 0x200000000, "0x200000000 (sd)"), ("sd", "t5", 0x100000003, "0x100000003 (sd)"),
  439:           ("sd", "t6", M64, "all-ones (sd)"), ("sw", "t7", 0xffffffff, "all-ones (sw)"),
  440:           ("sb", "t8", 0xff, "0xff (sb)"), ("sh", "t9", 0x100, "0x100 (sh)")]
  441: #  16 by sb and by sh, each read back into a register whose own value (0x200000000, 0x100000003) is spent by then and
  442: #  can never read as 5 -- so an ignored read, or a session that died, reds the row too.
  443: EXTRA = [("sb", "t3", "t4", "16 (sb)"), ("sh", "t3", "t5", "16 (sh)")]
  444: READ_P = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "v0"]
  445: PROG_P = [("sw", "a0", 0, None), ("sw", "a1", 16, None)]
  446: REGS_P = [("t0", FBCTRL), ("a0", 5), ("a1", 0x2a), ("a2", 7)]
  447: for k, (w, r, v, _n) in enumerate(REFUSE):
  448:     REGS_P.append((r, v))
  449:     if k:
  450:         PROG_P.append(("sw", "a0", 0, None))                   # a fresh PORT=5 before every later refusal
  451:     PROG_P.append((w, r, 0, "r%d" % k))
  452:     PROG_P.append(("lw", READ_P[k], 0, None))
  453: for w, r, rb, _n in EXTRA:
  454:     PROG_P += [("sw", "a0", 0, None), (w, r, 0, None), ("lw", rb, 0, None)]
  455: PROG_P += [("sw", "a2", 0, None), ("sw", "t1", 0, "r11"), ("lw", "v1", 0, None)]


