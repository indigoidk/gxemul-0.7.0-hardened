== fix
  session KW SURVIVED  steps=5/5 exit=0 once=1
KW status=SURVIVED steps=5/5 exit=0 DATA read=0x0
KW_DONE
== E_ref_cmd
  session KW HOST-DIED steps=4/5 exit=1 once=0
KW status=HOST-DIED steps=4/5 exit=1 DATA read=-
KW_DONE
== E_ref_p2
  session KW SURVIVED  steps=5/5 exit=0 once=1
KW status=SURVIVED steps=5/5 exit=0 DATA read=0x0
KW_DONE
