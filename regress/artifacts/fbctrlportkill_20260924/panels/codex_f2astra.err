 268:  *
 269:  *  Calls machine_new(), adds the new machine into the emul struct, and
 270:  *  returns a pointer to the new machine.
 271:  *
 272:  *  This function should be used instead of manually calling machine_new().
 273:  */
 274: struct machine *emul_add_machine(struct emul *e, char *name)
 275: {
 276: 	struct machine *m;
 277: 	char tmpstr[32];
 278: 	int i;
 279: 
 280: 	m = machine_new(name, e, e->n_machines);
 281: 	m->serial_nr = (e->next_serial_nr ++);
 282: 
 283: 	i = e->n_machines ++;
 284: 
 285: 	/*
 286: 	 *  When emulating more than one machine, use separate terminal
 287: 	 *  windows for each:
 288: 	 */
 289: 	if (e->n_machines > 1)
 290: 		console_allow_slaves(1);
 291: 
 292: 	CHECK_ALLOCATION(e->machines = (struct machine **) realloc(e->machines,
 293: 	    sizeof(struct machine *) * e->n_machines));
 294: 
 295: 	e->machines[i] = m;
 296: 
 297: 	snprintf(tmpstr, sizeof(tmpstr), "machine[%i]", i);
 298: 	settings_add(e->settings, tmpstr, 1, SETTINGS_TYPE_SUBSETTINGS, 0,
 299: 	    e->machines[i]->settings);
 300: 
 301: 	return m;
 302: }
