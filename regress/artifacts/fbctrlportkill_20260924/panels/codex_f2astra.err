 302: PROG_P += [("sw", "a2", 0, None), ("sw", "t1", 0, "r9"), ("lw", "v1", 0, None)]
 303: READS_P = READ_P + ["v1"]
 304: 
 305: PROG_K = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("sw", "t2", 0, None), ("lw", "s0", 16, None),
 306:           ("sw", "t4", 16, None), ("sw", "t1", 0, None), ("lw", "s1", 16, None)]
 307: REGS_K = [("t0", FBCTRL), ("t1", 5), ("t3", 0x2a), ("t2", 9), ("t4", 0x77), ("s0", 0xdead), ("s1", 0xdead)]
 308: 
 309: PROG_F = [("sw", "t1", 0, None)]
 310: REGS_F = [("t0", FBCTRL), ("t1", 9)]
 311: 
 312: 
 313: def main():
 314:     stub = stub_path()
 315:     try:
 316:         C = session("C", PROG_C, REGS_C, ["t4", "t5", "s2"], stub)
 317:         A = session("A", PROG_A, REGS_A, READS_A, stub)
 318:         P = session("P", PROG_P, REGS_P, READS_P, stub)
