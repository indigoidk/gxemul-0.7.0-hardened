#!/bin/bash
S=/mnt/c/DocumentNoSnc/cc/GXEMUL
A=$S/GXEMUL-SEC/regress/artifacts/fbctrlportkill_20260924/opus549_measured/p2
C=/tmp/gxopus549p2; W=/tmp/gxopus549p2_gate
rm -rf $W; mkdir -p $W
G=$C/regress/gate_mips_folds.sh
s=$(grep -n '^FBCLOG=' $G | cut -d: -f1)
e=$(awk -v s=$s 'NR>s && /^fi$/ {print NR; exit}' $G)
sed -n "${s},${e}p" $G > $W/block.sh
echo "block lines $s-$e ($(wc -l < $W/block.sh))"; cp $W/block.sh $A/gate16_block_extracted.sh
cp $C/regress/lib.sh $W/
cp $A/probe_build_gxemul.out $W/good.log
GOOD=$W/good.log
mk() { # name then content generator
  cat > $W/fixture_$1.log
}
cat $GOOD > /dev/null
mk good < $GOOD
: | mk empty
cat $GOOD $GOOD | mk dup
head -n $(( $(wc -l < $GOOD) - 1 )) $GOOD | mk trunc_nodone
grep -v '^FBCTRLP_RESULT=' $GOOD | mk no_result
grep -v '^FBCTRLP_CONTROL=' $GOOD | mk no_control
head -n 20 $GOOD | mk trunc_mid
{ grep -v '^FBCTRLP_DONE' $GOOD; echo FBCTRLP_DONE; echo FBCTRLP_DONE; } | mk dup_done
sed 's/^FBCTRLP_RESULT=41\/41$/FBCTRLP_RESULT=41\/41 /' $GOOD | mk result_trailing
{ grep -v '^FBCTRLP_RESULT=\|^FBCTRLP_DONE' $GOOD; echo 'FBCTRLP_RESULT=41/41'; echo 'FBCTRLP_RESULT=41/41'; echo FBCTRLP_DONE; } | mk dup_result
{ sed '/^  ok   refuse 9 (sw)/d' $GOOD; } | mk row_deleted
{ sed 's/^  ok   refuse 9 (sw)/  FAIL refuse 9 (sw)/' $GOOD; } | mk row_failed_result_intact
for f in good empty dup trunc_nodone no_result no_control trunc_mid dup_done result_trailing dup_result row_deleted row_failed_result_intact; do
  # fake probe: prints the fixture, exits 0
  printf 'import sys\nsys.stdout.write(open("%s").read())\n' "$W/fixture_$f.log" > $W/fbctrl_port_probe.py
  cat > $W/run.sh <<EOS
set -u
cd $W
. ./lib.sh
gate_begin "g16 block on fixture $f"
PMAX=/bin/true
$(cat $W/block.sh)
gate_end
EOS
  LOGDIR=$W/logs_$f bash $W/run.sh > $W/out_$f.txt 2>&1
  printf '%-26s %s\n' "$f" "$(grep -E 'g16 block on fixture' $W/out_$f.txt | tail -1 | sed 's/.*fixture [^:]*: //')"
done | tee $A/gate16_fixtures.out
cp $W/out_*.txt $A/ 2>/dev/null; mkdir -p $A/gate16_fixtures; cp $W/fixture_*.log $A/gate16_fixtures/



