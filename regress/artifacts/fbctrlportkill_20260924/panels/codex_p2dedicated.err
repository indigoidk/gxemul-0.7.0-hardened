regress/fbctrl_port_probe.py:249:
regress/fbctrl_port_probe.py:250:
regress/fbctrl_port_probe.py:251:def lw32(v):
regress/fbctrl_port_probe.py:252:    """what `lw` of a 32-bit device answer yields in a 64-bit register (sign-extended)"""
regress/fbctrl_port_probe.py:253:    v &= 0xffffffff
regress/fbctrl_port_probe.py:254:    return v | 0xffffffff00000000 if v & 0x80000000 else v
