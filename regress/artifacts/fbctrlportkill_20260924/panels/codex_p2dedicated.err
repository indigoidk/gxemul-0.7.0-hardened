regress/fbctrl_port_probe.py:262:          ("t4", 0xdead), ("t5", 0xdead), ("s2", 0xdead)]
regress/fbctrl_port_probe.py:263:
regress/fbctrl_port_probe.py:264:#  A: selector p written at a rotating width and read back through PORT into s<k> (poisoned 0xdead first, so a
regress/fbctrl_port_probe.py:265:#  read that never ran cannot pass -- selector 0 would otherwise match a register's reset value); DATA value 0x11*p
regress/fbctrl_port_probe.py:266:#  for p >= 1, read back through DATA INTO THE SELECTOR REGISTER, which holds p before the read, never 0x11*p.
regress/fbctrl_port_probe.py:267:#  Port 0 is COMMAND: written with NOP (0, from zr) only.
regress/fbctrl_port_probe.py:268:ACC = [(0, "sw"), (1, "sb"), (2, "sh"), (3, "sw"), (4, "sd"), (5, "sb"), (6, "sh"), (7, "sd")]
regress/fbctrl_port_probe.py:269:SEL_REG = ["t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8"]           # the selector values
regress/fbctrl_port_probe.py:270:VAL_REG = ["zr", "a0", "a1", "a2", "a3", "v0", "v1", "t9"]           # the DATA values (port 0 gets zr = NOP)
regress/fbctrl_port_probe.py:271:PORT_RB = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7"]           # PORT read-backs
regress/fbctrl_port_probe.py:272:PROG_A, REGS_A = [], [("t0", FBCTRL)]
regress/fbctrl_port_probe.py:273:for k, (p, w) in enumerate(ACC):
regress/fbctrl_port_probe.py:274:    REGS_A.append((SEL_REG[k], p))
regress/fbctrl_port_probe.py:275:    REGS_A.append((PORT_RB[k], 0xdead))
regress/fbctrl_port_probe.py:276:    if k:
regress/fbctrl_port_probe.py:277:        REGS_A.append((VAL_REG[k], 0x11 * p))
regress/fbctrl_port_probe.py:278:    PROG_A.append((w, SEL_REG[k], 0, None))                            # PORT = p at width w
regress/fbctrl_port_probe.py:279:    PROG_A.append(("lw", PORT_RB[k], 0, None))                         # read PORT
regress/fbctrl_port_probe.py:280:    PROG_A.append(("sw", VAL_REG[k], 16, None))                        # DATA = 0x11*p (NOP for port 0)
regress/fbctrl_port_probe.py:281:#  the DATA read-backs, one per port 1..7: re-select p, read DATA into the selector register
regress/fbctrl_port_probe.py:282:for k, (p, w) in enumerate(ACC):
regress/fbctrl_port_probe.py:283:    if k:
regress/fbctrl_port_probe.py:284:        PROG_A.append(("sw", SEL_REG[k], 0, None))
regress/fbctrl_port_probe.py:285:        PROG_A.append(("lw", SEL_REG[k], 16, None))
regress/fbctrl_port_probe.py:286:READS_A = PORT_RB + SEL_REG[1:]
regress/fbctrl_port_probe.py:287:
regress/fbctrl_port_probe.py:288:#  P: previous selector 5, then nine refusals, then previous 7 and one more.
regress/fbctrl_port_probe.py:289:REFUSE = [("sw", "t1", 9, "9 (sw)"), ("sw", "t2", 8, "8 (sw)"), ("sw", "t3", 16, "16 (sw)"),
regress/fbctrl_port_probe.py:290:          ("sd", "t4", 0x200000000, "0x200000000 (sd)"), ("sd", "t5", 0x100000003, "0x100000003 (sd)"),
regress/fbctrl_port_probe.py:291:          ("sd", "t6", M64, "all-ones (sd)"), ("sw", "t7", 0xffffffff, "all-ones (sw)"),
regress/fbctrl_port_probe.py:292:          ("sb", "t8", 0xff, "0xff (sb)"), ("sh", "t9", 0x100, "0x100 (sh)")]
regress/fbctrl_port_probe.py:293:READ_P = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "v0"]
regress/fbctrl_port_probe.py:294:PROG_P = [("sw", "a0", 0, None), ("sw", "a1", 16, None)]
regress/fbctrl_port_probe.py:295:REGS_P = [("t0", FBCTRL), ("a0", 5), ("a1", 0x2a), ("a2", 7)]
regress/fbctrl_port_probe.py:296:for k, (w, r, v, _n) in enumerate(REFUSE):
regress/fbctrl_port_probe.py:297:    REGS_P.append((r, v))
regress/fbctrl_port_probe.py:298:    if k:
regress/fbctrl_port_probe.py:299:        PROG_P.append(("sw", "a0", 0, None))                   # a fresh PORT=5 before every later refusal
regress/fbctrl_port_probe.py:300:    PROG_P.append((w, r, 0, "r%d" % k))
regress/fbctrl_port_probe.py:301:    PROG_P.append(("lw", READ_P[k], 0, None))
regress/fbctrl_port_probe.py:302:PROG_P += [("sw", "a2", 0, None), ("sw", "t1", 0, "r9"), ("lw", "v1", 0, None)]
regress/fbctrl_port_probe.py:303:READS_P = READ_P + ["v1"]
regress/fbctrl_port_probe.py:304:
regress/fbctrl_port_probe.py:305:PROG_K = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("sw", "t2", 0, None), ("lw", "s0", 16, None),
regress/fbctrl_port_probe.py:306:          ("sw", "t4", 16, None), ("sw", "t1", 0, None), ("lw", "s1", 16, None)]
regress/fbctrl_port_probe.py:307:REGS_K = [("t0", FBCTRL), ("t1", 5), ("t3", 0x2a), ("t2", 9), ("t4", 0x77), ("s0", 0xdead), ("s1", 0xdead)]
regress/fbctrl_port_probe.py:308:
regress/fbctrl_port_probe.py:309:PROG_F = [("sw", "t1", 0, None)]
regress/fbctrl_port_probe.py:310:REGS_F = [("t0", FBCTRL), ("t1", 9)]
regress/fbctrl_port_probe.py:311:
regress/fbctrl_port_probe.py:312:
regress/fbctrl_port_probe.py:313:def main():
regress/fbctrl_port_probe.py:314:    stub = stub_path()
regress/fbctrl_port_probe.py:315:    try:
regress/fbctrl_port_probe.py:316:        C = session("C", PROG_C, REGS_C, ["t4", "t5", "s2"], stub)
regress/fbctrl_port_probe.py:317:        A = session("A", PROG_A, REGS_A, READS_A, stub)
regress/fbctrl_port_probe.py:318:        P = session("P", PROG_P, REGS_P, READS_P, stub)
regress/fbctrl_port_probe.py:319:        K = session("K", PROG_K, REGS_K, ["s0", "s1"], stub)
regress/fbctrl_port_probe.py:320:        F = session("F", PROG_F, REGS_F, [], stub, free_run=True)
regress/fbctrl_port_probe.py:321:    finally:
regress/fbctrl_port_probe.py:322:        try:
regress/fbctrl_port_probe.py:323:            os.unlink(stub)
regress/fbctrl_port_probe.py:324:        except OSError:
regress/fbctrl_port_probe.py:325:            pass
regress/fbctrl_port_probe.py:326:    ctl = []
regress/fbctrl_port_probe.py:327:    print("CONTROLS")
regress/fbctrl_port_probe.py:328:    ctl.append(row("C every step survived", "%s %d/%d" % (C["status"], C["steps"], C["n"]),
regress/fbctrl_port_probe.py:329:                   "SURVIVED %d/%d" % (len(PROG_C), len(PROG_C))))
regress/fbctrl_port_probe.py:330:    ctl.append(row("C disassembly of every stepped word", len(C["badis"]), 0))
regress/fbctrl_port_probe.py:331:    ctl.append(row("C LIVENESS: DATA round-trips 0x2a", hx(C["vals"].get("t4")), "0x2a"))
regress/fbctrl_port_probe.py:332:    ctl.append(row("C LIVENESS: PORT reads back 5", hx(C["vals"].get("t5")), "0x5"))
regress/fbctrl_port_probe.py:333:    ctl.append(row("C SIGNATURE: X1 zeroed by GET_RESOLUTION", hx(C["vals"].get("s2")), "0x0",
regress/fbctrl_port_probe.py:334:                   "(RAM: 2; banked w/o command: 123)"))
regress/fbctrl_port_probe.py:335:    row("C nothing refused, no (once) line", len(ONCE_RE.findall(C["buf"])), 0)
regress/fbctrl_port_probe.py:336:    for S in (A, P, K):
regress/fbctrl_port_probe.py:337:        ctl.append(row("%s disassembly of every stepped word" % "APK"[(A, P, K).index(S)], len(S["badis"]), 0))
regress/fbctrl_port_probe.py:338:    print("ACCEPT (session A: %s %d/%d)" % (A["status"], A["steps"], A["n"]))
regress/fbctrl_port_probe.py:339:    for k, (p, w) in enumerate(ACC):
regress/fbctrl_port_probe.py:340:        row("accept selector %d written by %s" % (p, w), hx(A["vals"].get(PORT_RB[k])), hx(p))
regress/fbctrl_port_probe.py:341:    for k, (p, w) in enumerate(ACC):
regress/fbctrl_port_probe.py:342:        if k:
regress/fbctrl_port_probe.py:343:            row("port %d round-trips its DATA value" % p, hx(A["vals"].get(SEL_REG[k])), hx(0x11 * p))
regress/fbctrl_port_probe.py:344:    print("REFUSE (session P: %s %d/%d)" % (P["status"], P["steps"], P["n"]))
regress/fbctrl_port_probe.py:345:    for k, (w, r, v, name) in enumerate(REFUSE):
regress/fbctrl_port_probe.py:346:        row("refuse %s, PORT keeps 5" % name, hx(P["vals"].get(READ_P[k])), "0x5")
regress/fbctrl_port_probe.py:347:    row("refuse 9 after PORT=7, PORT keeps 7", hx(P["vals"].get("v1")), "0x7")
regress/fbctrl_port_probe.py:348:    row("announce: exactly 1 right after the FIRST refusal", P["once_after"].get("r0"), 1)
regress/fbctrl_port_probe.py:349:    row("announce: still exactly 1 after ten refusals", P["once_after"].get("r9"), 1)
regress/fbctrl_port_probe.py:350:    print("THE WITNESS PAIR (session K)")
regress/fbctrl_port_probe.py:351:    row("K survives DATA after a refused PORT write", "%s %d/%d" % (K["status"], K["steps"], K["n"]),
regress/fbctrl_port_probe.py:352:        "SURVIVED %d/%d" % (len(PROG_K), len(PROG_K)))
regress/fbctrl_port_probe.py:353:    row("K DATA read after the refusal is port 5's", hx(K["vals"].get("s0")), "0x2a")
regress/fbctrl_port_probe.py:354:    row("K DATA write after the refusal lands in port 5", hx(K["vals"].get("s1")), "0x77")
regress/fbctrl_port_probe.py:355:    print("FREE-RUNNING (session F)")
regress/fbctrl_port_probe.py:356:    row("F free-run reached its breakpoint", F["status"], "SURVIVED")
regress/fbctrl_port_probe.py:357:    row("F refusal announced while free-running (fatal)", F["once_after"].get("free"), 1)
regress/fbctrl_port_probe.py:358:    control = all(ctl)
regress/fbctrl_port_probe.py:359:    n_ok, n = sum(RESULTS), len(RESULTS)
regress/fbctrl_port_probe.py:360:    print("FBCTRLP_CONTROL=%s" % ("OK" if control else "FAILED"))
regress/fbctrl_port_probe.py:361:    print("FBCTRLP_RESULT=%d/%d" % (n_ok, n))
regress/fbctrl_port_probe.py:362:    print("FBCTRLP_DONE")
regress/fbctrl_port_probe.py:363:
regress/fbctrl_port_probe.py:364:
regress/fbctrl_port_probe.py:365:if __name__ == "__main__":
regress/fbctrl_port_probe.py:366:    main()
regress/gate_mips_folds.sh:1:#!/bin/bash
regress/gate_mips_folds.sh:2:# GATE 16 -- MIPS instruction-combiner ("fold") witness (#388).
regress/gate_mips_folds.sh:3:#
regress/gate_mips_folds.sh:4:# What this protects
regress/gate_mips_folds.sh:5:# -----------------
regress/gate_mips_folds.sh:6:# The nine MIPS COMBINE sites install 34 fold-handler variants, and before #388
regress/gate_mips_folds.sh:7:# NOTHING could witness one firing: most folds are architecturally transparent
regress/gate_mips_folds.sh:8:# by construction, so any result-asserting row passes whether or not the fold
regress/gate_mips_folds.sh:9:# fires -- the recorded vacuity mode. #388 added pull-only install/fire counters
regress/gate_mips_folds.sh:10:# (cpu_mips.h) printed by tlbdump as a prefix-bound MFOLD block. This gate runs
regress/gate_mips_folds.sh:11:# regress/mips_fold_probe.py, whose rows drive real fold loops free-running
regress/gate_mips_folds.sh:12:# (never step -- combining gates on !single_step) with a breakpoint AFTER each
regress/gate_mips_folds.sh:13:# sequence on a NON-ARMING instruction, and grades the counters as EQUALITIES
regress/gate_mips_folds.sh:14:# derived from the read-ahead rule (a breakpoint anywhere disables read-ahead
regress/gate_mips_folds.sh:15:# machine-wide, so fire == passes-1; the derivations live in the probe's rows).
regress/gate_mips_folds.sh:16:#
regress/gate_mips_folds.sh:17:# Non-vacuity: deleting the bne_samepage_nop replacement sub-arm (incl. its
regress/gate_mips_folds.sh:18:# install++) in a scratch build flips exactly that fold to (0,0) and reddens
regress/gate_mips_folds.sh:19:# its two rows while every other row stays green -- measured 2026-08-12
regress/gate_mips_folds.sh:20:# (M388MUT_PASS), the per-variant attribution -J cannot give.
regress/gate_mips_folds.sh:21:#
regress/gate_mips_folds.sh:22:# The BE rows are the first big-endian MIPS guest executions in this harness;
regress/gate_mips_folds.sh:23:# the mlw2v* value rows additionally witness the _be generated body's BE32
regress/gate_mips_folds.sh:24:# assembly + sign extension, not just its selection.
regress/gate_mips_folds.sh:25:set -u
regress/gate_mips_folds.sh:26:cd "$(dirname "$0")"
regress/gate_mips_folds.sh:27:. ./lib.sh
regress/gate_mips_folds.sh:28:
regress/gate_mips_folds.sh:29:gate_begin "gate 16: MIPS fold witness (#388)"
regress/gate_mips_folds.sh:30:
regress/gate_mips_folds.sh:31:PMAX=${PMAX:-$ROOT/build/gxemul}
regress/gate_mips_folds.sh:32:PMAX_KERNEL=$ROOT/gxemul_pmax_rig/bsd
regress/gate_mips_folds.sh:33:
regress/gate_mips_folds.sh:34:if [ ! -x "$PMAX" ]; then gate_skip "no gxemul binary at $PMAX"; fi
regress/gate_mips_folds.sh:35:
regress/gate_mips_folds.sh:36:#  ---------------------------------------------------------------------------------------
regress/gate_mips_folds.sh:37:#  #549 fbctrlportkill: dev_fbctrl.c's PORT selector, on -E testmips.  Before #549 a guest
regress/gate_mips_folds.sh:38:#  store of 8 or more to PORT was STORED with only a warning, and the next DATA access ended
regress/gate_mips_folds.sh:39:#  the emulator in the DATA arm's range check.  #549 refuses the selector (the previous one
regress/gate_mips_folds.sh:40:#  is kept) and announces the refusal once.  regress/fbctrl_port_probe.py drives real guest
regress/gate_mips_folds.sh:41:#  sb/sh/sw/sd/lw on an unmodified testmips -- no kernel, no rig image -- so it runs BEFORE
regress/gate_mips_folds.sh:42:#  this gate's pmax-kernel check: a missing kernel still skips the fold rows below, and
regress/gate_mips_folds.sh:43:#  gate_skip reports FAIL, not SKIP, if an fbctrl row failed first.
regress/gate_mips_folds.sh:44:#
regress/gate_mips_folds.sh:45:#  THE CONTRACT is the probe's header (CATCHES / NOT CLAIMED).  Kill table 1 was red on 20 of
regress/gate_mips_folds.sh:46:#  20 edits of the fix's own predicate, store and latch; a process-global latch and the
regress/gate_mips_folds.sh:47:#  deletion of the DATA arm's kept check are DISCLOSED escapes; and the device still ends the
regress/gate_mips_folds.sh:48:#  process through its command and offset defaults, which are filed, not claimed.  HEAD before
regress/gate_mips_folds.sh:49:#  #549 scored 25/41 here, every refusal row red.
regress/gate_mips_folds.sh:50:#
regress/gate_mips_folds.sh:51:#  `gatedevicesplit` is OWED (#498): one more device probe in a CPU gate, as #548 added to
regress/gate_mips_folds.sh:52:#  gate 14.  Recorded, not compounded silently.
regress/gate_mips_folds.sh:53:FBCLOG=$LOGDIR/fbctrl_port_probe.log
regress/gate_mips_folds.sh:54:fbrc=0
regress/gate_mips_folds.sh:55:python3 -u fbctrl_port_probe.py "$PMAX" > "$FBCLOG" 2>&1 || fbrc=$?
regress/gate_mips_folds.sh:56:if [ "$(grep -cx 'FBCTRLP_DONE' "$FBCLOG")" != "1" ] ||
regress/gate_mips_folds.sh:57:   [ "$(grep -c '^FBCTRLP_RESULT=' "$FBCLOG")" != "1" ] ||
regress/gate_mips_folds.sh:58:   ! grep -Eq '^FBCTRLP_RESULT=(0|[1-9][0-9]*)/(0|[1-9][0-9]*)$' "$FBCLOG" ||
regress/gate_mips_folds.sh:59:   [ "$(grep -c '^FBCTRLP_CONTROL=' "$FBCLOG")" != "1" ] ||
regress/gate_mips_folds.sh:60:   ! grep -Eq '^FBCTRLP_CONTROL=(OK|FAILED)$' "$FBCLOG"; then
regress/gate_mips_folds.sh:61:    note "fbctrl probe produced no unique, complete record; last lines follow"
regress/gate_mips_folds.sh:62:    tail -5 "$FBCLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:63:    check "fbctrl probe output parses" "no" "yes"
regress/gate_mips_folds.sh:64:else
regress/gate_mips_folds.sh:65:    check "fbctrl probe output parses" "yes" "yes"
regress/gate_mips_folds.sh:66:    grep -E '^  FAIL ' "$FBCLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:67:    check "fbctrl probe controls" "$(sed -n 's/^FBCTRLP_CONTROL=//p' "$FBCLOG")" "OK"
regress/gate_mips_folds.sh:68:    check "fbctrl probe exit status" "$fbrc" "0"
regress/gate_mips_folds.sh:69:    fbres=$(sed -n 's/^FBCTRLP_RESULT=//p' "$FBCLOG")
regress/gate_mips_folds.sh:70:    #  Pinned UNQUOTED under a one-token stem, so check_score_claims.py sees the pin.
regress/gate_mips_folds.sh:71:    check "fbctrl_port rows run" "${fbres#*/}" 41
regress/gate_mips_folds.sh:72:    check "fbctrl_port rows correct" "${fbres%/*}" "41"
regress/gate_mips_folds.sh:73:    check "fbctrl_port rows failed" "$(grep -c '^  FAIL ' "$FBCLOG")" "0"
regress/gate_mips_folds.sh:74:fi
regress/gate_mips_folds.sh:75:
regress/gate_mips_folds.sh:76:if [ ! -f "$PMAX_KERNEL" ]; then gate_skip "no pmax kernel at $PMAX_KERNEL"; fi
regress/gate_mips_folds.sh:77:
regress/gate_mips_folds.sh:78:FLOG=$LOGDIR/gate_mips_folds.log
regress/gate_mips_folds.sh:79:python3 mips_fold_probe.py "$PMAX" "$PMAX_KERNEL" > "$FLOG" 2>&1 || true
regress/gate_mips_folds.sh:80:
regress/gate_mips_folds.sh:81:#  #388 pass-2 (four seats convergent): a probe that STARTED but produced no
regress/gate_mips_folds.sh:82:#  result line is a failure of the thing under test (crash, dead emulator,
regress/gate_mips_folds.sh:83:#  unwritable /tmp), not preflight -- it must FAIL, not skip (lib.sh's #371
regress/gate_mips_folds.sh:84:#  doctrine: skip = could-not-run-at-all; the binary/kernel checks above are
regress/gate_mips_folds.sh:85:#  the real preflight). A silent skip here would report
regress/gate_mips_folds.sh:86:#  REGRESS_PASS_WITH_GAPS while removing all fold coverage.
regress/gate_mips_folds.sh:87:if ! grep -q "MFOLDPROBE_RESULT=" "$FLOG"; then
regress/gate_mips_folds.sh:88:    note "fold probe produced no result line; last lines follow"
regress/gate_mips_folds.sh:89:    tail -5 "$FLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:90:fi
regress/gate_mips_folds.sh:91:check "fold probe completed (result line present)" \
regress/gate_mips_folds.sh:92:      "$(grep -q 'MFOLDPROBE_RESULT=' "$FLOG" && echo yes || echo no)" "yes"
regress/gate_mips_folds.sh:93:
regress/gate_mips_folds.sh:94:grep -E " ok$| FAIL$" "$FLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:95:
regress/gate_mips_folds.sh:96:#  Every row named individually (the %-24s column keeps two-space anchoring
regress/gate_mips_folds.sh:97:#  satisfiable; no name is a prefix of another).
regress/gate_mips_folds.sh:98:for v in "bne_nop_3max" "bne_nop_tm64" "lui_ori_3max" \
regress/gate_mips_folds.sh:99:         "mlw2_le_3max" "mlw2v0_le_3max" "mlw2v1_le_3max" \
regress/gate_mips_folds.sh:100:         "mlw2_be_tm64" "mlw2v0_be_tm64" "mlw2v1_be_tm64" \
regress/gate_mips_folds.sh:101:         "mlw2_be_tm32" "mlw2v0_be_tm32" "mlw2v1_be_tm32" \
regress/gate_mips_folds.sh:102:         "mlw2_dev_tm64" "memset_3max"; do
regress/gate_mips_folds.sh:103:    n=$(count "$FLOG" "^$v  *.*ok$")
regress/gate_mips_folds.sh:104:    check "  fold row: $v" "$n" 1
regress/gate_mips_folds.sh:105:done
regress/gate_mips_folds.sh:106:
regress/gate_mips_folds.sh:107:fctrl=$(grep -o "MFOLDPROBE_CONTROL=[A-Z]*" "$FLOG" | tail -1 | cut -d= -f2)
regress/gate_mips_folds.sh:108:check "fold probe control (parse liveness)" "${fctrl:-missing}" "OK"
regress/gate_mips_folds.sh:109:
regress/gate_mips_folds.sh:110:fres=$(grep -o "MFOLDPROBE_RESULT=[0-9]*/[0-9]*" "$FLOG" | tail -1 | cut -d= -f2)
regress/gate_mips_folds.sh:111:check "fold rows correct" "${fres:-missing}" "14/14"
regress/gate_mips_folds.sh:112:
regress/gate_mips_folds.sh:113:gate_end

