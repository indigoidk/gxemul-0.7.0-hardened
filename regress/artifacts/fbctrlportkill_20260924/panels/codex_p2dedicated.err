98-
99-	if (byte_order == EMUL_LITTLE_ENDIAN)
100-		for (i=0; i<len; i++) {
101-			buf[i] = data & 255;
102-			data >>= 8;
103-		}
104-	else
105-		for (i=0; i<len; i++) {
106-			buf[len - 1 - i] = data & 255;
107-			data >>= 8;
108-		}
