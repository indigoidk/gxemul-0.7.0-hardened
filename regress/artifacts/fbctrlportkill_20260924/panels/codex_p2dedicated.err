regress/fbctrl_port_probe.py:94:def session(label, prog, regs, reads, stub, free_run=False):
regress/fbctrl_port_probe.py:95:    """prog: list of (op, rt, off, tag).  Steps each (or free-runs to an anchor after the last), then prints reads.
regress/fbctrl_port_probe.py:96:    Returns dict: status, exit, badis, vals, once_after (tag -> cumulative (once) count right after that step), buf."""
regress/fbctrl_port_probe.py:97:    pid, fd = pty.fork()
regress/fbctrl_port_probe.py:98:    if pid == 0:
regress/fbctrl_port_probe.py:99:        os.execvp(BIN, [BIN, "-V", "-E", "testmips", "-M", "64", "0x%x:%s" % (STUBADDR, stub)])
regress/fbctrl_port_probe.py:100:        os._exit(127)
regress/fbctrl_port_probe.py:101:    buf = ""
regress/fbctrl_port_probe.py:102:    dead = [False]
regress/fbctrl_port_probe.py:103:
regress/fbctrl_port_probe.py:104:    def rd(t=0.4):
regress/fbctrl_port_probe.py:105:        nonlocal buf
regress/fbctrl_port_probe.py:106:        r, _, _ = select.select([fd], [], [], t)
regress/fbctrl_port_probe.py:107:        if fd not in r:
regress/fbctrl_port_probe.py:108:            return True
regress/fbctrl_port_probe.py:109:        try:
regress/fbctrl_port_probe.py:110:            d = os.read(fd, 65536)
regress/fbctrl_port_probe.py:111:        except OSError:
regress/fbctrl_port_probe.py:112:            dead[0] = True
regress/fbctrl_port_probe.py:113:            return False
regress/fbctrl_port_probe.py:114:        if not d:
regress/fbctrl_port_probe.py:115:            dead[0] = True
regress/fbctrl_port_probe.py:116:            return False
regress/fbctrl_port_probe.py:117:        buf += d.decode("latin1", "replace")
regress/fbctrl_port_probe.py:118:        return True
regress/fbctrl_port_probe.py:119:
regress/fbctrl_port_probe.py:120:    def wait(mark=0, echo=None, timeout=60):
regress/fbctrl_port_probe.py:121:        t = time.time()
regress/fbctrl_port_probe.py:122:        while time.time() - t < timeout:
regress/fbctrl_port_probe.py:123:            if not rd():
regress/fbctrl_port_probe.py:124:                return False
regress/fbctrl_port_probe.py:125:            resp = buf[mark:]
regress/fbctrl_port_probe.py:126:            if echo is not None and echo not in resp:
regress/fbctrl_port_probe.py:127:                continue
regress/fbctrl_port_probe.py:128:            if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
regress/fbctrl_port_probe.py:129:                return True
regress/fbctrl_port_probe.py:130:        return False
regress/fbctrl_port_probe.py:131:
regress/fbctrl_port_probe.py:132:    def send(x, timeout=60):
regress/fbctrl_port_probe.py:133:        b = (x + "\n").encode("latin1")
regress/fbctrl_port_probe.py:134:        _mark = len(buf)
regress/fbctrl_port_probe.py:135:        n = 0
regress/fbctrl_port_probe.py:136:        try:
regress/fbctrl_port_probe.py:137:            while n < len(b):
regress/fbctrl_port_probe.py:138:                n += os.write(fd, b[n:])
regress/fbctrl_port_probe.py:139:        except OSError:
regress/fbctrl_port_probe.py:140:            dead[0] = True
