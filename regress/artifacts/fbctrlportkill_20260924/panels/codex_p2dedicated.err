regress/fbctrl_port_probe.py:257:# ---------------------------------------------------------------- sessions
regress/fbctrl_port_probe.py:258:PROG_C = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("lw", "t4", 16, None), ("lw", "t5", 0, None),
regress/fbctrl_port_probe.py:259:          ("sw", "t6", 0, None), ("sw", "t7", 16, None), ("sw", "s0", 0, None), ("sw", "s1", 16, None),
regress/fbctrl_port_probe.py:260:          ("sw", "t6", 0, None), ("lw", "s2", 16, None)]
