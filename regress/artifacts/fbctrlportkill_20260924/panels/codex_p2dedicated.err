src/devices/dev_fbctrl.c:111:
src/devices/dev_fbctrl.c:112:	if (writeflag == MEM_WRITE)
src/devices/dev_fbctrl.c:113:	        idata = memory_readmax64(cpu, data, len);
src/devices/dev_fbctrl.c:114:
src/devices/dev_fbctrl.c:115:	switch (relative_addr) {
src/devices/dev_fbctrl.c:116:
src/devices/dev_fbctrl.c:117:	case DEV_FBCTRL_PORT:
src/devices/dev_fbctrl.c:118:		if (writeflag == MEM_READ)
src/devices/dev_fbctrl.c:119:			odata = d->current_port;
src/devices/dev_fbctrl.c:120:		else if (idata >= DEV_FBCTRL_NPORTS) {
src/devices/dev_fbctrl.c:121:			/*  #549: an out-of-range selector is REFUSED, and
src/devices/dev_fbctrl.c:122:			    current_port keeps its previous, always-valid value.
src/devices/dev_fbctrl.c:123:			    It used to be stored with only a warning, and the
src/devices/dev_fbctrl.c:124:			    next DATA access then ended the emulator in the
src/devices/dev_fbctrl.c:125:			    range check below.  Announced once per device.  */
src/devices/dev_fbctrl.c:126:			if (!d->warned_port) {
