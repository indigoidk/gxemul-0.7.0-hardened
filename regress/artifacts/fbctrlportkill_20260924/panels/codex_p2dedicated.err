regress/lib.sh:1:#!/bin/bash
regress/lib.sh:2:# Shared helpers for the regression gates.
regress/lib.sh:3:#
regress/lib.sh:4:# Two rules encoded here, both learned by getting them wrong:
regress/lib.sh:5:#
regress/lib.sh:6:#  1. RUN UNBUFFERED. When gxemul's stdout is a pipe, libc switches to 4 KB block
regress/lib.sh:7:#     buffering. `timeout` then kills it with SIGTERM and the partial block is lost, so a
regress/lib.sh:8:#     guest that produced 3 KB of perfectly good boot output scores ZERO bytes while one
regress/lib.sh:9:#     that produced 5 KB scores 4096. An early version of this harness compared those
regress/lib.sh:10:#     numbers across builds and "found" a capability regression that was pure buffering.
regress/lib.sh:11:#     Every emulator invocation goes through run_emu() or run_emu_progress(), both of which
regress/lib.sh:12:#     force stdbuf -o0 -e0.  (#419 note: run_emu() itself now has NO CALLERS -- gate 7 was
regress/lib.sh:13:#     its last one.  It is kept because the rule is general and a future gate will want the
regress/lib.sh:14:#     simple form, but do not cite it as the universal path: run_emu_progress() is.)
regress/lib.sh:15:#
regress/lib.sh:16:#  2. A MISSING INPUT IS A HARD ERROR, NEVER A ZERO SCORE. The same early version had no
regress/lib.sh:17:#     existence check on the baseline binaries, so a wrong path looked exactly like a
regress/lib.sh:18:#     total behavioural failure. need_file() aborts the gate instead.
regress/lib.sh:19:#
regress/lib.sh:20:# Verdicts are PASS / FAIL / SKIP. A SKIP is never counted as a PASS.
regress/lib.sh:21:
regress/lib.sh:22:ROOT=${ROOT:-/mnt/c/DocumentNoSnc/CC/GXEMUL}
regress/lib.sh:23:IMAGES=$ROOT/_images
regress/lib.sh:24:LOGDIR=${LOGDIR:-/tmp/gxregress}
regress/lib.sh:25:#  d1: EXPORT, or the driver cannot see it.  A plain assignment here reaches the gates'
regress/lib.sh:26:#  own shell redirections but NOT a python child, so drive_guest.py kept writing its two
regress/lib.sh:27:#  pty logs to the hardcoded default while every other artefact relocated -- a mutation
regress/lib.sh:28:#  census then poisoned the shared logs gate 6 grades.  Measured: without this line a
regress/lib.sh:29:#  caller who writes `LOGDIR=x ./run.sh` propagates (env-prefixed vars are exported) but a
regress/lib.sh:30:#  caller who writes `LOGDIR=x; ./run.sh` does not, so the defect was CONDITIONALLY silent.
regress/lib.sh:31:export LOGDIR
regress/lib.sh:32:mkdir -p "$LOGDIR"
regress/lib.sh:33:
regress/lib.sh:34:#  #426: classify a rig's reported budget.  IT LIVES HERE, NOT IN THE GATE, so the branch
regress/lib.sh:35:#  logic can be exercised offline by a selftest instead of only under a weekly rig boot.
regress/lib.sh:36:#  Echoes ONE DISTINGUISHABLE TOKEN per case:
regress/lib.sh:37:#    absent      the rig deliberately has no budget (landisk: its count nearly halves under
regress/lib.sh:38:#                host load, so any ceiling would be invented rather than measured)
regress/lib.sh:39:#    calibrated  a value inside the range measured for that rig
regress/lib.sh:40:#    zeroed      ZERO ON A RIG THAT IS CALIBRATED -- the case that used to print a green
regress/lib.sh:41:#                "deliberately absent".  MEASURED: a luna88k run reporting BUDGET=0 passed
regress/lib.sh:42:#                11/11 while the row said something false about a 12 G rig, and the driver's
regress/lib.sh:43:#                own ceiling went falsy at the same time.  RED, not a skip: the gate HOLDS the
regress/lib.sh:44:#                calibration, so a skip would claim an ignorance it does not have.
regress/lib.sh:45:#    out-of-range / unreported  as they say.
regress/lib.sh:46:budget_class() {
regress/lib.sh:47:    #  ${2-} because every gate here runs under `set -u`, where a one-argument call would
regress/lib.sh:48:    #  abort the gate with "$2: unbound variable" instead of classifying.  A classifier that
regress/lib.sh:49:    #  kills its caller on a malformed call is worse than one that says `unreported`.
regress/lib.sh:50:    case "${1-}:${2-}" in
regress/lib.sh:51:    landisk:0)   echo absent ;;
regress/lib.sh:52:    luna88k:0)   echo zeroed ;;
regress/lib.sh:53:    *:)          echo unreported ;;
regress/lib.sh:54:    luna88k:*)   if [ "$2" -ge 8174849291 ] 2>/dev/null && [ "$2" -le 15571141508 ]
regress/lib.sh:55:                 then echo calibrated; else echo out-of-range; fi ;;
regress/lib.sh:56:    *:0)         echo absent ;;
regress/lib.sh:57:    *)           echo uncalibrated-rig ;;
regress/lib.sh:58:    esac
regress/lib.sh:59:}
regress/lib.sh:60:
regress/lib.sh:61:C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_SKIP=$'\033[33m'; C_OFF=$'\033[0m'
regress/lib.sh:62:[ -t 1 ] || { C_OK=""; C_BAD=""; C_SKIP=""; C_OFF=""; }
regress/lib.sh:63:
regress/lib.sh:64:# Exit codes. SKIP is 77, NOT 2, because bash exits 2 on a SYNTAX ERROR -- so with 2 as
regress/lib.sh:65:# the skip code a typo in any gate was silently downgraded to "coverage gap" and run.sh
regress/lib.sh:66:# still exited 0. Anything non-zero that is not 77 is a failure.
regress/lib.sh:67:EXIT_SKIP=77
regress/lib.sh:68:
regress/lib.sh:69:GATE_NAME=""
regress/lib.sh:70:_fails=0
regress/lib.sh:71:_checks=0
regress/lib.sh:72:
regress/lib.sh:73:gate_begin() { GATE_NAME=$1; _fails=0; _checks=0
regress/lib.sh:74:    echo "############################################################"
regress/lib.sh:75:    echo "## GATE: $GATE_NAME"
regress/lib.sh:76:    echo "############################################################"
regress/lib.sh:77:}
regress/lib.sh:78:
regress/lib.sh:79:# check <description> <actual> <expected>
regress/lib.sh:80:check() {
regress/lib.sh:81:    _checks=$((_checks+1))
regress/lib.sh:82:    if [ "$2" = "$3" ]; then
regress/lib.sh:83:        printf "  ${C_OK}ok${C_OFF}   %-52s %s\n" "$1" "$2"
regress/lib.sh:84:    else
regress/lib.sh:85:        printf "  ${C_BAD}FAIL${C_OFF} %-52s got=%s want=%s\n" "$1" "$2" "$3"
regress/lib.sh:86:        _fails=$((_fails+1))
regress/lib.sh:87:    fi
regress/lib.sh:88:}
regress/lib.sh:89:
regress/lib.sh:90:# check_min <description> <actual> <minimum>
regress/lib.sh:91:check_min() {
regress/lib.sh:92:    _checks=$((_checks+1))
regress/lib.sh:93:    if [ "$2" -ge "$3" ] 2>/dev/null; then
regress/lib.sh:94:        printf "  ${C_OK}ok${C_OFF}   %-52s %s (>= %s)\n" "$1" "$2" "$3"
regress/lib.sh:95:    else
regress/lib.sh:96:        printf "  ${C_BAD}FAIL${C_OFF} %-52s got=%s want>=%s\n" "$1" "$2" "$3"
regress/lib.sh:97:        _fails=$((_fails+1))
regress/lib.sh:98:    fi
regress/lib.sh:99:}
regress/lib.sh:100:
regress/lib.sh:101:note() { printf "  --   %s\n" "$*"; }
regress/lib.sh:102:
regress/lib.sh:103:# A gate may declare that part of its coverage did not run (a rig whose image is absent,
regress/lib.sh:104:# say). That must not be absorbed into a PASS: it downgrades the whole gate to SKIP, so a
regress/lib.sh:105:# missing input can never be reported as evidence of correctness.
regress/lib.sh:106:_degraded=0
regress/lib.sh:107:degrade() { _degraded=1; printf "  ${C_SKIP}skip${C_OFF} %s\n" "$*"; }
regress/lib.sh:108:
regress/lib.sh:109:gate_end() {
regress/lib.sh:110:    echo
regress/lib.sh:111:    if [ "$_checks" = 0 ]; then
regress/lib.sh:112:        echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} (no checks ran)"; return $EXIT_SKIP
regress/lib.sh:113:    elif [ "$_fails" != 0 ]; then
regress/lib.sh:114:        echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks)"; return 1
regress/lib.sh:115:    elif [ "$_degraded" != 0 ]; then
regress/lib.sh:116:        echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} ($_checks checks passed, but part of the gate could not run)"
regress/lib.sh:117:        return $EXIT_SKIP
regress/lib.sh:118:    else
regress/lib.sh:119:        echo "${C_OK}$GATE_NAME: PASS${C_OFF} ($_checks checks)"; return 0
regress/lib.sh:120:    fi
regress/lib.sh:121:}
regress/lib.sh:122:
regress/lib.sh:123:#  #371: gate_skip() exits with the SKIP code, which run.sh maps to
regress/lib.sh:124:#  REGRESS_PASS_WITH_GAPS -- a green-ish verdict. It never consulted the running
regress/lib.sh:125:#  failure counter, so a gate that had ALREADY recorded red checks and then hit a
regress/lib.sh:126:#  gate_skip (a probe that produced no result line, a missing rig image) reported
regress/lib.sh:127:#  those reds as a skip and they vanished from the battery. Measured on a
regress/lib.sh:128:#  synthetic gate: one FAIL then gate_skip exited 77, PASS_WITH_GAPS. This is the
regress/lib.sh:129:#  same "a green row means nothing" class the gate rows themselves guard against,
regress/lib.sh:130:#  in the harness's own control flow.
regress/lib.sh:131:#
regress/lib.sh:132:#  So a gate_skip AFTER failures is a FAIL, not a skip: the skip cannot un-record
regress/lib.sh:133:#  what already failed. A gate_skip with a clean slate stays a genuine skip (a
regress/lib.sh:134:#  preflight that could not run at all -- need_file/need_exec). degrade() was
regress/lib.sh:135:#  already correct: gate_end() tests _fails before _degraded, so a degraded gate
regress/lib.sh:136:#  with recorded failures already reports FAIL. Nothing there to change.
regress/lib.sh:137:gate_skip() {
regress/lib.sh:138:    echo
regress/lib.sh:139:    if [ "${_fails:-0}" != 0 ]; then
regress/lib.sh:140:        echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks failed" \
regress/lib.sh:141:             "before this section could not run: $*)"
regress/lib.sh:142:        exit 1
regress/lib.sh:143:    fi
regress/lib.sh:144:    echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} -- $*"; exit $EXIT_SKIP
regress/lib.sh:145:}
regress/lib.sh:146:
regress/lib.sh:147:need_file() {
regress/lib.sh:148:    for f in "$@"; do
regress/lib.sh:149:        [ -e "$f" ] || gate_skip "missing required input: $f"
regress/lib.sh:150:    done
regress/lib.sh:151:}
regress/lib.sh:152:
regress/lib.sh:153:need_exec() {
regress/lib.sh:154:    for f in "$@"; do
regress/lib.sh:155:        [ -x "$f" ] || gate_skip "missing or non-executable binary: $f"
regress/lib.sh:156:    done
regress/lib.sh:157:}
regress/lib.sh:158:
regress/lib.sh:159:# run_emu <seconds> <logfile> <binary> [args...]
regress/lib.sh:160:# Always unbuffered, always with stdin closed so a guest prompt cannot wedge the run.
regress/lib.sh:161:run_emu() {
regress/lib.sh:162:    local secs=$1 log=$2; shift 2
regress/lib.sh:163:    ( cd "$IMAGES" 2>/dev/null || cd /; timeout "$secs" stdbuf -o0 -e0 "$@" </dev/null ) \
regress/lib.sh:164:        > "$log" 2>&1
regress/lib.sh:165:    return 0
regress/lib.sh:166:}
regress/lib.sh:167:
regress/lib.sh:168:# run_emu_progress <backstop_s> <budget_instrs> <stall_s> <marker_re> <logfile> <binary> [args...]
regress/lib.sh:169:#
regress/lib.sh:170:# #419: run_emu()'s wall-clock budget is a LOAD-SENSITIVE ORACLE. Under host load the guest
regress/lib.sh:171:# makes less progress in the same seconds, the marker never appears, and the row FAILs
regress/lib.sh:172:# INDISTINGUISHABLY FROM A REAL CAPABILITY REGRESSION -- measured twice, from panel seats and
regress/lib.sh:173:# from interactive greps. This runs the emulator against a budget of GUEST WORK instead, and
regress/lib.sh:174:# -- the part that actually fixes the defect -- it REPORTS WHY IT STOPPED.
regress/lib.sh:175:#
regress/lib.sh:176:# Echoes one line: "reason=<MARKER|BUDGET|STALLED|BACKSTOP|EXITED|ABSENT> ninstrs=<N> wall=<S>"
regress/lib.sh:177:#
regress/lib.sh:178:#   MARKER    the regex matched. Stop AT ONCE: today's run burns its whole budget AFTER
regress/lib.sh:179:#             login because the guest never exits, so this is also where the speed-up is.
regress/lib.sh:180:#   BUDGET    the guest executed <budget_instrs> and still never matched. It was given a full
regress/lib.sh:181:#             allowance of WORK, not of host seconds, so LOAD CANNOT EXPLAIN IT -> the caller
regress/lib.sh:182:#             may score it FAIL with confidence.
regress/lib.sh:183:#   STALLED   no instruction progress for <stall_s>. A slow host still executes instructions;
regress/lib.sh:184:#             a WEDGED guest does not. Not universal -- a BUSY-LOOP hang executes for ever and
regress/lib.sh:185:#             keeps emitting records, so this detects a wedge, not every hang. It is what makes
regress/lib.sh:186:#             a wedged boot DISTINGUISHABLE from load,
regress/lib.sh:187:#             and it is upstream 0.7.0's exact signature on luna88k.
regress/lib.sh:188:#   BACKSTOP  wall clock expired while instructions were still advancing. The only genuinely
regress/lib.sh:189:#             load-ambiguous outcome, and the only one a caller may treat as inconclusive.
regress/lib.sh:190:#   EXITED    the emulator ended under its own power -- exited or crashed -- rather than
regress/lib.sh:191:#             being stopped. A CRASH IS NOT A TIMEOUT, and reporting one as BACKSTOP would
regress/lib.sh:192:#             put a dead build into the single reason a caller may excuse as load.
regress/lib.sh:193:#   ABSENT    no -N record ever appeared. A HARNESS FAULT, and it must be scored RED: drop
regress/lib.sh:194:#             `-N` from the args, or break the extraction by one character, and every leg
regress/lib.sh:195:#             would otherwise fall to BACKSTOP for ever while the battery stayed green and
regress/lib.sh:196:#             the capability rows tested nothing.
regress/lib.sh:197:#
regress/lib.sh:198:# *** DELIBERATELY POLLS A FILE INSTEAD OF PIPING. Rule 1 at the top of this file exists
regress/lib.sh:199:# because a lost 4 KB block once scored a good boot as ZERO and it was reported as a
regress/lib.sh:200:# capability regression. `stdbuf -o0` fixes GXEMUL's buffering, but a `gxemul | grep` reader
regress/lib.sh:201:# block-buffers ITS OWN stdout and re-creates the identical bug one process later. Worse, a
regress/lib.sh:202:# SIGPIPE-based stop only fires on the emulator's NEXT WRITE -- which never comes for a wedged
regress/lib.sh:203:# guest, precisely the case the stop exists to catch. Polling a file has neither failure mode,
regress/lib.sh:204:# and the log is complete on disk however the run ends.
regress/lib.sh:205:#
regress/lib.sh:206:# IT HAS A THIRD, THOUGH, AND THE FIRST WINDOW SIZE HIT IT: a tail window smaller than the
regress/lib.sh:207:# gap between two -N records loses the oracle entirely and reports ABSENT for a perfectly
regress/lib.sh:208:# healthy guest. See the window comment below. ***
regress/lib.sh:209:#
regress/lib.sh:210:# MEASURED BASIS (eleven luna88k boots, 2026-08-14). Instructions-to-login spans
regress/lib.sh:211:# 7,315,767,413 (loaded) to 7,785,570,754 -- 3.57 % across eight idle runs, 6.42 % across an
regress/lib.sh:212:# 8x host-speed range. Dropping the page cache did NOT widen it. Load moves the count DOWN
regress/lib.sh:213:# ~4 %, so the count is not pure guest work, but it errs in the SAFE direction for a ceiling.
regress/lib.sh:214:#
regress/lib.sh:215:# *** THE MECHANISM FOR THAT ~4 % IS NOT ESTABLISHED, and an earlier version of this comment
regress/lib.sh:216:# asserted one that the source contradicts. It claimed the m88k idle fold credits 8191
regress/lib.sh:217:# instructions per wall-paced usleep(500) iteration. The constant is real
regress/lib.sh:218:# (N_DYNTRANS_IDLE_BREAK = N_SAFE_DYNTRANS_LIMIT = (1<<13)-1 = 8191, added at
regress/lib.sh:219:# cpu_m88k_instr.c:2611 and :2660) but it is SUBTRACTED BACK at cpu_dyntrans.c:377 before
regress/lib.sh:220:# n_instrs is accumulated at :392, so the net credit per fold is ~0, not 8191. The DIRECTION
regress/lib.sh:221:# is measured and the conclusion rests on the measurement; the explanation does not. Do not
regress/lib.sh:222:# re-assert a mechanism here without reading both sites. ***
regress/lib.sh:223:#
regress/lib.sh:224:# The decisive run: under 8 busy loops on 8 cores the guest STILL reached login, at
regress/lib.sh:225:# 7,349,301,148 instructions in 742 s -- the same run that scored 1:1:0 and FAILed at the old
regress/lib.sh:226:# 300 s wall budget. That is 9.9 M instr/s, which is the slowest rate measured here.
regress/lib.sh:227:run_emu_progress() {
regress/lib.sh:228:    local backstop=$1 budget=$2 stall=$3 marker=$4 log=$5; shift 5
regress/lib.sh:229:    local t0 last_n=0 last_change n now reason= pid
regress/lib.sh:230:
regress/lib.sh:231:    : > "$log"
regress/lib.sh:232:    t0=$(date +%s); last_change=$t0
regress/lib.sh:233:    # *** DO NOT WRAP THIS IN A SUBSHELL. `$!` would then be the SUBSHELL's pid, and killing
regress/lib.sh:234:    # it reaps the wrapper while ORPHANING the emulator. Measured on the first gate run of
regress/lib.sh:235:    # #419: the pristine leg was correctly classified STALLED at 120 s, its "kill" removed
regress/lib.sh:236:    # only the subshell, and the emulator was still burning 99.9 % of a core four minutes
regress/lib.sh:237:    # later while the next two legs measured themselves under that self-inflicted load.
regress/lib.sh:238:    # Starting `timeout` directly makes `$!` the process we actually need to signal. ***
regress/lib.sh:239:    local oldpwd=$PWD
regress/lib.sh:240:    cd "$IMAGES" 2>/dev/null || cd /
regress/lib.sh:241:    timeout "$backstop" stdbuf -o0 -e0 "$@" </dev/null > "$log" 2>&1 &
regress/lib.sh:242:    pid=$!
regress/lib.sh:243:    cd "$oldpwd" || true
regress/lib.sh:244:
regress/lib.sh:245:    while kill -0 "$pid" 2>/dev/null; do
regress/lib.sh:246:        # tail -c keeps this O(1) in log size rather than O(n) per poll.
regress/lib.sh:247:        #
regress/lib.sh:248:        # *** THE WINDOW WAS 2048 AND THAT WAS TOO SMALL -- measured, not reasoned.
regress/lib.sh:249:        # A guest emitting one -N record per 2 s with ~6 KB of console output between
regress/lib.sh:250:        # records scored ABSENT with instrs=0: a healthy executing build reported as a
regress/lib.sh:251:        # harness fault AND a capability regression, which is exactly the misclassification
regress/lib.sh:252:        # this function exists to remove.  On the real luna88k log the max inter-record gap
regress/lib.sh:253:        # is 2334 bytes -- ALREADY LARGER THAN THE OLD WINDOW.  It did not bite only because
regress/lib.sh:254:        # the miss must persist for the whole stall period.  64 KB is ~28x the observed
regress/lib.sh:255:        # worst gap and still O(1) per poll. ***
regress/lib.sh:256:        n=$(tail -c 65536 "$log" 2>/dev/null | grep -ao '\[ *[0-9]\+ instrs' | tail -1 | tr -dc '0-9')
regress/lib.sh:257:        n=${n:-$last_n}
regress/lib.sh:258:        now=$(date +%s)
regress/lib.sh:259:        [ "$n" != "$last_n" ] && { last_n=$n; last_change=$now; }
regress/lib.sh:260:        if grep -aq "$marker" "$log" 2>/dev/null; then reason=MARKER; break; fi
regress/lib.sh:261:        if [ "${n:-0}" -gt "$budget" ] 2>/dev/null;  then reason=BUDGET; break; fi
regress/lib.sh:262:        if [ $((now - last_change)) -ge "$stall" ];  then reason=STALLED; break; fi
regress/lib.sh:263:        sleep 1
regress/lib.sh:264:    done
regress/lib.sh:265:
regress/lib.sh:266:    # The emulator outlives the poll loop unless it is killed here, and killing `timeout`
regress/lib.sh:267:    # alone is not enough to rely on: reap its children explicitly by pid. Do NOT use
regress/lib.sh:268:    # `pkill -f <pattern>` for this -- the pattern appears in the invoking shell's own
regress/lib.sh:269:    # command line, so pkill SIGTERMs itself before finishing the job (measured: it exited
regress/lib.sh:270:    # 15 having killed nothing).
regress/lib.sh:271:    local kid exitst=0
regress/lib.sh:272:    if [ -n "$reason" ]; then
regress/lib.sh:273:        # We stopped it deliberately, so its exit status carries no information.
regress/lib.sh:274:        for kid in $(pgrep -P "$pid" 2>/dev/null); do kill -TERM "$kid" 2>/dev/null; done
regress/lib.sh:275:        kill -TERM "$pid" 2>/dev/null
regress/lib.sh:276:        sleep 1
regress/lib.sh:277:        for kid in $(pgrep -P "$pid" 2>/dev/null); do kill -9 "$kid" 2>/dev/null; done
regress/lib.sh:278:        kill -9 "$pid" 2>/dev/null
regress/lib.sh:279:        wait "$pid" 2>/dev/null
regress/lib.sh:280:    else
regress/lib.sh:281:        # The poll loop ended because the process is GONE. Collect its status before
regress/lib.sh:282:        # touching it: that status is the only thing that distinguishes `timeout`
regress/lib.sh:283:        # firing (124) from the emulator exiting or crashing under its own power.
regress/lib.sh:284:        wait "$pid" 2>/dev/null; exitst=$?
regress/lib.sh:285:    fi
regress/lib.sh:286:
regress/lib.sh:287:    if [ -z "$reason" ]; then
regress/lib.sh:288:        # *** RE-CHECK THE LOG BEFORE DEFAULTING TO BACKSTOP.  Measured 3/3,
regress/lib.sh:289:        # deterministic: the poll period is ~1006 ms, so a marker landing in the final
regress/lib.sh:290:        # poll window was scored BACKSTOP even though the guest had reached it -- the
regress/lib.sh:291:        # caller then called a SUCCESSFUL BOOT a regression while the marker-count row
regress/lib.sh:292:        # simultaneously passed on 1:1:1.  Two contradictory rows from one run. ***
regress/lib.sh:293:        if grep -aq "$marker" "$log" 2>/dev/null; then
regress/lib.sh:294:            reason=MARKER
regress/lib.sh:295:        elif [ "$exitst" != 124 ]; then
regress/lib.sh:296:            # *** A CRASH IS NOT A TIMEOUT.  The loop also ends when the emulator DIES,
regress/lib.sh:297:            # and reporting that as BACKSTOP puts a crashed build into the one reason a
regress/lib.sh:298:            # caller may treat as load-ambiguous.  timeout(1) returns 124 if and only if
regress/lib.sh:299:            # IT fired; anything else means the emulator ended on its own.  Measured on
regress/lib.sh:300:            # the shipped code: a fake emitting one record then `exit 3` returned
regress/lib.sh:301:            # reason=BACKSTOP ninstrs=100000000 wall=2. ***
regress/lib.sh:302:            reason=EXITED
regress/lib.sh:303:        else
regress/lib.sh:304:            reason=BACKSTOP
regress/lib.sh:305:        fi
regress/lib.sh:306:        # Same race on the count: a run that finishes inside one poll interval has a
regress/lib.sh:307:        # valid record on disk that no poll ever observed.
regress/lib.sh:308:        n=$(tail -c 65536 "$log" 2>/dev/null | grep -ao '\[ *[0-9]\+ instrs' | tail -1 | tr -dc '0-9')
regress/lib.sh:309:        [ -n "$n" ] && [ "${n:-0}" -gt "${last_n:-0}" ] 2>/dev/null && last_n=$n
regress/lib.sh:310:    fi
regress/lib.sh:311:    # An absent oracle stream outranks most other reasons: if -N produced nothing then
regress/lib.sh:312:    # nothing was measured, whatever else the run appeared to do.  It does NOT outrank
regress/lib.sh:313:    # EXITED -- a build that died is a defect in its own right, and the caller's
regress/lib.sh:314:    # instruction-count row catches a dropped `-N` independently of the reason.
regress/lib.sh:315:    [ "${last_n:-0}" -eq 0 ] && [ "$reason" != MARKER ] && [ "$reason" != EXITED ] && reason=ABSENT
regress/lib.sh:316:
regress/lib.sh:317:    echo "reason=$reason ninstrs=$last_n wall=$(( $(date +%s) - t0 ))"
regress/lib.sh:318:}
regress/lib.sh:319:
regress/lib.sh:320:# count <logfile> <pattern>   -- number of matching lines, 0 if the file is absent.
regress/lib.sh:321:#
regress/lib.sh:322:# NOT `[ -f x ] && grep -ac ... || echo 0`. On zero matches grep prints "0" AND exits 1,
regress/lib.sh:323:# so the || arm fires too and the function emits TWO lines ("0\n0"). Measured: 3 bytes,
regress/lib.sh:324:# 2 lines. That silently corrupted every marker string built from it, and made gate 6's
regress/lib.sh:325:# one deliberate expected-negative assertion impossible to satisfy.
regress/lib.sh:326:count() {
regress/lib.sh:327:    [ -f "$1" ] || { echo 0; return; }
regress/lib.sh:328:    local c
regress/lib.sh:329:    c=$(grep -ac -- "$2" "$1" 2>/dev/null)
regress/lib.sh:330:    echo "${c:-0}"
regress/lib.sh:331:}
regress/gate_mips_folds.sh:1:#!/bin/bash
regress/gate_mips_folds.sh:2:# GATE 16 -- MIPS instruction-combiner ("fold") witness (#388).
regress/gate_mips_folds.sh:3:#
regress/gate_mips_folds.sh:4:# What this protects
regress/gate_mips_folds.sh:5:# -----------------
regress/gate_mips_folds.sh:6:# The nine MIPS COMBINE sites install 34 fold-handler variants, and before #388
regress/gate_mips_folds.sh:7:# NOTHING could witness one firing: most folds are architecturally transparent
regress/gate_mips_folds.sh:8:# by construction, so any result-asserting row passes whether or not the fold
regress/gate_mips_folds.sh:9:# fires -- the recorded vacuity mode. #388 added pull-only install/fire counters
regress/gate_mips_folds.sh:10:# (cpu_mips.h) printed by tlbdump as a prefix-bound MFOLD block. This gate runs
regress/gate_mips_folds.sh:11:# regress/mips_fold_probe.py, whose rows drive real fold loops free-running
regress/gate_mips_folds.sh:12:# (never step -- combining gates on !single_step) with a breakpoint AFTER each
regress/gate_mips_folds.sh:13:# sequence on a NON-ARMING instruction, and grades the counters as EQUALITIES
regress/gate_mips_folds.sh:14:# derived from the read-ahead rule (a breakpoint anywhere disables read-ahead
regress/gate_mips_folds.sh:15:# machine-wide, so fire == passes-1; the derivations live in the probe's rows).
regress/gate_mips_folds.sh:16:#
regress/gate_mips_folds.sh:17:# Non-vacuity: deleting the bne_samepage_nop replacement sub-arm (incl. its
regress/gate_mips_folds.sh:18:# install++) in a scratch build flips exactly that fold to (0,0) and reddens
regress/gate_mips_folds.sh:19:# its two rows while every other row stays green -- measured 2026-08-12
regress/gate_mips_folds.sh:20:# (M388MUT_PASS), the per-variant attribution -J cannot give.
regress/gate_mips_folds.sh:21:#
regress/gate_mips_folds.sh:22:# The BE rows are the first big-endian MIPS guest executions in this harness;
regress/gate_mips_folds.sh:23:# the mlw2v* value rows additionally witness the _be generated body's BE32
regress/gate_mips_folds.sh:24:# assembly + sign extension, not just its selection.
regress/gate_mips_folds.sh:25:set -u
regress/gate_mips_folds.sh:26:cd "$(dirname "$0")"
regress/gate_mips_folds.sh:27:. ./lib.sh
regress/gate_mips_folds.sh:28:
regress/gate_mips_folds.sh:29:gate_begin "gate 16: MIPS fold witness (#388)"
regress/gate_mips_folds.sh:30:
regress/gate_mips_folds.sh:31:PMAX=${PMAX:-$ROOT/build/gxemul}
regress/gate_mips_folds.sh:32:PMAX_KERNEL=$ROOT/gxemul_pmax_rig/bsd
regress/gate_mips_folds.sh:33:
regress/gate_mips_folds.sh:34:if [ ! -x "$PMAX" ]; then gate_skip "no gxemul binary at $PMAX"; fi
regress/gate_mips_folds.sh:35:
regress/gate_mips_folds.sh:36:#  ---------------------------------------------------------------------------------------
regress/gate_mips_folds.sh:37:#  #549 fbctrlportkill: dev_fbctrl.c's PORT selector, on -E testmips.  Before #549 a guest
regress/gate_mips_folds.sh:38:#  store of 8 or more to PORT was STORED with only a warning, and the next DATA access ended
regress/gate_mips_folds.sh:39:#  the emulator in the DATA arm's range check.  #549 refuses the selector (the previous one
regress/gate_mips_folds.sh:40:#  is kept) and announces the refusal once.  regress/fbctrl_port_probe.py drives real guest
regress/gate_mips_folds.sh:41:#  sb/sh/sw/sd/lw on an unmodified testmips -- no kernel, no rig image -- so it runs BEFORE
regress/gate_mips_folds.sh:42:#  this gate's pmax-kernel check: a missing kernel still skips the fold rows below, and
regress/gate_mips_folds.sh:43:#  gate_skip reports FAIL, not SKIP, if an fbctrl row failed first.
regress/gate_mips_folds.sh:44:#
regress/gate_mips_folds.sh:45:#  THE CONTRACT is the probe's header (CATCHES / NOT CLAIMED).  Kill table 1 was red on 20 of
regress/gate_mips_folds.sh:46:#  20 edits of the fix's own predicate, store and latch; a process-global latch and the
regress/gate_mips_folds.sh:47:#  deletion of the DATA arm's kept check are DISCLOSED escapes; and the device still ends the
regress/gate_mips_folds.sh:48:#  process through its command and offset defaults, which are filed, not claimed.  HEAD before
regress/gate_mips_folds.sh:49:#  #549 scored 25/41 here, every refusal row red.
regress/gate_mips_folds.sh:50:#
regress/gate_mips_folds.sh:51:#  `gatedevicesplit` is OWED (#498): one more device probe in a CPU gate, as #548 added to
regress/gate_mips_folds.sh:52:#  gate 14.  Recorded, not compounded silently.
regress/gate_mips_folds.sh:53:FBCLOG=$LOGDIR/fbctrl_port_probe.log
regress/gate_mips_folds.sh:54:fbrc=0
regress/gate_mips_folds.sh:55:python3 -u fbctrl_port_probe.py "$PMAX" > "$FBCLOG" 2>&1 || fbrc=$?
regress/gate_mips_folds.sh:56:if [ "$(grep -cx 'FBCTRLP_DONE' "$FBCLOG")" != "1" ] ||
regress/gate_mips_folds.sh:57:   [ "$(grep -c '^FBCTRLP_RESULT=' "$FBCLOG")" != "1" ] ||
regress/gate_mips_folds.sh:58:   ! grep -Eq '^FBCTRLP_RESULT=(0|[1-9][0-9]*)/(0|[1-9][0-9]*)$' "$FBCLOG" ||
regress/gate_mips_folds.sh:59:   [ "$(grep -c '^FBCTRLP_CONTROL=' "$FBCLOG")" != "1" ] ||
regress/gate_mips_folds.sh:60:   ! grep -Eq '^FBCTRLP_CONTROL=(OK|FAILED)$' "$FBCLOG"; then
regress/gate_mips_folds.sh:61:    note "fbctrl probe produced no unique, complete record; last lines follow"
regress/gate_mips_folds.sh:62:    tail -5 "$FBCLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:63:    check "fbctrl probe output parses" "no" "yes"
regress/gate_mips_folds.sh:64:else
regress/gate_mips_folds.sh:65:    check "fbctrl probe output parses" "yes" "yes"
regress/gate_mips_folds.sh:66:    grep -E '^  FAIL ' "$FBCLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:67:    check "fbctrl probe controls" "$(sed -n 's/^FBCTRLP_CONTROL=//p' "$FBCLOG")" "OK"
regress/gate_mips_folds.sh:68:    check "fbctrl probe exit status" "$fbrc" "0"
regress/gate_mips_folds.sh:69:    fbres=$(sed -n 's/^FBCTRLP_RESULT=//p' "$FBCLOG")
regress/gate_mips_folds.sh:70:    #  Pinned UNQUOTED under a one-token stem, so check_score_claims.py sees the pin.
regress/gate_mips_folds.sh:71:    check "fbctrl_port rows run" "${fbres#*/}" 41
regress/gate_mips_folds.sh:72:    check "fbctrl_port rows correct" "${fbres%/*}" "41"
regress/gate_mips_folds.sh:73:    check "fbctrl_port rows failed" "$(grep -c '^  FAIL ' "$FBCLOG")" "0"
regress/gate_mips_folds.sh:74:fi
regress/gate_mips_folds.sh:75:
regress/gate_mips_folds.sh:76:if [ ! -f "$PMAX_KERNEL" ]; then gate_skip "no pmax kernel at $PMAX_KERNEL"; fi
regress/gate_mips_folds.sh:77:
regress/gate_mips_folds.sh:78:FLOG=$LOGDIR/gate_mips_folds.log
regress/gate_mips_folds.sh:79:python3 mips_fold_probe.py "$PMAX" "$PMAX_KERNEL" > "$FLOG" 2>&1 || true
regress/gate_mips_folds.sh:80:
regress/gate_mips_folds.sh:81:#  #388 pass-2 (four seats convergent): a probe that STARTED but produced no
regress/gate_mips_folds.sh:82:#  result line is a failure of the thing under test (crash, dead emulator,
regress/gate_mips_folds.sh:83:#  unwritable /tmp), not preflight -- it must FAIL, not skip (lib.sh's #371
regress/gate_mips_folds.sh:84:#  doctrine: skip = could-not-run-at-all; the binary/kernel checks above are
regress/gate_mips_folds.sh:85:#  the real preflight). A silent skip here would report
regress/gate_mips_folds.sh:86:#  REGRESS_PASS_WITH_GAPS while removing all fold coverage.
regress/gate_mips_folds.sh:87:if ! grep -q "MFOLDPROBE_RESULT=" "$FLOG"; then
regress/gate_mips_folds.sh:88:    note "fold probe produced no result line; last lines follow"
regress/gate_mips_folds.sh:89:    tail -5 "$FLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:90:fi
regress/gate_mips_folds.sh:91:check "fold probe completed (result line present)" \
regress/gate_mips_folds.sh:92:      "$(grep -q 'MFOLDPROBE_RESULT=' "$FLOG" && echo yes || echo no)" "yes"
regress/gate_mips_folds.sh:93:
regress/gate_mips_folds.sh:94:grep -E " ok$| FAIL$" "$FLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:95:
regress/gate_mips_folds.sh:96:#  Every row named individually (the %-24s column keeps two-space anchoring
regress/gate_mips_folds.sh:97:#  satisfiable; no name is a prefix of another).
regress/gate_mips_folds.sh:98:for v in "bne_nop_3max" "bne_nop_tm64" "lui_ori_3max" \
regress/gate_mips_folds.sh:99:         "mlw2_le_3max" "mlw2v0_le_3max" "mlw2v1_le_3max" \
regress/gate_mips_folds.sh:100:         "mlw2_be_tm64" "mlw2v0_be_tm64" "mlw2v1_be_tm64" \
regress/gate_mips_folds.sh:101:         "mlw2_be_tm32" "mlw2v0_be_tm32" "mlw2v1_be_tm32" \
regress/gate_mips_folds.sh:102:         "mlw2_dev_tm64" "memset_3max"; do
