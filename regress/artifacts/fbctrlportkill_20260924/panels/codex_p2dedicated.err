src/devices/dev_fbctrl.c:129:				    (unsigned long long) idata);
src/devices/dev_fbctrl.c:130:				d->warned_port = 1;
src/devices/dev_fbctrl.c:131:			}
src/devices/dev_fbctrl.c:132:		} else
src/devices/dev_fbctrl.c:133:			d->current_port = idata;
src/devices/dev_fbctrl.c:134:		break;
src/devices/dev_fbctrl.c:135:
src/devices/dev_fbctrl.c:136:	case DEV_FBCTRL_DATA:
src/devices/dev_fbctrl.c:137:		/*  #549: unreachable while the PORT arm refuses; kept as a
src/devices/dev_fbctrl.c:138:		    tripwire for a later edit that lets a bad selector in.  */
src/devices/dev_fbctrl.c:139:		if (d->current_port < 0 || d->current_port
src/devices/dev_fbctrl.c:140:		    >= DEV_FBCTRL_NPORTS) {
src/devices/dev_fbctrl.c:141:			fatal("[ fbctrl port number is out of range! ]\n");
src/devices/dev_fbctrl.c:142:			exit(1);
src/devices/dev_fbctrl.c:143:		}
src/devices/dev_fbctrl.c:144:
src/devices/dev_fbctrl.c:145:		if (writeflag == MEM_READ)
src/devices/dev_fbctrl.c:146:			odata = d->port[d->current_port];
src/devices/dev_fbctrl.c:147:		else {
src/devices/dev_fbctrl.c:148:			d->port[d->current_port] = idata;
src/devices/dev_fbctrl.c:149:			if (d->current_port == DEV_FBCTRL_PORT_COMMAND)
src/devices/dev_fbctrl.c:150:				fbctrl_command(cpu, d);
src/devices/dev_fbctrl.c:151:		}
src/devices/dev_fbctrl.c:152:
src/devices/dev_fbctrl.c:153:		break;
src/devices/dev_fbctrl.c:154:
src/devices/dev_fbctrl.c:155:	default:
src/devices/dev_fbctrl.c:156:		fatal("[ dev_fbctrl: unimplemented relative addr 0x%x ]\n",
src/devices/dev_fbctrl.c:157:		    (int)relative_addr);
src/devices/dev_fbctrl.c:158:		exit(1);
src/devices/dev_fbctrl.c:159:	}
src/devices/dev_fbctrl.c:160:
src/devices/dev_fbctrl.c:161:	if (writeflag == MEM_READ)
src/devices/dev_fbctrl.c:162:		memory_writemax64(cpu, data, len, odata);
src/devices/dev_fbctrl.c:163:
src/devices/dev_fbctrl.c:164:	return 1;
src/devices/dev_fbctrl.c:165:}
