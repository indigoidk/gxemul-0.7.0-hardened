 500:            ("sw", "t9", 0, "vlast"),
 501:            ("lw", "a0", 0, None)]                                 # PORT at once: must still read 7 (a0 is spent)
 502: PROG_V += [("sw", "zr", 0, None), ("lw", "v1", 16, None)]
 503: for p in range(1, 8):
 504:     PROG_V += [("sw", "s%d" % p, 0, None), ("lw", "s%d" % p, 16, None)]
 505: READS_V = ["s0", "v0", "v1", "a0"] + ["s%d" % p for p in range(1, 8)]
