  27:  *
  28:  *  COMMENT: Framebuffer controller device (control's dev_fb in test machines)
  29:  *
  30:  *  A "framebuffer control" device. It can be used to manipulate the
  31:  *  framebuffer device in testmachines.
  32:  */
  33: 
  34: #include <stdio.h>
  35: #include <stdlib.h>
  36: #include <string.h>
  37: 
  38: #include "cpu.h"
  39: #include "device.h"
  40: #include "devices.h"
  41: #include "machine.h"
  42: #include "memory.h"
  43: #include "misc.h"
  44: 
  45: #include "testmachine/dev_fb.h"
  46: 
  47: 
  48: struct fbctrl_data {
  49: 	struct vfb_data *vfb_data;
  50: 	int		current_port;
  51: 	int		port[DEV_FBCTRL_NPORTS];
  52: 	int		warned_port;	/* #549: the refused-selector announce */
  53: };
  54: 
  55: 
  56: /*
  57:  *  fbctrl_command():
  58:  *
  59:  *  Execute a framebuffer control command.
  60:  */
  61: static void fbctrl_command(struct cpu *cpu, struct fbctrl_data *d)
  62: {
  63: 	int cmd = d->port[DEV_FBCTRL_PORT_COMMAND];
  64: 	int x1, y1, i;
  65: 
  66: 	switch (cmd) {
  67: 
  68: 	case DEV_FBCTRL_COMMAND_NOP:
  69: 		break;
  70: 
  71: 	case DEV_FBCTRL_COMMAND_SET_RESOLUTION:
  72: 		/*
  73: 		 *  Change the framebuffer resolution to X1 x Y1 pixels.
  74: 		 */
  75: 		x1 = d->port[DEV_FBCTRL_PORT_X1];
  76: 		y1 = d->port[DEV_FBCTRL_PORT_Y1];
  77: 		debug("[ dev_fbctrl: changing resolution to %i,%i ]\n", x1, y1);
  78: 
  79: 		dev_fb_resize(d->vfb_data, x1, y1);
  80: 
  81: 		/*  Remember to invalidate all translations for anyone
  82: 		    who might have used the old framebuffer:  */
  83: 		for (i = 0; i < cpu->machine->ncpus; i++)
  84: 			cpu->machine->cpus[i]->invalidate_translation_caches(
  85: 			    cpu->machine->cpus[i], 0, INVALIDATE_ALL);
  86: 		break;
  87: 
  88: 	case DEV_FBCTRL_COMMAND_GET_RESOLUTION:
  89: 		if (cpu->machine->x11_md.in_use) {
  90: 			d->port[DEV_FBCTRL_PORT_X1] = d->vfb_data->xsize;
  91: 			d->port[DEV_FBCTRL_PORT_Y1] = d->vfb_data->ysize;
  92: 		} else {
  93: 			// When not using X11 output, return 0x0 size.
  94: 			d->port[DEV_FBCTRL_PORT_X1] = 0;
  95: 			d->port[DEV_FBCTRL_PORT_Y1] = 0;
  96: 		}
  97: 		break;
  98: 
  99: 	/*  TODO: Block copy and fill.  */
 100: 
 101: 	default:fatal("fbctrl_command: Unimplemented command %i.\n", cmd);
 102: 		exit(1);
 103: 	}
 104: }
 105: 
 106: 
 107: DEVICE_ACCESS(fbctrl)
 108: {
 109: 	struct fbctrl_data *d = (struct fbctrl_data *) extra;
 110: 	uint64_t idata = 0, odata = 0;
 111: 
 112: 	if (writeflag == MEM_WRITE)
 113: 	        idata = memory_readmax64(cpu, data, len);
 114: 
 115: 	switch (relative_addr) {
 116: 
 117: 	case DEV_FBCTRL_PORT:
 118: 		if (writeflag == MEM_READ)
 119: 			odata = d->current_port;
 120: 		else if (idata >= DEV_FBCTRL_NPORTS) {
 121: 			/*  #549: an out-of-range selector is REFUSED, and
 122: 			    current_port keeps its previous, always-valid value.
 123: 			    It used to be stored as an int with only a warning:
 124: 			    9 made the next DATA access end the emulator in the
 125: 			    range check below, and a wide value was truncated
 126: 			    onto a legal port (0x100000003 selected port 3).
 127: 			    Announced once per device.  */
 128: 			if (!d->warned_port) {
 129: 				fatal("[ fbctrl: port number 0x%llx is out of range; "
 130: 				    "the selector is unchanged (once) ]\n",
 131: 				    (unsigned long long) idata);
 132: 				d->warned_port = 1;
 133: 			}
 134: 		} else
 135: 			d->current_port = idata;
 136: 		break;
 137: 
 138: 	case DEV_FBCTRL_DATA:
 139: 		/*  #549: unreachable while the PORT arm refuses; kept as a
 140: 		    tripwire for a later edit that lets a bad selector in.  */
 141: 		if (d->current_port < 0 || d->current_port
 142: 		    >= DEV_FBCTRL_NPORTS) {
 143: 			fatal("[ fbctrl port number is out of range! ]\n");
 144: 			exit(1);
 145: 		}
 146: 
 147: 		if (writeflag == MEM_READ)
 148: 			odata = d->port[d->current_port];
 149: 		else {
 150: 			d->port[d->current_port] = idata;
 151: 			if (d->current_port == DEV_FBCTRL_PORT_COMMAND)
 152: 				fbctrl_command(cpu, d);
 153: 		}
 154: 
 155: 		break;
 156: 
 157: 	default:
 158: 		fatal("[ dev_fbctrl: unimplemented relative addr 0x%x ]\n",
 159: 		    (int)relative_addr);
 160: 		exit(1);
 161: 	}
 162: 
 163: 	if (writeflag == MEM_READ)
 164: 		memory_writemax64(cpu, data, len, odata);
 165: 
 166: 	return 1;
 167: }
 168: 
 169: 
 170: DEVINIT(fbctrl)
 171: {
 172: 	struct fbctrl_data *d;
 173: 
 174: 	CHECK_ALLOCATION(d = (struct fbctrl_data *) malloc(sizeof(struct fbctrl_data)));
 175: 	memset(d, 0, sizeof(struct fbctrl_data));
 176: 
 177: 	d->vfb_data = dev_fb_init(devinit->machine, devinit->machine->memory,
 178: 	    DEV_FB_ADDRESS, VFB_GENERIC, 640, 480, 640, DEV_FBCTRL_MAXY(640),
 179: 	    24, "generic");
 180: 
 181: 	memory_device_register(devinit->machine->memory, devinit->name,
 182: 	    devinit->addr, DEV_FBCTRL_LENGTH, dev_fbctrl_access, d,
 183: 	    DM_DEFAULT, NULL);
 184: 
 185: 	return 1;
 186: }
