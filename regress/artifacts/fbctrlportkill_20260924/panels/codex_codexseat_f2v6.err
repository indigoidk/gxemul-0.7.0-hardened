 507: #  W: the width x boundary cells, each after its own non-zero predecessor into a poisoned read-back; then an ld.
 508: W_CELLS = [("accept 0 written by sb after PORT=5", "a0", "sb", "zr", "s0", 0, None),
 509:            ("accept 0 written by sh after PORT=5", "a0", "sh", "zr", "s1", 0, None),
 510:            ("accept 0 written by sw after PORT=5", "a0", "sw", "zr", "s2", 0, None),
 511:            ("accept 0 written by sd after PORT=5", "a0", "sd", "zr", "s3", 0, None),
 512:            ("accept 7 written by sb after PORT=5", "a0", "sb", "t5", "s4", 7, None),
 513:            ("accept 7 written by sh after PORT=5", "a0", "sh", "t5", "s5", 7, None),
 514:            ("accept 7 written by sw after PORT=5", "a0", "sw", "t5", "s6", 7, None),
 515:            ("refuse 8 (sb), PORT keeps 5", "a0", "sb", "t4", "s7", 5, "w1st"),     # W's FIRST refusal
 516:            ("refuse 8 (sh), PORT keeps 5", "a0", "sh", "t4", "v0", 5, None),
 517:            ("refuse 8 (sd), PORT keeps 5", "a0", "sd", "t4", "v1", 5, None),
 518:            ("refuse 0x8000000000000000 (sd), PORT keeps 5", "a0", "sd", "t2", "t6", 5, None),
 519:            ("refuse 9 after PORT=6, PORT keeps 6", "a3", "sw", "t1", "t8", 6, "wlast")]
 520: PROG_W = []
 521: REGS_W = [("t0", FBCTRL), ("a0", 5), ("a3", 6), ("t1", 9), ("t2", 0x8000000000000000), ("t4", 8), ("t5", 7),
 522:           ("t9", 0xdead), ("a1", 0xdead), ("a2", 0xdead)]
