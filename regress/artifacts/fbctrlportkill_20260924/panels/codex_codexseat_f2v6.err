 376: # ---------------------------------------------------------------- sessions
 377: PROG_C = [("sw", "t1", 0, None), ("sw", "t3", 16, None), ("lw", "t4", 16, None), ("lw", "t5", 0, None),
 378:           ("sw", "t6", 0, None), ("sw", "t7", 16, None),               # PORT=1 (X1), X1 = 123
 379:           ("sw", "s1", 0, None), ("sw", "t7", 16, None),               # PORT=2 (Y1), Y1 = 123
 380:           ("sw", "s0", 0, None), ("sw", "s1", 16, None),               # PORT=0 (COMMAND), DATA=2: GET_RESOLUTION
 381:           ("sw", "t6", 0, None), ("lw", "s2", 16, None),               # read X1
 382:           ("sw", "s1", 0, None), ("lw", "s3", 16, None)]               # read Y1
 383: REGS_C = [("t0", FBCTRL), ("t1", 5), ("t3", 0x2a), ("t6", 1), ("t7", 123), ("s0", 0), ("s1", 2),
 384:           ("t4", 0xdead), ("t5", 0xdead), ("s2", 0xdead), ("s3", 0xdead)]
 385: 
 386: #  A: selector p written at a rotating width and read back through PORT into s<k> (poisoned 0xdead first, so a
 387: #  read that never ran cannot pass -- selector 0 would otherwise match a register's reset value); DATA value 0x11*p
 388: #  for p >= 1, read back through DATA INTO THE SELECTOR REGISTER, which holds p before the read, never 0x11*p.
 389: #  Port 0 is COMMAND: written with NOP (0, from zr) only.
 390: ACC = [(0, "sw"), (1, "sb"), (2, "sh"), (3, "sw"), (4, "sd"), (5, "sb"), (6, "sh"), (7, "sd")]
 391: SEL_REG = ["t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8"]           # the selector values
 392: VAL_REG = ["zr", "a0", "a1", "a2", "a3", "v0", "v1", "t9"]           # the DATA values (port 0 gets zr = NOP)
 393: PORT_RB = ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7"]           # PORT read-backs
 394: PROG_A, REGS_A = [], [("t0", FBCTRL)]
 395: for k, (p, w) in enumerate(ACC):
 396:     REGS_A.append((SEL_REG[k], p))
 397:     REGS_A.append((PORT_RB[k], 0xdead))
 398:     if k:
 399:         REGS_A.append((VAL_REG[k], 0x11 * p))
 400:     PROG_A.append((w, SEL_REG[k], 0, None))                            # PORT = p at width w
 401:     PROG_A.append(("lw", PORT_RB[k], 0, None))                         # read PORT
 402:     PROG_A.append(("sw", VAL_REG[k], 16, None))                        # DATA = 0x11*p (NOP for port 0)
 403: #  the DATA read-backs, one per port 1..7: re-select p, read DATA into the selector register
 404: for k, (p, w) in enumerate(ACC):
 405:     if k:
 406:         PROG_A.append(("sw", SEL_REG[k], 0, None))
 407:         PROG_A.append(("lw", SEL_REG[k], 16, None))

