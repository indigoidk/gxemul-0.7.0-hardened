regress/gate_asan_sweep.sh:1:#!/bin/bash
regress/gate_asan_sweep.sh:2:# GATE 9 -- every machine type AND EVERY SUBTYPE constructed under AddressSanitizer,
regress/gate_asan_sweep.sh:3:# three-way.
regress/gate_asan_sweep.sh:4:#
regress/gate_asan_sweep.sh:5:# This is the BREADTH gate. Everything else in this harness executes four machines; the
regress/gate_asan_sweep.sh:6:# fork changed 117 source files, 27 of them specific to architectures (alpha, ARM, i960,
regress/gate_asan_sweep.sh:7:# PowerPC, SGI) that no rig touches at all. This gate builds every machine type, attaches
regress/gate_asan_sweep.sh:8:# its devices, and lets ASan watch.
regress/gate_asan_sweep.sh:9:#
regress/gate_asan_sweep.sh:10:# It revives an instrument the project already used -- the CHANGELOG records a "run every
regress/gate_asan_sweep.sh:11:# machine under ASan sweep (23 machine types)" that found the macppc heap OOB (#23) -- but
regress/gate_asan_sweep.sh:12:# as a STANDING GATE rather than a one-off, and comparatively rather than absolutely.
regress/gate_asan_sweep.sh:13:#
regress/gate_asan_sweep.sh:14:# THE ASSERTION IS DIRECTIONAL, and that matters. The fork exists partly to FIX memory
regress/gate_asan_sweep.sh:15:# errors, so upstream being dirty where HEAD is clean is success, not failure. Only the
regress/gate_asan_sweep.sh:16:# reverse is a regression:
regress/gate_asan_sweep.sh:17:#
regress/gate_asan_sweep.sh:18:#     clean under pristine, dirty under HEAD   -> REGRESSION (this gate fails)
regress/gate_asan_sweep.sh:19:#     dirty under pristine, clean under HEAD   -> the fork doing its job
regress/gate_asan_sweep.sh:20:#     dirty under both                         -> pre-existing, reported not failed
regress/gate_asan_sweep.sh:21:#
regress/gate_asan_sweep.sh:22:# A MACHINE MUST BE HANDED A FILE OR IT NEVER CONSTRUCTS. Measured: `-E testmips` with no
regress/gate_asan_sweep.sh:23:# file prints usage and aborts before any device is attached -- a sweep built that way
regress/gate_asan_sweep.sh:24:# would test nothing and pass every time. With a dummy image the machine reports
regress/gate_asan_sweep.sh:25:# `model:`, `cpu:`, `memory:` and attaches devices. Machines with subtypes additionally
regress/gate_asan_sweep.sh:26:# need `-e <subtype>`; without it 15 of the 41 types never construct.  (This line said
regress/gate_asan_sweep.sh:27:# "13 of 37" until #444 re-measured it. The counts drift with the machine list; that is
regress/gate_asan_sweep.sh:28:# why nothing below asserts one.)
regress/gate_asan_sweep.sh:29:#
regress/gate_asan_sweep.sh:30:# ############################################################################
regress/gate_asan_sweep.sh:31:# #444 asansweepblind -- THREE MEASURED BLIND SPOTS, all of which left this gate GREEN
regress/gate_asan_sweep.sh:32:# while it was reporting things that were not true. Each fix below is annotated with the
regress/gate_asan_sweep.sh:33:# measurement that forced it; none of them is reasoned-from-source.
regress/gate_asan_sweep.sh:34:#
regress/gate_asan_sweep.sh:35:#  B1. IT COULD NOT SEE A CONSTRUCTION ABORT AT ALL.
regress/gate_asan_sweep.sh:36:#      sanhit() greps for ASan/UBSan text. A machine that calls abort() is not a
regress/gate_asan_sweep.sh:37:#      sanitizer hit, so it scored ZERO -- and the only construction assertion was a
regress/gate_asan_sweep.sh:38:#      FLOOR (`check_min "machine types constructed" 20`), which a handful of corpses
regress/gate_asan_sweep.sh:39:#      cannot breach.
regress/gate_asan_sweep.sh:40:#      MEASURED, by running the shipped gate against the same binaries this one uses:
regress/gate_asan_sweep.sh:41:#      **PASS (3 checks)** while 15 machine/subtype combinations were dying by SIGABRT.
regress/gate_asan_sweep.sh:42:#      It touched two of the fifteen (hpcmips/be-300, mvmeppc/mvme1600); both scored the
regress/gate_asan_sweep.sh:43:#      row `no  0  0` -- BYTE-IDENTICAL to the row a machine that merely wants a subtype
regress/gate_asan_sweep.sh:44:#      produces -- and both were absorbed by "machine types constructed 38 (>= 20)".
regress/gate_asan_sweep.sh:45:#      *** AND THE ABORT MESSAGE WAS NOT EVEN ON DISK. ***  core/interrupt.c:191-198 does
regress/gate_asan_sweep.sh:46:#      `printf("Aborting.\n"); abort();`, and abort() DOES NOT FLUSH STDIO. With stdout
regress/gate_asan_sweep.sh:47:#      redirected to a file glibc block-buffers it, so the whole diagnostic died with the
regress/gate_asan_sweep.sh:48:#      process: MEASURED, the log of `-E decstation -e 5400` was **0 bytes**. The gate then
regress/gate_asan_sweep.sh:49:#      read that empty file as `constructed=no, sanhit=0` -- INDISTINGUISHABLE from a
regress/gate_asan_sweep.sh:50:#      machine that merely needs a subtype. A dead machine and a fine one scored alike.
regress/gate_asan_sweep.sh:51:#      Fix: classify by EXIT STATUS (diedby(), below), which no buffering can lose, and
regress/gate_asan_sweep.sh:52:#      run under `stdbuf -o0 -e0` so the reason text survives for the human.
regress/gate_asan_sweep.sh:53:#
regress/gate_asan_sweep.sh:54:#  B2. IT SWEPT ONLY EACH TYPE'S *FIRST* SUBTYPE, so a defect in any later one was
regress/gate_asan_sweep.sh:55:#      invisible by construction. MEASURED: the shipped gate ran 14 subtypes in total,
regress/gate_asan_sweep.sh:56:#      one per type that needs one. Sweeping every subtype runs 58 and finds **15** dying
regress/gate_asan_sweep.sh:57:#      machines where a first-subtype-only sweep of the same 41 types finds **2** -- and
regress/gate_asan_sweep.sh:58:#      finds 4 ASan hits each on sgi/ip28, sgi/ip30 and sgi/ip35, which nothing in this
regress/gate_asan_sweep.sh:59:#      harness had ever executed.
regress/gate_asan_sweep.sh:60:#      The full sweep is 99 combinations and the whole gate -- both binaries, 198 launches
regress/gate_asan_sweep.sh:61:#      -- costs 55 s wall (measured), so there is no reason to bound it. It is not
regress/gate_asan_sweep.sh:62:#      bounded. If a future edit does bound it, the gate must SAY what it dropped -- do
regress/gate_asan_sweep.sh:63:#      not cap coverage silently.
regress/gate_asan_sweep.sh:64:#
regress/gate_asan_sweep.sh:65:#  B3. THE ALIAS PARSER SILENTLY RE-ATTRIBUTED ONE MACHINE'S SUBTYPES TO ANOTHER.
regress/gate_asan_sweep.sh:66:#      The old awk required the primary alias to match `[a-z0-9_.-]+`. **SGI's primary
regress/gate_asan_sweep.sh:67:#      alias is "silicon graphics" -- WITH A SPACE** (`gxemul -H`: `SGI ("silicon
regress/gate_asan_sweep.sh:68:#      graphics", "sgi")`), so the type line matched the line pattern, failed the alias
regress/gate_asan_sweep.sh:69:#      pattern, and fell through WITHOUT running `next` and WITHOUT updating `type`.
regress/gate_asan_sweep.sh:70:#      Its ten subtypes then attached to whatever type came before it in the help text,
regress/gate_asan_sweep.sh:71:#      which is `rpi`:
regress/gate_asan_sweep.sh:72:#          BEFORE:  S rpi ip12 .. S rpi ip35   (10 rows), `T sgi` absent, `S sgi *` = 0
regress/gate_asan_sweep.sh:73:#          AFTER :  T sgi, S sgi ip12 .. S sgi ip35 (10 rows), `S rpi *` = 0
regress/gate_asan_sweep.sh:74:#      Consequence measured, and it is worse than a wrong label: because no `T sgi` line
regress/gate_asan_sweep.sh:75:#      existed, THE TYPE LOOP NEVER RAN A SINGLE SGI MACHINE. Ten subtypes carrying a
regress/gate_asan_sweep.sh:76:#      real heap-buffer-overflow (arcbios.c:2391 set_env <- machine_setup_sgi) were not
regress/gate_asan_sweep.sh:77:#      swept at all, and no row anywhere was red.
regress/gate_asan_sweep.sh:78:#      Fix: firstalias() takes the first SHELL-SAFE alias out of the trailing
regress/gate_asan_sweep.sh:79:#      parenthesised group -- so `sgi`, not `silicon graphics`. And a line that yields NO
regress/gate_asan_sweep.sh:80:#      usable alias now emits an explicit `X`/`Y` marker that a check asserts to be zero,
regress/gate_asan_sweep.sh:81:#      so the next multi-word alias is RED instead of silent. THAT is the fix for the
regress/gate_asan_sweep.sh:82:#      class; renaming one machine would only have fixed the instance.
regress/gate_asan_sweep.sh:83:#      (Why not the true primary `silicon graphics`? Two reasons, both measured: the type
regress/gate_asan_sweep.sh:84:#      list is consumed by word-splitting shell loops, and `sgi` is what every other
regress/gate_asan_sweep.sh:85:#      record in this project calls it. `-E "silicon graphics"` does work -- verified --
regress/gate_asan_sweep.sh:86:#      it is just not a usable row key.)
regress/gate_asan_sweep.sh:87:# ############################################################################
regress/gate_asan_sweep.sh:88:set -u
regress/gate_asan_sweep.sh:89:HERE=$(cd "$(dirname "$0")" && pwd)
regress/gate_asan_sweep.sh:90:. "$HERE/lib.sh"
regress/gate_asan_sweep.sh:91:
regress/gate_asan_sweep.sh:92:ASAN_HEAD=/tmp/gx-asan-head/gxemul
regress/gate_asan_sweep.sh:93:ASAN_PRI=/tmp/gx-asan-pristine/gxemul
regress/gate_asan_sweep.sh:94:DUMMY=$LOGDIR/dummy.elf
regress/gate_asan_sweep.sh:95:SHELLERR=$LOGDIR/asan_sweep_shellerr.txt
regress/gate_asan_sweep.sh:96:
regress/gate_asan_sweep.sh:97:gate_begin "asan-machine-sweep"
regress/gate_asan_sweep.sh:98:
regress/gate_asan_sweep.sh:99:[ -x "$ASAN_HEAD" ] || gate_skip "no ASan build -- see regress/README.md (build_asan)"
regress/gate_asan_sweep.sh:100:
regress/gate_asan_sweep.sh:101:# Leak reporting off: the emulator is killed mid-run, so exit-time leaks are expected and
regress/gate_asan_sweep.sh:102:# say nothing about correctness. ASan's memory-error detection is unaffected.
regress/gate_asan_sweep.sh:103:#
regress/gate_asan_sweep.sh:104:# verify_asan_link_order=0 is REQUIRED, not cosmetic. `stdbuf` works by LD_PRELOADing
regress/gate_asan_sweep.sh:105:# libstdbuf.so, which then precedes the ASan runtime in the initial library list; ASan
regress/gate_asan_sweep.sh:106:# refuses to start and prints "ASan runtime does not come first in initial library list".
regress/gate_asan_sweep.sh:107:# MEASURED both ways on decstation/5400: without the flag the run produced 155 bytes of
regress/gate_asan_sweep.sh:108:# that complaint and never entered main(); with it, 582 bytes of real emulator output
regress/gate_asan_sweep.sh:109:# ending in the abort diagnostic. Controls that the flag does not weaken detection:
regress/gate_asan_sweep.sh:110:# decstation/pmax still constructs (695 bytes, cpu:+memory:) and sgi/ip12 still reports
regress/gate_asan_sweep.sh:111:# its 4 sanitizer diagnostics.
regress/gate_asan_sweep.sh:112:#
regress/gate_asan_sweep.sh:113:# *** DO NOT TAKE "ASAN ACCEPTED THE FLAG" AS PROOF THE FLAG IS REAL. *** The discriminator
regress/gate_asan_sweep.sh:114:# this project uses for CLI effort tiers was tried here and FAILED to discriminate: this
regress/gate_asan_sweep.sh:115:# ASan silently ignores `no_such_asan_flag_xyz=0` and runs normally. The proof above is
regress/gate_asan_sweep.sh:116:# BEHAVIOURAL -- the flag changes what happens -- which is the only kind available.
regress/gate_asan_sweep.sh:117:export ASAN_OPTIONS=detect_leaks=0:abort_on_error=0:print_summary=1:verify_asan_link_order=0
regress/gate_asan_sweep.sh:118:export UBSAN_OPTIONS=print_stacktrace=0
regress/gate_asan_sweep.sh:119:
regress/gate_asan_sweep.sh:120:# 15 machines abort here by design (see AB_EXEMPT). This host already has `ulimit -c 0`,
regress/gate_asan_sweep.sh:121:# but a host that does not would drop fifteen cores of a 93 MB ASan binary into $LOGDIR.
regress/gate_asan_sweep.sh:122:ulimit -c 0 2>/dev/null || true
regress/gate_asan_sweep.sh:123:
regress/gate_asan_sweep.sh:124:#############################################################################
regress/gate_asan_sweep.sh:125:#  AB_EXEMPT -- THE KNOWN-DEAD SET, DATED AND NAMED.
regress/gate_asan_sweep.sh:126:#
regress/gate_asan_sweep.sh:127:#  Same idiom as gate_offline.sh's SM_EXEMPT/SC_EXEMPT, and for the same reason: a gate
regress/gate_asan_sweep.sh:128:#  that carries debt must carry it OUT LOUD. Entries are `type/subtype:YYYY-MM-DD`.
regress/gate_asan_sweep.sh:129:#
regress/gate_asan_sweep.sh:130:#  WHY A LIST AND NOT A FLOOR. A floor cannot express "none of them died" -- that was
regress/gate_asan_sweep.sh:131:#  B1's second half. A hard count could, but it is brittle: it breaks every time the
regress/gate_asan_sweep.sh:132:#  machine list changes, for no defect. A NAMED list is neither. Adding a machine that
regress/gate_asan_sweep.sh:133:#  works changes nothing; a machine that starts dying is red the same day; and a machine
regress/gate_asan_sweep.sh:134:#  that stops dying is ALSO red (see the "no longer die" check), so the list cannot rot
regress/gate_asan_sweep.sh:135:#  into a lie the way SM_COVERED did before it was cross-checked against real work.
regress/gate_asan_sweep.sh:136:#
regress/gate_asan_sweep.sh:137:#  WHY THESE FIFTEEN, AND WHY THE DIRECTIONAL FRAME DOES NOT COVER THEM.
regress/gate_asan_sweep.sh:138:#  All fifteen were MEASURED on both binaries: they abort IDENTICALLY under pristine
regress/gate_asan_sweep.sh:139:#  39748e3 and under HEAD (rc=134, SIGABRT, same reason text). So the directional rule --
regress/gate_asan_sweep.sh:140:#  the one at the top of this file -- classifies every one of them as "pre-existing,
regress/gate_asan_sweep.sh:141:#  reported not failed", and a purely directional gate would print them and pass. That is
regress/gate_asan_sweep.sh:142:#  right for attributing blame and WRONG for knowing what is dead, which is why this gate
regress/gate_asan_sweep.sh:143:#  now asserts BOTH: `died on HEAD but constructs upstream` (directional, blame) and
regress/gate_asan_sweep.sh:144:#  `died and is not on this list` (absolute, inventory).
regress/gate_asan_sweep.sh:145:#
regress/gate_asan_sweep.sh:146:#  They are upstream's own unported-legacy markers, not fork damage. THREE shapes, each
regress/gate_asan_sweep.sh:147:#  read at the cited line rather than guessed, and the table's `reason` column prints
regress/gate_asan_sweep.sh:148:#  which one a given row hit:
regress/gate_asan_sweep.sh:149:#    * `fatal("TODO: ... rewrite\n"); abort();`  -- machines/machine_pmax.c:365,536;
regress/gate_asan_sweep.sh:150:#      machines/machine_sgi.c:170,218,226,238. The machine's interrupt wiring was never
regress/gate_asan_sweep.sh:151:#      ported to the current interrupt API and the port is commented out directly below
regress/gate_asan_sweep.sh:152:#      the abort. Hit by decstation/{3maxplus,maxine} and sgi/{ip20,ip22,ip24}.
regress/gate_asan_sweep.sh:153:#    * `interrupt_handler_lookup("...") failed. / Aborting.` -- core/interrupt.c:191-198,
regress/gate_asan_sweep.sh:154:#      reached from the same unported wiring via INTERRUPT_CONNECT (interrupt.h:77-80),
regress/gate_asan_sweep.sh:155:#      which DISCARDS the lookup's return value, so a miss cannot be handled by the caller.
regress/gate_asan_sweep.sh:156:#      This is the printf-then-abort() that B1 could not see.
regress/gate_asan_sweep.sh:157:#    * `bus_pci_add(): pci_data == NULL!` -- devices/bus_pci.c:220-222, a machine adding
regress/gate_asan_sweep.sh:158:#      PCI devices to a bus it never created. Hit by mvmeppc/mvme1600.
regress/gate_asan_sweep.sh:159:#
regress/gate_asan_sweep.sh:160:#  *** THE DATE IS MINE, NOT THE OWNER'S, AND IT WANTS CONFIRMING. ***  gate_offline.md's
regress/gate_asan_sweep.sh:161:#  own lesson is that "a deadline nobody chose is a deadline nobody owns"; the owner has
regress/gate_asan_sweep.sh:162:#  previously chosen tighter dates than proposed. 2026-11-30 is a placeholder chosen
regress/gate_asan_sweep.sh:163:#  because these are whole machine ports rather than one-line fixes -- it is not a
regress/gate_asan_sweep.sh:164:#  judgement that they may wait that long.
regress/gate_asan_sweep.sh:165:#
regress/gate_asan_sweep.sh:166:#  hpcmips/{be-300,e-105,agenda} WERE here, and their removal is this ratchet's first
regress/gate_asan_sweep.sh:167:#  discharge -- exactly as the previous version of this comment predicted ("when that
regress/gate_asan_sweep.sh:168:#  lands, the 'no longer die' check goes RED and the fix is to DELETE those three lines").
regress/gate_asan_sweep.sh:169:#  #444 (a29f87b) fixed their constructor deaths, but the check stayed GREEN for a further
regress/gate_asan_sweep.sh:170:#  day because this gate's instrumented binary was built on 2026-07-29 -- the July binary
regress/gate_asan_sweep.sh:171:#  still died, so the exemptions still "held".  *** THE RED ARRIVED ONLY WHEN #450's round
regress/gate_asan_sweep.sh:172:#  REBUILT the binary from current HEAD. ***  A ratchet graded against a stale artefact
regress/gate_asan_sweep.sh:173:#  ratchets nothing; that is `asanstale`, measured live, and the second time in one day the
regress/gate_asan_sweep.sh:174:#  same staleness converted a real result into a wrong one.
regress/gate_asan_sweep.sh:175:AB_EXEMPT="
regress/gate_asan_sweep.sh:176:    alpha/3000/300:2026-11-30
regress/gate_asan_sweep.sh:177:    decstation/3maxplus:2026-11-30
regress/gate_asan_sweep.sh:178:    decstation/maxine:2026-11-30
regress/gate_asan_sweep.sh:179:    decstation/5400:2026-11-30
regress/gate_asan_sweep.sh:180:    decstation/5500:2026-11-30
regress/gate_asan_sweep.sh:181:    mvmeppc/mvme1600:2026-11-30
regress/gate_asan_sweep.sh:182:    mvmeppc/mvme2100:2026-11-30
regress/gate_asan_sweep.sh:183:    sgi/ip19:2026-11-30
regress/gate_asan_sweep.sh:184:    sgi/ip20:2026-11-30
regress/gate_asan_sweep.sh:185:    sgi/ip22:2026-11-30
regress/gate_asan_sweep.sh:186:    sgi/ip24:2026-11-30
regress/gate_asan_sweep.sh:187:    sgi/ip27:2026-11-30
regress/gate_asan_sweep.sh:188:"
regress/gate_asan_sweep.sh:189:
regress/gate_asan_sweep.sh:190:#  A DELIBERATE COPY of gate_offline.sh's exempt_expired(). It belongs in lib.sh and this
regress/gate_asan_sweep.sh:191:#  round may not edit lib.sh, so the duplication is recorded rather than hidden -- see the
regress/gate_asan_sweep.sh:192:#  residual note at the end of this file. The behaviour it encodes was learned the hard
regress/gate_asan_sweep.sh:193:#  way there: an entry with NO date, an UNPADDED date, or a non-date never expired, and
regress/gate_asan_sweep.sh:194:#  still satisfied the coverage check. A malformed entry is RED and names itself.
regress/gate_asan_sweep.sh:195:ab_expired () {          # ab_expired <today> <entries...>
regress/gate_asan_sweep.sh:196:    local today="$1"; shift
regress/gate_asan_sweep.sh:197:    local out="" e d
regress/gate_asan_sweep.sh:198:    for e in "$@"; do
regress/gate_asan_sweep.sh:199:        case "$e" in
regress/gate_asan_sweep.sh:200:            *:*) ;;
regress/gate_asan_sweep.sh:201:            *) out="$out $e(NO-DATE)"; continue ;;
regress/gate_asan_sweep.sh:202:        esac
regress/gate_asan_sweep.sh:203:        d=${e##*:}
regress/gate_asan_sweep.sh:204:        case "$d" in
regress/gate_asan_sweep.sh:205:            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
regress/gate_upstream.sh:1:#!/bin/bash
regress/gate_upstream.sh:2:# GATE 8 -- run upstream GXemul's own tests, on all three builds.
regress/gate_upstream.sh:3:#
regress/gate_upstream.sh:4:# Why this gate is worth having when seven others already exist: everything else in this
regress/gate_upstream.sh:5:# harness was authored by the same process that made the ~290 corrections. These tests
regress/gate_upstream.sh:6:# were written by upstream, before the fork existed, so they encode UPSTREAM's definition
regress/gate_upstream.sh:7:# of correct rather than ours. That independence is the point.
regress/gate_upstream.sh:8:#
regress/gate_upstream.sh:9:# WHAT IT ADDS THAT WE DID NOT ALREADY HAVE. The rigs do load kernels, so loader coverage
regress/gate_upstream.sh:10:# was not zero -- but it was narrow. Measured:
regress/gate_upstream.sh:11:#
regress/gate_upstream.sh:12:#   our rigs load : a.out (bsd.pmax), ELF32 LSB MIPS (arc), ELF32 MSB PPC (macppc),
regress/gate_upstream.sh:13:#                   gzip (landisk .rd)
regress/gate_upstream.sh:14:#   this adds     : ELF64 (RISC-V LSB and SH5 MSB -- a separate code path from ELF32),
regress/gate_upstream.sh:15:#                   b.out i960, MIPS16, and a NEGATIVE case (FileLoader_NonsenseFile),
regress/gate_upstream.sh:16:#                   which is exactly the malformed-input handling the fork hardened
regress/gate_upstream.sh:17:#
regress/gate_upstream.sh:18:# The fork changed SEVEN files under src/file/. Even with this gate, ECOFF, Mach-O, SREC
regress/gate_upstream.sh:19:# and Android still have no corpus here.
regress/gate_upstream.sh:20:#
regress/gate_upstream.sh:21:# TWO MISTAKES THIS GATE MADE ON ITS FIRST RUN, both fixed and both worth recording:
regress/gate_upstream.sh:22:#
regress/gate_upstream.sh:23:#  1. It used `-e testmips`. That is the SUBTYPE flag; the machine type flag is `-E`.
regress/gate_upstream.sh:24:#     Every invocation therefore produced `Sorry, emulation "" (subtype "testmips") is
regress/gate_upstream.sh:25:#     unknown.` -- and the gate compared that identical error across three builds and
regress/gate_upstream.sh:26:#     reported 22 checks passing. Upstream's own configure comment still shows `-e`,
regress/gate_upstream.sh:27:#     which is where the wrong flag came from; it predates the flag change.
regress/gate_upstream.sh:28:#  2. Its only guard was a 100-byte floor on output, which an error message clears
regress/gate_upstream.sh:29:#     easily. A floor proves VOLUME, not VALIDITY. Every case now asserts a
regress/gate_upstream.sh:30:#     format-specific marker that only the real loader path can print -- "ELF64 LSB",
regress/gate_upstream.sh:31:#     "b.out", "a.out" and so on -- so an error, a usage message or an empty run all fail.
regress/gate_upstream.sh:32:#
regress/gate_upstream.sh:33:# DELIBERATELY NOT INCLUDED: test/floatingpoint/fptest.c. It needs a cross-compiler to
regress/gate_upstream.sh:34:# build a program that runs inside the emulator, and gate 2 already proves MORE about the
regress/gate_upstream.sh:35:# one function fix #287 changed: it checks 20 million inputs and shows the difference from
regress/gate_upstream.sh:36:# upstream is exactly what was intended, with nothing extra changed and nothing missed,
regress/gate_upstream.sh:44:SEC=$ROOT/GXEMUL-SEC
regress/gate_upstream.sh:45:T=$SEC/test
regress/gate_upstream.sh:46:PRISTINE=/tmp/gx-pristine/gxemul
regress/gate_upstream.sh:47:PREBATCH=/tmp/gx-prebatch/gxemul
regress/gate_upstream.sh:48:HEAD=$ROOT/build/gxemul
regress/gate_upstream.sh:49:
regress/gate_upstream.sh:50:gate_begin "upstream-test-suite"
regress/gate_upstream.sh:51:need_file "$T"
regress/gate_upstream.sh:52:need_exec "$HEAD"
regress/gate_upstream.sh:53:
regress/gate_upstream.sh:54:# --- upstream's static hygiene check ---------------------------------
regress/gate_upstream.sh:55:# Every file calling `delete` must appear in its exceptions list. Costs milliseconds.
regress/gate_upstream.sh:56:if [ -f "$T/check_delete_calls.sh" ]; then
regress/gate_upstream.sh:57:    ( cd "$SEC" && sh test/check_delete_calls.sh ) > "$LOGDIR/check_delete.out" 2>&1
regress/gate_upstream.sh:58:    check "upstream check_delete_calls.sh" "$?" "0"
regress/gate_upstream.sh:59:    [ -s "$LOGDIR/check_delete.out" ] && head -6 "$LOGDIR/check_delete.out" | sed 's/^/       /'
regress/gate_upstream.sh:60:else
regress/gate_upstream.sh:61:    degrade "check_delete_calls.sh absent"
regress/gate_upstream.sh:62:fi
regress/gate_upstream.sh:63:echo
regress/gate_upstream.sh:64:
regress/gate_upstream.sh:65:# --- upstream's loader corpus, three-way ------------------------------
regress/gate_upstream.sh:66:if [ ! -x "$PRISTINE" ] || [ ! -x "$PREBATCH" ]; then
regress/gate_upstream.sh:67:    degrade "baseline builds absent -- run gate_ab.sh --build for the three-way"
regress/gate_upstream.sh:68:    gate_end; exit $?
regress/gate_upstream.sh:69:fi
regress/gate_upstream.sh:70:
regress/gate_upstream.sh:71:# Normalise the two things that legitimately differ between builds and between runs: the
regress/gate_upstream.sh:72:# version string baked in by configure, and gxemul's random temp filename.
regress/gate_upstream.sh:73:run_case() {   # machine, testfile, binary, outfile
regress/gate_upstream.sh:74:    timeout 20 stdbuf -o0 "$3" -V -E "$1" "$T/$2" </dev/null 2>&1 \
regress/gate_upstream.sh:75:        | sed -e 's|/tmp/gxemul\.[A-Za-z0-9]*|<TMP>|g' \
regress/gate_upstream.sh:76:              -e 's/^GXemul [^ ]*/GXemul <VER>/' > "$4"
regress/gate_upstream.sh:77:}
regress/gate_upstream.sh:78:
regress/gate_upstream.sh:79:# THE LIST OF DIFFERENCES WE MEANT TO MAKE.
regress/gate_upstream.sh:80:#
regress/gate_upstream.sh:81:# This fork changed about 290 things on purpose, so "upstream and current differ" is not
regress/gate_upstream.sh:82:# by itself a problem -- just counting differences is useless when hundreds are deliberate.
regress/gate_upstream.sh:83:# What makes the comparison workable is sorting each difference into one of three boxes:
regress/gate_upstream.sh:84:#
regress/gate_upstream.sh:85:#     the same                          -> fine
regress/gate_upstream.sh:86:#     differs, and it is fix #N         -> fine, and #N is named below
regress/gate_upstream.sh:87:#     differs, and nobody knows why     -> REGRESSION
regress/gate_upstream.sh:88:#
regress/gate_upstream.sh:89:# Each entry below cancels out exactly one intended change, so anything still left over is
regress/gate_upstream.sh:90:# unexplained by definition. Adding an entry is a deliberate act: it says "we changed this
regress/gate_upstream.sh:91:# on purpose, under this fix number".
regress/gate_upstream.sh:92:#
regress/gate_upstream.sh:93:#   #260 -- net diagnostics were routed through debugmsg(SUBSYS_NET, ...), which prefixes
regress/gate_upstream.sh:94:#           them with "net: ". Upstream printed them bare.
regress/gate_upstream.sh:95:intended_norm() {
regress/gate_upstream.sh:96:    sed -e 's/^\(  *\)net: /\1/'
regress/gate_upstream.sh:97:}
regress/gate_upstream.sh:98:
regress/gate_upstream.sh:99:note "upstream loader corpus across pristine / pre-batch / HEAD"
regress/gate_upstream.sh:100:note "'raw' = differences vs upstream; 'unexpl' = what remains after known-intended ones"
regress/gate_upstream.sh:101:printf "  %-26s %-11s %-10s %-11s %s\n" "case" "loader-ran" "raw-diff" "unexplained" "pre=HEAD"
regress/gate_upstream.sh:102:
regress/gate_upstream.sh:103:# machine : file : marker only the real loader path can print
regress/gate_upstream.sh:104:for spec in "testmips:FileLoader_ELF_MIPS:ELF32 MSB" \
regress/gate_upstream.sh:105:            "testmips:FileLoader_ELF_MIPS16:ELF32 MSB" \
regress/gate_upstream.sh:106:            "testriscv:FileLoader_ELF_RISCV64:ELF64 LSB" \
regress/gate_upstream.sh:107:            "testsh:FileLoader_ELF_SH5:ELF64 MSB" \
regress/gate_upstream.sh:108:            "testm88k:FileLoader_A.OUT_M88K:a.out" \
regress/gate_upstream.sh:109:            "barei960:FileLoader_B.OUT_i960:b.out" \
regress/gate_upstream.sh:110:            "testmips:FileLoader_NonsenseFile:symbol"; do
regress/gate_upstream.sh:111:    m=${spec%%:*}; rest=${spec#*:}; f=${rest%%:*}; marker=${rest#*:}
regress/gate_upstream.sh:112:    if [ ! -f "$T/$f" ]; then degrade "$f absent"; continue; fi
regress/gate_upstream.sh:113:
regress/gate_upstream.sh:114:    run_case "$m" "$f" "$PRISTINE" "$LOGDIR/up_pri.txt"
regress/gate_upstream.sh:115:    run_case "$m" "$f" "$PREBATCH" "$LOGDIR/up_pre.txt"
regress/gate_upstream.sh:116:    run_case "$m" "$f" "$HEAD"     "$LOGDIR/up_head.txt"
regress/gate_upstream.sh:117:
regress/gate_upstream.sh:118:    ran=$(grep -ac -- "$marker" "$LOGDIR/up_head.txt")
regress/gate_upstream.sh:119:
regress/gate_upstream.sh:120:    # raw differences, before adjudication
regress/gate_upstream.sh:121:    raw=$(diff "$LOGDIR/up_pri.txt" "$LOGDIR/up_head.txt" | grep -c '^[<>]')
regress/gate_upstream.sh:122:
regress/gate_upstream.sh:123:    # after erasing every KNOWN-INTENDED change, nothing may remain
regress/gate_upstream.sh:124:    intended_norm < "$LOGDIR/up_pri.txt"  > "$LOGDIR/up_pri_n.txt"
regress/gate_upstream.sh:125:    intended_norm < "$LOGDIR/up_pre.txt"  > "$LOGDIR/up_pre_n.txt"
regress/gate_upstream.sh:126:    intended_norm < "$LOGDIR/up_head.txt" > "$LOGDIR/up_head_n.txt"
regress/gate_upstream.sh:127:    unexplained=$(diff "$LOGDIR/up_pri_n.txt" "$LOGDIR/up_head_n.txt" | grep -c '^[<>]')
regress/gate_upstream.sh:128:    b=$(cmp -s "$LOGDIR/up_pre_n.txt" "$LOGDIR/up_head_n.txt" && echo same || echo DIFF)
regress/gate_upstream.sh:129:
regress/gate_upstream.sh:130:    printf "  %-26s %-11s %-10s %-11s %s\n" "$f" \
regress/gate_upstream.sh:131:        "$([ "$ran" != 0 ] && echo yes || echo NO)" "$raw" "$unexplained" "$b"
regress/gate_upstream.sh:132:
regress/gate_upstream.sh:133:    # POSITIVE ASSERTION FIRST. Without it, three builds agreeing on an error message
regress/gate_upstream.sh:134:    # counts as agreement -- which is exactly what this gate did on its first run.
regress/gate_upstream.sh:135:    check_min "$f: loader ran ('$marker')"          "$ran"         1
regress/gate_upstream.sh:136:    check     "$f: unexplained diffs vs upstream"   "$unexplained" "0"
regress/gate_upstream.sh:137:    check     "$f: pre-batch == HEAD"               "$b"           "same"
regress/gate_upstream.sh:138:    if [ "$unexplained" != 0 ] || [ "$b" = DIFF ]; then
regress/gate_upstream.sh:139:        diff "$LOGDIR/up_pri_n.txt" "$LOGDIR/up_head_n.txt" | head -8 | sed 's/^/       /'
regress/gate_upstream.sh:140:    fi
regress/gate_upstream.sh:141:done
regress/gate_upstream.sh:142:
regress/gate_upstream.sh:143:gate_end
regress/gate_upstream.sh:144:exit $?
regress/gate_mips_folds.sh:1:#!/bin/bash
regress/gate_mips_folds.sh:2:# GATE 16 -- MIPS instruction-combiner ("fold") witness (#388).
regress/gate_mips_folds.sh:3:#
regress/gate_mips_folds.sh:4:# What this protects
regress/gate_mips_folds.sh:5:# -----------------
regress/gate_mips_folds.sh:6:# The nine MIPS COMBINE sites install 34 fold-handler variants, and before #388
regress/gate_mips_folds.sh:7:# NOTHING could witness one firing: most folds are architecturally transparent
regress/gate_mips_folds.sh:8:# by construction, so any result-asserting row passes whether or not the fold
regress/gate_mips_folds.sh:9:# fires -- the recorded vacuity mode. #388 added pull-only install/fire counters
regress/gate_mips_folds.sh:10:# (cpu_mips.h) printed by tlbdump as a prefix-bound MFOLD block. This gate runs
regress/gate_mips_folds.sh:11:# regress/mips_fold_probe.py, whose rows drive real fold loops free-running
regress/gate_mips_folds.sh:12:# (never step -- combining gates on !single_step) with a breakpoint AFTER each
regress/gate_mips_folds.sh:13:# sequence on a NON-ARMING instruction, and grades the counters as EQUALITIES
regress/gate_mips_folds.sh:14:# derived from the read-ahead rule (a breakpoint anywhere disables read-ahead
regress/gate_mips_folds.sh:15:# machine-wide, so fire == passes-1; the derivations live in the probe's rows).
regress/gate_mips_folds.sh:16:#
regress/gate_mips_folds.sh:17:# Non-vacuity: deleting the bne_samepage_nop replacement sub-arm (incl. its
regress/gate_mips_folds.sh:18:# install++) in a scratch build flips exactly that fold to (0,0) and reddens
regress/gate_mips_folds.sh:19:# its two rows while every other row stays green -- measured 2026-08-12
regress/gate_mips_folds.sh:20:# (M388MUT_PASS), the per-variant attribution -J cannot give.
regress/gate_mips_folds.sh:21:#
regress/gate_mips_folds.sh:22:# The BE rows are the first big-endian MIPS guest executions in this harness;
regress/gate_mips_folds.sh:23:# the mlw2v* value rows additionally witness the _be generated body's BE32
regress/gate_mips_folds.sh:24:# assembly + sign extension, not just its selection.
regress/gate_mips_folds.sh:25:set -u
regress/gate_mips_folds.sh:26:cd "$(dirname "$0")"
regress/gate_mips_folds.sh:27:. ./lib.sh
regress/gate_mips_folds.sh:28:
regress/gate_mips_folds.sh:29:gate_begin "gate 16: MIPS fold witness (#388)"
regress/gate_mips_folds.sh:30:
regress/gate_mips_folds.sh:31:PMAX=${PMAX:-$ROOT/build/gxemul}
regress/gate_mips_folds.sh:32:PMAX_KERNEL=$ROOT/gxemul_pmax_rig/bsd
regress/gate_mips_folds.sh:33:
regress/gate_mips_folds.sh:34:if [ ! -x "$PMAX" ]; then gate_skip "no gxemul binary at $PMAX"; fi
regress/gate_mips_folds.sh:35:if [ ! -f "$PMAX_KERNEL" ]; then gate_skip "no pmax kernel at $PMAX_KERNEL"; fi
regress/gate_mips_folds.sh:36:
regress/gate_mips_folds.sh:37:FLOG=$LOGDIR/gate_mips_folds.log
regress/gate_mips_folds.sh:38:python3 mips_fold_probe.py "$PMAX" "$PMAX_KERNEL" > "$FLOG" 2>&1 || true
regress/gate_mips_folds.sh:39:
regress/gate_mips_folds.sh:40:#  #388 pass-2 (four seats convergent): a probe that STARTED but produced no
regress/gate_mips_folds.sh:41:#  result line is a failure of the thing under test (crash, dead emulator,
regress/gate_mips_folds.sh:42:#  unwritable /tmp), not preflight -- it must FAIL, not skip (lib.sh's #371
regress/gate_mips_folds.sh:43:#  doctrine: skip = could-not-run-at-all; the binary/kernel checks above are
regress/gate_mips_folds.sh:44:#  the real preflight). A silent skip here would report
regress/gate_mips_folds.sh:45:#  REGRESS_PASS_WITH_GAPS while removing all fold coverage.
regress/gate_mips_folds.sh:46:if ! grep -q "MFOLDPROBE_RESULT=" "$FLOG"; then
regress/gate_mips_folds.sh:47:    note "fold probe produced no result line; last lines follow"
regress/gate_mips_folds.sh:48:    tail -5 "$FLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:49:fi
regress/gate_mips_folds.sh:50:check "fold probe completed (result line present)" \
regress/gate_mips_folds.sh:51:      "$(grep -q 'MFOLDPROBE_RESULT=' "$FLOG" && echo yes || echo no)" "yes"
regress/gate_mips_folds.sh:52:
regress/gate_mips_folds.sh:53:grep -E " ok$| FAIL$" "$FLOG" | sed 's/^/       /'
regress/gate_mips_folds.sh:54:
regress/gate_mips_folds.sh:55:#  Every row named individually (the %-24s column keeps two-space anchoring
regress/gate_mips_folds.sh:56:#  satisfiable; no name is a prefix of another).
regress/gate_mips_folds.sh:57:for v in "bne_nop_3max" "bne_nop_tm64" "lui_ori_3max" \
regress/gate_mips_folds.sh:58:         "mlw2_le_3max" "mlw2v0_le_3max" "mlw2v1_le_3max" \
regress/gate_mips_folds.sh:59:         "mlw2_be_tm64" "mlw2v0_be_tm64" "mlw2v1_be_tm64" \
regress/gate_mips_folds.sh:60:         "mlw2_be_tm32" "mlw2v0_be_tm32" "mlw2v1_be_tm32" \
regress/gate_mips_folds.sh:61:         "mlw2_dev_tm64" "memset_3max"; do
regress/gate_mips_folds.sh:62:    n=$(count "$FLOG" "^$v  *.*ok$")
regress/gate_mips_folds.sh:63:    check "  fold row: $v" "$n" 1
regress/gate_mips_folds.sh:64:done
regress/gate_mips_folds.sh:65:
regress/gate_mips_folds.sh:66:fctrl=$(grep -o "MFOLDPROBE_CONTROL=[A-Z]*" "$FLOG" | tail -1 | cut -d= -f2)
regress/gate_mips_folds.sh:67:check "fold probe control (parse liveness)" "${fctrl:-missing}" "OK"
regress/gate_mips_folds.sh:68:
regress/gate_mips_folds.sh:69:fres=$(grep -o "MFOLDPROBE_RESULT=[0-9]*/[0-9]*" "$FLOG" | tail -1 | cut -d= -f2)
regress/gate_mips_folds.sh:70:check "fold rows correct" "${fres:-missing}" "14/14"
regress/gate_mips_folds.sh:71:
regress/gate_mips_folds.sh:72:gate_end

