63:DEVICE_ACCESS(disk_buf)
64:{
65:	struct disk_data *d = (struct disk_data *) extra;
66:	size_t safe = len;
67:
68:	/*
69:	 *  Bound the access to the buffer: a guest must not be able to make
70:	 *  this memcpy read or (worse) write past d->buf via a misaligned or
71:	 *  end-spanning access to the data-buffer region.
72:	 */
73:	if (relative_addr >= d->buf_len) {
74:		static int warned = 0;	/* #119: loud-once (course-correction) */
75:		if (!warned) {
76:			fatal("[ dev_disk: access at 0x%x beyond buffer 0x%x; "
77:			    "ignored ]\n", (int)relative_addr, (int)d->buf_len);
78:			warned = 1;
79:		}
80:		if (writeflag != MEM_WRITE)
81:			memset(data, 0, len);
82:		return 1;
83:	}
84:	if (relative_addr + len > d->buf_len) {
85:		static int warned2 = 0;	/* #119: loud-once on the end-span clamp */
86:		if (!warned2) {
87:			fatal("[ dev_disk: end-spanning access at 0x%x+%i clamped "
88:			    "to buffer 0x%x ]\n", (int)relative_addr, (int)len,
89:			    (int)d->buf_len);
90:			warned2 = 1;
91:		}
92:		safe = d->buf_len - relative_addr;
93:	}
