600:        note "#450 $s: shift=$sh450 asan=$as450 constructed=$live450 -- sites: $(grep -oE 'arcbios\.c:[0-9]+' "$LOGDIR/ub450.txt" | sort -u | tr '\n' ' ')"
607:#  every sanitizer, and silently drops bit 31 -- both #450 rows stayed green over a real
614:#  under set -u -- after the behavioural row had already printed ok, and with the wrapper
620:grep -E '^  (ok|FAIL) ' "$ARCSLOG" | sed 's/^/       /'
1:#!/bin/bash
2:# GATE 16 -- MIPS instruction-combiner ("fold") witness (#388).
3:#
4:# What this protects
5:# -----------------
6:# The nine MIPS COMBINE sites install 34 fold-handler variants, and before #388
7:# NOTHING could witness one firing: most folds are architecturally transparent
8:# by construction, so any result-asserting row passes whether or not the fold
9:# fires -- the recorded vacuity mode. #388 added pull-only install/fire counters
10:# (cpu_mips.h) printed by tlbdump as a prefix-bound MFOLD block. This gate runs
11:# regress/mips_fold_probe.py, whose rows drive real fold loops free-running
12:# (never step -- combining gates on !single_step) with a breakpoint AFTER each
13:# sequence on a NON-ARMING instruction, and grades the counters as EQUALITIES
14:# derived from the read-ahead rule (a breakpoint anywhere disables read-ahead
15:# machine-wide, so fire == passes-1; the derivations live in the probe's rows).
16:#
17:# Non-vacuity: deleting the bne_samepage_nop replacement sub-arm (incl. its
18:# install++) in a scratch build flips exactly that fold to (0,0) and reddens
19:# its two rows while every other row stays green -- measured 2026-08-12
20:# (M388MUT_PASS), the per-variant attribution -J cannot give.
21:#
22:# The BE rows are the first big-endian MIPS guest executions in this harness;
23:# the mlw2v* value rows additionally witness the _be generated body's BE32
24:# assembly + sign extension, not just its selection.
25:set -u
26:cd "$(dirname "$0")"
27:. ./lib.sh
28:
29:gate_begin "gate 16: MIPS fold witness (#388)"
30:
31:PMAX=${PMAX:-$ROOT/build/gxemul}
32:PMAX_KERNEL=$ROOT/gxemul_pmax_rig/bsd
33:
34:if [ ! -x "$PMAX" ]; then gate_skip "no gxemul binary at $PMAX"; fi
35:if [ ! -f "$PMAX_KERNEL" ]; then gate_skip "no pmax kernel at $PMAX_KERNEL"; fi
36:
37:FLOG=$LOGDIR/gate_mips_folds.log
38:python3 mips_fold_probe.py "$PMAX" "$PMAX_KERNEL" > "$FLOG" 2>&1 || true
39:
40:#  #388 pass-2 (four seats convergent): a probe that STARTED but produced no
41:#  result line is a failure of the thing under test (crash, dead emulator,
42:#  unwritable /tmp), not preflight -- it must FAIL, not skip (lib.sh's #371
43:#  doctrine: skip = could-not-run-at-all; the binary/kernel checks above are
44:#  the real preflight). A silent skip here would report
45:#  REGRESS_PASS_WITH_GAPS while removing all fold coverage.
46:if ! grep -q "MFOLDPROBE_RESULT=" "$FLOG"; then
47:    note "fold probe produced no result line; last lines follow"
48:    tail -5 "$FLOG" | sed 's/^/       /'
49:fi
50:check "fold probe completed (result line present)" \
51:      "$(grep -q 'MFOLDPROBE_RESULT=' "$FLOG" && echo yes || echo no)" "yes"
52:
53:grep -E " ok$| FAIL$" "$FLOG" | sed 's/^/       /'
54:
55:#  Every row named individually (the %-24s column keeps two-space anchoring
56:#  satisfiable; no name is a prefix of another).
57:for v in "bne_nop_3max" "bne_nop_tm64" "lui_ori_3max" \
58:         "mlw2_le_3max" "mlw2v0_le_3max" "mlw2v1_le_3max" \
59:         "mlw2_be_tm64" "mlw2v0_be_tm64" "mlw2v1_be_tm64" \
60:         "mlw2_be_tm32" "mlw2v0_be_tm32" "mlw2v1_be_tm32" \
61:         "mlw2_dev_tm64" "memset_3max"; do
62:    n=$(count "$FLOG" "^$v  *.*ok$")
63:    check "  fold row: $v" "$n" 1
64:done
65:
66:fctrl=$(grep -o "MFOLDPROBE_CONTROL=[A-Z]*" "$FLOG" | tail -1 | cut -d= -f2)
67:check "fold probe control (parse liveness)" "${fctrl:-missing}" "OK"
68:
69:fres=$(grep -o "MFOLDPROBE_RESULT=[0-9]*/[0-9]*" "$FLOG" | tail -1 | cut -d= -f2)
70:check "fold rows correct" "${fres:-missing}" "14/14"
71:
72:gate_end

