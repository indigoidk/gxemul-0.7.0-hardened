src/cpus/cpu_mips_instr_unaligned.c:96:				/*  #227: (Codex/Fable/agy) the pre-read is a MEM_READ so it
src/cpus/cpu_mips_instr_unaligned.c:97:				    raised a LOAD-side exception; this is a store -> map only
src/cpus/cpu_mips_instr_unaligned.c:98:				    the load codes to their store counterparts (TLBL->TLBS,
src/cpus/cpu_mips_instr_unaligned.c:99:				    AdEL->AdES) and leave the rest (DBE is shared load/store;
src/cpus/cpu_mips_instr_unaligned.c:100:				    Mod can't come from a read).  */
src/cpus/cpu_mips_instr_unaligned.c:101:				int exc = (cpu->cd.mips.coproc[0]->reg[COP0_CAUSE]
src/cpus/cpu_mips_instr_unaligned.c:102:				    & CAUSE_EXCCODE_MASK) >> CAUSE_EXCCODE_SHIFT;
src/cpus/cpu_mips_instr_unaligned.c:103:				if (exc == EXCEPTION_TLBL)
src/cpus/cpu_mips_instr_unaligned.c:104:					exc = EXCEPTION_TLBS;
src/cpus/cpu_mips_instr_unaligned.c:105:				else if (exc == EXCEPTION_ADEL)
src/cpus/cpu_mips_instr_unaligned.c:106:					exc = EXCEPTION_ADES;
src/cpus/cpu_mips_instr_unaligned.c:107:				cpu->cd.mips.coproc[0]->reg[COP0_CAUSE] =
src/cpus/cpu_mips_instr_unaligned.c:108:				    (cpu->cd.mips.coproc[0]->reg[COP0_CAUSE]
src/cpus/cpu_mips_instr_unaligned.c:109:				    & ~CAUSE_EXCCODE_MASK) | (exc << CAUSE_EXCCODE_SHIFT);
src/cpus/cpu_mips_instr_unaligned.c:110:			}
src/cpus/cpu_mips_instr_unaligned.c:111:			return;
src/cpus/cpu_mips_instr_unaligned.c:112:		}
src/cpus/cpu_mips_instr_unaligned.c:113:
src/cpus/cpu_mips_instr_unaligned.c:114:		for (i=0; i<wlen; i++) {
src/cpus/cpu_mips_instr_unaligned.c:115:			tmpaddr = addr + i*dir;
src/cpus/cpu_mips_instr_unaligned.c:116:			/*  Have we moved into another word/dword? Then stop: */
src/cpus/cpu_mips_instr_unaligned.c:117:			if ( (tmpaddr & ~(wlen-1)) != (addr & ~(wlen-1)) )
src/cpus/cpu_mips_instr_unaligned.c:118:				break;
src/cpus/cpu_mips_instr_unaligned.c:119:
src/cpus/cpu_mips_instr_unaligned.c:120:			/*  debug("unaligned byte at %016"PRIx64",
src/cpus/cpu_mips_instr_unaligned.c:121:			    reg_ofs=%i reg=0x%016"PRIx64"\n",
src/cpus/cpu_mips_instr_unaligned.c:122:			    tmpaddr, reg_ofs, (long long)result_value);  */
src/cpus/cpu_mips_instr_unaligned.c:123:
src/cpus/cpu_mips_instr_unaligned.c:124:			/*  Store one byte:  */
src/cpus/cpu_mips_instr_unaligned.c:125:			aligned_word[tmpaddr & (wlen-1)] =
src/cpus/cpu_mips_instr_unaligned.c:126:			    (result_value >> (reg_ofs * 8)) & 255;
src/cpus/cpu_mips_instr_unaligned.c:127:
src/cpus/cpu_mips_instr_unaligned.c:128:			reg_ofs += reg_dir;
src/cpus/cpu_mips_instr_unaligned.c:129:		}
src/cpus/cpu_mips_instr_unaligned.c:130:
src/cpus/cpu_mips_instr_unaligned.c:131:		ok = cpu->memory_rw(cpu, cpu->mem,
src/cpus/cpu_mips_instr_unaligned.c:132:		    aligned_addr, &aligned_word[0], wlen,
src/cpus/cpu_mips_instr_unaligned.c:133:		    MEM_WRITE, CACHE_DATA);
src/cpus/cpu_mips_instr_unaligned.c:134:
src/cpus/cpu_mips_instr_unaligned.c:135:		return;
src/cpus/cpu_mips_instr_unaligned.c:136:	}
src/cpus/cpu_mips_instr_unaligned.c:137:
src/cpus/cpu_mips_instr_unaligned.c:138:	/*  Load:  */
src/cpus/cpu_mips_instr_unaligned.c:139:	ok = cpu->memory_rw(cpu, cpu->mem, aligned_addr, &aligned_word[0], wlen,
src/cpus/cpu_mips_instr_unaligned.c:140:	    MEM_READ, CACHE_DATA);
src/cpus/cpu_mips_instr_unaligned.c:141:	if (!ok)
src/cpus/cpu_mips_instr_unaligned.c:142:		return;
src/cpus/cpu_mips_instr_unaligned.c:143:
src/cpus/cpu_mips_instr_unaligned.c:144:	for (i=0; i<wlen; i++) {
src/cpus/cpu_mips_instr_unaligned.c:145:		tmpaddr = addr + i*dir;
src/cpus/cpu_mips_instr_unaligned.c:146:		/*  Have we moved into another word/dword? Then stop: */
src/cpus/cpu_mips_instr_unaligned.c:147:		if ( (tmpaddr & ~(wlen-1)) != (addr & ~(wlen-1)) )
src/cpus/cpu_mips_instr_unaligned.c:148:			break;
src/cpus/cpu_mips_instr_unaligned.c:149:
src/cpus/cpu_mips_instr_unaligned.c:150:		/*  debug("unaligned byte at %016"PRIx64", reg_ofs=%i reg="
src/cpus/cpu_mips_instr_unaligned.c:151:		    "0x%016"PRIx64"\n", (uint64_t) tmpaddr,
src/cpus/cpu_mips_instr_unaligned.c:152:		    reg_ofs, (uint64_t)result_value); */
src/cpus/cpu_mips_instr_unaligned.c:153:
src/cpus/cpu_mips_instr_unaligned.c:154:		/*  Load one byte:  */
src/cpus/cpu_mips_instr_unaligned.c:155:		databyte = aligned_word[tmpaddr & (wlen-1)];
src/cpus/cpu_mips_instr_unaligned.c:156:		result_value &= ~((uint64_t)0xff << (reg_ofs * 8));
src/cpus/cpu_mips_instr_unaligned.c:157:		result_value |= (uint64_t)databyte << (reg_ofs * 8);
src/cpus/cpu_mips_instr_unaligned.c:158:
src/cpus/cpu_mips_instr_unaligned.c:159:		reg_ofs += reg_dir;
src/cpus/cpu_mips_instr_unaligned.c:160:	}
src/cpus/cpu_mips_instr_unaligned.c:161:
src/cpus/cpu_mips_instr_unaligned.c:162:	/*  Sign extend for 32-bit load lefts:  */
src/cpus/cpu_mips_instr_unaligned.c:163:	if (!store && wlen == sizeof(uint32_t))
src/cpus/cpu_mips_instr_unaligned.c:164:		result_value = (int32_t)result_value;
src/cpus/cpu_mips_instr_unaligned.c:165:
src/cpus/cpu_mips_instr_unaligned.c:166:	(*(uint64_t *)ic->arg[0]) = result_value;
src/cpus/cpu_mips_instr_unaligned.c:167:}
