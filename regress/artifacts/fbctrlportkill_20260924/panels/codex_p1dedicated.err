305:
306:MACHINE_SETUP(testmips)
307:{
308:	/*
309:	 *  A MIPS test machine. Originally, this was created as a way for
310:	 *  me to test my master's thesis code; since then it has both
311:	 *  evolved to support new things, and suffered bit rot so that it
312:	 *  no longer can run my thesis code. Well, well...
313:	 *
314:	 *  IRQ map:
315:	 *      7       CPU counter
316:	 *      6       SMP IPIs
317:	 *      5       not used yet
318:	 *      4       rtc
319:	 *      3       ethernet  
320:	 *      2       serial console
321:	 */
322:
323:	char tmpstr[300];
324:
325:	machine->machine_name = strdup("MIPS test machine");
326:	cpu->byte_order = EMUL_BIG_ENDIAN;
327:
328:	snprintf(tmpstr, sizeof(tmpstr), "cons addr=0x%" PRIx64" irq=%s."
329:	    "cpu[%i].2", (uint64_t) DEV_CONS_ADDRESS, machine->path,
330:	    machine->bootstrap_cpu);
331:	machine->main_console_handle = (size_t)device_add(machine, tmpstr);
332:
333:	snprintf(tmpstr, sizeof(tmpstr), "mp addr=0x%" PRIx64" irq=6",
334:	    (uint64_t) DEV_MP_ADDRESS);
335:	device_add(machine, tmpstr);
336:
337:	snprintf(tmpstr, sizeof(tmpstr), "fbctrl addr=0x%" PRIx64,
338:	    (uint64_t) DEV_FBCTRL_ADDRESS);
339:	device_add(machine, tmpstr);
340:
341:	snprintf(tmpstr, sizeof(tmpstr), "disk addr=0x%" PRIx64,
342:	    (uint64_t) DEV_DISK_ADDRESS);
343:	device_add(machine, tmpstr);
344:
345:	snprintf(tmpstr, sizeof(tmpstr), "ether addr=0x%" PRIx64" irq=%s."
346:	    "cpu[%i].3", (uint64_t) DEV_ETHER_ADDRESS, machine->path,
347:	    machine->bootstrap_cpu);
348:	device_add(machine, tmpstr);
349:
350:	snprintf(tmpstr, sizeof(tmpstr), "rtc addr=0x%" PRIx64" irq=%s."
351:	    "cpu[%i].4", (uint64_t) DEV_RTC_ADDRESS, machine->path,
352:	    machine->bootstrap_cpu);
353:	device_add(machine, tmpstr);
354:
355:	/*
356:	 *  Support for more than 256 MB RAM, as suggested in doc/TODO.html:
357:	 *
358:	 *	"testmips: Add support for more than 256 MB ram, e.g. by
359:	 *	 adding 'actual RAM' at the 1 GB offset. A 32 bit machine
360:	 *	 can thus use 3 GB, no limit on 64 bit machines. Low 256 MB
361:	 *	 can be considered a mirror of first 256 MB of RAM."
362:	 *
363:	 *  The machine's base RAM is created generically (emul.c) at
364:	 *  physical address 0, so with -M larger than 256 it would grow
365:	 *  into the experimental devices at 0x10000000 and up. Instead,
366:	 *  when more than 256 MB is requested, the full amount is made
367:	 *  visible as one contiguous block of "actual RAM" at the 1 GB
368:	 *  offset (0x40000000): the first 256 MB of that block is a
369:	 *  mirror of the low 256 MB (which is the base RAM, exactly as
370:	 *  before), and the remainder is real RAM at 0x50000000. The
371:	 *  mirror forwards both reads and writes, so the low 256 MB and
372:	 *  the first 256 MB at 0x40000000 always contain the same bytes,
373:	 *  which is precisely the TODO entry's layout (just with the
374:	 *  backing store in the low region; guest-invisible). Registered
375:	 *  devices take precedence over base RAM in memory_rw(), so the
376:	 *  devices at 0x10000000..0x1fffffff remain accessible, and with
377:	 *  -M larger than 1024 the mirror + high RAM simply shadow the
378:	 *  base RAM that would otherwise overlap them. This is the same
379:	 *  scheme the SGI O2 emulation uses (machine_sgi.c), with the
380:	 *  window at 1 GB.
381:	 *
382:	 *  With -M 256 or less (including the default), nothing is added
383:	 *  here and the machine behaves exactly as it always has.
384:	 */
385:	if (machine->physical_ram_in_mb > 256) {
386:		debugmsg(SUBSYS_MACHINE, "testmips high RAM", VERBOSITY_INFO,
387:		    "%i MB at 0x40000000 (low 256 MB mirrors its first 256 MB)",
388:		    machine->physical_ram_in_mb);
389:
390:		/*  Mirror of the low 256 MB of RAM, at the 1 GB offset:  */
391:		dev_ram_init(machine, 0x40000000ULL, 0x10000000ULL,
392:		    DEV_RAM_MIRROR, 0x0, "ram_mirror");
393:
394:		/*  The rest of the "actual RAM", directly above the mirror
395:		    (i.e. at 1 GB + 256 MB), making 0x40000000 .. 0x40000000
396:		    + physical_ram_in_mb one contiguous RAM block:  */
397:		dev_ram_init(machine, 0x50000000ULL,
398:		    ((uint64_t) machine->physical_ram_in_mb - 256) * 1048576,
399:		    DEV_RAM_RAM, 0x0, "ram_high");
400:	}
401:}
