172:MACHINE_SETUP(barearm)
173:{
174:	machine->machine_name = strdup("Generic \"bare\" ARM machine");
175:
176:#if 1
177:	// An experiment with running a particular firmware image on a device;
178:	// move some other place when/if it works?
179:	cpu->byte_order = EMUL_BIG_ENDIAN;
180:
181:	dev_ram_init(machine, 0xa0000000, 128 * 1048576, DEV_RAM_MIRROR
182:		| DEV_RAM_MIGHT_POINT_TO_DEVICES, 0x00000000, "ram_mirror");
183:#endif
184:}
185:
186:
187:MACHINE_SETUP(testarm)
188:{
189:	machine->machine_name = strdup("ARM test machine");
190:
191:	default_test(machine, cpu);
192:
193:	/*
194:	 *  Place a tiny stub at end of memory, and set the link register to
195:	 *  point to it. This stub halts the machine (making it easy to try
196:	 *  out simple stand-alone C functions).
197:	 */
198:	cpu->cd.arm.r[ARM_SP] = machine->physical_ram_in_mb * 1048576 - 4096;
199:	cpu->cd.arm.r[ARM_LR] = cpu->cd.arm.r[ARM_SP] + 32;
200:	store_32bit_word(cpu, cpu->cd.arm.r[ARM_LR] + 0, 0xe3a00201);
201:	store_32bit_word(cpu, cpu->cd.arm.r[ARM_LR] + 4, 0xe5c00010);
202:	store_32bit_word(cpu, cpu->cd.arm.r[ARM_LR] + 8, 0xeafffffe);
203:}
