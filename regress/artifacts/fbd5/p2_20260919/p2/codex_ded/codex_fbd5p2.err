 404:     def close(self, patience=20.0):
 405:         try:
 406:             os.write(self.fd, b"quit\n")
 407:         except OSError:
 408:             pass
 409:         # Drain through EOF; closing a live master can SIGHUP the child.
 410:         deadline = time.monotonic() + patience
 411:         eof = False
 412:         while True:
 413:             left = deadline - time.monotonic()
 414:             if left <= 0:
 415:                 break
 416:             if not self.rd(min(0.1, left)):
 417:                 eof = True
 418:                 break
 419:         try:
 420:             os.close(self.fd)
 421:         except OSError:
 422:             pass
 423:         #  #539 (pass 2): BOUNDED reap.  A child that survives the master close (SIGHUP ignored or
 424:         #  blocked, or stopped) would hang a blocking waitpid forever; poll, then kill, then wait.
 425:         pid, st, gone = 0, None, False
 426:         t1 = time.time()
 427:         while pid == 0 and time.time() - t1 < 10.0:
 428:             try:
 429:                 pid, st = os.waitpid(self.pid, os.WNOHANG)
 430:             except OSError:
 431:                 gone = True      # ECHILD: already reaped elsewhere -- its pid may be recycled; never kill it
 432:                 break
 433:             if pid == 0:
 434:                 time.sleep(0.05)
 435:         harness_killed = False
 436:         if pid == 0 and not gone:
 437:             #  F2 (#539): a kill WE fire is labelled, so a red from it is attributed to the harness --
 438:             #  a healthy child SIGKILLed by a too-short budget would otherwise read like a product
 439:             #  signal death (byte-identical to the y_sigkill mutant).  Budgets: 20 s drain + 10 s here.
 440:             harness_killed = True
 441:             try:
 442:                 os.kill(self.pid, signal.SIGKILL)
 443:             except OSError:
 444:                 pass
 445:             try:
 446:                 _, st = os.waitpid(self.pid, 0)
 447:             except OSError:
 448:                 st = None
 449:         code = os.WEXITSTATUS(st) if st is not None and os.WIFEXITED(st) else None
 450:         sig = os.WTERMSIG(st) if st is not None and os.WIFSIGNALED(st) else None
 451:         if harness_killed and sig == signal.SIGKILL:
 452:             sig = "HARNESS-KILL(%s)" % sig     # our kill; a kill landing on a zombie reaps the
 453:                                                 # product's own status and stays unlabelled
 454:         elif not eof and sig is not None:
 455:             sig = "HARNESS-CLOSE(%s)" % sig   # the drain deadline expired; our close() HUP'd a live child
 456:         return dict(exit=code, signal=sig)
