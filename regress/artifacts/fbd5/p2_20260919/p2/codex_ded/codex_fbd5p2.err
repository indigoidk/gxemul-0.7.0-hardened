 469: def spell_ok(expected, got):
 470:     """The emulator's own spelling differs cosmetically from the generator's:
 471:     it prints `ldr r5,[r4]` for a zero offset and `#0` rather than `#0x0`.  Those
 472:     are FORMAT differences, not encoding differences -- the WORD is compared
 473:     separately and exactly.  Normalise both sides so the check keeps its teeth
 474:     (a wrong register or a wrong offset still fails) without red rows for
 475:     punctuation."""
 476:     def norm(t):
 477:         t = re.sub(r"\s+", "", t.lower())
 478:         t = re.sub(r",#0\]", "]", t)                      # [r4,#0]  -> [r4]
 479:         t = re.sub(r"#0x([0-9a-f]+)",
 480:                    lambda m: "#" + str(int(m.group(1), 16)), t)   # #0x100 -> #256
 481:         return t
 482:     return norm(expected) == norm(got)
 483: 
 484: 
 485: def step_and_check(s, prog, n):
 486:     planted = {CODE + off: (w, t) for off, w, t, _ in prog}
 487:     bad, covered, ex = [], set(), []
 488:     for _ in range(n):
 489:         mark = len(s.buf)
 490:         if not s.send("step 1", timeout=30) or s.dead:
 491:             bad.append("host died / no prompt at step %d" % (len(ex) + 1))
 492:             break
 493:         m = re.search(r"([0-9a-f]{8}):\s+([0-9a-f]{8})\s+([^\r\n<]+)", s.buf[mark:])
 494:         if not m:
 495:             bad.append("no step line at step %d" % (len(ex) + 1))
 496:             break
 497:         addr, word = int(m.group(1), 16), int(m.group(2), 16)
 498:         got = re.sub(r"\s+", " ", m.group(3)).strip()
 499:         ex.append((addr, word, got))
 500:         if addr not in planted:
 501:             bad.append("stepped 0x%08x, never planted" % addr)
 502:             continue
 503:         pw, pt = planted[addr]
 504:         covered.add(addr)
 505:         if word != pw:
 506:             bad.append("0x%08x read back 0x%08x, planted 0x%08x" % (addr, word, pw))
 507:         if pt is not None and not spell_ok(pt, got):
 508:             bad.append("0x%08x %08x -> %r, expected %r" % (addr, word, got, pt))
 509:     return bad, covered, ex
 510: 
 511: 
 512: def run_arm(label, mmu_on=False, disable=False, accrue=None, max_drain_s=30.0):
 513:     accrue = ACCRUE_S if accrue is None else accrue
 514:     prog = build(mmu_on=mmu_on, disable_during_accrual=disable)
 515:     s = Session()
 516:     if not s.wait(timeout=120):
 517:         return dict(label=label, status="NO-PROMPT", **s.close())
 518:     plant(s, prog)
 519:     bad, cov, ex = step_and_check(s, prog, PROLOGUE_N)
 520:     #  ACCRUAL.  The SIGALRM timer is stopped at the debugger prompt
 521:     #  (debugger.c:800) and restarted on `continue` (:840), so only free-run
 522:     #  seconds accrue -- which is what makes rate*T predictable at all.
 523:     ok, dt = s.free_run(accrue)
 524:     accrued = dt
 525:     mid = s.read_words(DATA + O_DRAIN, 5) if ok and not s.dead else None
 526:     #  PHASE CHANGE: the harness, not a guest clock, decides when accrual ends.
 527:     if ok and not s.dead:
 528:         s.send("pc=0x%08x" % DRAIN_ENTRY)
 529:     #  DRAIN, in slices, until PHASE says done.
 530:     t0, phase, out = time.time(), None, None
 531:     while ok and not s.dead and time.time() - t0 < max_drain_s:
 532:         ok, _ = s.free_run(0.5)
 533:         if not ok or s.dead:
 534:             break
 535:         out = s.read_words(DATA + O_DRAIN, 5)
 536:         if out is None:
 537:             break
 538:         phase = out[4]
 539:         if phase in (3, 4):
 540:             break
 541:     r = s.regs()
 542:     status = "HOST-DIED" if s.dead else ("SURVIVED" if ok else "INTERRUPT-LOST")
 543:     end = s.close()
 544:     return dict(label=label, status=status, regs=r, badis=bad, executed=ex,
 545:                 covered=cov, want={CODE + o for o, *_ in prog},
 546:                 accrued=accrued, mid=mid, out=out, phase=phase,
 547:                 drain_s=time.time() - t0, **end)
 548: 
 549: 
 550: #  Arm E walks the drain body in SEGMENTS, each entered by setting pc directly.
 551: #
 552: #  WHY SEGMENTS AND NOT ONE WALK, stated because the first draft did the obvious
 553: #  thing and got 7 offsets of silent non-coverage: under `step 1` the emulated CPU
 554: #  advances ONE cycle per command, and DEVICE_TICK is driven by the dyntrans cycle
 555: #  counter at one call per 1 << DEV_FOOTBRIDGE_TICK_SHIFT == 16384 cycles.  So a
 556: #  single-stepped SPIN loop can never see a delivered tick inside a few dozen steps
 557: #  and the TICKSEEN arm is unreachable by stepping, however large the backlog is.
 558: #
 559: #  This check is about DECODE, not about control flow: it asks whether the emulator
 560: #  reads back each planted word as the instruction the assembler above meant.  That
 561: #  question is answered wherever the word executes, so entering a segment at its head
 562: #  is legitimate here -- and it is NOT a substitute for the behavioural evidence,
 563: #  which is separate: reaching phase 3 with a non-zero drained count is only possible
 564: #  if 0xac..0xc4 and 0xc8..0xd4 executed for real, in order, during arms D and X.
 565: E_SEGMENTS = ((0x70, 12),        # re-enable NOPs, freeze, PHASE=1, DLOOP, SPIN head
 566:               (0xa0, 2),         # subs fp / bne SPIN
 567:               (0xa8, 1),         # b DONE -- the budget-expiry arm
 568:               (0xac, 7),         # TICKSEEN .. b DLOOP
 569:               (0xc8, 5),         # DONE .. HALT
 570:               (0xdc, 2),         # OVER
 571:               (0xe4, 1))         # b HALT
 572: 
 573: 
 574: def run_drainenc():
 575:     """Arm E: every word of the drain body stepped as it EXECUTES."""
 576:     prog = build()
 577:     s = Session()
 578:     if not s.wait(timeout=120):
 579:         return dict(status="NO-PROMPT", badis=[], covered=set(), nsteps=0,
 580:                     executed=[], **s.close())
 581:     plant(s, prog)
 582:     bad, cov, ex = step_and_check(s, prog, PROLOGUE_N)
 583:     for head, n in E_SEGMENTS:
 584:         if s.dead:
 585:             break
 586:         s.send("pc=0x%08x" % (CODE + head))
 587:         b2, c2, e2 = step_and_check(s, prog, n)
 588:         bad += b2
 589:         cov |= c2
 590:         ex += e2
 591:     status = "HOST-DIED" if s.dead else "SURVIVED"
 592:     end = s.close()
 593:     return dict(status=status, badis=bad, covered=cov, nsteps=len(ex), executed=ex, **end)
 594: 
 595: 
 596: 
 597: 
 598: #  #545: THE HARNESS LEGS, replacing arm K.  Arm K read +0x18c, which the device used to answer with
 599: #  fatal()+exit(1); #545 declines that read, so the control that "this launcher notices a dead child"
 600: #  now comes from the harness itself:
 601: #    H1  an unknown -E name: machine.c prints `Sorry, emulation "<name>" is unknown.` and main.c
 602: #        exits 1 BEFORE any prompt.  Rowed on NO prompt AND the diagnostic naming THIS input AND
 603: #        WIFEXITED && == 1 -- five different startup refusals all exit 1 with no prompt (measured,
 604: #        pass 1), so only the text clause discriminates.
 605: #    H2  the prologue stepped to its end, a FRESH `reg` with r3 bit 0 clear, r5 = 0x11223344,
 606: #        r6 = VENDOR and r7 = LOADBACK (it really ran), `quit`, then ONE MORE ordinary `reg`: it
 607: #        must fail with `dead` set BEFORE close(), and close() must reap exit 0.  A child dead
 608: #        BEFORE the prologue finished shows `next send fails` + `dead` IDENTICALLY (measured), so
 609: #        the fresh-reg values and exit == 0 are both load-bearing.
 610: H1_NAME = "no-such-machine-fbd5"
 611: 
 612: 
 613: def run_legs():
 614:     #  H1
 615:     s = Session(emul=H1_NAME)
 616:     prompt = s.wait(timeout=120)
 617:     end = s.close()
 618:     h1 = dict(prompt=prompt, named=('Sorry, emulation "%s" is unknown' % H1_NAME) in s.buf, **end)
 619:     #  H2
 620:     prog = build()
 621:     s = Session()
 622:     if not s.wait(timeout=120):
 623:         return dict(h1=h1, h2=dict(status="NO-PROMPT", **s.close()))
 624:     plant(s, prog)
 625:     bad, cov, ex = step_and_check(s, prog, PROLOGUE_N)
 626:     r = s.regs((3, 5, 6, 7))
 627:     prologue_ok = (not bad and len(ex) == PROLOGUE_N and 3 in r and (r[3] & 1) == 0
 628:                    and r.get(5) == 0x11223344 and r.get(6) == VENDOR and r.get(7) == LOADBACK)
 629:     quit_rc = s.send("quit", timeout=10)
 630:     next_rc = s.send("reg", timeout=10)          # observed BEFORE close(); never short-circuited
 631:     dead_before_close = s.dead
 632:     end = s.close()
 633:     h2 = dict(status="SURVIVED" if prologue_ok else "PROLOGUE-FAILED", prologue_ok=prologue_ok,
 634:               quit_rc=quit_rc, next_rc=next_rc, dead_before_close=dead_before_close, **end)
 635:     return dict(h1=h1, h2=h2)
 636: 
 637: 
 638: def main():
 639:     t0 = time.time()
 640:     print("=" * 78)
 641:     print("fbpending DRAIN PROBE -- %s" % BIN)
 642:     print("  TIMER %d (index %d, base 0x%x): FCLK_256, load %d -> %.2f Hz.  accrual %.1f s"
 643:           % (TIMER_NR + 1, TIMER_NR, TBASE, LOAD_RUN, RATE, ACCRUE_S))
 644:     print("  UNCAPPED prediction: backlog = %.0f" % (RATE * ACCRUE_S))
 645:     print("=" * 78)
 646: 
 647:     skip = dict(label="(not run)", status="SKIPPED", regs={}, badis=[],
 648:                 covered=set(), executed=[], out=None, mid=None, phase=None)
 649:     LEGS = (run_legs() if not ONLY else
 650:             dict(h1=dict(prompt=None, named=False, exit=None, signal=None),
 651:                  h2=dict(status="SKIPPED", exit=None, signal=None)))
 652:     H1, H2 = LEGS["h1"], LEGS["h2"]
 653:     E = run_drainenc() if not ONLY else dict(status="SKIPPED", badis=[],
 654:                                              covered=set(), nsteps=0, executed=[])
 655:     T = (run_arm("T (MMU ON, negative control)", mmu_on=True, accrue=1.0,
 656:                  max_drain_s=4.0) if not ONLY else dict(skip, label="T"))
 657:     D = (run_arm("D (enabled throughout)") if ONLY != "X" else dict(skip, label="D"))
 658:     X = (run_arm("X (DISABLED during accrual)", disable=True)
 659:          if ONLY != "D" else dict(skip, label="X"))
 660: 
 661:     for A in (D, X, T):
 662:         print("\n--- arm %s ---" % A["label"])
 663:         print("    status %s  accrued %.2f s  drain wall %.1f s  phase %s"
 664:               % (A["status"], A.get("accrued", 0), A.get("drain_s", 0),
 665:                  A.get("phase")))
 666:         if A.get("badis"):
 667:             print("    *** ENCODING / READBACK MISMATCH ***")
 668:             for b in A["badis"]:
 669:                 print("        " + b)
 670:         if LEARN:
 671:             for a, w, t in A.get("executed", []):
 672:                 print("      0x%08x  %08x  %s" % (a, w, t))
 673:         rr = A.get("regs", {})
 674:         print("    regs " + ", ".join("r%d=0x%x" % (k, v) for k, v in sorted(rr.items())))
 675:         mid, out = A.get("mid"), A.get("out")
 676:         if mid:
 677:             print("    at end of accrual : drained=%-10s iters=%-12s lastv=0x%08x "
 678:                   "vendor=0x%08x phase=%s"
 679:                   % (mid[0], mid[1], mid[2], mid[3], mid[4]))
 680:         if out:
 681:             print("    after the drain   : drained=%-10s iters=%-12s lastv=0x%08x "
 682:                   "vendor=0x%08x phase=%s"
 683:                   % (out[0], out[1], out[2], out[3], out[4]))
 684: 
 685:     print("\n--- arm E (drain body, stepped as it EXECUTES) ---")
 686:     print("    status %s, %d steps, %d distinct offsets covered"
 687:           % (E["status"], E["nsteps"], len(E["covered"])))
 688:     for b in E["badis"]:
 689:         print("        " + b)
 690:     if LEARN:
 691:         for a, w, t in E["executed"]:
 692:             print("      0x%08x  %08x  %s" % (a, w, t))
 693: 
 694:     print("\n--- harness legs (#545): H1 startup rejection, H2 quit after a verified prologue ---")
 695:     print("    H1 prompt=%s named=%s exit=%s signal=%s" % (H1["prompt"], H1["named"], H1.get("exit"), H1.get("signal")))
 696:     print("    H2 %s prologue=%s quit_rc=%s next_rc=%s dead_before_close=%s exit=%s signal=%s"
 697:           % (H2["status"], H2.get("prologue_ok"), H2.get("quit_rc"), H2.get("next_rc"),
 698:              H2.get("dead_before_close"), H2.get("exit"), H2.get("signal")))
 699: 
 700:     print("\n" + "=" * 78)
 701:     print("CONTROLS")
 702:     print("=" * 78)
 703:     ok = True
 704: 
 705:     def row(tag, good, detail):
 706:         nonlocal ok
 707:         ok &= bool(good)
 708:         print("  %-4s %-46s %s" % ("ok" if good else "FAIL", tag, detail))
 709: 
 710:     def survived(a):
 711:         return a["status"] == "SURVIVED" and a.get("exit") == 0
 712: 
 713:     rD, rX, rT = D.get("regs", {}), X.get("regs", {}), T.get("regs", {})
 714:     ranD = survived(D) and D.get("out") is not None
 715:     ranX = survived(X) and X.get("out") is not None
 716:     row("R0 every arm produced data",
 717:         ranD and ranX and survived(T) and survived(E) and H2["status"] != "NO-PROMPT",
 718:         "; ".join("%s=%s exit=%s signal=%s" %
 719:                   (name, a["status"], a.get("exit"), a.get("signal"))
 720:                   for name, a in (("D", D), ("X", X), ("T", T), ("E", E), ("H2", H2))))
 721:     row("C1 liveness: RAM through the same decode",
 722:         rD.get(5) == 0x11223344 and rX.get(5) == 0x11223344,
 723:         "D r5=0x%x  X r5=0x%x" % (rD.get(5, -1), rX.get(5, -1)))
 724:     row("C2 the MMU is OFF in the device arms",
 725:         (rD.get(3, 1) & 1) == 0 and (rX.get(3, 1) & 1) == 0,
 726:         "CP15 c1: D=0x%x X=0x%x" % (rD.get(3, -1), rX.get(3, -1)))
 727:     row("A1 device signature VENDOR_ID",
 728:         rD.get(6) == VENDOR and rX.get(6) == VENDOR,
 729:         "D r6=0x%x X r6=0x%x (expect 0x%x)" % (rD.get(6, -1), rX.get(6, -1), VENDOR))
 730:     row("A2 device signature: the handler's own 24-bit mask",
 731:         rD.get(7) == LOADBACK and rX.get(7) == LOADBACK,
 732:         "wrote 0x12345678, read D=0x%08x X=0x%08x" % (rD.get(7, -1), rX.get(7, -1)))
 733:     drain_words = {CODE + o for o in range(0x70, 0xe8, 4)}
 734:     row("E  encodings: prologue AND drain body, as EXECUTED",
 735:         survived(E) and not D.get("badis") and not X.get("badis") and not E["badis"]
 736:         and not (drain_words - E["covered"]),
 737:         "%d mismatches; drain offsets not stepped: %s"
 738:         % (len(D.get("badis", [])) + len(X.get("badis", [])) + len(E["badis"]),
 739:            " ".join("0x%x" % a for a in sorted(drain_words - E["covered"])) or "none"))
 740:     row("H1 startup leg: unknown -E named, no prompt, exit 1",
 741:         H1["prompt"] is False and H1["named"] and H1.get("exit") == 1 and H1.get("signal") is None,
 742:         "prompt=%s named=%s exit=%s signal=%s" %
 743:         (H1["prompt"], H1["named"], H1.get("exit"), H1.get("signal")))
 744:     row("H2 quit leg: verified prologue, next send dead before close, exit 0",
 745:         H2.get("prologue_ok") is True and H2.get("next_rc") is False
 746:         and H2.get("dead_before_close") is True and H2.get("exit") == 0 and H2.get("signal") is None
 747:         and survived(D),
 748:         "prologue=%s next_rc=%s dead=%s exit=%s signal=%s" %
 749:         (H2.get("prologue_ok"), H2.get("next_rc"), H2.get("dead_before_close"),
 750:          H2.get("exit"), H2.get("signal")))
 751:     row("T  the MMU-ON control cannot see the device",
 752:         #  F2 (#539): the keys must be PRESENT -- None != VENDOR is True, so a register-parse miss
 753:         #  greened this row once survived() forbade the halt outcome.
 754:         survived(T) and 6 in rT and 7 in rT and rT[6] != VENDOR and rT[7] != LOADBACK,
 755:         "T r6=0x%x r7=0x%x" % (rT.get(6, -1), rT.get(7, -1)))
 756:     row("L1 the guest ran during the accrual",
 757:         ranD and D["out"][1] not in (None, POISON) and D["out"][1] > 1000,
 758:         "arm D accrual iterations = %s" % (D["out"][1] if ranD else "n/a"))
 759:     row("L2 the device answered a fresh read after the drain",
 760:         ranD and D["out"][3] == VENDOR,
 761:         "arm D final VENDOR_ID = 0x%08x" % (D["out"][3] if ranD else -1))
 762:     row("P  the drain terminated normally (phase 3, not the limit)",
 763:         ranD and D["phase"] == 3 and ranX and X["phase"] == 3,
 764:         "D phase=%s X phase=%s (4 == drain limit %d hit)"
 765:         % (D.get("phase"), X.get("phase"), LIMIT))
 766: 
 767:     print("\n" + "=" * 78)
 768:     print("MEASURED")
 769:     print("=" * 78)
 770:     predicted = RATE * D.get("accrued", 0)
 771: 
 772:     #  *** A POISONED DRAINED-COUNT IS NOT A HUGE BACKLOG, IT IS A DEAD CLOCK, and
 773:     #  the first draft of this file reported it as 3,735,928,559 pending interrupts.
 774:     #  0xDEADBEEF in that word means the guest never executed the publish store,
 775:     #  i.e. the very first poll found the sentinel intact: DEVICE_TICK delivered
 776:     #  NOTHING.  That is the OPPOSITE failure from an unbounded backlog and it is the
 777:     #  one this whole round is about, so conflating them would have shipped a wrong
 778:     #  record about the exact symptom under test.  Both still FAIL; they just have to
 779:     #  fail by their own names.  A live fix can never land here: the reset leaves the
 780:     #  counter at 1, so at least one tick is always owed.  ***
 781:     def backlog(A, ran):
 782:         if not ran:
 783:             return None, False
 784:         v = A["out"][0]
 785:         return (0, True) if v == POISON else (v, False)
 786: 
 787:     bD, deadD = backlog(D, ranD)
 788:     bX, deadX = backlog(X, ranX)
 789:     print("  arm D backlog after %.2f s enabled     %s%s   (uncapped prediction %.0f)"
 790:           % (D.get("accrued", 0), bD,
 791:              "  <-- CLOCK DEAD: zero ticks delivered" if deadD else "", predicted))
 792:     print("  arm X backlog after %.2f s DISABLED    %s%s   (uncapped prediction %.0f)"
 793:           % (X.get("accrued", 0), bX,
 794:              "  <-- CLOCK DEAD: zero ticks delivered" if deadX else "",
 795:              RATE * X.get("accrued", 0)))
 796:     if bD and not deadD:
 797:         print("  arm D measured accrual rate           %.1f Hz  (asked for %.2f Hz)"
 798:               % (bD / D["accrued"], RATE))
 799: 
 800:     print("\n" + "=" * 78)
 801:     print("VERDICT")
 802:     print("=" * 78)
 803:     print("FBDRAIN_CONTROL=%s" % ("OK" if ok else "FAILED"))
 804:     print("FBDRAIN_BACKLOG_D=%s" % bD)
 805:     print("FBDRAIN_BACKLOG_X=%s" % bX)
 806:     print("FBDRAIN_CLOCK_DEAD=%s" % ("D " if deadD else "") + ("X" if deadX else ""))
 807:     if EXPECT_CAP >= 0 and ok and bD is not None and bX is not None:
 808:         good = (bD <= EXPECT_CAP and bX <= EXPECT_CAP
 809:                 and not deadD and not deadX)
 810:         print("FBDRAIN_BOUNDED=%s  (cap asserted: %d)"
 811:               % ("YES" if good else "NO", EXPECT_CAP))
 812:         print("FBDRAIN_VERDICT=%s" % ("PASS" if good else "FAIL"))
 813:         sys.exit(0 if good else 1)
 814:     print("FBDRAIN_VERDICT=REPORT-ONLY")
 815:     print("PROBE_WALL=%.1fs" % (time.time() - t0))
 816:     sys.exit(0 if ok else 1)
 817: 
 818: 
 819: main()

