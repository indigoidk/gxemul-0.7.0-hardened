 415: 
 416: /*
 417:  *  Reading the byte at 0x79000000 is a quicker way to figure out which ISA
 418:  *  interrupt has occurred (and acknowledging it at the same time), than
 419:  *  dealing with the legacy 0x20/0xa0 ISA ports.
 420:  */
 421: DEVICE_ACCESS(footbridge_isa)
 422: {
 423: 	/*  struct footbridge_data *d = extra;  */
 424: 	uint64_t idata = 0, odata = 0;
 425: 	int x;
 426: 
 427: 	if (writeflag == MEM_WRITE) {
 428: 		idata = memory_readmax64(cpu, data, len);
 429: 		fatal("[ footbridge_isa: WARNING/TODO: write! idata = 0x%016" PRIx64" ]\n", idata);
 430: 	}
 431: 
 432: 	x = cpu->machine->isa_pic_data.last_int;
 433: 	if (x < 8)
 434: 		odata = cpu->machine->isa_pic_data.pic1->irq_base + x;
 435: 	else
 436: 		odata = cpu->machine->isa_pic_data.pic2->irq_base + x - 8;
 437: 
 438: 	if (writeflag == MEM_READ)
 439: 		memory_writemax64(cpu, data, len, odata);
 440: 
 441: 	return 1;
 442: }
 443: 
 444: 
 445: /*
 446:  *  Reset pin at ISA port 0x338, at least in the NetWinder:
 447:  *
 448:  *  TODO: NOT WORKING YET!
 449:  */
 450: DEVICE_ACCESS(footbridge_reset)
 451: {
 452: 	uint64_t idata = 0;
 453: 
 454: 	if (writeflag == MEM_WRITE) {
 455: 		idata = memory_readmax64(cpu, data, len);
 456: 		if (idata & 0x40) {
 457: 			debug("[ footbridge_reset: GP16: Halting. ]\n");
 458: 			/*  #220: (Codex/Fable) cpu->running=0 already halts cleanly;
 459: 			    the col-0 exit(1) was a debug hack that kills the host.  */
 460: 			cpu->running = 0;
 461: 		}
 462: 	}
 463: 
 464: 	return 1;
 465: }
 466: 
 467: 
 468: /*
 469:  *  The Footbridge PCI configuration space is implemented as a direct memory
 470:  *  space (i.e. not one port for addr and one port for data). This function
 471:  *  translates that into bus_pci calls.
 472:  */
 473: DEVICE_ACCESS(footbridge_pci)
 474: {
 475: 	struct footbridge_data *d = (struct footbridge_data *) extra;
 476: 	uint64_t idata = 0, odata = 0;
 477: 	int bus, dev, func, reg;
 478: 
 479: 	if (writeflag == MEM_WRITE)
 480: 		idata = memory_readmax64(cpu, data, len|MEM_PCI_LITTLE_ENDIAN);
 481: 
 482: 	/*  Decompose the (direct) address into its components:  */
 483: 	bus_pci_decompose_1(relative_addr, &bus, &dev, &func, &reg);
 484: 	bus_pci_setaddr(cpu, d->pcibus, bus, dev, func, reg);
 485: 
 486: 	if (bus == 255) {
 487: 		fatal("[ footbridge DEBUG ERROR: bus 255 unlikely,"
 488: 		    " pc (might not be updated) = 0x%08x ]\n", (int)cpu->pc);
 489: 		/*  #220: (Codex/Fable) don't exit() the host on a guest PCI
 490: 		    access to the (unlikely) bus 255; treat it as handled.  */
 491: 		return 1;
 492: 	}
 493: 
 494: 	debug("[ footbridge pci: %s bus %i, device %i, function %i, register "
 495: 	    "%i ]\n", writeflag == MEM_READ? "read from" : "write to", bus,
 496: 	    dev, func, reg);
 497: 
 498: 	bus_pci_data_access(cpu, d->pcibus, writeflag == MEM_READ?
 499: 	    &odata : &idata, len, writeflag);
 500: 
 501: 	if (writeflag == MEM_READ)
 502: 		memory_writemax64(cpu, data, len|MEM_PCI_LITTLE_ENDIAN, odata);
 503: 
 504: 	return 1;
 505: }
 506: 
 507: 
 508: DEVICE_ACCESS(footbridge)
 509: {
 510: 	struct footbridge_data *d = (struct footbridge_data *) extra;
 511: 	uint64_t idata = 0, odata = 0;
 512: 	int timer_nr = 0;
 513: 
 514: 	if (writeflag == MEM_WRITE)
 515: 		idata = memory_readmax64(cpu, data, len);
 516: 
 517: 	if (relative_addr >= TIMER_1_LOAD && relative_addr <= TIMER_4_CLEAR) {
 518: 		timer_nr = (relative_addr >> 5) & (N_FOOTBRIDGE_TIMERS - 1);
 519: 		relative_addr &= ~0x060;
 520: 	}
 521: 
 522: 	switch (relative_addr) {
 523: 
 524: 	case VENDOR_ID:
 525: 		odata = 0x1011;  /*  DC21285_VENDOR_ID  */
 526: 		break;
 527: 
 528: 	case DEVICE_ID:
 529: 		odata = 0x1065;  /*  DC21285_DEVICE_ID  */
 530: 		break;
 531: 
 532: 	case 0x04:
 533: 	case 0x0c:
 534: 	case 0x10:
 535: 	case 0x14:
 536: 	case 0x18:
 537: 		/*  TODO. Written to by Linux.  */
 538: 		break;
 539: 
 540: 	case REVISION:
 541: 		odata = 3;  /*  footbridge revision number  */
 542: 		break;
 543: 
 544: 	case PCI_ADDRESS_EXTENSION:
 545: 		/*  TODO: Written to by Linux.  */
 546: 		if (writeflag == MEM_WRITE && idata != 0)
 547: 			fatal("[ footbridge: TODO: write to PCI_ADDRESS_"
 548: 			    "EXTENSION: 0x%llx ]\n", (long long)idata);
 549: 		break;
 550: 
 551: 	case SA_CONTROL:
 552: 		/*  Read by Linux:  */
 553: 		odata = PCI_CENTRAL_FUNCTION;
 554: 		break;
 555: 
 556: 	case UART_DATA:
 557: 		if (writeflag == MEM_WRITE)
 558: 			console_putchar(d->console_handle, idata);
 559: 		break;
 560: 
 561: 	case UART_RX_STAT:
 562: 		/*  TODO  */
 563: 		odata = 0;
 564: 		break;
 565: 
 566: 	case UART_FLAGS:
 567: 		odata = UART_TX_EMPTY;
 568: 		break;
 569: 
 570: 	case IRQ_STATUS:
 571: 		if (writeflag == MEM_READ)
 572: 			odata = d->irq_status & d->irq_enable;
 573: 		else if (!d->warned_irq_status_w) {
 574: 			/*  #545: read-only register (7.3.29); the write is
 575: 			    declined -- no state changes -- and announced once.  */
 576: 			d->warned_irq_status_w = 1;
 577: 			fatal("[ WARNING: footbridge write to irq status? "
 578: 			    "(once) ]\n");
 579: 		}
 580: 		break;
 581: 
 582: 	case IRQ_RAW_STATUS:
 583: 		if (writeflag == MEM_READ)
 584: 			odata = d->irq_status;
 585: 		else if (!d->warned_irq_raw_w) {
 586: 			/*  #545: read-only (7.3.30); declined, announced once.  */
 587: 			d->warned_irq_raw_w = 1;
 588: 			fatal("[ footbridge write to irq_raw_status (once) ]\n");
 589: 		}
 590: 		break;
 591: 
 592: 	case IRQ_ENABLE_SET:
 593: 		if (writeflag == MEM_WRITE) {
 594: 			d->irq_enable |= idata;
 595: 			if (d->irq_status & d->irq_enable)
 596: 				INTERRUPT_ASSERT(d->irq);
 597: 			else
 598: 				INTERRUPT_DEASSERT(d->irq);
 599: 		} else {
 600: 			/*  #539: a read of 188h is documented -- IRQEnable is
 601: 			    "read-only ... can only be changed by writing to
 602: 			    the EnableSet and EnableClear registers", reset 0
 603: 			    (DC21285 Table 7-10, 7.3.31).  The value below was
 604: 			    always right; the exit(1) that followed it is gone.  */
 605: 			odata = d->irq_enable;
 606: 		}
 607: 		break;
 608: 
 609: 	case IRQ_ENABLE_CLEAR:
 610: 		if (writeflag == MEM_WRITE) {
 611: 			d->irq_enable &= ~idata;
 612: 			if (d->irq_status & d->irq_enable)
 613: 				INTERRUPT_ASSERT(d->irq);
 614: 			else
 615: 				INTERRUPT_DEASSERT(d->irq);
 616: 		} else if (!d->warned_irq_clear_r) {
 617: 			/*  #545: IRQEnableClear is write-only (7.3.33) and Table
 618: 			    7-10 names no register at 18Ch for reads, so the read
 619: 			    is declined with 0 -- the IRQEnable value that used to
 620: 			    be computed here is 188h's answer, not 18Ch's.  */
 621: 			d->warned_irq_clear_r = 1;
 622: 			fatal("[ WARNING: footbridge read from "
 623: 			    "ENABLE CLEAR? (once) ]\n");
 624: 		}
 625: 		break;
 626: 
 627: 	case FIQ_STATUS:
 628: 		if (writeflag == MEM_READ)
 629: 			odata = d->fiq_status & d->fiq_enable;
 630: 		else if (!d->warned_fiq_status_w) {
 631: 			/*  #545: read-only (7.3.29); declined, announced once.  */
 632: 			d->warned_fiq_status_w = 1;
 633: 			fatal("[ WARNING: footbridge write to fiq status? "
 634: 			    "(once) ]\n");
 635: 		}
 636: 		break;
 637: 
 638: 	case FIQ_RAW_STATUS:
 639: 		if (writeflag == MEM_READ)
 640: 			odata = d->fiq_status;
 641: 		else if (!d->warned_fiq_raw_w) {
 642: 			/*  #545: read-only (7.3.30); declined, announced once.  */
 643: 			d->warned_fiq_raw_w = 1;
 644: 			fatal("[ footbridge write to fiq_raw_status (once) ]\n");
 645: 		}
 646: 		break;
 647: 
 648: 	case FIQ_ENABLE_SET:
 649: 		if (writeflag == MEM_WRITE)
 650: 			d->fiq_enable |= idata;
 651: 		break;
 652: 
 653: 	case FIQ_ENABLE_CLEAR:
 654: 		if (writeflag == MEM_WRITE)
 655: 			d->fiq_enable &= ~idata;
 656: 		break;
 657: 
 658: 	case TIMER_1_LOAD:
 659: 		if (writeflag == MEM_READ)
 660: 			odata = d->timer_load[timer_nr];
 661: 		else {
 662: 			d->timer_load[timer_nr] = idata & TIMER_MAX_VAL;
 663: 			reload_timer_value(cpu, d, timer_nr);
 664: 			/*  debug("[ footbridge: timer %i (1-based), "
 665: 			    "value %i ]\n", timer_nr + 1,
 666: 			    (int)d->timer_value[timer_nr]);  */
 667: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
 668: 		}
 669: 		break;
 670: 
 671: 	case TIMER_1_VALUE:
 672: 		if (writeflag == MEM_READ)
 673: 			odata = d->timer_value[timer_nr];
 674: 		else
 675: 			d->timer_value[timer_nr] = idata & TIMER_MAX_VAL;
 676: 		break;
 677: 
 678: 	case TIMER_1_CONTROL:
 679: 		if (writeflag == MEM_READ)
 680: 			odata = d->timer_control[timer_nr];
 681: 		else {
 682: 			d->timer_control[timer_nr] = idata;
 683: 			/*  #432: both prescaler bits set is TIMER_EXTERNAL
 684: 			    (0x0C, dc21285reg.h:364) -- a LEGAL named encoding,
 685: 			    and it used to reach fatal()+exit(1) right here, so a
 686: 			    guest selecting the external clock source KILLED THE
 687: 			    HOST.  Arguably likelier than the zero load, since it
 688: 			    is a documented mode rather than a malformed value.
 689: 			    The rate an external clock would actually give is
 690: 			    UNKNOWN and is NOT invented: footbridge_effective_cycles()
 691: 			    now gives the encoding a defined, survivable meaning
 692: 			    (the unprescaled period), and the real semantics are
 693: 			    filed for a round that has a datasheet.  */
 694: 			if (idata & TIMER_ENABLE) {
 695: 				reload_timer_value(cpu, d, timer_nr);
 696: 			} else {
 697: 				d->pending_timer_interrupts[timer_nr] = 0;
 698: 			}
 699: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
 700: 		}
 701: 		break;
 702: 
 703: 	case TIMER_1_CLEAR:
 704: 		/*  #474: a READ must not perform the clear.  This case carried no
 705: 		    writeflag test at all, while TIMER_1_CONTROL immediately above it
 706: 		    does -- so a guest READ reloaded the counter, decremented the
 707: 		    pending count and DEASSERTED the interrupt.  A guest that merely
 708: 		    read the register silently acknowledged a pending timer interrupt;
 709: 		    the guest-visible consequence is a LOST interrupt, not a bad value.
 710: 
 711: 		    FOUR addresses, not one: the fold above normalises 0x30C/0x32C/
 712: 		    0x34C/0x36C onto this single case.
 713: 
 714: 		    GUARD THE BODY, KEEP THE break.  An early return here would skip
 715: 		    the function's common tail, which writes odata back on a read, and
 716: 		    would hand a guest an untouched buffer -- a defect this code does
 717: 		    not currently have.  */
 718: 		if (writeflag == MEM_WRITE) {
 719: 			if (d->timer_control[timer_nr] & TIMER_MODE_PERIODIC) {
 720: 				reload_timer_value(cpu, d, timer_nr);
 721: 			}
 722: 
 723: 			if (d->pending_timer_interrupts[timer_nr] > 0) {
 724: 				d->pending_timer_interrupts[timer_nr] --;
 725: 			}
 726: 
 727: 			INTERRUPT_DEASSERT(d->timer_irq[timer_nr]);
 728: 		}
 729: 		break;
 730: 
 731: 	case SDRAM_BA_MASK:
 732: 		if (writeflag == MEM_READ) {
 733: 			fatal("[ footbridge read from sdram_ba_mask ]\n");
 734: 			exit(1);
 735: 		} else {
 736: 			switch (idata) {
 737: 			case SDRAM_MASK_256KB:
 738: 			case SDRAM_MASK_512KB:
 739: 			case SDRAM_MASK_1MB:
 740: 			case SDRAM_MASK_2MB:
 741: 			case SDRAM_MASK_4MB:
 742: 			case SDRAM_MASK_8MB:
 743: 			case SDRAM_MASK_16MB:
 744: 			case SDRAM_MASK_32MB:
 745: 			case SDRAM_MASK_64MB:
 746: 			case SDRAM_MASK_128MB:
 747: 			case SDRAM_MASK_256MB:
 748: 				break;
 749: 			default:
 750: 				fatal("[ footbridge write to sdram_ba_mask "
 751: 				    "%#llx ]\n", (long long)idata);
 752: 				break;
 753: 			}
 754: 		}
 755: 		break;
 756: 	case SDRAM_BA_OFFSET:
 757: 		if (writeflag == MEM_READ) {
 758: 			fatal("[ footbridge read from sdram_ba_offset ]\n");
 759: 			exit(1);
 760: 		} else {
 761: 			if (idata != 0)
 762: 				fatal("[ footbridge write to sdram_ba_offset "
 763: 				    "%#llx ]\n", (long long)idata);
 764: 		}
 765: 		break;
 766: 
 767: 	default:if (writeflag == MEM_READ) {
 768: 			fatal("[ footbridge: read from 0x%x ]\n",
 769: 			    (int)relative_addr);
 770: 		} else {
 771: 			fatal("[ footbridge: write to 0x%x: 0x%llx ]\n",
 772: 			    (int)relative_addr, (long long)idata);
 773: 		}
 774: 	}
 775: 
 776: 	if (writeflag == MEM_READ)
 777: 		memory_writemax64(cpu, data, len, odata);
 778: 
 779: 	return 1;
 780: }
