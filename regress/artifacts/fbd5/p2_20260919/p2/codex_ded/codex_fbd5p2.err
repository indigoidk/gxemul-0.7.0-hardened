 200:     (0x10, 0xE3A00442, "mov r0,#0x42000000",    "footbridge base (machine_cats.c:64)"),
 201:     (0x14, 0xE3A04A09, "mov r4,#0x9000",        "scratch RAM"),
 202:     (0x18, 0xE5945000, "ldr r5,[r4]",           "C1 liveness: plain RAM, 0x11223344"),
 203:     (0x1c, 0xE5906000, "ldr r6,[r0]",           "A1: VENDOR_ID"),
 204:     (0x20, 0xE5942004, "ldr r2,[r4,#4]",        "load 0x12345678 from RAM"),
 205:     (0x24, 0xE5802300, "str r2,[r0,#768]",      "A2: TIMER_1_LOAD <- 0x12345678"),
 206:     (0x28, 0xE5901300, "ldr r1,[r0,#768]",      "A2: read it back"),
 207: ]
 208: KILL_NOP  = (0x2c, NOP,        NOPTXT,             "arm L: no kill site (the +0x18c kill retired by #545)")
 209: TAIL = [(0x30, NOP, NOPTXT, "landing pad -- planted, never stepped")]
 210: REG = dict(r0=0, r1=1, r2=2, r3=3, r4=4, r5=5, r6=6, r7=7, r8=8, r9=9, sl=10, fp=11, ip=12, sp=13, lr=14)
 211: def _mov(rd, imm):                          # imm < 256, rotate 0
 212:     return 0xE3A00000 | (REG[rd] << 12) | imm, "mov %s,#0x%x" % (rd, imm)
 213: def _ldr(rd, off):
 214:     return 0xE5900000 | (REG[rd] << 12) | off, "ldr %s,[r0,#%d]" % (rd, off)
 215: def _str(rd, off):
 216:     return 0xE5800000 | (REG[rd] << 12) | off, "str %s,[r0,#%d]" % (rd, off)
 217: def _w(off, wt, comment):
 218:     return (off, wt[0], wt[1], comment)
 219: #  #545: arm S -- the five declined sites, twice each, one legal sibling read between, one process.
 220: SITES = [
 221:     _w(0x2c, _mov("r8", 0x30),  "IRQ enable <- 0x30 (bits 4,5)"),
 222:     _w(0x30, _str("r8", 0x188), ""),
 223:     _w(0x34, _mov("r9", 0xc0),  "FIQ enable <- 0xc0 (bits 6,7)"),
 224:     _w(0x38, _str("r9", 0x288), ""),
 225:     _w(0x3c, _mov("r2", 0x10),  "the IRQ decline value, inside 0x30"),
 226:     _w(0x40, _str("r2", 0x180), "N1: write IRQ_STATUS (read-only) #1"),
 227:     _w(0x44, _ldr("r7", 0x184), "S2: legal IRQ_RAW_STATUS read between -> 0"),
 228:     _w(0x48, _str("r2", 0x180), "N1: write IRQ_STATUS #2 -- must NOT announce again"),
 229:     _w(0x4c, _str("r2", 0x184), "N2: write IRQ_RAW_STATUS (read-only) #1"),
 230:     _w(0x50, _ldr("sl", 0x180), "S1: legal IRQ_STATUS read between -> 0 (0 & 0x30)"),
 231:     _w(0x54, _str("r2", 0x184), "N2: write IRQ_RAW_STATUS #2"),
 232:     _w(0x58, _ldr("r9", 0x18c), "N3: read IRQ_ENABLE_CLEAR (write-only) #1 -> 0"),
 233:     _w(0x5c, _ldr("fp", 0x188), "S3: legal IRQEnable read between -> 0x30 (intact)"),
 234:     _w(0x60, _ldr("r8", 0x18c), "N3: read IRQ_ENABLE_CLEAR #2 -> 0"),
 235:     _w(0x64, _mov("ip", 0x40),  "the FIQ decline value, inside 0xc0"),
 236:     _w(0x68, _str("ip", 0x280), "N4: write FIQ_STATUS (read-only) #1"),
 237:     _w(0x6c, _ldr("r2", 0x280), "S4: legal FIQ_STATUS read between -> 0 (0 & 0xc0)"),
 238:     _w(0x70, _str("ip", 0x280), "N4: write FIQ_STATUS #2"),
 239:     _w(0x74, _str("ip", 0x284), "N5: write FIQ_RAW_STATUS (read-only) #1"),
 240:     _w(0x78, _ldr("lr", 0x284), "S5: legal FIQ_RAW_STATUS read between -> 0"),
 241:     _w(0x7c, _str("ip", 0x284), "N5: write FIQ_RAW_STATUS #2"),
 242:     _w(0x80, _ldr("r1", 0x184), "SF1: FINAL raw IRQ status after every decline -> 0"),
 243:     _w(0x84, _ldr("sp", 0x284), "SF2: FINAL raw FIQ status after every decline -> 0"),
 244:     (0x88, NOP, NOPTXT, "landing pad -- planted, never stepped"),
 245: ]
 246: #  #545: the five announce texts, one per site, in the device's own spelling.  ACCESS-LOCAL: each N row
 247: #  counts ITS text, so a misnamed register reds the row for the site that misnamed it.
 248: TEXTS = {
 249:     "N1": "footbridge write to irq status? (once)",
 250:     "N2": "footbridge write to irq_raw_status (once)",
 251:     "N3": "footbridge read from ENABLE CLEAR? (once)",
 252:     "N4": "footbridge write to fiq status? (once)",
 253:     "N5": "footbridge write to fiq_raw_status (once)",
 254: }
 255: H1_NAME = "no-such-machine-fbd5"      # the unknown -E name for leg H1; the diagnostic must name it
 256: P, Q = 0x00002002, 0x60000000           # #539 arm E values; loaded from DATA+8 / DATA+12
 257: ENABLE = [                              # #539: the ACCEPT rows, order E0,E1,E2,E3,E6,E5
 258:     (0x2c, 0xE5907188, "ldr r7,[r0,#392]",   "E0: read IRQ_ENABLE_SET before any write"),
 259:     (0x30, 0xE5948008, "ldr r8,[r4,#8]",     "r8 = P"),
 260:     (0x34, 0xE5808188, "str r8,[r0,#392]",   "IRQEnableSet <- P"),
 261:     (0x38, 0xE5901188, "ldr r1,[r0,#392]",   "E1: read back -> P"),
 262:     (0x3c, 0xE594900C, "ldr r9,[r4,#12]",    "r9 = Q"),
 263:     (0x40, 0xE5809188, "str r9,[r0,#392]",   "IRQEnableSet <- Q"),
 264:     (0x44, 0xE5902188, "ldr r2,[r0,#392]",   "E2: read back -> P|Q (pins |=)"),
 265:     (0x48, 0xE5D09188, "ldrb r9,[r0,#392]",  "E3: BYTE read -> 0x02"),
 266:     (0x4c, 0xE280AD06, "add sl,r0,#0x180",   "sl = base+0x180 (ldrh offsets cap at 255)"),
 267:     (0x50, 0xE1DAB0B8, "ldrh fp,[sl,#8]",    "E6: HALFWORD read -> 0x2002"),
 268:     (0x54, 0xE580818C, "str r8,[r0,#396]",   "IRQEnableClear <- P"),
 269:     (0x58, 0xE590C188, "ldr ip,[r0,#392]",   "E5: read back -> Q"),
 270:     (0x5c, NOP, NOPTXT, "landing pad -- planted, never stepped"),
 271: ]
 272: REGNAME = {10: "sl", 11: "fp", 12: "ip", 13: "sp", 14: "lr"}   # the emulator's spellings (cpu_arm.h ARM_REG_NAMES)
 273: 
 274: 
 275: def run_arm(label, prog, emul="cats", quit_leg=False):
 276:     """Plant `prog`, step it one instruction at a time, report registers and liveness.
 277:     #545: `emul` is the -E name (leg H1 passes an unknown one and expects NO prompt); `quit_leg`
 278:     runs leg H2 after the register read -- quit, then one more ordinary interaction, observed
 279:     BEFORE teardown."""
 280:     pid, fd = pty.fork()
 281:     if pid == 0:
 282:         os.execvp(BIN, [BIN, "-V", "-T", "-E", emul, "-M", "32",
 283:                         "0x%x:%s" % (CODE, STUB)])
 284:         os._exit(127)
 285:     buf = ""
 286:     dead = [False]
 287: 
 288:     def rd(t=0.4):
 289:         nonlocal buf
 290:         r, _, _ = select.select([fd], [], [], t)
 291:         if fd not in r:
 292:             return True
 293:         try:
 294:             d = os.read(fd, 65536)
 295:         except OSError:
 296:             dead[0] = True
 297:             return False
 298:         if not d:
 299:             dead[0] = True
 300:             return False
 301:         buf += d.decode("latin1", "replace")
 302:         return True
 303: 
 304:     #  Signature order is not free choice: gate_hygiene.sh pins the CANONICAL #392 call form
 305:     #  as a literal `return wait(mark=_mark, echo=<x> if <x> else None)`, tightened three
 306:     #  times because every looser prefix was a substring of the broken form too.  Written any
 307:     #  other way, a probe is simply not covered by that ratchet -- which is worse than failing
 308:     #  it.  So timeout goes last, and send() ends on the pinned form.
 309:     def wait(mark=0, echo=None, timeout=60):
 310:         t = time.time()
 311:         while time.time() - t < timeout:
 312:             if not rd():
 313:                 return False
 314:             resp = buf[mark:]
 315:             if echo is not None and echo not in resp:
 316:                 continue
 317:             if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
 318:                 return True
 319:         return False
 320: 
 321:     def send(x, timeout=60):
 322:         b = (x + "\n").encode("latin1")
 323:         _mark = len(buf)
 324:         n = 0
 325:         try:
 326:             while n < len(b):
 327:                 n += os.write(fd, b[n:])
 328:         except OSError:
 329:             dead[0] = True
 330:             return False
 331:         return wait(mark=_mark, echo=x if x else None, timeout=timeout)
 332: 
 333:     status, regs, badis = "?", {}, []
 334:     h2 = {}                        # #545 leg H2 observations, all taken BEFORE teardown
 335:     #  KEYWORD, and this is not style.  A positional wait(120) silently becomes mark=120 under
 336:     #  the pinned parameter order -- a real behaviour change, and the exact mistake the
 337:     #  m8820x probe's conversion had to fix in the same commit.
 338:     if not wait(timeout=120):
 339:         status = "NO-PROMPT"
 340:     else:

