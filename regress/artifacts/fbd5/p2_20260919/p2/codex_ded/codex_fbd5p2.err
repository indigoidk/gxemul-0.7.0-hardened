 442: 
 443: def run_witness(head, sentinel, slices, slice_s, label):
 444:     prog = head + prologue(sentinel[0], sentinel[1]) + LOOP + [LANDING]
 445:     s = Session()
 446:     if not s.wait(timeout=120):
 447:         return dict(status="NO-PROMPT", label=label, samples=[], regs={}, badis=[],
 448:                     catchup=0, **s.close())
 449:     plant(s, prog)
 450:     bad, _, _ = step_and_check(s, prog, PROLOGUE_N)
 451:     r = s.regs()
 452:     samples, t_cum, lost = [], 0.0, False
 453:     for _ in range(slices):
 454:         ok, dt = s.free_run(slice_s)
 455:         t_cum += dt
 456:         if not ok or s.dead:
 457:             lost = True
 458:             break
 459:         w = s.read_words(CLOB, 4)
 460:         if w is None:
 461:             lost = True
 462:             break
 463:         samples.append(dict(t=t_cum, clob=w[0], iters=w[1], lastv=w[2], lastid=w[3]))
 464:     if s.dead:
 465:         status = "HOST-DIED"
 466:     elif lost:
 467:         status = "INTERRUPT-LOST"
 468:     else:
 469:         status = "SURVIVED"
 470:     catchup = s.buf.count(TIMERMSG)
 471:     end = s.close()
 472:     return dict(status=status, label=label, regs=r, badis=bad,
 473:                 samples=samples, catchup=catchup, **end)
 474: 
 475: 
 476: 
 477: 
 478: #  #545: THE HARNESS LEGS, replacing arm K.  Arm K read +0x18c, which the device used to answer with
 479: #  fatal()+exit(1); #545 declines that read, so the control that "this launcher notices a dead child"
 480: #  now comes from the harness itself:
 481: #    H1  an unknown -E name: machine.c prints `Sorry, emulation "<name>" is unknown.` and main.c
 482: #        exits 1 BEFORE any prompt.  Rowed on NO prompt AND the diagnostic naming THIS input AND
 483: #        WIFEXITED && == 1 -- five different startup refusals all exit 1 with no prompt (measured,
 484: #        pass 1), so only the text clause discriminates.
 485: #    H2  the prologue stepped to its end, a FRESH `reg` with r3 bit 0 clear, r5 = 0x11223344,
 486: #        r6 = VENDOR and r7 = LOADBACK (it really ran), `quit`, then ONE MORE ordinary `reg`: it
 487: #        must fail with `dead` set BEFORE close(), and close() must reap exit 0.  A child dead
 488: #        BEFORE the prologue finished shows `next send fails` + `dead` IDENTICALLY (measured), so
 489: #        the fresh-reg values and exit == 0 are both load-bearing.
 490: H1_NAME = "no-such-machine-fbd5"
 491: 
 492: 
 493: def run_legs():
 494:     #  H1
 495:     s = Session(emul=H1_NAME)
 496:     prompt = s.wait(timeout=120)
 497:     end = s.close()
 498:     h1 = dict(prompt=prompt, named=('Sorry, emulation "%s" is unknown' % H1_NAME) in s.buf, **end)
 499:     #  H2
 500:     prog = MMU_OFF + prologue(*SENT_A) + [(0x48, NOP, NOPTXT, "landing pad")]
 501:     s = Session()
 502:     if not s.wait(timeout=120):
 503:         return dict(h1=h1, h2=dict(status="NO-PROMPT", **s.close()))
 504:     plant(s, prog)
 505:     bad, _, ex = step_and_check(s, prog, PROLOGUE_N)
 506:     r = s.regs((3, 5, 6, 7))
 507:     prologue_ok = (not bad and len(ex) == PROLOGUE_N and 3 in r and (r[3] & 1) == 0
 508:                    and r.get(5) == 0x11223344 and r.get(6) == VENDOR and r.get(7) == LOADBACK)
 509:     quit_rc = s.send("quit", timeout=10)
 510:     next_rc = s.send("reg", timeout=10)          # observed BEFORE close(); never short-circuited
 511:     dead_before_close = s.dead
 512:     end = s.close()
 513:     h2 = dict(status="SURVIVED" if prologue_ok else "PROLOGUE-FAILED", prologue_ok=prologue_ok,
 514:               quit_rc=quit_rc, next_rc=next_rc, dead_before_close=dead_before_close, **end)
 515:     return dict(h1=h1, h2=h2)
 516: 
 517: 
 518: def run_encodings():
 519:     """Arm E: sentinel 0 makes the poll compare EQUAL, so `step 1` walks BOTH loop
 520:     bodies and every planted word is checked as it EXECUTES."""
 521:     prog = MMU_OFF + prologue(*SENT_E) + LOOP + [LANDING]
 522:     s = Session()
 523:     if not s.wait(timeout=120):
 524:         return dict(status="NO-PROMPT", regs={}, badis=[], covered=set(), want=set(),
 525:                     nsteps=0, executed=[], **s.close())
 526:     plant(s, prog)
 527:     bad, covered, ex = step_and_check(s, prog, PROLOGUE_N + 2 * len(LOOP))
 528:     r = s.regs()
 529:     want = {CODE + off for off, *_ in prog if off != LANDING[0]}
 530:     status = "HOST-DIED" if s.dead else "SURVIVED"
 531:     end = s.close()
 532:     return dict(status=status, regs=r, badis=bad, covered=covered, want=want,
 533:                 nsteps=len(ex), executed=ex, **end)
 534: 
