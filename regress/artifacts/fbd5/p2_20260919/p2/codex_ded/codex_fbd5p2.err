 402: def plant(s, prog):
 403:     s.send("put w 0x%08x, 0x%08x" % (LIVE, 0x11223344))
 404:     s.send("put w 0x%08x, 0x%08x" % (SRC, 0x12345678))
 405:     for a in (CLOB, ITER, LASTV, LASTID):
 406:         s.send("put w 0x%08x, 0x%08x" % (a, POISON))
 407:     for off, word, _t, _c in prog:
 408:         s.send("put w 0x%08x, 0x%08x" % (CODE + off, word))
 409:     s.send("pc=0x%08x" % CODE)
