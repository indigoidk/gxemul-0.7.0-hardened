    1: #!/bin/bash
    2: # GATE 2 -- offline differential of the REAL ieee_store_float_value().
    3: #
    4: # The strongest gate here, and the cheapest, but only because it links the shipped
    5: # src/core/float_emul.c. The first version of this gate transcribed BOTH sides of the
    6: # differential and compared the copy against itself -- it never compiled or executed
    7: # float_emul.c at all, so deleting #287 from the shipped source left it green. Review
    8: # caught that, not the gate. Two things now prevent a repeat:
    9: #
   10: #   * the real file is compiled and linked into the driver, and
   11: #   * the file compiled is asserted byte-identical to the committed one, so "the test
   12: #     passed" and "the repository is correct" are the same statement.
   13: #
   14: # misc.h includes ../../config.h, which configure generates, so the compile has to happen
   15: # against a CONFIGURED tree. That tree is a copy of the committed source (no VPATH in this
   16: # project), which is exactly why the identity check above is required rather than assumed.
   17: set -u
   18: HERE=$(cd "$(dirname "$0")" && pwd)
   19: . "$HERE/lib.sh"
   20: 
   21: SEC=$ROOT/GXEMUL-SEC
   22: SRC=core/float_emul.c
   23: 
   24: gate_begin "offline-differential"
   25: 
   26: # #375: the mips*_loadstore[32] dispatch-table index is a SILENT CROSS-FILE
   27: # COUPLING. generate_mips_loadstore.c emits the table in the loop order
   28: # `endianness -> store -> size -> signedness`, so an entry's index is
   29: # endianness*16 + store*8 + size*2 + signedness. That arithmetic is then
   30: # hard-coded BY HAND, with no comment and no check, at a dozen sites: the
   31: # multi-transfer fold's bail (`mips32_loadstore[5]` = plain lw), the coproc
   32: # handlers (lwc1->5, swc1->12, ldc1->7, sdc1->14), the canonical decoder, and
   33: # the COMBINE(nop)/strlen/#169 matcher slots. Reorder that one generator loop
   34: # and every hand-coded index silently mis-resolves -- the fold bail dispatches
   35: # the wrong access SIZE, ldc1 becomes lw -- and NOTHING fails to compile. These
   36: # rows turn the coupling into a checked invariant, offline, needing no compiler
   37: # and no rig (only the committed generated table). Found by the #46 MIPS-combiner
   38: # audit; both boot rigs are LE, so the _be entries are dead code on the harness
   39: # but the coupling is real for any future BE MIPS work.
   40: #
   41: # The byte rows are load-bearing in the opposite direction: size==0 has no
   42: # endianness, so the generator makes the byte LE and BE entries the SAME symbol
   43: # ([1]==[17], [8]==[24]). #169's byte-store check and the strlen byte-load check
   44: # rely on that share; the word rows ([5]!=[21]) prove the discrimination the byte
   45: # rows deliberately lack. If a generator change ever split the byte entries, the
   46: # `|| [x+16]` matcher tautologies become live and those checks silently weaken.
   47: MIPSLS=$SEC/src/cpus/tmp_mips_loadstore.c
   48: need_file "$MIPSLS"
   49: 
   50: #  ls_entry <array-name> <index> -> the function symbol at that index, read from
   51: #  the committed generated table (the [32] arrays, not the [16] generic ones).
   52: ls_entry() {
   53:     awk -v arr="$1" -v idx="$2" '
   54:         $0 ~ ("\\*" arr "\\[32\\]") { f = 1; n = 0; next }
   55:         f && /^};/ { f = 0 }
   56:         f { gsub(/[ \t,};]/, "");
   57:             if ($0 != "") { if (n == idx) { print $0; exit } n++ } }
   58:     ' "$MIPSLS"
   59: }
   60: 
   61: for arr in mips32_loadstore mips_loadstore; do
   62:     pfx=${arr%_loadstore}
   63:     check "  $arr[5]  = plain word-load LE"  "$(ls_entry $arr 5)"  "${pfx}_instr_l4_le"
   64:     check "  $arr[12] = plain word-store LE" "$(ls_entry $arr 12)" "${pfx}_instr_s4_le"
   65:     check "  $arr[21] = plain word-load BE"  "$(ls_entry $arr 21)" "${pfx}_instr_l4_be"
   66:     check "  $arr byte-load LE/BE share [1]==[17]" \
   67:         "$([ "$(ls_entry $arr 1)" = "$(ls_entry $arr 17)" ] && echo same || echo differ)" "same"
   68:     check "  $arr byte-store LE/BE share [8]==[24]" \
   69:         "$([ "$(ls_entry $arr 8)" = "$(ls_entry $arr 24)" ] && echo same || echo differ)" "same"
   70:     check "  $arr word-load LE != BE [5]!=[21]" \
   71:         "$([ "$(ls_entry $arr 5)" != "$(ls_entry $arr 21)" ] && echo differ || echo same)" "differ"
   72: done
   73: 
   74: #  b1w: the pty record parser's selftest, and a POSITIVE CONTROL that proves the selftest can
   75: #  still catch something.  Placed BEFORE the compiler check on purpose: it needs only python3,
   76: #  and a machine without cc must not silently lose parser coverage as well as the
   77: #  differentials.  A measured census (absorb_census.py, 22 mutants) is what set the row floor;
   78: #  the shipped selftest before this round killed 17 of those 22 while reporting every row
   79: #  green, because its rows compared body+tail and a mutant that only MOVES text between the
   80: #  halves preserves the sum.
   81: ABLOG=$LOGDIR/selftest_absorb.log
   82: python3 "$HERE/selftest_absorb.py" > "$ABLOG" 2>&1 || true
   83: check     "absorb: no row failed" \
   84:           "$(grep -oE '[0-9]+ failures' "$ABLOG" | grep -oE '^[0-9]+')" "0"
   85: check     "absorb: verdict present" "$(grep -c SELFTEST_ABSORB_PASS "$ABLOG")" "1"
   86: check_min "absorb: rows actually run" \
   87:           "$(grep -oE '^[0-9]+ rows' "$ABLOG" | grep -oE '^[0-9]+')" 52
   88: #  Name the two rows the census showed were load-bearing, so deleting either is a red row
   89: #  rather than a quieter file.  (#410's lesson: a row that can only be counted cannot be
   90: #  missed by name.)
   91: check     "absorb: the hold invariant row is present" \
   92:           "$(grep -c 'tail invariant held at every step' "$ABLOG")" "1"
   93: #  A FLOOR: three today, and adding a fourth guest-text fixture must not red the gate.
   94: check_min "absorb: the body-landing rows are present" \
   95:           "$(grep -c 'lands in BODY' "$ABLOG")" 1
   96: 
   97: #  #425/#426: the budget the driver PRINTS must be the budget it ENFORCES, and the gate's
   98: #  budget classifier must be exercisable without a rig.  Both are offline.
   99: #
  100: #  The straddle (selftest_budget.py) reads BUDGET=N from the driver's OWN OUTPUT and then
  101: #  runs one leg under N and one over it.  MEASURED against three mutants in copies: a
  102: #  call-site multiply, a multiply at the COMPARISON, and a deleted stop -- all three go red,
  103: #  and the unmutated copy passes.  The comparison mutant is the one NO printing scheme can
  104: #  catch, which is why this row exists at all.
  105: BULOG=$LOGDIR/selftest_budget.log
  106: python3 "$HERE/selftest_budget.py" > "$BULOG" 2>&1 || true
  107: check     "budget: no row failed" \
  108:           "$(grep -oE '[0-9]+ failures' "$BULOG" | grep -oE '^[0-9]+')" "0"
  109: check     "budget: verdict present" "$(grep -c SELFTEST_BUDGET_PASS "$BULOG")" "1"
  110: check_min "budget: rows actually run" \
  111:           "$(grep -oE '^[0-9]+ rows' "$BULOG" | grep -oE '^[0-9]+')" 7
  112: check     "budget: the over-budget leg stops for the budget" \
  113:           "$(grep -c 'ok    a run PAST the printed budget stops' "$BULOG")" "1"
  114: check     "budget: the under-budget leg does not" \
  115:           "$(grep -c 'ok    a run UNDER the printed budget does not stop' "$BULOG")" "1"
  116: 
  117: #  #467: the deadline must fail on SILENCE, not on ELAPSED TIME.  Every pty probe used to
  118: #  spend a TOTAL-TIME budget, so a boot that took 90 s on a loaded host failed while bytes
  119: #  were arriving throughout -- slow was indistinguishable from stuck, and the battery could
  120: #  only be trusted on an idle machine.
  121: #
  122: #  THE TWO LEGS ARE OPPOSITE IN SIGN AND BOTH ARE CHECKED HERE.  A conversion that made the
  123: #  timeout UNREACHABLE would pass the slow-but-progressing leg and defend nothing; the
  124: #  genuinely-stuck leg is what refuses that.  Checking only the first would be the
  125: #  check-that-cannot-fail shape this tree keeps finding in its own work.
  126: IALOG=$LOGDIR/selftest_inactivity.log
  127: python3 "$HERE/selftest_inactivity.py" > "$IALOG" 2>&1 || true
  128: check     "inactivity: verdict present" "$(grep -c SELFTEST_INACTIVITY_PASS "$IALOG")" "1"
  129: check     "inactivity: the slow-but-progressing leg passes under the new shape" "$(grep -c 'NEW inactivity shape passes' "$IALOG")" "1"
  130: check     "inactivity: the genuinely-stuck leg STILL fails" "$(grep -c 'NEW inactivity shape STILL fails' "$IALOG")" "1"
  131: 
  132: #  budget_class lives in lib.sh precisely so this truth table can run here rather than only
  133: #  under a weekly rig boot.  `zeroed` is the case that used to print a GREEN "deliberately
  134: #  absent" for a rig whose budget is 12 G -- measured at 11/11 PASS before this round.
  135: check "budget class: calibrated value"    "$(budget_class luna88k 12000000000)" "calibrated"
  136: check "budget class: ZERO on a calibrated rig is not 'absent'" \
  137:                                           "$(budget_class luna88k 0)"           "zeroed"
  138: check "budget class: out of range"        "$(budget_class luna88k 5)"           "out-of-range"
  139: check "budget class: a deliberate zero stays absent" \
  140:                                           "$(budget_class landisk 0)"           "absent"
  141: check "budget class: missing is never zero" "$(budget_class luna88k '')"        "unreported"
  142: 
  143: #  THE POSITIVE CONTROL IS THE NAMED SURVIVOR ITSELF, applied to COPIES -- never the repo.
  144: #  An in-process wrong-expectation row would only prove the reporter can print FAIL; this
  145: #  proves THE ROW KILLS THE MUTANT.  Three states stay distinguishable IN AGGREGATE: never
  146: #  ran (empty log -- rows 1, 3 and 4 red; note that row 2 asks only for a nonzero status and
  147: #  a never-run python3 also exits nonzero, so THAT ROW ALONE DOES NOT SEPARATE THEM, which a
  148: #  review seat measured), ran and crashed (nonzero status, NO verdict token), ran and caught
  149: #  (the token plus the killing row's name).  The gate is red in all three failure shapes.
  150: ACDIR=$LOGDIR/absorb_control
  151: rm -rf "$ACDIR"; mkdir -p "$ACDIR"
  152: python3 - "$HERE" "$ACDIR" <<'PYCTL' > "$ACDIR/apply.log" 2>&1
  153: import os, shutil, sys
  154: here, out = sys.argv[1], sys.argv[2]
  155: src = open(os.path.join(here, "drive_guest.py"), encoding="utf-8").read()
  156: old = 'if i != -1 and "\\n" not in rest[i:] and len(rest) - i < HOLD_MAX:'
  157: new = 'if i != -1 and len(rest) - i < HOLD_MAX:'
  158: if src.count(old) != 1:
  159:     print("CONTROL_STALE applies %d times" % src.count(old)); sys.exit(1)
  160: open(os.path.join(out, "drive_guest.py"), "w", encoding="utf-8",
  161:      newline="\n").write(src.replace(old, new))
  162: shutil.copyfile(os.path.join(here, "selftest_absorb.py"),
  163:                 os.path.join(out, "selftest_absorb.py"))
  164: print("CONTROL_APPLIED")
  165: PYCTL
  166: check     "absorb control: the mutant still applies to today's parser" \
  167:           "$(grep -c CONTROL_APPLIED "$ACDIR/apply.log")" "1"
  168: python3 "$ACDIR/selftest_absorb.py" > "$ACDIR/run.log" 2>&1; ACRC=$?
  169: check     "absorb control: the mutant is REJECTED (nonzero status)" \
  170:           "$([ "$ACRC" -ne 0 ] && echo rejected || echo "accepted rc=$ACRC")" "rejected"
  171: check     "absorb control: it failed rather than crashed" \
  172:           "$(grep -c SELFTEST_ABSORB_FAIL "$ACDIR/run.log")" "1"
  173: #  A FLOOR, not an exact count.  The mutant strands every bracket-carrying line in the tail,
  174: #  so it fails EVERY "lands in BODY" row -- three today.  Pinning the exact number would turn
  175: #  a legitimately added row into a red gate; what must be true is that the kill comes from
  176: #  THAT NAMED ROW and not from some unrelated collapse.
  177: check_min "absorb control: the kill is by the named row" \
  178:           "$(grep -c 'FAIL  lands in BODY' "$ACDIR/run.log")" 1
  179: #  KEEP THE LOGS WHEN THE CONTROL FAILS.  Removing them unconditionally deleted the only
  180: #  evidence at exactly the moment it was needed.
  181: [ "$ACRC" -ne 0 ] && grep -q SELFTEST_ABSORB_FAIL "$ACDIR/run.log" && rm -rf "$ACDIR"
  182: 
  183: command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 || \
  184:     gate_skip "no C compiler on PATH"
  185: CC=$(command -v cc || command -v gcc)
  186: need_file "$HERE/diff_ieee_store.c" "$SEC/src/$SRC"
  187: 
  188: # Pick a configured tree: it must have the generated config.h AND the header directory.
  189: TREE=""
  190: for t in "$ROOT/build" /tmp/gxsec-build; do
  191:     [ -f "$t/config.h" ] && [ -f "$t/src/include/float_emul.h" ] && { TREE=$t; break; }
  192: done
  193: [ -n "$TREE" ] || gate_skip "no configured tree (run gate_build.sh first)"
  194: note "compiling against configured tree: $TREE"
  195: 
  196: # THE HONESTY LINK. Without this the gate tests whatever happens to be in a scratch
  197: # directory, which may lag the repository by any amount.
  198: if cmp -s "$TREE/src/$SRC" "$SEC/src/$SRC"; then
  199:     check "compiled float_emul.c is the committed one" "identical" "identical"
  200: else
  201:     check "compiled float_emul.c is the committed one" "DIFFERS" "identical"
  202:     note "the configured tree is stale -- run gate_build.sh to re-sync"
  203:     gate_end; exit $?
  204: fi
  205: 
  206: # #299's 2Sum exactness contract is enforced by GLOBAL build facts, not by anything
  207: # local to the helper: it needs strict IEEE doubles, so -ffast-math (or friends) in the
  208: # TREE's configure would break the shipped emulator while this gate -- which compiles
  209: # with its own flags -- stayed green. A panel seat named that exact hole, so the gate
  210: # trips on the flags themselves.
  211: if grep -Eq -- "-ffast-math|-Ofast|-funsafe-math|-fassociative-math|-ffp-contract=fast" \
  212:         "$SEC/configure" "$SEC/Makefile.skel" 2>/dev/null; then
  213:     check "tree build flags preserve IEEE arithmetic (no fast-math)" "found" "absent"
  214: else
  215:     check "tree build flags preserve IEEE arithmetic (no fast-math)" "absent" "absent"
  216: fi
  217: 
  218: # #303: the grep above reads the SCRIPTS; `CFLAGS=-Ofast ./configure` lands only in the
  219: # GENERATED Makefiles, which the emulator is actually built from, while this gate compiles
  220: # with its own -O2 -- a poisoned tree would misdecode D subnormals in the emulator with
  221: # every offline check green. So grep what the build actually uses, in every configured
  222: # tree present. This grep is the ONLY defence against tree-flag poisoning -- the runtime
  223: # canary below runs in THIS gate's own -O2 binary and can only see HOST-level trouble
  224: # (MXCSR FTZ/DAZ, a wrong rounding mode), a DIFFERENT hole (both were a panel seat's
  225: # findings; a diff-review seat corrected the first version of this comment, which
  226: # claimed the canary covered this one too).
  227: GENBAD=absent
  228: for t in "$ROOT/build" /tmp/gxsec-build; do
  229:     [ -f "$t/Makefile" ] || continue
  230:     if grep -Eq -- "-ffast-math|-Ofast|-funsafe-math|-fassociative-math|-ffp-contract=fast" \
  231:             "$t/Makefile" "$t"/src/Makefile "$t"/src/*/Makefile 2>/dev/null; then
  232:         GENBAD=found
  233:     fi
  234: done
  235: check "generated Makefiles preserve IEEE arithmetic too" "$GENBAD" "absent"
  236: 
  237: BIN=$LOGDIR/diff_ieee_store
  238: LOG=$LOGDIR/diff_ieee_store.log
  239: if ! $CC -O2 -I"$TREE/src/include" -o "$BIN" \
  240:         "$HERE/diff_ieee_store.c" "$TREE/src/$SRC" -lm > "$LOG" 2>&1; then
  241:     note "compile failed:"; sed 's/^/       /' "$LOG" | head -12
  242:     check "differential compiles and links" "no" "yes"
  243:     gate_end; exit $?
  244: fi
  245: check "differential compiles and links" "yes" "yes"
  246: 
  247: "$BIN" > "$LOG" 2>&1
  248: sed 's/^/       /' "$LOG"
  249: echo
  250: 
  251: val() { grep -E "^$1" "$LOG" | head -1 | sed 's/.*: *//' | tr -d ' '; }
  252: 
  253: # Absolute answers first: a differential alone is relative and passes when both sides are
  254: # wrong the same way.
  255: check     "absolute-answer failures"               "$(val 'absolute-answer failures')" "0"
  256: check_min "absolute-answer cases run"              "$(val 'absolute-answer cases')"    6
  257: 
  258: # NOTHING EXTRA CHANGED: no difference may appear outside the two expected groups.
  259: check     "S-format: unexplained differences"      "$(val 'UNEXPLAINED')"       "0"
  260: check     "S-format: in-range values moved"        "$(val 'in-range')"          "0"
  261: # NOTHING WAS MISSED: everything inside those groups must actually differ. Without this
  262: # half, the check only proves the differences it happened to see were allowed -- and a
  263: # broken version that fixes overflow for negative numbers but not positive ones would
  264: # sail through.
  265: check     "S-format: inputs that should have moved but did not" "$(val 'MISSED')" "0"
  266: check_min "S-format: how many inputs should have moved" "$(val 'must-differ population')" 1000
  267: # #331: this was "D-format: change-set is empty" == 0, and its flip is the
  268: # headline of that round -- upstream has NO gradual underflow in double
  269: # precision (an empty "FP_SUBNORMAL: TODO" arm), so this tree now differs from
  270: # it for every D subnormal it samples. The floor is what makes the assertion
  271: # mean something: a bare "> 0" would be satisfied by a single surviving diff
  272: # where the class is roughly ten thousand strong, which is the same
  273: # cannot-fail species this gate's header warns about. Measured 9839 over the
  274: # 20M-sample sweep (host-subnormal patterns are about 1 in 2048 of it).
  275: check_min "D-format: subnormal change-set present" "$(val 'D-format diffs')" 9000
  276: check_min "S-format: overflow class is non-empty"  "$(val '  of which overflow')" 1
  277: check_min "S-format: underflow class is non-empty" "$(val '  of which negative')" 1
  278: check_min "samples swept"                          "$(val 'samples')"       20000000
  279: check     "clamp threshold is 2^129, not 2^128"    "$(val 'clamp-at')"          "2^129"
  280: check     "exponent-255 threshold is 2^128"        "$(val 'exp255-at')"         "2^128"
  281: # #331: was 2^128 -- the overflow threshold #287 fixed, which used to be the
  282: # smallest input where the two implementations parted. The subnormal band is
  283: # further down, so it now comes first. The overflow pins either side of it
  284: # (clamp-at, exp255-at) are unchanged, which is what shows this moved because
  285: # a NEW class appeared below it rather than because the old one drifted.
  286: check     "first shipped-vs-upstream diff at 2^-149" "$(val 'first-difference-at')" "2^-149"
  287: 
  288: # #292: the mode-aware entry point, checked against INDEPENDENT oracles (the host's own
  289: # correctly-rounded float conversion) rather than against upstream. Named vectors carry
  290: # the cases a random sweep cannot hit -- an exact half-way tie occurs about once per 2^29
  291: # random inputs.
  292: check     "rm: nearest matches the host oracle"    "$(val 'rm: RN oracle')"     "0"
  293: check     "rm: toward-zero matches its oracle"     "$(val 'rm: RZ oracle')"     "0"
  294: check_min "rm: the mode actually changes results"  "$(val 'rm: mode-differing')" 1000000
  295: check     "rm: D untouched under every mode"       "$(val 'rm: D mismatches')"  "0"
  296: check     "rm: named-vector failures"              "$(val 'rm: named-vector' | cut -d'(' -f1)" "0"
  297: 
  298: # #303: the DECODE side. The canary is load-bearing for HOST-level trouble only --
  299: # MXCSR FTZ/DAZ or a non-nearest rounding mode void every D-subnormal expectation, and
  300: # the canary is the only check that can tell. (Tree-flag poisoning is the generated-
  301: # Makefile grep's job above; this binary compiles with its own -O2 and cannot see tree
  302: # flags.) It is computed with volatile operands at runtime -- a constant expression
  303: # would fold at compile time and pass on exactly the build it exists to catch.
  304: check     "interp: FTZ/DAZ+RN canary alive"        "$(val 'interp: FTZ')"       "alive"
  305: check     "interp: S subnormals both signs"        "$(grep 'interp: S subnormals' "$LOG" | grep -oE '[0-9]+ bad' | cut -d' ' -f1)" "0"
  306: check_min "interp: S population is exhaustive x2"  "$(grep 'interp: S subnormals' "$LOG" | grep -oE 'of [0-9]+' | cut -d' ' -f2)" 16777214
  307: check     "interp: D subnormals both signs"        "$(grep 'interp: D subnormals' "$LOG" | grep -oE '[0-9]+ bad' | cut -d' ' -f1)" "0"
  308: check_min "interp: D population not shrunken"      "$(grep 'interp: D subnormals' "$LOG" | grep -oE 'of [0-9]+' | cut -d' ' -f2)" 400000
  309: check     "interp: D m=3/m=4 decode distinct"      "$(val 'interp: D m=3/m=4')"  "yes"
  310: check     "interp: controls untouched"             "$(grep 'interp: controls' "$LOG" | grep -oE '[0-9]+ bad' | cut -d' ' -f1)" "0"
  311: check     "interp: verdict"                        "$(grep -c 'INTERP_RESULT=PASS' "$LOG")" "1"
  312: 
  313: check     "verdict"                                "$(grep -c 'DIFF_PASS' "$LOG")" "1"
  314: 
  315: # ---- #392: the readiness predicate, proved offline ----------------------
  316: # Belongs in THIS gate because it needs no emulator, no pty and no host timing --
  317: # it replays the probes' wait() loop over a scripted byte stream. That property is
  318: # the point: a readiness test whose verdict moved with host load would repeat the
  319: # mistake that once false-FAILed a 45-minute battery.
  320: #
  321: # The four rows are a truth table, and the middle two are the interesting ones:
  322: # changing the prompt STRING alone does not fix the defect (full+whole still
  323: # returns after one byte), and anchoring alone does not either. Only both together
  324: # read the reply. If a future change makes 'full-whole' pass, the predicate has
  325: # stopped being tested rather than started working.
  326: #
  327: # NOTE what this does NOT prove: it tests the four FORMS, not the probes, so on
  328: # its own it would stay green if a probe were reverted. The static census in
  329: # gate_hygiene.sh is what binds the shipped code to this result.
  330: #  A PER-RUN NONCE. It RAISES THE BAR AND DOES NOT CLOSE THE DOOR, and the
  331: #  previous version of this comment claimed otherwise -- wrongly.
  332: #
  333: #  What it does stop: a static transcript. The nonce enters the scripted reply,
  334: #  so the reported byte counts shift by exactly its length, and a file of frozen
  335: #  numbers fails (measured: fake reports 53 where 59 is required).
  336: #
  337: #  *** WHAT IT DOES NOT STOP, MEASURED BY A SEAT: the nonce is passed as an
  338: #  ARGUMENT TO THE VERY SCRIPT BEING VALIDATED, so a fake needs only
  339: #  len(sys.argv[1]) to compute the affine counts. A 12-line transcript that runs
  340: #  no loops passed all ten checks here and both pins in gate_hygiene. ***
  341: #  An oracle that asks the prover to KNOW A PUBLIC INPUT is not an oracle that
  342: #  asks it to DO THE WORK. A nonce only binds when it is WITHHELD -- the gate
  343: #  would have to recompute the expected stream itself, or vary something whose
  344: #  effect is not a length the script is handed. That is a design change, filed
  345: #  rather than rushed; see the queue entry on binding this test to real work.
  346: #  Recorded here rather than quietly weakened, because a check that overstates
  347: #  what it proves is worse than one that states its limit.
  348: #  d1: the driver must put BOTH pty logs where $LOGDIR says.  This cannot be a gate-5 row:
  349: #  in the default battery $LOGDIR IS the string the driver used to hardcode, so such a row
  350: #  passes on the unfixed code -- measured.  selftest_logdir.py points LOGDIR somewhere else
  351: #  and runs a stub in place of the emulator, so it needs no rig and no boot.  It sets the
  352: #  variable itself rather than being invoked as `env LOGDIR=... `, which would export from
  353: #  OUTSIDE and stay green with lib.sh's export missing (half the defect).
  354: DLOG=$LOGDIR/selftest_logdir.log
  355: python3 "$HERE/selftest_logdir.py" > "$DLOG" 2>&1 || true
  356: dlv() { grep -m1 -oE "$1=[a-z]+" "$DLOG" | cut -d= -f2; }
  357: check     "driver honours \$LOGDIR for the console log" "$(dlv console_log_in_logdir)" "yes"
  358: check     "driver honours \$LOGDIR for the raw log"     "$(dlv raw_log_in_logdir)"     "yes"
  359: 
  360: RNONCE="n$$"
  361: RLEN=${#RNONCE}
  362: RLOG=$LOGDIR/readiness_predicate.log
  363: python3 "$HERE/readiness_predicate_test.py" "$RNONCE" > "$RLOG" 2>&1 || true
  364: rbytes() { grep -E "^READINESS_ROW +$1 " "$RLOG" | grep -oE 'bytes=[0-9]+' | cut -d= -f2; }
  365: rrow() { grep -E "^READINESS_ROW +$1 " "$RLOG" | grep -oE 'saw_reply=[a-z]+' | cut -d= -f2; }
  366: check     "readiness: bare+whole returns early"     "$(rrow bare-whole)" "no"
  367: check     "readiness: full+whole ALSO returns early" "$(rrow full-whole)" "no"
  368: check     "readiness: bare+mark returns early"      "$(rrow bare-mark)"  "no"
  369: check     "readiness: full+mark reads the reply"    "$(rrow full-mark)"  "yes"
  370: check     "readiness: rstrip re-matches old prompt" "$(grep -c 'READINESS_LEFTOVER.*keeps_prompt=yes' "$RLOG")" "1"
  371: #  The two LATE-PROMPT rows are the ECHO conjunct's only behavioural coverage.
  372: #  A seat measured that the echo half could be deleted from all fourteen sites
  373: #  with every gate still green, because the four rows above exercise the mark and
  374: #  the prompt string and nothing exercised the echo. These two do: a stale prompt
  375: #  arriving AFTER the mark cannot be distinguished by byte anchoring, only by
  376: #  requiring the new command's own echo first.
  377: check     "readiness: late prompt fools a no-echo wait"  "$(rrow late-noecho)" "no"
  378: check     "readiness: echo guard survives a late prompt" "$(rrow late-echo)"   "yes"
  379: #  THE ANTI-FAKE CHECK. Both counts are affine in the nonce length, so a printed
  380: #  transcript OF FROZEN NUMBERS cannot satisfy them -- but one that reads the
  381: #  nonce from argv can, which is why this is a bar and not a door (see above).
  382: #  53 and 60 are the measured baselines at
  383: #  nonce="" and the arithmetic was verified at lengths 0, 5 and 10.
  384: check     "readiness: full-mark byte count tracks the nonce" "$(rbytes full-mark)" "$((53 + RLEN))"
  385: check     "readiness: late-echo byte count tracks the nonce" "$(rbytes late-echo)" "$((60 + RLEN))"
  386: check     "readiness: offline verdict"              "$(grep -c 'READINESS_RESULT=6/6' "$RLOG")" "1"
  387: 
  388: # ---- #400: the SH-4 TMU tick arithmetic -----------------------------------------
  389: # Same shape as the float_emul differential above, and for the same reason: the driver
  390: # stubs fatal() and #includes dev_sh4.c, so the sh4_timer_tick() that runs IS the one
  391: # that ships. sh4_timer_tick is static, so there is no way to link it without including
  392: # the file -- which is precisely what makes a transcription impossible here.
  393: #
  394: # The rows are exact values, not "did it move". The defect being guarded pinned TCNT at
  395: # zero permanently on a booting OpenBSD/landisk guest after 515.4 s; the no-freeze row
  396: # reproduces that in milliseconds instead of a 9.5-minute boot.
  397: #
  398: # The three-timer row exists because a measure seat found two wrong variants -- tcor[0]
  399: # for tcor[i], and cnt from tcnt[0] -- that are BIT-IDENTICAL to correct code across all
  400: # 824288 single-timer cases, because every other row starts timer 0 only. They are the
  401: # typo this rewrite newly risks. Measured: that row alone kills both.
  402: #  #427-#429: the timer core's frequency domain and its catch-up bound, driven OFFLINE.
  403: #  The driver #includes the shipped src/core/timer.c (timer_tick is static), stubs only
  404: #  gettimeofday, and never installs a signal handler -- so no host clock enters and these
  405: #  rows are not load-sensitive.  MEASURED against six mutants in copies: no ceiling,
  406: #  clamp-below-the-early-out, unbounded catch-up, both-clamps-written-plainly, and the
  407: #  drop-the-backlog policy all go red; the shipped file passes.
  408: TIMBIN=$LOGDIR/diff_timer
  409: TIMLOG=$LOGDIR/diff_timer.log
  410: #  -D_POSIX_C_SOURCE, because strict c99 hides struct sigaction and SA_RESTART, which the
  411: #  shipped timer.c uses -- the driver never calls that code, but it still has to compile.
  412: if ! $CC -O1 -std=c99 -D_POSIX_C_SOURCE=200809L -I"$SEC/src/include" \
  413:         -o "$TIMBIN" "$HERE/diff_timer.c" -lm > "$TIMLOG" 2>&1; then
  414:     note "timer differential compile failed:"; sed 's/^/       /' "$TIMLOG" | head -12
  415:     check "timer: compiles against the real timer.c" "no" "yes"
  416: else
  417:     check "timer: compiles against the real timer.c" "yes" "yes"
  418:     "$TIMBIN" > "$TIMLOG" 2>&1
  419:     sed 's/^/       /' "$TIMLOG"
  420:     check     "timer: row failures" \
  421:               "$(grep -oE '[0-9]+ failures' "$TIMLOG" | grep -oE '^[0-9]+')" "0"
  422:     #  THE FLOOR MUST EQUAL THE ROW COUNT, and it did not: it stood at 13 while the driver
  423:     #  ran 14, so DELETING THE IDENTITY ROW LEFT THE GATE FULLY GREEN -- the one defect the
  424:     #  identity row exists to prevent.  Two review seats read it independently and a third
  425:     #  measured it.  A floor set one below the count is not a weaker check, it is no check.
  426:     check_min "timer: rows actually run" \
  427:               "$(grep -oE '^[0-9]+ rows' "$TIMLOG" | grep -oE '^[0-9]+')" 24
  428:     check     "timer: offline verdict" "$(grep -c 'DIFF_TIMER_PASS' "$TIMLOG")" "1"
  429:     #  Name every row that is the SOLE detector of something, so deleting one is a red row
  430:     #  rather than a quieter file.  Each line below names a mutant that survived the first
  431:     #  version of this differential and was killed by adding that row.
  432:     check "timer: the NaN row is present" \
  433:           "$(grep -c 'NaN lands on the FLOOR' "$TIMLOG")" "1"
  434:     check "timer: the idempotence row is present" \
  435:           "$(grep -c 'five identical requests reset the schedule' "$TIMLOG")" "1"
  436:     check "timer: the anti-regression rows are present" \
  437:           "$(grep -c 'still delivers ~' "$TIMLOG")" "2"
  438:     #  The rows that defend the CONSTANTS.  Every other row reads them from the header and
  439:     #  is therefore green for any value; these two are derived from outside it.
  440:     check "timer: the ceiling-is-INT_MAX row is present" \
  441:           "$(grep -c 'the ceiling IS INT_MAX' "$TIMLOG")" "1"
  442:     check "timer: the floor-is-reachable row is present" \
  443:           "$(grep -c "the floor's interval is still a reachable" "$TIMLOG")" "1"
  444:     #  The absolute floor that defends TIMER_MAX_CATCHUP's value: 40 MHz is the pmax rate,
  445:     #  so this is the offline half of a case the weekly battery boots.
  446:     check "timer: the 40 MHz keeps-time row is present" \
  447:           "$(grep -c 'a 40 MHz timer' "$TIMLOG")" "1"
  448:     #  The bound's EXACT count, and the policy it protects.
  449:     check "timer: the exact-bound row is present" \
  450:           "$(grep -c 'delivers exactly the bound' "$TIMLOG")" "1"
  451:     check "timer: the backlog-retained row is present" \
  452:           "$(grep -c 'the retained backlog' "$TIMLOG")" "1"
  453:     #  The instrument's own self-check: without it the stall above can go inert again, as
  454:     #  it silently was when this differential first shipped.
  455:     check "timer: the stall-is-real row is present" \
  456:           "$(grep -c 'arming the resync really moves' "$TIMLOG")" "1"
  457:     #  The reporting path, which had no row at all: deleting the flag assignment from the
  458:     #  signal handler passed everything.
  459:     check "timer: the cap-is-reported row is present" \
  460:           "$(grep -c 'reports it exactly once' "$TIMLOG")" "1"
  461:     check "timer: the complaint-is-made row is present" \
  462:           "$(grep -c 'complains exactly once' "$TIMLOG")" "1"
  463:     check "timer: the interval-is-reciprocal row is present" \
  464:           "$(grep -c 'the interval is exactly 1/freq' "$TIMLOG")" "1"
  465: fi
  466: 
  467: #  #430-#431: memory_rw() translated the START vaddr once and then copied the whole length
  468: #  from that page's host pointer, so a page-crossing access walked PHYSICALLY contiguous
  469: #  host bytes across a VIRTUALLY contiguous guest span.  Driven OFFLINE, because the defect
  470: #  needs two pages adjacent virtually and NOT adjacent physically and no rig in this tree can
  471: #  be made to produce that on demand -- the map comes from a stub instead.
  472: #  MEASURED against the pre-fix file (git show b9daca1:src/cpus/memory_rw.c): 11 of these
  473: #  rows go red, including the reproduction (a straddling read returning the physically-
  474: #  following page), the straddling WRITE corrupting an unrelated page, the device case, and
  475: #  the missing fault.  -I"$SEC/src" because the driver includes "include/misc.h" the way the
  476: #  cpu files do.
  477: MRWBIN=$LOGDIR/diff_memory_rw
  478: MRWLOG=$LOGDIR/diff_memory_rw.log
  479: #  -fno-optimize-sibling-calls IS LOAD-BEARING, and only for the stack row.  gcc 15.2.1
  480: #  DOES eliminate the tail call at -O2, so a recursion mutant measured a 96-byte span and
  481: #  the "it is a loop" row passed under the very defect it exists to catch -- vacuous.
  482: #  With the flag: loop 0 bytes, recursion 1,572,768.  Measured both ways by a review seat.
  483: if ! $CC -O2 -fno-optimize-sibling-calls -std=c99 -D_POSIX_C_SOURCE=200809L \
  484:         -D_DEFAULT_SOURCE -I"$SEC/src" \
  485:         -o "$MRWBIN" "$HERE/diff_memory_rw.c" -lm > "$MRWLOG" 2>&1; then
  486:     note "memory_rw differential compile failed:"; sed 's/^/       /' "$MRWLOG" | head -12
  487:     check "memory_rw: compiles against the real memory_rw.c" "no" "yes"
  488: else
  489:     check "memory_rw: compiles against the real memory_rw.c" "yes" "yes"
  490:     "$MRWBIN" > "$MRWLOG" 2>&1
  491:     sed 's/^/       /' "$MRWLOG"
  492:     check     "memory_rw: row failures" \
  493:               "$(grep -oE '[0-9]+ failures' "$MRWLOG" | grep -oE '^[0-9]+')" "0"
  494:     #  The floor is the EXACT count, not one below it: a floor set under the count makes the
  495:     #  identity row deletable with the gate still green, which is what #430's sibling round
  496:     #  had to fix in the timer differential.
  497:     #
  498:     #  *** AND THIS PIN HAD DRIFTED SIX BELOW ITS OWN COUNT, UNDER THAT VERY SENTENCE. ***
  499:     #  17 against a harness printing 23.  A reading seat noticed it; a measuring seat then
  500:     #  DEMONSTRATED it rather than arguing it -- deleted six unpinned rows (A1, B2, B3, C1,
  501:     #  C2, D2, none named by any presence check), retuned the identity constant 23 -> 17 as a
  502:     #  legitimate edit would, and ran this gate's own memory_rw block verbatim: 14 OF 14
  503:     #  GREEN with six rows gone, identity row included.  (The first record of this said
  504:     #  "13 of 13"; a pass-2 seat reproduced the experiment and counted 14.  Substance
  505:     #  identical, number off by one, and it appeared in two places.)
  506:     #
  507:     #  Rows were added in later rounds and the pin was not moved with them.  Every other
  508:     #  floor in this gate was then swept the same way.  THERE ARE THIRTEEN, and the first
  509:     #  version of this list named NINE -- a pass-2 seat measured all thirteen and named the
  510:     #  four omitted: absorb 52/52, budget 7/7, autodev generator 8/8 and DISK GEOMETRY 34/34,
  511:     #  the last of which is a diff_*.c and so the omission a reader would notice.  In full:
  512:     #  absorb 52, budget 7, timer 24, memory_rw 23 (this one, after the fix), footbridge 19,
  513:     #  m8820x 25, m8invread 27, TMU 16, wdc 16, autodev 8, io 45, geom 34, parser 37 -- all
  514:     #  exact, so the drift is bounded to this one.  A DOCTRINE STATED IN A COMMENT IS NOT A MECHANISM:
  515:     #  nothing in the battery compares a floor to the count it claims to pin, which is why
  516:     #  this went six rounds unnoticed while the sentence above kept asserting otherwise.
  517:     check_min "memory_rw: rows actually run" \
  518:               "$(grep -oE '^[0-9]+ rows' "$MRWLOG" | grep -oE '^[0-9]+')" 23
  519:     check     "memory_rw: offline verdict" "$(grep -c 'DIFF_MEMORY_RW_PASS' "$MRWLOG")" "1"
  520:     #  Name each row that is the SOLE detector of something, so deleting one is a red row
  521:     #  rather than a quieter file.
  522:     check "memory_rw: the straddling-read row is present" \
  523:           "$(grep -c 'straddling read takes the VIRT-next page' "$MRWLOG")" "1"
  524:     check "memory_rw: the write-corruption rows are present" \
  525:           "$(grep -c 'the PHYS-next page was NOT corrupted' "$MRWLOG")" "1"
  526:     check "memory_rw: the device-straddle row is present" \
  527:           "$(grep -c 'device head, RAM tail' "$MRWLOG")" "1"
  528:     check "memory_rw: the faulting-tail rows are present" \
  529:           "$(grep -c 'bad tail returns FAILED' "$MRWLOG")" "2"
  530:     #  The two rows that defend the DESIGN rather than the fix: PHYSICAL must not be split,
  531:     #  and the split must not consume stack per page.
  532:     check "memory_rw: the PHYSICAL-not-split row is present" \
  533:           "$(grep -c 'splits per MEMBLOCK, not per page' "$MRWLOG")" "1"
  534:     check "memory_rw: the loop-not-recursion row is present" \
  535:           "$(grep -c 'stack does not grow per page' "$MRWLOG")" "1"
  536:     #  The two rows the pass-2 review forced, each covering a defect IN THE FIX: a 4 KB
  537:     #  split granule silently misses a 1 KB mapping (ARM tiny pages, SH SZ_1K), and the
  538:     #  split broke #244's promise that a failed read leaves the WHOLE buffer zeroed.
  539:     check "memory_rw: the 1 KB-granule row is present" \
  540:           "$(grep -c 'across a 1 KB mapping boundary' "$MRWLOG")" "1"
  541:     check "memory_rw: the first-chunk-fault rows are present" \
  542:           "$(grep -c 'first-chunk fault' "$MRWLOG")" "1"
  543:     check "memory_rw: the one-byte-tail rows are present" \
  544:           "$(grep -c '1-byte tail across' "$MRWLOG")" "2"
  545:     check "memory_rw: the identity row is present" \
  546:           "$(grep -c 'IDENTITY row count' "$MRWLOG")" "1"
  547: fi
  548: 
  549: #  #432: the footbridge timer divided by a guest-written zero -- a guest-reachable HOST CRASH,
  550: #  reproduced independently by two seats.  Driven OFFLINE because THERE IS NO NETWINDER OR CATS
  551: #  RIG ANYWHERE IN THIS TREE: nothing here boots a machine that has a footbridge, so this is not
  552: #  the cheapest detector, it is the only possible one.  The driver #includes the shipped device,
  553: #  exactly as diff_sh4_tmu.c does.
  554: #  -Wl,--gc-sections is LOAD-BEARING: without it the link needs eleven more symbols.  The
  555: #  trade-off, stated so it is not mistaken for coverage: it drops DEVINIT, so this file cannot
  556: #  test devinit.  -D_DEFAULT_SOURCE is required for random() under -std=c99.
  557: #  MEASURED against seven mutants in copies -- all red, control passes: the zero guard removed
  558: #  (dies BY SIGNAL 8, the crash itself), the prescaler back to a signed shift, the tick site
  559: #  prescaling, TIMER_EXTERNAL falling through as a bare x16, and the three that PASS 2 found
  560: #  surviving the first fifteen rows -- one character deleting the prescaler from the RATE domain,
  561: #  the tick counter replaced by a constant, and normalize-at-write (the design this round
  562: #  REJECTED).  An eighth is EQUIVALENT and deliberately not counted: on a uint64_t, `<<= 4` and
  563: #  `*= 16` are the same operation for every value in range -- it is the TYPE that makes it
  564: #  equivalent, not the magnitude.
  565: #
  566: #  ON THE FORKS, CORRECTED: two rows fork, and the first version of this comment said that made
  567: #  a re-crashing mutant a named-row KILL rather than a census FAULT.  MEASURED FALSE by two seats
  568: #  independently -- D2 is UNFORKED and reaches the divide first, so an unconditional
  569: #  re-introduction of the crash takes the binary down there, before F1's fork.  G1's fork IS
  570: #  load-bearing (the CONTROL-arm exit(1) is reachable nowhere else in-process) and F1's contains
  571: #  a narrower class (a zero-guard conditioned on the prescaler bits survives D2 and dies in F1).
  572: #  Detection is unaffected either way: a log cut anywhere before its LAST line fails the verdict check
  573: #  below (DIFF_FOOTBRIDGE_PASS is printed last), and one cut before the summary line fails the row-count
  574: #  and failure-count checks too -- each greps the whole file, so a per-row presence grep can still find a
  575: #  row printed before the cut.  (This said "every grep below fails on a truncated log" until #545's repair
  576: #  3, and then that the counts read the file's last lines until repair 3c; neither was so.)
  577: FBBIN=$LOGDIR/diff_footbridge
  578: FBLOG=$LOGDIR/diff_footbridge.log
  579: if ! $CC -O2 -std=c99 -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE \
  580:         -I"$SEC/src" -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
  581:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
  582:         -o "$FBBIN" "$HERE/diff_footbridge.c" -lm > "$FBLOG" 2>&1; then
  583:     note "footbridge differential compile failed:"; sed 's/^/       /' "$FBLOG" | head -12
  584:     check "footbridge: compiles against the real dev_footbridge.c" "no" "yes"
  585: else
  586:     check "footbridge: compiles against the real dev_footbridge.c" "yes" "yes"
  587:     "$FBBIN" > "$FBLOG" 2>&1
  588:     sed 's/^/       /' "$FBLOG"
  589:     check     "footbridge: row failures" \
  590:               "$(grep -oE '[0-9]+ failures' "$FBLOG" | grep -oE '^[0-9]+')" "0"
  591:     check_min "footbridge: rows actually run" \
  592:               "$(grep -oE '^[0-9]+ rows' "$FBLOG" | grep -oE '^[0-9]+')" 864
  593:     check     "footbridge: offline verdict" "$(grep -c 'DIFF_FOOTBRIDGE_PASS' "$FBLOG")" "1"
  594:     #  #545: the five declined sites.  P0-P9 pin preservation under a NONZERO seeded status, the read
  595:     #  expressions, the latch per site and byte-first at IRQ_STATUS; X1-X3 (the pass-2 L2 repair) pin
  596:     #  byte/halfword-first at EVERY site, narrow legal reads, and that no legal access re-arms a latch;
  597:     #  X4/X5 pin ZERO data / a zero enable as the first access, and a legal zero Clear write.  X6/X7 are
  598:     #  the CLASS CLOSURE (two consecutive passes found cells of one space): every declined access --
  599:     #  site x width x data x state x first/repeat -- keeps every field and the interrupt output and reads
  600:     #  0; each legal access X7 samples, with every latch set, re-arms no latch.  X8: wide (multi-byte) seeds, so a legal read
  601:     #  truncated to 8 bits reds.  X9 (the adjudication pass, 2026-09-23): the legal accesses with the latches still
  602:     #  CLEAR -- X7 latched every site first, so five one-conjunct edits to the direction test (`writeflag ==
  603:     #  MEM_READ && d->irq_enable` and mirrors) passed every row (q2_20260923/Q2.log).  X10-X12 (that repair's own
  604:     #  pass 2, where the Opus seat's 434 variants found three more cells open): X10 the VALUE of a legal access
  605:     #  with every latch set, X11 each ordered pair of sites' latches, X12 the legal Clear write's width and data.
  606:     #  STATES in X6/X7/X9-X13: seeded, all-zero, wide and ONES -- the ones state sets every bit of every field,
  607:     #  so with all-zero a condition keyed on any single bit diverts in one of the two.  Repair 3 (the closure's own
  608:     #  closing pass): the 8-byte LDRD/STRD cells at +0x180/+0x280 (X6, X7, X9, X10), the return value (X7,
  609:     #  X10-X13), X11 in all four states with a re-decline, X13 the narrow Clear write with every latch set, and X14
  610:     #  the INSTANCE cells no other block could reach -- the drive test's disjoint and single-line cells on a CPU
  611:     #  counter pair of its own, DEVINIT's timer values with and without a pending tick, and irq_asserted raised
  612:     #  through the real footbridge_interrupt_assert().  Not covered, and said so in diff_footbridge.c's contract:
  613:     #  exact field or data values, the address axis, narrow Set/FIQ writes (fbenablewidth), the Set write's own
  614:     #  drive test, the interrupt LEVEL (fbirqstuck), and joints beyond the rowed cells.
  615:     #  Kill tables: regress/artifacts/fbd5/{killtable,xtable,table3,table4}_20260919/ and
  616:     #  regress/artifacts/fbd5/q2_20260923/{repair,repair2,r3_20260923}/.
  617:     #  COUNTED AS DISTINCT GREEN ROW NAMES, not green lines (adjudication pass, G10): a duplicated green
  618:     #  line cannot stand in for a missing row.  Every row name in the file is unique on the fix.
  619:     fb_distinct() { grep -E "^  ok    $1 " "$FBLOG" | sed -E 's/^  ok    //; s/[[:space:]]+[0-9]+$//' | sort -u | wc -l | tr -d ' '; }
  620:     check "footbridge: #545 P-rows green (P0-P9), distinct names" "$(fb_distinct 'P[0-9]')" "78"
  621:     check "footbridge: #545 X-rows green (X1-X8), distinct names" "$(fb_distinct 'X[1-8]')" "440"
  622:     check "footbridge: #545 X6 every declined-access cell green" "$(fb_distinct 'X6')" "248"
  623:     check "footbridge: #545 X7 every sampled legal access re-arms no latch" "$(fb_distinct 'X7')" "148"
  624:     check "footbridge: #545 X8 wide legal reads keep all 32 bits" "$(fb_distinct 'X8')" "6"
  625:     check "footbridge: #545 X9 legal access, latches clear, all states" "$(fb_distinct 'X9')" "100"
  626:     check "footbridge: #545 X10 legal access, latches SET, value kept" "$(fb_distinct 'X10')" "72"
  627:     check "footbridge: #545 X11 every ordered pair of site latches, four states" "$(fb_distinct 'X11')" "80"
  628:     check "footbridge: #545 X12 legal Clear write, every width and data" "$(fb_distinct 'X12')" "20"
  629:     check "footbridge: #545 X13 legal Clear write, latches SET" "$(fb_distinct 'X13')" "20"
  630:     check "footbridge: #545 X14 instance cells (drive test, DEVINIT, irq_asserted)" "$(fb_distinct 'X14')" "21"
  631:     #  Name each row that is the SOLE detector of something.
  632:     check "footbridge: the zero-load row is present" \
  633:           "$(grep -c 'load 0 becomes the full 24-bit span' "$FBLOG")" "1"
  634:     check "footbridge: the prescaler-overflow rows are present" \
  635:           "$(grep -c 'does not overflow\|does not wrap to zero' "$FBLOG")" "2"
  636:     check "footbridge: the TIMER_EXTERNAL row is present" \
  637:           "$(grep -c 'not silently read as x16' "$FBLOG")" "1"
  638:     #  #474: the five fbclearread rows.  Kill table 5/5 in
  639:     #  regress/artifacts/fbclearread/killtable_20260827/.  The last three exist ONLY
  640:     #  because the pass-2 codex seat returned DO NOT SHIP on a detector that was already
  641:     #  green: it named an early-`return` mutant (the very defect the fix comment claims to
  642:     #  avoid, and nothing tested it) and a guard widened to admit a PERIODIC read.  Both
  643:     #  were built and both were killed by these rows.
  644:     check "footbridge: the fbclearread defect row is present" \
  645:           "$(grep -c 'a READ of TIMER_1_CLEAR must NOT clear pending' "$FBLOG")" "1"
  646:     #  *** grep -cF, NOT grep -c: `[LIVE]` is a BRACKET EXPRESSION in a basic
  647:     #  regex, so `grep -c '[LIVE] a WRITE...'` looks for ONE of L/I/V/E followed
  648:     #  by ' a WRITE...' and can NEVER match a line whose label ends in ']'.
  649:     #  Both rows were PRESENT and GREEN while these two checks reported got=0,
  650:     #  so the offline gate was red from #474's second wave and the redness was
  651:     #  attributable to nothing.  A CHECK THAT CANNOT PASS -- the inverse of the
  652:     #  carrier's check-that-cannot-fail, and louder, but still a wrong record.
  653:     #  Sibling sweep at the time of the fix: 5 bracket patterns among 175
  654:     #  `grep -c` invocations across the gates; the other 3 (`^[XY]`, `^[<>]`)
  655:     #  are deliberate character classes and were left alone.
  656:     check "footbridge: the fbclearread live control is present" \
  657:           "$(grep -cF '[LIVE] a WRITE of TIMER_1_CLEAR decrements pending' "$FBLOG")" "1"
  658:     check "footbridge: the common-tail row is present" \
  659:           "$(grep -c 'a READ still runs the common tail' "$FBLOG")" "1"
  660:     check "footbridge: the periodic-reload row is present" \
  661:           "$(grep -c 'a PERIODIC read must not reload the counter' "$FBLOG")" "1"
  662:     check "footbridge: the periodic-pending row is present" \
  663:           "$(grep -c 'a PERIODIC read must not clear pending either' "$FBLOG")" "1"
  664:     #  #474 second wave: eight rows added after a MEASURING seat showed FIVE
  665:     #  one-token mutants sweeping the 24-row detector clean.  All nine mutants now die,
  666:     #  and SIX of them die on a single sole-carrier row -- no row here is redundant:
  667:     #    TIMER_ENABLE   a DISABLED timer can never hold a pending interrupt, so a guard
  668:     #                   widened by it re-opens the defect on the exact state this round
  669:     #                   exists for -- and no other row ever sets that bit
  670:     #    deassert PAIR  the guard wraps THREE effects and the rows observed two.  A row
  671:     #                   wanting ZERO can only fail upward, so the defect row needs its
  672:     #                   ACCEPT companion or a deletion of the effect scores green
  673:     #    anchors        TIMER_1_CLEAR is 0x30C and (0x30C >> 5) & 3 == 0, so every older
  674:     #                   row is an INDEX-0 row.  0x32C and 0x36C pin indices 1 and 3, and
  675:     #                   assert the NEIGHBOUR is untouched so a colliding re-map still reds
  676:     #    index-1 READ   the anchors drive WRITES, so a guard widened per-index passes them
  677:     #                   for the ordinary reason.  This row is the only one carrying BOTH
  678:     #                   properties: which cell, and that the access is refused
  679:     check "footbridge: the deassert ACCEPT row is present" \
  680:           "$(grep -cF '[LIVE] a WRITE DOES deassert the irq' "$FBLOG")" "1"
  681:     check "footbridge: the deassert defect row is present" \
  682:           "$(grep -c 'a READ must NOT deassert the irq' "$FBLOG")" "1"
  683:     check "footbridge: the TIMER_ENABLE row is present" \
  684:           "$(grep -c 'an ENABLED timer READ does not clear' "$FBLOG")" "1"
  685:     check "footbridge: the access-width row is present" \
  686:           "$(grep -c 'a 2-byte READ does not clear either' "$FBLOG")" "1"
  687:     check "footbridge: the index-1 anchor row is present" \
  688:           "$(grep -c '0x32C decrements timer index 1' "$FBLOG")" "1"
  689:     check "footbridge: the index-3 anchor row is present" \
  690:           "$(grep -c '0x36C decrements timer index 3' "$FBLOG")" "1"
  691:     check "footbridge: the non-zero-index READ row is present" \
  692:           "$(grep -c 'a READ at index 1 does not clear' "$FBLOG")" "1"
  693:     check "footbridge: the counter-domain row is present" \
  694:           "$(grep -c 'leave the 24-bit counter in range' "$FBLOG")" "1"
  695:     #  The three rows PASS 2 added, each the SOLE detector of a mutant that survived the first
  696:     #  fifteen: the rate consumer really prescaling (one character defeated it), the counter
  697:     #  tracking the guest's OWN load (every earlier tick row used load 0, for which a constant
  698:     #  is the right answer), and the LOAD register reading back unmodified (nothing drove the
  699:     #  access handler at all, so the design this round REJECTED passed).
  700:     check "footbridge: the rate-prescaler row is present" \
  701:           "$(grep -c 'RATE consumer really applies' "$FBLOG")" "1"
  702:     check "footbridge: the counter-tracks-load row is present" \
  703:           "$(grep -c "below the guest's OWN load" "$FBLOG")" "1"
  704:     check "footbridge: the LOAD read-back rows are present" \
  705:           "$(grep -cE 'reads back as 0, not normalised|stays 0 on read-back' "$FBLOG")" "2"
  706:     #  The two forked end-to-end rows: these are the ones that prove the HOST SURVIVES.  Their
  707:     #  forks do NOT make every re-crash a named-row kill: an unconditional one takes the binary
  708:     #  down at the unforked D2 first (ON THE FORKS, CORRECTED, above).  G1's fork is load-bearing
  709:     #  and F1's holds a narrower class.  (This comment said otherwise until #545's repair 3.)
  710:     check "footbridge: the end-to-end survival rows are present" \
  711:           "$(grep -c 'does not kill the host\|does not exit()' "$FBLOG")" "2"
  712:     check "footbridge: the identity row is present" \
  713:           "$(grep -c 'IDENTITY row count' "$FBLOG")" "1"
  714: fi
  715: 
  716: #  #433: the M8820x CMMU terminated the HOST process on an ordinary guest register access --
  717: #  measured at 1007 of 1024 word offsets on a plain READ, on luna88k, which BOOTS in this tree.
  718: #  Driven offline for BREADTH (1024 offsets x 2 directions x 256 commands is not a pty job);
  719: #  the online cold-debugger probe that proves guest-instruction reachability is filed separately.
  720: #  THE KILL CRITERION IS THE EXIT STATUS, not "the child died": the first reproduction of this
  721: #  defect overcounted by exactly six in each direction because six offsets crashed in the
  722: #  HARNESS (the register-file arm invalidates before the writeflag check, so it fires on reads,
  723: #  and the driver had left that callback NULL).  A signal death is reported as a FAULT here,
  724: #  never counted as a detection.
  725: M8BIN=$LOGDIR/diff_m8820x
  726: M8LOG=$LOGDIR/diff_m8820x.log
  727: if ! $CC -O2 -std=c99 -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE \
  728:         -I"$SEC/src" -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
  729:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
  730:         -o "$M8BIN" "$HERE/diff_m8820x.c" -lm > "$M8LOG" 2>&1; then
  731:     note "m8820x differential compile failed:"; sed 's/^/       /' "$M8LOG" | head -12
  732:     check "m8820x: compiles against the real dev_m8820x.c" "no" "yes"
  733: else
  734:     check "m8820x: compiles against the real dev_m8820x.c" "yes" "yes"
  735:     "$M8BIN" > "$M8LOG" 2>&1
  736:     sed 's/^/       /' "$M8LOG"
  737:     check     "m8820x: row failures" \
  738:               "$(grep -oE '[0-9]+ failures' "$M8LOG" | grep -oE '^[0-9]+')" "0"
  739:     check_min "m8820x: rows actually run" \
  740:               "$(grep -oE '^[0-9]+ rows' "$M8LOG" | grep -oE '^[0-9]+')" 25
  741:     check     "m8820x: offline verdict" "$(grep -c 'DIFF_M8820X_PASS' "$M8LOG")" "1"
  742:     #  The whole-window sweep, and the harness-fault rows that keep its number honest.
  743:     check "m8820x: the whole-window sweep rows are present" \
  744:           "$(grep -cE 'kills the host' "$M8LOG")" "2"
  745:     check "m8820x: the harness-fault rows are present" \
  746:           "$(grep -c 'harness faults' "$M8LOG")" "2"
  747:     #  The latches -- plural, and that is the point.  There are TWO independent flags
  748:     #  (reported_offset and reported_command), and for a while only the first had a row:
  749:     #  the command control issues ONE command, and one command complains exactly once
  750:     #  whether the flag is latched or not.  Both must be present, or the gate greens an
  751:     #  unlatched command path -- a guest-drivable stderr flood on a path a real boot
  752:     #  exercises 640,016 times per boot.
  753:     check "m8820x: BOTH latch rows are present (offset and command)" \
  754:           "$(grep -c 'complain exactly once' "$M8LOG")" "2"
  755:     #  THE ROW THAT DEFENDS THE FOLD.  Without the folded PATC flushes, this round's own
  756:     #  complain-and-continue would have turned FLUSH_SUPER_LINE into a silently ignored TLB
  757:     #  flush -- a defect worse than the crash it removed.  Checked white-box, plus its control.
  758:     check "m8820x: the PATC-invalidation row is present" \
  759:           "$(grep -c 'folded PATC flushes invalidate' "$M8LOG")" "1"
  760:     check "m8820x: both fold controls are present" \
  761:           "$(grep -cE 'CONTROL: an undefined command|CONTROL: a CACHE command' "$M8LOG")" "2"
  762:     #  Values, not survival (rounds 79/80).
  763:     check "m8820x: the seeded-IDR value rows are present" \
  764:           "$(grep -c 'seeded 88200 rev-9 id\|does not corrupt it' "$M8LOG")" "2"
  765:     #  The rows PASS 2 forced.  D1 seeds ONE entry at the flushed address, so it can only
  766:     #  show that a MATCHING entry goes away -- eleven of twenty-one mutants survived it,
  767:     #  the cheapest being ONE DELETED CHARACTER (`!all` -> `all`) that turns every
  768:     #  FLUSH_*_ALL into a single-page flush: the exact under-invalidating TLB this round
  769:     #  exists to prevent.  D3-D6 seed a SPREAD and assert which entries SURVIVE.
  770:     check "m8820x: the flush-scope rows are present"           "$(grep -cE 'drops exactly one entry|drops every supervisor entry|leaves every supervisor entry|drops at least what a PAGE flush|drops every user entry' "$M8LOG")" "5"
  771:     #  D7 uses a counter that was already in the file and never asserted on: clearing the
  772:     #  PATC while leaving the emulator's OWN translation cache is the same failure by
  773:     #  another route.
  774:     check "m8820x: the dyntrans-purge row and its control are present"           "$(grep -cE "purges the emulator's own cache|a cache command purges nothing" "$M8LOG")" "2"
  775:     #  D9/D10 are coupled: if a guest could store to SSR it could set the V bit, and then a
  776:     #  dropped PROBE would read back a plausible-looking VALID translation instead of a
  777:     #  deterministic miss -- which is the command arm's own stated argument.
  778:     check "m8820x: the write-is-dropped rows are present"           "$(grep -cE 'dropped, not stored|cannot fake a valid translation' "$M8LOG")" "2"
  779:     check "m8820x: the identity row is present" \
  780:           "$(grep -c 'IDENTITY row count' "$M8LOG")" "1"
  781: fi
  782: 
  783: #  #434 -- a guest READ of six CMMU registers purged the whole translation cache.
  784: #
  785: #  THE ROWS THAT MATTER HERE ARE THE ARGUMENT ROWS, and that is not a stylistic
  786: #  preference.  A measuring seat built the one-identifier mutant
  787: #  INVALIDATE_ALL -> INVALIDATE_VADDR as a real emulator and BOOTED THE luna88k RIG
  788: #  WITH IT: 1:1:1 to `login:`, no diagnostics.  The purge is gutted to virtual page
  789: #  0 -- under-invalidation, the dangerous direction -- while the CALL COUNT stays
  790: #  bit-identical.  A count-based offline row cannot catch it, and THAT THREE-RUN
  791: #  BOOT-TO-LOGIN TRIAL did not; a different workload or assertion on the same rig
  792: #  might.  The likely masking mechanism is that the guest issues ~603,000 SCR
  793: #  flushes per boot, each doing its own INVALIDATE_ALL -- BELIEVED, since a
  794: #  successful boot alongside a plausible mechanism is not established attribution.
  795: #  ARGUMENT-INSPECTING ROWS are what catch it, F1 AND F2 both, which is why the
  796: #  named checks below pin the ARGUMENT rows and the cpu/cmmu rows and not the
  797: #  totals.
  798: #
  799: #  *** THESE THREE SENTENCES WERE RETRACTED IN diff_m8invread.c AND SURVIVED HERE
  800: #  VERBATIM FOR ONE PASS. ***  A pass-2 seat grepped and found each phrase alive in
  801: #  exactly one file -- this one.  That is the project's own "when correcting a
  802: #  claim, grep for its siblings" rule failing on its first application, in the very
  803: #  round that wrote the corrections.  A retraction that lives in one file is half a
  804: #  retraction.
  805: IVBIN=$LOGDIR/diff_m8invread
  806: IVLOG=$LOGDIR/diff_m8invread.log
  807: #  WHICH FLAGS ARE ACTUALLY LOAD-BEARING, ABLATED ONE AT A TIME RATHER THAN ASSUMED.
  808: #  The first version of this comment said "-I$SEC/src and -lm are BOTH load-bearing";
  809: #  a pass-2 seat compiled all four variants and measured:
  810: #      -I"$SEC/src"          LOAD-BEARING -- without it, `fatal error: include/misc.h`
  811: #      -Wl,--gc-sections     LOAD-BEARING -- without it, `undefined reference to
  812: #                            memory_device_register` from DEVINIT(m8820x).  It was NOT
  813: #                            named, which is the worst case: the one nobody knew about.
  814: #      -lm                   NOT load-bearing -- links and passes 21/21 without it.
  815: #  The command was right and the explanation was wrong, which is the failure mode a
  816: #  comment has that code does not.  Fitting, since this block's whole point is a lesson
  817: #  about copying a neighbouring block: it was copied from the SH-4 TMU block, whose
  818: #  differential includes nothing from src/, and the gate caught THAT loudly -- a compile
  819: #  failure is a FAIL here, never a skip.
  820: if ! $CC -O2 -std=c99 -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE         -I"$SEC/src" -I"$SEC/src/include" -I"$SEC/src/include/thirdparty"         -ffunction-sections -fdata-sections -Wl,--gc-sections         -o "$IVBIN" "$HERE/diff_m8invread.c" -lm > "$IVLOG" 2>&1; then
  821:     note "m8invread differential compile failed:"; sed 's/^/       /' "$IVLOG" | head -12
  822:     check "m8invread: compiles against the real dev_m8820x.c" "no" "yes"
  823: else
  824:     check "m8invread: compiles against the real dev_m8820x.c" "yes" "yes"
  825:     "$IVBIN" > "$IVLOG" 2>&1
  826:     sed 's/^/       /' "$IVLOG"
  827:     check     "m8invread: row failures"               "$(grep -oE '[0-9]+ failures' "$IVLOG" | grep -oE '^[0-9]+')" "0"
  828:     check_min "m8invread: rows actually run"               "$(grep -oE '^[0-9]+ rows' "$IVLOG" | grep -oE '^[0-9]+')" 27
  829:     check     "m8invread: offline verdict" "$(grep -c 'DIFF_M8INVREAD_PASS' "$IVLOG")" "1"
  830:     #  The defect row and its per-register twin: an aggregate alone misses a mutant
  831:     #  that moves a purge between registers, which a seat named explicitly.
  832:     check "m8invread: the read-side rows are present"           "$(grep -cE '^  (ok|FAIL) +(E1|E2) ' "$IVLOG")" "2"
  833:     #  THE ARGUMENT ROWS.  See the comment above -- these are the only defence
  834:     #  against a mutant that keeps the count and guts the flags.
  835:     check "m8invread: the purge-ARGUMENT rows are present"           "$(grep -cE '^  (ok|FAIL) +(F1|F2|F3) ' "$IVLOG")" "3"
  836:     #  The two-cpu row.  repro_m8invread.c and diff_m8820x.c are both single-cpu and
  837:     #  are structurally blind to the wrong-receiver mutant; this row is not.
  838:     check "m8invread: the two-cpu receiver rows are present"           "$(grep -cE '^  (ok|FAIL) +(G1|G2) ' "$IVLOG")" "2"
  839:     #  G3/G4/G5 and E10, all four from mutants a pass-2 seat BUILT AND RAN against the
  840:     #  17-row version.  Three survived it: a read purge gated on the register's VALUE
  841:     #  (which restores HALF the removed purges and boots the rig 1:1:1), the same
  842:     #  one-identifier swap applied to the REGS pointer rather than the callback receiver,
  843:     #  and cmmu[d->cmmu_nr] -> cmmu[0].  All three were invisible because the fixture had
  844:     #  ONE cmmu object, cmmu_nr always 0, and a memset-zero register file on every read.
  845:     check "m8invread: the register-file and second-cmmu rows are present"           "$(grep -cE '^  (ok|FAIL) +(G3|G4|G5) ' "$IVLOG")" "3"
  846:     check "m8invread: the nonzero-READ row is present"           "$(grep -cE '^  (ok|FAIL) +(E10) ' "$IVLOG")" "1"
  847:     #  Idempotency: the brace-drop mutant makes a READ zero the register, and only a
  848:     #  SECOND read can see it because odata is snapshotted before the switch.
  849:     check "m8invread: the idempotency and read-back rows are present"           "$(grep -cE '^  (ok|FAIL) +(E7|E8) ' "$IVLOG")" "2"
  850:     #  E9, and it is NOT redundant with E8.  A pass-2 seat appended ONE token to the
  851:     #  production condition -- `&& idata` -- and it survived all sixteen rows: a zero
  852:     #  write then neither purges nor stores, so writing 0 to a previously nonzero SAPR
  853:     #  silently fails to disable that context.  Every other write row used nonzero data,
  854:     #  and E8's single zero goes to a register fresh() had already zeroed, so it was
  855:     #  never a TRANSITION.  A value table that merely CONTAINS zero proves nothing.
  856:     #  *** THE TITLE THIS GREPPED FOR NO LONGER EXISTS, AND THAT IS THE POINT. ***
  857:     #  It was 'nonzero->ZERO write still purges once'.  #435 SPLIT that row, because it
  858:     #  welded two properties together -- "still purges once AND still stores" -- and the
  859:     #  split moved one half and not the other.  A presence check keyed to a title is a
  860:     #  string dependency on a file it does not own, so a legitimate row edit reddens the
  861:     #  gate on a PRESENCE check while the row itself is fine.  This project has hit that
  862:     #  shape before under the name "the padded-column grep trap"; a pass-2 seat named it
  863:     #  again here, in advance, which is the only reason the gate and the row moved in the
  864:     #  same commit.  Both halves are required, so a future edit cannot quietly drop one.
  865:     #  ANCHORED ON THE ROW IDENTIFIERS, not on prose.  The first version of this check
  866:     #  grepped 'purges exactly as much as it owes' and expected 3 -- which worked only
  867:     #  because that phrase ALSO matches E4, so the count was two real rows plus an
  868:     #  accident.  A pass-2 seat pointed out that this is exactly the title-string
  869:     #  dependency the comment above criticises, committed in the same edit that
  870:     #  criticised it.  E9a/E9b are stable identifiers; the prose can now be reworded
  871:     #  without reddening a presence check.
  872:     check "m8invread: BOTH halves of the nonzero->zero row are present"           "$(grep -cE '^  (ok|FAIL) +E9[ab] ' "$IVLOG")" "2"
  873:     #  F4 is #435's one genuinely new row: purge-only-on-change is the likeliest mutant to
  874:     #  be written by accident, because the BATC arm does exactly that thirty lines away.
  875:     #  G6-G9.  #435 created a SECOND store site, and G1-G5 all drive CMMU_SAPR, which the
  876:     #  split left in the OTHER arm -- so the new arm had ZERO owner/cmmu coverage, and every
  877:     #  purge-asserting row ran with both selectors at 0 because fresh() memsets dev.  A
  878:     #  pass-2 measure seat drove FIVE REAL DEFECTS through that gap, the smallest being one
  879:     #  appended `&& d->cmmu_nr == 0`.  MEASURED: the data CMMU takes 51.9% of all SAR writes
  880:     #  per boot, and a witness driving SAR through the handler shows the WRONG PAGE flushed
  881:     #  and a stale supervisor translation kept.
  882:     #
  883:     #  WHEN A ROUND SPLITS AN ARM, EVERY ROW THAT PINNED A PROPERTY OF THE OLD ARM NOW PINS
  884:     #  IT FOR ONLY ONE HALF.  Re-pinning the rows that go RED is the obvious half; the rows
  885:     #  that stay GREEN while quietly covering less are the half that gets missed.
  886:     check "m8invread: the split-arm selector rows are present" \
  887:           "$(grep -cE '^  (ok|FAIL) +(G6|G7|G8|G9) ' "$IVLOG")" "4"
  888:     check "m8invread: the same-value-write row is present"           "$(grep -cE '^  (ok|FAIL) +(F4) ' "$IVLOG")" "1"
  889:     #  The neighbouring arm, ~603,000 purges/boot: nothing above would notice its loss.
  890:     check "m8invread: the SCR-arm control rows are present"           "$(grep -cE '^  (ok|FAIL) +(H1|H2) ' "$IVLOG")" "2"
  891:     check "m8invread: identity row present"           "$(grep -c 'IDENTITY row count' "$IVLOG")" "1"
  892: fi
  893: 
  894: # ---------------------------------------------------------------------------
  895: #  CAN THESE DETECTORS STILL FAIL?  (#436)
  896: #
  897: #  Gate 3 is the battery's only failability control and it mutates ONE file,
  898: #  src/core/float_emul.c.  Eleven differentials live here; gate 3 names one.  A
  899: #  measuring seat reproduced the consequence: stub check() so it never compares,
  900: #  and 118 rows across five detectors print `ok`, keep their row counts, keep
  901: #  their identity rows, keep their verdict tokens -- and detect NOTHING, with
  902: #  every assertion in this file green.
  903: #
  904: #  The reason was structural, not an oversight in any one row: every assertion in
  905: #  this file grepped the detector's own stdout, and all of that stdout is downstream
  906: #  of the single comparison the stub removes.  They were ONE EQUIVALENCE CLASS, and
  907: #  the stub stepped over all of it at once.
  908: #
  909: #  PAST TENSE ON PURPOSE.  A pass-2 seat pointed out that this sentence was written
  910: #  in the PRESENT tense by the very hunk that falsified it: the five selfmutant_one
  911: #  checks grep the HELPER's output (varied input) and the manifest checks grep the
  912: #  FILESYSTEM, so a handful of this gate's assertions are now outside the class.
  913: #  That is the whole point of adding them, and stating it as a present fact would
  914: #  have made the comment wrong the moment it landed.  Only a check that VARIES THE INPUT and
  915: #  demands the output track it escapes.
  916: #
  917: #  TWO CONTROLS, COVERING DIFFERENT FAILURES, NEITHER SUBSTITUTING FOR THE OTHER:
  918: #    * the in-detector SELFCHECK row (in the .c files) -- feeds check() a
  919: #      mismatch and requires the failure counter to move.  Covers EVERY row in
  920: #      its file against the comparator dying.  Free, no extra compile.
  921: #    * the self-mutants below -- break the code the detector watches and require
  922: #      the NAMED row to catch it.  Covers ONE site against a fixture that has
  923: #      stopped reaching the code.  Measured: the SELFCHECK is blind to a row
  924: #      rewritten to compare the subject against itself; a pinned mutant is not.
  925: #
  926: #  WHAT THIS DOES NOT PROVE, said plainly because the honest scope is the whole
  927: #  point.  A seat stubbed every row EXCEPT the ones each mutant kills and both
  928: #  this gate and the self-mutant stayed green -- 23 of 24 rows inert for timer,
  929: #  25 of 27 for m8invread.  So this is a LIVENESS CONTROL: it proves the detector
  930: #  is not wholly inert and that one named row still fires.  It is not a census
  931: #  and must never be read as "the detector is fine".  Going from 0 to 1 is not
  932: #  false comfort; CALLING 1 "the detector works" is.
  933: selfmutant_one() {   # harness subject stem row-id [extra-cc-flags]
  934:     local h="$1" subj="$2" stem="$3" row="$4" xflags="${5:-}"
  935:     local o="$HERE/selfmutants/$stem.old" n="$HERE/selfmutants/$stem.new"
  936:     if [ ! -f "$o" ] || [ ! -f "$n" ]; then
  937:         check "selfmutant $stem: fragments present" "no" "yes"; return
  938:     fi
  939:     local out
  940:     #  The extra flags are the caller's, because the caller owns the real compile line.
  941:     #  memory_rw needs -fno-optimize-sibling-calls, which THIS FILE calls load-bearing for
  942:     #  the loop-not-recursion row; the helper hardcoded one flag set and so compiled that
  943:     #  harness differently from the battery, which the pristine control arm cannot detect
  944:     #  because both arms are then consistently wrong.
  945:     out=$(SELFMUTANT_EXTRA_FLAGS="$xflags"           python3 "$HERE/selfmutant.py" "$h" "$subj" "$o" "$n" "$row" 2>&1)
  946:     printf '%s\n' "$out" | grep -E '^       ' | sed 's/^/    /'
  947:     #  ASSERT THE OK TOKEN IS PRESENT, never "FAIL is absent": a setup error emits
  948:     #  neither, so a negative form is satisfied by a control that never ran.
  949:     check "selfmutant $stem: the detector still detects, via its named row" \
  950:           "$(printf '%s' "$out" | grep -c 'SELFMUTANT_OK')" "1"
  951: }
  952: #  *** F1: THE SELFCHECK ROW NEEDED A PRESENCE CHECK, AND NOT HAVING ONE WAS THE WORST
  953: #  DEFECT IN THE FIRST VERSION OF THIS ROUND. ***  A pass-2 seat deleted the whole SELFCHECK
  954: #  block from all five detectors and measured: gate 2 stayed PASS at the SAME check count with
  955: #  ZERO red rows, byte-identical to baseline, and all five self-mutants still OK.
  956: #
  957: #  It is unprotected PRECISELY BECAUSE THE BOOKKEEPING IS CORRECT: the row restores `rows`, so
  958: #  it is invisible to the only mechanism this gate has for noticing a deleted row -- the
  959: #  `rows actually run` floor.  A few hundred lines above, this file already says "Name each row
  960: #  that is the SOLE detector of something, so deleting one is a red row rather than a quieter
  961: #  file."  The SELFCHECK row is the sole detector of comparator death in five files and was
  962: #  named nowhere.  The doctrine was written down and then not applied to the next row added.
  963: #
  964: #  *** THE LIST THAT STOOD HERE WAS FIVE HARDCODED NAMES WITH NO MANIFEST BEHIND IT, and it
  965: #  has moved to the end of this file (selfcheck7). ***  It asserted that five detectors ran
  966: #  their sentinel and said NOTHING AT ALL about the other seven differentials, so a
  967: #  differential arriving without a comparator control was declared nowhere -- the same
  968: #  G-with-no-H shape the selfmutant manifest below was written to close, in this same file,
  969: #  a few hundred lines apart.
  970: #
  971: #  IT COULD NOT BE FIXED IN PLACE, AND THE REASON IS A STALE-ARTEFACT TRAP RATHER THAN
  972: #  TIDINESS.  Six of the twelve differentials do not compile or run until several hundred
  973: #  lines further down, and $LOGDIR PERSISTS BETWEEN RUNS: a manifest-driven grep of
  974: #  diff_sh4_tmu.log FROM HERE would read the PREVIOUS run's log and report a sentinel this
  975: #  run never executed.  That is "regenerate before grepping a generated file" wearing
  976: #  different clothes.  The whole control now lives in the SC_COVERED block just above
  977: #  gate_end, where every log is this run's.
  978: 
  979: selfmutant_one diff_timer.c      src/core/timer.c            timer      "NaN"
  980: selfmutant_one diff_memory_rw.c  src/cpus/memory_rw.c        memory_rw  "G1 " "-fno-optimize-sibling-calls"
  981: selfmutant_one diff_footbridge.c src/devices/dev_footbridge.c footbridge "A1 "
  982: selfmutant_one diff_m8820x.c     src/devices/dev_m8820x.c    m8820x     "D3"
  983: selfmutant_one diff_m8invread.c  src/devices/dev_m8820x.c    m8invread  "F1 "
  984: #  #437.  The mutant drops the fflush of the OVERLAY DATA file and KEEPS the fsync --
  985: #  chosen over the obvious whole-function revert for a measured reason: it leaves the
  986: #  fsync count at 2, so any test counting fsync alone stays GREEN, and only the fflush
  987: #  row goes red (1, want 2).  It is also the edit a maintainer might make in good faith,
  988: #  since "fsync already flushes, the fflush is redundant" is the reasoning that produced
  989: #  the original defect -- which diskimage.c:1207-1211 exists to refute.  The --wrap flags
  990: #  are load-bearing here, but NOT in the way -fno-optimize-sibling-calls is for memory_rw,
  991: #  and the difference matters.  memory_rw's flag makes BOTH arms consistently wrong, so the
  992: #  control cannot see it.  Here, omitting the flags makes the pristine arm fail to PASS, so
  993: #  selfmutant.py reports SELFMUTANT_SETUP -- which its own header says is NEVER scored as a
  994: #  detection.  Measured both ways.  The earlier comment asserted the memory_rw shape and
  995: #  taught the wrong hazard class.
  996: selfmutant_one diff_diskimage_sync.c src/disk/diskimage.c   diskimage_sync "overlay: sync flushes+syncs data" "-Wl,--wrap=fsync -Wl,--wrap=fflush"
  997: #  selfmutant6, part 1 of 3.  Both mutants were chosen so that exactly ONE row sees them --
  998: #  measured, 1 of 37 and 1 of 16 -- which is the diskimage_sync criterion: a mutant that
  999: #  reddens five rows proves little beyond "deleting code breaks tests".
 1000: #
 1001: #  diskimage_parse drops `&& !prefix_s` from #418's escape-hatch guard.  THIS IS THE SEVENTH
 1002: #  MUTANT OF #418 PASS 2: a reading seat proposed it, it was executed, and it SURVIVED all 35
 1003: #  rows -- the row it now dies on was added to kill it.  On every rig this project boots the
 1004: #  term genuinely is redundant, because get_default_disk_type_for_machine() returns SCSI for
 1005: #  PMAX/ARC/SGI/LUNA88K/MVME88K, so `sd:` resolves to SCSI either way.  It bites only on an
 1006: #  IDE-default machine -- which is exactly what makes "this term is redundant" a plausible
 1007: #  good-faith edit rather than sabotage.
 1008: #
 1009: #  -std=gnu99 is the memory_rw hazard class, found by reading the compile lines rather than
 1010: #  by being bitten: gate_offline.sh builds this harness with -std=gnu99 while selfmutant.py's
 1011: #  hardcoded CC uses -std=c99, and EXTRA_FLAGS is appended so the trailing one wins.  MEASURED
 1012: #  green BOTH ways, so it is belt-and-braces -- but it makes the control compile what the
 1013: #  battery compiles, which is the entire reason that flag argument exists.
 1014: selfmutant_one diff_diskimage_parse.c src/disk/diskimage.c    diskimage_parse "'sd:' stays SCSI" "-std=gnu99"
 1015: #  wdc_identify zeroes word 6's high byte on the premise that sectors-per-track is an 8-bit
 1016: #  field.  THIS IS THE MUTANT #410 MEASURED SURVIVING AT ALL FIVE OPTIMISATION LEVELS: #409
 1017: #  shipped row_wide_geometry with s=17, so word 6's high byte was permanently zero while the
 1018: #  row's name claimed words 3 AND 6.  The maintainer's premise is false for the reason
 1019: #  dev_wdc.c's own bucket (b) gives -- `-d f:` yields spt 256 and 1280.  Deliberately NOT the
 1020: #  `% 255` revert, which reddens seven rows.
 1021: selfmutant_one diff_wdc_identify.c    src/devices/dev_wdc.c   wdc_identify    "geometry words carry their high byte"
 1022: #  selfmutant6, part 2.  THE I/O AND GEOMETRY DIFFERENTIALS, 79 rows between them.
 1023: #
 1024: #  *** BOTH NEEDED A VERDICT TOKEN BEFORE THEY COULD BE CONTROLLED AT ALL, and that is a
 1025: #  FINDING rather than a chore. ***  selfmutant.py asserts the FAIL token is PRESENT --
 1026: #  never that PASS is absent -- so a differential printing only a row table can be broken
 1027: #  in every row without the helper being able to say so.  diff_diskimage_geom.c printed
 1028: #  DISKIMAGE_GEOM_PASS and NOTHING on failure; diff_diskimage_io.c printed no token in
 1029: #  either direction.  MEASURED with the tokens missing: geom's mutant arm reported
 1030: #  SELFMUTANT_FAIL, "the detector did NOT report a failure", while its named row was in
 1031: #  fact RED -- the helper blaming the detector for an apparatus gap -- and io could not
 1032: #  get past its pristine arm at all (SELFMUTANT_SETUP).
 1033: #
 1034: #  I/O.  The mutant drops the READ-SIDE ZERO-FILL from #416's bound and KEEPS the bound,
 1035: #  so the 43 rows that assert "the access was refused" all stay GREEN and only the two
 1036: #  that assert what happens to the CALLER'S BYTES go red (MEASURED: 45 rows / 0 failures
 1037: #  pristine, 45 / 2 mutant).  Every mutant of the bound ITSELF -- advertised capacity
 1038: #  instead of the backed extent, a start-only bound, dropping `offset < 0` -- reddens four
 1039: #  to six rows across three sections and proves only that deleting a bound breaks the rows
 1040: #  written for it.  diskimage.c:1469-1473 exists to refute this mutant's premise ("we
 1041: #  return failure, so the caller must not look at the buffer"): dev_wdc's read path
 1042: #  discards this function's return value and copies a 32 KB STACK buffer to the guest.
 1043: #  -std=gnu99 is the memory_rw hazard class again -- MEASURED green both ways, supplied so
 1044: #  the lane compiles what the battery compiles rather than something adjacent to it.
 1045: #
 1046: #  The one-row alternative that was measured and NOT taken is recorded in the .why file:
 1047: #  `lendone < (ssize_t)len` -> `lendone <= 0` kills exactly one row, but its kill depends
 1048: #  on RLIMIT_FSIZE producing a genuine PARTIAL write, so on a host that absorbs 0 bytes
 1049: #  instead of 256 the mutant survives and the control goes red for an environmental
 1050: #  reason that reads exactly like a dead detector.  gate_ab's wall-clock oracle in
 1051: #  miniature; determinism was preferred to a one-row pin.
 1052: selfmutant_one diff_diskimage_io.c    src/disk/diskimage.c   diskimage_io   "refused read leaves NO caller bytes" "-std=gnu99"
 1053: #  GEOMETRY.  strtoll -> strtoull at the SPT parse site ONLY; the heads field five lines
 1054: #  above keeps strtoll, which is what makes it a plausible half-done edit rather than a
 1055: #  rewrite.  strtoull applies a leading minus in UNSIGNED arithmetic, so
 1056: #  `-d g16;-18446744073709551615:` folds to spt=1 and is ACCEPTED.  The premise -- "heads
 1057: #  and sectors per track are counts, they cannot be negative, use the unsigned parse" --
 1058: #  is the good-faith kind.  diff_diskimage_geom.c's own FAMILY C note (:605) records that
 1059: #  this passed all 30 rows of that file's previous version.  MEASURED here: 34 rows / 0
 1060: #  failures pristine, 34 / 1 mutant -- one red row, and it is the pinned one.
 1061: #
 1062: #  *** THE EXTRA ARGUMENT IS A SOURCE FILE, NOT A FLAG, AND IT IS A THIRD HAZARD CLASS
 1063: #  THAT NEITHER OF THE TWO ALREADY RECORDED IN THIS FILE COVERS. ***  Alone among these
 1064: #  differentials, geom does NOT #include its subject: the battery compiles it against
 1065: #  "$SEC/src/disk/diskimage.c" as a second translation unit, so the helper must be told to
 1066: #  do the same, and the path must be RELATIVE because it is resolved from the mutant
 1067: #  tree's own regress/ directory.  MEASURED all three ways:
 1068: #    * omitted            -> link error -> SELFMUTANT_SETUP.  The diskimage_sync class:
 1069: #                            the pristine arm cannot PASS, and SETUP is never a detection.
 1070: #    * ABSOLUTE $SEC path -> the PRISTINE subject is compiled into BOTH arms, the mutant
 1071: #                            survives, and the helper prints SELFMUTANT_FAIL -- red, but
 1072: #                            blaming the DETECTOR for an APPARATUS error.  Right colour,
 1073: #                            wrong diagnosis, which is the F5 shape in selfmutant.py's own
 1074: #                            header and the dangerous one of the three.
 1075: #    * RELATIVE path      -> SELFMUTANT_OK.
 1076: selfmutant_one diff_diskimage_geom.c  src/disk/diskimage.c   diskimage_geom "must not fold to 1 in the SPT position" "-std=gnu99 ../src/disk/diskimage.c"
 1077: #  selfmutant6, the last of the five.  ONE CHARACTER: `step <= cnt` -> `step < cnt` in
 1078: #  sh4_timer_tick().  Kills exactly 1 of 16 rows, and it is plausible in good faith --
 1079: #  dev_sh4.c:208-216 says TCNT counts TCOR..0 and underflows AFTER 0, so reading "reaching
 1080: #  zero IS the underflow" gives `<` directly.  That comment exists to refute exactly this,
 1081: #  the same shape as diskimage_sync's "fsync already flushes".
 1082: #
 1083: #  The obvious alternative was BUILT AND RUN rather than reasoned about: `period = tcor[i]
 1084: #  + 1` -> `tcor[i]` DIES BY SIGNAL 8, because the TCOR=0 steady state reaches the `%
 1085: #  period`.  Guard F5 scores that SETUP -- a crash is a FAULT, never a detection.  And
 1086: #  `<=` -> `>=` reddens all 16 rows, the "deleting arithmetic breaks its tests" shape the
 1087: #  .why files warn against.  No extra CC flags: built under both the gate's line and
 1088: #  selfmutant.py's and the outputs are byte-identical.
 1089: selfmutant_one diff_sh4_tmu.c        src/devices/dev_sh4.c       sh4_tmu    "boundary"
 1090: selfmutant_one diff_rtc_range.c      src/devices/dev_rtc.c       rtc_range  "2^32: timer NOT removed"
 1091: #  #537 (owner: fix it, do not re-date): fbpending_bound's lane.  One thing kept it out since #442,
 1092: #  and one thing its call needs.
 1093: #  (1) selfmutant.py reads a verdict only as `<WORD>_PASS'/`<WORD>_FAIL', which this harness's
 1094: #  `FBBOUND_VERDICT=PASS' could never match -- it now prints the house form FBBOUND_PASS/_FAIL, and
 1095: #  the #442 verdict row further down greps that (the fix shape `fbsmlane' named on 2026-08-27).
 1096: #  (2) it is the one harness that links build/ objects instead of compiling standalone, so the
 1097: #  flags carry them.
 1098: #  The -I paths are RELATIVE on purpose: the lane builds in `<mirror>/regress', so ../src/devices
 1099: #  is the MIRROR's copy of dev_footbridge.c -- the mutated one.  An absolute -I to GXEMUL-SEC would
 1100: #  compile the PRISTINE copy in both arms; selfmutant.py's binary-identity check then reports SETUP,
 1101: #  so the row reds rather than lies -- but the lane would never test anything.
 1102: #  The stray line that stood below the rtc_range call since #442, `' ' ') -lm ... -lX11"', opened a
 1103: #  quote that ran to the apostrophe in "run.sh's" six lines later and executed a command named ' '
 1104: #  on every run (`command not found', rc 127; harmless under set -u, but a fragment, not code).
 1105: #  THE PIN IS R3, CASE-QUALIFIED -- not the aggregate R4 #442 added for it.  R4 is `failures == 0`,
 1106: #  VERDICT-EQUIVALENT: blind R3 while tightening R1 and an R4 pin stays OK (Opus seat, #537 pass 2),
 1107: #  certifying only that SOME row kills.  selfmutant.py matches the pin anywhere in the printed line,
 1108: #  so R3's row for one case -- R3 prints once per case -- names exactly one row (codex, #537 F2 pass).
 1109: #  The pin spans the harness's row-name padding (8 spaces): one space fewer and the helper SETUPs,
 1110: #  so drift is loud, not silent (measured, Opus seat, #537 F2 pass:
 1111: #  regress/artifacts/fbsmlane/r537_20260918/opus5_f2/f2pin_SUMMARY.txt).
 1112: selfmutant_one diff_fbpending_bound.c src/devices/dev_footbridge.c fbpending_bound "R3 the reset still owes one interrupt        cats, slowest legal" \
 1113:     "-std=gnu99 -I../src/include -I../src/include/thirdparty -I../src/devices $(find "$SEC/../build/src" -name '*.o' ! -name 'main.o' ! -name 'dev_footbridge.o' 2>/dev/null | sort | tr '\n' ' ') -L/usr/X11R6/lib -lX11"
 1114: 
 1115: #  THE MANIFEST -- the part that stops this being a five-instance fix.
 1116: #
 1117: #  Without it, differential #12 arrives with no control and nobody notices, which
 1118: #  is EXACTLY how R4-R9 added five differentials without once touching gate 3.
 1119: #  Same idiom as run.sh's GATE_MANIFEST: adding a differential means adding a
 1120: #  control or naming it on the exemption list, deliberately.  That is the point.
 1121: #
 1122: #  The exemptions are DATED and NAMED rather than silent.  They are real debt:
 1123: #  each is a differential whose rows could all be inert with this gate green.
 1124: #  Filed as `selfmutant6` -- doing them silently in this round would break the
 1125: #  stopping rule, and leaving them unnamed after writing the helper would repeat
 1126: #  the "grep for its siblings" miss this project keeps making.
 1127: SM_COVERED="timer memory_rw footbridge m8820x m8invread diskimage_sync diskimage_parse wdc_identify diskimage_io diskimage_geom sh4_tmu rtc_range fbpending_bound"
 1128: #  DEADLINES SET BY THE OWNER, 2026-08-17, TIGHTER THAN THE ONES I PROPOSED.  I had picked
 1129: #  Oct/Nov unilaterally; asked, the owner chose a fortnight -- 148 uncovered rows across five
 1130: #  differentials is urgent, not a Q4 item.  Recorded because a deadline nobody chose is a
 1131: #  deadline nobody owns, and this gate goes RED the day after that date (the comparison is a strict
 1132: #  `<`) whether or not the work is done.
 1133: #  fbpending_bound's exemption, dated 2026-09-20, is DISCHARGED by #537 -- its lane runs above.
 1134: #  This paragraph said the SELF-MUTANT LANE "DOES NOT RUN YET" because its pristine arm "does not
 1135: #  emit the PASS token", with the reason left as its own piece of work.  The reason was the token:
 1136: #  the harness printed `FBBOUND_VERDICT=PASS` where selfmutant.py reads `<WORD>_PASS` (found as
 1137: #  `fbsmlane`, 2026-08-27), so no run of it could pass.  The @@SELFCHECK@@ control was always live;
 1138: #  the two catch different failures, which is why the missing one was a real gap.
 1139: #
 1140: #  THE FOUR MUTANTS MEASURED BY HAND against the tracked tree on 2026-08-20, each killed by a named
 1141: #  row -- the lane automates the second one, pinned on the R3 row it is designed to kill (see the
 1142: #  pin's own comment above).  Still a liveness control, as this file says of the whole lane, not a
 1143: #  census:
 1144: #    pre-fix          FAIL R1 x7 and R2 with trough -2147483648 (the overflow itself)
 1145: #    reset to 0       FAIL R3 x7   (R1 stays green -- the bound still works, only the debt)
 1146: #    one callback     FAIL R1 x7
 1147: #    no ceiling       FAIL R1 on the two high-emulated_hz cases; R2 peak 2147483647
 1148: #  The `.old`/`.new`/`.why` fragments are committed and describe exactly that, so the lane is
 1149: #  a wiring job, not a design one.
 1150: SM_EXEMPT="ieee_store:2099-01-01"   # #537: fbpending_bound moved to SM_COVERED
 1151: sm_missing=""
 1152: for f in "$HERE"/diff_*.c; do
 1153:     stem=$(basename "$f" .c); stem=${stem#diff_}
 1154:     #  Match the STEM, not the whole token: exemptions now carry ":date" suffixes, and a
 1155:     #  substring match against the raw string would silently accept a stem that is merely a
 1156:     #  prefix of another one.
 1157:     _found=no
 1158:     for _c in $SM_COVERED; do [ "$_c" = "$stem" ] && _found=yes; done
 1159:     for _e in $SM_EXEMPT; do [ "${_e%%:*}" = "$stem" ] && _found=yes; done
 1160:     [ "$_found" = yes ] || sm_missing="$sm_missing $stem"
 1161: done
 1162: check "selfmutant manifest: every differential is covered or dated-exempt" \
 1163:       "${sm_missing:-none}" "none"
 1164: #  *** F3: THE MANIFEST VERIFIED THE LEDGER, NOT THE WORK. ***  SM_COVERED is a hand-written
 1165: #  string and nothing cross-checked it against the selfmutant_one calls, so a pass-2 seat
 1166: #  measured BOTH directions green: delete a selfmutant_one call and leave SM_COVERED intact ->
 1167: #  GREEN; move a stem from EXEMPT to COVERED, retune the count, write no mutant -> GREEN, with
 1168: #  the gate then PRINTING the paper shrink as evidence.
 1169: #
 1170: #  Same G-vs-H distinction this project already wrote into precommit_check.sh: the manifest was
 1171: #  a G with no H.  It verified that a name appeared in a list, never that work stood behind it.
 1172: sm_unbacked=""
 1173: for _stem in $SM_COVERED; do
 1174:     grep -qE "^selfmutant_one +[^ ]+ +[^ ]+ +$_stem +" "$HERE/gate_offline.sh" \
 1175:         || sm_unbacked="$sm_unbacked $_stem"
 1176: done
 1177: check "selfmutant manifest: every COVERED stem has a real selfmutant_one call" \
 1178:       "${sm_unbacked:-none}" "none"
 1179: #  ieee_store carries a far-future date because GATE 3 covers it -- against TOTAL comparator
 1180: #  death only, and by the vacuity-prone `grep -c PASS == 0` form this helper was written to
 1181: #  avoid, so it is a weaker exemption than it looks.  The other five -- sh4_tmu, wdc_identify,
 1182: #  diskimage_io, diskimage_geom, diskimage_parse -- WERE uncovered debt with real deadlines; all five
 1183: #  were discharged by 6014b7e (2026-08-19).  fbpending_bound, added by #442 the next day, was
 1184: #  discharged by #537, so ieee_store is the only entry left.
 1185: #
 1186: #  DATED ENTRIES, NOT A COUNT.  The first version asserted `wc -w == 6` under a row named
 1187: #  "6, shrinking not growing" -- and a seat measured that SHRINKING IT IS RED (got=5 want=6),
 1188: #  so the pin actively obstructed the thing its own name claimed to want, and the name embedded
 1189: #  the constant so a legitimate shrink would print "the exemption list is 6 ...   5".  A count
 1190: #  pins; a date expires.  Shrinking is now green by construction: there is nothing to retune.
 1191: #  *** A MALFORMED EXEMPTION DATE NEVER EXPIRED, AND IT STILL SATISFIED THE COVERAGE CHECK.
 1192: #  ***  REPRODUCED against the shipped loop, with both controls green (a well-formed past date
 1193: #  DID expire; a well-formed future one did not):
 1194: #
 1195: #      ieee_store            no date at all   -> never expires
 1196: #      ieee_store:2026-8-1   unpadded, 19 days past -> never expires
 1197: #      ieee_store:garbage    not a date       -> never expires
 1198: #
 1199: #  MECHANISM.  `${e##*:}` strips to the LAST colon -- and with NO colon it strips nothing and
 1200: #  returns the whole entry, so `ieee_store` was compared as a date: 's' > '2', false, unexpired.
 1201: #  The `""` arm only catches `stem:` with an empty tail, which is the one malformed case that
 1202: #  was handled.  For the unpadded form the compare is worse than useless: `2026-8-1` against
 1203: #  `2026-08-20` matches through `2026-`, then '8' > '0', so a date 19 days PAST sorts as
 1204: #  FUTURE.  And the coverage check keys on `${e%%:*}` -- the stem -- so the exemption is
 1205: #  honoured throughout.  The teeth of the exempt arm depended on a format NOTHING VALIDATED.
 1206: #
 1207: #  THE FIX IS TO REFUSE, NOT TO GUESS.  A malformed entry is now RED and names itself; it is
 1208: #  never silently treated as unexpired.  A `case` glob rather than a regex, because this runs
 1209: #  under POSIX sh and `[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]` needs no external process.
 1210: #
 1211: #  ONE HELPER FOR BOTH MANIFESTS.  SM_EXEMPT and SC_EXEMPT carried byte-identical loops a few
 1212: #  hundred lines apart, so a fix to one would have left the other -- which is this project's
 1213: #  "grep for the siblings before calling it fixed" rule, and the reason both are converted
 1214: #  here in one edit.
 1215: exempt_expired () {          # exempt_expired <today> <entries...>
 1216:     local today="$1"; shift
 1217:     local out="" e d
 1218:     for e in "$@"; do
 1219:         case "$e" in
 1220:             *:*) ;;
 1221:             *) out="$out $e(NO-DATE)"; continue ;;
 1222:         esac
 1223:         d=${e##*:}
 1224:         case "$d" in
 1225:             [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
 1226:             *) out="$out ${e%%:*}(BAD-DATE:${d:-empty})"; continue ;;
 1227:         esac
 1228:         [ "$d" \< "$today" ] && out="$out ${e%%:*}"
 1229:     done
 1230:     printf '%s' "${out:-none}"
 1231: }
 1232: 
 1233: sm_expired=$(exempt_expired "$(date +%Y-%m-%d)" $SM_EXEMPT)
 1234: check "selfmutant manifest: no exemption is past its dated deadline OR malformed" \
 1235:       "$sm_expired" "none"
 1236: 
 1237: TMUBIN=$LOGDIR/diff_sh4_tmu
 1238: TMULOG=$LOGDIR/diff_sh4_tmu.log
 1239: if ! $CC -O2 -std=c99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 1240:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 1241:         -o "$TMUBIN" "$HERE/diff_sh4_tmu.c" > "$TMULOG" 2>&1; then
 1242:     note "SH-4 TMU differential compile failed:"; sed 's/^/       /' "$TMULOG" | head -12
 1243:     check "SH-4 TMU: compiles against the real dev_sh4.c" "no" "yes"
 1244: else
 1245:     check "SH-4 TMU: compiles against the real dev_sh4.c" "yes" "yes"
 1246:     "$TMUBIN" > "$TMULOG" 2>&1
 1247:     sed 's/^/       /' "$TMULOG"
 1248:     #  Assert the verdict AND the row count. The verdict alone would stay green if the
 1249:     #  table were emptied; a floor on the rows is what stops that.
 1250:     check     "SH-4 TMU: row failures" \
 1251:               "$(grep -oE '[0-9]+ failures' "$TMULOG" | grep -oE '^[0-9]+')" "0"
 1252:     #  Floor raised 16 -> 18: 17 for the UNIE-clear row, 18 once the identity row was
 1253:     #  added and counted itself.  (This comment said "16 -> 17" for half an hour while
 1254:     #  the value below read 18 -- a number matching neither, caught by the ninth review
 1255:     #  seat.  A comment that names a constant goes stale the moment the constant moves.)
 1256:     #  A minimum the current value already
 1257:     #  exceeds is decoration rather than evidence -- the reason #416 raised the diskimage
 1258:     #  I/O floor from 3 to 45.
 1259:     check_min "SH-4 TMU: rows actually run" \
 1260:               "$(grep -oE '^[0-9]+ rows' "$TMULOG" | grep -oE '^[0-9]+')" 18
 1261:     check     "SH-4 TMU: offline verdict" "$(grep -c 'SH4_TMU_PASS' "$TMULOG")" "1"
 1262:     #  #401: the multi-period rows are named because they are the ONLY rows that
 1263:     #  make the modulo mean anything. Four seats independently found that dropping
 1264:     #  `% period` passed all of #400's eleven rows -- none ever reached
 1265:     #  remaining >= period, so the correction itself went untested. Deleting these
 1266:     #  must be visible rather than silent.
 1267:     check     "SH-4 TMU: the multi-period rows are present" \
 1268:               "$(grep -c 'multi-period wrap' "$TMULOG")" "2"
 1269:     #  Named rows, so that deleting one is visible rather than silent.
 1270:     check     "SH-4 TMU: the freeze row is present" \
 1271:               "$(grep -c 'no freeze past 515.4 s' "$TMULOG")" "1"
 1272:     check     "SH-4 TMU: the three-timer row is present" \
 1273:               "$(grep -c 'three timers at once' "$TMULOG")" "1"
 1274:     #  #403: a seat found FOURTEEN wrong implementations that passed the earlier
 1275:     #  table, because gcov showed timer_interrupts_pending[i]++ was NEVER
 1276:     #  EXECUTED -- no row set TCR_UNIE. These three rows are what made deleting
 1277:     #  the increment, wiping TCR with `=`, ignoring TSTR, and a signed compare
 1278:     #  visible. Name them so removing one is loud.
 1279:     check     "SH-4 TMU: the interrupt row is present" \
 1280:               "$(grep -c 'underflow raises one interrupt' "$TMULOG")" "1"
 1281:     #  The OTHER HALF of this harness's own claim.  MEASURED: without this row, deleting
 1282:     #  the `if (d->tcr[i] & TCR_UNIE)` guard at dev_sh4.c:249 left all sixteen rows GREEN.
 1283:     check     "SH-4 TMU: the UNIE-clear row is present" \
 1284:               "$(grep -c 'UNIE clear raises no interrupt' "$TMULOG")" "1"
 1285:     check     "SH-4 TMU: the stopped-timer row is present" \
 1286:               "$(grep -c 'stopped timer' "$TMULOG")" "1"
 1287:     check     "SH-4 TMU: the reset-default row is present" \
 1288:               "$(grep -c 'reset default must not underflow' "$TMULOG")" "1"
 1289: fi
 1290: 
 1291: # ---- #429: the RTC frequency range check ----------------------------------------------
 1292: # *** THIS ROW SAT HELD FOR DAYS ON A RECORDED OBSTACLE THAT WAS MEASURABLY FALSE. ***  The
 1293: # filing said a differential "cannot simply #include the device (it pulls in cpu.h,
 1294: # machine.h, emul.h, device.h)".  FOUR differentials in this very file already do exactly
 1295: # that, and dev_sh4.c -- included by one of them a few hundred lines above -- pulls a strict
 1296: # superset of dev_rtc.c's headers.  The obstacle cost more than the round did.
 1297: #
 1298: # WHAT IT DEFENDS.  #429 shipped with NO detector: nothing under regress/ compiled or even
 1299: # mentioned dev_rtc.c, so reverting the range check whole, or flipping its comparison, was
 1300: # green here.  That is the fifth vacuity class -- a shipped fix whose mutant passes
 1301: # everything.  Measured 2026-08-19: the true pre-#429 revert now fails 4 rows and the
 1302: # flipped comparison fails 5, both on VALUES rather than by crashing.
 1303: # ------------------------------------------------------------------ #442 fbpending
 1304: #  THE FOOTBRIDGE PENDING-INTERRUPT COUNTER, bounded.  Unbounded, it overflowed INT_MAX and
 1305: #  the emulated clock delivered NOTHING for 2^31 further ticks -- reproduced at rung 3 on an
 1306: #  unmodified -E cats, three runs, wrap at ~43 s and a 40 s dead window.
 1307: #
 1308: #  THIS ROW IS A DETECTOR, NOT THE REPRODUCTION, and the distinction is load-bearing here.
 1309: #  It #includes the shipped dev_footbridge.c and calls timer_tickN() directly, which the
 1310: #  witness ladder's mechanical discriminator classes as never-a-reproduction.  The
 1311: #  reproduction is regress/fbpending_drain_probe.py (rung 3) and it is NOT run here.
 1312: #
 1313: #  BOTH SHIP BECAUSE NEITHER ALONE IS ENOUGH -- measured, not assumed:
 1314: #    * the rung-3 probe cannot reach the boundary.  The core delivers at most
 1315: #      TIMER_MAX_CATCHUP * TIMER_BASE_FREQUENCY = 68,157,440 increments per wall second, so
 1316: #      2^31 of them take 31.5 s AT BEST and a gate row cannot spend that.  This harness does
 1317: #      2^31 direct increments in ~4 s.
 1318: #    * a mutant deleting the absolute ceiling (leaving the bound at the timer's own rate)
 1319: #      PASSES the rung-3 probe on every timer and is caught only here, at emulated_hz above
 1320: #      68 MHz -- reachable through the documented -I flag.
 1321: #
 1322: #  It links every object EXCEPT main.o and dev_footbridge.o, so it runs the REAL timer.c and
 1323: #  the REAL footbridge rather than re-implementations.  Measured kills: pre-fix fails R1 x7
 1324: #  and R2 with trough -2147483648 (the overflow itself); reset-to-0 fails R3 x7; a fix applied
 1325: #  to one callback only fails R1 x7; no-ceiling fails R1 on the two high-hz cases and R2 with
 1326: #  peak 2147483647.
 1327: FBBIN=$LOGDIR/diff_fbpending_bound
 1328: FBLOG=$LOGDIR/diff_fbpending_bound.log
 1329: FBOBJS=$(find "$SEC/../build/src" -name '*.o' ! -name 'main.o' ! -name 'dev_footbridge.o' 2>/dev/null | sort)
 1330: if [ -z "$FBOBJS" ]; then
 1331:     note "fbpending bound: no build/ objects -- SKIPPED, not passed"
 1332: else
 1333:     if ! $CC -O2 -std=gnu99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty"             -I"$SEC/src/devices" -o "$FBBIN" "$HERE/diff_fbpending_bound.c"             $FBOBJS -lm -L/usr/X11R6/lib -lX11 > "$FBLOG" 2>&1; then
 1334:         note "fbpending bound compile failed:"; sed 's/^/       /' "$FBLOG" | head -12
 1335:         check "fbpending bound: links against the real timer.c" "no" "yes"
 1336:     else
 1337:         check "fbpending bound: links against the real timer.c" "yes" "yes"
 1338:         #  The depth argument is what turns R2 on.  Without it R2 SKIPS -- and a skipped row
 1339:         #  that reads as a pass is this project's fifth vacuity class, so the count below
 1340:         #  pins that R2 actually ran.
 1341:         "$FBBIN" 2147487744 > "$FBLOG" 2>&1
 1342:         sed 's/^/       /' "$FBLOG" | tail -20
 1343:         check "fbpending bound: offline verdict" "$(grep -c '^FBBOUND_PASS$' "$FBLOG")" "1"
 1344:         check "fbpending bound: R2 actually ran (not SKIPPED)"               "$(grep -c 'R2 no signed overflow.*direct ticks' "$FBLOG")" "1"
 1345:         check_min "fbpending bound: rows actually run"               "$(grep -cE '^  (ok|FAIL) ' "$FBLOG")" 15
 1346:     fi
 1347: fi
 1348: 
 1349: RTCBIN=$LOGDIR/diff_rtc_range
 1350: RTCLOG=$LOGDIR/diff_rtc_range.log
 1351: if ! $CC -O2 -std=gnu99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 1352:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 1353:         -o "$RTCBIN" "$HERE/diff_rtc_range.c" > "$RTCLOG" 2>&1; then
 1354:     note "RTC range differential compile failed:"; sed 's/^/       /' "$RTCLOG" | head -12
 1355:     check "RTC range: compiles against the real dev_rtc.c" "no" "yes"
 1356: else
 1357:     check "RTC range: compiles against the real dev_rtc.c" "yes" "yes"
 1358:     "$RTCBIN" > "$RTCLOG" 2>&1
 1359:     sed 's/^/       /' "$RTCLOG"
 1360:     check     "RTC range: row failures" \
 1361:               "$(grep -oE '[0-9]+ failures' "$RTCLOG" | grep -oE '^[0-9]+')" "0"
 1362:     #  Floor 9 -> 12 -> 17, once per closed escape, and the value is named here on purpose
 1363:     #  (this file records the sh4_tmu comment that said "16 -> 17" while the code read 18):
 1364:     #    9 -> 12  the clamp TARGET was asserted nowhere, so `d->hz = 1;` passed all nine.
 1365:     #    12 -> 17 the threshold was pinned only from ABOVE, and the timer core's own input
 1366:     #             was never read.  Both MEASURED at 12 of 12 green.
 1367:     check_min "RTC range: rows actually run" \
 1368:               "$(grep -oE '^[0-9]+ rows' "$RTCLOG" | grep -oE '^[0-9]+')" 18
 1369:     check     "RTC range: offline verdict" "$(grep -c 'RTC_RANGE_PASS' "$RTCLOG")" "1"
 1370:     #  NAMED ROWS, because each is the SOLE detector of one arm and the row-count floor
 1371:     #  cannot see a deletion that also drops the floor.  -F throughout: the row names carry
 1372:     #  `^`, which is literal here but is a metacharacter one careless quote away.
 1373:     #
 1374:     #  2^32 and 2^63 are the two values MEASURED to turn an ADD into a REMOVE before #429.
 1375:     #  bit31 is the third arm and the quietest: it survives as a NEGATIVE int, which the
 1376:     #  timer core's floor turns into roughly one tick per three years -- the guest asked
 1377:     #  for the fastest rate available and got the slowest.  The zero rows are the CONTROL
 1378:     #  in the other direction: zero is the documented way to stop the timer, so a fix that
 1379:     #  clamped it into something else would be a regression this table must refuse.
 1380:     check     "RTC range: the 2^32 truncation row is present" \
 1381:               "$(grep -c -F '2^32: timer NOT removed' "$RTCLOG")" "1"
 1382:     check     "RTC range: the 2^63 truncation row is present" \
 1383:               "$(grep -c -F '2^63: timer NOT removed' "$RTCLOG")" "1"
 1384:     check     "RTC range: the bit-31 sign row is present" \
 1385:               "$(grep -c -F 'bit31: hz is positive' "$RTCLOG")" "1"
 1386:     check     "RTC range: the zero-keeps-its-meaning rows are present" \
 1387:               "$(grep -c -F 'zero: ' "$RTCLOG")" "2"
 1388:     #  *** THE SOLE DETECTOR OF THE CLAMP TARGET, and the first nine rows did not have it.
 1389:     #  ***  Two panel seats said independently that no row asserts WHAT the clamp produces --
 1390:     #  only that it is nonzero, positive, and did not remove the timer.  MEASURED rather than
 1391:     #  predicted: `d->hz = (int) TIMER_MAX_FREQUENCY;` changed to `d->hz = 1;` passed 9 of 9.
 1392:     #  Deleting these three rows restores that hole, so they are named here.
 1393:     check     "RTC range: the clamp-exactness rows are present" \
 1394:               "$(grep -c -F 'clamped to exactly TIMER_MAX_FREQUENCY' "$RTCLOG")" "3"
 1395:     #  *** THE THRESHOLD WAS PINNED ONLY FROM ABOVE, AND THAT WAS A MEASURED FALSE PASS.
 1396:     #  ***  Until this row the table sampled ONE in-range value (1000), so the bound could
 1397:     #  be moved anywhere in [1000, INT_MAX] undetected.  The measure seat found the cheapest
 1398:     #  form: TIMER_MAX_FREQUENCY -> TIMER_MAX_CATCHUP, ONE IDENTIFIER, and the two macros sit
 1399:     #  two lines apart in timer.h -- 12 of 12 green while every guest rate above 2^20 was
 1400:     #  boosted to INT_MAX, which timer.h:72-77 itself calls unserviceable.
 1401:     check     "RTC range: the threshold is pinned from BELOW" \
 1402:               "$(grep -c -F 'above CATCHUP: passed through, NOT clamped' "$RTCLOG")" "1"
 1403:     check     "RTC range: the boundary value itself is tested" \
 1404:               "$(grep -c -F 'INT_MAX exactly: passed through, not clamped' "$RTCLOG")" "1"
 1405:     #  What the TIMER CORE is told, as opposed to what the device stored.  Deleting
 1406:     #  timer_update_frequency() passed 12 of 12: the detector captured last_timer_hz from the
 1407:     #  start and no row ever read it.
 1408:     check     "RTC range: the timer core's own input is asserted" \
 1409:               "$(grep -c -F 'timer core got' "$RTCLOG")" "2"
 1410:     #  THE CONSTBLIND GUARD.  The three clamp rows READ TIMER_MAX_FREQUENCY, so they are
 1411:     #  green for any value of it; this row asserts the ceiling IS INT_MAX, derived from
 1412:     #  outside timer.h.  Named because deleting it silently restores the blindness -- and
 1413:     #  because five seats voted to DROP the constblind row as "already fixed" while THIS
 1414:     #  file, added after that audit, was a live instance of it.
 1415:     check     "RTC range: the constant-blindness guard is present" \
 1416:               "$(grep -c -F 'ceiling IS INT_MAX' "$RTCLOG")" "1"
 1417: fi
 1418: 
 1419: # ---- #405: the ATA IDENTIFY capacity bytes --------------------------------------
 1420: # Third instance of the same construction (float_emul, dev_sh4, now dev_wdc): the driver
 1421: # stubs the diskimage_* externals and #includes dev_wdc.c, so the function that runs is
 1422: # the one that ships. wdc_initialize_identify_struct() is static, so there is no way to
 1423: # link it without including the file.
 1424: #
 1425: # *** WHY THE NAMED ROWS BELOW ARE THE WHOLE POINT. `% 255` and `& 255` return the SAME
 1426: # byte for every operand below 255, so a table of plausible-looking disk sizes passes on
 1427: # the UNFIXED code -- every disk under 33,423,360 bytes agrees. Each named row puts a
 1428: # specific byte at or past the divergence point. Measured against the shipped defect:
 1429: # the full revert fails 7 rows, and a PARTIAL fix that corrects only the two `>> 8`
 1430: # lines still fails 4 -- which is the case a less careful table would have let through.
 1431: # ***
 1432: WDCBIN=$LOGDIR/diff_wdc_identify
 1433: WDCLOG=$LOGDIR/diff_wdc_identify.log
 1434: if ! $CC -O2 -std=c99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 1435:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 1436:         -o "$WDCBIN" "$HERE/diff_wdc_identify.c" > "$WDCLOG" 2>&1; then
 1437:     note "wdc IDENTIFY differential compile failed:"; sed 's/^/       /' "$WDCLOG" | head -12
 1438:     check "wdc IDENTIFY: compiles against the real dev_wdc.c" "no" "yes"
 1439: else
 1440:     check "wdc IDENTIFY: compiles against the real dev_wdc.c" "yes" "yes"
 1441:     "$WDCBIN" > "$WDCLOG" 2>&1
 1442:     sed 's/^/       /' "$WDCLOG"
 1443:     check     "wdc IDENTIFY: row failures" \
 1444:               "$(grep -oE '[0-9]+ failures' "$WDCLOG" | grep -oE '^[0-9]+')" "0"
 1445:     check_min "wdc IDENTIFY: rows actually run" \
 1446:               "$(grep -oE '^[0-9]+ rows' "$WDCLOG" | grep -oE '^[0-9]+')" 42
 1447:     check     "wdc IDENTIFY: offline verdict" \
 1448:               "$(grep -c 'WDC_IDENTIFY_PASS' "$WDCLOG")" "1"
 1449:     #  The four divergence rows. Deleting any one of them returns the table to the
 1450:     #  vacuous state described above, so each is named rather than merely counted.
 1451:     check     "wdc IDENTIFY: the >>8 threshold row is present" \
 1452:               "$(grep -c 'threshold: >>8 byte reaches 255' "$WDCLOG")" "1"
 1453:     check     "wdc IDENTIFY: the carry row is present" \
 1454:               "$(grep -c 'carry: >>8 wraps into >>16' "$WDCLOG")" "1"
 1455:     check     "wdc IDENTIFY: the >>16 row is present" \
 1456:               "$(grep -c '>>8 accidentally right, >>16 wrong' "$WDCLOG")" "1"
 1457:     check     "wdc IDENTIFY: the >>24 threshold row is present" \
 1458:               "$(grep -c 'threshold: >>24 byte reaches 255' "$WDCLOG")" "1"
 1459:     #  The spec-free oracle. There is no ATA document in this tree, so the absolute
 1460:     #  encoding cannot be cited -- but diskimage_recalc_size() rounds every image up to
 1461:     #  a whole cylinder, so the block must agree with its OWN geometry words. That
 1462:     #  needs no specification at all, and it is what makes the fix defensible here.
 1463:     check     "wdc IDENTIFY: the self-consistency oracle is present" \
 1464:               "$(grep -c 'IDENTIFY agrees with itself' "$WDCLOG")" "1"
 1465:     #  Word 53 is 0x0002 -- asymmetric, so a +0/+1 packing swap is visible. Word 47 is
 1466:     #  0x8080, a byte-swap palindrome, and would have been useless here.
 1467:     check     "wdc IDENTIFY: the packing anchor is present" \
 1468:               "$(grep -c 'packing anchor' "$WDCLOG")" "1"
 1469: 
 1470:     #  #484: THE RING-OCCUPANCY ROWS.  Each is NAMED rather than counted, because
 1471:     #  deleting any one returns the table to a state a measured mutant survives --
 1472:     #  the same reason the four divergence rows above are named.
 1473:     #
 1474:     #  *** THE TWO ANCHORED ROWS ARE NOT INTERCHANGEABLE WITH THE REST. ***  Two
 1475:     #  mutants that keep occupancy SOUND while destroying DATA -- the `return` moved
 1476:     #  inside the warning latch, and drop-oldest -- are GREEN under every
 1477:     #  occupancy-shaped and DRQ-shaped row here.  Only the marker byte at the tail
 1478:     #  cell and the real consumer's FIFO order kill them.  An oracle computed the
 1479:     #  same way as the code under test cannot see an edit that preserves the
 1480:     #  computation -- clause (f) one level down.
 1481:     #
 1482:     #  MEASURED: 9 of these red on the pre-fix device and 0 after, with the two R6
 1483:     #  liveness rows GREEN ON BOTH -- which is what makes the nine reds evidence
 1484:     #  rather than a ring that never worked at all.  Kill table and logs in
 1485:     #  regress/artifacts/wdcringambig/killtable_20260827/.
 1486:     #
 1487:     #  *** -cF, NOT -c, AND THE GATE CAUGHT ME OMITTING IT. ***  The label
 1488:     #  `R2 anchor: inbuf[tail] survives` contains a BRACKET PAIR, which basic grep
 1489:     #  reads as a CHARACTER CLASS -- `inbuf[tail]` matches inbuft / inbufa / inbufi /
 1490:     #  inbufl and never the literal text.  It returned 0 and the gate went red, which
 1491:     #  is the LOUD direction and the safe one.  Had the class happened to match
 1492:     #  something, the row would have read as pinned while pinning nothing.
 1493:     #
 1494:     #  Fixed-string matching for every label in this block: a row NAME is literal
 1495:     #  text, never a pattern.  Same class as this tree's existing `grep -nF` rule.
 1496:     check     "wdc IDENTIFY: the ring liveness control" \
 1497:               "$(grep -cF 'R6 liveness: SIZE-1 all land' "$WDCLOG")" "1"
 1498:     check     "wdc IDENTIFY: the wrap, in the file's own idiom" \
 1499:               "$(grep -cF 'R1 full ring: pointer occupancy' "$WDCLOG")" "1"
 1500:     check     "wdc IDENTIFY: the guest-visible DRQ bit" \
 1501:               "$(grep -cF 'R3 full ring: DRQ still set' "$WDCLOG")" "1"
 1502:     check     "wdc IDENTIFY: ANCHORED -- the tail marker byte" \
 1503:               "$(grep -cF 'R2 anchor: inbuf[tail] survives' "$WDCLOG")" "1"
 1504:     check     "wdc IDENTIFY: ANCHORED -- the consumer's own order" \
 1505:               "$(grep -cF 'R4 fifo: first pop is first push' "$WDCLOG")" "1"
 1506:     check     "wdc IDENTIFY: the disk-image sink" \
 1507:               "$(grep -cF 'R5b sink: no MIS-SEQUENCED sector reaches the image' "$WDCLOG")" "1"
 1508:     check     "wdc IDENTIFY: the BULK arm (defensive; see the fix comment)" \
 1509:               "$(grep -cF 'R7 memcpy arm: the anchor survives' "$WDCLOG")" "1"
 1510:     check     "wdc IDENTIFY: pins the -1 in the bulk bound" \
 1511:               "$(grep -cF 'R8 bulk edge: head never reaches tail' "$WDCLOG")" "1"
 1512: 
 1513:     #  *** R9 IS THE ACCEPT SIDE, AND IT IS A SOLE CARRIER.  THREE SEATS NAMED THE
 1514:     #  SAME ONE-CHARACTER ESCAPE INDEPENDENTLY ON PASS 2. ***  Tightening the bulk
 1515:     #  bound `>` to `>=` refuses a refill that exactly fits, silently shortening the
 1516:     #  transfer -- and it escaped ALL 119 rows, because R8 pins only the REFUSAL side.
 1517:     #  MEASURED with R9 present: 122 rows, exactly 1 failure, and it is this row.
 1518:     #
 1519:     #  A guard is half-tested by showing it refuses what it should; the other half is
 1520:     #  showing it ACCEPTS WHAT IT MUST, which is the half a bound-tightening edit
 1521:     #  escapes.  Same reasoning as the de-escalation clause's accept rows, reached
 1522:     #  from the opposite direction.
 1523:     check     "wdc IDENTIFY: ACCEPT side -- an exactly-fitting refill lands" \
 1524:               "$(grep -cF 'R9 exact fit: the refill is ACCEPTED' "$WDCLOG")" "1"
 1525: 
 1526:     #  *** R10 AND R11 CLOSE AN L2 FLOOR BREACH FOUND ON PASS 2, and all three
 1527:     #  escapes had ONE cause: no row had free >= 512 with to_read >= 2, so the
 1528:     #  MULTIPLIER `* to_read` was unpinned; and no row called wdc__read() TWICE, so
 1529:     #  the bulk arm's latch interaction and its common tail were unpinned. ***
 1530:     #
 1531:     #    M3  `512 * to_read >` -> `512 >`   two tokens, 0 reds of 122, 275 integrity
 1532:     #                                       violations -- clause (d), a bound RELAXED
 1533:     #    M2  break moved inside the latch   0 reds; the SECOND read falls through and
 1534:     #                                       head lands ON tail -- the ambiguity back
 1535:     #    M1  break -> return                0 reds; the completion irq is dropped
 1536:     #
 1537:     #  Each now dies to exactly ONE row, and to a DIFFERENT one.  R11's first cut
 1538:     #  filled the ring to free == 0 and the mutant SURVIVED -- the fall-through then
 1539:     #  takes the byte-wise arm, whose per-byte guard saves it.  A mutant that will not
 1540:     #  die is a RESULT: that one was the row mis-cut, not the target dead.
 1541:     check     "wdc IDENTIFY: the multiplier is pinned (two sectors, one sector of room)" \
 1542:               "$(grep -cF 'R10 multiplier: two sectors into one sector of room is REFUSED' "$WDCLOG")" "1"
 1543:     check     "wdc IDENTIFY: a SECOND refused read keeps the ring unambiguous" \
 1544:               "$(grep -cF 'R11 second refusal: head has NOT landed on tail' "$WDCLOG")" "1"
 1545:     check     "wdc IDENTIFY: a SECOND refused read still reaches the common tail" \
 1546:               "$(grep -cF 'R11 second refusal: the completion irq still reaches the tail' "$WDCLOG")" "1"
 1547: 
 1548:     #  *** #485: ONE ROW, FOUR LEGS, AND FOUR OF SEVEN MUTANTS PASS LEG 1 ENTIRELY. ***
 1549:     #  The round first shipped a two-observable sweep (ABRT, assert-count) over 256
 1550:     #  opcodes.  A seat built five edits that escaped it, and each surviving leg below
 1551:     #  exists because of one of them:
 1552:     #
 1553:     #    M9  delete dev_wdc_access's TAIL TICK      the repro called wdc_command() and
 1554:     #                                               ran the tick BY HAND, so it was blind;
 1555:     #                                               leg 1 drives the real register path
 1556:     #    M4  hoist ONE assert after the switch      reads ABRT+NO-irq 0 and passes a
 1557:     #                                               count oracle, while asserting at
 1558:     #                                               DISPATCH for the three DEFERRED
 1559:     #                                               opcodes -- a spurious completion irq
 1560:     #                                               on every disk write a guest issues.
 1561:     #                                               The silent set is pinned as an
 1562:     #                                               IDENTITY {0x30,0xa0,0xc5}, not a count
 1563:     #    M5  assert moved INSIDE the unimpl latch   only the FIRST unknown command per
 1564:     #                                               device interrupts.  A sweep with one
 1565:     #                                               fresh device per opcode CANNOT see it
 1566:     #    M7  STATUS read stops clearing the field   int_assert is a LEVEL; the tick
 1567:     #                                               re-raises it forever
 1568:     #    M8  SET_FEATURES asserts only on abort     the sweep varies the command byte and
 1569:     #                                               never `precomp`, so its SUCCESS path
 1570:     #                                               never ran.  Input coverage in ONE
 1571:     #                                               dimension is not input coverage
 1572:     #
 1573:     #  Measured: all seven mutants die, and M4/M5/M7/M8 read ABRT+NO-irq 0 -- they pass
 1574:     #  leg 1 and die only to the legs those escapes forced.  Pre-fix the row reads
 1575:     #  ABRT+NO-irq 242, silent 245, 2nd 0.
 1576:     check     "wdc IDENTIFY: a terminated command raises its irq" \
 1577:               "$(grep -cF 'a terminated command raises its irq' "$WDCLOG")" "1"
 1578: 
 1579:     #  #480: THE THREE CALL-SITE ROWS ARE NAMED, BECAUSE THE COUNT PIN IS NOT ENOUGH.
 1580:     #
 1581:     #  This round first DECLINED to name them, reasoning that the detector's own identity
 1582:     #  row (`if (rows != 85)`) already reds the gate on any deletion, so naming would guard
 1583:     #  a shut door -- which the ADDITION LICENCE refuses.  TWO SEATS REFUTED THAT BY
 1584:     #  DIFFERENT ROUTES, and both refutations were then MEASURED:
 1585:     #
 1586:     #    D1_renumber      delete the call AND renumber the pin in the same edit
 1587:     #                     -> 82 rows, 0 failures, WDC_IDENTIFY_PASS
 1588:     #    D2_rowsplusplus  replace `row_rejected_cmd_resets();` with `rows ++;`
 1589:     #                     -> 83 rows, 0 failures, WDC_IDENTIFY_PASS  <- no renumber at all
 1590:     #
 1591:     #  So the count pin binds the row COUNT and not row IDENTITY, and the SOLE CARRIER for
 1592:     #  M4_afterguard could have been removed with this gate staying green.  These three
 1593:     #  checks close exactly that mode.
 1594:     #
 1595:     #  WHAT THEY DO NOT CLOSE, stated because a guard whose scope is overclaimed is worse
 1596:     #  than none: an oracle WEAKENED while keeping its label.  `rows` stays right, the
 1597:     #  label still prints, and these greps still pass.  That remains kill-table territory.
 1598:     check     "wdc IDENTIFY: the same-opcode reissue row is present" \
 1599:               "$(grep -c 'a same-opcode reissue resets the ring' "$WDCLOG")" "1"
 1600:     check     "wdc IDENTIFY: the rejected-command row is present" \
 1601:               "$(grep -c 'a rejected command still resets' "$WDCLOG")" "1"
 1602:     check     "wdc IDENTIFY: the refill-command row is present" \
 1603:               "$(grep -c 'a refill command starts from empty' "$WDCLOG")" "1"
 1604: 
 1605:     #  #481: the ALT-CTRL rows, named for the reason #480 MEASURED rather than assumed.
 1606:     #
 1607:     #  The detector's identity row binds the row COUNT, never row IDENTITY: replacing a
 1608:     #  row's call with `rows ++` keeps the count right, the verdict green and this gate
 1609:     #  passing while a sole carrier vanishes.  Two seats found that independently on #480
 1610:     #  and it was negative-controlled.
 1611:     #
 1612:     #  THIS ROUND HAS TWO SOLE CARRIERS and they are the ones that matter most:
 1613:     #    Md_nohelper (guard kept, abort removed)  -> only `an SRST aborts what was in
 1614:     #                                                flight` reds
 1615:     #    Md_widemask (mask widened to include IDS) -> only `an nIEN write is not a
 1616:     #                                                reset` reds
 1617:     #
 1618:     #  Same honest scope as #480's block: naming closes DELETION and REPLACEMENT.  It
 1619:     #  does NOT close an oracle weakened while keeping its label -- that stays kill-table
 1620:     #  territory, and saying so is what keeps this guard from being overclaimed.
 1621:     check     "wdc IDENTIFY: the SRST-is-a-reset row is present" \
 1622:               "$(grep -c 'a real SRST (0x06) is a reset' "$WDCLOG")" "1"
 1623:     check     "wdc IDENTIFY: the routine-ctl row is present" \
 1624:               "$(grep -c 'a routine 0x08 preserves the command' "$WDCLOG")" "1"
 1625:     check     "wdc IDENTIFY: the nIEN row is present" \
 1626:               "$(grep -c 'an nIEN write is not a reset' "$WDCLOG")" "1"
 1627:     check     "wdc IDENTIFY: the SRST-abort row is present" \
 1628:               "$(grep -c 'an SRST aborts what was in flight' "$WDCLOG")" "1"
 1629:     check     "wdc IDENTIFY: the SRST-signature accept row is present" \
 1630:               "$(grep -c 'a real SRST still signs the CD-ROM' "$WDCLOG")" "1"
 1631: 
 1632:     #  *** THE BLOCK ABOVE NAMED FIVE OF SEVEN ROWS, AND THE TWO IT MISSED WERE BOTH
 1633:     #      CONTROLS.  Found by the opus seat: deleting either kept this gate fully
 1634:     #      green -- which is the precise failure the comment above says naming exists
 1635:     #      to close.  A guard that covers most of its population is not a partial
 1636:     #      guard; it is a guard with an unadvertised hole. ***
 1637:     #
 1638:     #  The two controls are load-bearing, not decoration:
 1639:     #    non-CD-ROM        stops the signature assertion being satisfied by a device
 1640:     #                      that signs unconditionally -- a different defect wearing
 1641:     #                      this one's clothes
 1642:     #    reset-signature   separates "the power-on half is missing" from "the
 1643:     #                      signature is broken" -- two different repairs
 1644:     #
 1645:     #  The last two rows were added after the panel and are sole carriers:
 1646:     #    unreset CD-ROM    SOLE carrier for Mo_sigalways (the reset conjunct dropped
 1647:     #                      at the read site).  The non-CD-ROM control tests the OTHER
 1648:     #                      conjunct, which is why that mutant escaped three checks
 1649:     #    libata SRST form  0x0c differs from OpenBSD's 0x06 in BIT 3, the exact bit
 1650:     #                      this round moved away from
 1651:     check     "wdc IDENTIFY: the non-CD-ROM control is present" \
 1652:               "$(grep -c 'control: a non-CD-ROM does not sign' "$WDCLOG")" "1"
 1653:     check     "wdc IDENTIFY: the reset-signature control is present" \
 1654:               "$(grep -c 'control: the reset signature works' "$WDCLOG")" "1"
 1655:     check     "wdc IDENTIFY: the unreset-CD-ROM row is present" \
 1656:               "$(grep -c 'an unreset CD-ROM does not sign' "$WDCLOG")" "1"
 1657:     check     "wdc IDENTIFY: the libata-SRST-form row is present" \
 1658:               "$(grep -c 'the libata SRST form signs too' "$WDCLOG")" "1"
 1659: 
 1660:     #  #482: THE TENANT-ISOLATION ROWS.  #481's abort row armed the writer, the ATAPI
 1661:     #  flag, the phase AND the ring together, so it could not say WHICH of them the
 1662:     #  guard reads -- and any single-conjunct qualification of the helper call passed
 1663:     #  it.  Each row below arms exactly ONE tenant, and each is a sole or near-sole
 1664:     #  carrier:
 1665:     #    ATA-write-alone   kills the atapi_cmd_in_progress qualification -- SRST
 1666:     #                      otherwise stops aborting a plain ATA write, THE MAJORITY PATH
 1667:     #    packet-alone      kills the write_in_progress qualification            SOLE
 1668:     #    empty-ring        kills the occupancy qualification                    SOLE
 1669:     #    0x88              kills the mask widened with bit 7   (was SOLE; the #483
 1670:     #                      sweep now kills it too, so that SOLE is stale -- corrected
 1671:     #                      here rather than left, since #483 edited nearby lines and
 1672:     #                      did not re-check it)
 1673:     #
 1674:     #  The empty-ring row was MISSED BY THE FIRST DRAFT and found by running the table:
 1675:     #  both other rows stage bytes, so an occupancy-gated guard walked past them.  That
 1676:     #  is this round's own defect one level down, and it is why the row exists.
 1677:     check     "wdc IDENTIFY: the ATA-write-alone row is present" \
 1678:               "$(grep -c 'an SRST aborts an ATA write alone' "$WDCLOG")" "1"
 1679:     check     "wdc IDENTIFY: the packet-alone row is present" \
 1680:               "$(grep -c 'an SRST aborts a packet alone' "$WDCLOG")" "1"
 1681:     check     "wdc IDENTIFY: the empty-ring row is present" \
 1682:               "$(grep -c 'an SRST clears a writer with no bytes' "$WDCLOG")" "1"
 1683:     check     "wdc IDENTIFY: the 0x88-control row is present" \
 1684:               "$(grep -c 'a 0x88 control write is not a reset' "$WDCLOG")" "1"
 1685: 
 1686:     #  #483: the three rows that close what #482 could not see.
 1687:     #    orphan-ring   SOLE carrier for the disjunctive guard BOTH flagship seats built
 1688:     #                  independently -- the repair a maintainer writes after reading
 1689:     #                  #482's rows, which defeats all four of them
 1690:     #    packet-empty  SOLE carrier for the wip-or-occupancy guard.  A PARITY row:
 1691:     #                  #482 built the empty-ring case for the ATA writer and not for
 1692:     #                  the packet, so an occupancy-gated guard walked past everything
 1693:     #    bit-2 ACTS     all 256 control values, asserting BOTH effects -- the latch AND
 1694:     #                   the purge.  SOLE for bit 6, for the too-NARROW direction a point
 1695:     #                   pin cannot see, and for the whole abort-nulling family.
 1696:     #
 1697:     #  *** AN EARLIER VERSION SWEPT ONLY THE LATCH, AND THIS COMMENT CLAIMED IT
 1698:     #      'SUBSUMES the 0x88 point pin'.  THAT WAS MEASURED FALSE. ***  A guard
 1699:     #      qualifying the ABORT alone -- `if (idata & WDCTL_4BIT)` in front of the
 1700:     #      helper -- escaped all 103 rows, and BOTH flagship seats built it
 1701:     #      independently.  It is reachable by REAL DRIVER BEHAVIOUR: 0x04 is the
 1702:     #      canonical soft-reset bit and 0x06 is what this tree's own row documents as
 1703:     #      OpenBSD's, and neither carries bit 3.  A mutant aborting on a high bit
 1704:     #      WITHOUT latching died to the 0x88 row and ESCAPED the sweep -- so the point
 1705:     #      pin was a SOLE CARRIER for something the sweep could not see.
 1706:     #
 1707:     #      THE CLAIM CONFLATED INPUT COVERAGE (the sweep wins, 256 values vs 1) WITH
 1708:     #      ORACLE BREADTH (the point pin won, three observables vs one).  Strengthening
 1709:     #      the sweep to assert both effects MADE THE CLAIM TRUE rather than softening
 1710:     #      it: that mutant now dies to seven rows including this one, diagnosing `h 4`
 1711:     #      -- at value 0x04 it latches without purging, a HALF reset.
 1712:     #
 1713:     #                   The sweep also makes the 0x88 row's appeal to ATA knowledge
 1714:     #                   NON-LOAD-BEARING -- not retired, since that row is kept and its
 1715:     #                   own comment still carries the disclosure.
 1716:     check     "wdc IDENTIFY: the orphan-ring row is present" \
 1717:               "$(grep -c 'an SRST purges an orphan ring' "$WDCLOG")" "1"
 1718:     check     "wdc IDENTIFY: the packet-empty-ring row is present" \
 1719:               "$(grep -c 'an SRST clears a packet with no bytes' "$WDCLOG")" "1"
 1720:     check     "wdc IDENTIFY: the bit-2 ACTS sweep is present" \
 1721:               "$(grep -c 'reset ACTS IFF bit 2 is set' "$WDCLOG")" "1"
 1722:     #  #473: the six DATAIN chunking rows.  ALL EIGHT mutants in that round were killed
 1723:     #  (kill473_table.txt): three clause-(b) reinstatements, four clause-(d) null-repair
 1724:     #  forms and one clause-(c) null medium.  TWO of the (d) mutants escaped the first
 1725:     #  table and are the reason the last two rows exist -- Md_norefill (keep the 32768
 1726:     #  clamp, delete the refill: the guest is told a chunk is ready and the ring is
 1727:     #  EMPTY) and Md_wrongoff (refill from data_in[j], so every chunk returns chunk 0).
 1728:     #  The length row alone passes both, which is why an occupancy oracle and a source-
 1729:     #  offset oracle ship beside it.
 1730:     check     "wdc IDENTIFY: the arm bounds the push is present" \
 1731:               "$(grep -c 'arm: pushes one chunk, not the whole' "$WDCLOG")" "1"
 1732:     check     "wdc IDENTIFY: the arm corruption oracle is present" \
 1733:               "$(grep -c 'arm: block 0 survives the push' "$WDCLOG")" "1"
 1734:     check     "wdc IDENTIFY: the re-arm length row is present" \
 1735:               "$(grep -c 're-arm: >32768 left is not zeroed' "$WDCLOG")" "1"
 1736:     check     "wdc IDENTIFY: the re-arm liveness control is present" \
 1737:               "$(grep -c 're-arm: the branch was actually taken' "$WDCLOG")" "1"
 1738:     check     "wdc IDENTIFY: the re-arm refill row is present" \
 1739:               "$(grep -c 're-arm: the chunk is REFILLED' "$WDCLOG")" "1"
 1740:     check     "wdc IDENTIFY: the re-arm offset row is present" \
 1741:               "$(grep -c 're-arm: refill starts at received' "$WDCLOG")" "1"
 1742:     #  #475: the six wdcoddstep rows.  Kill table 7 killed + 1 measured equivalence.
 1743:     #  TWO of these groups exist ONLY because panel seats named escapes the table did not
 1744:     #  have, and each escape is killed ONLY by its own group:
 1745:     #    `consumed = atapi_len`      sweeps the two end-state rows -> the MID-WALK rows
 1746:     #    `len == 4 && consumed > ..` swept all six then present -> the WIDTH rows, because
 1747:     #                                every other row here issues a four-byte read
 1748:     #  Deleting any one returns the table to a shape a one-token edit escapes.
 1749:     check     "wdc IDENTIFY: the odd-step completion row is present" \
 1750:               "$(grep -c 'odd chunk: the count stops at zero' "$WDCLOG")" "1"
 1751:     check     "wdc IDENTIFY: the odd-step truthfulness row is present" \
 1752:               "$(grep -c 'odd chunk: received never exceeds len' "$WDCLOG")" "1"
 1753:     check     "wdc IDENTIFY: the mid-walk length row is present" \
 1754:               "$(grep -c 'mid-walk: one 4-byte read leaves 33' "$WDCLOG")" "1"
 1755:     check     "wdc IDENTIFY: the mid-walk cursor row is present" \
 1756:               "$(grep -c 'mid-walk: cursor advances by 4' "$WDCLOG")" "1"
 1757:     check     "wdc IDENTIFY: the width length row is present" \
 1758:               "$(grep -c 'width: a 2-byte read of 1 remaining' "$WDCLOG")" "1"
 1759:     check     "wdc IDENTIFY: the width cursor row is present" \
 1760:               "$(grep -c 'width: received stops at data_in_len' "$WDCLOG")" "1"
 1761:     #  #475, second wave: four rows added after a MEASURING seat showed the detector
 1762:     #  was below the vacuity floor.  Each closes something the others cannot see:
 1763:     #    chunk edge  -- `Md5_xferbound` clamps to the TRANSFER remainder instead of the
 1764:     #                  CHUNK remainder.  It is identical on every single-chunk transfer,
 1765:     #                  so it swept all six earlier rows; it diverges only at a boundary.
 1766:     #                  It also showed "odd chunk" was the wrong FRAME -- an EVEN 32768
 1767:     #                  chunk overshoots too, under mixed access widths.
 1768:     #    guest byte  -- the ONLY guest-visible channel here.  CYL_LO/CYL_HI are served
 1769:     #                  from atapi_len, so a negative count reaches the guest as 0xffff.
 1770:     #                  Without it, a fix that repairs completion but leaves the counter
 1771:     #                  negative looks correct.
 1772:     #    zero-length -- READ TOC with allocation length 0 arms DATAIN with a ZERO chunk.
 1773:     #                  A clamp guarded `> 0` rather than `>=` hangs here.
 1774:     check     "wdc IDENTIFY: the chunk-edge re-arm row is present" \
 1775:               "$(grep -c 'chunk edge: the re-arm still fires' "$WDCLOG")" "1"
 1776:     check     "wdc IDENTIFY: the chunk-edge anchor row is present" \
 1777:               "$(grep -c 'chunk edge: chunk 2 starts at 32768' "$WDCLOG")" "1"
 1778:     check     "wdc IDENTIFY: the GUEST-VISIBLE byte-count row is present" \
 1779:               "$(grep -c 'guest byte count is not 0xffff' "$WDCLOG")" "1"
 1780:     check     "wdc IDENTIFY: the zero-length DATAIN row is present" \
 1781:               "$(grep -c 'zero-length DATAIN stays at zero' "$WDCLOG")" "1"
 1782:     #  #476: the host-kill row.  It FORKS, because the defect is a SIGNAL -- an
 1783:     #  in-process oracle would take the differential down with it and report nothing.
 1784:     #  #475 clamped a counter that used to go NEGATIVE; that woke a branch whose
 1785:     #  `d->atapi_st->data_in_len` deref had only ever been protected by the broken
 1786:     #  value.  Two guest register accesses from a fresh device reached it.
 1787:     check     "wdc IDENTIFY: the host-kill row is present" \
 1788:               "$(grep -c 'a DATA read with no transfer survives' "$WDCLOG")" "1"
 1789:     #  #477: the phase rows.  Kill table 6/6; FOUR of the six die on a single
 1790:     #  sole-carrier row.  Two exist only because a measuring seat named the escape:
 1791:     #    `!= PHASE_DATAIN`  passes every DATAIN row -> the DATAOUT and COMPLETED rows
 1792:     #    `& WDCI_CMD`       CMDOUT and COMPLETED both carry that bit, and the seat could
 1793:     #                       NOT kill it -> the COMPLETED row is its sole carrier
 1794:     #  The NO-PUSH row is the one that settles the mechanism: a len-3 write pushes ZERO
 1795:     #  bytes and the dispatch frees the transfer anyway, so the defect was never "writes
 1796:     #  push foreign bytes" -- which is why guarding the pushes measured WORSE than no fix.
 1797:     check     "wdc IDENTIFY: the CDB re-dispatch row is present" \
 1798:               "$(grep -c 'a mid-DATAIN write frees nothing' "$WDCLOG")" "1"
 1799:     check     "wdc IDENTIFY: the NO-PUSH row is present" \
 1800:               "$(grep -c 'no-push write does not dispatch' "$WDCLOG")" "1"
 1801:     check     "wdc IDENTIFY: the DATAOUT phase row is present" \
 1802:               "$(grep -c 'a DATAOUT write does not dispatch' "$WDCLOG")" "1"
 1803:     check     "wdc IDENTIFY: the COMPLETED phase row is present" \
 1804:               "$(grep -c 'a COMPLETED write does not dispatch' "$WDCLOG")" "1"
 1805:     #  #473 pass 2: three rows added AFTER the round shipped, because two more
 1806:     #  clause-(d) mutants escaped a table that had already closed four.  Both hid for
 1807:     #  one structural reason -- every re-arm row sat where the remainder EXCEEDS 32768,
 1808:     #  so `atapi_len` and the constant 32768 were the same number.  Md_emptyguard is
 1809:     #  the round own safety sentence as a predicate; Md5_chunkconst relaxes the refill
 1810:     #  bound to that constant and is a heap-buffer-overflow READ under ASan.
 1811:     check     "wdc IDENTIFY: the dirty-ring row is present" \
 1812:               "$(grep -c 're-arm: refills a NON-EMPTY ring too' "$WDCLOG")" "1"
 1813:     check     "wdc IDENTIFY: the short-last-chunk length row is present" \
 1814:               "$(grep -c 'last chunk: length is the REMAINDER' "$WDCLOG")" "1"
 1815:     check     "wdc IDENTIFY: the refill-bound row is present" \
 1816:               "$(grep -c 'last chunk: refill is BOUNDED by it' "$WDCLOG")" "1"
 1817:     #  #407: two rows added (slave drive, word 49) and row_selfconsistent() widened, after a
 1818:     #  measure seat found three mutants that passed (this comment said "three rows added"
 1819:     #  until the 2026-09-05 retrospective review; the commit message carries the same error)
 1820:     #  the original ten. Each is named because each is the ONLY row that kills its
 1821:     #  mutant -- verified by asserting the row NAME in the kill, not just that
 1822:     #  something failed.
 1823:     #    slave      <- 10 chars: drop `d->drive + ` at dev_wdc.c:179
 1824:     #    word 49    <- 1 char:   advertise LBA that is #if 0'd out
 1825:     #    65535 loop <- 11-bit cylinder truncation, first contradiction at c=2048,
 1826:     #                  which the old c<=2000 bound missed by FORTY-EIGHT
 1827:     check     "wdc IDENTIFY: the slave-drive row is present" \
 1828:               "$(grep -c 'the SLAVE reports its own capacity' "$WDCLOG")" "1"
 1829:     check     "wdc IDENTIFY: the word-49 capability row is present" \
 1830:               "$(grep -c 'no unimplemented capability claimed' "$WDCLOG")" "1"
 1831:     check     "wdc IDENTIFY: the oracle sweeps the full 16-bit range" \
 1832:               "$(grep -c 'of 65535 contradict their geometry' "$WDCLOG")" "1"
 1833:     #  #408: two more named rows, each closing a mutant class that survived the
 1834:     #  twelve. The slave row previously asserted only CAPACITY, so four mutants
 1835:     #  reading drive 0's cylinders/heads/spt went unnoticed; and base_drive -- which
 1836:     #  dev_wdc_init sets to 2 for the SECONDARY controller, so it is live, not
 1837:     #  hypothetical -- was ungated at all three call sites.
 1838:     check     "wdc IDENTIFY: the slave row covers geometry, not just capacity" \
 1839:               "$(grep -c 'the SLAVE reports its own' "$WDCLOG")" "1"
 1840:     check     "wdc IDENTIFY: the base_drive row is present" \
 1841:               "$(grep -c 'base_drive reaches the diskimage id' "$WDCLOG")" "1"
 1842:     #  #409: two further rows, each closing mutants that survived the thirteen.
 1843:     #    identity  <- is_a_cdrom and getname still IGNORED `id`, so four mutants
 1844:     #                 lived. The stub now poisons BY INVERSION: every id except
 1845:     #                 this drive's is a CD-ROM. Pinning ONE specific id does not
 1846:     #                 work -- a wrong id simply misses it and still reads "not a
 1847:     #                 CD-ROM", which is how the first attempt at this row failed.
 1848:     #    wide      <- no fixture pushed heads or spt past 255, so the `>> 8` half
 1849:     #                 of words 3 and 6 was never non-zero and could be replaced by
 1850:     #                 a literal 0 undetected.
 1851:     #  #410: grep a string the row prints WHETHER IT PASSES OR FAILS. The #409
 1852:     #  version matched 'the right id', which appears only in the ok line -- so a
 1853:     #  genuinely FAILING row also reported "not present", turning one red row into
 1854:     #  two and making a failure indistinguishable from a deletion. That is the
 1855:     #  phantom-regression shape this harness's own vacuity taxonomy warns about.
 1856:     check     "wdc IDENTIFY: the identity row is present" \
 1857:               "$(grep -c 'the right id\|not the CD-ROM next to it' "$WDCLOG")" "1"
 1858:     #  #410: the ATAPI branch was DELETABLE with every row green -- #409's
 1859:     #  inverted poison made the drive under test the only non-CD-ROM, so the row
 1860:     #  could observe nothing but the negative answer. This row takes the other
 1861:     #  branch and asserts word 0 == 0x8580.
 1862:     check     "wdc IDENTIFY: the ATAPI-flags row is present" \
 1863:               "$(grep -c 'announces itself as one' "$WDCLOG")" "1"
 1864:     check     "wdc IDENTIFY: the wide-geometry row is present" \
 1865:               "$(grep -c 'high byte' "$WDCLOG")" "1"
 1866: fi
 1867: 
 1868: # ---- #406: the autodev.c generator ----------------------------------------------
 1869: # A prose mention of "DEVINIT" in a comment used to reach the generated C. It cost
 1870: # 358 compiler errors, no binary, gate 1 red and eleven gates skipped -- from one
 1871: # comment line, which is still in the tree DELIBERATELY (rewording it would have
 1872: # made the hardening deletable in silence).
 1873: #
 1874: # The driver runs the REAL generator in a scratch copy, so it cannot drift from
 1875: # what ships, and it carries its own mutant lane. The load-bearing row is the
 1876: # ORDERED NAME LIST, not a character check: measured, the half-fix that keeps
 1877: # noglob but drops the anchor emits 27 extra names of which 26 are DOTLESS --
 1878: # valid C identifiers that a "no bad characters" row waves straight through, and
 1879: # that fail at link time instead of parse time.
 1880: AGLOG=$LOGDIR/diff_autodev_gen.log
 1881: if [ ! -x "$HERE/diff_autodev_gen.sh" ]; then
 1882:     check "autodev generator: driver is executable" "no" "yes"
 1883: else
 1884:     "$HERE/diff_autodev_gen.sh" > "$AGLOG" 2>&1
 1885:     sed 's/^/       /' "$AGLOG"
 1886:     check     "autodev generator: row failures" \
 1887:               "$(grep -oE '[0-9]+ failures' "$AGLOG" | grep -oE '^[0-9]+')" "0"
 1888:     check_min "autodev generator: rows actually run" \
 1889:               "$(grep -oE '^[0-9]+ rows' "$AGLOG" | grep -oE '^[0-9]+')" 8
 1890:     check     "autodev generator: offline verdict" \
 1891:               "$(grep -c 'AUTODEV_GEN_PASS' "$AGLOG")" "1"
 1892:     #  Named rows. The two mutants are what make the ordered-list assertion
 1893:     #  load-bearing rather than decorative, so deleting either must be loud.
 1894:     check     "autodev generator: the ordered devinit list is asserted" \
 1895:               "$(grep -c 'devinit names == the .DEVINIT( declarations, in order' "$AGLOG")" "1"
 1896:     check     "autodev generator: the full-revert mutant is present" \
 1897:               "$(grep -c 'MUTANT killed: full revert' "$AGLOG")" "1"
 1898:     check     "autodev generator: the HALF-FIX mutant is present" \
 1899:               "$(grep -c 'MUTANT killed: noglob only' "$AGLOG")" "1"
 1900:     #  If somebody rewords dev_rs5c313.c:144 the mutant lane stops proving
 1901:     #  anything, so the driver asserts that live input still exists and this row
 1902:     #  makes that assertion visible at gate level too.
 1903:     check     "autodev generator: a live off-anchor mention still exists" \
 1904:               "$(grep -c 'a live off-anchor DEVINIT mention still exists' "$AGLOG")" "1"
 1905:     #  No mutant may SURVIVE. Named separately from the failure count because a
 1906:     #  survivor is a statement about the DETECTOR, not about the generator.
 1907:     check     "autodev generator: no mutant survives" \
 1908:               "$(grep -c 'SURVIVES' "$AGLOG")" "0"
 1909: fi
 1910: 
 1911: # ---- #412: SCSI READ CAPACITY on a zero-block disk -------------------------------
 1912: # `size` is uint64_t and nr_of_logical_blocks is int64_t, so 0 - 1 underflowed and the
 1913: # guest was told the disk holds 4,294,967,296 blocks -- 2 TiB -- rather than that it is
 1914: # empty. Measured both directions before and after: 0xffffffff -> 0x00000000.
 1915: #
 1916: # THIS IS NOT A CORNER CASE TODAY. A separate live defect leaves every `-d gH;S` disk with
 1917: # zero blocks, and such a disk KEEPS its SCSI/IDE type, so it reaches the handler and is told
 1918: # it holds 2 TiB. Measured: a 10 MB image announced as "SCSI DISK id 0, 0 MB (CHS=0,16,63)".
 1919: # (#413 narrowed this from "every floppy": DISKIMAGE_FLOPPY is a WRITE-ONLY type -- no device
 1920: # ever passes it, so a floppy-typed disk never reaches this handler at all. That is a separate
 1921: # filed defect. The row below is unaffected; a 0-byte image IS a reachable zero-block disk.) The "0 KB" on the console is the host-side banner only; the guest is told two
 1922: # terabytes. This guard keeps an empty disk reporting empty however it got that way, and
 1923: # stays correct after that defect is fixed -- which is why its row uses a 0-BYTE IMAGE
 1924: # rather than a floppy. A floppy row would go vacuous the moment the geometry fix lands.
 1925: #
 1926: # The driver carries four further sections, DISABLED, that assert defects still live
 1927: # (short/failed writes reported as success, reads past EOF, and a single WRITE(10) that
 1928: # grew a 10 KB image to 512 MB with status GOOD). Build with -DDISKIMAGE_IO_UNFIXED to
 1929: # see them fail; the round that fixes them deletes the guard.
 1930: #  ---------------------------------------------------------------------------
 1931: #  #437: SYNCHRONIZE CACHE durability.
 1932: #
 1933: #  --wrap=fsync,--wrap=fflush is NOT optional decoration.  The bigger half of #437 is that
 1934: #  an overlaid disk never fsynced the file holding the guest's data, and NO byte comparison
 1935: #  can see that: measured this round, a plain fflush with no fsync leaves the bytes fully
 1936: #  visible to a separate reader after _exit(), because the page cache is the kernel's and
 1937: #  outlives the process.  Only real power loss distinguishes fsync, so the CALL COUNTS are
 1938: #  the evidence.  The flags FAIL CLOSED, which was measured rather than assumed: drop both
 1939: #  and the harness still links but reports 7 rows / 4 failed; drop only --wrap=fflush and it
 1940: #  reports 2 failed.  An earlier version of this comment claimed it would "still pass against
 1941: #  nothing", which is the opposite of the truth and would have taught the next reader to
 1942: #  distrust a red row.
 1943: #
 1944: #  Differential verified BOTH WAYS before this block was written: 7 rows / 0 failed against
 1945: #  the fix, 7 rows / 5 failed against the pre-fix sources taken from git.  The pre-fix arm
 1946: #  had to be built with the detector INSIDE the pre-fix tree: a quoted relative
 1947: #  #include "../src/disk/diskimage.c" resolves against the including file's own directory,
 1948: #  so compiling it from $SEC pulled in the FIXED source and reported a meaningless pass.
 1949: SYNCLOG=$LOGDIR/diff_diskimage_sync.log
 1950: if ! $CC -O2 -std=gnu99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 1951:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 1952:         -Wl,--wrap=fsync -Wl,--wrap=fflush \
 1953:         -o "$LOGDIR/diff_diskimage_sync" "$HERE/diff_diskimage_sync.c" > "$SYNCLOG" 2>&1; then
 1954:     note "diskimage sync differential compile failed:"; sed 's/^/       /' "$SYNCLOG" | head -12
 1955:     check "diskimage sync: compiles against the real diskimage.c" "no" "yes"
 1956: else
 1957:     check "diskimage sync: compiles against the real diskimage.c" "yes" "yes"
 1958:     ( cd "$LOGDIR" && "$LOGDIR/diff_diskimage_sync" ) > "$SYNCLOG" 2>&1
 1959:     sed 's/^/       /' "$SYNCLOG"
 1960:     check     "diskimage sync: row failures" \
 1961:               "$(grep -oE '[0-9]+ failed' "$SYNCLOG" | grep -oE '^[0-9]+')" "0"
 1962:     check_min "diskimage sync: rows actually run" \
 1963:               "$(grep -oE '^ *[0-9]+ rows' "$SYNCLOG" | grep -oE '[0-9]+')" 11
 1964:     #  Each named so that deleting one is VISIBLE rather than silent.  The overlay pair is
 1965:     #  the only evidence for the half of #437 that no byte test can reach.
 1966:     #  The overlay TRACE row NAMES THE FILE rather than counting calls, and it is the only
 1967:     #  row that catches a wrong-file mutant.  Its count-only predecessor let FOUR data-losing
 1968:     #  mutants pass green, so deleting this row must be visible rather than silent.
 1969:     check     "diskimage sync: the overlay file-order trace row is present" \
 1970:               "$(grep -c 'overlay: sync flushes+syncs data, THEN bitmap' "$SYNCLOG")" "1"
 1971:     check     "diskimage sync: the overlay trace is data-then-bitmap" \
 1972:               "$(grep -c 'F(data) S(data) F(bitmap) S(bitmap)' "$SYNCLOG")" "1"
 1973:     #  #437 ORDERING.  The `continue` on a failed overlay-DATA sync is what stops the
 1974:     #  bitmap from claiming blocks whose bytes are not durable, AND what keeps the
 1975:     #  remaining overlays being synced.  MEASURED before these rows existed: the whole
 1976:     #  differential passed 8 rows / 0 failed against the shipped source AND against each
 1977:     #  of `continue` deleted, `continue`->`break` and `continue`->`return 0`.  The rule
 1978:     #  was reasoned and reviewed but UNGATED, and the detector said so in its header.
 1979:     check     "diskimage sync: the ordering row is present" \
 1980:               "$(grep -c 'overlay: failure skips only ITS OWN bitmap' "$SYNCLOG")" "1"
 1981:     #  The VALUE, not merely the name, and it needs TWO overlays to be worth asserting:
 1982:     #  d0 is skipped from its own bitmap onward while d1 is synced in full.  With one
 1983:     #  overlay the three mutants above are indistinguishable -- MEASURED, a single
 1984:     #  -overlay version of this row caught only the deletion.  The regex is anchored
 1985:     #  because a failing run prints the same row name followed by "(want ...)".
 1986:     check     "diskimage sync: a failed data sync skips that bitmap only" \
 1987:               "$(grep -cE 'ITS OWN bitmap +F\(d0\) S\(d0\) F\(d1\) S\(d1\) F\(b1\) S\(b1\)$' "$SYNCLOG")" "1"
 1988:     #  The two rows that keep the one above HONEST, and neither is a discriminator.
 1989:     #  Without the witness, a dead --wrap hook would turn the ordering row red for a
 1990:     #  SETUP reason that reads exactly like a code defect (MEASURED: with the injection
 1991:     #  disabled, BOTH go red together -- that pair is the signature to look for, and a
 1992:     #  lone red on the ordering row is the one that means the CODE changed).  Without
 1993:     #  the disarmed control, "the trace was short" could not be told from "the bitmap is
 1994:     #  never synced at all" -- a mutant this file has already had to catch once.
 1995:     check     "diskimage sync: the injection-fired witness row is present" \
 1996:               "$(grep -c 'overlay: a failed sync reports CHECK CONDITION' "$SYNCLOG")" "1"
 1997:     check     "diskimage sync: the disarmed control row is present" \
 1998:               "$(grep -c 'overlay: control -- disarmed, all files sync' "$SYNCLOG")" "1"
 1999:     #  Without these, the trace rows are satisfied by a fixture that never wrote a byte --
 2000:     #  which is exactly how the first version of this detector passed against four mutants.
 2001:     check     "diskimage sync: the guest-data-arrived rows are present" \
 2002:               "$(grep -c 'actually reached the' "$SYNCLOG")" "2"
 2003:     check     "diskimage sync: the failed-sync status row is present" \
 2004:               "$(grep -c 'nothing open: sync reports CHECK CONDITION' "$SYNCLOG")" "1"
 2005:     #  The buffer-size note is a DIAGNOSTIC, never a row: scoring it would fail the gate on
 2006:     #  drvfs for a filesystem reason unrelated to the code, and a false FAIL costs as much
 2007:     #  as a false pass.  Checked for PRESENCE so the warning cannot be quietly deleted.
 2008:     check     "diskimage sync: the stdio-buffer diagnostic is present" \
 2009:               "$(grep -c 'stdio buffer' "$SYNCLOG")" "1"
 2010: fi
 2011: 
 2012: IOLOG=$LOGDIR/diff_diskimage_io.log
 2013: if ! $CC -O2 -std=gnu99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 2014:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 2015:         -o "$LOGDIR/diff_diskimage_io" "$HERE/diff_diskimage_io.c" > "$IOLOG" 2>&1; then
 2016:     note "diskimage I/O differential compile failed:"; sed 's/^/       /' "$IOLOG" | head -12
 2017:     check "diskimage I/O: compiles against the real diskimage.c" "no" "yes"
 2018: else
 2019:     check "diskimage I/O: compiles against the real diskimage.c" "yes" "yes"
 2020:     "$LOGDIR/diff_diskimage_io" > "$IOLOG" 2>&1
 2021:     sed 's/^/       /' "$IOLOG"
 2022:     check     "diskimage I/O: row failures" \
 2023:               "$(grep -oE '[0-9]+ failures' "$IOLOG" | grep -oE '^[0-9]+')" "0"
 2024:     check     "diskimage I/O: faults" \
 2025:               "$(grep -oE '[0-9]+ faults' "$IOLOG" | grep -oE '^[0-9]+')" "0"
 2026:     #  selfmutant6: the token this differential had never printed in EITHER
 2027:     #  direction.  Without it a detector that dies before its summary line is
 2028:     #  indistinguishable from one that ran clean, and selfmutant.py cannot
 2029:     #  control the file at all -- it asserts the FAIL token is PRESENT, and
 2030:     #  there was none to find.  The geometry block a few hundred lines down has
 2031:     #  carried the equivalent row since #414; this one did not.
 2032:     check     "diskimage I/O: verdict token" \
 2033:               "$(grep -c 'DISKIMAGE_IO_PASS' "$IOLOG")" "1"
 2034:     #  #416: was `>= 3`, written when only three rows ran by default.  The
 2035:     #  guard that hid the other four sections is now gone, so 3 would permit
 2036:     #  28 rows to be deleted silently -- a minimum the current value exceeds
 2037:     #  tenfold is decoration, not evidence.
 2038:     check_min "diskimage I/O: rows actually run" \
 2039:               "$(grep -oE '^[0-9]+ rows' "$IOLOG" | grep -oE '^[0-9]+')" 52
 2040:     #  Named so that deleting the zero-block row is visible rather than silent.
 2041:     check     "diskimage I/O: the zero-block capacity row is present" \
 2042:               "$(grep -c 'zero-block disk does not announce' "$IOLOG")" "1"
 2043: 
 2044:     #  #488: NAMED so that deleting any of these is visible rather than silent -- the
 2045:     #  practice the zero-block row above already establishes.
 2046:     #
 2047:     #  *** grep -cF, NOT grep -c. ***  Several of these labels contain characters a regex
 2048:     #  would eat, and the trap this project has already paid for is that a check which
 2049:     #  CANNOT match reports 0 and reads as a deleted row rather than as a broken check.
 2050:     #
 2051:     #  ROW L, ROW I and ROW W each close a dimension the fixture had held constant --
 2052:     #  layer, iteration and writability.  ROW W is the capped ask-again's single yield and
 2053:     #  is the sharpest of the three: adding `&& d->writable` to the fill guard passed all
 2054:     #  86 rows AND all 149,072 cases of an equivalence sweep, because neither ever opened a
 2055:     #  disk that was not writable.
 2056:     check     "diskimage I/O: the short-read defect row is present" \
 2057:               "$(grep -cF 'short read: caller bytes the read never wrote' "$IOLOG")" "1"
 2058:     check     "diskimage I/O: the tail-destruction row is present" \
 2059:               "$(grep -cF 'short read: base bytes surviving the tail zero-fill' "$IOLOG")" "1"
 2060:     check     "diskimage I/O: ROW P (partial block) is present" \
 2061:               "$(grep -cF 'ROW P partial block: sentinel past the request untouched' "$IOLOG")" "1"
 2062:     check     "diskimage I/O: ROW U (unaligned) is present" \
 2063:               "$(grep -cF 'ROW U unaligned: sentinel past the request untouched' "$IOLOG")" "1"
 2064:     check     "diskimage I/O: ROW Z (empty overlay) is present" \
 2065:               "$(grep -cF 'ROW Z empty overlay: all 512 bytes are zero-filled' "$IOLOG")" "1"
 2066:     check     "diskimage I/O: ROW L (base-layer short) is present" \
 2067:               "$(grep -cF 'ROW L base-layer short: no sentinel survives' "$IOLOG")" "1"
 2068:     check     "diskimage I/O: ROW I (short in iteration 2) is present" \
 2069:               "$(grep -cF 'ROW I short in iteration 2: no sentinel survives' "$IOLOG")" "1"
 2070:     check     "diskimage I/O: ROW W (read-only disk) is present" \
 2071:               "$(grep -cF 'ROW W read-only disk: no sentinel survives' "$IOLOG")" "1"
 2072:     check     "diskimage I/O: ROW T (IDE-typed disk) is present" \
 2073:               "$(grep -cF 'ROW T IDE-typed disk: no sentinel survives' "$IOLOG")" "1"
 2074:     check     "diskimage I/O: ROW S (two shorts, one call) is present" \
 2075:               "$(grep -cF 'ROW S two shorts in one call: no sentinel survives' "$IOLOG")" "1"
 2076: 
 2077:     #  *** THE ROW THAT ACTUALLY FAILS WHEN THE CALLER'S TAIL memset IS DELETED. ***
 2078:     #  A review seat measured the deletion: exactly ONE row reddens, and it is this one,
 2079:     #  in section_boundary().  The neighbouring `READ inside the advertised gap still
 2080:     #  succeeds` row is pinned a few lines below and is STRUCTURALLY BLIND to that
 2081:     #  deletion -- it checks res == 1, which holds either way.  So the gate was pinning
 2082:     #  the insensitive row and leaving the sensitive one deletable in silence.
 2083:     check     "diskimage I/O: the caller-memset-sensitive row is present" \
 2084:               "$(grep -cF 'and is zero-filled' "$IOLOG")" "1"
 2085:     #  #416: the four sections that used to sit behind -DDISKIMAGE_IO_UNFIXED
 2086:     #  now run unconditionally.  Named individually so that re-hiding any of
 2087:     #  them is visible; the grep text appears whether the row passes or fails,
 2088:     #  so a FAILING row cannot read as a MISSING one.
 2089:     check     "diskimage I/O: the past-capacity WRITE rows run by default" \
 2090:               "$(grep -c 'WRITE(10) past capacity' "$IOLOG")" "3"
 2091:     check     "diskimage I/O: the refused-read zero-fill is ASSERTED" \
 2092:               "$(grep -c 'refused read leaves NO caller bytes' "$IOLOG")" "1"
 2093:     #  SECTION G is the boundary.  Without it three separate mutants survive:
 2094:     #  an off-by-one bound, a start-only bound, and a write bounded by
 2095:     #  ADVERTISED capacity rather than the backed extent.
 2096:     check     "diskimage I/O: the gap-write row is present" \
 2097:               "$(grep -c 'WRITE into the advertised gap is refused' "$IOLOG")" "1"
 2098:     check     "diskimage I/O: the run-off-the-end row is present" \
 2099:               "$(grep -c 'running off the end' "$IOLOG")" "1"
 2100:     check     "diskimage I/O: the gap READ still succeeds (the rig images)" \
 2101:               "$(grep -c 'READ inside the advertised gap still succeeds' "$IOLOG")" "1"
 2102: fi
 2103: 
 2104: # ----------------------------------------------------------------------------
 2105: # #414: disk GEOMETRY differential -- diskimage_recalc_size() and the -d gH;S
 2106: # parser, linked against the real diskimage.c.
 2107: #
 2108: # It needs a WRITABLE DIRECTORY because recalc_size() calls stat(): every row
 2109: # creates a real file of an exact size rather than faking the size field, so
 2110: # what is measured is the shipped code path and not a stub of it.  GEOMDIR is
 2111: # how the driver is told where to put them.
 2112: #
 2113: # The row count is asserted, not merely reported.  Two files named
 2114: # diff_diskimage_geom.c existed during development in paths differing only by
 2115: # the case of a parent directory, and the smaller one encoded a design decision
 2116: # that had since been reversed; a run that silently used the wrong one looked
 2117: # exactly like a run that used the right one.
 2118: GEOMLOG=$LOGDIR/diff_diskimage_geom.log
 2119: if ! $CC -O2 -std=gnu99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 2120:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 2121:         -o "$LOGDIR/diff_diskimage_geom" "$HERE/diff_diskimage_geom.c" \
 2122:         "$SEC/src/disk/diskimage.c" > "$GEOMLOG" 2>&1; then
 2123:     note "disk geometry differential compile failed:"; sed 's/^/       /' "$GEOMLOG" | head -12
 2124:     check "disk geometry: compiles against the real diskimage.c" "no" "yes"
 2125: else
 2126:     check "disk geometry: compiles against the real diskimage.c" "yes" "yes"
 2127:     GEOMDIR="$LOGDIR" "$LOGDIR/diff_diskimage_geom" > "$GEOMLOG" 2>&1
 2128:     sed 's/^/       /' "$GEOMLOG"
 2129:     check     "disk geometry: row failures" \
 2130:               "$(grep -oE '[0-9]+ failures' "$GEOMLOG" | grep -oE '^[0-9]+')" "0"
 2131:     check     "disk geometry: verdict token" \
 2132:               "$(grep -c 'DISKIMAGE_GEOM_PASS' "$GEOMLOG")" "1"
 2133:     check_min "disk geometry: rows actually run" \
 2134:               "$(grep -oE '^[0-9]+ rows' "$GEOMLOG" | grep -oE '^[0-9]+')" 34
 2135:     #  Named individually so that DELETING one is visible rather than silent.
 2136:     #  Every one of these closed a mutant that survived all the other rows;
 2137:     #  the grep text is chosen to appear whether the row PASSES OR FAILS, so a
 2138:     #  failing row cannot read as a missing row.
 2139:     check     "disk geometry: the autodetect rows use type UNKNOWN" \
 2140:               "$(grep -c 'autodetect 720 KB\|autodetect 1.2 MB\|autodetect 2.88 MB' "$GEOMLOG")" "3"
 2141:     check     "disk geometry: the zero-byte row guarding #412 is present" \
 2142:               "$(grep -c '0-byte image stays empty' "$GEOMLOG")" "1"
 2143:     check     "disk geometry: the fg prefix row is present" \
 2144:               "$(grep -c 'fg2;9 is honoured through the parser' "$GEOMLOG")" "1"
 2145:     check     "disk geometry: the SPT-position wrap row is present" \
 2146:               "$(grep -c 'wrap in the SPT position' "$GEOMLOG")" "1"
 2147:     #  These four cover regions no earlier row entered at all.  The s:/i:
 2148:     #  pair is the important one: without it the shared cylinder block is
 2149:     #  never reached at the type every primary rig actually uses, and a
 2150:     #  one-condition mutant reinstates the whole defect for those disks.
 2151:     check     "disk geometry: the non-multiple floppy size row is present" \
 2152:               "$(grep -c 'NOT a multiple of 81920' "$GEOMLOG")" "1"
 2153:     check     "disk geometry: the shared block is reached as SCSI and IDE" \
 2154:               "$(grep -c 'reaches the shared cylinder block' "$GEOMLOG")" "2"
 2155:     check     "disk geometry: the unsigned-fold row is present" \
 2156:               "$(grep -c 'must not fold to 1 in the SPT position' "$GEOMLOG")" "1"
 2157: fi
 2158: 
 2159: # ---------------------------------------------------------------------------
 2160: # #418: the `-d` PREFIX PARSER differential.  Offline, no binary, no guest.
 2161: #
 2162: # `d:` is documented as the escape hatch out of the size heuristic, but nothing
 2163: # acted on it, so a floppy-sized image stayed DISKIMAGE_FLOPPY -- a type NO
 2164: # controller ever passes -- and the guest got no disk at all.
 2165: #
 2166: # WHY THE [SIZE] ROWS BELOW ARE NAMED INDIVIDUALLY.  Measured, six variants
 2167: # built and run: a placement in the prefix block ALSO makes `d:` work and is
 2168: # killed by NOTHING ELSE IN THE FILE -- only the four exactness rows fail it,
 2169: # because that placement runs before diskimage_recalc_size() and rounds the
 2170: # advertised capacity up (720K 1440 -> 2016 blocks, +40%).  Delete those four
 2171: # rows and the wrong placement ships green.
 2172: PARSELOG=$LOGDIR/diff_diskimage_parse.log
 2173: if ! $CC -O2 -std=gnu99 -I"$SEC/src/include" -I"$SEC/src/include/thirdparty" \
 2174:         -ffunction-sections -fdata-sections -Wl,--gc-sections \
 2175:         -o "$LOGDIR/diff_diskimage_parse" "$HERE/diff_diskimage_parse.c" > "$PARSELOG" 2>&1; then
 2176:     note "disk parser differential compile failed:"; sed 's/^/       /' "$PARSELOG" | head -12
 2177:     check "disk parser: compiles against the real diskimage.c" "no" "yes"
 2178: else
 2179:     check "disk parser: compiles against the real diskimage.c" "yes" "yes"
 2180:     "$LOGDIR/diff_diskimage_parse" > "$PARSELOG" 2>&1
 2181:     sed 's/^/       /' "$PARSELOG"
 2182:     check     "disk parser: row failures" \
 2183:               "$(grep -oE '[0-9]+ failures' "$PARSELOG" | grep -oE '^[0-9]+')" "0"
 2184:     #  37 = the 36 the identity row asserts, plus the identity row itself.
 2185:     check_min "disk parser: rows actually run" \
 2186:               "$(grep -oE '^[0-9]+ rows' "$PARSELOG" | grep -oE '^[0-9]+')" 37
 2187:     check     "disk parser: the identity row is present" \
 2188:               "$(grep -c 'row count -- guards against a stale copy' "$PARSELOG")" "1"
 2189:     #  The grep text appears whether a row PASSES OR FAILS, so a failing row
 2190:     #  cannot read as a missing row.  Each of these closed a mutant that
 2191:     #  survived every other row in the file.
 2192:     check     "disk parser: all four exactness rows are present" \
 2193:               "$(grep -c 'advertised blocks exact' "$PARSELOG")" "4"
 2194:     check     "disk parser: the IDE-default rows are present" \
 2195:               "$(grep -c 'on IDE-default -> IDE\|exists as IDE (dev_wdc)\|NOT visible as SCSI' "$PARSELOG")" "3"
 2196:     #  The 'sd:' row is the SEVENTH mutant's ONLY kill: deleting `&& !prefix_s`
 2197:     #  survives every other row in the file, because `sd:` on a SCSI-default
 2198:     #  machine changes SCSI to SCSI.  It has to run on an IDE-default machine,
 2199:     #  and it has to be named here or deleting it is silent.
 2200:     check     "disk parser: the explicit-prefix precedence rows are present" \
 2201:               "$(grep -c "'fd:' stays FLOPPY\|'id:' stays IDE\|'sd:' stays SCSI" "$PARSELOG")" "3"
 2202:     check     "disk parser: the d:*.iso rows are present" \
 2203:               "$(grep -c 'd:\*.iso is not a CD-ROM\|d:\*.iso is writable' "$PARSELOG")" "2"
 2204:     #  Records, not endorsements: both pin defects this round did NOT fix, so
 2205:     #  the round that does fix them cannot land silently.
 2206:     check     "disk parser: the bare-floppy unreachability records are present" \
 2207:               "$(grep -c 'unreachable by dev_asc' "$PARSELOG")" "4"
 2208:     check     "disk parser: the FLOPPY-typed-ISO record is present" \
 2209:               "$(grep -c 'is FLOPPY-typed (filed defect)' "$PARSELOG")" "1"
 2210: fi
 2211: 
 2212: # ---------------------------------------------------------------------------
 2213: #  THE SELFCHECK MANIFEST (selfcheck7).  The SECOND failability control, brought up to the
 2214: #  standard the self-mutant manifest above already reached.
 2215: #
 2216: #  The two controls cover DIFFERENT failures and neither substitutes for the other; the long
 2217: #  form is at the head of the selfmutant section.  In one line each: the self-mutant breaks
 2218: #  the SUBJECT and demands a NAMED row notice, so it catches a fixture that has stopped
 2219: #  reaching the code; the @@SELFCHECK@@ sentinel breaks nothing and feeds the detector's OWN
 2220: #  comparator a deliberate mismatch, so it catches a comparator edited into always-passing --
 2221: #  a state in which every row prints `ok`, and the row count, the identity row and the verdict
 2222: #  token ALL SURVIVE, so the self-mutant and every other assertion here stay green.
 2223: #
 2224: #  WHY IT IS HERE AND NOT BESIDE ITS SIBLING: three of the four assertions read the
 2225: #  FILESYSTEM and could live anywhere, but the fourth reads each differential's LOG, and six
 2226: #  of the twelve do not run until after the selfmutant block.  $LOGDIR persists between runs,
 2227: #  so asserting it there would grade the previous run's logs.
 2228: #
 2229: #  *** THE THIRD ASSERTION IS THE H, AND IT IS THE WHOLE POINT OF THE ROUND. ***  A name in
 2230: #  SC_COVERED is a LEDGER ENTRY; sc_unbacked greps the differential's OWN SOURCE for a real
 2231: #  @@SELFCHECK@@ block, so moving a stem from EXEMPT to COVERED and writing no sentinel is
 2232: #  RED.  Without it this would be another G -- a check that a name appears in a list -- which
 2233: #  is precisely the defect being corrected here.
 2234: SC_COVERED="timer memory_rw footbridge m8820x m8invread diskimage_sync diskimage_parse diskimage_io diskimage_geom sh4_tmu rtc_range fbpending_bound"
 2235: #  *** COVERED IS NOT UNIFORM, AND THE MANIFEST CANNOT SEE THE DIFFERENCE -- READ THIS BEFORE
 2236: #  TREATING A GREEN ROW AS "the file is vouched for". ***  All but three of the COVERED stems
 2237: #  route every row through one or two shared helpers, so the sentinel covers the file.  The
 2238: #  count used to be spelled out here as "seven of the ten" and went stale the first time a
 2239: #  stem was added; a proportion that has to be re-derived on every addition is a comment that
 2240: #  will be wrong more often than right, so it is stated as an exception list instead.  The
 2241: #  three that do NOT route through shared helpers:
 2242: #    * sh4_tmu   -- 12 of 18 rows.  row1() is the only comparator in the file that takes an
 2243: #                   expected value; row_three_timers/row_interrupt/row_interrupt_unie_clear/
 2244: #                   row_stopped/row_no_freeze each hardcode their own, and cannot be probed.
 2245: #    * geom      -- every row but the identity row, via BOTH geom() and parse(), which are
 2246: #                   two separate comparators and are probed separately for that reason.
 2247: #    * sync      -- both checks() and checkn(), for the same reason.
 2248: #  rtc_range is in the UNIFORM group: every row goes through chk(), its single comparator.
 2249: #  Named here rather than left to be re-derived, because the three-file exception list above
 2250: #  is only trustworthy if additions are classified as they arrive.
 2251: #  The per-file comments carry the scope; this is a LIVENESS control, never a census, and
 2252: #  "going from 0 to 1 is not false comfort; calling 1 `the detector works` is".
 2253: #
 2254: #  THE EXEMPTIONS, DATED AND REASONED.  A FORTNIGHT, matching the deadline the owner chose
 2255: #  over the Q4 one I proposed for the selfmutant list: 2 uncovered differentials, 1311 and 766
 2256: #  lines, whose every row could be inert with this gate green.
 2257: #
 2258: #    ieee_store    HAS NO COMPARATOR TO SENTINEL.  No check(), no `rows`, no `failures`: each
 2259: #                  section carries its own counter (abs_bad, rm_rn_bad, rm_rz_bad, rm_d_bad,
 2260: #                  rm_vec_bad, interp_bad) with the comparison written inline dozens of times,
 2261: #                  and this gate greps one summary line per counter for 0.  There is no single
 2262: #                  point to feed a mismatch to.  A probe through a comparator NO REAL ROW USES
 2263: #                  would prove nothing while reading exactly like coverage, so none was
 2264: #                  written -- a forced control is worse than none.  Gate 3 does cover this file
 2265: #                  against TOTAL comparator death, which is this control's own failure mode,
 2266: #                  but by the vacuity-prone `grep -c PASS == 0` form its SM_EXEMPT comment
 2267: #                  already flags, so it is a weaker cover than it looks.
 2268: #    wdc_identify  NOTHING TO FEED A MISMATCH TO.  Read every row function: row_anchor,
 2269: #                  row_slave, row_base_drive, row_identity, row_atapi_flags, row_wide_geometry,
 2270: #                  row_no_lba_claim and row_selfconsistent are ZERO-ARGUMENT with the expected
 2271: #                  value hardcoded in the body, and row(why, sectors) derives its expectation
 2272: #                  FROM ITS INPUT (`got57 != sectors`), so changing the input changes the
 2273: #                  answer too and no mismatch can be produced.  Injecting one means mutating
 2274: #                  dev_wdc.c -- which is the OTHER control, already present.  This one needs
 2275: #                  the nine row functions refactored onto a shared helper first: a round, not
 2276: #                  a line.
 2277: #  RE-DATED 2026-09-18 BY OWNER RULING, from 2026-09-02 -- a date that passed with no owner row: the
 2278: #  "no exemption is past its dated deadline" row below went RED on every run from 2026-09-03, and the
 2279: #  first run to OBSERVE it was 2026-09-18, the weekly battery having been disabled.  A re-date is not a
 2280: #  discharge: both reasons above stand unchanged, and this list's SM twin was ruled the other way
 2281: #  ("fix it, do not re-date", #537).  The comparison is a strict `<`, so these are valid ON 2026-09-27
 2282: #  and RED from 2026-09-28.  Owner row: `scexempt` -- discharge, re-decide or delete before then.
 2283: SC_EXEMPT="ieee_store:2026-09-27 wdc_identify:2026-09-27"
 2284: 
 2285: sc_missing=""
 2286: for f in "$HERE"/diff_*.c; do
 2287:     stem=$(basename "$f" .c); stem=${stem#diff_}
 2288:     #  Match the STEM, not the whole token -- exemptions carry ":date" suffixes, and a
 2289:     #  substring match would silently accept a stem that is merely a prefix of another.
 2290:     _found=no
 2291:     for _c in $SC_COVERED; do [ "$_c" = "$stem" ] && _found=yes; done
 2292:     for _e in $SC_EXEMPT; do [ "${_e%%:*}" = "$stem" ] && _found=yes; done
 2293:     [ "$_found" = yes ] || sc_missing="$sc_missing $stem"
 2294: done
 2295: check "SELFCHECK manifest: every differential is covered or dated-exempt" \
 2296:       "${sc_missing:-none}" "none"
 2297: 
 2298: #  THE H.  Grep the SOURCE, not the ledger and not the log: a stem can only be COVERED if
 2299: #  its own file contains the block.  @@SELFCHECK@@ rather than the summary text, because the
 2300: #  token is what selfmutant.py filters and what the probe rows are named with, so a block
 2301: #  gutted down to its printf still fails this.
 2302: sc_unbacked=""
 2303: for _stem in $SC_COVERED; do
 2304:     grep -q '@@SELFCHECK@@' "$HERE/diff_$_stem.c" 2>/dev/null \
 2305:         || sc_unbacked="$sc_unbacked $_stem"
 2306: done
 2307: check "SELFCHECK manifest: every COVERED stem has a real sentinel block" \
 2308:       "${sc_unbacked:-none}" "none"
 2309: 
 2310: #  DATED ENTRIES, NOT A COUNT -- the selfmutant list learned this the hard way: `wc -w == 6`
 2311: #  under a row named "shrinking not growing" made SHRINKING IT RED.  A count pins; a date
 2312: #  expires, and shrinking is green by construction.
 2313: #  The SM manifest's twin, and it carried the identical defect -- see exempt_expired() above.
 2314: sc_expired=$(exempt_expired "$(date +%Y-%m-%d)" $SC_EXEMPT)
 2315: check "SELFCHECK manifest: no exemption is past its dated deadline OR malformed" \
 2316:       "$sc_expired" "none"
 2317: 
 2318: #  THE G -- and it is not made redundant by the H above.  The H proves the block EXISTS in the
 2319: #  source; this proves it RAN, which is a different failure: a block behind a dead #ifdef, a
 2320: #  differential whose compile failed, or a driver that died before reaching it all satisfy the
 2321: #  H and fail this.  Assert the OK-token is PRESENT rather than "no FAIL line", because a
 2322: #  detector that never started prints neither and a negative form is satisfied by a control
 2323: #  that never ran.
 2324: sc_notrun=""
 2325: for _stem in $SC_COVERED; do
 2326:     grep -q 'SELFCHECK the comparator can still fail' "$LOGDIR/diff_$_stem.log" 2>/dev/null \
 2327:         || sc_notrun="$sc_notrun $_stem"
 2328: done
 2329: check "SELFCHECK manifest: every COVERED detector ran its sentinel" \
 2330:       "${sc_notrun:-none}" "none"
 2331: 
 2332: # ------------------------------------------------------------------ #446 sgi_eaddr
 2333: #  MOVED TO GATE 9 (gate_asan_sweep) AND DELIBERATELY NOT REPLACED HERE.
 2334: #
 2335: #  It was wired into this gate because the detector was pure SOURCE TEXT and so needed
 2336: #  neither a binary nor a rig.  A pass-2 panel then built sixteen mutants against that
 2337: #  detector and ALL SIXTEEN SCORED 7/7 -- including a two-character edit that restores
 2338: #  the heap-buffer-overflow with no compiler warning, and a 217-byte file containing
 2339: #  nothing but a C comment.  The replacement is a RUNTIME value oracle: it breaks on
 2340: #  arcbios_init() in a real construction of five real subtypes and requires the ethernet
 2341: #  string to BE the formatting of the MAC bytes passed beside it.
 2342: #
 2343: #  That needs build/gxemul and gdb, and THIS GATE RUNS NO EMULATOR AT ALL -- it is the
 2344: #  offline differential of the linked float_emul.c, and it references the binary nowhere.
 2345: #  Adding an emulator run here would have made the gate's own name untrue, which is the
 2346: #  same defect as a check whose title does not match what it checks.  Gate 9 already
 2347: #  constructs every machine and every subtype, so the probe went there.
 2348: #
 2349: #  Nothing is left behind here on purpose: a stub row asserting the probe merely EXISTS
 2350: #  would be a row that cannot fail for the reason it names.
 2351: 
 2352: gate_end
 2353: exit $?
