  364: 	d->timer_control[0] = TIMER_ENABLE | TIMER_FCLK_256;
  365: 	last_freq = -1.0;
  366: 	reload_timer_value(cpu, d, 0);
  367: 	check_u("E4 the RATE consumer really applies the x256 prescaler",
  368: 	    (uint64_t) (last_freq * 1000.0 + 0.5), 390625);
