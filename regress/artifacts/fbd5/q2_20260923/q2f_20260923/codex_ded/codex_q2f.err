  370: 	printf("--- F. END TO END: the shipped tick survives route 2, in a forked child ---\n");
  371: 	/*  ROUTE 2, the one that PREDATES #427/#428 and is the reason this round does not get
  372: 	    to blame its own hardening: TIMER_x_LOAD does not clear pending_timer_interrupts
  373: 	    (TIMER_x_CONTROL does), so an ordinary legal timer accrues a backlog and a later
  374: 	    write of zero divides.  Forked, because a mutant that re-crashes would otherwise
  375: 	    take the whole gate binary down and score as a census FAULT rather than a named-row
  376: 	    KILL.  */
  377: 	{
  378: 		pid_t pid = fork();
  379: 		if (pid == 0) {
  380: 			struct footbridge_data *c = calloc(1, sizeof(*c));
  381: 			int i;
  382: 			arm_irqs(c);
