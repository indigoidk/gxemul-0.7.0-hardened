 1282: 					free(x);
 1283: 				}
 1284: 		/*  X12  */
 1285: 		for (st = 0; st < 4; st++)
 1286: 			for (c = 0; c < 5; c++) {
 1287: 				uint64_t mask = CY[c].w == 4 ? 0xffffffffULL : CY[c].w == 2 ? 0xffffULL : 0xffULL;
 1288: 				uint32_t is = SY[st].is, ne = SY[st].ie & ~(uint32_t) (CY[c].data & mask);
 1289: 				YNEW(st);
 1290: 				fatal_calls = 0; a0 = irq_asserts; d0 = irq_deasserts;
 1291: 				memory_writemax64(cpu, b, CY[c].w, CY[c].data);
 1292: 				rv = dev_footbridge_access(cpu, NULL, IRQ_ENABLE_CLEAR, b, CY[c].w, MEM_WRITE, x);
 1293: 				ok = rv == 1 && fatal_calls == 0 && x->irq_enable == ne && x->irq_status == is
 1294: 				    && x->fiq_status == SY[st].fs && x->fiq_enable == SY[st].fe
 1295: 				    && ((is & ne) ? (irq_asserts == a0 + 1 && irq_deasserts == d0)
 1296: 				                  : (irq_asserts == a0 && irq_deasserts == d0 + 1));
 1297: 				YDECLINE_ALL();
 1298: 				ok = ok && fatal_calls == 5;
 1299: 				snprintf(yn, sizeof(yn), "X12 IRQ Clear write %s (%s, latches clear)", CY[c].nm, SY[st].nm);
 1300: 				check_u(yn, ok, 1);
 1301: 				free(x);
 1302: 			}
 1303: 		/*  X13  */
 1304: 		for (st = 0; st < 4; st++)
 1305: 			for (c = 0; c < 5; c++) {
 1306: 				uint64_t mask = CY[c].w == 4 ? 0xffffffffULL : CY[c].w == 2 ? 0xffffULL : 0xffULL;
 1307: 				uint32_t is = SY[st].is, ne = SY[st].ie & ~(uint32_t) (CY[c].data & mask);
 1308: 				YNEW(st);
 1309: 				YDECLINE_ALL();
 1310: 				f0 = fatal_calls; a0 = irq_asserts; d0 = irq_deasserts;
 1311: 				memory_writemax64(cpu, b, CY[c].w, CY[c].data);
 1312: 				rv = dev_footbridge_access(cpu, NULL, IRQ_ENABLE_CLEAR, b, CY[c].w, MEM_WRITE, x);
 1313: 				ok = rv == 1 && fatal_calls == f0 && x->irq_enable == ne && x->irq_status == is
 1314: 				    && x->fiq_status == SY[st].fs && x->fiq_enable == SY[st].fe
 1315: 				    && ((is & ne) ? (irq_asserts == a0 + 1 && irq_deasserts == d0)
 1316: 				                  : (irq_asserts == a0 && irq_deasserts == d0 + 1));
 1317: 				YDECLINE_ALL();
 1318: 				ok = ok && fatal_calls == f0;
 1319: 				snprintf(yn, sizeof(yn), "X13 IRQ Clear write %s (%s, latches SET)", CY[c].nm, SY[st].nm);
 1320: 				check_u(yn, ok, 1);
 1321: 				free(x);
 1322: 			}
 1323: #undef YDECLINE_ALL
 1324: #undef YSAME
 1325: #undef YNEW
 1326: 		fatal_calls = 0;
 1327: 	}
