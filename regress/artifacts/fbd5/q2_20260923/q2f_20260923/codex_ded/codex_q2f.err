  304: 			if (d->timer_value[0] > 0xffffff)
  305: 				over++;
  306: 		}
  307: 		check_u("D2 20000 ticks leave the 24-bit counter in range", over, 0);
  308: 	}
  309: 	/*  D3 EXISTS BECAUSE D2 WAS NOT ENOUGH, and the review measured why: every tick-path
  310: 	    row above uses load == 0, and for load == 0 the constant 16777216 is exactly the
  311: 	    right answer -- so replacing the whole helper call with that literal passed the
  312: 	    entire file.  The counter must TRACK THE GUEST'S LOAD, not merely stay in range.  */
  313: 	{
  314: 		int i, over = 0;
  315: 		struct footbridge_data *e = calloc(1, sizeof(*e));
  316: 		arm_irqs(e);
  317: 		e->timer_load[0] = 1000;
  318: 		e->timer_control[0] = TIMER_ENABLE;
  319: 		e->pending_timer_interrupts[0] = 1;
  320: 		for (i = 0; i < 20000; i++) {
  321: 			dev_footbridge_tick(cpu, e);
  322: 			if (e->timer_value[0] >= 1000)
  323: 				over++;
  324: 		}
  325: 		check_u("D3 the counter stays below the guest's OWN load", over, 0);
  326: 		free(e);
  327: 	}
  328: 
  329: 	printf("--- E. the rate the device asks the timer core for ---\n");
  330: 	memset(d, 0, sizeof(*d));
  331: 	d->timer_load[0] = 1000;
  332: 	d->timer_control[0] = TIMER_ENABLE;
  333: 	last_freq = -1.0;
  334: 	reload_timer_value(cpu, d, 0);
  335: 	check_u("E1 a 1000-cycle load at 100 MHz asks for 100 kHz",
  336: 	    (uint64_t) (last_freq + 0.5), 100000);
  337: 	/*  E2 is the route that needs NO load write at all: the reset load is TIMER_MAX_VAL,
  338: 	    so one write of ENABLE|FCLK_256 reaches the old overflow.  Before #432 this asked
  339: 	    for a NEGATIVE rate, which the core's floor clamp turned into one tick per ~3.2
  340: 	    years, silently.  */
