  860: 	/*
  861: 	 *  #545 CLASS CLOSURE (repair pass 2 -- two consecutive passes found breaches of ONE class, so the
  862: 	 *  whole space is enumerated from the handler's own inputs and closed in one block; carrier rule).  Its own
  863: 	 *  closing pass found the ENUMERATION wrong again -- in the cells (repair 3: X6-X13, below the CONTRACT) and in
  864: 	 *  the INSTANCES every block is built from (repair 3: X14, the last block before IDENTITY).
  865: 	 *
  866: 	 *  X6: EVERY DECLINED ACCESS -- site (5) x width (1, 2, 4, and 8 at the two 8-byte-aligned sites) x data (zero,
  867: 	 *      nonzero; writes only) x state (seeded, all-zero, wide, ones) x occurrence (first, repeated).  Each row
  868: 	 *      requires: the handler returns 1; the announce count moves by exactly 1 on the first access, 0 on the
  869: 	 *      repeat; all four register fields are unchanged; the interrupt output is untouched (no assert, no
  870: 	 *      deassert); and a declined read returns 0 over its whole width.
  871: 	 *  X7: EVERY LEGAL ACCESS IT SAMPLES RE-ARMS NO LATCH -- with all five sites latched: each enable write
  872: 	 *      (Set/Clear, IRQ/FIQ) at len 4 with zero and nonzero data, and each legal read of the readable registers
  873: 	 *      plus VENDOR_ID and TIMER_1_VALUE at widths 1, 2 and 4 (and 8 at IRQ_STATUS and FIQ_STATUS); from the four
  874: 	 *      states, so a divert keyed on a zero field or on any one bit announces in one of them.  After each, the
  875: 	 *      access returned 1 and re-declining all five sites announces nothing.  X7 reads NO value; the value channel
  876: 	 *      of a legal access with the latches set is X10's.
  877: 	 *  X9-X13 (below X8) are the rest of the legal side: X9 with the latches still CLEAR, X10 with every latch SET
  878: 	 *  (value and effect), X11 the cross-site latch ORDER and PRESERVATION, X12 and X13 the legal Clear write's
  879: 	 *  width and data with the latches clear and set.

 succeeded in 2899ms:
  880: 	 *
  881: 	 *  CONTRACT (clause e).  THE SPACE, from the handler and from what the PRODUCER emits: the case label (the
  882: 	 *  timer fold maps no address onto these five -- they sit below TIMER_1_LOAD and have bits 5-6 clear); the
  883: 	 *  direction test; the WIDTH, whose domain is what the ARM load/store unit emits -- 1, 2 and 4, and 8 at the
  884: 	 *  8-byte-aligned offsets: of the five decline sites, +0x180 and +0x280 (an LDRD/STRD there is ONE 8-byte
  885: 	 *  access: cpu_arm_instr_loadstore.c's `datalen = 8` and a single memory_rw call; an access to +0x184, +0x18c
  886: 	 *  or +0x284 cannot be 8 bytes, it is aligned down first), and the enable arms at +0x188 and +0x288 too (grok,
  887: 	 *  glm and codex on repair 3's pass: this said "the two 8-byte-aligned sites"); idata (read by the four legal
  888: 	 *  enable writes -- of those
  889: 	 *  only the IRQ Clear write shares its case, and so its direction test, with a decline); the four interrupt
  890: 	 *  fields (read by the legal branches); and the five latches (each read by its own decline).  The bodies
  891: 	 *  compare no field or data against a constant: they test the direction, their own latch and, in the Clear
  892: 	 *  write, whether (irq_status & the new enable) is zero.  That test's operand cells -- both zero, one zero,
  893: 	 *  both nonzero and DISJOINT, intersecting -- are set by the PRODUCER: footbridge_interrupt_assert() and
  894: 	 *  _deassert() are the only writers of irq_status, and the lines a device raises are the timers (4-7), ISA 10
  895: 	 *  (cats) and 11 (netwinder) and PCI 18 (cats); no device raises the other 25.  And an edit can condition any
  896: 	 *  of the arms' tests on a field NO branch of the five reads -- irq_asserted (written only by that pair), the timer
  897: 	 *  fields (DEVINIT: PERIODIC, TIMER_MAX_VAL, a bound of 1; timer_value 0), the pending ticks, and the rest of the
  898: 	 *  instance (the CPU interrupt's own fields, pcibus, console_handle, the timer handles) -- so the INSTANCE a row
  899: 	 *  runs on is part of the space.
  900: 	 *  COVERED -- the rows named, each observing the channels it names: the return value, the announce count, the
  901: 	 *  four fields, the interrupt calls and the read data over the width, except X7 (the return value and the
  902: 	 *  announce count only) and X14's rows (the channels in each row's name and header):
  903: 	 *    declined x width (the site's domain) x data {0, 0x70} x state x first/repeat (X6);
  904: 	 *    the legal READS of the five readable registers x width (the site's domain) x state, every latch clear (X9)
  905: 	 *    and every latch set (X10; X7 for the announce channel);
  906: 	 *    the eight enable writes at len 4, data {0, 0x70}, every latch clear (X9) and set (X7);
  907: 	 *    the IRQ Clear write -- the one legal write inside an edited case -- at len 1 and 2 with 0x70 and at len 1,
  908: 	 *    2 and 4 with all-ones data (0xff, 0xffff, 0xffffffff), every latch clear (X12) and set (X13); at len 4 with
  909: 	 *    0 and 0x70, latches clear (X9), and with 0x70, every latch set (X10);
  910: 	 *    each ordered pair of sites in each of the four states: latch j, then i's first decline announces once,
  911: 	 *    returns 1, reads 0 if it is the declined read, and BOTH stay latched (X11);
  912: 	 *    the drive test's disjoint and status-zero cells, and each of the seven raised lines pending alone, with
  913: 	 *    the CPU line counted apart from the timer interrupts (X14); DEVINIT's timer values, without and with a
  914: 	 *    tick pending, at the five legal reads, a Set and a Clear (the drive in both polarities), and the five
  915: 	 *    declines, each with the interrupt output (X14); irq_asserted = 1, raised through the real producer, at the
  916: 	 *    IRQ_STATUS read (value, fields, output), the Clear write both ways, and a re-arm row -- five declines, the
  917: 	 *    legal reads with their values and a Clear, five declines again: 5 announces, one CPU assert (X14).
  918: 	 *  STATES: seeded, all-zero, wide and ONES -- with all-zero, the ones state makes every single-bit condition on
  919: 	 *  one field divert in one of the two.
  920: 	 *  *** THIS SAID "the cells above are the whole class" and was measured false THREE times on 2026-09-23: the
  921: 	 *  reset state (q2_20260923/Q2.log); then the value channel with the latches set, the cross-site order, the
  922: 	 *  narrow Clear write and any field bit no state set (the Opus seat's 434 variants; X10-X12); then, on the
  923: 	 *  closure's OWN closing pass, an 8-byte access at the two aligned sites (grok), the return value unread on
  924: 	 *  X10-X12 (grok), a narrow Clear write after its latch was set (codex), a decline clearing ANOTHER site's latch
  925: 	 *  (codex) and a field x other-latch condition in any state but the seeded one (glm) -- all measured green on
  926: 	 *  707 rows (q2_20260923/closing_20260923/CL.log, CL2.log) -- and on the same pass the Opus seat's 28 (the
  927: 	 *  drive test's operand and single-line cells, WHICH interrupt a Clear drives, the timer fields at their
  928: 	 *  DEVINIT values, a tick pending, and irq_asserted; q2_20260923/q2c_opus/SUMMARY.txt).  All closed by
  929: 	 *  repair 3, X6-X14. ***
  930: 	 *  NOT COVERED, stated so a later escape is "outside the contract", not a surprise:
  931: 	 *    a condition on one EXACT field or data value (`d->fiq_enable != 0x10`; `idata == 0` at a latched Clear write
  932: 	 *    -- measured green, r3c_20260923; `idata != 0x20` and the `irq_enable`/`irq_status != 0x10` forms at +0x180
  933: 	 *    and +0x18c are red since X14, whose rows happen to write 0x20 and hold 0x10 -- by value, not by design): the
  934: 	 *    bodies compare nothing against a constant, and no practical set of
  935: 	 *    seeded states holds every value (a field's domain is finite, 2^32, but not enumerable here);
  936: 	 *    JOINT conditions beyond the rowed combinations: two fields beyond the four states; latch vectors other
  937: 	 *    than none, all, the site's own and the X11 pairs (a first decline after two OTHER sites latched); a width
  938: 	 *    and a latch outside the rowed cells;
  939: 	 *    the Set writes (IRQ and FIQ) and the FIQ Clear write below len 4, and the enable arms at len 8 -- an
  940: 	 *    LDRD/STRD at +0x188 or +0x288, or at +0x18c/+0x28c aligned down onto them -- including IRQEnable's 8-byte
  941: 	 *    read: arms that share no case with a decline, so outside the floor; a `len == 4` conjunct on their
  942: 	 *    direction tests, or on the write-data fetch with the Clear address exempted, or `len != 8` on the fetch,
  943: 	 *    passes every row (measured, closing_20260923/CL.log; filed `fbenablewidth`);
  944: 	 *    declined-write DATA other than 0 and 0x70 -- wide, 0x55, odd (measured green: q2c_opus N_D02, N_D03, N_D06,
  945: 	 *    N_D11, N_B10);
  946: 	 *    the ADDRESS axis -- a case label added for another offset, or a widened timer fold, aliasing an address onto
  947: 	 *    an arm.  (An 8-byte access answers ONE register: X9/X10 pin an 8-byte READ's upper word to 0, and an STRD at
  948: 	 *    +0x180 is one decline of IRQ_STATUS, not a second of +0x184 -- this line said the upper word was not
  949: 	 *    covered until the Opus seat measured it red, repair 3's pass.);
  950: 	 *    WHICH interrupt a Clear write drives, below len 4: X14 counts the CPU line apart at len 4 only, and X9-X13
  951: 	 *    count calls on the shared pair, so a destination conditioned on the width passes (codex, repair 3's pass);
  952: 	 *    a mask on one of the 25 bits of the drive test no device raises (a guest cannot set them in irq_status);
  953: 	 *    the IRQ Set write's own drive test (the same `if (d->irq_status & d->irq_enable)`, in an arm that shares no
  954: 	 *    case with a decline): X9 rows it where (irq_status & the new enable) is nonzero, where both operands are
  955: 	 *    zero and where only the enable is set -- never with both nonzero and disjoint, so `&&` there passes;
  956: 	 *    X14's operand and single-line cells are the Clear write's;
  957: 	 *    the PRODUCER PAIR's own logic: X14 calls footbridge_interrupt_assert() only to BUILD its instances, and
  958: 	 *    nothing here calls _deassert() -- deleting the `~` in its `irq_status &= ~interrupt->line` passes all 862
  959: 	 *    rows (codex, repair 3's pass; measured, q2_20260923/r3_20260923/t_deassert.txt).  That pair is
  960: 	 *    `fbirqstuck`'s round;
  961: 	 *    the interrupt output's LEVEL: these rows count calls on stubbed callbacks, so a line left high
  962: 	 *    (`fbirqstuck`) is invisible here;
  963: 	 *    any other register's semantics; and, beyond X14's cells, a condition in ANY of the arms' tests -- the
  964: 	 *    direction test, a latch test, the write-data fetch, the drive test, a latch clearer -- on a field no branch
  965: 	 *    of the five reads: other timer values (`!d->timer_value[0]`, `d->pending_bound[0] <= 1`: q2c_opus N_T07,
  966: 	 *    N_T08, announce count only), irq_asserted = 1 at the other legal accesses and widths, and a pending tick
  967: 	 *    at the other timers.  (F1, `&& !timer_control[0]` on a latch guard, passed every row until X14's DEVINIT
  968: 	 *    rows -- the guest sites probe caught it only because its prologue arms timer 1, table4_20260919; it is red
  969: 	 *    on the 862 rows, r3_20260923.)  fiq_status has NO writer in the product, so every FIQ status value these
  970: 	 *    rows seed is synthetic.
  971: 	 */
  972: 	{
  973: 		static const struct { uint64_t addr; int wf; const char *nm; } S5[] = {
  974: 			{ IRQ_STATUS, MEM_WRITE, "write IRQ_STATUS" }, { IRQ_RAW_STATUS, MEM_WRITE, "write IRQ_RAW_STATUS" },
  975: 			{ IRQ_ENABLE_CLEAR, MEM_READ, "read IRQ_ENABLE_CLEAR" }, { FIQ_STATUS, MEM_WRITE, "write FIQ_STATUS" },
  976: 			{ FIQ_RAW_STATUS, MEM_WRITE, "write FIQ_RAW_STATUS" } };
  977: 		/*  #545 adjudication (Fable 5.1, Q2 (e) cell): the byte seeds left bits 8-31 of every field unexercised,
  978: 		    so a decline store or a latch clearer keyed on them passed every row.  "wide" is X8's seeds -- and it
  979: 		    still left byte 1 of every field, bit 0, bits 18-29 and byte 3 of the enables at 0, so a condition keyed
  980: 		    on one of those bits passed every row (repair pass 2, five seats; Opus measured 30 such edits green).
  981: 		    "ones" sets every bit of every field: with all-zero, a single-bit condition diverts in one of the two.  */
  982: 		static const struct { uint32_t is, ie, fs, fe; const char *nm; } ST[4] = {
  983: 			{ 0x18, 0x30, 0x60, 0xc0, "seeded" }, { 0, 0, 0, 0, "all-zero" },
  984: 			{ 0x80010018, 0x00010030, 0x40020060, 0x000200c0, "wide" },
  985: 			{ 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, "ones" } };
  986: 		static const int W[4] = { 1, 2, 4, 8 };
  987: 		static const struct { uint64_t addr; int wf; uint64_t data; const char *nm; } LW[8] = {
  988: 			{ IRQ_ENABLE_SET, MEM_WRITE, 0, "IRQ Set write 0" }, { IRQ_ENABLE_SET, MEM_WRITE, 0x70, "IRQ Set write 0x70" },
  989: 			{ IRQ_ENABLE_CLEAR, MEM_WRITE, 0, "IRQ Clear write 0" }, { IRQ_ENABLE_CLEAR, MEM_WRITE, 0x70, "IRQ Clear write 0x70" },
  990: 			{ FIQ_ENABLE_SET, MEM_WRITE, 0, "FIQ Set write 0" }, { FIQ_ENABLE_SET, MEM_WRITE, 0x70, "FIQ Set write 0x70" },
  991: 			{ FIQ_ENABLE_CLEAR, MEM_WRITE, 0, "FIQ Clear write 0" }, { FIQ_ENABLE_CLEAR, MEM_WRITE, 0x70, "FIQ Clear write 0x70" } };
  992: 		static const struct { uint64_t addr; const char *nm; } LR[9] = {
  993: 			{ IRQ_STATUS, "IRQ_STATUS" }, { IRQ_RAW_STATUS, "IRQ_RAW_STATUS" }, { FIQ_STATUS, "FIQ_STATUS" },
  994: 			{ FIQ_RAW_STATUS, "FIQ_RAW_STATUS" }, { IRQ_ENABLE_SET, "IRQ_ENABLE_SET" }, { FIQ_ENABLE_SET, "FIQ_ENABLE_SET" },
  995: 			{ FIQ_ENABLE_CLEAR, "FIQ_ENABLE_CLEAR" }, { VENDOR_ID, "VENDOR_ID" }, { TIMER_1_VALUE, "TIMER_1_VALUE" } };
  996: 		unsigned char b[8];
  997: 		char xn[200];
  998: 		int si, st, wi, dv, ord, k, f0, a0, d0, rv, ok;
  999: 		struct footbridge_data *x;
 1000: #define XSET(x, s) do { arm_irqs(x); (x)->irq.interrupt_assert = noop_assert; (x)->irq.interrupt_deassert = noop_deassert; \
 1001: 		(x)->irq_status = ST[s].is; (x)->irq_enable = ST[s].ie; (x)->fiq_status = ST[s].fs; (x)->fiq_enable = ST[s].fe; } while (0)
 1002: #define XSAME(x, s) ((x)->irq_status == ST[s].is && (x)->irq_enable == ST[s].ie && (x)->fiq_status == ST[s].fs \
 1003: 		&& (x)->fiq_enable == ST[s].fe)
 1004: 		for (si = 0; si < 5; si++)
 1005: 			for (st = 0; st < 4; st++)
 1006: 				for (wi = 0; wi < (S5[si].addr == IRQ_STATUS || S5[si].addr == FIQ_STATUS ? 4 : 3); wi++)
 1007: 					for (dv = 0; dv < (S5[si].wf == MEM_WRITE ? 2 : 1); dv++) {
 1008: 						x = calloc(1, sizeof(*x)); XSET(x, st);
 1009: 						fatal_calls = 0;
 1010: 						for (ord = 0; ord < 2; ord++) {
 1011: 							a0 = irq_asserts; d0 = irq_deasserts; f0 = fatal_calls;
 1012: 							memset(b, 0xa5, sizeof(b));
 1013: 							if (S5[si].wf == MEM_WRITE)
 1014: 								memory_writemax64(cpu, b, W[wi], dv ? 0x70 : 0);
 1015: 							rv = dev_footbridge_access(cpu, NULL, S5[si].addr, b, W[wi], S5[si].wf, x);
 1016: 							ok = rv == 1 && fatal_calls - f0 == (ord == 0 ? 1 : 0) && XSAME(x, st)
 1017: 							    && irq_asserts == a0 && irq_deasserts == d0
 1018: 							    && (S5[si].wf != MEM_READ || memory_readmax64(cpu, b, W[wi]) == 0);
 1019: 							snprintf(xn, sizeof(xn), "X6 %s len %d %s %s %s: declined, fields/irq kept, once",
 1020: 							    S5[si].nm, W[wi], S5[si].wf == MEM_WRITE ? (dv ? "data 0x70" : "data 0") : "",
 1021: 							    ST[st].nm, ord ? "repeat" : "first");
 1022: 							check_u(xn, ok, 1);
 1023: 						}
 1024: 						free(x);
 1025: 					}
 1026: 		for (st = 0; st < 4; st++)
 1027: 			for (k = 0; k < 8 + 9 * 3 + 2; k++) {
 1028: 				x = calloc(1, sizeof(*x)); XSET(x, st);
 1029: 				for (si = 0; si < 5; si++) {
 1030: 					memory_writemax64(cpu, b, 4, 0x70);
 1031: 					dev_footbridge_access(cpu, NULL, S5[si].addr, b, 4, S5[si].wf, x);
 1032: 				}
 1033: 				f0 = fatal_calls;
 1034: 				if (k < 8) {
 1035: 					memory_writemax64(cpu, b, 4, LW[k].data);
 1036: 					rv = dev_footbridge_access(cpu, NULL, LW[k].addr, b, 4, MEM_WRITE, x);
 1037: 					snprintf(xn, sizeof(xn), "X7 %s (%s) re-arms NO latch", LW[k].nm, ST[st].nm);
 1038: 				} else {
 1039: 					int r = k < 8 + 27 ? (k - 8) / 3 : (k == 8 + 27 ? 0 : 2);
 1040: 					int w = k < 8 + 27 ? W[(k - 8) % 3] : 8;
 1041: 					memset(b, 0, sizeof(b));
 1042: 					rv = dev_footbridge_access(cpu, NULL, LR[r].addr, b, w, MEM_READ, x);
 1043: 					snprintf(xn, sizeof(xn), "X7 legal len %d read of %s (%s) re-arms NO latch", w, LR[r].nm, ST[st].nm);
 1044: 				}
 1045: 				for (si = 0; si < 5; si++) {
 1046: 					memory_writemax64(cpu, b, 4, 0x70);
 1047: 					dev_footbridge_access(cpu, NULL, S5[si].addr, b, 4, S5[si].wf, x);
 1048: 				}
 1049: 				ok = rv == 1 && fatal_calls == f0;
 1050: 				check_u(xn, ok, 1);
 1051: 				free(x);
 1052: 			}
 1053: #undef XSAME
 1054: #undef XSET
 1055: 		fatal_calls = 0;
 1056: 	}
 1057: 	/*  X8 (adjudication pass, G11): every seed in the P-rows and X1-X5 fits in ONE byte, so a legal read
 1058: 	    truncated to 8 bits passed every row.  Wide seeds: each legal word read returns its full 32-bit value
 1059: 	    (the masked reads: 0x80010018 & 0x00010030 = 0x00010010, 0x40020060 & 0x000200c0 = 0x00020040).  These
 1060: 	    seeds set bits in bytes 0, 2 and 3 only; the ONES state is what exercises byte 1 -- X9, X10, X12 and X13 read
 1061: 	    or clear it, X6 and X11 require every field to keep it, X7 reads no value.  */
 1062: 	{
 1063: 		struct footbridge_data *x = calloc(1, sizeof(*x));
 1064: 		unsigned char b[8];
 1065: 		arm_irqs(x);
 1066: 		x->irq.interrupt_assert = noop_assert;
 1067: 		x->irq.interrupt_deassert = noop_deassert;
 1068: 		x->irq_status = 0x80010018;  x->irq_enable = 0x00010030;
 1069: 		x->fiq_status = 0x40020060;  x->fiq_enable = 0x000200c0;
 1070: 		fatal_calls = 0;
 1071: 		memset(b, 0, sizeof(b));
 1072: 		dev_footbridge_access(cpu, NULL, IRQ_STATUS, b, 4, MEM_READ, x);
 1073: 		check_u("X8 wide IRQ_STATUS read = 0x00010010 (all 32 bits)", memory_readmax64(cpu, b, 4), 0x00010010);
 1074: 		dev_footbridge_access(cpu, NULL, IRQ_RAW_STATUS, b, 4, MEM_READ, x);
 1075: 		check_u("X8 wide IRQ_RAW_STATUS read = 0x80010018", memory_readmax64(cpu, b, 4), 0x80010018);
 1076: 		dev_footbridge_access(cpu, NULL, FIQ_STATUS, b, 4, MEM_READ, x);
 1077: 		check_u("X8 wide FIQ_STATUS read = 0x00020040", memory_readmax64(cpu, b, 4), 0x00020040);
 1078: 		dev_footbridge_access(cpu, NULL, FIQ_RAW_STATUS, b, 4, MEM_READ, x);
 1079: 		check_u("X8 wide FIQ_RAW_STATUS read = 0x40020060", memory_readmax64(cpu, b, 4), 0x40020060);
 1080: 		dev_footbridge_access(cpu, NULL, IRQ_ENABLE_SET, b, 4, MEM_READ, x);
 1081: 		check_u("X8 wide IRQEnable read = 0x00010030", memory_readmax64(cpu, b, 4), 0x00010030);
 1082: 		check_u("X8 the wide legal reads announce nothing", fatal_calls, 0);
 1083: 		free(x);
 1084: 		fatal_calls = 0;
 1085: 	}
 1086: 	/*  X9 (adjudication pass, 2026-09-23 -- Fable 5.1's Q2, MEASURED before this block existed): the legal
 1087: 	    accesses of the five sites -- reads of the four status registers and of IRQEnable (+0x188) at widths 1, 2
 1088: 	    and 4, and the eight enable writes at len 4 (X12 has the Clear write's other widths and data) -- WITH THE
 1089: 	    LATCHES STILL CLEAR, from each state.  X7 latched all five sites before its legal access,
 1090: 	    so a direction test conjoined with a field that is 0 in the RESET state (`writeflag == MEM_READ &&
 1091: 	    d->irq_enable` at IRQ_STATUS, its three read mirrors, `writeflag == MEM_WRITE && d->irq_enable` at
 1092: 	    IRQEnableClear) sent the legal access into the decline, which announced a phantom complaint, consumed the
 1093: 	    latch and -- for the reads -- returned read data 0, the right value in that state; the diverted Clear WRITE
 1094: 	    cleared nothing, which in that state is also the right result -- and every row stayed green
 1095: 	    (regress/artifacts/fbd5/q2_20260923/Q2.log: 333/333 and 37/37 for all five).  Each cell is ONE row on a
 1096: 	    fresh instance: the access returns 1 and announces nothing; a read returns its value over the width and
 1097: 	    changes no field; a write sets the enable it targets as written and leaves the other three alone, and IRQ
 1098: 	    Set/Clear drive the interrupt output exactly once by (irq_status & the new enable) while FIQ Set/Clear do
 1099: 	    not touch it; then the five declines announce EXACTLY 5, because no latch was consumed.  */
 1100: 	{
 1101: 		static const struct { uint32_t is, ie, fs, fe; const char *nm; } S9[4] = {
 1102: 			{ 0x18, 0x30, 0x60, 0xc0, "seeded" }, { 0, 0, 0, 0, "all-zero" },
 1103: 			{ 0x80010018, 0x00010030, 0x40020060, 0x000200c0, "wide" },
 1104: 			{ 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff, "ones" } };
 1105: 		static const struct { uint64_t addr; int wf; } D5[5] = {
 1106: 			{ IRQ_STATUS, MEM_WRITE }, { IRQ_RAW_STATUS, MEM_WRITE }, { IRQ_ENABLE_CLEAR, MEM_READ },
 1107: 			{ FIQ_STATUS, MEM_WRITE }, { FIQ_RAW_STATUS, MEM_WRITE } };
 1108: 		static const struct { uint64_t addr; const char *nm; } R5[5] = {
 1109: 			{ IRQ_STATUS, "IRQ_STATUS" }, { IRQ_RAW_STATUS, "IRQ_RAW_STATUS" }, { FIQ_STATUS, "FIQ_STATUS" },
 1110: 			{ FIQ_RAW_STATUS, "FIQ_RAW_STATUS" }, { IRQ_ENABLE_SET, "IRQEnable" } };
 1111: 		static const struct { uint64_t addr; int fiq, set; uint32_t data; const char *nm; } W8[8] = {
 1112: 			{ IRQ_ENABLE_SET, 0, 1, 0, "IRQ Set write 0" }, { IRQ_ENABLE_SET, 0, 1, 0x70, "IRQ Set write 0x70" },
 1113: 			{ IRQ_ENABLE_CLEAR, 0, 0, 0, "IRQ Clear write 0" }, { IRQ_ENABLE_CLEAR, 0, 0, 0x70, "IRQ Clear write 0x70" },
 1114: 			{ FIQ_ENABLE_SET, 1, 1, 0, "FIQ Set write 0" }, { FIQ_ENABLE_SET, 1, 1, 0x70, "FIQ Set write 0x70" },
 1115: 			{ FIQ_ENABLE_CLEAR, 1, 0, 0, "FIQ Clear write 0" }, { FIQ_ENABLE_CLEAR, 1, 0, 0x70, "FIQ Clear write 0x70" } };
 1116: 		static const int W9[3] = { 1, 2, 4 };
 1117: 		unsigned char b[8];
 1118: 		char xn[200];
 1119: 		int st, k, si, a0, d0, rv, ok;
 1120: 		struct footbridge_data *x;
 1121: 		for (st = 0; st < 4; st++)
 1122: 			for (k = 0; k < 5 * 3 + 2 + 8; k++) {
 1123: 				uint32_t is = S9[st].is, ie = S9[st].ie, fs = S9[st].fs, fe = S9[st].fe;
 1124: 				x = calloc(1, sizeof(*x));
 1125: 				arm_irqs(x);
 1126: 				x->irq.interrupt_assert = noop_assert;
 1127: 				x->irq.interrupt_deassert = noop_deassert;
 1128: 				x->irq_status = is;  x->irq_enable = ie;  x->fiq_status = fs;  x->fiq_enable = fe;
 1129: 				fatal_calls = 0;
 1130: 				a0 = irq_asserts;  d0 = irq_deasserts;
 1131: 				if (k < 17) {
 1132: 					int r = k < 15 ? k / 3 : (k == 15 ? 0 : 2), w = k < 15 ? W9[k % 3] : 8;
 1133: 					uint64_t want = r == 0 ? (uint64_t) (is & ie) : r == 1 ? (uint64_t) is
 1134: 					    : r == 2 ? (uint64_t) (fs & fe) : r == 3 ? (uint64_t) fs : (uint64_t) ie;
 1135: 					want &= w == 8 ? ~0ULL : w == 4 ? 0xffffffffULL : w == 2 ? 0xffffULL : 0xffULL;
 1136: 					memset(b, 0xa5, sizeof(b));
