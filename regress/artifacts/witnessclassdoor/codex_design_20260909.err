1814:def selftest(verbose=False):
1815:    import shutil
1816:    import subprocess
1817:    import tempfile
1818:
1819:    src_regress = DEFAULT_REGRESS
1820:    me = os.path.abspath(__file__)
1821:    root = tempfile.mkdtemp(prefix="probewiring_selftest_")
1822:    results = []
1823:
1824:    #  *** THE BASELINE MUST BE GREEN BY CONSTRUCTION, AND THE FIRST VERSION WAS NOT. ***
1825:    #  fresh() copied EVERY .py from the live tree, so when a concurrent round dropped an
1826:    #  unclassified probe into regress/, M0/M2b/M5a all went red and the selftest announced
1827:    #  "THE CHECKER CAN NO LONGER BE SHOWN TO FAIL".  Right colour, WRONG DIAGNOSIS: it
1828:    #  blamed the checker for an APPARATUS state -- gate_offline's F5 shape, and the
1829:    #  dangerous one, because it points the reader at the wrong file.
1830:    #
1831:    #  So the baseline copies exactly the MANIFEST set.  Live-tree content can no longer
1832:    #  perturb a mutant, and M6 still tests the unclassified-arrival path by ADDING one.
1833:    #  A MANIFEST entry with no source file is a SETUP FAULT here, never a mutant result --
1834:    #  absorb_census.py's rule that a crash is a fault and never a detection.
1835:    def fresh():
1836:        work = tempfile.mkdtemp(dir=root)
1837:        rg = os.path.join(work, "regress")
1838:        os.makedirs(rg)
1839:        #  #471: THE COPY MUST MIRROR THE TREE, NOT FLATTEN IT.  This loop was
1840:        #  `os.listdir`, so once the checker could see nested detectors the selftest
1841:        #  copy still could not -- and every nested MANIFEST entry became a GHOST in
1842:        #  the copy, reddening the unmutated M0 control.
1843:        #
1844:        #  That is the SAME blind spot one level up, inside the harness that tests
1845:        #  for it: a flat copy cannot exercise a recursive scan.
1846:        for f in os.listdir(src_regress):
1847:            if f.endswith(".sh"):
1848:                shutil.copyfile(os.path.join(src_regress, f), os.path.join(rg, f))
1849:        for rel in MANIFEST:
1850:            if not rel.endswith(".py"):
1851:                continue
1852:            src = os.path.join(src_regress, rel.replace("/", os.sep))
1853:            if not os.path.isfile(src):
1854:                continue
1855:            dst = os.path.join(rg, rel.replace("/", os.sep))
1856:            os.makedirs(os.path.dirname(dst), exist_ok=True)
1857:            shutil.copyfile(src, dst)
1858:        chk = os.path.join(work, "check_probe_wiring.py")
1859:        shutil.copyfile(me, chk)
1860:        return rg, chk
1861:
1862:    absent = [f for f in sorted(MANIFEST) if not os.path.isfile(os.path.join(src_regress, f))]
1863:    if absent:
1864:        print("PROBEWIRING_SELFTEST_SETUP  the MANIFEST names files regress/ does not have:")
1865:        for f in absent:
1866:            print("    %s" % f)
1867:        print("  fix the manifest first; a selftest on a broken baseline proves nothing.")
1868:        return 2
