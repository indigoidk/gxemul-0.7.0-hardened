import ast, pathlib, subprocess
p = pathlib.Path('tools/pipeline/check_probe_wiring.py')
t = ast.parse(p.read_text(encoding='utf-8'))
m = next(n.value for n in t.body if isinstance(n, ast.Assign) and any(isinstance(x, ast.Name) and x.id == 'MANIFEST' for x in n.targets))
w = [(ast.literal_eval(k), v.lineno, ast.literal_eval(v.elts[1])) for k,v in zip(m.keys,m.values) if isinstance(v,ast.Tuple) and isinstance(v.elts[0],ast.Name) and v.elts[0].id == 'CLASS_WITNESS']
for name,line,note in w:
 print(f'{line}\\t{name}\\t{note}')
print(f'WITNESS_TOTAL={len(w)} TOP_LEVEL={sum(\"/\" not in n for n,_,_ in w)} ARTIFACTS={sum(\"/\" in n for n,_,_ in w)}')
cmd = ['rg','-n','-F','--max-depth','1','-g','*.sh']
for name,_,_ in w:
 cmd += ['-e',pathlib.PurePosixPath(name).name]
cmd += ['regress']
print('GREP_DERIVER=' + subprocess.list2cmdline(cmd),flush=True)
r=subprocess.run(cmd, capture_output=True,text=True)
print(r.stdout,end='')
print(r.stderr,end='')
print('GREP_EXIT=' + str(r.returncode))
