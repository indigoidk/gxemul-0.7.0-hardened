import ast, pathlib, re
p=pathlib.Path('tools/pipeline/check_probe_wiring.py')
t=ast.parse(p.read_text(encoding='utf-8'))
m=next(n.value for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='MANIFEST' for x in n.targets))
w=[(ast.literal_eval(k),ast.literal_eval(v.elts[1])) for k,v in zip(m.keys,m.values) if isinstance(v,ast.Tuple) and isinstance(v.elts[0],ast.Name) and v.elts[0].id=='CLASS_WITNESS']
scores=[]
for key,note in w:
 pairs=re.findall(r'\\b(?:fix(?:ed)?\\s+|post-fix green MEASURED\\s+)(\\d+)/(\\d+)',note)
 if any(int(a)>0 and a==b for a,b in pairs):
  scores.append(key)
print('WITNESS_ENTRIES='+str(len(w)))
print('TOP_LEVEL='+str(sum('/' not in k for k,_ in w)))
print('NESTED='+str(sum('/' in k for k,_ in w)))
print('EXPLICIT_ALL_GREEN_SCORES='+str(len(scores)))
print('\\n'.join(scores))
values=[k for k,note in w if '0x4242 on the fix' in note]
print('ADDITIONAL_REPAIRED_VALUE_NOTES='+str(len(values)))
print('\\n'.join(values))
print('MANIFEST_GREEN_OUTCOME_NOTES='+str(len(set(scores+values))))
