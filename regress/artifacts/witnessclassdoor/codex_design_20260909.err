2168:                if not DATE_RE.match(d or ""):
2169:                    fails.append("MALFORMED EXEMPTION  %s:'%s' is not YYYY-MM-DD. A date "
2170:                                 "nothing validates never expires -- refusing to guess."
2171:                                 % (f, d))
2172:                    state = "EXEMPT(BAD-DATE)"
2173:                elif d < today:
2174:                    fails.append("EXPIRED EXEMPTION  %s came due %s (today %s) and is still "
2175:                                 "run by no gate" % (f, d, today))
2176:                    state = "EXEMPT(EXPIRED %s)" % d
