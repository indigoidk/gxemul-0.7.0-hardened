1394:    else
1395:        grep -E " ok$| FAIL$" "$WFLOG" | sed 's/^/       /'
1396:        wfres=$(grep -o "WDC_FLOOD_RESULT=[0-9]*/[0-9]*" "$WFLOG" | tail -1 | cut -d= -f2)
1397:
1398:        #  *** PARSE BEFORE SCORE. ***  If the result line exists but is MALFORMED, the
1399:        #  outer grep still succeeds, `wfres` is EMPTY, and both `${wfres%/*}` and
1400:        #  `${wfres#*/}` expand to the empty string -- so `check "rows correct" "" ""`
1401:        #  PASSES while nothing was measured.  Three panel seats found that false pass
1402:        #  in the asic section above; it is the project's own "a pattern that matched
1403:        #  nothing reports zero for everything" class in shell-expansion clothes.
1404:        if [ -z "$wfres" ]; then
1405:            note "wdc_flood result line present but unparseable; last lines follow"
1406:            tail -3 "$WFLOG" | sed 's/^/       /'
1407:            check "wdc_flood result parses" "no" "yes"
1408:        else
1409:            check "wdc_flood result parses" "yes" "yes"
1410:            check "wdc_flood rows run"     "${wfres#*/}" 26
1411:            check "wdc_flood rows correct" "${wfres%/*}" "${wfres#*/}"
1412:
1413:            #  Per-row presence.  A row that silently stops being tested is the
1414:            #  padded-column class.  The probe's format is "%-14s " -- fourteen columns
1415:            #  plus one literal space -- so a name of length L is followed by (15 - L)
1416:            #  spaces; at L=13 that is two and the `^$v  ` anchor still matches, at L=14
1417:            #  it is ONE and THE ROW SILENTLY STOPS BEING TESTED while the gate stays
1418:            #  green.  Longest name here is `overread x2` / `unimpl 2op` (11), so there
1419:            #  are two characters of headroom.  Checked: no name is a prefix of another
1420:            #  followed by a space, so no pattern can match two rows.
1421:            #  The `count "$WFLOG"` on the next line is what identifies this section --
1422:            #  every section's list opens "live" "devsig".
1423:            for v in "live" "devsig" "unimpl x2" "unimpl 2op" "abrt 2nd" "overread x2" "overread -1" "w16 x2" "r16 x2" "datawr x2" "fire3" "interleave" "w16 reset" "wr indep" "w mixed" "r mixed" "r16 reset" "w32 x2" "r32 x2" "r16 value" "w16 value" "overrun x2" "accept ec" "accept w8" "accept r8" "disjoint"; do
1424:                n=$(count "$WFLOG" "^$v  .*ok$")
1425:                check "wdc_flood $v" "$n" 1
1426:            done
1427:        fi
1428:    fi
1429:fi
1430:
1431:#  *** A SOURCE GREP, BECAUSE A STEP-BASED PROBE CANNOT SEE CHANNEL SEMANTICS. ***
1432:#  `fatal(` -> `debug(` at any of the six sites scores a CLEAN SWEEP against every row
1433:#  above: they all single-step, and debug() always prints under stepping (its early-out
1434:#  at core/debugmsg.c:375 fires on `v < 0`, which free-running at verbose 0 gives and
1435:#  stepping does not).  A production guest would get SILENCE while the detector stayed
1436:#  green -- quietly reversing this fork's own warrant for keeping fatal() (dev_asc.c:248-257:
1437:#  under -q verbosity settles at VERBOSITY_ERROR, so a WARNING-level debugmsg is invisible
1438:#  to the boot-log hygiene grep and an ERROR-level one trips #261's break-on-ERROR).
1439:#  Named by a file-reading seat on the pass-2 panel.  Textual, cheap, and the only guard
1470:#      of counting an open set.  The device carries ELEVEN warned_ latches today;
1471:#      this pin still reads 12 because growth cannot reach it."
1472:#
1473:#      Growth reached it by TWO routes the sentence did not consider, and a third
1474:#      dimension nobody had named at all:
1475:#
1476:#        05ec21e  14:00 2026-08-27   the immunity comment lands
1477:#        cf300c0  17:59 2026-08-27   #484 adds a SECOND guarded site re-using
1478:#                                    warned_inbuf_overrun               -> +2
1479:#        d819188  19:29 2026-08-27   #485 adds a COMMENT naming
1480:#                                    warned_unimpl_cmd                  -> +1
1481:#
1482:#      MEMBERS was closed, and correctly so -- a new latch NAME cannot reach it.
1483:#      OCCURRENCES was open: grep -c counts LINES, so a new SITE re-using a named
1484:#      latch increments it.  And TEXT-vs-CODE was never considered: a sentence of
1485:#      prose counted as a guard.
1486:#
1487:#      The comment's own closing rule was right and was not followed:
1488:#      "Never an equality over a set the codebase is expected to add to."
1489:#      d->warned_X OCCURRENCES are exactly such a set.  The members were named,
1490:#      and then an equality was used over their occurrences anyway.
1491:#
1492:#  *** A BARE FLOOR (>= 12) WAS PROPOSED AND MEASURED VACUOUS, so it is not what
1493:#      replaced it.  Deleting ONE latch's two-line guard pair scores 13 and PASSES,
1494:#      restoring the unbounded flood #464 fixed.  Six per-latch ">= 2" rows were
1495:#      also refuted: >= 2 is satisfied by TWO READS AND NO SET. ***
1496:#
1497:#      REPLACED BY TWO EQUALITIES OVER THE NAMED CLOSED SET, per-latch presence,
1498:#      counted over COMMENT-STRIPPED code.  Equality is right for MEMBERS (that set
1499:#      does not grow); what broke was an equality over OCCURRENCES, which this does
1500:#      not count.  Stripping defeats the text-vs-code dimension by CLASS -- an anchor
1501:#      tuned to today's comment survives only by its missing brace.
1502:#
1503:#      MEASURED (artifacts/batteryreds/row5_20260829/killtable.out):
1504:#        BASE 6/6 ok | M1 delete guard pair 5/6 KILLED | M2 gut+comment 5/6 KILLED
1505:#        M4 delete SET keep READ 5/6 KILLED | M3 null medium 0/0 KILLED
1506:#        M5 absent file 0/0 and reports WDC_LATCH_FILE=MISSING, so a missing file
1507:#        and a file with no latches do not render the same.
1508:#
1509:#      Proposed by the opus5 seat; adopted by the fable5 adjudicator over its own
1510:#      twelve-row alternative, 2026-08-29.
1511:wdclatch=$(python3 wdc_latch_census.py 2>/dev/null)
1512:check "wdcflood: census read the file (not MISSING)" \
1513:      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_FILE=[A-Z]+' | cut -d= -f2)" "OK"
1514:check "wdcflood: all six latches have a SET (comment-stripped)" \
1515:      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_SET=[0-9]+' | cut -d= -f2)" "6"
1516:check "wdcflood: all six latches have a READ (comment-stripped)" \
1517:      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_READ=[0-9]+' | cut -d= -f2)" "6"
1518:
1519:#  *** THE TWO ROWS BELOW CLOSE AN L2 FLOOR BREACH THAT THE FIRST VERSION OF THIS
1520:#  BLOCK SHIPPED, and its kill table was CLEAN while the breach was live. ***
1521:#
1522:#  Presence alone (SET/READ above) is blind to a MULTI-SITE latch losing one site.
1523:#  Every mutant in the first table happened to target a single-site latch, so the
1524:#  table ran on a population that structurally could not exhibit the defect:
1525:#
1526:#      if (!d->warned_inbuf_overrun) {  ->  if (1) {     at ONE of its TWO sites
1527:#      => set=2 read=1, SET=6 READ=6, gate GREEN, producer flood unbounded again
1528:#
1529:#  Floor clause (b) demands failure on reinstatement at EVERY fixed site, so that is
1530:#  L2.  Note the inversion: the OLD pin counted OCCURRENCES, so a second site moved
1531:#  it -- loud and wrong but alive.  Presence-only made losing one of two INVISIBLE.
1532:#
1533:#  BALANCED is RELATIONAL (set_count == read_count per latch), so growth increments
1534:#  both sides and it is growth-invariant BY CONSTRUCTION -- not an equality against a
1535:#  frozen literal needing hand-bumps, which is what broke here in the first place.
1536:#  It is the tree's own house idiom: every latch is 1:1 and inbuf_overrun is 2:2.
1537:#
1538:#  DECL restores a tripwire this round would otherwise have DELETED -- the carrier's
1539:#  de-escalation clause one level up.  Replacing a decaying equality with a
1540:#  growth-immune one removes the accidental signal that latch growth used to send.
1541:#  A twelfth latch, or a brand-new unguarded fatal(), now reds until someone looks.
1542:#
1543:#  MEASURED, artifacts/batteryreds/row5_20260829/killtable2.out -- ELEVEN mutants,
1544:#  all killed, BASE 6/6/6/11 clean:
1545:#    E1/E2 neutralise one of two sites 6/6/5/11 | E3 redirect guard 6/6/4/11
1546:#    E7 twelfth latch 6/6/6/12 | E8 READ redirected to a LONGER name 6/5/5/12
1547:#    E6 C99 "//" continuation swallowing a SET 6/6/5/11
1548:#    M1/M2/M4 5/6/5/11 | M3 null medium 0/0/0/0 | M5 absent file reports MISSING
1549:check "wdcflood: every latch BALANCED (set count == read count)" \
1550:      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_BALANCED=[0-9]+' | cut -d= -f2)" "6"
1551:check "wdcflood: device latch population (bump DELIBERATELY, read it first)" \
1552:      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_DECL=[0-9]+' | cut -d= -f2)" "11"
1553:
1554:gate_end
