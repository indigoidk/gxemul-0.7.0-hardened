1395:def _refuse_duplicate_keys():
1396:    with open(os.path.abspath(__file__), "r", encoding="utf-8", errors="replace") as fh:
1397:        src = fh.read()
1398:    #  *** AN ANCHOR THAT NO LONGER MATCHES IS ITSELF A SETUP FAULT, NOT A REASON TO SKIP,
1399:    #  AND THE FIRST VERSION OF THIS GUARD DID `continue`. ***  A flagship review MEASURED
1400:    #  the consequence: `MANIFEST =  {` -- one extra space, valid Python, invisible to a
1401:    #  reader -- makes a literal find() miss, the guard skips, and a planted duplicate key
1402:    #  runs GREEN.  That is this file's own thesis turned on itself: a fault in a guard does
1403:    #  not fail loudly, it stops guarding.  The regex tolerates whitespace, and a miss is
1404:    #  now reported rather than shrugged at.
1405:    for name in ("MANIFEST", "EXEMPT"):
1406:        m = re.search(r"^%s\s*=\s*\{" % re.escape(name), src, re.M)
1407:        if m is None:
1408:            print("PROBEWIRING_SETUP_FAULT  the %s literal could not be located in this"
1409:                  " file's own source." % name)
1410:            print("  The duplicate-key guard cannot run, and a duplicate would pass"
1411:                  " UNSEEN.  Fix the anchor, do not delete the check.")
1412:            sys.exit(2)
1413:        i = m.start()
1414:        j = src.find("\n}", i)
1415:        seen, dupes = set(), []
1416:        for k in re.findall(r'^\s*"([^"]+)"\s*:', src[i:j], re.M):
1417:            (dupes.append(k) if k in seen else None)
1418:            seen.add(k)
1419:        if dupes:
1420:            print("PROBEWIRING_SETUP_FAULT  %s names the same key twice; a dict literal" % name)
1421:            print("  keeps only the LAST and says nothing.  Delete the stale line(s):")
1422:            for k in sorted(set(dupes)):
1423:                print("    %s" % k)
1424:            sys.exit(2)
