1351:                                 "gate row can mean anything, so wiring is a design step first"),
1352:    "hpcmips_ctor_probe.py":    ("2026-09-20",
1353:                                 "rung 2, ~8 s, no rig image -- wants a construction gate"),
1354:    #  Both #494 probes are TWO-LEG DIFFERENTIALS: they take a PRE-FIX binary and
1355:    #  a post-fix one and compare.  No gate builds a second leg, so wiring them is
1356:    #  a change to the instrument -- a single-leg mode asserting only the fix-side
1357:    #  wants against the gate's own binary -- not a line in a gate script.
1358:    "wdc_altoffset_probe.py":     ("2026-09-20",
1359:                                   "two-leg differential; wants a single-leg mode "
1360:                                   "before gate 10 can assert anything"),
1361:    "wdc_altoffset_sig_probe.py": ("2026-09-20",
1362:                                   "two-leg differential AND needs a ciR: CD-ROM rig "
1363:                                   "the battery does not build today"),
1364:    "wdc_altoffset_4bit_probe.py": ("2026-09-20",
1365:                                    "two-leg differential; shares the single-leg-mode "
1366:                                    "debt with its two siblings"),
1367:    "wdc_addtoinbuf_probe.py":     ("2026-09-20",
1368:                                    "two-leg differential AND needs a poisoned CD "
