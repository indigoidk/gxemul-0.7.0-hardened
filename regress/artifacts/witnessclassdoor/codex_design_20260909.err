1870:    def case(name, want_rc, want_text, chk, rg, extra=(), forbid=None):
1871:        p = subprocess.run([sys.executable, chk, "--regress", rg] + list(extra),
1872:                           capture_output=True, text=True)
1873:        out = p.stdout + p.stderr
1874:        ok = (p.returncode == want_rc) and (want_text in out)
1875:        if forbid is not None and forbid in out:
1876:            ok = False
1877:        results.append(ok)
