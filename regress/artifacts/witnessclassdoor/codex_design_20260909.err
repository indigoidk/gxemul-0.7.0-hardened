1477:
1478:def gate_list(regress):
1479:    """The battery's OWN array is the authority on which scripts run.
1480:
1481:    Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
1482:    second-order property worth having: a gate script that exists but was dropped out of
1483:    GATES does not run, so every probe it owned becomes unwired here and this goes RED.
1484:    A glob would have called those probes gated forever.
1485:    """
1486:    run = os.path.join(regress, "run.sh")
1487:    if not os.path.isfile(run):
1488:        return None, "regress/run.sh is missing -- cannot tell which gates run"
1489:    m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
1490:    if not m:
1491:        return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
1492:    return [n + ".sh" for n in m.group(1).split()], None
1493:
1494:
1495:def exec_sites(regress, scripts):
1496:    """Return (hits, ignored, missing).
1497:
1498:    hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
1499:    ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
1500:    """
1501:    hits, ignored, missing = {}, [], []
1502:    for script in scripts:
1503:        path = os.path.join(regress, script)
1504:        if not os.path.isfile(path):
1505:            missing.append(script)
1506:            continue
1507:        lines = read(path).splitlines()
1508:        #  One-level variable map, from this file only.  gate_hygiene really does write
1509:        #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
1510:        #  one level would report a genuinely gated probe as unwired -- and a false red is
1511:        #  how a rule gets switched off.
1512:        varmap = {}
1513:        for ln in lines:
1514:            if ln.lstrip().startswith("#"):
1515:                continue
1516:            a = ASSIGN_RE.match(ln)
1517:            if a and ".py" in a.group(2):
1518:                varmap[a.group(1)] = unquote(a.group(2))
1519:        #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
1520:        #  flagship review MEASURED it: an invocation-shaped line inside a
1521:        #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
1522:        #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
1523:        #  its own invocation is an entirely natural shape.  Latent rather than live -- every
1524:        #  `<<` site in the battery today is a data table or a python program body, none
1525:        #  carrying an interpreter plus a probe in body position -- but this is the
1526:        #  dangerous direction: it does not fail loudly, it stops demanding a gate.
1527:        #
1528:        #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
1529:        #  that GENERATES a script the gate then runs is genuine wiring one level away, and
1530:        #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
1531:        #  That is the right error to make.
1532:        body = set()
1533:        pend = None
1534:        for no, ln in enumerate(lines, 1):
1535:            if pend is not None:
1536:                body.add(no)
1537:                if ln.strip() == pend:
1538:                    pend = None
1539:                continue
1540:            h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
1541:            if h and not ln.lstrip().startswith("#"):
1542:                pend = h.group(1)
1543:
1544:        for no, ln in enumerate(lines, 1):
1545:            if ln.lstrip().startswith("#") or no in body:
1546:                continue
1547:            for m in INTERP_RE.finditer(ln):
1548:                if not CMDPOS_RE.match(ln[: m.start()]):
1549:                    continue
1550:                toks = ln[m.end():].split()
1551:                if toks and toks[0].startswith("-c"):
1552:                    continue          # an inline program, not a script invocation
1553:                for tok in toks:
1554:                    t = unquote(tok)
1555:                    v = VAR_RE.match(t)
1556:                    if v:
1557:                        t = varmap.get(v.group(1), "")
1558:                    if not t.endswith(".py"):
1559:                        continue
1560:                    d, b = os.path.split(t)
1561:                    if d in HERE_DIRS:
1562:                        hits.setdefault(b, []).append("%s:%d" % (script, no))
1563:                    else:
1564:                        #  #471: a NESTED invocation is keyed by its RELATIVE PATH, not
1565:                        #  its basename.  Before this, a gate invoking
1566:                        #  `artifacts/.../gdrom_pio_null_probe.py` was filed as an
1567:                        #  EXTERNAL reference and IGNORED -- so the detector #465 wired
1568:                        #  by hand still reported UNWIRED once the scan could see it.
1569:                        #
1570:                        #  Path keys are also what makes the re-key SAFE: two detectors
1571:                        #  sharing a basename in different directories stay distinct,
1572:                        #  where basename keys would mark BOTH gated when only one is.
1573:                        rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
1574:                        if os.path.isfile(os.path.join(regress, rel)):
1575:                            hits.setdefault(rel, []).append("%s:%d" % (script, no))
1576:                        else:
1577:                            ignored.append("%s:%d  %s" % (script, no, t))
1578:                    break             # the first .py argument is the script
1579:    return hits, ignored, missing
1580:
1581:
1582:#  STANDALONE WORDS ONLY.  The first draft used a plain substring and reported
1583:#  mips_fold_probe.py as self-labelled "witness" -- its summary line reads "the MIPS
1584:#  fold-witness COUNTERS", where the word names a counter, not the artefact.  That is the
1585:#  substring trap in the one place in this file that was allowed to be a heuristic, and an
1586:#  advisory that cries wolf is an advisory nobody reads.  MEASURED: with the hyphen guard
1587:#  the noise line disappears and pit8253's real disagreement still fires.
1588:_LBL_W = re.compile(r"(?<![\w-])witness(?![\w-])", re.I)
1589:_LBL_D = re.compile(r"(?<![\w-])detector(?![\w-])", re.I)
1590:
1591:
1592:def domain(regress):
1593:    """The .py artefacts this check governs, and (mode, why) describing how it decided.
1594:
1595:    *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
1596:    first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
1597:    round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
1598:    check went red -- correctly identifying a real unwired detector, but firing at a
1599:    file its author had not yet offered for commit, in someone else's working tree.
1600:
1601:    `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
1602:    add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
1603:    precisely when the author is present to classify it.  A scratch probe that is never
1604:    staged defends nothing in a fresh clone either, so it is honestly out of scope.
1605:
1606:    FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
1607:    git cannot answer, and a fallback that quietly changes what a check governs is the
1608:    kind of silent scope change this harness keeps being bitten by.  So the mode is
1609:    printed on the summary line.
1610:    """
1611:    try:
1612:        p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
1613:                           capture_output=True, text=True)
1614:        if p.returncode == 0:
1615:            #  #471: NO `"/" not in f` FILTER.  Its docstring always claimed "every
1616:            #  committed DETECTOR under regress/", and the filter made that false --
1617:            #  the checker could not see below top level, which is exactly where
1618:            #  #465 shipped a detector that no gate ran.
1619:            #
1620:            #  `git ls-files` yields paths RELATIVE to regress/, so a top-level file
1621:            #  still arrives as a bare basename and every existing MANIFEST key keeps
1622:            #  matching unchanged.  Only nested files gain a path key.
1623:            files = sorted(f for f in p.stdout.split()
1624:                           if f.endswith(".py")
1625:                           and os.path.isfile(os.path.join(regress, f)))
1626:            if files:
1627:                return files, "tracked-or-staged"
1628:    except OSError:
1629:        pass
1630:    #  #471: the FALLBACK must descend too.  Leaving it flat would re-create the blind
1631:    #  spot on any machine where git cannot answer -- a check whose coverage depends
1632:    #  on which branch it took is the shape this file exists to refuse.
1633:    found = []
1634:    for dirpath, dirnames, filenames in os.walk(regress):
1635:        dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
1636:        for f in filenames:
1637:            if f.endswith(".py"):
1638:                rel = os.path.relpath(os.path.join(dirpath, f), regress)
1639:                found.append(rel.replace(os.sep, "/"))
1640:    return sorted(found), "on-disk (git could not answer)"
1641:
