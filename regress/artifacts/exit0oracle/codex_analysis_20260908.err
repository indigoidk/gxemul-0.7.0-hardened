 139: TEX_BASE    = 0xb5001600
 140: TEX_HI_OFF  = 0x0d8               # the last 8-byte slot inside CRIME_RE_TEX + 0xe0
 141: TEX_RD_DECL = "unimplemented read from CRIME_RE_TEX -- declined."
