"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$auditScript = @'"'
import ast
from pathlib import Path
names=['gdrom_cond_probe.py','gdrom_decline_probe.py','gdrom_default_probe.py','gdrom_toclen_probe.py','pcc2_width_probe.py','pcc2_width_witness.py','sgi_de_width_probe.py','sgi_de_primop_probe.py','sgi_re_unmapped_probe.py','sgi_re_width_probe.py']
for name in names:
    tree=ast.parse((Path('regress')/name).read_text())
    parents={c:n for n in ast.walk(tree) for c in ast.iter_child_nodes(n)}
    named_collections={t.id:n.value for n in tree.body if isinstance(n,ast.Assign) and isinstance(n.value,(ast.Tuple,ast.List)) for t in n.targets if isinstance(t,ast.Name)}
    sites=expanded=compound_sites=compound_expanded=0
    print('\\nFILE',name)
    for n in sorted(ast.walk(tree),key=lambda n:getattr(n,'lineno',0)):
        if not (isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='row'):
            continue
        w=n.args[2] if len(n.args)>2 else next((k.value for k in n.keywords if k.arg=='want'),None)
        if not(isinstance(w,ast.Constant) and isinstance(w.value,str) and 'exit0' in w.value):
            continue
        multiplier=1
        a=n
        names_at_site=[]
        while a in parents:
            a=parents[a]
            if isinstance(a,ast.For):
                seq=named_collections.get(a.iter.id) if isinstance(a.iter,ast.Name) else a.iter
                if not isinstance(seq,(ast.Tuple,ast.List)):
                    raise ValueError('Unresolved loop')
                multiplier*=len(seq.elts)
                if isinstance(a.target,ast.Tuple):
                    names_at_site=[ast.unparse(e.elts[0]) for e in seq.elts]
        exact=w.value=='exit0'
        sites+=int(exact)
        expanded+=multiplier*int(exact)
        compound_sites+=int(not exact)
        compound_expanded+=multiplier*int(not exact)
        print(n.lineno,'EXACT' if exact else 'COMPOUND','x'+str(multiplier),ast.unparse(n.args[0]),w.value,'LOOP LABELS',','.join(names_at_site))
    print('TOTAL exact',sites,expanded,'compound',compound_sites,compound_expanded)
    if name=='pcc2_width_probe.py':
        for n in ast.walk(tree):
            if isinstance(n,(ast.For,ast.Assign)):
                target=n.target if isinstance(n,ast.For) else ast.Tuple(elts=n.targets,ctx=ast.Store())
                if any(isinstance(x,ast.Name) and x.id in ('want','landed','rdv') for x in ast.walk(target)):
                    print('DYNAMIC WANT BINDING',n.lineno,ast.unparse(target),'=',ast.unparse(n.iter if isinstance(n,ast.For) else n.value))
