1354:                         + ["put h 0x%x, 0xaabb" % (PCC2 + MASK)]
1355:                         + program([LD_BU(4, MASK)], at=CODE + 0x100) + ["print r4"])
1356: row("op mask", how, "exit0", "debugger put h at odd MASK survives")
