 143: def anchor(arr, idx, val, kind):
 144:     """*** THE ANCHOR CHANNEL, clause (f). ***  The store's OWN debug() names the
 145:     INDEX it wrote, so this literal pins WHICH CELL the address resolved to --
 146:     not merely that some cell round-tripped.  A translation that slides the whole
 147:     window keeps every value distinct and still reddens here.  Nothing is added to
 148:     the READ path to make this work: the channel already exists on the write."""
 149:     if kind == "hw":
 150:         return "d->%s[%i] = 0x%04x" % (arr, idx, (val >> 48) & 0xffff)
 151:     return "[ d->%s[%i] = 0x%08x, [%i] = 0x%08x ]" % (
 152:         arr, idx, (val >> 32) & 0xffffffff, idx + 1, val & 0xffffffff)
