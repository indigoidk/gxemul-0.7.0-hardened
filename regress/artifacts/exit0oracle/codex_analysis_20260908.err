import ast
from pathlib import Path
paired_lines={'gdrom_decline_probe.py':set(),'gdrom_default_probe.py':{1272},'gdrom_toclen_probe.py':{279,418},'pcc2_width_probe.py':{611,619,625,629,633,1340,1344,1356},'pcc2_width_witness.py':{201,210,216,222},'sgi_de_width_probe.py':{319,385},'sgi_de_primop_probe.py':{460,474},'sgi_re_unmapped_probe.py':{386,425,493},'sgi_re_width_probe.py':set()}
totals=[0,0,0,0]
for name,paired in paired_lines.items():
    tree=ast.parse((Path('regress')/name).read_text())
    parents={c:n for n in ast.walk(tree) for c in ast.iter_child_nodes(n)}
    collections={t.id:n.value for n in tree.body if isinstance(n,ast.Assign) and isinstance(n.value,(ast.Tuple,ast.List)) for t in n.targets if isinstance(t,ast.Name)}
    counts=[0,0,0,0]
    for n in ast.walk(tree):
        if not(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='row' and len(n.args)>2 and isinstance(n.args[2],ast.Constant) and n.args[2].value=='exit0'):
            continue
        m=1
        a=n
        while a in parents:
            a=parents[a]
            if isinstance(a,ast.For):
                seq=collections[a.iter.id] if isinstance(a.iter,ast.Name) else a.iter
                m*=len(seq.elts)
        c=0 if n.lineno in paired else 1
        counts[c]+=1
        counts[c+2]+=m
    print(name,'paired/alone call sites',counts[:2],'paired/alone expanded',counts[2:])
    totals=[a+b for a,b in zip(totals,counts)]
print('TOTAL',totals)
