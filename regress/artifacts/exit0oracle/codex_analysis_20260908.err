 123: def row(name, got, want, note=""):
 124:     ok = (got == want)
 125:     rows.append((name, ok))
 126:     print("%-16s %-14s %-14s %-44s %s" % (name, str(got), str(want), note,
 127:                                           "ok" if ok else "FAIL"))
 128:     return ok
