 154: #            name        base          symbol               accept-probe text
 155: SITES = [
 156:  ("tlb_a",    0xb5001000, "CRIME_RE_TLB_A",    "d->re_tlb_a[4] = 0x1122"),
 157:  ("tlb_b",    0xb5001200, "CRIME_RE_TLB_B",    "d->re_tlb_b[4] = 0x1122"),
 158:  ("tlb_c",    0xb5001400, "CRIME_RE_TLB_C",    "d->re_tlb_c[4] = 0x1122"),
 159:  ("tex",      0xb5001600, "CRIME_RE_TEX",      "d->re_tex[1] = 0x1122"),
 160:  ("linear_a", 0xb5001700, "CRIME_RE_LINEAR_A",
 161:               "d->re_linear_a[2] = 0x11223344, [3] = 0x55667788"),
 162:  ("linear_b", 0xb5001780, "CRIME_RE_LINEAR_B",
 163:               "d->re_linear_b[2] = 0x11223344, [3] = 0x55667788"),
 164: ]
