  84: 
  85: BIN = sys.argv[1] if len(sys.argv) > 1 else "build/gxemul"
  86: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
  87: 
  88: DUMMY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dummy_kernel.bin")
  89: if not os.path.exists(DUMMY):
