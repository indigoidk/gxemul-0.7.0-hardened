 959: #
 960: #  The harm is not a kill: it CORRUPTS AN IN-FLIGHT COMMAND.  A guest assembling a packet
 961: #  that happens to write a bad COND value mid-sequence has its byte counter silently
 962: #  rewound, so the twelve-byte packet never completes and the command never dispatches.
 963: #
 964: #  The session interleaves the decline INTO the packet, which no other row does: arm with
 965: #  0xa0, three data words, a DECLINED COND write, three more.  On the correct build the
 966: #  count reaches 12 and dispatches; under the mutant it is rewound to 0 at the decline,
 967: #  reaches only 6, and the dispatch token never appears.
 968: #
 969: #  *** AND IT IS ANOTHER SIBLING-PARITY MISS: R13 was written for the ACCEPT arm and the
 970: #  identical statement in the DECLINE arm went unwatched. ***  Same field, same file, two
 971: #  lines apart in intent.
 972: A = Addr(CODE)
 973: t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
 974:                         + store16(GDROM_DATA, 0x1111, A)
 975:                         + store16(GDROM_DATA, 0x2222, A)
 976:                         + store16(GDROM_DATA, 0x3333, A)
 977:                         + store16(GDROM_COND, 0x0055, A)
 978:                         + store16(GDROM_DATA, 0x4444, A)
 979:                         + store16(GDROM_DATA, 0x5555, A)
 980:                         + store16(GDROM_DATA, 0x6666, A))
 981: m = COND_RE.search(t)
 982: row("R13b mid pkt", "%d|%s" % (t.count(DISPATCH_TEXT), m.group(1) if m else "absent"),
 983:     "1|55", "a DECLINE mid-packet does not rewind cmd_count")
 984: 
 985: # ------------------------------------------------ THE TRAILING CONTROL, AND WHY IT EXISTS
 986: #  *** THE OPENING CONTROLS BRACKET THE START OF THE RUN AND NOTHING BRACKETS THE END.
 987: #  MEASURED: a contended run scored 18/25 with GDROMCOND_CONTROL=OK -- seven late rows
 988: #  reading `absent` or `ABSENT-READ-FAILED`, and one session dying outright -- while the
 989: #  four control rows, all of which ran FIRST, were green. ***
 990: #
 991: #  A reader seeing CONTROL=OK is entitled to read the row scores as product results.  On
 992: #  that run they were apparatus failures, and the header said so nowhere.  The controls
 993: #  were not wrong; they were EARLY, and a per-run control cannot see a per-session
 994: #  degradation that begins after it.
 995: #
 996: #  Re-running ONE liveness and ONE device-signature row at the END costs two sessions and
 997: #  converts "the rig was alive when we started" into "the rig was alive throughout".
 998: #  A run whose trailing control is dead has measured nothing after the point it died,
 999: #  and the score must not be read as a product result.
1000: A = Addr(CODE)
1001: t, alive, how = session(["put w 0x8c001800, 0x%x" % LIVE] + load32(0x8c001800, A))
1002: row("Zlive end", printed(t, "r2"), "0x%x" % LIVE,
1003:     "TRAILING LIVENESS: the rig was alive at the END too")
1004: 
1005: A = Addr(CODE)
1006: t, alive, how = session(store16(GDROM_CNTLO, 0x1234, A) + load16(GDROM_CNTLO, A))
1007: row("Zdevsig end", printed(t, "r2"), "0x34",
1008:     "TRAILING DEVSIG: the device still answered at the END")
1009: 
1010: #  The END control is reported SEPARATELY from the opening one, because "died partway"
1011: #  and "never started" are different facts and must not render the same.
1012: print("")
1013: print("GDROMCOND_CONTROL_END=%s"
1014:       % ("OK" if rows[-1][1] and rows[-2][1] else "DEAD"))
1015: 
1016: # ------------------------------------------------------------------------------- result
1017: ok = sum(1 for _, o in rows if o)
1018: print("")
1019: print("GDROMCOND_PROBE_RESULT=%d/%d" % (ok, len(rows)))
1020: print("GDROMCOND_PROBE_DONE")
1021: sys.exit(0 if ok == len(rows) else 1)

