  46: 
  47: WHY A SURVIVE-ONLY ROW SET WOULD HAVE BEEN VACUOUS, measured rather than assumed.
  48: The obvious clause-(d) mutant weakens `!= 408` to `> 408`.  Then cnt=407 falls THROUGH to
  49: alloc_data(407), and the writer's hardcoded indices run to byte 407 -- a one-byte heap
  50: overflow that a normal -O3 build does not necessarily fault on.  A row that only asks
  51: "did the host survive?" scores that mutant GREEN while the defect the round closed is
  52: back.  The discriminator is a SECOND OBSERVABLE CHANNEL:
  53: 
  54:     cnt == 408 accepted  ->  d->data != NULL  ->  tail sets COND_DATA_AVAIL   -> 0xa8
  55:     cnt != 408 declined  ->  d->data == NULL  ->  tail CLEARS it, cnt = 0     -> 0xa0
  56: 
  57: Both values are DERIVED, not fitted: the guest writes 0xa0 to GDROM_COND to start the
  58: command, and the common tail either ORs in COND_DATA_AVAIL (0x08) or masks it out.  The
  59: `case GDROM_COND:` read arm returns `d->cond` unmodified.
  60: 
  61: RUNG 3: every access is a real guest instruction through real address decode and real
  62: memory_rw, on the UNMODIFIED committed `dreamcast` machine description.  Nothing is
  63: device_add'ed and no machine is introduced to reach the site.
  64: 
  65: DREAMCAST NEEDS -x (two console inputs) or the session dies for a CONFIGURATION reason and
  66: reports the same "died" a defect would.
  67: 
  68: USAGE:  gdrom_toclen_probe.py <gxemul-binary> <kernel-image> [extra args...]
  69: """
  70: import os
  71: import pty
  72: import re
  73: import select
  74: import sys
  75: import time
  76: 
  77: BIN = sys.argv[1]
  78: KERNEL = sys.argv[2]
  79: EXTRA = sys.argv[3:]
  80: 
  81: CODE = 0x8c001000
  82: SCRATCH = 0x8c001800
  83: 
  84: GDROM_DATA = 0xa05f7080
  85: GDROM_BUSY = 0xa05f7018
  86: GDROM_CNTLO = 0xa05f7090
  87: GDROM_CNTHI = 0xa05f7094
  88: GDROM_COND = 0xa05f709c
  89: #  SYSASIC_EVENT_GDROM is 32 (thirdparty/dreamcast_sysasicvar.h), and the macro
  90: #  addresses SYSASIC_BASE + 4*(e>>5) -- so event 32 lands in pending_irq[1], bit
  91: #  32 & 31 == 0.  The ASIC's read arm is `odata = d->pending_irq[r]` with NO
  92: #  clear-on-read, so the bit LATCHES and a later guest load can still see it.
  93: #  gdrom_default_probe.py already reads pending_irq[0] at 0xa05f6900, so the
  94: #  technique is in-tree precedent rather than invention.
  95: SYSASIC_PEND1 = 0xa05f6904
  96: SYSASIC_GDROM_BIT = 0x00000001
  97: SH4_IPRD = 0xffd00010
  98: IPRD_RESET = 0xda74
  99: LIVE = 0x12345678
 100: 
 101: BRA_SELF = 0xaffe
 102: NOP = 0x0009
 103: 
 104: #  The decline diagnostic this round adds.  Latched N=1 per device instance.
 105: DECLINE = re.compile(r"Read TOC with cnt=-?\d+, not 408 -- declined")
 106: 
 107: 
 108: def MOVW_ST(n, m):
 109:     return 0x2001 | (n << 8) | (m << 4)
 110: 
 111: 
 112: def MOVW_LD(n, m):
 113:     return 0x6001 | (n << 8) | (m << 4)
 114: 
 115: 
 116: def MOVL_ST(n, m):
 117:     return 0x2002 | (n << 8) | (m << 4)
 118: 
 119: 
 120: def MOVL_LD(n, m):
 121:     return 0x6002 | (n << 8) | (m << 4)
 122: 
 123: 
 124: rows = []
 125: 
 126: 
 127: def row(name, got, want, note=""):
 128:     ok = (got == want)
 129:     rows.append((name, ok))
 130:     print("%-14s %-12s %-12s %-46s %s" % (name, got, want, note,
 131:                                           "ok" if ok else "FAIL"))
 132:     return ok
 133: 
 134: 
 135: def session(cmds, settle=8.0, spin=2.0, step=0.30):
 136:     pid, fd = pty.fork()
 137:     if pid == 0:
 138:         os.execv(BIN, [BIN, "-V", "-x", "-E", "dreamcast", "-M", "64"] +
 139:                  EXTRA + [KERNEL])
 140:         os._exit(127)
 141:     buf = ""
 142: 
 143:     def rd(t):
 144:         nonlocal buf
 145:         end = time.time() + t
 146:         while time.time() < end:
 147:             r, _, _ = select.select([fd], [], [], 0.25)
 148:             if not r:
 149:                 continue
 150:             try:
 151:                 d = os.read(fd, 65536)
 152:             except OSError:
 153:                 return False
 154:             if not d:
 155:                 return False
 156:             buf += d.decode("latin-1", "replace")
 157:         return True
 158: 
 159:     alive = rd(settle)
 160:     if alive:
 161:         for i, c in enumerate(cmds):
 162:             try:
 163:                 os.write(fd, (c + "\n").encode("latin-1"))
 164:             except OSError:
 165:                 alive = False
 166:                 break
 167:             if not rd(spin if i == len(cmds) - 1 else step):
 168:                 alive = False
 169:                 break
 170:     try:
 171:         os.write(fd, b"quit\n")
 172:         rd(0.6)
 173:     except OSError:
 174:         pass
 175:     try:
 176:         os.close(fd)
 177:     except OSError:
 178:         pass
 179:     how = "nostatus"
 180:     try:
 181:         _, stat = os.waitpid(pid, 0)
 182:         if os.WIFSIGNALED(stat):
 183:             how = "sig%d" % os.WTERMSIG(stat)
 184:         elif os.WIFEXITED(stat):
 185:             how = "exit%d" % os.WEXITSTATUS(stat)
 186:     except OSError:
 187:         pass
 188:     return buf, alive, how
 189: 
 190: 
 191: def printed(t, reg):
 192:     m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
 193:     return m.group(1) if m else "absent"
 194: 
 195: 
 196: class Addr(object):
 197:     def __init__(self, base):
 198:         self.a = base
 199: 
 200:     def take(self):
 201:         a = self.a
 202:         self.a += 0x40
 203:         return a
 204: 
 205: 
 206: def run(ops, at):
 207:     put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(ops)]
 208:     put += ["put h 0x%x, 0x%04x" % (at + 2 * len(ops), BRA_SELF),
 209:             "put h 0x%x, 0x%04x" % (at + 2 * len(ops) + 2, NOP)]
 210:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
 211: 
 212: 
 213: def store16(reg, val, A):
 214:     return ["r7=0x%x" % reg, "r8=0x%04x" % val] + run([MOVW_ST(7, 8)], A.take())
 215: 
 216: 
 217: def load16(reg, A, dest=2):
 218:     return ["r1=0x%x" % reg, "r%d=0" % dest] + \
 219:         run([MOVW_LD(dest, 1)], A.take()) + ["print r%d" % dest]
 220: 
 221: 
 222: def packet(words, A):
 223:     setup = ["r7=0x%x" % GDROM_DATA]
 224:     for i, w in enumerate(words):
 225:         setup.append("r%d=0x%04x" % (8 + i, w))
 226:     return setup + run([MOVW_ST(7, 8 + i) for i in range(len(words))], A.take())
 227: 
 228: 
 229: CMD_TOC = [0x0014] * 6
 230: 
 231: 
 232: def stage_toc(A, cnt):
 233:     """CNTLO/CNTHI = cnt, COND = 0xa0, then the Read-TOC packet.  9 accesses."""
 234:     return (store16(GDROM_CNTLO, cnt & 0xff, A) +
 235:             store16(GDROM_CNTHI, (cnt >> 8) & 0xff, A) +
 236:             store16(GDROM_COND, 0xa0, A) +
 237:             packet(CMD_TOC, A))
 238: 
 239: 
 240: # ------------------------------------------------------------------- controls
 241: A = Addr(CODE)
 242: t, alive, how = session(["r7=0x%x" % SCRATCH, "r8=0x%08x" % LIVE,
 243:                          "r1=0x%x" % SCRATCH, "r2=0"] +
 244:                         run([MOVL_ST(7, 8), MOVL_LD(2, 1)], A.take()) +
 245:                         ["print r2"])
 246: row("live", printed(t, "r2") if alive else "died", "0x%x" % LIVE,
 247:     "LIVENESS: guest store then guest load, through RAM")
 248: 
 249: A = Addr(CODE)
 250: t, alive, how = session(["r1=0x%x" % SH4_IPRD, "r2=0"] +
 251:                         run([MOVL_LD(2, 1)], A.take()) + ["print r2"])
 252: g = printed(t, "r2") if alive else "died"
 253: row("devsig sh4", ("0x%x" % (int(g, 16) & 0xffff)) if g.startswith("0x") else g,
 254:     "0x%x" % IPRD_RESET, "DEVSIG: SH4 IPRD reset value, RAM reads 0")
 255: 
 256: A = Addr(CODE)
 257: t, alive, how = session(["r1=0x%x" % GDROM_BUSY, "r2=0"] +
 258:                         run([MOVL_LD(2, 1)], A.take()) + ["print r2"])
 259: g = printed(t, "r2") if alive else "died"
 260: row("gdrom map", ("mapped" if g.startswith("0x") else g) if alive else "died",
 261:     "mapped", "GDROM_BUSY read is served, not a paddr fault")
 262: print("TOCLEN_CONTROL=%s" % ("OK" if all(ok for _, ok in rows) else "DEAD"))
 263: 
 264: # ------------------------------------------------------------------- accept side
 265: #
 266: #  THE DE-ESCALATION ACCEPT ROWS.  This round removed a host-fatal guard, which
 267: #  deleted the accidental tripwire that made guard growth self-announcing: before
 268: #  the fix, narrowing the accept set meant exit(1) on the first legal write.  These
 269: #  rows pin the accept side so a grown guard reddens instead of going quiet.
 270: A = Addr(CODE)
 271: t, alive, how = session(stage_toc(A, 408) +
 272:                         ["r1=0x%x" % GDROM_DATA, "r2=0", "r3=0"] +
 273:                         run([MOVW_LD(2, 1), MOVW_LD(3, 1)], A.take()) +
 274:                         ["print r2", "print r3"])
 275: row("ok data0", printed(t, "r2") if alive else "died", "0x10",
 276:     "ACCEPT: synthesized TOC halfword 0, device-only value")
 277: row("ok data1", printed(t, "r3") if alive else "died", "0xffff9600",
 278:     "ACCEPT: TOC halfword 1, sign-extended by mov.w")
 279: row("ok surv", how, "exit0", "ACCEPT: the legal length must not kill the host")
 280: 
 281: A = Addr(CODE)
 282: t, alive, how = session(stage_toc(A, 408) + load16(GDROM_COND, A))
 283: g = printed(t, "r2") if alive else "died"
 284: row("ok cond", ("0x%x" % (int(g, 16) & 0xff)) if g.startswith("0x") else g,
 285:     "0xa8", "ACCEPT: 0xa0 written, COND_DATA_AVAIL(0x08) SET by the tail")
 286: 
 287: # ------------------------------------------------------------------- the decline
 288: #
 289: #  `bad surv`/`zero surv` are the reinstatement carriers: they pinned exit1 on the
 290: #  committed build and pin exit0 now.
 291: A = Addr(CODE)
 292: t1, alive1, how1 = session(stage_toc(A, 407))
 293: row("bad surv", how1, "exit0",
 294:     "cnt=407 declines instead of ending the host")
 295: row("bad says", "yes" if len(DECLINE.findall(t1)) >= 1 else "no", "yes",
 296:     "the decline ANNOUNCES itself -- not a silent refusal")
 297: 
 298: A = Addr(CODE)
 299: t2, alive2, how2 = session(stage_toc(A, 0))
 300: row("zero surv", how2, "exit0",
 301:     "cnt=0 declines too -- the malloc(0) end of the same guard")
 302: 
 303: #  *** THE CLAUSE-(d) CARRIER, and the reason this probe reads COND at all. ***
 304: #  A guard weakened from `!= 408` to `> 408` lets cnt=407 reach alloc_data(407)
 305: #  while the writer indexes byte 407 -- a one-byte heap overflow that need not
 306: #  fault, so `bad surv` alone would score it GREEN.  Under that mutant d->data is
 307: #  non-NULL, so the tail SETS COND_DATA_AVAIL and this row reads 0xa8, not 0xa0.
 308: A = Addr(CODE)
 309: t, alive, how = session(stage_toc(A, 407) + load16(GDROM_COND, A))
 310: g = printed(t, "r2") if alive else "died"
 311: row("bad cond", ("0x%x" % (int(g, 16) & 0xff)) if g.startswith("0x") else g,
 312:     "0xa0", "DECLINE: COND_DATA_AVAIL stays CLEAR -- kills the `> 408` mutant")
 313: 
 314: #  *** THE break-vs-return ROWS.  ADDED AFTER A MEASURED L1: this detector scored
 315: #  13/13 against `break;` -> `return;`, and the product comment beside the fix
 316: #  CLAIMS that edit "would skip that event and leave the guest waiting forever"
 317: #  while shipping no row for it.  That is the CLAIM -> ROW check, unrun, on the
 318: #  round's own diff.  Found by the opus seat on Round 2's design panel. ***
 319: #
 320: #  *** AND `bad cond` STRUCTURALLY CANNOT SEE IT, which is worth stating because
 321: #  it is the clause-(d) carrier and looks like it should. ***  The guest writes
 322: #  0xa0 to start the command, and BIT 3 IS ALREADY CLEAR in 0xa0.  So the tail's
 323: #  `d->cond &= ~COND_DATA_AVAIL` is a NO-OP on this path: `break` (tail runs,
 324: #  clears an already-clear bit) and `return` (tail never runs) both leave 0xa0.
 325: #  A row can only separate them by observing something the TAIL WRITES.
 326: #
 327: #  On the decline path the tail writes exactly two things -- `d->cnt = 0` and the
 328: #  SYSASIC event -- so there is one row each, and between them they pin both
 329: #  halves of what the comment claims.
 330: A = Addr(CODE)
 331: t, alive, how = session(stage_toc(A, 407) + load16(GDROM_CNTLO, A))
 332: g = printed(t, "r2") if alive else "died"
 333: row("bad cnt", ("0x%x" % (int(g, 16) & 0xff)) if g.startswith("0x") else g,
 334:     "0x0", "DECLINE: the tail zeroed d->cnt -- `return` leaves 0x97")
 335: 
 336: #  The event itself, pinned directly rather than inferred.  This is the stronger
 337: #  of the two: `bad cnt` shows the tail RAN, this shows the guest was actually
 338: #  TOLD the command completed -- which is the property that stops a hang.
 339: A = Addr(CODE)
 340: t, alive, how = session(stage_toc(A, 407) +
 341:                         ["r1=0x%x" % SYSASIC_PEND1, "r2=0"] +
 342:                         run([MOVL_LD(2, 1)], A.take()) + ["print r2"])
 343: g = printed(t, "r2") if alive else "died"
 344: row("bad event",
 345:     ("set" if (int(g, 16) & SYSASIC_GDROM_BIT) else "clear")
 346:     if g.startswith("0x") else g,
 347:     "set", "DECLINE: SYSASIC_EVENT_GDROM fired -- `return` would skip it")
 348: 
 349: #  *** THE ZERO AND OVER-LENGTH COND ROWS.  ADDED AFTER PASS 2 MEASURED TWO MORE
 350: #  ESCAPES, ONE OF WHICH RE-OPENS THE HEAP OVERFLOW THIS ROUND CLOSES. ***
 351: #
 352: #  I applied the survive-only-is-vacuous lesson to cnt=407 and NOT to the other two
 353: #  ends of the same guard.  `zero surv` and (as first drafted) the over-length case
 354: #  ask only "did the host survive?", and at this site that question is answerable
 355: #  YES while the defect is fully restored:
 356: #
 357: #    EXEMPT-ZERO   `d->cnt != 408`  ->  `d->cnt != 408 && d->cnt != 0`
 358: #        cnt=0 is then ACCEPTED -> alloc_data(0) -> malloc(0), both memsets become
 359: #        no-ops, and the writer still stores through d->data[101*4+3].  **408 bytes
 360: #        into a zero-byte allocation** -- the round's own A2 defect, back -- and a
 361: #        write past a minimal chunk need not fault, so `zero surv` reads exit0.
 362: #        Found by the glm seat on pass 2; predicted 15/15 clean before this row.
 363: #
 364: #    LOWER-BOUND   `d->cnt != 408`  ->  `d->cnt < 408`
 365: #        cnt >= 409 is then ACCEPTED.  No overflow (409 >= 408), so nothing dies --
 366: #        but the guard now admits lengths it must refuse, and NO SHIPPED ROW USED A
 367: #        VALUE ABOVE 408.  Found independently by the grok and agy seats, both
 368: #        predicting a 15/15 sweep.
 369: #
 370: #  Both are killed the same way the `> 408` mutant was: by asking the DECLINE
 371: #  question on the COND channel instead of the survival question.
 372: A = Addr(CODE)
 373: t, alive, how = session(stage_toc(A, 0) + load16(GDROM_COND, A))
 374: g = printed(t, "r2") if alive else "died"
 375: row("zero cond", ("0x%x" % (int(g, 16) & 0xff)) if g.startswith("0x") else g,
 376:     "0xa0", "DECLINE: cnt=0 declines -- kills the exempt-zero mutant")
 377: 
 378: A = Addr(CODE)
 379: t4, alive4, how4 = session(stage_toc(A, 409))
 380: row("over surv", how4, "exit0", "cnt=409 declines instead of ending the host")
 381: 
 382: A = Addr(CODE)
 383: t, alive, how = session(stage_toc(A, 409) + load16(GDROM_COND, A))
 384: g = printed(t, "r2") if alive else "died"
 385: row("over cond", ("0x%x" % (int(g, 16) & 0xff)) if g.startswith("0x") else g,
 386:     "0xa0", "DECLINE: cnt=409 declines -- kills the `< 408` mutant")
 387: 
 388: #  THE LATCH.  Two bad TOCs in one session must print exactly ONE diagnostic.
 389: #  fatal() cannot be silenced by -q, so an unlatched guest-drivable message is a
 390: #  flood; N=1 per device instance is the house idiom.
 391: #  *** THE SECOND DECLINE IS READ BACK, AND THAT ROW IS THE ONE THAT KILLS THE
 392: #  LATCH-STATE MUTANT.  Added after pass 2; found by ONE seat of nine. ***
 393: #
 394: #  `if (d->cnt != 408 && !(d->warned & GDROM_W_TOCLEN))` -- the nested-if collapse,
 395: #  or equivalently a brace slip that moves `break` inside the latch block -- was
 396: #  measured to sweep the 18-row version CLEAN while re-opening the heap overflow:
 397: #
 398: #    * every NON-latch row runs its own fresh session, where `warned` is clear, so
 399: #      the mutant behaves identically to the correct build and every row passes;
 400: #    * the latch session declines the FIRST bad TOC (setting the bit) and then
 401: #      ACCEPTS the second, because the latch bit now gates the guard itself.  One
 402: #      message is still printed and the host still survives, so `latch once` = 1
 403: #      and `latch surv` = exit0 BOTH PASS -- while the second bad TOC reached
 404: #      alloc_data(406) and the writer stored through byte 407.
 405: #
 406: #  *** SO THE GENERALISATION THE HEADER STATES IS ONE LEVEL SHORT. ***  It says
 407: #  every VALUE the guard refuses needs a decline-channel row.  True -- and every
 408: #  STATE in which it refuses needs one too.  The latched state had only a count row
 409: #  and a survival row, which are exactly the two shapes this file already knows are
 410: #  vacuous here.
 411: #
 412: #  Costs no new session: the read is appended to the existing latch session.
 413: A = Addr(CODE)
 414: t3, alive3, how3 = session(stage_toc(A, 407) + stage_toc(A, 406) +
 415:                            load16(GDROM_COND, A))
 416: row("latch once", str(len(DECLINE.findall(t3))), "1",
 417:     "two declines in one session emit the diagnostic exactly once")
 418: row("latch surv", how3, "exit0", "and neither of them ends the host")
 419: g = printed(t3, "r2") if alive3 else "died"
 420: row("latch cond", ("0x%x" % (int(g, 16) & 0xff)) if g.startswith("0x") else g,
 421:     "0xa0", "the SECOND decline still declined -- kills the latch-state mutant")
 422: 
 423: ok = all(o for _, o in rows)
 424: print("")
 425: print("TOCLEN_RESULT=%d/%d" % (sum(1 for _, o in rows if o), len(rows)))
 426: print("TOCLEN_PROBE=%s" % ("PASS" if ok else "FAIL"))
 427: sys.exit(0 if ok else 1)

