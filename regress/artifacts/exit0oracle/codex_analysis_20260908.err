 117: #
 118: #  What the SECOND value actually buys is narrower and still worth having: two
 119: #  rows cannot both be satisfied by a mutant returning one fixed constant, and
 120: #  the hi row exercises the window's LAST SLOT -- which is what M4 and M7
 121: #  measured, and neither is a lane property at all. ***
 122: VAL_LO      = 0x1122334455667788
 123: VAL_HI      = 0xa1b2c3d4e5f60718
