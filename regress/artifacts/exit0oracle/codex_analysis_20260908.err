 949: #  machinery ran gets, for free, every mutant that works by stopping the machinery.*
 950: DISPATCH_TEXT = "handle_command: unimplemented command 0x11"
 951: row("R13 recount", "%d|%s|%d" % (t.count(TOOMUCH_TEXT), how, t.count(DISPATCH_TEXT)),
