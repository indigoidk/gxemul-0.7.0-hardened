 186: def printed(t, reg):
 187:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
 188:     if not m:
 189:         return "absent"
 190:     return "0x%x" % int(m.group(1), 16)
