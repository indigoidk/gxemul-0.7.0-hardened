  78: import os, pty, re, select, sys, time
  79: 
  80: BIN   = sys.argv[1]
  81: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
  82: DUMMY = "/tmp/dummy497.bin"
  83: if not os.path.exists(DUMMY):
  84:     with open(DUMMY, "wb") as f:
