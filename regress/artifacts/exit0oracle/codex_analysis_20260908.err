  91: 
  92: CODE = 0xffffffff80001000
  93: SCRATCH_RAM = 0xffffffff80002000
  94: DE = 0xffffffffb5002000              # sgi_de   @ phys 0x15002000
  95: RE = 0xffffffffb5001000              # sgi_re   @ phys 0x15001000
  96: DE_STATUS = 0xffffffffb5003000       # sgi_de_status, for the device signature
