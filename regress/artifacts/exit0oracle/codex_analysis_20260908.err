  87: CODE        = 0x80001000
  88: SCRATCH_RAM = 0xa0001800
  89: LIVE_VAL    = 0x12345678
  90: DE_BASE     = 0xb5002000          # DEVICE_ACCESS(sgi_de); a BYTE access fires DE_LEN
  91: #  Drawing-engine registers, to fire the last two latch bits.  Addresses and values COPIED from
  92: #  regress/sgi_re_randompixel_probe.py, which drives this path as a shipped rung-3 witness --
  93: #  not invented here.
  94: DE_MODE_DST = 0xb5002008
  95: DE_DRAWMODE = 0xb5002018
  96: DE_XVERT_0  = 0xb5002070
  97: DE_XVERT_1  = 0xb5002074
  98: DE_PRIM_ST  = 0xb5002860          # CRIME_DE_PRIMITIVE | CRIME_DE_START -- the store fires the draw
  99: MODE_LIN_B  = 0x1620              # LIN_B | BUFDEPTH_32 | TYPE_RGBA -> dst_mode 5, the default arm
 100: DRAWMODE    = 0x002000f8
 101: PRIM_RECT   = 0x03020000          # DE_PRIM_RECTANGLE | DE_PRIM_TB -- an IMPLEMENTED op
 102: PRIM_BAD    = 0x05020000          # an UNIMPLEMENTED op: only LINE and RECTANGLE of 256 exist
 103: DE_STATUS   = 0xb5004000
 104: DE_STAT_VAL = "0x1e000000"
 105: OUTSIDE     = 0xb5001800          # past LINEAR_B -> the final else (straggler)
 106: ACC_VAL     = "0x1122334455667788"
