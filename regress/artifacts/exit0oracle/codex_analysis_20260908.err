import ast
from pathlib import Path
names = ['gdrom_cond_probe.py','gdrom_decline_probe.py','gdrom_default_probe.py','gdrom_toclen_probe.py','pcc2_width_probe.py','pcc2_width_witness.py','sgi_de_width_probe.py','sgi_de_primop_probe.py','sgi_re_unmapped_probe.py','sgi_re_width_probe.py']
for name in names:
    p = Path('regress') / name
    source = p.read_text()
    tree = ast.parse(source)
    print('\\nFILE', name, 'LINES', len(source.splitlines()))
    print('IMPORTS', '; '.join(ast.unparse(n) for n in tree.body if isinstance(n, (ast.Import, ast.ImportFrom))))
    for n in ast.walk(tree):
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            print('DEF', n.lineno, n.name, ast.unparse(n.args))
    for n in sorted(ast.walk(tree), key=lambda n: getattr(n, 'lineno', 0)):
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == 'row':
            want = n.args[2] if len(n.args) > 2 else next((k.value for k in n.keywords if k.arg == 'want'), None)
            if want is not None and ('exit0' in ast.unparse(want) or not isinstance(want, ast.Constant)):
                print('ROW', n.lineno, ast.unparse(n))
