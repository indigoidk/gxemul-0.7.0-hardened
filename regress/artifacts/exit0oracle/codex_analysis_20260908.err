codex
I’m defining membership by an expected value exactly equal to `exit0`, regardless of the row’s name. I’ll report both source call sites and rows generated by loops, and distinguish those from compound expectations that include `exit0`. A diagnostic or count paired with a status check only helps if it would fail when the process announces and then exits zero.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$auditScript = @'"'
import ast
from pathlib import Path
names = ['gdrom_cond_probe.py','gdrom_decline_probe.py','gdrom_default_probe.py','gdrom_toclen_probe.py','pcc2_width_probe.py','pcc2_width_witness.py','sgi_de_width_probe.py','sgi_de_primop_probe.py','sgi_re_unmapped_probe.py','sgi_re_width_probe.py']
total = 0
for name in names:
    p = Path('regress') / name
    tree = ast.parse(p.read_text())
    parents = {}
    for parent in ast.walk(tree):
        for child in ast.iter_child_nodes(parent):
            parents[child] = parent
    selected = []
    for n in ast.walk(tree):
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == 'row':
            want = n.args[2] if len(n.args)>2 else next((k.value for k in n.keywords if k.arg == 'want'), None)
            if isinstance(want, ast.Constant) and want.value == 'exit0':
                selected.append(n)
    total += len(selected)
    print('\\nFILE', name, 'EXACT CALL SITES', len(selected))
    for n in sorted(selected, key=lambda n:n.lineno):
        print(n.lineno, ast.unparse(n))
        a = n
        while a in parents:
            a = parents[a]
            if isinstance(a, ast.For):
                print('  LOOP', a.lineno, ast.unparse(a.target), 'IN', ast.unparse(a.iter))
            if isinstance(a, (ast.If, ast.While)):
                print('  CONDITION', a.lineno, ast.unparse(a.test))
    for n in tree.body:
        if isinstance(n, ast.Assign) and isinstance(n.value, (ast.List, ast.Tuple)):
            print('COLLECTION', n.lineno, ast.unparse(n))
print('\\nTOTAL EXACT CALL SITES', total)
