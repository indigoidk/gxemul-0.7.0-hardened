 198:             except OSError:
 199:                 return False
 200:             if not d:
 201:                 return False
 202:             buf += d.decode("latin-1", "replace")
 203:         return True
 204: 
 205:     alive = rd(settle)
 206:     for i, c in enumerate(cmds):
 207:         try:
 208:             os.write(fd, (c + "\n").encode("latin-1"))
 209:         except OSError:
 210:             alive = False
 211:             break
 212:         if not rd(spin if i == len(cmds) - 1 else 0.35):
 213:             alive = False
 214:             break
 215:     try:
 216:         os.write(fd, b"quit\n")
 217:         rd(0.6)
 218:     except OSError:
 219:         pass
 220:     try:
 221:         os.close(fd)
 222:     except OSError:
 223:         pass
 224:     how = "nostatus"
 225:     try:
 226:         _, stat = os.waitpid(pid, 0)
 227:         if os.WIFSIGNALED(stat):
 228:             how = "sig%d" % os.WTERMSIG(stat)
 229:         elif os.WIFEXITED(stat):
 230:             how = "exit%d" % os.WEXITSTATUS(stat)
 231:     except OSError:
 232:         pass
 233:     return buf, alive, how
 234: 
 235: 
 236: def printed(t, reg):
 237:     """The LAST `print rN` in the transcript -- a session with several reads of the same
 238:     register must not silently score the first one."""
 239:     m = re.findall(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
 240:     return m[-1] if m else "absent"
 241: 
 242: 
 243: def bit(t, reg, mask):
 244:     """"set"/"clear" for one bit -- and "ABSENT" as its OWN token when the read failed.
 245: 
 246:     *** THIS FUNCTION EXISTS BECAUSE FOLDING A FAILED READ INTO "clear" MADE R7 FAIL OPEN.
 247:     Caught on pass 2 by the fable5 seat. ***  R7's want is "clear", so a session that died
 248:     before the load returned "absent" -> "clear" -> EQUAL TO WANT -> PASS.  The one row
 249:     whose oracle is an ABSENCE was the one row an apparatus failure scored green.
 250: 
 251:     R6 and R9 want "set" and so fail safe on the same input, which is exactly why the
 252:     defect was invisible: three rows share a helper and only the inverted one is unsafe.
 253:     A row must fail to a DISTINGUISHABLE token or it manufactures agreement.
 254:     """
 255:     v = printed(t, reg)
 256:     if v == "absent":
 257:         return "ABSENT-READ-FAILED"
 258:     #  *** AND THE SEED IS A NON-ANSWER TOO, which is the same defect one level down. ***
 259:     #  0xdead has bit 3 set, so an UNEXECUTED load would score "set" -- green on R6 and R9,
 260:     #  whose want IS "set".  Introducing the seed to make a dead read visible would have
 261:     #  made it invisible again on exactly the two rows the "absent" guard already fails
 262:     #  safe on.  A sentinel is only a sentinel if every consumer knows it is one.
 263:     if int(v, 16) == SEED:
 264:         return "SEED-NEVER-RAN"
 265:     return "set" if (int(v, 16) & mask) else "clear"
 266: 
 267: 
 268: def MOVW_ST(n, m):
 269:     return 0x2001 | (n << 8) | (m << 4)     # mov.w Rm, @Rn
 270: 
 271: 
 272: def MOVW_LD(n, m):
 273:     return 0x6001 | (n << 8) | (m << 4)     # mov.w @Rm, Rn
 274: 
 275: 
 276: class Addr(object):
 277:     """Hands out non-overlapping code addresses so planted runs cannot collide."""
 278: 
 279:     def __init__(self, base):
 280:         self.a = base
 281: 
 282:     def take(self, n_ops):
 283:         got = self.a
 284:         self.a += 2 * (n_ops + 2) + 0x20
 285:         return got
 286: 
 287: 
 288: def run(ops, at):
 289:     put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(ops)]
 290:     put += ["put h 0x%x, 0x%04x" % (at + 2 * len(ops), BRA_SELF),
 291:             "put h 0x%x, 0x%04x" % (at + 2 * len(ops) + 2, NOP)]
 292:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
 293: 
 294: 
 295: def store16(reg, val, A):
 296:     return ["r7=0x%x" % reg, "r8=0x%04x" % val] + run([MOVW_ST(7, 8)], A.take(1))
 297: 
 298: 
 299: #  *** THE DESTINATION IS SEEDED 0xdead, NOT 0, AND THAT IS NOT COSMETIC. ***
 300: #
 301: #  Seeding 0 makes an UNEXECUTED LOAD indistinguishable from a load that genuinely read
 302: #  zero -- and "RAM would read 0" is the exact failure every device-signature control here
 303: #  exists to detect.  So under load, when a `step` does not complete, the row reads back its
 304: #  own initialiser and reports the precise defect it was written to catch.
 305: #
 306: #  *** THE MOTIVATING DIAGNOSIS WAS WRONG AND THE SEED IS WHAT PROVED IT. ***  On this
 307: #  probe's first run `devsig sh4` reported got=0x0 want=0xda74, with three agy jobs holding
 308: #  ~10 concurrent gxemul processes, and I wrote it up as a contention artifact -- a step that
 309: #  did not complete, leaving the register at its 0 initialiser.
 310: #
 311: #  It was not.  The row was simply WRONG (wrong address, wrong width -- see its own comment),
 312: #  and it had been failing correctly the whole time.  **The seed settled it on the very next
 313: #  run: a step that never executed would have left 0xdead, and it left 0x0, so the guest ran
 314: #  and the device returned zero.**
 315: #
 316: #  The seed is kept, and its warrant is now the measured one rather than the guessed one: it
 317: #  makes DID-NOT-RUN and READ-ZERO distinguishable, which is what let a wrong diagnosis be
 318: #  refuted in one run instead of being carried. *A sentinel earns its keep by making you
 319: #  wrong faster.*
 320: #
 321: #  0xdead cannot be produced by an unexecuted load, by RAM, or by any register this probe
 322: #  reads, so the three states are now distinct: 0xdead = DID NOT RUN, 0x0 = read zero,
 323: #  anything else = the value.  This is the harness's own distinguishable-token rule applied
 324: #  to the seed rather than to the oracle.
 325: SEED = 0xdead
 326: 
 327: #  operands as CORRECTED in gdrom_decline_probe.py: MOVW_LD(dest, 1) is `mov.w @R1, Rdest`.
 328: #  Reversing them made three sibling rows pass vacuously, so this is COPIED, not re-derived.
 329: def load16(reg, A, dest=2):
 330:     return ["r1=0x%x" % reg, "r%d=0x%x" % (dest, SEED)] + run([MOVW_LD(dest, 1)], A.take(1)) \
 331:         + ["print r%d" % dest]
 332: 
 333: 
 334: def load32(reg, A, dest=2):
 335:     return ["r1=0x%x" % reg, "r%d=0x%x" % (dest, SEED)] + run([0x6002 | (1 << 4) | (dest << 8)],
 336:                                                               A.take(1)) + ["print r%d" % dest]
 337: 
 338: 
 339: print("#496 gdromcondlies DETECTOR -- rung 3, unmodified -E dreamcast.")
 340: print("binary: %s" % BIN)
 341: print("")
 342: print("%-14s %-12s %-12s %-46s %s" % ("row", "got", "want", "note", ""))
 343: 
 344: # ------------------------------------------------------------------ MANDATORY CONTROLS
 345: #  Over the CONTROL ROWS ONLY.  A control that also goes dead on a product failure sends a
 346: #  reader hunting a broken rig for a real defect -- measured on the sibling probe's first run.
 347: A = Addr(CODE)
 348: t, alive, how = session(["put w 0x8c001800, 0x%08x" % LIVE] + load32(0x8c001800, A))
 349: row("live", printed(t, "r2"), "0x%x" % LIVE,
 350:     "LIVENESS: guest store then guest load, through RAM")
 351: 
 352: #  *** COPIED VERBATIM FROM THE WITNESS, NOT RE-DERIVED, AND THE FIRST VERSION OF THIS ROW
 353: #  WAS WRITTEN FROM MEMORY AND WAS WRONG. ***  It read `load16(0xa4000150)`; the real row is
 354: #  a 32-BIT load from 0xffd00010 masked to 16 bits.  Wrong address AND wrong width, so it
 355: #  read 0 -- and 0 is exactly what this control's own note says a RAM-backed window would
 356: #  give, i.e. it reported the precise defect it exists to detect.
 357: #
 358: #  I diagnosed that as host contention and wrote that reason into this file.  It was not:
 359: #  the SEED change (below) is what refuted it, because a step that never ran would have left
 360: #  0xdead and it left 0x0.  The seed earned its keep on its first run, on a different
 361: #  question from the one it was added for.
 362: #
 363: #  The general rule this file already states for citations applies to APPARATUS too: copy a
 364: #  sibling's control, do not re-derive it.  `gdrom_decline_probe.py` and the witness both
 365: #  carry this row; agreeing with them is the point, since the value of a shared control is
 366: #  that a failure is comparable across probes rather than novel to this one.
 367: A = Addr(CODE)
 368: t, alive, how = session(load32(0xffd00010, A))
 369: g = printed(t, "r2")
 370: row("devsig sh4", ("0x%x" % (int(g, 16) & 0xffff)) if g.startswith("0x") else g,
 371:     "0x%x" % IPRD_RESET, "DEVSIG: SH4 IPRD reset value; RAM would read 0")
 372: 
 373: A = Addr(CODE)
 374: t, alive, how = session(load16(GDROM_STAT, A))
 375: row("devsig st", printed(t, "r2"), "0x6",
 376:     "DEVSIG: fresh GDROM_STAT = 6 (no IDE image); RAM = 0")
 377: 
 378: #  The STRONG device-signature form: a TRANSFORMATION only the device performs.  The write
 379: #  arm masks CNTLO to a byte, so storing 0x1234 reads back 0x34.  RAM would return 0x1234
 380: #  verbatim, so this discriminates against a RAM-backed window as well as a dead one.
 381: A = Addr(CODE)
 382: t, alive, how = session(store16(GDROM_CNTLO, 0x1234, A) + load16(GDROM_CNTLO, A))
 383: row("devsig cnt", printed(t, "r2"), "0x34",
 384:     "DEVSIG: device masks CNTLO to a byte; RAM gives 0x1234")
 385: 
 386: #  *** CONTROLS FIRST AND SEPARATELY. ***  A run whose controls died is an APPARATUS
 387: #  failure and must not be read as a wall of product failures.  The gate keys on this line
 388: #  BEFORE it looks at any score, so a broken rig reports as a broken rig.
 389: print("GDROMCOND_CONTROL=%s" % ("OK" if all(o for _, o in rows) else "DEAD"))
 390: print("")
 391: 
 392: # ------------------------------------------------------------------ R1, R3, R10  SITE A
 393: #  R1 -- the decline is ANNOUNCED.  Kills a mutant that reinstates exit(1) (the process
 394: #  would die and the text never appear) and one that declines SILENTLY.
 395: #  *** THE EXIT STATUS IS PART OF THIS ROW, AND LEAVING IT OUT WAS A CLAUSE-(b) FLOOR
 396: #  BREACH -- caught on pass 2 by a PACKET-FED seat reasoning from the diff alone. ***
 397: #
 398: #  The header's ban on the survival channel was written too broadly.  Reinstating `exit(1)`
 399: #  after the fatal() PRINTS THE DIAGNOSTIC AND THEN DIES: the message count is 1, the byte
 400: #  is right, and a presence-only row is GREEN on a verbatim reinstatement of the very defect
 401: #  this round removed.  The witness measured exactly that shape pre-fix -- `a88 says` = 1
 402: #  AND `a88 kill` = exit1, in the same session.
 403: #
 404: #  THE CORRECT RULE: survival is a dead channel for rows pinning the ACCEPT side, because
 405: #  the fix makes accepted values survive either way.  On the DECLINE side it is the ONLY
 406: #  channel that sees clause (b).  So a decline row asserts BOTH -- announced, and survived.
 407: A = Addr(CODE)
 408: t, alive, how = session(store16(GDROM_UNK88, 0x0000, A))
 409: m = A88_RE.search(t)
 410: row("R1 a88 says", "%d|%s|%s" % (t.count(A88_TEXT), m.group(1) if m else "absent", how),
 411:     "1|00|exit0", "site A declines, announces the byte, and SURVIVES")
 412: 
 413: #  R1b -- and the byte TRACKS.  A second, DIFFERENT declined value is what separates a
 414: #  format that prints idata from one that prints a constant, and it is what reddens under
 415: #  the 0x%02x -> 0x%02d fidelity mutant (0xaa would report as "70").
 416: A = Addr(CODE)
 417: t, alive, how = session(store16(GDROM_UNK88, 0x00aa, A))
 418: m = A88_RE.search(t)
 419: row("R1b a88 trk", m.group(1) if m else "absent", "aa",
 420:     "and it tracks the datum, so the predicate saw it")
 421: 
 422: #  R3 -- the LATCH.  Three bad writes in ONE session must announce exactly once.
 423: A = Addr(CODE)
 424: t, alive, how = session(store16(GDROM_UNK88, 0x0000, A)
 425:                         + store16(GDROM_UNK88, 0x0055, A)
 426:                         + store16(GDROM_UNK88, 0x00aa, A))
 427: row("R3 a88 x3", "%d" % t.count(A88_TEXT), "1",
 428:     "three bad writes at A, ONE diagnostic")
 429: 
 430: #  R10 -- site A's accepted value is a NO-OP.  If a future edit gives 0x0b an effect, the
 431: #  three device-state bytes stop agreeing with a fresh device.
 432: #  *** R10 READS COND AND BUSY, NOT STAT, AND THE STAT VERSION WAS HOLLOW. ***
 433: #  PRETABLE prescribed "stat/busy/cond unchanged"; the first build read STAT alone -- and
 434: #  `dreamcast_gdrom_update_stat()` RECOMPUTES d->stat on every read, so it normalises to 6
 435: #  whatever site A did.  A mutant adding `d->cond = 0x08;` to the 0x0b arm therefore passed
 436: #  R10 while forging COND_DATA_AVAIL: the row aimed at "site A grew an effect" could not see
 437: #  site A growing an effect.
 438: #
 439: #  That is #490's lost-prescription failure in miniature -- the row list drifted from the
 440: #  block that prescribed it -- caught pre-commit by the fable5 seat rather than by a mutant.
 441: #  The STAT leg is dropped rather than added to: `devsig st` already pins it, and a leg that
 442: #  cannot vary is what made this row hollow in the first place.
 443: A = Addr(CODE)
 444: t, alive, how = session(store16(GDROM_UNK88, 0x000b, A)
 445:                         + load16(GDROM_COND, A, dest=2)
 446:                         + load16(GDROM_BUSY, A, dest=3))
 447: row("R10 a88 nop", "%s|%s|%d" % (printed(t, "r2"), printed(t, "r3"), t.count(A88_TEXT)),
 448:     "0x0|0x0|0", "accepting 0x0b touches no state and says nothing")
 449: 
 450: # --------------------------------- R10b/R10c  SITE A HAS A STATE CHANNEL TOO
 451: #  *** SIBLING PARITY FAILED THREE TIMES IN ONE ROUND, AND THE THIRD FAILURE IS INSIDE
 452: #  THE REPAIR FOR THE SECOND. ***  The first was byte fidelity (site B captured its byte,
 453: #  site A did not).  The second was the end-to-end consequence, and R12 was written for
 454: #  it AT SITE B ONLY.  The third is this: **every repair this round made to close a
 455: #  site-B gap was made at site B alone**, so until now NO ROW READ ANY DEVICE REGISTER
 456: #  AFTER A SITE-A ACCESS.  Site A was observed by nothing but its own message.
 457: #
 458: #  Three mutants were MEASURED sweeping the whole detector through that hole, each a
 459: #  one-line edit in site A:
 460: #      d->cond |=  0x08;   in the DECLINE arm  -- forges readiness      (21/21 clean)
 461: #      d->cond &= ~0x08;   in the DECLINE arm  -- revokes a genuine one (21/21 clean)
 462: #      SYSASIC_TRIGGER_EVENT on the ACCEPTED 0x0b -- a phantom completion
 463: #
 464: #  R10 could not see any of them: it reads COND and BUSY after ACCEPTING 0x0b, and all
 465: #  three act on the DECLINE path or on a channel it does not read.
 466: #
 467: #  *** THE REVIEWER CHECK THIS EARNS, and it costs two seconds: when a repair closes a
 468: #  gap at one site of a pair, ASK WHAT THE SAME EDIT WOULD DO AT THE OTHER. ***  Three
 469: #  times the answer here was "nothing would notice".
 470: A = Addr(CODE)
 471: t, alive, how = session(store16(GDROM_UNK88, 0x0055, A)
 472:                         + load16(GDROM_COND, A, dest=2)
 473:                         + load32(SYSASIC_PEND1, A, dest=3))
 474: row("R10b a88 decl", "%s|%s|%d" % (printed(t, "r2"),
 475:                                    bit(t, "r3", GDROM_EVENT_BIT),
 476:                                    t.count(A88_TEXT)),
 477:     "0x0|clear|1", "a DECLINED site-A write touches COND and the event NOT AT ALL")
 478: 
 479: #  and the ACCEPTED value must not grow an event either -- the third mutant acts on the
 480: #  0x0b path, which R10 reads but only through COND and BUSY.
 481: A = Addr(CODE)
 482: t, alive, how = session(store16(GDROM_UNK88, 0x000b, A)
 483:                         + load32(SYSASIC_PEND1, A, dest=2))
 484: row("R10c a88 evt", bit(t, "r2", GDROM_EVENT_BIT), "clear",
 485:     "and ACCEPTING 0x0b fires no completion event")
 486: 
 487: # ------------------------------------------------------------------ R2, R4  SITE B
 488: #  R2 -- announced, and the echoed byte TRACKS the guest's datum.  A constant would prove
 489: #  far less: it would survive a mutant that stopped reading idata at all.
 490: A = Addr(CODE)
 491: t, alive, how = session(store16(GDROM_COND, 0x0055, A))
 492: m = COND_RE.search(t)
 493: row("R2 cond says", "%s|%s" % (m.group(1) if m else "absent", how), "55|exit0",
 494:     "site B declines, announces the byte, and SURVIVES")
 495: 
 496: A = Addr(CODE)
 497: t, alive, how = session(store16(GDROM_COND, 0x0001, A))
 498: m = COND_RE.search(t)
 499: row("R2b cond trk", m.group(1) if m else "absent", "01",
 500:     "and it tracks the datum, so the predicate saw it")
 501: 
 502: #  R4 -- the LATCH at site B.
 503: A = Addr(CODE)
 504: t, alive, how = session(store16(GDROM_COND, 0x0055, A)
 505:                         + store16(GDROM_COND, 0x0056, A)
 506:                         + store16(GDROM_COND, 0x0057, A))
 507: row("R4 cond x3", "%d" % len(COND_RE.findall(t)), "1",
 508:     "three bad writes at B, ONE diagnostic")
 509: 
 510: # ------------------------------------------------------------------ R5  *** THE KEYSTONE
 511: #  *** ANCHORED, AND THE ANCHOR IS THE WHOLE POINT (clause f). ***
 512: #  A fresh device has cond == 0.  So the naive row -- "write 0x55, read back 0" -- is
 513: #  satisfied by the CORRECT fix and ALSO by a mutant that assigns d->cond = 0 on decline.
 514: #  Driving an ACCEPTED 0xef FIRST puts a value in cond that only the accept arm can have
 515: #  placed there; requiring 0xef back after the declined write separates the two.
 516: #
 517: #  This is the row that kills the clause-(d) mutant BOTH Agent seats named independently on
 518: #  pass 1: keep the latched decline, move `d->cond = idata;` back above the dispatch.  Under
 519: #  that mutant this reads 0x55.  Every other row in this file stays green.
 520: A = Addr(CODE)
 521: t, alive, how = session(store16(GDROM_COND, 0x00ef, A)
 522:                         + store16(GDROM_COND, 0x0055, A)
 523:                         + load16(GDROM_COND, A))
 524: row("R5 cond keep", printed(t, "r2"), "0xef",
 525:     "*** ANCHORED: declined write leaves d->cond UNCHANGED")
 526: 
 527: #  *** ONE ANCHOR IS NOT ENOUGH, AND A SEAT MEASURED WHY ON PASS 2. ***
 528: #  R5 alone pins "cond == 0xef after the sequence", which the CORRECT fix satisfies and so
 529: #  does a one-line mutant `d->cond = 0xef;` in the decline arm.  That mutant fabricates
 530: #  COND_DATA_AVAIL (0xef & 0x08) out of a fresh or 0xa0-anchored decline and unlocks the
 531: #  GDROM_DATA read path -- the exact defect R5 exists to prevent, walking straight past it.
 532: #
 533: #  THE REPAIR IS PRE-STATES, NOT MORE ROWS OF THE SAME SHAPE.  "Unchanged" is a claim about
 534: #  a FUNCTION of the prior value, and one sample cannot distinguish a function from a
 535: #  constant.  Three samples over the model's principal reachable states pin it: any
 536: #  constant, any zeroing, any OR, and idata itself all differ from the identity on at least
 537: #  one of them.
 538: #  *** THE DECLINED BYTE HERE IS 0xaa, NOT 0x55, AND THE CHANGE IS ONE CONSTANT THAT CLOSES
 539: #  A MEASURED ESCAPE. ***  With 0x55 the three declined values were {0x55, 0x55, 0x08},
 540: #  whose union is 0x5d -- so BITS 1, 5 AND 7 APPEARED IN NO PROBED VALUE, and R5/R5b/R5c
 541: #  were blind to any VALUE-CONDITIONAL store keyed on them.  The opus5 seat built one and
 542: #  measured all 20 rows identical to the fix tree:
 543: #
 544: #      +		if (idata >= 0x80)
 545: #      +			d->cond = idata;
 546: #
 547: #  Its plausible dress writes itself -- "0xa0 and 0xef are both >= 0x80, so high bytes are
 548: #  command codes; let them land" -- and a declined 0x88 then stores 0x88, whose bit 3 FORGES
 549: #  COND_DATA_AVAIL: the exact defect the store relocation exists to prevent.
 550: #
 551: #  {0x55, 0xaa, 0x08} spans all eight bits, so no conditional keyed on any single bit can
 552: #  pass all three.  The three rows now test the map on a spanning set rather than on an
 553: #  arbitrary one.  *Zero new rows; the cost of the original hole was that nobody asked which
 554: #  bits the probed values covered.*
 555: A = Addr(CODE)
 556: t, alive, how = session(store16(GDROM_COND, 0x00aa, A) + load16(GDROM_COND, A))
 557: row("R5b cond 00", printed(t, "r2"), "0x0",
 558:     "FRESH pre-state: decline leaves cond at its reset 0")
 559: 
 560: A = Addr(CODE)
 561: #  the declined byte here is 0x08 -- COND_DATA_AVAIL itself -- so the row MEASURES the
 562: #  forge subspace instead of inferring it: any mutant that stores or ORs the declined
 563: #  value lands data-available on top of an accepted 0xa0, and this reds.
 564: t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
 565:                         + store16(GDROM_COND, 0x0008, A)
 566:                         + load16(GDROM_COND, A))
 567: row("R5c cond a0", printed(t, "r2"), "0xa0",
 568:     "0xa0 pre-state: decline preserves the ACCEPTED value")
 569: 
 570: #  *** SPANNING THE BITS KILLS SINGLE-BIT PREDICATES AND NOT CONJUNCTIONS.  Named by the
 571: #  codex seat AFTER the spanning repair had already landed -- which is the useful shape of a
 572: #  finding: accept the repair, then ask what it does NOT buy. ***
 573: #
 574: #  The three declined bytes {0x55, 0xaa, 0x08} union to 0xff, so no SINGLE-bit conditional
 575: #  can pass all three.  A CONJUNCTION can:
 576: #
 577: #      if ((idata & 0x09) == 0x09)
 578: #              d->cond = idata;
 579: #
 580: #  0x55 carries bit 0 and not bit 3; 0xaa and 0x08 carry bit 3 and not bit 0.  **NOT ONE OF
 581: #  THE THREE HAS BOTH**, so every existing row stays green while a declined 0x09 stores 0x09
 582: #  and forges COND_DATA_AVAIL.  0x09 is the smallest value carrying the readiness bit
 583: #  together with a bit no other probed value pairs it with.
 584: #
 585: #  HONEST BOUND, because a spanning argument invites exactly this overclaim: this closes
 586: #  two-bit conjunctions involving bit 3.  It does not close the general k-bit case, and the
 587: #  contract covers every unmodelled value while four samples do not.  Stated rather than
 588: #  implied.
 589: A = Addr(CODE)
 590: t, alive, how = session(store16(GDROM_COND, 0x00ef, A)
 591:                         + store16(GDROM_COND, 0x0009, A)
 592:                         + load16(GDROM_COND, A))
 593: #  THE 09 ANNOUNCEMENT IS IN THE ORACLE because without it this row is store-death-unsafe:
 594: #  if the 0x09 store is missed while the ANCHOR and the LOAD both run, the read still
 595: #  returns 0xef and the row passes having observed nothing.  Named by a seat as an eighth
 596: #  `storesidedead` member -- the class applies to a row that drives TWO stores whenever
 597: #  only one of them is load-bearing.
 598: m = COND_RE.search(t)
 599: #  *** AND THE MUTANT THIS ROW USED TO NAME IS ONE R12b ALREADY SUBSUMES.  Corrected
 600: #  2026-08-30 by the adjudicating seat, which checked rather than agreed. ***
 601: #
 602: #  The stated mutant was a conjunction `(idata & 0x09) == 0x09`.  R12b drives 0xff, and
 603: #  0xff passes EVERY `(idata & M) == M` -- so R12b kills that form on its own and this
 604: #  row adds nothing against it.  A row is justified by a mutant no OTHER row catches,
 605: #  and citing a subsumed one overstates the suite while looking like coverage.
 606: #
 607: #  THE DISCRIMINATING FORM IS AN EXACT LOW-NIBBLE MATCH, `(idata & 0x0f) == 0x09`:
 608: #      0xff -> 0x0f != 0x09   R12b stays GREEN and misses it
 609: #      0x09 -> forges cond=0x09, and this row reds on field 1 (0x9 != 0xef)
 610: #  So R5d earns its place -- on that mutant, not on the one it used to claim.
 611: #
 612: #  LATENT FRAGILITY, worth stating because it is invisible from the row: field 2 works
 613: #  ONLY while 0xef stays an ACCEPTED value.  The device announces nothing for 0xef, so
 614: #  the sole COND_RE match is the 0x09 decline.  If a future round moved 0xef to the
 615: #  declined side, field 2 STOPS OBSERVING THE 0x09 DECLINE and starts observing
 616: #  whatever the anchor's own decline printed instead.  The row reds -- loudly, which is
 617: #  the safe direction -- but for a reason unrelated to the rule under test, so whoever
 618: #  sees it should read this note before re-pinning.
 619: #
 620: #  *** AN EARLIER DRAFT OF THIS NOTE PREDICTED THE OBSERVABLE AND GOT IT WRONG, WHICH
 621: #  IS WHY IT NO LONGER PREDICTS ONE. ***  It said field 2 would read "absent".  It
 622: #  would not: the anchor's decline goes through the SAME else arm and prints
 623: #  `unimplemented GDROM_COND = 0xef ... (once)`, and COND_RE.search returns the FIRST
 624: #  match -- so field 2 reads "ef".  (And if a future decline used different text, the
 625: #  0x09 latch would be unconsumed and field 2 would read "09" with field 1 red
 626: #  instead.)  Caught by the adjudicating seat.  The DIRECTION was right and the
 627: #  mechanism was wrong -- which is `read the line before citing it`, inside a
 628: #  correction written to fix an overclaim.
 629: row("R5d cond 09", "%s|%s" % (printed(t, "r2"), m.group(1) if m else "absent"),
 630:     "0xef|09", "a decline carrying BOTH bits 0 and 3 is refused too")
 631: 
 632: # ------------------------------------------------------------------ R6, R8, R9  ACCEPTS
 633: #  These are the de-escalation ACCEPT rows.  They pin that legal writes still LAND -- which
 634: #  is the clause's own wording -- and landing means the EFFECT, not the silence.  A quiet
 635: #  row cannot see an emptied arm; these can.
 636: A = Addr(CODE)
 637: t, alive, how = session(store16(GDROM_COND, 0x00a0, A) + load16(GDROM_BUSY, A))
 638: row("R6 a0 busy", bit(t, "r2", 0x08), "set",
 639:     "ACCEPT 0xa0 still sets BUSY bit 0x08")
 640: 
 641: A = Addr(CODE)
 642: t, alive, how = session(store16(GDROM_COND, 0x00a0, A) + load16(GDROM_COND, A))
 643: row("R8 a0 echo", printed(t, "r2"), "0xa0",
 644:     "ACCEPT 0xa0 still stores idata into d->cond")
 645: 
 646: A = Addr(CODE)
 647: t, alive, how = session(store16(GDROM_COND, 0x00ef, A) + load32(SYSASIC_PEND1, A))
 648: row("R9 ef event", bit(t, "r2", GDROM_EVENT_BIT), "set",
 649:     "ACCEPT 0xef still fires the SYSASIC event")
 650: 
 651: # ------------------------------------------------------------------ R7  NO EVENT ON DECLINE
 652: #  *** THE TWO IN-FILE PRECEDENTS DISAGREE, so the choice is PINNED rather than assumed. ***
 653: #  handle_command()'s default arm FIRES a completion event on decline, because a guest that
 654: #  has SENT a packet is waiting on one.  The DMA arm REFUSES one, because a completion on a
 655: #  declined transfer is a false success.  At GDROM_COND the guest has sent no packet and is
 656: #  polling BUSY, so an event would announce a command that never began.
 657: #
 658: #  This row is the CLAIM->ROW discharge for that comment sentence.  It is a counterfactual
 659: #  "would <consequence>" claim, which the five-verb grep form of the check walks straight
 660: #  past -- the trigger is semantic: does the sentence assert something a row could observe?
 661: A = Addr(CODE)
 662: t, alive, how = session(store16(GDROM_COND, 0x0055, A) + load32(SYSASIC_PEND1, A))
 663: row("R7 no event", bit(t, "r2", GDROM_EVENT_BIT), "clear",
 664:     "a DECLINED COND write fires NO completion event")
 665: 
 666: #  R7b -- and it touches NO OTHER command state either.  R5/R5b/R5c pin `cond` and R7 pins
 667: #  the event; without this row a one-line busy/stat mutation in the decline arm passes both.
 668: #  The comment this discharges says the decline "accepted no new command or packet ... any
 669: #  pre-existing command state is left untouched" -- a counterfactual claim about state, and
 670: #  CLAIM->ROW owes it a row whatever verbs it happens to use.
 671: #
 672: #  BUSY is read-only here on purpose: its write arm is `d->busy &= ~idata` -- WRITE-TO-CLEAR
 673: #  -- so a probe that "initialises" busy by writing it CLEARS bits instead of setting them.
 674: #  BEFORE/AFTER, not an absolute.  Writing "want 0x0|0x6" here would mean reading the fresh
 675: #  values off the binary and pinning them -- which is fitting the test to the answer, and is
 676: #  observationally identical to laundering.  Comparing the pair ACROSS the decline states
 677: #  the actual claim ("unchanged") and needs no knowledge of what the values are.
 678: A = Addr(CODE)
 679: t, alive, how = session(load16(GDROM_BUSY, A, dest=2)
 680:                         + load16(GDROM_STAT, A, dest=3)
 681:                         + store16(GDROM_COND, 0x0055, A)
 682:                         + load16(GDROM_BUSY, A, dest=4)
 683:                         + load16(GDROM_STAT, A, dest=5))
 684: before = "%s|%s" % (printed(t, "r2"), printed(t, "r3"))
 685: after = "%s|%s" % (printed(t, "r4"), printed(t, "r5"))
 686: #  *** A SELF-COMPARING ROW MUST NOT BE ABLE TO PASS ON NOTHING. ***  If the apparatus
 687: #  fails, all four reads return "absent", after == before, and the row goes GREEN having
 688: #  observed nothing whatever -- the check-that-cannot-fail shape, arriving by way of an
 689: #  otherwise correct before/after oracle.  Any "absent" is forced to a value that cannot
 690: #  equal the other side, so an apparatus failure reds instead of passing.
 691: if "absent" in before or "absent" in after or "0x%x" % SEED in before + after:
 692:     before = "READ-FAILED " + before
 693: row("R7b cond st", after, before,
 694:     "and BUSY/STAT are UNCHANGED across the decline")
 695: 
 696: # ------------------------------------------------------------------ R11  THE CROSS-BIT ROW
 697: #  *** d->warned IS SHARED.  THE COUNT NAMES ITS DERIVER, because every carried version of
 698: #  it in this round's artifacts was wrong: ***
 699: #
 700: #      grep -c 'd->warned |=' src/devices/dev_dreamcast_gdrom.c   ->  12 RAW
 701: #      ... minus ONE that is inside a comment block               ->  11 LIVE writers
 702: #      of which, inside a DEVICE_ACCESS                           ->   8
 703: #
 704: #  (Pre-round: 10 raw, 9 live, 6 inside.)  An earlier draft of this comment said "ten sites,
 705: #  six inside" -- #490's numbers plus two, with #490's own additions never folded in.  The
 706: #  raw grep is the same comment-contamination that `exit_census.py` exists to defeat.
 707: #
 708: #  Not all eight are guest register READS -- GDROM_W_NOTWAIT, GDROM_W_DMANODATA and
 709: #  GDROM_W_DMAARM are write-triggered.  The hazard is unchanged and if anything broader:
 710: #  ordinary guest traffic of EITHER direction can pre-set a colliding bit.  A latch-bit
 711: #  collision is therefore SILENCED BY BENIGN TRAFFIC and looks exactly like a working
 712: #  latch.  #490's `M3shared` escape is this file's recorded cost of shipping without a row
 713: #  for it.
 714: #  *** THE SESSION OPENS WITH AN ORDINARY GDROM_DATA READ, AND THAT ONE COMMAND IS WHAT
 715: #  MAKES THIS ROW MEET #490's STANDARD RATHER THAN A WEAKER ONE. ***
 716: #
 717: #  Without it the row kills only NEW-vs-NEW collapse -- the two new bits aliased onto each
 718: #  other.  It cannot see either new bit aliased onto an OLD one, which compiles clean: the
 719: #  disjointness assert polices the DEFINE level, and an alias written at the USE SITE
 720: #  (testing and setting GDROM_W_NODATA's bit inside site A's guard) never reaches it.
 721: #
 722: #  A GDROM_DATA read ARMS GDROM_W_NODATA inside DEVICE_ACCESS, so if either new latch is
 723: #  aliased onto it, that site falls silent and the row reds.  It touches neither d->cond nor
 724: #  either diagnostic pattern, so it costs the row nothing.  This is the "most benign traffic
 725: #  instance MEASURED" standard `gdrom_decline_probe.py` records #490 arriving at after its
 726: #  own crossbit claim "overclaimed by a factor of seven".
 727: #
 728: #  DISCLOSED, because the contract must claim what it measured and no more: this stages ONE
 729: #  old bit.  Aliases onto the other old bits are NOT covered, and a full alias sweep is not
 730: #  attempted here.
 731: A = Addr(CODE)
 732: t, alive, how = session(load16(GDROM_DATA, A, dest=6)
 733:                         + store16(GDROM_UNK88, 0x0000, A)
 734:                         + store16(GDROM_COND, 0x0055, A))
 735: row("R11 crossbit", "%d|%d" % (t.count(A88_TEXT), len(COND_RE.findall(t))), "1|1",
 736:     "both announce AFTER benign traffic armed an old bit")
 737: 
 738: # ------------------------------------------------ R12  THE END-TO-END CONSEQUENCE
 739: #  *** EVERY OTHER ROW PINS THE CAUSE; THIS ONE PINS THE EFFECT. ***  Named in the
 740: #  adjudication pass by a PACKET-FED seat as the thing all nine of us missed: the probe
 741: #  checked the decline and the COND readback, and never exercised the READ PATH the whole
 742: #  fix exists to protect.
 743: #
 744: #  The declined byte is 0x08 -- COND_DATA_AVAIL itself.  Under the shipped fix d->cond is
 745: #  untouched, so the DATA read finds readiness clear and announces "no data available".
 746: #  Under any mutant that lets the declined value reach d->cond, readiness is FORGED, the
 747: #  read takes the payload branch instead, and the diagnostic never appears.
 748: #
 749: #  *** IT KEYS ON THE DIAGNOSTIC, NOT ON THE RETURNED VALUE, AND THE DEVICE FILE SAYS WHY
 750: #  IN SO MANY WORDS: *** the no-data path returns 0xffff, and "this device's TOC is
 751: #  memset(0xff), so 0xffff is LEGITIMATE PAYLOAD here and no returned value is
 752: #  self-identifying.  The DIAGNOSTIC is the truthfulness channel, not the value."  A row
 753: #  written against the value would be green under a mutant that forges readiness onto a TOC.
 754: #
 755: #  This discharges a CLAIM->ROW debt the round had missed: the fix's own comment asserts a
 756: #  declined write could "forge data-available ... or revoke a genuine one", which is a
 757: #  consequence claim about the DATA path, and until now no row observed that path at all.
 758: NODATA_TEXT = "read from GDROM_DATA with no data available"
 759: A = Addr(CODE)
 760: t, alive, how = session(store16(GDROM_COND, 0x0008, A) + load16(GDROM_DATA, A))
 761: #  *** THE NODATA TOKEN ALONE IS NOT AN EXECUTION WITNESS, AND TWO SEATS SAID SO AGAINST A
 762: #  THIRD THAT CALLED THIS ROW SAFE. ***  It IS a positive observable -- but it is produced by
 763: #  the FRESH STATE as well: cond is 0 on a fresh device, so if the declining store never
 764: #  executes, the DATA read still finds no data and still announces.  The row would be green
 765: #  having observed nothing.
 766: #
 767: #  So the refined rule is not "wants a positive observable" but **wants an observable ONLY
 768: #  THE STORE CAN PRODUCE**.  The COND decline announcement is one: it cannot appear unless the
 769: #  guest store reached the device handler and was refused there.  Asserting both makes the row
 770: #  say "the store ran, AND it did not unlock the path" -- two claims, one session.
 771: m = COND_RE.search(t)
 772: row("R12 no forge", "%d|%s" % (t.count(NODATA_TEXT), m.group(1) if m else "absent"),
 773:     "1|08", "a DECLINED 0x08 does NOT unlock the DATA read path")
 774: 
 775: # ------------------------------------------- R12b  THE ACCEPT SET HAS AN UPPER EDGE TOO
 776: #  *** ONE CHARACTER SWEEPS EVERY OTHER ROW IN THIS FILE, AND IT IS AN EQUALITY BECOMING AN
 777: #  INEQUALITY -- the shape a careless edit produces most easily. ***  Predicted by the codex
 778: #  seat from the diff alone:
 779: #
 780: #      -   } else if (idata == 0xef) {
 781: #      +   } else if (idata >= 0xef) {
 782: #
 783: #  Every probed value behaves identically: 0xa0 still takes the first arm, 0xef still takes
 784: #  the second, and every declined value this file drives (0x55, 0xaa, 0x08, 0x09, 0x00) is
 785: #  BELOW 0xef.  So the accept set silently grows an upper tail -- and 0xff then stores 0xff
 786: #  into cond, forging COND_DATA_AVAIL, *and* fires a completion event for a command that was
 787: #  never issued.  Both halves of the defect this round exists to prevent, from one keystroke.
 788: #
 789: #  The row drives 0xff and requires the DECLINE: the diagnostic present, cond unchanged from
 790: #  an anchored 0xa0, and no ASIC event.  **Three channels in one row on purpose** -- the
 791: #  mutant's two consequences land on different ones, and a row that watched only cond would
 792: #  miss the forged event while a row that watched only the event would miss the forged
 793: #  readiness.
 794: #
 795: #  This is the ACCEPT SET's boundary rather than the store's identity, so it is not covered
 796: #  by R5* however many pre-states those grow: they all drive values the mutant still
 797: #  declines.
 798: A = Addr(CODE)
 799: t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
 800:                         + store16(GDROM_COND, 0x00ff, A)
 801:                         + load16(GDROM_COND, A, dest=2)
 802:                         + load32(SYSASIC_PEND1, A, dest=3))
 803: m = COND_RE.search(t)
 804: row("R12b cond ff", "%s|%s|%s" % (m.group(1) if m else "absent",
 805:                                   printed(t, "r2"),
 806:                                   bit(t, "r3", GDROM_EVENT_BIT)),
 807:     "ff|0xa0|clear", "0xff is DECLINED: no store, no event, announced")
 808: 
 809: # ------------------------------------------------- R12c  ABOVE THE BYTE, AND IT TRUNCATES
 810: #  *** MY CONTRACT'S THRESHOLD ACCOUNTING WAS WRONG AND A SEAT REFUTED IT WITH ARITHMETIC. ***
 811: #  It claimed the surviving thresholds are those strictly inside (0xaa, 0xff).  They are not:
 812: #  R12b drives 0xff, which satisfies `idata >= K` for EVERY K in that range, so the whole
 813: #  interval is already covered.
 814: #
 815: #  What survives is ABOVE 0xff -- and it survives for a reason no row was watching:
 816: #
 817: #      `idata` comes from memory_readmax64() and is 64-BIT.
 818: #      `d->cond` is uint8_t.
 819: #
 820: #  So `if (idata >= 0x100) d->cond = idata;` is declined for every value this file drove --
 821: #  all of them fit in a byte -- while a guest 16-bit store of 0x0108 gives idata = 0x108,
 822: #  passes the guard, and **TRUNCATES INTO cond AS 0x08, forging COND_DATA_AVAIL.**  The
 823: #  forging value never appears in the store; it is manufactured by the assignment's width.
 824: #
 825: #  This row drives exactly that: a 16-bit store of 0x0108, anchored over an accepted 0xa0.
 826: #  *A value-conditional forge does not have to be reachable within the register's own width
 827: #  -- the predicate sees the WIDE datum and the field keeps the narrow one.*
 828: A = Addr(CODE)
 829: t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
 830:                         + store16(GDROM_COND, 0x0108, A)
 831:                         + load16(GDROM_COND, A))
 832: row("R12c cond 108", printed(t, "r2"), "0xa0",
 833:     "a decline ABOVE the byte cannot truncate into cond")
 834: 
 835: # ------------------------------------- R12d  THE AXIS NOBODY SAMPLED: THE HIGH BYTE
 836: #  *** MEASURED L2 FLOOR BREACH.  `if ((idata & 0xff) == 0xa0)` -- and the same on the
 837: #  0xef arm -- SCORED 24/24 WITH ZERO FAILING ROWS, while a guest store of 0x01ef fired a
 838: #  COMPLETION EVENT FOR A COMMAND NEVER ISSUED and 0x01a0 armed BUSY, both SILENTLY. ***
 839: #
 840: #  Why nothing saw it, derived rather than guessed:
 841: #
 842: #      grep -o 'GDROM_COND, 0x[0-9a-f]*' gdrom_cond_probe.py | sort -u
 843: #      -> 0001 0008 0009 0055 0056 0057 00a0 00aa 00ef 00ff
 844: #
 845: #  **Ten distinct values and EVERY ONE IS 0x00xx.**  The samples span all eight bits of
 846: #  the LOW byte -- three separate repairs saw to that -- and the entire high byte was
 847: #  never varied.  So a predicate that moves into the unsampled dimension is invisible to
 848: #  all of them, however many low-byte values are added.
 849: #
 850: #  *** THE GENERAL LESSON, WHICH IS WHY THIS ROW EXISTS RATHER THAN A FOURTH LOW-BYTE
 851: #  SAMPLE: THREE POINT SAMPLES CANNOT DISCHARGE A FAMILY. ***  For any finite declined set
 852: #  S, a predicate keyed on a DIMENSION S does not vary escapes it.  Each earlier repair
 853: #  added samples along the axis the previous escape used; this one changes axis.
 854: #
 855: #  The mutant is plausibly dressed -- `d->cond` IS a uint8_t, so "mask to the register
 856: #  width" reads like a robustness fix, which is exactly the shape clause (d) asks for.
 857: #
 858: #  Three channels in one session, because the mutant has two distinct harms: the value
 859: #  must not land, the event must not fire, and the decline must still be announced.
 860: A = Addr(CODE)
 861: t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
 862:                         + store16(GDROM_COND, 0x01ef, A)
 863:                         + load16(GDROM_COND, A, dest=2)
 864:                         + load32(SYSASIC_PEND1, A, dest=3))
 865: m = COND_RE.search(t)
 866: row("R12d hi byte", "%s|%s|%s" % (m.group(1) if m else "absent",
 867:                                   printed(t, "r2"),
 868:                                   bit(t, "r3", GDROM_EVENT_BIT)),
 869:     "1ef|0xa0|clear", "0x01ef is DECLINED: the HIGH byte is not ignored")
 870: 
 871: # ------------------------------------------ R13  THE FOURTH STATEMENT OF THE ACCEPTED ARM
 872: #  *** THE 0xa0 ARM HAS FOUR STATEMENTS AND THIS DETECTOR PINNED TWO.  MEASURED ESCAPE,
 873: #  BUILT AND RUN BY THE opus5 SEAT: deleting `d->cmd_count = 0;` leaves all twenty other
 874: #  rows BYTE-IDENTICAL while restoring a guest-reachable HOST KILL. ***
 875: #
 876: #  R6 reads `d->busy & 0x08` and R8 reads `d->cond`; the mutant touches neither.  The two
 877: #  rows that ought to have caught it cannot, by construction.
 878: #
 879: #  WHY THE LINE IS LOAD-BEARING, and it is not this device's own arm that dies.  The
 880: #  GDROM_DATA *write* arm still holds a live exit(1) -- `fatal("Too much GDROM_DATA?")` --
 881: #  and it is documented UNREACHABLE on a three-leg warrant: cmd_count steps by 2, the == 12
 882: #  equality clears busy at the boundary, and **0xa0 resets it**.  THE THIRD LEG IS THIS
 883: #  LINE.  Delete it and the attack is `0xa0` -> six DATA words -> `0xa0` -> one DATA word,
 884: #  which is any guest issuing two GD-ROM commands in a row; the host dies on the first data
 885: #  write of the second command.  Measured: attack probe 5/5 exit0 on the fix tree, 3/5
 886: #  exit1 on the mutant, with an attribution control (same traffic, no re-arm) green on both.
 887: #
 888: #  *** AND IT IS A CONTRACT BREACH, NOT AN OUT-OF-CONTRACT ESCAPE. ***  Clause (e) claims
 889: #  "emptying either accepted arm (R6, R8, R9)".  The contract disclaims the GDROM_DATA READ
 890: #  path; this consequence lands in the WRITE path.
 891: #
 892: #  *** AND `PRETABLE.out` ENUMERATED `d->cmd_count` BY NAME AS A SITE-B BODY FIELD, TWICE,
 893: #  AND THEN NO ROW WAS WRITTEN. ***  That is #490's lost-prescription failure occurring in
 894: #  the very artifact that exists to prevent it, two sections after it says so.
 895: #
 896: #  The oracle is the absence of the kill, on a LATER access whose outcome depends on state
 897: #  the accepted arm set -- so it does not reach for the accept-side survival channel the
 898: #  header bans.  It doubles as the carrier for `gdromexitsix`'s absence record, whose
 899: #  warrant this round's diff edited without re-running the death measurement.
 900: TOOMUCH_TEXT = "Too much GDROM_DATA?"
 901: A = Addr(CODE)
 902: t, alive, how = session(store16(GDROM_COND, 0x00a0, A)
 903:                         + store16(GDROM_DATA, 0x1111, A)
 904:                         + store16(GDROM_DATA, 0x2222, A)
 905:                         + store16(GDROM_DATA, 0x3333, A)
 906:                         + store16(GDROM_DATA, 0x4444, A)
 907:                         + store16(GDROM_DATA, 0x5555, A)
 908:                         + store16(GDROM_DATA, 0x6666, A)
 909:                         + store16(GDROM_COND, 0x00a0, A)
 910:                         + store16(GDROM_DATA, 0x7777, A))
 911: #  *** R13's WANT IS A NULL OUTCOME, AND A NULL OUTCOME IS WHAT A DEAD SESSION PRODUCES. ***
 912: #  `0|exit0` -- no kill token, host alive -- is BIT-IDENTICAL to a run in which none of these
 913: #  nine stores executed at all.  That is the `storesidedead` class, and this row drives more
 914: #  stores than any other, so it has the most ways to die silently: *a row that drives a longer
 915: #  sequence has MORE ways to die quietly, not fewer*, which inverts the intuition that a
 916: #  richer row is a stronger row.
 917: #
 918: #  THE EXECUTION WITNESS COSTS NOTHING AND WAS FOUND BY A SEAT LOOKING FOR IT.  The sixth
 919: #  DATA word completes the 12-byte packet and DISPATCHES: `cmd[0]` is 0x11 (the low byte of
 920: #  0x1111), which no case implements, so `handle_command()`'s latched default arm announces
 921: #  `[ dreamcast_gdrom: handle_command: unimplemented command 0x11 -- declined.  (once) ]`.
 922: #
 923: #  **That token fires on the correct build AND on the mutant** -- it comes from word 6, and
 924: #  the mutant's kill lands on word 7 -- so folding it in converts R13's want from a NULL
 925: #  outcome to a POSITIVE OBSERVABLE without weakening the kill.  A session whose stores never
 926: #  ran cannot produce it.
 927: #
 928: #  *THE GENERAL DISCRIMINATOR, which is better than the row enumeration the filed class
 929: #  carries: a row wanting a POSITIVE observable is store-death-safe; a row wanting a NULL
 930: #  outcome is not.*  The one refinement is that the positive observable must be one only the
 931: #  STORE can produce -- R12's no-data diagnostic is positive and is ALSO produced by the fresh
 932: #  state, which is why R12 remains a member of the class and this row no longer is.
 933: #  *** AND THE TOKEN CLOSED A SECOND MUTANT NOBODY WAS LOOKING FOR, WHICH IS THE PART WORTH
 934: #  RECORDING. ***  A different seat, reviewing the version WITHOUT this token, showed that
 935: #  R13 pinned less than its comment claimed:
 936: #
 937: #      d->cmd_count = 1;      /* was = 0 -- a REPLACEMENT, not a deletion */
 938: #
 939: #  The six words then step 1, 3, 5, 7, 9, 11 -- **the `== 12` equality NEVER FIRES**, so busy
 940: #  is never cleared, no command ever dispatches, and the seventh word is safe.  The old
 941: #  oracle (`0 kills | exit0`) is exactly that mutant's behaviour, so it escaped: R13 pinned
