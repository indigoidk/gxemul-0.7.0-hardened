 193: def printed32(t, reg):
 194:     """The low 32 bits of a register loaded by `lw`.
 195: 
 196:     *** lw SIGN-EXTENDS.  A 32-bit read of 0xcafebabe lands in the 64-bit
 197:     register as 0xffffffffcafebabe, and a row comparing the raw string then
 198:     FAILS on MIPS semantics rather than on device behaviour.  That bit this
 199:     detector on its first run -- 21/22 with the device entirely correct --
 200:     and the two neighbouring accept rows passed only because their fixtures
 201:     happen to have bit 31 CLEAR. ***
 202: 
 203:     Masking rather than choosing a friendlier constant is deliberate: it
 204:     makes the row correct BY CONSTRUCTION for any value, instead of correct
 205:     by an accident of the fixture that the next person to edit it cannot
 206:     see.  Nothing is lost -- for a `lw` the upper 32 bits carry no device
 207:     data, only the sign extension.
 208:     """
 209:     v = printed(t, reg)
 210:     if v == "absent":
 211:         return v
 212:     return "0x%x" % (int(v, 16) & 0xffffffff)
