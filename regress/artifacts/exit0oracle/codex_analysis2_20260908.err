for p,value in value_sites.items():
    t=ast.parse(Path(p).read_text(encoding='utf-8'))
    population={n.lineno for n in ast.walk(t) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='row' and len(n.args)>2 and isinstance(n.args[2],ast.Constant) and n.args[2].value=='exit0'}
    alone=unpaired_sites.get(p,set())
