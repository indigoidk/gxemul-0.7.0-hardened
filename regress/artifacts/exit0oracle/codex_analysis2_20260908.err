490:                         + load(A, 0xffffffff80002000) + ["print v0"])
491: row("two once", t.count(DRAW), 1,
492:     "TWO distinct declined ops, ONE message -- kills a dropped |= (flood)")
493: row("two live", printed(t, "v0") if alive else "died", "0x0",
494:     "...and the guest survives both")
495: 
496: # ------------------------------------------------------------ the READ arm
497: #  `if (startFlag)' is not conditioned on MEM_WRITE, so a START-aliased READ
498: #  draws too -- with whatever op the register already holds, i.e. the reset
499: #  value.  A repair applied to the write direction only escapes every row above.
500: A = Addr(CODE)
501: t, alive, how = session(load(A, DE + START_ONLY) + ["print v0"])
502: row("rd surv", how, "exit0",
503:     "a START-aliased READ also draws, and is declined")
504: row("rd decl", t.count(declined("0x00000000")), 1,
505:     "...announced with the FULL literal -- kills a write-only repair")
506: 
507: # --------------------------------------------------- the CROSS-LATCH row
508: #  *** EVERY ROW ABOVE RUNS IN A FRESH SESSION WITH NO PRIOR DEVICE TRAFFIC, AND A
509: #  REVIEW SEAT POINTED OUT WHAT THAT CANNOT SEE: a bit-value mutant onto an
510: #  ALREADY-USED bit (1 << 6 is #498's SGIRE_W_DE_LEN, 1 << 8 is #499's UNMAP_RD)
511: #  leaves those latches CLEAR in a fresh session, so the announce still fires and
512: #  every row above passes.  The collision is only visible once something else has
513: #  ALREADY SET the colliding bit. ***
514: #
515: #  It matters because the four sgi_re/sgi_de/sgi_mte/sgi_de_status handlers share
516: #  ONE malloc'd struct, so `d->warned' is shared ACROSS DEVICES -- #498 measured a
517: #  reused bit at 23/25, and BOTH #499 and this round were originally designed for
518: #  1 << 7.  The collision was caught by a human listing the enum, which is exactly
519: #  the kind of catch that should not be relied upon.
520: #
521: #  So: fire the #498 width latch FIRST with a byte access, THEN trigger the draw,
522: #  and require the prim-op decline ANYWAY.  Under a colliding bit the first access
523: #  pre-sets it and this row goes silent.
524: A = Addr(CODE)
525: t, alive, how = session(store(A, DE + 0x0, val="0x5a", op=OP_SB_T0_A3)
526:                         + store(A, DE + PRIM_START, val="0x02000000")
527:                         + load(A, 0xffffffff80002000) + ["print v0"])
528: row("xlatch decl", t.count(declined("0x02000000")), 1,
529:     "prim-op decline fires even AFTER another latch set -- kills a shared bit")
530: row("xlatch live", printed(t, "v0") if alive else "died", "0x0",
531:     "...and the guest survives the composed session")
532: 
533: #  *** AND ONE PRE-SET LATCH IS ONE CELL, NOT THE CLASS -- SAME MISTAKE, SAME
534: #  ROUND, ONE ROW OVER.  Two seats found it independently. ***
535: #
536: #  `xlatch decl' above pre-fires exactly ONE colliding bit, #498's 1 << 6.  The
537: #  enum's OTHER already-used bits are #499's 1 << 7 (UNMAP_WR) and 1 << 8
538: #  (UNMAP_RD), and NO row in this file raises either before drawing -- so
539: #  aliasing SGIRE_W_PRIM_OP onto 1 << 7 or 1 << 8 left all 30 rows green while
540: #  making the decline go silent after ordinary unmapped traffic.  A one-token
541: #  edit to the very constant this round ADDED: floor clause (d), not coverage
542: #  debt.
543: #
544: #  The four handlers share one `d->warned', so the unmapped windows on sgi_re
545: #  set latches that the sgi_de draw path then tests.  Raising BOTH in one
546: #  session closes the remaining pair; with 1 << 6 above, every already-used bit
547: #  in the enum is now pre-set by some row.
548: A = Addr(CODE)
549: t, alive, how = session(store(A, RE + UNMAP_W, val="0x5a")
550:                         + load(A, RE + UNMAP_R)
551:                         + store(A, DE + PRIM_START, val="0x02000000")
552:                         + load(A, 0xffffffff80002000) + ["print v0"])
553: row("xlatch unm", t.count(declined("0x02000000")), 1,
554:     "decline fires after BOTH #499 unmapped latches -- kills an alias onto 1<<7 or 1<<8")
555: row("xlatch unliv", printed(t, "v0") if alive else "died", "0x0",
556:     "...and the guest RUNS ON through the four-access session")
557: 
558: #  *** AND THREE PRE-SET BITS IS THREE CELLS, NOT THE CLASS.  FOUND BY THE
559: #  PRE-TABLE BLOCK -- the mandatory check I had SKIPPED, run late, which located
560: #  in one grep what four panels had left. ***

