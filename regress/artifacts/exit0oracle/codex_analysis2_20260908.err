581: 
582: def printed(t, reg):
583:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
584:     return "0x%x" % int(m.group(1), 16) if m else "absent"
585: 
586: 
587: def program(insns, at=CODE):
588:     #  `at' lets a session run TWO programs: a second sequence at the SAME address finds
589:     #  pc already there and the assignment is skipped (the Addr hazard, designed out in
590:     #  the sgi probes with Addr.take()).  Callers needing two pass at=CODE + 0x100.
591:     words = list(insns) + [I_BR_SELF, 0]
592:     cmds = ["put w 0x%x, 0x%08x" % (at + 4 * i, w) for i, w in enumerate(words)]
593:     return cmds + ["pc=0x%x" % at, "step %d" % len(insns)]
594: 
595: 
596: def setup(r5="0x5a5a5a5a", r6="0x0"):
597:     return ["r2=0x%x" % PCC2, "r3=0x%x" % SCRATCH, "r5=%s" % r5, "r6=%s" % r6,
598:             "r4=0x%x" % SENTINEL]
599: 
600: 
601: print("pcc2widthkills DETECTOR -- binary=%s label=%s" % (BIN, LABEL))
602: print("%-16s %-12s %-12s %-46s %s" % ("row", "got", "want", "note", ""))
603: 
604: # ------------------------------------------------------------------ controls
605: t, alive, how = session(setup() + program([I_ST_SCR, I_LD_SCR]) + ["print r4"])
606: row("live", printed(t, "r4") if alive else "died", "0x5a5a5a5a",
607:     "RAM word round-trips through the same decode")
608: t, alive, how = session(setup() + program([ST_B(5, CHIPID)]))
609: row("devsig", t.count(DEVSIG), 1, "a byte write to CHIPID makes the DEVICE speak")
610: t, alive, how = session(setup() + program([I_ST_SCR, LD_B(4, GENCTL), I_LD_SCR]) + ["print r4"])
611: row("byte rd", how, "exit0", "ld.b GENCTL: the legal width, serviced on both builds")
612: row("byte rd liv", printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
613: 
614: # --------------------------------------- survival pairs at the five reachable blocks
615: #  Each kill row is PAIRED with a positive post-access observable.
616: for nm, off in (("genctl", GENCTL), ("t2ctl", T2CTL), ("t2icr", T2ICR),
617:                 ("sccerr", SCCERR), ("scctx", SCCTX)):
618:     t, alive, how = session(setup() + program([I_ST_SCR, LD_H(4, off), I_LD_SCR]) + ["print r4"])
619:     row("hrd " + nm, how, "exit0", "ld.h %s (aligned halfword READ) survives" % nm.upper())
620:     row("hrd %s lv" % nm, printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
621:     row("hrd %s nod" % nm, t.count(DECL), 0,
622:         "...and a wide READ is never declined (the direction split's own conjunct)")
623:     #  r6 = the halfword to store: both lanes keep GENCTL's bit 0x04 CLEAR (pcc2c040kill)
624:     t, alive, how = session(setup(r6="0xaabb") + program([I_ST_SCR, ST_H(6, off), I_LD_SCR]) + ["print r4"])
625:     row("hwr " + nm, how, "exit0", "st.h %s (aligned halfword WRITE) survives" % nm.upper())
626:     row("hwr %s lv" % nm, printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
627: #  SCCERR is the one 4-aligned block: word read AND write
628: t, alive, how = session(setup() + program([I_ST_SCR, LD_W(4, SCCERR), I_LD_SCR]) + ["print r4"])
629: row("wrd sccerr", how, "exit0", "ld SCCERR (the one 4-aligned block) survives")
630: row("wrd sccerr lv", printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
631: row("wrd sccerr nod", t.count(DECL), 0, "...and the word READ is never declined")
632: t, alive, how = session(setup(r6="0x00000000") + program([I_ST_SCR, ST_W(6, SCCERR), I_LD_SCR]) + ["print r4"])
633: row("wwr sccerr", how, "exit0", "st SCCERR (word WRITE) survives")
634: row("wwr sccerr lv", printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
635: #  SCCERR's arm always stores 0, so decline and accept are VALUE-identical there: the
636: #  only channel that varies is the announcement.
637: row("wwr sccerr dcl", t.count("write to PCCTWO_SCCERR " + DECL), 1,
638:     "...and it was DECLINED once -- the message is the only channel here")
639: 
640: # ---------------------------------------------------------- VALUE rows (reads)
641: #  A wide read must compose the lanes in ADDRESS order.  VECBASE's arm masks & 0xf0
642: #  and GENCTL's stores the byte, so the halfword at 0x02 is GENCTL<<8 | VECBASE.
643: #  0x82 keeps bit 0x04 clear.
644: t, alive, how = session(setup(r5="0x82", r6="0x50")
645:                         + program([ST_B(5, GENCTL), ST_B(6, VECBASE), LD_HU(4, GENCTL)]) + ["print r4"])
646: row("val h genctl", printed(t, "r4") if alive else "died", "0x8250",
647:     "ld.h at GENCTL composes GENCTL:VECBASE in address order -- kills lane-order / zero-fill")
648: #  word at SCCERR: SCCERR always 0; SCCICR & 0x1f; SCCTX & 0x1f; SCCRX & 0xdf.
649: t, alive, how = session(setup(r5="0x15", r6="0x1f")
650:                         + program([ST_B(5, SCCICR), ST_B(6, SCCTX), ST_B(6, SCCRX), LD_W(4, SCCERR)]) + ["print r4"])
651: row("val w sccerr", printed(t, "r4") if alive else "died", "0x151f1f",
652:     "ld at SCCERR composes 00:SCCICR:SCCTX:SCCRX -- four lanes, right order")
653: 
654: # ------------------------------------------------ READBACK rows (the DELETE killer)
655: #  After a declined st.h 0xAABB to GENCTL, BOTH lanes must be unchanged.  Under a bare
656: #  deletion GENCTL reads 0xBB (the neighbour's lane); under an accidental compose it
657: #  reads 0xAA and VECBASE 0xB0.  Both lanes of 0xAABB keep bit 0x04 clear.
658: t, alive, how = session(setup(r5="0x82", r6="0xaabb")
659:                         + program([ST_B(5, GENCTL), ST_H(6, GENCTL), LD_BU(4, GENCTL)]) + ["print r4"])
660: row("rb genctl", printed(t, "r4") if alive else "died", "0x82",
661:     "GENCTL unchanged after a declined st.h -- kills DELETE (0xbb) and compose (0xaa)")
662: row("rb genctl dcl", t.count("write to PCCTWO_GENCTL " + DECL), 1,
663:     "...and the decline was announced ONCE")
664: t, alive, how = session(setup(r5="0x50", r6="0xaabb")
665:                         + program([ST_B(5, VECBASE), ST_H(6, GENCTL), LD_BU(4, VECBASE)]) + ["print r4"])
666: row("rb vecbase", printed(t, "r4") if alive else "died", "0x50",
667:     "VECBASE unchanged too -- the second lane of the declined halfword")
668: 
669: # ---------------------------- per-arm channels (pass 2: sibling parity, arm by arm)
670: #  A seat pointed out that only GENCTL had a readback: every other reachable arm's
671: #  halfword-write row checked SURVIVAL alone, so a guard edited at ONE arm (`len > 2',
672: #  or the guard deleted, at T2ICR only) left every row green.  Each arm now has its own
673: #  channel, with a lane value its own mask turns into a different byte when it lands.
674: for nm, off, pre, landed in (("t2ctl", T2CTL, "0x03", "0x3"), ("t2icr", T2ICR, "0x13", "0x13"),
675:                              ("scctx", SCCTX, "0x1f", "0x1f")):
676:     t, alive, how = session(setup(r5=pre, r6="0xaab8")
677:                             + program([ST_B(5, off), ST_H(6, off), LD_BU(4, off)]) + ["print r4"])
678:     row("rb " + nm, printed(t, "r4") if alive else "died", landed,
679:         "%s unchanged after a declined st.h -- kills a guard edited at THIS arm" % nm.upper())
680:     row("rb %s dcl" % nm, t.count("write to PCCTWO_%s " % ("TxCTL" if nm == "t2ctl" else "TxICR" if nm == "t2icr" else "SCCTX") + DECL), 1,
681:         "...announced once at this arm")
682: t, alive, how = session(setup(r6="0xaab8") + program([ST_H(6, SCCERR)]))
683: row("hwr sccerr dcl", t.count("write to PCCTWO_SCCERR " + DECL), 1,
684:     "halfword write to SCCERR declined once -- value-identical arm, message channel")
685: 
686: #  PRE-TABLE BLOCK yield (section 1, guard field vs body field): the guard reads the access
687: #  SHAPE (len) and the guarded body reads the VALUE (idata).  An operand swap to a value
688: #  test -- `idata > 0xff', a plausible "does it fit a byte" reading -- accepts a halfword
689: #  write whose value fits, and big-endian 0x0022 then stores 0x22, the NEIGHBOUR's lane,
690: #  into GENCTL: the original defect, behind a guard that still reads like a width check.
691: #  Every other wide-write row used a value above 0xff, so all 77 were green under it BY
692: #  CONSTRUCTION.  Written before the repair table ran; the table says whether it kills.
693: t, alive, how = session(setup(r5="0x11", r6="0x0022")
694:                         + program([ST_B(5, GENCTL), ST_H(6, GENCTL), LD_BU(4, GENCTL)]) + ["print r4"])
695: row("rb genctl lo", printed(t, "r4") if alive else "died", "0x11",
696:     "st.h of a value that FITS a byte is still declined -- the guard is on len, not idata")
697: 
698: # ------------------------- latch CARDINALITY (pass 2, the measuring seat's class closer)
699: #  `latch same' and `latch two' pin ONE pair out of 66: every other session writes at most
700: #  one BLOCK, so a bit shared by any other pair announces normally and no row moves.
701: #  MEASURED by the builder: aliasing SCCTX onto SCCRX's bit -- a ONE-CHARACTER edit --
702: #  left the 60-row detector at 60/60.  ONE OFFSET PER BLOCK: TxCTL serves T1CTL+T2CTL
703: #  and TxICR serves T1ICR+T2ICR, so twelve LABELS would give only ten announces -- the
704: #  same units slip that let "five even blocks + seven odd ones = twelve" read as all
705: #  twelve blocks.  This row pins the CARDINALITY of the latch: any collision anywhere in
706: #  the 12-bit space drops the count.  (Operator path for all twelve, so the odd ones are
707: #  reachable; the guest-reachable halves have their own rows above.)
708: BLOCKS12 = (("GENCTL", 0x02), ("VECBASE", 0x03), ("PSCALEADJ", 0x15), ("TxCTL", 0x16),
709:             ("TxICR", 0x1a), ("SCCERR", 0x1c), ("SCCICR", 0x1d), ("SCCTX", 0x1e),
710:             ("SCCRX", 0x1f), ("SCSIICR", 0x2f), ("IPL", 0x3e), ("MASK", 0x3f))
711: #  VALUE 0x0003, not 0x0303: it fits a byte, so this row ALSO reds if any arm swaps its
712: #  guard operand from len to a value test (see `rb genctl lo').  On the fix the value
713: #  never lands, so the expectation is value-independent.
714: t, alive, how = session(["put h 0x%x, 0x0003" % (PCC2 + o) for _, o in BLOCKS12])
715: row("latch all", t.count(DECL), 12,
716:     "one wide write per BLOCK -> TWELVE announces: bit CARDINALITY, not one pair")
717: row("latch all lv", how, "exit0", "...and the host survived all twelve blocks")
718: #  PASS 5 (fable5, MEASURED): `break' -> `return 0' at an OPERATOR-only block is a total escape
