import ast
from pathlib import Path
paths=['regress/gdrom_decline_probe.py','regress/pcc2_width_probe.py','regress/gdrom_default_probe.py','regress/pcc2_width_witness.py','regress/gdrom_toclen_probe.py','regress/sgi_de_primop_probe.py','regress/sgi_de_width_probe.py','regress/sgi_re_unmapped_probe.py','regress/sgi_re_width_probe.py']
total=0
for p in paths:
    t=ast.parse(Path(p).read_text(encoding='utf-8'))
    parents={c:n for n in ast.walk(t) for c in ast.iter_child_nodes(n)}
    signatures=[n for n in ast.walk(t) if isinstance(n,ast.FunctionDef) and n.name=='row']
    assert len(signatures)==1
    names=[a.arg for a in signatures[0].args.args]
    calls=sorted((n for n in ast.walk(t) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='row'),key=lambda n:n.lineno)
    exact=[]; compound=[]; unpacked=[]
    for n in calls:
        args=dict(zip(names,n.args)); args.update({k.arg:k.value for k in n.keywords})
        if any(isinstance(a,ast.Starred) for a in n.args) or None in args: unpacked.append(n.lineno)
        v=args.get('want')
        if isinstance(v,ast.Constant) and isinstance(v.value,str) and 'exit0' in v.value:
            (exact if v.value=='exit0' else compound).append((n,ast.unparse(args['name']),v.value))
    total+=len(exact)
    print('\\nFILE',p,'EXACT_SITES',len(exact),'UNPACKED',unpacked)
    for n,name,want in exact:
        ancestors=[]; a=parents.get(n)
        while a:
            if isinstance(a,ast.For): ancestors.append('for '+ast.unparse(a.target)+' in '+ast.unparse(a.iter))
            if isinstance(a,ast.If): ancestors.append('if '+ast.unparse(a.test))
            if isinstance(a,ast.FunctionDef): ancestors.append('inside def '+a.name)
            a=parents.get(a)
        print(n.lineno,name,'ANCESTORS',ancestors)
    for n,name,want in compound: print('COMPOUND_EXCLUDED',n.lineno,name,repr(want))
print('\\nTOTAL_EXACT_SITES',total)
