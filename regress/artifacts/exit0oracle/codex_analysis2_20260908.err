1314: #  PASS 4 (codex): `acc all' proves no DECLINE and survival; it does not prove the byte
1315: #  reached the arm's BODY.  For the two print-only arms the body's own print is the proof:
1316: t, alive, how = session(setup(r5="0x10") + program([ST_B(5, PSCALEADJ)]))
1317: row("acc pscale ign", t.count("PSCALEADJ ignored"), 1,
1318:     "a legal byte write to PSCALEADJ reaches its body -- the ignored print fires once")
1319: t, alive, how = session(setup(r5="0x10") + program([ST_B(5, IPL)]))
1320: row("acc ipl ro", t.count("write to read-only PCCTWO_IPL"), 1,
1321:     "a legal byte write to IPL reaches its body -- the read-only print fires once")
1322: #  The T1 labels of the two SHARED blocks (deepseek, pass 3): their readbacks above are at
1323: #  the T2 offsets, so a fall-through reaching only the T1 half of a split block would leave
1324: #  `op t1ctl dcl' at 1 with nothing reading T1CTL back.  Operator path, own readbacks:
1325: #  (`want' is the value as the debugger PRINTS it -- 0x03 comes back as `0x3'.  The first
1326: #  part-3 BASE run reddened this row on the fix for exactly that string mismatch, 95/96;
1327: #  the value was right.  Re-measured in part 3b.)
1328: for nm, off, pre, want in (("t1ctl", T1CTL, "0x03", "0x3"), ("t1icr", T1ICR, "0x13", "0x13")):
1329:     t, alive, how = session(setup(r5=pre) + program([ST_B(5, off)])
1330:                             + ["put h 0x%x, 0xaab8" % (PCC2 + off)]
1331:                             + program([LD_BU(4, off)], at=CODE + 0x100) + ["print r4"])
1332:     row("rb " + nm, printed(t, "r4") if alive else "died", want,
1333:         "%s unchanged after a declined put h at the T1 label -- a fall-through lands 0xb8 & mask (RMW at TxCTL: 0)" % nm.upper())
1334: 
1335: # --------------------------------- IPL (guest-reachable, EVEN) and MASK (operator, odd)
1336: #  IPL 0x3e: a halfword at 0x3e lands in the IPL arm.  Its write side is read-only (#119
1337: #  "ignored"), so a wide write is declined by the WIDTH latch first and a readback cannot
1338: #  tell the two refusals apart -- the channel is the message.
1339: t, alive, how = session(setup() + program([I_ST_SCR, LD_H(4, IPL), I_LD_SCR]) + ["print r4"])
1340: row("hrd ipl", how, "exit0", "ld.h IPL (EVEN, the SIXTH guest-reachable block) survives")
1341: row("hrd ipl lv", printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
1342: row("hrd ipl nod", t.count(DECL), 0, "...and the wide READ of IPL is never declined")
1343: t, alive, how = session(setup(r6="0x1234") + program([I_ST_SCR, ST_H(6, IPL), I_LD_SCR]) + ["print r4"])
1344: row("hwr ipl", how, "exit0", "st.h IPL survives")
1345: row("hwr ipl lv", printed(t, "r4") if alive else "died", "0x5a5a5a5a", "...and runs on")
1346: row("hwr ipl dcl", t.count("write to PCCTWO_IPL " + DECL), 1,
1347:     "...declined by the WIDTH latch (not the read-only one) -- the message is the channel")
1348: #  MASK 0x3f: odd, operator path.  It is GENCTL's twin, so it gets GENCTL's readback: set
1349: #  MASK to a known byte at the legal width, decline a wide write through the debugger,
1350: #  then read the byte back through a program at a SECOND address.  A deleted guard stores
1351: #  the wrong lane (0xbb); an accidental compose stores 0xaa.  reassert_interrupts on a
1352: #  MASK byte write is harmless here: GENCTL's C040 bit is clear and nothing is pending.
1353: t, alive, how = session(setup(r5="0x12") + program([ST_B(5, MASK)])
1354:                         + ["put h 0x%x, 0xaabb" % (PCC2 + MASK)]
1355:                         + program([LD_BU(4, MASK)], at=CODE + 0x100) + ["print r4"])
1356: row("op mask", how, "exit0", "debugger put h at odd MASK survives")
1357: row("op mask dcl", t.count("write to PCCTWO_MASK " + DECL), 1, "...and was declined once")
1358: row("rb mask", printed(t, "r4") if alive else "died", "0x12",
1359:     "MASK unchanged after the declined wide write -- GENCTL's twin gets GENCTL's readback")
1360: 
1361: # ---------------------------------------------------------------------- summary
1362: print("NOROW  two device instances               -- mvme187 has ONE pcc2; per-instance latch state"
1363:       " is by construction, not measured")
1364: print("NOROW  pcc2c040kill                        -- a LEGAL byte write of 0x04 to GENCTL still ends"
1365:       " the host; every GENCTL lane here keeps that bit clear")
1366: print("NOROW  pcc2defaultkill / pcc2counter8      -- other arms, other rounds")
1367: bad = [n for n, ok in rows if not ok]
1368: print("PCC2W_RESULT=%d/%d" % (len(rows) - len(bad), len(rows)))
1369: print("PCC2W_LABEL=%s" % LABEL)
1370: if bad:
1371:     print("PCC2W_RED=%s" % ",".join(bad))
1372: print("PCC2W_PROBE_DONE")

