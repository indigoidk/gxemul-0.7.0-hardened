import ast
from collections import defaultdict
from pathlib import Path
paths=['regress/gdrom_decline_probe.py','regress/pcc2_width_probe.py','regress/gdrom_default_probe.py','regress/pcc2_width_witness.py','regress/gdrom_toclen_probe.py','regress/sgi_de_primop_probe.py','regress/sgi_de_width_probe.py','regress/sgi_re_unmapped_probe.py','regress/sgi_re_width_probe.py']
def rows_in_order(body):
    for n in body:
        if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)): continue
        if isinstance(n,(ast.For,ast.While,ast.If,ast.With)):
            yield from rows_in_order(n.body)
            if hasattr(n,'orelse'): yield from rows_in_order(n.orelse)
        elif isinstance(n,ast.Try):
            yield from rows_in_order(n.body)
            for h in n.handlers: yield from rows_in_order(h.body)
            yield from rows_in_order(n.orelse)
            yield from rows_in_order(n.finalbody)
        else: yield n
sums=[0,0,0,0]
for p in paths:
    tree=ast.parse(Path(p).read_text(encoding='utf-8'))
    parents={c:n for n in ast.walk(tree) for c in ast.iter_child_nodes(n)}
    containers={n.targets[0].id:n.value for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and isinstance(n.value,(ast.Tuple,ast.List))}
    groups=defaultdict(list); last=None
    for n in rows_in_order(tree.body):
        if any(isinstance(c,ast.Call) and isinstance(c.func,ast.Name) and c.func.id=='session' for c in ast.walk(n)): last=n.lineno
        for c in ast.walk(n):
            if isinstance(c,ast.Call) and isinstance(c.func,ast.Name) and c.func.id=='row': groups[last].append(c)
    exact_total=bare=paired=expanded=0
    print('\\nFILE',p)
    for session_line,calls in groups.items():
        matches=[c for c in calls if len(c.args)>2 and isinstance(c.args[2],ast.Constant) and c.args[2].value=='exit0']
        for c in matches:
            exact_total+=1
            multiplier=1; a=parents.get(c)
            while a:
                if isinstance(a,ast.For):
                    val=containers[a.iter.id] if isinstance(a.iter,ast.Name) else a.iter
                    assert isinstance(val,(ast.Tuple,ast.List))
                    multiplier*=len(val.elts)
                a=parents.get(a)
            expanded+=multiplier
            others=[o for o in calls if o is not c]
            paired+=bool(others); bare+=not others
            print('SITE',c.lineno,ast.unparse(c.args[0]),'EXPANSION',multiplier,'SESSION',session_line,'OTHER_ROWS',[(o.lineno,ast.unparse(o.args[0])) for o in others])
    vals=[exact_total,expanded,bare,paired]
    sums=[a+b for a,b in zip(sums,vals)]
    print('COUNTS source/expanded/bare/paired',*vals)
print('\\nTOTAL source/expanded/bare/paired',*sums)
