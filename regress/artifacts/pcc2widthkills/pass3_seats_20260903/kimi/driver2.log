=== M_FALL_VECBASE alone (82/82 = sweep) ===
  mutated: FALL_VECBASE
build ok
PCC2W_RESULT=82/82
PCC2W_PROBE_DONE
=== M_FALL_IPL alone (82/82 = sweep) ===
  mutated: FALL_IPL
build ok
PCC2W_RESULT=82/82
PCC2W_PROBE_DONE
SPLIT_DONE
c
+ mutate FALL_VECBASE
+ python3 - FALL_VECBASE
+ build
+ rm -f /tmp/gxseat/tree/src/devices/dev_pcc2.o /tmp/gxseat/tree/gxemul
+ '[' /tmp/gxseat/tree/gxemul -nt /tmp/gxseat/tree/src/devices/dev_pcc2.c ']'
+ echo build ok
+ runprobe M_FALL_VECBASE
+ grep -E '^PCC2W_(RESULT|RED|PROBE_DONE)' /tmp/gxseat/M_FALL_VECBASE.out
+ echo '=== M_FALL_IPL alone (82/82 = sweep) ==='
+ cp /tmp/gxseat/base.c /tmp/gxseat/tree/src/devices/dev_pcc2.c
+ mutate FALL_IPL
+ python3 - FALL_IPL
+ build
+ rm -f /tmp/gxseat/tree/src/devices/dev_pcc2.o /tmp/gxseat/tree/gxemul
+ '[' /tmp/gxseat/tree/gxemul -nt /tmp/gxseat/tree/src/devices/dev_pcc2.c ']'
+ echo build ok
+ runprobe M_FALL_IPL
+ grep -E '^PCC2W_(RESULT|RED|PROBE_DONE)' /tmp/gxseat/M_FALL_IPL.out
+ cp /tmp/gxseat/base.c /tmp/gxseat/tree/src/devices/dev_pcc2.c
+ echo SPLIT_DONE
