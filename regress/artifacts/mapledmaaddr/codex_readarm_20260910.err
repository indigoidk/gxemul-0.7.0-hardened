  147: 		/*
  148: 		 *  NOTE/TODO:
  149: 		 *
  150: 		 *  Implement the controller in a reasonable way!
  151: 		 *  Theoretically, there are all of these buttons: ABCD XYZ Start
  152: 		 *  and two digital pads, two analog joysticks, and two
  153: 		 *  analog fire buttons (left and right).
  154: 		 */
  155: 
  156: 		int control_bits = 0;
  157: 		switch (key) {
  158: 		case 'a':
  159: 		case 'A':
  160: 			control_bits = 0x0004;
  161: 			break;
  162: 		case 'b':
  163: 		case 'B':
  164: 			control_bits = 0x0002;
  165: 			break;
  166: 		case 'c':
  167: 		case 'C':
  168: 			control_bits = 0x0001;
  169: 			break;
  170: 		case 'd':
  171: 		case 'D':
  172: 			control_bits = 0x0800;
  173: 			break;
  174: 
  175: 		case 'x':
  176: 		case 'X':
  177: 			control_bits = 0x0400;
  178: 			break;
  179: 		case 'y':
  180: 		case 'Y':
  181: 			control_bits = 0x0200;
  182: 			break;
  183: 		case 'z':
  184: 		case 'Z':
  185: 			control_bits = 0x0100;
  186: 			break;
  187: 
  188: 		case 's':
  189: 		case 'S':	/*  Start  */
  190: 			control_bits = 0x0008;
  191: 			break;
  192: 
  193: 		case '8':	/*  up  */
  194: 			control_bits = 0x0010;
  195: 			break;
  196: 		case '2':	/*  down  */
  197: 		case 'k':
  198: 			control_bits = 0x0020;
  199: 			break;
  200: 		case '4':	/*  left  */
  201: 		case 'u':
  202: 			control_bits = 0x0040;
  203: 			break;
  204: 		case '6':	/*  right  */
  205: 		case 'o':
  206: 			control_bits = 0x0080;
  207: 			break;
  208: 		}
  209: 
  210: 		if (control_bits != 0) {
  211: 			/*  Add to the controller queue:  */
  212: 			d->controller_queue[d->controller_queue_head] = control_bits;
  213: 			d->controller_queue_head =
  214: 			    (d->controller_queue_head + 1) % MAX_CONTROLLER_DATA;
  215: 			if (d->controller_queue_head == d->controller_queue_tail)
  216: 				fatal("[ dreamcast_maple: CONTROLLER QUEUE "
  217: 				    "OVERRUN! ]\n");
  218: 		}
  219: 	}
  220: }
  221: 
  222: 
  223: static int get_key(struct dreamcast_maple_data *d)
  224: {
  225: 	int key = d->char_queue[d->char_queue_tail];
  226: 	if (d->char_queue_head == d->char_queue_tail)
  227: 		return -1;
  228: 
  229: 	d->char_queue_tail = (d->char_queue_tail + 1) % MAX_CHARS;
  230: 	return key;
  231: }
  232: 
  233: 
  234: static int get_controller(struct dreamcast_maple_data *d)
  235: {
  236: 	int c = d->controller_queue[d->controller_queue_tail];
  237: 	if (d->controller_queue_head == d->controller_queue_tail)
  238: 		return 0;
  239: 
  240: 	d->controller_queue_tail = (d->controller_queue_tail + 1)
  241: 	    % MAX_CONTROLLER_DATA;
  242: 	return c;
  243: }
  244: 
  245: 
  246: /*
  247:  *  maple_getcond_controller_response():
  248:  *
  249:  *  Generate a controller response. Based on info from Marcus
  250:  *  Comstedt's page: http://mc.pp.se/dc/controller.html
  251:  */
  252: static void maple_getcond_controller_response(struct dreamcast_maple_data *d,
  253: 	struct cpu *cpu, int port, uint32_t receive_addr)
  254: {
  255: 	uint8_t buf[8];
  256: 	uint32_t response_code, transfer_code;
  257: 	int c;
  258: 
  259: 	transfer_code = (MAPLE_RESPONSE_DATATRF << 24) |
  260: 	    (((port << 6) | 0x20) << 16) |
  261: 	    ((port << 6) << 8) |
  262: 	    3  /*  Transfer length in 32-bit words  */;
  263: 	transfer_code = BE32_TO_HOST(transfer_code);
  264: 	cpu->memory_rw(cpu, cpu->mem, receive_addr, (unsigned char *) (void *) &transfer_code,
  265: 	    4, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  266: 	receive_addr += 4;
  267: 
  268: 	response_code = BE32_TO_HOST(MAPLE_FUNC(MAPLE_FN_CONTROLLER));
  269: 	cpu->memory_rw(cpu, cpu->mem, receive_addr, (unsigned char *) (void *) &response_code,
  270: 	    4, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  271: 	receive_addr += 4;
  272: 
  273: 	/*  NOTE: Inverse of the buttons pressed!  */
  274: 	c = ~get_controller(d);
  275: 
  276: 	/*
  277: 	 *  buf[0..1] = little endian button bitfield
  278: 	 *  buf[2] = right analogue trigger (0-255)
  279: 	 *  buf[3] = left analogue trigger (0-255)
  280: 	 *  buf[4] = analogue joystick X (0-255)
  281: 	 *  buf[5] = analogue joystick Y (0-255)
  282: 	 *  buf[6] = second analogue joystick X (0-255)
  283: 	 *  buf[7] = second analogue joystick Y (0-255)
  284: 	 */
  285: 	memset(buf, 0, 8);
  286: 	buf[0] = c & 0xff;
  287: 	buf[1] = c >> 8;
  288: 	buf[2] = buf[3] = 0;				// 0 = not pressed
  289: 	buf[4] = buf[5] = buf[6] = buf[7] = 128;	// 128 = centered
  290: 
  291: 	cpu->memory_rw(cpu, cpu->mem, receive_addr, (unsigned char *) (void *) &buf, 8,
  292: 	    MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  293: }
  294: 
  295: 
  296: /*
  297:  *  maple_getcond_keyboard_response():
  298:  *
  299:  *  Generate a keyboard key-press response. Based on info from Marcus
  300:  *  Comstedt's page: http://mc.pp.se/dc/kbd.html
  301:  */
  302: static void maple_getcond_keyboard_response(struct dreamcast_maple_data *d,
  303: 	struct cpu *cpu, int port, uint32_t receive_addr)
  304: {
  305: 	int key;
  306: 	uint8_t buf[8];
  307: 	uint32_t response_code, transfer_code;
  308: 
  309: 	transfer_code = (MAPLE_RESPONSE_DATATRF << 24) |
  310: 	    (((port << 6) | 0x20) << 16) |
  311: 	    ((port << 6) << 8) |
  312: 	    3  /*  Transfer length in 32-bit words  */;
  313: 	transfer_code = BE32_TO_HOST(transfer_code);
  314: 	cpu->memory_rw(cpu, cpu->mem, receive_addr, (unsigned char *) (void *) &transfer_code,
  315: 	    4, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  316: 	receive_addr += 4;
  317: 
  318: 	response_code = BE32_TO_HOST(MAPLE_FUNC(MAPLE_FN_KEYBOARD));
  319: 	cpu->memory_rw(cpu, cpu->mem, receive_addr, (unsigned char *) (void *) &response_code,
  320: 	    4, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  321: 	receive_addr += 4;
  322: 
  323: 	key = get_key(d);
  324: 
  325: 	/*
  326: 	 *  buf[0] = shift keys (1 = left ctrl, 2 = shift, 0x10 = right ctrl)
  327: 	 *  buf[1] = led state
  328: 	 *  buf[2] = key
  329: 	 */
  330: 	memset(buf, 0, 8);
  331: 
  332: 	if (key >= 'a' && key <= 'z')	buf[2] = 4 + key - 'a';
  333: 	if (key >= 'A' && key <= 'Z')	buf[0] = 2, buf[2] = 4 + key - 'A';
  334: 	if (key >= 1 && key <= 26)	buf[0] = 1, buf[2] = 4 + key - 1;
  335: 	if (key >= '1' && key <= '9')	buf[2] = 0x1e + key - '1';
  336: 	if (key == '!')			buf[0] = 2, buf[2] = 0x1e;
  337: 	if (key == '"')			buf[0] = 2, buf[2] = 0x1f;
  338: 	if (key == '#')			buf[0] = 2, buf[2] = 0x20;
  339: 	if (key == '$')			buf[0] = 2, buf[2] = 0x21;
  340: 	if (key == '%')			buf[0] = 2, buf[2] = 0x22;
  341: 	if (key == '^')			buf[0] = 2, buf[2] = 0x23;
  342: 	if (key == '&')			buf[0] = 2, buf[2] = 0x24;
  343: 	if (key == '*')			buf[0] = 2, buf[2] = 0x25;
  344: 	if (key == '(')			buf[0] = 2, buf[2] = 0x26;
  345: 	if (key == '@')			buf[0] = 2, buf[2] = 0x1f;
  346: 	if (key == '\n' || key == '\r')	buf[0] = 0, buf[2] = 0x28;
  347: 	if (key == ')')			buf[0] = 2, buf[2] = 0x27;
  348: 	if (key == '\b')		buf[0] = 0, buf[2] = 0x2a;
  349: 	if (key == '\t')		buf[0] = 0, buf[2] = 0x2b;
  350: 	if (key == ' ')			buf[0] = 0, buf[2] = 0x2c;
  351: 	if (key == '0')			buf[2] = 0x27;
  352: 	if (key == 27)			buf[2] = 0x29;
  353: 	if (key == '-')			buf[2] = 0x2d;
  354: 	if (key == '=')			buf[2] = 0x2e;
  355: 	if (key == '[')			buf[2] = 0x2f;
  356: 	if (key == '\\')		buf[2] = 0x31;
  357: 	if (key == '|')			buf[2] = 0x31, buf[0] = 2;
  358: 	if (key == ']')			buf[2] = 0x32;
  359: 	if (key == ';')			buf[2] = 0x33;
  360: 	if (key == ':')			buf[2] = 0x34;
  361: 	if (key == ',')			buf[2] = 0x36;
  362: 	if (key == '.')			buf[2] = 0x37;
  363: 	if (key == '/')			buf[2] = 0x38;
  364: 	if (key == '<')			buf[2] = 0x36, buf[0] = 2;
  365: 	if (key == '>')			buf[2] = 0x37, buf[0] = 2;
  366: 	if (key == '?')			buf[2] = 0x38, buf[0] = 2;
  367: 	if (key == '+')			buf[2] = 0x57;
  368: 
  369: 	cpu->memory_rw(cpu, cpu->mem, receive_addr, (unsigned char *) (void *) &buf, 8,
  370: 	    MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
  371: }
  372: 
  373: 
  374: /*
  375:  *  maple_do_dma_xfer():
  376:  *
  377:  *  Perform a DMA transfer. enable should be 1, and dmaaddr should point to
  378:  *  the memory to transfer.
  379:  */
  380: void maple_do_dma_xfer(struct cpu *cpu, struct dreamcast_maple_data *d)
  381: {
  382: 	uint32_t addr = d->dmaaddr;
  383: 
  384: 	if (!d->enable) {
  385: 		debug("[ maple_do_dma_xfer: not enabled? ]\n");
  386: 		return;
  387: 	}
  388: 
  389: 	/*  debug("[ dreamcast_maple: DMA transfer, dmaaddr = "
  390: 	    "0x%08" PRIx32" ]\n", addr);  */
  391: 
  392: 	/*
  393: 	 *  DMA transfers must be 32-byte aligned, according to Marcus
  394: 	 *   Comstedt's Maple demo program.
  395: 	 */
  396: 	if (addr & 0x1f) {
  397: 		fatal("[ dreamcast_maple: dmaaddr 0x%08" PRIx32" is NOT"
  398: 		    " 32-byte aligned; aborting ]\n", addr);
  399: 		return;
  400: 	}
  401: 
  402: 	/*
  403: 	 *  Handle one or more requests/responses:
  404: 	 *
  405: 	 *  (This is "reverse engineered" from Comstedt's maple demo program;
  406: 	 *  it might not be good enough to emulate how the Maple is being
  407: 	 *  used by other programs.)
  408: 	 */
  409: 	for (;;) {
  410: 		uint32_t receive_addr, response_code, cond;
  411: 		int port, last_message, cmd, to, datalen_cmd, unit;
  412: 		uint8_t buf[8];
  413: 
  414: 		/*  Read the message' two control words:  */
  415: 		cpu->memory_rw(cpu, cpu->mem, addr, (unsigned char *) (void *) &buf, 8, MEM_READ,
  416: 		    NO_EXCEPTIONS | PHYSICAL);
  417: 		addr += 8;
  418: 
  419: 		// int datalen = buf[0] * sizeof(uint32_t);
  420: 
  421: 		if (buf[1] & 2) {
  422: 			fatal("[ dreamcast_maple: TODO: GUN bit. ]\n");
  423: 			/*  TODO: Set some bits in A05F80C4 to indicate
  424: 			    which raster position a lightgun is pointing
  425: 			    at!  */
  426: 			exit(1);
  427: 		}
  428: 		port = buf[2];
  429: 		last_message = buf[3] & 0x80;
  430: 		receive_addr = buf[4] + (buf[5] << 8) + (buf[6] << 16)
  431: 		    + (buf[7] << 24);
  432: 
  433: 		if (receive_addr & 0xe000001f)
  434: 			fatal("[ dreamcast_maple: WARNING! receive address 0x"
  435: 			    "%08" PRIx32" isn't valid! ]\n", receive_addr);
  436: 
  437: 		/*  Read the command word for this message:  */
  438: 		cpu->memory_rw(cpu, cpu->mem, addr, (unsigned char *) (void *) &buf, 4, MEM_READ,
  439: 		    NO_EXCEPTIONS | PHYSICAL);
  440: 		addr += 4;
  441: 
  442: 		cmd = buf[0];
  443: 		to = buf[1];
  444: 		// int from = buf[2];
  445: 		datalen_cmd = buf[3];
  446: 
  447: 		/*  Decode the unit number:  */
  448: 		unit = 0;
  449: 		switch (to & 0x3f) {
  450: 		case 0x00:
  451: 		case 0x20: unit = 0; break;
  452: 		case 0x01: unit = 1; break;
  453: 		case 0x02: unit = 2; break;
  454: 		case 0x04: unit = 3; break;
  455: 		case 0x08: unit = 4; break;
  456: 		case 0x10: unit = 5; break;
  457: 		default: fatal("[ dreamcast_maple: ERROR! multiple "
  458: 			    "units? Not yet implemented. to = 0x%02x ]\n", to);
  459: 			exit(1);
  460: 		}
  461: 
  462: 		/*  fatal("[ dreamcast_maple: cmd=0x%02x, port=%c, unit=%i"
  463: 		    ", datalen=%i words. receive_addr=0x%08x ]\n",
  464: 		    cmd, port+'A', unit, datalen_cmd, receive_addr);  */
  465: 
  466: 		/*
  467: 		 *  Handle the command:
  468: 		 */
  469: 		switch (cmd) {
  470: 
  471: 		case MAPLE_COMMAND_DEVINFO:
  472: 			if (port < 0 || port >= N_MAPLE_PORTS ||
  473: 			    d->device[port] == NULL || unit != 0) {
  474: 				/*  No device present: Timeout.  */
  475: 				/*  debug("[ dreamcast_maple: response="
  476: 				    "timeout ]\n");  */
  477: 				response_code = (uint32_t) -1;
  478: 				response_code = LE32_TO_HOST(response_code);
  479: 				cpu->memory_rw(cpu, cpu->mem, receive_addr,
  480: 				    (unsigned char *) (void *) &response_code, 4, MEM_WRITE,
  481: 				    NO_EXCEPTIONS | PHYSICAL);
  482: 			} else {
  483: 				/*  Device present:  */
  484: 				unsigned int i;
  485: 				struct maple_devinfo *di =
  486: 				    &d->device[port]->devinfo;
  487: 				/*  debug("[ dreamcast_maple: response="
  488: 				    "\"%s\" ]\n", di->di_product_name);  */
  489: 				response_code = MAPLE_RESPONSE_DEVINFO |
  490: 				    (((port << 6) | 0x20) << 8) |
  491: 				    ((port << 6) << 16) |
  492: 				    ((sizeof(struct maple_devinfo) /
  493: 				    sizeof(uint32_t)) << 24);
  494: 				response_code = LE32_TO_HOST(response_code);
  495: 				cpu->memory_rw(cpu, cpu->mem, receive_addr,
  496: 				    (unsigned char *) (void *) &response_code, 4, MEM_WRITE,
  497: 				    NO_EXCEPTIONS | PHYSICAL);
  498: 				for (i=0; i<sizeof(struct maple_devinfo); i++)
  499: 					cpu->memory_rw(cpu, cpu->mem,
  500: 					    receive_addr + 4 + i, (unsigned
  501: 					    char *) di + i, 1, MEM_WRITE,
  502: 					    NO_EXCEPTIONS | PHYSICAL);
  503: 			}
  504: 			break;
  505: 
  506: 		case MAPLE_COMMAND_GETCOND:
  507: 			cpu->memory_rw(cpu, cpu->mem, addr, (unsigned char *) (void *) &buf, 4,
  508: 			    MEM_READ, NO_EXCEPTIONS | PHYSICAL);
  509: 			cond = buf[3] + (buf[2] << 8) + (buf[1] << 16)
  510: 			    + (buf[0] << 24);
  511: 			if (cond & MAPLE_FUNC(MAPLE_FN_CONTROLLER)) {
  512: 				maple_getcond_controller_response(
  513: 				    d, cpu, port, receive_addr);
  514: 			} else if (cond & MAPLE_FUNC(MAPLE_FN_KEYBOARD)) {
  515: 				maple_getcond_keyboard_response(
  516: 				    d, cpu, port, receive_addr);
  517: 			} else {
  518: 				fatal("[ dreamcast_maple: WARNING: GETCOND: "
  519: 				    "UNIMPLEMENTED 0x%08" PRIx32" ]\n", cond);
  520: 				exit(1);
  521: 			}
  522: 			break;
  523: 
  524: 		case MAPLE_COMMAND_BWRITE:
  525: 			fatal("[ dreamcast_maple: BWRITE: TODO ]\n");
  526: 			break;
  527: 
  528: 		default:fatal("[ dreamcast_maple: command %i: TODO ]\n", cmd);
  529: 			exit(1);
  530: 		}
  531: 
  532: 		addr += datalen_cmd * 4;
  533: 
  534: 		/*  Last request? Then stop.  */
  535: 		if (last_message)
  536: 			break;
  537: 	}
  538: 
  539: 	// TODO: Should the DMA address be updated?
  540: 	d->dmaaddr = addr;
  541: 
  542: 	/*  Assert the SYSASIC_EVENT_MAPLE_DMADONE event:  */
  543: 	SYSASIC_TRIGGER_EVENT(SYSASIC_EVENT_MAPLE_DMADONE);
  544: }
  545: 
  546: 
  547: DEVICE_ACCESS(dreamcast_maple)
  548: {
  549: 	struct dreamcast_maple_data *d = (struct dreamcast_maple_data *) extra;
  550: 	uint64_t idata = 0, odata = 0;
  551: 
  552: 	if (writeflag == MEM_WRITE)
  553: 		idata = memory_readmax64(cpu, data, len);
  554: 
  555: 	switch (relative_addr) {
  556: 
  557: 	case 0x04:	/*  MAPLE_DMAADDR  */
  558: 		if (writeflag == MEM_WRITE) {
  559: 			d->dmaaddr = idata;
  560: 			/* debug("[ dreamcast_maple: dmaaddr set to 0x%08x"
  561: 			    " ]\n", d->dmaaddr);  */
  562: 		} else {
  563: 			fatal("[ dreamcast_maple: TODO: read from dmaaddr ]\n");
  564: 			odata = d->dmaaddr;
  565: 			exit(1);
  566: 		}
  567: 		break;
  568: 
  569: 	case 0x10:	/*  MAPLE_RESET2  */
  570: 		if (writeflag == MEM_WRITE && idata != 0)
  571: 			fatal("[ dreamcast_maple: UNIMPLEMENTED reset2 value"
  572: 			    " 0x%08x ]\n", (int)idata);
  573: 		break;
  574: 
  575: 	case 0x14:	/*  MAPLE_ENABLE  */
  576: 		if (writeflag == MEM_WRITE)
  577: 			d->enable = idata;
  578: 		else
  579: 			odata = d->enable;
  580: 		break;
  581: 
  582: 	case 0x18:	/*  MAPLE_STATE  */
  583: 		if (writeflag == MEM_WRITE) {
  584: 			switch (idata) {
  585: 			case 0:	break;
  586: 			case 1:	maple_do_dma_xfer(cpu, d);
  587: 				break;
  588: 			default:fatal("[ dreamcast_maple: UNIMPLEMENTED "
  589: 				    "state value %i ]\n", (int)idata);
  590: 			}
  591: 		} else {
  592: 			/*  Always return 0 to indicate DMA xfer complete.  */
  593: 			odata = 0;
  594: 		}
  595: 		break;
  596: 
  597: 	case 0x80:	/*  MAPLE_SPEED  */
  598: 		if (writeflag == MEM_WRITE) {
  599: 			d->timeout = (idata >> 16) & 0xffff;
  600: 			/*  TODO: Bits 8..9 are "speed", but only the value
  601: 			    0 (indicating 2 Mbit/s) should be used.  */
  602: 			debug("[ dreamcast_maple: timeout set to %i ]\n",
  603: 			    d->timeout);
  604: 		} else {
  605: 			odata = d->timeout << 16;
  606: 		}
  607: 		break;
  608: 
  609: 	case 0x8c:	/*  MAPLE_RESET  */
  610: 		if (writeflag == MEM_WRITE) {
  611: 			if (idata != 0x6155404f && idata != 0x61557f00)
  612: 				fatal("[ dreamcast_maple: UNIMPLEMENTED reset "
  613: 				    "value 0x%08x ]\n", (int)idata);
  614: 			d->enable = 0;
  615: 		}
  616: 		break;
  617: 
  618: 	case 0xe8:	/*  UNKNOWN_0xe8  */
  619: 		if (writeflag == MEM_WRITE) {
  620: 			// The Dreamcast PROM writes 1 here.
  621: 			if (idata != 1) {
  622: 				fatal("[ dreamcast_maple: UNIMPLEMENTED 0xe8 "
  623: 				    "value 0x%08x ]\n", (int)idata);
  624: 			}
  625: 		}
  626: 		break;
  627: 
  628: 	default:if (writeflag == MEM_READ) {
  629: 			fatal("[ dreamcast_maple: UNIMPLEMENTED read from "
  630: 			    "addr 0x%x ]\n", (int)relative_addr);
  631: 		} else {
  632: 			fatal("[ dreamcast_maple: UNIMPLEMENTED write to addr "
  633: 			    "0x%x: 0x%x ]\n", (int)relative_addr, (int)idata);
  634: 		}
  635: 	}
  636: 
  637: 	if (writeflag == MEM_READ)
