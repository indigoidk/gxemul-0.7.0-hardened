"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$lineNumber = 0; Get-Content -LiteralPath '"'C:\\DocumentNoSnc\\CC\\GXEMUL\\GXEMUL-SEC\\regress\\gdrom_default_probe.py' | ForEach-Object { "'$lineNumber++; if ($lineNumber -ge 381 -and $lineNumber -le 760) { '"'{0,5}: {1}' -f "'$lineNumber, $_ } }' in C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC
