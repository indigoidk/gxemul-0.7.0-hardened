  135: 	dev_ram_init(machine, 0x00a00000, 6 * 1048576, DEV_RAM_RAM, 0, "hack_for_netbsd");
  136: 
  137: 	/*  RAM:  */
  138: 	dev_ram_init(machine, 0x0c000000, 16 * 1048576, DEV_RAM_RAM, 0x0, NULL);
  139: 
  140: 	/*  Image of RAM:  */
  141: 	dev_ram_init(machine, 0x0e000000, 16 * 1048576, DEV_RAM_MIRROR
