   43: MACHINE_SETUP(dreamcast)
   44: {
   45: 	machine->machine_name = strdup("Dreamcast");
   46: 
   47: 	if (machine->emulated_hz == 0)
   48: 		machine->emulated_hz = 200000000;
   49: 
   50: 	/*  50 MHz SH4 PCLOCK:  */
   51: 	machine->cpus[0]->cd.sh.pclock = 50000000;
   52: 
   53: 	if (!machine->x11_md.in_use)
   54: 		fprintf(stderr, "-------------------------------------"
   55: 		    "------------------------------------------\n"
   56: 		    "\n  WARNING!  You are emulating a Dreamcast without -X."
   57: 		    "\n            You will miss graphical output!\n\n"
   58: 		    "-------------------------------------"
   59: 		    "------------------------------------------\n");
   60: 
   61: 	/*
   62: 	 *  Physical address layout on the Dreamcast, according to a
   63: 	 *  combination of sources:  NetBSD sources, KallistiOS sources,
   64: 	 *  http://www.boob.co.uk/docs/Dreamcast_memory.txt, and
   65: 	 *  http://www.ludd.luth.se/~jlo/dc/memory.txt, and possibly some
   66: 	 *  others:
   67: 	 *
   68: 	 *  0x00000000 - 0x001fffff	Boot ROM (2 MB)
   69: 	 *  0x00200000 - 0x0021ffff	Flash (128 KB) (perhaps multiple images afterwards?)
   70: 	 *				The bytes read by the Dreamcast PROM during
   71: 	 *				boot are:
   72: 	 *				    Offset 0x1a000 .. 0x1a004 = 5 bytes debug/startup state?
   73: 	 *					hex digits (maybe limited to 0x30, 0x31, 0x32, or 0x33)
   74: 	 *				    Offset 0x1a02d .. 0x1a037 = date/time values.
   75: 	 *				    Offset 0x1a056 .. 0x1a05d = 8 bytes serial number / machine ID.
   76: 	 *  0x005f0000 - ...            ???
   77: 	 *  0x005f6800 - ...		PowerVR2 DMA registers
   78: 	 *  0x005f6900 - ...		ASIC registers
   79: 	 *  0x005f6c00 - ...		Maple registers (controller ports)
   80: 	 *  0x005f7000 - ...		GDROM registers
   81: 	 *  0x005f7400 - ...		(G2 External DMA registers? Or GDROM?)
   82: 	 *  0x005f74e4 - ...		GDROM re-enable disabled drive (?)
   83: 	 *  0x005f7800 - ...		G2 External DMA registers
   84: 	 *  0x005f7c00 - ...		DMA (?) for some device (PVR related?)
   85: 	 *  0x005f8000 - 0x005f9fff	PVR registers (graphics)
   86: 	 *  0x00600000 - 0x006007ff	G2 bus: Modem
   87: 	 *  0x00600400 - 0x0060047f	G2 bus: LAN Adapter (MB86967) registers?
   88: 	 *  0x00620000 - 0x00623fff	G2 bus: Expansion port?
   89: 	 *  0x00606900 - ...		???
   90: 	 *  0x00700000 - ...		SPU registers (sound)
   91: 	 *  0x00702800 - 0x007028ff	???
   92: 	 *  0x00702c00 -		Cable select and AICA (?) (*3)
   93: 	 *  0x00703xxx - ...		AICA something
   94: 	 *  0x00710000 - 0x00710007	RTC registers
   95: 	 *  0x00800000 - 0x009fffff	AICA (Sound) RAM (2 MB) (*4)
   96: 	 *  0x01000000 - 0x01ffffff	G2 bus or Parallel port registers?
   97: 	 *  0x02000000 - ...		CD-ROM port registers
   98: 	 *  0x03000000 - 0x03ffffff	G2 bus (?)
   99: 	 *  0x04000000 - 0x047fffff	Video RAM (*)     (64-bit)
  100: 	 *  0x05000000 - 0x057fffff	Video RAM (8 MB)  (32-bit)
  101: 	 *  0x06000000 - 0x067fffff	Video RAM (*)     (64-bit) (copy)
  102: 	 *  0x07000000 - 0x077fffff	Video RAM (8 MB)  (32-bit) (copy)
  103: 	 *  0x0c000000 - 0x0cffffff	RAM (16 MB)
  104: 	 *  0x0e000000 - 0x0effffff	Copy of RAM? (*2)
  105: 	 *  0x10000000 - 0x107fffff	Tile Accelerator: command area
  106: 	 *  0x10800000 - 0x10ffffff	Tile Accelerator: YUV data
  107: 	 *  0x11000000 - 0x11ffffff	Tile Accelerator: Texture data
  108: 	 *  0x14000000 - 0x17ffffff	G2 bus (?)
  109: 	 *
  110: 	 *  (*1) = with banks 0 and 1 switched; 64-bit read/write access...
  111: 	 *  (*2) The "luftvarg" 4KB intro uses memory at paddr 0x0ef00000...
  112: 	 *  (*3) = See VOUTC in Linux' drivers/video/pvr2fb.c.
  113: 	 *  (*4) = It seems that ARM machine code is placed here.
  114: 	 */
  115: 
  116: 	dev_ram_init(machine, 0x00000000, 2 * 1024 * 1024,
  117: 	    DEV_RAM_RAM /* | DEV_RAM_TRACE_ALL_ACCESSES */, 0x0, "bootrom");
  118: 
  119: 	dev_ram_init(machine, 0x00200000, 128 * 1024,
  120: 	    DEV_RAM_RAM /* | DEV_RAM_TRACE_ALL_ACCESSES */, 0x0, "flash");
  121: 
  122: 	dev_ram_init(machine, 0x00600004, 4, DEV_RAM_RAM, 0, NULL);
  123: 	dev_ram_init(machine, 0x00700000, 0x27ff, DEV_RAM_RAM, 0, NULL);
  124: 	dev_ram_init(machine, 0x00702800, 256, DEV_RAM_RAM, 0, NULL);
  125: 	dev_ram_init(machine, 0x00702c00, 4, DEV_RAM_RAM, 0, NULL);
  126: 	dev_ram_init(machine, 0x00703000, 0x1fff, DEV_RAM_RAM, 0, NULL);
  127: 
  128: 	/*  Sound RAM:  */
