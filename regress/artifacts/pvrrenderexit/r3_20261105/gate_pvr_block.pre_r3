#  ------------------------------------------------------------ pvrrenderexit (#NNN)
#  dev_pvr.c's renderer ended the emulator (fatal() + exit(1)) on a polygon header whose list word 1 sets bit 26 (Z-write disable).
#  Now such a polygon goes through the same depth test and rasterization as any other and only its depth store is skipped, in both
#  rasterizers, and every render clears the flag first.  The rung-3 witness (regress/artifacts/pvrrenderexit/witness_20261104/) is
#  NOT run here; this is its detector: 68 rows -- the witness's nine plus fifteen render sessions whose pixels are read back through
#  the linear VRAM window (the depth-test cells of both rasterizers, two renders in one session, the x-range bound at both screen
#  edges, the equal-depth edge, and repair 2's class closure: the y range, the span end and start, the swap, and the bit-26
#  decode's two neighbours).  Needs only the binary: -E dreamcast with a 4-byte dummy image at 0x8c010000, about half a
#  second.  It sits here rather than in gate_sh_rounding.sh with the other dreamcast probes only because that file carried another
#  session's uncommitted work when it landed.  Test-variant tables: regress/artifacts/pvrrenderexit/det_20261104/table1/ (the
#  51-row probe) and r2_20261105/table2/ (this probe, the record).  Like the blocks above, it runs only if none of this gate's earlier skip points fired.
PVRLOG=$LOGDIR/pvr_zwrite.log
python3 -u pvr_zwrite_probe.py "$PMAX" gate > "$PVRLOG" 2>&1 || true
if ! grep -q "PVR_ZWRITE_PROBE_DONE" "$PVRLOG"; then
    check "pvr zwrite probe completed" "no" "yes"
else
    check "pvr zwrite probe completed" "yes" "yes"
    check "pvr zwrite sentinel once" "$(grep -c '^PVR_ZWRITE_PROBE_DONE$' "$PVRLOG")" "1"
    pzres=$(sed -n 's/^PVR_ZWRITE_RESULT=//p' "$PVRLOG")
    check "pvr_zwrite rows run"     "${pzres#*/}" 68
    check "pvr_zwrite rows correct" "${pzres%/*}" "68"
    check "pvr zwrite controls" "$(grep -c '^PVR_ZWRITE_CONTROL=OK$' "$PVRLOG")" "1"
    check "pvr zwrite symptom absent" "$(grep -c '^PVR_ZWRITE_SYMPTOM=ABSENT$' "$PVRLOG")" "1"
    for v in "neg apparatus" "id session" "id r8" "zon session" "zon rendered" "zon prompt" "zoff rendered" "zoff session" "zoff prompt" "ovoff session" "ovoff overlap" "ovoff t2 only" "ovoff t1 only" "ovoff bg" "ovon overlap" "ovon t2 only" "ovon t1 only" "ovon bg" "behind session" "behind overlap" "behind t2 only" "behind t1 only" "texoff session" "texoff overlap" "texoff t1 only" "texoff t2 only" "texbeh session" "texbeh overlap" "texbeh t2 only" "texbeh t1 only" "texon overlap" "texon t2 only" "two session" "two overlap" "two t1 only" "two t2 only" "sticky session" "sticky overlap" "sticky t2 only" "edges l in" "edges l out" "edges r in" "edges r out" "edges rspan" "texedges l in" "texedges l out" "texedges r in" "texedges r out" "texedges rspan" "equal overlap" "equal t2 only" "texequal overlap" "texequal t2 only" "yedges t in" "yedges b in" "yedges b out" "yedges swap" "yedges s end" "yedges s past" "texyedges t in" "texyedges b in" "texyedges b out" "texyedges swap" "texyedges s end" "texyedges s past" "mask overlap" "mask t2 only" "mask25 overlap"; do
        check "pvr zwrite row: $v" "$(count "$PVRLOG" "^$v  .*ok$")" "1"
    done
    check "pvr zwrite rows emitted" "$(( $(count "$PVRLOG" " ok$") + $(count "$PVRLOG" " FAIL$") ))" "68"
    check "pvr zwrite rows green"   "$(count "$PVRLOG" " ok$")"   "68"
    check "pvr zwrite rows red"     "$(count "$PVRLOG" " FAIL$")" "0"
fi


