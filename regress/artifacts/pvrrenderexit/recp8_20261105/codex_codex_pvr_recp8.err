867: def psession_at(name, body, pixels, base):
868:     """psession() with every pixel read at `base` + its usual linear offset."""
869:     for p in pixels:
870:         x, y = PIX[p]
871:         body = body + ["r7=0x%x" % (VRAM + base + ((y * 640 + x) & ~1) * 2), "pc=0x%x" % (CODE + 4), "step 1", "reg"]
872:     _, t, how = session(name, body)
873:     vals = [int(m.group(1), 16) for m in re.finditer(r"^cpu0: .*?\br8 +=\s*(0x[0-9a-fA-F]+)", t, re.M)]
874:     half = lambda v, x: ((v >> 16) if x & 1 else v) & 0xffff
875:     return {p: (half(vals[i], PIX[p][0]) if i < len(vals) else None) for i, p in enumerate(pixels)}, t, how
