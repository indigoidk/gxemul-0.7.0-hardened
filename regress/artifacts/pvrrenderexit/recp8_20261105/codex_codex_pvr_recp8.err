26: #  (Corrected 2026-11-05, repair 4 -- codex pass 4, F2: this said table 3 was 'prepared, not yet run'.)  Like the blocks above, it
27: #  runs only if none of this gate's earlier skip points fired.
28: PVRLOG=$LOGDIR/pvr_zwrite.log
29: python3 -u pvr_zwrite_probe.py "$PMAX" gate > "$PVRLOG" 2>&1 || true
