+for z, nm in ((False, "fbhi"), (True, "zfbhi")):
+    P, T, how = psession_at(nm, FBS + header(z) + tri(FBA, 2.0, 0xff0000) + header(z, TEX_RED) + tri(FBB, 2.0) + GO,
+                            ["fb s", "fb t"], FBHI)
