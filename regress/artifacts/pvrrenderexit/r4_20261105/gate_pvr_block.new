#  ------------------------------------------------------------ pvrrenderexit (#NNN)
#  dev_pvr.c's renderer ended the emulator (fatal() + exit(1)) on a polygon header whose list word 1 sets bit 26 (Z-write disable).
#  Now such a polygon goes through the same depth test and rasterization as any other and only its depth store is skipped, in both
#  rasterizers, and every render clears the flag first.  The rung-3 witness (regress/artifacts/pvrrenderexit/witness_20261104/) is
#  NOT run here; this is its detector: 140 rows -- the witness's nine plus forty-four render sessions whose pixels are read back
#  through the linear VRAM window (the depth-test cells of both rasterizers, two renders in one session, the x-range bound at both
#  screen edges, the equal-depth edge, repair 2's y range, span end and start, swap and bit-26 decode neighbours, repair 3's class
#  closure -- the swap's other edges and body, reversed spans across both edges, the left clause's compares at their edge, a Z-off
#  polygon at equal depth, the decode's `== 1` and wider masks, and a Z-OFF TWIN of every single-layer geometry session and of the
#  swap-body session -- and repair 4's half-pixel edges of simpleline's position compares and the swap body's far end, each with its
#  Z-off twin).  Needs only the binary: -E dreamcast with a 4-byte dummy image at 0x8c010000, about two seconds
#  (r4_20261105/base140f/: 2.3 s).  (Corrected 2026-11-05, repair 3: this said 'fifteen render sessions' -- repair 2 made sixteen --
#  and 'about half a second', which held for the 51-row probe; the 68-row probe took ~90 s, because one session's input passed the
#  4100-byte debugger stdin cap and waited out its timeout -- r3_20261105/PVR3_NOTE.md.  The probe now refuses such a session before
#  running anything.)  It sits here rather than in gate_sh_rounding.sh with the other dreamcast probes only because that file carried
#  another session's uncommitted work when it landed.  Test-variant tables: regress/artifacts/pvrrenderexit/det_20261104/table1/
#  (the 51-row probe), r2_20261105/table2/ (the 68-row probe), r3_20261105/table3/ (the 128-row probe: 129 of its 130 predictions
#  hit; the miss was a Z-off twin left out of one prediction, r3_20261105/PRETABLE_3.errata.md) and r4_20261105/table4/ (this probe:
#  all 148 of PRETABLE_4.out's predictions hit -- 142 variants and six legs; four undefined-behaviour variants were unpredicted).
#  (Corrected 2026-11-05, repair 4 -- codex pass 4, F2: this said table 3 was 'prepared, not yet run'.)  Like the blocks above, it
#  runs only if none of this gate's earlier skip points fired.
PVRLOG=$LOGDIR/pvr_zwrite.log
python3 -u pvr_zwrite_probe.py "$PMAX" gate > "$PVRLOG" 2>&1 || true
if ! grep -q "PVR_ZWRITE_PROBE_DONE" "$PVRLOG"; then
    check "pvr zwrite probe completed" "no" "yes"
else
    check "pvr zwrite probe completed" "yes" "yes"
    check "pvr zwrite sentinel once" "$(grep -c '^PVR_ZWRITE_PROBE_DONE$' "$PVRLOG")" "1"
    pzres=$(sed -n 's/^PVR_ZWRITE_RESULT=//p' "$PVRLOG")
    check "pvr_zwrite rows run"     "${pzres#*/}" 140
    check "pvr_zwrite rows correct" "${pzres%/*}" "140"
    check "pvr zwrite controls" "$(grep -c '^PVR_ZWRITE_CONTROL=OK$' "$PVRLOG")" "1"
    check "pvr zwrite symptom absent" "$(grep -c '^PVR_ZWRITE_SYMPTOM=ABSENT$' "$PVRLOG")" "1"
    for v in "neg apparatus" "id session" "id r8" "zon session" "zon rendered" "zon prompt" "zoff rendered" "zoff session" "zoff prompt" "ovoff session" "ovoff overlap" "ovoff t2 only" "ovoff t1 only" "ovoff bg" "ovon overlap" "ovon t2 only" "ovon t1 only" "ovon bg" "behind session" "behind overlap" "behind t2 only" "behind t1 only" "texoff session" "texoff overlap" "texoff t1 only" "texoff t2 only" "texbeh session" "texbeh overlap" "texbeh t2 only" "texbeh t1 only" "texon overlap" "texon t2 only" "two session" "two overlap" "two t1 only" "two t2 only" "sticky session" "sticky overlap" "sticky t2 only" "edges l in" "edges l out" "edges r in" "edges r out" "edges rspan" "texedges l in" "texedges l out" "texedges r in" "texedges r out" "texedges rspan" "equal overlap" "equal t2 only" "texequal overlap" "texequal t2 only" "yedges t in" "yedges b in" "yedges b out" "yedges swap" "yedges s end" "yedges s past" "texyedges t in" "texyedges b in" "texyedges b out" "texyedges swap" "texyedges s end" "texyedges s past" "mask overlap" "mask t2 only" "mask25 overlap" "swap s before" "swap s tip" "swap vert" "swap frac past" "swap s start" "texswap s before" "texswap s tip" "texswap vert" "ramp l end" "texramp l end" "edges2 l rev" "edges2 r rev" "edges2 l tip" "edges2 x2 tip" "texedges2 l rev" "texedges2 r rev" "texedges2 l tip" "texedges2 x2 tip" "zleft tip" "texzleft tip" "zeq overlap" "texzeq overlap" "maskoff overlap" "maskhi overlap" "zedges l in" "zedges l out" "zedges r in" "zedges r out" "zedges rspan" "zyedges t in" "zyedges b in" "zyedges b out" "zyedges swap" "zyedges s end" "zyedges s past" "zswap s before" "zswap s tip" "zswap vert" "zswap frac past" "zswap s start" "zedges2 l rev" "zedges2 r rev" "zedges2 l tip" "zramp l end" "ztedges l in" "ztedges l out" "ztedges r in" "ztedges r out" "ztedges rspan" "ztyedges t in" "ztyedges b in" "ztyedges b out" "ztyedges swap" "ztyedges s end" "ztyedges s past" "ztswap s before" "ztswap s tip" "ztswap vert" "ztedges2 l rev" "ztedges2 r rev" "ztedges2 l tip" "ztramp l end" "half swap" "half r x1" "half r x2" "zhalf swap" "zhalf r x1" "zhalf r x2" "ramp8 r end" "zramp8 r end" "texramp8 r end" "ztramp8 r end"; do
        check "pvr zwrite row: $v" "$(count "$PVRLOG" "^$v  .*ok$")" "1"
    done
    check "pvr zwrite rows emitted" "$(( $(count "$PVRLOG" " ok$") + $(count "$PVRLOG" " FAIL$") ))" "140"
    check "pvr zwrite rows green"   "$(count "$PVRLOG" " ok$")"   "140"
    check "pvr zwrite rows red"     "$(count "$PVRLOG" " FAIL$")" "0"
fi


