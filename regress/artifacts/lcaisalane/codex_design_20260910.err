294:			    d->name, (int)odata);
295:		}
296:		break;
297:
298:	default:
299:		if (writeflag==MEM_READ) {
300:			debug("[ ns16550 (%s): read from reg %i ]\n",
301:			    d->name, (int)relative_addr);
302:			odata = d->reg[relative_addr];
303:		} else {
304:			debug("[ ns16550 (%s): write to reg %i:",
