   1: #!/usr/bin/env python3
   2: #
   3: #  lcaisalane -- RUNG-3 WITNESS: the LCA sparse-I/O byte-lane handler ends the host process on an
   4: #  ordinary byte access to a documented ISA register, and SILENTLY ANSWERS ZERO on another.
   5: #
   6: #  THE DEFECT, quoted from `DEVICE_ACCESS(lca_isa)' in src/devices/dev_lca.c:
   7: #
   8: #      relative_addr >>= 5;
   9: #
  10: #      ofs = relative_addr & 3;
  11: #      if (ofs > len) {
  12: #              fatal("[ ofs=%i len=%i in lca_isa access function. "
  13: #                  "aborting ]\n", ofs, len);
  14: #              exit(1);
  15: #      }
  16: #
  17: #      if (writeflag == MEM_WRITE) {
  18: #              byte = data[ofs % len];
  19: #              return cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE +
  20: #                  relative_addr, &byte, 1, writeflag, CACHE_NONE);
  21: #      }
  22: #
  23: #      cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE + relative_addr,
  24: #          &byte, 1, MEM_READ, CACHE_NONE);
  25: #
  26: #      for (i=0; i<len; i++)
  27: #              data[i] = i == ofs? byte : 0x00;
  28: #
  29: #  *** THE LANE IS NOT AN INDEPENDENT FIELD.  IT IS THE LOW TWO BITS OF THE ISA PORT NUMBER. ***
  30: #  The shift comes FIRST, so `ofs' is bits 6:5 of the incoming relative address -- which are bits
  31: #  1:0 of the derived port -- and the forwarded access goes to `LCA_ISA_BASE + (r >> 5)', i.e. to
  32: #  that same port INCLUDING those two bits.  So there is no way to address ONE port through two
  33: #  different lanes: the lane is a FUNCTION of the port.  The defect therefore partitions the whole
  34: #  64 K ISA port space by `port & 3', and for a BYTE (len == 1) access it reads:
  35: #
  36: #      port & 3 == 0   ->  ofs 0.  data[0] = byte.                        CORRECT
  37: #      port & 3 == 1   ->  ofs 1.  1 > 1 is FALSE, so ACCEPTED -- and the packing loop runs
  38: #                          `for (i = 0; i < 1; i++) data[i] = (i == 1)? byte : 0', which is
  39: #                          never true, so THE DEVICE BYTE IS DISCARDED AND THE GUEST IS HANDED
  40: #                          ZERO with a success return.  A false success, not a decline.
  41: #      port & 3 == 2   ->  ofs 2.  2 > 1  ->  fatal() + exit(1).          HOST DEATH
  42: #      port & 3 == 3   ->  ofs 3.  3 > 1  ->  fatal() + exit(1).          HOST DEATH
  43: #
  44: #  For len == 2 the same arithmetic gives ofs 2 a zero answer and ofs 3 a death; for len 4 and 8
  45: #  `ofs > len' is never true and the packing index is always in range, so those widths are clean.
  46: #  The guard's `>' (rather than `>=') is what admits the zero-answering case: `ofs == len' passes
  47: #  the guard and then indexes nothing.
  48: #
  49: #  WHAT THAT COSTS AT A REAL DEVICE, and it is why the ns16550 is the right subject.  The console
  50: #  UART sits at ISA 0x3f8..0x3ff, so its eight registers fall into all four classes:
  51: #
  52: #      0x3f8 data     ofs 0   ok        0x3fc mcr       ofs 0   ok
  53: #      0x3f9 ier      ofs 1   ZERO      0x3fd lsr       ofs 1   ZERO
  54: #      0x3fa iir      ofs 2   DEATH     0x3fe msr       ofs 2   DEATH
  55: #      0x3fb lctl     ofs 3   DEATH     0x3ff scratch   ofs 3   DEATH
  56: #
  57: #  A byte read of the LINE STATUS REGISTER -- the register a polling console driver reads before
  58: #  every character -- returns zero, and a byte read of the MODEM STATUS or LINE CONTROL register
  59: #  ends the emulator.  No unusual value, no driver setup, four guest instructions.
  60: #
  61: #  ---------------------------------------------------------------------------------------------
  62: #  *** #530: IT IS NOW THE WITNESS AND THE DETECTOR.  Sessions 1-3 are the witness below, unchanged but
  63: #  for the sentinel; the #530 sessions at the end are the detector for the fix. ***
  64: #
  65: #  THE FIX (disposition B, regress/artifacts/lcaisalane/FABLE_F2_RULING_20260914.md): the byte for port
  66: #  P sits at buffer position (P & 3) % len on BOTH arms; `len == 0' is refused first; no latch, no
  67: #  announce (there is no event -- member 4, ACCEPT).  Table 1 (37 rows): HEAD 19/37, fix 37/37
