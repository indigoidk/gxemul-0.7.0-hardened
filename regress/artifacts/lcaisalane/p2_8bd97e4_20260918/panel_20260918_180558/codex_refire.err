import ast, subprocess
path = 'regress/lca_widewrite_probe.py'
src = subprocess.check_output(['git', '-C', 'GXEMUL-SEC', 'show', '8bd97e4:' + path], text=True)
tree = ast.parse(src)
functions = {'mem','LDA','LDAH','LDBU','STB','LDQ','load_const','sent','k0','SP'}
assignments = {'BOOTSTR','ZERO','T0','T1','T2','T3','T4','A0','A1','A2','A3','CALL_PAL_PROM','SENT','K0SEG','LCA_PCI_SIO','SCRATCH','CODE','SCR','PRESET','WANT','RA','p1','p2','p3','p4','RET','consts','phases'}
selected = []
for node in tree.body:
    if isinstance(node, ast.FunctionDef) and node.name in functions:
        selected.append(node)
    elif isinstance(node, ast.Assign):
        targets = {part.id for target in node.targets for part in ast.walk(target) if isinstance(part, ast.Name)}
        if targets and targets <= assignments:
            selected.append(node)
ns = {}
exec(compile(ast.Module(body=selected, type_ignores=[]), path, 'exec'), ns)
prog = ns['load_const'](ns['T0'], ns['SCRATCH']) + ns['p1'] + ns['p2'] + ns['p3'] + ns['p4']
print('phase lengths:', len(ns['load_const'](ns['T0'], ns['SCRATCH'])), *(len(ns[p]) for p in ('p1','p2','p3','p4')))
