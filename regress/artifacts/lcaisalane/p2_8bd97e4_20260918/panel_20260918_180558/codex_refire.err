 328: #  has bits 5-6 CLEAR.  Re-pinned FIRST, HEAD re-run 13/16 with the same three reds, THEN the fix
 329: #  (the oracle-correction order; FABLE_F2_RULING_20260914.md R3).
 330: def sent(reg): return load_const(reg, SENT)
 331: 
 332: # ---------------------------------------------------------------- addresses
 333: K0SEG        = 0xfffffc0000000000
 334: def k0(p):   return K0SEG | p
 335: 
 336: LCA_PCI_SIO  = 0x1c0000000               # alpha_lcareg.h; DEVINIT maps 0x10000<<5 bytes here as
 337:                                          # "lca_isa" -- THE HANDLER UNDER TEST
 338: LCA_ISA_BASE = LCA_PCI_SIO + 0x10000000  # dev_lca.c:47.  bus_isa_init put the real devices here,
 339:                                          # and this is where the handler FORWARDS to.
 340: def SP(port):   return LCA_PCI_SIO  + (port << 5)   # the guest-visible sparse address
 341: def FLAT(port): return LCA_ISA_BASE + port          # the internal flat mapping
 342: 
 343: #  ---- the ports, and why each one ----------------------------------------------------------
 344: KBC_CMD, KBC_DAT = 0x64, 0x60      # 8042: both 0 mod 4.  0xAA is the standard self-test command
 345: KBC_SELFTEST, KBC_REPLY = 0xAA, 0x55
 346: UART_LSR   = 0x3fd                 # 1 mod 4 -> ofs 1.  DEVICE_ACCESS(ns16550) sets
 347: LSR_FIXED  = 0x60                  #   `d->reg[com_lsr] |= LSR_TXRDY | LSR_TSRE' at the TOP of
 348:                                    #   every access, so 0x20|0x40 is there by construction, with
 349:                                    #   no setup.  Masked to those two bits because LSR_RXRDY (0x01)
 350:                                    #   tracks console input and is the one bit a stray keystroke
 351:                                    #   could flip -- a witness must not have a race in its oracle.
 352: UART_MSR   = 0x3fe                 # 2 mod 4 -> ofs 2.  Same handler unconditionally sets
 353: MSR_FIXED  = 0xb0                  #   MSR_DCD|MSR_DSR|MSR_CTS = 0x80|0x20|0x10, and nothing else
 354:                                    #   ever sets an MSR bit, so this is exact.
 355: UART_SCR   = 0x3ff                 # 3 mod 4 -> ofs 3.  reg 7 falls to the ns16550 `default:' arm,
 356: SCR_VALUE  = 0x5a                  #   which stores and returns the byte -- a plain scratchpad.
 357: NODEV_PORT = 0x300                 # 0 mod 4, and bus_isa_init registers nothing at 0x300.
 358: 
 359: SCRATCH      = 0x01020000
 360: CODE         = 0x01040000
 361: assert max(SCRATCH, CODE) < 64 * 1024 * 1024, "scratch/code must be inside RAM"
 362: 
 363: DUMMY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "alpha_dummy.bin")
 364: if not os.path.exists(DUMMY):
 365:     with open(DUMMY, "wb") as f:
 366:         f.write(b"\0" * 8)
 367: 
 368: # ---------------------------------------------------------------- session
 369: def session(cmds, settle, spin):
 370:     pid, fd = pty.fork()
 371:     if pid == 0:
 372:         os.execv(BIN, [BIN, "-V", "-x", "-E", "alpha", "-e", MACH, "-M", "64",
 373:                        "0x20000000:" + DUMMY])
 374:         os._exit(127)
 375:     buf = ""
 376:     def rd(t):
 377:         nonlocal buf
 378:         end = time.time() + t
 379:         while time.time() < end:
 380:             r, _, _ = select.select([fd], [], [], 0.1)
 381:             if not r:
 382:                 continue
 383:             try:
 384:                 d = os.read(fd, 65536)
 385:                 if not d:
 386:                     return False
 387:                 buf += d.decode("latin-1", "replace")
 388:             except OSError:
 389:                 return False
 390:         return True
 391:     alive = rd(settle)
 392:     for i, c in enumerate(cmds):
 393:         try:
 394:             os.write(fd, (c + "\n").encode("latin-1"))
 395:         except OSError:
 396:             alive = False; break
 397:         if not rd(spin if i == len(cmds) - 1 else 0.45):
 398:             alive = False; break
 399:     try:
 400:         os.write(fd, b"quit\n"); rd(0.5)
 401:     except OSError:
 402:         pass
 403:     try:
 404:         os.close(fd)
 405:     except OSError:
 406:         pass
 407:     return buf.replace("\r", ""), alive
 408: 
 409: def printed(t, reg):
 410:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
 411:     return None if not m else int(m.group(1), 16)
 412: 
 413: #  #530 repair 6: `printed' is re.search -- it returns the FIRST print of a register and nothing else.  That is
 414: #  correct for every session written before repair 6, because each prints a given register once.  The 8253 sessions
 415: #  print T3/T4/T5 once per PHASE, ~20 phases per session, so reading them with `printed' would silently hand every
 416: #  row PHASE 1's value -- a whole session vacuous by construction, and GREEN.  `nth' is the positional form (the
 417: #  idiom crime_width_probe.py already uses).  `printed' is deliberately NOT reimplemented in terms of it, so the
 418: #  existing 185 rows cannot move.
 419: def nth(t, reg, n):
 420:     m = re.findall(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
 421:     return None if n >= len(m) else int(m[n], 16)
 422: 
 423: 
 424: def n_prints(t, reg):
 425:     return len(re.findall(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t))
 426: 
 427: 
 428: def build(consts, phases):
 429:     """consts -> SCRATCH slots 0,8,16,...   phases = list of (ops, printreg|None).
 430:     Returns the debugger command list."""
 431:     prog = load_const(T0, SCRATCH)
 432:     lens = [len(prog)]
 433:     for ops, _ in phases:
 434:         prog += ops
 435:         lens.append(len(ops))
 436:     cmds  = ["put d 0x%x, 0x%x" % (SCRATCH + 8 * i, v) for i, v in enumerate(consts)]
 437:     cmds += ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op) for i, op in enumerate(prog)]
 438:     cmds += ["pc=0x%x" % k0(CODE), "step %d" % lens[0]]
 439:     for (ops, pr), n in zip(phases, lens[1:]):
 440:         cmds.append("step %d" % n)
 441:         if pr is not None:
 442:             #  #530 repair 6: a phase may print SEVERAL registers; a bare string is unchanged.
 443:             for _r in ((pr,) if isinstance(pr, str) else tuple(pr)):
 444:                 cmds.append("print %s" % _r)
 445:     return cmds
 446: 
 447: def run(tag, consts, phases, want_regs, settle=3.0, spin=4.0):
 448:     """want_regs: registers whose `print' MUST be present for the run to be READY.  A run that is
 449:     not ready timed out rather than measured, and is retried ONCE with tripled patience -- the
 450:     machine may be loaded.  Returns (txt, alive, retried)."""
 451:     cmds = build(consts, phases)
 452:     txt, alive = session(cmds, settle, spin)
 453:     retried = False
 454:     def _ready(t):
 455:         #  #530 repair 6: an entry may be ("t3", 9) -- at least NINE prints of t3.  A bare string keeps the
 456:         #  old meaning.  Without this a multi-phase session that times out HALFWAY still reports READY,
 457:         #  because its FIRST print did arrive, and the rows then score against missing data.
 458:         for w in want_regs:
 459:             if isinstance(w, str):
 460:                 if printed(t, w) is None:
 461:                     return False
 462:             elif n_prints(t, w[0]) < w[1]:
 463:                 return False
 464:         return True
 465:     if not _ready(txt):
 466:         retried = True
 467:         txt, alive = session(cmds, settle * 3, spin * 3)
 468:     if RAW:
 469:         with open(os.path.join(RAW, "raw_%s.txt" % tag), "w", encoding="utf-8") as f:
 470:             f.write("### cmds\n" + "\n".join(cmds) + "\n### transcript\n" + txt)
 471:     return txt, alive, retried
 472: 
 473: def evidence(txt, tag):
 474:     for _l in txt.split(chr(10)):
 475:         if ("lca_isa access function" in _l or "lca:" in _l or "pckbc:" in _l
 476:                 or "non-existant" in _l):
 477:             print("  EVIDENCE[%s]: %s" % (tag, _l.strip()))
 478: 
 479: def hx(v):
 480:     return "absent" if v is None else "0x%x" % v
 481: 
 482: ATTRIB = "in lca_isa access function"     # unique in src/; the arm's own diagnostic
 483: 
 484: print("lca_isalane_probe -- binary=%s label=%s machine=%s" % (BIN, LABEL, MACH))
 485: print("  sparse LCA_PCI_SIO=0x%x  flat LCA_ISA_BASE=0x%x  ofs = (r>>5) & 3 = port & 3"
 486:       % (LCA_PCI_SIO, LCA_ISA_BASE))
 487: print("%-14s %-24s %-24s %-56s %s" % ("row", "got", "want", "note", ""))
 488: 
