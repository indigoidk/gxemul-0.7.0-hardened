1249:def _cw():             return [LDQ(T1, 0, T0), LDQ(T2, 8, T0), STB(T2, 0, T1)]
1250:def _fl_st(s, a=2):    return [LDQ(T1, 8 * a, T0), LDQ(T2, 8 * s, T0), STB(T2, 0, T1)]
