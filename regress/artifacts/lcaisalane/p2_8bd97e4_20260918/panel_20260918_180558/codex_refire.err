 621: def dsession(tag, consts, phases, names, settle=3.0, spin=4.0):
 622:     """Returns (alive, {name: value|None}).  A run that did not produce every print is retried ONCE
 623:     with tripled patience -- the load-tolerance rule the witness sessions already follow."""
 624:     need = sum(1 for _, pr in phases if pr is not None)
 625:     cmds = build(consts, phases)
 626:     txt, alive = session(cmds, settle, spin)
 627:     if len(prints_in_order(txt)) < need and alive:
 628:         #  recorded since pass 2 (Opus): before it, this retry was SILENT and LCAISALANE_RETRIED reported
 629:         #  only the three witness sessions
 630:         DRETRIED.append(tag)
 631:         txt, alive = session(cmds, settle * 3, spin * 3)
 632:     if RAW:
 633:         with open(os.path.join(RAW, "raw_%s.txt" % tag), "w", encoding="utf-8") as f:
 634:             f.write("### cmds\n" + "\n".join(cmds) + "\n### transcript\n" + txt)
 635:     vals = prints_in_order(txt)
 636:     got = {n: (vals[i] if i < len(vals) else None) for i, n in enumerate(names)}
 637:     print("  RAW[%s]: alive=%s %s" % (tag, alive, " ".join("%s=%s" % (n, hx(got[n])) for n in names)))
 638:     evidence(txt, tag)
 639:     return alive, got
