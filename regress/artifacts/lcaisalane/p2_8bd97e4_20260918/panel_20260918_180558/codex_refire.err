 616: def prints_in_order(txt):
 617:     #  The detector sessions reuse register names, so values are taken IN PRINT ORDER rather than
 618:     #  by name (printed() returns the FIRST match, which would read an earlier phase's value).
 619:     return [int(v, 16) for _, v in re.findall(r"print\s+(t\d)\s*\n\s*(0x[0-9a-f]+)", txt)]
