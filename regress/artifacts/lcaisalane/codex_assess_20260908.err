 248: 				exit(1);
 249: 			}
 250: 		}
 251: 		break;
 252: 
 253: 	case LCA_IOC_TBIA:
 254: 		/*  TLB Invalidate All.  */
 255: 		/*  TODO: For now, let's just ignore it.  */
