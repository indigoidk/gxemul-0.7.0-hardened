 281: 				    " (0x%" PRIx64") from the only implemented"
 282: 				    " values\n", (uint64_t)idata);
 283: 				exit(1);
 284: 			}
 285: 		}
 286: 		break;
 287: 
 288: 	case LCA_IOC_W_MASK0:
