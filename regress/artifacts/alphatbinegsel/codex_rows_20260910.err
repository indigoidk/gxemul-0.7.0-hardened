1237:		// actually point to the same physical page, and if then
1238:		// the virtual address 0x0000000012345000 is to be invalidated,
1239:		// then both of those should be invalidated!
1240:		int n = 0;
1241:		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++)
1242:			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid &&
1243:			    (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page
1244:			    & cpu->vaddr_mask) == (addr_page & cpu->vaddr_mask)) {
1245:				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page, flags);
1246:				n ++;
1247:			}
1248:
1249:		if (n > 1)
1250:			debug("[ DYNTRANS_INVALIDATE_TC: CACHE COLLISION vaddr 0x%016llx! ]\n",
1251:				(long long)addr_page);
1252:#endif
1253:
1254:		return;
1255:	}
1256:
1257:	/*  Invalidate everything:  */
1258:#ifdef DYNTRANS_PPC
1259:	if (flags & INVALIDATE_ALL && flags & INVALIDATE_VADDR_UPPER4) {
1260:		/*  fatal("all, upper4 (PowerPC segment)\n");  */
1261:		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1262:			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid &&
1263:			    (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page
1264:			    & 0xf0000000) == addr_page) {
1265:				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.
1266:				    DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1267:				    0);
1268:				// Not needed: DYNTRANS_INVALIDATE_TLB_ENTRY should
1269:				// set valid to 0 anyway.
1270:				// cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid=0;
1271:			}
1272:		}
1273:		return;
1274:	}
1275:#endif
1276:	if (flags & INVALIDATE_ALL) {
1277:		/*  fatal("all\n");  */
1278:		for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1279:			if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid) {
1280:				DYNTRANS_INVALIDATE_TLB_ENTRY(cpu, cpu->cd.
1281:				    DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1282:				    0);
1283:				// Not needed: DYNTRANS_INVALIDATE_TLB_ENTRY should
1284:				// set valid to 0 anyway.
1285:				// cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid=0;
1286:			}
1287:		}
1288:		return;
1289:	}
1290:
1291:	/*  Invalidate a physical page:  */
1292:
1293:	if (!(flags & INVALIDATE_PADDR))
1294:		fatal("HUH? Invalidate: Not vaddr, all, or paddr?\n");
1295:
1296:	/*  fatal("addr 0x%08x\n", (int)addr_page);  */
1297:
1298:	for (r=0; r<DYNTRANS_MAX_VPH_TLB_ENTRIES; r++) {
1299:		if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid && addr_page
1300:		    == cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].paddr_page) {
1301:			DYNTRANS_INVALIDATE_TLB_ENTRY(cpu,
1302:			    cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].vaddr_page,
1303:			    flags);
1304:			if (flags & JUST_MARK_AS_NON_WRITABLE)
1305:				cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r]
1306:				    .writeflag = 0;
1307:			else
1308:				cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r]
1309:				    .valid = 0;
1310:		}
1311:	}
1312:}
1313:#endif	/*  DYNTRANS_INVALIDATE_TC  */
