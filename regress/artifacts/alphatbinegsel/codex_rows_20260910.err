1317:#ifdef DYNTRANS_INVALIDATE_TC_CODE
1318:/*
1319: *  XXX_invalidate_code_translation():
1320: *
1321: *  Invalidate code translations for a specific physical address, a specific
1322: *  virtual address, or for all entries in the cache.
1323: */
1324:void DYNTRANS_INVALIDATE_TC_CODE(struct cpu *cpu, uint64_t addr, int flags)
1325:{
1326:	int r;
1327:#ifdef MODE32
1328:	uint32_t
1329:#else
1330:	uint64_t
1331:#endif
1332:	    vaddr_page, paddr_page;
1333:
1334:	addr &= ~(DYNTRANS_PAGESIZE-1);
1335:
1336:	/*  printf("DYNTRANS_INVALIDATE_TC_CODE addr=0x%08x flags=%i\n",
1337:	    (int)addr, flags);  */
1338:
1339:	if (flags & INVALIDATE_PADDR) {
1340:		int pagenr, table_index;
1341:		uint32_t physpage_ofs, *physpage_entryp;
1342:		struct DYNTRANS_TC_PHYSPAGE *ppp, *prev_ppp;
1343:
1344:		pagenr = DYNTRANS_ADDR_TO_PAGENR(addr);
1345:		table_index = PAGENR_TO_TABLE_INDEX(pagenr);
1346:
1347:		physpage_entryp = &(((uint32_t *)cpu->
1348:		    translation_cache)[table_index]);
1349:		physpage_ofs = *physpage_entryp;
1350:
1351:		/*  Return immediately if there is no code translation
1352:		    for this page.  */
1353:		if (physpage_ofs == 0)
1354:			return;
1355:
1356:		prev_ppp = ppp = NULL;
1357:
1358:		/*  Traverse the physical page chain:  */
1359:		while (physpage_ofs != 0) {
1360:			prev_ppp = ppp;
1361:			ppp = (struct DYNTRANS_TC_PHYSPAGE *)
1362:			    (cpu->translation_cache + physpage_ofs);
1363:
1364:			/*  If we found the page in the cache,
1365:			    then we're done:  */
1366:			if (ppp->physaddr == addr)
1367:				break;
1368:
1369:			/*  Try the next page in the chain:  */
1370:			physpage_ofs = ppp->next_ofs;
1371:		}
1372:
1373:		/*  If there is no translation, there is no need to go
1374:		    on and try to remove it from the vph_tlb_entry array:  */
1375:		if (physpage_ofs == 0)
1376:			return;
1377:
1378:#if 0
1379:		/*
1380:		 *  "Bypass" the page, removing it from the code cache.
1381:		 *
1382:		 *  NOTE/TODO: This gives _TERRIBLE_ performance with self-
1383:		 *  modifying code, or when a single page is used for both
1384:		 *  code and (writable) data.
1385:		 */
1386:		if (ppp != NULL) {
1387:			if (prev_ppp != NULL)
1388:				prev_ppp->next_ofs = ppp->next_ofs;
1389:			else
1390:				*physpage_entryp = ppp->next_ofs;
1391:		}
1392:#else
1393:		(void)prev_ppp;	// shut up compiler warning
1394:
1395:		/*
1396:		 *  Instead of removing the page from the code cache, each
1397:		 *  entry can be set to "to_be_translated". This is slow in
1398:		 *  the general case, but in the case of self-modifying code,
1399:		 *  it might be faster since we don't risk wasting cache
1400:		 *  memory as quickly (which would force unnecessary Restarts).
1401:		 */
1402:		if (ppp != NULL && ppp->translations_bitmap != 0) {
1403:			uint32_t x = ppp->translations_bitmap;	/*  TODO:
1404:				urk Should be same type as the bitmap */
1405:			int i, j, n, m;
1406:
1407:#ifdef DYNTRANS_ARM
1408:			/*
1409:			 *  Note: On ARM, PC-relative load instructions are
1410:			 *  implemented as immediate mov instructions. When
1411:			 *  setting parts of the page to "to be translated",
1412:			 *  we cannot keep track of which of the immediate
1413:			 *  movs that were affected, so we need to clear
1414:			 *  the entire page. (ARM only; not for the general
1415:			 *  case.)
1416:			 */
1417:			x = 0xffffffff;
1418:#endif
1419:			n = 8 * sizeof(x);
1420:			m = DYNTRANS_IC_ENTRIES_PER_PAGE / n;
1421:
1422:			for (i=0; i<n; i++) {
1423:				if (x & 1) {
1424:					for (j=0; j<m; j++)
1425:						ppp->ics[i*m + j].f =
1426:						    TO_BE_TRANSLATED;
1427:				}
1428:
1429:				x >>= 1;
1430:			}
1431:
1432:			ppp->translations_bitmap = 0;
1433:
1434:			/*  Clear the list of translatable ranges:  */
1435:			if (ppp->translation_ranges_ofs != 0) {
1436:				struct physpage_ranges *physpage_ranges =
1437:				    (struct physpage_ranges *)
1438:				    (cpu->translation_cache +
1439:				    ppp->translation_ranges_ofs);
1440:				physpage_ranges->next_ofs = 0;
1441:				physpage_ranges->n_entries_used = 0;
1442:			}
1443:		}
1444:#endif
1445:	}
1446:
1447:	/*  Invalidate entries in the VPH table:  */
1448:	for (r = 0; r < DYNTRANS_MAX_VPH_TLB_ENTRIES; r ++) {
1449:		if (cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r].valid) {
1450:			vaddr_page = cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r]
1451:			    .vaddr_page & ~(DYNTRANS_PAGESIZE-1);
1452:			paddr_page = cpu->cd.DYNTRANS_ARCH.vph_tlb_entry[r]
1453:			    .paddr_page & ~(DYNTRANS_PAGESIZE-1);
1454:
1455:			if (flags & INVALIDATE_ALL ||
1456:			    (flags & INVALIDATE_PADDR && paddr_page == addr) ||
1457:			    (flags & INVALIDATE_VADDR && vaddr_page == addr)) {
1458:#ifdef MODE32
1459:				uint32_t index =
1460:				    DYNTRANS_ADDR_TO_PAGENR(vaddr_page);
1461:				cpu->cd.DYNTRANS_ARCH.phys_page[index] = NULL;
1462:#else
1463:				const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
1464:				const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
1465:				const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
1466:				uint32_t x1, x2, x3;
1467:				struct DYNTRANS_L2_64_TABLE *l2;
1468:				struct DYNTRANS_L3_64_TABLE *l3;
1469:
1470:				x1 = (vaddr_page >> (64-DYNTRANS_L1N)) & mask1;
1471:				x2 = (vaddr_page >> (64-DYNTRANS_L1N -
1472:				    DYNTRANS_L2N)) & mask2;
1473:				x3 = (vaddr_page >> (64-DYNTRANS_L1N -
1474:				    DYNTRANS_L2N - DYNTRANS_L3N)) & mask3;
1475:				l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
1476:				l3 = l2->l3[x2];
1477:				l3->phys_page[x3] = NULL;
1478:#endif
1479:			}
1480:		}
1481:	}
1482:}
1483:#endif	/*  DYNTRANS_INVALIDATE_TC_CODE  */
