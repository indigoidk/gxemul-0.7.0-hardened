61: *	MEMORY_ACCESS_OK
62: *
63: *  (MEMORY_ACCESS_FAILED is 0.)
64: */
65:
66:/*
67: *  #430: THE PAGE SIZE, IN ONE PLACE.
68: *
69: *  It was a local inside the function.  The wrapper below needs the same number, and two
70: *  copies of a page size that can silently diverge is the shape this tree has been bitten
71: *  by before -- so it is hoisted to a macro and the local now reads it.  Note the Alpha
72: *  value: it is 8 KB, not 4 KB, so anything that splits at "the page boundary" must use
73: *  THIS and never a literal 4096.  A review seat caught exactly that hazard in the design
74: *  brief, which had said "4 KB page" throughout.
75: */
76:#ifdef MEM_ALPHA
77:#define	MRW_OFFSET_MASK		0x1fff
78:#else
79:#define	MRW_OFFSET_MASK		0xfff
80:#endif
161: *      do_return_ok`s first.  Measured with a device straddling the memblock boundary --
162: *      one device call, offset 0xffe, len 4, zero host lookups.
163: *
164: *  A LOOP, not recursion.  A recursive split costs a real frame per chunk when the compiler
165: *  does NOT eliminate the tail call -- measured at -O0, 1,834,896 bytes of stack for a 16 MB
166: *  access -- and a large enough access then dies on the stack rather than returning an
167: *  answer.
168: *
169: *  CORRECTION, and it is the reason this paragraph is worded carefully: the first draft said
170: *  "gcc does not turn the tail call into a loop at -O2".  MEASURED, IT DOES -- gcc 15.2.1
171: *  performs the sibling-call optimisation at -O2 and -O3, leaving a 96-byte span.  So the
172: *  loop is still the right implementation (it does not depend on an optimisation being
173: *  applied, and -O0 builds and other compilers are real), but the justification was wrong,
174: *  and the row that certified it was VACUOUS until the differential was given
175: *  -fno-optimize-sibling-calls.  No caller in the tree passes an access large enough for
176: *  this to bite today; it is insurance, and it costs about fifteen lines.
177: *
178: *  ONLY WHEN A TRANSLATION ACTUALLY HAPPENS.  Under PHYSICAL (or with no translate_v2p)
179: *  paddr == vaddr, there is no per-page mapping to redo, and splitting would buy nothing
180: *  while turning one large DMA into thousands of calls -- so those go straight through and
181: *  the memblock split keeps doing its job unchanged.
182: */
183:int MEMORY_RW(struct cpu *cpu, struct memory *mem, uint64_t vaddr,
184:	unsigned char *data, size_t len, int writeflag, int misc_flags)
185:{
186:	if (!(misc_flags & PHYSICAL) && cpu->translate_v2p != NULL) {
187:		size_t granule = (size_t) MRW_SPLIT_MASK + 1;
188:		size_t offset = (size_t) (vaddr & MRW_SPLIT_MASK);
189:
190:		/*  `len > granule - offset`, NOT `offset + len > granule`: the sum can
191:		    wrap for an absurd length (offset 1, len SIZE_MAX), which would skip
192:		    the loop and hand the whole thing to the worker.  The subtraction
193:		    cannot wrap, because offset < granule always.
194:
195:		    STATED EXACTLY, because the first version of this comment implied more
196:		    than it delivers: this form does not SERVICE such a length, it declines
197:		    to mis-copy it.  A length near SIZE_MAX now iterates about 2^54 times
198:		    instead of silently under-splitting -- measured, a fuzz watchdog fired
199:		    at two million chunks.  No caller passes anything remotely like it (the
200:		    largest in the tree are PHYSICAL and exempt), so the case is recorded
201:		    and filed rather than handled.  */
202:		while (len > granule - offset) {
203:			size_t head = granule - offset;
204:
205:			if (!MEMORY_RW_ONE_PAGE(cpu, mem, vaddr, data, head,
206:			    writeflag, misc_flags)) {
207:				/*  #244 PROMISES THE WHOLE READ BUFFER, AND SPLITTING BROKE
208:				    THAT: the worker zeroes only the chunk IT was given, so a
209:				    failure before the last chunk used to leave the caller's
210:				    remaining bytes untouched -- uninitialised host stack, for
211:				    a caller that ignores the return value.  Unsplit, one call
212:				    covered the whole length.  Zero the rest here so the
213:				    guarantee is the same as it was.  */
214:				if (writeflag == MEM_READ)
215:					memset(data, 0, len);
216:				return MEMORY_ACCESS_FAILED;
217:			}
218:
219:			vaddr += head;
220:			data += head;
221:			len -= head;
222:			offset = 0;
223:		}
224:	}
225:
226:	return MEMORY_RW_ONE_PAGE(cpu, mem, vaddr, data, len, writeflag, misc_flags);
227:}
228:
229:
230:static int MEMORY_RW_ONE_PAGE(struct cpu *cpu, struct memory *mem, uint64_t vaddr,
231:	unsigned char *data, size_t len, int writeflag, int misc_flags)
232:{
233:	const int offset_mask = MRW_OFFSET_MASK;
234:
235:	int ok = 2;
236:	uint64_t paddr;
237:	int cache, no_exceptions, offset;
238:	unsigned char *memblock;
239:	int dyntrans_device_danger = 0;
240:
241:	no_exceptions = misc_flags & NO_EXCEPTIONS;
242:	cache = misc_flags & CACHE_FLAGS_MASK;
243:
244:
245:	if (misc_flags & PHYSICAL || cpu->translate_v2p == NULL) {
246:		paddr = vaddr;
247:	} else {
248:		ok = cpu->translate_v2p(cpu, vaddr, &paddr,
249:		    (writeflag? FLAG_WRITEFLAG : 0) +
250:		    (no_exceptions? FLAG_NOEXCEPTIONS : 0)
251:		    + (misc_flags & MEMORY_USER_ACCESS)
252:		    + (cache==CACHE_INSTRUCTION? FLAG_INSTR : 0));
253:
254:		/*
255:		 *  If the translation caused an exception, or was invalid in
256:		 *  some way, then simply return without doing the memory
257:		 *  access:
258:		 */
259:		if (!ok) {
260:			/*  #244: A failed (or NO_EXCEPTIONS) translation leaves
261:			    the caller's read buffer untouched; zero it so
262:			    callers that ignore the return value (e.g. the DEC
263:			    PROM string helpers) consume deterministic 0 bytes
264:			    instead of uninitialised host stack. Same zero-fill
265:			    ethos as the failed-device-read path (#95).  */
266:			if (writeflag == MEM_READ)
267:				memset(data, 0, len);
268:			return MEMORY_ACCESS_FAILED;
269:		}
270:	}
271:
272:	/*
273:	 *  #250: data write-watchpoint. Checked here, before the device /
274:	 *  cache / RAM dispatch (several of which return early �?" notably the
119:	uint32_t	next_ofs;	/*  0 for end of chain  */
120:	uint32_t	n_entries_used;
121:	uint16_t	base[PHYSPAGE_RANGES_ENTRIES_PER_LIST];
122:	uint16_t	length[PHYSPAGE_RANGES_ENTRIES_PER_LIST];
123:	uint16_t	count[PHYSPAGE_RANGES_ENTRIES_PER_LIST];
124:};
125:
126:
127:/*
128: *  Dyntrans "Instruction Translation Cache":
129: *
130: *  cur_physpage is a pointer to the current physpage. (It _HAPPENS_ to
131: *  be the same as cur_ic_page, because all the instrcalls should be placed
132: *  first in the physpage struct!)
133: *
134: *  cur_ic_page is a pointer to an array of xxx_IC_ENTRIES_PER_PAGE
135: *  instruction call entries.
136: *
137: *  next_ic points to the next such instruction call to be executed.
138: *
139: *  combination_check, when set to non-NULL, is executed automatically after
140: *  an instruction has been translated. (It check for combinations of
141: *  instructions; low_addr is the offset of the translated instruction in the
142: *  current page, NOT shifted right.)
143: */
144:#define DYNTRANS_ITC(arch)	struct arch ## _tc_physpage *cur_physpage;  \
145:				struct arch ## _instr_call  *cur_ic_page;   \
146:				struct arch ## _instr_call  *next_ic;       \
147:				struct arch ## _tc_physpage *physpage_template;\
148:				void (*combination_check)(struct cpu *,     \
149:				    struct arch ## _instr_call *, int low_addr);
150:
151:/*
152: *  Virtual -> physical -> host address translation TLB entries:
153: *  ------------------------------------------------------------
154: *
155: *  Regardless of whether 32-bit or 64-bit address translation is used, the
156: *  same TLB entry structure is used.
157: */
158:#define	VPH_TLBS(arch,ARCH)						\
159:	struct arch ## _vpg_tlb_entry					\
160:	    vph_tlb_entry[ARCH ## _MAX_VPH_TLB_ENTRIES];
161:
162:/*
163: *  32-bit dyntrans emulated Virtual -> physical -> host address translation:
164: *  -------------------------------------------------------------------------
165: *
166: *  This stuff assumes that 4 KB pages are used. 20 bits to select a page
167: *  means just 1 M entries needed. This is small enough that a couple of
168: *  full-size tables can fit in virtual memory on modern hosts (both 32-bit
169: *  and 64-bit hosts). :-)
170: *
171: *  Usage: e.g. VPH32(arm,ARM)
172: *           or VPH32(sparc,SPARC)
173: *
174: *  The vph_tlb_entry entries are cpu dependent tlb entries.
175: *
176: *  The host_load and host_store entries point to host pages; the phys_addr
177: *  entries are uint32_t (emulated physical addresses).
178: *
179: *  phys_page points to translation cache physpages.
180: *
181: *  vaddr_to_tlbindex is a virtual address to tlb index hint table.
182: *  The values in this array are the tlb index plus 1, so a value of, say,
183: *  3 means tlb index 2. A value of 0 would mean a tlb index of -1, which
184: *  is not a valid index. (I.e. no hit.)
185: *
186: *  The VPH32EXTENDED variant adds an additional postfix to the array
187: *  names. Used so far only for usermode addresses in M88K emulation.
188: */
189:#define	N_VPH32_ENTRIES		1048576
190:#define	VPH32(arch,ARCH)						\
191:	unsigned char		*host_load[N_VPH32_ENTRIES];		\
192:	unsigned char		*host_store[N_VPH32_ENTRIES];		\
193:	uint32_t		phys_addr[N_VPH32_ENTRIES];		\
194:	struct arch ## _tc_physpage  *phys_page[N_VPH32_ENTRIES];	\
195:	uint8_t			vaddr_to_tlbindex[N_VPH32_ENTRIES];
196:#define	VPH32_16BITVPHENTRIES(arch,ARCH)				\
197:	unsigned char		*host_load[N_VPH32_ENTRIES];		\
198:	unsigned char		*host_store[N_VPH32_ENTRIES];		\
199:	uint32_t		phys_addr[N_VPH32_ENTRIES];		\
200:	struct arch ## _tc_physpage  *phys_page[N_VPH32_ENTRIES];	\
201:	uint16_t		vaddr_to_tlbindex[N_VPH32_ENTRIES];
202:#define	VPH32EXTENDED(arch,ARCH,ex)					\
203:	unsigned char		*host_load_ ## ex[N_VPH32_ENTRIES];	\
204:	unsigned char		*host_store_ ## ex[N_VPH32_ENTRIES];	\
205:	uint32_t		phys_addr_ ## ex[N_VPH32_ENTRIES];	\
206:	struct arch ## _tc_physpage  *phys_page_ ## ex[N_VPH32_ENTRIES];\
207:	uint8_t			vaddr_to_tlbindex_ ## ex[N_VPH32_ENTRIES];
208:
209:
210:/*
211: *  64-bit dyntrans emulated Virtual -> physical -> host address translation:
212: *  -------------------------------------------------------------------------
213: *
214: *  Usage: e.g. VPH64(alpha,ALPHA)
215: *           or VPH64(sparc,SPARC)
216: *
217: *  l1_64 is an array containing poiners to l2 tables.
218: *
219: *  l2_64_dummy is a pointer to a "dummy l2 table". Instead of having NULL
220: *  pointers in l1_64 for unused slots, a pointer to the dummy table can be
221: *  used.
222: */
223:#define	DYNTRANS_L1N		17
224:#define	VPH64(arch,ARCH)						\
225:	struct arch ## _l3_64_table	*l3_64_dummy;			\
226:	struct arch ## _l3_64_table	*next_free_l3;			\
227:	struct arch ## _l2_64_table	*l2_64_dummy;			\
228:	struct arch ## _l2_64_table	*next_free_l2;			\
229:	struct arch ## _l2_64_table	*l1_64[1 << DYNTRANS_L1N];
