src/cpus/memory_alpha.c:168: 	/*  #508: was just `PFN << pageSizeShift' -- a PAGE BASE.  memory_rw then takes
src/cpus/memory_alpha.c:169: 	    `offset = paddr & offset_mask', which was therefore always zero, so every
src/cpus/memory_alpha.c:170: 	    walked access FILLED THE TRANSLATION FROM the page's first bytes.  ("every
src/cpus/memory_alpha.c:171: 	    walked access resolved to" until 2026-09-07: a pass-2 seat noted that the
src/cpus/memory_alpha.c:172: 	    Alpha FAST PATH recomputes `addr & 8191' itself, so a later cache HIT reads
src/cpus/memory_alpha.c:173: 	    the right bytes.  The corruption is the SLOW-PATH FILL, which is also why a
src/cpus/memory_alpha.c:174: 	    watchpoint -- which keeps a page off the fast store table -- makes it
src/cpus/memory_alpha.c:175: 	    reproducible.)  Measured: a cold guest ldq
src/cpus/memory_alpha.c:176: 	    of vaddr+8 returned the vaddr+0 value.  A debugger watchpoint on a walked page
src/cpus/memory_alpha.c:177: 	    landed at the base for the same reason.
src/cpus/memory_alpha.c:178: 	
src/cpus/memory_alpha.c:179: 	    The mask is derived from pageSizeShift rather than written as 0x1fff: this
src/cpus/memory_alpha.c:180: 	    function already has TWO names for 13 (ALPHA_PAGESHIFT and this local), and a
src/cpus/memory_alpha.c:181: 	    literal beside the shift is how the two drift.  `|' rather than `+' because
src/cpus/memory_alpha.c:182: 	    that is what every other CPU's walk in this tree writes; here they are equal,
src/cpus/memory_alpha.c:183: 	    the shifted PFN having bits 12:0 clear.  The TODO below STAYS: `flags' is
src/cpus/memory_alpha.c:184: 	    still ignored, the protection bits untested, and `return 2' still reports
src/cpus/memory_alpha.c:185: 	    every walked page writable.  */
src/cpus/memory_alpha.c:186: 	(*return_paddr) = (ALPHA_PTE_TO_PFN(pte3) << pageSizeShift)
src/cpus/memory_alpha.c:187: 	    | (vaddr & ((1ULL << pageSizeShift) - 1));
src/cpus/memory_alpha.c:188: 
src/cpus/memory_alpha.c:189: 	// TODO.
src/cpus/memory_alpha.c:190: 	return 2;
src/cpus/memory_alpha.c:191: 
src/cpus/memory_alpha.c:192: not_found:
src/cpus/memory_alpha.c:193: 	/*  No match.  */
src/cpus/memory_alpha.c:194: 	/*  #194: (Codex/Fable) a failed guest page-table walk must not
src/cpus/memory_alpha.c:195: 	    abort()/exit() the host; report no-translation (0) so the caller
src/cpus/memory_alpha.c:196: 	    raises the fault (keeps the emulator alive and debuggable).  */
src/cpus/memory_alpha.c:197: 	fatal("[ alpha_translate_v2p: 0x%016" PRIx64" wasn't found ]\n", vaddr);
