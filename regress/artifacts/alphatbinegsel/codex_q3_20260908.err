src/machines/machine_alpha.c:186: 	 *  PROM_ENTRY_PADDR + 0x800:
src/machines/machine_alpha.c:187: 	 *  (Hopefully nothing else will be there.)
src/machines/machine_alpha.c:188: 	 */
src/machines/machine_alpha.c:189: 	store_32bit_word(cpu, PROM_ENTRY_PADDR, 0x3fffffe);
src/machines/machine_alpha.c:190: 	store_32bit_word(cpu, PROM_ENTRY_PADDR + 0x800, 0x3fffffd);
src/machines/machine_alpha.c:191: 
