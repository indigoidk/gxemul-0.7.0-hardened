src/include/thirdparty/alpha_cpu.h:274: 
src/include/thirdparty/alpha_cpu.h:275: #ifdef _KERNEL
src/include/thirdparty/alpha_cpu.h:276: 
src/include/thirdparty/alpha_cpu.h:277: /*
src/include/thirdparty/alpha_cpu.h:278:  * Translation Buffer Invalidation definitions [OSF/1 PALcode Specific]
src/include/thirdparty/alpha_cpu.h:279:  */
src/include/thirdparty/alpha_cpu.h:280: 
src/include/thirdparty/alpha_cpu.h:281: #define	ALPHA_TBIA()	alpha_pal_tbi(-2, 0)		/* all TB entries */
src/include/thirdparty/alpha_cpu.h:282: #define	ALPHA_TBIAP()	alpha_pal_tbi(-1, 0)		/* all per-process */
src/include/thirdparty/alpha_cpu.h:283: #define	ALPHA_TBISI(va)	alpha_pal_tbi(1, (va))		/* ITB entry for va */
src/include/thirdparty/alpha_cpu.h:284: #define	ALPHA_TBISD(va)	alpha_pal_tbi(2, (va))		/* DTB entry for va */
src/include/thirdparty/alpha_cpu.h:285: #define	ALPHA_TBIS(va)	alpha_pal_tbi(3, (va))		/* all for va */
src/include/thirdparty/alpha_cpu.h:286: 
src/include/thirdparty/alpha_cpu.h:287: #endif /* _KERNEL */
src/include/thirdparty/alpha_cpu.h:288: 
src/include/thirdparty/alpha_cpu.h:289: /*
src/include/thirdparty/alpha_cpu.h:473: 		: "$1", "$22", "$23", "$24", "$25", "memory");
src/include/thirdparty/alpha_cpu.h:474: 
src/include/thirdparty/alpha_cpu.h:475: 	return (v0);
src/include/thirdparty/alpha_cpu.h:476: }
src/include/thirdparty/alpha_cpu.h:477: 
src/include/thirdparty/alpha_cpu.h:478: static __inline void
src/include/thirdparty/alpha_cpu.h:479: alpha_pal_tbi(unsigned long op, vaddr_t va)
src/include/thirdparty/alpha_cpu.h:480: {
src/include/thirdparty/alpha_cpu.h:481: 	register unsigned long a0 __asm("$16") = op;
src/include/thirdparty/alpha_cpu.h:482: 	register unsigned long a1 __asm("$17") = va;
src/include/thirdparty/alpha_cpu.h:483: 
src/include/thirdparty/alpha_cpu.h:484: 	__asm volatile("call_pal %2 # PAL_OSF1_tbi"
src/include/thirdparty/alpha_cpu.h:485: 		: "=r" (a0), "=r" (a1)
src/include/thirdparty/alpha_cpu.h:486: 		: "i" (PAL_OSF1_tbi), "0" (a0), "1" (a1)
src/include/thirdparty/alpha_cpu.h:487: 		/* clobbers t0, t8..t11, a0 (above), a1 (above) */
src/include/thirdparty/alpha_cpu.h:488: 		: "$1", "$22", "$23", "$24", "$25");
