src/machines/machine_alpha.c:159: 	/*
src/machines/machine_alpha.c:160: 	 *  MDDT: Memory Data Descriptor Table. For now, it is a simple
src/machines/machine_alpha.c:161: 	 *  two-entry table with half of the available RAM in each entry.
src/machines/machine_alpha.c:162: 	 *  (The values are in number of 8K pages.)
src/machines/machine_alpha.c:163: 	 *  The first 16 MB are not included (the kernel lives there).
src/machines/machine_alpha.c:164: 	 *  The last 1 MB is not included either, it is reserved for bootup
src/machines/machine_alpha.c:165: 	 *  and similar.
src/machines/machine_alpha.c:166: 	 */
