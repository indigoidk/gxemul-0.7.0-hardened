regress/alpha_harness_probe.py:1: #!/usr/bin/env python3
regress/alpha_harness_probe.py:2: #  alpha_harness_probe.py -- THE ALPHA RUNG-3 HARNESS.
regress/alpha_harness_probe.py:3: #
regress/alpha_harness_probe.py:4: #  There has never been an Alpha probe in this tree, and three open HIGH rows need one
regress/alpha_harness_probe.py:5: #  (`alphaswpctxptbr', `alphapfnoffset', and the swpctx return-register defect).  This file is
regress/alpha_harness_probe.py:6: #  the FOUNDATION: an encoder, a pty session, and the two controls the witness ladder demands
regress/alpha_harness_probe.py:7: #  of any rung-3 access witness.  It deliberately ships the controls FIRST and asserts nothing
regress/alpha_harness_probe.py:8: #  about any defect, because a harness whose controls have never been green cannot be trusted
regress/alpha_harness_probe.py:9: #  to say anything about a defect afterwards.
regress/alpha_harness_probe.py:10: #
regress/alpha_harness_probe.py:11: #  *** WHAT IS ESTABLISHED BEFORE THIS FILE RUNS, all read out of the fork rather than assumed:
regress/alpha_harness_probe.py:12: #
regress/alpha_harness_probe.py:13: #  1. THE MACHINES EXIST AND THREE OF FOUR RUN.  Measured 2026-09-07: `-H' advertises
regress/alpha_harness_probe.py:14: #     alphabook1 (21066), alphaserver4100 (21164A-2), 3000/300 and eb164 (21164PC); the first,
regress/alpha_harness_probe.py:15: #     second and fourth construct and reach the debugger prompt, and `3000/300' ABORTS the host
regress/alpha_harness_probe.py:16: #     during construction at interrupt_handler_lookup("0") -- a separate filed defect.
regress/alpha_harness_probe.py:17: #
regress/alpha_harness_probe.py:18: #  2. `call_pal' IS OPCODE 0 WITH THE PAL NUMBER IN BITS 25..0, and cpu_alpha_instr.c dispatches
regress/alpha_harness_probe.py:19: #     it STRAIGHT to alpha_palcode():
regress/alpha_harness_probe.py:20: #         case 0x00:  ic->f = instr(call_pal);  ic->arg[0] = iword & 0x3ffffff;
regress/alpha_harness_probe.py:21: #     so `call_pal 0x30' is literally the instruction word 0x00000030.
regress/alpha_harness_probe.py:22: #
regress/alpha_harness_probe.py:23: #     *** BUT "NO GATING OF ANY KIND" WAS MY CLAIM AND IT IS WRONG.  A seat corrected it, and
regress/alpha_harness_probe.py:24: #     the correction is the difference between a working probe and one that mysteriously
regress/alpha_harness_probe.py:25: #     halts. ***  Dispatch INTO alpha_palcode() carries no privilege check -- but the function
regress/alpha_harness_probe.py:26: #     GATES ITS OWN SWITCH, at cpu_alpha_palcode.c:183:
regress/alpha_harness_probe.py:27: #
regress/alpha_harness_probe.py:28: #         uint64_t userMode = cpu->cd.alpha.ps & ALPHA_PSL_USERMODE;   /* 0x0008 */
regress/alpha_harness_probe.py:29: #         if (userMode && !(palcode == 0x80 || 0x81 || 0x83 || 0xae ||
regress/alpha_harness_probe.py:30: #                           0xaa || 0x86 || 0x9e || 0x92 || 0x9f)) {
regress/alpha_harness_probe.py:31: #                 fatal("[ Privileged Alpha PALcode called from user mode: TODO ]");
regress/alpha_harness_probe.py:32: #                 cpu->running = 0;          <-- THE MACHINE STOPS
regress/alpha_harness_probe.py:33: #                 return;
regress/alpha_harness_probe.py:34: #         }
regress/alpha_harness_probe.py:35: #
regress/alpha_harness_probe.py:36: #     0x30 is NOT on that whitelist.  So in user mode `call_pal 0x30' does not reach swpctx --
regress/alpha_harness_probe.py:37: #     it HALTS THE CPU.  **That failure would present as a probe whose step never completes,
regress/alpha_harness_probe.py:38: #     i.e. as a broken harness rather than as a mode problem**, which is exactly why it gets a
regress/alpha_harness_probe.py:39: #     control row of its own below rather than a comment.
regress/alpha_harness_probe.py:40: #
regress/alpha_harness_probe.py:41: #     `cpu->cd.alpha.ps' has no explicit initialiser anywhere in src/, so it is zero from the
regress/alpha_harness_probe.py:42: #     zeroed cpu struct and USERMODE is clear -- kernel mode.  **That is a DERIVATION, not a
regress/alpha_harness_probe.py:43: #     measurement**, and the `palgate' row is what turns it into one.
regress/alpha_harness_probe.py:44: #
regress/alpha_harness_probe.py:45: #  3. THE MEMORY-FORMAT ENCODING is opcode<<26 | ra<<21 | rb<<16 | disp16, and the opcodes are
regress/alpha_harness_probe.py:46: #     read off cpu_alpha_instr.c's own decoder rather than from a manual: LDA 0x08, LDAH 0x09,
regress/alpha_harness_probe.py:47: #     LDQ 0x29, STQ 0x2d, LDL 0x28, STL 0x2c.
regress/alpha_harness_probe.py:48: #
regress/alpha_harness_probe.py:49: #  4. REGISTER NUMBERS AND DEBUGGER NAMES come from cpu_alpha.h's ALPHA_REG_NAMES:
regress/alpha_harness_probe.py:50: #     r0 v0, r1 t0, r2 t1, r3 t2, ... r16 a0, ... r30 sp, r31 zero.
regress/alpha_harness_probe.py:51: #
regress/alpha_harness_probe.py:52: #  *** WHAT IS NOT ESTABLISHED, and is exactly what the controls are for: WHICH ADDRESSES ARE
regress/alpha_harness_probe.py:53: #  WRITABLE RAM.  The machine loads a file at 0x20000000 and `alphaserver4100'/`eb164' report
regress/alpha_harness_probe.py:54: #  "cpu0: starting at 0x0000000020000000", but -M 64 is 64 MB and 0x20000000 is 512 MB, so the
regress/alpha_harness_probe.py:55: #  two facts do not obviously agree.  THIS FILE DOES NOT GUESS: the liveness control writes a
regress/alpha_harness_probe.py:56: #  known value through a real guest store and reads it back through a real guest load, and if
regress/alpha_harness_probe.py:57: #  the address is wrong that row goes RED and says so.  A harness that assumed an address and
regress/alpha_harness_probe.py:58: #  then reported a defect would be measuring its own mistake. ***
regress/alpha_harness_probe.py:59: 
regress/alpha_harness_probe.py:60: import os, sys, re, pty, time, select
regress/alpha_harness_probe.py:61: 
regress/alpha_harness_probe.py:62: BIN   = sys.argv[1]
regress/alpha_harness_probe.py:63: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
regress/alpha_harness_probe.py:64: MACH  = sys.argv[3] if len(sys.argv) > 3 else "alphabook1"
regress/alpha_harness_probe.py:65: 
regress/alpha_harness_probe.py:66: rows = []
regress/alpha_harness_probe.py:67: 
regress/alpha_harness_probe.py:68: def row(name, got, want, note="", negate=False):
regress/alpha_harness_probe.py:69:     ok = (got != want) if negate else (got == want)
regress/alpha_harness_probe.py:70:     rows.append((name, ok))
regress/alpha_harness_probe.py:71:     print("%-18s %-20s %-20s %-40s %s" % (name, str(got), ("NOT " if negate else "") + str(want),
regress/alpha_harness_probe.py:72:                                           note, "ok" if ok else "FAIL"))
regress/alpha_harness_probe.py:73:     return ok
regress/alpha_harness_probe.py:74: 
regress/alpha_harness_probe.py:75: # ---------------------------------------------------------------- the encoder
regress/alpha_harness_probe.py:76: #  Memory format.  `disp' is a SIGNED 16-bit displacement, so it is masked here and the caller
regress/alpha_harness_probe.py:77: #  is responsible for keeping values in range -- an out-of-range displacement silently truncating
regress/alpha_harness_probe.py:78: #  would be a wrong instruction that still assembles, which is the hand-assembled-encoding trap
regress/alpha_harness_probe.py:79: #  this project has paid for four times.  Hence the assert.
regress/alpha_harness_probe.py:80: def mem(op, ra, rb, disp):
regress/alpha_harness_probe.py:81:     assert -0x8000 <= disp <= 0xffff, "displacement %r out of 16-bit range" % disp
regress/alpha_harness_probe.py:82:     return ((op & 0x3f) << 26) | ((ra & 31) << 21) | ((rb & 31) << 16) | (disp & 0xffff)
regress/alpha_pfnoffset_probe.py:1: #!/usr/bin/env python3
regress/alpha_pfnoffset_probe.py:2: #
regress/alpha_pfnoffset_probe.py:3: #  alphapfnoffset -- RUNG-3 WITNESS: the Alpha page-table walk drops the within-page offset.
regress/alpha_pfnoffset_probe.py:4: #
regress/alpha_pfnoffset_probe.py:5: #      memory_alpha.c   (*return_paddr) = ALPHA_PTE_TO_PFN(pte3) << pageSizeShift;
regress/alpha_pfnoffset_probe.py:6: #      memory_rw.c      offset = paddr & offset_mask;
regress/alpha_pfnoffset_probe.py:7: #
regress/alpha_pfnoffset_probe.py:8: #  The walk returns a PAGE BASE, so `paddr & offset_mask' is zero and a walked access resolves to
regress/alpha_pfnoffset_probe.py:9: #  the page's first bytes.  A codex reachability pass enumerated all 8192 offsets: the walk yields
regress/alpha_pfnoffset_probe.py:10: #  offset zero throughout, differing from the offset-preserving address for 8191 of them.
regress/alpha_pfnoffset_probe.py:11: #
regress/alpha_pfnoffset_probe.py:12: #  *** THIS IS A WITNESS (rung 3), NOT A DETECTOR.  It shows the symptom on the COMMITTED build,
regress/alpha_pfnoffset_probe.py:13: #  which is what licenses a fix, and it must NOT be gated -- a witness stays red until the fix
regress/alpha_pfnoffset_probe.py:14: #  lands.  Its rows therefore assert the CORRECT behaviour and are expected to FAIL here. ***
regress/alpha_pfnoffset_probe.py:15: #
regress/alpha_pfnoffset_probe.py:16: #  ---------------------------------------------------------------------------------------------
regress/alpha_pfnoffset_probe.py:17: #  SIX THINGS THE DESIGN REVIEW (grok, 2026-09-07) ESTABLISHED.  Four are traps that would have
regress/alpha_pfnoffset_probe.py:18: #  produced a GREEN run on the defective build; none is obvious from the source.
regress/alpha_pfnoffset_probe.py:19: #
regress/alpha_pfnoffset_probe.py:20: #  1. THE SWAP IS NOT A BLOCKER.  `swpctx' is the only writer of apcb_ptbr -- but it is only a
regress/alpha_pfnoffset_probe.py:21: #     CONFOUND when ptbr and flags DIFFER.  Put the SAME L1 PFN in both PCB fields and the
regress/alpha_pfnoffset_probe.py:22: #     defective line and the corrected line both leave apcb_ptbr = L1_PFN.  (The inverse is a
regress/alpha_pfnoffset_probe.py:23: #     trap: PFN in flags with ptbr = 0 arms the walk on HEAD and leaves IDENTITY MAPPING on a
regress/alpha_pfnoffset_probe.py:24: #     fixed PAL, so post-fix green would be the bootstrap, not the repair.)
regress/alpha_pfnoffset_probe.py:25: #
regress/alpha_pfnoffset_probe.py:26: #  2. PFN, NOT BYTE ADDRESS.  apcb_ptbr and the PTE high halves hold PFNs.  ptbr = 0x01050000
regress/alpha_pfnoffset_probe.py:27: #     would give base = 0x01050000 << 13, past RAM, and the walk reports `wasn't found'.
regress/alpha_pfnoffset_probe.py:28: #
regress/alpha_pfnoffset_probe.py:29: #  3. ONE COLD SHOT.  The fast path caches the page from `paddr & ~offset_mask' -- the CORRECT
regress/alpha_pfnoffset_probe.py:30: #     physical page -- so the walked paddr is wrong only for the FILL.  A second access at any
regress/alpha_pfnoffset_probe.py:31: #     offset is a hit and reads the right bytes, i.e. GOES GREEN ON HEAD.  Load once; never retry.
regress/alpha_pfnoffset_probe.py:32: #
regress/alpha_pfnoffset_probe.py:33: #  4. THE POLARITY TRAP.  Planting B *through the walk* makes HEAD store it at data+0 and read it
regress/alpha_pfnoffset_probe.py:34: #     back from data+0 -- the defect measured against itself, green.  A cousin: planting at vaddr
regress/alpha_pfnoffset_probe.py:35: #     0/N while ptbr == 0 hits PHYSICAL 0/N, not the data page.  So A and B are planted through
regress/alpha_pfnoffset_probe.py:36: #     K0SEG of the DATA PAGE, before the walk is ever used.
regress/alpha_pfnoffset_probe.py:37: #
regress/alpha_pfnoffset_probe.py:38: #  5. A FAILED WALK DOES NOT WRITE THE DESTINATION REGISTER.  LS_GENERIC_N returns on a memory_rw
regress/alpha_pfnoffset_probe.py:39: #     failure without storing, so "faults or returns zero" is false.  Hence a THREE-WAY oracle
regress/alpha_pfnoffset_probe.py:40: #     with a sentinel S pre-loaded into the destination:
regress/alpha_pfnoffset_probe.py:41: #         S = the walk never completed        0 = walked onto unmapped physical
regress/alpha_pfnoffset_probe.py:42: #         A = right page, offset dropped      B = correct
regress/alpha_pfnoffset_probe.py:43: #
regress/alpha_pfnoffset_probe.py:44: #  6. ONLY ALPHA_PTE_VALID IS LOAD-BEARING.  Verified in memory_alpha.c: each level tests
regress/alpha_pfnoffset_probe.py:45: #     `!(pteN & ALPHA_PTE_VALID)' and nothing else -- not KR/KW/UR/UW, FAULT_ON_*, ASM or
regress/alpha_pfnoffset_probe.py:46: #     granularity.  Setting bits the walk does not implement and calling them required would be
regress/alpha_pfnoffset_probe.py:47: #     the "cannot hurt" addition this project refuses.
regress/alpha_pfnoffset_probe.py:48: #
regress/alpha_pfnoffset_probe.py:49: #  Usage:  alpha_pfnoffset_probe.py <gxemul-binary> [label]
regress/alpha_pfnoffset_probe.py:50: import os, sys, pty, select, time, re
regress/alpha_pfnoffset_probe.py:51: 
regress/alpha_pfnoffset_probe.py:52: BIN   = sys.argv[1]
regress/alpha_pfnoffset_probe.py:53: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
regress/alpha_pfnoffset_probe.py:54: MACH  = "alphabook1"
regress/alpha_pfnoffset_probe.py:55: 
regress/alpha_pfnoffset_probe.py:56: rows = []
regress/alpha_pfnoffset_probe.py:57: def row(name, got, want, note="", negate=False):
regress/alpha_pfnoffset_probe.py:58:     ok = (got != want) if negate else (got == want)
regress/alpha_pfnoffset_probe.py:59:     rows.append((name, ok))
regress/alpha_pfnoffset_probe.py:60:     shown = ("NOT " + str(want)) if negate else str(want)
regress/alpha_pfnoffset_probe.py:61:     print("%-14s %-20s %-22s %-44s %s" % (name, str(got), shown, note, "ok" if ok else "FAIL"))
regress/alpha_pfnoffset_probe.py:62:     return ok
regress/alpha_pfnoffset_probe.py:63: 
regress/alpha_pfnoffset_probe.py:64: # ---------------------------------------------------------------- encoder
regress/alpha_pfnoffset_probe.py:65: ZERO, T0, T1, T2, T3, T4 = 31, 1, 2, 3, 4, 5
regress/alpha_pfnoffset_probe.py:66: A0 = 16
regress/alpha_pfnoffset_probe.py:67: 
regress/alpha_pfnoffset_probe.py:68: def mem(op, ra, rb, disp):
regress/alpha_pfnoffset_probe.py:69:     assert -32768 <= disp <= 32767, "displacement %d out of range" % disp
regress/alpha_pfnoffset_probe.py:70:     return (op << 26) | (ra << 21) | (rb << 16) | (disp & 0xffff)
regress/alpha_pfnoffset_probe.py:71: 
regress/alpha_pfnoffset_probe.py:72: def LDA (ra, disp, rb=ZERO): return mem(0x08, ra, rb, disp)
regress/alpha_pfnoffset_probe.py:73: def LDAH(ra, disp, rb=ZERO): return mem(0x09, ra, rb, disp)
regress/alpha_pfnoffset_probe.py:74: def LDQ (ra, disp, rb):      return mem(0x29, ra, rb, disp)
regress/alpha_pfnoffset_probe.py:75: def CALL_PAL(n):             return n & 0x3ffffff
regress/alpha_pfnoffset_probe.py:76: 
