codex
Alpha has an active page-table walker, and the tree includes Alpha guest harnesses with memory and PAL-dispatch controls. That rules out “paging is absent” as a reason to call this unobservable. The invalidation helper also clears the fast load/store mappings and the corresponding TLB valid bit; its old “quick array only” comment is stale.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "rg -n 'os.exec|execl|execv|subprocess|Popen|MACH|"'^row'"\\(|"'^#  ----|''^#  CONTROL|''^def session|''^def run'"' regress/alpha_harness_probe.py regress/alpha_pfnoffset_probe.py; rg -l -i 'alphatbinegsel|PAL_OSF1_tbi|ALPHA_TBIA|CALL_PAL\\(0x33\\)' regress -g '*.py' -g '*.sh' -g '*.c' -g '"'!artifacts/**'"' -g '"'!regress/artifacts/**'"'; "'$p='"'src/machines/machine_alpha.c'; "'$s=Get-Content -LiteralPath $p; for ($i=234; $i -lt 255 -and $i -lt $s.Length; $i++) { '"'{0}:{1}: {2}' -f "'$p,($i+1),$s[$i] }' in C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC
