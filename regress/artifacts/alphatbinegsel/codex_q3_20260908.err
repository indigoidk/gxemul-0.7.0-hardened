src/include/cpu_alpha.h:155: 
src/include/cpu_alpha.h:156: 	/*  Misc.:  */
src/include/cpu_alpha.h:157: 	uint64_t		pcc;			/*  Cycle Counter  */
src/include/cpu_alpha.h:158: 	uint64_t		load_linked_addr;
src/include/cpu_alpha.h:159: 	int			ll_flag;
src/include/cpu_alpha.h:160: 
src/include/cpu_alpha.h:161: 	int			irq_asserted;
src/include/cpu_alpha.h:162: 
src/include/cpu_alpha.h:163: 	/*  OSF1 PALcode specific:  */
src/include/cpu_alpha.h:164: 	uint64_t		ps;		/*  Processor Status  */
src/include/cpu_alpha.h:165: 	uint64_t		vptptr;		/*  Virtual Page Table Ptr  */
src/include/cpu_alpha.h:166: 	uint64_t		sysvalue;
src/include/cpu_alpha.h:167: 	uint64_t		mces;		/*  Machine Check Error Summary  */
src/include/cpu_alpha.h:168: 	uint64_t		kgp;		/*  Kernel GP  */
src/include/cpu_alpha.h:169: 	uint64_t		kentry[N_ALPHA_KENTRY];
src/include/cpu_alpha.h:170: 	uint64_t		ctx;		/*  Ptr to current PCB (?)  */
src/include/cpu_alpha.h:171: 	struct alpha_pcb	pcb;		/*  Process Control Block  */
src/include/cpu_alpha.h:172: 
src/include/cpu_alpha.h:173: 
src/include/cpu_alpha.h:174: 	/*
src/include/cpu_alpha.h:175: 	 *  Instruction translation cache and Virtual->Physical->Host
src/include/cpu_alpha.h:176: 	 *  address translation:
src/include/cpu_alpha.h:177: 	 */
