src/include/cpu.h:522: #define	JUST_MARK_AS_NON_WRITABLE	1
src/include/cpu.h:523: #define	INVALIDATE_ALL			2
src/include/cpu.h:524: #define	INVALIDATE_PADDR		4
src/include/cpu.h:525: #define	INVALIDATE_VADDR		8
src/include/cpu.h:526: #define	INVALIDATE_VADDR_UPPER4		16	/*  useful for PPC emulation  */
src/include/cpu.h:527: 
