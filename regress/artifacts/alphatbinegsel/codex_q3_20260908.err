src/machines/machine_test.c:26:  *   
src/machines/machine_test.c:27:  *
src/machines/machine_test.c:28:  *  COMMENT: Various test machines
src/machines/machine_test.c:29:  *
src/machines/machine_test.c:30:  *  Generally, the machines are as follows:
src/machines/machine_test.c:31:  *
src/machines/machine_test.c:32:  *	bareXYZ:	A bare machine using an XYZ processor.
src/machines/machine_test.c:33:  *
src/machines/machine_test.c:34:  *	testXYZ:	A machine with an XYZ processor, and some experimental
src/machines/machine_test.c:35:  *			devices connected to it.
src/machines/machine_test.c:36:  *
src/machines/machine_test.c:37:  *  The experimental devices in the test machines are:
src/machines/machine_test.c:38:  *
src/machines/machine_test.c:39:  *	cons		A serial I/O console device.
src/machines/machine_test.c:40:  *	disk		A device for reading/writing (emulated) disk sectors.
src/machines/machine_test.c:41:  *	ether		An ethernet device, for sending/receiving ethernet
src/machines/machine_test.c:42:  *			frames on an emulated network.
src/machines/machine_test.c:43:  *	fb		Framebuffer (24-bit RGB per pixel).
src/machines/machine_test.c:44:  *	irqc		A generic interrupt controller.
src/machines/machine_test.c:45:  *	mp		A multiprocessor controller.
src/machines/machine_test.c:46:  *	rtc		A real-time clock device.
src/machines/machine_test.c:47:  */
src/machines/machine_test.c:48: 
src/machines/machine_test.c:49: #include <stdio.h>
src/machines/machine_test.c:50: #include <string.h>
src/machines/machine_test.c:51: 
src/machines/machine_test.c:52: #include "cpu.h"
src/machines/machine_test.c:53: #include "device.h"
src/machines/machine_test.c:54: #include "devices.h"
src/machines/machine_test.c:55: #include "machine.h"
src/machines/machine_test.c:56: #include "memory.h"
src/machines/machine_test.c:57: #include "misc.h"
src/machines/machine_test.c:58: 
src/machines/machine_test.c:59: #include "thirdparty/sh4_exception.h"
src/machines/machine_test.c:60: 
src/machines/machine_test.c:61: #include "testmachine/dev_cons.h"
src/machines/machine_test.c:62: #include "testmachine/dev_disk.h"
src/machines/machine_test.c:63: #include "testmachine/dev_ether.h"
src/machines/machine_test.c:64: #include "testmachine/dev_fb.h"
src/machines/machine_test.c:65: #include "testmachine/dev_irqc.h"
src/machines/machine_test.c:66: #include "testmachine/dev_mp.h"
src/machines/machine_test.c:67: #include "testmachine/dev_rtc.h"
src/machines/machine_test.c:68: 
src/machines/machine_test.c:69: 
src/machines/machine_test.c:70: /*
src/machines/machine_test.c:71:  *  default_test():
src/machines/machine_test.c:72:  *
src/machines/machine_test.c:73:  *  Initializes devices for most test machines. (Note: MIPS is different,
src/machines/machine_test.c:74:  *  because of legacy reasons.)
src/machines/machine_test.c:75:  */
src/machines/machine_test.c:76: static void default_test(struct machine *machine, struct cpu *cpu)
src/machines/machine_test.c:77: {
src/machines/machine_test.c:78: 	char tmpstr[2000];
src/machines/machine_test.c:79: 	char base_irq[1000];
src/machines/machine_test.c:80: 	char end_of_base_irq[50];
src/machines/machine_test.c:81: 
src/machines/machine_test.c:82: 	/*
src/machines/machine_test.c:83: 	 *  First add the interrupt controller. Most processor architectures
src/machines/machine_test.c:84: 	 *  in GXemul have only 1 interrupt pin on the CPU, and it is simply
src/machines/machine_test.c:85: 	 *  called "machine[y].cpu[z]".
src/machines/machine_test.c:86: 	 *
src/machines/machine_test.c:87: 	 *  MIPS is an exception, dealt with in a separate setup function.
src/machines/machine_test.c:88: 	 *  ARM and SH are dealt with here.
src/machines/machine_test.c:89: 	 */
src/machines/machine_test.c:90: 
src/machines/machine_test.c:91: 	switch (cpu->cpu_family->arch) {
src/machines/machine_test.c:92: 
src/machines/machine_test.c:93: 	case ARCH_ARM:
src/machines/machine_test.c:94: 		snprintf(end_of_base_irq, sizeof(end_of_base_irq), ".irq");
src/machines/machine_test.c:95: 		break;
src/machines/machine_test.c:96: 
src/machines/machine_test.c:97: 	case ARCH_SH:
src/machines/machine_test.c:98: 		/*
src/machines/machine_test.c:99: 		 *  #456: NOT IRQ15.  The whole SH test machine hangs off this
src/machines/machine_test.c:100: 		 *  one line, and 0x3e0 can never carry a priority: the loop in
src/machines/machine_test.c:101: 		 *  sh_update_interrupt_priorities() stops at IRQ14, and its own
src/machines/machine_test.c:102: 		 *  formula 15 - ((i - IRQ0) / 0x20) yields 0 for that line
src/machines/machine_test.c:103: 		 *  anyway -- so widening the loop would NOT help, it would
src/machines/machine_test.c:104: 		 *  merely assign zero to the encoding the manual calls "no
src/machines/machine_test.c:105: 		 *  request".  Priority 0 means masked, so nothing this machine
src/machines/machine_test.c:106: 		 *  raised could ever be delivered.
src/machines/machine_test.c:107: 		 *
src/machines/machine_test.c:108: 		 *  The hardware has no such source either.  SH7750 Hardware
src/machines/machine_test.c:109: 		 *  Manual Rev.7.00 19.2.2: "A value of 15 (1111) indicates no
src/machines/machine_test.c:110: 		 *  interrupt request (interrupt priority level 0)", and Table
src/machines/machine_test.c:111: 		 *  19.5's IRL block ends at H'3C0.  `H'3E0` does not appear
src/machines/machine_test.c:112: 		 *  anywhere in the manual.
src/machines/machine_test.c:113: 		 *
src/machines/machine_test.c:114: 		 *  IRQ14 is the lowest REAL level, which is the right tier for
src/machines/machine_test.c:115: 		 *  a test machine's catch-all: least preemptive, and an IRL
src/machines/machine_test.c:116: 		 *  encoding is the honest namespace for an external `irqc`.
src/machines/machine_test.c:117: 		 *  An on-chip INTEVT code would misattribute the interrupt to
src/machines/machine_test.c:118: 		 *  a peripheral a guest driver may legitimately claim.
src/machines/machine_test.c:119: 		 *
src/machines/machine_test.c:120: 		 *  Until #455 this was LOUD -- priority 0 ran exit(1), so any
src/machines/machine_test.c:121: 		 *  interrupt here ended the host.  #455 correctly made priority
src/machines/machine_test.c:122: 		 *  0 mean masked, which turned the same defect SILENT.  That is
src/machines/machine_test.c:123: 		 *  why this fix ships immediately behind it rather than later.
src/machines/machine_test.c:124: 		 */
src/machines/machine_test.c:125: 		snprintf(end_of_base_irq, sizeof(end_of_base_irq),
src/machines/machine_test.c:126: 		    ".irq[0x%x]", SH4_INTEVT_IRQ14);
src/machines/machine_test.c:127: 		break;
src/machines/machine_test.c:128: 
src/machines/machine_test.c:129: 	default:
src/machines/machine_test.c:130: 		end_of_base_irq[0] = '\0';
src/machines/machine_test.c:131: 	}
src/machines/machine_test.c:132: 
src/machines/machine_test.c:133: 	snprintf(base_irq, sizeof(base_irq), "%s.cpu[%i]%s",
src/machines/machine_test.c:134: 	    machine->path, machine->bootstrap_cpu, end_of_base_irq);
src/machines/machine_test.c:135: 
src/machines/machine_test.c:136: 	snprintf(tmpstr, sizeof(tmpstr), "irqc addr=0x%" PRIx64" irq=%s",
src/machines/machine_test.c:137: 	    (uint64_t) DEV_IRQC_ADDRESS, base_irq);
src/machines/machine_test.c:138: 	device_add(machine, tmpstr);
src/machines/machine_test.c:139: 
src/machines/machine_test.c:140: 
src/machines/machine_test.c:141: 	/*  Now, add the other devices:  */
src/machines/machine_test.c:142: 
src/machines/machine_test.c:143: 	snprintf(tmpstr, sizeof(tmpstr), "cons addr=0x%" PRIx64
src/machines/machine_test.c:144: 	    " irq=%s.irqc.2 in_use=%i",
src/machines/machine_test.c:145: 	    (uint64_t) DEV_CONS_ADDRESS, base_irq, cpu->cpu_family->arch != ARCH_SH);
src/machines/machine_test.c:146: 	machine->main_console_handle = (size_t)device_add(machine, tmpstr);
src/machines/machine_test.c:147: 
src/machines/machine_test.c:148: 	snprintf(tmpstr, sizeof(tmpstr), "mp addr=0x%" PRIx64" irq=%s%sirqc.6",
src/machines/machine_test.c:149: 	    (uint64_t) DEV_MP_ADDRESS,
src/machines/machine_test.c:150: 	    end_of_base_irq[0]? end_of_base_irq + 1 : "",
src/machines/machine_test.c:151: 	    end_of_base_irq[0]? "." : "");
src/machines/machine_test.c:152: 	device_add(machine, tmpstr);
src/machines/machine_test.c:153: 
src/machines/machine_test.c:154: 	snprintf(tmpstr, sizeof(tmpstr), "fbctrl addr=0x%" PRIx64,
src/machines/machine_test.c:155: 	    (uint64_t) DEV_FBCTRL_ADDRESS);
src/machines/machine_test.c:156: 	device_add(machine, tmpstr);
src/machines/machine_test.c:157: 
src/machines/machine_test.c:158: 	snprintf(tmpstr, sizeof(tmpstr), "disk addr=0x%" PRIx64,
src/machines/machine_test.c:159: 	    (uint64_t) DEV_DISK_ADDRESS);
src/machines/machine_test.c:160: 	device_add(machine, tmpstr);
src/machines/machine_test.c:161: 
src/machines/machine_test.c:162: 	snprintf(tmpstr, sizeof(tmpstr), "ether addr=0x%" PRIx64" irq=%s.irqc.3",
src/machines/machine_test.c:163: 	    (uint64_t) DEV_ETHER_ADDRESS, base_irq);
src/machines/machine_test.c:164: 	device_add(machine, tmpstr);
src/machines/machine_test.c:165: 
src/machines/machine_test.c:166: 	snprintf(tmpstr, sizeof(tmpstr), "rtc addr=0x%" PRIx64" irq=%s.irqc.4",
src/machines/machine_test.c:167: 	    (uint64_t) DEV_RTC_ADDRESS, base_irq);
src/machines/machine_test.c:168: 	device_add(machine, tmpstr);
src/machines/machine_test.c:169: }
src/machines/machine_test.c:170: 
src/machines/machine_test.c:171: 
src/machines/machine_test.c:172: MACHINE_SETUP(barearm)
src/machines/machine_test.c:173: {
src/machines/machine_test.c:174: 	machine->machine_name = strdup("Generic \"bare\" ARM machine");
src/machines/machine_test.c:175: 
src/machines/machine_test.c:176: #if 1
src/machines/machine_test.c:177: 	// An experiment with running a particular firmware image on a device;
src/machines/machine_test.c:178: 	// move some other place when/if it works?
src/machines/machine_test.c:179: 	cpu->byte_order = EMUL_BIG_ENDIAN;
src/machines/machine_test.c:180: 
src/machines/machine_test.c:181: 	dev_ram_init(machine, 0xa0000000, 128 * 1048576, DEV_RAM_MIRROR
src/machines/machine_test.c:182: 		| DEV_RAM_MIGHT_POINT_TO_DEVICES, 0x00000000, "ram_mirror");
src/machines/machine_test.c:183: #endif
src/machines/machine_test.c:184: }
src/machines/machine_test.c:185: 
src/machines/machine_test.c:186: 
src/machines/machine_test.c:187: MACHINE_SETUP(testarm)
src/machines/machine_test.c:188: {
src/machines/machine_test.c:189: 	machine->machine_name = strdup("ARM test machine");
src/machines/machine_test.c:190: 
src/machines/machine_test.c:191: 	default_test(machine, cpu);
src/machines/machine_test.c:192: 
src/machines/machine_test.c:193: 	/*
src/machines/machine_test.c:194: 	 *  Place a tiny stub at end of memory, and set the link register to
src/machines/machine_test.c:195: 	 *  point to it. This stub halts the machine (making it easy to try
src/machines/machine_test.c:196: 	 *  out simple stand-alone C functions).
src/machines/machine_test.c:197: 	 */
src/machines/machine_test.c:198: 	cpu->cd.arm.r[ARM_SP] = machine->physical_ram_in_mb * 1048576 - 4096;
src/machines/machine_test.c:199: 	cpu->cd.arm.r[ARM_LR] = cpu->cd.arm.r[ARM_SP] + 32;
src/machines/machine_test.c:200: 	store_32bit_word(cpu, cpu->cd.arm.r[ARM_LR] + 0, 0xe3a00201);
src/include/cpu_alpha.h:118: 
src/include/cpu_alpha.h:119: 
src/include/cpu_alpha.h:120: /*  Dyntrans definitions:  */
src/include/cpu_alpha.h:121: 
src/include/cpu_alpha.h:122: #define	ALPHA_N_IC_ARGS			3
src/include/cpu_alpha.h:123: #define	ALPHA_INSTR_ALIGNMENT_SHIFT	2
src/include/cpu_alpha.h:124: #define	ALPHA_IC_ENTRIES_SHIFT		11
src/include/cpu_alpha.h:125: #define	ALPHA_IC_ENTRIES_PER_PAGE	(1 << ALPHA_IC_ENTRIES_SHIFT)
src/include/cpu_alpha.h:126: #define	ALPHA_PC_TO_IC_ENTRY(a)		(((a)>>ALPHA_INSTR_ALIGNMENT_SHIFT) \
src/include/cpu_alpha.h:127: 					& (ALPHA_IC_ENTRIES_PER_PAGE-1))
src/include/cpu_alpha.h:128: #define	ALPHA_ADDR_TO_PAGENR(a)		((a) >> (ALPHA_IC_ENTRIES_SHIFT \
src/include/cpu_alpha.h:129: 					+ ALPHA_INSTR_ALIGNMENT_SHIFT))
src/include/cpu_alpha.h:130: 
src/include/cpu_alpha.h:131: #define	ALPHA_MAX_VPH_TLB_ENTRIES	128
src/include/cpu_alpha.h:132: 
src/include/cpu_alpha.h:133: #define	ALPHA_L2N		17
src/include/cpu_alpha.h:134: #define	ALPHA_L3N		17
src/include/cpu_alpha.h:135: 
src/include/cpu_alpha.h:136: DYNTRANS_MISC_DECLARATIONS(alpha,ALPHA,uint64_t)
src/include/cpu_alpha.h:137: DYNTRANS_MISC64_DECLARATIONS(alpha,ALPHA,uint8_t)
src/include/cpu_alpha.h:138: 
src/include/cpu_alpha.h:139: 
src/include/cpu_alpha.h:140: #define	ALPHA_PAGESHIFT		13
src/include/cpu_alpha.h:141: 
src/include/cpu_alpha.h:142: 
src/include/cpu_alpha.h:143: struct alpha_cpu {
src/include/cpu_alpha.h:144: 	struct alpha_cpu_type_def	cpu_type;
src/include/cpu_alpha.h:145: 
src/include/cpu_alpha.h:146: 
src/include/cpu_alpha.h:147: 	/*
src/include/cpu_alpha.h:148: 	 *  General Purpose Registers:
src/include/cpu_alpha.h:149: 	 */
src/include/cpu_alpha.h:150: 
src/include/cpu_alpha.h:151: 	uint64_t		r[N_ALPHA_REGS];	/*  Integer  */
src/include/cpu_alpha.h:152: 	uint64_t		f[N_ALPHA_REGS];	/*  Floating Point  */
src/include/cpu_alpha.h:153: 
