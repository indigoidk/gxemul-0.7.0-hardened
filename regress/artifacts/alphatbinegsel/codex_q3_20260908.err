regress/alpha_pfnoffset_probe.py:78:     lo, hi = val & 0xffff, (val >> 16) & 0xffff
regress/alpha_pfnoffset_probe.py:79:     if lo & 0x8000:
regress/alpha_pfnoffset_probe.py:80:         hi = (hi + 1) & 0xffff
regress/alpha_pfnoffset_probe.py:81:     return [LDAH(reg, hi if hi < 0x8000 else hi - 0x10000),
regress/alpha_pfnoffset_probe.py:82:             LDA (reg, lo if lo < 0x8000 else lo - 0x10000, reg)]
regress/alpha_pfnoffset_probe.py:83: 
regress/alpha_pfnoffset_probe.py:84: # ---------------------------------------------------------------- the map
regress/alpha_pfnoffset_probe.py:85: K0SEG      = 0xfffffc0000000000
regress/alpha_pfnoffset_probe.py:86: def k0(p): return K0SEG | p
regress/alpha_pfnoffset_probe.py:87: 
regress/alpha_pfnoffset_probe.py:88: PAGESHIFT  = 13
regress/alpha_pfnoffset_probe.py:89: PTE_VALID  = 0x1
regress/alpha_pfnoffset_probe.py:90: def pte(pfn): return (pfn << 32) | PTE_VALID
regress/alpha_pfnoffset_probe.py:91: 
regress/alpha_pfnoffset_probe.py:92: #  Off the PROM pocket (0x10000 entry stub, 0x10100 initial ctx, 0x12000 argspace, 0x14000 HWRPB)
regress/alpha_pfnoffset_probe.py:93: #  and off the sibling probes' 0x0102/0103/0104xxxx scratch.
