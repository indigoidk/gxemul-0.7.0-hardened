302:			    lines above -- "three lines up" until 2026-09-07, corrected
303:			    after a pass-2 seat derived the true distance from the hunk
304:			    header alone and called the phrasing inconsistent) and apcb_flags NEVER,
305:			    while every other field in this block is assigned exactly once.  Two
306:			    consequences: apcb_ptbr ended up holding the flags word, and the incoming
307:			    context's flags were dropped -- so the NEXT save published a never-loaded
308:			    word back into the outgoing PCB, wiping what the guest planted.  */
309:			cpu->cd.alpha.pcb.apcb_flags = new_flags;	/*  #507  */
310:			cpu->cd.alpha.pcb.apcb_decrsv0 = new_decrsv0;
311:			cpu->cd.alpha.pcb.apcb_decrsv1 = new_decrsv1;
312:
313:			// TODO: Don't invalidate EVERYTHING!
314:			cpu->invalidate_translation_caches(cpu, 0, INVALIDATE_ALL);
315:		}
316:		break;
