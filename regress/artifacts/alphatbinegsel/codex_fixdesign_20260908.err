105:VAL_B = 0xbbbb0000bbbb
106:VAL_C = 0xcccc0000cccc
107:VAL_D = 0xdddd0000dddd
108:VAL_E = 0xeeee0000eeee
109:VAL_F = 0xffff0000ffff
110:VAL_S = 0x55000055
