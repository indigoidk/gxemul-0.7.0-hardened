1:#!/usr/bin/env python3
2:"""alphatbi_probe.py -- witness for Alpha PAL_OSF1_tbi negative selector defect (alphatbinegsel)
3:
4:    usage:  alphatbi_probe.py <gxemul-binary> [label]
5:
6:WHAT THIS PINS.
7:In src/cpus/cpu_alpha_palcode.c, case 0x33 /* PAL_OSF1_tbi */:
8:    if (a0 >= 1)
9:        cpu->invalidate_translation_caches(cpu, a1, INVALIDATE_VADDR);
10:    else
11:        cpu->invalidate_translation_caches(cpu, 0, INVALIDATE_ALL);
12:
13:a0 is uint64_t.
14:ALPHA_TBIA() is defined as alpha_pal_tbi(-2, 0), passing a0 = -2 (0xfffffffffffffffe).
15:ALPHA_TBIAP() is defined as alpha_pal_tbi(-1, 0), passing a0 = -1 (0xffffffffffffffff).
16:Because a0 is unsigned uint64_t without a signed cast or upper bound check:
17:    (uint64_t)-2 >= 1 is TRUE  -> takes INVALIDATE_VADDR branch with a1 = 0
18:    (uint64_t)-1 >= 1 is TRUE  -> takes INVALIDATE_VADDR branch with a1 = 0
19:INVALIDATE_VADDR invalidates only the entry matching virtual page (a1 & vaddr_mask) == 0.
20:INVALIDATE_ALL invalidates every translation cache entry.
21:
22:Therefore, TBIA/TBIAP on HEAD flushes virtual page ZERO and NOTHING ELSE.
23:
24:FIVE TRAPS HANDLED:
25:1. Debugger all-flushes between interactions:
26:   The fill (initial load caching VPN), remap (PTE update via K0SEG store),
27:   tbi (call_pal 0x33), and observing load are ALL executed within a SINGLE 'step N'.
28:2. K0SEG is checked before ptbr:
29:   The test addresses (0x2000, 0x4000, 0x6000) are in user virtual memory and consult
30:   the 3-level page table, warming and testing the dynamic translation cache.
31:3. Page 0 is flushed by the defect:
32:   We use non-zero VPNs (0x2000 = VPN 1, 0x4000 = VPN 2, 0x6000 = VPN 3).
33:4. Zero a1 explicitly before call_pal 0x33:
34:   LDA a1, 0(zero) is executed before TBIA/TBIAP palcalls.
35:5. Remap must change observed bytes:
36:   Initial pages hold VAL_A/VAL_C/VAL_E; remapped pages hold VAL_B/VAL_D/VAL_F.
37:
38:ORACLE POLARITY:
39:Asserts the CORRECT behavior (re-walks and loads remapped data VAL_B / VAL_D).
40:Pre-fix committed build: RED (stale cached data VAL_A / VAL_C observed).
41:Post-fix build: GREEN (re-walked data VAL_B / VAL_D observed).
42:"""
43:import os, sys, pty, select, time, re
44:
45:BIN   = sys.argv[1]
46:LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
47:MACH  = "alphabook1"
48:
49:rows = []
50:def row(name, got, want, note=""):
51:    ok = (got == want)
52:    rows.append((name, ok))
53:    print("%-16s %-20s %-20s %-50s %s" % (name, str(got), str(want), note,
54:                                          "ok" if ok else "FAIL"))
55:    return ok
56:
57:# ---------------------------------------------------------------- encoder
58:ZERO, T0, T1, T2, T3, T4, T5 = 31, 1, 2, 3, 4, 5, 6
59:A0, A1 = 16, 17
60:
61:def mem(op, ra, rb, disp):
62:    assert -32768 <= disp <= 32767, "displacement %d out of range" % disp
63:    return ((op & 0x3f) << 26) | ((ra & 31) << 21) | ((rb & 31) << 16) | (disp & 0xffff)
64:
65:def LDA (ra, disp, rb=ZERO): return mem(0x08, ra, rb, disp)
66:def LDAH(ra, disp, rb=ZERO): return mem(0x09, ra, rb, disp)
67:def LDQ (ra, disp, rb):      return mem(0x29, ra, rb, disp)
68:def STQ (ra, disp, rb):      return mem(0x2d, ra, rb, disp)
69:def CALL_PAL(func):          return (0x00 << 26) | (func & 0x3ffffff)
70:
71:def load_const(reg, val):
72:    hi, lo = (val >> 16) & 0xffff, val & 0xffff
73:    if lo & 0x8000:
74:        hi = (hi + 1) & 0xffff
75:    return [LDAH(reg, hi - 0x10000 if hi & 0x8000 else hi, ZERO),
76:            LDA (reg, lo - 0x10000 if lo & 0x8000 else lo, reg)]
77:
78:# ---------------------------------------------------------------- addresses & map
79:K0SEG      = 0xfffffc0000000000
80:def k0(p): return K0SEG | p
81:
82:PAGESHIFT  = 13
83:PTE_VALID  = 0x1
84:def pte(pfn): return (pfn << 32) | PTE_VALID
85:
86:P_L1       = 0x01050000
87:P_L2       = 0x01052000
88:P_L3       = 0x01054000
89:P_DATA1    = 0x01056000  # TBIA initial page (VPN 1 = 0x2000)
90:P_DATA2    = 0x01058000  # TBIA remapped page
91:P_DATA3    = 0x0105a000  # TBIAP initial page (VPN 2 = 0x4000)
92:P_DATA4    = 0x0105c000  # TBIAP remapped page
93:P_DATA5    = 0x0105e000  # POSITIVE selector initial page (VPN 3 = 0x6000)
94:P_DATA6    = 0x01060000  # POSITIVE selector remapped page
95:P_PCB      = 0x01062000
96:P_PTRV     = 0x01064000
97:P_CODE     = 0x01066000
98:
99:L1_PFN     = P_L1 >> PAGESHIFT
100:
101:assert max(P_L1, P_L2, P_L3, P_DATA1, P_DATA2, P_DATA3, P_DATA4, P_DATA5, P_DATA6,
102:           P_PCB, P_PTRV, P_CODE) < 64 * 1024 * 1024, "addresses must fit in RAM"
103:
104:VAL_A = 0xaaaa0000aaaa
105:VAL_B = 0xbbbb0000bbbb
106:VAL_C = 0xcccc0000cccc
107:VAL_D = 0xdddd0000dddd
108:VAL_E = 0xeeee0000eeee
109:VAL_F = 0xffff0000ffff
110:VAL_S = 0x55000055
111:
112:DUMMY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "alpha_dummy.bin")
113:if not os.path.exists(DUMMY):
114:    with open(DUMMY, "wb") as f:
115:        f.write(b"\0" * 8)
116:
117:# ---------------------------------------------------------------- session
118:def session(cmds, timeout=6.0):
119:    pid, fd = pty.fork()
120:    if pid == 0:
121:        os.execv(BIN, [BIN, "-V", "-x", "-E", "alpha", "-e", MACH, "-M", "64",
122:                       "0x20000000:" + DUMMY])
123:        os._exit(127)
124:    buf = ""
125:    def wait_prompt(t=6.0):
126:        nonlocal buf
127:        last_pos = len(buf)
128:        end = time.time() + t
129:        while time.time() < end:
130:            r, _, _ = select.select([fd], [], [], 0.02)
131:            if not r:
132:                continue
133:            try:
134:                d = os.read(fd, 65536)
135:                if not d:
136:                    return False
137:                buf += d.decode("latin-1", "replace")
138:                if "gxemul>" in buf[last_pos:].lower():
139:                    return True
140:            except OSError:
141:                return False
142:        return False
143:
144:    alive = wait_prompt(timeout)
145:    for c in cmds:
146:        try:
147:            os.write(fd, (c + "\n").encode("latin-1"))
148:        except OSError:
149:            alive = False; break
150:        if not wait_prompt(timeout):
151:            alive = False; break
152:    try:
153:        os.write(fd, b"quit\n")
154:        time.sleep(0.05)
155:    except OSError:
156:        pass
157:    try:
158:        os.close(fd)
159:    except OSError:
160:        pass
161:    return buf.replace("\r", ""), alive
162:
163:def printed(t, reg):
164:    m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
165:    return "absent" if not m else "0x%x" % int(m.group(1), 16)
166:
167:# ---------------------------------------------------------------- table setup
168:setup = [
169:    # L1 and L2 tables
170:    "put d 0x%x, 0x%x" % (k0(P_L1),        pte(P_L2 >> PAGESHIFT)),
171:    "put d 0x%x, 0x%x" % (k0(P_L2),        pte(P_L3 >> PAGESHIFT)),
172:    # Initial L3 entries: L3[1] -> DATA1, L3[2] -> DATA3, L3[3] -> DATA5
173:    "put d 0x%x, 0x%x" % (k0(P_L3 + 8),    pte(P_DATA1 >> PAGESHIFT)),
174:    "put d 0x%x, 0x%x" % (k0(P_L3 + 16),   pte(P_DATA3 >> PAGESHIFT)),
175:    "put d 0x%x, 0x%x" % (k0(P_L3 + 24),   pte(P_DATA5 >> PAGESHIFT)),
176:    # Data pages
177:    "put d 0x%x, 0x%x" % (k0(P_DATA1 + 0), VAL_A),
178:    "put d 0x%x, 0x%x" % (k0(P_DATA2 + 0), VAL_B),
179:    "put d 0x%x, 0x%x" % (k0(P_DATA3 + 0), VAL_C),
180:    "put d 0x%x, 0x%x" % (k0(P_DATA4 + 0), VAL_D),
181:    "put d 0x%x, 0x%x" % (k0(P_DATA5 + 0), VAL_E),
182:    "put d 0x%x, 0x%x" % (k0(P_DATA6 + 0), VAL_F),
183:    # PCB setup (ptbr & flags)
184:    "put d 0x%x, 0x%x" % (k0(P_PCB + 16),  L1_PFN),
185:    "put d 0x%x, 0x%x" % (k0(P_PCB + 40),  L1_PFN),
186:    # Pointer vector
187:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 0),  k0(P_PCB)),
188:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 8),  k0(P_L3 + 8)),
189:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 16), pte(P_DATA2 >> PAGESHIFT)),
190:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 24), k0(P_L3 + 16)),
191:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 32), pte(P_DATA4 >> PAGESHIFT)),
192:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 40), k0(P_L3 + 24)),
193:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 48), pte(P_DATA6 >> PAGESHIFT)),
194:    "put d 0x%x, 0x%x" % (k0(P_PTRV + 56), k0(P_PTRV)),
195:]
196:
197:print("alphatbi_probe -- binary=%s label=%s machine=%s" % (BIN, LABEL, MACH))
198:print("%-16s %-20s %-20s %-50s %s" % ("row", "got", "want", "note", ""))
199:
200:# ================================================================
201:# SESSION 1: TBIA (a0 = -2, a1 = 0) on VPN 1 (0x2000)
202:# ================================================================
203:prog1 = (load_const(T0, P_PTRV) +
204:         [LDQ(T0, 56, T0),      # t0 = k0(P_PTRV)
205:          LDQ(A0, 0, T0),       # a0 = k0(P_PCB)
206:          LDQ(T1, 8, T0),       # t1 = k0(P_L3 + 8) (PTE addr)
207:          LDQ(T2, 16, T0),      # t2 = pte(P_DATA2 >> 13) (new PTE)
208:          CALL_PAL(0x30)] +     # swpctx -> installs ptbr
209:         load_const(T3, 0x2000) +
210:         [LDQ(T4, 0, T3),       # WARM TRANSLATION CACHE: loads VAL_A from 0x2000
211:          STQ(T2, 0, T1),       # REMAP: L3[1] -> P_DATA2 (holding VAL_B)
212:          LDA(A0, -2, ZERO),    # a0 = -2 (ALPHA_TBIA)
213:          LDA(A1, 0, ZERO),     # a1 = 0 (TRAP 4: explicit zero)
214:          CALL_PAL(0x33)] +     # PAL_OSF1_tbi
215:         load_const(T5, VAL_S) +
216:         [LDQ(T5, 0, T3)])      # OBSERVING LOAD: reads 0x2000
217:
218:cmds1 = setup + ["put w 0x%x, 0x%08x" % (k0(P_CODE) + 4 * i, op) for i, op in enumerate(prog1)]
219:cmds1 += ["pc=0x%x" % k0(P_CODE), "step %d" % len(prog1), "print t4", "print t5"]
220:t1txt, alive1 = session(cmds1)
221:
222:t4_1 = printed(t1txt, "t4")
223:t5_1 = printed(t1txt, "t5")
224:
225:row("live", "alive" if alive1 else "died", "alive",
226:    "CONTROL: emulator session survives sequence")
227:row("tbia fill", t4_1, "0x%x" % VAL_A,
228:    "CONTROL: initial walked load cached VAL_A")
229:row("tbia obs", t5_1, "0x%x" % VAL_B,
230:    "TBIA (a0=-2) must flush TLB and read remapped VAL_B")
231:
232:# ================================================================
233:# SESSION 2: TBIAP (a0 = -1, a1 = 0) on VPN 2 (0x4000)
234:# ================================================================
235:prog2 = (load_const(T0, P_PTRV) +
236:         [LDQ(T0, 56, T0),      # t0 = k0(P_PTRV)
237:          LDQ(A0, 0, T0),       # a0 = k0(P_PCB)
238:          LDQ(T1, 24, T0),      # t1 = k0(P_L3 + 16) (PTE addr)
239:          LDQ(T2, 32, T0),      # t2 = pte(P_DATA4 >> 13) (new PTE)
240:          CALL_PAL(0x30)] +     # swpctx -> installs ptbr
241:         load_const(T3, 0x4000) +
242:         [LDQ(T4, 0, T3),       # WARM TRANSLATION CACHE: loads VAL_C from 0x4000
243:          STQ(T2, 0, T1),       # REMAP: L3[2] -> P_DATA4 (holding VAL_D)
244:          LDA(A0, -1, ZERO),    # a0 = -1 (ALPHA_TBIAP)
245:          LDA(A1, 0, ZERO),     # a1 = 0 (TRAP 4: explicit zero)
246:          CALL_PAL(0x33)] +     # PAL_OSF1_tbi
247:         load_const(T5, VAL_S) +
248:         [LDQ(T5, 0, T3)])      # OBSERVING LOAD: reads 0x4000
249:
250:cmds2 = setup + ["put w 0x%x, 0x%08x" % (k0(P_CODE) + 4 * i, op) for i, op in enumerate(prog2)]
251:cmds2 += ["pc=0x%x" % k0(P_CODE), "step %d" % len(prog2), "print t4", "print t5"]
252:t2txt, alive2 = session(cmds2)
253:
254:t4_2 = printed(t2txt, "t4")
255:t5_2 = printed(t2txt, "t5")
256:
257:row("tbiap fill", t4_2, "0x%x" % VAL_C,
258:    "CONTROL: initial walked load cached VAL_C")
259:row("tbiap obs", t5_2, "0x%x" % VAL_D,
260:    "TBIAP (a0=-1) must flush TLB and read remapped VAL_D")
261:
262:# ================================================================
263:# SESSION 3: Positive Selector Control (a0 = 2 DTB, a1 = 0x6000)
264:# ================================================================
265:prog3 = (load_const(T0, P_PTRV) +
266:         [LDQ(T0, 56, T0),      # t0 = k0(P_PTRV)
267:          LDQ(A0, 0, T0),       # a0 = k0(P_PCB)
