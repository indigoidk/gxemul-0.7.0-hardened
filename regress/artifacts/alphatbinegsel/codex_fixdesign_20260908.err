78:# ---------------------------------------------------------------- addresses & map
79:K0SEG      = 0xfffffc0000000000
80:def k0(p): return K0SEG | p
81:
82:PAGESHIFT  = 13
83:PTE_VALID  = 0x1
84:def pte(pfn): return (pfn << 32) | PTE_VALID
85:
86:P_L1       = 0x01050000
87:P_L2       = 0x01052000
88:P_L3       = 0x01054000
89:P_DATA1    = 0x01056000  # TBIA initial page (VPN 1 = 0x2000)
90:P_DATA2    = 0x01058000  # TBIA remapped page
91:P_DATA3    = 0x0105a000  # TBIAP initial page (VPN 2 = 0x4000)
92:P_DATA4    = 0x0105c000  # TBIAP remapped page
93:P_DATA5    = 0x0105e000  # POSITIVE selector initial page (VPN 3 = 0x6000)
94:P_DATA6    = 0x01060000  # POSITIVE selector remapped page
95:P_PCB      = 0x01062000
96:P_PTRV     = 0x01064000
97:P_CODE     = 0x01066000
