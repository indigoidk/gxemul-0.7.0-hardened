1:#!/usr/bin/env python3
2:"""alphatbi_probe.py -- witness for Alpha PAL_OSF1_tbi negative selector defect (alphatbinegsel)
3:
4:    usage:  alphatbi_probe.py <gxemul-binary> [label]
5:
6:WHAT THIS PINS.
7:In src/cpus/cpu_alpha_palcode.c, case 0x33 /* PAL_OSF1_tbi */:
8:    if (a0 >= 1)
9:        cpu->invalidate_translation_caches(cpu, a1, INVALIDATE_VADDR);
10:    else
11:        cpu->invalidate_translation_caches(cpu, 0, INVALIDATE_ALL);
12:
13:a0 is uint64_t.
14:ALPHA_TBIA() is defined as alpha_pal_tbi(-2, 0), passing a0 = -2 (0xfffffffffffffffe).
15:ALPHA_TBIAP() is defined as alpha_pal_tbi(-1, 0), passing a0 = -1 (0xffffffffffffffff).
16:Because a0 is unsigned uint64_t without a signed cast or upper bound check:
17:    (uint64_t)-2 >= 1 is TRUE  -> takes INVALIDATE_VADDR branch with a1 = 0
18:    (uint64_t)-1 >= 1 is TRUE  -> takes INVALIDATE_VADDR branch with a1 = 0
19:INVALIDATE_VADDR invalidates only the entry matching virtual page (a1 & vaddr_mask) == 0.
20:INVALIDATE_ALL invalidates every translation cache entry.
21:
22:Therefore, TBIA/TBIAP on HEAD flushes virtual page ZERO and NOTHING ELSE.
23:
24:FIVE TRAPS HANDLED:
25:1. Debugger all-flushes between interactions:
26:   The fill (initial load caching VPN), remap (PTE update via K0SEG store),
27:   tbi (call_pal 0x33), and observing load are ALL executed within a SINGLE 'step N'.
28:2. K0SEG is checked before ptbr:
29:   The test addresses (0x2000, 0x4000, 0x6000) are in user virtual memory and consult
30:   the 3-level page table, warming and testing the dynamic translation cache.
31:3. Page 0 is flushed by the defect:
32:   We use non-zero VPNs (0x2000 = VPN 1, 0x4000 = VPN 2, 0x6000 = VPN 3).
33:4. Zero a1 explicitly before call_pal 0x33:
34:   LDA a1, 0(zero) is executed before TBIA/TBIAP palcalls.
35:5. Remap must change observed bytes:
36:   Initial pages hold VAL_A/VAL_C/VAL_E; remapped pages hold VAL_B/VAL_D/VAL_F.
37:
38:ORACLE POLARITY:
39:Asserts the CORRECT behavior (re-walks and loads remapped data VAL_B / VAL_D).
40:Pre-fix committed build: RED (stale cached data VAL_A / VAL_C observed).
41:Post-fix build: GREEN (re-walked data VAL_B / VAL_D observed).
42:"""
43:import os, sys, pty, select, time, re
44:
45:BIN   = sys.argv[1]
46:LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
47:MACH  = "alphabook1"
48:
49:rows = []
50:def row(name, got, want, note=""):
51:    ok = (got == want)
52:    rows.append((name, ok))
53:    print("%-16s %-20s %-20s %-50s %s" % (name, str(got), str(want), note,
54:                                          "ok" if ok else "FAIL"))
55:    return ok
56:
57:# ---------------------------------------------------------------- encoder
58:ZERO, T0, T1, T2, T3, T4, T5 = 31, 1, 2, 3, 4, 5, 6
59:A0, A1 = 16, 17
60:
61:def mem(op, ra, rb, disp):
62:    assert -32768 <= disp <= 32767, "displacement %d out of range" % disp
63:    return ((op & 0x3f) << 26) | ((ra & 31) << 21) | ((rb & 31) << 16) | (disp & 0xffff)
64:
65:def LDA (ra, disp, rb=ZERO): return mem(0x08, ra, rb, disp)
66:def LDAH(ra, disp, rb=ZERO): return mem(0x09, ra, rb, disp)
67:def LDQ (ra, disp, rb):      return mem(0x29, ra, rb, disp)
68:def STQ (ra, disp, rb):      return mem(0x2d, ra, rb, disp)
69:def CALL_PAL(func):          return (0x00 << 26) | (func & 0x3ffffff)
70:
71:def load_const(reg, val):
72:    hi, lo = (val >> 16) & 0xffff, val & 0xffff
73:    if lo & 0x8000:
74:        hi = (hi + 1) & 0xffff
75:    return [LDAH(reg, hi - 0x10000 if hi & 0x8000 else hi, ZERO),
76:            LDA (reg, lo - 0x10000 if lo & 0x8000 else lo, reg)]
