280:			uint64_t new_cpc =
281:			    load_32bit_word(cpu, cpu->cd.alpha.ctx + 24);
282:			uint64_t new_asn =
283:			    load_32bit_word(cpu, cpu->cd.alpha.ctx + 28);
284:			uint64_t new_unique =
285:			    load_64bit_word(cpu, cpu->cd.alpha.ctx + 32);
286:			uint64_t new_flags =
287:			    load_64bit_word(cpu, cpu->cd.alpha.ctx + 40);
288:			uint64_t new_decrsv0 =
289:			    load_64bit_word(cpu, cpu->cd.alpha.ctx + 48);
290:			uint64_t new_decrsv1 =
291:			    load_64bit_word(cpu, cpu->cd.alpha.ctx + 56);
292:
293:			// Update all variables in the pcb simultaneously:
294:			cpu->cd.alpha.pcb.apcb_ksp = new_ksp;
295:			cpu->cd.alpha.pcb.apcb_usp = new_usp;
296:			cpu->cd.alpha.pcb.apcb_ptbr = new_ptbr;
297:			cpu->cd.alpha.pcb.apcb_cpc = new_cpc;
298:			cpu->cd.alpha.pcb.apcb_asn = new_asn;
299:			cpu->cd.alpha.pcb.apcb_unique = new_unique;
