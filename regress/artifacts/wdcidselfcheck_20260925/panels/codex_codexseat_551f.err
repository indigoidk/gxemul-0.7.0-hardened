    reds=[l for l in proc.stdout.splitlines() if l.startswith('RED ')]
    complete='SCORER_COMPLETE' in proc.stdout and proc.returncode==0 and not proc.stderr
    print(path.name,'raw block', 'red' if reds else 'GREEN','red checks',len(reds),'scorer completed',complete)
    if not complete: print('scorer error',proc.returncode,proc.stderr)
brief=(root/'pass551f/pass551f_brief.md').read_text(encoding='utf-8')
section=brief.split('## 4. MEASURED',1)[1].split('## 5.',1)[0]
quoted=re.search(r'"'```'"\\n(.*?)\\n"'```'"',section,re.S).group(1)
measured=(root/'measured/run551f.out').read_text(encoding='utf-8').strip()
print('brief measured table equals preserved run551f.out:',quoted.strip()==measured)
for name in ('pristine','selfmut'):
    f=(root/('measured/run551f_logs/F_'+name+'.log')).read_bytes()
    e=(root/('measured/run551f_logs/E_'+name+'.log')).read_bytes()
    print('raw byte equality E/F',name,f==e,'bytes',len(f))
