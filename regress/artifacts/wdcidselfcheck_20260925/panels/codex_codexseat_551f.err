patterns=re.findall(r\"grep -c(F)? '(["'^'"']+)' \\\"\\"'$WDCLOG'"\\\"\",inc)
log=(root/'measured/run551f_logs/F_pristine.log').read_text(encoding='utf-8')
rowmap={}
for fixed,patt in patterns:
    if patt=='WDC_IDENTIFY_PASS': continue
    if not fixed and any(c in patt.replace(r'\\|','') for c in '."'^$[*'"\\\\'):
        raise ValueError(('nonliteral BRE requires review',patt))
    parts=[patt] if fixed else patt.split(r'\\|')
    matches=[(n,line) for n,line in enumerate(log.splitlines(),1) if any(part in line for part in parts)]
    assert len(matches)==1,(patt,len(matches))
    for n,line in matches: rowmap.setdefault(n,[]).append(patt)
print('Verified by literal matching of fixed and inspected basic patterns:')
print('named-label checks excluding PASS/high byte:',len(patterns)-2)
print('distinct named rows excluding high byte:',len([v for v in rowmap.values() if v"'!=['"'high byte']]))
print('distinct rows including high byte:',len(rowmap))
print('duplicate row predicates:',[(n,v) for n,v in rowmap.items() if len(v)>1])
for path in sorted((root/'measured/run551f_logs').glob('F*.log')):
    t=path.read_text(encoding='utf-8')
    cap='\\n'.join(re.findall(r'([0-9]+) failures',t))
    print(path.name,'failure-count check',cap=='0','capture',repr(cap))
brief=(root/'pass551f/pass551f_brief.md').read_text(encoding='utf-8')
measured=(root/'measured/run551f.out').read_text(encoding='utf-8')
rows=[]
for line in measured.splitlines():
    match=re.match(r'\\s+(F\\S*)\\s+((?:GREEN|red)\\(.*?\\))\\s+((?:GREEN|red)\\(.*?\\))\\s+((?:GREEN|red)\\(.*?\\))\\s+((?:GREEN|red)\\(.*?\\))\\s+(\\S+)\\s+(.*)',line)
    if match: rows.append(match.groups())
print('table shapes including baseline:',len(rows))
caught=[r for r in rows if r[5]=='caught']
print('caught shapes',len(caught),'all defect cells red:',all(all(c.startswith('red(') for c in r[2:5]) for r in caught))
print('green escapes:',[(r[0],r[5]) for r in rows if r[0]"'!='"'F' and r[1].startswith('GREEN') and any(c.startswith('GREEN') for c in r[2:5])])
print('separately preserved requested equality logs:',[(d,(root/('measured/run551f_logs/F_'+d+'.log')).exists(),(root/('measured/run551f_logs/E_'+d+'.log')).exists()) for d in ('pristine','selfmut','cyl13','srstbit')])
