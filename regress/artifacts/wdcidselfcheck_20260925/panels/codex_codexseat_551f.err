#!/usr/bin/env python3
"""#551 revision e -- the Fable 5.1 adjudication of #551d's own pass (pass551d/fable5_pass551d.md), on top of
xform551d.py:

  * the LAST self-check requires every covered call to have run before it -- chk() 24, row_cmp() 8 (the Opus 5.5 seat's
    call-count pin, measured in opus551_measured_d/callpin.out): covered rows moved past the verdict, with the identity
    row re-pinned, now fail the run instead of printing their FAILs after the PASS token (G2, overturned to ADOPT);
  * the contract rewritten as FOUR disclosed classes, the trailer named as its own class, in the adjudication's words
    (G1, G5, G6, G7) -- in the block comment and in gate 2's bullet;
  * "one pair that must NOT fail" -> "one probe per comparator" (G9); the reconciliation's comment says it keeps the
    PRINTED count honest (G8).

usage: xform551e.py <orig diff_wdc_identify.c> <out.c> [variant]
  variants: xform551d.py's, plus move_repin nopin nopin_move_repin condreset"""
import io
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xform551d as D   # noqa: E402

BS = chr(92)
NL = BS + "n"


def sub1(s, old, new):
    n = s.count(old)
    if n != 1:
        raise SystemExit("REFUSED: %d matches for %r" % (n, old[:70]))
    return s.replace(old, new)


PIN_OLD = ("\tif (!sc_bad && sc_first_bad == 0) {\n")
PIN = ("\t/*  #551e: the LAST run also requires every covered call to have run BEFORE it -- chk() 24 and row_cmp() 8,\n"
       "\t    the counts the note line below prints.  Covered rows moved past the verdict, with the identity row\n"
       "\t    re-pinned, would otherwise print their FAILs after the PASS token.  Change these with the rows, as the\n"
       "\t    identity row's 128.  */\n"
       "\tif (chk_calls != 24 || rowcmp_calls != 8) {\n"
       "\t\tprintf(\"  FAIL  SELFCHECK(last): chk() ran %d times and row_cmp() %d before this run; want 24 and 8" + NL
       + "\",\n"
       "\t\t    chk_calls, rowcmp_calls);\n"
       "\t\tif (!sc_bad)\n"
       "\t\t\tfailures = sc_f + 1;\n"
       "\t\tsc_bad++;\n"
