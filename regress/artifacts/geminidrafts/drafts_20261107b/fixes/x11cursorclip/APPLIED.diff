+		    fbwin->x11_fb_gc,
+		    xtmp, 0, 0,
+		    fbwin->cursor_x/fbwin->scaledown,
+		    fbwin->cursor_y/fbwin->scaledown,
+		    cxsize,
+		    cysize);
+
+		XDestroyImage(xtmp);
+	}
 
 	fbwin->OLD_cursor_on = fbwin->cursor_on;
 	fbwin->OLD_cursor_x = fbwin->cursor_x;
