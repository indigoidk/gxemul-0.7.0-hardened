1531| int diskimage__internal_access(struct diskimage *d, int writeflag,
1532| 	off_t offset, unsigned char *buf, size_t len)
1533| {
1534| 	ssize_t lendone;
1535| 
1536| 	/*  #206: (Codex/Fable) a legal zero-length access (e.g. SCSI WRITE(10)
1537| 	    with transfer length 0) arrives with buf==NULL; treat it as a no-op
1538| 	    before the NULL check so it can't exit() the host.  */
1539| 	if (len == 0)
1540| 		return 1;
1541| 	if (buf == NULL) {
1542| 		fprintf(stderr, "diskimage__internal_access(): buf = NULL\n");
1543| 		exit(1);
1544| 	}
1545| 	if (d->f == NULL)
1546| 		return 0;
1547| 
1548| 	/*
1549| 	 *  #416: bound every access against the disk's extent.  Before this,
1550| 	 *  the only limit on a guest LBA was a byte-count cap, so ONE
1551| 	 *  WRITE(10) past capacity grew a 10,240-byte image to 512,000,512
1552| 	 *  bytes -- and the growth persisted, because capacity is re-derived
1553| 	 *  by stat() on the next run.
1554| 	 *
1555| 	 *  THE TWO LIMITS DIFFER ON PURPOSE, and the asymmetry is the whole
1556| 	 *  design:
1557| 	 *
1558| 	 *    WRITES are bounded by d->total_size, the BACKED extent, so a
1559| 	 *    guest can never grow the host file by even one byte.
1560| 	 *
1561| 	 *    READS are bounded by the ADVERTISED capacity, which is rounded up
1562| 	 *    to whole cylinders and so exceeds the file by 480..992 blocks on
1563| 	 *    every image in this project.  Reads of that gap must keep
1564| 	 *    succeeding as zero-fill: the pmax rig's own BSD disklabel records
1565| 	 *    d_secperunit = 614880 against a 614400-block file, with partition
1566| 	 *    c extending 480 blocks past the end -- geometry the guest's own
1567| 	 *    installer wrote.  Bounding reads by total_size instead was
1568| 	 *    measured to break all five rig images.
1569| 	 *
1570| 	 *  Refusing gap WRITES costs nothing measurable: since the shipped
1571| 	 *  code had no bound at all, any write there would have grown the file
1572| 	 *  permanently at some point in each image's history, and all five
1573| 	 *  still sit at their exact original sizes (300 MiB, 300 MiB, 1 GiB,
1574| 	 *  1 GiB, 2 GiB).  Recorded honestly: this does leave READ CAPACITY
1575| 	 *  advertising blocks the disk will then refuse to write, which
1576| 	 *  disklabel(8) or fsck on a raw partition could reach.  It cannot be
1577| 	 *  fixed by advertising less, because the advertised number is already
1578| 	 *  baked into guest-written labels on disk.
1579| 	 *
1580| 	 *  Tapes are exempt: their offsets are sequential positions, not
1581| 	 *  addresses into a fixed extent (the SCSI tape read uses
1582| 	 *  d->tape_offset and is legitimately unbounded).
1583| 	 *
1584| 	 *  The comparison is written to avoid offset+len, which would overflow
1585| 	 *  before it could be tested.  The zero-fill on the read side is
1586| 	 *  LOAD-BEARING, not tidiness: dev_wdc's read path declares a 32 KB
1587| 	 *  buffer on the stack, discards this function's return value, and
1588| 	 *  copies the whole buffer to the guest, so an early return that left
1589| 	 *  buf untouched would hand the guest uninitialised host memory.
1590| 	 */
1591| 	if (!d->is_a_tape) {
1592| 		int64_t limit = writeflag ? d->total_size
1593| 		    : (int64_t) d->nr_of_logical_blocks * d->logical_block_size;
1594| 
1595| 		if (offset < 0 || (int64_t)len > limit ||
1596| 		    (int64_t)offset > limit - (int64_t)len) {
1597| 			if (!writeflag)
1598| 				memset(buf, 0, len);
1599| 			return 0;
1600| 		}
1601| 	}
1602| 
1603| 	if (writeflag) {
1604| 		if (!d->writable)
1605| 			return 0;
1606| 
1607| 		lendone = fwrite_helper(offset, buf, len, d);
1608| 	} else {
1609| 		/*
1610| 		 *  Multi-track (CUE/BIN) CD-ROM images use the parsed track
1611| 		 *  table to map logical offsets to the right bin file and
1612| 		 *  sector; all other (flat file) images use the unchanged
1613| 		 *  code paths below.
1614| 		 */
1615| 		/*
1616| 		 *  Special case for CD-ROMs. Actually, this is not needed
1617| 		 *  for .iso images, only for physical CDROMS on some OSes,
1618| 		 *  such as FreeBSD.
1619| 		 */
1620| 		if (d->nr_of_tracks > 0)
1621| 			lendone = diskimage_access__cue(d, offset, buf, len);
1622| 		else if (d->is_a_cdrom)
1623| 			lendone = diskimage_access__cdrom(d, offset, buf, len);
1624| 		else
1625| 			lendone = fread_helper(offset, buf, len, d);
1626| 
1627| 		if (lendone >= 0 && lendone < (ssize_t)len)
1628| 			memset(buf + lendone, 0, len - lendone);
1629| 	}
1630| 
1631| 	/*
1632| 	 *  Incomplete data transfer?
1633| 	 *
1634| 	 *  READS may legitimately come up short and still succeed: the
1635| 	 *  advertised capacity is rounded up to whole cylinders, so the last
1636| 	 *  480..992 blocks of every image in this project are addressable but
1637| 	 *  not backed by file.  Those reads are zero-filled above and stay
1638| 	 *  GOOD -- that is the behaviour the rig images have relied on for the
1639| 	 *  life of this fork.
1640| 	 *
1641| 	 *  WRITES may not.  A short write means bytes the guest handed us are
1642| 	 *  not on the disk, and reporting success for that is the difference
1643| 	 *  between a full store and silent data loss.  The bound above makes
1644| 	 *  this reachable only through a genuine I/O failure, since a
1645| 	 *  past-the-end write is now refused before it starts.
1646| 	 *
1647| 	 *  #416: this replaces a check that was compiled out under `#if 0`.
1648| 	 *  Its own TODO read "check against full cylinder-size instead",
1649| 	 *  which is what the bound above now does; and as written it tested
1650| 	 *  `lendone <= 0`, so it would not have caught a PARTIAL write at all
1651| 	 *  -- only a total one.  Both halves are addressed here.
1652| 	 */
1653| 	if (writeflag && lendone < (ssize_t)len) {
1654| 		debugmsg(SUBSYS_DISK, "", VERBOSITY_WARNING,
1655| 		    "disk_id %i: short write at offset %lli: %i of %i bytes",
1656| 		    d->id, (long long)offset, (int)lendone, (int)len);
1657| 		return 0;
1658| 	}
