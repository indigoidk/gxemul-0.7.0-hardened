 87|         #  This rig booted a ramdisk with no disk image, so wdc0 attached and was never
 88|         #  driven -- measured: not one ATA opcode reaches the command register across a
 89|         #  full boot to the installer prompt.  With a disk attached the same boot issues
 90|         #  14 command-register writes across SEVEN opcodes (3x 0xEC IDENTIFY, 3x 0x20
 91|         #  READ, 2x 0xC6 SETMULTI, 2x 0x91 IDP, 2x 0x10 RECAL, 1x 0xF5 SEC_FREEZE_LOCK,
 92|         #  1x 0xC4 READMULTI).
 93|         #
 94|         #  SCOPE IT HONESTLY: this gives ZERO coverage of wdc_command()'s `default:` arm,
 95|         #  which is where every filed wdc defect lives -- "Unimplemented command" warnings
 96|         #  on a disked boot measured ZERO.  Its real value is 0xF5 as [[wdcnoirq]]'s
 97|         #  witness, plus general wdc exercise.  No 0xE0, no 0x30 WRITE, no 0xC5
 98|         #  WRITEMULTI: those need a full filesystem lifecycle through `halt -p`, which
 99|         #  this rig never performs.
100|         #
101|         #  MEASURED SAFE, 4 fixed windows, same host and binary:
102|         #      no disk        prompt_reached=1  instrs=2,852,727,965
103|         #      iR: 64MB       prompt_reached=1  instrs=1,879,394,907
104|         #      no disk   (2)  prompt_reached=1  instrs=2,382,496,189
105|         #      iR: 64MB  (2)  prompt_reached=1  instrs=1,711,379,982
106|         #  Both reach the installer menu, wd0 attaches and is probed, and
107|         #  gate_crossfamily.sh's SH7751R,42 token is unaffected.
108|         #
109|         #  *** TWO TRAPS, BOTH MEASURED. ***
110|         #  (1) SYNTAX: `-d i:R:<path>` ABORTS.  diskimage_add() takes ALL prefix chars
111|         #      before a SINGLE colon (diskimage.c:1700-1755), so the form is `-d iR:`.
112|         #  (2) THE DISKED BOOT RETIRES 28-34% FEWER INSTRUCTIONS in the same wall time.
113|         #      Harmless TODAY only because "budget": 0 below -- landisk deliberately has
114|         #      no instruction ceiling.  But a NINSTRS floor is FILED, and a floor derived
115|         #      from a diskless boot and applied to a disked one is a false-FAIL waiting
116|         #      to happen.  Whoever calibrates that floor must calibrate the DISKED config.
117|         #
118|         #  The `R:` is not optional: plain `-d` opens the image read/write, so every boot
119|         #  would mutate the shared file and later runs would inherit the previous run's
120|         #  state.  R: discards guest writes into a pid-unique overlay.
121|         #
122|         #  OPTIONAL BY DESIGN.  _images/ is deliberately outside the repository, so on a
123|         #  fresh clone this file does not exist.  Absent, the rig boots exactly as it did
124|         #  before -- but it SAYS SO on stdout, because a silent revert to zero wdc
125|         #  coverage is indistinguishable from coverage that ran, which is this project's
126|         #  "silent coverage loss scored as a pass" class.
127|         "optional_disk": IMAGES + "/wdc-scratch-64m.img",
     [... lines 128-272 omitted ...]
273|     #  landiskdisk: attach the optional scratch disk if it is present, and REPORT which
274|     #  way it went.  The report is the point -- see the "optional_disk" comment above.
275|     argv = list(cfg["args"])
276|     od = cfg.get("optional_disk")
277|     if od:
278|         if os.path.exists(od):
279|             argv += ["-d", "iR:" + od]
280|             print("RIG_DISK=1 %s" % od, flush=True)
281|         else:
