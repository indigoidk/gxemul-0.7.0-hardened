 300| 	// printf("c=%i h=%i s=%i\n", d->cylinders, d->heads, d->sectors_per_track);
 301| 
 302| 	// Update size to full cylinders.
 303| 	size = d->heads * d->sectors_per_track * d->cylinders * 512;
