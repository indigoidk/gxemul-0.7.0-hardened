5606| /*
5607|  *  #407: WORD 49 MUST STAY ZERO, and this row is worth one character of mutant.
5608|  *  Setting the LOW byte of word 49 (`identify_struct[2 * 49 + 1]`, dev_wdc.c:236 at
5609|  *  085766a) to 2 gives word 0x0002 -- a reserved bit, NOT LBA (LBA is 0x0200, the
5610|  *  high byte); that mutant passed all ten original rows, and this row pins both
5611|  *  bytes so either mutant reds.  (This comment said "advertises LBA" until the
5612|  *  2026-09-05 retrospective review.)
5613|  *  It is not cosmetic: the LBA offset arms in wdc__read/wdc__write are `#if 0`
5614|  *  (:315-321, :361-367), the live offsets at :311-313/:358-360 are pure CHS, and
5615|  *  d->lba is parsed at :970 and never reaches an offset computation. A guest
5616|  *  told LBA is supported would have its LBA addresses read as C/H/S.
5617|  *
5618|  *  This asserts the CURRENT, DELIBERATE state. If LBA is ever implemented, this
5619|  *  row must be re-authored in the SAME change -- that is the point of pinning it.
5620|  */
5621| static void row_no_lba_claim(void)
5622| {
5623| 	struct wdc_data d;
5624| 
5625| 	build(&d, 1024, 1, 1, 1);
5626| 	rows ++;
5627| 	if (d.identify_struct[2 * 49 + 0] != 0 ||
5628| 	    d.identify_struct[2 * 49 + 1] != 0) {
5629| 		printf("  FAIL word 49 claims a capability: %02x %02x"
5630| 		    " (0x200 = LBA, 0x100 = DMA -- neither is implemented)\n",
5631| 		    d.identify_struct[2 * 49 + 0], d.identify_struct[2 * 49 + 1]);
5632| 		failures ++;
5633| 	} else {
5634| 		printf("  ok   %-38s word 49 = 00 00\n",
5635| 		    "no unimplemented capability claimed");
5636| 	}
5637| }
