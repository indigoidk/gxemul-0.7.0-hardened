458| def gen_disk(path):
459|     if os.path.exists(path) and os.path.getsize(path) == 4096 * 512:
460|         return
461|     with open(path, "wb") as f:
462|         for n in range(4096):
463|             words = [n & 0xffff, (~n) & 0xffff, 0x4c42, 0x4100] + [0] * 252
464|             f.write(struct.pack("<256H", *words))
465| 
466| 
467| def TAG(n):
468|     """The 32-bit signature of sector n: (word1 << 16) | word0 = (~n , n)."""
469|     return (((~n) & 0xffff) << 16) | (n & 0xffff)
470| 
     [... lines 471-481 omitted ...]
482| def build_rows(sess, H, S):
483|     """Return rows as (label, kind, got, want_head, want_fix, mode).
484| 
485|     mode: 'eq' got==want(column); 'nz' got is (H,S) and both nonzero;
486|     'neg' a forced mismatch the parser must report as FAIL (passes iff got!=want)."""
487|     hs = (TAG(H * S - 1)) if (H and S) else None   # lba 256 on the CHS (HEAD) decode
488|     wr = COMB(WR_W0, WR_W1)                         # 0x88887777, the written payload
489|     rows = []
490|     for name, _ in SESSION_ORDER:
491|         g = sess.get(name, {}).get("ram")
492|         rows.append(("ram:%s" % name, "control", g, RAM_MAGIC, RAM_MAGIC, "eq"))
493| 
494|     idf = sess.get("identify", {})
495|     rows.append(("id w49", "control", idf.get("w49"), 0x0000, 0x0000, "eq"))
496|     rows.append(("id geo", "control", (idf.get("H"), idf.get("S")),
497|                  "H,S!=0", "H,S!=0", "nz"))
498| 
499|     chs = sess.get("chs", {})
500|     rows.append(("chs s1", "control", COMB(chs.get("s1_lo"), chs.get("s1_hi")),
501|                  TAG(0), TAG(0), "eq"))
502|     rows.append(("chs s2", "control", COMB(chs.get("s2_lo"), chs.get("s2_hi")),
503|                  TAG(1), TAG(1), "eq"))
504|     rows.append(("chs h1", "control", COMB(chs.get("h1_lo"), chs.get("h1_hi")),
505|                  TAG(S) if S else None, TAG(S) if S else None, "eq"))
506| 
507|     sdh = sess.get("sdh", {})
508|     rows.append(("sdh rb", "control", sdh.get("rb"), 0xe5, 0xe5, "eq"))
509|     rows.append(("sdh rb2", "control", sdh.get("rb2"), 0xb3, 0xb3, "eq"))
510| 
511|     lba = sess.get("lba", {})
512|     rows.append(("lba 70", "symptom", COMB(lba.get("l70_lo"), lba.get("l70_hi")),
513|                  TAG(69), TAG(70), "eq"))
514|     rows.append(("lba 256", "symptom", COMB(lba.get("l256_lo"), lba.get("l256_hi")),
515|                  hs, TAG(256), "eq"))
516|     l0 = sess.get("lba0", {})
517|     rows.append(("lba 0", "symptom", COMB(l0.get("l0_lo"), l0.get("l0_hi")),
518|                  TAG(0), TAG(0), "nehead"))     # HEAD: anything but tag 0; FIX: tag 0
519| 
520|     lw = sess.get("lbawr", {})
521|     rows.append(("lba wr", "symptom", COMB(lw.get("wr_lo"), lw.get("wr_hi")),
522|                  TAG(70), wr, "eq"))
523|     rows.append(("lba wr2", "symptom", COMB(lw.get("wr2_lo"), lw.get("wr2_hi")),
524|                  wr, TAG(69), "eq"))
525| 
526|     rows.append(("neg appar", "control", 0x0001, 0x0000, 0x0000, "neg"))
527|     return rows
528| 
529| 
530| def row_ok(mode, got, want, column="HEAD"):
531|     if mode == "nz":
532|         H, S = got
533|         return bool(H) and bool(S) and H != 0 and S != 0
534|     if mode == "neg":
535|         return got != want          # the parser MUST report this mismatch as a FAIL
536|     if mode == "nehead":            # HEAD column: any served value but `want`; FIX column: exactly `want`
537|         if got is None:
538|             return False
539|         return got != want if column == "HEAD" else got == want
540|     return got == want
541| 
     [... line 542 omitted ...]
543| def run_leg(leg, binary, column, out):
544|     out("-" * 86)
545|     out("LEG %s -- %s build, judged against the %s column" % (leg, leg, column))
546|     out("-" * 86)
547|     sess = {}
548|     enc_all = hit_all = True
549|     for name, builder in SESSION_ORDER:
550|         prog_list, halt_addr, regmap = builder()
551|         got, enc_ok, hit = run_session(binary, prog_list, halt_addr,
552|                                        os.path.join(RAWDIR, "%s_%s.bin" % (leg, name)),
553|                                        regmap, "%s_%s" % (leg, name), out)
554|         sess[name] = got
555|         enc_all = enc_all and enc_ok
556|         hit_all = hit_all and hit
557|     H = sess.get("identify", {}).get("H")
558|     S = sess.get("identify", {}).get("S")
559| 
560|     out("")
561|     out("  %-10s %-4s %-12s %-12s %-12s" % ("row", "", "got", "head", "fix"))
562|     npass = nfail = 0
563|     ctrl_ok = True
564|     for label, kind, got, wh, wf, mode in build_rows(sess, H, S):
565|         want = wh if column == "HEAD" else wf
566|         ok = row_ok(mode, got, want, column)
567|         npass += ok
568|         nfail += (not ok)
569|         if kind == "control" and not ok:
570|             ctrl_ok = False
571|         if kind == "symptom":
572|             out("  %-10s %-4s %-12s head %-10s fix %-10s [%s] %s"
573|                 % (label, "", show(got),
574|                    ("!=" + show(wh)) if mode == "nehead" else show(wh), show(wf),
575|                    column, "ok" if ok else "FAIL"))
576|         else:
577|             out("  %-10s %-4s %-12s want %-12s %s"
578|                 % (label, "", show(got) if mode != "nz" else str(got),
579|                    show(want) if mode != "nz" else str(wh),
580|                    "ok" if ok else "FAIL"))
581|     out("")
582|     out("  %d/%d passed" % (npass, npass + nfail))
583|     out("  CONTROL=%s" % ("PASS" if (ctrl_ok and enc_all and hit_all) else "FAIL"))
584|     leg_pass = (nfail == 0 and ctrl_ok and enc_all and hit_all)
585|     out("  LEG %s VERDICT: %s" % (leg, "PASS" if leg_pass else "FAIL"))
586|     out("")
587|     return leg_pass
