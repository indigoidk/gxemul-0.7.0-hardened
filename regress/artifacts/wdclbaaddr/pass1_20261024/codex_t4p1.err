1115| 		/*  #464: `d->error |= WDCE_ABRT` STAYS OUTSIDE THE GUARD.
1116| 		    Inside it, the second unimplemented command silently
1117| 		    SUCCEEDS -- wdc_command() re-clears d->error per command,
1118| 		    so the guest is told the command worked.  A line-counting
1119| 		    oracle cannot see that; row `abrt 2nd` reads the status
1120| 		    register after the second command and can.
1121| 
1122| 		    ONE LINE PER DEVICE, NOT PER OPCODE.  A per-opcode set was
1123| 		    proposed and is FILED, not shipped: the scalar is what stops
1124| 		    a guest cycling 0x00..0xff for 256 lines, which is the flood
1125| 		    #464 exists to bound.  Row `unimpl 2op` pins the
1126| 		    per-device spec by firing TWO different opcodes and
1127| 		    demanding ONE line -- which also kills a
1128| 		    "last-warned-opcode" latch, under which an alternating guest
1129| 		    would flood forever.  */
1130| 		/*  #485: see the WDCC_SEC_* arm above for the invariant and the
1131| 		    warrant.  This is the other terminal arm that never raised its
1132| 		    completion interrupt.
1133| 
1134| 		    *** THE ASSERT IS OUTSIDE THE LATCH, AND THAT IS NOT A STYLE
1135| 		    CHOICE. ***  Moved inside `if (!d->warned_unimpl_cmd)` below,
1136| 		    only the FIRST unimplemented command per device would interrupt
1137| 		    and every later one would go silent again.  It is what a tidying
1138| 		    maintainer writes -- group the response with the warning -- and a
1139| 		    sweep using one fresh device per opcode CANNOT SEE IT, because
1140| 		    the latch is 0 on every leg.  Row `irq 2nd` exists for exactly
1141| 		    that mutant.
1142| 		
1143| 		    *** THAT SENTENCE NAMED A ROW `irq 2nd` THAT DOES NOT EXIST.
1144| 		    Repo-wide it occurred in this comment and nowhere else. ***  The
1145| 		    real artifact is an unnamed SUB-LEG of row_completion_irq(),
1146| 		    printing a `2nd` field inside a row named "a terminated command
1147| 		    raises its irq".  What makes the error dangerous rather than
1148| 		    untidy is the company it kept: the SAME sentence cites `abrt 2nd`,
1149| 		    which IS a real row -- so a true citation stood next to a
1150| 		    fabricated one and lent it credibility.
1151| 		
1152| 		    #464 already found the ABORT BIT wrongly inside
1153| 		    this same guard and shipped `abrt 2nd` for it; the interrupt
1154| 		    needed the same row.  */
1155| 		d->error |= WDCE_ABRT;
1156| 		d->int_assert = 1;
1157| 		if (!d->warned_unimpl_cmd) {
1158| 			d->warned_unimpl_cmd = 1;
1159| 			fatal("[ wdc: WARNING! Unimplemented command 0x%02x "
1160| 			    "(drive %i, head %i, cyl %i, sector %i, nsecs %i)"
1161| 			    " ]\n", d->cur_command, d->drive, d->head,
1162| 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
1163| 		}
1164| 	}
1165| }
