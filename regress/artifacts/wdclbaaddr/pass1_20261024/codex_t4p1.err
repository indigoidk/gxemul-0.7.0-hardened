205| def e_cmd(select, seccnt, sector, cyl_lo, cyl_hi, command):
206|     """Load the taskfile and issue a command.  The command store is LAST because it
207|     runs wdc_command() synchronously inside the guest's own store, so the ring is
208|     filled (reads) or armed (writes) before the next guest instruction executes."""
209|     e_store(select, R_SDH, t0)
210|     e_store(seccnt, R_SECCNT, t0)
211|     e_store(sector, R_SECTOR, t0)
212|     e_store(cyl_lo, R_CYL_LO, t0)
213|     e_store(cyl_hi, R_CYL_HI, t0)
214|     e_store(command, R_STATUS, t0)
215| 
