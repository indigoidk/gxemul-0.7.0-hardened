218|     """Pop two 16-bit words from the data-port FIFO: word0 then word1 of the tag."""
219|     e_lhu(rlo, R_DATA, t0)
220|     e_lhu(rhi, R_DATA, t0)
221| 
222| 
223| def e_discard(n):
224|     for _ in range(n):
225|         e_lhu(t3, R_DATA, t0)
