1704| 	    machine->machine_type == MACHINE_ARC ||
1705| 	    machine->machine_type == MACHINE_SGI ||
1706| 	    machine->machine_type == MACHINE_LUNA88K ||
1707| 	    machine->machine_type == MACHINE_MVME88K)
1708| 		return DISKIMAGE_SCSI;
1709| 
1710| 	return DISKIMAGE_IDE;
