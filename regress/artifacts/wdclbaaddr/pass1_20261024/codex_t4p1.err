610|     out("wdc       physical 0x180001f0 via bus_pci piix4_ide; KSEG1 0xffffffffb80001f0")
611|     out("disk      %s  (4096 sectors; tag n = (n, ~n))" % DISK)
612|     out("base bin  %s" % BASE_BIN)
613|     out("fix bin   %s" % ("(none -- WITNESS run)" if FIX_ARG == "-" else FIX_ARG))
614|     out("")
