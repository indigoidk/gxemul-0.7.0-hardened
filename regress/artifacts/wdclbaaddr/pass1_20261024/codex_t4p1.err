**8.8 The write drain (where `write_offset` is consumed, S7) and the init-time geometry copy (S9):**
*`src/devices/dev_wdc.c` at HEAD, lines 1824-1880, 2124-2136:*
~~~~
1824| 			/*  #478: AN EMPTY RING MUST NOT BE READ AS A FULL SECTOR.
1825| 
1826| 			    `inbuf_len == 0` satisfies `0 % 512 == 0`, so this block fired
1827| 			    with NOTHING queued and handed diskimage_access 512 bytes of
1828| 			    whatever the ring held, at the guest's chosen LBA.  MEASURED:
1829| 			    `1 write(s), 512 bytes to 0x8000, first=0xdd` -- the poison, so
1830| 			    the bytes written were ones the guest never supplied.
1831| 
1832| 			    BOTH conditions are load-bearing and each closes a door the
1833| 			    other leaves open -- measured, not argued:
1834| 
1835| 			      `inbuf_len > 0`   closes the empty ring, and the WRITE+PKT
1836| 			                        door where a CDB dispatch has already
1837| 			                        consumed the LOCAL inbuf_len to a stale 0
1838| 			                        while pushing fresh DATA-IN into the ring.
1839| 			      `!badlen_this`    closes the LEFTOVER door: an unread payload
1840| 			                        leaves occupancy at 512, so `512 > 0` passes
1841| 			                        and the guest's own returned data is written
1842| 			                        to the image.  MEASURED first=0xbe.
1843| 
1844| 			    The drain is guarded rather than the `default:` arm because the
1845| 			    WRITE+PKT door involves no bad-len access at all.  */
1846| 			if (inbuf_len > 0 && !badlen_this &&
1847| 			    (( d->write_in_progress == WDCC_WRITEMULTI &&
1848| 			    inbuf_len % (512 * d->write_count) == 0)
1849| 			    ||
1850| 			    ( d->write_in_progress == WDCC_WRITE &&
1851| 			    inbuf_len % 512 == 0)) ) {
1852| 				int count = (d->write_in_progress ==
1853| 				    WDCC_WRITEMULTI)? d->write_count : 1;
1854| 				unsigned char *buf, *b;
1855| 
1856| 				CHECK_ALLOCATION(buf = (unsigned char *) malloc(512 * count));
1857| 				b = buf;
1858| 
1859| 				if (d->inbuf_tail+512*count <= WDC_INBUF_SIZE) {
1860| 					b = d->inbuf + d->inbuf_tail;
1861| 					d->inbuf_tail = (d->inbuf_tail + 512
1862| 					    * count) % WDC_INBUF_SIZE;
1863| 				} else {
1864| 					for (i=0; i<512 * count; i++)
1865| 						buf[i] = wdc_get_inbuf(d);
1866| 				}
1867| 
1868| 				diskimage_access(cpu->machine,
1869| 				    d->drive + d->base_drive, DISKIMAGE_IDE, 1,
1870| 				    d->write_offset, b, 512 * count);
1871| 
1872| 				d->write_count -= count;
1873| 				d->write_offset += 512 * count;
1874| 
1875| 				d->int_assert = 1;
1876| 
1877| 				if (d->write_count == 0)
1878| 					d->write_in_progress = 0;
1879| 
1880| 				free(buf);
