**8.5 `status_byte()` -- the status bits a probe polls (DRQ while the ring holds data or a write is armed; no BSY ever):**
*`src/devices/dev_wdc.c` at HEAD, lines 578-600:*
~~~~
578| /*
579|  *  status_byte():
580|  *
581|  *  Return a reasonable status byte corresponding to the controller's current
582|  *  state.
583|  */
584| static int status_byte(struct wdc_data *d, struct cpu *cpu)
585| {
586| 	int odata = 0;
587| 	if (diskimage_exist(cpu->machine, d->drive + d->base_drive,
588| 	    DISKIMAGE_IDE))
589| 		odata |= WDCS_DRDY | WDCS_DSC;
590| 	if (d->inbuf_head != d->inbuf_tail)
591| 		odata |= WDCS_DRQ;
592| 	if (d->write_in_progress)
593| 		odata |= WDCS_DRQ;
594| 	if (d->error)
595| 		odata |= WDCS_ERR;
596| 	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
597| 		odata |= WDCS_DRQ;
598| 	}
599| 	return odata;
600| }
~~~~

**8.6 `DEVICE_ACCESS(wdc)` -- the register-value prologue, the SDH arm WITH its neighbours, and the common tail (S1-S3, R11):**
*`src/devices/dev_wdc.c` at HEAD, lines 1168-1194, 1933-2070:*
~~~~
1168| DEVICE_ACCESS(wdc)
1169| {
1170| 	struct wdc_data *d = (struct wdc_data *) extra;
1171| 	uint64_t idata = 0, odata = 0;
1172| 	int i;
1173| 
1174| 	relative_addr /= d->addr_mult;
1175| 
1176| 	if (!d->io_enabled)
1177| 		goto ret;
1178| 
1179| 	if (writeflag == MEM_WRITE) {
1180| 		if (relative_addr == wd_data)
1181| 			idata = memory_readmax64(cpu, data, len);
1182| 		else {
1183| 			/*  #464: latch the announcement; `idata = data[0]`
1184| 			    is the repair and stays outside the guard.  */
1185| 			if (len != 1 && !d->warned_nonbyte_write) {
