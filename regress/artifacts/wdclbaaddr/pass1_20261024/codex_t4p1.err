**8.2 `wdc_initialize_identify_struct()` -- the IDENTIFY words (S9, S10):**
*`src/devices/dev_wdc.c` at HEAD, lines 311-453:*
~~~~
311| /*
312|  *  wdc_initialize_identify_struct():
313|  */
314| static void wdc_initialize_identify_struct(struct cpu *cpu, struct wdc_data *d)
315| {
316| 	uint64_t total_size;
317| 	int flags, cdrom = 0;
318| 	char namebuf[40];
319| 
320| 	total_size = diskimage_getsize(cpu->machine, d->drive + d->base_drive,
321| 	    DISKIMAGE_IDE);
322| 	if (diskimage_is_a_cdrom(cpu->machine, d->drive + d->base_drive,
323| 	    DISKIMAGE_IDE))
324| 		cdrom = 1;
325| 
326| 	memset(d->identify_struct, 0, sizeof(d->identify_struct));
327| 
328| 	/*  Offsets are in 16-bit WORDS!  High byte, then low.  */
329| 
330| 	/*  0: general flags  */
331| 	flags = 1 << 6;	/*  Fixed  */
332| 	if (cdrom)
333| 		flags = 0x8580;		/*  ATAPI, CDROM, removable  */
334| 	d->identify_struct[2 * 0 + 0] = flags >> 8;
335| 	d->identify_struct[2 * 0 + 1] = flags;
336| 
337| 	/*  1: nr of cylinders  */
338| 	d->identify_struct[2 * 1 + 0] = d->cyls[d->drive] >> 8;
339| 	d->identify_struct[2 * 1 + 1] = d->cyls[d->drive];
340| 
341| 	/*  3: nr of heads  */
342| 	d->identify_struct[2 * 3 + 0] = d->heads[d->drive] >> 8;
343| 	d->identify_struct[2 * 3 + 1] = d->heads[d->drive];
344| 
345| 	/*  6: sectors per track  */
346| 	d->identify_struct[2 * 6 + 0] = d->sectors_per_track[d->drive] >> 8;
347| 	d->identify_struct[2 * 6 + 1] = d->sectors_per_track[d->drive];
348| 
349| 	/*  10-19: Serial number  */
350| 	memcpy(&d->identify_struct[2 * 10], "#0                  ", 20);
351| 
352| 	/*  23-26: Firmware version  */
353| 	memcpy(&d->identify_struct[2 * 23], "1.0     ", 8);
354| 
355| 	/*  27-46: Model number  */
356| 	if (diskimage_getname(cpu->machine, d->drive + d->base_drive,
357| 	    DISKIMAGE_IDE, namebuf, sizeof(namebuf))) {
358| 		size_t i;
359| 		for (i=0; i<sizeof(namebuf); i++)
360| 			if (namebuf[i] == 0) {
361| 				for (; i<sizeof(namebuf); i++)
362| 					namebuf[i] = ' ';
363| 				break;
364| 			}
365| 		memcpy(&d->identify_struct[2 * 27], namebuf, 40);
366| 	} else
367| 		memcpy(&d->identify_struct[2 * 27],
368| 		    "Fake GXemul IDE disk                    ", 40);
369| 
370| 	/*  47: max sectors per multitransfer  */
371| 	d->identify_struct[2 * 47 + 0] = 0x80;
372| 	d->identify_struct[2 * 47 + 1] = 128;
373| 
374| 	/*  49: capabilities:  */
375| 	/*  (0x200 = LBA, 0x100 = DMA support.)  */
376| 	d->identify_struct[2 * 49 + 0] = 0;
377| 	d->identify_struct[2 * 49 + 1] = 0;
378| 
379| 	/*  51: PIO timing mode.  */
380| 	d->identify_struct[2 * 51 + 0] = 0x00;	/*  ?  */
381| 	d->identify_struct[2 * 51 + 1] = 0x00;
382| 
383| 	/*  53: 0x02 = fields 64-70 valid, 0x01 = fields 54-58 valid  */
384| 	d->identify_struct[2 * 53 + 0] = 0x00;
385| 	d->identify_struct[2 * 53 + 1] = 0x02;
386| 
387| 	/*
388| 	 *  #405: `% 255` where `& 255` is meant, on six of these eight lines.
389| 	 *
390| 	 *  The two that were already right are the ones whose operand is small:
391| 	 *  `(sectors) & 255` cannot exceed a byte anyway. Every other line shifts
392| 	 *  first and does NOT pre-mask, so its operand is a multi-byte quantity and
393| 	 *  `% 255` is not byte extraction that occasionally coincides -- it is a
394| 	 *  base-256 digit sum. Measured in closed form, 0 counterexamples over 2^26:
395| 	 *      x % 255 == ((x >> 8) + (x & 255)) % 255
396| 	 *
397| 	 *  So this is not a rare corner. Above the threshold it is wrong 100.0000%
398| 	 *  of the time; the 0.39% of sizes where the >>8 byte is accidentally right
399| 	 *  are exactly the ones where >>16 is wrong. The announced capacity lands
400| 	 *  either side of the truth, worst case reporting ZERO SECTORS.
401| 	 *
402| 	 *  Smallest size at which any byte diverges is 65,280 sectors -- but
403| 	 *  diskimage_recalc_size()'s closing whole-cylinder round-up (the shared
404| 	 *  bytespercyl block, hoisted there by #414) rounds every image up to
405| 	 *  whole cylinders, so that exact count is unreachable. The smallest
406| 	 *  REACHABLE divergence is 33,546,240 bytes (65 cylinders), where a 32 MB
407| 	 *  disk announces itself as 120 KB.
408| 	 *
409| 	 *  The byte order is NOT a second defect and was deliberately left alone.
410| 	 *  The convention is stated at the top of this function ("Offsets are in
411| 	 *  16-bit WORDS!  High byte, then low"), the geometry words follow it, the
412| 	 *  transmit loop in wdc_command()'s WDCC_IDENTIFY case pushes [i+1] before
413| 	 *  [i+0], and dev_wdc_access()'s wd_data read reassembles (high << 8) | low.
414| 	 *  Two panel seats called it a defect from the snippet alone; two that read
415| 	 *  the file found it consistent, and a later pass CONFIRMED it by executing
416| 	 *  the whole guest path: both the LE and BE branches, plus memory_writemax64,
417| 	 *  land the SAME two bytes in guest memory, so the device layer is
418| 	 *  byte-stream-preserving. The 57-vs-58 WORD order is not establishable from
419| 	 *  this tree at all -- there is no ATA specification here -- so a mask-only
420| 	 *  correction is exactly as much as the source can justify.
421| 	 *
422| 	 *  #408: THE CITATIONS ABOVE NAME CONSTRUCTS, NOT LINE NUMBERS, AND THAT IS
423| 	 *  DELIBERATE.  #405 cited lines that its own inserted comment had shifted by
424| 	 *  +31.  #407 wrote a correction saying "re-read every line reference AFTER
425| 	 *  the edit is in place" -- and then made the identical error, because that
426| 	 *  correction was itself +9 lines and every number it "fixed" was re-read from
427| 	 *  the pre-edit file.  Two rounds, same mechanism, and the second one had the
428| 	 *  lesson written down in front of it.  A line number inside a file the same
429| 	 *  commit edits is measured against the file it was written in, not the one
430| 	 *  that ships; naming the construct survives every future edit instead.
431| 	 */
432| 	/*  57-58: current capacity in sectors  */
433| 	d->identify_struct[2 * 58 + 0] = ((total_size / 512) >> 24) & 255;
434| 	d->identify_struct[2 * 58 + 1] = ((total_size / 512) >> 16) & 255;
435| 	d->identify_struct[2 * 57 + 0] = ((total_size / 512) >> 8) & 255;
436| 	d->identify_struct[2 * 57 + 1] = (total_size / 512) & 255;
437| 
438| 	/*  60-61: total nr of addressable sectors  */
439| 	d->identify_struct[2 * 61 + 0] = ((total_size / 512) >> 24) & 255;
440| 	d->identify_struct[2 * 61 + 1] = ((total_size / 512) >> 16) & 255;
441| 	d->identify_struct[2 * 60 + 0] = ((total_size / 512) >> 8) & 255;
442| 	d->identify_struct[2 * 60 + 1] = (total_size / 512) & 255;
443| 
444| 	/*  64: Advanced PIO mode support. 0x02 = mode4, 0x01 = mode3  */
445| 	d->identify_struct[2 * 64 + 0] = 0x00;
446| 	d->identify_struct[2 * 64 + 1] = 0x03;
447| 
448| 	/*  67, 68: PIO timing  */
449| 	d->identify_struct[2 * 67 + 0] = 0;
450| 	d->identify_struct[2 * 67 + 1] = 120;
451| 	d->identify_struct[2 * 68 + 0] = 0;
452| 	d->identify_struct[2 * 68 + 1] = 120;
453| }
~~~~

