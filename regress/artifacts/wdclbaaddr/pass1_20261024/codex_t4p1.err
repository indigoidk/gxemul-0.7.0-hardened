325| class Emu(object):
326|     def __init__(self, argv, boot_wait=5.0):
327|         self.buf = bytearray()
328|         self.pid, self.fd = pty.fork()
329|         if self.pid == 0:
330|             try:
331|                 os.execvp(argv[0], argv)
332|             finally:
333|                 os._exit(127)
334|         self.drain(boot_wait)
335| 
336|     def drain(self, seconds):
337|         end_t = time.time() + seconds
338|         while time.time() < end_t:
339|             r, _, _ = select.select([self.fd], [], [], 0.05)
340|             if self.fd in r:
341|                 try:
342|                     d = os.read(self.fd, 65536)
343|                 except OSError:
344|                     return
345|                 if not d:
346|                     return
347|                 self.buf.extend(d)
348| 
349|     def send(self, cmd, wait=0.4):
350|         start = len(self.buf)
351|         data = (cmd + "\n").encode()
352|         view = memoryview(data)
353|         while len(view):
354|             n = os.write(self.fd, view)
355|             view = view[n:]
356|             if len(view):
357|                 self.drain(0.05)
358|         self.drain(wait)
359|         return bytes(self.buf[start:]).decode("latin1", "replace")
360| 
361|     def close(self, log):
362|         try:
363|             os.write(self.fd, b"quit\n")
364|             self.drain(0.4)
365|         except OSError:
366|             pass
367|         for fn in (lambda: os.close(self.fd),
368|                    lambda: os.kill(self.pid, 9),
369|                    lambda: os.waitpid(self.pid, 0)):
370|             try:
371|                 fn()
372|             except OSError:
373|                 pass
374|         with open(log, "w") as f:
375|             f.write(bytes(self.buf).decode("latin1", "replace"))
376| 
377| 
378| def reg(emu, name):
379|     for _ in range(5):
380|         out = emu.send("print %s" % name, wait=0.35)
381|         m = re.findall(r"0x[0-9a-fA-F]+", out)
382|         if m:
383|             return int(m[-1], 16)
384|         emu.drain(0.25)
385|     return None
