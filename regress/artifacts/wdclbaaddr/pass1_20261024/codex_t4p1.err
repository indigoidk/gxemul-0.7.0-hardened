 275| 	/*
 276| 	 *  #414: cylinders are derived from the size for EVERY disk -- both
 277| 	 *  arms, with or without a -d gH;S override.  Both assignments to
 278| 	 *  d->cylinders used to sit inside "if (!d->chs_override)", and a
 279| 	 *  census of the file showed those were the only two, so an override
 280| 	 *  removed every write to the field that existed and left the zeroed
 281| 	 *  0 in place.  The shared block below is what makes the override
 282| 	 *  usable; it also removes a duplicated copy of the arithmetic.
 283| 	 *
 284| 	 *  bytespercyl is guarded ITSELF rather than only its factors: the
 285| 	 *  factors are clamped above, but guarding the divisor is what stops
 286| 	 *  a SIGFPE if a future non-parser caller sets heads or spt to 0.
 287| 	 *  Guard and clamp do different jobs -- the guard prevents a crash,
 288| 	 *  the clamp is what makes the answer right.
 289| 	 */
 290| 	{
 291| 		int64_t bytespercyl = (int64_t) d->heads
 292| 		    * d->sectors_per_track * 512;
 293| 		if (bytespercyl < 1)
 294| 			bytespercyl = 1;
 295| 		d->cylinders = size / bytespercyl;
 296| 		if (d->cylinders * bytespercyl < size)
 297| 			d->cylinders ++;
 298| 	}
