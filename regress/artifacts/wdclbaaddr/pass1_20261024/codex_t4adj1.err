458: def gen_disk(path):
459:     if os.path.exists(path) and os.path.getsize(path) == 4096 * 512:
460:         return
461:     with open(path, "wb") as f:
462:         for n in range(4096):
463:             words = [n & 0xffff, (~n) & 0xffff, 0x4c42, 0x4100] + [0] * 252
464:             f.write(struct.pack("<256H", *words))
