#!/bin/bash
# mk_cen.sh -- build commit A (#564's stranded gate-6 census) from HEAD's blobs.  gate_hygiene.sh is the working tree's
# version with EXPECT_PTY_PROBES 75 and EXPECT_CONVERTED 25 (#564's half; #567's 76/26 waits for commit B), PROVED by
# the deriver with #567's probe moved out of the tree.  The WT's gate_hygiene.sh and fbctrl_cmd_probe.py are backed up
# by md5 and restored -- and the restore verified -- before anything else runs.  Pretests H, O, I, L, R and section C.
set -e
F=/c/Users/User00/AppData/Local/Temp/claude/C--DocumentNoSnc-cc-GXEMUL/8e474f41-4d47-4c99-bf11-3406a84c4fcd/scratchpad/cen
R=/c/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC
w() { cygpath -w "$1"; }
cd "$R"
H=$(git rev-parse --short=8 HEAD)
echo "HEAD $H: $(git log -1 --format=%s | cut -c1-90)"
[ "$H" = "6c2840d7" ] || { echo "REFUSE: HEAD moved from 6c2840d7"; exit 2; }
for f in OUTSTANDING_BUGS.md CHANGELOG.md; do git diff --quiet HEAD -- "$f" || { echo "REFUSE: $f is dirty"; exit 2; }; done
# --- 1. commit A's gate_hygiene.sh, and the proof
sed -e 's/^EXPECT_PTY_PROBES=76$/EXPECT_PTY_PROBES=75/' -e 's/^EXPECT_CONVERTED=26$/EXPECT_CONVERTED=25/' \
    regress/gate_hygiene.sh > "$F/gate_hygiene_commit.sh"
grep -qx 'EXPECT_PTY_PROBES=75' "$F/gate_hygiene_commit.sh" && grep -qx 'EXPECT_CONVERTED=25' "$F/gate_hygiene_commit.sh" \
    || { echo "REFUSE: the pins did not move to 75/25"; exit 2; }
git show HEAD:regress/gate_hygiene.sh > "$F/gate_hygiene_head.sh"
echo "commit A vs HEAD: $(diff "$F/gate_hygiene_head.sh" "$F/gate_hygiene_commit.sh" | grep -c '^[<>]') changed lines; CONVERTED changed: $(diff "$F/gate_hygiene_head.sh" "$F/gate_hygiene_commit.sh" | grep -c 'EXPECT_CONVERTED')"
GH_MD5=$(md5sum < regress/gate_hygiene.sh | cut -c1-32); PR_MD5=$(md5sum < regress/fbctrl_cmd_probe.py | cut -c1-32)
cp regress/gate_hygiene.sh "$F/gate_hygiene_wt.bak"; cp regress/fbctrl_cmd_probe.py "$F/fbctrl_cmd_probe_wt.bak"
echo "WT backed up: gate_hygiene.sh $GH_MD5, fbctrl_cmd_probe.py $PR_MD5 -- if this run dies, restore both from $F/*_wt.bak"
cp "$F/gate_hygiene_commit.sh" regress/gate_hygiene.sh; rm regress/fbctrl_cmd_probe.py
set +e
bash tools/derive_hygiene_pins.sh > "$F/DERIVE_commitA.out" 2>&1
set -e
cp "$F/gate_hygiene_wt.bak" regress/gate_hygiene.sh; cp "$F/fbctrl_cmd_probe_wt.bak" regress/fbctrl_cmd_probe.py
[ "$(md5sum < regress/gate_hygiene.sh | cut -c1-32)" = "$GH_MD5" ] && [ "$(md5sum < regress/fbctrl_cmd_probe.py | cut -c1-32)" = "$PR_MD5" ] \
    && echo "WT restored, md5-verified" || { echo "RESTORE FAILED -- see the .bak files"; exit 3; }
sed -n '/^census/,/^EXPECT_WHOLE_FULL/p' "$F/DERIVE_commitA.out" | awk 'NR>1 {n++; if ($(NF-1)!=$NF) {bad++; print "  MISMATCH:", $0}} END {printf "commit A census: %d compared, %d mismatched\n", n, bad+0}'
grep -A3 '^UNTRACKED' "$F/DERIVE_commitA.out" | sed 's/^/  /'
grep -q 'NEW PROMPTLESS' "$F/DERIVE_commitA.out" && { echo "REFUSE: a promptless probe stands ungrandfathered"; exit 2; }
# --- 2. ledger, changelog, bug file, generated pages
git show HEAD:tools/pipeline/ledger.json > "$F/ledger_head.json"
git show HEAD:tools/pipeline/fable_queue.md > "$F/fq_commit.md"
python - "$(w $F)" "$(w $R)" <<'PYEOF'
import io, json, os, subprocess, sys
F, R = sys.argv[1], sys.argv[2]
NL = chr(10)
def rd(p): return io.open(p, encoding="utf-8", newline="").read()
dump = lambda o: json.dumps(o, indent=1, ensure_ascii=False).replace(NL, "\r" + NL)
head = rd(os.path.join(F, "ledger_head.json")); L = json.loads(head); assert dump(L) == head
wt = json.loads(rd(os.path.join(R, "tools", "pipeline", "ledger.json")))
have = {r["id"] for r in L["rows"]}
for rid in ("ptyprobepins", "sgimtereadiness", "batterystandby"):
    assert rid not in have, rid
    row = [r for r in wt["rows"] if r["id"] == rid]
    assert len(row) == 1, rid
    L["rows"].append(row[0])
io.open(os.path.join(F, "ledger_commit.json"), "w", encoding="utf-8", newline="").write(dump(L))
ob = subprocess.run(["git", "-C", R, "show", "HEAD:OUTSTANDING_BUGS.md"], capture_output=True).stdout.decode("utf-8")
cl = subprocess.run(["git", "-C", R, "show", "HEAD:CHANGELOG.md"], capture_output=True).stdout.decode("utf-8")
assert ob.endswith(NL)
io.open(os.path.join(F, "ob_commit.md"), "w", encoding="utf-8", newline="").write(ob + NL + rd(os.path.join(F, "ob_cen_section.md")).rstrip(NL) + NL)
io.open(os.path.join(F, "changelog_commit.md"), "w", encoding="utf-8", newline="").write(rd(os.path.join(F, "changelog_cen.md")).rstrip(NL) + NL + NL + cl)
print("ledger (+3 rows), bug file and changelog written")
PYEOF
TD=$(mktemp -d -p "$F" gen.XXXX)
for f in gen_dashboard.py stage_tokens.py gen_codex_wall.py; do git show HEAD:tools/pipeline/$f > "$TD/$f"; done
GXLEDGER="$(w $F/ledger_commit.json)" python "$(w $TD/gen_dashboard.py)" --out "$(w $F/matrix_commit.html)" | tail -1
GXLEDGER="$(w $F/ledger_commit.json)" GXQUEUE="$(w $F/fq_commit.md)" python "$(w $TD/gen_codex_wall.py)"
rm -rf "$TD"
python - "$(w $F)" "$H" <<'PYEOF'
import io, json, os, sys
c, h = sys.argv[1], sys.argv[2]
P = lambda n: {"from": "file", "path": os.path.join(c, n)}
spec = {"repo": "C:/DocumentNoSnc/cc/GXEMUL/GXEMUL-SEC", "expect_head": h, "message": os.path.join(c, "commit_msg.txt"),
        "files": {"tools/pipeline/ledger.json": P("ledger_commit.json"), "tools/pipeline/matrix.html": P("matrix_commit.html"),
                  "tools/pipeline/fable_queue.md": P("fq_commit.md"), "CHANGELOG.md": P("changelog_commit.md"),
                  "OUTSTANDING_BUGS.md": P("ob_commit.md"), "regress/gate_hygiene.sh": P("gate_hygiene_commit.sh")},
        "neutral": ["tools/pipeline/check_probe_wiring.py"],
        "add_dirs": [],
        "wt_after": {"tools/pipeline/matrix.html": "orig", "tools/pipeline/fable_queue.md": "staged",
                     "tools/pipeline/ledger.json": "merge", "CHANGELOG.md": "staged", "OUTSTANDING_BUGS.md": "staged",
                     "regress/gate_hygiene.sh": "orig"}}
json.dump(spec, io.open(os.path.join(c, "commit_spec.json"), "w", encoding="utf-8"), indent=1)
print("spec written, expect_head", h)
PYEOF
echo "--- pretests on the unit"
GXLEDGER="$(w $F/ledger_commit.json)" python tools/pipeline/check_stage_panels.py 2>&1 | tail -1
TB=$(mktemp -d -p "$F" bp.XXXX); cp tools/pipeline/check_boilerplate.py "$TB/"; cp "$F/ledger_commit.json" "$TB/ledger.json"
python "$(w $TB/check_boilerplate.py)" 2>&1 | grep -E "BOILERPLATE_|SHARED" | head -6; rm -rf "$TB"
