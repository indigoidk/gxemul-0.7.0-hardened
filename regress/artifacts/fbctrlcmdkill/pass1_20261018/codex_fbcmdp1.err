114: *  dev_fb_resize():
115: *
116: *  Resize a framebuffer window. (This functionality is probably a bit buggy,
117: *  because I didn't think of including it from the start.)
118: *
119: *  SUPER-IMPORTANT: Anyone who resizes a framebuffer by calling this function
120: *  must also clear all dyntrans address translations manually, in all cpus
121: *  which might have access to the framebuffer!
122: */
123:void dev_fb_resize(struct vfb_data *d, int new_xsize, int new_ysize)
124:{
125:	unsigned char *new_framebuffer;
126:	int y, new_bytes_per_line;
127:	size_t size, sz_bytes_per_line;
128:
129:	if (d == NULL) {
130:		fatal("dev_fb_resize(): d == NULL\n");
131:		return;
132:	}
133:
134:	if (new_xsize < 10 || new_ysize < 10) {
135:		/*  #184: (Codex/Fable) guest-reachable (e.g. SGI GBE HCMAP/VCMAP
136:		    written with a tiny/zero dimension); reject and keep the old
137:		    framebuffer intact instead of exit(1), matching the >16384
138:		    branch below.  */
139:		fatal("dev_fb_resize(): size too small (%i x %i); ignored.\n",
140:		    new_xsize, new_ysize);
141:		return;
142:	}
143:
144:	/*  #156: (Codex/Fable) compute the new size in size_t with overflow
145:	    checks, and cap the guest-controlled dimensions; on failure
146:	    return early, leaving the old framebuffer intact.  */
147:	if (new_xsize > 16384 || new_ysize > 16384) {
148:		fatal("dev_fb_resize(): size too large (%i x %i).\n",
149:		    new_xsize, new_ysize);
150:		return;
151:	}
152:
153:	if (d->bit_depth < 1 ||
154:	    (size_t) new_xsize > SIZE_MAX / (size_t) d->bit_depth) {
155:		fatal("dev_fb_resize(): bytes_per_line overflow.\n");
156:		return;
157:	}
158:
159:	sz_bytes_per_line = (size_t) new_xsize * (size_t) d->bit_depth / 8;
160:
161:	if (sz_bytes_per_line < 1 ||
162:	    (size_t) new_ysize > SIZE_MAX / sz_bytes_per_line) {
163:		fatal("dev_fb_resize(): framebuffer size overflow.\n");
164:		return;
165:	}
166:
167:	new_bytes_per_line = (int) sz_bytes_per_line;
168:	size = (size_t) new_ysize * sz_bytes_per_line;
169:
170:	CHECK_ALLOCATION(new_framebuffer = (unsigned char *) malloc(size));
171:
172:	/*  Copy the old framebuffer to the new:  */
173:	if (d->framebuffer != NULL) {
174:		for (y=0; y<new_ysize; y++) {
175:			size_t fromofs = d->bytes_per_line * y;
176:			size_t toofs = new_bytes_per_line * y;
177:			size_t len_to_copy = d->bytes_per_line <
178:			    new_bytes_per_line? d->bytes_per_line	
179:			    : new_bytes_per_line;
180:			memset(new_framebuffer + toofs, 0, new_bytes_per_line);
181:			if (y < d->x11_ysize)
182:				memmove(new_framebuffer + toofs,
183:				    d->framebuffer + fromofs, len_to_copy);
184:		}
185:
186:		free(d->framebuffer);
187:	}
188:
189:	d->framebuffer = new_framebuffer;
190:	d->framebuffer_size = size;
191:
192:	if (new_xsize > d->xsize || new_ysize > d->ysize) {
193:		d->update_x1 = d->update_y1 = 0;
194:		d->update_x2 = new_xsize - 1;
195:		d->update_y2 = new_ysize - 1;
196:	}
197:
198:	d->bytes_per_line = new_bytes_per_line;
199:	d->xsize = d->visible_xsize = new_xsize;
200:	d->ysize = d->visible_ysize = new_ysize;
201:
202:	d->x11_xsize = d->xsize / d->vfb_scaledown;
203:	d->x11_ysize = d->ysize / d->vfb_scaledown;
204:
205:	memory_device_update_data(d->memory, d, d->framebuffer);
206:
207:	/*  #182: (Codex/Fable) also resize the device's mapped length so the
208:	    dyntrans fast-map gate cannot install a host mapping past the new
209:	    (possibly smaller) framebuffer allocation on a guest-driven shrink.
210:	    The #157 invalidation below then drops any stale fast-path pointers
211:	    so the next access re-derives against the new length.  */
212:	memory_device_update_length(d->memory, d, size);
213:
214:	/*  #157: (Codex/Fable) the framebuffer memory was just freed and
215:	    reallocated, so invalidate all CPUs' translation caches (same
216:	    idiom as dev_fbctrl), otherwise dyntrans fast-path host pointers
217:	    would still point into the freed old framebuffer.  */
218:	if (d->machine != NULL) {
219:		int i;
220:		for (i = 0; i < d->machine->ncpus; i++)
221:			d->machine->cpus[i]->invalidate_translation_caches(
222:			    d->machine->cpus[i], 0, INVALIDATE_ALL);
223:	}
224:
225:	set_title(d);
226:
227:#ifdef WITH_X11
228:	if (d->fb_window != NULL) {
229:		x11_fb_resize(d->fb_window, d->x11_xsize, d->x11_ysize);
230:		if (d->fb_window->name != NULL)
231:			free(d->fb_window->name);
232:		d->fb_window->name = strdup(d->title);
233:		x11_set_standard_properties(d->fb_window);
234:	}
235:#endif
236:}
