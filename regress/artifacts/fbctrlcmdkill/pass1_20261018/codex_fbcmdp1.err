1:#!/usr/bin/env python3
2:"""fbctrlcmdkill WITNESS (rung 3, test-first) -- dev_fbctrl.c's fbctrl_command() ends the emulator process on any command
3:other than NOP (0), SET_RESOLUTION (1) and GET_RESOLUTION (2), reached by ONE guest DATA write while the COMMAND port (0)
4:is selected, on an UNMODIFIED `-E testmips` (machine_test.c installs `fbctrl addr=0x12f00000`).  t0 = kseg1 of
5:DEV_FBCTRL_ADDRESS; PORT is +0x00, DATA +0x10.  The harness is regress/fbctrl_port_probe.py's (#549), copied, not
6:imported: that file runs its rows at import.
7:
8:SESSIONS, each on a fresh emulator, every word stepped and compared with the emulator's own step line:
9:  C   controls: PORT=5, DATA=0x2a, read DATA back (LIVENESS: 0x2a); PORT=1, DATA=123, PORT=0, DATA=2 (GET_RESOLUTION:
10:      with no X11 it zeroes X1 and Y1), PORT=1, read DATA (DEVICE-SIGNATURE: 0, where RAM would keep 123).
11:  K3  PORT=0, DATA=3 (DEV_FBCTRL_COMMAND_FILL, documented in testmachine/dev_fb.h, TODO in the source), then PORT=5.
12:  K4  the same with 4 (COPY).          K5  with 5 (undocumented).
13:  KM  with sw 0xffffffff (the int command -1).
14:  KW  with sd 0x100000003 -- d->port[] is int, so the command the switch reads is 3: the width path into the kill.
15:Rows: `live', `devsig', and per K session `cmd N' = SURVIVED/DIED and `cmd N exit' = the child's exit status.
16:Pre-fix the K rows are expected to read DIED with exit 1; a fix makes them SURVIVED.
17:Output: rows, then FBCMDW_CONTROL=OK|FAILED, FBCMDW_RESULT=n/t, FBCMDW_DONE.
18:usage: fbctrl_cmd_witness.py <gxemul-binary>"""
19:import os, pty, re, select, signal, sys, time
20:
21:BIN = sys.argv[1]
22:STUBADDR = 0xffffffff80100000
23:CODE = 0xffffffff80100020
24:FBCTRL = 0xffffffffb2f00000
25:REG = dict(zr=0, t0=8, t1=9, t2=10, t3=11, t4=12, t5=13, t6=14, t7=15, s0=16, s1=17, s2=18, s3=19)
26:OPS = dict(sw=0x2b, sd=0x3f, lw=0x23)
27:
28:
29:def ins(op, rt, off, base="t0"):
30:    return (OPS[op] << 26) | (REG[base] << 21) | (REG[rt] << 16) | (off & 0xffff)
31:
32:
33:def text(op, rt, off, base="t0"):
34:    return "%s %s,%d(%s)" % (op, rt, off, base)
35:
36:
37:ANCHOR = (0x0f << 26) | (REG["t7"] << 16)
38:assert ins("sw", "t1", 0) == 0xad090000            # pinned independently of the helper
39:assert ins("lw", "t2", 0x10) == 0x8d0a0010
40:assert ins("sd", "t5", 0) == 0xfd0d0000
41:assert ANCHOR == 0x3c0f0000
42:
43:
44:def stub_path():
45:    p = "/tmp/gx_fbcmdw_%d.bin" % os.getpid()
46:    with open(p, "wb") as f:
47:        f.write(b"\x00\x00\x00\x00")
48:    return p
49:
50:
51:def session(label, prog, regs, reads, stub):
52:    pid, fd = pty.fork()
53:    if pid == 0:
54:        os.execvp(BIN, [BIN, "-V", "-E", "testmips", "-M", "64", "0x%x:%s" % (STUBADDR, stub)])
55:        os._exit(127)
56:    buf = ""
57:    dead = [False]
58:
59:    def rd(t=0.4):
60:        nonlocal buf
61:        r, _, _ = select.select([fd], [], [], t)
62:        if fd not in r:
63:            return True
64:        try:
65:            d = os.read(fd, 65536)
66:        except OSError:
67:            dead[0] = True
68:            return False
69:        if not d:
70:            dead[0] = True
71:            return False
72:        buf += d.decode("latin1", "replace")
73:        return True
74:
75:    def wait(mark=0, echo=None, timeout=60):
76:        t = time.time()
77:        while time.time() - t < timeout:
78:            if not rd():
79:                return False
80:            resp = buf[mark:]
81:            if echo is not None and echo not in resp:
82:                continue
83:            if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
84:                return True
85:        return False
86:
87:    def send(x, timeout=60):
88:        b = (x + "\n").encode("latin1")
89:        mark = len(buf)
90:        n = 0
91:        try:
92:            while n < len(b):
93:                n += os.write(fd, b[n:])
94:        except OSError:
95:            dead[0] = True
96:            return False
97:        return wait(mark=mark, echo=x if x else None, timeout=timeout)
98:
99:    words = [ins(op, rt, off) for op, rt, off in prog] + [ANCHOR]
100:    status, badis, vals, steps = "?", [], {}, 0
101:    if not wait(timeout=120):
102:        status = "NO-PROMPT"
103:    else:
104:        for i, w in enumerate(words):
105:            send("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
106:        for name, val in regs:
107:            send("%s=0x%x" % (name, val & 0xffffffffffffffff))
108:        send("pc=0x%x" % CODE)
109:        status = "SURVIVED"
110:        for i, (op, rt, off) in enumerate(prog):
111:            mark = len(buf)
112:            if not send("step 1", timeout=30) or dead[0]:
113:                status = "DIED"
114:                break
115:            steps += 1
116:            seg = buf[mark:]
117:            m = re.search(r"%016x:?\s+%08x\s+([^\r\n<]+)" % (CODE + 4 * i, words[i]), seg)
118:            got = re.sub(r"\s+", " ", m.group(1)).strip() if m else "(no step line)"
119:            if not got.startswith(text(op, rt, off)):
120:                badis.append("+0x%02x planted 0x%08x -> %r, expected %r" % (4 * i, words[i], got, text(op, rt, off)))
121:        if status == "SURVIVED":
122:            for name in reads:
123:                got = None
124:                for _ in range(2):
125:                    mark = len(buf)
126:                    if not send("print %s" % name, timeout=30) or dead[0]:
127:                        break
128:                    m = re.search(r"(?m)^0x([0-9a-fA-F]+)\s*$", buf[mark:])
129:                    if m:
130:                        got = int(m.group(1), 16)
131:                        break
132:                vals[name] = got
133:    try:
134:        os.write(fd, b"quit\n")
135:    except OSError:
136:        pass
137:    t1 = time.time()
138:    while time.time() - t1 < 20.0:
139:        if not rd(0.1):
140:            break
141:    try:
142:        os.close(fd)
143:    except OSError:
144:        pass
145:    rpid, st = 0, None
146:    t1 = time.time()
147:    while rpid == 0 and time.time() - t1 < 10.0:
148:        try:
149:            rpid, st = os.waitpid(pid, os.WNOHANG)
150:        except OSError:
151:            break
152:        if rpid == 0:
153:            time.sleep(0.05)
154:    if rpid == 0:
155:        try:
156:            os.kill(pid, signal.SIGKILL)
157:            _, st = os.waitpid(pid, 0)
158:        except OSError:
159:            st = None
160:    code = os.WEXITSTATUS(st) if st is not None and os.WIFEXITED(st) else None
161:    unimpl = len(re.findall(r"fbctrl_command: Unimplemented command", buf))
162:    print("  session %-3s %-9s steps=%d/%d exit=%s unimpl_msgs=%d" % (label, status, steps, len(prog), code, unimpl))
163:    for b in badis:
164:        print("      DISASSEMBLY MISMATCH: %s" % b)
165:    return {"status": status, "exit": code, "badis": badis, "vals": vals, "buf": buf}
166:
167:
168:RESULTS = []
169:
170:
171:def row(name, got, want, note=""):
172:    ok = got == want
173:    RESULTS.append(ok)
174:    print("  %-14s got=%-12s want=%-12s %s  %s" % (name, got, want, "ok" if ok else "FAIL", note))
175:    return ok
