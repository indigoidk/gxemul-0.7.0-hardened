REFUSED = [("3", "sw", 3), ("4", "sw", 4), ("sb3", "sb", 3), ("sh4", "sh", 4), ("5", "sw", 5), ("m1w", "sw", 0xffffffff), ("w3", "sd", 0x100000003),
           ("w0", "sd", 0x100000000), ("w1", "sd", 0x100000001), ("w2", "sd", 0x100000002),
           ("m1d", "sd", 0xffffffffffffffff)]
for name, op, v in REFUSED:
