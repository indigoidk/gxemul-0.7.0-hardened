91: 			d->port[DEV_FBCTRL_PORT_X1] = d->vfb_data->xsize;
92: 			d->port[DEV_FBCTRL_PORT_Y1] = d->vfb_data->ysize;
93: 		} else {
94: 			// When not using X11 output, return 0x0 size.
95: 			d->port[DEV_FBCTRL_PORT_X1] = 0;
96: 			d->port[DEV_FBCTRL_PORT_Y1] = 0;
97: 		}
98: 		break;
99: 
100: 	/*  TODO: Block copy and fill.  */
101: 
102: 	/*  #567: unreachable while the DATA arm refuses every command
103: 	    other than these three; kept as a tripwire for a later edit
