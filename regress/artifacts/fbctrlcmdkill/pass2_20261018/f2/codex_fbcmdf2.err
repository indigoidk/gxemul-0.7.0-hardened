75: 		 */
76: 		x1 = d->port[DEV_FBCTRL_PORT_X1];
77: 		y1 = d->port[DEV_FBCTRL_PORT_Y1];
78: 		debug("[ dev_fbctrl: changing resolution to %i,%i ]\n", x1, y1);
