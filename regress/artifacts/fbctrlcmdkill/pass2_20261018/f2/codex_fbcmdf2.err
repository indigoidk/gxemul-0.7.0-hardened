+			if (!d->warned_cmd) {
+				fatal("[ fbctrl: command 0x%llx is not supported; "
+				    "the command port is unchanged (once) ]\n",
+				    (unsigned long long) idata);
+				d->warned_cmd = 1;
+			}
+		} else {
 			d->port[d->current_port] = idata;
 			if (d->current_port == DEV_FBCTRL_PORT_COMMAND)
 				fbctrl_command(cpu, d);
