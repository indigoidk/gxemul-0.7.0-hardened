4187: 				/*  ppc_exception() leaves MSR[ME] set,
4188: 				    where the architecture clears it on a
4189: 				    machine check, so a further failing
4190: 				    fetch here takes a second machine check
4191: 				    instead of checkstopping (#QQQ).  */
4192: 				ppc_exception(cpu, PPC_EXCEPTION_MC);
4193: 				return;
4194: 			}
4195: 			/*  Clears only this CPU's running and parks
4196: 			    next_ic on nothing_call, which ends the
4197: 			    current batch.  memory.c's -T halt clears
4198: 			    every CPU's running; a checkstop is a
4199: 			    per-processor state.  pmppc has one CPU,
4200: 			    so what the other CPUs of a multiprocessor
4201: 			    do after this checkstop is not measured
4202: 			    (#PPP).  */
4203: 			fatal("[ ppc: instruction fetch from 0x%" PRIx64
4204: 			    " declined with MSR[ME]=0: checkstop ]\n",
4205: 			    (uint64_t) addr);
4206: 			cpu->running = 0;
4207: 			cpu->cd.ppc.next_ic = &nothing_call;
4208: 			return;
4209: 		}
4210: 	}
