 496: regs, T, how = session("T ra me", ["srr0=0x%x" % SENT, "msr=0x%x" % MSR_ME, "pc=0x%x" % RA_LAST, "continue"], flags=["-T"])
 497: row("T ra me session", how, "exit0", "-T read-ahead with MSR[ME] set: survives")
 498: row("T ra me pc", hexr(regs, "pc"), hex(RA_NEXT), "parked at the word past the window")
