 504: row("T ra me srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented with ME set")
 505: row("T ra me unimpl", unimpl(T), "absent", "the real fetch is not sent to bad: (W3, V10)")
 506: # `T ra` entered at the UNALIGNED pc 0xfec00005 (repair 6; Mythos pass-5 breach 2, p5_20261105/TRAODD_NOTE.md): the prologue
 507: # keeps pc's low two bits, so the read-ahead fetch reaches the failure block with pc != addr.  The fix's arm (a) returns and the
 508: # real fetch halts again: two reports, the park at 0xfec00009.  A guard conjoined with an alignment test sends the read-ahead
 509: # failure on to arm (c), which parks it at read-ahead time: one report.  No breakpoint, so read-ahead runs.
 510: RA_ODD = 0xfec00005
 511: regs, T, how = session("T ra odd", ["srr0=0x%x" % SENT, "pc=0x%x" % RA_ODD, "continue"], flags=["-T"])
 512: row("T ra odd session", how, "exit0", "-T read-ahead from an unaligned pc: survives")
