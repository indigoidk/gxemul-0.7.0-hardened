4085: {
4086: 	uint64_t addr, low_pc, tmp_addr;
4087: 	uint32_t iword, mask;
4088: 	unsigned char *page;
4089: 	unsigned char ib[4];
4090: 	int main_opcode, rt, rs, ra, rb, rc, aa_bit, l_bit, lk_bit, spr, sh,
4091: 	    xo, imm, load, size, update, zero, bf, bo, bi, bh, oe_bit, n64=0,
4092: 	    bfa, fp, byterev, nb, mb, me;
4093: 	void (*samepage_function)(struct cpu *, struct ppc_instr_call *);
4094: 	void (*rc_f)(struct cpu *, struct ppc_instr_call *);
4095: 
4096: 	/*  Figure out the (virtual) address of the instruction:  */
4097: 	low_pc = ((size_t)ic - (size_t)cpu->cd.ppc.cur_ic_page)
4098: 	    / sizeof(struct ppc_instr_call);
4099: 	addr = cpu->pc & ~((PPC_IC_ENTRIES_PER_PAGE-1)
4100: 	    << PPC_INSTR_ALIGNMENT_SHIFT);
4101: 	addr += (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);
4102: 	cpu->pc = addr;
4103: 	addr &= ~((1 << PPC_INSTR_ALIGNMENT_SHIFT) - 1);
4104: 
4105: 	/*  Read the instruction word from memory:  */
4106: #ifdef MODE32
4107: 	page = cpu->cd.ppc.host_load[((uint32_t)addr) >> 12];
4108: #else
4109: 	{
4110: 		const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
4111: 		const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
4112: 		const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
4113: 		uint32_t x1 = (addr >> (64-DYNTRANS_L1N)) & mask1;
4114: 		uint32_t x2 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
4115: 		uint32_t x3 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N-
4116: 		    DYNTRANS_L3N)) & mask3;
