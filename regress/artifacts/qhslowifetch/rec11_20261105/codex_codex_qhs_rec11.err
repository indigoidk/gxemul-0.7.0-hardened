4118: 		struct DYNTRANS_L3_64_TABLE *l3 = l2->l3[x2];
4119: 		page = l3->host_load[x3];
4120: 	}
4121: #endif
4122: 
4123: 	if (page != NULL) {
4124: 		/*  fatal("TRANSLATION HIT!\n");  */
