 291: WORK = sys.argv[3] if len(sys.argv) > 3 else None
 292: if WORK:
 293:     os.makedirs(WORK, exist_ok=True)
 294: _TMPDIR = tempfile.mkdtemp(prefix="ppc_ifetch_")
 295: NOP = os.path.join(_TMPDIR, "nop.bin")
 296: open(NOP, "wb").write(bytes([0x60, 0x00, 0x00, 0x00]))      # ori r0,r0,0 (big-endian)
 297: 
 298: ENTRY = 0x2000
 299: SENT = 0x11111111            # the SRR0 sentinel; only an exception entry overwrites it in these runs
 300: ISI_PC = 0x20000000          # a reset-BAT gap on the PPC750: no IBAT covers it, SDR1 = 0, so translation misses
 301: MSR_IR = 0x20
 302: MSR_ME = 0x1000              # PPC_MSR_ME, cpu_ppc.h: arm (d)'s test
 303: NOMEM = 0x02040000           # past 32 MB of RAM and the 256 KB SILENT slack above it (core/memory.c:605), so `-T` fails the read
 304: FATAL = "read failed: TODO"  # the translator's text at the exit
 305: AGAIN_NONEX = 2             # ROW 3: frozen from the first run on the fixed build.  A -T halt leaves running at 0, so a second step
 306:                              # or continue runs nothing (D3 and D4: the same count without the park; FINDING_D8.md's correction)
 307: 
 308: rows = []
 309: controls = []
 310: symptom_hits = 0
 311: 
 312: 
 313: def row(name, got, want, note="", control=False):
 314:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
 315:     assert len(name) <= 16, name
 316:     ok = (got == want)
 317:     rows.append((name, ok))
 318:     if control:
 319:         controls.append((name, ok))
 320:     print("%-18s %-20s %-20s %-46s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
 321:     return ok
 322: 
 323: 
 324: def session(name, cmds, flags=(), machine="pmppc", timeout=60):
 325:     """One cold debugger run: `cmds` then `reg` and `quit`.  Returns (regs, text, how)."""
 326:     global symptom_hits
 327:     allc = list(cmds) + ["reg", "quit"]
 328:     argv = [BIN, "-V", "-x", "-E", machine] + list(flags) + ["0x%x:%s" % (ENTRY, NOP)]
 329:     inp = ("\n".join(allc) + "\n").encode("latin-1")
 330:     try:
 331:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
 332:         t = p.stdout.decode("latin-1", "replace").replace("\r", "")
 333:         rc = p.returncode
 334:         how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
 335:     except subprocess.TimeoutExpired as e:
 336:         t = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
 337:         how = "TIMEOUT"

