 519: row("T ra odd srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented on this route (R7b_a_srr0un)")
 520: row("T ra odd unimpl", unimpl(T), "absent", "the real fetch is not sent to bad: (W3, R8_c_clun_bad)")
