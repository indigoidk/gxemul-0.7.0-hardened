4126: 	} else {
4127: 		/*  fatal("TRANSLATION MISS!\n");  */
4128: 		if (!cpu->memory_rw(cpu, cpu->mem, addr, ib,
4129: 		    sizeof(ib), MEM_READ, CACHE_INSTRUCTION)) {
4130: 			/*  #NNN: the instruction fetch failed.  This
4131: 			    used to be fatal() + exit(1).  Four states
4132: 			    reach here; none may run this slot, and
4133: 			    the slot stays TO_BE_TRANSLATED, so a fetch
4134: 			    that later reaches it re-enters this arm.
4135: 			    (A -T halt is terminal whichever exit is
4136: 			    taken: memory.c cleared running, so the run
4137: 			    loop no longer enters this CPU and a further
4138: 			    step or continue runs nothing.  (c)'s park
4139: 			    only ends the current batch and keeps pc
4140: 			    here.)  */
4141: 			/*  (a) Read-ahead: the guest has not reached
4142: 			    this address.  Touch nothing, as bad:
4143: 			    does.  */
4144: 			if (cpu->translation_readahead)
4145: 				return;
4146: 			/*  (b) The translation in memory_rw raised an
4147: 			    ISI or 603 IMISS: ppc_exception() saved
4148: 			    SRR0/SRR1 and moved pc to the vector.
4149: 			    That route is reached on no measured
4150: 			    session (the dispatch pc lookup translates
4151: 			    this address first); kept so a delivered
4152: 			    exception is not doubled by (d).  Not
4153: 			    watertight: when the vector equals the
4154: 			    failing address, pc equals addr again, (b)
4155: 			    is skipped and (d) delivers a second
4156: 			    exception over SRR0/SRR1, or checkstops if
4157: 			    MSR[ME] is clear (#MMM; no producer on any
4158: 			    machine measured).  pc is compared ALIGNED:
4159: 			    the prologue aligns addr but not pc, and a
4160: 			    guest can make pc unaligned (mtlr and bclr
4161: 			    copy LR unmasked), so a bare pc != addr
4162: 			    took this arm for such a pc, re-ran the
4163: 			    slot and, under -T, printed thousands of
4164: 			    halt reports instead of parking in (c).
4165: 			    next_ic must follow pc; ppc_exception()
4166: 			    re-resolves it, and (d) relies on that.
4167: 			    The refresh here is redundant and harmless.  */
