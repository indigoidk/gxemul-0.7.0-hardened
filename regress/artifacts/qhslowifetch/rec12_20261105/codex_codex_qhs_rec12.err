  275: 64/249, /bin/false 65/249 -- each CONTROL=FAIL (r7_20261105/table12/SCORES.txt).
  276: 
  277: Sentinel: PPC_IFETCH_PROBE_DONE (plus PPC_IFETCH_RESULT=n/N, PPC_IFETCH_CONTROL=OK|FAIL, PPC_IFETCH_SYMPTOM=PRESENT|ABSENT,
  278: PPC_IFETCH_RED=none|<names>).  Session transcripts go to the optional [workdir].
  279: """
  280: 
  281: import os
  282: import re
  283: import subprocess
  284: import sys
  285: import tempfile
  286: import time
  287: 
  288: if len(sys.argv) < 2:
  289:     sys.stderr.write("usage: ppc_ifetch_probe.py <gxemul> [label] [workdir]\n")
  290:     sys.exit(2)
  291: 
  292: BIN = sys.argv[1]
  293: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
  294: WORK = sys.argv[3] if len(sys.argv) > 3 else None
  295: if WORK:
  296:     os.makedirs(WORK, exist_ok=True)
  297: _TMPDIR = tempfile.mkdtemp(prefix="ppc_ifetch_")
  298: NOP = os.path.join(_TMPDIR, "nop.bin")
  299: open(NOP, "wb").write(bytes([0x60, 0x00, 0x00, 0x00]))      # ori r0,r0,0 (big-endian)
  300: 
  301: ENTRY = 0x2000
  302: SENT = 0x11111111            # the SRR0 sentinel; only an exception entry overwrites it in these runs
  303: ISI_PC = 0x20000000          # a reset-BAT gap on the PPC750: no IBAT covers it, SDR1 = 0, so translation misses
  304: MSR_IR = 0x20
  305: MSR_ME = 0x1000              # PPC_MSR_ME, cpu_ppc.h: arm (d)'s test
  306: NOMEM = 0x02040000           # past 32 MB of RAM and the 256 KB SILENT slack above it (core/memory.c:605), so `-T` fails the read
  307: FATAL = "read failed: TODO"  # the translator's text at the exit
  308: AGAIN_NONEX = 2             # ROW 3: frozen from the first run on the fixed build.  A -T halt leaves running at 0, so a second step
  309:                              # or continue runs nothing (D3 and D4: the same count without the park; FINDING_D8.md's correction)
  310: 
  311: rows = []
  312: controls = []
  313: symptom_hits = 0
  314: 
  315: 
  316: def row(name, got, want, note="", control=False):
  317:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
  318:     assert len(name) <= 16, name
  319:     ok = (got == want)
  320:     rows.append((name, ok))
  321:     if control:
  322:         controls.append((name, ok))
  323:     print("%-18s %-20s %-20s %-46s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
  324:     return ok
  325: 
  326: 
  327: def session(name, cmds, flags=(), machine="pmppc", timeout=60):
  328:     """One cold debugger run: `cmds` then `reg` and `quit`.  Returns (regs, text, how)."""
  329:     global symptom_hits
  330:     allc = list(cmds) + ["reg", "quit"]
  331:     argv = [BIN, "-V", "-x", "-E", machine] + list(flags) + ["0x%x:%s" % (ENTRY, NOP)]
  332:     inp = ("\n".join(allc) + "\n").encode("latin-1")
  333:     try:
  334:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
  335:         t = p.stdout.decode("latin-1", "replace").replace("\r", "")
  336:         rc = p.returncode
  337:         how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
  338:     except subprocess.TimeoutExpired as e:
  339:         t = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
  340:         how = "TIMEOUT"
  341:     except OSError as e:            # an ABSENT binary is a null medium: every session row fails, the sentinel still prints
  342:         t = ""
  343:         how = "NOBIN(%s)" % e.__class__.__name__
  344:     if WORK:
  345:         open(os.path.join(WORK, name.replace(" ", "_") + ".txt"), "w", encoding="latin-1").write(
  346:             "$ " + " ".join(argv) + "\n--- stdin ---\n" + "\n".join(allc) + "\n--- transcript (%s) ---\n" % how + t)
  347:     if FATAL in t:
  348:         symptom_hits += 1
  349:     regs = {}
  350:     idx = t.rfind("GXemul> reg")
  351:     if idx >= 0:
  352:         seg = t[idx:]
  353:         for key in ("pc", "srr0", "srr1", "msr", "lr"):
  354:             m = re.search(r"\b%s\s*=\s*(0x[0-9a-fA-F]+)" % key, seg)
  355:             if m:
  356:                 regs[key] = int(m.group(1), 16)
  357:     return regs, t, how
  358: 
  359: 
  360: def hexr(regs, k):
  361:     return hex(regs[k]) if k in regs else "none"
  362: 
  363: 
  364: def text(t):
  365:     return "present" if FATAL in t else "absent"
  366: 
  367: 
  368: def prompt(t):
  369:     return "yes" if ("GXemul> reg" in t and "cpu0: pc" in t) else "no"
  370: 
  371: 
  372: def nonex(t):
  373:     """How many `-T` halt reports the run printed (memory_rw's "non-existant" line)."""
  374:     return str(t.count("non-existant"))
  375: 
  376: 
  377: def halts(t):
  378:     """The distinct addresses the -T halt reports name, sorted ("none" when there is no report)."""
  379:     return ",".join(sorted(set(re.findall(r"non-existant paddr=(0x[0-9a-fA-F]+)", t)))) or "none"
  380: 
  381: 
  382: def stopped(t):
  383:     """Whether the run printed the emulator's stop line (every CPU's running cleared)."""
  384:     return "yes" if "All machines stopped" in t else "no"
  385: 
  386: 
  387: def unimpl(t):
  388:     return "present" if "UNIMPLEMENTED" in t else "absent"
  389: 
  390: 
  391: def exc(t):
  392:     return "present" if "[ PPC Exception" in t else "absent"
  393: 
  394: 
  395: def chk(t):
  396:     """The (d) arm's checkstop text.  MSR[ME] is clear on T step, T cont and again (msr = 0; T me sets it), so on those an arm (c)
  397:     that is deleted or inverted falls to the checkstop fallback -- same pc, SRR0 and park -- and this text is the one channel that
  398:     differs."""
  399:     return "present" if "checkstop" in t else "absent"
  400: 
  401: 
  402: print("qhslowifetch DETECTOR -- binary=%s label=%s" % (BIN, LABEL))
  403: print("machine: -E pmppc (UNMODIFIED in-tree; Artesyn PM/PPC, PPC750, 32 MB); `ori r0,r0,0` loaded raw at 0x%x" % ENTRY)
  404: print("%-18s %-20s %-20s %-46s %s" % ("row", "got", "want", "note", ""))
  405: t0 = time.time()
  406: 
  407: # ============================================================ CONTROL SESSIONS ==
  408: regs, T, how = session("ctl", ["srr0=0x%x" % SENT, "step 1"])
  409: row("ctl session", how, "exit0", "the control session's exit status", control=True)
  410: row("ctl live", hexr(regs, "pc"), hex(ENTRY + 4), "the loaded word executed (one step)", control=True)
  411: row("ctl srr0 kept", hexr(regs, "srr0"), hex(SENT), "a good fetch delivers no exception", control=True)
  412: nregs, _, nhow = session("neg", ["step 1"], machine="nosuchmachine", timeout=30)
  413: row("neg apparatus", "%s/%s" % (nhow, hexr(nregs, "pc")), "exit1/none", "a bogus machine runs no guest", control=True)
  414: regs, T, how = session("isi", ["srr0=0x%x" % SENT, "msr=0x%x" % MSR_IR, "pc=0x%x" % ISI_PC, "continue"])
  415: row("isi session", how, "exit0", "IR on, fetch in a BAT gap: survives", control=True)
  416: row("isi srr0", hexr(regs, "srr0"), hex(ISI_PC), "the ISI was delivered (SRR0 = fault PC)", control=True)
  417: row("isi pc", hexr(regs, "pc"), hex(0x400), "resumed at the ISI vector (zero word stops)", control=True)
  418: row("isi text", text(T), "absent", "the translator's exit is not on this route", control=True)
  419: row("isi nonex", nonex(T), "0", "premise: no -T report on the ISI route (W6)", control=True)
  420: regs, T, how = session("isi1", ["srr0=0x%x" % SENT, "msr=0x%x" % MSR_IR, "pc=0x%x" % ISI_PC, "step 1"])
  421: row("isi1 session", how, "exit0", "IR on, one step into the BAT gap: survives", control=True)
  422: row("isi1 srr0", hexr(regs, "srr0"), hex(ISI_PC), "premise: the lookup delivers the ISI (W6)", control=True)
  423: row("isi1 pc", hexr(regs, "pc"), hex(0x400), "premise: the step lands on the ISI vector", control=True)
  424: row("isi1 nonex", nonex(T), "0", "premise: no -T report on the ISI step", control=True)
  425: regs, T, how = session("noT", ["srr0=0x%x" % SENT, "pc=0x%x" % NOMEM, "continue"])
  426: row("noT session", how, "exit0", "no -T: the read past RAM zero-fills", control=True)
  427: row("noT pc", hexr(regs, "pc"), hex(NOMEM), "the CPU stopped on the zero word", control=True)
  428: row("noT srr0 kept", hexr(regs, "srr0"), hex(SENT), "no exception on that route", control=True)
  429: row("noT unimpl", unimpl(T), "present", "the zero word is reported unimplemented (the read succeeded)")
  430: row("noT chkstop", chk(T), "absent", "a successful read never enters the failure arm")
  431: 
  432: # ========================================================= THE WITNESS ROWS (-T) ==
  433: regs, T, how = session("T cont", ["srr0=0x%x" % SENT, "pc=0x%x" % NOMEM, "continue"], flags=["-T"])
  434: row("T cont session", how, "exit0", "-T fetch past RAM, continue: survives")
  435: row("T cont text", text(T), "absent", "no `read failed: TODO` exit")
  436: row("T cont prompt", prompt(T), "yes", "the debugger ran `reg` afterwards")
  437: row("T cont pc", hexr(regs, "pc"), hex(NOMEM), "parked at the fetch address (W2, W5)")
  438: row("T cont srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented on the -T route (W4)")
  439: row("T cont nonex", nonex(T), "1", "exactly one halt report: the loop stopped (W2)")
  440: row("T cont unimpl", unimpl(T), "absent", "the halt is not reported as unimplemented (W3)")
  441: row("T cont exc", exc(T), "absent", "no exception entry on the -T route (W4)")
  442: row("T cont chkstop", chk(T), "absent", "arm (c) parked it; the checkstop arm did not run")
  443: row("T cont msr", hexr(regs, "msr"), hex(0), "the park leaves MSR as it was (B1c)")
  444: regs, T, how = session("T step", ["srr0=0x%x" % SENT, "pc=0x%x" % NOMEM, "step 1"], flags=["-T"])
  445: row("T step session", how, "exit0", "-T fetch past RAM, step: survives")
  446: row("T step text", text(T), "absent", "no `read failed: TODO` exit")
  447: row("T step prompt", prompt(T), "yes", "the debugger ran `reg` afterwards")
  448: row("T step pc", hexr(regs, "pc"), hex(NOMEM), "parked at the fetch address (W2: a bare return moves it)")
  449: row("T step srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented on the -T route (W4)")
  450: row("T step nonex", nonex(T), "2", "premise: single-step read + translator read", control=True)
  451: row("T step unimpl", unimpl(T), "absent", "the halt is not reported as unimplemented (W3)")
  452: row("T step exc", exc(T), "absent", "no exception entry on the -T route (W4)")
  453: row("T step chkstop", chk(T), "absent", "arm (c) parked it; the checkstop arm did not run")
  454: row("T step msr", hexr(regs, "msr"), hex(0), "the park leaves MSR as it was (B1c)")
  455: # The floor cell the merged rows left empty (the pre-table check, 2026-11-04): arm (d) TESTS MSR[ME], and MSR is 0 on every -T
  456: # session above, so the -T halt with ME SET is driven here -- arm (c) must still park it, not deliver a machine check.
  457: regs, T, how = session("T me", ["srr0=0x%x" % SENT, "msr=0x%x" % MSR_ME, "pc=0x%x" % NOMEM, "step 1"], flags=["-T"])
  458: row("T me session", how, "exit0", "-T halt with MSR[ME] set: survives")
  459: row("T me pc", hexr(regs, "pc"), hex(NOMEM), "parked, not at the 0x200 machine-check vector")
  460: row("T me srr0", hexr(regs, "srr0"), hex(SENT), "no machine check delivered on the -T route")
  461: row("T me nonex", nonex(T), "2", "premise: the same two reports with ME set", control=True)
  462: row("T me text", text(T), "absent", "no `read failed: TODO` exit")
  463: row("T me exc", exc(T), "absent", "no `[ PPC Exception 0x2` on the -T route")
  464: row("T me unimpl", unimpl(T), "absent", "an ME-set halt is not sent to bad: (V10)")
  465: row("T me chkstop", chk(T), "absent", "an ME-set halt does not take the checkstop (V11)")
  466: row("T me msr", hexr(regs, "msr"), hex(MSR_ME), "the park leaves MSR[ME] set (B1a)")
  467: regs, T, how = session("again", ["srr0=0x%x" % SENT, "pc=0x%x" % NOMEM, "step 1", "step 1", "continue", "continue"], flags=["-T"])
  468: print("again: measured non-existant count = %s" % nonex(T))
  469: row("again session", how, "exit0", "a second step and a second continue after the halt survive")
  470: row("again pc", hexr(regs, "pc"), hex(NOMEM), "still parked: no translated zero slot ran (W5)")
  471: row("again srr0", hexr(regs, "srr0"), hex(SENT), "still no exception entry (W4)")
  472: row("again nonex", nonex(T), str(AGAIN_NONEX), "premise: a -T halt is terminal (repeats run nothing)", control=True)
  473: row("again text", text(T), "absent", "no `read failed: TODO` exit on the repeats")
  474: row("again unimpl", unimpl(T), "absent", "a translated zero slot would print UNIMPLEMENTED (W5)")
  475: row("again exc", exc(T), "absent", "no exception entry on the repeats (W4)")
  476: row("again chkstop", chk(T), "absent", "arm (c), not the checkstop arm, on every repeat")
  477: row("again prompt", prompt(T), "yes", "the debugger ran `reg` after the repeats")
  478: row("again msr", hexr(regs, "msr"), hex(0), "the repeats leave MSR as it was (B1c)")
  479: 
  480: # The read-ahead cell (FINAL_FABLE.md F4; found by det_20261104/window_sweep.out): cpc700_pci's last word, 0xfec00004, reads
  481: # 0x23120e00 in its reset state -- subfic r24,r18,0xe00 -- so translating it reads ahead into 0xfec00008, past the 8-byte window.
  482: # The -T halt fires DURING read-ahead and arm (a) returns; the subfic runs; the real fetch of 0xfec00008 halts again and arm (c)
  483: # parks.  Two halt reports, both naming 0xfec00008.
  484: RA_LAST = 0xfec00004         # cpc700_pci's data word: the window's last word
  485: RA_NEXT = 0xfec00008         # past the window: no device answers it
  486: regs, T, how = session("T ra", ["srr0=0x%x" % SENT, "pc=0x%x" % RA_LAST, "continue"], flags=["-T"])
  487: row("T ra session", how, "exit0", "-T read-ahead past cpc700_pci: survives")
  488: row("T ra pc", hexr(regs, "pc"), hex(RA_NEXT), "parked at the word past the window")
  489: row("T ra nonex", nonex(T), "2", "the read-ahead's halt, then the real fetch's (W7)")
  490: row("T ra addr", halts(T), hex(RA_NEXT), "every halt names the word past the window")
  491: row("T ra stopped", stopped(T), "yes", "the -T halt stopped the machine (running 0)")
  492: row("T ra msr", hexr(regs, "msr"), hex(0), "the read-ahead route leaves MSR as it was (B1c)")
  493: row("T ra chkstop", chk(T), "absent", "no checkstop line on the read-ahead route (B2)")
  494: row("T ra srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented on the read-ahead route")
  495: row("T ra unimpl", unimpl(T), "absent", "the real fetch is not sent to bad: (W3)")
  496: # Arm (a)'s guard with MSR[ME] SET (the adjudication of repair pass 2, Q1: GLM's floor gap).  `T ra` runs with MSR 0, so a guard
  497: # conjoined with an ME-clear test is invisible there; with ME set that conjunct sends the read-ahead failure past arm (a) to
  498: # arm (c)'s park -- one report where the fix gives two (the base side: artifacts/qhslowifetch/p2r_20261105/tra_me_base.out).
  499: regs, T, how = session("T ra me", ["srr0=0x%x" % SENT, "msr=0x%x" % MSR_ME, "pc=0x%x" % RA_LAST, "continue"], flags=["-T"])
  500: row("T ra me session", how, "exit0", "-T read-ahead with MSR[ME] set: survives")
  501: row("T ra me pc", hexr(regs, "pc"), hex(RA_NEXT), "parked at the word past the window")
  502: row("T ra me nonex", nonex(T), "2", "arm (a) returns on read-ahead with ME set (V8)")
  503: row("T ra me addr", halts(T), hex(RA_NEXT), "every halt names the word past the window (W2, D3)")
  504: row("T ra me stopped", stopped(T), "yes", "the -T halt stopped the machine (B1)")
  505: row("T ra me chkstop", chk(T), "absent", "the real fetch parks, not a checkstop (V11)")
  506: row("T ra me msr", hexr(regs, "msr"), hex(MSR_ME), "MSR[ME] stays set through read-ahead and park (B1a, B1b)")
  507: row("T ra me srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented with ME set")
  508: row("T ra me unimpl", unimpl(T), "absent", "the real fetch is not sent to bad: (W3, V10)")
  509: # `T ra` entered at the UNALIGNED pc 0xfec00005 (repair 6; Mythos pass-5 breach 2, p5_20261105/TRAODD_NOTE.md): the prologue
  510: # keeps pc's low two bits, so the read-ahead fetch reaches the failure block with pc != addr.  The fix's arm (a) returns and the
  511: # real fetch halts again: two reports, the park at 0xfec00009.  A guard conjoined with an alignment test sends the read-ahead
  512: # failure on to arm (c), which parks it at read-ahead time: one report.  No breakpoint, so read-ahead runs.
  513: RA_ODD = 0xfec00005
  514: regs, T, how = session("T ra odd", ["srr0=0x%x" % SENT, "pc=0x%x" % RA_ODD, "continue"], flags=["-T"])
  515: row("T ra odd session", how, "exit0", "-T read-ahead from an unaligned pc: survives")
  516: row("T ra odd pc", hexr(regs, "pc"), hex(RA_NEXT | 1), "parked past the window, the low bit kept")
  517: row("T ra odd nonex", nonex(T), "2", "the read-ahead halt, then the real fetch (arm (a) at pc != addr)")
  518: row("T ra odd addr", halts(T), hex(RA_NEXT), "every halt names the word past the window (W2, D3)")
  519: row("T ra odd stopped", stopped(T), "yes", "the -T halt stopped the machine (B1)")
  520: row("T ra odd msr", hexr(regs, "msr"), hex(0), "MSR as entered: arm (a) writes no MSR (R7_a_msrset)")
  521: row("T ra odd chkstop", chk(T), "absent", "no checkstop line on this route (R7b_a_chkun)")
  522: row("T ra odd srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented on this route (R7b_a_srr0un)")
  523: row("T ra odd unimpl", unimpl(T), "absent", "the real fetch is not sent to bad: (W3, R8_c_clun_bad)")
  524: # THE ARM (a) CLASS CLOSURE (repair 7; codex pass 6, r7_20261105/B123_NOTE.md).  Passes 5 and 6 both found arm (a) x alignment cells
  525: # unrowed, so the read-ahead route is crossed over pc's low two bits {00, 01, 10, 11} x MSR[ME] {clear, set}: `T ra`, `T ra me` and
  526: # `T ra odd` hold three cells and these five sessions the rest -- `T ra` entered at 0xfec00004 | low bits, MSR written only when ME
  527: # is set (`m`).  The prologue keeps pc's low bits, so the read-ahead fetch reaches the failure block at pc 0xfec00008 | low bits; arm
  528: # (a) returns, the subfic runs, the real fetch halts again and arm (c) parks at that pc: exit 0, that pc, two reports naming
  529: # 0xfec00008, the stop, MSR as entered, no checkstop line, SRR0 untouched and no UNIMPLEMENTED text -- `T ra`'s nine channels
  530: # (repair 7b; `unimpl`, repair 8).  A guard that refuses a cell parks it at read-ahead time instead (one report); an MSR or SRR0
  531: # write, a checkstop print, or a transfer to bad: from the real fetch (where bad: prints UNIMPLEMENTED and changes nothing else; a
  532: # read-ahead transfer returns silently -- this comment said "a transfer to bad: (which prints UNIMPLEMENTED ...)", codex pass 8, R1)
  533: # shows in its own row.
  534: for tag, low, msr, kills in (("o1m", 1, MSR_ME, "R7_a_meun"), ("o2", 2, 0, "R7_a_bit1, R7_a_clun"),
  535:                              ("o2m", 2, MSR_ME, "R7_a_bit1, R7_a_meun"), ("o3", 3, 0, "R7_a_bit1, R7_a_bit0, R7_a_clun"),
  536:                              ("o3m", 3, MSR_ME, "R7_a_bit1, R7_a_bit0, R7_a_meun")):
  537:     nm = "T ra " + tag
  538:     regs, T, how = session(nm, ["srr0=0x%x" % SENT] + (["msr=0x%x" % msr] if msr else []) + ["pc=0x%x" % (RA_LAST | low), "continue"],
  539:                            flags=["-T"])
  540:     row(nm + " session", how, "exit0", "-T read-ahead, pc&3 = %d, ME %s: survives" % (low, "set" if msr else "clear"))
  541:     row(nm + " pc", hexr(regs, "pc"), hex(RA_NEXT | low), "parked past the window, low bits kept (R7_fail_unal)")
  542:     row(nm + " nonex", nonex(T), "2", "arm (a) returns at this cell (%s)" % kills)
  543:     row(nm + " addr", halts(T), hex(RA_NEXT), "every halt names the word past the window (W2, D3)")
  544:     row(nm + " stopped", stopped(T), "yes", "the -T halt stopped the machine (B1)")
  545:     row(nm + " msr", hexr(regs, "msr"), hex(msr), "MSR as entered (%s)" % ("R7_a_msrclr" if msr else "R7_a_msrset"))
  546:     row(nm + " chkstop", chk(T), "absent", "no checkstop line on this route (R7b_a_chkun)")
  547:     row(nm + " srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented on this route (R7b_a_srr0un)")
  548:     row(nm + " unimpl", unimpl(T), "absent",
  549:         "the real fetch is not sent to bad: (%s)" % ("W3, V10, R8_c_meun_bad" if msr else "W3, R8_c_clun_bad"))
  550: # THE ONE-ENTRY PARTNERS (repair 11; codex pass 10, B1; r7_20261105/B123_NOTE.md).  Each read-ahead session enters the failure block
  551: # TWICE at one full pc -- the read-ahead visit, then the real fetch; its partner enters it ONCE at the SAME full pc and MSR: pc set to
  552: # 0xfec00008 | low bits directly and continued under -T, so the first fetch fails (a failed fetch is never translated, so no
  553: # read-ahead follows) and arm (c) parks it.  The pair then presents the block with the same pc, addr, MSR, running (0) and slot; only
  554: # translation_readahead differs, nonzero on the two-entry session's first visit.  So a toggle conditioned on any of those that the
  555: # toggle itself leaves unchanged fires on both visits exactly when it fires on the partner's one, provided both failed-fetch visits
  556: # still happen and nothing between them changes the toggled state (the docstring; codex rec11) -- it cancels on the pair's two-entry
  557: # side and shows on the partner -- and a condition on translation_readahead fires on one visit only and shows on the two-entry side.
  558: # A self-referential toggle is outside this: the docstring's SCOPE (codex pass 11, R1).
  559: for tag, low, msr in (("", 0, 0), ("me", 0, MSR_ME), ("odd", 1, 0), ("o1m", 1, MSR_ME), ("o2", 2, 0), ("o2m", 2, MSR_ME),
  560:                       ("o3", 3, 0), ("o3m", 3, MSR_ME)):
  561:     nm, pair = ("T rp " + tag).rstrip(), ("T ra " + tag).rstrip()
  562:     regs, T, how = session(nm, ["srr0=0x%x" % SENT] + (["msr=0x%x" % msr] if msr else []) + ["pc=0x%x" % (RA_NEXT | low), "continue"],
  563:                            flags=["-T"])
  564:     row(nm + " session", how, "exit0", "-T fetch at %s's full pc, one entry: survives" % pair)
  565:     row(nm + " pc", hexr(regs, "pc"), hex(RA_NEXT | low), "parked at the same full pc as %s's real fetch" % pair)
  566:     row(nm + " nonex", nonex(T), "1", "ONE halt report: one entry, where %s has two (R6_mask15)" % pair)
  567:     row(nm + " addr", halts(T), hex(RA_NEXT), "the halt names the same word as %s's (W2, D3)" % pair)
  568:     row(nm + " stopped", stopped(T), "yes", "the -T halt stopped the machine (B1)")
  569:     row(nm + " msr", hexr(regs, "msr"), hex(msr), "MSR as entered: one entry, no toggle cancels (R9_tog_me%d)" % low)
  570:     row(nm + " chkstop", chk(T), "absent", "arm (c) parked it; no checkstop (%s)" % ("V11" if msr else "D1, D2"))
  571:     row(nm + " srr0", hexr(regs, "srr0"), hex(SENT),
  572:         "SRR0 as entered: one entry, no toggle cancels (R11_tog_full, R11_tog_full_%d%s)" % (low, "m" if msr else "c"))
  573:     row(nm + " unimpl", unimpl(T), "absent", "the halt is not sent to bad: (W3%s)" % (", V10" if msr else ""))
  574: # Arm (b) with a guest-made UNALIGNED pc (repair pass 4; p4_20261105/BLR_NOTE.md, ADJ_MYTHOS.md): this fork's mtlr and its
  575: # unconditional blr (X(bclr_20)) copy LR unmasked and the translator's prologue aligns addr but not pc, so `mtlr r3; blr` reaches the
  576: # failure block with pc != addr.  Before repair 5 arm (b) took it, refreshed and re-ran the slot: 8278 halt reports under -T.  With
  577: # the aligned compare the fetch parks in arm (c).  r3 = 0x02040007 has bits 0-2 set (repair 6; p5_20261105/MASK7_NOTE.md): the
  578: # prologue gives addr 0x02040004, so a mask narrowed to either low bit (`& ~1`, `& ~2`) or widened to bit 2 (`& ~7`) still floods.
  579: # The program is written with `put b` (byte stores do not warm translations); a far breakpoint disables read-ahead.
  580: BLR_PC = 0x02040007
  581: cmds = ["srr0=0x%x" % SENT, "r3=0x%x" % BLR_PC]
  582: for i, w in enumerate((0x7C6803A6, 0x4E800020)):          # mtlr r3 ; blr
  583:     for j in range(4):
  584:         cmds.append("put b 0x%x,0x%02x" % (ENTRY + 4 * i + j, (w >> (24 - 8 * j)) & 0xff))
  585: regs, T, how = session("T blr", cmds + ["breakpoint add 0x3000", "continue"], flags=["-T"])
  586: row("T blr session", how, "exit0", "-T fetch at a guest-made unaligned pc: survives")
  587: row("T blr pc", hexr(regs, "pc"), hex(BLR_PC), "parked at the unaligned pc (arm (c))")
  588: row("T blr nonex", nonex(T), "1", "one halt report: the slot is not re-run (repair 5)")
  589: row("T blr srr0", hexr(regs, "srr0"), hex(SENT), "no exception invented")
  590: row("T blr msr", hexr(regs, "msr"), hex(0), "MSR unchanged")
  591: row("T blr chkstop", chk(T), "absent", "arm (c) parked it; no checkstop")
  592: row("T blr unimpl", unimpl(T), "absent", "the halt is not reported as unimplemented")
  593: row("T blr lr", hexr(regs, "lr"), hex(BLR_PC), "LR holds the stored value (mtlr writes all bits)")
  594: # ONE-ENTRY FAILURES (repairs 9 and 10; codex passes 8 and 9; r7_20261105/B123_NOTE.md).  Every read-ahead session enters the
  595: # failure block TWICE -- the read-ahead failure, then the real fetch -- so a toggle the block makes under a condition both visits share
  596: # (pc's low bits, MSR[ME]) cancels before the final state is read; only a ONE-ENTRY failure in the same (low bits, ME) cell sees it.
  597: # The grid {00, 01, 10, 11} x {ME clear, set} x {two-entry, one-entry} is held whole: two-entry by the eight read-ahead sessions,
  598: # one-entry by `T cont` / `T step` / `again` (00, clear), `T me` (00, set), `T blr` (11, clear) and these five -- `T blr` with r3 =
  599: # 0x02040005 / 0x02040006 (o1, o2: ME clear; repair 9) and 0x02040005 / 0x02040006 / 0x02040007 with msr = 0x1000 (m1, m2, m3; repair
  600: # 10).  The breakpoint keeps read-ahead off, so each failing fetch enters the block once and arm (c) parks it.  (Codex pass 9, R2: the
  601: # srr0 note read "(R9_tog_srr0_1)" for o1 and o2 alike; o2 cannot see that toggle, so its note now names R10_tog_srr0_2.)
  602: BLR_PUTS = cmds[2:]
  603: for tag, target, msr, bits, togme, togsrr0, floods in (
  604:         ("o1", 0x02040005, 0, "01", "R9_tog_me1", "R9_tog_srr0_1", "R5_mask2"),
  605:         ("o2", 0x02040006, 0, "10", "R9_tog_me2", "R10_tog_srr0_2", "R5_mask1"),
  606:         ("m1", 0x02040005, MSR_ME, "01", "R9_tog_me1", "R10_tog_srr0_me1", "R5_mask2"),
  607:         ("m2", 0x02040006, MSR_ME, "10", "R9_tog_me2", "R10_tog_srr0_me2", "R5_mask1"),
  608:         ("m3", 0x02040007, MSR_ME, "11", "R9_tog_me3", "R10_tog_srr0_me3", "R5_mask1, R5_mask2")):
  609:     nm = "T blr " + tag
  610:     regs, T, how = session(nm, ["srr0=0x%x" % SENT] + (["msr=0x%x" % msr] if msr else []) + ["r3=0x%x" % target] + BLR_PUTS +
  611:                            ["breakpoint add 0x3000", "continue"], flags=["-T"])
  612:     row(nm + " session", how, "exit0", "-T fetch at a guest-made pc, low bits %s, ME %s: survives" % (bits, "set" if msr else "clear"))
  613:     row(nm + " pc", hexr(regs, "pc"), hex(target), "parked at the unaligned pc (arm (c))")
  614:     row(nm + " nonex", nonex(T), "1", "one halt report: one entry, the slot not re-run (%s)" % floods)
  615:     row(nm + " srr0", hexr(regs, "srr0"), hex(SENT), "SRR0 as entered: one entry, no toggle cancels (%s)" % togsrr0)
  616:     row(nm + " msr", hexr(regs, "msr"), hex(msr), "MSR as entered: one entry, no toggle cancels (%s)" % togme)
  617:     row(nm + " chkstop", chk(T), "absent", "arm (c) parked it; no checkstop")
  618:     row(nm + " unimpl", unimpl(T), "absent", "the halt is not sent to bad: (%s)" % ("V10, R8_c_meun_bad" if msr else "R8_c_clun_bad"))
  619:     row(nm + " lr", hexr(regs, "lr"), hex(target), "LR holds the stored value")
  620: 
  621: # ===================================================================== RESULT ==
  622: n_ok = sum(1 for _, ok in rows if ok)
  623: red = [n for n, ok in rows if not ok]
  624: print("elapsed %.1fs" % (time.time() - t0))
  625: print("PPC_IFETCH_RESULT=%d/%d" % (n_ok, len(rows)))
  626: print("PPC_IFETCH_CONTROL=%s" % ("OK" if all(ok for _, ok in controls) else "FAIL"))
  627: print("PPC_IFETCH_SYMPTOM=%s" % ("PRESENT" if symptom_hits else "ABSENT"))
  628: print("PPC_IFETCH_RED=%s" % (",".join(n.replace(" ", "_") for n in red) if red else "none"))
  629: print("PPC_IFETCH_PROBE_DONE")

