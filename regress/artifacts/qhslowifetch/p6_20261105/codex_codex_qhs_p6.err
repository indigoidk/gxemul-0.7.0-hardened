4166:                 re-resolves it, and (d) relies on that.
4167:                 The refresh here is redundant and harmless.  */
4168:             if ((cpu->pc & ~(uint64_t)3) != addr) {
4169:                 quick_pc_to_pointers(cpu);
4170:                 return;
4171:             }
4172:             /*  (c) -T: memory.c cleared running and printed
4173:                 the non-existant line.  No PowerPC exception
4174:                 is involved.  Park at this pc (set above) so
4175:                 the debugger shows the failing fetch.  */
4176:             if (!cpu->running) {
4177:                 cpu->cd.ppc.next_ic = &nothing_call;
4178:                 return;
4179:             }
4180:             /*  (d) A device declined an instruction-width
4181:                 read while running.  A fetch the bus
4182:                 terminates with an error is a machine check
4183:                 (vector 0x200) when MSR[ME] is set and a
4184:                 checkstop when it is clear.  SRR1 status
4185:                 bits are not modelled.  */
4186:             if (cpu->cd.ppc.msr & PPC_MSR_ME) {
4187:                 /*  ppc_exception() leaves MSR[ME] set,
4188:                     where the architecture clears it on a
4189:                     machine check, so a further failing
4190:                     fetch here takes a second machine check
4191:                     instead of checkstopping (#QQQ).  */
4192:                 ppc_exception(cpu, PPC_EXCEPTION_MC);
4193:                 return;
4194:             }
4195:             /*  Clears only this CPU's running and parks
4196:                 next_ic on nothing_call, which ends the
4197:                 current batch.  memory.c's -T halt clears
4198:                 every CPU's running; a checkstop is a
4199:                 per-processor state.  pmppc has one CPU,
4200:                 so what the other CPUs of a multiprocessor
4201:                 do after this checkstop is not measured
4202:                 (#PPP).  */
4203:             fatal("[ ppc: instruction fetch from 0x%" PRIx64
4204:                 " declined with MSR[ME]=0: checkstop ]\n",
4205:                 (uint64_t) addr);
4206:             cpu->running = 0;
4207:             cpu->cd.ppc.next_ic = &nothing_call;
4208:             return;
4209:         }
```

