 552: /*
 553:  *  wdc__write():
 554:  */
 555: void wdc__write(struct cpu *cpu, struct wdc_data *d)
 556: {
 557: 	int cyl = d->cyl_hi * 256+ d->cyl_lo;
 558: 	int count = d->seccnt? d->seccnt : 256;
 559: 	uint64_t offset = 512 * (d->sector - 1
 560: 	    + (int64_t)d->head * d->sectors_per_track[d->drive] +
 561: 	    (int64_t)d->heads[d->drive] * d->sectors_per_track[d->drive] * cyl);
 562: #if 0
 563: 	/*  LBA:  */
 564: 	if (d->lba)
 565: 		offset = 512 * (((d->head & 0xf) << 24) +
 566: 		    (cyl << 8) + d->sector);
 567: 	printf("WDC write to offset %lli\n", (long long)offset);
 568: #endif
 569: 
 570: 	d->write_in_progress = d->cur_command;
 571: 	d->write_count = count;
 572: 	d->write_offset = offset;
 573: 
 574: 	/*  TODO: result code?  */
 575: }
 576: 
 577: 
 578: /*
 579:  *  status_byte():
 580:  *
 581:  *  Return a reasonable status byte corresponding to the controller's current
 582:  *  state.
 583:  */
 584: static int status_byte(struct wdc_data *d, struct cpu *cpu)
 585: {
 586: 	int odata = 0;
 587: 	if (diskimage_exist(cpu->machine, d->drive + d->base_drive,
 588: 	    DISKIMAGE_IDE))
 589: 		odata |= WDCS_DRDY | WDCS_DSC;
 590: 	if (d->inbuf_head != d->inbuf_tail)
 591: 		odata |= WDCS_DRQ;
 592: 	if (d->write_in_progress)
 593: 		odata |= WDCS_DRQ;
 594: 	if (d->error)
 595: 		odata |= WDCS_ERR;
 596: 	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
 597: 		odata |= WDCS_DRQ;
 598: 	}
 599: 	return odata;
 600: }
 601: 
 602: 
 603: /*  #481: forward-declared so the ALT-CTRL arm below can call it.  A panel seat's
 604:     control mutant failed to compile for want of exactly this line and the failure
 605:     was briefly read as a design constraint against calling the shared helper; it
 606:     is one line and it builds clean.  */
 607: static void wdc_new_command_reset(struct wdc_data *d);
 608: 
 609: DEVICE_ACCESS(wdc_altstatus)
 610: {
 611: 	struct wdc_data *d = (struct wdc_data *) extra;
 612: 	uint64_t idata = 0, odata = 0;
 613: 
 614: 	idata = data[0];
 615: 
 616: 	/*  Same as the normal status byte:  */
 617: 	odata = status_byte(d, cpu);
 618: 
 619: 	if (writeflag==MEM_READ) {
 620: 		if (relative_addr != 0) {
 620: 		if (relative_addr != 0) {
 621: 			/*  #525 (wdcaltdigin): THE READ PATH NEVER DECODED ITS
 622: 			    OFFSET EITHER.  `relative_addr' was tested in exactly
 623: 			    one place in this function -- inside the `else' of
 624: 			    this `if' -- so a READ of offset 1, the Drive Address
 625: 			    register (0x3f7 on the PC layout), returned the
 626: 			    ALT-STATUS byte -- the value of a DIFFERENT register,
 627: 			    from an offset this handler never decoded.
 628: 
 629: 			    THIS IS THE SYMMETRIC CELL OF #494, WHICH CLOSED THE
 630: 			    WRITE HALF OF THE SAME `if' AND LEFT THIS ONE OPEN.
 631: 			    The function's own inputs give a two-by-two --
 632: 			    {READ, WRITE} x {offset 0, offset 1} -- and three
 633: 			    cells were closed.  Measured at rung 3 on the
 634: 			    committed build: 14/16 pre-fix with both offset-1
 635: 			    read rows returning the status byte (0x51 at power-on,
 636: 			    0x58 armed), 16/16 after.
 637: 
 638: 			    *** AND ATA-2 SETTLES MORE OF THIS THAN THE ROUND
 639: 			    FIRST CLAIMED -- X3T10 0948D, Note 1 to the command
 640: 			    block (_scratchpad/ata2_x3t10_948d.txt:1529-1531):
 641: 			    "This register is obsolete.  It is recommended that a
 642: 			    device NOT RESPOND to a read of this address.  If a
 643: 			    device does respond, it shall be sure NOT TO DRIVE THE
 644: 			    DD7 SIGNAL to prevent possible conflict with floppy
 645: 			    disk implementations." ***
 646: 
 647: 			    Three things follow, and they are stronger than the
 648: 			    emulator-policy warrant this comment originally rested
 649: 			    on.  DECLINING IS THE RECOMMENDED BEHAVIOUR, not merely
 650: 			    a choice.  DD7 IS BIT 7, and `odata = 0' leaves it
 651: 			    clear, so the returned value satisfies the one
 652: 			    constraint the standard places on a device that does
 653: 			    answer.  And the floppy conflict the tree documents
 654: 			    from both sides IS the reason the standard gives --
 655: 			    which is why the narrowed sentence below stops at
 656: 			    "contested" rather than claiming what every guest
 657: 			    expects.  (`030e961' already recorded this Note as
 658: 			    governing and the comment never cited it; two panel
 659: 			    seats raised it independently.)
 660: 
 661: 			    ZERO IS AN EMULATOR POLICY WHERE THE STANDARD IS
 662: 			    SILENT -- it fixes WHICH non-DD7 value is returned,
 663: 			    which ATA-2 does not specify -- BUT IT IS NOT AN
 664: 			    ARBITRARY ONE.
 665: 			    DC21285-era PC parts leave 0x3f7 to the floppy
 666: 			    controller -- wdcreg.h compiles wd_digin out under an
 667: 			    `#if 0' reading "NOT MAPPED; fd uses this register on
 668: 			    PCs", and dev_fdc.c's DEV_FDC_LENGTH carries "TODO 8,
 669: 			    but collision with wdc".  Whose register it really is
 670: 			    stays open (row wdcaltownership).  What is settled is
 671: 			    that it is not ours to answer with our status byte, so
 672: 			    the declined read returns the deterministic 0 that #95
 673: 			    already pre-zeroes the caller's buffer with, rather
 674: 			    than inventing a value.
 675: 
 676: 			    SILENT, like #494's write decline and for a NARROWER
 677: 			    version of the same reason.  What the tree actually
 678: 			    establishes is that on the PC layout this byte is
 679: 			    CONTESTED and documented from both sides; it does NOT
 680: 			    establish that every guest on every registered layout
 681: 			    expects a floppy effect here, and an earlier draft of
 682: 			    this comment claimed that.  A diagnostic would
 683: 			    therefore be announcing a decode we are not certain is
 684: 			    anomalous -- which is reason enough to stay quiet,
 685: 			    without the stronger claim.
 686: 
 687: 			    (NOTE the collision is PROSPECTIVE, not live:
 688: 			    DEV_FDC_LENGTH is 6, so dev_fdc.c does not register
 689: 			    0x3f7 today.  The "TODO 8" is what would collide.)
 690: 
 691: 			    THE REGISTRATION IS DELIBERATELY NOT NARROWED.  A
 692: 			    2 -> 1 at the memory_device_register() below would
 693: 			    close both offset-1 cells structurally, but it moves
 694: 			    0x3f7 from HANDLED-AND-DECLINED to UNMAPPED -- a
 695: 			    different path whose behaviour here is unmeasured --
 696: 			    and it would leave #494's arm as dead code carrying a
 697: 			    measured comment.  Owner ruling: decode the read.  */
 698: 			odata = 0;
 699: 		} else
 700: 			debug("[ wdc: read from ALTSTATUS: 0x%02x ]\n",
 701: 			    (int)odata);
 702: 	} else if (relative_addr != 0) {
 703: 		/*  #494: THE HANDLER NEVER DECODED ITS OWN OFFSET.  The region is
 704: 		    registered TWO BYTES wide, so offset 1 -- the Drive Address
 705: 		    register, 0x3f7 on the PC layout -- arrived here and was treated
 706: 		    as a Device Control write.  Since #481 corrected the reset bit,
 707: 		    that meant a guest store to a READ-ONLY register aborted a live
 708: 		    ATA write and purged the queued ring.  Measured at rung 3 on an
 709: 		    unmodified evbmips -e malta; the witness is preserved under
 710: 		    regress/artifacts/wdcaltoffset/witness_20260829/.
 711: 
 712: 		    THE WHOLE ACTION IS DECLINED, NOT JUST THE HELPER CALL, AND THAT
 713: 		    IS THE POINT.  The reset has two effects with two owners: the
 714: 		    cur_command assignment below, and the ring/DRQ clearing inside
 715: 		    wdc_new_command_reset().  A fix that guards only the helper leaves
 716: 		    the ATAPI signature latched.  That was MEASURED, not reasoned: it
 717: 		    escapes the witness AND the detector that replaced it with a clean
 718: 		    sweep, because every row in both observes DRQ or the ring and
 719: 		    neither varies under it.  The kill table and its scores are under
 720: 		    regress/artifacts/wdcaltoffset/killtable_20260830/ -- read TABLE.txt
 721: 		    for the counts rather than trusting a number written here, which is
 722: 		    how this sentence was wrong once already.
 723: 
 724: 		    SILENT BY DESIGN, at debug() level and with no latch.  The house
 725: 		    idiom announces a guest ANOMALY, and this is not one: the tree
 726: 		    records in two places that this byte belongs to the floppy
 727: 		    controller on PCs -- wdcreg.h compiles wd_digin out under
 728: 		    an `#if 0` whose own note reads "NOT MAPPED; fd uses this
 729: 		    register on PCs" (the delimiters are dropped here on purpose:
 730: 		    a comment terminator quoted inside a comment ends it), and
 731: 		    dev_fdc.c's DEV_FDC_LENGTH carries `TODO 8, but collision with
 732: 		    wdc`.  *** NARROWED 2026-09-11 (#525): this sentence used to
 733: 		    read "A correct guest writes here expecting a floppy effect, so
 734: 		    a wdc diagnostic would report correct behaviour as a fault",
 735: 		    and #525's read-side comment 34 lines below RETRACTED exactly
 736: 		    that claim -- leaving this handler contradicting itself in one
 737: 		    function.  What the tree establishes is that on the PC layout
 738: 		    this byte is CONTESTED and documented from both sides; it does
 739: 		    NOT establish what every guest on every registered layout
 740: 		    expects.  The silence is still right, on the narrower ground
 741: 		    that a diagnostic would announce a decode we are not certain is
 742: 		    anomalous.  (And the collision is PROSPECTIVE: DEV_FDC_LENGTH
 743: 		    is 6, so dev_fdc.c does not register this byte today.)  Found
 744: 		    by the flagship adjudication, which grepped for the sibling of
 745: 		    a correction I had already called finished. ***
 746: 
 747: 		    THE ACCESS STAYS HANDLED (return 1), AND THE REASON IS NOT THE ONE
 748: 		    THIS COMMENT FIRST GAVE.  It said a 0 would fall through to
 749: 		    unassigned-address handling and warn per access.  That is false: this
 750: 		    device is REGISTERED, so a 0 never reaches that path.  memory_rw sets
 751: 		    res = -1, takes its res <= 0 branch, and raises EXCEPTION_DBE --
 752: 		    measured, 19793 `device 'wdc_altstatus' ... failed` lines and ZERO
 753: 		    `non-existant` ones under -v.  The guest then loops forever
 754: 		    re-executing the faulting store, and at DEFAULT verbosity it does so
 755: 		    in SILENCE.  That is worse than a warning flood, not better, which is
 756: 		    why the wrong reason was worth correcting rather than dropping: a
 757: 		    maintainer who reads `only noisy warnings` may decide a 0 is fine.
 758: 
 759: 		    The arm falls through to the common tail, which is a no-op for it --
 760: 		    the tail only assigns on the READ path.  (An earlier draft justified
 761: 		    that by the untouched-buffer hazard; #95 already zeroes the caller's
 762: 		    buffer, so that hazard cannot arise here either.)  */
 763: 		debug("[ wdc: write to DRIVE ADDRESS (read-only): 0x%02x,"
 764: 		    " ignored ]\n", (int)idata);
 765: 	} else {
 766: 		debug("[ wdc: write to ALT. CTRL: 0x%02x ]\n",
 767: 		    (int)idata);
 768: 		/*  #481: THE RESET BIT IS WDCTL_RST (0x04), NOT WDCTL_4BIT (0x08).
 769: 		
 770: 		    WDCTL_4BIT is "use four head bits (wd1003)", a head-addressing
 771: 		    mode selector that Linux libata holds as its STEADY-STATE ap->ctl.
 772: 		    Testing it here meant three measured defects at once:
 773: 		
 774: 		      * a real soft reset was MISSED.  Older OpenBSD asserts with 0x06,
 775: 		        which has bit 3 CLEAR -- measured `cur_command 0x0`.
 776: 		      * a ROUTINE control write DESTROYED THE RECORD OF WHICH COMMAND IS
 777: 		        EXECUTING -- measured `0xec -> 0x100`.  cur_command is also the
 778: 		        value assigned into write_in_progress, so this is only harmless
 779: 		        because wdc__write() has exactly ONE caller, immediately after
 780: 		        the assignment.  An accident, not an invariant.
 781: 		      * an nIEN write latched a reset.  0x0a is libata's polled-mode
 782: 		        staple -- measured `0x0a->0x100`.
 783: 		
 784: 		    COMMAND_RESET IS NOT A RESET ACTION.  It is read at exactly two
 785: 		    sites, both making the cylinder registers return the ATAPI signature
 786: 		    0xEB14 for a CD-ROM.  It is the SIGNATURE LATCH -- which is why the
 787: 		    wrong bit went unnoticed: triggering on libata's steady state kept
 788: 		    the signature on almost always.
 789: 		
 790: 		    LEVEL-TRIGGERED, DELIBERATELY, AND THE MEASURED DIFFERENCE
 791: 		    FAVOURS THIS FORM.  A channel held in reset must not carry bytes
 792: 		    out the far side, and an edge-triggered abort lets it:
 793: 		
 794: 		        assert 0x0e, 8 guest stores to DATA, rewrite 0x0e, release
 795: 		          LEVEL (this form):  occ 0, DRQ 0   -- the ring is purged
 796: 		          EDGE:               occ 8, DRQ 1   -- the bytes survive the
 797: 		                                                 whole reset, and the
 798: 		                                                 status byte still
 799: 		                                                 advertises DRQ
 800: 		
 801: 		    Measured through register writes only, with a liveness control (the
 802: 		    same traffic without a reset leaves occ 8, so the 0 is the reset
 803: 		    working and not a dead path).
 804: 		
 805: 		    *** AN EARLIER VERSION OF THIS COMMENT SAID edge and level were
 806: 		    "indistinguishable here, because the abort is idempotent and no
 807: 		    protocol-following driver issues commands while holding SRST".
 808: 		    THAT WAS MEASURED FALSE.  Three things were wrong with it:
 809: 		
 810: 		      * the differential behind it only ever asserted SRST ONCE, and
 811: 		        the forms differ only when a driver HOLDS it across two
 812: 		        control writes with something accruing in between;
 813: 		      * IDEMPOTENCE OF THE HELPER DOES NOT LICENCE THE INFERENCE.
 814: 		        It means repeating the abort is harmless.  It says nothing
 815: 		        about SKIPPING the repeat, which is what an edge does, and
 816: 		        state accrues between the writes;
 817: 		      * the scenario above ISSUES NO COMMAND.  Plain data-register
 818: 		        stores suffice -- and in a hardening fork the guest need not
 819: 		        be protocol-following at all.
 820: 		
 821: 		    The decision is unchanged and now rests on evidence that does not
 822: 		    collapse when someone builds the discriminating case. ***
 823: 		
 824: 		    Note also that a prev_ctl update mis-scoped by one brace makes
 825: 		    every LATER reset be ignored -- a failure this form cannot have --
 826: 		    but that is a secondary argument, not the reason.
 827: 		
 828: 		    THE ABORT IS #479's HELPER, not a second one: a channel reset and a
 829: 		    new command must not disagree about what gets cleared, and #479
 830: 		    already reasoned out which latches must SURVIVE (see its comment --
 831: 		    clearing warned_* would undo #337 and #464).  */
 832: 		if (idata & WDCTL_RST) {
 833: 			d->cur_command = COMMAND_RESET;
 834: 			wdc_new_command_reset(d);
 835: 		}
 836: 	}
 837: 
 838: 	if (writeflag == MEM_READ)
 839: 		data[0] = odata;
 840: 
 841: 	return 1;
 842: }
 843: 
 844: 
 845: 
 850:  *  WRITER, BUFFERED BYTES, OR PHASE.
 851:  *
 852:  *  #480 L4: THE SCOPE IS THIS FUNCTION, NOT THE WORD "COMMAND".  An earlier
 853:  *  headline read "A NEW COMMAND STARTS WITHOUT..." with no qualifier, and the
 854:  *  device falsified that in its own code: the ALT-CTRL arm assigned
 855:  *  cur_command = COMMAND_RESET WITHOUT CALLING THIS HELPER, so the most
 856:  *  reset-like operation the device had was not a caller at all.  The SCOPE
 857:  *  paragraph forty lines below said so; a universal headline with its qualifier
 858:  *  that far down is read as universal.  Named by the fable seat on #479 pass 2.
 859:  *
 860:  *  wdc_command() cleared the ATAPI flag and the error and nothing else, so three
 861:  *  pieces of the previous command's state survived into the next one.  All three
 862:  *  were reproduced with liveness controls before this was written:
 863:  *
 864:  *    write_in_progress   an ATA write stayed armed across a packet command, so one
 865:  *                        shared ring served the disk-write path and the CDB path at
 866:  *                        once.  MEASURED: a guest's own sector write put 512 CD-ROM
 867:  *                        DATA-IN bytes and ZERO of its own on the image.
 868:  *    the input ring      residue from an under-drained transfer was never cleared.
 869:  *                        MEASURED: the drain then fires early and the guest's sector
 870:  *                        arrives with the previous transfer's bytes at its head.
 871:  *    atapi_phase         PHASE_CMDOUT survived an ordinary WRITE command.  Latent
 872:  *                        while the dispatch tests the flag AND the phase -- and #477's
 873:  *                        comment was pointing a future round straight at it.
 874:  *
 875:  *  WHY THE TOP, AND NOT THE END.  IDENTIFY loads its 512-byte response INTO the ring
 876:  *  as part of the command, and wdc__read() does the same for every ordinary READ.  A
 877:  *  seat measured the end-of-function form destroying both -- 256 of 256 IDENTIFY
 878:  *  words wrong, and a freshly-read sector gone -- while every row this round pins
 879:  *  stayed GREEN.  Clean-up-on-exit reads as the more principled placement and is the
 880:  *  more dangerous one.
 881:  *
 882:  *  WHAT THIS DELIBERATELY DOES NOT TOUCH:
 883:  *
 884:  *    cur_command     wdc__write() reads it, and the caller sets it immediately
 885:  *                    above.  Clearing it here would break the write it is about to
 886:  *                    set up.
 887:  *    the warned_*    latches.  Zeroing them alongside everything else reads as
 888:  *                    COMPLETING this helper and is the mutant to press: it undoes
 889:  *                    #337 and #464, and it is STRICTLY WORSE than the equivalent
 890:  *                    mistake in dev_asc.c, because wdc_command() runs far more often
 891:  *                    than a chip reset.  dev_asc.c says so at its own latch
 892:  *                    declarations: "Deliberately NOT cleared by dev_asc_reset() or
 893:  *                    dev_asc_fifo_flush(): a guest could otherwise re-arm the flood."
 894:  *
 895:  *  SCOPE.  TWO CALLERS: wdc_command(), and the ALT-CTRL arm on a real soft reset.
 896:  *
 897:  *  *** THIS PARAGRAPH SAID "Called from wdc_command() only" AND PRESCRIBED WHAT WOULD
 898:  *  HAVE TO HAPPEN FIRST BEFORE THE OTHER CALLER COULD EXIST.  #481 DID EXACTLY THAT,
 899:  *  so the prescription is DISCHARGED rather than merely stale. ***
 900:  *
 901:  *  It read: extending the helper to that arm AS IT STOOD was MEASURED to cancel a
 902:  *  legal transfer on an ordinary 0x08 Device Control write, which real drivers hold
 903:  *  as their steady state; so the extension "needs the arm's bit test fixed first
 904:  *  (WDCTL_RST, not WDCTL_4BIT) and is a separate round."
 905:  *
 906:  *  #481 is that round.  It corrected the bit AND made the call in one change, which
 907:  *  is why the accept rows this paragraph pointed at are GREEN on the shipped tree and
 908:  *  still RED under `Md_bitswap` -- the same extension WITHOUT the prerequisite.
 909:  *  Those four rows therefore MEASURED the ordering argument rather than asserting it.
 910:  *
 911:  *  The invariant is still not established on every path into the device: the ALT-CTRL
 912:  *  arm calls this only for WDCTL_RST, and other decode paths into that register are
 913:  *  filed rather than covered.  Said out loud rather than implied, as before.
 914:  */
 915: static void wdc_new_command_reset(struct wdc_data *d)
 916: {
 917: 	d->atapi_cmd_in_progress = 0;
 918: 	d->atapi_phase = 0;
 919: 	d->write_in_progress = 0;
 920: 
 921: 	/*  pointer reset rather than a drain loop, matching dev_asc_fifo_flush()'s
 922: 	    count-zeroing: there is no consumer to notify and nothing to hand back.  */
 923: 	d->inbuf_head = d->inbuf_tail = 0;
 924: }
 925: /*
 926:  *  wdc_command():
 927:  */
 928: void wdc_command(struct cpu *cpu, struct wdc_data *d, int idata)
 929: {
 930: 	size_t i;
 931: 
 932: 	d->cur_command = idata;
 933: 	d->error = 0;
 934: 
 935: 	/*  #479: this replaced a bare `d->atapi_cmd_in_progress = 0;`.  The flag
 936: 	    was one of three pieces of the previous command's state, and clearing
 937: 	    only the one that had been noticed is what left the other two.  */
 938: 	wdc_new_command_reset(d);
 939: 
 940: 	/*
 941: 	 *  Disk images that do not exist return an ABORT error.  This also
 942: 	 *  happens with CDROM images with the WDCC_IDENTIFY command; CDROM
 943: 	 *  images must be detected with ATAPI_IDENTIFY_DEVICE instead.
 944: 	 *
 945: 	 *  TODO:  Is this correct/good behaviour?
 946: 	 */
 947: 	if (!diskimage_exist(cpu->machine, d->drive + d->base_drive,
 948: 	    DISKIMAGE_IDE)) {
 949: 		debug("[ wdc: command 0x%02x drive %i, but no disk image ]\n",
 950: 		    d->cur_command, d->drive + d->base_drive);
 951: 		d->error |= WDCE_ABRT;
 952: 		d->int_assert = 1;
 953: 		return;
 954: 	}
 955: 	if (diskimage_is_a_cdrom(cpu->machine, d->drive + d->base_drive,
 956: 	    DISKIMAGE_IDE) && d->cur_command == WDCC_IDENTIFY) {
 957: 		debug("[ wdc: IDENTIFY drive %i, but it is an ATAPI "
 958: 		    "drive ]\n", d->drive + d->base_drive);
 959: 		d->error |= WDCE_ABRT;
 960: 		d->int_assert = 1;
 961: 		return;
 962: 	}
 963: 
 964: 	/*  Handle the command:  */
 965: 	switch (d->cur_command) {
 966: 
 967: 	case WDCC_READ:
 968: 	case WDCC_READMULTI:
 969: 		if (!quiet_mode)
 970: 			debug("[ wdc: READ from drive %i, head %i, cyl %i, "
 971: 			    "sector %i, nsecs %i ]\n", d->drive, d->head,
 972: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
 973: 		wdc__read(cpu, d);
 974: 		break;
 975: 
 976: 	case WDCC_WRITE:
 977: 	case WDCC_WRITEMULTI:
 978: 		if (!quiet_mode)
 979: 			debug("[ wdc: WRITE to drive %i, head %i, cyl %i, "
 980: 			    "sector %i, nsecs %i ]\n", d->drive, d->head,
 981: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
 982: 		wdc__write(cpu, d);
 983: 		break;
 984: 
 985: 	case WDCC_IDP:	/*  Initialize drive parameters  */
 986: 		debug("[ wdc: IDP drive %i (TODO) ]\n", d->drive);
 987: 		/*  TODO  */
 988: 		d->int_assert = 1;
 989: 		break;
 990: 
 991: 	case SET_FEATURES:
 992: 		debug("[ wdc: SET_FEATURES drive %i (TODO), feature 0x%02x ]\n",
 993: 		    d->drive, d->precomp);
 994: 		/*  TODO  */
 995: 		switch (d->precomp) {
 996: 		case WDSF_SET_MODE:
 997: 			debug("[ wdc: WDSF_SET_MODE drive %i, pio/dma flags "
 998: 			    "0x%02x ]\n", d->drive, d->seccnt);
 999: 			break;
1000: 		default:d->error |= WDCE_ABRT;
1001: 		}
1002: 		/*  TODO: always interrupt?  */
1003: 		d->int_assert = 1;
1004: 		break;
1005: 
1006: 	case WDCC_RECAL:
1007: 		debug("[ wdc: RECAL drive %i ]\n", d->drive);
1008: 		d->int_assert = 1;
1009: 		break;
1010: 
1011: 	case WDCC_IDENTIFY:
1012: 	case ATAPI_IDENTIFY_DEVICE:
1013: 		debug("[ wdc: %sIDENTIFY drive %i ]\n", d->cur_command ==
1014: 		    ATAPI_IDENTIFY_DEVICE? "ATAPI " : "", d->drive);
1015: 		wdc_initialize_identify_struct(cpu, d);
1016: 		/*  The IDENTIFY data is sent out in low/high byte order:  */
1017: 		for (i=0; i<sizeof(d->identify_struct); i+=2) {
1018: 			wdc_addtoinbuf(d, d->identify_struct[i+1]);
1019: 			wdc_addtoinbuf(d, d->identify_struct[i+0]);
1020: 		}
1021: 		d->int_assert = 1;
1022: 		break;
1023: 
1024: 	case WDCC_IDLE_IMMED:
1025: 		debug("[ wdc: IDLE_IMMED drive %i ]\n", d->drive);
1026: 		/*  TODO: interrupt here?  */
1027: 		d->int_assert = 1;
1028: 		break;
1029: 
1030: 	case WDCC_SETMULTI:
1031: 		debug("[ wdc: SETMULTI drive %i ]\n", d->drive);
1032: 		/*  TODO: interrupt here?  */
1033: 		d->int_assert = 1;
1034: 		break;
1035: 
1036: 	case ATAPI_SOFT_RESET:
1037: 		debug("[ wdc: ATAPI_SOFT_RESET drive %i ]\n", d->drive);
1038: 		/*  TODO: interrupt here?  */
1039: 		d->int_assert = 1;
1040: 		break;
1041: 
1042: 	case ATAPI_PKT_CMD:
1043: 		debug("[ wdc: ATAPI_PKT_CMD drive %i ]\n", d->drive);
1044: 		/*  TODO: interrupt here?  */
1045: 		/*  d->int_assert = 1;  */
1046: 		d->atapi_cmd_in_progress = 1;
1047: 		d->atapi_phase = PHASE_CMDOUT;
1048: 		break;
1049: 
1050: 	case WDCC_DIAGNOSE:
1051: 		debug("[ wdc: WDCC_DIAGNOSE drive %i: TODO ]\n", d->drive);
1052: 		/*  TODO: interrupt here?  */
1053: 		d->int_assert = 1;
1054: 		d->error = 1;		/*  No error?  */
1055: 		break;
1056: 
1057: 	/*  Unsupported commands, without warning:  */
1058: 	case WDCC_SEC_SET_PASSWORD:
1059: 	case WDCC_SEC_UNLOCK:
1060: 	case WDCC_SEC_ERASE_PREPARE:
1061: 	case WDCC_SEC_ERASE_UNIT:
1062: 	case WDCC_SEC_FREEZE_LOCK:
1063: 	case WDCC_SEC_DISABLE_PASSWORD:
1064: 		/*  #485: A TERMINAL ARM RAISES ITS COMPLETION INTERRUPT.
1065: 
1158: 			d->warned_unimpl_cmd = 1;
1159: 			fatal("[ wdc: WARNING! Unimplemented command 0x%02x "
1160: 			    "(drive %i, head %i, cyl %i, sector %i, nsecs %i)"
1161: 			    " ]\n", d->cur_command, d->drive, d->head,
1162: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
1163: 		}
1164: 	}
1165: }
1166: 
1167: 
1168: DEVICE_ACCESS(wdc)
1169: {
1170: 	struct wdc_data *d = (struct wdc_data *) extra;
1171: 	uint64_t idata = 0, odata = 0;
1172: 	int i;
1173: 
1174: 	relative_addr /= d->addr_mult;
1175: 
1176: 	if (!d->io_enabled)
1177: 		goto ret;
1178: 
1179: 	if (writeflag == MEM_WRITE) {
1180: 		if (relative_addr == wd_data)
1181: 			idata = memory_readmax64(cpu, data, len);
1182: 		else {
1183: 			/*  #464: latch the announcement; `idata = data[0]`
1184: 			    is the repair and stays outside the guard.  */
1185: 			if (len != 1 && !d->warned_nonbyte_write) {
1186: 				d->warned_nonbyte_write = 1;
1187: 				fatal("[ wdc: WARNING! non-8-bit access on "
1188: 				    "WRITE! ]\n");
1189: 			}
1190: 			idata = data[0];
1191: 		}
1192: 	}
1193: 
1194: 	switch (relative_addr) {
1195: 
1196: 	case wd_data:	/*  0: data  */
1197: 		if (writeflag == MEM_READ) {
1198: 			odata = wdc_get_inbuf(d);
1199: 
1200: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
1201: 				if (len >= 2)
1202: 					odata += (wdc_get_inbuf(d) << 8);
1203: 				if (len == 4) {
1204: 					odata += (wdc_get_inbuf(d) << 16);
1205: 					odata += (wdc_get_inbuf(d) << 24);
1206: 				}
1207: 			} else {
1208: 				if (len >= 2)
1209: 					odata = (odata << 8) + wdc_get_inbuf(d);
1210: 				if (len == 4) {
1211: 					odata = (odata << 8) + wdc_get_inbuf(d);
1212: 					odata = (odata << 8) + wdc_get_inbuf(d);
1213: 				}
1214: 			}
1215: 
1216: 			if (d->data_debug) {
1217: 				const char *s = "0x%04" PRIx64" ]\n";
1218: 				if (len == 1)
1219: 					s = "0x%02" PRIx64" ]\n";
1220: 				if (len == 4)
1221: 					s = "0x%08" PRIx64" ]\n";
1222: 				if (len == 8)
1223: 					s = "0x%016" PRIx64" ]\n";
1224: 				debug("[ wdc: read from DATA: ");
1225: 				debug(s, (uint64_t) odata);
1840: 			                        leaves occupancy at 512, so `512 > 0` passes
1841: 			                        and the guest's own returned data is written
1842: 			                        to the image.  MEASURED first=0xbe.
1843: 
1844: 			    The drain is guarded rather than the `default:` arm because the
1845: 			    WRITE+PKT door involves no bad-len access at all.  */
1846: 			if (inbuf_len > 0 && !badlen_this &&
1847: 			    (( d->write_in_progress == WDCC_WRITEMULTI &&
1848: 			    inbuf_len % (512 * d->write_count) == 0)
1849: 			    ||
1850: 			    ( d->write_in_progress == WDCC_WRITE &&
1851: 			    inbuf_len % 512 == 0)) ) {
1852: 				int count = (d->write_in_progress ==
1853: 				    WDCC_WRITEMULTI)? d->write_count : 1;
1854: 				unsigned char *buf, *b;
1855: 
1856: 				CHECK_ALLOCATION(buf = (unsigned char *) malloc(512 * count));
1857: 				b = buf;
1858: 
1859: 				if (d->inbuf_tail+512*count <= WDC_INBUF_SIZE) {
1860: 					b = d->inbuf + d->inbuf_tail;
1861: 					d->inbuf_tail = (d->inbuf_tail + 512
1862: 					    * count) % WDC_INBUF_SIZE;
1863: 				} else {
1864: 					for (i=0; i<512 * count; i++)
1865: 						buf[i] = wdc_get_inbuf(d);
1866: 				}
1867: 
1868: 				diskimage_access(cpu->machine,
1869: 				    d->drive + d->base_drive, DISKIMAGE_IDE, 1,
1870: 				    d->write_offset, b, 512 * count);
1871: 
1872: 				d->write_count -= count;
1873: 				d->write_offset += 512 * count;
1874: 
1875: 				d->int_assert = 1;
1876: 
1877: 				if (d->write_count == 0)
1878: 					d->write_in_progress = 0;
1879: 
1880: 				free(buf);
1881: 			} else if ((( d->write_in_progress == WDCC_WRITEMULTI &&
1882: 			    inbuf_len % (512 * d->write_count) == 0)
1883: 			    ||
1884: 			    ( d->write_in_progress == WDCC_WRITE &&
1885: 			    inbuf_len % 512 == 0)) && !d->warned_empty_drain) {
1886: 				/*  #478: DECLINE AND ANNOUNCE, per this tree's own #264
1887: 				    precedent -- dev_asc.c refuses a zero-length DATA_OUT
1888: 				    and SAYS SO rather than proceeding silently.
1889: 
1890: 				    The condition is the DIFFERENCE between this fix and the
1891: 				    code it replaces, not the negation of the guard: the old
1892: 				    code drained on the modulus alone, so this fires exactly
1893: 				    where a spurious sector USED to reach the disk image.
1894: 				    Announcing on every non-draining write would fire on all
1895: 				    255 partial stores of an ordinary sector.
1896: 
1897: 				    Without this the guest had NO notice at all: no error
1898: 				    bit, the handler returns 1, and the interrupt is still
1899: 				    asserted -- a write silently vanishing.  N=1 per device
1900: 				    instance with `(once)`, the tree's plurality marker.
1901: 
1902: 				    fatal() and not debugmsg(): under -q the verbosity
1903: 				    settles at VERBOSITY_ERROR, so a WARNING would be
1904: 				    invisible to the boot-log hygiene grep and an ERROR
1905: 				    would trip #261's break-on-ERROR.  */
1920: 				    decline-and-announce ruling exists to prevent.
1921: 
1922: 				    The CONDITION is kept: it fires where the unfixed code would have
1923: 				    put a spurious sector on the disk image, which is worth saying
1924: 				    however the ring reached that state.  The TEXT now describes what
1925: 				    happened -- a drain was refused -- instead of asserting a buffer
1926: 				    state it never checked.  */
