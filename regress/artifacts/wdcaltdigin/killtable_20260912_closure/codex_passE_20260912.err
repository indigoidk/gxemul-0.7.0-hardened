2073: DEVINIT(wdc)
2074: {
2075: 	struct wdc_data *d;
2076: 	uint64_t alt_status_addr;
2077: 	int i, tick_shift = WDC_TICK_SHIFT;
2078: 
2079: 	CHECK_ALLOCATION(d = (struct wdc_data *) malloc(sizeof(struct wdc_data)));
2080: 	memset(d, 0, sizeof(struct wdc_data));
2081: 
2082: 	INTERRUPT_CONNECT(devinit->interrupt_path, d->irq);
2083: 	d->addr_mult  = devinit->addr_mult;
2084: 	d->data_debug = 1;
2085: 	d->io_enabled = 1;
2086: 	d->error      = 1;
2087: 
2088: 	d->inbuf = (unsigned char *) zeroed_alloc(WDC_INBUF_SIZE);
2089: 
2090: 	/*  base_drive = 0 for the primary controller, 2 for the secondary.  */
2091: 	d->base_drive = 0;
2092: 	if ((devinit->addr & 0xfff) == 0x170)
2093: 		d->base_drive = 2;
2094: 
2095: 	alt_status_addr = devinit->addr + 0x206;
2096: 
2097: 	/*  Special hacks for individual machines:  */
2098: 	switch (devinit->machine->machine_type) {
2099: 	case MACHINE_MACPPC:
2100: 		alt_status_addr = devinit->addr + 0x160;
2101: 		break;
2102: 	case MACHINE_HPCMIPS:
2103: 		/*  TODO: Fix  */
2104: 		if (devinit->addr == 0x14000180)
2105: 			alt_status_addr = 0x14000386;
2106: 		break;
2107: 	case MACHINE_IQ80321:
2108: 		alt_status_addr = devinit->addr + 0x402;
2109: 		break;
2110: 	}
2111: 
2112: 	/*  Get disk geometries:  */
2113: 	for (i=0; i<2; i++)
2114: 		if (diskimage_exist(devinit->machine, d->base_drive +i,
2115: 		    DISKIMAGE_IDE))
2116: 			diskimage_getchs(devinit->machine, d->base_drive + i,
2117: 			    DISKIMAGE_IDE, &d->cyls[i], &d->heads[i],
2118: 			    &d->sectors_per_track[i]);
2119: 
2120: 	memory_device_register(devinit->machine->memory, "wdc_altstatus",
2121: 	    alt_status_addr, 2, dev_wdc_altstatus_access, d, DM_DEFAULT, NULL);
2122: 	memory_device_register(devinit->machine->memory, devinit->name,
2123: 	    devinit->addr, DEV_WDC_LENGTH * devinit->addr_mult, dev_wdc_access,
2124: 	    d, DM_DEFAULT, NULL);
2125: 
2126: 	machine_add_tickfunction(devinit->machine, dev_wdc_tick,
2127: 	    d, tick_shift);
2128: 
2129: 	devinit->return_ptr = d;
2130: 
2131: 	return 1;
2132: }
