 258:     ("CORE_READ_OFF1_ARMED",       "s4", 0x00,       "core",    "Offset-1 read armed declined: want 0x00 != S_armed"),
 259:     ("WRITE0_SRST_DRQ_CLEAR",      "s5", ST_IDLE,    "accept",  "#481: offset-0 SRST clears DRQ (0x50)"),
 260:     ("WRITE0_SRST_RING_PURGED",    "s6", FF,         "accept",  "#481: offset-0 SRST purges ring (0xff)"),
 261:     ("CORE_READ_OFF1_SRST",        "k1", 0x00,       "core",    "#525 p3: declined at 0x50 -- kills (odata & (DRQ|ERR))"),
 262:     ("CONTROL_STATUS_ARMED_W2",    "s7", ST_ARMED,   "control", "Re-armed status for Phase W2 (0x58)"),
 263:     ("WRITE1_DECLINE_DRQ_SET",     "t8", ST_ARMED,   "accept",  "#494: offset-1 SRST declined: DRQ still set (0x58)"),
 264:     ("WRITE1_DECLINE_RING_INTACT", "t9", 0x71,       "accept",  "#494: offset-1 SRST declined: byte 0x71 intact"),
 265: ]
 266: 
 267: class Emu(object):
 268:     def __init__(self, argv, boot_wait=5.0):
 269:         self.buf = bytearray()
 270:         self.pid, self.fd = pty.fork()
 271:         if self.pid == 0:
 272:             try:
 273:                 os.execvp(argv[0], argv)
 274:             finally:
 275:                 os._exit(127)
 276:         self.drain(boot_wait)
 277: 
 278:     def drain(self, seconds):
 279:         end = time.time() + seconds
 280:         while time.time() < end:
 281:             r, _, _ = select.select([self.fd], [], [], 0.05)
 282:             if self.fd in r:
 283:                 try:
 284:                     d = os.read(self.fd, 65536)
 285:                 except OSError:
 286:                     return
 287:                 if not d:
 288:                     return
 289:                 self.buf.extend(d)
 290: 
 291:     def send(self, cmd, wait=0.4):
 292:         start = len(self.buf)
 293:         data = (cmd + "\n").encode()
 294:         view = memoryview(data)
 295:         while len(view):
 296:             n = os.write(self.fd, view)
 297:             view = view[n:]
 298:             if len(view):
 299:                 self.drain(0.05)
 300:         self.drain(wait)
 301:         return bytes(self.buf[start:]).decode("latin1", "replace")
 302: 
 303:     def close(self, log):
 304:         try:
 305:             os.write(self.fd, b"quit\n")
 306:             self.drain(0.4)
 307:         except OSError:
 308:             pass
 309:         for fn in (lambda: os.close(self.fd),
 310:                    lambda: os.kill(self.pid, 9),
 311:                    lambda: os.waitpid(self.pid, 0)):
 312:             try:
 313:                 fn()
 314:             except OSError:
 315:                 pass
 316:         with open(log, "w") as f:
 317:             f.write(bytes(self.buf).decode("latin1", "replace"))
 318: 
 319: def reg(emu, name):
 320:     for _ in range(5):
 321:         out = emu.send("print %s" % name, wait=0.35)
 322:         m = re.findall(r"0x[0-9a-fA-F]+", out)
 323:         if m:
 324:             return int(m[-1], 16)
 325:         emu.drain(0.25)
 326:     return None
 327: 
 328: def main():
 329:     os.makedirs(OUTDIR, exist_ok=True)
 330:     if not os.path.isfile(DISK):
 331:         with open(DISK, "wb") as f:
 332:             f.write(b"\0" * (8 * 1024 * 1024))
 333: 
 334:     rawbin = os.path.join(OUTDIR, "altdigin_%s.bin" % LEG)
 335:     with open(rawbin, "wb") as f:
 336:         for w, _ in prog:
 337:             f.write(bytes([w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff]))
 338: 
 339:     argv = [BINARY, "-V", "-E", "evbmips", "-e", "malta",
 340:             "-d", "iR:" + DISK, "0x%x:%s" % (BASE, rawbin)]
 341: 
 342:     print("==============================================================================")
 343:     print("wdcaltdigin Rung-3 Witness -- Leg: %s" % LEG)
 344:     print("==============================================================================")
 345:     print("date       %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
 346:     print("binary     %s" % BINARY)
 347:     print("command    %s" % " ".join(argv))
 348:     sys.stdout.flush()
 349: 
 350:     emu = Emu(argv)
 351: 
 352:     # Control 0 check
 353:     dis = emu.send("unassemble 0x%x 0x%x" % (BASE, BASE + len(prog) * 4), wait=3.0)
 354:     seen = {}
 355:     for line in dis.splitlines():
 356:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
 357:         if m:
 358:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
 359: 
 360:     w_ok = 0
 361:     for i, (w, _) in enumerate(prog):
 362:         addr = (BASE + i * 4) & 0xffffffff
 363:         hit = seen.get(addr)
 364:         if hit and hit[0] == "%08x" % w:
 365:             w_ok += 1
 366:     print("Control 0 disassembly: %d of %d words verified match" % (w_ok, len(prog)))
 367: 
 368:     emu.send("breakpoint add 0x%x" % HALT_ADDR, wait=0.5)
 369:     t = time.time()
 370:     emu.send("continue", wait=1.0)
 371:     deadline = time.time() + 60
 372:     hit = False
 373:     while time.time() < deadline:
 374:         emu.drain(0.5)
 375:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
 376:         if "BREAKPOINT" in tail.upper():
 377:             hit = True
 378:             break
 379:     elapsed = time.time() - t
 380:     print("Breakpoint at 0x%x reached: %s (%.2f s)" % (HALT_ADDR, hit, elapsed))
 381: 
 382:     got = {}
 383:     for nm in REGS:
 384:         v = reg(emu, nm)
 385:         got[nm] = None if v is None else (v & 0xff)
 386: 
 387:     logpath = os.path.join(OUTDIR, "transcript_%s.log" % LEG)
 388:     emu.close(logpath)
 389: 
 390:     # Report measured S explicitly
 391:     s_pwr = got.get("s0")
 392:     s_arm = got.get("s3")
 393:     off1_pwr = got.get("s1")
 394:     off1_arm = got.get("s4")
 395:     print("------------------------------------------------------------------------------")
 396:     print("MEASURED STATUS & OFFSET-1 SAMPLES:")
 397:     print("  Power-on Altstatus (off 0): S = 0x%02x (want 0x51)" % (s_pwr if s_pwr is not None else 0))
 398:     print("  Power-on Offset 1 (off 1):  0x%02x (BASE want 0x00, HEAD defect is 0x%02x)" %
 399:           (off1_pwr if off1_pwr is not None else 0, s_pwr if s_pwr is not None else 0))
 400:     print("  Armed Altstatus (off 0):    S_armed = 0x%02x (want 0x58)" % (s_arm if s_arm is not None else 0))
 401:     print("  Armed Offset 1 (off 1):     0x%02x (BASE want 0x00, HEAD defect is 0x%02x)" %
 402:           (off1_arm if off1_arm is not None else 0, s_arm if s_arm is not None else 0))
 403:     print("------------------------------------------------------------------------------")
 404: 
 405:     # Evaluate rows
 406:     npass = 0
 407:     fails = []
 408:     print("%-28s %-4s %-8s %-8s %-6s %s" % ("ROW NAME", "REG", "WANT", "GOT", "STATUS", "DESCRIPTION"))
 409:     print("-" * 80)
 410:     for name, rname, want, kind, desc in ROW_DEFS:
 411:         g = got.get(rname)
 412:         ok = (g == want)
 413:         if ok:
 414:             npass += 1
 415:         else:
 416:             fails.append((name, rname, want, g))
 417:         #  #525 p3: None means the register was NEVER SAMPLED.  Rendering it 0x00
 418:         #  printed `want 0x00 got 0x00 FAIL` -- a self-contradictory line whose
 419:         #  natural reading is "probe bug", and it cost two wrong refutations.
 420:         gs = ("0x%02x" % g) if g is not None else "--"
 421:         print("%-28s %-4s 0x%02x     %-8s %-6s %s" %
 422:               (name, rname, want, gs, "PASS" if ok else "FAIL", desc))
 423: 
 424:     print("-" * 80)
 425:     print("SCORE %d/%d" % (npass, len(ROW_DEFS)))
 426:     #  Gate-idiom lines, matching wdc_flood_probe.py in gate_sh_rounding.sh.
 427:     #  PRINT-ONLY: no row verdict depends on them, so the instrument the kill
 428:     #  table measured is unchanged.
 429:     #  Index rather than unpack: ROW_DEFS entries are 5-tuples
 430:     #  (name, reg, want, kind, desc) and an arity assumption here would
 431:     #  break the summary on any future column change.
 432:     _failed = {f[0] for f in fails}
 433:     _ctl_bad = [r[0] for r in ROW_DEFS
 434:                 if r[0].startswith("CONTROL_") and r[0] in _failed]
 435:     print("WDC_ALTDIGIN_CONTROL=%s" % ("OK" if not _ctl_bad else "BROKEN"))
 436:     print("WDC_ALTDIGIN_RESULT=%d/%d" % (npass, len(ROW_DEFS)))
 437:     if fails:
 438:         print("FAILING ROWS (%d):" % len(fails))
 439:         for name, rname, want, g in fails:
 440:             print("  FAIL: %s (%s) want 0x%02x got %s" % (name, rname, want,
 441:                   ("0x%02x" % g) if g is not None else "-- (never sampled)"))
 442:     else:
 443:         print("ALL ROWS PASSED CLEANLY.")
 444: 
 445:     print("WDCALTDIGIN_WITNESS_DONE")
 446: 
 447: if __name__ == "__main__":
 448:     main()

