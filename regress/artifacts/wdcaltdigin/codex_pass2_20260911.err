2025:DEVINIT(wdc)
2026:{
2027:	struct wdc_data *d;
2028:	uint64_t alt_status_addr;
2029:	int i, tick_shift = WDC_TICK_SHIFT;
2030:
2031:	CHECK_ALLOCATION(d = (struct wdc_data *) malloc(sizeof(struct wdc_data)));
2032:	memset(d, 0, sizeof(struct wdc_data));
2033:
2034:	INTERRUPT_CONNECT(devinit->interrupt_path, d->irq);
2035:	d->addr_mult  = devinit->addr_mult;
2036:	d->data_debug = 1;
2037:	d->io_enabled = 1;
2038:	d->error      = 1;
2039:
2040:	d->inbuf = (unsigned char *) zeroed_alloc(WDC_INBUF_SIZE);
2041:
2042:	/*  base_drive = 0 for the primary controller, 2 for the secondary.  */
2043:	d->base_drive = 0;
2044:	if ((devinit->addr & 0xfff) == 0x170)
2045:		d->base_drive = 2;
2046:
2047:	alt_status_addr = devinit->addr + 0x206;
2048:
2049:	/*  Special hacks for individual machines:  */
2050:	switch (devinit->machine->machine_type) {
2051:	case MACHINE_MACPPC:
2052:		alt_status_addr = devinit->addr + 0x160;
2053:		break;
2054:	case MACHINE_HPCMIPS:
2055:		/*  TODO: Fix  */
2056:		if (devinit->addr == 0x14000180)
2057:			alt_status_addr = 0x14000386;
2058:		break;
2059:	case MACHINE_IQ80321:
2060:		alt_status_addr = devinit->addr + 0x402;
2061:		break;
2062:	}
2063:
2064:	/*  Get disk geometries:  */
2065:	for (i=0; i<2; i++)
2066:		if (diskimage_exist(devinit->machine, d->base_drive +i,
2067:		    DISKIMAGE_IDE))
2068:			diskimage_getchs(devinit->machine, d->base_drive + i,
2069:			    DISKIMAGE_IDE, &d->cyls[i], &d->heads[i],
2070:			    &d->sectors_per_track[i]);
2071:
2072:	memory_device_register(devinit->machine->memory, "wdc_altstatus",
2073:	    alt_status_addr, 2, dev_wdc_altstatus_access, d, DM_DEFAULT, NULL);
2074:	memory_device_register(devinit->machine->memory, devinit->name,
2075:	    devinit->addr, DEV_WDC_LENGTH * devinit->addr_mult, dev_wdc_access,
2076:	    d, DM_DEFAULT, NULL);
2077:
2078:	machine_add_tickfunction(devinit->machine, dev_wdc_tick,
2079:	    d, tick_shift);
2080:
2081:	devinit->return_ptr = d;
2082:
2083:	return 1;
2084:}
2085:

codex
The four branches bind as intended. `status_byte()` contains no device-state writes; normal STATUS acknowledges interrupts separately. Its call to `diskimage_exist()` leaves one purity check outside the allowed files. I also found that dispatch clamps an offset-1 `len == 2` access to one byte after zeroing the full read buffer.

