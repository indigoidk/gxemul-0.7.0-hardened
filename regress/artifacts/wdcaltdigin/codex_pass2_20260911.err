798:/*
799: *  wdc_new_command_reset():
800: *
801: *  #479: A COMMAND ENTERING wdc_command() STARTS WITHOUT THE PREVIOUS COMMAND'S
802: *  WRITER, BUFFERED BYTES, OR PHASE.
803: *
804: *  #480 L4: THE SCOPE IS THIS FUNCTION, NOT THE WORD "COMMAND".  An earlier
805: *  headline read "A NEW COMMAND STARTS WITHOUT..." with no qualifier, and the
860: *  still RED under `Md_bitswap` -- the same extension WITHOUT the prerequisite.
861: *  Those four rows therefore MEASURED the ordering argument rather than asserting it.
862: *
863: *  The invariant is still not established on every path into the device: the ALT-CTRL
864: *  arm calls this only for WDCTL_RST, and other decode paths into that register are
865: *  filed rather than covered.  Said out loud rather than implied, as before.
866: */
867:static void wdc_new_command_reset(struct wdc_data *d)
868:{
869:	d->atapi_cmd_in_progress = 0;
870:	d->atapi_phase = 0;
871:	d->write_in_progress = 0;
872:
873:	/*  pointer reset rather than a drain loop, matching dev_asc_fifo_flush()'s
874:	    count-zeroing: there is no consumer to notify and nothing to hand back.  */
875:	d->inbuf_head = d->inbuf_tail = 0;
876:}
877:/*
878: *  wdc_command():
