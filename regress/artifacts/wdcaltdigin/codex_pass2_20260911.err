182:static void wdc_addtoinbuf(struct wdc_data *d, int c)
183:{
184:	/*  #484: REFUSE BEFORE THE STORE.  The invariant this establishes is
185:	    THE RING'S OCCUPANCY IS SOUND -- deliberately not the weaker "full is
186:	    distinguishable from empty".  MANY sites depend on the first and only
187:	    this function implements the second; the readers are derivable at any
188:	    commit with
189:	
190:	        grep -n 'inbuf_head [=!]= d->inbuf_tail' dev_wdc.c   (and the
191:	        reversed and subtractive forms; one site writes tail - head)
192:	
193:	    rather than from a number here.  An earlier draft wrote SIX while the
194:	    checkpoint said FOUR, and the two cannot be reconciled without first
195:	    deciding whether to count SITES or DECISIONS -- which is how the wrong
196:	    number got written in the first place.  A count in a comment ages; a
197:	    deriver does not.  Naming the WEAK property here would invite a later
198:	    edit to trade the strong one away, which is the whole reason the
199:	    invariant is stated as occupancy rather than as distinguishability.
200:	
201:	    One slot is sacrificed, so head == tail now means EMPTY, full stop, and
202:	    every reader below becomes sound with no struct change and no new field.
203:	    Modelled on dev_pckbc.c's pckbc_add_code(), which refuses at
204:	    next == tail for exactly this defect (#288).
205:	
206:	    *** THE RETURN IS OUTSIDE THE LATCH, AND THAT IS NOT A STYLE CHOICE.
207:	    ***  Nested inside it, the FIRST overflow is refused and every later
208:	    push sees warned_inbuf_overrun == 1, skips the whole condition, and
209:	    walks head onto tail -- the defect restored.  Measured as mutant Md3,
210:	    13/16 in the panel seat's own table (its Md3), and 12/15 when I rebuilt
211:	    it against these bytes as Md_inside -- DIFFERENT TABLES, and the figure is
212:	    cited with the one that produced it rather than blended.  Both tables kill
213:	    it, which is the claim.  wdc_get_inbuf() below already forbids the same
214:	    shape in the
215:	    CONSUMER for the same reason, so a maintainer copying that function's
216:	    structure into this one writes the bug by accident.
217:	
218:	    Written WITHOUT an `int next` temporary on purpose.  The obvious form
219:	    (`next = (head+1) % SIZE; ... head = next;`) deletes the masked advance
220:	    below and makes the mask inside `next` safety-critical; dropping it is a
221:	    one-token simplification and measured as an actual heap overflow
222:	    (`free(): invalid next size`).  Keeping both statements untouched makes
223:	    that edit inexpressible as a SINGLE change -- though not impossible: the
224:	    modulo in the advance statement below is still removable on its own.
225:	    What it closes is the obvious consolidation path, which is what a
226:	    maintainer actually takes.
227:	
228:	    Drop-NEWEST, not drop-oldest, by reason: the surviving consumers key on
229:	    the FRONT of the stream (the CDB dispatch reads bytes 0-11; the sector
230:	    drain reads aligned runs from tail), so overwriting the oldest byte
579: *  status_byte():
580: *
581: *  Return a reasonable status byte corresponding to the controller's current
582: *  state.
583: */
584:static int status_byte(struct wdc_data *d, struct cpu *cpu)
585:{
586:	int odata = 0;
587:	if (diskimage_exist(cpu->machine, d->drive + d->base_drive,
588:	    DISKIMAGE_IDE))
589:		odata |= WDCS_DRDY | WDCS_DSC;
590:	if (d->inbuf_head != d->inbuf_tail)
591:		odata |= WDCS_DRQ;
592:	if (d->write_in_progress)
593:		odata |= WDCS_DRQ;
594:	if (d->error)
595:		odata |= WDCS_ERR;
596:	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
597:		odata |= WDCS_DRQ;
598:	}
599:	return odata;
600:}
