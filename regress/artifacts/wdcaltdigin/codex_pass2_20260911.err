27: *
28: *  Generic memory_rw(), with special hacks for specific CPU families.
29: *
30: *  Example for inclusion from memory_mips.c:
31: *
32: *	MEMORY_RW should be mips_memory_rw
33: *	MEM_MIPS should be defined
34: *
35: *
36: *  TODO: Cleanup the "ok" variable usage!
37: */
38:
39:
40:/*
41: *  memory_rw():
42: *
43: *  Read or write data from/to memory.
44: *
45: *	cpu		the cpu doing the read/write
46: *	mem		the memory object to use
47: *	vaddr		the virtual address
48: *	data		a pointer to the data to be written to memory, or
49: *			a placeholder for data when reading from memory
50: *	len		the length of the 'data' buffer
51: *	writeflag	set to MEM_READ or MEM_WRITE
52: *	misc_flags	CACHE_{NONE,DATA,INSTRUCTION} | other flags
53: *
54: *  If the address indicates access to a memory mapped device, that device'
55: *  read/write access function is called.
56: *
57: *  This function should not be called with cpu == NULL.
58: *
59: *  Returns one of the following:
60: *	MEMORY_ACCESS_FAILED
61: *	MEMORY_ACCESS_OK
62: *
63: *  (MEMORY_ACCESS_FAILED is 0.)
64: */
65:
66:/*
67: *  #430: THE PAGE SIZE, IN ONE PLACE.
68: *
69: *  It was a local inside the function.  The wrapper below needs the same number, and two
70: *  copies of a page size that can silently diverge is the shape this tree has been bitten
71: *  by before -- so it is hoisted to a macro and the local now reads it.  Note the Alpha
72: *  value: it is 8 KB, not 4 KB, so anything that splits at "the page boundary" must use
73: *  THIS and never a literal 4096.  A review seat caught exactly that hazard in the design
74: *  brief, which had said "4 KB page" throughout.
75: */
76:#ifdef MEM_ALPHA
77:#define	MRW_OFFSET_MASK		0x1fff
78:#else
79:#define	MRW_OFFSET_MASK		0xfff
80:#endif
81:
82:/*
83: *  #430: THE SPLIT GRANULE IS 1 KB, AND IT IS NOT THE SAME NUMBER AS THE MASK ABOVE.
84: *
85: *  MRW_OFFSET_MASK is the HOST-page granule: what memory_paddr_to_hostaddr() is asked for
86: *  and what update_translation_table() caches.  The granule the SPLIT needs is a different
87: *  thing -- the smallest unit at which a translator in this tree can send two adjacent
88: *  virtual addresses to unrelated physical ones -- and it is SMALLER:
89: *
90: *      memory_arm.c:198-207   descriptor type 3 on a non-XScale core is a 1 KB page,
91: *                             *return_paddr = (d2 & 0xfffffc00) | (vaddr & 0x3ff)
92: *      memory_sh.c:116        SH4_PTEL_SZ_1K gives mask 0xfffffc00
93: *      memory_mips_v2p.c      the VR41xx path likewise has 1 KB logic
94: *
95: *  A first draft of this split used the 4 KB mask and a review seat produced the
96: *  counterexample: with a 1 KB mapping, a four-byte access at 0x13fe crosses a translation
97: *  boundary but NOT a 4 KB one, so the loop never fired and the defect survived exactly
98: *  where MEMORY_NOT_FULL_PAGE says it is most likely.  Splitting finer is always SAFE --
99: *  each chunk is then inside one mapping for every translator here, and the worker's own
100: *  host-page arithmetic is unchanged -- so the only cost is more worker calls on the slow
101: *  path for a multi-page translated access, which is rare (large transfers are PHYSICAL
102: *  and exempt).  Correctness at a known granule beats a faster one that is wrong on ARM.
103: */
104:#define	MRW_SPLIT_MASK		0x3ff
105:
106:/*  The one-page worker; its name is derived from MEMORY_RW because cpu_alpha.c includes
107:    this file TWICE in one translation unit (alpha_userland_memory_rw, then alpha_memory_rw
108:    via tmp_alpha_tail.c), so a plainly named static would be a redefinition.  */
109:#ifndef MRW_CAT2
110:#define	MRW_CAT2(a,b)		a##b
111:#define	MRW_CAT(a,b)		MRW_CAT2(a,b)
112:#endif
113:#define	MEMORY_RW_ONE_PAGE	MRW_CAT(MEMORY_RW, _one_page)
114:
115:/*
116: *  The one relationship between the two that MUST hold, asserted at COMPILE TIME because it
117: *  cannot be asserted at run time by the offline differential.
118: *
119: *  MEM_ALPHA is never compiled by that differential -- its fixture is 4 KB-specific -- so a
120: *  review seat MEASURED that widening MRW_OFFSET_MASK, or hardcoding the worker's local back
121: *  to 0xfff (exactly the drift this macro exists to prevent), leaves every row green.  A
122: *  static assertion costs nothing and covers the Alpha build the test cannot reach.  The
123: *  name is derived because this file is included twice per translation unit.
124: */
125:typedef char MRW_CAT(MEMORY_RW, _split_le_page)
126:    [(MRW_SPLIT_MASK) <= (MRW_OFFSET_MASK) ? 1 : -1];
127:
128:static int MEMORY_RW_ONE_PAGE(struct cpu *cpu, struct memory *mem, uint64_t vaddr,
129:	unsigned char *data, size_t len, int writeflag, int misc_flags);
130:
180: *  while turning one large DMA into thousands of calls -- so those go straight through and
181: *  the memblock split keeps doing its job unchanged.
182: */
183:int MEMORY_RW(struct cpu *cpu, struct memory *mem, uint64_t vaddr,
184:	unsigned char *data, size_t len, int writeflag, int misc_flags)
185:{
186:	if (!(misc_flags & PHYSICAL) && cpu->translate_v2p != NULL) {
187:		size_t granule = (size_t) MRW_SPLIT_MASK + 1;
188:		size_t offset = (size_t) (vaddr & MRW_SPLIT_MASK);
189:
190:		/*  `len > granule - offset`, NOT `offset + len > granule`: the sum can
191:		    wrap for an absurd length (offset 1, len SIZE_MAX), which would skip
192:		    the loop and hand the whole thing to the worker.  The subtraction
193:		    cannot wrap, because offset < granule always.
194:
195:		    STATED EXACTLY, because the first version of this comment implied more
196:		    than it delivers: this form does not SERVICE such a length, it declines
197:		    to mis-copy it.  A length near SIZE_MAX now iterates about 2^54 times
198:		    instead of silently under-splitting -- measured, a fuzz watchdog fired
199:		    at two million chunks.  No caller passes anything remotely like it (the
200:		    largest in the tree are PHYSICAL and exempt), so the case is recorded
201:		    and filed rather than handled.  */
202:		while (len > granule - offset) {
203:			size_t head = granule - offset;
204:
205:			if (!MEMORY_RW_ONE_PAGE(cpu, mem, vaddr, data, head,
206:			    writeflag, misc_flags)) {
207:				/*  #244 PROMISES THE WHOLE READ BUFFER, AND SPLITTING BROKE
208:				    THAT: the worker zeroes only the chunk IT was given, so a
209:				    failure before the last chunk used to leave the caller's
210:				    remaining bytes untouched -- uninitialised host stack, for
211:				    a caller that ignores the return value.  Unsplit, one call
212:				    covered the whole length.  Zero the rest here so the
213:				    guarantee is the same as it was.  */
214:				if (writeflag == MEM_READ)
215:					memset(data, 0, len);
216:				return MEMORY_ACCESS_FAILED;
217:			}
218:
219:			vaddr += head;
220:			data += head;
221:			len -= head;
222:			offset = 0;
223:		}
224:	}
225:
226:	return MEMORY_RW_ONE_PAGE(cpu, mem, vaddr, data, len, writeflag, misc_flags);
227:}
228:
229:
230:static int MEMORY_RW_ONE_PAGE(struct cpu *cpu, struct memory *mem, uint64_t vaddr,
231:	unsigned char *data, size_t len, int writeflag, int misc_flags)
232:{
233:	const int offset_mask = MRW_OFFSET_MASK;
234:
235:	int ok = 2;
236:	uint64_t paddr;
237:	int cache, no_exceptions, offset;
238:	unsigned char *memblock;
239:	int dyntrans_device_danger = 0;
240:
241:	no_exceptions = misc_flags & NO_EXCEPTIONS;
242:	cache = misc_flags & CACHE_FLAGS_MASK;
243:
244:
245:	if (misc_flags & PHYSICAL || cpu->translate_v2p == NULL) {
246:		paddr = vaddr;
247:	} else {
248:		ok = cpu->translate_v2p(cpu, vaddr, &paddr,
249:		    (writeflag? FLAG_WRITEFLAG : 0) +
250:		    (no_exceptions? FLAG_NOEXCEPTIONS : 0)
251:		    + (misc_flags & MEMORY_USER_ACCESS)
252:		    + (cache==CACHE_INSTRUCTION? FLAG_INSTR : 0));
253:
254:		/*
255:		 *  If the translation caused an exception, or was invalid in
256:		 *  some way, then simply return without doing the memory
257:		 *  access:
258:		 */
259:		if (!ok) {
260:			/*  #244: A failed (or NO_EXCEPTIONS) translation leaves
261:			    the caller's read buffer untouched; zero it so
262:			    callers that ignore the return value (e.g. the DEC
263:			    PROM string helpers) consume deterministic 0 bytes
264:			    instead of uninitialised host stack. Same zero-fill
265:			    ethos as the failed-device-read path (#95).  */
266:			if (writeflag == MEM_READ)
267:				memset(data, 0, len);
268:			return MEMORY_ACCESS_FAILED;
269:		}
270:	}
271:
272:	/*
273:	 *  #250: data write-watchpoint. Checked here, before the device /
274:	 *  cache / RAM dispatch (several of which return early �?" notably the
275:	 *  R3000 cached path via memory_cache_R3000()), so every store that
276:	 *  reaches this slow path is covered. Watched pages are kept off the
277:	 *  fast store table by update_translation_table(), and R3000 cached
278:	 *  data already comes through here. Show the store (writer pc, target,
279:	 *  width, value) and request entry into the debugger after the current
280:	 *  instruction, via the same about_to_enter_single_step mechanism as
281:	 *  subsystem breakpoints. NOP unless a watchpoint is set.
282:	 */
283:	if (writeflag == MEM_WRITE && cpu->machine->watchpoints.n != 0 &&
284:	    !single_step && !about_to_enter_single_step &&
285:	    machine_watchpoint_match(cpu->machine, paddr, len)) {
286:		char valbuf[3 * 16 + 1];
287:		size_t vi, vn = len < 16 ? len : 16;
288:		valbuf[0] = '\0';
289:		for (vi = 0; vi < vn; vi++)
290:			snprintf(valbuf + strlen(valbuf),
291:			    sizeof(valbuf) - strlen(valbuf), "%s%02x",
292:			    vi ? " " : "", data[vi]);
293:		fatal("[ WATCHPOINT: write of %i byte(s) to vaddr 0x%" PRIx64
294:		    " (paddr 0x%" PRIx64") = %s%s, pc = 0x%" PRIx64" ]\n",
295:		    (int) len, (uint64_t) vaddr, (uint64_t) paddr, valbuf,
296:		    len > 16 ? " ..." : "", (uint64_t) cpu->pc);
297:		about_to_enter_single_step = true;
298:	}
299:
300:#if 0
301:	/*
302:	 *  For quick-and-dirty debugging of 32-bit code, typically
303:	 *  unknown ROM code:  Write out a summary of accessed memory ranges.
304:	 */
305:	if (cpu->running && paddr < 0x00300000)
306:	{
307:		static int swriteflag = -1, lastswriteflag;
308:		static int32_t start = -1, stop = -1;
309:		static int32_t laststart = -1, laststop = -1;
310:
475:		start = 0; end = mem->n_mmapped_devices - 1;
476:		i = mem->last_accessed_device;
477:
478:		/*  Scan through all devices:  */
479:		do {
480:			if (paddr >= mem->devices[i].baseaddr &&
481:			    paddr < mem->devices[i].endaddr) {
482:				/*  Found a device, let's access it:  */
483:				mem->last_accessed_device = i;
484:
485:				/*  #95: zero the caller's buffer up front on a read
486:				    so a device handler that fills only part of it --
487:				    or whose access is len-clamped just below -- can
488:				    never hand back uninitialised host memory to the
489:				    guest.  Root-cause fix for the uninit-read class
490:				    (cf. per-device #91/#93/#94).  */
491:				if (writeflag == MEM_READ)
492:					memset(data, 0, len);
493:
494:				paddr -= mem->devices[i].baseaddr;
495:				if (paddr + len > mem->devices[i].length) {
496:					/*  Note the truncation per the
497:					    warn-loudly ethos, but only at
498:					    debug verbosity (-v) and at most
499:					    8 times (single-threaded), since
500:					    probing at the end of a device's
501:					    mapped range is common and benign
502:					    (cf. the unwarned zero-fill in
503:					    #95/#119 above).  */
504:					static int n_trunc_msgs = 0;
505:					if (ENOUGH_VERBOSITY(SUBSYS_MEMORY,
506:					    VERBOSITY_DEBUG) &&
507:					    n_trunc_msgs < 8) {
508:						n_trunc_msgs ++;
509:						debugmsg_cpu(cpu,
510:						    SUBSYS_MEMORY,
511:						    mem->devices[i].name,
512:						    VERBOSITY_DEBUG,
513:						    "%s truncated at end of"
514:						    " device: offset 0x%llx,"
515:						    " len %i -> %i",
516:						    writeflag == MEM_WRITE ?
517:						    "write" : "read",
518:						    (long long) paddr,
519:						    (int) len,
520:						    (int) (mem->devices[i].
521:						    length - paddr));
522:					}
523:					len = mem->devices[i].length - paddr;
524:				}
525:
526:				if (cpu->update_translation_table != NULL &&
527:				    !(ok & MEMORY_NOT_FULL_PAGE) &&
528:				    mem->devices[i].flags & DM_DYNTRANS_OK) {
529:					int wf = writeflag == MEM_WRITE? 1 : 0;
530:					unsigned char *host_addr;
531:
532:					if (!(mem->devices[i].flags &
533:					    DM_DYNTRANS_WRITE_OK))
534:						wf = 0;
535:
536:					if (writeflag && wf) {
537:						if (paddr < mem->devices[i].
538:						    dyntrans_write_low)
539:							mem->devices[i].
540:							dyntrans_write_low =
541:							    paddr &~offset_mask;
542:						if (paddr >= mem->devices[i].
543:						    dyntrans_write_high)
544:							mem->devices[i].
545:						 	dyntrans_write_high =
546:							    paddr | offset_mask;
547:					}
548:
549:					if (mem->devices[i].flags &
550:					    DM_EMULATED_RAM) {
551:						/*  MEM_WRITE to force the page
552:						    to be allocated, if it
553:						    wasn't already  */
554:						uint64_t *pp = (uint64_t *)mem->
555:						    devices[i].dyntrans_data;
556:						uint64_t p = orig_paddr - *pp;
557:						host_addr =
558:						    memory_paddr_to_hostaddr(
559:						    mem, p & ~offset_mask,
560:						    MEM_WRITE);
561:					} else if ((paddr | offset_mask) <
562:					    mem->devices[i].length) {
563:						host_addr = mem->devices[i].
564:						    dyntrans_data +
565:						    (paddr & ~offset_mask);
566:					} else {
567:						/*  #155: (Codex/Fable)
568:						    don't install dyntrans
569:						    fast-path access to a
570:						    device page that is not
571:						    fully backed; keep it on
572:						    the bounded slow path.  */
573:						host_addr = NULL;
574:					}
575:
576:					if (host_addr != NULL)
577:						cpu->update_translation_table(
578:						    cpu, vaddr & ~offset_mask,
579:						    host_addr, wf,
580:						    orig_paddr & ~offset_mask);
581:				}
582:
583:				res = 0;
584:				if (!no_exceptions || (mem->devices[i].flags &
585:				    DM_READS_HAVE_NO_SIDE_EFFECTS)) {
586:					bool running_before_device_access = cpu->running;
587:					res = mem->devices[i].f(cpu, mem, paddr,
588:					    data, len, writeflag,
589:					    mem->devices[i].extra);
590:
591:					if (running_before_device_access && !cpu->running)
592:						return MEMORY_ACCESS_FAILED;
593:				}
594:
595:				if (res == 0)
596:					res = -1;
597:
598:				/*
599:				 *  If accessing the memory mapped device
600:				 *  failed, then return with an exception.
601:				 *  (Architecture specific.)
602:				 */
603:				if (res <= 0 && !no_exceptions) {
604:					debug("[ %s device '%s' addr %08lx "
605:					    "failed ]\n", writeflag?
606:					    "writing to" : "reading from",
607:					    mem->devices[i].name, (long)paddr);
608:#ifdef MEM_MIPS
609:					mips_cpu_exception(cpu,
610:					    cache == CACHE_INSTRUCTION?
611:					    EXCEPTION_IBE : EXCEPTION_DBE,
612:					    0, vaddr, 0, 0, 0, 0);
613:#endif
614:#ifdef MEM_M88K
615:					/*  TODO: This is enough for
616:					    OpenBSD/mvme88k's badaddr()
617:					    implementation... but the
618:					    faulting address should probably
619:					    be included somewhere too!  */
620:					m88k_exception(cpu, cache == CACHE_INSTRUCTION
621:					    ? M88K_EXCEPTION_INSTRUCTION_ACCESS
622:					    : M88K_EXCEPTION_DATA_ACCESS, 0);
623:#endif
624:					return MEMORY_ACCESS_FAILED;
625:				}
626:				goto do_return_ok;
627:			}
628:
629:			if (paddr < mem->devices[i].baseaddr)
630:				end = i - 1;
631:			if (paddr >= mem->devices[i].endaddr)
632:				start = i + 1;
633:			i = (start + end) >> 1;
634:		} while (start <= end);
635:	}
750:		    paddr & ~offset_mask);
751:
752:	/*
753:	 *  If writing, or if mapping a page where writing is ok later on,
754:	 *  then invalidate code translations for the (physical) page address:
755:	 */
756:
757:	if ((writeflag == MEM_WRITE
758:	    || (ok == 2 && cache == CACHE_DATA)
759:	    ) && cpu->invalidate_code_translation != NULL)
760:		cpu->invalidate_code_translation(cpu, paddr, INVALIDATE_PADDR);
761:
762:	if ((paddr&((1<<BITS_PER_MEMBLOCK)-1)) + len > (1<<BITS_PER_MEMBLOCK)) {
763:		/*  #165: (Codex/Fable) split accesses that cross a memblock
764:		    boundary (e.g. large DMA transfers) at the boundary,
765:		    instead of exiting the whole emulator.  */
766:		size_t len_head = (size_t) ((1<<BITS_PER_MEMBLOCK) -
767:		    (paddr & ((1<<BITS_PER_MEMBLOCK)-1)));
768:
769:		if (writeflag == MEM_WRITE)
770:			memcpy(memblock + offset, data, len_head);
771:		else
772:			memcpy(data, memblock + offset, len_head);
773:
774:		return MEMORY_RW(cpu, mem, vaddr + len_head, data + len_head,
775:		    len - len_head, writeflag, misc_flags);
776:	}
777:
778:	/*  And finally, read or write the data:  */
779:	if (writeflag == MEM_WRITE)
780:		memcpy(memblock + offset, data, len);
781:	else
782:		memcpy(data, memblock + offset, len);
783:
784:do_return_ok:
785:	return MEMORY_ACCESS_OK;
786:}
