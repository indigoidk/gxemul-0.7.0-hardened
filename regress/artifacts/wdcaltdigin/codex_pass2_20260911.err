160:/*
161: *  wdc_set_io_enabled():
162: *
163: *  Set io_enabled to zero to disable the I/O registers temporarily (e.g.
164: *  used by PCI code in NetBSD to detect whether multiple controllers collide
165: *  in I/O space).
166: *
167: *  Return value is old contents of the io_enabled variable.
168: */
169:int wdc_set_io_enabled(struct wdc_data *d, int io_enabled)
170:{
171:	int old = d->io_enabled;
172:	d->io_enabled = io_enabled;
173:	return old;
174:}
