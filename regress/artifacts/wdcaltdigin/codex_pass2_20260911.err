609:DEVICE_ACCESS(wdc_altstatus)
610:{
611:	struct wdc_data *d = (struct wdc_data *) extra;
612:	uint64_t idata = 0, odata = 0;
613:
614:	idata = data[0];
615:
616:	/*  Same as the normal status byte:  */
