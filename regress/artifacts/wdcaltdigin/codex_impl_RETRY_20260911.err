   210: #define	ATAPI_PKT_CMD_FTRE_OVL	0x02
   211: 
   212: /* ireason */
   213: #define	WDCI_CMD		0x01	/* command(1) or data(0) */
   214: #define	WDCI_IN			0x02	/* transfer to(1) or from(0) the host */
   215: #define	WDCI_RELEASE		0x04	/* bus released until completion */
   216: 
