65: 		idata = memory_readmax64(cpu, data, len);
66: 
67: 	switch (relative_addr) {
68: 	case 0x04:
69: 		break;
70: 	default:/*
71: 		 *  #280: this dummy skeleton models exactly one register --
72: 		 *  0x04, the Main Status Register, handled above -- so every
73: 		 *  other offset lands here, and an ungated fatal() emitted one
74: 		 *  host line per guest access (measured: 1.00 lines/access,
75: 		 *  read and write alike).
76: 		 *
77: 		 *  Gated at DEBUG like #276, NOT latched like #277/#279,
78: 		 *  because the guest IS told: the probe fails through modelled
79: 		 *  behaviour and the OS draws the right conclusion by itself
80: 		 *  ("fdc at pica0 slot 2 offset 0x0 not configured"). A latch
81: 		 *  would be actively wrong here -- fdcprobe's reset pulse is
82: 		 *  TWO writes to reg 2 (0x00, then FDO_FRST), and a latch
83: 		 *  would suppress the second one, the only interesting thing
84: 		 *  this site shows.
85: 		 *
86: 		 *  The write arm's 2+len fatal() calls built ONE line between
87: 		 *  them (only the closer carried the newline); they collapse
88: 		 *  into a single debugmsg with the bytes pre-formatted into a
89: 		 *  buffer sized from the register array, never from len.
90: 		 */
91: 		if (writeflag==MEM_READ) {
92: 			debugmsg(SUBSYS_DEVICE, "fdc", VERBOSITY_DEBUG,
93: 			    "read from reg %i", (int)relative_addr);
94: 			odata = d->reg[relative_addr];
95: 		} else {
96: 			char buf[3 * DEV_FDC_LENGTH + 1];
97: 			size_t p = 0;
98: 
99: 			buf[0] = '\0';
100: 			for (i=0; i<len && i<DEV_FDC_LENGTH; i++)
101: 				p += snprintf(buf + p, sizeof(buf) - p,
102: 				    " %02x", data[i]);
103: 
104: 			debugmsg(SUBSYS_DEVICE, "fdc", VERBOSITY_DEBUG,
105: 			    "write to reg %i:%s", (int)relative_addr, buf);
106: 			d->reg[relative_addr] = idata;
107: 		}
108: 	}
109: 
110: 	if (writeflag == MEM_READ)
111: 		memory_writemax64(cpu, data, len, odata);
112: 
113: 	return 1;
114: }
