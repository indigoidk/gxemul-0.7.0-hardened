594: 	if (d->error)
595: 		odata |= WDCS_ERR;
596: 	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
597: 		odata |= WDCS_DRQ;
598: 	}
599: 	return odata;
