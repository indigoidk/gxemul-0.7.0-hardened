1916: 			odata = (d->sectorsize << 6) + (d->lba << 5) +
1917: 			    (d->drive << 4) + (d->head);
1918: 			debug("[ wdc: read from SDH: 0x%02x (sectorsize %i,"
1919: 			    " lba=%i, drive %i, head %i) ]\n", (int)odata,
1920: 			    d->sectorsize, d->lba, d->drive, d->head);
1921: 		} else {
1922: 			d->sectorsize = (idata >> 6) & 3;
1923: 			d->lba   = (idata >> 5) & 1;
1924: 			d->drive = (idata >> 4) & 1;
1925: 			d->head  = idata & 0xf;
1926: 			debug("[ wdc: write to SDH: 0x%02x (sectorsize %i,"
1927: 			    " lba=%i, drive %i, head %i) ]\n", (int)idata,
1928: 			    d->sectorsize, d->lba, d->drive, d->head);
1929: 		}
1930: 		break;
1931: 
1932: 	case wd_command:	/*  7: command or status  */
1933: 		if (writeflag==MEM_READ) {
1934: 			odata = status_byte(d, cpu);
1935: 			if (!quiet_mode)
1936: 				debug("[ wdc: read from STATUS: 0x%02x ]\n",
1937: 				    (int)odata);
1938: 			INTERRUPT_DEASSERT(d->irq);
1939: 			d->int_assert = 0;
1940: 		} else {
1941: 			debug("[ wdc: write to COMMAND: 0x%02x ]\n",(int)idata);
1942: 			wdc_command(cpu, d, idata);
1943: 		}
1944: 		break;
1945: 
1946: 	default:
1947: 		if (writeflag==MEM_READ)
1948: 			debug("[ wdc: read from 0x%02x ]\n",
1949: 			    (int)relative_addr);
1950: 		else
1951: 			debug("[ wdc: write to  0x%02x: 0x%02x ]\n",
1952: 			    (int)relative_addr, (int)idata);
1953: 	}
1954: 
1955: 	/*  Assert interrupt, if necessary:  */
1956: 	dev_wdc_tick(cpu, extra);
1957: 
1958: ret:
1959: 	if (writeflag == MEM_READ) {
1960: 		if (relative_addr == wd_data)
1961: 			memory_writemax64(cpu, data, len, odata);
1962: 		else {
1963: 			/*  #464: latch the announcement only.  This sits
1964: 			    INSIDE the function's common `ret:` tail, so
1965: 			    `data[0] = odata` and the `return 1` below must run
1966: 			    regardless -- an early return here would hand the
1967: 			    guest an untouched read buffer.  */
1968: 			if (len != 1 && !d->warned_nonbyte_read) {
1969: 				d->warned_nonbyte_read = 1;
1970: 				fatal("[ wdc: WARNING! non-8-bit access on "
1971: 				    "READ! ]\n");
1972: 			}
1973: 			data[0] = odata;
1974: 		}
1975: 	}
1976: 
1977: 	return 1;
1978: }
1979: 
1980: 
1981: DEVINIT(wdc)
1982: {
1983: 	struct wdc_data *d;
1984: 	uint64_t alt_status_addr;
1985: 	int i, tick_shift = WDC_TICK_SHIFT;
1986: 
1987: 	CHECK_ALLOCATION(d = (struct wdc_data *) malloc(sizeof(struct wdc_data)));
1988: 	memset(d, 0, sizeof(struct wdc_data));
1989: 
1990: 	INTERRUPT_CONNECT(devinit->interrupt_path, d->irq);
1991: 	d->addr_mult  = devinit->addr_mult;
1992: 	d->data_debug = 1;
1993: 	d->io_enabled = 1;
1994: 	d->error      = 1;
1995: 
1996: 	d->inbuf = (unsigned char *) zeroed_alloc(WDC_INBUF_SIZE);
1997: 
1998: 	/*  base_drive = 0 for the primary controller, 2 for the secondary.  */
1999: 	d->base_drive = 0;
2000: 	if ((devinit->addr & 0xfff) == 0x170)
2001: 		d->base_drive = 2;
2002: 
2003: 	alt_status_addr = devinit->addr + 0x206;
2004: 
2005: 	/*  Special hacks for individual machines:  */
2006: 	switch (devinit->machine->machine_type) {
2007: 	case MACHINE_MACPPC:
2008: 		alt_status_addr = devinit->addr + 0x160;
2009: 		break;
2010: 	case MACHINE_HPCMIPS:
2011: 		/*  TODO: Fix  */
2012: 		if (devinit->addr == 0x14000180)
2013: 			alt_status_addr = 0x14000386;
2014: 		break;
2015: 	case MACHINE_IQ80321:
2016: 		alt_status_addr = devinit->addr + 0x402;
2017: 		break;
2018: 	}
2019: 
2020: 	/*  Get disk geometries:  */
2021: 	for (i=0; i<2; i++)
2022: 		if (diskimage_exist(devinit->machine, d->base_drive +i,
2023: 		    DISKIMAGE_IDE))
2024: 			diskimage_getchs(devinit->machine, d->base_drive + i,
2025: 			    DISKIMAGE_IDE, &d->cyls[i], &d->heads[i],
2026: 			    &d->sectors_per_track[i]);
2027: 
2028: 	memory_device_register(devinit->machine->memory, "wdc_altstatus",
2029: 	    alt_status_addr, 2, dev_wdc_altstatus_access, d, DM_DEFAULT, NULL);
2030: 	memory_device_register(devinit->machine->memory, devinit->name,
2031: 	    devinit->addr, DEV_WDC_LENGTH * devinit->addr_mult, dev_wdc_access,
2032: 	    d, DM_DEFAULT, NULL);
2033: 
2034: 	machine_add_tickfunction(devinit->machine, dev_wdc_tick,
2035: 	    d, tick_shift);
2036: 
2037: 	devinit->return_ptr = d;
2038: 
2039: 	return 1;
2040: }
