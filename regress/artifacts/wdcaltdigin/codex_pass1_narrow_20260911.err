  133: BASE_BIN = sys.argv[1] if len(sys.argv) > 1 else "/tmp/gxaltoff/base/gxemul"
  134: FIX_BIN = sys.argv[2] if len(sys.argv) > 2 else "/tmp/gxaltoff/fix/gxemul"
  135: DISK = sys.argv[3] if len(sys.argv) > 3 else "/tmp/gxaltoff/altoff-scratch.img"
