  578: /*
  579:  *  status_byte():
  580:  *
  581:  *  Return a reasonable status byte corresponding to the controller's current
  582:  *  state.
  583:  */
  584: static int status_byte(struct wdc_data *d, struct cpu *cpu)
  585: {
  586: 	int odata = 0;
  587: 	if (diskimage_exist(cpu->machine, d->drive + d->base_drive,
  588: 	    DISKIMAGE_IDE))
  589: 		odata |= WDCS_DRDY | WDCS_DSC;
  590: 	if (d->inbuf_head != d->inbuf_tail)
  591: 		odata |= WDCS_DRQ;
  592: 	if (d->write_in_progress)
  593: 		odata |= WDCS_DRQ;
  594: 	if (d->error)
  595: 		odata |= WDCS_ERR;
  596: 	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
  597: 		odata |= WDCS_DRQ;
  598: 	}
  599: 	return odata;
  600: }
