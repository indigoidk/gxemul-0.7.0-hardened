  177: /*
  178:  *  wdc_addtoinbuf():
  179:  *
  180:  *  Write to the inbuf at its head, read at its tail.
  181:  */
  182: static void wdc_addtoinbuf(struct wdc_data *d, int c)
  183: {
  184: 	/*  #484: REFUSE BEFORE THE STORE.  The invariant this establishes is
  185: 	    THE RING'S OCCUPANCY IS SOUND -- deliberately not the weaker "full is
  186: 	    distinguishable from empty".  MANY sites depend on the first and only
  187: 	    this function implements the second; the readers are derivable at any
  188: 	    commit with
  189: 	
  190: 	        grep -n 'inbuf_head [=!]= d->inbuf_tail' dev_wdc.c   (and the
  191: 	        reversed and subtractive forms; one site writes tail - head)
  192: 	
  193: 	    rather than from a number here.  An earlier draft wrote SIX while the
  194: 	    checkpoint said FOUR, and the two cannot be reconciled without first
  195: 	    deciding whether to count SITES or DECISIONS -- which is how the wrong
  196: 	    number got written in the first place.  A count in a comment ages; a
  197: 	    deriver does not.  Naming the WEAK property here would invite a later
  198: 	    edit to trade the strong one away, which is the whole reason the
  199: 	    invariant is stated as occupancy rather than as distinguishability.
  200: 	
  201: 	    One slot is sacrificed, so head == tail now means EMPTY, full stop, and
  202: 	    every reader below becomes sound with no struct change and no new field.
  203: 	    Modelled on dev_pckbc.c's pckbc_add_code(), which refuses at
  204: 	    next == tail for exactly this defect (#288).
  205: 	
  206: 	    *** THE RETURN IS OUTSIDE THE LATCH, AND THAT IS NOT A STYLE CHOICE.
  207: 	    ***  Nested inside it, the FIRST overflow is refused and every later
  208: 	    push sees warned_inbuf_overrun == 1, skips the whole condition, and
  209: 	    walks head onto tail -- the defect restored.  Measured as mutant Md3,
  210: 	    13/16 in the panel seat's own table (its Md3), and 12/15 when I rebuilt
  211: 	    it against these bytes as Md_inside -- DIFFERENT TABLES, and the figure is
  212: 	    cited with the one that produced it rather than blended.  Both tables kill
  213: 	    it, which is the claim.  wdc_get_inbuf() below already forbids the same
  214: 	    shape in the
  215: 	    CONSUMER for the same reason, so a maintainer copying that function's
  216: 	    structure into this one writes the bug by accident.
  217: 	
  218: 	    Written WITHOUT an `int next` temporary on purpose.  The obvious form
  219: 	    (`next = (head+1) % SIZE; ... head = next;`) deletes the masked advance
  220: 	    below and makes the mask inside `next` safety-critical; dropping it is a
  221: 	    one-token simplification and measured as an actual heap overflow
  222: 	    (`free(): invalid next size`).  Keeping both statements untouched makes
  223: 	    that edit inexpressible as a SINGLE change -- though not impossible: the
  224: 	    modulo in the advance statement below is still removable on its own.
  225: 	    What it closes is the obvious consolidation path, which is what a
  226: 	    maintainer actually takes.
  227: 	
  228: 	    Drop-NEWEST, not drop-oldest, by reason: the surviving consumers key on
  229: 	    the FRONT of the stream (the CDB dispatch reads bytes 0-11; the sector
  230: 	    drain reads aligned runs from tail), so overwriting the oldest byte
  231: 	    silently re-aims a 512-byte disk write at data the guest never staged
  232: 	    there.  Both in-tree ring precedents drop newest.  Measured: drop-oldest
  233: 	    scores 13/16 IN THE PANEL SEAT'S TABLE (its Md4) and is invisible to every
  234: 	    occupancy- and DRQ-shaped row there.  I did NOT rebuild that mutant against
  235: 	    these bytes, so it is cited as the seat's measurement and not as this
  236: 	    round's -- artifacts/wdcringambig/killtable_20260827/.
  237: 	
  238: 	    COST, measured and named rather than discovered later: WDC_INBUF_SIZE is
  239: 	    512*513, so the saturated occupancy 262655 is never 0 (mod 512) while the
  240: 	    old 262656 always was.  A saturated ring's pending sector write therefore
  241: 	    stalls instead of committing its oldest sector.  It is reachable only
  242: 	    through the width-mixing pathology that fills the ring in the first
  243: 	    place, and a stalled write is strictly better than a write of bytes the
  244: 	    guest did not supply.  */
  245: 	if ((d->inbuf_head + 1) % WDC_INBUF_SIZE == d->inbuf_tail) {
  246: 		if (!d->warned_inbuf_overrun) {
  247: 			d->warned_inbuf_overrun = 1;
  248: 			fatal("[ wdc_addtoinbuf(): WARNING! wdc inbuf overrun!"
  249: 			    " Increase WDC_MAX_SECTORS. ]\n");
  250: 		}
  251: 		return;
  252: 	}
  253: 
  254: 	d->inbuf[d->inbuf_head] = c;
  255: 
  256: 	d->inbuf_head = (d->inbuf_head + 1) % WDC_INBUF_SIZE;
  257: 	/*  #484: the #464 POST-HOC check that stood here is DELETED, and the
  258: 	    warrant is a measurement rather than an argument.
  259: 
  260: 	    It tested `head == tail` AFTER the advance.  The guard at the top of
  261: 	    this function makes `(head + 1) % SIZE != tail` a precondition of
  262: 	    reaching the store, so after the advance head != tail always: the
  263: 	    branch was unreachable.  MEASURED TRUE 0 TIMES across 12,232 producer
  264: 	    refusals over the whole 122-row suite.
  265: 
  266: 	    *** IT WAS KEPT AT FIRST, ON THE WARRANT THAT DEAD CODE WITH A TRUE
  267: 	    COMMENT COSTS NOTHING.  THE COMMENT WAS FALSE IN FOUR CLAIMS. ***  It
  268: 	    said head == tail means both empty and full with no disambiguator
  269: 	    (this round added one); that the corrupting store is the next one and
  270: 	    is silent (it is now refused and announced); that the bulk paths never
  271: 	    compare the pointers (one now does); and that no detector row claims
  272: 	    ring health (R1-R9 claim exactly that).  A maintainer reading it would
  273: 	    have concluded the ring is still ambiguous.  Removing code needs a
  274: 	    warrant in this fork, and a measured-dead branch under a four-times-
  275: 	    false comment is the clearest one there is.  */
  276: }
  277: 
  278: 
  279: /*
  280:  *  wdc_get_inbuf():
  281:  *
  282:  *  Read from the tail of inbuf.
  283:  */
  284: static uint64_t wdc_get_inbuf(struct wdc_data *d)
  285: {
  286: 	int c = d->inbuf[d->inbuf_tail];
  287: 
  288: 	if (d->inbuf_head == d->inbuf_tail) {
  289: 		/*  #464: the guard wraps the fatal() ONLY.
  290: 		    *** THE `return` MUST STAY OUTSIDE IT. ***  Nested inside,
  291: 		    the SECOND over-read falls through to the tail advance
  292: 		    below and corrupts the ring pointer -- a fix strictly worse
  293: 		    than the flood it removes.  Row `overread -1` pins it.
  294: 		    See `wdcringambig`: BEFORE #484 this predicate was unsound
  295: 		    after an overrun, because a FULL ring was indistinguishable
  296: 		    from an empty one; #484 sacrifices one slot, so head == tail
  297: 		    now means EMPTY (stale wording corrected 2026-09-05).  */
  298: 		if (!d->warned_inbuf_overread) {
  299: 			d->warned_inbuf_overread = 1;
  300: 			fatal("[ wdc: WARNING! someone is reading too much "
  301: 			    "from the wdc inbuf! ]\n");
  302: 		}
  303: 		return (uint64_t) -1;
  304: 	}
  305: 
  306: 	d->inbuf_tail = (d->inbuf_tail + 1) % WDC_INBUF_SIZE;
  307: 	return c;
  308: }
  309: 
  310: 
  311: /*
  312:  *  wdc_initialize_identify_struct():
  313:  */
  314: static void wdc_initialize_identify_struct(struct cpu *cpu, struct wdc_data *d)
  315: {
  316: 	uint64_t total_size;
  317: 	int flags, cdrom = 0;
  318: 	char namebuf[40];
  319: 
  320: 	total_size = diskimage_getsize(cpu->machine, d->drive + d->base_drive,
  321: 	    DISKIMAGE_IDE);
  322: 	if (diskimage_is_a_cdrom(cpu->machine, d->drive + d->base_drive,
  323: 	    DISKIMAGE_IDE))
  324: 		cdrom = 1;
  325: 
  326: 	memset(d->identify_struct, 0, sizeof(d->identify_struct));
  327: 
  328: 	/*  Offsets are in 16-bit WORDS!  High byte, then low.  */
  329: 
  330: 	/*  0: general flags  */
  331: 	flags = 1 << 6;	/*  Fixed  */
  332: 	if (cdrom)
  333: 		flags = 0x8580;		/*  ATAPI, CDROM, removable  */
  334: 	d->identify_struct[2 * 0 + 0] = flags >> 8;
  335: 	d->identify_struct[2 * 0 + 1] = flags;
  336: 
  337: 	/*  1: nr of cylinders  */
  338: 	d->identify_struct[2 * 1 + 0] = d->cyls[d->drive] >> 8;
  339: 	d->identify_struct[2 * 1 + 1] = d->cyls[d->drive];
  340: 
  341: 	/*  3: nr of heads  */
  342: 	d->identify_struct[2 * 3 + 0] = d->heads[d->drive] >> 8;
  343: 	d->identify_struct[2 * 3 + 1] = d->heads[d->drive];
  344: 
  345: 	/*  6: sectors per track  */
  346: 	d->identify_struct[2 * 6 + 0] = d->sectors_per_track[d->drive] >> 8;
  347: 	d->identify_struct[2 * 6 + 1] = d->sectors_per_track[d->drive];
  348: 
  349: 	/*  10-19: Serial number  */
  350: 	memcpy(&d->identify_struct[2 * 10], "#0                  ", 20);
  351: 
  352: 	/*  23-26: Firmware version  */
  353: 	memcpy(&d->identify_struct[2 * 23], "1.0     ", 8);
  354: 
  355: 	/*  27-46: Model number  */
  356: 	if (diskimage_getname(cpu->machine, d->drive + d->base_drive,
  357: 	    DISKIMAGE_IDE, namebuf, sizeof(namebuf))) {
  358: 		size_t i;
  359: 		for (i=0; i<sizeof(namebuf); i++)
  360: 			if (namebuf[i] == 0) {
  361: 				for (; i<sizeof(namebuf); i++)
  362: 					namebuf[i] = ' ';
  363: 				break;
  364: 			}
  365: 		memcpy(&d->identify_struct[2 * 27], namebuf, 40);
  366: 	} else
  367: 		memcpy(&d->identify_struct[2 * 27],
  368: 		    "Fake GXemul IDE disk                    ", 40);
  369: 
  370: 	/*  47: max sectors per multitransfer  */
  371: 	d->identify_struct[2 * 47 + 0] = 0x80;
  372: 	d->identify_struct[2 * 47 + 1] = 128;
  373: 
  374: 	/*  49: capabilities:  */
  375: 	/*  (0x200 = LBA, 0x100 = DMA support.)  */
  376: 	d->identify_struct[2 * 49 + 0] = 0;
  377: 	d->identify_struct[2 * 49 + 1] = 0;
  378: 
  379: 	/*  51: PIO timing mode.  */
  380: 	d->identify_struct[2 * 51 + 0] = 0x00;	/*  ?  */
  381: 	d->identify_struct[2 * 51 + 1] = 0x00;
  382: 
  383: 	/*  53: 0x02 = fields 64-70 valid, 0x01 = fields 54-58 valid  */
  384: 	d->identify_struct[2 * 53 + 0] = 0x00;
  385: 	d->identify_struct[2 * 53 + 1] = 0x02;
  386: 
  387: 	/*
  388: 	 *  #405: `% 255` where `& 255` is meant, on six of these eight lines.
  389: 	 *
  390: 	 *  The two that were already right are the ones whose operand is small:
  391: 	 *  `(sectors) & 255` cannot exceed a byte anyway. Every other line shifts
  392: 	 *  first and does NOT pre-mask, so its operand is a multi-byte quantity and
  393: 	 *  `% 255` is not byte extraction that occasionally coincides -- it is a
  394: 	 *  base-256 digit sum. Measured in closed form, 0 counterexamples over 2^26:
  395: 	 *      x % 255 == ((x >> 8) + (x & 255)) % 255
  396: 	 *
  397: 	 *  So this is not a rare corner. Above the threshold it is wrong 100.0000%
  398: 	 *  of the time; the 0.39% of sizes where the >>8 byte is accidentally right
  399: 	 *  are exactly the ones where >>16 is wrong. The announced capacity lands
  400: 	 *  either side of the truth, worst case reporting ZERO SECTORS.
  401: 	 *
  402: 	 *  Smallest size at which any byte diverges is 65,280 sectors -- but
  403: 	 *  diskimage_recalc_size()'s closing whole-cylinder round-up (the shared
  404: 	 *  bytespercyl block, hoisted there by #414) rounds every image up to
  405: 	 *  whole cylinders, so that exact count is unreachable. The smallest
  406: 	 *  REACHABLE divergence is 33,546,240 bytes (65 cylinders), where a 32 MB
  407: 	 *  disk announces itself as 120 KB.
  408: 	 *
  409: 	 *  The byte order is NOT a second defect and was deliberately left alone.
  410: 	 *  The convention is stated at the top of this function ("Offsets are in
  411: 	 *  16-bit WORDS!  High byte, then low"), the geometry words follow it, the
  412: 	 *  transmit loop in wdc_command()'s WDCC_IDENTIFY case pushes [i+1] before
  413: 	 *  [i+0], and dev_wdc_access()'s wd_data read reassembles (high << 8) | low.
  414: 	 *  Two panel seats called it a defect from the snippet alone; two that read
  415: 	 *  the file found it consistent, and a later pass CONFIRMED it by executing
  416: 	 *  the whole guest path: both the LE and BE branches, plus memory_writemax64,
  417: 	 *  land the SAME two bytes in guest memory, so the device layer is
  418: 	 *  byte-stream-preserving. The 57-vs-58 WORD order is not establishable from
  419: 	 *  this tree at all -- there is no ATA specification here -- so a mask-only
  420: 	 *  correction is exactly as much as the source can justify.
  421: 	 *
  422: 	 *  #408: THE CITATIONS ABOVE NAME CONSTRUCTS, NOT LINE NUMBERS, AND THAT IS
  423: 	 *  DELIBERATE.  #405 cited lines that its own inserted comment had shifted by
  424: 	 *  +31.  #407 wrote a correction saying "re-read every line reference AFTER
  425: 	 *  the edit is in place" -- and then made the identical error, because that
  426: 	 *  correction was itself +9 lines and every number it "fixed" was re-read from
  427: 	 *  the pre-edit file.  Two rounds, same mechanism, and the second one had the
  428: 	 *  lesson written down in front of it.  A line number inside a file the same
  429: 	 *  commit edits is measured against the file it was written in, not the one
  430: 	 *  that ships; naming the construct survives every future edit instead.
  431: 	 */
  432: 	/*  57-58: current capacity in sectors  */
  433: 	d->identify_struct[2 * 58 + 0] = ((total_size / 512) >> 24) & 255;
  434: 	d->identify_struct[2 * 58 + 1] = ((total_size / 512) >> 16) & 255;
  435: 	d->identify_struct[2 * 57 + 0] = ((total_size / 512) >> 8) & 255;
  436: 	d->identify_struct[2 * 57 + 1] = (total_size / 512) & 255;
  437: 
  438: 	/*  60-61: total nr of addressable sectors  */
  439: 	d->identify_struct[2 * 61 + 0] = ((total_size / 512) >> 24) & 255;
  440: 	d->identify_struct[2 * 61 + 1] = ((total_size / 512) >> 16) & 255;
  441: 	d->identify_struct[2 * 60 + 0] = ((total_size / 512) >> 8) & 255;
  442: 	d->identify_struct[2 * 60 + 1] = (total_size / 512) & 255;
  443: 
  444: 	/*  64: Advanced PIO mode support. 0x02 = mode4, 0x01 = mode3  */
  445: 	d->identify_struct[2 * 64 + 0] = 0x00;
  446: 	d->identify_struct[2 * 64 + 1] = 0x03;
  447: 
  448: 	/*  67, 68: PIO timing  */
  449: 	d->identify_struct[2 * 67 + 0] = 0;
  450: 	d->identify_struct[2 * 67 + 1] = 120;
  451: 	d->identify_struct[2 * 68 + 0] = 0;
  452: 	d->identify_struct[2 * 68 + 1] = 120;
  453: }
  454: 
  455: 
  456: /*
  457:  *  wdc__read():
  458:  */
  459: void wdc__read(struct cpu *cpu, struct wdc_data *d)
  460: {
  461: #define MAX_SECTORS_PER_CHUNK	64
  462: 	const int max_sectors_per_chunk = MAX_SECTORS_PER_CHUNK;
  463: 	unsigned char buf[512 * MAX_SECTORS_PER_CHUNK];
  464: 	int i, cyl = d->cyl_hi * 256+ d->cyl_lo;
  465: 	int count = d->seccnt? d->seccnt : 256;
  466: 	uint64_t offset = 512 * (d->sector - 1
  467: 	    + (int64_t)d->head * d->sectors_per_track[d->drive] +
  468: 	    (int64_t)d->heads[d->drive] * d->sectors_per_track[d->drive] * cyl);
  469: 
  470: #if 0
  471: 	/*  LBA:  */
  472: 	if (d->lba)
  473: 		offset = 512 * (((d->head & 0xf) << 24) + (cyl << 8)
  474: 		    + d->sector);
  475: 	printf("WDC read from offset %lli\n", (long long)offset);
  476: #endif
  477: 
  478: 	while (count > 0) {
  479: 		int to_read = count > max_sectors_per_chunk?
  480: 		    max_sectors_per_chunk : count;
  481: 
  482: 		/*  TODO: result code from the read?  */
  483: 
  484: 		/*  #484: AN OCCUPANCY BOUND.  The test below is a BUFFER bound -- does
  485: 		    the linear write fit inside the allocation -- and it is NOT an
  486: 		    occupancy bound: this arm bypasses wdc_addtoinbuf() entirely and
  487: 		    compares the two pointers nowhere, so it can step head past tail and
  488: 		    overwrite unread bytes in silence.
  489: 
  490: 		    MEASURED, AND THE QUALIFIER IS PART OF THE MEASUREMENT: driving the
  491: 		    FUNCTION with a prefilled ring gives occupancy 262156 -> 1548, a
  492: 		    plausible-looking number, with 1548 bytes of unread data replaced by
  493: 		    disk contents.
  494: 
  495: 		    *** BUT 'REACHABLE' IS THE WRONG WORD AND THE READING SEATS WERE RIGHT
  496: 		    ABOUT THE PRODUCT. ***  `wdc__read()` has exactly ONE caller and it sits
  497: 		    AFTER `wdc_new_command_reset()`, so the ring is EMPTY on every real
  498: 		    invocation.  The prefilled state the rows build is a FUNCTION state, not
  499: 		    a guest route.  The arm is occupancy-blind AS CODE; this guard is
  500: 		    DEFENSIVE, and it is licensed by the caller invariant being unwritten
  501: 		    anywhere else -- not by a live defect.  A second seat then MEASURED
  502: 		    that too: 512 READ/READMULTI commands driven only through the guest
  503: 		    register interface, ring pre-stuffed each time, reached this guard
  504: 		    1280 times and FIRED IT ZERO TIMES.
  505: 		
  506: 		    The `- 1` is the sacrificed slot and is load-bearing: without it this
  507: 		    guard admits a refill of exactly room+1 bytes, which is the ONLY input
  508: 		    that distinguishes the two forms (measured 15/16, one row).
  509: 		
  510: 		    It is the SAME admission predicate as the producer's, and that is the
  511: 		    reason both hunks are one round: split them and the two arms disagree
  512: 		    about what "full" means, which is an incoherence the split itself
  513: 		    creates.  */
  514: 		if (512 * to_read > (d->inbuf_tail - d->inbuf_head - 1 +
  515: 		    WDC_INBUF_SIZE) % WDC_INBUF_SIZE) {
  516: 			if (!d->warned_inbuf_overrun) {
  517: 				d->warned_inbuf_overrun = 1;
  518: 				/*  #484: names THIS function, not the producer.  The
  519: 				    shared latch already removes the only other way to
  520: 				    tell the two sites apart, so a message pointing at
  521: 				    a guard that did not fire is a wrong record in
  522: 				    product output.  */
  523: 				fatal("[ wdc__read(): WARNING! wdc inbuf would"
  524: 				    " overrun; refill refused. Increase"
  525: 				    " WDC_MAX_SECTORS. ]\n");
  526: 			}
  527: 			break;
  528: 		}
  529: 
  530: 		if (d->inbuf_head + 512 * to_read <= WDC_INBUF_SIZE) {
  531: 			diskimage_access(cpu->machine, d->drive + d->base_drive,
  532: 			    DISKIMAGE_IDE, 0, offset,
  533: 			    d->inbuf + d->inbuf_head, 512 * to_read);
  534: 			d->inbuf_head += 512 * to_read;
  535: 			if (d->inbuf_head == WDC_INBUF_SIZE)
  536: 				d->inbuf_head = 0;
  537: 		} else {
  538: 			diskimage_access(cpu->machine, d->drive + d->base_drive,
  539: 			    DISKIMAGE_IDE, 0, offset, buf, 512 * to_read);
  540: 			for (i=0; i<512 * to_read; i++)
  541: 				wdc_addtoinbuf(d, buf[i]);
  542: 		}
  543: 
  544: 		offset += 512 * to_read;
  545: 		count -= to_read;
  546: 	}
  547: 
  548: 	d->int_assert = 1;
  549: }
  550: 
  551: 
  552: /*
  553:  *  wdc__write():
  554:  */
  555: void wdc__write(struct cpu *cpu, struct wdc_data *d)
  556: {
  557: 	int cyl = d->cyl_hi * 256+ d->cyl_lo;
  558: 	int count = d->seccnt? d->seccnt : 256;
  559: 	uint64_t offset = 512 * (d->sector - 1
  560: 	    + (int64_t)d->head * d->sectors_per_track[d->drive] +
  569: 
  570: 	d->write_in_progress = d->cur_command;
  571: 	d->write_count = count;
  572: 	d->write_offset = offset;
  573: 
  574: 	/*  TODO: result code?  */
  575: }
  576: 
  577: 
  578: /*
  579:  *  status_byte():
  580:  *
  581:  *  Return a reasonable status byte corresponding to the controller's current
  582:  *  state.
  583:  */
  584: static int status_byte(struct wdc_data *d, struct cpu *cpu)
  585: {
  586: 	int odata = 0;
  587: 	if (diskimage_exist(cpu->machine, d->drive + d->base_drive,
  588: 	    DISKIMAGE_IDE))
  589: 		odata |= WDCS_DRDY | WDCS_DSC;
  590: 	if (d->inbuf_head != d->inbuf_tail)
  591: 		odata |= WDCS_DRQ;
  592: 	if (d->write_in_progress)
  593: 		odata |= WDCS_DRQ;
  594: 	if (d->error)
  595: 		odata |= WDCS_ERR;
  596: 	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
  597: 		odata |= WDCS_DRQ;
  598: 	}
  599: 	return odata;
  600: }
  601: 
  602: 
  603: /*  #481: forward-declared so the ALT-CTRL arm below can call it.  A panel seat's
  604:     control mutant failed to compile for want of exactly this line and the failure
  605:     was briefly read as a design constraint against calling the shared helper; it
  606:     is one line and it builds clean.  */
  607: static void wdc_new_command_reset(struct wdc_data *d);
  608: 
  609: DEVICE_ACCESS(wdc_altstatus)
  610: {
  611: 	struct wdc_data *d = (struct wdc_data *) extra;
  612: 	uint64_t idata = 0, odata = 0;
  613: 
  614: 	idata = data[0];
  615: 
  616: 	/*  Same as the normal status byte:  */
  617: 	odata = status_byte(d, cpu);
  618: 
  619: 	if (writeflag==MEM_READ)
  620: 		debug("[ wdc: read from ALTSTATUS: 0x%02x ]\n",
  621: 		    (int)odata);
  622: 	else if (relative_addr != 0) {
  623: 		/*  #494: THE HANDLER NEVER DECODED ITS OWN OFFSET.  The region is
  624: 		    registered TWO BYTES wide, so offset 1 -- the Drive Address
  625: 		    register, 0x3f7 on the PC layout -- arrived here and was treated
  626: 		    as a Device Control write.  Since #481 corrected the reset bit,
  627: 		    that meant a guest store to a READ-ONLY register aborted a live
  628: 		    ATA write and purged the queued ring.  Measured at rung 3 on an
  629: 		    unmodified evbmips -e malta; the witness is preserved under
  630: 		    regress/artifacts/wdcaltoffset/witness_20260829/.
  631: 
  632: 		    THE WHOLE ACTION IS DECLINED, NOT JUST THE HELPER CALL, AND THAT
  633: 		    IS THE POINT.  The reset has two effects with two owners: the
  634: 		    cur_command assignment below, and the ring/DRQ clearing inside
  635: 		    wdc_new_command_reset().  A fix that guards only the helper leaves
  636: 		    the ATAPI signature latched.  That was MEASURED, not reasoned: it
  637: 		    escapes the witness AND the detector that replaced it with a clean
  638: 		    sweep, because every row in both observes DRQ or the ring and
  639: 		    neither varies under it.  The kill table and its scores are under
  640: 		    regress/artifacts/wdcaltoffset/killtable_20260830/ -- read TABLE.txt
  641: 		    for the counts rather than trusting a number written here, which is
  642: 		    how this sentence was wrong once already.
  643: 
  644: 		    SILENT BY DESIGN, at debug() level and with no latch.  The house
  645: 		    idiom announces a guest ANOMALY, and this is not one: the tree
  646: 		    records in two places that this byte belongs to the floppy
  647: 		    controller on PCs -- wdcreg.h compiles wd_digin out under
  648: 		    an `#if 0` whose own note reads "NOT MAPPED; fd uses this
  649: 		    register on PCs" (the delimiters are dropped here on purpose:
  650: 		    a comment terminator quoted inside a comment ends it), and
  651: 		    dev_fdc.c's DEV_FDC_LENGTH carries `TODO 8, but collision with
  652: 		    wdc`.  A correct guest writes here expecting a floppy effect, so
  653: 		    a wdc diagnostic would report correct behaviour as a fault.
  654: 
  655: 		    THE ACCESS STAYS HANDLED (return 1), AND THE REASON IS NOT THE ONE
  656: 		    THIS COMMENT FIRST GAVE.  It said a 0 would fall through to
  657: 		    unassigned-address handling and warn per access.  That is false: this
  658: 		    device is REGISTERED, so a 0 never reaches that path.  memory_rw sets
  659: 		    res = -1, takes its res <= 0 branch, and raises EXCEPTION_DBE --
  660: 		    measured, 19793 `device 'wdc_altstatus' ... failed` lines and ZERO
  661: 		    `non-existant` ones under -v.  The guest then loops forever
  662: 		    re-executing the faulting store, and at DEFAULT verbosity it does so
  663: 		    in SILENCE.  That is worse than a warning flood, not better, which is
  664: 		    why the wrong reason was worth correcting rather than dropping: a
  665: 		    maintainer who reads `only noisy warnings` may decide a 0 is fine.
  666: 
  667: 		    The arm falls through to the common tail, which is a no-op for it --
  668: 		    the tail only assigns on the READ path.  (An earlier draft justified
  669: 		    that by the untouched-buffer hazard; #95 already zeroes the caller's
  670: 		    buffer, so that hazard cannot arise here either.)  */
  671: 		debug("[ wdc: write to DRIVE ADDRESS (read-only): 0x%02x,"
  672: 		    " ignored ]\n", (int)idata);
  673: 	} else {
  674: 		debug("[ wdc: write to ALT. CTRL: 0x%02x ]\n",
  675: 		    (int)idata);
  676: 		/*  #481: THE RESET BIT IS WDCTL_RST (0x04), NOT WDCTL_4BIT (0x08).
  677: 		
  678: 		    WDCTL_4BIT is "use four head bits (wd1003)", a head-addressing
  679: 		    mode selector that Linux libata holds as its STEADY-STATE ap->ctl.
  680: 		    Testing it here meant three measured defects at once:
  681: 		
  682: 		      * a real soft reset was MISSED.  Older OpenBSD asserts with 0x06,
  683: 		        which has bit 3 CLEAR -- measured `cur_command 0x0`.
  684: 		      * a ROUTINE control write DESTROYED THE RECORD OF WHICH COMMAND IS
  685: 		        EXECUTING -- measured `0xec -> 0x100`.  cur_command is also the
  686: 		        value assigned into write_in_progress, so this is only harmless
  687: 		        because wdc__write() has exactly ONE caller, immediately after
  688: 		        the assignment.  An accident, not an invariant.
  689: 		      * an nIEN write latched a reset.  0x0a is libata's polled-mode
  690: 		        staple -- measured `0x0a->0x100`.
  691: 		
  692: 		    COMMAND_RESET IS NOT A RESET ACTION.  It is read at exactly two
  693: 		    sites, both making the cylinder registers return the ATAPI signature
  694: 		    0xEB14 for a CD-ROM.  It is the SIGNATURE LATCH -- which is why the
  695: 		    wrong bit went unnoticed: triggering on libata's steady state kept
  696: 		    the signature on almost always.
  697: 		
  698: 		    LEVEL-TRIGGERED, DELIBERATELY, AND THE MEASURED DIFFERENCE
  699: 		    FAVOURS THIS FORM.  A channel held in reset must not carry bytes
  700: 		    out the far side, and an edge-triggered abort lets it:
  701: 		
  702: 		        assert 0x0e, 8 guest stores to DATA, rewrite 0x0e, release
  703: 		          LEVEL (this form):  occ 0, DRQ 0   -- the ring is purged
  704: 		          EDGE:               occ 8, DRQ 1   -- the bytes survive the
  705: 		                                                 whole reset, and the
  706: 		                                                 status byte still
  707: 		                                                 advertises DRQ
  708: 		
  709: 		    Measured through register writes only, with a liveness control (the
  710: 		    same traffic without a reset leaves occ 8, so the 0 is the reset
  711: 		    working and not a dead path).
  712: 		
  713: 		    *** AN EARLIER VERSION OF THIS COMMENT SAID edge and level were
  714: 		    "indistinguishable here, because the abort is idempotent and no
  715: 		    protocol-following driver issues commands while holding SRST".
  716: 		    THAT WAS MEASURED FALSE.  Three things were wrong with it:
  717: 		
  718: 		      * the differential behind it only ever asserted SRST ONCE, and
  719: 		        the forms differ only when a driver HOLDS it across two
  720: 		        control writes with something accruing in between;
  721: 		      * IDEMPOTENCE OF THE HELPER DOES NOT LICENCE THE INFERENCE.
  722: 		        It means repeating the abort is harmless.  It says nothing
  723: 		        about SKIPPING the repeat, which is what an edge does, and
  724: 		        state accrues between the writes;
  725: 		      * the scenario above ISSUES NO COMMAND.  Plain data-register
  726: 		        stores suffice -- and in a hardening fork the guest need not
  727: 		        be protocol-following at all.
  728: 		
  729: 		    The decision is unchanged and now rests on evidence that does not
  730: 		    collapse when someone builds the discriminating case. ***
  731: 		
  732: 		    Note also that a prev_ctl update mis-scoped by one brace makes
  733: 		    every LATER reset be ignored -- a failure this form cannot have --
  734: 		    but that is a secondary argument, not the reason.
  735: 		
  736: 		    THE ABORT IS #479's HELPER, not a second one: a channel reset and a
  737: 		    new command must not disagree about what gets cleared, and #479
  738: 		    already reasoned out which latches must SURVIVE (see its comment --
  739: 		    clearing warned_* would undo #337 and #464).  */
  740: 		if (idata & WDCTL_RST) {
  741: 			d->cur_command = COMMAND_RESET;
  742: 			wdc_new_command_reset(d);
  743: 		}
  744: 	}
  745: 
  746: 	if (writeflag == MEM_READ)
  747: 		data[0] = odata;
  748: 
  749: 	return 1;
  750: }
  751: 
  752: 
  753: 
  754: /*
  755:  *  wdc_new_command_reset():
  756:  *
  757:  *  #479: A COMMAND ENTERING wdc_command() STARTS WITHOUT THE PREVIOUS COMMAND'S
  758:  *  WRITER, BUFFERED BYTES, OR PHASE.
  759:  *
  760:  *  #480 L4: THE SCOPE IS THIS FUNCTION, NOT THE WORD "COMMAND".  An earlier
  761:  *  headline read "A NEW COMMAND STARTS WITHOUT..." with no qualifier, and the
  762:  *  device falsified that in its own code: the ALT-CTRL arm assigned
  763:  *  cur_command = COMMAND_RESET WITHOUT CALLING THIS HELPER, so the most
  764:  *  reset-like operation the device had was not a caller at all.  The SCOPE
  765:  *  paragraph forty lines below said so; a universal headline with its qualifier
  766:  *  that far down is read as universal.  Named by the fable seat on #479 pass 2.
  767:  *
  768:  *  wdc_command() cleared the ATAPI flag and the error and nothing else, so three
  769:  *  pieces of the previous command's state survived into the next one.  All three
  770:  *  were reproduced with liveness controls before this was written:
  771:  *
  772:  *    write_in_progress   an ATA write stayed armed across a packet command, so one
  773:  *                        shared ring served the disk-write path and the CDB path at
  774:  *                        once.  MEASURED: a guest's own sector write put 512 CD-ROM
  775:  *                        DATA-IN bytes and ZERO of its own on the image.
  776:  *    the input ring      residue from an under-drained transfer was never cleared.
  777:  *                        MEASURED: the drain then fires early and the guest's sector
  778:  *                        arrives with the previous transfer's bytes at its head.
  779:  *    atapi_phase         PHASE_CMDOUT survived an ordinary WRITE command.  Latent
  780:  *                        while the dispatch tests the flag AND the phase -- and #477's
  781:  *                        comment was pointing a future round straight at it.
  782:  *
  783:  *  WHY THE TOP, AND NOT THE END.  IDENTIFY loads its 512-byte response INTO the ring
  784:  *  as part of the command, and wdc__read() does the same for every ordinary READ.  A
  785:  *  seat measured the end-of-function form destroying both -- 256 of 256 IDENTIFY
  786:  *  words wrong, and a freshly-read sector gone -- while every row this round pins
  787:  *  stayed GREEN.  Clean-up-on-exit reads as the more principled placement and is the
  788:  *  more dangerous one.
  789:  *
  790:  *  WHAT THIS DELIBERATELY DOES NOT TOUCH:
  791:  *
  792:  *    cur_command     wdc__write() reads it, and the caller sets it immediately
  793:  *                    above.  Clearing it here would break the write it is about to
  794:  *                    set up.
  795:  *    the warned_*    latches.  Zeroing them alongside everything else reads as
  796:  *                    COMPLETING this helper and is the mutant to press: it undoes
  797:  *                    #337 and #464, and it is STRICTLY WORSE than the equivalent
  798:  *                    mistake in dev_asc.c, because wdc_command() runs far more often
  799:  *                    than a chip reset.  dev_asc.c says so at its own latch
  800:  *                    declarations: "Deliberately NOT cleared by dev_asc_reset() or
  801:  *                    dev_asc_fifo_flush(): a guest could otherwise re-arm the flood."
  802:  *
  803:  *  SCOPE.  TWO CALLERS: wdc_command(), and the ALT-CTRL arm on a real soft reset.
  804:  *
  805:  *  *** THIS PARAGRAPH SAID "Called from wdc_command() only" AND PRESCRIBED WHAT WOULD
  806:  *  HAVE TO HAPPEN FIRST BEFORE THE OTHER CALLER COULD EXIST.  #481 DID EXACTLY THAT,
  807:  *  so the prescription is DISCHARGED rather than merely stale. ***
  808:  *
  809:  *  It read: extending the helper to that arm AS IT STOOD was MEASURED to cancel a
  810:  *  legal transfer on an ordinary 0x08 Device Control write, which real drivers hold
  811:  *  as their steady state; so the extension "needs the arm's bit test fixed first
  812:  *  (WDCTL_RST, not WDCTL_4BIT) and is a separate round."
  813:  *
  814:  *  #481 is that round.  It corrected the bit AND made the call in one change, which
  815:  *  is why the accept rows this paragraph pointed at are GREEN on the shipped tree and
  816:  *  still RED under `Md_bitswap` -- the same extension WITHOUT the prerequisite.
  817:  *  Those four rows therefore MEASURED the ordering argument rather than asserting it.
  818:  *
  819:  *  The invariant is still not established on every path into the device: the ALT-CTRL
  820:  *  arm calls this only for WDCTL_RST, and other decode paths into that register are
  821:  *  filed rather than covered.  Said out loud rather than implied, as before.
  822:  */
  823: static void wdc_new_command_reset(struct wdc_data *d)
  824: {
  825: 	d->atapi_cmd_in_progress = 0;
  826: 	d->atapi_phase = 0;
  827: 	d->write_in_progress = 0;
  828: 
  829: 	/*  pointer reset rather than a drain loop, matching dev_asc_fifo_flush()'s
  830: 	    count-zeroing: there is no consumer to notify and nothing to hand back.  */
  831: 	d->inbuf_head = d->inbuf_tail = 0;
  832: }
  833: /*
  834:  *  wdc_command():
  835:  */
  836: void wdc_command(struct cpu *cpu, struct wdc_data *d, int idata)
  837: {
  838: 	size_t i;
  839: 
  840: 	d->cur_command = idata;
  841: 	d->error = 0;
  842: 
  843: 	/*  #479: this replaced a bare `d->atapi_cmd_in_progress = 0;`.  The flag
  844: 	    was one of three pieces of the previous command's state, and clearing
  845: 	    only the one that had been noticed is what left the other two.  */
  846: 	wdc_new_command_reset(d);
  847: 
  848: 	/*
  849: 	 *  Disk images that do not exist return an ABORT error.  This also
  850: 	 *  happens with CDROM images with the WDCC_IDENTIFY command; CDROM
  851: 	 *  images must be detected with ATAPI_IDENTIFY_DEVICE instead.
  852: 	 *
  853: 	 *  TODO:  Is this correct/good behaviour?
  854: 	 */
  855: 	if (!diskimage_exist(cpu->machine, d->drive + d->base_drive,
  856: 	    DISKIMAGE_IDE)) {
  857: 		debug("[ wdc: command 0x%02x drive %i, but no disk image ]\n",
  858: 		    d->cur_command, d->drive + d->base_drive);
  859: 		d->error |= WDCE_ABRT;
  860: 		d->int_assert = 1;
  861: 		return;
  862: 	}
  863: 	if (diskimage_is_a_cdrom(cpu->machine, d->drive + d->base_drive,
  864: 	    DISKIMAGE_IDE) && d->cur_command == WDCC_IDENTIFY) {
  865: 		debug("[ wdc: IDENTIFY drive %i, but it is an ATAPI "
  866: 		    "drive ]\n", d->drive + d->base_drive);
  867: 		d->error |= WDCE_ABRT;
  868: 		d->int_assert = 1;
  869: 		return;
  870: 	}
  871: 
  872: 	/*  Handle the command:  */
  873: 	switch (d->cur_command) {
  874: 
  875: 	case WDCC_READ:
  876: 	case WDCC_READMULTI:
  877: 		if (!quiet_mode)
  878: 			debug("[ wdc: READ from drive %i, head %i, cyl %i, "
  879: 			    "sector %i, nsecs %i ]\n", d->drive, d->head,
  880: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
  881: 		wdc__read(cpu, d);
  882: 		break;
  883: 
  884: 	case WDCC_WRITE:
  885: 	case WDCC_WRITEMULTI:
  886: 		if (!quiet_mode)
  887: 			debug("[ wdc: WRITE to drive %i, head %i, cyl %i, "
  888: 			    "sector %i, nsecs %i ]\n", d->drive, d->head,
  889: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
  890: 		wdc__write(cpu, d);
  891: 		break;
  892: 
  893: 	case WDCC_IDP:	/*  Initialize drive parameters  */
  894: 		debug("[ wdc: IDP drive %i (TODO) ]\n", d->drive);
  895: 		/*  TODO  */
  896: 		d->int_assert = 1;
  897: 		break;
  898: 
  899: 	case SET_FEATURES:
  900: 		debug("[ wdc: SET_FEATURES drive %i (TODO), feature 0x%02x ]\n",
  901: 		    d->drive, d->precomp);
  902: 		/*  TODO  */
  903: 		switch (d->precomp) {
  904: 		case WDSF_SET_MODE:
  905: 			debug("[ wdc: WDSF_SET_MODE drive %i, pio/dma flags "
  906: 			    "0x%02x ]\n", d->drive, d->seccnt);
  907: 			break;
  908: 		default:d->error |= WDCE_ABRT;
  909: 		}
  910: 		/*  TODO: always interrupt?  */
  911: 		d->int_assert = 1;
  912: 		break;
  913: 
  914: 	case WDCC_RECAL:
  915: 		debug("[ wdc: RECAL drive %i ]\n", d->drive);
  916: 		d->int_assert = 1;
  917: 		break;
  918: 
  919: 	case WDCC_IDENTIFY:
  920: 	case ATAPI_IDENTIFY_DEVICE:
  921: 		debug("[ wdc: %sIDENTIFY drive %i ]\n", d->cur_command ==
  922: 		    ATAPI_IDENTIFY_DEVICE? "ATAPI " : "", d->drive);
  923: 		wdc_initialize_identify_struct(cpu, d);
  924: 		/*  The IDENTIFY data is sent out in low/high byte order:  */
  925: 		for (i=0; i<sizeof(d->identify_struct); i+=2) {
  926: 			wdc_addtoinbuf(d, d->identify_struct[i+1]);
  927: 			wdc_addtoinbuf(d, d->identify_struct[i+0]);
  928: 		}
  929: 		d->int_assert = 1;
  930: 		break;
  931: 
  932: 	case WDCC_IDLE_IMMED:
  933: 		debug("[ wdc: IDLE_IMMED drive %i ]\n", d->drive);
  934: 		/*  TODO: interrupt here?  */
  935: 		d->int_assert = 1;
  936: 		break;
  937: 
  938: 	case WDCC_SETMULTI:
  939: 		debug("[ wdc: SETMULTI drive %i ]\n", d->drive);
  940: 		/*  TODO: interrupt here?  */
  941: 		d->int_assert = 1;
  942: 		break;
  943: 
  944: 	case ATAPI_SOFT_RESET:
  945: 		debug("[ wdc: ATAPI_SOFT_RESET drive %i ]\n", d->drive);
  946: 		/*  TODO: interrupt here?  */
  947: 		d->int_assert = 1;
  948: 		break;
  949: 
  950: 	case ATAPI_PKT_CMD:
  951: 		debug("[ wdc: ATAPI_PKT_CMD drive %i ]\n", d->drive);
  952: 		/*  TODO: interrupt here?  */
  953: 		/*  d->int_assert = 1;  */
  954: 		d->atapi_cmd_in_progress = 1;
  955: 		d->atapi_phase = PHASE_CMDOUT;
  956: 		break;
  957: 
  958: 	case WDCC_DIAGNOSE:
  959: 		debug("[ wdc: WDCC_DIAGNOSE drive %i: TODO ]\n", d->drive);
  960: 		/*  TODO: interrupt here?  */
  961: 		d->int_assert = 1;
  962: 		d->error = 1;		/*  No error?  */
  963: 		break;
  964: 
  965: 	/*  Unsupported commands, without warning:  */
  966: 	case WDCC_SEC_SET_PASSWORD:
  967: 	case WDCC_SEC_UNLOCK:
  968: 	case WDCC_SEC_ERASE_PREPARE:
  969: 	case WDCC_SEC_ERASE_UNIT:
  970: 	case WDCC_SEC_FREEZE_LOCK:
  971: 	case WDCC_SEC_DISABLE_PASSWORD:
  972: 		/*  #485: A TERMINAL ARM RAISES ITS COMPLETION INTERRUPT.
  973: 
  974: 		    THE INVARIANT, derived over all 256 opcodes rather than from a
  975: 		    few neighbours: every command wdc_command() FINISHES raises the
  976: 		    completion interrupt.  The only opcodes that stay silent are the
  977: 		    THREE that hand control back for a data phase -- WDCC_WRITE,
  978: 		    WDCC_WRITEMULTI and ATAPI_PKT_CMD -- and each of those asserts
  979: 		    when its data phase drains.  This arm and the `default:` arm
  980: 		    below were the only violations.
  981: 
  982: 		    *** THEY WERE ALSO THE ONLY TERMINAL ARMS IN THE FUNCTION WITH NO
  983: 		    INTERRUPT DECISION RECORDED AT ALL -- no assert, and no comment.
  984: 		    ***  Six arms carry a `TODO ... interrupt` hedge; in five the
  985: 		    author asserted, and in the sixth (ATAPI_PKT_CMD) he left the
  986: 		    assert COMMENTED OUT, so that decision is visible in the source.
  987: 		    A question never reached, not a decision to stay silent.
  988: 
  989: 		    NO SPECIFICATION IS CITED AND NONE IS AVAILABLE -- there is no ATA
  990: 		    document in this tree.  The warrant is the invariant above plus a
  991: 		    sibling model: dev_mb89352.c asserts on ANY non-zero interrupt
  992: 		    status, without regard to whether the command succeeded.
  993: 
  994: 		    nIEN CANNOT CONTRADICT THIS: WDCTL_IDS (0x02) is defined in
  995: 		    wdcreg.h and read NOWHERE in this file, so the model has no
  996: 		    interrupt-disable state.  This arm is exactly as nIEN-blind as
  997: 		    the ten arms that already assert.
  998: 
  999: 		    HARM, STATED HONESTLY: none measured.  WDCS_BSY is never set
 1000: 		    anywhere in this file, so a polling driver's wait returns at once
 1001: 		    with DRDY|DSC|ERR.  The WDCS_BSY fact is FILE-SCOPED and this
 1002: 		    comment owns it: grep the file.
 1003: 		
 1004: 		    *** THE REST OF THIS PARAGRAPH ONCE ASSERTED A BOOT CENSUS -- that
 1005: 		    OpenBSD 7.6 completes boot and shutdown against the old behaviour,
 1006: 		    that 0xF5 lands here on every attach and 0xE0 on every halt.  A
 1007: 		    PANEL SEAT MEASURED ALL OF THAT AND ITS ARTIFACT WAS NOT PRESERVED,
 1008: 		    so the claim rested on evidence that no longer exists.  Named by a
 1009: 		    packet-fed seat on pass 2. ***
 1010: 		
 1011: 		    It is kept as an ATTRIBUTED REPORT rather than deleted, because the
 1012: 		    reachability it describes is why this arm was worth fixing at all --
 1013: 		    but it is a seat's measurement, not this comment's, and a reader
 1014: 		    who wants it must re-run a boot rather than cite this line.
 1015: 		
 1016: 		    The licence is protocol correctness at trivial cost, NOT a hang.
 1017: 		    That much stands on the WDCS_BSY reading alone.  */
 1018: 		d->error |= WDCE_ABRT;
 1019: 		d->int_assert = 1;
 1020: 		break;
 1021: 
 1022: 	default:/*  TODO  */
 1023: 		/*  #464: `d->error |= WDCE_ABRT` STAYS OUTSIDE THE GUARD.
 1024: 		    Inside it, the second unimplemented command silently
 1025: 		    SUCCEEDS -- wdc_command() re-clears d->error per command,
 1026: 		    so the guest is told the command worked.  A line-counting
 1027: 		    oracle cannot see that; row `abrt 2nd` reads the status
 1028: 		    register after the second command and can.
 1029: 
 1030: 		    ONE LINE PER DEVICE, NOT PER OPCODE.  A per-opcode set was
 1031: 		    proposed and is FILED, not shipped: the scalar is what stops
 1032: 		    a guest cycling 0x00..0xff for 256 lines, which is the flood
 1033: 		    #464 exists to bound.  Row `unimpl 2op` pins the
 1034: 		    per-device spec by firing TWO different opcodes and
 1035: 		    demanding ONE line -- which also kills a
 1036: 		    "last-warned-opcode" latch, under which an alternating guest
 1037: 		    would flood forever.  */
 1038: 		/*  #485: see the WDCC_SEC_* arm above for the invariant and the
 1039: 		    warrant.  This is the other terminal arm that never raised its
 1040: 		    completion interrupt.
 1041: 
 1042: 		    *** THE ASSERT IS OUTSIDE THE LATCH, AND THAT IS NOT A STYLE
 1043: 		    CHOICE. ***  Moved inside `if (!d->warned_unimpl_cmd)` below,
 1044: 		    only the FIRST unimplemented command per device would interrupt
 1045: 		    and every later one would go silent again.  It is what a tidying
 1046: 		    maintainer writes -- group the response with the warning -- and a
 1047: 		    sweep using one fresh device per opcode CANNOT SEE IT, because
 1048: 		    the latch is 0 on every leg.  Row `irq 2nd` exists for exactly
 1049: 		    that mutant.
 1050: 		
 1051: 		    *** THAT SENTENCE NAMED A ROW `irq 2nd` THAT DOES NOT EXIST.
 1052: 		    Repo-wide it occurred in this comment and nowhere else. ***  The
 1053: 		    real artifact is an unnamed SUB-LEG of row_completion_irq(),
 1054: 		    printing a `2nd` field inside a row named "a terminated command
 1055: 		    raises its irq".  What makes the error dangerous rather than
 1056: 		    untidy is the company it kept: the SAME sentence cites `abrt 2nd`,
 1057: 		    which IS a real row -- so a true citation stood next to a
 1058: 		    fabricated one and lent it credibility.
 1059: 		
 1060: 		    #464 already found the ABORT BIT wrongly inside
 1061: 		    this same guard and shipped `abrt 2nd` for it; the interrupt
 1062: 		    needed the same row.  */
 1063: 		d->error |= WDCE_ABRT;
 1064: 		d->int_assert = 1;
 1065: 		if (!d->warned_unimpl_cmd) {
 1066: 			d->warned_unimpl_cmd = 1;
 1067: 			fatal("[ wdc: WARNING! Unimplemented command 0x%02x "
 1068: 			    "(drive %i, head %i, cyl %i, sector %i, nsecs %i)"
 1069: 			    " ]\n", d->cur_command, d->drive, d->head,
 1070: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
 1071: 		}
 1072: 	}
 1073: }
 1074: 
 1075: 
 1076: DEVICE_ACCESS(wdc)
 1077: {
 1078: 	struct wdc_data *d = (struct wdc_data *) extra;
 1079: 	uint64_t idata = 0, odata = 0;
 1080: 	int i;
 1081: 
 1082: 	relative_addr /= d->addr_mult;
 1083: 
 1084: 	if (!d->io_enabled)
 1085: 		goto ret;
 1086: 
 1087: 	if (writeflag == MEM_WRITE) {
 1088: 		if (relative_addr == wd_data)
 1089: 			idata = memory_readmax64(cpu, data, len);
 1090: 		else {
 1091: 			/*  #464: latch the announcement; `idata = data[0]`
 1092: 			    is the repair and stays outside the guard.  */
 1093: 			if (len != 1 && !d->warned_nonbyte_write) {
 1094: 				d->warned_nonbyte_write = 1;
 1095: 				fatal("[ wdc: WARNING! non-8-bit access on "
 1096: 				    "WRITE! ]\n");
 1097: 			}
 1098: 			idata = data[0];
 1099: 		}
 1100: 	}
 1101: 
 1102: 	switch (relative_addr) {
 1103: 
 1104: 	case wd_data:	/*  0: data  */
 1105: 		if (writeflag == MEM_READ) {
 1106: 			odata = wdc_get_inbuf(d);
 1107: 
 1108: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
 1109: 				if (len >= 2)
 1110: 					odata += (wdc_get_inbuf(d) << 8);
 1111: 				if (len == 4) {
 1112: 					odata += (wdc_get_inbuf(d) << 16);
 1113: 					odata += (wdc_get_inbuf(d) << 24);
 1114: 				}
 1115: 			} else {
 1116: 				if (len >= 2)
 1117: 					odata = (odata << 8) + wdc_get_inbuf(d);
 1118: 				if (len == 4) {
 1119: 					odata = (odata << 8) + wdc_get_inbuf(d);
 1120: 					odata = (odata << 8) + wdc_get_inbuf(d);
 1121: 				}
 1122: 			}
 1123: 
 1124: 			if (d->data_debug) {
 1125: 				const char *s = "0x%04" PRIx64" ]\n";
 1126: 				if (len == 1)
 1127: 					s = "0x%02" PRIx64" ]\n";
 1128: 				if (len == 4)
 1129: 					s = "0x%08" PRIx64" ]\n";
 1130: 				if (len == 8)
 1131: 					s = "0x%016" PRIx64" ]\n";
 1132: 				debug("[ wdc: read from DATA: ");
 1133: 				debug(s, (uint64_t) odata);
 1134: 			}
 1135: 
 1136: 			if (d->atapi_cmd_in_progress) {
 1137: 				/*  #341: account for what was actually CONSUMED
 1138: 				    from the buffer, not for what the guest
 1139: 				    asked for. The reads above take one byte,
 1140: 				    two if len >= 2, four only if len == 4 --
 1141: 				    so a 3- or 8-byte access consumes 2 (widths
 1142: 				    1..8 ATTEMPT 1, 2, 2, 4, 2, 2, 2, 2 pops --
 1143: 				    those are CALL counts, and the pops succeed
 1144: 				    only while bytes remain: wdc_get_inbuf()
 1145: 				    returns (uint64_t) -1 on an empty ring
 1146: 				    WITHOUT advancing the tail, so with q bytes
 1147: 				    queued a width-w access pops min(q, calls).
 1148: 				    "1 or 2" until 2026-09-05; the unqualified
 1149: 				    pop counts until 2026-09-06, when a pass-2
 1150: 				    seat read the helper instead of this
 1151: 				    comment.  NOTE `consumed' below is computed
 1152: 				    from `len' alone and so counts ATTEMPTS
 1153: 				    too -- row wdcconsumedattempts)
 1154: 				    while `len` says 3 or 8. Subtracting the
 1155: 				    requested length let atapi_len step PAST
 1156: 				    zero, which its `== 0` test then never
 1157: 				    catches, so PHASE_COMPLETED never fires and
 1158: 				    the guest is told a transfer is further
 1159: 				    along than the bytes it received. Same
 1160: 				    truthfulness defect as #283 in the ASC and
 1161: 				    #338 in the mb89352: the count reported has
 1162: 				    to be the count that happened.  */
 1163: 				int consumed = len == 4 ? 4 : (len >= 2 ? 2 : 1);
 1164: 				/*  #475: clamp to what REMAINS, not just to what was popped.
 1165: 				    #341 fixed `consumed` to count the POPS rather than the
 1166: 				    requested length; it did not stop the subtraction STEPPING
 1167: 				    PAST ZERO.  With an odd remainder -- and the length is a
 1168: 				    guest-chosen allocation byte -- a 4-byte read of an odd
 1169: 				    remainder drove atapi_len NEGATIVE, so `== 0` never fired
 1170: 				    again and the command never completed, while atapi_received
 1171: 				    claimed more bytes than the transfer holds.  Two distinct
 1172: 				    numbers, and conflating them is easy: the 3-byte fixture
 1173: 				    lands on -1; the worked INQUIRY-37 path lands on -3 (nine
 1174: 				    4-byte reads leave 1, the tenth takes 4).
 1175: 
 1176: 				    CLAMPING `consumed` RATHER THAN SATURATING atapi_len,
 1177: 				    because atapi_received has two live MID-TRANSFER consumers:
 1178: 				    the re-arm's length, and the refill's source offset
 1179: 				    data_in[atapi_received + j].  Saturating repairs completion
 1180: 				    and leaves those two reading a skewed offset, permanently
 1181: 				    skipping up to 3 real bytes -- #283's defect shape,
 1182: 				    re-created.
 1183: 
 1184: 				    A NEARBY PRECEDENT, cited narrowly on purpose: dev_asc.c
 1185: 				    clamps a step to a remainder before its move.  An earlier
 1186: 				    draft of this comment called that #283 and called it
 1187: 				    'exactly this shape'; a panel seat refuted both.  #283 tags
 1188: 				    the RESIDUAL REPORTING there (`programmed`/`moved`) -- its
 1189: 				    own comment says it snapshots the count 'before the clamps
 1190: 				    below rewrite len2', so the clamp is untagged upstream code.
 1191: 				    And the shapes differ: dev_asc clamps the TRANSFER before
 1192: 				    the move, while this clamps the ACCOUNTING and lets the pop
 1193: 				    happen at full width.  The in-tree precedent for clamping
 1194: 				    the transfer is a DIFFERENT option, which this round
 1195: 				    considered and did not take.
 1196: 
 1197: 				    The warrant that survives is the one above: the cursor.  */
 1198: 				if (consumed > d->atapi_len)
 1199: 					consumed = d->atapi_len;
 1200: 
 1201: 				d->atapi_len -= consumed;
 1202: 				d->atapi_received += consumed;
 1203: 				/*  #476: `atapi_st` IS DEREFERENCED ON THE NEXT LINE AND WAS NEVER
 1204: 				    NULL-CHECKED.  #475's clamp made this branch REACHABLE: before it, a
 1205: 				    read with atapi_len already 0 drove the counter NEGATIVE and `== 0`
 1206: 				    never fired again, so the deref was dead code.  Clamping consumed to
 1207: 				    0 leaves atapi_len AT 0, the test fires, and two guest register
 1208: 				    accesses from a fresh device -- write ATAPI_PKT_CMD to COMMAND, then
 1209: 				    read DATA -- reach `d->atapi_st->data_in_len` through NULL.
 1210: 
 1211: 				    MEASURED: SIGSEGV at address 0x48, which is
 1212: 				    offsetof(struct scsi_transfer, data_in_len).  The pre-#475 blob
 1213: 				    survives the identical input, and the row for the defect #475 FIXED
 1214: 				    goes the OTHER way on the same pair -- so the bisect is unambiguous.
 1215: 
 1216: 				    The clamp was right; the branch it woke was never NULL-safe.  Decline
 1217: 				    and say so once, per this file's latch idiom: a device that cannot
 1218: 				    service an access must not take the emulator with it (#337, #184,
 1219: 				    #186, #315, #316, #326).  */
 1220: 				if (d->atapi_len == 0 && d->atapi_st == NULL) {
 1221: 					if (!d->warned_null_xfer) {
 1222: 						d->warned_null_xfer = 1;
 1223: 						fatal("[ wdc: DATA read with no ATAPI "
 1224: 						    "transfer armed (once) ]\n");
 1225: 					}
 1226: 				} else if (d->atapi_len == 0 &&
 1227: 				    d->atapi_phase != PHASE_CMDOUT) {
 1228: 					/*  #477: A STRAY DATA-PORT READ MUST NOT REWRITE THE PHASE WHILE A
 1229: 					    CDB IS BEING COLLECTED.  Measured by the Fable seat as a
 1230: 					    REGRESSION of the dispatch phase guard below: HEAD services
 1231: 					    `PKT, stray read, CDB` after a prior completed command, and
 1232: 					    without this arm's phase test the CDB never dispatches at all.
 1233: 
 1234: 					    The ATAPI_PKT_CMD arm of wdc_command() assigns only the flag and
 1235: 					    the phase, so a new packet starts with atapi_len == 0,
 1236: 					    atapi_received == data_in_len and atapi_st STALE NON-NULL (it is
 1237: 					    freed at the next dispatch and never NULLed).  A read then falls
 1238: 					    here, finds `received < data_in_len` false, and sets
 1239: 					    PHASE_COMPLETED -- moving the phase off CMDOUT before the CDB is
 1240: 					    complete.
 1241: 
 1242: 					    *** AND THE RESIDUE THAT MAKES IT UNRECOVERABLE IS A PROPERTY OF
 1243: 					    THE DEVICE, NOT OF THIS REGRESSION -- an earlier draft of this
 1244: 					    comment said otherwise, and the Opus seat MEASURED the
 1245: 					    difference. ***
 1246: 
 1247: 					    *** THE NEXT SENTENCE WAS TRUE WHEN WRITTEN AND IS FALSE AT
 1248: 					    HEAD.  Corrected 2026-08-30. ***  It read: `ATAPI_PKT_CMD
 1249: 					    never flushes the ring, and neither reset path does either,
 1250: 					    so an under-drained DATA-IN leaves occupancy at 32 -> 44 ->
 1251: 					    56 -> 68 and every later CDB is dropped forever.  That
 1252: 					    entrance is open`.  It is not open: wdc_new_command_reset()
 1253: 					    zeroes inbuf_head and inbuf_tail and runs at the TOP of
 1254: 					    wdc_command(), BEFORE the ATAPI_PKT_CMD case -- so every
 1255: 					    command flushes, and `wdcringnoflush` is CLOSED on exactly
 1256: 					    that.  The residue described above is still a property of
 1257: 					    the device; what changed is that it cannot survive into the
 1258: 					    NEXT command.  dev_asc.c's
 1259: 					    dev_asc_fifo_flush() is the in-tree idiom for closing it.
 1260: 
 1261: 					    In CMDOUT the atapi_len/atapi_received pair describes the
 1262: 					    PREVIOUS transfer, so no completion state may be derived from it
 1263: 					    -- the same statement the dispatch guard below makes about the
 1264: 					    flag, applied to the read arm.  Falling through BOTH arms is the
 1265: 					    correct disposition: the read pops the ring and changes no
 1266: 					    transfer state.  */
 1267: 					if (d->atapi_received < d->atapi_st->
 1268: 					    data_in_len) {
 1269: 						d->atapi_phase = PHASE_DATAIN;
 1270: 						/*  #473: clamp to the chunk size, NOT zero, and REFILL.  This
 1271: 						    assigned 0 where the initial arm clamps to 32768 in the same
 1272: 						    condition, so a transfer with >32768 left reported ZERO
 1273: 						    remaining -- with no recovery, since the next read decrements
 1274: 						    from 0 and `== 0` never fires again.  MEASURED band
 1275: 						    [65537, 262655]; the guest saw bytecount 0 with DRQ asserted.
 1276: 
 1277: 						    The refill is what makes the bounded push above correct: here
 1278: 						    atapi_len is 0, so the guest drained the previous chunk; data_in
 1279: 						    is still live, being freed only when the next command arrives.
 1280: 
 1281: 						    #473 L4: an earlier version of this comment said the ring is
 1282: 						    EMPTY here.  That is an overclaim and a panel seat broke it.
 1283: 						    atapi_len counts only what the DATAIN arms pushed, and the
 1284: 						    data-port WRITE arm above pushes guest bytes with no phase
 1285: 						    guard and no capacity check -- its unexpected-write latch is
 1286: 						    suppressed precisely because atapi_cmd_in_progress is set.  A
 1287: 						    guest that WRITES to the data port mid-DATAIN therefore grows
 1288: 						    head without touching atapi_len, and those bytes are still
 1289: 						    queued when the refill runs.
 1290: 
 1291: 						    What IS true: the ring is empty for any guest that only READS
 1292: 						    during DATAIN, which is every driver in this tree.  An
 1293: 						    adversarial interleaved write DESYNCHRONISES that guest's own
 1294: 						MEASURED by a panel seat: one 2-byte store placed so the
 1295: 						ring still holds the tail of chunk 1 makes all 32768 bytes of
 1296: 						chunk 2 wrong on this build.
 1297: 
 1298: 						*** AN EARLIER DRAFT CALLED THAT A REGRESSION.  A SECOND SEAT
 1299: 						MEASURED IT FALSE. ***  It rested on 'and ZERO wrong pre-fix',
 1300: 						which is a 0 OF 0 -- the denominator trap.  Pre-#473 there is
 1301: 						no refill loop at all, so chunk 2 is NEVER DELIVERED and the
 1302: 						wrongness was counted over the empty set.  Measured honestly,
 1303: 						the pre-fix build delivers 0 of 32768 bytes of chunk 2 and
 1304: 						returns the over-read sentinel forever.
 1305: 
 1306: 						A regression needs a case that WORKED before and does not now,
 1307: 						and there is none: the fix strictly improves the no-write case
 1308: 						(0 wrong against 32640) and moves the adversarial case from
 1309: 						DEAD to SHIFTED.  The honest word is a shifted failure mode,
 1310: 						not a regression.
 1311: 
 1312: 						    The arithmetic here was stated BACKWARDS in the first draft of
 1313: 						    this comment: the refill route takes 229889 injected bytes and
 1314: 						    the direct write route 262657, so the refill route is cheaper
 1315: 						    by 32768 -- FEWER, not more.  The conclusion survives because
 1316: 						    both routes are unbounded and a guest with either has the
 1317: 						    other; the stated reason was false, and a wrong reason gets
 1318: 						    reused.
 1319: 
 1320: 						    TWO QUALIFICATIONS, both from a later seat, both narrowing
 1321: 						    claims that were too absolute.  262657 is the EMPTY-RING
 1322: 						    direct threshold -- with a chunk already queued the direct
 1323: 						    route also overwrites after 229889, so these are thresholds
 1324: 						    under stated starting states, not intrinsic costs.  And
 1325: 						    'only that guest's own transfer' overclaims: the same shared
 1326: 						    ring feeds the CDB-dispatch and disk-image-drain paths.  The
 1327: 						    defensible form is that this adds no DEMONSTRATED
 1328: 						    host-memory-safety primitive, and the measured case corrupts
 1329: 						    returned transfer data.  Tracked as
 1330: 						    `wdcaddtoinbufbound`, which names that write path as the live
 1331: 						    unbounded route.  */
 1332: 						d->atapi_len = d->atapi_st->
 1333: 						    data_in_len -
 1334: 						    d->atapi_received;
 1335: 						if (d->atapi_len > 32768)
 1336: 							d->atapi_len = 32768;
 1337: 
 1338: 						/*  WHY THIS DEREFERENCE IS NOT NULL-CHECKED, and the dispatch
 1339: 						    refill below IS.  The asymmetry is real and the safety here
 1340: 						    rests on an invariant that lives in ANOTHER FILE, which is
 1341: 						    the reason it is written down rather than left to be
 1342: 						    re-derived:
 1343: 
 1344: 						      a LIVE scsi_transfer with data_in_len > 0 always has
 1345: 						      data_in != NULL.
 1346: 
 1347: 						    scsi_transfer_alloc() memsets the whole struct, so a fresh
 1348: 						    transfer is (NULL, 0).  scsi_transfer_allocbuf() either
 1349: 						    installs a buffer or exit()s -- it never returns having set a
 1350: 						    length without one.  The three later length mutations in the
 1351: 						    tree (MODE_SENSE, READ_TOC, and dev_asc's consumed-prefix
 1352: 						    subtraction) only SHRINK or preserve a live allocation.
 1353: 
 1354: 						    *** IT IS A FUNCTION-BOUNDARY INVARIANT, NOT A CONTINUOUS
 1355: 						    ONE, and an earlier draft of this note said the two fields
 1356: 						    are set together.  They are not: allocbuf writes the LENGTH
 1357: 						    first and the POINTER fourteen lines later, with a malloc
 1358: 						    between them.  Nothing observes that window -- no callback
 1359: 						    and no return to this device runs inside it -- but the
 1360: 						    distinction is the whole reason this is a comment and not a
 1361: 						    proof. ***
 1362: 
 1363: 						    NOT a guard: the ADDITION LICENCE wants a measured delta or a
 1364: 						    transferred warrant, and the state is not producible today.
 1365: 						    What was missing is a REASON an edit elsewhere can break,
 1366: 						    rather than a check that would silently never fire.  Filed
 1367: 						    as `wdcdatainnull`.  */
 1368: 						for (int j=0; j<d->atapi_len; j++)
 1369: 							wdc_addtoinbuf(d, d->atapi_st->
 1370: 								data_in[d->atapi_received + j]);
 1371: 					} else
 1372: 						d->atapi_phase =
 1373: 						    PHASE_COMPLETED;
 1374: 					d->int_assert = 1;
 1375: 				}
 1376: 			} else {
 1377: #if 0
 1378: 				if (d->inbuf_tail != d->inbuf_head)
 1379: #else
 1380: 				if (d->inbuf_tail != d->inbuf_head &&
 1381: 				    ((d->inbuf_tail - d->inbuf_head) % 512)
 1382: 				    == 0)
 1383: #endif
 1384: 					d->int_assert = 1;
 1385: 			}
 1386: 		} else {
 1387: 			int inbuf_len;
 1388: 			/*  #478: PER-ACCESS, and a struct field here is a REGRESSION.
 1389: 			    MEASURED: a latched field silences every later legal write,
 1390: 			    turning a corruption defect into silent data loss, which is
 1391: 			    worse.  The question is 'did THIS access push nothing', so the
 1392: 			    answer must not outlive the access.  */
 1393: 			int badlen_this = 0;
 1394: 			if (d->data_debug) {
 1395: 				const char *s = "0x%04" PRIx64" ]\n";
 1396: 				if (len == 1)
 1397: 					s = "0x%02" PRIx64" ]\n";
 1398: 				if (len == 4)
 1399: 					s = "0x%08" PRIx64" ]\n";
 1400: 				if (len == 8)
 1401: 					s = "0x%016" PRIx64" ]\n";
 1402: 				debug("[ wdc: write to DATA: ");
 1403: 				debug(s, (uint64_t) idata);
 1404: 			}
 1405: 			/*  #464: latched.  */
 1406: 			if (!d->write_in_progress &&
 1407: 			    !d->atapi_cmd_in_progress &&
 1408: 			    !d->warned_data_unexpected) {
 1409: 				d->warned_data_unexpected = 1;
 1410: 				fatal("[ wdc: write to DATA, but not "
 1411: 				    "expecting any? (len=%i): 0x%08lx ]\n",
 1412: 				    (int)len, (long)idata);
 1413: 			}
 1414: 
 1415: 			/*  #495: A HOST STORE TO THE DATA PORT DURING A DATA-IN
 1416: 			    TRANSFER IS OUT OF PROTOCOL, AND UNTIL NOW IT WAS PUSHED
 1417: 			    INTO THE RING ANYWAY.
 1418: 
 1419: 			    Real ATAPI hardware never accepts host data-register
 1420: 			    stores while the direction is device-to-host.  This model
 1421: 			    accepted them, and the injected bytes grew inbuf_head
 1422: 			    WITHOUT growing atapi_len -- which counts only what the
 1423: 			    DATA-IN arms pushed.  They then sat ahead of the next
 1424: 			    chunk, and the re-arm refilled on top of them, so the
 1425: 			    guest's whole next chunk arrived shifted.
 1426: 
 1427: 			    Measured at rung 3 on unmodified evbmips -e malta, 20 of
 1428: 			    20 across both legs: one 2-byte store placed while the
 1429: 			    tail of chunk 1 is still in the ring makes the guest read
 1430: 			    back ITS OWN INJECTED BYTES as disk data.  The witness is
 1431: 			    at regress/artifacts/wdcaddtoinbufbound/rung3_20260830/.
 1432: 
 1433: 			    AND IT WAS SILENT.  The one diagnostic that could have
 1434: 			    announced a stray write requires !atapi_cmd_in_progress,
 1435: 			    and that flag is 1 for the whole of DATA-IN -- so the
 1436: 			    single guard that might have caught this was disabled
 1437: 			    exactly when it was needed.
 1438: 
 1439: 			    THE TEST IS THE PHASE, NOT THE FLAG, AND THE DIFFERENCE
 1440: 			    IS NOT COSMETIC.  #477 measured that guarding these
 1441: 			    pushes could CREATE a use-after-free: a suppressed push
 1442: 			    leaves occupancy at 12 and the CDB dispatch fires anyway.
 1443: 			    That hazard lives at occupancy 12, which is CMDOUT -- so
 1444: 			    a guard keyed on the PHASE never suppresses there and
 1445: 			    cannot reach it.  A guard keyed on the FLAG alone matches
 1446: 			    CDB collection too and re-arms #477's objection in full.
 1447: 
 1448: 			    THIS GUARD IS NOT SELF-CONTAINED, and that is recorded
 1449: 			    rather than left for someone to rediscover: it is safe
 1450: 			    only because #477's READ-arm phase test stops a stray
 1451: 			    read moving atapi_phase off CMDOUT mid-CDB.  Remove that
 1452: 			    and this starts refusing legitimate CDB bytes.
 1453: 
 1454: 			    ONLY THE PUSH IS REFUSED.  The access stays HANDLED and
 1455: 			    falls through to the common tail, which returns 1.  A 0
 1456: 			    would not reach unassigned-address handling -- this
 1457: 			    device is registered -- it would raise EXCEPTION_DBE and
 1458: 			    leave the guest re-executing the faulting store forever,
 1459: 			    silently at default verbosity.  Measured last round at
 1460: 			    19793 device-failed diagnostics and zero non-existant
 1461: 			    ones.  Worse than a flood, not better.
 1462: 
 1463: 			    The shipped 128-row offline detector scores ZERO failures
 1464: 			    with this defect live, so it cannot see it at all; the
 1465: 			    rung-3 witness ships as the detector for that reason.
 1466: 
 1467: 			    A FORWARD HAZARD, NAMED BECAUSE IT IS INERT TODAY AND WILL
 1468: 			    NOT BE.  `!= PHASE_CMDOUT` also covers PHASE_DATAOUT, the
 1469: 			    phase in which a guest legitimately drives host-to-device
 1470: 			    bytes.  That is harmless right now because DATAOUT IS
 1471: 			    UNIMPLEMENTED: the constant is assigned at exactly one site,
 1472: 			    which latches warned_atapi_dataout and prints `ATAPI DATA
 1473: 			    OUT phase not implemented`, and it is read nowhere else.  So
 1474: 			    this refuses bytes nothing would have consumed.
 1475: 
 1476: 			    Whoever implements DATAOUT must widen this predicate, and
 1477: 			    the round's own witness will stay GREEN while they do not,
 1478: 			    because it walks only DATA-IN.  The guard is deliberately
 1479: 			    NOT widened today: a `&& phase != PHASE_DATAOUT` term no row
 1480: 			    exercises and no measurement covers is the addition
 1481: 			    licence's `it cannot hurt`, which is how dead guards
 1482: 			    accrete.  Found by a packet-fed seat on pass 2, from the
 1483: 			    inlined diff alone.  */
 1484: 			if (d->atapi_cmd_in_progress &&
 1485: 			    d->atapi_phase != PHASE_CMDOUT) {
 1486: 				/*  out of protocol: refuse the push  */
 1487: 			} else if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
 1488: 				switch (len) {
 1489: 				case 4:	wdc_addtoinbuf(d, idata & 0xff);
 1490: 					wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1491: 					wdc_addtoinbuf(d, (idata >> 16) & 0xff);
 1492: 					wdc_addtoinbuf(d, (idata >> 24) & 0xff);
 1493: 					break;
 1494: 				case 2:	wdc_addtoinbuf(d, idata & 0xff);
 1495: 					wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1496: 					break;
 1497: 				case 1:	wdc_addtoinbuf(d, idata); break;
 1498: 				/*  #337: a 3- or 8-byte access to the data
 1499: 				    port used to call exit(1) -- a GUEST
 1500: 				    choosing an access width killed the host
 1501: 				    process. Same halt class as #184/#186/
 1502: 				    #187/#315/#316/#326. Drop the access and
 1503: 				    say so once; a device that cannot honour
 1504: 				    a transfer must not take the emulator
 1505: 				    with it. (Unreachable from SH-4, which
 1506: 				    has no 3- or 8-byte access, but reachable
 1507: 				    from a 64-bit MIPS machine carrying wdc
 1508: 				    over bus_isa/bus_pci.)  */
 1509: 				default:/*  #478: `break` leaves the WIDTH SWITCH, not the
 1510: 				            handler -- execution falls through to the
 1511: 				            occupancy drain below with NOTHING pushed.  */
 1512: 				        badlen_this = 1;
 1513: 				        if (!d->warned_badlen) {
 1514: 						d->warned_badlen = 1;
 1515: 						fatal("wdc: unimplemented "
 1516: 						    "write len %i (ignored)\n",
 1517: 						    len);
 1518: 					}
 1519: 					break;
 1520: 				}
 1521: 			} else {
 1522: 				switch (len) {
 1523: 				case 4:	wdc_addtoinbuf(d, (idata >> 24) & 0xff);
 1524: 					wdc_addtoinbuf(d, (idata >> 16) & 0xff);
 1525: 					wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1526: 					wdc_addtoinbuf(d, idata & 0xff);
 1527: 					break;
 1528: 				case 2:	wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1529: 					wdc_addtoinbuf(d, idata & 0xff);
 1530: 					break;
 1531: 				case 1:	wdc_addtoinbuf(d, idata); break;
 1532: 				/*  #337: a 3- or 8-byte access to the data
 1533: 				    port used to call exit(1) -- a GUEST
 1534: 				    choosing an access width killed the host
 1535: 				    process. Same halt class as #184/#186/
 1536: 				    #187/#315/#316/#326. Drop the access and
 1537: 				    say so once; a device that cannot honour
 1538: 				    a transfer must not take the emulator
 1539: 				    with it. (Unreachable from SH-4, which
 1540: 				    has no 3- or 8-byte access, but reachable
 1541: 				    from a 64-bit MIPS machine carrying wdc
 1542: 				    over bus_isa/bus_pci.)  */
 1543: 				default:/*  #478: `break` leaves the WIDTH SWITCH, not the
 1544: 				            handler -- execution falls through to the
 1545: 				            occupancy drain below with NOTHING pushed.  */
 1546: 				        badlen_this = 1;
 1547: 				        if (!d->warned_badlen) {
 1548: 						d->warned_badlen = 1;
 1549: 						fatal("wdc: unimplemented "
 1550: 						    "write len %i (ignored)\n",
 1551: 						    len);
 1552: 					}
 1553: 					break;
 1554: 				}
 1555: 			}
 1556: 
 1557: 			inbuf_len = d->inbuf_head - d->inbuf_tail;
 1558: 			while (inbuf_len < 0)
 1559: 				inbuf_len += WDC_INBUF_SIZE;
 1560: 
 1561: 			/*  #477: THE DISPATCH KEYS ON THE PHASE IN ADDITION TO THE FLAG.
 1562: 
 1563: 			    *** THIS HEADLINE READ "ON THE PHASE, NOT ON THE FLAG" UNTIL
 1564: 			    2026-08-27, AND THAT WORDING WAS UNSAFE.  The codex seat reasoned
 1565: 			    on #477's pass 2 that deleting the flag conjunct would sweep the
 1566: 			    detector; MEASURED, it swept all 52 rows clean. ***
 1567: 
 1568: 			    BOTH CONJUNCTS ARE LOAD-BEARING, and the reason is a STALE PHASE.
 1569: 			    `wdc_command(ATAPI_PKT_CMD)` sets PHASE_CMDOUT; a following
 1570: 			    `wdc_command(WDCC_WRITE)` clears the flag at the top of that
 1571: 			    function and arms the write -- and NOTHING RESETS THE PHASE.  The
 1572: 			    device then sits in exactly the state a phase-only guard cannot
 1573: 			    tell from a real CDB collection.
 1574: 
 1575: 			    Under a phase-only guard the guest's own sector payload reaches
 1576: 			    occupancy 12 and is issued as a SCSI command.  MEASURED, and worse
 1577: 			    than the seat predicted: the sector does not merely lose twelve
 1578: 			    bytes, it NEVER REACHES THE DISK -- `0 w, 0 b` against a wanted
 1579: 			    one write of 512.  `row_stale_phase_write` pins both halves.
 1580: 
 1581: 			    The stale phase is itself a defect; it is filed with
 1582: 			    `wdcwipclear` / `wdcringnoflush` -- a new command does not reset
 1583: 			    what the old one left.
 1584: 
 1585: 			    `atapi_cmd_in_progress` is set when a packet command arrives and
 1586: 			    cleared only when the NEXT command does -- so it stays 1 through the
 1587: 			    whole of DATAIN and past PHASE_COMPLETED.  It conflates two roles: 'a
 1588: 			    packet command is active' (read at four register sites through
 1589: 			    completion, and must stay set) and 'I am collecting a 12-byte CDB'
 1590: 			    (what this test actually wants).
 1591: 
 1592: 			    So a guest write during DATAIN that brought ring occupancy to exactly
 1593: 			    12 re-entered this block, FREED THE LIVE TRANSFER, and issued a SCSI
 1594: 			    command built from the guest's own returned DATA-IN payload.  MEASURED:
 1595: 			    `freed 1 live transfer(s)`.
 1596: 
 1597: 			    NOT guarding the data-port write instead, and two measuring seats
 1598: 			    agree: this check runs on EVERY data-port write regardless of what the
 1599: 			    write did -- the width switch's `default:` arm (len 3 or 8) pushes
 1600: 			    ZERO bytes and falls straight through to here.  Guarding the pushes
 1601: 			    was MEASURED WORSE THAN NO FIX: with occupancy already 12 the
 1602: 			    suppressed push leaves it at 12, so the guard CREATES a free on an
 1603: 			    input the unfixed code survives.
 1604: 
 1605: 			    Nor clearing the flag at completion: that leaves this window untouched
 1606: 			    (the flag is legitimately 1 here) and breaks the ATAPI handshake --
 1607: 			    ireason and the byte-count pair are read at PHASE_COMPLETED.  */
 1608: 			/*  #479: A REJECTED WIDTH MUST NOT DISPATCH EITHER.
 1609: 
 1610: 			    `#478` added `badlen_this` and guarded the sector DRAIN with
 1611: 			    it, and recorded that this finally made `#337`'s `(ignored)`
 1612: 			    message true.  It did not.  Two seats found it independently
 1613: 			    on `#478`'s pass 2 -- one by reading, one by measuring a
 1614: 			    3-byte store allocate an `atapi_st` -- and the row
 1615: 			    `a rejected width issues no command` reds without this.
 1616: 
 1617: 			    This dispatch runs on EVERY data-port write regardless of
 1618: 			    what the write did, so an access of an unimplemented width
 1619: 			    -- which pushes nothing and is announced as ignored -- still
 1620: 			    issued a 12-byte SCSI command whenever occupancy already
 1621: 			    stood at 12.  A rejected access with a side effect is worse
 1622: 			    than either accepting or refusing it cleanly, because the
 1623: 			    diagnostic says the opposite of what happened.  */
 1624: 			if (d->atapi_cmd_in_progress && !badlen_this &&
 1625: 			    d->atapi_phase == PHASE_CMDOUT && inbuf_len == 12) {
 1626: 				unsigned char *scsi_cmd;
 1627: 				int x = 0, res;
 1628: 
 1629: 				/*  #477: THE `inbuf_len == 12` IN THE GUARD ABOVE IS WHAT BOUNDS THE
 1630: 			    COPY BELOW.  `x` is not checked against 12, so the equality is not
 1631: 			    only selecting the dispatch -- it is the only thing keeping this
 1632: 			    12-byte allocation from overflowing with guest bytes.  A pass-2
 1633: 			    mutant relaxing it to `>= 12` was MEASURED under ASAN as a
 1634: 			    heap-buffer-overflow WRITE here, while the 44-row detector stayed
 1635: 			    green -- and this round's own kill table had first classified that
 1636: 			    edit as an IMPROVEMENT.  Four readers reasoned about the guard as a
 1637: 			    dispatch selector and none opened these nine lines.  Do not widen
 1638: 			    the equality; flush the ring instead (`wdcringnoflush`).  */
 1639: 				CHECK_ALLOCATION(scsi_cmd = (unsigned char *) malloc(12));
 1640: 
 1641: 				if (d->atapi_st != NULL)
 1642: 					scsi_transfer_free(d->atapi_st);
 1643: 				d->atapi_st = scsi_transfer_alloc();
 1644: 
 1645: 				debug("[ wdc: ATAPI command ]\n");
 1646: 
 1647: 				while (inbuf_len > 0) {
 1648: 					scsi_cmd[x++] = wdc_get_inbuf(d);
 1649: 					inbuf_len --;
 1650: 				}
 1651: 
 1652: 				d->atapi_st->cmd = scsi_cmd;
 1653: 				d->atapi_st->cmd_len = 12;
 1654: 
 1655: 				if (scsi_cmd[0] == SCSIBLOCKCMD_READ_CAPACITY
 1656: 				    || scsi_cmd[0] == SCSICMD_READ_10
 1657: 				    || scsi_cmd[0] == SCSICMD_MODE_SENSE10)
 1658: 					d->atapi_st->cmd_len = 10;
 1659: 
 1660: 				res = diskimage_scsicommand(cpu,
 1661: 				    d->drive + d->base_drive, DISKIMAGE_IDE,
 1662: 				    d->atapi_st);
 1663: 
 1664: 				/*  #337: an ATAPI command the SCSI layer
 1665: 				    rejected used to exit(1). Any guest that
 1666: 				    issues an unsupported or malformed packet
 1667: 				    command could therefore kill the host.
 1668: 				    Complete the command instead: the phase
 1669: 				    goes to COMPLETED with no data, and the
 1670: 				    interrupt below still fires, which is how
 1671: 				    a real drive reports a failed packet
 1672: 				    command to its driver.  */
 1673: 				if (res == 0) {
 1674: 					if (!d->warned_atapi_err) {
 1675: 						d->warned_atapi_err = 1;
 1676: 						fatal("wdc: ATAPI command "
 1677: 						    "rejected; completing "
 1678: 						    "with no data\n");
 1679: 					}
 1680: 					d->atapi_len = 0;
 1681: 					d->atapi_received = 0;
 1682: 					d->atapi_phase = PHASE_COMPLETED;
 1683: 					d->int_assert = 1;
 1684: 					break;
 1685: 				}
 1686: 
 1687: 				d->atapi_len = 0;
 1688: 				d->atapi_received = 0;
 1689: 
 1690: 				if (res == 1) {
 1691: 					if (d->atapi_st->data_in != NULL) {
 1692: 						d->atapi_phase = PHASE_DATAIN;
 1693: 						/*  #473: CLAMP BEFORE THE PUSH.  This loop was unbounded and the
 1694: 						    clamp sat AFTER it, so a transfer larger than the ring was pushed
 1695: 						    whole: WDC_INBUF_SIZE is exactly 513 blocks, and block 514 wrapped
 1696: 						    onto unread data.  MEASURED: a 514-block transfer returned block
 1697: 						    513's bytes where block 0's should be, and the latch fired one
 1698: 						    store EARLIER than the corruption, because head==tail cannot tell
 1699: 						    full from empty.  The clamp is not new -- it was on the wrong side
 1700: 						    of the loop.  */
 1701: 						d->atapi_len = d->atapi_st->data_in_len;
 1702: 						if (d->atapi_len > 32768)
 1703: 							d->atapi_len = 32768;
 1704: 
 1705: 						for (int j=0; j<d->atapi_len; j++)
 1706: 							wdc_addtoinbuf(d, d->atapi_st->data_in[j]);
 1707: 					} else {
 1708: 						d->atapi_phase =
 1709: 						    PHASE_COMPLETED;
 1710: 					}
 1711: 				} else {
 1712: 					/*  #337: this arm ALREADY set the
 1713: 					    right phase and then called
 1714: 					    exit(1) anyway, so removing the
 1715: 					    abort is the whole fix -- any
 1716: 					    ATAPI command wanting a DATA OUT
 1717: 					    phase (MODE SELECT, for one) took
 1718: 					    the host down. The transfer
 1719: 					    itself is still unimplemented,
 1720: 					    which is what the warning says.  */
 1721: 					if (!d->warned_atapi_dataout) {
 1722: 						d->warned_atapi_dataout = 1;
 1723: 						fatal("wdc: ATAPI DATA OUT "
 1724: 						    "phase not implemented\n");
 1725: 					}
 1726: 					d->atapi_phase = PHASE_DATAOUT;
 1727: 				}
 1728: 
 1729: 				d->int_assert = 1;
 1730: 			}
 1731: 
 1732: 			/*  #478: AN EMPTY RING MUST NOT BE READ AS A FULL SECTOR.
 1733: 
 1734: 			    `inbuf_len == 0` satisfies `0 % 512 == 0`, so this block fired
 1735: 			    with NOTHING queued and handed diskimage_access 512 bytes of
 1736: 			    whatever the ring held, at the guest's chosen LBA.  MEASURED:
 1737: 			    `1 write(s), 512 bytes to 0x8000, first=0xdd` -- the poison, so
 1738: 			    the bytes written were ones the guest never supplied.
 1739: 
 1740: 			    BOTH conditions are load-bearing and each closes a door the
 1741: 			    other leaves open -- measured, not argued:
 1742: 
 1743: 			      `inbuf_len > 0`   closes the empty ring, and the WRITE+PKT
 1744: 			                        door where a CDB dispatch has already
 1745: 			                        consumed the LOCAL inbuf_len to a stale 0
 1746: 			                        while pushing fresh DATA-IN into the ring.
 1747: 			      `!badlen_this`    closes the LEFTOVER door: an unread payload
 1748: 			                        leaves occupancy at 512, so `512 > 0` passes
 1749: 			                        and the guest's own returned data is written
 1750: 			                        to the image.  MEASURED first=0xbe.
 1751: 
 1752: 			    The drain is guarded rather than the `default:` arm because the
 1753: 			    WRITE+PKT door involves no bad-len access at all.  */
 1754: 			if (inbuf_len > 0 && !badlen_this &&
 1755: 			    (( d->write_in_progress == WDCC_WRITEMULTI &&
 1756: 			    inbuf_len % (512 * d->write_count) == 0)
 1757: 			    ||
 1758: 			    ( d->write_in_progress == WDCC_WRITE &&
 1759: 			    inbuf_len % 512 == 0)) ) {
 1760: 				int count = (d->write_in_progress ==
 1761: 				    WDCC_WRITEMULTI)? d->write_count : 1;
 1762: 				unsigned char *buf, *b;
 1763: 
 1764: 				CHECK_ALLOCATION(buf = (unsigned char *) malloc(512 * count));
 1765: 				b = buf;
 1766: 
 1767: 				if (d->inbuf_tail+512*count <= WDC_INBUF_SIZE) {
 1768: 					b = d->inbuf + d->inbuf_tail;
 1769: 					d->inbuf_tail = (d->inbuf_tail + 512
 1770: 					    * count) % WDC_INBUF_SIZE;
 1771: 				} else {
 1772: 					for (i=0; i<512 * count; i++)
 1773: 						buf[i] = wdc_get_inbuf(d);
 1774: 				}
 1775: 
 1776: 				diskimage_access(cpu->machine,
 1777: 				    d->drive + d->base_drive, DISKIMAGE_IDE, 1,
 1778: 				    d->write_offset, b, 512 * count);
 1779: 
 1780: 				d->write_count -= count;
 1781: 				d->write_offset += 512 * count;
 1782: 
 1783: 				d->int_assert = 1;
 1784: 
 1785: 				if (d->write_count == 0)
 1786: 					d->write_in_progress = 0;
 1787: 
 1788: 				free(buf);
 1789: 			} else if ((( d->write_in_progress == WDCC_WRITEMULTI &&
 1790: 			    inbuf_len % (512 * d->write_count) == 0)
 1791: 			    ||
 1792: 			    ( d->write_in_progress == WDCC_WRITE &&
 1793: 			    inbuf_len % 512 == 0)) && !d->warned_empty_drain) {
 1794: 				/*  #478: DECLINE AND ANNOUNCE, per this tree's own #264
 1795: 				    precedent -- dev_asc.c refuses a zero-length DATA_OUT
 1796: 				    and SAYS SO rather than proceeding silently.
 1797: 
 1798: 				    The condition is the DIFFERENCE between this fix and the
 1799: 				    code it replaces, not the negation of the guard: the old
 1800: 				    code drained on the modulus alone, so this fires exactly
 1801: 				    where a spurious sector USED to reach the disk image.
 1802: 				    Announcing on every non-draining write would fire on all
 1803: 				    255 partial stores of an ordinary sector.
 1804: 
 1805: 				    Without this the guest had NO notice at all: no error
 1806: 				    bit, the handler returns 1, and the interrupt is still
 1807: 				    asserted -- a write silently vanishing.  N=1 per device
 1808: 				    instance with `(once)`, the tree's plurality marker.
 1809: 
 1810: 				    fatal() and not debugmsg(): under -q the verbosity
 1811: 				    settles at VERBOSITY_ERROR, so a WARNING would be
 1812: 				    invisible to the boot-log hygiene grep and an ERROR
 1813: 				    would trip #261's break-on-ERROR.  */
 1814: 				d->warned_empty_drain = 1;
 1815: 				/*  *** THE TEXT SAID "no sector buffered; write dropped" AND BOTH HALVES
 1816: 				    COULD BE FALSE.  Measured by the Opus seat on #478 pass 2,
 1817: 				    end-to-end through the registers, no struct poking. ***
 1818: 
 1819: 				    `inbuf_len == 0` is reached by TWO routes: an empty ring, and a
 1820: 				    STALE LOCAL after a CDB dispatch has consumed it.  On the second
 1821: 				    the guest's bytes were USED, not dropped.  On the leftover door a
 1822: 				    whole 512-byte sector sits in the ring while the message claims
 1823: 				    none is buffered.
 1824: 
 1825: 				    THE HARM WAS NOT THE FALSE SENTENCE.  A spurious emission BURNS
 1826: 				    THE N=1 LATCH, so a later GENUINE drop is announced to nobody --
 1827: 				    this announce could defeat itself, which is exactly the state the
 1828: 				    decline-and-announce ruling exists to prevent.
 1829: 
 1830: 				    The CONDITION is kept: it fires where the unfixed code would have
 1831: 				    put a spurious sector on the disk image, which is worth saying
 1832: 				    however the ring reached that state.  The TEXT now describes what
 1833: 				    happened -- a drain was refused -- instead of asserting a buffer
 1834: 				    state it never checked.  */
 1835: 				fatal("[ wdc: refused a sector drain the buffer "
 1836: 					"cannot justify (once) ]\n");
 1837: 			}
 1838: 		}
 1839: 		break;
 1840: 
 1841: 	case wd_error:	/*  1: error (r), precomp (w)  */
 1842: 		if (writeflag == MEM_READ) {
 1843: 			odata = d->error;
 1844: 			debug("[ wdc: read from ERROR: 0x%02x ]\n", (int)odata);
 1845: 		} else {
 1846: 			d->precomp = idata;
 1847: 			debug("[ wdc: write to PRECOMP: 0x%02x ]\n",(int)idata);
 1848: 		}
 1849: 		break;
 1850: 
 1851: 	case wd_seccnt:	/*  2: sector count (or "ireason" for ATAPI)  */
 1852: 		if (writeflag == MEM_READ) {
 1853: 			odata = d->seccnt;
 1854: 			if (d->atapi_cmd_in_progress) {
 1855: 				odata = d->atapi_phase & (WDCI_CMD | WDCI_IN);
 1856: 			}
 1857: 			debug("[ wdc: read from SECCNT: 0x%02x ]\n",(int)odata);
 1858: 		} else {
 1859: 			d->seccnt = idata;
 1860: 			debug("[ wdc: write to SECCNT: 0x%02x ]\n", (int)idata);
 1861: 		}
 1862: 		break;
 1863: 
 1864: 	case wd_sector:	/*  3: first sector  */
 1865: 		if (writeflag == MEM_READ) {
 1866: 			odata = d->sector;
 1867: 			debug("[ wdc: read from SECTOR: 0x%02x ]\n",(int)odata);
 1868: 		} else {
 1869: 			d->sector = idata;
 1870: 			debug("[ wdc: write to SECTOR: 0x%02x ]\n", (int)idata);
 1871: 		}
 1872: 		break;
 1873: 
 1874: 	case wd_cyl_lo:	/*  4: cylinder low  */
 1875: 		if (writeflag == MEM_READ) {
 1876: 			odata = d->cyl_lo;
 1877: 			if (d->cur_command == COMMAND_RESET &&
 1878: 			    diskimage_is_a_cdrom(cpu->machine,
 1879: 			    d->drive + d->base_drive, DISKIMAGE_IDE))
 1880: 				odata = 0x14;
 1881: 			if (d->atapi_cmd_in_progress) {
 1882: 				int x = d->atapi_len;
 1883: 				if (x > 32768)
 1884: 					x = 32768;
 1885: 				odata = x & 255;
 1886: 			}
 1887: 			debug("[ wdc: read from CYL_LO: 0x%02x ]\n",(int)odata);
 1888: 		} else {
 1889: 			d->cyl_lo = idata;
 1890: 			debug("[ wdc: write to CYL_LO: 0x%02x ]\n", (int)idata);
 1891: 		}
 1892: 		break;
 1893: 
 1894: 	case wd_cyl_hi:	/*  5: cylinder high  */
 1895: 		if (writeflag == MEM_READ) {
 1896: 			odata = d->cyl_hi;
 1897: 			if (d->cur_command == COMMAND_RESET &&
 1898: 			    diskimage_is_a_cdrom(cpu->machine,
 1899: 			    d->drive + d->base_drive, DISKIMAGE_IDE))
 1900: 				odata = 0xeb;
 1901: 			if (d->atapi_cmd_in_progress) {
 1902: 				int x = d->atapi_len;
 1903: 				if (x > 32768)
 1904: 					x = 32768;
 1905: 				odata = (x >> 8) & 255;
 1906: 			}
 1907: 			debug("[ wdc: read from CYL_HI: 0x%02x ]\n",(int)odata);
 1908: 		} else {
 1909: 			d->cyl_hi = idata;
 1910: 			debug("[ wdc: write to CYL_HI: 0x%02x ]\n", (int)idata);
 1911: 		}
 1912: 		break;
 1913: 
 1914: 	case wd_sdh:	/*  6: sectorsize/drive/head  */
 1915: 		if (writeflag==MEM_READ) {
 1916: 			odata = (d->sectorsize << 6) + (d->lba << 5) +
 1917: 			    (d->drive << 4) + (d->head);
 1918: 			debug("[ wdc: read from SDH: 0x%02x (sectorsize %i,"
 1919: 			    " lba=%i, drive %i, head %i) ]\n", (int)odata,
 1920: 			    d->sectorsize, d->lba, d->drive, d->head);
 1921: 		} else {
 1922: 			d->sectorsize = (idata >> 6) & 3;
 1923: 			d->lba   = (idata >> 5) & 1;
 1924: 			d->drive = (idata >> 4) & 1;
 1925: 			d->head  = idata & 0xf;
 1926: 			debug("[ wdc: write to SDH: 0x%02x (sectorsize %i,"
 1927: 			    " lba=%i, drive %i, head %i) ]\n", (int)idata,
 1928: 			    d->sectorsize, d->lba, d->drive, d->head);
 1929: 		}
 1930: 		break;
 1931: 
 1932: 	case wd_command:	/*  7: command or status  */
 1933: 		if (writeflag==MEM_READ) {
 1934: 			odata = status_byte(d, cpu);
 1935: 			if (!quiet_mode)
 1936: 				debug("[ wdc: read from STATUS: 0x%02x ]\n",
 1937: 				    (int)odata);
 1938: 			INTERRUPT_DEASSERT(d->irq);
 1939: 			d->int_assert = 0;
 1940: 		} else {
 1941: 			debug("[ wdc: write to COMMAND: 0x%02x ]\n",(int)idata);
 1942: 			wdc_command(cpu, d, idata);
 1943: 		}
 1944: 		break;
 1945: 
 1946: 	default:
 1947: 		if (writeflag==MEM_READ)
 1948: 			debug("[ wdc: read from 0x%02x ]\n",
 1949: 			    (int)relative_addr);
 1950: 		else
 1951: 			debug("[ wdc: write to  0x%02x: 0x%02x ]\n",
 1952: 			    (int)relative_addr, (int)idata);
 1953: 	}
 1954: 
 1955: 	/*  Assert interrupt, if necessary:  */
 1956: 	dev_wdc_tick(cpu, extra);
 1957: 
 1958: ret:
 1959: 	if (writeflag == MEM_READ) {
 1960: 		if (relative_addr == wd_data)
 1961: 			memory_writemax64(cpu, data, len, odata);
 1962: 		else {
 1963: 			/*  #464: latch the announcement only.  This sits
 1964: 			    INSIDE the function's common `ret:` tail, so
 1965: 			    `data[0] = odata` and the `return 1` below must run
 1966: 			    regardless -- an early return here would hand the
 1967: 			    guest an untouched read buffer.  */
 1968: 			if (len != 1 && !d->warned_nonbyte_read) {
 1969: 				d->warned_nonbyte_read = 1;
 1970: 				fatal("[ wdc: WARNING! non-8-bit access on "
 1971: 				    "READ! ]\n");
 1972: 			}
 1973: 			data[0] = odata;
 1974: 		}
 1975: 	}
 1976: 
 1977: 	return 1;
 1978: }
 1979: 
 1980: 
 1981: DEVINIT(wdc)
 1982: {
 1983: 	struct wdc_data *d;
 1984: 	uint64_t alt_status_addr;
 1985: 	int i, tick_shift = WDC_TICK_SHIFT;
 1986: 
 1987: 	CHECK_ALLOCATION(d = (struct wdc_data *) malloc(sizeof(struct wdc_data)));
 1988: 	memset(d, 0, sizeof(struct wdc_data));
 1989: 
 1990: 	INTERRUPT_CONNECT(devinit->interrupt_path, d->irq);
 1991: 	d->addr_mult  = devinit->addr_mult;
 1992: 	d->data_debug = 1;
 1993: 	d->io_enabled = 1;
 1994: 	d->error      = 1;
 1995: 
 1996: 	d->inbuf = (unsigned char *) zeroed_alloc(WDC_INBUF_SIZE);
 1997: 
 1998: 	/*  base_drive = 0 for the primary controller, 2 for the secondary.  */
 1999: 	d->base_drive = 0;
 2000: 	if ((devinit->addr & 0xfff) == 0x170)
 2001: 		d->base_drive = 2;
 2002: 
 2003: 	alt_status_addr = devinit->addr + 0x206;
 2004: 
 2005: 	/*  Special hacks for individual machines:  */
 2006: 	switch (devinit->machine->machine_type) {
 2007: 	case MACHINE_MACPPC:
 2008: 		alt_status_addr = devinit->addr + 0x160;
 2009: 		break;
 2010: 	case MACHINE_HPCMIPS:
 2011: 		/*  TODO: Fix  */
 2012: 		if (devinit->addr == 0x14000180)
 2013: 			alt_status_addr = 0x14000386;
 2014: 		break;
 2015: 	case MACHINE_IQ80321:
 2016: 		alt_status_addr = devinit->addr + 0x402;
 2017: 		break;
 2018: 	}
 2019: 
 2020: 	/*  Get disk geometries:  */
 2021: 	for (i=0; i<2; i++)
 2022: 		if (diskimage_exist(devinit->machine, d->base_drive +i,
 2023: 		    DISKIMAGE_IDE))
 2024: 			diskimage_getchs(devinit->machine, d->base_drive + i,
 2025: 			    DISKIMAGE_IDE, &d->cyls[i], &d->heads[i],
 2026: 			    &d->sectors_per_track[i]);
 2027: 
 2028: 	memory_device_register(devinit->machine->memory, "wdc_altstatus",
 2029: 	    alt_status_addr, 2, dev_wdc_altstatus_access, d, DM_DEFAULT, NULL);
 2030: 	memory_device_register(devinit->machine->memory, devinit->name,
 2031: 	    devinit->addr, DEV_WDC_LENGTH * devinit->addr_mult, dev_wdc_access,
 2032: 	    d, DM_DEFAULT, NULL);
 2033: 
 2034: 	machine_add_tickfunction(devinit->machine, dev_wdc_tick,
 2035: 	    d, tick_shift);
 2036: 
 2037: 	devinit->return_ptr = d;
 2038: 
 2039: 	return 1;
 2040: }
 2041: 

exec
