  153: R_DATA, R_SECCNT, R_SECTOR = 0, 2, 3
  154: R_CYL_LO, R_CYL_HI, R_SDH = 4, 5, 6
  155: R_STATUS = 7                       # wd_command on write, wd_status on read
  156: 
  157: #  Status bits -- wdcreg.h
  158: DRDY, DSC, DRQ, ERR = 0x40, 0x10, 0x08, 0x01
  159: 
  160: #  status_byte() ORs DRDY|DSC because diskimage_exist() is true for the attached IDE
  161: #  image; DRQ iff (inbuf_head != inbuf_tail) OR write_in_progress; ERR iff d->error.
  162: #
  163: #  d->error IS SET AT DEVINIT.  Grep it as "->error" -- dev_wdc_init writes
  164: #  "d->error      = 1;" with the field name padded, so a grep for "d->error = 1" with a
  165: #  SINGLE space MATCHES NOTHING and reports that the field starts at 0.  It did, while
  166: #  this file was being written, and the first run's measured 0x51 against a predicted
  167: #  0x50 is what sent me back to look.  A pattern that matches nothing reports zero for
  168: #  everything, which is this project's oldest apparatus trap -- and here the measurement
  169: #  caught the reading rather than the other way round.
  170: #
  171: #  wdc_command() clears it ("d->error = 0" at the top), so the power-on ERR bit stands
  172: #  only until the first phase issues WDCC_WRITE.
  173: ST_POWERON = DRDY | DSC | ERR      # 0x51  before any command has been issued
  174: ST_IDLE = DRDY | DSC               # 0x50  ring empty, no write armed, error cleared
  175: ST_ARMED = DRDY | DSC | DRQ        # 0x58  write_in_progress set
  176: 
  177: WDCC_WRITE = 0x30                  # wdcreg.h
  178: WDCTL_RST = 0x04
  179: WDCTL_IDS = 0x02
  180: SRST_POKE = WDCTL_IDS | WDCTL_RST  # 0x06 -- what older OpenBSD asserts; #481's value
  181: NIEN_POKE = WDCTL_IDS              # 0x02 -- no reset bit at all
  182: BARE_RST = WDCTL_RST               # 0x04 -- RST with nothing else set
  183: 
  184: STAGE = [0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78]
  185: 
  186: zero, v0, v1, a0, a1, a2, a3 = 0, 2, 3, 4, 5, 6, 7
  187: t0, t1, t2, t3 = 8, 9, 10, 11
  188: t4, t5, t6 = 12, 13, 14            # PHASE 4's results; t3 is e_store()'s scratch
  189: s0, s1, s2, s3, s4, s5, s6, s7 = 16, 17, 18, 19, 20, 21, 22, 23
  190: t9 = 25
  191: 
  192: 
  193: def I(op, rs, rt, imm):
  194:     return (op << 26) | (rs << 21) | (rt << 16) | (imm & 0xffff)
  195: 
  196: 
  197: def lui(rt, imm):
  198:     return I(0x0F, 0, rt, imm)
  199: 
  200: 
  201: def ori(rt, rs, imm):
  202:     return I(0x0D, rs, rt, imm)
  203: 
  204: 
  205: def addiu(rt, rs, imm):
  206:     return I(0x09, rs, rt, imm)
  207: 
  208: 
  209: def sb(rt, off, base):
  210:     return I(0x28, base, rt, off)
  211: 
  212: 
  213: def lbu(rt, off, base):
  214:     return I(0x24, base, rt, off)
  215: 
  216: 
  217: def beq(rs, rt, off):
  218:     return I(0x04, rs, rt, off)
  219: 
  220: 
  221: NOP = 0
  222: NAME = {zero: "zr", v0: "v0", v1: "v1", a0: "a0", a1: "a1", a2: "a2", a3: "a3",
  223:         t0: "t0", t1: "t1", t2: "t2", t3: "t3", t4: "t4", t5: "t5", t6: "t6",
  224:         s0: "s0", s1: "s1", s2: "s2",
  225:         s3: "s3", s4: "s4", s5: "s5", s6: "s6", s7: "s7", t9: "t9"}
  226: 
  227: prog = []
  228: 
  229: 
  230: def emit(word, mn):
  231:     """mn is checked against the EMULATOR'S OWN disassembly.
  232: 
  233:     A wrong register field silently yields 0, and 0 is a value several rows below would
  234:     accept by accident -- this project has shipped that mistake into a committed gate.
  235:     """
  236:     prog.append((word, mn))
  237: 
  238: 
  239: def e_li(rt, v):
  240:     emit(addiu(rt, zero, v), "addiu %s,zr,%d" % (NAME[rt], v))
  241: 
  242: 
  243: def e_sb(rt, off, base):
  244:     emit(sb(rt, off, base), "sb %s,%d(%s)" % (NAME[rt], off, NAME[base]))
  245: 
  246: 
  247: def e_lbu(rt, off, base):
  248:     emit(lbu(rt, off, base), "lbu %s,%d(%s)" % (NAME[rt], off, NAME[base]))
  249: 
  250: 
  251: def e_store(val, off, base):
  252:     e_li(t3, val)
  253:     e_sb(t3, off, base)
  254: 
  255: 
  256: def arm_a_write():
  257:     """Arm WDCC_WRITE and stage STAGE into the input ring.
  258: 
  259:     wdc_command() -> wdc__write() sets d->write_in_progress = d->cur_command, which is
  260:     what makes status_byte() raise DRQ.  wdc_command() also calls
  261:     wdc_new_command_reset(), so each phase starts from a clean ring on BOTH legs
  262:     regardless of what the previous phase left -- that is what keeps the phases
  263:     independent, and it is why phase 3 measures the same thing on both legs even though
  264:     phase 2 left them in different states.
  265: 
  266:     len(STAGE) is 8, deliberately NOT a multiple of 512: the sector drain inside
  267:     DEVICE_ACCESS(wdc) fires on "inbuf_len % 512 == 0", so nothing reaches the disk
  268:     image and the staged bytes simply sit in the ring where the reset can destroy them.
  269:     """
  270:     e_store(0xa0, R_SDH, t0)       # drive 0, head 0 (bits 7 and 5 are the obsolete 1s)
  271:     e_store(0x01, R_SECCNT, t0)
  272:     e_store(0x01, R_SECTOR, t0)
  273:     e_store(0x00, R_CYL_LO, t0)
  274:     e_store(0x00, R_CYL_HI, t0)
  275:     e_store(WDCC_WRITE, R_STATUS, t0)
  276:     for b in STAGE:
  277:         e_store(b, R_DATA, t0)
  278: 
  279: 
  280: #  ---------------------------------------------------------------- setup
  281: emit(lui(t0, WDC_HI), "lui t0,0xb800")
  282: emit(ori(t0, t0, WDC_LO), "ori t0,t0,0x01f0")
  283: emit(lui(t1, ALT_HI), "lui t1,0xb800")
  284: emit(ori(t1, t1, ALT_LO), "ori t1,t1,0x03f6")
  285: emit(lui(t2, RAM_HI), "lui t2,0x8020")
  286: 
  287: #  A -- RAM LIVENESS: the same instruction shapes, through plain RAM.
  288: e_store(0x55, 0, t2)
  289: e_lbu(v0, 0, t2)
  290: 
  291: #  B -- DEVICE-REGISTER LIVENESS: #481's 0x6655, through the wdc's own decode.
  292: e_store(0x55, R_CYL_LO, t0)
  293: e_store(0x66, R_CYL_HI, t0)
  294: e_lbu(v1, R_CYL_LO, t0)
  295: e_lbu(a0, R_CYL_HI, t0)
  296: 
  297: #  C -- DEVICE SIGNATURE: the data port is a FIFO, not a cell.
  298: e_store(0x5a, R_DATA, t0)
  299: e_store(0xa5, R_DATA, t0)
  300: e_lbu(a1, R_DATA, t0)
  301: e_lbu(a2, R_DATA, t0)
  302: 
  303: #  D -- DEVICE SIGNATURE: a status byte the guest never wrote.
  304: e_lbu(a3, R_STATUS, t0)
  305: 
  306: #  ------------------------------------------------- PHASE 1: 0x3f6, a real SRST
  307: arm_a_write()
  308: e_lbu(s0, R_STATUS, t0)            # armed -> DRQ set
  309: e_store(SRST_POKE, 0, t1)          # <<< 0x3f6, the Device Control register
  310: e_lbu(s1, R_STATUS, t0)            # both legs: DRQ CLEAR
  311: e_lbu(s2, R_DATA, t0)              # both legs: 0xff, the ring is empty
  312: 
  313: #  ------------------------------------- PHASE 2: 0x3f7, THE READ-ONLY REGISTER
  314: arm_a_write()
  315: e_lbu(s3, R_STATUS, t0)            # armed -> DRQ set
  316: e_store(SRST_POKE, 1, t1)          # <<< 0x3f7, the Drive Address Register
  317: e_lbu(s4, R_STATUS, t0)            # base: DRQ CLEAR   fix: DRQ still SET
  318: e_lbu(s5, R_DATA, t0)              # base: 0xff        fix: 0x71, the staged byte
  319: 
  320: #  ------------------------- PHASE 3: 0x3f7 again, with the RESET BIT NOT SET
  321: arm_a_write()
  322: e_lbu(s6, R_STATUS, t0)            # armed -> DRQ set
  323: e_store(NIEN_POKE, 1, t1)          # <<< 0x3f7 with WDCTL_RST clear
  324: e_lbu(s7, R_STATUS, t0)            # both legs: DRQ still SET
  325: e_lbu(t9, R_DATA, t0)              # both legs: 0x71
  326: 
  327: #  ---------------- PHASE 4: 0x3f7 carrying the BARE reset bit, 0x04 not 0x06
  328: #
  329: #  WHY A SECOND VALUE AT THE SAME OFFSET IS NOT A DUPLICATE ROW.  Phase 2's only
  330: #  defect-side store is 0x06, and 0x06 is ALSO the value #481's comment records as
  331: #  real traffic ("Older OpenBSD asserts with 0x06").  So the plausible future edit
  332: #  is to tighten the decline to the value someone has seen -- `relative_addr != 0 &&
  333: #  idata == 0x06` -- which keeps every phase-2 row GREEN and re-opens the defect for
  334: #  0x04, 0x0c and 0x0e.  This phase is the row that refuses that edit.
  335: #
  336: #  0x04 is the discriminating choice rather than an arbitrary second value: it kills
  337: #  an equality guard on 0x06, and phase 2 symmetrically kills any re-aim to 0x04.
  338: arm_a_write()
  339: e_lbu(t4, R_STATUS, t0)            # armed -> DRQ set
  340: e_store(BARE_RST, 1, t1)           # <<< 0x3f7, reset bit alone
  341: e_lbu(t5, R_STATUS, t0)            # base: DRQ CLEAR   fix: DRQ still SET
  342: e_lbu(t6, R_DATA, t0)              # base: 0xff        fix: 0x71, the staged byte
  343: 
  344: HALT = len(prog)
  345: emit(beq(zero, zero, -1), "b 0x")
  346: emit(NOP, "nop")
  347: HALT_ADDR = BASE + HALT * 4
  348: 
  349: REGS = ("v0", "v1", "a0", "a1", "a2", "a3", "t4", "t5", "t6",
  350:         "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "t9")
  351: 
  352: FF = 0xff       # wdc_get_inbuf() returns (uint64_t)-1 on an empty ring; lbu takes 0xff
  353: 
  354: #  label, register, want on the COMMITTED build, want on the FIX leg, kind
  355: ROWS = [
  356:     ("A   liveness   RAM round-trip, same sb/lbu shapes",
  357:      "v0", 0x55, 0x55, "control"),
  358:     ("B   liveness   cyl_lo readback (0x6655 low byte)",
  359:      "v1", 0x55, 0x55, "control"),
  360:     ("B   liveness   cyl_hi readback (0x6655 high byte)",
  361:      "a0", 0x66, 0x66, "control"),
  362:     ("C   devsig     data port 1st read -- a FIFO",
  363:      "a1", 0x5a, 0x5a, "control"),
  364:     ("C   devsig     data port 2nd read -- not a cell",
  365:      "a2", 0xa5, 0xa5, "control"),
  366:     ("D   devsig     status byte computed by the device",
  367:      "a3", ST_POWERON, ST_POWERON, "control"),
  368:     ("P1  liveness   armed for the 0x3f6 phase: DRQ SET",
  369:      "s0", ST_ARMED, ST_ARMED, "control"),
  370:     ("P1  accept     0x3f6 SRST aborts the write: DRQ CLEAR",
  371:      "s1", ST_IDLE, ST_IDLE, "accept"),
  372:     ("P1  accept     0x3f6 SRST purged the ring: 0xff",
  373:      "s2", FF, FF, "accept"),
  374:     ("P2  liveness   armed for the 0x3f7 phase: DRQ SET",
  375:      "s3", ST_ARMED, ST_ARMED, "control"),
  376:     ("P2  *DEFECT*   0x3f7 store aborts the live write",
  377:      "s4", ST_IDLE, ST_ARMED, "defect"),
  378:     ("P2  *DEFECT*   0x3f7 store purged the staged bytes",
  379:      "s5", FF, 0x71, "defect"),
  380:     ("P3  liveness   armed for the nIEN phase: DRQ SET",
  381:      "s6", ST_ARMED, ST_ARMED, "control"),
  382:     ("P3  control    0x3f7 without WDCTL_RST: DRQ still SET",
  383:      "s7", ST_ARMED, ST_ARMED, "control"),
  384:     ("P3  control    0x3f7 without WDCTL_RST: bytes intact",
  385:      "t9", 0x71, 0x71, "control"),
  386:     ("P4  liveness   armed for the bare-RST phase: DRQ SET",
  387:      "t4", ST_ARMED, ST_ARMED, "control"),
  388:     ("P4  *DEFECT*   0x3f7 bare RST 0x04 aborts the write",
  389:      "t5", ST_IDLE, ST_ARMED, "defect"),
  390:     ("P4  *DEFECT*   0x3f7 bare RST 0x04 purged the bytes",
  391:      "t6", FF, 0x71, "defect"),
  392: ]
  393: 
  394: #  THE PADDED-COLUMN TRAP, refused by construction.  The result line formats the
  395: #  label with %-56s; a label AT OR OVER that width runs into the next column and a
  396: #  gate grepping for `^<label> .*ok$` then matches NOTHING -- the row silently stops
  397: #  being tested.  This project has shipped that defect before, so it is asserted
  398: #  here rather than remembered.
  399: _LW = max(len(r[0]) for r in ROWS)
  400: assert _LW < 56, 'row label %d chars, the %%-56s column silently truncates' % _LW
  401: 
  402: #  And the registers must be DISTINCT: two rows sharing one register would both
  403: #  report whatever the later store left, which reads as agreement.
  404: assert len(set(r[1] for r in ROWS)) == len(ROWS), 'two rows share a register'
  405: 
  406: 
  407: class Emu(object):
  408:     def __init__(self, argv, boot_wait=5.0):
  409:         self.buf = bytearray()
  410:         self.pid, self.fd = pty.fork()
  411:         if self.pid == 0:
  412:             try:
  413:                 os.execvp(argv[0], argv)
  414:             finally:
  415:                 os._exit(127)
  416:         self.drain(boot_wait)
  417: 
  418:     def drain(self, seconds):
  419:         end = time.time() + seconds
  420:         while time.time() < end:
  421:             r, _, _ = select.select([self.fd], [], [], 0.05)
  422:             if self.fd in r:
  423:                 try:
  424:                     d = os.read(self.fd, 65536)
  425:                 except OSError:
  426:                     return
  427:                 if not d:
  428:                     return
  429:                 self.buf.extend(d)
  430: 
  431:     def send(self, cmd, wait=0.4):
  432:         start = len(self.buf)
  433:         data = (cmd + "\n").encode()
  434:         view = memoryview(data)
  435:         while len(view):
  436:             n = os.write(self.fd, view)
  437:             view = view[n:]
  438:             if len(view):
  439:                 self.drain(0.05)
  440:         self.drain(wait)
  441:         return bytes(self.buf[start:]).decode("latin1", "replace")
  442: 
  443:     def close(self, log):
  444:         try:
  445:             os.write(self.fd, b"quit\n")
  446:             self.drain(0.4)
  447:         except OSError:
  448:             pass
  449:         for fn in (lambda: os.close(self.fd),
  450:                    lambda: os.kill(self.pid, 9),
  451:                    lambda: os.waitpid(self.pid, 0)):
  452:             try:
  453:                 fn()
  454:             except OSError:
  455:                 pass
  456:         with open(log, "w") as f:
  457:             f.write(bytes(self.buf).decode("latin1", "replace"))
  458: 
  459: 
  460: def reg(emu, name):
  461:     for _ in range(5):
  462:         out = emu.send("print %s" % name, wait=0.35)
  463:         m = re.findall(r"0x[0-9a-fA-F]+", out)
  464:         if m:
  465:             return int(m[-1], 16)
  466:         emu.drain(0.25)
  467:     return None
  468: 
  469: 
  470: def run_one(binary, tag, out):
  471:     argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
  472:             "-d", DISK_PREFIX + DISK, "0x%x:%s" % (BASE, RAWBIN)]
  473:     out("  command   " + " ".join(argv))
  474:     emu = Emu(argv)
  475: 
  476:     #  CONTROL 0 -- every hand-encoded word checked against the emulator's own
  477:     #  disassembler.  Addresses are printed WITHOUT an 0x prefix.  The WORD is the
  478:     #  authoritative check; the mnemonic is a rendering and is counted separately so a
  479:     #  spelling this file guessed wrong cannot masquerade as a bad encoding.
  480:     dis = emu.send("unassemble 0x%x 0x%x" % (BASE, BASE + len(prog) * 4), wait=3.0)
  481:     seen = {}
  482:     for line in dis.splitlines():
  483:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
  484:         if m:
  485:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
  486: 
  487:     w_ok = m_ok = 0
  488:     bad = []
  489:     for i, (w, want_mn) in enumerate(prog):
  490:         addr = (BASE + i * 4) & 0xffffffff
  491:         hit = seen.get(addr)
  492:         if hit is None:
  493:             bad.append("  BAD  0x%08x  no disassembly line" % addr)
  494:             continue
  495:         gotw, gotmn = hit
  496:         norm = " ".join(gotmn.replace("\t", " ").split())
  497:         if gotw == "%08x" % w:
  498:             w_ok += 1
  499:         else:
  500:             bad.append("  BAD  0x%08x  word %s vs %08x" % (addr, gotw, w))
  501:         if norm.startswith(" ".join(want_mn.split())):
  502:             m_ok += 1
  503:         else:
  504:             bad.append("  MNEMONIC 0x%08x  got %r want %r" % (addr, norm, want_mn))
  505:     out("  CONTROL 0 encodings: %d of %d WORDS and %d of %d mnemonics agree with the"
  506:         " emulator's own disassembler" % (w_ok, len(prog), m_ok, len(prog)))
  507:     for l in bad:
  508:         out(l)
  509: 
  510:     pc0 = reg(emu, "pc")
  511:     out("  pc at entry = %s (want 0x%016x)"
  512:         % (("0x%016x" % pc0) if pc0 is not None else "UNREADABLE", BASE))
  513: 
  514:     emu.send("breakpoint add 0x%x" % HALT_ADDR, wait=0.5)
  515:     t = time.time()
  516:     emu.send("continue", wait=1.0)
  517:     deadline = time.time() + 120
  518:     hit = False
  519:     while time.time() < deadline:
  520:         emu.drain(0.5)
  521:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
  522:         #  *** MATCH THE HIT LINE, NOT THE BARE WORD. ***  This read
  523:         #  `if "BREAKPOINT" in <tail>.upper():` until 2026-08-30, and the
  524:         #  transcript contains the probe's OWN echoed setup command,
  525:         #  `breakpoint add 0x...`.  The check matched its own input and could
  526:         #  never return False.  It was right by accident in every run where the
  527:         #  guest parked, and silently wrong in the first run where it did not:
  528:         #  a mutant returning 0 from the device handler raises EXCEPTION_DBE, the
  529:         #  guest re-executes the faulting store forever, and the probe still
  530:         #  reported `breakpoint reached: True` with every register reading ??.
  531:         #  That was scored as a KILL -- a failed run counted as a table result.
  532:         #  The emulator prints `BREAKPOINT: pc = 0x...` on a real hit.
  533:         if "BREAKPOINT: PC" in tail.upper():
  534:             hit = True
  535:             break
  536:     elapsed = time.time() - t
  537:     out("  parked at the halt breakpoint: %s   (%.2f s)"
  538:         % ("yes" if hit else
  539:            "*** NO -- the guest never reached 0x%016x ***" % HALT_ADDR, elapsed))
  540: 
  541:     got = {}
  542:     for nm in REGS:
  543:         v = reg(emu, nm)
  544:         got[nm] = None if v is None else (v & 0xff)
  545: 
  546:     whole = bytes(emu.buf).decode("latin1", "replace")
  547:     diags = {n: whole.count(n) for n in
  548:              ("write to DATA, but not", "reading too much", "wdc inbuf overrun",
  549:               "wdc inbuf full", "write to ALT. CTRL", "DRIVE ADDRESS")}
  550:     emu.close(os.path.join(OUTDIR, "transcript_%s.log" % tag))
  551:     return got, w_ok, m_ok, hit, diags
  552: 
  553: 
  554: def main():
  555:     global RAWBIN
  556:     os.makedirs(OUTDIR, exist_ok=True)
  557:     RAWBIN = os.path.join(OUTDIR, "wdcaltoff.bin")
  558:     with open(RAWBIN, "wb") as f:
  559:         for w, _ in prog:
  560:             f.write(bytes([w & 0xff, (w >> 8) & 0xff,
  561:                            (w >> 16) & 0xff, (w >> 24) & 0xff]))
  562: 
  563:     lines = []
  564: 
  565:     def out(s=""):
  566:         lines.append(s)
  567:         print(s)
  568:         sys.stdout.flush()
  569: 
  570:     out("=" * 94)
  571:     out("wdcaltoffset -- RUNG-3 WITNESS + DETECTOR on unmodified `evbmips -e malta`")
  572:     out("=" * 94)
  573:     out("date      %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
  574:     out("machine   evbmips -e malta   5Kc, LITTLE endian   (machine desc UNMODIFIED)")
  575:     out("wdc       physical 0x180001f0 via bus_pci piix4_ide; KSEG1 0xffffffffb80001f0")
  576:     out("altstat   physical 0x180003f6 len 2; offset 1 = 0x180003f7 = the READ-ONLY")
  577:     out("          Drive Address Register, KSEG1 0xffffffffb80003f7")
  578:     out("program   %d guest instructions at 0x%016x, parks at 0x%016x"
  579:         % (len(prog), BASE, HALT_ADDR))
  580:     out("staged    %d bytes per phase (%s) -- NOT a multiple of 512, so the sector"
