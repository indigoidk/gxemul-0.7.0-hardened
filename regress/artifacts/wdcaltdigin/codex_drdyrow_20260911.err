  118: # Register liveness
  119: e_store(0x55, R_CYL_LO, t0)
  120: e_store(0x66, R_CYL_HI, t0)
  121: e_lbu(v1, R_CYL_LO, t0)
  122: e_lbu(a0, R_CYL_HI, t0)
  123: 
  124: # FIFO signature
  125: e_store(0x5a, R_DATA, t0)
  126: e_store(0xa5, R_DATA, t0)
  127: e_lbu(a1, R_DATA, t0)
  128: e_lbu(a2, R_DATA, t0)
  129: 
  130: # Power-on status signature
  131: e_lbu(a3, R_STATUS, t0)
  132: 
  133: # 2. Phase R1: Altstatus reads at power-on
