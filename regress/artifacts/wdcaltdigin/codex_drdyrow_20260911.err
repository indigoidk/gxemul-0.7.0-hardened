  109: emit(lui(t1, ALT_HI), "lui t1,0xb800")
  110: emit(ori(t1, t1, ALT_LO), "ori t1,t1,0x03f6")
  111: emit(lui(t2, RAM_HI), "lui t2,0x8020")
