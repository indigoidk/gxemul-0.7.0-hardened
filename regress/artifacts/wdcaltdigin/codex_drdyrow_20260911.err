   98:     e_store(0x01, R_SECTOR, t0)
   99:     e_store(0x00, R_CYL_LO, t0)
  100:     e_store(0x00, R_CYL_HI, t0)
  101:     e_store(WDCC_WRITE, R_STATUS, t0)
  102:     for b in STAGE:
  103:         e_store(b, R_DATA, t0)
