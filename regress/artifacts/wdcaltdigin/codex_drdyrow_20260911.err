   67:     return I(0x24, base, rt, off)
   68: 
   69: def beq(rs, rt, off):
   70:     return I(0x04, rs, rt, off)
   71: 
   72: NOP = 0
   73: NAME = {zero: "zr", v0: "v0", v1: "v1", a0: "a0", a1: "a1", a2: "a2", a3: "a3",
   74:         t0: "t0", t1: "t1", t2: "t2", t3: "t3", s0: "s0", s1: "s1", s2: "s2",
   75:         s3: "s3", s4: "s4", s5: "s5", s6: "s6", s7: "s7", t8: "t8", t9: "t9"}
   76: 
   77: prog = []
   78: 
   79: def emit(word, mn):
   80:     prog.append((word, mn))
   81: 
   82: def e_li(rt, v):
   83:     emit(addiu(rt, zero, v), "addiu %s,zr,%d" % (NAME[rt], v))
   84: 
   85: def e_sb(rt, off, base):
   86:     emit(sb(rt, off, base), "sb %s,%d(%s)" % (NAME[rt], off, NAME[base]))
   87: 
   88: def e_lbu(rt, off, base):
   89:     emit(lbu(rt, off, base), "lbu %s,%d(%s)" % (NAME[rt], off, NAME[base]))
   90: 
   91: def e_store(val, off, base):
   92:     e_li(t3, val)
   93:     e_sb(t3, off, base)
