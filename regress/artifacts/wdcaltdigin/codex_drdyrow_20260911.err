  167:     ("CONTROL_CYL_HI_LIVENESS",    "a0", 0x66, "control", "cyl_hi readback"),
  168:     ("CONTROL_FIFO_DEVSIG_1",      "a1", 0x5a, "control", "FIFO data port 1st read"),
  169:     ("CONTROL_FIFO_DEVSIG_2",      "a2", 0xa5, "control", "FIFO data port 2nd read"),
  170:     ("CONTROL_STATUS_POWERON",     "a3", ST_POWERON, "control", "Status byte at power-on (+7)"),
  171:     ("ACCEPT_READ_OFF0_POWERON",   "s0", ST_POWERON, "accept",  "Legal offset-0 read returns S (0x51 != 0)"),
  172:     ("CORE_READ_OFF1_POWERON",     "s1", 0x00,       "core",    "Offset-1 read declined: want 0x00 != S"),
  173:     ("CONTROL_STATUS_ARMED",       "s2", ST_ARMED,   "control", "Armed status (+7) has DRQ set (0x58)"),
  174:     ("ACCEPT_READ_OFF0_ARMED",     "s3", ST_ARMED,   "accept",  "Legal offset-0 read returns S_armed (0x58 != 0)"),
  175:     ("CORE_READ_OFF1_ARMED",       "s4", 0x00,       "core",    "Offset-1 read armed declined: want 0x00 != S_armed"),
  176:     ("WRITE0_SRST_DRQ_CLEAR",      "s5", ST_IDLE,    "accept",  "#481: offset-0 SRST clears DRQ (0x50)"),
  177:     ("WRITE0_SRST_RING_PURGED",    "s6", FF,         "accept",  "#481: offset-0 SRST purges ring (0xff)"),
  178:     ("CONTROL_STATUS_ARMED_W2",    "s7", ST_ARMED,   "control", "Re-armed status for Phase W2 (0x58)"),
  179:     ("WRITE1_DECLINE_DRQ_SET",     "t8", ST_ARMED,   "accept",  "#494: offset-1 SRST declined: DRQ still set (0x58)"),
  180:     ("WRITE1_DECLINE_RING_INTACT", "t9", 0x71,       "accept",  "#494: offset-1 SRST declined: byte 0x71 intact"),
