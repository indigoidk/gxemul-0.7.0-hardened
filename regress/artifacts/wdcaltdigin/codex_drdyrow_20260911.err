    1: #!/bin/bash
    2: # GATE 10 -- SuperH floating-point rounding mode, measured on real guest instructions.
    3: #
    4: # What this protects
    5: # -----------------
    6: # #296 wired FPSCR.RM into thirteen of the sixteen single-precision store sites in
    7: # cpu_sh_instr.c. Before it, the field was guest-writable and decoded NOWHERE: every store
    8: # truncated. Truncation is round-toward-zero, which is the mode the SH-4 resets into, so
    9: # there was no visible defect until you look at a guest that CHANGES the mode -- and
   10: # OpenBSD/landisk installs round-to-nearest at every exec.
   11: #
   12: # Why the vectors look the way they do
   13: # -----------------------------------
   14: # Each one runs under BOTH modes and expects DIFFERENT answers, so reverting #296 turns the
   15: # gate red. Two vectors are deliberately mode-INDEPENDENT and named PIN: they record limits
   16: # that are real and are NOT fixed (double precision cannot be fixed at the store, and the
   17: # host-double double-rounding is shared by every CPU core). A pin failing means someone
   18: # changed a known limitation without updating the record -- which is worth knowing either
   19: # way, and is the opposite of a check that cannot fail.
   20: #
   21: # The gate asserts on the number of discriminating vectors as well as on the results,
   22: # because a table where every vector wants the same answer in both modes would pass
   23: # vacuously. That is the failure mode this harness has now been bitten by five times.
   24: set -u
   25: cd "$(dirname "$0")"
   26: . ./lib.sh
   27: 
   28: gate_begin "gate 10: SuperH rounding mode (#296)"
   29: 
   30: PMAX=${PMAX:-$ROOT/build/gxemul}
   31: KERNEL=$IMAGES/openbsd76-landisk-bsd.rd
   32: LOG=$LOGDIR/gate_sh_rounding.log
   33: 
   34: need_exec "$PMAX"
   35: need_file "$KERNEL"
   36: command -v python3 >/dev/null || gate_skip "python3 not available"
   37: 
   38: note "binary : $PMAX"
   39: note "kernel : $KERNEL (loaded so the machine constructs; never executed)"
   40: note "cold debugger, no media, no console -- the SCIF drops host->guest writes (#293)"
   41: 
   42: python3 sh_rounding_probe.py "$PMAX" "$KERNEL" > "$LOG" 2>&1 || true
   43: 
   44: if ! grep -q "SH_ROUND_RESULT=" "$LOG"; then
   45:     note "probe produced no result line; last lines follow"
   46:     tail -5 "$LOG" | sed 's/^/       /'
   47:     gate_skip "probe did not complete"
   48: fi
   49: 
   50: sed -n '1,/SH_ROUND_DISCRIMINATING/p' "$LOG" | grep -E "ok$|FAIL" | sed 's/^/       /'
   51: 
   52: res=$(grep -o "SH_ROUND_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
   53: got=${res%/*}; want=${res#*/}
   54: disc=$(grep -o "SH_ROUND_DISCRIMINATING=[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
   55: 
   56: # 36 vector-mode pairs: 17 vectors x 2 modes (9 from #296, 6 ftrc rows from #297, and
   57: # #299 turned the double-rounding PIN into a discriminating row and added the fmac
   58: # tie-band witness) + #303's two single-mode subnormal-operand rows (RN pinned; DN
   59: # STRIPPED by their NODN marker -- a DN=1 numeric expectation would bless a value
   60: # real silicon flushes; committed bytes 0x32000001 / 0x3f800001 measured live).
   61: check     "vector-mode pairs run"                  "$want" 36
   62: check     "vector-mode pairs correct"              "$got"  "$want"
   63: # EXACTLY 9 of the 17 vectors discriminate between the two modes: the 7 from #296 plus
   64: # the #299-fixed fsub band row and the #300-fixed D-division row (each a PIN until its
   65: # fix landed; each flip was that fix's acceptance test). If this number drops, someone weakened the table; if it RISES,
   66: # someone made a mode-independent row (an ftrc row, or the fmac tie whose two modes
   67: # genuinely agree) depend on FPSCR.RM, which is drift in the other direction.
   68: # (#303's two rows are single-mode by design and cannot enter this count.)
   69: check     "vectors that discriminate the two modes" "$disc" 9
   70: 
   71: # Per-instruction closure: naming them individually means a single site silently reverting
   72: # cannot hide behind an aggregate count. The ftrc rows are #297's regression checks; the
   73: # "fsub band" and "fmactie" rows are #299's (the pre-#299 build fails the band's RZ arm
   74: # and the tie's RN arm).
   75: for v in "fdiv" "float" "fadd " "fmac " "fmactie" "fipr" "ftrv" "fmul" \
   76:          "fsub band" "faddinf" "Ddiv" "ftrcS-inf" "ftrcS-ovf" "ftrcS-nan" "ftrcS-edge" \
   77:          "ftrcD-2p31" "ftrcD-neghalf"; do
   78:     n=$(grep -c "^$v.*ok$" "$LOG")
   79:     check "  $v: both modes correct" "$n" 2
   80: done
   81: # #303's subnormal rows are SINGLE-mode (RN pinned; see the probe) -- one line each.
   82: for v in "subn fmul" "subn fdiv"; do
   83:     n=$(grep -c "^$v.*ok$" "$LOG")
   84:     check "  $v: RN row correct" "$n" 1
   85: done
   86: 
   87: # ---- #314: legal encodings must not stop the emulator ------------------------
   88: # The SH decoder answered an unimplemented encoding with `goto bad`, which sets
   89: # cpu->running = 0. All eight rows below were measured HALTING the committed
   90: # build; three of them are BASE ISA (MAC.L, MAC.W, TST.B), present since
   91: # SH-1/SH-2 and legal on the SH7751R this rig models -- so this is not a
   92: # question about accepting SH-4A extensions on an SH-4 core.
   93: #
   94: # The probe classifies the outcome from the dyntrans halt MESSAGE, not from a
   95: # memory marker: after the fix the exception is raised and any store placed
   96: # after the test instruction is legitimately never reached, so a marker-only
   97: # check called every repaired row a failure (and called SLEEP, which is
   98: # implemented and simply sleeps, a halt). See the probe's header.
   99: HLOG=$LOGDIR/gate_sh_halt.log
  100: python3 sh_halt_probe.py "$PMAX" "$KERNEL" > "$HLOG" 2>&1 || true
  101: 
  102: if ! grep -q "SH_HALT_RESULT=" "$HLOG"; then
  103:     note "halt probe produced no result line; last lines follow"
  104:     tail -5 "$HLOG" | sed 's/^/       /'
  105:     #  a CHECK, not a gate_skip: the rounding section above has already
  106:     #  recorded results and a skip here would discard them.
  107:     check "halt probe completed" "no" "yes"
  108:     gate_end; exit $?
  109: fi
  110: 
  111: grep -E " ok$| FAIL$" "$HLOG" | sed 's/^/       /'
  112: 
  113: hctrl=$(grep -o "SH_HALT_CONTROL=[A-Z]*" "$HLOG" | tail -1 | cut -d= -f2)
  114: check "halt-probe control proves it measures" "${hctrl:-missing}" "OK"
  115: 
  116: hres=$(grep -o "SH_HALT_RESULT=[0-9]*/[0-9]*" "$HLOG" | tail -1 | cut -d= -f2)
  117: hgot=${hres%/*}; hwant=${hres#*/}
  118: check "halt rows run"     "$hwant" 34
  119: check "halt rows correct" "$hgot"  "$hwant"
  120: 
  121: # Named, so one encoding regressing cannot hide behind a total. Two spaces after
  122: # the name: the probe pads to a fixed column and a name that is a PREFIX of
  123: # another would otherwise match both rows (the trap that made two of gate 14's
  124: # checks unsatisfiable and two of gate 13's count the wrong rows).
  125: for v in "MAC.L" "MAC.W" "TST.B" "STC SGR" "STC.L DBR" "MOVLI.L" "SYNCO" "PREFI"; do
  126:     n=$(count "$HLOG" "^$v  .*ok$")
  127:     check "  survives: $v" "$n" 1
  128: done
  129: 
  130: # ---- #315/#316/#317: execute-time halts, and one dropped store ---------------
  131: # These need a state prologue (FPSCR.SZ/PR, SR.FD, a branch), so the bare
  132: # encoding sweep above is structurally blind to them -- which is why they
  133: # outlived #314. Three of them killed the gxemul PROCESS rather than setting
  134: # cpu->running = 0, so the probe distinguishes a host exit from an emulator
  135: # halt from a live run; a check that only looked for the halt message would
  136: # have scored those as passes.
  137: #
  138: # The two XD rows are load-bearing. The register-pair handlers redirect an ODD
  139: # register field to the XF bank, and an earlier draft computed that redirect
  140: # then still transferred through the original pointer -- which every DR test
  141: # passes. Only a row that seeds fr and xf differently can tell them apart.
  142: #
  143: # `movca.l` carries its own trap: r12 is the DECODER's default source for that
  144: # encoding, so the row seeds r12 with a decoy and fails if the R0 override is
  145: # ever dropped.
  146: # ---- #318: the store-queue flush with the MMU on -----------------------------
  147: # `pref` into the SQ range is a write-back, and with MMUCR.AT set the
  148: # destination comes from the UTLB, not from QACR. That path used to run
  149: # ABORT_EXECUTION.
  150: #
  151: # The probe installs the UTLB entry and MMUCR through GUEST stores to the
  152: # architectural MMIO windows, because the debugger's register names for those
  153: # fields exist but do not reach them -- an earlier version set them by name,
  154: # never entered the AT branch, and would have passed against an unfixed build.
  155: #
  156: # `sq at1 ok` is the composition witness, not just a survival check: the operand
  157: # has nonzero bits in BOTH [9:5] and [4:0], and the architectural destination is
  158: # the translated page plus [9:5] with [4:0] zeroed -- an address that is neither
  159: # the operand nor the page base.
  160: #
  161: # *** THIS BLOCK USED TO PIN THE OPPOSITE OF THE MANUAL, and it said so plainly:
  162: # "a build that judged this access as a read would complete the copy and fail
  163: # this row alone."  It would have.  Corrected in #454. ***
  164: #
  165: # SH7750 Hardware Manual Rev.7.00 4.7.4 "SQ Protection", p. 144 --
  166: # `_scratchpad/sh7750_hardware.txt:11744-11746`, identically in the SH-4
  167: # programming manual 4.6.4 at `sh4_programming.txt:3561-3563`:
  168: #
  169: #     "Write type exception judgment is performed for writes to the SQs, and
  170: #      read type for transfer from the SQs to external memory (PREF
  171: #      instruction), and a TLB miss exception, protection violation exception,
  172: #      or initial page write exception is generated."
  173: #
  174: # Quoted in full because these rows were previously pinned to a panel VERDICT
  175: # rather than to a document, and a future seat must be able to re-derive them
  176: # without trusting this round.  The manual was not in the tree when they were
  177: # first pinned; it is now.
  178: #
  179: # So `sq pr00 rdok` and `sq d0 rdok` FLUSH: privileged read is permitted by
  180: # PR=00 and is indifferent to D.  The three `evt` rows carry the exception
  181: # channel, which is the only channel that can see the change once the copy
  182: # completes either way -- and MEASURED, two one-token mutants scored full marks
  183: # without them, one of which lands the payload at PHYSICAL ZERO in silence.
  184: # The two `itlb` rows kill FLAG_INSTR, which escapes the value rows AND the
  185: # EXPEVT rows because it also yields 0x040.
  186: #
  187: # *** `sq at0 qacr` WAS CALLED "the regression guard: the QACR composition must be
  188: # exactly as before".  MEASURED FALSE in #454 -- the composition can be DELETED
  189: # OUTRIGHT and that row stays green. ***  It pins `addr & 0x03ffffe0` and nothing
  190: # more.  Two structural reasons, neither of them bad luck: no row in the probe ever
  191: # wrote QACR0 or QACR1 and dev_sh4.c seeds them nowhere, so the term under test was
  192: # identically ZERO in every row; and every SQ operand had bit 5 SET, so `sq_nr` was
  193: # 1 in all ten rows and QACR0 was never the register consulted, ever.
  194: #
  195: # The three `sq qacr*` rows are the real guard, and they were added because the
  196: # escape is WITNESSED guest-visible corruption rather than a hypothesis: with AT=0,
  197: # the ordinary store-queue mode without paging, the destination AREA comes entirely
  198: # from QACR, so dropping the term or swapping the two registers lands 32 bytes on
  199: # the wrong physical page.  Measured 34/34 on the fix, 31/34 on each mutant.
  200: #  Row names are capped at 13 CHARACTERS and that is not cosmetic: the probe
  201: #  prints them through %-14s and this pattern demands two spaces after the name,
  202: #  so a 14-character name leaves ONE and the check becomes unsatisfiable -- it
  203: #  counts 0 against an expected 1 and reddens for a reason unrelated to the code.
  204: #  Two of #454's first-draft names broke it.  Measure after any rename.
  205: for v in "sq at1 ok" "sq at1 miss" "sq pr00 rdok" "sq d0 rdok" "sq miss evt" "sq pr00 evt" "sq d0 evt" "sq itlb utlb" "sq itlb decoy" "sq qacr1 dst" "sq qacr1 neg" "sq qacr0 sel" "sq at0 qacr"; do
  206:     n=$(count "$HLOG" "^$v  .*ok$")
  207:     check "  round 81: $v" "$n" 1
  208: done
  209: 
  210: for v in "movca.l" "fmovd @r1" "fmovd @r2" "fmovd xd st" "fmovd xd ld" \
  211:          "fmovd r0idx" "fmovs SZ=0" "fsrra PR=1" "fneg odd PR=1" \
  212:          "fabs odd PR=1" "fp in slot" "trapa in slot"; do
  213:     n=$(count "$HLOG" "^$v  .*ok$")
  214:     check "  round 80: $v" "$n" 1
  215: done
  216: 
  217: # ---- #457: a UTLB associative write matching two entries ended the host -------
  218: #  Wired in the SAME commit as the fix, per gate 6's structural note.
  219: #
  220: #  SIX ROWS, and two of them exist because a survival-only oracle was MEASURED
  221: #  passing six different mutants.  `expevt` + `pc` kills four of them; the other two
  222: #  need rows nothing else provides:
  223: #    * `tlbm sr` pre-sets SR to 0x40008000 so the reset transition's THIRD statement
  224: #      is observable.  From the reset-default SR that statement is a NO-OP, which is
  225: #      why an arm that sets pc and vbr and forgets it passes every other row.
  226: #    * `tlbm single` gives entry 1 a different VPN so nothing should fire.  It is the
  227: #      only row that sees a `n_hits >= 1` mutant, and it doubles as the liveness
  228: #      control -- it proves the three stores execute and the session survives them.
  229: #
  230: #  landisk and not testsh, deliberately: landisk's PROM leaves vbr = 0x8c000000, so
  231: #  `vbr == 0` is a real transition.  On testsh vbr is already 0 and that row would be
  232: #  vacuous.
  233: TMLOG=$LOGDIR/gate_sh_tlbmulti.log
  234: #  *** -u ON ALL SIX PROBES IN THIS GATE. ***  `probeslow` recorded the streaming
  235: #  mitigation as APPLIED and called it "the general fix" -- and it had been applied to
  236: #  NONE of them: the -u lived only in ad-hoc measurement scripts.  These six are exactly
  237: #  the six probes `probetimebased` names as having no prompt detection, so they are also
  238: #  the six whose runs are longest and most worth not losing.  Redirected to a file,
  239: #  stdout is block buffered and a killed run loses everything it had already measured.
  240: python3 -u sh_tlbmulti_probe.py "$PMAX" "$KERNEL" > "$TMLOG" 2>&1 || true
  241: 
  242: if ! grep -q "SH_TLBMULTI_RESULT=" "$TMLOG"; then
  243:     note "sh_tlbmulti probe produced no result line; last lines follow"
  244:     tail -5 "$TMLOG" | sed 's/^/       /'
  245:     check "sh_tlbmulti probe completed" "no" "yes"
  246: else
  247:     grep -E " ok$| FAIL$" "$TMLOG" | sed 's/^/       /'
  248:     tmctrl=$(grep -o "SH_TLBMULTI_CONTROL=[A-Z]*" "$TMLOG" | tail -1 | cut -d= -f2)
  249:     check "sh_tlbmulti control proves it measures" "${tmctrl:-missing}" "OK"
  250:     tmres=$(grep -o "SH_TLBMULTI_RESULT=[0-9]*/[0-9]*" "$TMLOG" | tail -1 | cut -d= -f2)
  251:     check "sh_tlbmulti rows run"     "${tmres#*/}" 6
  252:     check "sh_tlbmulti rows correct" "${tmres%/*}" "${tmres#*/}"
  253:     for v in "tlbm alive" "tlbm expevt" "tlbm pc" "tlbm vbr" "tlbm sr" "tlbm single"; do
  254:         n=$(count "$TMLOG" "^$v  .*ok$")
  255:         check "  $v" "$n" 1
  256:     done
  257: fi
  258: 
  259: # ---- #455: an interrupt at priority 0 ended the host process -----------------
  260: #  Wired in the SAME commit as the fix.  Gate 6's structural note says a probe that
  261: #  ships with its wiring cannot skip its census pin, because the wiring forces a
  262: #  gate run -- #441's did not, and its pin then went latently red between two
  263: #  commits.
  264: #
  265: #  This probe drives BOTH SH rigs, and which row uses which is forced rather than
  266: #  stylistic.
  267: #
  268: #  The PRIMARY witness is `-E testsh`, where the kill is reached SYNCHRONOUSLY --
  269: #  one guest store to the mp device's IPI register -- because the test machine wires
  270: #  its whole interrupt tree to a line the priority loop never assigns.  Being
  271: #  synchronous is what lets a cheap `step` see it.
  272: #
  273: #  The SECONDARY rows (`prio0 tmu`, `prio0 tmuq`) drive the landisk TMU route and
  274: #  must FREE-RUN, because a TMU underflow is produced by a HOST timer and
  275: #  debugger.c stops those for the duration of a `step`.  They exist because a
  276: #  MEASURED mutant that repaired only the testsh route scored full marks without
  277: #  them.  See the probe header.
  278: IPLOG=$LOGDIR/gate_sh_intprio.log
  279: python3 -u sh_intprio_probe.py "$PMAX" "$KERNEL" > "$IPLOG" 2>&1 || true
  280: 
  281: if ! grep -q "SH_INTPRIO_RESULT=" "$IPLOG"; then
  282:     note "sh_intprio probe produced no result line; last lines follow"
  283:     tail -5 "$IPLOG" | sed 's/^/       /'
  284:     check "sh_intprio probe completed" "no" "yes"
  285: else
  286:     grep -E " ok$| FAIL$" "$IPLOG" | sed 's/^/       /'
  287:     ipctrl=$(grep -o "SH_INTPRIO_CONTROL=[A-Z]*" "$IPLOG" | tail -1 | cut -d= -f2)
  288:     check "sh_intprio control proves it measures" "${ipctrl:-missing}" "OK"
  289:     ipres=$(grep -o "SH_INTPRIO_RESULT=[0-9]*/[0-9]*" "$IPLOG" | tail -1 | cut -d= -f2)
  290:     check "sh_intprio rows run"     "${ipres#*/}" 7
  291:     check "sh_intprio rows correct" "${ipres%/*}" "${ipres#*/}"
  292:     #  Named individually, and every one earns its place against a MEASURED mutant.
  293:     #  `tmu`/`tmuq` (#455) kill a PARTIAL FIX that repairs only the route the witness
  294:     #  drives -- measured passing 4/4 before they existed -- and they carry #455's
  295:     #  priority-0 coverage now that #456 moved the testsh line off priority 0.
  296:     #  `accept` (#455) is the de-escalation clause's cost: it pins that a LEGAL
  297:     #  priority-1 interrupt is still delivered, and is the only row that reddens
  298:     #  under `if (prio <= 1) return;` (measured 6/7).
  299:     #
  300:     #  `irq14 deliv` / `irq14 imask` (#456) REPLACED #455's `prio0 kill`/`prio0 quiet`,
  301:     #  which #456 made vacuous -- silently, since they stayed green.  They kill
  302:     #  DIFFERENT families and neither covers the other's: reverting to IRQ15 is caught
  303:     #  by `deliv` alone (6/7), while IRQ13 and IRQ0 both still DELIVER and are caught
  304:     #  by `imask` alone (6/7 each), because only bracketing IMASK pins the level to
  305:     #  exactly 1.
  306:     for v in "irq14 deliv" "irq14 imask" "prio0 live" "prio0 devsig" "prio0 tmu" "prio0 tmuq" "prio0 accept"; do
  307:         n=$(count "$IPLOG" "^$v  .*ok$")
  308:         check "  $v" "$n" 1
  309:     done
  310: fi
  311: 
  312: # ------------------------------------------------------------------ #458 sh4_iprbcd
  313: #  sh_update_interrupt_priorities() read two of the four IPR registers, and took SCIF
  314: #  from INTPRI00 -- an SH7750R/SH7760 register this machine never even MAPS, so SCIF's
  315: #  priority was a guest-immutable 3 while the boot witness shows OpenBSD asking for 12.
  316: #
  317: #  Two of these rows read the priority TABLE rather than a delivery, and that is not
  318: #  decoration: WDT, REF, SCI, GPIO, DMAC, H-UDI and RTC have NO `INTERRUPT_ASSERT`
  319: #  anywhere in this tree, so a mutant dropping their mapping scores a clean 10/10
  320: #  against every behavioural row that can be written.  Nothing a guest can DO depends
  321: #  on those priorities -- only what the table SAYS.
  322: IBLOG=$LOGDIR/gate_sh_iprbcd.log
  323: python3 -u sh_iprbcd_probe.py "$PMAX" "$KERNEL" > "$IBLOG" 2>&1 || true
  324: 
  325: if ! grep -q "IPRBCD_RESULT=" "$IBLOG"; then
  326:     note "sh_iprbcd probe produced no result line; last lines follow"
  327:     tail -5 "$IBLOG" | sed 's/^/       /'
  328:     check "sh_iprbcd probe completed" "no" "yes"
  329: else
  330:     grep -E " ok$| FAIL$" "$IBLOG" | sed 's/^/       /'
  331:     ibctrl=$(grep -o "IPRBCD_CONTROL=[A-Z]*" "$IBLOG" | tail -1 | cut -d= -f2)
  332:     check "sh_iprbcd control proves it measures" "${ibctrl:-missing}" "OK"
  333:     ibres=$(grep -o "IPRBCD_RESULT=[0-9]*/[0-9]*" "$IBLOG" | tail -1 | cut -d= -f2)
  334:     check "sh_iprbcd rows run"     "${ibres#*/}" 18
  335:     check "sh_iprbcd rows correct" "${ibres%/*}" "${ibres#*/}"
  336:     #  `naive` is pinned deliberately as a LABELLED row: writing one IPR and expecting
  337:     #  delivery is GREEN on the unfixed build, so it fails vacuity floor clause (a).  It
  338:     #  ships so nobody re-invents it; `iprc_hi`/`iprc_lo`/`iprc_lo1` are what discriminate,
  339:     #  by BRACKETING IMASK -- delivery needs IMASK < int_level, so a pair of rows at two
  340:     #  IMASK values pins the level to a range instead of to "nonzero".
  341:     #
  342:     #  `iprb wdt` / `ipra rtc` are the two table-reading rows.  MEASURED: dropping the
  343:     #  IPRB+RTC mapping reddens THESE TWO AND NOTHING ELSE (10/12 -- a TWELVE-ROW-ERA
  344:     #  number, measured before the iprd pair was added), and dropping only the
  345:     #  three RTC lines reddens `ipra rtc` alone.  Without them the settings exposure
  346:     #  added by #458 would be an unused convenience.
  347:     #
  348:     #  `raise` isolates the rescan half: it is the only row red on an IPR-only build.
  349:     #
  350:     #  `iprd hold` / `iprd ctl` defend the round's central DECISION rather than its
  351:     #  code.  #458 declines to read IPRD, and a pass-2 seat observed that the decision
  352:     #  lived only in a comment: the obvious "read all four registers per Table 19.6"
  353:     #  completion scored a clean pass against every other row while masking four landisk
  354:     #  PCIC lines.  MEASURED, not predicted -- `m_iprdread` (apply IPRD's nibbles to
  355:     #  IRL0-3) scores 13/14, red on `iprd hold` ALONE.  A guest `IPRD := 0` must leave
  356:     #  IRQ2/IRL0 (0x240) at 0xd; IRQ10 (0x340) is outside IPRD and stays 0x5 under fix
  357:     #  and mutant alike, which is what makes the red attributable to IPRD rather than to
  358:     #  a broken session.
  359:     #
  360:     #  *** `scif eri/rxi/bri/txi` ARE THE ONE ESCAPE THAT WAS NOT COVERAGE DEBT. ***
  361:     #  A measuring seat narrowed the IPRC SCIF loop to TXI alone -- one identifier --
  362:     #  and MEASURED 14/14.  Unlike every other escape this round, that one reaches a
  363:     #  LIVE line: SCIF RXI (0x720) is asserted by dev_sh4.c:250-256 on RIE && DR and
  364:     #  connected at :1912, which is CONSOLE INPUT on landisk.  Measured, the mutant
  365:     #  leaves iprio_720 at priority 0 with the line asserted, and RX delivery at
  366:     #  IMASK=3 goes from delivered to refused -- console input silently deleted, gate
  367:     #  green.  The ten behavioural rows all drive TXI, so nothing saw the RX side.
  368:     #  These four pin the loop's WHOLE membership, killing every narrowing of it.
  369:     for v in "live" "devsig" "naive" "iprc_hi" "iprc_lo" "iprc_lo1" \
  370:              "raise" "raise_lo" "lower" "deassert" "iprb wdt" "ipra rtc" \
  371:              "iprd hold" "iprd ctl" "scif eri" "scif rxi" "scif bri" "scif txi"; do
  372:         n=$(count "$IBLOG" "^$v  .*ok$")
  373:         check "  $v" "$n" 1
  374:     done
  375: fi
  376: 
  377: # ------------------------------------------------------------------ #459 sh4_pclock
  378: #  ONE ORDINARY GUEST STORE to 0xffd80010 ended the host process on every SH machine
  379: #  whose board never assigned a peripheral clock.  cpu_sh.c:233-234 adds the sh4 device
  380: #  from `arch == 4`, so the CPU brings the TMU and the BOARD brings the clock, and
  381: #  nothing checked that the two agree.  MEASURED dead on THREE machine types --
  382: #  -e jornada680, -E baresh and -E testsh -- while dreamcast and landisk, the only two
  383: #  that assign pclock, were fine.
  384: #
  385: #  This gate section is the de-escalation clause's cost, paid in full.  #459 removed a
  386: #  host-fatal guard, which DELETES the accidental tripwire that made the behaviour
  387: #  self-announcing, so the rows below rebuild it deliberately on both sides.
  388: PCLOG=$LOGDIR/gate_sh_pclock.log
  389: python3 -u sh_pclock_probe.py "$PMAX" "$KERNEL" > "$PCLOG" 2>&1 || true
  390: 
  391: if ! grep -q "SH_PCLOCK_RESULT=" "$PCLOG"; then
  392:     note "sh_pclock probe produced no result line; last lines follow"
  393:     tail -5 "$PCLOG" | sed 's/^/       /'
  394:     check "sh_pclock probe completed" "no" "yes"
  395: else
  396:     grep -E " ok$| FAIL$" "$PCLOG" | sed 's/^/       /'
  397:     pcctrl=$(grep -o "SH_PCLOCK_CONTROL=[A-Z]*" "$PCLOG" | tail -1 | cut -d= -f2)
  398:     check "sh_pclock control proves it measures" "${pcctrl:-missing}" "OK"
  399:     pcres=$(grep -o "SH_PCLOCK_RESULT=[0-9]*/[0-9]*" "$PCLOG" | tail -1 | cut -d= -f2)
  400:     check "sh_pclock rows run"     "${pcres#*/}" 16
  401:     check "sh_pclock rows correct" "${pcres%/*}" "${pcres#*/}"
  402:     #  THREE machines, because the brief that opened the round said two.  Two pass-1
  403:     #  seats independently caught that machine_test.c:535 is MACHINE_DEFAULT_CPU(baresh),
  404:     #  not testsh -- so `baresh kill`/`baresh diag` pin a machine the round nearly missed.
  405:     #
  406:     #  `accept hz` / `accept dc hz` use TWO DIFFERENT CLOCK VALUES on purpose.  A single
  407:     #  row pinned at landisk's 33.33 MHz is passed by a mutant that HARDCODES 33333333
  408:     #  in place of cpu->cd.sh.pclock; dreamcast's 50 MHz is the discriminator, and no
  409:     #  hardcode satisfies both.  (dreamcast needs -x or it exits before the debugger
  410:     #  prompt -- two console inputs, console.c:994-1007.  Its first draft read "died",
  411:     #  the SAME STRING the trigger rows produce, which would have been scored as a
  412:     #  fourth reproduction.  The probe passes -x for that machine only.)
  413:     #
  414:     #  The last four are the rebuilt tripwire and none is decoration.  Without them a
  415:     #  mutant that declines SILENTLY passes every other row: `says` pins that the
  416:     #  refusal names itself, `once` that the same timer twice yields ONE line, `pertmr`
  417:     #  that TCR0 and TCR1 yield TWO (the latch instance is per-timer, not shared), and
  418:     #  `unlatch` that the refused write does NOT land -- #447's own comment cites that
  419:     #  read-back as how "the guest can see the rejection", so it is the guest's channel
  420:     #  where the diagnostic is the operator's.
  421:     for v in "live" "devsig" "hpcsh kill" "hpcsh diag" "baresh kill" "baresh diag" "testsh kill" "testsh diag" "accept hz" "accept tcr" "accept dc hz" "accept dc tcr" "hpcsh says" "hpcsh once" "hpcsh pertmr" "hpcsh unlatch"; do
  422:         n=$(count "$PCLOG" "^$v  .*ok$")
  423:         check "  $v" "$n" 1
  424:     done
  425: fi
  426: 
  427: # ------------------------------------------------------------------ #460 gdrom_data
  428: #  FOUR guest-reachable exit(1) sites in ONE register's access arm.  `cond` and `busy`
  429: #  are both zero on a fresh device, so THERE WAS NO LEGAL FIRST TOUCH of GDROM_DATA:
  430: #  any non-16-bit access in either direction, the first 16-bit read, and the first
  431: #  16-bit write each ended the host process.  Measured 5/23 pre-fix, 23/23 post-fix,
  432: #  the pre-fix build rebuilt from `git show HEAD:` and not from build/.
  433: #
  434: #  Dreamcast needs -x or it exits before the debugger prompt (two console inputs,
  435: #  console.c:994-1007).  Without it a session dies for a CONFIGURATION reason and
  436: #  prints the same "died" the defect prints -- that cost #459 a false positive.
  437: GDLOG=$LOGDIR/gate_gdrom_data.log
  438: python3 -u gdrom_data_probe.py "$PMAX" "$KERNEL" > "$GDLOG" 2>&1 || true
  439: 
  440: if ! grep -q "GDROM_RESULT=" "$GDLOG"; then
  441:     note "gdrom_data probe produced no result line; last lines follow"
  442:     tail -5 "$GDLOG" | sed 's/^/       /'
  443:     check "gdrom_data probe completed" "no" "yes"
  444: else
  445:     grep -E " ok$| FAIL$" "$GDLOG" | sed 's/^/       /'
  446:     gdctrl=$(grep -o "GDROM_CONTROL=[A-Z]*" "$GDLOG" | tail -1 | cut -d= -f2)
  447:     check "gdrom_data control proves it measures" "${gdctrl:-missing}" "OK"
  448:     gdres=$(grep -o "GDROM_RESULT=[0-9]*/[0-9]*" "$GDLOG" | tail -1 | cut -d= -f2)
  449:     check "gdrom_data rows run"     "${gdres#*/}" 23
  450:     check "gdrom_data rows correct" "${gdres%/*}" "${gdres#*/}"
  451:     #  THE `x1` COUNT ROWS ARE THE POINT, not the survival rows.  The first oracle
  452:     #  asserted the OLD fatal text must be ABSENT -- but the fix KEEPS the diagnostic
  453:     #  and drops only exit(1), so DELETING the whole register arm scored 13/13 while
  454:     #  the real fix scored 8/13.  Re-pinned to "the diagnostic appears EXACTLY ONCE":
  455:     #  pre-fix dies, the fix says it once, a deleted arm says it zero times.
  456:     #
  457:     #  THE LOAD VARIANTS ARE LOAD-BEARING.  A rebuild once wrapped the width rows
  458:     #  around stores only, and a seat named the mutant that walks that gap: restore
  459:     #  exit(1) on WRONG-WIDTH READ ONLY, which scored a clean 14/14 while one guest
  460:     #  MOV.B read from the register still ended the host.
  461:     #
  462:     #  `two sites x2` is the ONLY row separating a per-site latch from ONE SHARED
  463:     #  BIT; every other row drives one site per session and cannot see the axis.
  464:     #
  465:     #  `accept d0`/`accept d1` are the de-escalation accept for four removed
  466:     #  predicates -- a legal TOC PIO returning 0x0010 then 0xffff9600 (mov.w
  467:     #  sign-extends, and 0x9600 has bit 15 set).  Without them, a mutant that strips
  468:     #  the whole success path scores full marks.  `declined val` pins what a DECLINED
  469:     #  read returns; without it 0xffff -> 0 passes while the diagnostic claims 0xffff.
  470:     for v in "live" "devsig" "gdrom map" "w8 store" "w8store x1" "w32 store" "w32store x1" "w8 load" "w8load x1" "w32 load" "w32load x1" "w16 load" "w16load x1" "w16 store" "w16store x1" "two sites" "two sites x2" "accept d0" "accept d1" "declined val" "overread" "overread x1" "accept w8"; do
  471:         n=$(count "$GDLOG" "^$v  .*ok$")
  472:         check "  $v" "$n" 1
  473:     done
  474: fi
  475: 
  476: # --------------------------------------------------------------- #461 gdrom_default
  477: #  dev_dreamcast_gdrom.c registers a 0x100 window and implements EIGHT offsets; every
  478: #  other address fell to a `default:` arm that printed then exit(1)ed -- a read OR a
  479: #  write, at any width.  MEASURED: 21 offsets sampled, 19 died.  One predicate, roughly
  480: #  248 of 256 byte offsets lethal, so a driver scanning the register space died on its
  481: #  first unhandled address.  The DMA window's own default arm joined the round on a
  482: #  measurement: it died on committed HEAD AND on a build that fixed only the control
  483: #  window.  *** 9/32 pre-fix, 32/32 post-fix, both measured AT 32 ROWS (pre461f.out).
  484: #  ***
  485: #
  486: #  This line asserted `8/32 ... BOTH MEASURED` before that run existed, and the carried
  487: #  8 was wrong as well as unmeasured -- the real figure is 9, because `dma accept`
  488: #  reads five IMPLEMENTED DMA offsets and those work on the pre-fix build.  A seat
  489: #  predicted 9 from the code and the measurement returned it.  Hence the carrier rule
  490: #  that a score claim names its log: section U checks the DENOMINATOR against this
  491: #  file's own pin, and nothing can check a NUMERATOR that was never run.
  492: #
  493: #  This line said "7/27 pre-fix, 27/27 post-fix -- both MEASURED at the final row
  494: #  count, not carried over" while citing the earlier carried-over incident as the
  495: #  thing it had learned from.  A seat found it FALSE THREE WAYS: the final count is
  496: #  32, not 27; NO 7/27 measurement ever existed (the runs on record are 7/21, 7/25
  497: #  and 8/32); and the honest pre-fix number is 8, not 7, because `dma seed` passes
  498: #  pre-fix -- the implemented +0x04 always worked.
  499: #
  500: #  Third generation of the frozen-number defect, inside the sentence memorialising
  501: #  the first two.  Section U now checks the DENOMINATOR against this file's own pin
  502: #  mechanically; the NUMERATOR and the word "measured" still cannot be checked by
  503: #  anything but a reader, which is exactly how this one survived.
  504: #  after the probe had grown to 25, which is the stale-score class a seat caught
  505: #  mid-answer and section U now checks mechanically.
  506: GDDLOG=$LOGDIR/gate_gdrom_default.log
  507: #  -u IS LOAD-BEARING.  `probeslow` recorded the streaming mitigation as APPLIED;
  508: #  it was applied only in ad-hoc measurement scripts, never HERE -- and this is
  509: #  the invocation that runs weekly.  Redirected to a file, stdout is block
  510: #  buffered and the probe (no flush anywhere, a few KB of output) loses EVERY
  511: #  row if the run is killed.  A killed run then looks like a run that produced
  512: #  nothing, which is the silence this row was filed about.
  513: python3 -u gdrom_default_probe.py "$PMAX" "$KERNEL" > "$GDDLOG" 2>&1 || true
  514: 
  515: if ! grep -q "GDROM_DEF_RESULT=" "$GDDLOG"; then
  516:     note "gdrom_default probe produced no result line; last lines follow"
  517:     tail -5 "$GDDLOG" | sed 's/^/       /'
  518:     check "gdrom_default probe completed" "no" "yes"
  519: else
  520:     grep -E " ok$| FAIL$" "$GDDLOG" | sed 's/^/       /'
  521:     gddctrl=$(grep -o "GDROM_DEF_CONTROL=[A-Z]*" "$GDDLOG" | tail -1 | cut -d= -f2)
  522:     check "gdrom_default control proves it measures" "${gddctrl:-missing}" "OK"
  523:     gddres=$(grep -o "GDROM_DEF_RESULT=[0-9]*/[0-9]*" "$GDDLOG" | tail -1 | cut -d= -f2)
  524:     check "gdrom_default rows run"     "${gddres#*/}" 60
  525:     check "gdrom_default rows correct" "${gddres%/*}" "${gddres#*/}"
  526:     #  `scan uniq` IS AN IDENTITY ROW: 64 word keys minus 8 implemented offsets is
  527:     #  exactly 56.  A ninth implemented register moves it to 55 in the same commit --
  528:     #  the fail-closed ratchet, equality and not >=.  It kills a capped counter (4 !=
  529:     #  56), a masked key (32 != 56), AND the raw-address indexing mutant (measured
  530:     #  18/21 -- it reddens `scan uniq` too).
  531:     #
  532:     #  *** AN EARLIER DRAFT OF THIS COMMENT SAID THE SCAN CANNOT SEE THE
  533:     #  RAW-ADDRESS MUTANT, 56/56 IDENTICAL TO CORRECT. That was the pass-1
  534:     #  analysis of a design WITHOUT the bounds guard, and the round's own kill
  535:     #  table refutes it. ***  With the guard, raw indexing pushes k to 255
  536:     #  against 64 keys, the guard rejects, most offsets never report, and the
  537:     #  count drops.  A seat caught the comment still carrying the pre-guard
  538:     #  number beside a table that measured otherwise.
  539:     #
  540:     #  `granularity` is the one that does: at 4-byte stride byte- and word-indexing
  541:     #  give equally many distinct keys, so only a SUB-WORD access exposes it.  That
  542:     #  `granularity` pins the per-word keying directly, which is a DESIGN COMMITMENT
  543:     #  worth one access.
  544:     #
  545:     #  *** THREE CLAIMS STOOD HERE AND A SEAT REFUTED ALL THREE. ***
  546:     #
  547:     #  It said the raw-address mutant "lands five words past the array, directly on
  548:     #  dma_reg[], setting the two fields that authorise a DMA transfer".  A guardless
  549:     #  bits[k] reaches dma_reg[0..3] -- count, destination and length -- but NOT
  550:     #  dma_reg[5], the ENABLE, which needs word index 11 against a reachable maximum
  551:     #  of 9.  Three of four, and the overreach is 4 words for the read row, 6 for the
  552:     #  write row.  It also stated the landing in the INDICATIVE, as something that
  553:     #  happens -- the shipped guard prevents any landing at all; it is a property of
  554:     #  the guardless counterfactual only.
  555:     #
  556:     #  It said that re-opens "a host kill that is otherwise unreachable".  Both DMA
  557:     #  +0x18 exits are reachable on the SHIPPED build through the front door: write
  558:     #  count=1 at +0x0c and enable=1 at +0x14, both implemented cases, then any
  559:     #  nonzero store to +0x18.
  560:     #
  561:     #  And it said "SHIP BOTH; neither subsumes the other, and that was measured".
  562:     #  The measurement says the opposite: across six mutants `scan uniq` kills every
  563:     #  one that anything kills, and `granularity`'s only kill (m_oob) reddens
  564:     #  `scan uniq` too, at 15 against 56.  SHIP BOTH ANYWAY -- but because the
  565:     #  granularity row states a commitment cheaply, not because it is a sole killer.
  566:     #  scored a perfect 16/16 before it existed -- including DELETING case GDROM_DATA,
  567:     #  which silently undoes #460.  Before this fix, deleting a case meant exit(1) on
  568:     #  first use; after it, silently wrong forever.
  569:     #
  570:     #  `rd then wr` expects TWO.  Three seats voted that the read/write split was
  571:     #  padding; a build measured offset-only keying producing ZERO write diagnostics
  572:     #  across 31 offsets, because the read pass latches every offset first.
  573:     #  *** THIS LIST HAD 27 NAMES AGAINST 32 ROWS, AND THE FIVE MISSING ONES WERE
  574:     #  THE HIGHEST-VALUE ROWS IN THE FILE. ***  A seat noticed that #460's gate
  575:     #  names all 23 of its rows while this one silently stopped at the pass-1 set --
  576:     #  so `dma alias x1`, `dma align16`, `dma rdleak`, `both windows` and
  577:     #  `dma accept`, every one of them added BECAUSE a mutant escaped, were pinned
  578:     #  by the count check alone.  A row absent from this list still runs; it just
  579:     #  stops being named, so a rename or a silent drop reads as green here.
  580:     #
  581:     #  ONE LINE, deliberately: assembling this with a backslash continuation through
  582:     #  a heredoc mangled TWICE in one session and shipped a red gate with a bogus
  583:     #  word `n` in it.
  584:     for v in "live" "devsig" "impl ok" "rd lo" "rdlo x1" "wr lo" "wrlo x1" "rd hi" "rdhi x1" "rd w16" "rdw16 x1" "same twice" "two offs" "rd then wr" "granularity" "accept cnt" "accept cond" "scan" "scan uniq" "accept8" "data 0xffff" "dma rd" "dma rd x1" "dma two" "dma shadow" "dma seed" "dma alias" "dma alias x1" "dma align16" "dma rdleak" "both windows" "dma accept" "arm survive" "arm says" "arm idle" "arm once" "nodata live" "nodata says" "accept dma" "accept idle" "accept quiet" "nodata quiet" "accept event" "nodata idle" "arm halfarm" "nodata notx" "arm quiet" "arm twice" "nodata len" "arm bytetrig" "accept data" "both decl" "arm count2" "arm enable2" "nodata stale" "stale says" "stale idle" "nodata twice" "stale quiet" "stale how"; do
  585:         n=$(count "$GDDLOG" "^$v  .*ok$")
  586:         check "  $v" "$n" 1
  587:     done
  588: fi
  589: 
  590: #  ---------------------------------------------------------------- #463
  591: #  asic_badaddr: dev_dreamcast_asic.c ended the host process on a SINGLE
  592: #  guest load.  `r = (relative_addr / 4) & 3` then `exit(1)` when r == 3 --
  593: #  above the switch and above the writeflag test, so no store, no staging
  594: #  and no command sequence was needed.
  595: #
  596: #  THE DENOMINATOR IS 14 -- it read 13 until 2026-09-06, when the retrospective
  597: #  re-check found the loop below naming thirteen of the probe's fourteen rows and
  598: #  omitting `sweep 256' (the byte-load of all 256 offsets), which is now added.  An
  599: #  unlisted row is not a failing row: it silently stops being checked while the gate
  600: #  stays green, which is this file's own padded-column hazard reached by a different
  601: #  road.  FOUR OF THOSE ROWS EXIST BECAUSE A PANEL FOUND
  602: #  THE FIRST NINE INSUFFICIENT.  `alias`, `alias2` and `crossarr` pin the INDEXING
  603: #  half of the bound on r; the other nine pin the kill and the accept side.
  604: #  They are COMPLEMENTARY on purpose -- neither catches the other's mutant:
  605: #    & 3 -> & 2  aliases +0x14 onto +0x10   -> only `alias` sees it
  606: #    & 3 -> & 7  reaches mask_13[4], which IS mask_11[1] (the struct declares
  607: #                pending_irq[3], mask_13[3], mask_11[3], mask_9[3]
  608: #                CONSECUTIVELY) -> only `crossarr` sees it
  609: #    & 3 -> & 1  aliases +0x18 onto +0x10   -> only `alias2` sees it
  610: #    / 4 -> / 2  aliases +0x18 onto +0x10   -> only `alias2` sees it
  611: #  A same-array distinctness row CANNOT see `& 7`: under it the three mask_13
  612: #  words map to [4],[5],[6], three distinct cells that still round-trip.
  613: #
  614: #  THE UNIT OF COVERAGE IS THE COLLISION PAIR, not "aliasing" in the abstract.
  615: #  Three register words admit distinct pairs and ONE distinctness row pins ONE
  616: #  pair.  `alias` pins words 0 and 1; `& 1` and `/ 2` both collide words 0 and
  617: #  TWO, so it was blind to both until `alias2` was added.  Four seats found
  618: #  these four escapes against a table that was already green.
  619: #
  620: #  -u IS LOAD-BEARING, for the reason the gdrom section above records: with
  621: #  stdout redirected to a file it is block buffered, and a killed run then
  622: #  loses every row and looks like a run that produced nothing.
  623: ASLOG=$LOGDIR/gate_asic_badaddr.log
  624: python3 -u asic_badaddr_probe.py "$PMAX" "$KERNEL" > "$ASLOG" 2>&1 || true
  625: 
  626: if ! grep -q "ASIC_BADADDR_RESULT=" "$ASLOG"; then
  627:     note "asic_badaddr probe produced no result line; last lines follow"
  628:     tail -5 "$ASLOG" | sed 's/^/       /'
  629:     check "asic_badaddr probe completed" "no" "yes"
  630: else
  631:     grep -E " ok$| FAIL$" "$ASLOG" | sed 's/^/       /'
  632:     asres=$(grep -o "ASIC_BADADDR_RESULT=[0-9]*/[0-9]*" "$ASLOG" | tail -1 | cut -d= -f2)
  633: 
  634:     #  *** THE PARSE MUST BE CHECKED BEFORE THE SCORE IS READ. ***  Three panel
  635:     #  seats independently found the same false pass here: if the result line
  636:     #  exists but is MALFORMED (no slash, truncated digits), the outer grep -q
  637:     #  still succeeds, `asres` is EMPTY, and then `${asres%/*}` and
  638:     #  `${asres#*/}` BOTH expand to the empty string -- so
  639:     #  `check "rows correct" "" ""` PASSES while nothing was measured.  The
  640:     #  `rows run` sibling would still redden the gate, so this was never a
  641:     #  silent green overall; it was a false GREEN ROW, which is worse than
  642:     #  useless because a reader scanning check output is misled about which
  643:     #  part failed.  This is the project's own "a pattern that matched nothing
  644:     #  reports zero for everything" class, wearing shell-expansion clothes.
  645:     if [ -z "$asres" ]; then
  646:         note "asic_badaddr result line present but unparseable; last lines follow"
  647:         tail -3 "$ASLOG" | sed 's/^/       /'
  648:         check "asic_badaddr result parses" "no" "yes"
  649:     else
  650:         check "asic_badaddr result parses" "yes" "yes"
  651:         #  *** 13 -> 14 ON 2026-08-29.  ALL FOURTEEN ROWS PASS; ONLY THE PIN WAS STALE.
  652:         #  The battery reported `rows run got=14 want=13` while `rows correct` read 14
  653:         #  in the SAME run -- denominator stale, numerator sound. ***
  654:         #
  655:         #  Provenance: pinned at 13 by `f1fa6a0` (#463); `d894e35` (#474) added the
  656:         #  `asicoffsetkill` sweep row to the probe and did not move the pin.  #474 was a
  657:         #  footbridge round, so it edited a probe belonging to a gate it did not run --
  658:         #  which is why nothing surfaced until the weekly battery.
  659:         #
  660:         #  *** AN EARLIER DRAFT BUMPED THIS NUMBER WITH NO COMMENT AT ALL, while the
  661:         #  other three re-pins in this round carried paragraphs.  THREE PASS-2 SEATS
  662:         #  INDEPENDENTLY CALLED THAT A DEFECT (glm, deepseek, minimax) -- a bare number
  663:         #  bump is indistinguishable from fitting the pin to the output. ***
  664:         check "asic_badaddr rows run"     "${asres#*/}" 14
  665:         check "asic_badaddr rows correct" "${asres%/*}" "${asres#*/}"
  666: 
  667:         #  Per-row presence.  A row that silently stops being tested is the
  668:         #  padded-column class; every name here is <= 10 chars against the
  669:         #  probe's %-14s column, so the two-space anchor cannot become
  670:         #  unsatisfiable.  The `count "$ASLOG"` on the NEXT line is what
  671:         #  identifies this section -- every section's list opens "live" "devsig".
  672:         #
  673:         #  `alias` IS A PREFIX OF `alias2`, which is the sibling of the
  674:         #  padded-column trap: one name's pattern matching two rows, or none.
  675:         #  CHECKED EMPIRICALLY against probe-formatted lines rather than reasoned
  676:         #  about -- each of alias / alias2 / crossarr matches EXACTLY ONE. The
  677:         #  two-space anchor cannot span the collision because the character after
  678:         #  `alias` is the digit 2, not a space. If a future row is named so that a
  679:         #  SPACE follows an existing name's prefix, re-run that check before
  680:         #  trusting this loop.
  681:         #
  682:         #  *** AND THERE IS A HARD LENGTH BOUND: ROW NAMES MUST BE <= 13 CHARS. ***
  683:         #  The probe's format is "%-14s " -- fourteen columns plus one literal
  684:         #  space -- so a name of length L is followed by (15 - L) spaces.  At L=13
  685:         #  that is two spaces and the anchor still matches; at L=14 it is ONE, the
  686:         #  `^$v  ` anchor can never match, and THE ROW SILENTLY STOPS BEING TESTED
  687:         #  while the gate stays green.  Longest name here is `kill store` (10), so
  688:         #  there are three characters of headroom.  Named by a panel seat, which
  689:         #  computed the threshold rather than just warning about the class.
  690:         for v in "live" "devsig" "asic ok" "safe 8" "kill word" "kill byte" "kill store" "safe 4" "kill far" "alias" "crossarr" "alias2" "mask9 rt" "sweep 256"; do
  691:             n=$(count "$ASLOG" "^$v  .*ok$")
  692:             check "asic_badaddr $v" "$n" 1
  693:         done
  694:     fi
  695: fi
  696: 
  697: #  NOTE ON CHECK NAMING: the sections above use `check "  $v"`, a bare padded
  698: #  row name. Every section has a `live` row, so those names COLLIDE in the
  699: #  gate's own output and a reader cannot tell which section a failing `live`
  700: #  belongs to. This section prefixes with `asic_badaddr` deliberately.
  701: 
  702: # ------------------------------------------------------------------ #443 sh4_pcic
  703: #  A guest 32-bit LOAD to an unimplemented PCIC offset used to END THE HOST PROCESS.  A
  704: #  MEASURED census of all 137 word offsets in both directions found 116 killing on a read
  705: #  and 125 on a write; post-fix both are 0.
  706: #
  707: #  *** WIRED HERE IN THE SAME COMMIT AS THE PROBE, WHICH IS THE WHOLE POINT. ***  Both
  708: #  sh_halt_probe.py above and sh4_bsc_width_probe.py (#441) shipped UNWIRED, and gate 6's
  709: #  own structural note says a probe that ships with its wiring cannot skip its census pin,
  710: #  because the wiring forces a gate run.  #441's did not, and the pin then went latently
  711: #  red between two commits.
  712: #
  713: #  Note the existing halt probe is blind to this by construction: it classifies from the
  714: #  dyntrans HALT message, and exit(1) is not a halt.
  715: PCLOG=$LOGDIR/gate_sh4_pcic.log
  716: python3 sh4_pcic_probe.py "$PMAX" "$KERNEL" > "$PCLOG" 2>&1 || true
  717: 
  718: if ! grep -q "SH4_PCIC_RESULT=" "$PCLOG"; then
  719:     note "sh4_pcic probe produced no result line; last lines follow"
  720:     tail -5 "$PCLOG" | sed 's/^/       /'
  721:     check "sh4_pcic probe completed" "no" "yes"
  722: else
  723:     grep -E "^  (ok|FAIL) " "$PCLOG" | sed 's/^/       /'
  724:     check "sh4_pcic: no offset kills the host"           "$(grep -c 'SH4_PCIC_PASS' "$PCLOG")" "1"
  725:     #  The census rows are the ONLY thing that sees a latch sharing one word between
  726:     #  offsets 32 apart -- a mutant a measuring seat built which passes both the
  727:     #  per-offset and the per-device rows.  So pin that they ran, not merely that the
  728:     #  verdict was green.
  729:     #  29 -> 38 in the same edit that grew the probe: a pass-2 seat measured SEVEN mutants
  730:     #  all scoring 29/29 -- including one that reinstated the original host kill -- and the
  731:     #  nine new rows are what kill them.  This is a FLOOR, so it would have stayed green at
  732:     #  38 with no edit at all, which is exactly how a floor stops noticing.
  733:     check_min "sh4_pcic: rows actually run"           "$(grep -cE '^  (ok|FAIL) ' "$PCLOG")" 38
  734: fi
  735: 
  736: # ------------------------------------------------------------------ #447 sh4 value guards
  737: #  A SIBLING OF THE BLOCK ABOVE, NOT AN EXTENSION OF IT -- and the reason is the row title
  738: #  three lines up.  That check is named "sh4_pcic: no offset kills the host".  Folding
  739: #  #447's rows under it would make the gate's own check name UNTRUE, because these are four
  740: #  DIFFERENT sites (TCR, DMATCR, ICR, RCR1) reached by VALUE rather than by offset.  A check
  741: #  whose title does not describe what it checks is the same defect as a green row that means
  742: #  nothing, and it is harder to see because the number still moves.
  743: #
  744: #  WHAT #447 FIXED: four guards in DEVICE_ACCESS(sh4) called exit(1) on a value the model
  745: #  does not implement.  A guest STORE of an unmodelled bit ended the host process.  They now
  746: #  DIAGNOSE AND SURVIVE, latched per (class, INSTANCE, offending BIT) -- three parts, each
  747: #  earned: per-class alone reports timer 0 and silences timers 1-2 and channels 1-7, and
  748: #  per-(class,instance) still swallows the second feature at one register, because RCR1's
  749: #  single guard covers TWO features and TCR's covers SIX.
  750: #
  751: #  THE STORE POSITION DIFFERS THREE WAYS OUT OF FOUR, which is why "move the store below the
  752: #  guard" is not a file-wide rule: DMATCR's store is already downstream, ICR has no store on
  753: #  any path, RCR1's was upstream (the #443 shape), and TCR is a third case -- `timer_hz` is
  754: #  set from `idata & 3` BEFORE the guard, so a naive fix would install pclock/4 for a write
  755: #  asking for a clock source the model cannot provide, turning a loud fault into a silent one.
  756: VALOG=$LOGDIR/gate_sh4_val.log
  757: python3 sh4_val_probe.py "$PMAX" "$KERNEL" > "$VALOG" 2>&1 || true
  758: 
  759: if ! grep -q "SH4_VAL_RESULT=" "$VALOG"; then
  760:     note "sh4_val probe produced no result line; last lines follow"
  761:     tail -5 "$VALOG" | sed 's/^/       /'
  762:     check "sh4_val probe completed" "no" "yes"
  763: else
  764:     grep -E "^  (ok|FAIL) " "$VALOG" | sed 's/^/       /'
  765:     check "sh4_val: no guest VALUE kills the host"           "$(grep -c 'SH4_VAL_PASS' "$VALOG")" "1"
  766:     #  33, and the floor is pinned because two mutants initially scored 32/32 against an
  767:     #  earlier draft of this probe -- one collapsing all four fault classes into one, one
  768:     #  turning fatal() into debug() at every site.  Both are now killed by single rows, so
  769:     #  a row count that quietly drops is a real loss of coverage rather than tidying.
  770:     check_min "sh4_val: rows actually run"           "$(grep -cE '^  (ok|FAIL) ' "$VALOG")" 33
  771: fi
  772: 
  773: # ------------------------------------------------------------------ #448 CHCR decoders
  774: #  A THIRD SIBLING, and the same reasoning that kept #447 out of #443's block keeps this
  775: #  out of both: the checks above are named "no offset kills the host" and "no guest VALUE
  776: #  kills the host", and these four sites are reached by neither -- they are CHCR FIELD
  777: #  ENCODINGS decoded inside sh4_dmac_transfer(), on the far side of a call.
  778: #
  779: #  *** THIS WAS EASIER TO REACH THAN ANYTHING #447 REPAIRED. ***  Only `case 0x200:`
  780: #  survives the CHCR_RS switch, so fifteen of the sixteen resource-select encodings ended
  781: #  the host -- and a wholly legal configuration (4-byte transfers, both addresses
  782: #  incrementing) died on its resource-select alone.
  783: #
  784: #  THE ACCEPT-SIDE ROWS (A1-A4) ARE THE DE-ESCALATION CLAUSE, and this is the first round
  785: #  to owe them: a fatal->survive fix DELETES the accidental tripwire that made guard growth
  786: #  self-announcing, so the detector must pin that legal encodings are still ACCEPTED, not
  787: #  merely that illegal ones are declined.  #447 shipped without those rows and a review
  788: #  seat then found a ONE-IDENTIFIER escape scoring full marks.
  789: CHCRLOG=$LOGDIR/gate_sh4_chcr.log
  790: python3 sh4_chcr_probe.py "$PMAX" "$KERNEL" > "$CHCRLOG" 2>&1 || true
  791: 
  792: if ! grep -q "SH4CHCR_RESULT=" "$CHCRLOG"; then
  793:     note "sh4_chcr probe produced no result line; last lines follow"
  794:     tail -5 "$CHCRLOG" | sed 's/^/       /'
  795:     check "sh4_chcr probe completed" "no" "yes"
  796: else
  797:     grep -E "^  (ok|FAIL) " "$CHCRLOG" | sed 's/^/       /'
  798:     check "sh4_chcr: no guest CHCR ENCODING kills the host"           "$(grep -c 'SH4CHCR_PASS' "$CHCRLOG")" "1"
  799:     #  *** THIS COMMENT WAS CORRUPTED BY A CARELESS sed AND SHIPPED THAT WAY. ***  A
  800:     #  flagship review found it: it said "16" against the floor of 18 one line below, "TWO
  801:     #  rows" against a record of five, "round.s" (the `.` in the pattern matched the
  802:     #  apostrophe), and it spliced two sentences into one that says nothing.  A wrong
  803:     #  record in a committed gate file, caused by editing prose with a regex.
  804:     #
  805:     #  What it should have said: the floor is 18, and FIVE rows were measured vacuous
  806:     #  across this round and rebuilt.  R2 carried the ACCEPTED resource select, so a
  807:     #  `return`->`break` mutant printed one line either way.  L1's second store was a
  808:     #  BIT-SUBSET of its first, so a whole-register latch computed fresh==0 and stayed
  809:     #  silent.  R5 was byte-identical to R4.  R6 proves channel 3 REACHES the guard, not
  810:     #  that the latch DISTINGUISHES channels, so L3 was added.  And R1 had R2's exact
  811:     #  defect, fixed at R2/R3 in the same session and not carried across -- with a comment
  812:     #  left behind claiming it was covered.  A pass-2 seat found that one.
  813:     check_min "sh4_chcr: rows actually run"           "$(grep -cE '^  (ok|FAIL) ' "$CHCRLOG")" 27
  814: fi
  815: 
  816: # ------------------------------------------------------------------ #449 RTCSR refresh
  817: #  A FOURTH SIBLING, and it is the first in this file whose defect is NOT at a store.
  818: #
  819: #  *** THE GUEST WRITE LANDS AND RETURNS NORMALLY.  THE HOST DIED ~9 ms LATER, INSIDE
  820: #  sh4_timer_tick() AT 110 Hz. ***  Every other probe wired above -- #443's, #447's, #448's
  821: #  -- observes the STORE SITE: issue one store, ask whether the host survived that
  822: #  instruction.  All three are blind to this by construction, and the witness keeps a row
  823: #  (S0) recording exactly that: the store alone leaves the host alive.
  824: #
  825: #  F1 IS THE ROW THAT NEEDED THE NEW SHAPE.  The diagnostic comes from a callback that
  826: #  fires many times during one free run, and fatal() has no quiet_mode early-out, so an
  827: #  unlatched complaint is a flood -q cannot stop.  F1 spins long enough for many ticks and
  828: #  requires EXACTLY ONE line.  No store-site row can measure that: none lets the callback
  829: #  run twice.
  830: #
  831: #  The TMU half is covered OFFLINE instead, in gate 2: regress/diff_sh4_tmu.c's
  832: #  `rtcsr_falls_through` row sets CMIE and requires the timer to keep counting, which is
  833: #  what catches an early `return` -- the obvious fix, and the wrong one.  Measured there:
  834: #  clean 0 failures, early-return 1 failure.  It costs microseconds and needs no pty.
  835: RTLOG=$LOGDIR/gate_sh4_rtcsr.log
  836: python3 sh4_rtcsr_probe.py "$PMAX" "$KERNEL" > "$RTLOG" 2>&1 || true
  837: 
  838: if ! grep -q "SH4RTCSR_RESULT=" "$RTLOG"; then
  839:     note "sh4_rtcsr probe produced no result line; last lines follow"
  840:     tail -5 "$RTLOG" | sed 's/^/       /'
  841:     check "sh4_rtcsr probe completed" "no" "yes"
  842: else
  843:     grep -E "^  (ok|FAIL) " "$RTLOG" | sed 's/^/       /'
  844:     check "sh4_rtcsr: a refresh-interrupt enable does not kill the host"           "$(grep -c 'SH4RTCSR_PASS' "$RTLOG")" "1"
  845:     #  10, and two of those rows exist because the round's own mutation run measured them
  846:     #  needed: L1 (two stores in ONE process) after a latch mutant scored a clean 9/9
  847:     #  against every single-session row, and A1 re-valued after it was written against
  848:     #  RTCSR_CMF -- a bit that is write-1-to-KEEP and that nothing in the device ever sets,
  849:     #  so a guest cannot set it and the row could never trip a widened guard.
  850:     check_min "sh4_rtcsr: rows actually run"           "$(grep -cE '^  (ok|FAIL) ' "$RTLOG")" 10
  851: fi
  852: 
  853: #  #451: the two command-byte validators in sh4_sci_cmd().  This is the first SH-4 site
  854: #  in this tree that a single store CANNOT reach -- the guest must clock a byte in through
  855: #  SHREG_SCSPTR, seventeen mov.b stores, and only the eighth rising edge calls the
  856: #  function.  Every SH-4 probe before it observes a store site, so all of them were blind.
  857: #
  858: #  *** THE ORACLE IS THE TRANSFER, NOT SURVIVAL, and that is the whole design. ***  This
  859: #  fix deleted two exit(1) calls, and with them the accidental tripwire that made a
  860: #  missing `return` or a grown guard LOUD.  After it, both are silent: a missing `return`
  861: #  performs an invented transfer against the RS5C313 and says nothing.  So the rows watch
  862: #  dev_sh4.c:664/:685's `[ SCI: read|write addr=.. data=.. ]` lines, with a legal pair
  863: #  (0xa5 sets address 5, 0x9c writes data c) proving the oracle is LIVE -- otherwise every
  864: #  "no transfer occurred" row would pass for the wrong reason rather than the right one.
  865: #
  866: #  MEASURED KILL TABLE, 14 mutants, no survivors.  Two carry a lesson worth the line:
  867: #    *  M2 (site 1 `return` deleted) is invisible to byte 0x00 -- 0x00 also fails site 2,
  868: #       which catches what site 1 dropped.  Row R1 uses 0x10 instead: bit 7 clear but a
  869: #       LEGAL transfer field, so the fall-through reaches the write arm and really writes.
  870: #       Three pass-1 seats converged on this independently.
  871: #    *  M9 (the `sci_bits_outputed = 0` moved into the callee below the returns) was first
  872: #       built at the TOP of the callee, where it runs on every call -- an EQUIVALENT
  873: #       mutant that "survived".  Rebuilt as described, it jams the shifter and row J
  874: #       reddens.  A mutant that does not model the defect measures the detector's silence,
  875: #       not its blindness.
  876: SCILOG=$LOGDIR/gate_sh4_sci.log
  877: python3 sh4_sci_probe.py "$PMAX" "$KERNEL" > "$SCILOG" 2>&1 || true
  878: 
  879: if ! grep -q "SH4SCI_RESULT=" "$SCILOG"; then
  880:     note "sh4_sci probe produced no result line; last lines follow"
  881:     tail -5 "$SCILOG" | sed 's/^/       /'
  882:     check "sh4_sci probe completed" "no" "yes"
  883: else
  884:     grep -E "^  (ok|FAIL) " "$SCILOG" | sed 's/^/       /'
  885:     check "sh4_sci: a clocked-in command byte does not kill the host"           "$(grep -c 'SH4SCI_PASS' "$SCILOG")" "1"
  886:     check_min "sh4_sci: rows actually run"           "$(grep -cE '^  (ok|FAIL) ' "$SCILOG")" 14
  887: fi
  888: 
  889: #  #452: the two TLB data-array-2 sites.  Both `da1` devices are registered for SIXTEEN
  890: #  megabytes and each handler ended the host on `relative_addr & 0x800000` -- EIGHT
  891: #  megabytes, the upper half of a range the device itself claimed.  One guest load or
  892: #  store was enough, and the guard sat ABOVE the writeflag test so direction did not
  893: #  matter.  The discriminator is a single ADDRESS BIT, sharper than any earlier SH-4
  894: #  round here: the same device at the same width answers at 0xf3000000 and died at
  895: #  0xf3800000.
  896: #
  897: #  MEASURED KILL TABLE, 10 mutants: 9 die, 1 is EQUIVALENT.  Two are worth the lines:
  898: #    *  M1 -- dropping the declined-read's memory_writemax64() -- was predicted by THREE
  899: #       seats to hand the guest stale host bytes.  It does not, and the reason is in this
  900: #       tree: memory_rw.c:484-491, correction #95, already zeroes the caller's buffer
  901: #       before every device read.  Measured in five contexts, identical on both builds.
  902: #       It carries NO row, because a row that cannot fail is decoration.
  903: #    *  G1 -- the guard grown from 0x800000 to 0xc00000, with its latch operand widened
  904: #       jointly -- reddens A3 and NOTHING ELSE.  A1/A2 sit at offset 0 and cannot see it;
  905: #       A3 sits at +0x400000, bit 22 set, which is exactly the range such a growth starts
  906: #       refusing.  That is the de-escalation clause discharged by measured kill.
  907: DA2LOG=$LOGDIR/gate_sh4_tlbda2.log
  908: python3 sh4_tlbda2_probe.py "$PMAX" "$KERNEL" > "$DA2LOG" 2>&1 || true
  909: 
  910: if ! grep -q "SH4TLBDA2_RESULT=" "$DA2LOG"; then
  911:     note "sh4_tlbda2 probe produced no result line; last lines follow"
  912:     tail -5 "$DA2LOG" | sed 's/^/       /'
  913:     check "sh4_tlbda2 probe completed" "no" "yes"
  914: else
  915:     grep -E "^  (ok|FAIL) " "$DA2LOG" | sed 's/^/       /'
  916:     check "sh4_tlbda2: a TLB data-array-2 access does not kill the host"           "$(grep -c 'SH4TLBDA2_PASS' "$DA2LOG")" "1"
  917:     check_min "sh4_tlbda2: rows actually run"           "$(grep -cE '^  (ok|FAIL) ' "$DA2LOG")" 10
  918: fi
  919: 
  920: #  sh4_tlbda2_witness.py is DELIBERATELY NOT RUN HERE -- same rule as the four below it.
  921: #  7/7 pre-fix and 4/7 after, the three differences being exactly the three kill rows
  922: #  (an ITLB load, a UTLB load, and an ITLB store).  Its two controls assert EQUALITY with
  923: #  the value each device's own mask folds 0xffffffff to -- 0x1ffffdfa and 0x1ffffdff,
  924: #  which DIFFER -- after a panel seat pointed out that the first draft asserted only
  925: #  INEQUALITY against three wrong values, which any fourth wrong value would have passed.
  926: 
  927: #  sh4_sci_witness.py is DELIBERATELY NOT RUN HERE -- same rule as the three below it.
  928: #  8/8 pre-fix, 5/8 after, the three differences being exactly the three bytes that used
  929: #  to end the host (0x00, 0x80 and 0xb0).  0xb0 was NOT in the first draft of that witness:
  930: #  a pass-1 seat pointed out that `(cmd & 0x30)` reaches the else arm for BOTH 0x00 and
  931: #  0x30, so the second site had two reachable faults and only one of them was measured.
  932: 
  933: #  sh4_rtcsr_witness.py is DELIBERATELY NOT RUN HERE: 8/8 pre-fix, 6/8 after, the two
  934: #  differences being the two kill rows.  A gated witness reddens the day its fix lands.
  935: 
  936: #  sh4_chcr_witness.py is DELIBERATELY NOT RUN HERE, for the same reason as #447's:
  937: #  it asserts the PRE-FIX symptom (13/13 pre-fix, 8/13 post-fix, the five differences
  938: #  being exactly the five sites repaired) and would go red the day its fix landed.
  939: 
  940: #  sh4_val_witness.py is DELIBERATELY NOT RUN HERE.  It asserts the PRE-FIX symptom -- that
  941: #  the host process dies -- so it correctly goes RED the moment the fix is present.  Wiring
  942: #  a witness into a gate manufactures a phantom regression on the day the fix lands, and
  943: #  check_probe_wiring.py treats a gated witness as a HARD failure for exactly that reason.
  944: 
  945: 
  946: #  ------------------------------------------------------------------ wdcflood
  947: #  Six unlatched fatal() in dev_wdc.c, each guest-drivable without bound.  Measured
  948: #  pre-fix: 20 stores -> 20 host lines with AND without -q, and the OVER-READ site at
  949: #  500 iterations produced 2000 lines / 158,449 bytes.  Artifacts live at
  950: #  regress/artifacts/wdcflood/witness_20260825/{fr_no__q,fr_with__q,n3}.out.
  951: #  (An earlier wording said "the read path", which points at the non-8-bit READ guard;
  952: #  n3.out is 2000x "reading too much", i.e. the ring over-read.  Same numbers, wrong
  953: #  site named.)  fatal() has no early-out (core/debugmsg.c:384-390 against debug()'s
  954: #  at :375), so -q cannot silence it.
  955: #
  956: #  THE DENOMINATOR IS 26 AND TWELVE OF THOSE ROWS EXIST BECAUSE A PANEL OR A KILL TABLE
  957: #  FOUND THE FIRST FOURTEEN INSUFFICIENT.  Every one of the twelve closes a MEASURED or
  958: #  PREDICTED escape, and each is the only row that sees its own:
  959: #    overrun x2  the :145 reinstatement -- an L2 FLOOR BREACH until this row existed
  960: #    interleave  a latch reset on a NORMAL operation, invisible to back-to-back rows
  961: #    w16 reset   a latch operand a guest can CLEAR between fires
  962: #    r16 reset   the same at the READ site -- sibling parity, and it was missing
  963: #    fire3       a period-N latch; a two-fire oracle cannot see period 2
  964: #    w32/r32     the width rows probed 16-bit only
  965: #    r16/w16 value  BOTH fires, because a `return` after a latched fatal() corrupts
  966: #                   the FIRST access and an earlier one-value form was VACUOUS
  967: #    wr indep    TWO SITES IN ONE SESSION -- the only row that can see flag pairing
  968: #    w mixed     a width-KEYED latch: alternating mov.w/mov.l floods forever, and no
  969: #    r mixed     single-width row can see it.  Both came from the capped ask-again,
  970: #                fired against a table that was already clean at 24 rows.
  971: #
  972: #  -u IS LOAD-BEARING, for the reason the gdrom section above records: with stdout
  973: #  redirected to a file it is block buffered, and a killed run then loses every row and
  974: #  looks like a run that produced nothing.
  975: #
  976: #  THE DISK IS REQUIRED AND ITS ABSENCE IS A SKIP, NEVER A PASS.  wdc_command()
  977: #  early-returns before the opcode switch when no IDE image exists (grep
  978: #  `but no disk image`), so without it the :583 rows cannot fire at all and would read
  979: #  as green-on-nothing.  An earlier form cited :461-468, which is wdc_status() and was
  980: #  wrong even before the fix moved every line in this file.
  981: #
  982: #  THAT EARLY RETURN'S OWN debug() REPEATS ONCE PER FAILED COMMAND and is NOT latched
  983: #  here.  It is a DIFFERENT CHANNEL, and the reason is stronger than -q: debug()
  984: #  computes v = verbose - (emul_executing ? 1 : 0) + (stepping ? 1 : 0) and returns at
  985: #  core/debugmsg.c:375 when v < 0.  FREE-RUNNING AT DEFAULT VERBOSITY THAT IS v == -1,
  986: #  so the arm emits NOTHING AT ALL; it becomes one line per command only under -v or
  987: #  under stepping.  fatal() has no such early-out.  Outside this round's scope rather
  988: #  than a missed site; it rides with `floodclass`.
  989: #
  990: #  (An earlier wording said FLOODS IDENTICALLY, full stop -- an overstatement, and the
  991: #  qualifier was not missing from the evidence but from the summary: the original
  992: #  filing already read "invisible free-running at verbosity 0".  Caught by the pass-2
  993: #  codex seat re-deriving from debugmsg.c what our own record already said.)
  994: #  ---------------------------------------------------------------- #465 gdrom PIO
  995: #
  996: #  A DETECTOR NO GATE RUNS IS NOT A DETECTOR.  The gdrompionull probe shipped under
  997: #  regress/artifacts/ and NOTHING IN THE BATTERY EXECUTED IT -- found by grepping the
  998: #  gates for the probe's own name before writing the round record, which is the check
  999: #  that should run on every "we shipped a detector" claim.
 1000: #
 1001: #  What it pins, and the evidence is four preserved logs beside the probe:
 1002: #    prefix_HEAD_13of13.raw   pre-fix, OLD pin   13/13  the defect reproduces
 1003: #    repin_HEAD_RED.raw       pre-fix, NEW pin   12/13  the re-pin measured RED first
 1004: #    postfix_465.raw          post-fix           11/13  crash gone, witness rows stale
 1005: #    postfix_465_final.raw    post-fix           13/13  detector complete
 1006: #
 1007: #  The two trigger rows were WITNESS rows pinned to "sig11" and are now DETECTOR rows
 1008: #  pinned to "exit0".  That inversion is licensed by the preserved pre-fix logs -- same
 1009: #  script, same row names, opposite colour -- and not by the new binary.
 1010: #
 1011: #  `staged quiet` was RE-PINNED from "0 of 8" to "1 of 8" in the mandated order: the
 1012: #  oracle changed FIRST, the committed build measured RED under it, and only then did
 1013: #  the code change.  The fix IS louder by one line, because the repaired state routes
 1014: #  into #460's once-latched overread decline.  The round's earlier prose claimed it
 1015: #  "invents no new behaviour"; that was false and is corrected in the probe's
 1016: #  `staged quiet` row comment -- NOT its header, which is where this line first said
 1017: #  it was.  A pass-2 seat caught the mislocation: a pointer naming the wrong place is
 1018: #  a small wrong record, but it is the kind a future reader gives up on.
 1019: GPNPROBE=artifacts/gdrompionull/gdrom_pio_null_probe.py
 1020: if [ ! -f "$GPNPROBE" ]; then
 1021:     gate_skip "gdrompio: $GPNPROBE absent"
 1022: else
 1023:     GPNLOG=$LOGDIR/gate_gdrom_pio.log
 1024:     python3 -u "$GPNPROBE" "$PMAX" "$KERNEL" > "$GPNLOG" 2>&1 || true
 1025: 
 1026:     if ! grep -q "GDROMPIO_RESULT=" "$GPNLOG"; then
 1027:         note "gdrompio probe produced no result line; last lines follow"
 1028:         tail -5 "$GPNLOG" | sed 's/^/       /'
 1029:         check "gdrompio probe completed" "no" "yes"
 1030:     else
 1031:         grep -E " ok$| FAIL$" "$GPNLOG" | sed 's/^/       /'
 1032: 
 1033:         #  *** CONTROLS FIRST, AND SEPARATELY. ***  A run whose five controls all died
 1034:         #  scored 1/13 today and looked like a catastrophic regression; the real cause was
 1035:         #  a nonexistent image path passed by the operator.  A dead-control run must
 1036:         #  announce itself as an APPARATUS failure, not as twelve product failures.
 1037:         if grep -q "GDROMPIO_CONTROL=OK" "$GPNLOG"; then
 1038:             check "gdrompio controls live" "yes" "yes"
 1039:         else
 1040:             note "gdrompio CONTROLS DEAD -- the probe never reached the device."
 1041:             note "Do not read the row scores below as product failures."
 1042:             check "gdrompio controls live" "no" "yes"
 1043:         fi
 1044: 
 1045:         #  PARSE BEFORE SCORE.  A malformed result line still satisfies the outer grep,
 1046:         #  leaving gdres empty so both halves expand to "" and the score row compares
 1047:         #  "" with "" -- green on nothing.  This is the wdc_flood idiom, same reason.
 1048:         gdres=$(grep -o "GDROMPIO_RESULT=[0-9]*/[0-9]*" "$GPNLOG" | tail -1 | cut -d= -f2)
 1049:         case "$gdres" in
 1050:             [0-9]*/[0-9]*)
 1051:                 check "gdrompio result parses" "yes" "yes"
 1052:                 #  the denominator against a LITERAL: a probe that loses rows cannot pass
 1053:                 check "gdrompio rows run"     "${gdres#*/}" 13
 1054:                 check "gdrompio rows correct" "${gdres%/*}" "${gdres#*/}"
 1055:                 ;;
 1056:             *)
 1057:                 check "gdrompio result parses" "no" "yes"
 1058:                 ;;
 1059:         esac
 1060: 
 1061:         #  Per-row presence.  A row that silently stops being tested is the padded-column
 1062:         #  class; these names are checked individually so a vanished row reds.
 1063:         for v in "live" "devsig sh4" "gdrom map" "cheap trig" "staged trig" \
 1064:                  "staged quiet" "cheap loud"; do
 1065:             n=$(grep -c "^$v  .*ok$" "$GPNLOG")
 1066:             check "gdrompio row present: $v" "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
 1067:         done
 1068:     fi
 1069: fi
 1070: 
 1071: #  ------------------------------------------------------------------ #489 gdrom TOC length
 1072: #
 1073: #  The `case 0x14` TOC length guard used to end the host on a GUEST-SUPPLIED cnt.  The
 1074: #  WITNESS for it is deliberately NOT run here -- it pins the PRE-fix symptom, so gating it
 1075: #  would manufacture a regression the day the fix landed.  It lives ungated at
 1076: #  artifacts/gdromexitsix/gdrom_toclen_witness.py and is registered CLASS_WITNESS.
 1077: #
 1078: #  The row worth knowing about here is `bad cond`.  A survive-only row set is VACUOUS at this
 1079: #  site: weakening the guard from `!= 408` to `> 408` lets cnt=407 reach alloc_data(407)
 1080: #  while the TOC writer indexes byte 407, and that one-byte overflow need not fault -- so
 1081: #  "did the host survive?" scores the mutant GREEN with the defect back.  `bad cond` reads
 1082: #  COND_DATA_AVAIL instead: declined leaves it CLEAR (0xa0), the mutant SETS it (0xa8).
 1083: TOCPROBE=gdrom_toclen_probe.py
 1084: if [ ! -f "$TOCPROBE" ]; then
 1085:     gate_skip "gdromtoclen: $TOCPROBE absent"
 1086: else
 1087:     TOCLOG=$LOGDIR/gate_gdrom_toclen.log
 1088:     python3 -u "$TOCPROBE" "$PMAX" "$KERNEL" > "$TOCLOG" 2>&1 || true
 1089: 
 1090:     if ! grep -q "TOCLEN_RESULT=" "$TOCLOG"; then
 1091:         note "gdromtoclen probe produced no result line; last lines follow"
 1092:         tail -5 "$TOCLOG" | sed 's/^/       /'
 1093:         check "gdromtoclen probe completed" "no" "yes"
 1094:     else
 1095:         grep -E " ok$| FAIL$" "$TOCLOG" | sed 's/^/       /'
 1096: 
 1097:         #  CONTROLS FIRST AND SEPARATELY.  A run whose controls all died is an APPARATUS
 1098:         #  failure -- a bad image path, a load spike eating the settle window -- and must
 1099:         #  not be read as product failures.  gdrompio scored 1/13 that way once.
 1100:         if grep -q "TOCLEN_CONTROL=OK" "$TOCLOG"; then
 1101:             check "gdromtoclen controls live" "yes" "yes"
 1102:         else
 1103:             note "gdromtoclen CONTROLS DEAD -- the probe never reached the device."
 1104:             note "Do not read the row scores below as product failures."
 1105:             check "gdromtoclen controls live" "no" "yes"
 1106:         fi
 1107: 
 1108:         #  PARSE BEFORE SCORE.  A malformed result line still satisfies the outer grep,
 1109:         #  leaving tocres empty so both halves expand to "" and the score row compares
 1110:         #  "" with "" -- green on nothing.  Same reason as the wdc_flood idiom above.
 1111:         tocres=$(grep -o "TOCLEN_RESULT=[0-9]*/[0-9]*" "$TOCLOG" | tail -1 | cut -d= -f2)
 1112:         if [ -z "$tocres" ]; then
 1113:             note "gdromtoclen result line present but unparseable; last lines follow"
 1114:             tail -5 "$TOCLOG" | sed 's/^/       /'
 1115:             check "gdromtoclen result parses" "no" "yes"
 1116:         else
 1117:             check "gdromtoclen result parses" "yes" "yes"
 1118:             #  the denominator against a LITERAL: a probe that loses rows cannot pass
 1119:             check "gdromtoclen rows run"     "${tocres#*/}" 19
 1120:             check "gdromtoclen rows correct" "${tocres%/*}" "${tocres#*/}"
 1121:         fi
 1122: 
 1123:         #  Per-row presence.  A row that silently stops being tested is the padded-column
 1124:         #  class; these names are checked individually so a vanished row reds.
 1125:         for v in "live" "devsig sh4" "gdrom map" "ok data0" "ok data1" "ok surv" \
 1126:                  "ok cond" "bad surv" "bad says" "zero surv" "bad cond" \
 1127:                  "bad cnt" "bad event" "zero cond" "over surv" "over cond" \
 1128:                  "latch once" "latch surv" "latch cond"; do
 1129:             n=$(grep -c "^$v  .*ok$" "$TOCLOG")
 1130:             check "gdromtoclen row present: $v" "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
 1131:         done
 1132:     fi
 1133: fi
 1134: 
 1135: #  ---------------------------------------------------------------- #490 gdromdecline
 1136: #
 1137: #  The two de-fatalised sites in dev_dreamcast_gdrom.c's handle_command(): the case 0x30
 1138: #  data-format guard and the default: arm.  Both were fatal() + exit(1) reached by an
 1139: #  ordinary guest store.
 1140: #
 1141: #  ITS OWN SECTION AND ITS OWN DENOMINATOR, deliberately.  Bolting these rows onto the
 1142: #  58-row gdrom_default probe would edit two coupled places -- a literal and a 58-name list
 1143: #  that must agree -- for every row added.  #489 set that precedent and this follows it.
 1144: #
 1145: #  THE ROWS WORTH KNOWING ABOUT HERE ARE `crossbit` AND `latch cond`, because both were
 1146: #  MEASURED escaping an earlier plan:
 1147: #    * `crossbit` -- d->warned now has NINE writers sharing one field, and SIX of the
 1148: #      pre-existing ones are set from inside DEVICE_ACCESS by ordinary guest register reads.
 1149: #      If either new latch bit ALIASES an existing one, a prior TOC decline silences a whole
 1150: #      site and the guest gets a mute refusal.  Measured as Ma_toclen / Mb_toclen.
 1151: #    * `latch cond` -- moving the `break` INSIDE the latch `if` lets the SECOND identical bad
 1152: #      format fall through into sector_nr.  The announce count reads 1 either way, so this
 1153: #      row reads a DECLINE channel after the second command instead.  Measured as M_braceA.
 1154: DECLPROBE=gdrom_decline_probe.py
 1155: if [ ! -f "$DECLPROBE" ]; then
 1156:     gate_skip "gdromdecline: $DECLPROBE absent"
 1157: else
 1158:     DECLLOG=$LOGDIR/gate_gdrom_decline.log
 1159:     python3 -u "$DECLPROBE" "$PMAX" "$KERNEL" > "$DECLLOG" 2>&1 || true
 1160: 
 1161:     if ! grep -q "GDROM_DECL_RESULT=" "$DECLLOG"; then
 1162:         note "gdromdecline probe produced no result line; last lines follow"
 1163:         tail -5 "$DECLLOG" | sed 's/^/       /'
 1164:         check "gdromdecline probe completed" "no" "yes"
 1165:     else
 1166:         grep -E " ok$| FAIL$" "$DECLLOG" | sed 's/^/       /'
 1167: 
 1168:         #  CONTROLS FIRST AND SEPARATELY -- a run whose controls died is an APPARATUS
 1169:         #  failure and must not be read as product failures.
 1170:         if grep -q "GDROM_DECL_CONTROL=OK" "$DECLLOG"; then
 1171:             check "gdromdecline controls live" "yes" "yes"
 1172:         else
 1173:             note "gdromdecline CONTROLS DEAD -- the probe never reached the device."
 1174:             note "Do not read the row scores below as product failures."
 1175:             check "gdromdecline controls live" "no" "yes"
 1176:         fi
 1177: 
 1178:         #  PARSE BEFORE SCORE.  A malformed result line still satisfies the outer grep,
 1179:         #  leaving declres empty so both halves expand to "" and the score row compares ""
 1180:         #  with "" -- green on nothing.
 1181:         declres=$(grep -o "GDROM_DECL_RESULT=[0-9]*/[0-9]*" "$DECLLOG" | tail -1 | cut -d= -f2)
 1182:         if [ -z "$declres" ]; then
 1183:             note "gdromdecline result line present but unparseable; last lines follow"
 1184:             tail -5 "$DECLLOG" | sed 's/^/       /'
 1185:             check "gdromdecline result parses" "no" "yes"
 1186:         else
 1187:             check "gdromdecline result parses" "yes" "yes"
 1188:             #  the denominator against a LITERAL: a probe that loses rows cannot pass
 1189:             check "gdromdecline rows run"     "${declres#*/}" 20
 1190:             check "gdromdecline rows correct" "${declres%/*}" "${declres#*/}"
 1191:         fi
 1192: 
 1193:         #  Per-row presence.  A row that silently stops being tested is the padded-column
 1194:         #  class; these names are checked individually so a vanished row reds.
 1195:         for v in "live" "devsig sh4" "gdrom map" "fmt surv" "fmt says" "fmt x2" \
 1196:                  "latch cond" "fmt stage" "fmt cnt" "fmt event" "fmt 0x24" "unk surv" "unk says" \
 1197:                  "unk x2" "unk cnt" "unk event" "both sites" "crossbit" "acceptA" \
 1198:                  "accept sil"; do
 1199:             n=$(count "$DECLLOG" "^$v  .*ok$")
 1200:             check "gdromdecline row present: $v" "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
 1201:         done
 1202:     fi
 1203: fi
 1204: 
 1205: #  ---------------------------------------------------------------------------------------
 1206: #  #496 gdromcondlies -- GDROM_UNKNOWN_0x88 and GDROM_COND bad-value declines.
 1207: #
 1208: #  Two guest-reachable host kills de-fatalised, plus -- at GDROM_COND only -- the
 1209: #  `d->cond = idata;` store MOVED from above the dispatch into the two accepted arms.
 1210: #  That relocation is the half of the fix that is not about exit(): COND_DATA_AVAIL
 1211: #  (0x08) is a bit of d->cond and the GDROM_DATA read path is gated on it, so leaving
 1212: #  the store where it was would let any declined value forge or revoke data-available.
 1213: #
 1214: #  *** NO **ACCEPT-SIDE** ROW HERE MAY READ SURVIVAL. ***  Post-fix every accepted access
 1215: #  exits 0, so a survival oracle at a refusal-EFFECT site answers the same whether or not
 1216: #  the guard is right.  The round's WITNESS does use survival -- correctly, it ran BEFORE
 1217: #  the fix -- and its accept rows are deliberately NOT carried into this detector.
 1218: #
 1219: #  *** THE BAN WAS WRITTEN WITHOUT THE QUALIFIER AND THAT WAS ITSELF A CLAUSE-(b) FLOOR
 1220: #  BREACH.  Corrected 2026-09-06 by the retrospective re-check (batch 8b), against the
 1221: #  probe rather than against this comment. ***  The DECLINE rows R1 and R2 read the exit
 1222: #  status on purpose -- `row("R2 cond says", ... , "55|exit0", ...)` -- and
 1223: #  gdrom_cond_probe.py's own docstring gives the reason at its anchor `R1 and R2 assert
 1224: #  announced AND survived`: a presence-only decline row cannot see exit(1) being
 1225: #  reinstated, because fatal() PRINTS AND THEN THE PROCESS DIES.  Count 1, byte correct,
 1226: #  row green, defect back.  So the rule is: an ACCEPT row may not rest on survival
 1227: #  (guarded and unguarded code both survive); a DECLINE row MUST carry it (it is the only
 1228: #  channel that distinguishes announce-and-continue from announce-and-die).
 1229: #
 1230: #  `R5 cond keep` is the KEYSTONE and it is ANCHORED: a fresh device has cond == 0, so
 1231: #  the naive "write 0x55, read back 0" is satisfied by the correct fix AND by a mutant
 1232: #  that zeroes cond on decline.  The row drives an ACCEPTED 0xef first, so the value it
 1233: #  requires back is one only the accept arm can have placed there.
 1234: CONDPROBE=gdrom_cond_probe.py
 1235: if [ ! -f "$CONDPROBE" ]; then
 1236:     gate_skip "gdromcond: $CONDPROBE absent"
 1237: else
 1238:     CONDLOG=$LOGDIR/gate_gdrom_cond.log
 1239:     python3 -u "$CONDPROBE" "$PMAX" "$KERNEL" > "$CONDLOG" 2>&1 || true
 1240: 
 1241:     if ! grep -q "GDROMCOND_PROBE_RESULT=" "$CONDLOG"; then
 1242:         note "gdromcond probe produced no result line; last lines follow"
 1243:         tail -5 "$CONDLOG" | sed 's/^/       /'
 1244:         check "gdromcond probe completed" "no" "yes"
 1245:     else
 1246:         grep -E " ok$| FAIL$" "$CONDLOG" | sed 's/^/       /'
 1247: 
 1248:         #  CONTROLS FIRST AND SEPARATELY -- a run whose controls died is an APPARATUS
 1249:         #  failure and must not be read as a wall of product failures.
 1250:         if grep -q "GDROMCOND_CONTROL=OK" "$CONDLOG"; then
 1251:             check "gdromcond controls live" "yes" "yes"
 1252:         else
 1253:             note "gdromcond CONTROLS DEAD -- the probe never reached the device."
 1254:             note "Do not read the row scores below as product failures."
 1255:             check "gdromcond controls live" "no" "yes"
 1256:         fi
 1257: 
 1258:         #  *** AND THE TRAILING CONTROL, WHICH IS A DIFFERENT QUESTION. ***  The opening
 1259:         #  controls run FIRST, so they cannot see a rig that degrades partway.  MEASURED: a
 1260:         #  contended run scored 18/25 with CONTROL=OK -- seven late rows reading `absent` and
 1261:         #  one session dying -- and nothing in the log said the scores were uncitable.
 1262:         #  "Alive at the start" and "alive throughout" are different facts.
 1263:         if grep -q "GDROMCOND_CONTROL_END=OK" "$CONDLOG"; then
 1264:             check "gdromcond controls live at END" "yes" "yes"
 1265:         else
 1266:             note "gdromcond TRAILING CONTROL DEAD -- the rig degraded DURING the run."
 1267:             note "Everything after the failure point measured nothing.  Re-run alone."
 1268:             check "gdromcond controls live at END" "no" "yes"
 1269:         fi
 1270: 
 1271:         #  PARSE BEFORE SCORE.  A malformed result line still satisfies the outer grep,
 1272:         #  leaving condres empty so both halves expand to "" and the score row compares
 1273:         #  "" with "" -- green on nothing.
 1274:         condres=$(grep -o "GDROMCOND_PROBE_RESULT=[0-9]*/[0-9]*" "$CONDLOG" | tail -1 | cut -d= -f2)
 1275:         if [ -z "$condres" ]; then
 1276:             note "gdromcond result line present but unparseable; last lines follow"
 1277:             tail -5 "$CONDLOG" | sed 's/^/       /'
 1278:             check "gdromcond result parses" "no" "yes"
 1279:         else
 1280:             check "gdromcond result parses" "yes" "yes"
 1281:             #  the denominator against a LITERAL: a probe that loses rows cannot pass
 1282:             check "gdromcond rows run"     "${condres#*/}" 31
 1283:             check "gdromcond rows correct" "${condres%/*}" "${condres#*/}"
 1284:         fi
 1285: 
 1286:         #  Per-row presence.  A row that silently stops being tested is the padded-column
 1287:         #  class; these names are checked individually so a vanished row reds.  Every name
 1288:         #  is <= 12 chars against a %-14s column, so the two-space anchor below is always
 1289:         #  satisfiable -- a name AS LONG AS its column makes the check impossible instead.
 1290:         for v in "live" "devsig sh4" "devsig st" "devsig cnt" \
 1291:                  "R1 a88 says" "R1b a88 trk" "R3 a88 x3" \
 1292:                  "R10 a88 nop" "R10b a88 decl" "R10c a88 evt" \
 1293:                  "R2 cond says" "R2b cond trk" "R4 cond x3" \
 1294:                  "R5 cond keep" "R5b cond 00" "R5c cond a0" "R5d cond 09" \
 1295:                  "R6 a0 busy" "R8 a0 echo" "R9 ef event" \
 1296:                  "R7 no event" "R7b cond st" "R11 crossbit" \
 1297:                  "R12 no forge" "R12b cond ff" "R12c cond 108" \
 1298:                  "R12d hi byte" "R13 recount" "R13b mid pkt" \
 1299:                  "Zlive end" "Zdevsig end"; do
 1300:             n=$(count "$CONDLOG" "^$v  .*ok$")
 1301:             check "gdromcond row present: $v" "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
 1302:         done
 1303:     fi
 1304: fi
 1305: 
 1306: #  ---------------------------------------------------------------------------------------
 1307: #  #441 SH4 BSC non-16-bit access -- sh4bcr.  A guest choosing an access WIDTH used to end
 1308: #  the host at BCR2/BCR3; the fix services the access and diagnoses it once per site.
 1309: #
 1310: #  WIRED HERE because the probe execs `-E landisk`, which is this gate's machine, and its
 1311: #  exemption in check_probe_wiring.py is DELETED in the same edit -- a wired probe that
 1312: #  keeps an exemption is a STALE EXEMPTION and the checker reds on it.
 1313: #
 1314: #  *** THE PROBE GAINED `SH4_BSC_WIDTH_DONE` IN THIS SAME COMMIT, BEFORE BEING WIRED. ***
 1315: #  It already printed `SH4_BSC_WIDTH_PASS` or `_FAIL`, but those are MUTUALLY EXCLUSIVE, so a
 1316: #  gate keyed on either cannot tell A RUN THAT FAILED from A RUN THAT DIED BEFORE PRINTING.
 1317: #  The sentinel is unconditional, so completion and outcome are separate questions here --
 1318: #  which is what lets the two rows below say different things.
 1319: #
 1320: #  NOTE THE ROW NAMES ARE LONGER THAN THEIR COLUMN.  The probe prints `"  %-4s %-58s"` and
 1321: #  several names exceed 58 characters, so those lines carry NO trailing padding.  The anchors
 1322: #  below therefore must NOT require trailing whitespace -- `^  ok   <name>` and nothing more.
 1323: #  This is the padded-column trap approached from the other side: the usual failure is a name
 1324: #  as long as its column making a check unsatisfiable, and here the check is written to be
 1325: #  insensitive to it.
 1326: BSCPROBE=sh4_bsc_width_probe.py
 1327: if [ ! -f "$BSCPROBE" ]; then
 1328:     gate_skip "sh4bscwidth: $BSCPROBE absent"
 1329: else
 1330:     BSCLOG=$LOGDIR/gate_sh4_bsc_width.log
 1331:     python3 -u "$BSCPROBE" "$PMAX" "$KERNEL" > "$BSCLOG" 2>&1 || true
 1332: 
 1333:     if ! grep -q "SH4_BSC_WIDTH_DONE" "$BSCLOG"; then
 1334:         note "sh4bscwidth probe did not reach its completion sentinel; last lines follow"
 1335:         tail -5 "$BSCLOG" | sed 's/^/       /'
 1336:         check "sh4bscwidth probe completed" "no" "yes"
 1337:     else
 1338:         grep -E "^  (ok|FAIL) " "$BSCLOG" | sed 's/^/       /'
 1339: 
 1340:         #  PARSE BEFORE SCORE.  A malformed result line still satisfies an outer grep,
 1341:         #  leaving the variable empty so both halves expand to "" and the row compares ""
 1342:         #  with "" -- green on nothing.
 1343:         bscres=$(grep -o "SH4_BSC_WIDTH_RESULT=[0-9]*/[0-9]*" "$BSCLOG" | tail -1 | cut -d= -f2)
 1344:         if [ -z "$bscres" ]; then
 1345:             note "sh4bscwidth result line present but unparseable; last lines follow"
 1346:             tail -5 "$BSCLOG" | sed 's/^/       /'
 1347:             check "sh4bscwidth result parses" "no" "yes"
 1348:         else
 1349:             check "sh4bscwidth result parses" "yes" "yes"
 1350:             #  the denominator against a LITERAL: a probe that loses rows cannot pass
 1351:             check "sh4bscwidth rows run"     "${bscres#*/}" 13
 1352:             check "sh4bscwidth rows correct" "${bscres%/*}" "${bscres#*/}"
 1353:         fi
 1354: 
 1355:         #  D0 and D7a are this probe's OWN controls and are checked BY NAME rather than
 1356:         #  folded into the score -- a control that goes red while the total stays acceptable
 1357:         #  is an apparatus failure being read as a product result.
 1358:         for c in "D0 every arm produced data" "D7a CONTROL: the CPU really is big-endian"; do
 1359:             check "sh4bscwidth control: $c" \
 1360:                   "$(grep -c "^  ok   $c" "$BSCLOG")" "1"
 1361:         done
 1362: 
 1363:         #  Per-row presence.  A row that silently stops being tested is the padded-column
 1364:         #  class, so each is pinned individually rather than by a total.
 1365:         for v in "D1 4-byte write reaches BCR2 AND IS MASKED; host survives" \
 1366:                  "D2 4-byte read returns the register in its own lane" \
 1367:                  "D3 a 1-byte write is not promoted to 16 bits" \
 1368:                  "D4 BOTH sites latch SEPARATELY, in one process (count the suffix, NOT the name)" \
 1369:                  "D5 a second non-16-bit access in one process survives" \
 1370:                  "D6 the 4-byte access is diagnosed AND says it was serviced" \
 1371:                  "D6b a 4-byte READ is diagnosed too, not only a write" \
 1372:                  "D7b a 4-byte write takes the FIRST two bytes on big-endian" \
 1373:                  "D8 BCR3's write reaches its register UNMASKED" \
 1374:                  "D9 a 1-byte READ does not kill the host" \
 1375:                  "D10 a legal 16-bit access is NOT diagnosed"; do
 1376:             n=$(count "$BSCLOG" "^  ok   $v")
 1377:             check "sh4bscwidth row green: $v" \
 1378:                   "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
 1379:         done
 1380:     fi
 1381: fi
 1382: 
 1383: WDCIMG=$IMAGES/wdc-scratch-64m.img
 1384: if [ ! -f "$WDCIMG" ]; then
 1385:     gate_skip "wdcflood: $WDCIMG absent (see regress/images.md -- it is a dd recipe, not a download)"
 1386: else
 1387:     WFLOG=$LOGDIR/gate_wdc_flood.log
 1388:     python3 -u wdc_flood_probe.py "$PMAX" "$KERNEL" "$WDCIMG" > "$WFLOG" 2>&1 || true
 1389: 
 1390:     if ! grep -q "WDC_FLOOD_RESULT=" "$WFLOG"; then
 1391:         note "wdc_flood probe produced no result line; last lines follow"
 1392:         tail -5 "$WFLOG" | sed 's/^/       /'
 1393:         check "wdc_flood probe completed" "no" "yes"
 1394:     else
 1395:         grep -E " ok$| FAIL$" "$WFLOG" | sed 's/^/       /'
 1396:         wfres=$(grep -o "WDC_FLOOD_RESULT=[0-9]*/[0-9]*" "$WFLOG" | tail -1 | cut -d= -f2)
 1397: 
 1398:         #  *** PARSE BEFORE SCORE. ***  If the result line exists but is MALFORMED, the
 1399:         #  outer grep still succeeds, `wfres` is EMPTY, and both `${wfres%/*}` and
 1400:         #  `${wfres#*/}` expand to the empty string -- so `check "rows correct" "" ""`
 1401:         #  PASSES while nothing was measured.  Three panel seats found that false pass
 1402:         #  in the asic section above; it is the project's own "a pattern that matched
 1403:         #  nothing reports zero for everything" class in shell-expansion clothes.
 1404:         if [ -z "$wfres" ]; then
 1405:             note "wdc_flood result line present but unparseable; last lines follow"
 1406:             tail -3 "$WFLOG" | sed 's/^/       /'
 1407:             check "wdc_flood result parses" "no" "yes"
 1408:         else
 1409:             check "wdc_flood result parses" "yes" "yes"
 1410:             check "wdc_flood rows run"     "${wfres#*/}" 26
 1411:             check "wdc_flood rows correct" "${wfres%/*}" "${wfres#*/}"
 1412: 
 1413:             #  Per-row presence.  A row that silently stops being tested is the
 1414:             #  padded-column class.  The probe's format is "%-14s " -- fourteen columns
 1415:             #  plus one literal space -- so a name of length L is followed by (15 - L)
 1416:             #  spaces; at L=13 that is two and the `^$v  ` anchor still matches, at L=14
 1417:             #  it is ONE and THE ROW SILENTLY STOPS BEING TESTED while the gate stays
 1418:             #  green.  Longest name here is `overread x2` / `unimpl 2op` (11), so there
 1419:             #  are two characters of headroom.  Checked: no name is a prefix of another
 1420:             #  followed by a space, so no pattern can match two rows.
 1421:             #  The `count "$WFLOG"` on the next line is what identifies this section --
 1422:             #  every section's list opens "live" "devsig".
 1423:             for v in "live" "devsig" "unimpl x2" "unimpl 2op" "abrt 2nd" "overread x2" "overread -1" "w16 x2" "r16 x2" "datawr x2" "fire3" "interleave" "w16 reset" "wr indep" "w mixed" "r mixed" "r16 reset" "w32 x2" "r32 x2" "r16 value" "w16 value" "overrun x2" "accept ec" "accept w8" "accept r8" "disjoint"; do
 1424:                 n=$(count "$WFLOG" "^$v  .*ok$")
 1425:                 check "wdc_flood $v" "$n" 1
 1426:             done
 1427:         fi
 1428:     fi
 1429: fi
 1430: 
 1431: # ---------------------------------------------------------------------------
 1432: # #525 (wdcaltdigin): the wdc alt-ctrl handler never decoded its offset ON THE
 1433: # READ SIDE.  `relative_addr' was tested in exactly ONE place -- inside the
 1434: # `else' of `writeflag == MEM_READ' -- so a READ of offset 1, the Drive Address
 1435: # register, returned the ALT-STATUS byte: a different register's value, from an
 1436: # offset the handler never looked at.  THE SYMMETRIC CELL OF #494, which closed
 1437: # the WRITE half of that same `if' and left this one open.
 1438: #
 1439: # ATA-2 X3T10/0948D Note 1 recommends a device NOT RESPOND to a read here and,
 1440: # if it does, NOT DRIVE DD7.  `odata = 0' leaves bit 7 clear, so the returned
 1441: # value satisfies the one constraint the standard places on a device that
 1442: # answers; WHICH non-DD7 value is emulator policy, and the comment says so.
 1443: #
 1444: # THE STATUS BYTE BEING NONZERO IS LOAD-BEARING, NOT INCIDENTAL.  The mutant
 1445: # that keeps the offset guard and deletes `odata = 0' returns the status byte S;
 1446: # if S were 0 the fixed and broken builds would return the same byte and the row
 1447: # would be vacuous.  d->error = 1 at init gives S = 0x51, armed 0x58.
 1448: #
 1449: # Measured in regress/artifacts/wdcaltdigin/killtable_20260911/: HEAD 14/16,
 1450: # fix 16/16, M_REINSTATE = HEAD, M_NULL_MEDIUM fails a DIFFERENT pair (the two
 1451: # ACCEPT rows) -- all four legs score 14/16, so the discrimination lives in the
 1452: # ROW IDENTITY and not the score.  Clause (d) is N/A-WITH-REASON: the guarded
 1453: # body is `odata = 0', reading and testing nothing, and over a two-byte region
 1454: # `!= 0' admits no non-equivalent weakening, so the enumeration is EMPTY.
 1455: ADLOG=$LOGDIR/gate_wdc_altdigin.log
 1456: ADIMG=$LOGDIR/wdc_altdigin_scratch.img
 1457: python3 -u wdc_altdigin_probe.py "$PMAX" GATE "$ADIMG" "$LOGDIR/altdigin" > "$ADLOG" 2>&1 || true
 1458: 
 1459: if ! grep -q "WDC_ALTDIGIN_RESULT=" "$ADLOG"; then
 1460:     note "wdc_altdigin probe produced no result line; last lines follow"
 1461:     tail -5 "$ADLOG" | sed 's/^/       /'
 1462:     check "wdc_altdigin probe completed" "no" "yes"
 1463: else
 1464:     grep -E " PASS | FAIL " "$ADLOG" | sed 's/^/       /'
 1465:     adres=$(grep -o "WDC_ALTDIGIN_RESULT=[0-9]*/[0-9]*" "$ADLOG" | tail -1 | cut -d= -f2)
 1466: 
 1467:     #  *** PARSE BEFORE SCORE -- the same guard the wdcflood section above carries,
 1468:     #  and for the same measured reason: a result line that EXISTS but is MALFORMED
 1469:     #  still satisfies the outer grep, `adres' is then EMPTY, and both ${adres%/*}
 1470:     #  and ${adres#*/} expand to the empty string -- so `check "rows correct" "" ""'
 1471:     #  PASSES while nothing was measured. ***
 1472:     if [ -z "$adres" ]; then
 1473:         note "wdc_altdigin result line present but unparseable; last lines follow"
 1474:         tail -3 "$ADLOG" | sed 's/^/       /'
 1475:         check "wdc_altdigin result parses" "no" "yes"
 1476:     else
 1477:         check "wdc_altdigin result parses" "yes" "yes"
 1478: 
 1479:         adctl=$(grep -o "WDC_ALTDIGIN_CONTROL=[A-Z]*" "$ADLOG" | tail -1 | cut -d= -f2)
 1480:         check "wdc_altdigin control: liveness and devsig" "${adctl:-missing}" "OK"
 1481: 
 1482:         #  DENOMINATOR PINNED TO A LITERAL.  A gate that trusts the probe's own
 1483:         #  denominator cannot tell a probe that LOST rows from one that never had
 1484:         #  them -- which is this file's own padded-column lesson one level up.
 1485:         check "wdc_altdigin rows run"     "${adres#*/}" 16
 1486:         check "wdc_altdigin rows correct" "${adres%/*}" "${adres#*/}"
 1487:     fi
 1488: fi
 1489: 
 1490: #  *** A SOURCE GREP, BECAUSE A STEP-BASED PROBE CANNOT SEE CHANNEL SEMANTICS. ***
 1491: #  `fatal(` -> `debug(` at any of the six sites scores a CLEAN SWEEP against every row
 1492: #  above: they all single-step, and debug() always prints under stepping (its early-out
 1493: #  at core/debugmsg.c:375 fires on `v < 0`, which free-running at verbose 0 gives and
 1494: #  stepping does not).  A production guest would get SILENCE while the detector stayed
 1495: #  green -- quietly reversing this fork's own warrant for keeping fatal() (dev_asc.c:248-257:
 1496: #  under -q verbosity settles at VERBOSITY_ERROR, so a WARNING-level debugmsg is invisible
 1497: #  to the boot-log hygiene grep and an ERROR-level one trips #261's break-on-ERROR).
 1498: #  Named by a file-reading seat on the pass-2 panel.  Textual, cheap, and the only guard
 1499: #  that exists for this class.
 1500: #  *** PIN ON THE OPENING STRING LITERAL, AND THE REASON IS A NEAR MISS WORTH RECORDING. ***
 1501: #  A first draft pinned `grep -c 'fatal('` at 12.  That counts COMMENT lines mentioning
 1502: #  fatal() and gives 15 -- an UNSATISFIABLE check, red forever.  Narrowing to
 1503: #  `^[[:space:]]+fatal\(` gives 12 and looks correct -- but TWO of those matches are
 1504: #  comment CONTINUATION lines that happen to start with whitespace then "fatal()".  The
 1505: #  number would have been right BY COINCIDENCE, and any edit to that comment block would
 1506: #  have broken a check nobody would suspect.  `fatal("` cannot match a comment, and 10 is
 1507: #  the true census: 4 call sites latched by #337, 6 by this round.
 1508: #  *** THIS WAS AN EQUALITY PINNED AT 10 AND IT WAS RED FROM #476 UNTIL 2026-08-27,
 1509: #      WHICH IS TWO ROUNDS AND NOBODY SAW IT.  The grep returns 12: #476 added the
 1510: #      no-ATAPI DATA read, #478 added the refused-drain announce, and neither round
 1511: #      moved the pin.  It hid because this row lives in the WEEKLY battery -- every
 1512: #      commit since was green on its own targeted gate while this was failing. ***
 1513: #
 1514: #  IT IS A FLOOR NOW, AND THAT IS THE PIN THIS CHECK ALWAYS WANTED.  Read the reason
 1515: #  above: it exists to catch a DOWNGRADE, `fatal(` -> `debug(`, which REDUCES the
 1516: #  count.  An equality catches that -- and also breaks on every legitimate ADDITION,
 1517: #  which is what actually happened.  A floor catches the downgrade it was built for and
 1518: #  is immune to the growth that defeated it twice.
 1519: #
 1520: #  Negative-controlled both ways on the day it changed: deleting one call site reds it,
 1521: #  adding one leaves it green.  The number is a FLOOR, not a census -- do not "correct"
 1522: #  it upward when sites are added; that is the failure mode this replaces.
 1523: check_min "wdcflood: fatal() call sites intact (channel not downgraded)" \
 1524:       "$(grep -cE '^[[:space:]]+fatal\("' ../src/devices/dev_wdc.c)" 12
 1525: #  *** THAT COMPANION PIN CLAIMED IMMUNITY TO GROWTH AND CALLED THAT "THE WHOLE
 1526: #      LESSON".  IT READ 15 AGAINST A PINNED 12.  The claim survived FOUR HOURS. ***
 1527: #
 1528: #      Its exact words were: "it ENUMERATES SIX NAMED LATCHES in its regex instead
 1529: #      of counting an open set.  The device carries ELEVEN warned_ latches today;
 1530: #      this pin still reads 12 because growth cannot reach it."
 1531: #
 1532: #      Growth reached it by TWO routes the sentence did not consider, and a third
 1533: #      dimension nobody had named at all:
 1534: #
 1535: #        05ec21e  14:00 2026-08-27   the immunity comment lands
 1536: #        cf300c0  17:59 2026-08-27   #484 adds a SECOND guarded site re-using
 1537: #                                    warned_inbuf_overrun               -> +2
 1538: #        d819188  19:29 2026-08-27   #485 adds a COMMENT naming
 1539: #                                    warned_unimpl_cmd                  -> +1
 1540: #
 1541: #      MEMBERS was closed, and correctly so -- a new latch NAME cannot reach it.
 1542: #      OCCURRENCES was open: grep -c counts LINES, so a new SITE re-using a named
 1543: #      latch increments it.  And TEXT-vs-CODE was never considered: a sentence of
 1544: #      prose counted as a guard.
 1545: #
 1546: #      The comment's own closing rule was right and was not followed:
 1547: #      "Never an equality over a set the codebase is expected to add to."
 1548: #      d->warned_X OCCURRENCES are exactly such a set.  The members were named,
 1549: #      and then an equality was used over their occurrences anyway.
 1550: #
 1551: #  *** A BARE FLOOR (>= 12) WAS PROPOSED AND MEASURED VACUOUS, so it is not what
 1552: #      replaced it.  Deleting ONE latch's two-line guard pair scores 13 and PASSES,
 1553: #      restoring the unbounded flood #464 fixed.  Six per-latch ">= 2" rows were
 1554: #      also refuted: >= 2 is satisfied by TWO READS AND NO SET. ***
 1555: #
 1556: #      REPLACED BY TWO EQUALITIES OVER THE NAMED CLOSED SET, per-latch presence,
 1557: #      counted over COMMENT-STRIPPED code.  Equality is right for MEMBERS (that set
 1558: #      does not grow); what broke was an equality over OCCURRENCES, which this does
 1559: #      not count.  Stripping defeats the text-vs-code dimension by CLASS -- an anchor
 1560: #      tuned to today's comment survives only by its missing brace.
 1561: #
 1562: #      MEASURED (artifacts/batteryreds/row5_20260829/killtable.out):
 1563: #        BASE 6/6 ok | M1 delete guard pair 5/6 KILLED | M2 gut+comment 5/6 KILLED
 1564: #        M4 delete SET keep READ 5/6 KILLED | M3 null medium 0/0 KILLED
 1565: #        M5 absent file 0/0 and reports WDC_LATCH_FILE=MISSING, so a missing file
 1566: #        and a file with no latches do not render the same.
 1567: #
 1568: #      Proposed by the opus5 seat; adopted by the fable5 adjudicator over its own
 1569: #      twelve-row alternative, 2026-08-29.
 1570: wdclatch=$(python3 wdc_latch_census.py 2>/dev/null)
 1571: check "wdcflood: census read the file (not MISSING)" \
 1572:       "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_FILE=[A-Z]+' | cut -d= -f2)" "OK"
 1573: check "wdcflood: all six latches have a SET (comment-stripped)" \
 1574:       "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_SET=[0-9]+' | cut -d= -f2)" "6"
 1575: check "wdcflood: all six latches have a READ (comment-stripped)" \
 1576:       "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_READ=[0-9]+' | cut -d= -f2)" "6"
 1577: 
 1578: #  *** THE TWO ROWS BELOW CLOSE AN L2 FLOOR BREACH THAT THE FIRST VERSION OF THIS
 1579: #  BLOCK SHIPPED, and its kill table was CLEAN while the breach was live. ***
 1580: #
 1581: #  Presence alone (SET/READ above) is blind to a MULTI-SITE latch losing one site.
 1582: #  Every mutant in the first table happened to target a single-site latch, so the
 1583: #  table ran on a population that structurally could not exhibit the defect:
 1584: #
 1585: #      if (!d->warned_inbuf_overrun) {  ->  if (1) {     at ONE of its TWO sites
 1586: #      => set=2 read=1, SET=6 READ=6, gate GREEN, producer flood unbounded again
 1587: #
 1588: #  Floor clause (b) demands failure on reinstatement at EVERY fixed site, so that is
 1589: #  L2.  Note the inversion: the OLD pin counted OCCURRENCES, so a second site moved
 1590: #  it -- loud and wrong but alive.  Presence-only made losing one of two INVISIBLE.
 1591: #
 1592: #  BALANCED is RELATIONAL (set_count == read_count per latch), so growth increments
 1593: #  both sides and it is growth-invariant BY CONSTRUCTION -- not an equality against a
 1594: #  frozen literal needing hand-bumps, which is what broke here in the first place.
 1595: #  It is the tree's own house idiom: every latch is 1:1 and inbuf_overrun is 2:2.
 1596: #
 1597: #  DECL restores a tripwire this round would otherwise have DELETED -- the carrier's
 1598: #  de-escalation clause one level up.  Replacing a decaying equality with a
 1599: #  growth-immune one removes the accidental signal that latch growth used to send.
 1600: #  A twelfth latch, or a brand-new unguarded fatal(), now reds until someone looks.
 1601: #
 1602: #  MEASURED, artifacts/batteryreds/row5_20260829/killtable2.out -- ELEVEN mutants,
 1603: #  all killed, BASE 6/6/6/11 clean:
 1604: #    E1/E2 neutralise one of two sites 6/6/5/11 | E3 redirect guard 6/6/4/11
 1605: #    E7 twelfth latch 6/6/6/12 | E8 READ redirected to a LONGER name 6/5/5/12
 1606: #    E6 C99 "//" continuation swallowing a SET 6/6/5/11
 1607: #    M1/M2/M4 5/6/5/11 | M3 null medium 0/0/0/0 | M5 absent file reports MISSING
 1608: check "wdcflood: every latch BALANCED (set count == read count)" \
 1609:       "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_BALANCED=[0-9]+' | cut -d= -f2)" "6"
 1610: check "wdcflood: device latch population (bump DELIBERATELY, read it first)" \
 1611:       "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_DECL=[0-9]+' | cut -d= -f2)" "11"
 1612: 
 1613: gate_end

