  253:             f.write(bytes([w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff]))
  254: 
  255:     argv = [BINARY, "-V", "-E", "evbmips", "-e", "malta",
  256:             "-d", "iR:" + DISK, "0x%x:%s" % (BASE, rawbin)]
  257: 
  258:     print("==============================================================================")
  259:     print("wdcaltdigin Rung-3 Witness -- Leg: %s" % LEG)
  260:     print("==============================================================================")
  261:     print("date       %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
  262:     print("binary     %s" % BINARY)
  263:     print("command    %s" % " ".join(argv))
  264:     sys.stdout.flush()
  265: 
  266:     emu = Emu(argv)
  267: 
  268:     # Control 0 check
  269:     dis = emu.send("unassemble 0x%x 0x%x" % (BASE, BASE + len(prog) * 4), wait=3.0)
  270:     seen = {}
  271:     for line in dis.splitlines():
  272:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
  273:         if m:
  274:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
  275: 
  276:     w_ok = 0
  277:     for i, (w, _) in enumerate(prog):
  278:         addr = (BASE + i * 4) & 0xffffffff
  279:         hit = seen.get(addr)
  280:         if hit and hit[0] == "%08x" % w:
  281:             w_ok += 1
  282:     print("Control 0 disassembly: %d of %d words verified match" % (w_ok, len(prog)))
  283: 
  284:     emu.send("breakpoint add 0x%x" % HALT_ADDR, wait=0.5)
  285:     t = time.time()
  286:     emu.send("continue", wait=1.0)
  287:     deadline = time.time() + 60
  288:     hit = False
  289:     while time.time() < deadline:
  290:         emu.drain(0.5)
  291:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
  292:         if "BREAKPOINT" in tail.upper():
  293:             hit = True
  294:             break
  295:     elapsed = time.time() - t
  296:     print("Breakpoint at 0x%x reached: %s (%.2f s)" % (HALT_ADDR, hit, elapsed))
  297: 
  298:     got = {}
  299:     for nm in REGS:
  300:         v = reg(emu, nm)
  301:         got[nm] = None if v is None else (v & 0xff)
  302: 
  303:     logpath = os.path.join(OUTDIR, "transcript_%s.log" % LEG)
  304:     emu.close(logpath)
  305: 
  306:     # Report measured S explicitly
  307:     s_pwr = got.get("s0")
  308:     s_arm = got.get("s3")
  309:     off1_pwr = got.get("s1")
  310:     off1_arm = got.get("s4")
  311:     print("------------------------------------------------------------------------------")
  312:     print("MEASURED STATUS & OFFSET-1 SAMPLES:")
  313:     print("  Power-on Altstatus (off 0): S = 0x%02x (want 0x51)" % (s_pwr if s_pwr is not None else 0))
  314:     print("  Power-on Offset 1 (off 1):  0x%02x (BASE want 0x00, HEAD defect is 0x%02x)" %
  315:           (off1_pwr if off1_pwr is not None else 0, s_pwr if s_pwr is not None else 0))
  316:     print("  Armed Altstatus (off 0):    S_armed = 0x%02x (want 0x58)" % (s_arm if s_arm is not None else 0))
  317:     print("  Armed Offset 1 (off 1):     0x%02x (BASE want 0x00, HEAD defect is 0x%02x)" %
  318:           (off1_arm if off1_arm is not None else 0, s_arm if s_arm is not None else 0))
  319:     print("------------------------------------------------------------------------------")
  320: 
  321:     # Evaluate rows
  322:     npass = 0
