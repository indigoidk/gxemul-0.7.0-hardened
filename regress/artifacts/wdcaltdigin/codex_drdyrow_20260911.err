  140: e_lbu(s3, 0, t1)         # offset 0 (0x3f6) -> ACCEPT: returns S_armed=0x58
  141: e_lbu(s4, 1, t1)         # offset 1 (0x3f7) -> CORE: HEAD returns 0x58, BASE returns 0x00
  142: 
  143: # 4. Phase W1: WRITE to offset 0 (#481 soft reset unregressed)
