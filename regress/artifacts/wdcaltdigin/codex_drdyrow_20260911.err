#!/bin/bash
# GATE 10 -- SuperH floating-point rounding mode, measured on real guest instructions.
#
# What this protects
# -----------------
# #296 wired FPSCR.RM into thirteen of the sixteen single-precision store sites in
# cpu_sh_instr.c. Before it, the field was guest-writable and decoded NOWHERE: every store
# truncated. Truncation is round-toward-zero, which is the mode the SH-4 resets into, so
# there was no visible defect until you look at a guest that CHANGES the mode -- and
# OpenBSD/landisk installs round-to-nearest at every exec.
#
# Why the vectors look the way they do
# -----------------------------------
# Each one runs under BOTH modes and expects DIFFERENT answers, so reverting #296 turns the
# gate red. Two vectors are deliberately mode-INDEPENDENT and named PIN: they record limits
# that are real and are NOT fixed (double precision cannot be fixed at the store, and the
# host-double double-rounding is shared by every CPU core). A pin failing means someone
# changed a known limitation without updating the record -- which is worth knowing either
# way, and is the opposite of a check that cannot fail.
#
# The gate asserts on the number of discriminating vectors as well as on the results,
# because a table where every vector wants the same answer in both modes would pass
# vacuously. That is the failure mode this harness has now been bitten by five times.
set -u
cd "$(dirname "$0")"
. ./lib.sh

gate_begin "gate 10: SuperH rounding mode (#296)"

PMAX=${PMAX:-$ROOT/build/gxemul}
KERNEL=$IMAGES/openbsd76-landisk-bsd.rd
LOG=$LOGDIR/gate_sh_rounding.log

need_exec "$PMAX"
need_file "$KERNEL"
command -v python3 >/dev/null || gate_skip "python3 not available"

note "binary : $PMAX"
note "kernel : $KERNEL (loaded so the machine constructs; never executed)"
note "cold debugger, no media, no console -- the SCIF drops host->guest writes (#293)"

python3 sh_rounding_probe.py "$PMAX" "$KERNEL" > "$LOG" 2>&1 || true

if ! grep -q "SH_ROUND_RESULT=" "$LOG"; then
    note "probe produced no result line; last lines follow"
    tail -5 "$LOG" | sed 's/^/       /'
    gate_skip "probe did not complete"
fi

sed -n '1,/SH_ROUND_DISCRIMINATING/p' "$LOG" | grep -E "ok$|FAIL" | sed 's/^/       /'

res=$(grep -o "SH_ROUND_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
got=${res%/*}; want=${res#*/}
disc=$(grep -o "SH_ROUND_DISCRIMINATING=[0-9]*" "$LOG" | tail -1 | cut -d= -f2)

# 36 vector-mode pairs: 17 vectors x 2 modes (9 from #296, 6 ftrc rows from #297, and
# #299 turned the double-rounding PIN into a discriminating row and added the fmac
# tie-band witness) + #303's two single-mode subnormal-operand rows (RN pinned; DN
# STRIPPED by their NODN marker -- a DN=1 numeric expectation would bless a value
# real silicon flushes; committed bytes 0x32000001 / 0x3f800001 measured live).
check     "vector-mode pairs run"                  "$want" 36
check     "vector-mode pairs correct"              "$got"  "$want"
# EXACTLY 9 of the 17 vectors discriminate between the two modes: the 7 from #296 plus
# the #299-fixed fsub band row and the #300-fixed D-division row (each a PIN until its
# fix landed; each flip was that fix's acceptance test). If this number drops, someone weakened the table; if it RISES,
# someone made a mode-independent row (an ftrc row, or the fmac tie whose two modes
# genuinely agree) depend on FPSCR.RM, which is drift in the other direction.
# (#303's two rows are single-mode by design and cannot enter this count.)
check     "vectors that discriminate the two modes" "$disc" 9

# Per-instruction closure: naming them individually means a single site silently reverting
# cannot hide behind an aggregate count. The ftrc rows are #297's regression checks; the
# "fsub band" and "fmactie" rows are #299's (the pre-#299 build fails the band's RZ arm
# and the tie's RN arm).
for v in "fdiv" "float" "fadd " "fmac " "fmactie" "fipr" "ftrv" "fmul" \
         "fsub band" "faddinf" "Ddiv" "ftrcS-inf" "ftrcS-ovf" "ftrcS-nan" "ftrcS-edge" \
         "ftrcD-2p31" "ftrcD-neghalf"; do
    n=$(grep -c "^$v.*ok$" "$LOG")
    check "  $v: both modes correct" "$n" 2
done
# #303's subnormal rows are SINGLE-mode (RN pinned; see the probe) -- one line each.
for v in "subn fmul" "subn fdiv"; do
    n=$(grep -c "^$v.*ok$" "$LOG")
    check "  $v: RN row correct" "$n" 1
done

# ---- #314: legal encodings must not stop the emulator ------------------------
# The SH decoder answered an unimplemented encoding with `goto bad`, which sets
# cpu->running = 0. All eight rows below were measured HALTING the committed
# build; three of them are BASE ISA (MAC.L, MAC.W, TST.B), present since
# SH-1/SH-2 and legal on the SH7751R this rig models -- so this is not a
# question about accepting SH-4A extensions on an SH-4 core.
#
# The probe classifies the outcome from the dyntrans halt MESSAGE, not from a
# memory marker: after the fix the exception is raised and any store placed
# after the test instruction is legitimately never reached, so a marker-only
# check called every repaired row a failure (and called SLEEP, which is
# implemented and simply sleeps, a halt). See the probe's header.
HLOG=$LOGDIR/gate_sh_halt.log
python3 sh_halt_probe.py "$PMAX" "$KERNEL" > "$HLOG" 2>&1 || true

if ! grep -q "SH_HALT_RESULT=" "$HLOG"; then
    note "halt probe produced no result line; last lines follow"
    tail -5 "$HLOG" | sed 's/^/       /'
    #  a CHECK, not a gate_skip: the rounding section above has already
    #  recorded results and a skip here would discard them.
    check "halt probe completed" "no" "yes"
    gate_end; exit $?
fi

grep -E " ok$| FAIL$" "$HLOG" | sed 's/^/       /'

hctrl=$(grep -o "SH_HALT_CONTROL=[A-Z]*" "$HLOG" | tail -1 | cut -d= -f2)
check "halt-probe control proves it measures" "${hctrl:-missing}" "OK"

hres=$(grep -o "SH_HALT_RESULT=[0-9]*/[0-9]*" "$HLOG" | tail -1 | cut -d= -f2)
hgot=${hres%/*}; hwant=${hres#*/}
check "halt rows run"     "$hwant" 34
check "halt rows correct" "$hgot"  "$hwant"

# Named, so one encoding regressing cannot hide behind a total. Two spaces after
# the name: the probe pads to a fixed column and a name that is a PREFIX of
# another would otherwise match both rows (the trap that made two of gate 14's
# checks unsatisfiable and two of gate 13's count the wrong rows).
for v in "MAC.L" "MAC.W" "TST.B" "STC SGR" "STC.L DBR" "MOVLI.L" "SYNCO" "PREFI"; do
    n=$(count "$HLOG" "^$v  .*ok$")
    check "  survives: $v" "$n" 1
done

# ---- #315/#316/#317: execute-time halts, and one dropped store ---------------
# These need a state prologue (FPSCR.SZ/PR, SR.FD, a branch), so the bare
# encoding sweep above is structurally blind to them -- which is why they
# outlived #314. Three of them killed the gxemul PROCESS rather than setting
# cpu->running = 0, so the probe distinguishes a host exit from an emulator
# halt from a live run; a check that only looked for the halt message would
# have scored those as passes.
#
# The two XD rows are load-bearing. The register-pair handlers redirect an ODD
# register field to the XF bank, and an earlier draft computed that redirect
# then still transferred through the original pointer -- which every DR test
# passes. Only a row that seeds fr and xf differently can tell them apart.
#
# `movca.l` carries its own trap: r12 is the DECODER's default source for that
# encoding, so the row seeds r12 with a decoy and fails if the R0 override is
# ever dropped.
# ---- #318: the store-queue flush with the MMU on -----------------------------
# `pref` into the SQ range is a write-back, and with MMUCR.AT set the
# destination comes from the UTLB, not from QACR. That path used to run
# ABORT_EXECUTION.
#
# The probe installs the UTLB entry and MMUCR through GUEST stores to the
# architectural MMIO windows, because the debugger's register names for those
# fields exist but do not reach them -- an earlier version set them by name,
# never entered the AT branch, and would have passed against an unfixed build.
#
# `sq at1 ok` is the composition witness, not just a survival check: the operand
# has nonzero bits in BOTH [9:5] and [4:0], and the architectural destination is
# the translated page plus [9:5] with [4:0] zeroed -- an address that is neither
# the operand nor the page base.
#
# *** THIS BLOCK USED TO PIN THE OPPOSITE OF THE MANUAL, and it said so plainly:
# "a build that judged this access as a read would complete the copy and fail
# this row alone."  It would have.  Corrected in #454. ***
#
# SH7750 Hardware Manual Rev.7.00 4.7.4 "SQ Protection", p. 144 --
# `_scratchpad/sh7750_hardware.txt:11744-11746`, identically in the SH-4
# programming manual 4.6.4 at `sh4_programming.txt:3561-3563`:
#
#     "Write type exception judgment is performed for writes to the SQs, and
#      read type for transfer from the SQs to external memory (PREF
#      instruction), and a TLB miss exception, protection violation exception,
#      or initial page write exception is generated."
#
# Quoted in full because these rows were previously pinned to a panel VERDICT
# rather than to a document, and a future seat must be able to re-derive them
# without trusting this round.  The manual was not in the tree when they were
# first pinned; it is now.
#
# So `sq pr00 rdok` and `sq d0 rdok` FLUSH: privileged read is permitted by
# PR=00 and is indifferent to D.  The three `evt` rows carry the exception
# channel, which is the only channel that can see the change once the copy
# completes either way -- and MEASURED, two one-token mutants scored full marks
# without them, one of which lands the payload at PHYSICAL ZERO in silence.
# The two `itlb` rows kill FLAG_INSTR, which escapes the value rows AND the
# EXPEVT rows because it also yieransfer".  A guardless
    #  bits[k] reaches dma_reg[0..3] -- count, destination and length -- but NOT
    #  dma_reg[5], the ENABLE, which needs word index 11 against a reachable maximum
    #  of 9.  Three of four, and the overreach is 4 words for the read row, 6 for the
    #  write row.  It also stated the landing in the INDICATIVE, as something that
    #  happens -- the shipped guard prevents any landing at all; it is a property of
    #  the guardless counterfactual only.
    #
    #  It said that re-opens "a host kill that is otherwise unreachable".  Both DMA
    #  +0x18 exits are reachable on the SHIPPED build through the front door: write
    #  count=1 at +0x0c and enable=1 at +0x14, both implemented cases, then any
    #  nonzero store to +0x18.
    #
    #  And it said "SHIP BOTH; neither subsumes the other, and that was measured".
    #  The measurement says the opposite: across six mutants `scan uniq` kills every
    #  one that anything kills, and `granularity`'s only kill (m_oob) reddens
  et-only keying producing ZERO write diagnostics
    #  across 31 offsets, because the read pass latches every offset first.
    #  *** THIS LIST HAD 27 NAMES AGAINST 32 ROWS, AND THE FIVE MISSING ONES WERE
    #  THE HIGHEST-VALUE ROWS IN THE FILE. ***  A seat noticed that #460's gate
    #  names all 23 of its rows while this one silently stopped at the pass-1 set --
    #  so `dma alias x1`, `dma align16`, `dma rdleak`, `both windows` and
    #  `dma accept`, every one of them added BECAUSE a mutant escap through
    #  a heredoc mangled TWICE in one session and shipped a red gate with a bogus
    #  word `n` in it.
    for v in "live" "devsig" "impl ok" "rd lo" "rdlo x1" "wr lo" "wrlo x1" "rd hi" "rdhi x1" "rd w16" "rdw16 x1" "same twice" "two offs" "rd tasic_badaddr: dev_dreamcast_asic.c ended the host process on a SINGLE
#  guest load.  `r = (relative_addr / 4) & 3` then `exit(1)` when r == 3 --
#  above the switch and above the writeflag test, so no store, no staging
#  and no command sequence was needed.
#
#  THE DENOMINATOR IS 14 -- it read 13 until 2026-09-06, when the retrospective
#  re-check found the loop below naming thirteen of the probe's fourteen rows and
#  omitting `sweep 256' (the byte-load of all 256 offsets), which is now added.  An
#  unlisted row is not a failing row: it silently stops being checked while the gate
#  stays green, which is this file's own padded-column hazard reached by a different
#  road.  FOUR OF THOSE ROWS EXIST BECAUSE A PANEL FOUND
#  THE FIRST NINE INSUFFICIENT.  `alias`, `alias2` and `crossarr` pin the INDEXING
#  half of the bound on r; the other nine pin the kill and the accept side.
#  They are COMPLEMENTARY on purpose -- neither catches the other's mutant:
#    & 3 -> & 2  aliases +0x14 onto +0x10   -> only `al10   -> only `alias2` sees it
#    / 4 -> / 2  aliases +0x18 onto +0x10   -> only `alias2` sees it
#  A same-array distinctness row CANNOT see `& 7`: under it the three mask_13
#  words map to [4],[5],[6], three distinct cells that still round-trip.
#
#  Ted run then
#  loses every row and looks like a run that produced nothing.
ASLOG=$LOGDIR/gate_asic_badaddr.log
python3 -u asic_badaddr_probe.py "$PMAX" "$KERNEL" > "$ASLOG" 2>&1 || true

if ! grep -q "ASIC_BADADDR_RESULT=" "$ASLOG"; then
    note "asic_bad*/[0-9]*" "$ASLOG" | tail -1 | cut -d= -f2)

    #  *** THE PARSE MUST BE CHECKED BEFORE THE SCORE IS READ. ***  Three panel
    #  seats independently found the same false pass here: if the result line
    #  exists but is MALFORMED (no slash, truncated digits), the outer grep -q
    #  still succeeds, `asres` is EMPTY, and then `${asres%/*}` and
    #  `${asres#*/}` BOTH expand to the empty string -- so
    #  `check "rows correct" "" ""` PASSES while nothing was measured.  The
    #  `rows run` sibling would still redden the gate, so this was never a
    #  silent green overall; it was a false GREEN ROW, which is worse than
    #  useless because a reader scanning check output is misled about which
    #  part failed.  This is the project's own "a pattern        check "asic_badaddr result parses" "no" "yes"
    else
        check "asic_badaddr result parses" "yes" "yes"
        #  *** 13 -> 14 ON 2026-08-29.  ALL FOURTEEN ROWS PASS; ONLY THE PIN WAS STALE.
        #  The battery reported `rows run got=14 want=13` while `rows correct` read 14
        #  in the SAME run -- denominator stale, numerator sound. ***
        #
        #  Provenance: pinned at 13 by `f1fa6a0` (#463); `d894e35` (#474) added the
        #  `asicoffsetkill` sweep row to the probe and tocres=$(grep -o "TOCLEN_RESULT=[0-9]*/[0-9]*" "$TOCLOG" | tail -1 | cut -d= -f2)
        if [ -z "$tocres" ]; then
            note "gdromtoclen result line present but unparseable; last lines follow"
            tail -5 "$TOCLOG" | sed 's/^/       /'
            check "gdromtoclen result parses" "no" "yes"
        else
            check "gdromtoclen result parses" "yes" "yes"
            #  the denominator against a LITERAL: a probe that loses rows cannot pass
            check "gdromtoclen rows run"     "${tocres#*/}" 19
            check "gdromtoclen rows correct" "${tocres%/*}" "${tocres#*/}"
        fi

        #  Per-row presence.  A row that silently stops being tested is the padded-column
        #  class; these names are checked individually so a vanished row reds.
        for v in "live" "devsig sh4" "gdrom map" "ok data0" "ok data1" "ok surv" \
                 "ok cond" "bad surv" "bad says" "zero surv" "bad cond" \
                 "bad cnt" "bad event" "zero cond" "over surv" "over cond" \
                 "latch once" "latch surv" "latch cond"; do
            n=$(grep -c "^$v  .*ok$" "$TOCLOG")
            check "gdromtoclen row present: $v" "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
        done
    fi
fi

#  ---------------------------------------------------------------- #490 gdromdecline
#
#  The two de-fatalised sites in dev_dreamcast_gdrom.c's handle_command(): the case 0x30
#  data-format guard and the default: arm.  Both were fatal() + exit(1) reached by an
#  ordinary guest store.
#
#  ITS OWN SECTION AND ITS OWN DENOMINATOR, deliberately.  Bolting these rows onto the
#  58-row gdrom_default probe would edit two coupled places -- a literal and a 58-name list
#  that must agree -- for every row added.  #489 set that precedent and this follows it.
#
#  THE ROWS WORTH KNOWING ABOUT HERE ARE `crossbit` AND `latch cond`, because both were
#  MEASURED escaping an earlier plan:
#    * `crossbit` -- d->warned now has NINE writers sharing one field, and SIX of the
#      pre-existing ones are set from inside DEVICE_ACCESS by ordinary guest register reads.
#      If either new latch bit ALIASES an existing one, a prior TOC decline silences a whole
#      site and the guest gets a mute refusal.  Measured as Ma_toclen / Mb_toclen.
#    * `latch cond` -- moving the `break` INSIDE the latch `if` lets the SECOND identical bad
#      format fall through into sector_nr.  The announce count reads 1 either way, so this
#      row reads a DECLINE channel after the second command instead.  Measured as M_braceA.
DECLPROBE=gdrom_decline_probe.py
if [ ! -f "$DECLPROBE" ]; then
    gate_skip "gdromdecline: $DECLPROBE absent"
else
    DECLLOG=$LOGDIR/gate_gdrom_decline.log
    python3 -u "$DECLPROBE" "$PMAX" "$KERNEL" > "$DECLLOG" 2>&1 || true

    if ! grep -q "GDROM_DECL_RESULT=" "$DECLLOG"; then
        note "gdromdecline probe produced no result line; last lines follow"
        tail -5 "$DECLLOG" | sed 's/^/       /'
        check "gdromdecline probe completed" "no" "yes"
    else
        grep -E " ok$| FAIL$" "$DECLLOG" | sed 's/^/       /'

        #  CONTROLS FIRST AND SEPARATELY -- a run whose controls died is an APPARATUS
        #  failure and must not be read as product failures.
        if grep -q "GDROM_DECL_CONTROL=OK" "$DECLLOG"; then
            check "gdromdecline controls live" "yes" "yes"
        else
            note "gdromdecline CONTROLS DEAD -- the probe never reached the device."
            note "Do not read the row scores below as product failures."
            check "gdromdecline controls live" "no" "yes"
        fi

        #  PARSE BEFORE SCORE.  A malformed result line still satisfies the outer grep,
        #  leaving declres empty so both halves expand to "" and the score row compares ""
        #  with "" -- green on nothing.
        declres=$(grep -o "GDROM_DECL_RESULT=[0-9]*/[0-9]*" "$DECLLOG" | tail -1 | cut -d= -f2)
        if [ -z "$declres" ]; then
            note "gdromdecline result line present but unparseable; last lines follow"
            tail -5 "$DECLLOG" | sed 's/^/       /'
            check "gdromdecline result parses" "no" "yes"
        else
            check "gdromdecline result parses" "yes" "yes"
            #  the denominator against a LITERAL: a probe that loses rows cannot pass
            check "gdromdecline rows run"     "${declres#*/}" 20
            check "gdromdecline rows correct" "${declres%/*}" "${declres#*/}"
        fi

        #  Per-row presence.  A row that silently stops being tested is the padded-column
        #  class; these names are checked individually so a vanished row reds.
        for v in "live" "devsig sh4" "gdrom map" "fmt surv" "fmt says" "fmt x2" \
                 "latch cond" "fmt stage" "fmt cnt" "fmt event" "fmt 0x24" "unk surv" "unk says" \
                 "unk x2" "unk cnt" "robe completed" "no" "yes"
    else
        grep -E " ok$| FAIL$" "$CONDLOG" | sed 's/^/       /'

        #  CONTROLS FIRST AND SEPARATELY -- a run whose controls died is an APPARATUS
        #  failure and must not be read as a wall of product failures.
        if grep -q "GDROMCOND_CONTROL=OK" "$CONDLOG"; then
            check "gdromcond controls live" "yes" "yes"
        else
            note "gdromcond CONTROLS DEAD -- the probe never reached the device."
            note "Do not read the row scores btway.  MEASURED: a
        #  contended run scored 18/25 with CONTROL=OK -- seven late rows reading `absent` and
        #  one session dying -- and nothing in the log said the scores were uncitable.
        #  "Alive at the start" and "alive throughout" aws below say different things.
#
#  NOTE THE ROW NAMES ARE LONGER THAN THEIR COLUMN.  The probe prints `"  %-4s %-58s"` and
#  several names exceed 58 characters, so those lines carry NO trailing padding.  The anchors
#  below therefore must NOT require trSC_WIDTH_DONE" "$BSCLOG"; then
        note "sh4bscwidth probe did not reach its completion sentinel; last lines follow"
        tail -5 "$BSCLOG" | sed 's/^/       /'
        check "sh4bscwidth probe completed" "no" "yes"
    else
        grep -E "^  (ok|FAIL) " "$BSCLOG" | sed 's/^/       /'

        #  PARSE BEFORE SCORE.  A malformed result line still satisfies an outer grep,
        #  leaving the variable empty so both halves expand to "" and the row compares ""
        #  with "" -- green on nothing.
        bscres=$(grep -o "SH4_BSC_WIDTH_RESULT=[0-9]*/[0-9]*" "$BSCLOG" | tail -1 | cut -d= -f2)
        if [ -z "$bscres" ]; then
            note "sh4bscwidth result line present but unparseable; last lines follow"
            tail -5 "$BSCLOG" | sed 's/^/       /'
            check "sh4bscwidth result parses" "no" "yes"
        else
            check "sh4bscwidth result parses" "yes" "yes"
            #  the denominator against a LITERAL: a probe that loses rows cannot pass
            check "sh4bscwidth rows run"     "${bscres#*/}" 13
            check "sh4bscwidth rows correct" "${bscres%/*}" "${bscres#*/}"
        fi

        #  D0 and D7a are this probe's OWN controls and are checked BY NAME rather than
        #  folded into the score -- a control that goes red while the total stays acceptable
        #  is an apparatus failure being read as a product result.
        for c in "D0 every arm produced data" "D7a CONTROL: the CPU really is big-endian"; do
            check "sh4bscwidth control: $c" \
                  "$(grep -c "^  ok   $c" "$BSCLOG")" "1"
        done

        #  Per-row presence.  A row that silently stops being tested is the padded-column
        #  class, so each is pinned individually rather than by a total.
        for v in "D1 4-byte write reaches BCR2 AND IS MASKED; host survives" \
                 "D2 4-byte read returns the register in its own lane" \
                 "D3 a 1-byte write is not promoted to 16 bits" \
                 "D4 BOTH sites latch SEPARATELY, in one process (count the suffix, NOT the name)" \
                 "D5 a second non-16-bit access in one process survives" \
                 "D6 the 4-byte access is diagnosed AND says it was serviced" \
                 "D6b a 4-byte READ is diagnosed too, not only a write" \
                 "D7b a 4-byte write takes the FIRST two bytes on big-endian" \
                 "D8 BCR3's write reaches its register UNMASKED" \
                 "D9 a 1-byte READ does not kill the host" \
                 "D10 a legal 16-bit access is NOT diagnosed"; do
            n=$(count "$BSCLOG" "^  ok   $v")
            check "sh4bscwidth row green: $v" \
                  "$( [ "$n" -ge 1 ] && echo yes || echo no )" "yes"
        done
    fi
fi

WDCIMG=$IMAGES/wdc-scratch-64m.img
if [ ! -f "$WDCIMG" ]; then
    gate_skip "wdcflood: $WDCIMG absent (see regress/images.md -- it is a dd recipe, not a download)"
else
    WFLOG=$LOGDIR/gate_wdc_flood.log
    python3 -u wdc_flood_probe.py "$PMAX" "$KERNEL" "$WDCIMG" > "$WFLOG" 2>&1 || true

    if ! grep -q "WDC_FLOOD_RESULT=" "$WFLOG"; then
        note "wdc_flood probe produced no result line; last lines follow"
        tail -5 "$WFLOG" | sed 's/^/       /'
        check "wdc_flood probe completed" "no" "yes"
    else
        grep -E " ok$| FAIL$" "$WFLOG" | sed 's/^/       /'
        wfres=$(grep -o "WDC_FLOOD_RESULT=[0-9]*/[0-9]*" "$WFLOG" | tail -1 | cut -d= -f2)

        #  *** PARSE BEFORE SCORE. ***  If the result line exists but is MALFORMED, the
        #  outer grep still succeeds, `wfres` is EMPTY, and both `${wfres%/*}` and
        #  `${wfres#*/}` expand to the empty string -- so `check "rows correct" "" ""`
        #  PASSES while nothing was measured.  Three panel seats found that false pass
        #  in the asic section above; it is the project's own "a pattern that matched
        #  nothing reports zero for everything" class in shell-expansion clothes.
        if [ -z "$wfres" ]; then
            note "wdc_flood result line present but unparseable; last lines follow"
            tail -3 "$WFLOG" | sed 's/^/       /'
            check "wdc_flood result parses" "no" "yes"
        else
            check "wdc_flood result parses" "yes" "yes"
            check "wdc_flood rows run"     "${wfres#*/}" 26
            check "wdc_flood rows correct" "${wfres%/*}" "${wfres#*/}"

            #  Per-row presence.  A row that silently stops being tested is the
            #  padded-column class.  The probe's format is "%-14s " -- fourteen columns
            #  plus one literal space -- so a name of length L is followed by (15 - L)
            #  spaces; at L=13 that is two and the `^$v  ` anchor still matches, at L=14
            #  it is ONE and THE ROW SILENTLY STOPS BEING TESTED while the gate stays
            #  green.  Longest name here is `overread x2` / `unimpl 2op` (11), so there
            #  are two characters of headroom.  Checked: no name is a prefix of another
            #  followed by a space, so no pattern can match two rows.
            #  The `count "$WFLOG"` on the next line is what identifies this section --
            #  every section's list opens "live" "devsig".
            for v in "live" "devsig" "unimpl x2" "unimpl 2op" "abrt 2nd" "overread x2" "overread -1" "w16 x2" "r16 x2" "datawr x2" "fire3" "interleave" "w16 reset" "wr indep" "w mixed" "r mixed" "r16 reset" "w32 x2" "r32 x2" "r16 value" "w16 value" "overrun x2" "accept ec" "accept w8" "accept r8" "disjoint"; do
                n=$(count "$WFLOG" "^$v  .*ok$")
                check "wdc_flood $v" "$n" 1
            done
        fi
    fi
fi

# ---------------------------------------------------------------------------
# #525 (wdcaltdigin): the wdc alt-ctrl handler never decoded its offset ON THE
# READ SIDE.  `relative_addr' was tested in exactly ONE place -- inside the
# `else' of `writeflag == MEM_READ' -- so a READ of offset 1, the Drive Address
# register, returned the ALT-STATUS byte: a different register's value, from an
# offset the handler never looked at.  THE SYMMETRIC CELL OF #494, which closed
# the WRITE half of that same `if' and left this one open.
#
# ATA-2 X3T10/0948D Note 1 recommends a device NOT RESPOND to a read here and,
# if it does, NOT DRIVE DD7.  `odata = 0' leaves bit 7 clear, so the returned
# value satisfies the one constraint the standard places on a device that
# answers; WHICH non-DD7 value is emulator policy, and the comment says so.
#
# THE STATUS BYTE BEING NONZERO IS LOAD-BEARING, NOT INCIDENTAL.  The mutant
# that keeps the offset guard and deletes `odata = 0' returns the status byte S;
# if S were 0 the fixed and broken builds would return the same byte and the row
# would be vacuous.  d->error = 1 at init gives S = 0x51, armed 0x58.
#
# Measured in regress/artifacts/wdcaltdigin/killtable_20260911/: HEAD 14/16,
# fix 16/16, M_REINSTATE = HEAD, M_NULL_MEDIUM fails a DIFFERENT pair (the two
# ACCEPT rows) -- all four legs score 14/16, so the discrimination lives in the
# ROW IDENTITY and not the score.  Clause (d) is N/A-WITH-REASON: the guarded
# body is `odata = 0', reading and testing nothing, and over a two-byte region
# `!= 0' admits no non-equivalent weakening, so the enumeration is EMPTY.
ADLOG=$LOGDIR/gate_wdc_altdigin.log
ADIMG=$LOGDIR/wdc_altdigin_scratch.img
python3 -u wdc_altdigin_probe.py "$PMAX" GATE "$ADIMG" "$LOGDIR/altdigin" > "$ADLOG" 2>&1 || true

if ! grep -q "WDC_ALTDIGIN_RESULT=" "$ADLOG"; then
    note "wdc_altdigin probe produced no result line; last lines follow"
    tail -5 "$ADLOG" | sed 's/^/       /'
    check "wdc_altdigin probe completed" "no" "yes"
else
    grep -E " PASS | FAIL " "$ADLOG" | sed 's/^/       /'
    adres=$(grep -o "WDC_ALTDIGIN_RESULT=[0-9]*/[0-9]*" "$ADLOG" | tail -1 | cut -d= -f2)

    #  *** PARSE BEFORE SCORE -- the same guard the wdcflood section above carries,
    #  and for the same measured reason: a result line that EXISTS but is MALFORMED
    #  still satisfies the outer grep, `adres' is then EMPTY, and both ${adres%/*}
    #  and ${adres#*/} expand to the empty string -- so `check "rows correct" "" ""'
    #  PASSES while nothing was measured. ***
    if [ -z "$adres" ]; then
        note "wdc_altdigin result line present but unparseable; last lines follow"
        tail -3 "$ADLOG" | sed 's/^/       /'
        check "wdc_altdigin result parses" "no" "yes"
    else
        check "wdc_altdigin result parses" "yes" "yes"

        adctl=$(grep -o "WDC_ALTDIGIN_CONTROL=[A-Z]*" "$ADLOG" | tail -1 | cut -d= -f2)
        check "wdc_altdigin control: liveness and devsig" "${adctl:-missing}" "OK"

        #  DENOMINATOR PINNED TO A LITERAL.  A gate that trusts the probe's own
        #  denominator cannot tell a probe that LOST rows from one that never had
        #  them -- which is this file's own padded-column lesson one level up.
        check "wdc_altdigin rows run"     "${adres#*/}" 16
        check "wdc_altdigin rows correct" "${adres%/*}" "${adres#*/}"
    fi
fi

#  *** A SOURCE GREP, BECAUSE A STEP-BASED PROBE CANNOT SEE CHANNEL SEMANTICS. ***
#  `fatal(` -> `debug(` at any of the six sites scores a CLEAN SWEEP against every row
#  above: they all single-step, and debug() always prints under stepping (its early-out
#  at core/debugmsg.c:375 fires on `v < 0`, which free-running at verbose 0 gives and
#  stepping does not).  A production guest would get SILENCE while the detector stayed
#  green -- quietly reversing this fork's own warrant for keeping fatal() (dev_asc.c:248-257:
#  under -q verbosity settles at VERBOSITY_ERROR, so a WARNING-level debugmsg is invisible
#  to the boot-log hygiene grep and an ERROR-level one trips #261's break-on-ERROR).
#  Named by a file-reading seat on the pass-2 panel.  Textual, cheap, and the only guard
#  that exists for this class.
#  *** PIN ON THE OPENING STRING LITERAL, AND THE REASON IS A NEAR MISS WORTH RECORDING. ***
#  A first draft pinned `grep -c 'fatal('` at 12.  That counts COMMENT lines mentioning
#  fatal() and gives 15 -- an UNSATISFIABLE check, red forever.  Narrowing to
#  `^[[:space:]]+fatal\(` gives 12 and looks correct -- but TWO of those matches are
#  comment CONTINUATION lines that happen to start with whitespace then "fatal()".  The
#  number would have been right BY COINCIDENCE, and any edit to that comment block would
#  have broken a check nobody would suspect.  `fatal("` cannot match a comment, and 10 is
#  the true census: 4 call sites latched by #337, 6 by this round.
#  *** THIS WAS AN EQUALITY PINNED AT 10 AND IT WAS RED FROM #476 UNTIL 2026-08-27,
#      WHICH IS TWO ROUNDS AND NOBODY SAW IT.  The grep returns 12: #476 added the
#      no-ATAPI DATA read, #478 added the refused-drain announce, and neither round
#      moved the pin.  It hid because this row lives in the WEEKLY battery -- every
#      commit since was green on its own targeted gate while this was failing. ***
#
#  IT IS A FLOOR NOW, AND THAT IS THE PIN THIS CHECK ALWAYS WANTED.  Read the reason
#  above: it exists to catch a DOWNGRADE, `fatal(` -> `debug(`, which REDUCES the
#  count.  An equality catches that -- and also breaks on every legitimate ADDITION,
#  which is what actually happened.  A floor catches the downgrade it was built for and
#  is immune to the growth that defeated it twice.
#
#  Negative-controlled both ways on the day it changed: deleting one call site reds it,
#  adding one leaves it green.  The number is a FLOOR, not a census -- do not "correct"
#  it upward when sites are added; that is the failure mode this replaces.
check_min "wdcflood: fatal() call sites intact (channel not downgraded)" \
      "$(grep -cE '^[[:space:]]+fatal\("' ../src/devices/dev_wdc.c)" 12
#  *** THAT COMPANION PIN CLAIMED IMMUNITY TO GROWTH AND CALLED THAT "THE WHOLE
#      LESSON".  IT READ 15 AGAINST A PINNED 12.  The claim survived FOUR HOURS. ***
#
#      Its exact words were: "it ENUMERATES SIX NAMED LATCHES in its regex instead
#      of counting an open set.  The device carries ELEVEN warned_ latches today;
#      this pin still reads 12 because growth cannot reach it."
#
#      Growth reached it by TWO routes the sentence did not consider, and a third
#      dimension nobody had named at all:
#
#        05ec21e  14:00 2026-08-27   the immunity comment lands
#        cf300c0  17:59 2026-08-27   #484 adds a SECOND guarded site re-using
#                                    warned_inbuf_overrun               -> +2
#        d819188  19:29 2026-08-27   #485 adds a COMMENT naming
#                                    warned_unimpl_cmd                  -> +1
#
#      MEMBERS was closed, and correctly so -- a new latch NAME cannot reach it.
#      OCCURRENCES was open: grep -c counts LINES, so a new SITE re-using a named
#      latch increments it.  And TEXT-vs-CODE was never considered: a sentence of
#      prose counted as a guard.
#
#      The comment's own closing rule was right and was not followed:
#      "Never an equality over a set the codebase is expected to add to."
#      d->warned_X OCCURRENCES are exactly such a set.  The members were named,
#      and then an equality was used over their occurrences anyway.
#
#  *** A BARE FLOOR (>= 12) WAS PROPOSED AND MEASURED VACUOUS, so it is not what
#      replaced it.  Deleting ONE latch's two-line guard pair scores 13 and PASSES,
#      restoring the unbounded flood #464 fixed.  Six per-latch ">= 2" rows were
#      also refuted: >= 2 is satisfied by TWO READS AND NO SET. ***
#
#      REPLACED BY TWO EQUALITIES OVER THE NAMED CLOSED SET, per-latch presence,
#      counted over COMMENT-STRIPPED code.  Equality is right for MEMBERS (that set
#      does not grow); what broke was an equality over OCCURRENCES, which this does
#      not count.  Stripping defeats the text-vs-code dimension by CLASS -- an anchor
#      tuned to today's comment survives only by its missing brace.
#
#      MEASURED (artifacts/batteryreds/row5_20260829/killtable.out):
#        BASE 6/6 ok | M1 delete guard pair 5/6 KILLED | M2 gut+comment 5/6 KILLED
#        M4 delete SET keep READ 5/6 KILLED | M3 null medium 0/0 KILLED
#        M5 absent file 0/0 and reports WDC_LATCH_FILE=MISSING, so a missing file
#        and a file with no latches do not render the same.
#
#      Proposed by the opus5 seat; adopted by the fable5 adjudicator over its own
#      twelve-row alternative, 2026-08-29.
wdclatch=$(python3 wdc_latch_census.py 2>/dev/null)
check "wdcflood: census read the file (not MISSING)" \
      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_FILE=[A-Z]+' | cut -d= -f2)" "OK"
check "wdcflood: all six latches have a SET (comment-stripped)" \
      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_SET=[0-9]+' | cut -d= -f2)" "6"
check "wdcflood: all six latches have a READ (comment-stripped)" \
      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_READ=[0-9]+' | cut -d= -f2)" "6"

#  *** THE TWO ROWS BELOW CLOSE AN L2 FLOOR BREACH THAT THE FIRST VERSION OF THIS
#  BLOCK SHIPPED, and its kill table was CLEAN while the breach was live. ***
#
#  Presence alone (SET/READ above) is blind to a MULTI-SITE latch losing one site.
#  Every mutant in the first table happened to target a single-site latch, so the
#  table ran on a population that structurally could not exhibit the defect:
#
#      if (!d->warned_inbuf_overrun) {  ->  if (1) {     at ONE of its TWO sites
#      => set=2 read=1, SET=6 READ=6, gate GREEN, producer flood unbounded again
#
#  Floor clause (b) demands failure on reinstatement at EVERY fixed site, so that is
#  L2.  Note the inversion: the OLD pin counted OCCURRENCES, so a second site moved
#  it -- loud and wrong but alive.  Presence-only made losing one of two INVISIBLE.
#
#  BALANCED is RELATIONAL (set_count == read_count per latch), so growth increments
#  both sides and it is growth-invariant BY CONSTRUCTION -- not an equality against a
#  frozen literal needing hand-bumps, which is what broke here in the first place.
#  It is the tree's own house idiom: every latch is 1:1 and inbuf_overrun is 2:2.
#
#  DECL restores a tripwire this round would otherwise have DELETED -- the carrier's
#  de-escalation clause one level up.  Replacing a decaying equality with a
#  growth-immune one removes the accidental signal that latch growth used to send.
#  A twelfth latch, or a brand-new unguarded fatal(), now reds until someone looks.
#
#  MEASURED, artifacts/batteryreds/row5_20260829/killtable2.out -- ELEVEN mutants,
#  all killed, BASE 6/6/6/11 clean:
#    E1/E2 neutralise one of two sites 6/6/5/11 | E3 redirect guard 6/6/4/11
#    E7 twelfth latch 6/6/6/12 | E8 READ redirected to a LONGER name 6/5/5/12
#    E6 C99 "//" continuation swallowing a SET 6/6/5/11
#    M1/M2/M4 5/6/5/11 | M3 null medium 0/0/0/0 | M5 absent file reports MISSING
check "wdcflood: every latch BALANCED (set count == read count)" \
      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_BALANCED=[0-9]+' | cut -d= -f2)" "6"
check "wdcflood: device latch population (bump DELIBERATELY, read it first)" \
      "$(printf '%s\n' "$wdclatch" | grep -oE 'WDC_LATCH_DECL=[0-9]+' | cut -d= -f2)" "11"

gate_end


