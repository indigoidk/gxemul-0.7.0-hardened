  176: 
  177: /*
  178:  *  wdc_addtoinbuf():
  179:  *
  180:  *  Write to the inbuf at its head, read at its tail.
  181:  */
  182: static void wdc_addtoinbuf(struct wdc_data *d, int c)
  183: {
  184: 	/*  #484: REFUSE BEFORE THE STORE.  The invariant this establishes is
  185: 	    THE RING'S OCCUPANCY IS SOUND -- deliberately not the weaker "full is
  186: 	    distinguishable from empty".  MANY sites depend on the first and only
  187: 	    this function implements the second; the readers are derivable at any
  188: 	    commit with
  189: 	
  190: 	        grep -n 'inbuf_head [=!]= d->inbuf_tail' dev_wdc.c   (and the
  191: 	        reversed and subtractive forms; one site writes tail - head)
  192: 	
  193: 	    rather than from a number here.  An earlier draft wrote SIX while the
  194: 	    checkpoint said FOUR, and the two cannot be reconciled without first
  195: 	    deciding whether to count SITES or DECISIONS -- which is how the wrong
  196: 	    number got written in the first place.  A count in a comment ages; a
  197: 	    deriver does not.  Naming the WEAK property here would invite a later
  198: 	    edit to trade the strong one away, which is the whole reason the
  199: 	    invariant is stated as occupancy rather than as distinguishability.
  200: 	
  201: 	    One slot is sacrificed, so head == tail now means EMPTY, full stop, and
  202: 	    every reader below becomes sound with no struct change and no new field.
  203: 	    Modelled on dev_pckbc.c's pckbc_add_code(), which refuses at
  204: 	    next == tail for exactly this defect (#288).
  205: 	
  206: 	    *** THE RETURN IS OUTSIDE THE LATCH, AND THAT IS NOT A STYLE CHOICE.
  207: 	    ***  Nested inside it, the FIRST overflow is refused and every later
  208: 	    push sees warned_inbuf_overrun == 1, skips the whole condition, and
  209: 	    walks head onto tail -- the defect restored.  Measured as mutant Md3,
  210: 	    13/16 in the panel seat's own table (its Md3), and 12/15 when I rebuilt
  211: 	    it against these bytes as Md_inside -- DIFFERENT TABLES, and the figure is
  212: 	    cited with the one that produced it rather than blended.  Both tables kill
  213: 	    it, which is the claim.  wdc_get_inbuf() below already forbids the same
  214: 	    shape in the
  215: 	    CONSUMER for the same reason, so a maintainer copying that function's
  216: 	    structure into this one writes the bug by accident.
  217: 	
  218: 	    Written WITHOUT an `int next` temporary on purpose.  The obvious form
  219: 	    (`next = (head+1) % SIZE; ... head = next;`) deletes the masked advance
  220: 	    below and makes the mask inside `next` safety-critical; dropping it is a
  221: 	    one-token simplification and measured as an actual heap overflow
  222: 	    (`free(): invalid next size`).  Keeping both statements untouched makes
  223: 	    that edit inexpressible as a SINGLE change -- though not impossible: the
  224: 	    modulo in the advance statement below is still removable on its own.
  225: 	    What it closes is the obvious consolidation path, which is what a
  226: 	    maintainer actually takes.
  227: 	
  228: 	    Drop-NEWEST, not drop-oldest, by reason: the surviving consumers key on
  229: 	    the FRONT of the stream (the CDB dispatch reads bytes 0-11; the sector
  230: 	    drain reads aligned runs from tail), so overwriting the oldest byte
  231: 	    silently re-aims a 512-byte disk write at data the guest never staged
  232: 	    there.  Both in-tree ring precedents drop newest.  Measured: drop-oldest
  233: 	    scores 13/16 IN THE PANEL SEAT'S TABLE (its Md4) and is invisible to every
  234: 	    occupancy- and DRQ-shaped row there.  I did NOT rebuild that mutant against
  235: 	    these bytes, so it is cited as the seat's measurement and not as this
  236: 	    round's -- artifacts/wdcringambig/killtable_20260827/.
  237: 	
  238: 	    COST, measured and named rather than discovered later: WDC_INBUF_SIZE is
  239: 	    512*513, so the saturated occupancy 262655 is never 0 (mod 512) while the
  240: 	    old 262656 always was.  A saturated ring's pending sector write therefore
  241: 	    stalls instead of committing its oldest sector.  It is reachable only
  242: 	    through the width-mixing pathology that fills the ring in the first
  243: 	    place, and a stalled write is strictly better than a write of bytes the
  244: 	    guest did not supply.  */
  245: 	if ((d->inbuf_head + 1) % WDC_INBUF_SIZE == d->inbuf_tail) {
  246: 		if (!d->warned_inbuf_overrun) {
  247: 			d->warned_inbuf_overrun = 1;
  248: 			fatal("[ wdc_addtoinbuf(): WARNING! wdc inbuf overrun!"
  249: 			    " Increase WDC_MAX_SECTORS. ]\n");
  250: 		}
  251: 		return;
  252: 	}
  253: 
  254: 	d->inbuf[d->inbuf_head] = c;
  255: 
  256: 	d->inbuf_head = (d->inbuf_head + 1) % WDC_INBUF_SIZE;
  257: 	/*  #484: the #464 POST-HOC check that stood here is DELETED, and the
  258: 	    warrant is a measurement rather than an argument.
  259: 
  260: 	    It tested `head == tail` AFTER the advance.  The guard at the top of
  261: 	    this function makes `(head + 1) % SIZE != tail` a precondition of
  262: 	    reaching the store, so after the advance head != tail always: the
  263: 	    branch was unreachable.  MEASURED TRUE 0 TIMES across 12,232 producer
  264: 	    refusals over the whole 122-row suite.
  265: 
  266: 	    *** IT WAS KEPT AT FIRST, ON THE WARRANT THAT DEAD CODE WITH A TRUE
  267: 	    COMMENT COSTS NOTHING.  THE COMMENT WAS FALSE IN FOUR CLAIMS. ***  It
  268: 	    said head == tail means both empty and full with no disambiguator
  269: 	    (this round added one); that the corrupting store is the next one and
  270: 	    is silent (it is now refused and announced); that the bulk paths never
  271: 	    compare the pointers (one now does); and that no detector row claims
  272: 	    ring health (R1-R9 claim exactly that).  A maintainer reading it would
  273: 	    have concluded the ring is still ambiguous.  Removing code needs a
  274: 	    warrant in this fork, and a measured-dead branch under a four-times-
  275: 	    false comment is the clearest one there is.  */
  276: }
  277: 
  278: 
  279: /*
  280:  *  wdc_get_inbuf():
  281:  *
  282:  *  Read from the tail of inbuf.
  283:  */
  284: static uint64_t wdc_get_inbuf(struct wdc_data *d)
  285: {
  286: 	int c = d->inbuf[d->inbuf_tail];
  287: 
  288: 	if (d->inbuf_head == d->inbuf_tail) {
  289: 		/*  #464: the guard wraps the fatal() ONLY.
  290: 		    *** THE `return` MUST STAY OUTSIDE IT. ***  Nested inside,
  291: 		    the SECOND over-read falls through to the tail advance
  292: 		    below and corrupts the ring pointer -- a fix strictly worse
  293: 		    than the flood it removes.  Row `overread -1` pins it.
  294: 		    See `wdcringambig`: BEFORE #484 this predicate was unsound
  295: 		    after an overrun, because a FULL ring was indistinguishable
  296: 		    from an empty one; #484 sacrifices one slot, so head == tail
  297: 		    now means EMPTY (stale wording corrected 2026-09-05).  */
  298: 		if (!d->warned_inbuf_overread) {
  299: 			d->warned_inbuf_overread = 1;
  300: 			fatal("[ wdc: WARNING! someone is reading too much "
  301: 			    "from the wdc inbuf! ]\n");
  302: 		}
  303: 		return (uint64_t) -1;
  304: 	}
  305: 
  306: 	d->inbuf_tail = (d->inbuf_tail + 1) % WDC_INBUF_SIZE;
  307: 	return c;
  308: }
  309: 
  310: 
  311: /*
  312:  *  wdc_initialize_identify_struct():
  313:  */
  314: static void wdc_initialize_identify_struct(struct cpu *cpu, struct wdc_data *d)
  315: {
  316: 	uint64_t total_size;
  317: 	int flags, cdrom = 0;
  318: 	char namebuf[40];
  319: 
  320: 	total_size = diskimage_getsize(cpu->machine, d->drive + d->base_drive,
  321: 	    DISKIMAGE_IDE);
  322: 	if (diskimage_is_a_cdrom(cpu->machine, d->drive + d->base_drive,
  323: 	    DISKIMAGE_IDE))
  324: 		cdrom = 1;
  325: 
  326: 	memset(d->identify_struct, 0, sizeof(d->identify_struct));
  327: 
  328: 	/*  Offsets are in 16-bit WORDS!  High byte, then low.  */
  329: 
  330: 	/*  0: general flags  */
  331: 	flags = 1 << 6;	/*  Fixed  */
  332: 	if (cdrom)
  333: 		flags = 0x8580;		/*  ATAPI, CDROM, removable  */
  334: 	d->identify_struct[2 * 0 + 0] = flags >> 8;
  335: 	d->identify_struct[2 * 0 + 1] = flags;
  336: 
  337: 	/*  1: nr of cylinders  */
  338: 	d->identify_struct[2 * 1 + 0] = d->cyls[d->drive] >> 8;
  339: 	d->identify_struct[2 * 1 + 1] = d->cyls[d->drive];
  340: 
  341: 	/*  3: nr of heads  */
  342: 	d->identify_struct[2 * 3 + 0] = d->heads[d->drive] >> 8;
  343: 	d->identify_struct[2 * 3 + 1] = d->heads[d->drive];
  344: 
  345: 	/*  6: sectors per track  */
  346: 	d->identify_struct[2 * 6 + 0] = d->sectors_per_track[d->drive] >> 8;
  347: 	d->identify_struct[2 * 6 + 1] = d->sectors_per_track[d->drive];
  348: 
  349: 	/*  10-19: Serial number  */
  350: 	memcpy(&d->identify_struct[2 * 10], "#0                  ", 20);
  351: 
  352: 	/*  23-26: Firmware version  */
  353: 	memcpy(&d->identify_struct[2 * 23], "1.0     ", 8);
  354: 
  355: 	/*  27-46: Model number  */
  356: 	if (diskimage_getname(cpu->machine, d->drive + d->base_drive,
  357: 	    DISKIMAGE_IDE, namebuf, sizeof(namebuf))) {
  358: 		size_t i;
  359: 		for (i=0; i<sizeof(namebuf); i++)
  360: 			if (namebuf[i] == 0) {
  361: 				for (; i<sizeof(namebuf); i++)
  362: 					namebuf[i] = ' ';
  363: 				break;
  364: 			}
  365: 		memcpy(&d->identify_struct[2 * 27], namebuf, 40);
  366: 	} else
  367: 		memcpy(&d->identify_struct[2 * 27],
  368: 		    "Fake GXemul IDE disk                    ", 40);
  369: 
  370: 	/*  47: max sectors per multitransfer  */
  371: 	d->identify_struct[2 * 47 + 0] = 0x80;
  372: 	d->identify_struct[2 * 47 + 1] = 128;
  373: 
  374: 	/*  49: capabilities:  */
  375: 	/*  (0x200 = LBA, 0x100 = DMA support.)  */
  376: 	d->identify_struct[2 * 49 + 0] = 0;
  377: 	d->identify_struct[2 * 49 + 1] = 0;
  378: 
  379: 	/*  51: PIO timing mode.  */
  380: 	d->identify_struct[2 * 51 + 0] = 0x00;	/*  ?  */
  381: 	d->identify_struct[2 * 51 + 1] = 0x00;
  382: 
  383: 	/*  53: 0x02 = fields 64-70 valid, 0x01 = fields 54-58 valid  */
  384: 	d->identify_struct[2 * 53 + 0] = 0x00;
  385: 	d->identify_struct[2 * 53 + 1] = 0x02;
  386: 
  387: 	/*
  388: 	 *  #405: `% 255` where `& 255` is meant, on six of these eight lines.
  389: 	 *
  390: 	 *  The two that were already right are the ones whose operand is small:
  391: 	 *  `(sectors) & 255` cannot exceed a byte anyway. Every other line shifts
  392: 	 *  first and does NOT pre-mask, so its operand is a multi-byte quantity and
  393: 	 *  `% 255` is not byte extraction that occasionally coincides -- it is a
  394: 	 *  base-256 digit sum. Measured in closed form, 0 counterexamples over 2^26:
  395: 	 *      x % 255 == ((x >> 8) + (x & 255)) % 255
  396: 	 *
  397: 	 *  So this is not a rare corner. Above the threshold it is wrong 100.0000%
  398: 	 *  of the time; the 0.39% of sizes where the >>8 byte is accidentally right
  399: 	 *  are exactly the ones where >>16 is wrong. The announced capacity lands
  400: 	 *  either side of the truth, worst case reporting ZERO SECTORS.
  401: 	 *
  402: 	 *  Smallest size at which any byte diverges is 65,280 sectors -- but
  403: 	 *  diskimage_recalc_size()'s closing whole-cylinder round-up (the shared
  404: 	 *  bytespercyl block, hoisted there by #414) rounds every image up to
  405: 	 *  whole cylinders, so that exact count is unreachable. The smallest
  406: 	 *  REACHABLE divergence is 33,546,240 bytes (65 cylinders), where a 32 MB
  407: 	 *  disk announces itself as 120 KB.
  408: 	 *
  409: 	 *  The byte order is NOT a second defect and was deliberately left alone.
  410: 	 *  The convention is stated at the top of this function ("Offsets are in
  411: 	 *  16-bit WORDS!  High byte, then low"), the geometry words follow it, the
  412: 	 *  transmit loop in wdc_command()'s WDCC_IDENTIFY case pushes [i+1] before
  413: 	 *  [i+0], and dev_wdc_access()'s wd_data read reassembles (high << 8) | low.
  414: 	 *  Two panel seats called it a defect from the snippet alone; two that read
  415: 	 *  the file found it consistent, and a later pass CONFIRMED it by executing
  416: 	 *  the whole guest path: both the LE and BE branches, plus memory_writemax64,
  417: 	 *  land the SAME two bytes in guest memory, so the device layer is
  418: 	 *  byte-stream-preserving. The 57-vs-58 WORD order is not establishable from
  419: 	 *  this tree at all -- there is no ATA specification here -- so a mask-only
  420: 	 *  correction is exactly as much as the source can justify.
  421: 	 *
  422: 	 *  #408: THE CITATIONS ABOVE NAME CONSTRUCTS, NOT LINE NUMBERS, AND THAT IS
  423: 	 *  DELIBERATE.  #405 cited lines that its own inserted comment had shifted by
  424: 	 *  +31.  #407 wrote a correction saying "re-read every line reference AFTER
  425: 	 *  the edit is in place" -- and then made the identical error, because that
  426: 	 *  correction was itself +9 lines and every number it "fixed" was re-read from
  427: 	 *  the pre-edit file.  Two rounds, same mechanism, and the second one had the
  428: 	 *  lesson written down in front of it.  A line number inside a file the same
  429: 	 *  commit edits is measured against the file it was written in, not the one
  430: 	 *  that ships; naming the construct survives every future edit instead.
  431: 	 */
  432: 	/*  57-58: current capacity in sectors  */
  433: 	d->identify_struct[2 * 58 + 0] = ((total_size / 512) >> 24) & 255;
  434: 	d->identify_struct[2 * 58 + 1] = ((total_size / 512) >> 16) & 255;
  435: 	d->identify_struct[2 * 57 + 0] = ((total_size / 512) >> 8) & 255;
  436: 	d->identify_struct[2 * 57 + 1] = (total_size / 512) & 255;
  437: 
  438: 	/*  60-61: total nr of addressable sectors  */
  439: 	d->identify_struct[2 * 61 + 0] = ((total_size / 512) >> 24) & 255;
  440: 	d->identify_struct[2 * 61 + 1] = ((total_size / 512) >> 16) & 255;
  441: 	d->identify_struct[2 * 60 + 0] = ((total_size / 512) >> 8) & 255;
  442: 	d->identify_struct[2 * 60 + 1] = (total_size / 512) & 255;
  443: 
  444: 	/*  64: Advanced PIO mode support. 0x02 = mode4, 0x01 = mode3  */
  445: 	d->identify_struct[2 * 64 + 0] = 0x00;
  446: 	d->identify_struct[2 * 64 + 1] = 0x03;
  447: 
  448: 	/*  67, 68: PIO timing  */
  449: 	d->identify_struct[2 * 67 + 0] = 0;
  450: 	d->identify_struct[2 * 67 + 1] = 120;
  451: 	d->identify_struct[2 * 68 + 0] = 0;
  452: 	d->identify_struct[2 * 68 + 1] = 120;
  453: }
  454: 
  455: 
  456: /*
  457:  *  wdc__read():
  458:  */
  459: void wdc__read(struct cpu *cpu, struct wdc_data *d)
  460: {
  461: #define MAX_SECTORS_PER_CHUNK	64
  462: 	const int max_sectors_per_chunk = MAX_SECTORS_PER_CHUNK;
  463: 	unsigned char buf[512 * MAX_SECTORS_PER_CHUNK];
  464: 	int i, cyl = d->cyl_hi * 256+ d->cyl_lo;
  465: 	int count = d->seccnt? d->seccnt : 256;
  466: 	uint64_t offset = 512 * (d->sector - 1
  467: 	    + (int64_t)d->head * d->sectors_per_track[d->drive] +
  468: 	    (int64_t)d->heads[d->drive] * d->sectors_per_track[d->drive] * cyl);
  469: 
  470: #if 0
  471: 	/*  LBA:  */
  472: 	if (d->lba)
  473: 		offset = 512 * (((d->head & 0xf) << 24) + (cyl << 8)
  474: 		    + d->sector);
  475: 	printf("WDC read from offset %lli\n", (long long)offset);
  476: #endif
  477: 
  478: 	while (count > 0) {
  479: 		int to_read = count > max_sectors_per_chunk?
  480: 		    max_sectors_per_chunk : count;
  481: 
  482: 		/*  TODO: result code from the read?  */
  483: 
  484: 		/*  #484: AN OCCUPANCY BOUND.  The test below is a BUFFER bound -- does
  485: 		    the linear write fit inside the allocation -- and it is NOT an
  486: 		    occupancy bound: this arm bypasses wdc_addtoinbuf() entirely and
  487: 		    compares the two pointers nowhere, so it can step head past tail and
  488: 		    overwrite unread bytes in silence.
  489: 
  490: 		    MEASURED, AND THE QUALIFIER IS PART OF THE MEASUREMENT: driving the
  491: 		    FUNCTION with a prefilled ring gives occupancy 262156 -> 1548, a
  492: 		    plausible-looking number, with 1548 bytes of unread data replaced by
  493: 		    disk contents.
  494: 
  495: 		    *** BUT 'REACHABLE' IS THE WRONG WORD AND THE READING SEATS WERE RIGHT
  496: 		    ABOUT THE PRODUCT. ***  `wdc__read()` has exactly ONE caller and it sits
  497: 		    AFTER `wdc_new_command_reset()`, so the ring is EMPTY on every real
  498: 		    invocation.  The prefilled state the rows build is a FUNCTION state, not
  499: 		    a guest route.  The arm is occupancy-blind AS CODE; this guard is
  500: 		    DEFENSIVE, and it is licensed by the caller invariant being unwritten
  501: 		    anywhere else -- not by a live defect.  A second seat then MEASURED
  502: 		    that too: 512 READ/READMULTI commands driven only through the guest
  503: 		    register interface, ring pre-stuffed each time, reached this guard
  504: 		    1280 times and FIRED IT ZERO TIMES.
  505: 		
  506: 		    The `- 1` is the sacrificed slot and is load-bearing: without it this
  507: 		    guard admits a refill of exactly room+1 bytes, which is the ONLY input
  508: 		    that distinguishes the two forms (measured 15/16, one row).
  509: 		
  510: 		    It is the SAME admission predicate as the producer's, and that is the
  511: 		    reason both hunks are one round: split them and the two arms disagree
  512: 		    about what "full" means, which is an incoherence the split itself
  513: 		    creates.  */
  514: 		if (512 * to_read > (d->inbuf_tail - d->inbuf_head - 1 +
  515: 		    WDC_INBUF_SIZE) % WDC_INBUF_SIZE) {
  516: 			if (!d->warned_inbuf_overrun) {
  517: 				d->warned_inbuf_overrun = 1;
  518: 				/*  #484: names THIS function, not the producer.  The
  519: 				    shared latch already removes the only other way to
  520: 				    tell the two sites apart, so a message pointing at
  521: 				    a guard that did not fire is a wrong record in
  522: 				    product output.  */
  523: 				fatal("[ wdc__read(): WARNING! wdc inbuf would"
  524: 				    " overrun; refill refused. Increase"
  525: 				    " WDC_MAX_SECTORS. ]\n");
  526: 			}
  527: 			break;
  528: 		}
  529: 
  530: 		if (d->inbuf_head + 512 * to_read <= WDC_INBUF_SIZE) {
  531: 			diskimage_access(cpu->machine, d->drive + d->base_drive,
  532: 			    DISKIMAGE_IDE, 0, offset,
  533: 			    d->inbuf + d->inbuf_head, 512 * to_read);
  534: 			d->inbuf_head += 512 * to_read;
  535: 			if (d->inbuf_head == WDC_INBUF_SIZE)
  536: 				d->inbuf_head = 0;
  537: 		} else {
  538: 			diskimage_access(cpu->machine, d->drive + d->base_drive,
  539: 			    DISKIMAGE_IDE, 0, offset, buf, 512 * to_read);
  540: 			for (i=0; i<512 * to_read; i++)
  541: 				wdc_addtoinbuf(d, buf[i]);
  542: 		}
  543: 
  544: 		offset += 512 * to_read;
  545: 		count -= to_read;
  546: 	}
  547: 
  548: 	d->int_assert = 1;
  549: }
  550: 
  551: 
  552: /*
  553:  *  wdc__write():
  554:  */
  555: void wdc__write(struct cpu *cpu, struct wdc_data *d)
  556: {
  557: 	int cyl = d->cyl_hi * 256+ d->cyl_lo;
  558: 	int count = d->seccnt? d->seccnt : 256;
  559: 	uint64_t offset = 512 * (d->sector - 1
  560: 	    + (int64_t)d->head * d->sectors_per_track[d->drive] +
  561: 	    (int64_t)d->heads[d->drive] * d->sectors_per_track[d->drive] * cyl);
  562: #if 0
  563: 	/*  LBA:  */
  564: 	if (d->lba)
  565: 		offset = 512 * (((d->head & 0xf) << 24) +
  566: 		    (cyl << 8) + d->sector);
  567: 	printf("WDC write to offset %lli\n", (long long)offset);
  568: #endif
  569: 
  570: 	d->write_in_progress = d->cur_command;
  571: 	d->write_count = count;
  572: 	d->write_offset = offset;
  573: 
  574: 	/*  TODO: result code?  */
  575: }
  576: 
  577: 
  578: /*
  579:  *  status_byte():
  580:  *
  581:  *  Return a reasonable status byte corresponding to the controller's current
  582:  *  state.
  583:  */
  584: static int status_byte(struct wdc_data *d, struct cpu *cpu)
  585: {
  586: 	int odata = 0;
  587: 	if (diskimage_exist(cpu->machine, d->drive + d->base_drive,
  588: 	    DISKIMAGE_IDE))
  589: 		odata |= WDCS_DRDY | WDCS_DSC;
  590: 	if (d->inbuf_head != d->inbuf_tail)
  591: 		odata |= WDCS_DRQ;
  592: 	if (d->write_in_progress)
  593: 		odata |= WDCS_DRQ;
  594: 	if (d->error)
  595: 		odata |= WDCS_ERR;
  596: 	if (d->atapi_cmd_in_progress && (d->atapi_phase & WDCS_DRQ)) {
  597: 		odata |= WDCS_DRQ;
  598: 	}
  599: 	return odata;
  600: }
  601: 
  602: 
  603: /*  #481: forward-declared so the ALT-CTRL arm below can call it.  A panel seat's
  604:     control mutant failed to compile for want of exactly this line and the failure
  605:     was briefly read as a design constraint against calling the shared helper; it
  606:     is one line and it builds clean.  */
  607: static void wdc_new_command_reset(struct wdc_data *d);
  608: 
  609: DEVICE_ACCESS(wdc_altstatus)
  610: {
  611: 	struct wdc_data *d = (struct wdc_data *) extra;
  612: 	uint64_t idata = 0, odata = 0;
  613: 
  614: 	idata = data[0];
  615: 
  616: 	/*  Same as the normal status byte:  */
  617: 	odata = status_byte(d, cpu);
  618: 
  619: 	if (writeflag==MEM_READ) {
  620: 		if (relative_addr != 0) {
  621: 			/*  #525 (wdcaltdigin): THE READ PATH NEVER DECODED ITS
  622: 			    OFFSET EITHER.  `relative_addr' was tested in exactly
  623: 			    one place in this function -- inside the `else' of
  624: 			    this `if' -- so a READ of offset 1, the Drive Address
  625: 			    register (0x3f7 on the PC layout), returned the
  626: 			    ALT-STATUS byte -- the value of a DIFFERENT register,
  627: 			    from an offset this handler never decoded.
  628: 
  629: 			    THIS IS THE SYMMETRIC CELL OF #494, WHICH CLOSED THE
  630: 			    WRITE HALF OF THE SAME `if' AND LEFT THIS ONE OPEN.
  631: 			    The function's own inputs give a two-by-two --
  632: 			    {READ, WRITE} x {offset 0, offset 1} -- and three
  633: 			    cells were closed.  Measured at rung 3 on the
  634: 			    committed build: 14/16 pre-fix with both offset-1
  635: 			    read rows returning the status byte (0x51 at power-on,
  636: 			    0x58 armed), 16/16 after.
  637: 
  638: 			    *** AND ATA-2 SETTLES MORE OF THIS THAN THE ROUND
  639: 			    FIRST CLAIMED -- X3T10 0948D, Note 1 to the command
  640: 			    block (_scratchpad/ata2_x3t10_948d.txt:1529-1531):
  641: 			    "This register is obsolete.  It is recommended that a
  642: 			    device NOT RESPOND to a read of this address.  If a
  643: 			    device does respond, it shall be sure NOT TO DRIVE THE
  644: 			    DD7 SIGNAL to prevent possible conflict with floppy
  645: 			    disk implementations." ***
  646: 
  647: 			    Three things follow, and they are stronger than the
  648: 			    emulator-policy warrant this comment originally rested
  649: 			    on.  DECLINING IS THE RECOMMENDED BEHAVIOUR, not merely
  650: 			    a choice.  DD7 IS BIT 7, and `odata = 0' leaves it
  651: 			    clear, so the returned value satisfies the one
  652: 			    constraint the standard places on a device that does
  653: 			    answer.  And the floppy conflict the tree documents
  654: 			    from both sides IS the reason the standard gives --
  655: 			    which is why the narrowed sentence below stops at
  656: 			    "contested" rather than claiming what every guest
  657: 			    expects.  (`030e961' already recorded this Note as
  658: 			    governing and the comment never cited it; two panel
  659: 			    seats raised it independently.)
  660: 
  661: 			    ZERO IS AN EMULATOR POLICY WHERE THE STANDARD IS
  662: 			    SILENT -- it fixes WHICH non-DD7 value is returned,
  663: 			    which ATA-2 does not specify -- BUT IT IS NOT AN
  664: 			    ARBITRARY ONE.
  665: 			    DC21285-era PC parts leave 0x3f7 to the floppy
  666: 			    controller -- wdcreg.h compiles wd_digin out under an
  667: 			    `#if 0' reading "NOT MAPPED; fd uses this register on
  668: 			    PCs", and dev_fdc.c's DEV_FDC_LENGTH carries "TODO 8,
  669: 			    but collision with wdc".  Whose register it really is
  670: 			    stays open (row wdcaltownership).  What is settled is
  671: 			    that it is not ours to answer with our status byte, so
  672: 			    the declined read returns the deterministic 0 that #95
  673: 			    already pre-zeroes the caller's buffer with, rather
  674: 			    than inventing a value.
  675: 
  676: 			    SILENT, like #494's write decline and for a NARROWER
  677: 			    version of the same reason.  What the tree actually
  678: 			    establishes is that on the PC layout this byte is
  679: 			    CONTESTED and documented from both sides; it does NOT
  680: 			    establish that every guest on every registered layout
  681: 			    expects a floppy effect here, and an earlier draft of
  682: 			    this comment claimed that.  A diagnostic would
  683: 			    therefore be announcing a decode we are not certain is
  684: 			    anomalous -- which is reason enough to stay quiet,
  685: 			    without the stronger claim.
  686: 
  687: 			    (NOTE the collision is PROSPECTIVE, not live:
  688: 			    DEV_FDC_LENGTH is 6, so dev_fdc.c does not register
  689: 			    0x3f7 today.  The "TODO 8" is what would collide.)
  690: 
  691: 			    THE REGISTRATION IS DELIBERATELY NOT NARROWED.  A
  692: 			    2 -> 1 at the memory_device_register() below would
  693: 			    close both offset-1 cells structurally, but it moves
  694: 			    0x3f7 from HANDLED-AND-DECLINED to UNMAPPED -- a
  695: 			    different path whose behaviour here is unmeasured --
  696: 			    and it would leave #494's arm as dead code carrying a
  697: 			    measured comment.  Owner ruling: decode the read.  */
  698: 			odata = 0;
  699: 		} else
  700: 			debug("[ wdc: read from ALTSTATUS: 0x%02x ]\n",
  701: 			    (int)odata);
  702: 	} else if (relative_addr != 0) {
  703: 		/*  #494: THE HANDLER NEVER DECODED ITS OWN OFFSET.  The region is
  704: 		    registered TWO BYTES wide, so offset 1 -- the Drive Address
  705: 		    register, 0x3f7 on the PC layout -- arrived here and was treated
  706: 		    as a Device Control write.  Since #481 corrected the reset bit,
  707: 		    that meant a guest store to a READ-ONLY register aborted a live
  708: 		    ATA write and purged the queued ring.  Measured at rung 3 on an
  709: 		    unmodified evbmips -e malta; the witness is preserved under
  710: 		    regress/artifacts/wdcaltoffset/witness_20260829/.
  711: 
  712: 		    THE WHOLE ACTION IS DECLINED, NOT JUST THE HELPER CALL, AND THAT
  713: 		    IS THE POINT.  The reset has two effects with two owners: the
  714: 		    cur_command assignment below, and the ring/DRQ clearing inside
  715: 		    wdc_new_command_reset().  A fix that guards only the helper leaves
  716: 		    the ATAPI signature latched.  That was MEASURED, not reasoned: it
  717: 		    escapes the witness AND the detector that replaced it with a clean
  718: 		    sweep, because every row in both observes DRQ or the ring and
  719: 		    neither varies under it.  The kill table and its scores are under
  720: 		    regress/artifacts/wdcaltoffset/killtable_20260830/ -- read TABLE.txt
  721: 		    for the counts rather than trusting a number written here, which is
  722: 		    how this sentence was wrong once already.
  723: 
  724: 		    SILENT BY DESIGN, at debug() level and with no latch.  The house
  725: 		    idiom announces a guest ANOMALY, and this is not one: the tree
  726: 		    records in two places that this byte belongs to the floppy
  727: 		    controller on PCs -- wdcreg.h compiles wd_digin out under
  728: 		    an `#if 0` whose own note reads "NOT MAPPED; fd uses this
  729: 		    register on PCs" (the delimiters are dropped here on purpose:
  730: 		    a comment terminator quoted inside a comment ends it), and
  731: 		    dev_fdc.c's DEV_FDC_LENGTH carries `TODO 8, but collision with
  732: 		    wdc`.  *** NARROWED 2026-09-11 (#525): this sentence used to
  733: 		    read "A correct guest writes here expecting a floppy effect, so
  734: 		    a wdc diagnostic would report correct behaviour as a fault",
  735: 		    and #525's read-side comment 34 lines below RETRACTED exactly
  736: 		    that claim -- leaving this handler contradicting itself in one
  737: 		    function.  What the tree establishes is that on the PC layout
  738: 		    this byte is CONTESTED and documented from both sides; it does
  739: 		    NOT establish what every guest on every registered layout
  740: 		    expects.  The silence is still right, on the narrower ground
  741: 		    that a diagnostic would announce a decode we are not certain is
  742: 		    anomalous.  (And the collision is PROSPECTIVE: DEV_FDC_LENGTH
  743: 		    is 6, so dev_fdc.c does not register this byte today.)  Found
  744: 		    by the flagship adjudication, which grepped for the sibling of
  745: 		    a correction I had already called finished. ***
  746: 
  747: 		    THE ACCESS STAYS HANDLED (return 1), AND THE REASON IS NOT THE ONE
  748: 		    THIS COMMENT FIRST GAVE.  It said a 0 would fall through to
  749: 		    unassigned-address handling and warn per access.  That is false: this
  750: 		    device is REGISTERED, so a 0 never reaches that path.  memory_rw sets
  751: 		    res = -1, takes its res <= 0 branch, and raises EXCEPTION_DBE --
  752: 		    measured, 19793 `device 'wdc_altstatus' ... failed` lines and ZERO
  753: 		    `non-existant` ones under -v.  The guest then loops forever
  754: 		    re-executing the faulting store, and at DEFAULT verbosity it does so
  755: 		    in SILENCE.  That is worse than a warning flood, not better, which is
  756: 		    why the wrong reason was worth correcting rather than dropping: a
  757: 		    maintainer who reads `only noisy warnings` may decide a 0 is fine.
  758: 
  759: 		    The arm falls through to the common tail, which is a no-op for it --
  760: 		    the tail only assigns on the READ path.  (An earlier draft justified
  761: 		    that by the untouched-buffer hazard; #95 already zeroes the caller's
  762: 		    buffer, so that hazard cannot arise here either.)  */
  763: 		debug("[ wdc: write to DRIVE ADDRESS (read-only): 0x%02x,"
  764: 		    " ignored ]\n", (int)idata);
  765: 	} else {
  766: 		debug("[ wdc: write to ALT. CTRL: 0x%02x ]\n",
  767: 		    (int)idata);
  768: 		/*  #481: THE RESET BIT IS WDCTL_RST (0x04), NOT WDCTL_4BIT (0x08).
  769: 		
  770: 		    WDCTL_4BIT is "use four head bits (wd1003)", a head-addressing
  771: 		    mode selector that Linux libata holds as its STEADY-STATE ap->ctl.
  772: 		    Testing it here meant three measured defects at once:
  773: 		
  774: 		      * a real soft reset was MISSED.  Older OpenBSD asserts with 0x06,
  775: 		        which has bit 3 CLEAR -- measured `cur_command 0x0`.
  776: 		      * a ROUTINE control write DESTROYED THE RECORD OF WHICH COMMAND IS
  777: 		        EXECUTING -- measured `0xec -> 0x100`.  cur_command is also the
  778: 		        value assigned into write_in_progress, so this is only harmless
  779: 		        because wdc__write() has exactly ONE caller, immediately after
  780: 		        the assignment.  An accident, not an invariant.
  781: 		      * an nIEN write latched a reset.  0x0a is libata's polled-mode
  782: 		        staple -- measured `0x0a->0x100`.
  783: 		
  784: 		    COMMAND_RESET IS NOT A RESET ACTION.  It is read at exactly two
  785: 		    sites, both making the cylinder registers return the ATAPI signature
  786: 		    0xEB14 for a CD-ROM.  It is the SIGNATURE LATCH -- which is why the
  787: 		    wrong bit went unnoticed: triggering on libata's steady state kept
  788: 		    the signature on almost always.
  789: 		
  790: 		    LEVEL-TRIGGERED, DELIBERATELY, AND THE MEASURED DIFFERENCE
  791: 		    FAVOURS THIS FORM.  A channel held in reset must not carry bytes
  792: 		    out the far side, and an edge-triggered abort lets it:
  793: 		
  794: 		        assert 0x0e, 8 guest stores to DATA, rewrite 0x0e, release
  795: 		          LEVEL (this form):  occ 0, DRQ 0   -- the ring is purged
  796: 		          EDGE:               occ 8, DRQ 1   -- the bytes survive the
  797: 		                                                 whole reset, and the
  798: 		                                                 status byte still
  799: 		                                                 advertises DRQ
  800: 		
  801: 		    Measured through register writes only, with a liveness control (the
  802: 		    same traffic without a reset leaves occ 8, so the 0 is the reset
  803: 		    working and not a dead path).
  804: 		
  805: 		    *** AN EARLIER VERSION OF THIS COMMENT SAID edge and level were
  806: 		    "indistinguishable here, because the abort is idempotent and no
  807: 		    protocol-following driver issues commands while holding SRST".
  808: 		    THAT WAS MEASURED FALSE.  Three things were wrong with it:
  809: 		
  810: 		      * the differential behind it only ever asserted SRST ONCE, and
  811: 		        the forms differ only when a driver HOLDS it across two
  812: 		        control writes with something accruing in between;
  813: 		      * IDEMPOTENCE OF THE HELPER DOES NOT LICENCE THE INFERENCE.
  814: 		        It means repeating the abort is harmless.  It says nothing
  815: 		        about SKIPPING the repeat, which is what an edge does, and
  816: 		        state accrues between the writes;
  817: 		      * the scenario above ISSUES NO COMMAND.  Plain data-register
  818: 		        stores suffice -- and in a hardening fork the guest need not
  819: 		        be protocol-following at all.
  820: 		
  821: 		    The decision is unchanged and now rests on evidence that does not
  822: 		    collapse when someone builds the discriminating case. ***
  823: 		
  824: 		    Note also that a prev_ctl update mis-scoped by one brace makes
  825: 		    every LATER reset be ignored -- a failure this form cannot have --
  826: 		    but that is a secondary argument, not the reason.
  827: 		
  828: 		    THE ABORT IS #479's HELPER, not a second one: a channel reset and a
  829: 		    new command must not disagree about what gets cleared, and #479
  830: 		    already reasoned out which latches must SURVIVE (see its comment --
  831: 		    clearing warned_* would undo #337 and #464).  */
  832: 		if (idata & WDCTL_RST) {
  833: 			d->cur_command = COMMAND_RESET;
  834: 			wdc_new_command_reset(d);
  835: 		}
  836: 	}
  837: 
  838: 	if (writeflag == MEM_READ)
  839: 		data[0] = odata;
  840: 
  841: 	return 1;
  842: }
  843: 
  844: 
  845: 
  846: /*
  847:  *  wdc_new_command_reset():
  848:  *
  849:  *  #479: A COMMAND ENTERING wdc_command() STARTS WITHOUT THE PREVIOUS COMMAND'S
  850:  *  WRITER, BUFFERED BYTES, OR PHASE.
  851:  *
  852:  *  #480 L4: THE SCOPE IS THIS FUNCTION, NOT THE WORD "COMMAND".  An earlier
  853:  *  headline read "A NEW COMMAND STARTS WITHOUT..." with no qualifier, and the
  854:  *  device falsified that in its own code: the ALT-CTRL arm assigned
  855:  *  cur_command = COMMAND_RESET WITHOUT CALLING THIS HELPER, so the most
  856:  *  reset-like operation the device had was not a caller at all.  The SCOPE
  857:  *  paragraph forty lines below said so; a universal headline with its qualifier
  858:  *  that far down is read as universal.  Named by the fable seat on #479 pass 2.
  859:  *
  860:  *  wdc_command() cleared the ATAPI flag and the error and nothing else, so three
  861:  *  pieces of the previous command's state survived into the next one.  All three
  862:  *  were reproduced with liveness controls before this was written:
  863:  *
  864:  *    write_in_progress   an ATA write stayed armed across a packet command, so one
  865:  *                        shared ring served the disk-write path and the CDB path at
  866:  *                        once.  MEASURED: a guest's own sector write put 512 CD-ROM
  867:  *                        DATA-IN bytes and ZERO of its own on the image.
  868:  *    the input ring      residue from an under-drained transfer was never cleared.
  869:  *                        MEASURED: the drain then fires early and the guest's sector
  870:  *                        arrives with the previous transfer's bytes at its head.
  871:  *    atapi_phase         PHASE_CMDOUT survived an ordinary WRITE command.  Latent
  872:  *                        while the dispatch tests the flag AND the phase -- and #477's
  873:  *                        comment was pointing a future round straight at it.
  874:  *
  875:  *  WHY THE TOP, AND NOT THE END.  IDENTIFY loads its 512-byte response INTO the ring
  876:  *  as part of the command, and wdc__read() does the same for every ordinary READ.  A
  877:  *  seat measured the end-of-function form destroying both -- 256 of 256 IDENTIFY
  878:  *  words wrong, and a freshly-read sector gone -- while every row this round pins
  879:  *  stayed GREEN.  Clean-up-on-exit reads as the more principled placement and is the
  880:  *  more dangerous one.
  881:  *
  882:  *  WHAT THIS DELIBERATELY DOES NOT TOUCH:
  883:  *
  884:  *    cur_command     wdc__write() reads it, and the caller sets it immediately
  885:  *                    above.  Clearing it here would break the write it is about to
  886:  *                    set up.
  887:  *    the warned_*    latches.  Zeroing them alongside everything else reads as
  888:  *                    COMPLETING this helper and is the mutant to press: it undoes
  889:  *                    #337 and #464, and it is STRICTLY WORSE than the equivalent
  890:  *                    mistake in dev_asc.c, because wdc_command() runs far more often
  891:  *                    than a chip reset.  dev_asc.c says so at its own latch
  892:  *                    declarations: "Deliberately NOT cleared by dev_asc_reset() or
  893:  *                    dev_asc_fifo_flush(): a guest could otherwise re-arm the flood."
  894:  *
  895:  *  SCOPE.  TWO CALLERS: wdc_command(), and the ALT-CTRL arm on a real soft reset.
  896:  *
  897:  *  *** THIS PARAGRAPH SAID "Called from wdc_command() only" AND PRESCRIBED WHAT WOULD
  898:  *  HAVE TO HAPPEN FIRST BEFORE THE OTHER CALLER COULD EXIST.  #481 DID EXACTLY THAT,
  899:  *  so the prescription is DISCHARGED rather than merely stale. ***
  900:  *
  901:  *  It read: extending the helper to that arm AS IT STOOD was MEASURED to cancel a
  902:  *  legal transfer on an ordinary 0x08 Device Control write, which real drivers hold
  903:  *  as their steady state; so the extension "needs the arm's bit test fixed first
  904:  *  (WDCTL_RST, not WDCTL_4BIT) and is a separate round."
  905:  *
  906:  *  #481 is that round.  It corrected the bit AND made the call in one change, which
  907:  *  is why the accept rows this paragraph pointed at are GREEN on the shipped tree and
  908:  *  still RED under `Md_bitswap` -- the same extension WITHOUT the prerequisite.
  909:  *  Those four rows therefore MEASURED the ordering argument rather than asserting it.
  910:  *
  911:  *  The invariant is still not established on every path into the device: the ALT-CTRL
  912:  *  arm calls this only for WDCTL_RST, and other decode paths into that register are
  913:  *  filed rather than covered.  Said out loud rather than implied, as before.
  914:  */
  915: static void wdc_new_command_reset(struct wdc_data *d)
  916: {
  917: 	d->atapi_cmd_in_progress = 0;
  918: 	d->atapi_phase = 0;
  919: 	d->write_in_progress = 0;
  920: 
  921: 	/*  pointer reset rather than a drain loop, matching dev_asc_fifo_flush()'s
  922: 	    count-zeroing: there is no consumer to notify and nothing to hand back.  */
  923: 	d->inbuf_head = d->inbuf_tail = 0;
  924: }
  925: /*
  926:  *  wdc_command():
  927:  */
  928: void wdc_command(struct cpu *cpu, struct wdc_data *d, int idata)
  929: {
  930: 	size_t i;
  931: 
  932: 	d->cur_command = idata;
  933: 	d->error = 0;
  934: 
  935: 	/*  #479: this replaced a bare `d->atapi_cmd_in_progress = 0;`.  The flag
  936: 	    was one of three pieces of the previous command's state, and clearing
  937: 	    only the one that had been noticed is what left the other two.  */
  938: 	wdc_new_command_reset(d);
  939: 
  940: 	/*
  941: 	 *  Disk images that do not exist return an ABORT error.  This also
  942: 	 *  happens with CDROM images with the WDCC_IDENTIFY command; CDROM
  943: 	 *  images must be detected with ATAPI_IDENTIFY_DEVICE instead.
  944: 	 *
  945: 	 *  TODO:  Is this correct/good behaviour?
  946: 	 */
  947: 	if (!diskimage_exist(cpu->machine, d->drive + d->base_drive,
  948: 	    DISKIMAGE_IDE)) {
  949: 		debug("[ wdc: command 0x%02x drive %i, but no disk image ]\n",
  950: 		    d->cur_command, d->drive + d->base_drive);
  951: 		d->error |= WDCE_ABRT;
  952: 		d->int_assert = 1;
  953: 		return;
  954: 	}
  955: 	if (diskimage_is_a_cdrom(cpu->machine, d->drive + d->base_drive,
  956: 	    DISKIMAGE_IDE) && d->cur_command == WDCC_IDENTIFY) {
  957: 		debug("[ wdc: IDENTIFY drive %i, but it is an ATAPI "
  958: 		    "drive ]\n", d->drive + d->base_drive);
  959: 		d->error |= WDCE_ABRT;
  960: 		d->int_assert = 1;
  961: 		return;
  962: 	}
  963: 
  964: 	/*  Handle the command:  */
  965: 	switch (d->cur_command) {
  966: 
  967: 	case WDCC_READ:
  968: 	case WDCC_READMULTI:
  969: 		if (!quiet_mode)
  970: 			debug("[ wdc: READ from drive %i, head %i, cyl %i, "
  971: 			    "sector %i, nsecs %i ]\n", d->drive, d->head,
  972: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
  973: 		wdc__read(cpu, d);
  974: 		break;
  975: 
  976: 	case WDCC_WRITE:
  977: 	case WDCC_WRITEMULTI:
  978: 		if (!quiet_mode)
  979: 			debug("[ wdc: WRITE to drive %i, head %i, cyl %i, "
  980: 			    "sector %i, nsecs %i ]\n", d->drive, d->head,
  981: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
  982: 		wdc__write(cpu, d);
  983: 		break;
  984: 
  985: 	case WDCC_IDP:	/*  Initialize drive parameters  */
  986: 		debug("[ wdc: IDP drive %i (TODO) ]\n", d->drive);
  987: 		/*  TODO  */
  988: 		d->int_assert = 1;
  989: 		break;
  990: 
  991: 	case SET_FEATURES:
  992: 		debug("[ wdc: SET_FEATURES drive %i (TODO), feature 0x%02x ]\n",
  993: 		    d->drive, d->precomp);
  994: 		/*  TODO  */
  995: 		switch (d->precomp) {
  996: 		case WDSF_SET_MODE:
  997: 			debug("[ wdc: WDSF_SET_MODE drive %i, pio/dma flags "
  998: 			    "0x%02x ]\n", d->drive, d->seccnt);
  999: 			break;
 1000: 		default:d->error |= WDCE_ABRT;
 1001: 		}
 1002: 		/*  TODO: always interrupt?  */
 1003: 		d->int_assert = 1;
 1004: 		break;
 1005: 
 1006: 	case WDCC_RECAL:
 1007: 		debug("[ wdc: RECAL drive %i ]\n", d->drive);
 1008: 		d->int_assert = 1;
 1009: 		break;
 1010: 
 1011: 	case WDCC_IDENTIFY:
 1012: 	case ATAPI_IDENTIFY_DEVICE:
 1013: 		debug("[ wdc: %sIDENTIFY drive %i ]\n", d->cur_command ==
 1014: 		    ATAPI_IDENTIFY_DEVICE? "ATAPI " : "", d->drive);
 1015: 		wdc_initialize_identify_struct(cpu, d);
 1016: 		/*  The IDENTIFY data is sent out in low/high byte order:  */
 1017: 		for (i=0; i<sizeof(d->identify_struct); i+=2) {
 1018: 			wdc_addtoinbuf(d, d->identify_struct[i+1]);
 1019: 			wdc_addtoinbuf(d, d->identify_struct[i+0]);
 1020: 		}
 1021: 		d->int_assert = 1;
 1022: 		break;
 1023: 
 1024: 	case WDCC_IDLE_IMMED:
 1025: 		debug("[ wdc: IDLE_IMMED drive %i ]\n", d->drive);
 1026: 		/*  TODO: interrupt here?  */
 1027: 		d->int_assert = 1;
 1028: 		break;
 1029: 
 1030: 	case WDCC_SETMULTI:
 1031: 		debug("[ wdc: SETMULTI drive %i ]\n", d->drive);
 1032: 		/*  TODO: interrupt here?  */
 1033: 		d->int_assert = 1;
 1034: 		break;
 1035: 
 1036: 	case ATAPI_SOFT_RESET:
 1037: 		debug("[ wdc: ATAPI_SOFT_RESET drive %i ]\n", d->drive);
 1038: 		/*  TODO: interrupt here?  */
 1039: 		d->int_assert = 1;
 1040: 		break;
 1041: 
 1042: 	case ATAPI_PKT_CMD:
 1043: 		debug("[ wdc: ATAPI_PKT_CMD drive %i ]\n", d->drive);
 1044: 		/*  TODO: interrupt here?  */
 1045: 		/*  d->int_assert = 1;  */
 1046: 		d->atapi_cmd_in_progress = 1;
 1047: 		d->atapi_phase = PHASE_CMDOUT;
 1048: 		break;
 1049: 
 1050: 	case WDCC_DIAGNOSE:
 1051: 		debug("[ wdc: WDCC_DIAGNOSE drive %i: TODO ]\n", d->drive);
 1052: 		/*  TODO: interrupt here?  */
 1053: 		d->int_assert = 1;
 1054: 		d->error = 1;		/*  No error?  */
 1055: 		break;
 1056: 
 1057: 	/*  Unsupported commands, without warning:  */
 1058: 	case WDCC_SEC_SET_PASSWORD:
 1059: 	case WDCC_SEC_UNLOCK:
 1060: 	case WDCC_SEC_ERASE_PREPARE:
 1061: 	case WDCC_SEC_ERASE_UNIT:
 1062: 	case WDCC_SEC_FREEZE_LOCK:
 1063: 	case WDCC_SEC_DISABLE_PASSWORD:
 1064: 		/*  #485: A TERMINAL ARM RAISES ITS COMPLETION INTERRUPT.
 1065: 
 1066: 		    THE INVARIANT, derived over all 256 opcodes rather than from a
 1067: 		    few neighbours: every command wdc_command() FINISHES raises the
 1068: 		    completion interrupt.  The only opcodes that stay silent are the
 1069: 		    THREE that hand control back for a data phase -- WDCC_WRITE,
 1070: 		    WDCC_WRITEMULTI and ATAPI_PKT_CMD -- and each of those asserts
 1071: 		    when its data phase drains.  This arm and the `default:` arm
 1072: 		    below were the only violations.
 1073: 
 1074: 		    *** THEY WERE ALSO THE ONLY TERMINAL ARMS IN THE FUNCTION WITH NO
 1075: 		    INTERRUPT DECISION RECORDED AT ALL -- no assert, and no comment.
 1076: 		    ***  Six arms carry a `TODO ... interrupt` hedge; in five the
 1077: 		    author asserted, and in the sixth (ATAPI_PKT_CMD) he left the
 1078: 		    assert COMMENTED OUT, so that decision is visible in the source.
 1079: 		    A question never reached, not a decision to stay silent.
 1080: 
 1081: 		    NO SPECIFICATION IS CITED AND NONE IS AVAILABLE -- there is no ATA
 1082: 		    document in this tree.  The warrant is the invariant above plus a
 1083: 		    sibling model: dev_mb89352.c asserts on ANY non-zero interrupt
 1084: 		    status, without regard to whether the command succeeded.
 1085: 
 1086: 		    nIEN CANNOT CONTRADICT THIS: WDCTL_IDS (0x02) is defined in
 1087: 		    wdcreg.h and read NOWHERE in this file, so the model has no
 1088: 		    interrupt-disable state.  This arm is exactly as nIEN-blind as
 1089: 		    the ten arms that already assert.
 1090: 
 1091: 		    HARM, STATED HONESTLY: none measured.  WDCS_BSY is never set
 1092: 		    anywhere in this file, so a polling driver's wait returns at once
 1093: 		    with DRDY|DSC|ERR.  The WDCS_BSY fact is FILE-SCOPED and this
 1094: 		    comment owns it: grep the file.
 1095: 		
 1096: 		    *** THE REST OF THIS PARAGRAPH ONCE ASSERTED A BOOT CENSUS -- that
 1097: 		    OpenBSD 7.6 completes boot and shutdown against the old behaviour,
 1098: 		    that 0xF5 lands here on every attach and 0xE0 on every halt.  A
 1099: 		    PANEL SEAT MEASURED ALL OF THAT AND ITS ARTIFACT WAS NOT PRESERVED,
 1100: 		    so the claim rested on evidence that no longer exists.  Named by a
 1101: 		    packet-fed seat on pass 2. ***
 1102: 		
 1103: 		    It is kept as an ATTRIBUTED REPORT rather than deleted, because the
 1104: 		    reachability it describes is why this arm was worth fixing at all --
 1105: 		    but it is a seat's measurement, not this comment's, and a reader
 1106: 		    who wants it must re-run a boot rather than cite this line.
 1107: 		
 1108: 		    The licence is protocol correctness at trivial cost, NOT a hang.
 1109: 		    That much stands on the WDCS_BSY reading alone.  */
 1110: 		d->error |= WDCE_ABRT;
 1111: 		d->int_assert = 1;
 1112: 		break;
 1113: 
 1114: 	default:/*  TODO  */
 1115: 		/*  #464: `d->error |= WDCE_ABRT` STAYS OUTSIDE THE GUARD.
 1116: 		    Inside it, the second unimplemented command silently
 1117: 		    SUCCEEDS -- wdc_command() re-clears d->error per command,
 1118: 		    so the guest is told the command worked.  A line-counting
 1119: 		    oracle cannot see that; row `abrt 2nd` reads the status
 1120: 		    register after the second command and can.
 1121: 
 1122: 		    ONE LINE PER DEVICE, NOT PER OPCODE.  A per-opcode set was
 1123: 		    proposed and is FILED, not shipped: the scalar is what stops
 1124: 		    a guest cycling 0x00..0xff for 256 lines, which is the flood
 1125: 		    #464 exists to bound.  Row `unimpl 2op` pins the
 1126: 		    per-device spec by firing TWO different opcodes and
 1127: 		    demanding ONE line -- which also kills a
 1128: 		    "last-warned-opcode" latch, under which an alternating guest
 1129: 		    would flood forever.  */
 1130: 		/*  #485: see the WDCC_SEC_* arm above for the invariant and the
 1131: 		    warrant.  This is the other terminal arm that never raised its
 1132: 		    completion interrupt.
 1133: 
 1134: 		    *** THE ASSERT IS OUTSIDE THE LATCH, AND THAT IS NOT A STYLE
 1135: 		    CHOICE. ***  Moved inside `if (!d->warned_unimpl_cmd)` below,
 1136: 		    only the FIRST unimplemented command per device would interrupt
 1137: 		    and every later one would go silent again.  It is what a tidying
 1138: 		    maintainer writes -- group the response with the warning -- and a
 1139: 		    sweep using one fresh device per opcode CANNOT SEE IT, because
 1140: 		    the latch is 0 on every leg.  Row `irq 2nd` exists for exactly
 1141: 		    that mutant.
 1142: 		
 1143: 		    *** THAT SENTENCE NAMED A ROW `irq 2nd` THAT DOES NOT EXIST.
 1144: 		    Repo-wide it occurred in this comment and nowhere else. ***  The
 1145: 		    real artifact is an unnamed SUB-LEG of row_completion_irq(),
 1146: 		    printing a `2nd` field inside a row named "a terminated command
 1147: 		    raises its irq".  What makes the error dangerous rather than
 1148: 		    untidy is the company it kept: the SAME sentence cites `abrt 2nd`,
 1149: 		    which IS a real row -- so a true citation stood next to a
 1150: 		    fabricated one and lent it credibility.
 1151: 		
 1152: 		    #464 already found the ABORT BIT wrongly inside
 1153: 		    this same guard and shipped `abrt 2nd` for it; the interrupt
 1154: 		    needed the same row.  */
 1155: 		d->error |= WDCE_ABRT;
 1156: 		d->int_assert = 1;
 1157: 		if (!d->warned_unimpl_cmd) {
 1158: 			d->warned_unimpl_cmd = 1;
 1159: 			fatal("[ wdc: WARNING! Unimplemented command 0x%02x "
 1160: 			    "(drive %i, head %i, cyl %i, sector %i, nsecs %i)"
 1161: 			    " ]\n", d->cur_command, d->drive, d->head,
 1162: 			    d->cyl_hi*256+d->cyl_lo, d->sector, d->seccnt);
 1163: 		}
 1164: 	}
 1165: }
 1166: 
 1167: 
 1168: DEVICE_ACCESS(wdc)
 1169: {
 1170: 	struct wdc_data *d = (struct wdc_data *) extra;
 1171: 	uint64_t idata = 0, odata = 0;
 1172: 	int i;
 1173: 
 1174: 	relative_addr /= d->addr_mult;
 1175: 
 1176: 	if (!d->io_enabled)
 1177: 		goto ret;
 1178: 
 1179: 	if (writeflag == MEM_WRITE) {
 1180: 		if (relative_addr == wd_data)
 1181: 			idata = memory_readmax64(cpu, data, len);
 1182: 		else {
 1183: 			/*  #464: latch the announcement; `idata = data[0]`
 1184: 			    is the repair and stays outside the guard.  */
 1185: 			if (len != 1 && !d->warned_nonbyte_write) {
 1186: 				d->warned_nonbyte_write = 1;
 1187: 				fatal("[ wdc: WARNING! non-8-bit access on "
 1188: 				    "WRITE! ]\n");
 1189: 			}
 1190: 			idata = data[0];
 1191: 		}
 1192: 	}
 1193: 
 1194: 	switch (relative_addr) {
 1195: 
 1196: 	case wd_data:	/*  0: data  */
 1197: 		if (writeflag == MEM_READ) {
 1198: 			odata = wdc_get_inbuf(d);
 1199: 
 1200: 			if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
 1201: 				if (len >= 2)
 1202: 					odata += (wdc_get_inbuf(d) << 8);
 1203: 				if (len == 4) {
 1204: 					odata += (wdc_get_inbuf(d) << 16);
 1205: 					odata += (wdc_get_inbuf(d) << 24);
 1206: 				}
 1207: 			} else {
 1208: 				if (len >= 2)
 1209: 					odata = (odata << 8) + wdc_get_inbuf(d);
 1210: 				if (len == 4) {
 1211: 					odata = (odata << 8) + wdc_get_inbuf(d);
 1212: 					odata = (odata << 8) + wdc_get_inbuf(d);
 1213: 				}
 1214: 			}
 1215: 
 1216: 			if (d->data_debug) {
 1217: 				const char *s = "0x%04" PRIx64" ]\n";
 1218: 				if (len == 1)
 1219: 					s = "0x%02" PRIx64" ]\n";
 1220: 				if (len == 4)
 1221: 					s = "0x%08" PRIx64" ]\n";
 1222: 				if (len == 8)
 1223: 					s = "0x%016" PRIx64" ]\n";
 1224: 				debug("[ wdc: read from DATA: ");
 1225: 				debug(s, (uint64_t) odata);
 1226: 			}
 1227: 
 1228: 			if (d->atapi_cmd_in_progress) {
 1229: 				/*  #341: account for what was actually CONSUMED
 1230: 				    from the buffer, not for what the guest
 1231: 				    asked for. The reads above take one byte,
 1232: 				    two if len >= 2, four only if len == 4 --
 1233: 				    so a 3- or 8-byte access consumes 2 (widths
 1234: 				    1..8 ATTEMPT 1, 2, 2, 4, 2, 2, 2, 2 pops --
 1235: 				    those are CALL counts, and the pops succeed
 1236: 				    only while bytes remain: wdc_get_inbuf()
 1237: 				    returns (uint64_t) -1 on an empty ring
 1238: 				    WITHOUT advancing the tail, so with q bytes
 1239: 				    queued a width-w access pops min(q, calls).
 1240: 				    "1 or 2" until 2026-09-05; the unqualified
 1241: 				    pop counts until 2026-09-06, when a pass-2
 1242: 				    seat read the helper instead of this
 1243: 				    comment.  NOTE `consumed' below is computed
 1244: 				    from `len' alone and so counts ATTEMPTS
 1245: 				    too -- row wdcconsumedattempts)
 1246: 				    while `len` says 3 or 8. Subtracting the
 1247: 				    requested length let atapi_len step PAST
 1248: 				    zero, which its `== 0` test then never
 1249: 				    catches, so PHASE_COMPLETED never fires and
 1250: 				    the guest is told a transfer is further
 1251: 				    along than the bytes it received. Same
 1252: 				    truthfulness defect as #283 in the ASC and
 1253: 				    #338 in the mb89352: the count reported has
 1254: 				    to be the count that happened.  */
 1255: 				int consumed = len == 4 ? 4 : (len >= 2 ? 2 : 1);
 1256: 				/*  #475: clamp to what REMAINS, not just to what was popped.
 1257: 				    #341 fixed `consumed` to count the POPS rather than the
 1258: 				    requested length; it did not stop the subtraction STEPPING
 1259: 				    PAST ZERO.  With an odd remainder -- and the length is a
 1260: 				    guest-chosen allocation byte -- a 4-byte read of an odd
 1261: 				    remainder drove atapi_len NEGATIVE, so `== 0` never fired
 1262: 				    again and the command never completed, while atapi_received
 1263: 				    claimed more bytes than the transfer holds.  Two distinct
 1264: 				    numbers, and conflating them is easy: the 3-byte fixture
 1265: 				    lands on -1; the worked INQUIRY-37 path lands on -3 (nine
 1266: 				    4-byte reads leave 1, the tenth takes 4).
 1267: 
 1268: 				    CLAMPING `consumed` RATHER THAN SATURATING atapi_len,
 1269: 				    because atapi_received has two live MID-TRANSFER consumers:
 1270: 				    the re-arm's length, and the refill's source offset
 1271: 				    data_in[atapi_received + j].  Saturating repairs completion
 1272: 				    and leaves those two reading a skewed offset, permanently
 1273: 				    skipping up to 3 real bytes -- #283's defect shape,
 1274: 				    re-created.
 1275: 
 1276: 				    A NEARBY PRECEDENT, cited narrowly on purpose: dev_asc.c
 1277: 				    clamps a step to a remainder before its move.  An earlier
 1278: 				    draft of this comment called that #283 and called it
 1279: 				    'exactly this shape'; a panel seat refuted both.  #283 tags
 1280: 				    the RESIDUAL REPORTING there (`programmed`/`moved`) -- its
 1281: 				    own comment says it snapshots the count 'before the clamps
 1282: 				    below rewrite len2', so the clamp is untagged upstream code.
 1283: 				    And the shapes differ: dev_asc clamps the TRANSFER before
 1284: 				    the move, while this clamps the ACCOUNTING and lets the pop
 1285: 				    happen at full width.  The in-tree precedent for clamping
 1286: 				    the transfer is a DIFFERENT option, which this round
 1287: 				    considered and did not take.
 1288: 
 1289: 				    The warrant that survives is the one above: the cursor.  */
 1290: 				if (consumed > d->atapi_len)
 1291: 					consumed = d->atapi_len;
 1292: 
 1293: 				d->atapi_len -= consumed;
 1294: 				d->atapi_received += consumed;
 1295: 				/*  #476: `atapi_st` IS DEREFERENCED ON THE NEXT LINE AND WAS NEVER
 1296: 				    NULL-CHECKED.  #475's clamp made this branch REACHABLE: before it, a
 1297: 				    read with atapi_len already 0 drove the counter NEGATIVE and `== 0`
 1298: 				    never fired again, so the deref was dead code.  Clamping consumed to
 1299: 				    0 leaves atapi_len AT 0, the test fires, and two guest register
 1300: 				    accesses from a fresh device -- write ATAPI_PKT_CMD to COMMAND, then
 1301: 				    read DATA -- reach `d->atapi_st->data_in_len` through NULL.
 1302: 
 1303: 				    MEASURED: SIGSEGV at address 0x48, which is
 1304: 				    offsetof(struct scsi_transfer, data_in_len).  The pre-#475 blob
 1305: 				    survives the identical input, and the row for the defect #475 FIXED
 1306: 				    goes the OTHER way on the same pair -- so the bisect is unambiguous.
 1307: 
 1308: 				    The clamp was right; the branch it woke was never NULL-safe.  Decline
 1309: 				    and say so once, per this file's latch idiom: a device that cannot
 1310: 				    service an access must not take the emulator with it (#337, #184,
 1311: 				    #186, #315, #316, #326).  */
 1312: 				if (d->atapi_len == 0 && d->atapi_st == NULL) {
 1313: 					if (!d->warned_null_xfer) {
 1314: 						d->warned_null_xfer = 1;
 1315: 						fatal("[ wdc: DATA read with no ATAPI "
 1316: 						    "transfer armed (once) ]\n");
 1317: 					}
 1318: 				} else if (d->atapi_len == 0 &&
 1319: 				    d->atapi_phase != PHASE_CMDOUT) {
 1320: 					/*  #477: A STRAY DATA-PORT READ MUST NOT REWRITE THE PHASE WHILE A
 1321: 					    CDB IS BEING COLLECTED.  Measured by the Fable seat as a
 1322: 					    REGRESSION of the dispatch phase guard below: HEAD services
 1323: 					    `PKT, stray read, CDB` after a prior completed command, and
 1324: 					    without this arm's phase test the CDB never dispatches at all.
 1325: 
 1326: 					    The ATAPI_PKT_CMD arm of wdc_command() assigns only the flag and
 1327: 					    the phase, so a new packet starts with atapi_len == 0,
 1328: 					    atapi_received == data_in_len and atapi_st STALE NON-NULL (it is
 1329: 					    freed at the next dispatch and never NULLed).  A read then falls
 1330: 					    here, finds `received < data_in_len` false, and sets
 1331: 					    PHASE_COMPLETED -- moving the phase off CMDOUT before the CDB is
 1332: 					    complete.
 1333: 
 1334: 					    *** AND THE RESIDUE THAT MAKES IT UNRECOVERABLE IS A PROPERTY OF
 1335: 					    THE DEVICE, NOT OF THIS REGRESSION -- an earlier draft of this
 1336: 					    comment said otherwise, and the Opus seat MEASURED the
 1337: 					    difference. ***
 1338: 
 1339: 					    *** THE NEXT SENTENCE WAS TRUE WHEN WRITTEN AND IS FALSE AT
 1340: 					    HEAD.  Corrected 2026-08-30. ***  It read: `ATAPI_PKT_CMD
 1341: 					    never flushes the ring, and neither reset path does either,
 1342: 					    so an under-drained DATA-IN leaves occupancy at 32 -> 44 ->
 1343: 					    56 -> 68 and every later CDB is dropped forever.  That
 1344: 					    entrance is open`.  It is not open: wdc_new_command_reset()
 1345: 					    zeroes inbuf_head and inbuf_tail and runs at the TOP of
 1346: 					    wdc_command(), BEFORE the ATAPI_PKT_CMD case -- so every
 1347: 					    command flushes, and `wdcringnoflush` is CLOSED on exactly
 1348: 					    that.  The residue described above is still a property of
 1349: 					    the device; what changed is that it cannot survive into the
 1350: 					    NEXT command.  dev_asc.c's
 1351: 					    dev_asc_fifo_flush() is the in-tree idiom for closing it.
 1352: 
 1353: 					    In CMDOUT the atapi_len/atapi_received pair describes the
 1354: 					    PREVIOUS transfer, so no completion state may be derived from it
 1355: 					    -- the same statement the dispatch guard below makes about the
 1356: 					    flag, applied to the read arm.  Falling through BOTH arms is the
 1357: 					    correct disposition: the read pops the ring and changes no
 1358: 					    transfer state.  */
 1359: 					if (d->atapi_received < d->atapi_st->
 1360: 					    data_in_len) {
 1361: 						d->atapi_phase = PHASE_DATAIN;
 1362: 						/*  #473: clamp to the chunk size, NOT zero, and REFILL.  This
 1363: 						    assigned 0 where the initial arm clamps to 32768 in the same
 1364: 						    condition, so a transfer with >32768 left reported ZERO
 1365: 						    remaining -- with no recovery, since the next read decrements
 1366: 						    from 0 and `== 0` never fires again.  MEASURED band
 1367: 						    [65537, 262655]; the guest saw bytecount 0 with DRQ asserted.
 1368: 
 1369: 						    The refill is what makes the bounded push above correct: here
 1370: 						    atapi_len is 0, so the guest drained the previous chunk; data_in
 1371: 						    is still live, being freed only when the next command arrives.
 1372: 
 1373: 						    #473 L4: an earlier version of this comment said the ring is
 1374: 						    EMPTY here.  That is an overclaim and a panel seat broke it.
 1375: 						    atapi_len counts only what the DATAIN arms pushed, and the
 1376: 						    data-port WRITE arm above pushes guest bytes with no phase
 1377: 						    guard and no capacity check -- its unexpected-write latch is
 1378: 						    suppressed precisely because atapi_cmd_in_progress is set.  A
 1379: 						    guest that WRITES to the data port mid-DATAIN therefore grows
 1380: 						    head without touching atapi_len, and those bytes are still
 1381: 						    queued when the refill runs.
 1382: 
 1383: 						    What IS true: the ring is empty for any guest that only READS
 1384: 						    during DATAIN, which is every driver in this tree.  An
 1385: 						    adversarial interleaved write DESYNCHRONISES that guest's own
 1386: 						MEASURED by a panel seat: one 2-byte store placed so the
 1387: 						ring still holds the tail of chunk 1 makes all 32768 bytes of
 1388: 						chunk 2 wrong on this build.
 1389: 
 1390: 						*** AN EARLIER DRAFT CALLED THAT A REGRESSION.  A SECOND SEAT
 1391: 						MEASURED IT FALSE. ***  It rested on 'and ZERO wrong pre-fix',
 1392: 						which is a 0 OF 0 -- the denominator trap.  Pre-#473 there is
 1393: 						no refill loop at all, so chunk 2 is NEVER DELIVERED and the
 1394: 						wrongness was counted over the empty set.  Measured honestly,
 1395: 						the pre-fix build delivers 0 of 32768 bytes of chunk 2 and
 1396: 						returns the over-read sentinel forever.
 1397: 
 1398: 						A regression needs a case that WORKED before and does not now,
 1399: 						and there is none: the fix strictly improves the no-write case
 1400: 						(0 wrong against 32640) and moves the adversarial case from
 1401: 						DEAD to SHIFTED.  The honest word is a shifted failure mode,
 1402: 						not a regression.
 1403: 
 1404: 						    The arithmetic here was stated BACKWARDS in the first draft of
 1405: 						    this comment: the refill route takes 229889 injected bytes and
 1406: 						    the direct write route 262657, so the refill route is cheaper
 1407: 						    by 32768 -- FEWER, not more.  The conclusion survives because
 1408: 						    both routes are unbounded and a guest with either has the
 1409: 						    other; the stated reason was false, and a wrong reason gets
 1410: 						    reused.
 1411: 
 1412: 						    TWO QUALIFICATIONS, both from a later seat, both narrowing
 1413: 						    claims that were too absolute.  262657 is the EMPTY-RING
 1414: 						    direct threshold -- with a chunk already queued the direct
 1415: 						    route also overwrites after 229889, so these are thresholds
 1416: 						    under stated starting states, not intrinsic costs.  And
 1417: 						    'only that guest's own transfer' overclaims: the same shared
 1418: 						    ring feeds the CDB-dispatch and disk-image-drain paths.  The
 1419: 						    defensible form is that this adds no DEMONSTRATED
 1420: 						    host-memory-safety primitive, and the measured case corrupts
 1421: 						    returned transfer data.  Tracked as
 1422: 						    `wdcaddtoinbufbound`, which names that write path as the live
 1423: 						    unbounded route.  */
 1424: 						d->atapi_len = d->atapi_st->
 1425: 						    data_in_len -
 1426: 						    d->atapi_received;
 1427: 						if (d->atapi_len > 32768)
 1428: 							d->atapi_len = 32768;
 1429: 
 1430: 						/*  WHY THIS DEREFERENCE IS NOT NULL-CHECKED, and the dispatch
 1431: 						    refill below IS.  The asymmetry is real and the safety here
 1432: 						    rests on an invariant that lives in ANOTHER FILE, which is
 1433: 						    the reason it is written down rather than left to be
 1434: 						    re-derived:
 1435: 
 1436: 						      a LIVE scsi_transfer with data_in_len > 0 always has
 1437: 						      data_in != NULL.
 1438: 
 1439: 						    scsi_transfer_alloc() memsets the whole struct, so a fresh
 1440: 						    transfer is (NULL, 0).  scsi_transfer_allocbuf() either
 1441: 						    installs a buffer or exit()s -- it never returns having set a
 1442: 						    length without one.  The three later length mutations in the
 1443: 						    tree (MODE_SENSE, READ_TOC, and dev_asc's consumed-prefix
 1444: 						    subtraction) only SHRINK or preserve a live allocation.
 1445: 
 1446: 						    *** IT IS A FUNCTION-BOUNDARY INVARIANT, NOT A CONTINUOUS
 1447: 						    ONE, and an earlier draft of this note said the two fields
 1448: 						    are set together.  They are not: allocbuf writes the LENGTH
 1449: 						    first and the POINTER fourteen lines later, with a malloc
 1450: 						    between them.  Nothing observes that window -- no callback
 1451: 						    and no return to this device runs inside it -- but the
 1452: 						    distinction is the whole reason this is a comment and not a
 1453: 						    proof. ***
 1454: 
 1455: 						    NOT a guard: the ADDITION LICENCE wants a measured delta or a
 1456: 						    transferred warrant, and the state is not producible today.
 1457: 						    What was missing is a REASON an edit elsewhere can break,
 1458: 						    rather than a check that would silently never fire.  Filed
 1459: 						    as `wdcdatainnull`.  */
 1460: 						for (int j=0; j<d->atapi_len; j++)
 1461: 							wdc_addtoinbuf(d, d->atapi_st->
 1462: 								data_in[d->atapi_received + j]);
 1463: 					} else
 1464: 						d->atapi_phase =
 1465: 						    PHASE_COMPLETED;
 1466: 					d->int_assert = 1;
 1467: 				}
 1468: 			} else {
 1469: #if 0
 1470: 				if (d->inbuf_tail != d->inbuf_head)
 1471: #else
 1472: 				if (d->inbuf_tail != d->inbuf_head &&
 1473: 				    ((d->inbuf_tail - d->inbuf_head) % 512)
 1474: 				    == 0)
 1475: #endif
 1476: 					d->int_assert = 1;
 1477: 			}
 1478: 		} else {
 1479: 			int inbuf_len;
 1480: 			/*  #478: PER-ACCESS, and a struct field here is a REGRESSION.
 1481: 			    MEASURED: a latched field silences every later legal write,
 1482: 			    turning a corruption defect into silent data loss, which is
 1483: 			    worse.  The question is 'did THIS access push nothing', so the
 1484: 			    answer must not outlive the access.  */
 1485: 			int badlen_this = 0;
 1486: 			if (d->data_debug) {
 1487: 				const char *s = "0x%04" PRIx64" ]\n";
 1488: 				if (len == 1)
 1489: 					s = "0x%02" PRIx64" ]\n";
 1490: 				if (len == 4)
 1491: 					s = "0x%08" PRIx64" ]\n";
 1492: 				if (len == 8)
 1493: 					s = "0x%016" PRIx64" ]\n";
 1494: 				debug("[ wdc: write to DATA: ");
 1495: 				debug(s, (uint64_t) idata);
 1496: 			}
 1497: 			/*  #464: latched.  */
 1498: 			if (!d->write_in_progress &&
 1499: 			    !d->atapi_cmd_in_progress &&
 1500: 			    !d->warned_data_unexpected) {
 1501: 				d->warned_data_unexpected = 1;
 1502: 				fatal("[ wdc: write to DATA, but not "
 1503: 				    "expecting any? (len=%i): 0x%08lx ]\n",
 1504: 				    (int)len, (long)idata);
 1505: 			}
 1506: 
 1507: 			/*  #495: A HOST STORE TO THE DATA PORT DURING A DATA-IN
 1508: 			    TRANSFER IS OUT OF PROTOCOL, AND UNTIL NOW IT WAS PUSHED
 1509: 			    INTO THE RING ANYWAY.
 1510: 
 1511: 			    Real ATAPI hardware never accepts host data-register
 1512: 			    stores while the direction is device-to-host.  This model
 1513: 			    accepted them, and the injected bytes grew inbuf_head
 1514: 			    WITHOUT growing atapi_len -- which counts only what the
 1515: 			    DATA-IN arms pushed.  They then sat ahead of the next
 1516: 			    chunk, and the re-arm refilled on top of them, so the
 1517: 			    guest's whole next chunk arrived shifted.
 1518: 
 1519: 			    Measured at rung 3 on unmodified evbmips -e malta, 20 of
 1520: 			    20 across both legs: one 2-byte store placed while the
 1521: 			    tail of chunk 1 is still in the ring makes the guest read
 1522: 			    back ITS OWN INJECTED BYTES as disk data.  The witness is
 1523: 			    at regress/artifacts/wdcaddtoinbufbound/rung3_20260830/.
 1524: 
 1525: 			    AND IT WAS SILENT.  The one diagnostic that could have
 1526: 			    announced a stray write requires !atapi_cmd_in_progress,
 1527: 			    and that flag is 1 for the whole of DATA-IN -- so the
 1528: 			    single guard that might have caught this was disabled
 1529: 			    exactly when it was needed.
 1530: 
 1531: 			    THE TEST IS THE PHASE, NOT THE FLAG, AND THE DIFFERENCE
 1532: 			    IS NOT COSMETIC.  #477 measured that guarding these
 1533: 			    pushes could CREATE a use-after-free: a suppressed push
 1534: 			    leaves occupancy at 12 and the CDB dispatch fires anyway.
 1535: 			    That hazard lives at occupancy 12, which is CMDOUT -- so
 1536: 			    a guard keyed on the PHASE never suppresses there and
 1537: 			    cannot reach it.  A guard keyed on the FLAG alone matches
 1538: 			    CDB collection too and re-arms #477's objection in full.
 1539: 
 1540: 			    THIS GUARD IS NOT SELF-CONTAINED, and that is recorded
 1541: 			    rather than left for someone to rediscover: it is safe
 1542: 			    only because #477's READ-arm phase test stops a stray
 1543: 			    read moving atapi_phase off CMDOUT mid-CDB.  Remove that
 1544: 			    and this starts refusing legitimate CDB bytes.
 1545: 
 1546: 			    ONLY THE PUSH IS REFUSED.  The access stays HANDLED and
 1547: 			    falls through to the common tail, which returns 1.  A 0
 1548: 			    would not reach unassigned-address handling -- this
 1549: 			    device is registered -- it would raise EXCEPTION_DBE and
 1550: 			    leave the guest re-executing the faulting store forever,
 1551: 			    silently at default verbosity.  Measured last round at
 1552: 			    19793 device-failed diagnostics and zero non-existant
 1553: 			    ones.  Worse than a flood, not better.
 1554: 
 1555: 			    The shipped 128-row offline detector scores ZERO failures
 1556: 			    with this defect live, so it cannot see it at all; the
 1557: 			    rung-3 witness ships as the detector for that reason.
 1558: 
 1559: 			    A FORWARD HAZARD, NAMED BECAUSE IT IS INERT TODAY AND WILL
 1560: 			    NOT BE.  `!= PHASE_CMDOUT` also covers PHASE_DATAOUT, the
 1561: 			    phase in which a guest legitimately drives host-to-device
 1562: 			    bytes.  That is harmless right now because DATAOUT IS
 1563: 			    UNIMPLEMENTED: the constant is assigned at exactly one site,
 1564: 			    which latches warned_atapi_dataout and prints `ATAPI DATA
 1565: 			    OUT phase not implemented`, and it is read nowhere else.  So
 1566: 			    this refuses bytes nothing would have consumed.
 1567: 
 1568: 			    Whoever implements DATAOUT must widen this predicate, and
 1569: 			    the round's own witness will stay GREEN while they do not,
 1570: 			    because it walks only DATA-IN.  The guard is deliberately
 1571: 			    NOT widened today: a `&& phase != PHASE_DATAOUT` term no row
 1572: 			    exercises and no measurement covers is the addition
 1573: 			    licence's `it cannot hurt`, which is how dead guards
 1574: 			    accrete.  Found by a packet-fed seat on pass 2, from the
 1575: 			    inlined diff alone.  */
 1576: 			if (d->atapi_cmd_in_progress &&
 1577: 			    d->atapi_phase != PHASE_CMDOUT) {
 1578: 				/*  out of protocol: refuse the push  */
 1579: 			} else if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
 1580: 				switch (len) {
 1581: 				case 4:	wdc_addtoinbuf(d, idata & 0xff);
 1582: 					wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1583: 					wdc_addtoinbuf(d, (idata >> 16) & 0xff);
 1584: 					wdc_addtoinbuf(d, (idata >> 24) & 0xff);
 1585: 					break;
 1586: 				case 2:	wdc_addtoinbuf(d, idata & 0xff);
 1587: 					wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1588: 					break;
 1589: 				case 1:	wdc_addtoinbuf(d, idata); break;
 1590: 				/*  #337: a 3- or 8-byte access to the data
 1591: 				    port used to call exit(1) -- a GUEST
 1592: 				    choosing an access width killed the host
 1593: 				    process. Same halt class as #184/#186/
 1594: 				    #187/#315/#316/#326. Drop the access and
 1595: 				    say so once; a device that cannot honour
 1596: 				    a transfer must not take the emulator
 1597: 				    with it. (Unreachable from SH-4, which
 1598: 				    has no 3- or 8-byte access, but reachable
 1599: 				    from a 64-bit MIPS machine carrying wdc
 1600: 				    over bus_isa/bus_pci.)  */
 1601: 				default:/*  #478: `break` leaves the WIDTH SWITCH, not the
 1602: 				            handler -- execution falls through to the
 1603: 				            occupancy drain below with NOTHING pushed.  */
 1604: 				        badlen_this = 1;
 1605: 				        if (!d->warned_badlen) {
 1606: 						d->warned_badlen = 1;
 1607: 						fatal("wdc: unimplemented "
 1608: 						    "write len %i (ignored)\n",
 1609: 						    len);
 1610: 					}
 1611: 					break;
 1612: 				}
 1613: 			} else {
 1614: 				switch (len) {
 1615: 				case 4:	wdc_addtoinbuf(d, (idata >> 24) & 0xff);
 1616: 					wdc_addtoinbuf(d, (idata >> 16) & 0xff);
 1617: 					wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1618: 					wdc_addtoinbuf(d, idata & 0xff);
 1619: 					break;
 1620: 				case 2:	wdc_addtoinbuf(d, (idata >> 8) & 0xff);
 1621: 					wdc_addtoinbuf(d, idata & 0xff);
 1622: 					break;
 1623: 				case 1:	wdc_addtoinbuf(d, idata); break;
 1624: 				/*  #337: a 3- or 8-byte access to the data
 1625: 				    port used to call exit(1) -- a GUEST
 1626: 				    choosing an access width killed the host
 1627: 				    process. Same halt class as #184/#186/
 1628: 				    #187/#315/#316/#326. Drop the access and
 1629: 				    say so once; a device that cannot honour
 1630: 				    a transfer must not take the emulator
 1631: 				    with it. (Unreachable from SH-4, which
 1632: 				    has no 3- or 8-byte access, but reachable
 1633: 				    from a 64-bit MIPS machine carrying wdc
 1634: 				    over bus_isa/bus_pci.)  */
 1635: 				default:/*  #478: `break` leaves the WIDTH SWITCH, not the
 1636: 				            handler -- execution falls through to the
 1637: 				            occupancy drain below with NOTHING pushed.  */
 1638: 				        badlen_this = 1;
 1639: 				        if (!d->warned_badlen) {
 1640: 						d->warned_badlen = 1;
 1641: 						fatal("wdc: unimplemented "
 1642: 						    "write len %i (ignored)\n",
 1643: 						    len);
 1644: 					}
 1645: 					break;
 1646: 				}
 1647: 			}
 1648: 
 1649: 			inbuf_len = d->inbuf_head - d->inbuf_tail;
 1650: 			while (inbuf_len < 0)
 1651: 				inbuf_len += WDC_INBUF_SIZE;
 1652: 
 1653: 			/*  #477: THE DISPATCH KEYS ON THE PHASE IN ADDITION TO THE FLAG.
 1654: 
 1655: 			    *** THIS HEADLINE READ "ON THE PHASE, NOT ON THE FLAG" UNTIL
 1656: 			    2026-08-27, AND THAT WORDING WAS UNSAFE.  The codex seat reasoned
 1657: 			    on #477's pass 2 that deleting the flag conjunct would sweep the
 1658: 			    detector; MEASURED, it swept all 52 rows clean. ***
 1659: 
 1660: 			    BOTH CONJUNCTS ARE LOAD-BEARING, and the reason is a STALE PHASE.
 1661: 			    `wdc_command(ATAPI_PKT_CMD)` sets PHASE_CMDOUT; a following
 1662: 			    `wdc_command(WDCC_WRITE)` clears the flag at the top of that
 1663: 			    function and arms the write -- and NOTHING RESETS THE PHASE.  The
 1664: 			    device then sits in exactly the state a phase-only guard cannot
 1665: 			    tell from a real CDB collection.
 1666: 
 1667: 			    Under a phase-only guard the guest's own sector payload reaches
 1668: 			    occupancy 12 and is issued as a SCSI command.  MEASURED, and worse
 1669: 			    than the seat predicted: the sector does not merely lose twelve
 1670: 			    bytes, it NEVER REACHES THE DISK -- `0 w, 0 b` against a wanted
 1671: 			    one write of 512.  `row_stale_phase_write` pins both halves.
 1672: 
 1673: 			    The stale phase is itself a defect; it is filed with
 1674: 			    `wdcwipclear` / `wdcringnoflush` -- a new command does not reset
 1675: 			    what the old one left.
 1676: 
 1677: 			    `atapi_cmd_in_progress` is set when a packet command arrives and
 1678: 			    cleared only when the NEXT command does -- so it stays 1 through the
 1679: 			    whole of DATAIN and past PHASE_COMPLETED.  It conflates two roles: 'a
 1680: 			    packet command is active' (read at four register sites through
 1681: 			    completion, and must stay set) and 'I am collecting a 12-byte CDB'
 1682: 			    (what this test actually wants).
 1683: 
 1684: 			    So a guest write during DATAIN that brought ring occupancy to exactly
 1685: 			    12 re-entered this block, FREED THE LIVE TRANSFER, and issued a SCSI
 1686: 			    command built from the guest's own returned DATA-IN payload.  MEASURED:
 1687: 			    `freed 1 live transfer(s)`.
 1688: 
 1689: 			    NOT guarding the data-port write instead, and two measuring seats
 1690: 			    agree: this check runs on EVERY data-port write regardless of what the
 1691: 			    write did -- the width switch's `default:` arm (len 3 or 8) pushes
 1692: 			    ZERO bytes and falls straight through to here.  Guarding the pushes
 1693: 			    was MEASURED WORSE THAN NO FIX: with occupancy already 12 the
 1694: 			    suppressed push leaves it at 12, so the guard CREATES a free on an
 1695: 			    input the unfixed code survives.
 1696: 
 1697: 			    Nor clearing the flag at completion: that leaves this window untouched
 1698: 			    (the flag is legitimately 1 here) and breaks the ATAPI handshake --
 1699: 			    ireason and the byte-count pair are read at PHASE_COMPLETED.  */
 1700: 			/*  #479: A REJECTED WIDTH MUST NOT DISPATCH EITHER.
 1701: 
 1702: 			    `#478` added `badlen_this` and guarded the sector DRAIN with
 1703: 			    it, and recorded that this finally made `#337`'s `(ignored)`
 1704: 			    message true.  It did not.  Two seats found it independently
 1705: 			    on `#478`'s pass 2 -- one by reading, one by measuring a
 1706: 			    3-byte store allocate an `atapi_st` -- and the row
 1707: 			    `a rejected width issues no command` reds without this.
 1708: 
 1709: 			    This dispatch runs on EVERY data-port write regardless of
 1710: 			    what the write did, so an access of an unimplemented width
 1711: 			    -- which pushes nothing and is announced as ignored -- still
 1712: 			    issued a 12-byte SCSI command whenever occupancy already
 1713: 			    stood at 12.  A rejected access with a side effect is worse
 1714: 			    than either accepting or refusing it cleanly, because the
 1715: 			    diagnostic says the opposite of what happened.  */
 1716: 			if (d->atapi_cmd_in_progress && !badlen_this &&
 1717: 			    d->atapi_phase == PHASE_CMDOUT && inbuf_len == 12) {
 1718: 				unsigned char *scsi_cmd;
 1719: 				int x = 0, res;
 1720: 
 1721: 				/*  #477: THE `inbuf_len == 12` IN THE GUARD ABOVE IS WHAT BOUNDS THE
 1722: 			    COPY BELOW.  `x` is not checked against 12, so the equality is not
 1723: 			    only selecting the dispatch -- it is the only thing keeping this
 1724: 			    12-byte allocation from overflowing with guest bytes.  A pass-2
 1725: 			    mutant relaxing it to `>= 12` was MEASURED under ASAN as a
 1726: 			    heap-buffer-overflow WRITE here, while the 44-row detector stayed
 1727: 			    green -- and this round's own kill table had first classified that
 1728: 			    edit as an IMPROVEMENT.  Four readers reasoned about the guard as a
 1729: 			    dispatch selector and none opened these nine lines.  Do not widen
 1730: 			    the equality; flush the ring instead (`wdcringnoflush`).  */
 1731: 				CHECK_ALLOCATION(scsi_cmd = (unsigned char *) malloc(12));
 1732: 
 1733: 				if (d->atapi_st != NULL)
 1734: 					scsi_transfer_free(d->atapi_st);
 1735: 				d->atapi_st = scsi_transfer_alloc();
 1736: 
 1737: 				debug("[ wdc: ATAPI command ]\n");
 1738: 
 1739: 				while (inbuf_len > 0) {
 1740: 					scsi_cmd[x++] = wdc_get_inbuf(d);
 1741: 					inbuf_len --;
 1742: 				}
 1743: 
 1744: 				d->atapi_st->cmd = scsi_cmd;
 1745: 				d->atapi_st->cmd_len = 12;
 1746: 
 1747: 				if (scsi_cmd[0] == SCSIBLOCKCMD_READ_CAPACITY
 1748: 				    || scsi_cmd[0] == SCSICMD_READ_10
 1749: 				    || scsi_cmd[0] == SCSICMD_MODE_SENSE10)
 1750: 					d->atapi_st->cmd_len = 10;
 1751: 
 1752: 				res = diskimage_scsicommand(cpu,
 1753: 				    d->drive + d->base_drive, DISKIMAGE_IDE,
 1754: 				    d->atapi_st);
 1755: 
 1756: 				/*  #337: an ATAPI command the SCSI layer
 1757: 				    rejected used to exit(1). Any guest that
 1758: 				    issues an unsupported or malformed packet
 1759: 				    command could therefore kill the host.
 1760: 				    Complete the command instead: the phase
 1761: 				    goes to COMPLETED with no data, and the
 1762: 				    interrupt below still fires, which is how
 1763: 				    a real drive reports a failed packet
 1764: 				    command to its driver.  */
 1765: 				if (res == 0) {
 1766: 					if (!d->warned_atapi_err) {
 1767: 						d->warned_atapi_err = 1;
 1768: 						fatal("wdc: ATAPI command "
 1769: 						    "rejected; completing "
 1770: 						    "with no data\n");
 1771: 					}
 1772: 					d->atapi_len = 0;
 1773: 					d->atapi_received = 0;
 1774: 					d->atapi_phase = PHASE_COMPLETED;
 1775: 					d->int_assert = 1;
 1776: 					break;
 1777: 				}
 1778: 
 1779: 				d->atapi_len = 0;
 1780: 				d->atapi_received = 0;
 1781: 
 1782: 				if (res == 1) {
 1783: 					if (d->atapi_st->data_in != NULL) {
 1784: 						d->atapi_phase = PHASE_DATAIN;
 1785: 						/*  #473: CLAMP BEFORE THE PUSH.  This loop was unbounded and the
 1786: 						    clamp sat AFTER it, so a transfer larger than the ring was pushed
 1787: 						    whole: WDC_INBUF_SIZE is exactly 513 blocks, and block 514 wrapped
 1788: 						    onto unread data.  MEASURED: a 514-block transfer returned block
 1789: 						    513's bytes where block 0's should be, and the latch fired one
 1790: 						    store EARLIER than the corruption, because head==tail cannot tell
 1791: 						    full from empty.  The clamp is not new -- it was on the wrong side
 1792: 						    of the loop.  */
 1793: 						d->atapi_len = d->atapi_st->data_in_len;
 1794: 						if (d->atapi_len > 32768)
 1795: 							d->atapi_len = 32768;
 1796: 
 1797: 						for (int j=0; j<d->atapi_len; j++)
 1798: 							wdc_addtoinbuf(d, d->atapi_st->data_in[j]);
 1799: 					} else {
 1800: 						d->atapi_phase =
 1801: 						    PHASE_COMPLETED;
 1802: 					}
 1803: 				} else {
 1804: 					/*  #337: this arm ALREADY set the
 1805: 					    right phase and then called
 1806: 					    exit(1) anyway, so removing the
 1807: 					    abort is the whole fix -- any
 1808: 					    ATAPI command wanting a DATA OUT
 1809: 					    phase (MODE SELECT, for one) took
 1810: 					    the host down. The transfer
 1811: 					    itself is still unimplemented,
 1812: 					    which is what the warning says.  */
 1813: 					if (!d->warned_atapi_dataout) {
 1814: 						d->warned_atapi_dataout = 1;
 1815: 						fatal("wdc: ATAPI DATA OUT "
 1816: 						    "phase not implemented\n");
 1817: 					}
 1818: 					d->atapi_phase = PHASE_DATAOUT;
 1819: 				}
 1820: 
 1821: 				d->int_assert = 1;
 1822: 			}
 1823: 
 1824: 			/*  #478: AN EMPTY RING MUST NOT BE READ AS A FULL SECTOR.
 1825: 
 1826: 			    `inbuf_len == 0` satisfies `0 % 512 == 0`, so this block fired
 1827: 			    with NOTHING queued and handed diskimage_access 512 bytes of
 1828: 			    whatever the ring held, at the guest's chosen LBA.  MEASURED:
 1829: 			    `1 write(s), 512 bytes to 0x8000, first=0xdd` -- the poison, so
 1830: 			    the bytes written were ones the guest never supplied.
 1831: 
 1832: 			    BOTH conditions are load-bearing and each closes a door the
 1833: 			    other leaves open -- measured, not argued:
 1834: 
 1835: 			      `inbuf_len > 0`   closes the empty ring, and the WRITE+PKT
 1836: 			                        door where a CDB dispatch has already
 1837: 			                        consumed the LOCAL inbuf_len to a stale 0
 1838: 			                        while pushing fresh DATA-IN into the ring.
 1839: 			      `!badlen_this`    closes the LEFTOVER door: an unread payload
 1840: 			                        leaves occupancy at 512, so `512 > 0` passes
 1841: 			                        and the guest's own returned data is written
 1842: 			                        to the image.  MEASURED first=0xbe.
 1843: 
 1844: 			    The drain is guarded rather than the `default:` arm because the
 1845: 			    WRITE+PKT door involves no bad-len access at all.  */
 1846: 			if (inbuf_len > 0 && !badlen_this &&
 1847: 			    (( d->write_in_progress == WDCC_WRITEMULTI &&
 1848: 			    inbuf_len % (512 * d->write_count) == 0)
 1849: 			    ||
 1850: 			    ( d->write_in_progress == WDCC_WRITE &&
 1851: 			    inbuf_len % 512 == 0)) ) {
 1852: 				int count = (d->write_in_progress ==
 1853: 				    WDCC_WRITEMULTI)? d->write_count : 1;
 1854: 				unsigned char *buf, *b;
 1855: 
 1856: 				CHECK_ALLOCATION(buf = (unsigned char *) malloc(512 * count));
 1857: 				b = buf;
 1858: 
 1859: 				if (d->inbuf_tail+512*count <= WDC_INBUF_SIZE) {
 1860: 					b = d->inbuf + d->inbuf_tail;
 1861: 					d->inbuf_tail = (d->inbuf_tail + 512
 1862: 					    * count) % WDC_INBUF_SIZE;
 1863: 				} else {
 1864: 					for (i=0; i<512 * count; i++)
 1865: 						buf[i] = wdc_get_inbuf(d);
 1866: 				}
 1867: 
 1868: 				diskimage_access(cpu->machine,
 1869: 				    d->drive + d->base_drive, DISKIMAGE_IDE, 1, 1874:  1883: 			    ||
 1884: 			    ( d->write_in_progress == WDCC_WRITE &&
 1885: 			    inbuf_len % 512 == 0)) && !d->warned_empty_drain) {
 1886: 				/*  #478: DECLINE AND ANNOUNCE, per this tree's own #264
 1887: 				    precedent -- dev_asc.c refuses a zero-length DATA_OUT
 1888: 				    and SAYS SO rather than proceeding silently.
 1889: 
 1890: 				    The condition is the DIFFERENCE between this fix and the
 1891: 				    code it replaces, not the negation of the guard: the old
 1892: 				    code drained on the modulus alone, so this fires exactly
 1893: 				    where a spurious sector USED to reach the disk image.
 1894: 				    Announcing on every non-draining write would fire on all
 1895: 				    255 partial stores of an ordinary sector.
 1896: 
 1897: 				    Without this the guest had NO notice at all: no error
 1898: 				    bit, the handler returns 1, and the interrupt is still
 1899: 				    asserted -- a write silently vanishing.  N=1 per device
 1900: 				    instance with `(once)`, the tree's plurality marker.
 1901: 
 1902: 				    fatal() and not debugmsg(): under -q the verbosity
 1903: 				    settles at VERBOSITY_ERROR, so a WARNING would be
 1904: 				    invisible to the boot-log hygiene grep and an ERROR
 1905: 				    would trip #261's break-on-ERROR.  */
 1906: 				d->warned_empty_drain = 1;
 1907: 				/*  *** THE TEXT SAID "no sector buffered; write dropped" AND BOTH HALVES
 1908: 				    COULD BE FALSE.  Measured by the Opus seat on #478 pass 2,
 1909: 				    end-to-end through the registers, no struct poking. ***
 1910: 
 1911: 				    `inbuf_len == 0` is reached by TWO routes: an empty ring, and a
 1912: 				    STALE LOCAL after a CDB dispatch has consumed it.  On the second
 1913: 				    the guest's bytes were USED, not dropped.  On the leftover door a
 1914: 				    whole 512-byte sector sits in the ring while the message claims
 1915: 				    none is buffered.
 1916: 
 1917: 				    THE HARM WAS NOT THE FALSE SENTENCE.  A spurious emission BURNS
 1918: 				    THE N=1 LATCH, so a later GENUINE drop is announced to nobody --
 1919: 				    this announce could defeat itself, which is exactly the state the
 1920: 				    decline-and-announce ruling exists to prevent.
 1921: 
 1922: 				    The CONDITION is kept: it fires where the unfixed code would have
 1923: 				    put a spurious sector on the disk image, which is worth saying
 1924: 				    however the ring reached that state.  The TEXT now describes what
 1925: 				    happened -- a drain was refused -- instead of asserting a buffer
 1926: 				    state it never checked.  */
 1927: 				fatal("[ wdc: refused a sector drain the buffer "
 1928: 					"cannot justify (once) ]\n");
 1929: 			}
 1930: 		}
 1931: 		break;
 1932: 
 1933: 	case wd_error:	/*  1: error (r), precomp (w)  */
 1934: 		if (writeflag == MEM_READ) {
 1935: 			odata = d->error;
 1936: 			debug("[ wdc: read from ERROR: 0x%02x ]\n", (int)odata);
 1937: 		} else {
 1938: 			d->precomp = idata;
 1939: 			debug("[ wdc: write to PRECOMP: 0x%02x ]\n",(int)idata);
 1940: 		}
 1941: 		break;
 1942: 
 1943: 	case wd_seccnt:	/*  2: sector count (or "ireason" for ATAPI)  */
 1944: 		if (writeflag == MEM_READ) {
 1945: 			odata = d->seccnt;
 1946: 			if (d->atapi_cmd_in_progress) {
 1947: 				odata = d->atapi_phase & (WDCI_CMD | WDCI_IN);
 1948: 			}
 1949: 			debug("[ wdc: read from SECCNT: 0x%02x ]\n",(int)odata);
 1950: 		} else {
 1951: 			d->seccnt = idata;
 1952: 			debug("[ wdc: write to SECCNT: 0x%02x ]\n", (int)idata);
 1953: 		}
 1954: 		break;
 1955: 
 1956: 	case wd_sector:	/*  3: first sector  */
 1957: 		if (writeflag == MEM_READ) {
 1958: 			odata = d->sector;
 1959: 			debug("[ wdc: read from SECTOR: 0x%02x ]\n",(int)odata);
 1960: 		} else {
 1961: 			d->sector = idata;
 1962: 			debug("[ wdc: write to SECTOR: 0x%02x ]\n", (int)idata);
 1963: 		}
 1964: 		break;
 1965: 
 1966: 	case wd_cyl_lo:	/*  4: cylinder low  */
 1967: 		if (writeflag == MEM_READ) {
 1968: 			odata = d->cyl_lo;
 1969: 			if (d->cur_command == COMMAND_RESET &&
 1970: 			    diskimage_is_a_cdrom(cpu->machine,
 1971: 			    d->drive + d->base_drive, DISKIMAGE_IDE))
 1972: 				odata = 0x14;
 1973: 			if (d->atapi_cmd_in_progress) {
 1974: 				int x = d->atapi_len;
 1975: 				if (x > 32768)
 1976: 					x = 32768;
 1977: 				odata = x & 255;
 1978: 			}
 1979: 			debug("[ wdc: read from CYL_LO: 0x%02x ]\n",(int)odata);
 1980: 		} else {
 1981: 			d->cyl_lo = idata;
 1982: 			debug("[ wdc: write to CYL_LO: 0x%02x ]\n", (int)idata);
 1983: 		}
 1984: 		break;
 1985: 
 1986: 	case wd_cyl_hi:	/*  5: cylinder high  */
 1987: 		if (writeflag == MEM_READ) {
 1988: 			odata = d->cyl_hi;
 1989: 			if (d->cur_command == COMMAND_RESET &&
 1990: 			    diskimage_is_a_cdrom(cpu->machine,
 1991: 			    d->drive + d->base_drive, DISKIMAGE_IDE))
 1992: 				odata = 0xeb;
 1993: 			if (d->atapi_cmd_in_progress) {
 1994: 				int x = d->atapi_len;
 1995: 				if (x > 32768)
 1996: 					x = 32768;
 1997: 				odata = (x >> 8) & 255;
 1998: 			}
 1999: 			debug("[ wdc: read from CYL_HI: 0x%02x ]\n",(int)odata);
 2000: 		} else {
 2001: 			d->cyl_hi = idata;
 2002: 			debug("[ wdc: write to CYL_HI: 0x%02x ]\n", (int)idata);
 2003: 		}
 2004: 		break;
 2005: 
 2006: 	case wd_sdh:	/*  6: sectorsize/drive/head  */
 2007: 		if (writeflag==MEM_READ) {
 2008: 			odata = (d->sectorsize << 6) + (d->lba << 5) +
 2009: 			    (d->drive << 4) + (d->head);
 2010: 			debug("[ wdc: read from SDH: 0x%02x (sectorsize %i,"
 2011: 			    " lba=%i, drive %i, head %i) ]\n", (int)odata,
 2012: 			    d->sectorsize, d->lba, d->drive, d->head);
 2013: 		} else {
 2014: 			d->sectorsize = (idata >> 6) & 3;
 2015: 			d->lba   = (idata >> 5) & 1;
 2016: 			d->drive = (idata >> 4) & 1;
 2017: 			d->head  = idata & 0xf;
 2018: 			debug("[ wdc: write to SDH: 0x%02x (sectorsize %i,"
 2019: 			    " lba=%i, drive %i, head %i) ]\n", (int)idata,
 2020: 			    d->sectorsize, d->lba, d->drive, d->head);
 2021: 		}
 2022: 		break;
 2023: 
 2024: 	case wd_command:	/*  7: command or status  */
 2025: 		if (writeflag==MEM_READ) {
 2026: 			odata = status_byte(d, cpu);
 2027: 			if (!quiet_mode)
 2028: 				debug("[ wdc: read from STATUS: 0x%02x ]\n",
 2029: 				    (int)odata);
 2030: 			INTERRUPT_DEASSERT(d->irq);
 2031: 			d->int_assert = 0;
 2032: 		} else {
