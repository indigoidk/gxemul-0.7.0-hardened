  183: class Emu(object):
  184:     def __init__(self, argv, boot_wait=5.0):
  185:         self.buf = bytearray()
  186:         self.pid, self.fd = pty.fork()
  187:         if self.pid == 0:
  188:             try:
  189:                 os.execvp(argv[0], argv)
  190:             finally:
  191:                 os._exit(127)
  192:         self.drain(boot_wait)
  193: 
  194:     def drain(self, seconds):
  195:         end = time.time() + seconds
  196:         while time.time() < end:
  197:             r, _, _ = select.select([self.fd], [], [], 0.05)
  198:             if self.fd in r:
  199:                 try:
  200:                     d = os.read(self.fd, 65536)
  201:                 except OSError:
  202:                     return
  203:                 if not d:
  204:                     return
  205:                 self.buf.extend(d)
  206: 
  207:     def send(self, cmd, wait=0.4):
  208:         start = len(self.buf)
  209:         data = (cmd + "\n").encode()
  210:         view = memoryview(data)
  211:         while len(view):
  212:             n = os.write(self.fd, view)
  213:             view = view[n:]
  214:             if len(view):
  215:                 self.drain(0.05)
  216:         self.drain(wait)
  217:         return bytes(self.buf[start:]).decode("latin1", "replace")
  218: 
  219:     def close(self, log):
  220:         try:
  221:             os.write(self.fd, b"quit\n")
  222:             self.drain(0.4)
  223:         except OSError:
  224:             pass
  225:         for fn in (lambda: os.close(self.fd),
  226:                    lambda: os.kill(self.pid, 9),
  227:                    lambda: os.waitpid(self.pid, 0)):
  228:             try:
  229:                 fn()
  230:             except OSError:
  231:                 pass
  232:         with open(log, "w") as f:
  233:             f.write(bytes(self.buf).decode("latin1", "replace"))
  234: 
  235: def reg(emu, name):
  236:     for _ in range(5):
  237:         out = emu.send("print %s" % name, wait=0.35)
  238:         m = re.findall(r"0x[0-9a-fA-F]+", out)
  239:         if m:
  240:             return int(m[-1], 16)
  241:         emu.drain(0.25)
  242:     return None
  243: 
  244: def main():
  245:     os.makedirs(OUTDIR, exist_ok=True)
  246:     if not os.path.isfile(DISK):
  247:         with open(DISK, "wb") as f:
  248:             f.write(b"\0" * (8 * 1024 * 1024))
