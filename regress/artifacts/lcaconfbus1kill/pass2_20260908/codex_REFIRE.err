  216: DEVICE_ACCESS(lca_isa)
  217: {
  218: 	unsigned int ofs, i;
  219: 	uint8_t byte;
  220: 
  221: 	relative_addr >>= 5;
  222: 
  223: 	ofs = relative_addr & 3;
  224: 	if (ofs > len) {
  225: 		fatal("[ ofs=%i len=%i in lca_isa access function. "
  226: 		    "aborting ]\n", ofs, len);
  227: 		exit(1);
  228: 	}
  229: 
  230: 	if (writeflag == MEM_WRITE) {
  231: 		byte = data[ofs % len];
  232: 		return cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE +
  233: 		    relative_addr, &byte, 1, writeflag, CACHE_NONE);
  234: 	}
  235: 
  236: 	cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE + relative_addr,
  237: 	    &byte, 1, MEM_READ, CACHE_NONE);
  238: 
  239: 	for (i=0; i<len; i++)
  240: 		data[i] = i == ofs? byte : 0x00;
  241: 
  242: 	return 1;
  243: }
