  174:                  LDQ(T0, 8,  T0),   # t0 = 0x1   (base clobbered LAST -- both pointers are loaded)
  175:                  LDQ(T2, 0,  T1)]   # [A] CONTROL read of PCI config, with ioc_conf == 0
  176: armed    = [STQ(T0, 0, T3),         # [B] the ACCEPTED store: ioc_conf = 1
