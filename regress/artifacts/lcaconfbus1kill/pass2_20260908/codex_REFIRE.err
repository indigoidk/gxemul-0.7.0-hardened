  336: #  whose `odata' is never read, and the two control reads take the type-0 path.  So the canonical
  337: #  clause-(d) mutant on the refusal's own repair SWEEPS the detector clean without this row.
  338: #
  339: #  A type-1 READ at the alias is therefore the cell that pins the refusal's VALUE, as distinct from
  340: #  `t1 alias', which pins only that forwarding did not happen.
  341: setup2b = ["put d 0x%x, 0x%x" % (SCRATCH + 0, k0(LCA_IOC_CONF)),
  342:            "put d 0x%x, 0x%x" % (SCRATCH + 8, LEGAL),
  343:            "put d 0x%x, 0x%x" % (SCRATCH + 16, k0(T1_ZERO))]
  344: prog2b = load_const(T0, SCRATCH) + [
  345:     LDQ(T1, 16, T0),      # t1 = k0(T1_ZERO)
  346:     LDQ(T3, 0,  T0),      # t3 = k0(LCA_IOC_CONF)
  347:     LDQ(T0, 8,  T0),      # t0 = 1     (base clobbered LAST)
  348:     STQ(T0, 0,  T3),      # ioc_conf = 1
  349:     LDQ(T2, 0,  T1)]      # [F] type-1 READ at the alias -> the refusal's synthesised value
  350: cmds2b = setup2b + ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op) for i, op in enumerate(prog2b)]
  351: cmds2b += ["pc=0x%x" % k0(CODE), "step %d" % len(prog2b), "print t2"]
  352: txt2b, alive2b = session(cmds2b)
  353: t1rd = printed(txt2b, "t2")
  354: 
  355: row("t1 rdval", t1rd if alive2b else "died", "0xffffffffffffffff",
  356:     "the refusal must synthesise the empty-slot signature at register 0")
  357: 
  358: # ---- SESSION 3: the ACCEPT side -- type-0 service of a REGISTERED device is unchanged -----------
  359: #  ioc_conf is left at its reset value, so this is the `!type1' arm.  A read, not a write: reading a
  360: #  PRESENT device is silent and returns real config data, so this row additionally carries the
  361: #  small-nonzero discipline -- a wrong field yields 0 or all-ones, both of which this rejects.
  362: setup3 = ["put d 0x%x, 0x%x" % (SCRATCH + 0, k0(T0_DEV7))]
  363: prog3 = load_const(T0, SCRATCH) + [LDQ(T1, 0, T0), LDQ(T2, 0, T1)]
  364: cmds3 = setup3 + ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op) for i, op in enumerate(prog3)]
  365: cmds3 += ["pc=0x%x" % k0(CODE), "step %d" % len(prog3), "print t2"]
  366: txt3, alive3 = session(cmds3)
  367: t0val = printed(txt3, "t2")
  368: 
  369: row("t0 alive", "alive" if alive3 else "dead", "alive",
  370:     "ACCEPT: the type-0 path must still reach a registered device")
  371: 
  372: row("t0 real", "real" if t0val not in ("absent", "0x0", "0xffffffffffffffff") else t0val, "real",
  373:     "ACCEPT: dev 7 is the i82378zb -- neither empty-slot nor unmapped")
  374: 
  375: row("t0 accept", t0val, T0_PIN,
  376:     "ACCEPT: the exact value type-0 service returned before the fix")
  377: 
  378: ok = sum(1 for _, o in rows if o)
  379: print("")
  380: print("LCACONFBUS_T1ANCHOR=%s" % ("yes" if FWD in txt2 else "no"))
  381: print("LCACONFBUS_T1READ=%s" % t1rd)
  382: print("LCACONFBUS_T0VAL=%s" % t0val)
  383: print("LCACONFBUS_RESULT=%d/%d" % (ok, len(rows)))
  384: print("LCACONFBUS_WITNESS=%s" % ("PASS" if ok == len(rows) else "FAIL"))
