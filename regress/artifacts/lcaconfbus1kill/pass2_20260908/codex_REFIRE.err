  269: #      addr = tag << 5 | (regoffset & ~0x03) << 5 | 0x3 << 3
  270: #
  271: #  -- so for register 0 a real address is `tag << 5 | 0x18', not `tag << 5'.  The handler then
  272: #  discards bits 4..0 with `>> 5', so BOTH forms decode identically and the earlier measurement was
