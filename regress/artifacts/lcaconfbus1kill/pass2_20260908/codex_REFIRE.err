   68: rows = []
   69: def row(name, got, want, note=""):
   70:     ok = (got == want)
   71:     rows.append((name, ok))
   72:     print("%-14s %-24s %-24s %-52s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
   73:     return ok
