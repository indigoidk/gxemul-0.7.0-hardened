   89: DEVICE_ACCESS(lca_pci_conf)
   90: {
   91: 	uint64_t idata = 0, odata = 0;
   92: 	int tag, type1, bus, dev, func, reg;	/*  #515  */
   93: 	struct lca_data *d = (struct lca_data *) extra;
   94: 
   95: 	if (writeflag == MEM_WRITE)
   96: 		idata = memory_readmax64(cpu, data, len);
   97: 
   98: 	/*
   99: 	 *  1. Decompose the address into a tag.
  100: 	 *
  101: 	 *  According to NetBSD's lca_pci.c, the address is composed like this:
  102: 	 *
  103: 	 *	addr = tag << 5 | (regoffset & ~0x03) << 5 | 0x3 << 3
  104: 	 */
  105: 	reg = (relative_addr >> 5) & 0xfc;
  106: 	tag = (relative_addr >> 5) & ~0xff;
  107: 
  108: 	/*
  109: 	 *  2. Decompose the tag into bus, dev, and func.
  110: 	 *
  111: 	 *  The tag can be constructed in one of two ways. On the primary
  112: 	 *  bus (nr 0):
  113: 	 *
  114: 	 *	tag = (1 << (device + 11)) | (function << 8);
  115: 	 *
  116: 	 *  and on other busses, the tag is a normal:
  117: 	 *
  118: 	 *	tag = (bus << 16) | (device << 11) | (function << 8)
  119: 	 */
  120: 	/*  printf("tag = 0x%x\n", (int)tag);  */
  121: 
  122: 	/*  #515: `bus' used to be BOTH the configuration CYCLE TYPE and the
  123: 	    DESTINATION BUS, and conflating them is the whole defect.  IOC_CONF bit 0
  124: 	    selects the cycle type only -- 21066/21066A HRM S6.2.9: "PCI address bits
  125: 	    ad<1:0> come directly from configuration cycle type register (IOC_CONF,
  126: 	    Section 6.4.2) bits <1:0>" -- and it does NOT carry a bus number.  The
  127: 	    destination bus of a type-1 cycle lives in the ADDRESS, per the PCI Local
  128: 	    Bus specification's type-1 layout (bus 23..16, dev 15..11, fn 10..8,
  129: 	    reg 7..2), which S6.2.9 defers to explicitly.
  130: 
  131: 	    Before this, a guest that merely SET bit 0 -- a value the CONF guard
  132: 	    ACCEPTS -- made any subsequent access in this window reach
  133: 	    `fatal("TODO. Non-zero bus."); exit(1)'.  MEASURED: two ordinary guest
  134: 	    accesses, nothing refused anywhere on the path
  135: 	    (regress/lca_confbus_probe.py, 3/4 pre-fix; artifacts/lcaconfbus1kill/).  */
  136: 	type1 = d->ioc_conf & 1;	/*  #515  */
  137: 	bus = 0;			/*  #515  */
  138: 
  139: 	if (!type1) {			/*  #515  */
  140: 		/*  #511: was `0x800 << dev'.  `0x800' is a plain int (2^11) and `dev'
  141: 		    reaches 20, so the last iteration evaluates 2^31 -- a SIGNED
  142: 		    OVERFLOW, undefined by C99 6.5.7p4, not merely
  143: 		    implementation-defined.  MEASURED under UBSAN before the change:
  144: 		    "dev_lca.c:125:21: runtime error: left shift of 2048 by 20 places
  145: 		    cannot be represented in type 'int'", reached by an ordinary guest
  146: 		    ldq into the PCI config window (regress/lca_confbus_probe.py against
  147: 		    build-asan; artifacts/lcashiftub/ubsan_HEAD_20260907.raw).
  148: 
  149: 		    `0x800U' makes the operand unsigned, so 2048U << 20 is 0x80000000U --
  150: 		    inside unsigned int -- and NOTHING ELSE MOVES.
  151: 
  152: 		    *** THE REASON, CORRECTED: AN EARLIER DRAFT SAID `tag' IS "ALREADY A
  153: 		    WIDER UNSIGNED QUANTITY".  THAT IS FALSE -- `tag' is a plain signed
  154: 		    `int' (:92) -- AND FOUR PASS-2 SEATS CAUGHT IT.  Worse, the claim was
  155: 		    backwards: being WIDER is what would CREATE a difference, not remove
  156: 		    one.  Had `tag' been `uint64_t', the old `int' 0x80000000 is NEGATIVE
  157: 		    and would SIGN-EXTEND to 0xffffffff80000000 for the `&', while
  158: 		    `0x800U << 20' zero-extends to 0x0000000080000000 -- two different
  159: 		    masks.  The seats were right about the mechanism and it does not fire
  160: 		    here only because of the type.
  161: 
  162: 		    WHAT ACTUALLY HOLDS: both operands are 32-bit, so the `&' is performed
  163: 		    at 32 bits either way -- `int & int' before, and after, `tag' converted
  164: 		    to `unsigned int' by the usual arithmetic conversions.  The RESULT'S
  165: 		    BIT PATTERN IS IDENTICAL; only its type changes, and it is consumed
  166: 		    solely as a truth test in `if (...)'.  So no guest-visible value moves,
  167: 		    and the repair is owed purely by the LANGUAGE. ***
  168: 
  169: 		    *** THE LOOP THIS SITS IN IS THIS FILE'S OWN GRACEFUL-DEGRADATION
  170: 		    PRECEDENT -- the `dev >= 21' arm below has a commented-out
  171: 		    fatal()/exit(1) and substitutes `dev = 0' instead, and `lcabadval'
  172: 		    cites it as a transferable warrant.  The safe path contained the UB. ***  */
  173: 		for (dev=0; dev<21; dev++)
  174: 			if (tag & (0x800U << dev))	/*  #511  */
  175: 				break;
  176: 		if (dev >= 21) {
  177: 			/*  fatal("[ LCA: No bus 0 device? TODO ]\n");
  178: 			exit(1);  */
  179: 			dev = 0;
  180: 		}
  181: 	} else {
  182: 		/*  #515: a type-1 cycle carries its destination in the address.  */
  183: 		bus = (tag >> 16) & 0xff;	/*  #515  */
  184: 		dev = (tag >> 11) & 0x1f;	/*  #515  */
  185: 	}
  186: 
  187: 	func = (tag >> 8) & 7;
  188: 	/*  printf("bus=%i dev=%i func=%i reg=%i\n", bus,dev,func,reg);  */
  189: 
  190: 	/*  #515: a type-1 cycle whose bus field is zero selects NOTHING.  Type-1 is
  191: 	    how a bridge is asked to reach a bus BEHIND it; the primary bus is reached
  192: 	    with type-0 cycles, whose IDSEL encoding is decoded above.  Forwarding this
  193: 	    case would set cur_bus = 0 and hand the access to whichever primary-bus
  194: 	    device matched -- `i82378zb' is registered at 0:7:0 by DEVINIT below -- so
  195: 	    simply decoding `bus' and stopping there would replace a host kill with a
  196: 	    NEW MISROUTING.  Refuse it instead, matching `bus_pci_data_access''s own
  197: 	    empty-slot contract (bus_pci.c, the `dev == NULL' arm: all-ones at register
  198: 	    0, zero elsewhere) so the guest sees the ordinary "nothing there" answer.
  199: 	    Writes are discarded, which leaves backend state untouched.  */
  200: 	if (type1 && bus == 0) {		/*  #515  */
  201: 		odata = reg == 0? (uint64_t) -1 : 0;
  202: 	} else {
  203: 		/*  Pass PCI accesses onto bus_pci:  */
  204: 		bus_pci_setaddr(cpu, d->pci_data, bus, dev, func, reg);
  205: 		bus_pci_data_access(cpu, d->pci_data, writeflag == MEM_READ?
  206: 		    &odata : &idata, len, writeflag);
  207: 	}
  208: 
  209: 	if (writeflag == MEM_READ)
  210: 		memory_writemax64(cpu, data, len, odata);
  211: 
  212: 	return 1;
  213: }
