  398: DEVINIT(lca)
  399: {
  400: 	char *interrupt_path;
  401: 	struct interrupt interrupt_template;
  402: 	struct lca_data *d;
  403: 
  404: 	CHECK_ALLOCATION(d = (struct lca_data *) malloc(sizeof(struct lca_data)));
  405: 	memset(d, 0, sizeof(struct lca_data));
  406: 
  407: 	/*  Register a PCI bus:  */
  408: 	d->pci_data = bus_pci_init(
  409: 	    devinit->machine,
  410: 	    "TODO: irq"		/*  pciirq: TODO  */,
  411: 	    LCA_PCI_SIO,	/*  pci device io offset  */
  412: 	    0x00000000,		/*  pci device mem offset: TODO  */
  413: 	    0x00000000,		/*  PCI portbase: TODO  */
  414: 	    0x00000000,		/*  PCI membase: TODO  */
  415: 	    "TODO: pci irq base",	/*  PCI irqbase: TODO  */
  416: 	    LCA_ISA_BASE,	/*  ISA portbase  */
  417: 	    LCA_ISA_MEMBASE,	/*  ISA membase  */
  418: 	    "TODO: irqbase isa");                /*  ISA irqbase: TODO  */
  419: 
  420: 	/*  Add the "sio0" controller (as seen by NetBSD):  */
  421: 	bus_pci_add(devinit->machine, d->pci_data, devinit->machine->memory,
  422: 	    0, 7, 0, "i82378zb");
  423: 
  424: 	memory_device_register(devinit->machine->memory, "lca_pci_conf",
  425: 	    LCA_PCI_CONF, 0x20000000, dev_lca_pci_conf_access, (void *)d,
  426: 	    DM_DEFAULT, NULL);
  427: 
  428: 	memory_device_register(devinit->machine->memory, "lca_isa",
  429: 	    LCA_PCI_SIO, 0x10000 << 5, dev_lca_isa_access, (void *)d,
  430: 	    DM_DEFAULT, NULL);
  431: 
  432: 	memory_device_register(devinit->machine->memory, "lca_ioc",
  433: 	    LCA_IOC_BASE, 0x20000000, dev_lca_ioc_access, (void *)d,
  434: 	    DM_DEFAULT, NULL);
  435: 
  436: 	CHECK_ALLOCATION(interrupt_path = (char *)
  437: 	    malloc(strlen(devinit->machine->path) + 10));
  438: 	snprintf(interrupt_path, strlen(devinit->machine->path) + 10,
  439: 	    "%s.lca", devinit->machine->path);
  440: 
  441: 	memset(&interrupt_template, 0, sizeof(interrupt_template));
  442: 	interrupt_template.line = 0;
  443: 	interrupt_template.name = interrupt_path;
  444: 	interrupt_template.extra = d;
  445: 	interrupt_template.interrupt_assert = lca_interrupt_assert;
  446: 	interrupt_template.interrupt_deassert = lca_interrupt_deassert;
  447: 	interrupt_handler_register(&interrupt_template);
  448: 
  449: 	bus_isa_init(devinit->machine, interrupt_path,
  450: 	    BUS_ISA_IDE0 | BUS_ISA_IDE1, LCA_ISA_BASE, LCA_ISA_MEMBASE);
  451: 
  452: 	return 1;
  453: }
