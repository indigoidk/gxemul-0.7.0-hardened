  793: 	case PCI_MAPREG_START + 4:
  794: 	case PCI_MAPREG_START + 8:
  795: 	case PCI_MAPREG_START + 12:
  796: 	case PCI_MAPREG_START + 16:
  797: 	case PCI_MAPREG_START + 20:
  798: 		return 1;
  799: 	}
  800: 
  801: 	return 0;
  802: }
