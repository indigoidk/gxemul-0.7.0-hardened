  314: #  access ran and was refused" from "the access never ran", which is this project's
  315: #  pattern-that-matched-nothing class in its purest form: a phantom absence read as a result.
  316: #  Binding it to `alive2' makes the two states render differently, per the oldest rule here --
  317: #  an unrun check and a passing one must never look the same.
  318: row("t1 alias",
  319:     ("refused" if ALIAS not in txt2 else "forwarded") if alive2 else "died-before-E",
  320:     "refused",
  321:     "type-1 with bus 0 must NOT be forwarded onto the primary bus")
  322: 
  323: for _l in txt2.split(chr(10)):
  324:     if "non-existant" in _l:
  325:         print("  EVIDENCE(S2): %s" % _l.strip())
