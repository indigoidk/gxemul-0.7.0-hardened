  246: DEVICE_ACCESS(lca_ioc)
  247: {
  248: 	uint64_t idata = 0, odata = 0;
  249: 	struct lca_data *d = (struct lca_data *) extra;
  250: 
  251: 	if (writeflag == MEM_WRITE)
  252: 		idata = memory_readmax64(cpu, data, len);
  253: 
  254: 	switch (relative_addr + LCA_IOC_BASE) {
  255: 
  256: 	case LCA_IOC_BASE:
  257: 		/*  Ignore? Linux reads from the base at startup.  */
  258: 		break;
  259: 
  260: 	case LCA_IOC_CONF:
  261: 		if (writeflag == MEM_READ) {
  262: 			odata = d->ioc_conf;
  263: 		} else {
  264: 			d->ioc_conf = idata;
  265: 			/*  Only bit 0 is implemented so far, the PCI bus 0 vs
  266: 			    bus non-0 selection bit.  */
  267: 			if (idata & ~1) {
  268: 				/*  #506: was `0x%x', (int)idata -- a 64-bit guarded value
  269: 				    narrowed to 32 in the KILL diagnostic, so a write of
  270: 				    0x100000000 trips `idata & ~1' and then reports "0x0",
  271: 				    which is a value this same guard ACCEPTS.  The five
  272: 				    sibling arms below already print the full width this
  273: 				    way; this arm was the outlier among the VALUE-guard
  274: 				    diagnostics.  (Not the file's only narrowing site --
  275: 				    the default arm below has the same cast, and this
  276: 				    round fixes it too.)  */
  277: 				fatal("TODO: Write to unimplemented bit of"
  278: 				    " IOC_CONF: 0x%" PRIx64 "\n", (uint64_t)idata);
  279: 				exit(1);
  280: 			}
  281: 		}
  282: 		break;
  283: 
  284: 	case LCA_IOC_TBIA:
  285: 		/*  TLB Invalidate All.  */
  286: 		/*  TODO: For now, let's just ignore it.  */
  287: 		break;
  288: 
  289: 	case LCA_IOC_TB_ENA:
  290: 		if (writeflag == MEM_READ) {
  291: 			odata = d->tlb_enable;
  292: 		} else {
  293: 			d->tlb_enable = idata;
  294: 			/*  TODO: Actually implement this.  */
  295: 			if (idata & ~IOC_TB_ENA_TEN) {
  296: 				fatal("TODO: LCA_IOC_TB_ENA value "
  297: 				    " (0x%" PRIx64") has unimplemented "
  298: 				    "bits.\n", (uint64_t)idata);
  299: 				exit(1);
  300: 			}
  301: 		}
  302: 		break;
  303: 
  304: 	case LCA_IOC_W_BASE0:
  305: 		if (writeflag == MEM_READ) {
  306: 			odata = d->window_base_0;
  307: 		} else {
  308: 			d->window_base_0 = idata;
  309: 			/*  TODO: Actually implement this.  */
  310: 			if (idata != 0ULL && idata != 0x300800000ULL) {
  311: 				fatal("TODO: LCA_IOC_W_BASE0 value differs"
  312: 				    " (0x%" PRIx64") from the only implemented"
  313: 				    " values\n", (uint64_t)idata);
  314: 				exit(1);
  315: 			}
  316: 		}
  317: 		break;
