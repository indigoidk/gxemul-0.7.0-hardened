   66: 
   67: /*
   68:  *  bus_pci_decompose_1():
   69:  *
   70:  *  Helper function for decomposing Mechanism 1 tags.
   71:  */
   72: void bus_pci_decompose_1(uint32_t t, int *bus, int *dev, int *func, int *reg)
   73: {
   74: 	*bus  = (t >> 16) & 0xff;
   75: 	*dev  = (t >> 11) & 0x1f;
   76: 	*func = (t >>  8) &  0x7;
   77: 	*reg  =  t        & 0xff;
   78: 
   79: 	/*  Warn about unaligned register access:  */
   80: 	if (t & 3)
   81: 		fatal("[ bus_pci_decompose_1: WARNING: reg = 0x%02x ]\n",
   82: 		    t & 0xff);
   83: }
   84: 
   85: 
   86: /*
   87:  *  bus_pci_data_access():
   88:  *
   89:  *  Reads from or writes to the PCI configuration registers of a device.
   90:  */
   91: void bus_pci_data_access(struct cpu *cpu, struct pci_data *pci_data,
   92: 	uint64_t *data, int len, int writeflag)
   93: {
   94: 	struct pci_device *dev;
   95: 	unsigned char *cfg_base;
   96: 	uint64_t x, idata = *data;
   97: 	int i;
   98: 
   99: 	/*  Scan through the list of pci_device entries.  */
  100: 	dev = pci_data->first_device;
  101: 	while (dev != NULL) {
  102: 		if (dev->bus      == pci_data->cur_bus &&
  103: 		    dev->function == pci_data->cur_func &&
  104: 		    dev->device   == pci_data->cur_device)
  105: 			break;
  106: 		dev = dev->next;
  107: 	}
  108: 
  109: 	/*  No device? Then return emptiness.  */
  110: 	if (dev == NULL) {
  111: 		if (writeflag == MEM_READ) {
  112: 			if (pci_data->cur_reg == 0)
  113: 				*data = (uint64_t) -1;
  114: 			else
  115: 				*data = 0;
  116: 		} else {
  117: 			fatal("[ bus_pci_data_access(): write to non-existant"
  118: 			    " device, bus %i func %i device %i ]\n",
  119: 			    pci_data->cur_bus, pci_data->cur_func,
  120: 			    pci_data->cur_device);
  121: 		}
  122: 		return;
  123: 	}
  124: 
  125: 	/*  Return normal config data, or length data?  */
  126: 	if (pci_data->last_was_write_ffffffff &&
  127: 	    pci_data->cur_reg >= PCI_MAPREG_START &&
  128: 	    pci_data->cur_reg <= PCI_MAPREG_END - 4)
  129: 		cfg_base = dev->cfg_mem_size;
  130: 	else
  131: 		cfg_base = dev->cfg_mem;
  132: 
  133: 	/*  Read data as little-endian:  */
  134: 	x = 0;
  135: 	for (i=len-1; i>=0; i--) {
  136: 		int ofs = pci_data->cur_reg + i;
  137: 		x <<= 8;
  138: 		x |= cfg_base[ofs & (PCI_CFG_MEM_SIZE - 1)];
  139: 	}
  140: 
  141: 	/*  Register write:  */
  142: 	if (writeflag == MEM_WRITE) {
  143: 		debug("[ bus_pci: write to PCI DATA: data = 0x%08llx ]\n",
  144: 		    (long long)idata);
  145: 		if (idata == 0xffffffffULL &&
  146: 		    pci_data->cur_reg >= PCI_MAPREG_START &&
  147: 		    pci_data->cur_reg <= PCI_MAPREG_END - 4) {
  148: 			pci_data->last_was_write_ffffffff = 1;
  149: 			return;
  150: 		}
  151: 
  152: 		if (dev->cfg_reg_write == NULL ||
  153: 		    dev->cfg_reg_write(dev, pci_data->cur_reg, *data) == 0) {
  154: 			/*  Print a warning for unhandled writes:  */
  155: 			debug("[ bus_pci: write to PCI DATA: data = 0x%08llx"
  156: 			    " (current value = 0x%08llx); NOT YET"
  157: 			    " SUPPORTED. bus %i, device %i, function %i (%s)"
  158: 			    " register 0x%02x ]\n", (long long)idata,
  159: 			    (long long)x, pci_data->cur_bus,
  160: 			    pci_data->cur_device, pci_data->cur_func,
  161: 			    dev->name, pci_data->cur_reg);
  162: 
  163: 			/*  Special warning, to detect if NetBSD's special
  164: 			    detection of PCI devices fails:  */
  165: 			if (pci_data->cur_reg == PCI_COMMAND_STATUS_REG
  166: 			    && !((*data) & PCI_COMMAND_IO_ENABLE)) {
  167: 				fatal("\n[ NetBSD PCI detection stuff not"
  168: 				    " yet implemented for device '%s' ]\n",
  169: 				    dev->name);
  170: 			}
  171: 		}
  172: 		return;
  173: 	}
  174: 
  175: 	/*  Register read:  */
  176: 	*data = x;
  177: 
  178: 	pci_data->last_was_write_ffffffff = 0;
  179: 
  180: 	debug("[ bus_pci: read from PCI DATA, bus %i, device "
  181: 	    "%i, function %i (%s) register 0x%02x: (len=%i) 0x%08lx ]\n",
  182: 	    pci_data->cur_bus, pci_data->cur_device, pci_data->cur_func,
  183: 	    dev->name, pci_data->cur_reg, len, (long)*data);
  184: }
  185: 
  186: 
  187: /*
  188:  *  bus_pci_setaddr():
  189:  *
  190:  *  Sets the address in preparation for a PCI register transfer.
  191:  */
  192: void bus_pci_setaddr(struct cpu *cpu, struct pci_data *pci_data,
  193: 	int bus, int device, int function, int reg)
  194: {
  195: 	if (cpu == NULL || pci_data == NULL) {
  196: 		fatal("bus_pci_setaddr(): NULL ptr\n");
  197: 		exit(1);
  198: 	}
  199: 
  200: 	pci_data->cur_bus = bus;
  201: 	pci_data->cur_device = device;
  202: 	pci_data->cur_func = function;
  203: 	pci_data->cur_reg = reg;
  204: }
  205: 
  206: 
  207: /*
  208:  *  bus_pci_add():
  209:  *
  210:  *  Add a PCI device to a bus_pci device.
  211:  */
  212: void bus_pci_add(struct machine *machine, struct pci_data *pci_data,
  213: 	struct memory *mem, int bus, int device, int function,
  214: 	const char *name)
  215: {
  216: 	struct pci_device *pd;
  217: 	int ofs;
  218: 	void (*init)(struct machine *, struct memory *, struct pci_device *);
  219: 
  220: 	if (pci_data == NULL) {
  221: 		fatal("bus_pci_add(): pci_data == NULL!\n");
  222: 		abort();
  223: 	}
  224: 
  225: 	/*  Find the PCI device:  */
  226: 	init = pci_lookup_initf(name);
  227: 
  228: 	/*  Make sure this bus/device/function number isn't already in use:  */
  229: 	pd = pci_data->first_device;
  230: 	while (pd != NULL) {
  231: 		if (pd->bus == bus && pd->device == device &&
  232: 		    pd->function == function) {
  233: 			fatal("bus_pci_add(): (bus %i, device %i, function"
  234: 			    " %i) already in use\n", bus, device, function);
  235: 			exit(1);
  236: 		}
  237: 		pd = pd->next;
  238: 	}
  239: 
  240: 	CHECK_ALLOCATION(pd = (struct pci_device *) malloc(sizeof(struct pci_device)));
  241: 	memset(pd, 0, sizeof(struct pci_device));
  242: 
  243: 	/*  Add the new device first in the PCI bus' chain:  */
  244: 	pd->next = pci_data->first_device;
  245: 	pci_data->first_device = pd;
  246: 
  247: 	CHECK_ALLOCATION(pd->name = strdup(name));
  248: 	pd->pcibus   = pci_data;
  249: 	pd->bus      = bus;
  250: 	pd->device   = device;
  251: 	pd->function = function;
  252: 
  253: 	/*
  254: 	 *  Initialize with some default values:
  255: 	 *
  256: 	 *  TODO:  The command status register is best to set up per device.
  257: 	 *  The size registers should also be set up on a per-device basis.
  258: 	 */
  259: 	PCI_SET_DATA(PCI_COMMAND_STATUS_REG,
  260: 	    PCI_COMMAND_IO_ENABLE | PCI_COMMAND_MEM_ENABLE);
  261: 	for (ofs = PCI_MAPREG_START; ofs < PCI_MAPREG_END; ofs += 4)
  262: 		PCI_SET_DATA_SIZE(ofs, 0x00100000 - 1);
  263: 
  264: 	if (init == NULL) {
  265: 		fatal("No init function for PCI device \"%s\"?\n", name);
  266: 		exit(1);
  267: 	}
  268: 
  269: 	/*  Call the PCI device' init function:  */
  270: 	init(machine, mem, pd);
  271: }
  272: 
  273: 
  274: /*
  275:  *  allocate_device_space():
  276:  *
  277:  *  Used by glue code (see below) to allocate space for a PCI device.
  278:  *
  279:  *  The returned values in portp and memp are the actual (emulated) addresses
  280:  *  that the device should use. (Normally only one of these is actually used.)
  281:  *
  282:  *  TODO: PCI irqs?
  283:  */
  284: static void allocate_device_space(struct pci_device *pd,
  285: 	uint64_t portsize, uint64_t memsize,
  286: 	uint64_t *portp, uint64_t *memp)
  287: {
  288: 	uint64_t port, mem;
  289: 
  290: 	/*  Calculate an aligned starting port:  */
  291: 	port = pd->pcibus->cur_pci_portbase;
  292: 	if (portsize != 0) {
  293: 		port = ((port - 1) | (portsize - 1)) + 1;
  294: 		pd->pcibus->cur_pci_portbase = port;
  295: 		PCI_SET_DATA(PCI_MAPREG_START + pd->cur_mapreg_offset,
  296: 		    port | PCI_MAPREG_TYPE_IO);
  297: 		PCI_SET_DATA_SIZE(PCI_MAPREG_START + pd->cur_mapreg_offset,
  298: 		    ((portsize - 1) & ~0xf) | 0xd);
  299: 		pd->cur_mapreg_offset += sizeof(uint32_t);
  300: 	}
  301: 
  302: 	/*  Calculate an aligned starting memory location:  */
  303: 	mem = pd->pcibus->cur_pci_membase;
  304: 	if (memsize != 0) {
  305: 		mem = ((mem - 1) | (memsize - 1)) + 1;
  306: 		pd->pcibus->cur_pci_membase = mem;
  307: 		PCI_SET_DATA(PCI_MAPREG_START + pd->cur_mapreg_offset, mem);
  308: 		PCI_SET_DATA_SIZE(PCI_MAPREG_START + pd->cur_mapreg_offset,
  309: 		    ((memsize - 1) & ~0xf) | 0x0);
  310: 		pd->cur_mapreg_offset += sizeof(uint32_t);
  311: 	}
  312: 
  313: 	*portp = port + pd->pcibus->pci_actual_io_offset;
  314: 	*memp  = mem  + pd->pcibus->pci_actual_mem_offset;
  315: 
  316: 	if (verbose >= 2) {
  317: 		debug("pci device '%s' at", pd->name);
  318: 		if (portsize != 0)
  319: 			debug(" port 0x%llx-0x%llx", (long long)pd->pcibus->
  320: 			    cur_pci_portbase, (long long)(pd->pcibus->
  321: 			    cur_pci_portbase + portsize - 1));
  322: 		if (memsize != 0)
  323: 			debug(" mem 0x%llx-0x%llx", (long long)pd->pcibus->
  324: 			    cur_pci_membase, (long long)(pd->pcibus->
  325: 			    cur_pci_membase + memsize - 1));
  326: 		debug("\n");
  327: 	}
  328: 
  329: 	pd->pcibus->cur_pci_portbase += portsize;
  330: 	pd->pcibus->cur_pci_membase += memsize;
  331: }
  332: 
  333: 
  334: /*
  335:  *  bus_pci_init():
  336:  *
  337:  *  This doesn't register a device, but instead returns a pointer to a struct
  338:  *  which should be passed to other bus_pci functions when accessing the bus.
  339:  *
  340:  *  irq_path is the interrupt path to the PCI controller.
  341:  *
  342:  *  pci_portbase, pci_membase, and pci_irqbase are the port, memory, and
  343:  *  interrupt bases for PCI devices (as found in the configuration registers).
  344:  *
  345:  *  pci_actual_io_offset and pci_actual_mem_offset are the offset from
  346:  *  the values in the configuration registers to the actual (emulated) device.
  347:  *
  348:  *  isa_portbase, isa_membase, and isa_irqbase are the port, memory, and
  349:  *  interrupt bases for legacy ISA devices.
  350:  */
  351: struct pci_data *bus_pci_init(struct machine *machine, const char *irq_path,
  352: 	uint64_t pci_actual_io_offset, uint64_t pci_actual_mem_offset,
  353: 	uint64_t pci_portbase, uint64_t pci_membase, const char *pci_irqbase,
  354: 	uint64_t isa_portbase, uint64_t isa_membase, const char *isa_irqbase)
  355: {
  356: 	struct pci_data *d;
  357: 
  358: 	CHECK_ALLOCATION(d = (struct pci_data *) malloc(sizeof(struct pci_data)));
  359: 	memset(d, 0, sizeof(struct pci_data));
  360: 
  361: 	CHECK_ALLOCATION(d->irq_path     = strdup(irq_path));
  362: 	CHECK_ALLOCATION(d->irq_path_isa = strdup(isa_irqbase));
  363: 	CHECK_ALLOCATION(d->irq_path_pci = strdup(pci_irqbase));
  364: 
  365: 	d->pci_actual_io_offset  = pci_actual_io_offset;
  366: 	d->pci_actual_mem_offset = pci_actual_mem_offset;
  367: 	d->pci_portbase          = pci_portbase;
  368: 	d->pci_membase           = pci_membase;
  369: 	d->isa_portbase          = isa_portbase;
  370: 	d->isa_membase           = isa_membase;
