  185: DEVICE_ACCESS(lca_isa)
  186: {
  187: 	unsigned int ofs, i;
  188: 	uint8_t byte;
  189: 
  190: 	relative_addr >>= 5;
  191: 
  192: 	ofs = relative_addr & 3;
  193: 	if (ofs > len) {
  194: 		fatal("[ ofs=%i len=%i in lca_isa access function. "
  195: 		    "aborting ]\n", ofs, len);
  196: 		exit(1);
  197: 	}
  198: 
  199: 	if (writeflag == MEM_WRITE) {
  200: 		byte = data[ofs % len];
  201: 		return cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE +
  202: 		    relative_addr, &byte, 1, writeflag, CACHE_NONE);
  203: 	}
  204: 
  205: 	cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE + relative_addr,
  206: 	    &byte, 1, MEM_READ, CACHE_NONE);
  207: 
  208: 	for (i=0; i<len; i++)
  209: 		data[i] = i == ofs? byte : 0x00;
  210: 
  211: 	return 1;
  212: }
  213: 
  214: 
  215: DEVICE_ACCESS(lca_ioc)
  216: {
  217: 	uint64_t idata = 0, odata = 0;
  218: 	struct lca_data *d = (struct lca_data *) extra;
  219: 
  220: 	if (writeflag == MEM_WRITE)
  221: 		idata = memory_readmax64(cpu, data, len);
  222: 
  223: 	switch (relative_addr + LCA_IOC_BASE) {
  224: 
  225: 	case LCA_IOC_BASE:
  226: 		/*  Ignore? Linux reads from the base at startup.  */
  227: 		break;
  228: 
  229: 	case LCA_IOC_CONF:
