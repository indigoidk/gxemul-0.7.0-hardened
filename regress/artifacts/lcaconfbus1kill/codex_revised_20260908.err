   89: DEVICE_ACCESS(lca_pci_conf)
   90: {
   91: 	uint64_t idata = 0, odata = 0;
   92: 	int tag, bus, dev, func, reg;
   93: 	struct lca_data *d = (struct lca_data *) extra;
   94: 
   95: 	if (writeflag == MEM_WRITE)
   96: 		idata = memory_readmax64(cpu, data, len);
   97: 
   98: 	/*
   99: 	 *  1. Decompose the address into a tag.
  100: 	 *
  101: 	 *  According to NetBSD's lca_pci.c, the address is composed like this:
  102: 	 *
  103: 	 *	addr = tag << 5 | (regoffset & ~0x03) << 5 | 0x3 << 3
  104: 	 */
  105: 	reg = (relative_addr >> 5) & 0xfc;
  106: 	tag = (relative_addr >> 5) & ~0xff;
  107: 
  108: 	/*
  109: 	 *  2. Decompose the tag into bus, dev, and func.
  110: 	 *
  111: 	 *  The tag can be constructed in one of two ways. On the primary
  112: 	 *  bus (nr 0):
  113: 	 *
  114: 	 *	tag = (1 << (device + 11)) | (function << 8);
  115: 	 *
  116: 	 *  and on other busses, the tag is a normal:
  117: 	 *
  118: 	 *	tag = (bus << 16) | (device << 11) | (function << 8)
  119: 	 */
  120: 	/*  printf("tag = 0x%x\n", (int)tag);  */
  121: 	bus = d->ioc_conf & 1;
  122: 
  123: 	if (bus == 0) {
  124: 		/*  #511: was `0x800 << dev'.  `0x800' is a plain int (2^11) and `dev'
  125: 		    reaches 20, so the last iteration evaluates 2^31 -- a SIGNED
  126: 		    OVERFLOW, undefined by C99 6.5.7p4, not merely
  127: 		    implementation-defined.  MEASURED under UBSAN before the change:
  128: 		    "dev_lca.c:125:21: runtime error: left shift of 2048 by 20 places
  129: 		    cannot be represented in type 'int'", reached by an ordinary guest
  130: 		    ldq into the PCI config window (regress/lca_confbus_probe.py against
  131: 		    build-asan; artifacts/lcashiftub/ubsan_HEAD_20260907.raw).
  132: 
  133: 		    `0x800U' makes the operand unsigned, so 2048U << 20 is 0x80000000U --
  134: 		    inside unsigned int -- and NOTHING ELSE MOVES.
  135: 
  136: 		    *** THE REASON, CORRECTED: AN EARLIER DRAFT SAID `tag' IS "ALREADY A
  137: 		    WIDER UNSIGNED QUANTITY".  THAT IS FALSE -- `tag' is a plain signed
  138: 		    `int' (:92) -- AND FOUR PASS-2 SEATS CAUGHT IT.  Worse, the claim was
  139: 		    backwards: being WIDER is what would CREATE a difference, not remove
  140: 		    one.  Had `tag' been `uint64_t', the old `int' 0x80000000 is NEGATIVE
  141: 		    and would SIGN-EXTEND to 0xffffffff80000000 for the `&', while
  142: 		    `0x800U << 20' zero-extends to 0x0000000080000000 -- two different
  143: 		    masks.  The seats were right about the mechanism and it does not fire
  144: 		    here only because of the type.
  145: 
  146: 		    WHAT ACTUALLY HOLDS: both operands are 32-bit, so the `&' is performed
  147: 		    at 32 bits either way -- `int & int' before, and after, `tag' converted
  148: 		    to `unsigned int' by the usual arithmetic conversions.  The RESULT'S
  149: 		    BIT PATTERN IS IDENTICAL; only its type changes, and it is consumed
  150: 		    solely as a truth test in `if (...)'.  So no guest-visible value moves,
  151: 		    and the repair is owed purely by the LANGUAGE. ***
  152: 
  153: 		    *** THE LOOP THIS SITS IN IS THIS FILE'S OWN GRACEFUL-DEGRADATION
  154: 		    PRECEDENT -- the `dev >= 21' arm below has a commented-out
  155: 		    fatal()/exit(1) and substitutes `dev = 0' instead, and `lcabadval'
  156: 		    cites it as a transferable warrant.  The safe path contained the UB. ***  */
  157: 		for (dev=0; dev<21; dev++)
  158: 			if (tag & (0x800U << dev))	/*  #511  */
  159: 				break;
  160: 		if (dev >= 21) {
  161: 			/*  fatal("[ LCA: No bus 0 device? TODO ]\n");
  162: 			exit(1);  */
  163: 			dev = 0;
  164: 		}
  165: 	} else {
  166: 		fatal("TODO. Non-zero bus.\n");
  167: 		exit(1);
  168: 	}
  169: 
  170: 	func = (tag >> 8) & 7;
  171: 	/*  printf("bus=%i dev=%i func=%i reg=%i\n", bus,dev,func,reg);  */
  172: 
  173: 	/*  Pass PCI accesses onto bus_pci:  */
  174: 	bus_pci_setaddr(cpu, d->pci_data, bus, dev, func, reg);
  175: 	bus_pci_data_access(cpu, d->pci_data, writeflag == MEM_READ?
  176: 	    &odata : &idata, len, writeflag);
  177: 
  178: 	if (writeflag == MEM_READ)
  179: 		memory_writemax64(cpu, data, len, odata);
  180: 
  181: 	return 1;
  182: }
