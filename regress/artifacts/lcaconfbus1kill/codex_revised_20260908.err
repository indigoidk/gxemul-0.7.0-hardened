   53: void
   54: lca_pci_init(pc, v)
   55: 	pci_chipset_tag_t pc;
   56: 	void *v;
   57: {
   58: 
   59: 	pc->pc_conf_v = v;
   60: 	pc->pc_attach_hook = lca_attach_hook;
   61: 	pc->pc_bus_maxdevs = lca_bus_maxdevs;
   62: 	pc->pc_make_tag = lca_make_tag;
   63: 	pc->pc_decompose_tag = lca_decompose_tag;
   64: 	pc->pc_conf_read = lca_conf_read;
   65: 	pc->pc_conf_write = lca_conf_write;
   66: }
   67: 
   68: void
   69: lca_attach_hook(parent, self, pba)
   70: 	struct device *parent, *self;
   71: 	struct pcibus_attach_args *pba;
   72: {
   73: }
   74: 
   75: int
   76: lca_bus_maxdevs(cpv, busno)
   77: 	void *cpv;
   78: 	int busno;
   79: {
   80: 
   81: 	if (busno == 0)
   82: 		return 16;
   83: 	else
   84: 		return 32;
   85: }
   86: 
   87: pcitag_t
   88: lca_make_tag(cpv, b, d, f)
   89: 	void *cpv;
   90: 	int b, d, f;
   91: {
   92: 
   93: 	return (b << 16) | (d << 11) | (f << 8);
   94: }
   95: 
   96: void
   97: lca_decompose_tag(cpv, tag, bp, dp, fp)
   98: 	void *cpv;
   99: 	pcitag_t tag;
  100: 	int *bp, *dp, *fp;
  101: {
  102: 
  103: 	if (bp != NULL)
  104: 		*bp = (tag >> 16) & 0xff;
  105: 	if (dp != NULL)
  106: 		*dp = (tag >> 11) & 0x1f;
  107: 	if (fp != NULL)
  108: 		*fp = (tag >> 8) & 0x7;
  109: }
  110: 
  111: pcireg_t
  112: lca_conf_read(cpv, tag, offset)
  113: 	void *cpv;
  114: 	pcitag_t tag;
  115: 	int offset;
  116: {
  117: 	struct lca_config *lcp = cpv;
  118: 	pcireg_t *datap, data;
  119: 	int s, secondary, device, ba;
  120: 
  121: #ifdef DIAGNOSTIC
  122: 	s = 0;					/* XXX gcc -Wuninitialized */
  123: #endif
  124: 
  125: 	/* secondary if bus # != 0 */
  126: 	pci_decompose_tag(&lcp->lc_pc, tag, &secondary, &device, 0);
  127: 	if (secondary) {
  128: 		s = splhigh();
  129: 		alpha_mb();
  130: 		REGVAL(LCA_IOC_CONF) = 0x01;
  131: 		alpha_mb();
  132: 	} else {
  133: 		/*
  134: 		 * on the LCA, must frob the tag used for
  135: 		 * devices on the primary bus, in the same ways
  136: 		 * as is used by type 1 configuration cycles
  137: 		 * on PCs.
  138: 		 */
  139: 		tag = (1 << (device + 11)) | (tag & 0x7ff);
  140: 	}
  141: 
  142: 	datap = (pcireg_t *)ALPHA_PHYS_TO_K0SEG(LCA_PCI_CONF |
  143: 	    tag << 5UL |					/* XXX */
  144: 	    (offset & ~0x03) << 5 |				/* XXX */
  145: 	    0 << 5 |						/* XXX */
  146: 	    0x3 << 3);						/* XXX */
  147: 	data = (pcireg_t)-1;
  148: 	if (!(ba = badaddr(datap, sizeof *datap)))
  149: 		data = *datap;
  150: 
  151: 	if (secondary) {
  152: 		alpha_mb();
  153: 		REGVAL(LCA_IOC_CONF) = 0x00;
  154: 		alpha_mb();
  155: 		splx(s);
  156: 	}
  157: 
  158: #if 0
  159: 	printf("lca_conf_read: tag 0x%lx, reg 0x%lx -> %x @ %p%s\n", tag, reg,
  160: 	    data, datap, ba ? " (badaddr)" : "");
  161: #endif
  162: 
  163: 	return data;
  164: }
  165: 
  166: void
  167: lca_conf_write(cpv, tag, offset, data)
  168: 	void *cpv;
  169: 	pcitag_t tag;
  170: 	int offset;
  171: 	pcireg_t data;
  172: {
  173: 	struct lca_config *lcp = cpv;
  174: 	pcireg_t *datap;
  175: 	int s, secondary, device;
  176: 
  177: #ifdef DIAGNOSTIC
  178: 	s = 0;					/* XXX gcc -Wuninitialized */
  179: #endif
  180: 
  181: 	/* secondary if bus # != 0 */
  182: 	pci_decompose_tag(&lcp->lc_pc, tag, &secondary, &device, 0);
  183: 	if (secondary) {
  184: 		s = splhigh();
  185: 		alpha_mb();
  186: 		REGVAL(LCA_IOC_CONF) = 0x01;
  187: 		alpha_mb();
  188: 	} else {
  189: 		/*
  190: 		 * on the LCA, must frob the tag used for
  191: 		 * devices on the primary bus, in the same ways
  192: 		 * as is used by type 1 configuration cycles
  193: 		 * on PCs.
  194: 		 */
  195: 		tag = (1 << (device + 11)) | (tag & 0x7ff);
  196: 	}
  197: 
  198: 	datap = (pcireg_t *)ALPHA_PHYS_TO_K0SEG(LCA_PCI_CONF |
  199: 	    tag << 5UL |					/* XXX */
  200: 	    (offset & ~0x03) << 5 |				/* XXX */
  201: 	    0 << 5 |						/* XXX */
  202: 	    0x3 << 3);						/* XXX */
  203: 	*datap = data;
  204: 
  205: 	if (secondary) {
  206: 		alpha_mb();
  207: 		REGVAL(LCA_IOC_CONF) = 0x00;	
  208: 		alpha_mb();
  209: 		splx(s);
  210: 	}
  211: 
  212: #if 0
  213: 	printf("lca_conf_write: tag 0x%lx, reg 0x%lx -> 0x%x @ %p\n", tag,
  214: 	    reg, data, datap);
  215: #endif
  216: }
