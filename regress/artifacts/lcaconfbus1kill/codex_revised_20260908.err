"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
import struct
from capstone import Cs, CS_ARCH_X86, CS_MODE_64
for filename in ('../build/gxemul', '../build-asan/gxemul'):
    blob = Path(filename).read_bytes()
    hdr = struct.unpack_from('<16sHHIQQQIHHHHHH', blob)
    sections = [struct.unpack_from('<IIQQQQIIQQ', blob, hdr[6] + i*hdr[11]) for i in range(hdr[12])]
    symbols = {}
    for sec in sections:
        if sec[1] "'!= 2: continue
        strsec = sections[sec[6]]
        strings = blob[strsec[4]:strsec[4]+strsec[5]]
        for off in range(sec[4], sec[4]+sec[5], sec[9]):
            sym = struct.unpack_from('"'<IBBHQQ', blob, off)
            name = strings[sym[0]:strings.index(0, sym[0])].decode()
            symbols[name] = sym
    names = {sym[4]:name for name,sym in symbols.items() if sym[4]}
    sym = symbols['dev_lca_pci_conf_access']
    sec = sections[sym[3]]
    fileoff = sec[4] + sym[4] - sec[3]
    print(filename, 'handler call sites:')
    for ins in Cs(CS_ARCH_X86, CS_MODE_64).disasm(blob[fileoff:fileoff+sym[5]], sym[4]):
        if ins.mnemonic not in ('call', 'jmp') or not ins.op_str.startswith('0x'): continue
        target = int(ins.op_str, 16)
        name = names.get(target, '')
        if name in ('bus_pci_setaddr','bus_pci_data_access'):
            print('  ', ins.mnemonic, name)
    for name in ('bus_pci_setaddr', 'bus_pci_data_access'):
        sym = symbols[name]
        sec = sections[sym[3]]
        fileoff = sec[4] + sym[4] - sec[3]
        insns = list(Cs(CS_ARCH_X86, CS_MODE_64).disasm(blob[fileoff:fileoff+sym[5]], sym[4]))
        print('  entry', name, ':', ' / '.join(i.mnemonic+' '+i.op_str for i in insns[:6]))
