   44: void		lca_attach_hook __P((struct device *, struct device *,
   45: 		    struct pcibus_attach_args *));
   46: int		lca_bus_maxdevs __P((void *, int));
   47: pcitag_t	lca_make_tag __P((void *, int, int, int));
   48: void		lca_decompose_tag __P((void *, pcitag_t, int *, int *,
   49: 		    int *));
