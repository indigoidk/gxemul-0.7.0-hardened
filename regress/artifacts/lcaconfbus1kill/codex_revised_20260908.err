  268: 				exit(1);
  269: 			}
  270: 		}
  271: 		break;
  272: 
  273: 	case LCA_IOC_W_BASE0:
  274: 		if (writeflag == MEM_READ) {
  275: 			odata = d->window_base_0;
  276: 		} else {
