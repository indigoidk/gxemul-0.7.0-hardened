  770: struct piix_ide_extra {
  771: 	void	*wdc0;
  772: 	void	*wdc1;
  773: };
  774: 
  775: int piix_ide_cfg_reg_write(struct pci_device *pd, int reg, uint32_t value)
  776: {
  777: 	void *wdc0 = ((struct piix_ide_extra *)pd->extra)->wdc0;
  778: 	void *wdc1 = ((struct piix_ide_extra *)pd->extra)->wdc1;
  779: 	int enabled = 0;
  780: 
  781: 	PCI_SET_DATA(reg, value);
  782: 
  783: 	switch (reg) {
  784: 	case PCI_COMMAND_STATUS_REG:
  785: 		if (value & PCI_COMMAND_IO_ENABLE)
  786: 			enabled = 1;
  787: 		if (wdc0 != NULL)
  788: 			wdc_set_io_enabled((struct wdc_data *) wdc0, enabled);
  789: 		if (wdc1 != NULL)
  790: 			wdc_set_io_enabled((struct wdc_data *) wdc1, enabled);
  791: 		return 1;
  792: 	case PCI_MAPREG_START:
  793: 	case PCI_MAPREG_START + 4:
  794: 	case PCI_MAPREG_START + 8:
  795: 	case PCI_MAPREG_START + 12:
  796: 	case PCI_MAPREG_START + 16:
  797: 	case PCI_MAPREG_START + 20:
  798: 		return 1;
  799: 	}
