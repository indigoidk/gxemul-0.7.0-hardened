 1068 struct symphony_82c105_extra {
 1069 	void	*wdc0;
 1070 	void	*wdc1;
 1071 };
 1072 
 1073 int symphony_82c105_cfg_reg_write(struct pci_device *pd, int reg,
 1074 	uint32_t value)
 1075 {
 1076 	void *wdc0 = ((struct symphony_82c105_extra *)pd->extra)->wdc0;
 1077 	void *wdc1 = ((struct symphony_82c105_extra *)pd->extra)->wdc1;
 1078 	int enabled = 0;
 1079 
 1080 printf("reg = 0x%x\n", reg);
 1081 	switch (reg) {
 1082 	case PCI_COMMAND_STATUS_REG:
 1083 		if (value & PCI_COMMAND_IO_ENABLE)
 1084 			enabled = 1;
 1085 printf("  value = 0x%" PRIx32"\n", value);
 1086 		if (wdc0 != NULL)
 1087 			wdc_set_io_enabled((struct wdc_data *) wdc0, enabled);
 1088 		if (wdc1 != NULL)
 1089 			wdc_set_io_enabled((struct wdc_data *) wdc1, enabled);
 1090 		/*  Set all bits:  */
 1091 		PCI_SET_DATA(reg, value);
 1092 		return 1;
 1093 	case PCI_MAPREG_START:
 1094 	case PCI_MAPREG_START + 4:
 1095 	case PCI_MAPREG_START + 8:
 1096 	case PCI_MAPREG_START + 12:
 1097 	case PCI_MAPREG_START + 16:
 1098 	case PCI_MAPREG_START + 20:
 1099 		PCI_SET_DATA(reg, value);
 1100 		return 1;
 1101 	}
 1102 
 1103 	return 0;
 1104 }
