 1004 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_MASS_STORAGE,
 1005 	    PCI_SUBCLASS_MASS_STORAGE_IDE, 0x00) + 0x01);
 1006 
 1007 	/*  APO_IDECONF  */
 1008 	/*  channel 0 and 1 enabled  */
 1009 	PCI_SET_DATA(0x40, 0x00000003);
 1010 
 1011 	CHECK_ALLOCATION(pd->extra = malloc(sizeof(struct vt82c586_ide_extra)));
 1012 	((struct vt82c586_ide_extra *)pd->extra)->wdc0 = NULL;
 1013 	((struct vt82c586_ide_extra *)pd->extra)->wdc1 = NULL;
