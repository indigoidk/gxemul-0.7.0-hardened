 1203 
 1204 PCIINIT(dec21143)
 1205 {
 1206 	uint64_t port, memaddr;
 1207 	int pci_int_line = 0x101, irq = 0, isa = 0;
 1208 	char irqstr[1000];
 1209 	char tmpstr[2000];
 1210 
 1211 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_DEC,
 1212 	    PCI_PRODUCT_DEC_21142));
 1213 
 1214 	PCI_SET_DATA(PCI_COMMAND_STATUS_REG, 0x02000017);
 1215 
 1216 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_NETWORK,
 1217 	    PCI_SUBCLASS_NETWORK_ETHERNET, 0x00) + 0x41);
 1218 
 1219 	PCI_SET_DATA(PCI_BHLC_REG, PCI_BHLC_CODE(0,0,0, 0x40,0));
 1220 
 1221 	switch (machine->machine_type) {
 1222 	case MACHINE_CATS:
 1223 		/*  CATS int 18 = PCI.  */
 1224 		irq = 18;
 1225 		pci_int_line = 0x101;
 1226 		break;
 1227 	case MACHINE_COBALT:
 1228 		/*  On Cobalt, IRQ 7 = PCI.  */
 1229 		irq = 8 + 7;
 1230 		pci_int_line = 0x407;
 1231 		break;
 1232 	case MACHINE_PREP:
 1233 		irq = 10;
 1234 		isa = 1;
 1235 		pci_int_line = 0x20a;
 1236 		break;
 1237 	case MACHINE_MVMEPPC:
 1238 		/*  TODO  */
 1239 		irq = 10;
 1240 		pci_int_line = 0x40a;
 1241 		break;
 1242 	case MACHINE_PMPPC:
 1243 		/*  TODO, not working yet  */
 1244 		irq = 31 - CPC_IB_EXT1;
 1245 		pci_int_line = 0x101;
 1246 		break;
 1247 	case MACHINE_MACPPC:
 1248 		/*  TODO, not working yet  */
 1249 		irq = 25;
 1250 		pci_int_line = 0x101;
 1251 		break;
 1252 	}
 1253 
 1254 	PCI_SET_DATA(PCI_INTERRUPT_REG, 0x28140000 | pci_int_line);
 1255 
 1256 	allocate_device_space(pd, 0x100, 0x100, &port, &memaddr);
 1257 
 1258 	if (isa)
 1259 		snprintf(irqstr, sizeof(irqstr), "%s.isa.%i",
 1260 		    pd->pcibus->irq_path_isa, irq);
 1261 	else
 1262 		snprintf(irqstr, sizeof(irqstr), "%s.%i",
 1263 		    pd->pcibus->irq_path_pci, irq);
 1264 
 1265 	snprintf(tmpstr, sizeof(tmpstr), "dec21143 addr=0x%llx addr2=0x%llx "
 1266 	    "irq=%s pci_little_endian=1", (long long)port,
 1267 	    (long long)memaddr, irqstr);
 1268 
 1269 	device_add(machine, tmpstr);
 1270 }
