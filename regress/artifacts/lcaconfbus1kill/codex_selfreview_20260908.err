  971 struct vt82c586_ide_extra {
  972 	void	*wdc0;
  973 	void	*wdc1;
  974 };
  975 
  976 int vt82c586_ide_cfg_reg_write(struct pci_device *pd, int reg, uint32_t value)
  977 {
  978 	void *wdc0 = ((struct vt82c586_ide_extra *)pd->extra)->wdc0;
  979 	void *wdc1 = ((struct vt82c586_ide_extra *)pd->extra)->wdc1;
  980 	int enabled = 0;
  981 
  982 	switch (reg) {
  983 	case PCI_COMMAND_STATUS_REG:
  984 		if (value & PCI_COMMAND_IO_ENABLE)
  985 			enabled = 1;
  986 		if (wdc0 != NULL)
  987 			wdc_set_io_enabled((struct wdc_data *) wdc0, enabled);
  988 		if (wdc1 != NULL)
  989 			wdc_set_io_enabled((struct wdc_data *) wdc1, enabled);
  990 		return 1;
  991 	}
  992 
  993 	return 0;
  994 }
