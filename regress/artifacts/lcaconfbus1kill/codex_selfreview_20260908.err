  573  *  device is added from the normal device instead of the other way around.
  574  */
  575 
  576 #define PCI_VENDOR_GALILEO           0x11ab    /* Galileo Technology */
  577 #define PCI_PRODUCT_GALILEO_GT64011  0x4146    /* GT-64011 System Controller */
  578 #define	PCI_PRODUCT_GALILEO_GT64120  0x4620    /* GT-64120 */
  579 #define	PCI_PRODUCT_GALILEO_GT64260  0x6430    /* GT-64260 */
  580 
  581 PCIINIT(gt64011)
  582 {
