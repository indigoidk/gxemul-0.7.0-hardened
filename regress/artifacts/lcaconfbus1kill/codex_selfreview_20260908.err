  657 /*
  658  *  Intel 31244   Serial ATA Controller
  659  *  Intel 82371SB PIIX3 PCI-ISA bridge
  660  *  Intel 82371AB PIIX4 PCI-ISA bridge
  661  *  Intel 82371SB IDE controller
  662  *  Intel 82371AB IDE controller
  663  *  Intel 82378ZB System I/O controller.
  664  */
  665 
  666 #define	PCI_VENDOR_INTEL		0x8086
  667 #define	PCI_PRODUCT_INTEL_31244		0x3200
  668 #define	PCI_PRODUCT_INTEL_82371SB_ISA	0x7000
  669 #define	PCI_PRODUCT_INTEL_82371SB_IDE	0x7010
  670 #define	PCI_PRODUCT_INTEL_82371AB_ISA	0x7110
  671 #define	PCI_PRODUCT_INTEL_82371AB_IDE	0x7111
  672 #define	PCI_PRODUCT_INTEL_SIO		0x0484
  673 
  674 PCIINIT(i31244)
  675 {
  676 	uint64_t port, memaddr;
  677 	int irq = 0;
  678 
  679 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_INTEL,
  680 	    PCI_PRODUCT_INTEL_31244));
  681 
  682 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_MASS_STORAGE,
  683 	    PCI_SUBCLASS_MASS_STORAGE_IDE, 0x33) + 0x00);
  684 
  685 	switch (machine->machine_type) {
  686 	case MACHINE_IQ80321:
  687 		/*  S-PCI-X slot uses PCI IRQ A, int 29  */
  688 		irq = (1 << 8) + 29;
  689 		break;
  690 	default:fatal("i31244 in non-implemented machine type %i\n",
  691 		    machine->machine_type);
  692 		exit(1);
  693 	}
  694 
  695 	PCI_SET_DATA(PCI_INTERRUPT_REG, 0x01100000 | irq);
  696 
  697 	allocate_device_space(pd, 0x1000, 0, &port, &memaddr);
  698 	allocate_device_space(pd, 0x1000, 0, &port, &memaddr);
  699 
  700 	/*  PCI IDE using dev_wdc:  */
  701 	if (diskimage_exist(machine, 0, DISKIMAGE_IDE) ||
  702 	    diskimage_exist(machine, 1, DISKIMAGE_IDE)) {
  703 		char tmpstr[2000];
  704 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx irq=%s.%i",
  705 		    (long long)(pd->pcibus->pci_actual_io_offset + 0),
  706 		    pd->pcibus->irq_path_pci, irq & 255);
  707 		device_add(machine, tmpstr);
  708 	}
  709 }
  710 
  711 int piix_isa_cfg_reg_write(struct pci_device *pd, int reg, uint32_t value)
  712 {
  713 	switch (reg) {
  714 	case PCI_MAPREG_START:
  715 	case PCI_MAPREG_START + 4:
  716 	case PCI_MAPREG_START + 8:
  717 	case PCI_MAPREG_START + 12:
  718 	case PCI_MAPREG_START + 16:
  719 	case PCI_MAPREG_START + 20:
  720 		PCI_SET_DATA(reg, value);
  721 		return 1;
  722 	}
  723 
  724 	return 0;
  725 }
