  731 
  732 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_BRIDGE,
  733 	    PCI_SUBCLASS_BRIDGE_ISA, 0) + 0x01);	/*  Rev 1  */
  734 
  735 	PCI_SET_DATA(PCI_BHLC_REG,
  736 	    PCI_BHLC_CODE(0,0, 1 /* multi-function */, 0x40,0));
  737 }
  738 
  739 PCIINIT(piix4_isa)
  740 {
  741 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_INTEL,
  742 	    PCI_PRODUCT_INTEL_82371AB_ISA));
  743 
  744 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_BRIDGE,
  745 	    PCI_SUBCLASS_BRIDGE_ISA, 0) + 0x01);	/*  Rev 1  */
  746 
  747 	PCI_SET_DATA(PCI_BHLC_REG,
  748 	    PCI_BHLC_CODE(0,0, 1 /* multi-function */, 0x40,0));
  749 
  750 	pd->cfg_reg_write = piix_isa_cfg_reg_write;
  751 }
  752 
  753 PCIINIT(i82378zb)
  754 {
  755 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_INTEL,
  756 	    PCI_PRODUCT_INTEL_SIO));
  757 
  758 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_BRIDGE,
  759 	    PCI_SUBCLASS_BRIDGE_ISA, 0) + 0x43);
  760 
  761 	PCI_SET_DATA(PCI_BHLC_REG,
  762 	    PCI_BHLC_CODE(0,0, 1 /* multi-function */, 0x40,0));
  763 
  764 	PCI_SET_DATA(0x40, 0x20);
  765 
  766 	/*  PIRQ[0]=10 PIRQ[1]=11 PIRQ[2]=14 PIRQ[3]=15  */
  767 	PCI_SET_DATA(0x60, 0x0f0e0b0a);
  768 }
  769 
  770 struct piix_ide_extra {
  771 	void	*wdc0;
  772 	void	*wdc1;
  773 };
  774 
  775 int piix_ide_cfg_reg_write(struct pci_device *pd, int reg, uint32_t value)
  776 {
  777 	void *wdc0 = ((struct piix_ide_extra *)pd->extra)->wdc0;
  778 	void *wdc1 = ((struct piix_ide_extra *)pd->extra)->wdc1;
  779 	int enabled = 0;
  780 
  781 	PCI_SET_DATA(reg, value);
  782 
  783 	switch (reg) {
  784 	case PCI_COMMAND_STATUS_REG:
  785 		if (value & PCI_COMMAND_IO_ENABLE)
  786 			enabled = 1;
  787 		if (wdc0 != NULL)
  788 			wdc_set_io_enabled((struct wdc_data *) wdc0, enabled);
  789 		if (wdc1 != NULL)
  790 			wdc_set_io_enabled((struct wdc_data *) wdc1, enabled);
  791 		return 1;
  792 	case PCI_MAPREG_START:
  793 	case PCI_MAPREG_START + 4:
  794 	case PCI_MAPREG_START + 8:
  795 	case PCI_MAPREG_START + 12:
  796 	case PCI_MAPREG_START + 16:
  797 	case PCI_MAPREG_START + 20:
  798 		return 1;
  799 	}
  800 
  801 	return 0;
  802 }
  803 
  804 PCIINIT(piix3_ide)
  805 {
  806 	char tmpstr[2000];
  807 
  808 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_INTEL,
  809 	    PCI_PRODUCT_INTEL_82371SB_IDE));
  810 
  811 	/*  Possibly not correct:  */
  812 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_MASS_STORAGE,
  813 	    PCI_SUBCLASS_MASS_STORAGE_IDE, 0x00) + 0x00);
  814 
  815 	/*  PIIX_IDETIM (see NetBSD's pciide_piix_reg.h)  */
  816 	/*  channel 0 and 1 enabled as IDE  */
  817 	PCI_SET_DATA(0x40, 0x80008000);
  818 
  819 	CHECK_ALLOCATION(pd->extra = malloc(sizeof(struct piix_ide_extra)));
  820 	((struct piix_ide_extra *)pd->extra)->wdc0 = NULL;
  821 	((struct piix_ide_extra *)pd->extra)->wdc1 = NULL;
  822 
  823 	if (diskimage_exist(machine, 0, DISKIMAGE_IDE) ||
  824 	    diskimage_exist(machine, 1, DISKIMAGE_IDE)) {
  825 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx "
  826 		    "irq=%s.isa.%i", (long long)(pd->pcibus->isa_portbase +
  827 		    0x1f0), pd->pcibus->irq_path_isa, 14);
  828 		((struct piix_ide_extra *)pd->extra)->wdc0 =
  829 		    device_add(machine, tmpstr);
  830 	}
  831 
  832 	if (diskimage_exist(machine, 2, DISKIMAGE_IDE) ||
  833 	    diskimage_exist(machine, 3, DISKIMAGE_IDE)) {
  834 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx "
  835 		    "irq=%s.isa.%i", (long long)(pd->pcibus->isa_portbase +
  836 		    0x170), pd->pcibus->irq_path_isa, 15);
  837 		((struct piix_ide_extra *)pd->extra)->wdc1 =
  838 		    device_add(machine, tmpstr);
  839 	}
  840 
  841 	pd->cfg_reg_write = piix_ide_cfg_reg_write;
  842 }
  843 
  844 PCIINIT(piix4_ide)
  845 {
  846 	char tmpstr[2000];
  847 
  848 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_INTEL,
  849 	    PCI_PRODUCT_INTEL_82371AB_IDE));
  850 
  851 	/*  Possibly not correct:  */
  852 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_MASS_STORAGE,
  853 	    PCI_SUBCLASS_MASS_STORAGE_IDE, 0x80) + 0x01);
  854 
  855 	/*  PIIX_BMIBA (see NetBSD's pciide_piix_reg.h)  */
  856 	/*  2009-05-18: Needs to have the lowest bit set, or Linux/Malta
  857 	    crashes.  */
  858 	PCI_SET_DATA(0x20, 1);
  859 
  860 	/*  PIIX_IDETIM (see NetBSD's pciide_piix_reg.h)  */
  861 	/*  channel 0 and 1 enabled as IDE  */
  862 	PCI_SET_DATA(0x40, 0x80008000);
  863 
  864 	CHECK_ALLOCATION(pd->extra = malloc(sizeof(struct piix_ide_extra)));
  865 	((struct piix_ide_extra *)pd->extra)->wdc0 = NULL;
  866 	((struct piix_ide_extra *)pd->extra)->wdc1 = NULL;
  867 
  868 	if (diskimage_exist(machine, 0, DISKIMAGE_IDE) ||
  869 	    diskimage_exist(machine, 1, DISKIMAGE_IDE)) {
  870 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx irq=%s."
  871 		    "isa.%i", (long long)(pd->pcibus->isa_portbase + 0x1f0),
  872 		    pd->pcibus->irq_path_isa, 14);
  873 		((struct piix_ide_extra *)pd->extra)->wdc0 =
  874 		    device_add(machine, tmpstr);
  875 	}
  876 
  877 	if (diskimage_exist(machine, 2, DISKIMAGE_IDE) ||
  878 	    diskimage_exist(machine, 3, DISKIMAGE_IDE)) {
  879 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx irq=%s."
  880 		    "isa.%i", (long long)(pd->pcibus->isa_portbase + 0x170),
  881 		    pd->pcibus->irq_path_isa, 15);
  882 		((struct piix_ide_extra *)pd->extra)->wdc1 =
  883 		    device_add(machine, tmpstr);
  884 	}
  885 
  886 	pd->cfg_reg_write = piix_ide_cfg_reg_write;
  887 }
