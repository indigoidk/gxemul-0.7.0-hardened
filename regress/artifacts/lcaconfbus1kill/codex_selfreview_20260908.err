  932 
  933 /*
  934  *  VIATECH VT82C586 devices:
  935  *
  936  *	vt82c586_isa	PCI->ISA bridge
  937  *	vt82c586_ide	IDE controller
  938  *
  939  *  TODO:  This more or less just a dummy device, so far.
  940  */
  941 
  942 #define PCI_VENDOR_VIATECH                0x1106  /* VIA Technologies */
  943 #define PCI_PRODUCT_VIATECH_VT82C586_IDE  0x1571  /* VT82C586 (Apollo VP)
  944 					             IDE Controller */
  945 #define PCI_PRODUCT_VIATECH_VT82C586_ISA  0x0586  /* VT82C586 (Apollo VP)
  946 						     PCI-ISA Bridge */
  947 
  948 PCIINIT(vt82c586_isa)
  949 {
  950 	PCI_SET_DATA(PCI_ID_REG, PCI_ID_CODE(PCI_VENDOR_VIATECH,
  951 	    PCI_PRODUCT_VIATECH_VT82C586_ISA));
  952 
  953 	PCI_SET_DATA(PCI_CLASS_REG, PCI_CLASS_CODE(PCI_CLASS_BRIDGE,
  954 	    PCI_SUBCLASS_BRIDGE_ISA, 0) + 0x39);   /*  Revision 37 or 39  */
  955 
  956 	PCI_SET_DATA(PCI_BHLC_REG,
  957 	    PCI_BHLC_CODE(0,0, 1 /* multi-function */, 0x40,0));
  958 
  959 	/*
  960 	 *  NetBSD/cobalt specific: bits 7..4 are the "model id". See
  961 	 *  netbsd/usr/src/sys/arch/cobalt/cobalt/machdep.c read_board_id()
  962 	 *  for details.
  963 	 */
  964 	if (machine->machine_type == MACHINE_COBALT) {
  965 #define	COBALT_PCIB_BOARD_ID_REG	0x94
