   89 DEVICE_ACCESS(lca_pci_conf)
   90 {
   91 	uint64_t idata = 0, odata = 0;
   92 	int tag, bus, dev, func, reg;
   93 	struct lca_data *d = (struct lca_data *) extra;
   94 
   95 	if (writeflag == MEM_WRITE)
   96 		idata = memory_readmax64(cpu, data, len);
   97 
   98 	/*
   99 	 *  1. Decompose the address into a tag.
  100 	 *
  101 	 *  According to NetBSD's lca_pci.c, the address is composed like this:
  102 	 *
  103 	 *	addr = tag << 5 | (regoffset & ~0x03) << 5 | 0x3 << 3
  104 	 */
  105 	reg = (relative_addr >> 5) & 0xfc;
  106 	tag = (relative_addr >> 5) & ~0xff;
  107 
  108 	/*
  109 	 *  2. Decompose the tag into bus, dev, and func.
  110 	 *
  111 	 *  The tag can be constructed in one of two ways. On the primary
  112 	 *  bus (nr 0):
  113 	 *
  114 	 *	tag = (1 << (device + 11)) | (function << 8);
  115 	 *
  116 	 *  and on other busses, the tag is a normal:
  117 	 *
  118 	 *	tag = (bus << 16) | (device << 11) | (function << 8)
  119 	 */
  120 	/*  printf("tag = 0x%x\n", (int)tag);  */
  121 	bus = d->ioc_conf & 1;
  122 
  123 	if (bus == 0) {
  124 		/*  #511: was `0x800 << dev'.  `0x800' is a plain int (2^11) and `dev'
  125 		    reaches 20, so the last iteration evaluates 2^31 -- a SIGNED
  126 		    OVERFLOW, undefined by C99 6.5.7p4, not merely
  127 		    implementation-defined.  MEASURED under UBSAN before the change:
  128 		    "dev_lca.c:125:21: runtime error: left shift of 2048 by 20 places
  129 		    cannot be represented in type 'int'", reached by an ordinary guest
  130 		    ldq into the PCI config window (regress/lca_confbus_probe.py against
  131 		    build-asan; artifacts/lcashiftub/ubsan_HEAD_20260907.raw).
  132 
  133 		    `0x800U' makes the operand unsigned, so 2048U << 20 is 0x80000000U --
  134 		    inside unsigned int -- and NOTHING ELSE MOVES.
  135 
  136 		    *** THE REASON, CORRECTED: AN EARLIER DRAFT SAID `tag' IS "ALREADY A
  137 		    WIDER UNSIGNED QUANTITY".  THAT IS FALSE -- `tag' is a plain signed
  138 		    `int' (:92) -- AND FOUR PASS-2 SEATS CAUGHT IT.  Worse, the claim was
  139 		    backwards: being WIDER is what would CREATE a difference, not remove
  140 		    one.  Had `tag' been `uint64_t', the old `int' 0x80000000 is NEGATIVE
  141 		    and would SIGN-EXTEND to 0xffffffff80000000 for the `&', while
  142 		    `0x800U << 20' zero-extends to 0x0000000080000000 -- two different
  143 		    masks.  The seats were right about the mechanism and it does not fire
  144 		    here only because of the type.
  145 
  146 		    WHAT ACTUALLY HOLDS: both operands are 32-bit, so the `&' is performed
  147 		    at 32 bits either way -- `int & int' before, and after, `tag' converted
  148 		    to `unsigned int' by the usual arithmetic conversions.  The RESULT'S
  149 		    BIT PATTERN IS IDENTICAL; only its type changes, and it is consumed
  150 		    solely as a truth test in `if (...)'.  So no guest-visible value moves,
  151 		    and the repair is owed purely by the LANGUAGE. ***
  152 
  153 		    *** THE LOOP THIS SITS IN IS THIS FILE'S OWN GRACEFUL-DEGRADATION
  154 		    PRECEDENT -- the `dev >= 21' arm below has a commented-out
  155 		    fatal()/exit(1) and substitutes `dev = 0' instead, and `lcabadval'
  156 		    cites it as a transferable warrant.  The safe path contained the UB. ***  */
  157 		for (dev=0; dev<21; dev++)
  158 			if (tag & (0x800U << dev))	/*  #511  */
  159 				break;
  160 		if (dev >= 21) {
  161 			/*  fatal("[ LCA: No bus 0 device? TODO ]\n");
  162 			exit(1);  */
  163 			dev = 0;
  164 		}
  165 	} else {
  166 		fatal("TODO. Non-zero bus.\n");
  167 		exit(1);
  168 	}
  169 
  170 	func = (tag >> 8) & 7;
  171 	/*  printf("bus=%i dev=%i func=%i reg=%i\n", bus,dev,func,reg);  */
  172 
  173 	/*  Pass PCI accesses onto bus_pci:  */
  174 	bus_pci_setaddr(cpu, d->pci_data, bus, dev, func, reg);
  175 	bus_pci_data_access(cpu, d->pci_data, writeflag == MEM_READ?
  176 	    &odata : &idata, len, writeflag);
  177 
  178 	if (writeflag == MEM_READ)
  179 		memory_writemax64(cpu, data, len, odata);
  180 
  181 	return 1;
  182 }
  183 
  184 
  185 DEVICE_ACCESS(lca_isa)
  186 {
  187 	unsigned int ofs, i;
  188 	uint8_t byte;
  189 
  190 	relative_addr >>= 5;
  191 
  192 	ofs = relative_addr & 3;
  193 	if (ofs > len) {
  194 		fatal("[ ofs=%i len=%i in lca_isa access function. "
  195 		    "aborting ]\n", ofs, len);
  196 		exit(1);
  197 	}
  198 
  199 	if (writeflag == MEM_WRITE) {
  200 		byte = data[ofs % len];
  201 		return cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE +
  202 		    relative_addr, &byte, 1, writeflag, CACHE_NONE);
  203 	}
  204 
  205 	cpu->memory_rw(cpu, cpu->mem, LCA_ISA_BASE + relative_addr,
  206 	    &byte, 1, MEM_READ, CACHE_NONE);
  207 
  208 	for (i=0; i<len; i++)
  209 		data[i] = i == ofs? byte : 0x00;
  210 
  211 	return 1;
  212 }
  213 
  214 
  215 DEVICE_ACCESS(lca_ioc)
  216 {
  217 	uint64_t idata = 0, odata = 0;
  218 	struct lca_data *d = (struct lca_data *) extra;
  219 
  220 	if (writeflag == MEM_WRITE)
  221 		idata = memory_readmax64(cpu, data, len);
  222 
  223 	switch (relative_addr + LCA_IOC_BASE) {
  224 
  225 	case LCA_IOC_BASE:
  226 		/*  Ignore? Linux reads from the base at startup.  */
  227 		break;
  228 
  229 	case LCA_IOC_CONF:
  230 		if (writeflag == MEM_READ) {
  231 			odata = d->ioc_conf;
  232 		} else {
  233 			d->ioc_conf = idata;
  234 			/*  Only bit 0 is implemented so far, the PCI bus 0 vs
  235 			    bus non-0 selection bit.  */
  236 			if (idata & ~1) {
  237 				/*  #506: was `0x%x', (int)idata -- a 64-bit guarded value
  238 				    narrowed to 32 in the KILL diagnostic, so a write of
  239 				    0x100000000 trips `idata & ~1' and then reports "0x0",
  240 				    which is a value this same guard ACCEPTS.  The five
  241 				    sibling arms below already print the full width this
  242 				    way; this arm was the outlier among the VALUE-guard
  243 				    diagnostics.  (Not the file's only narrowing site --
  244 				    the default arm below has the same cast, and this
  245 				    round fixes it too.)  */
  246 				fatal("TODO: Write to unimplemented bit of"
  247 				    " IOC_CONF: 0x%" PRIx64 "\n", (uint64_t)idata);
  248 				exit(1);
  249 			}
  250 		}
  251 		break;
  252 
  253 	case LCA_IOC_TBIA:
  254 		/*  TLB Invalidate All.  */
  255 		/*  TODO: For now, let's just ignore it.  */
  256 		break;
  257 
  258 	case LCA_IOC_TB_ENA:
  259 		if (writeflag == MEM_READ) {
  260 			odata = d->tlb_enable;
  261 		} else {
  262 			d->tlb_enable = idata;
  263 			/*  TODO: Actually implement this.  */
  264 			if (idata & ~IOC_TB_ENA_TEN) {
  265 				fatal("TODO: LCA_IOC_TB_ENA value "
  266 				    " (0x%" PRIx64") has unimplemented "
  267 				    "bits.\n", (uint64_t)idata);
  268 				exit(1);
  269 			}
  270 		}
  271 		break;
  272 
  273 	case LCA_IOC_W_BASE0:
  274 		if (writeflag == MEM_READ) {
  275 			odata = d->window_base_0;
  276 		} else {
  277 			d->window_base_0 = idata;
  278 			/*  TODO: Actually implement this.  */
  279 			if (idata != 0ULL && idata != 0x300800000ULL) {
  280 				fatal("TODO: LCA_IOC_W_BASE0 value differs"
  281 				    " (0x%" PRIx64") from the only implemented"
  282 				    " values\n", (uint64_t)idata);
  283 				exit(1);
  284 			}
  285 		}
  286 		break;
  287 
  288 	case LCA_IOC_W_MASK0:
  289 		if (writeflag == MEM_READ) {
  290 			odata = d->window_mask_0;
  291 		} else {
  292 			d->window_mask_0 = idata;
  293 			/*  TODO: Actually implement this.  */
  294 			if (idata != 0x700000ULL) {
  295 				fatal("TODO: LCA_IOC_W_MASK0 value differs"
  296 				    " (0x%" PRIx64") from the only implemented"
  297 				    " value\n", (uint64_t)idata);
  298 				exit(1);
  299 			}
  300 		}
  301 		break;
  302 
  303 	case LCA_IOC_W_T_BASE0:
  304 		if (writeflag == MEM_READ) {
  305 			odata = d->window_t_base_0;
  306 		} else {
  307 			d->window_t_base_0 = idata;
  308 			/*  TODO: Actually implement this.  */
  309 		}
  310 		break;
  311 
  312 	case LCA_IOC_W_BASE1:
  313 		if (writeflag == MEM_READ) {
  314 			odata = d->window_base_1;
  315 		} else {
  316 			d->window_base_1 = idata;
  317 			/*  TODO: Actually implement this.  */
  318 			if (idata != 0x240000000ULL) {
  319 				fatal("TODO: LCA_IOC_W_BASE1 value differs"
  320 				    " (0x%" PRIx64") from the only implemented"
  321 				    " value\n", (uint64_t)idata);
  322 				exit(1);
  323 			}
  324 		}
  325 		break;
  326 
  327 	case LCA_IOC_W_MASK1:
  328 		if (writeflag == MEM_READ) {
  329 			odata = d->window_mask_1;
  330 		} else {
  331 			d->window_mask_1 = idata;
  332 			/*  TODO: Actually implement this.  */
  333 			if (idata != 0x3ff00000ULL) {
  334 				fatal("TODO: LCA_IOC_W_MASK1 value differs"
  335 				    " (0x%" PRIx64") from the only implemented"
  336 				    " value\n", (uint64_t)idata);
  337 				exit(1);
  338 			}
  339 		}
  340 		break;
  341 
  342 	case LCA_IOC_W_T_BASE1:
  343 		if (writeflag == MEM_READ) {
  344 			odata = d->window_t_base_1;
  345 		} else {
  346 			d->window_t_base_1 = idata;
  347 			/*  TODO: Actually implement this.  */
  348 		}
  349 		break;
  350 
  351 	default:fatal("[ lca_ioc: unimplemented %s to offset 0x%x",
  352 		    writeflag == MEM_WRITE? "write" : "read", (int)
  353 		    relative_addr);
  354 		if (writeflag == MEM_WRITE)
  355 			fatal(": 0x%" PRIx64, (uint64_t)idata);	/*  #506  */
  356 		fatal(" ]\n");
  357 		exit(1);
  358 	}
  359 
  360 	if (writeflag == MEM_READ)
  361 		memory_writemax64(cpu, data, len, odata);
  362 
  363 	return 1;
  364 }
