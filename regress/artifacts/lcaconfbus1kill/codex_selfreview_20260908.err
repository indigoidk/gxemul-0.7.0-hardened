 1015 	if (diskimage_exist(machine, 0, DISKIMAGE_IDE) ||
 1016 	    diskimage_exist(machine, 1, DISKIMAGE_IDE)) {
 1017 		snprintf(tmpstr, sizeof(tmpstr), "wdc addr=0x%llx irq=%s."
 1018 		    "isa.%i", (long long)(pd->pcibus->isa_portbase + 0x1f0),
 1019 		    pd->pcibus->irq_path_isa, 14);
 1020 		((struct vt82c586_ide_extra *)pd->extra)->wdc0 =
 1021 		    device_add(machine, tmpstr);
