622:
623:class Emu(object):
624:    def __init__(self, argv, boot_wait=5.0):
625:        self.buf = bytearray()
626:        self.pid, self.fd = pty.fork()
627:        if self.pid == 0:
628:            try:
629:                os.execvp(argv[0], argv)
630:            finally:
631:                os._exit(127)
632:        self.drain(boot_wait)
633:
634:    def drain(self, seconds):
635:        end = time.time() + seconds
636:        while time.time() < end:
637:            r, _, _ = select.select([self.fd], [], [], 0.05)
638:            if self.fd in r:
639:                try:
640:                    d = os.read(self.fd, 65536)
641:                except OSError:
642:                    return
643:                if not d:
644:                    return
645:                self.buf.extend(d)
646:
647:    def send(self, cmd, wait=0.4):
648:        start = len(self.buf)
649:        data = (cmd + "\n").encode()
650:        view = memoryview(data)
651:        while len(view):
652:            n = os.write(self.fd, view)
653:            view = view[n:]
654:            if len(view):
655:                self.drain(0.05)
656:        self.drain(wait)
657:        return bytes(self.buf[start:]).decode("latin1", "replace")
658:
659:    def close(self, log):
660:        try:
661:            os.write(self.fd, b"quit\n")
662:            self.drain(0.4)
663:        except OSError:
664:            pass
665:        for fn in (lambda: os.close(self.fd),
666:                   lambda: os.kill(self.pid, 9),
667:                   lambda: os.waitpid(self.pid, 0)):
668:            try:
669:                fn()
670:            except OSError:
671:                pass
672:        with open(log, "w") as f:
673:            f.write(bytes(self.buf).decode("latin1", "replace"))
674:
675:
676:def reg(emu, name):
677:    for _ in range(5):
678:        out = emu.send("print %s" % name, wait=0.35)
679:        m = re.findall(r"0x[0-9a-fA-F]+", out)
680:        if m:
681:            return int(m[-1], 16)
682:        emu.drain(0.25)
683:    return None
684:
685:
686:def run_one(binary, tag):
687:    argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
688:            "-d", "ciR:" + CD, "0x%x:%s" % (BASE, RAWBIN)]
689:    print("  command   " + " ".join(argv))
690:    emu = Emu(argv)
691:
692:    # CONTROL 0 -- hand-assembled words checked against the emulator's own
693:    # disassembler.  Addresses print WITHOUT an 0x prefix.
694:    dis = emu.send("unassemble 0x%x 0x%x" % (BASE, BASE + len(prog) * 4), wait=2.5)
695:    seen = {}
696:    for line in dis.splitlines():
697:        m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
698:        if m:
699:            seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
700:
701:    word_ok = word_bad = mn_ok = mn_bad = 0
702:    bad_lines = []
703:    for i, (w, want_mn) in enumerate(prog):
704:        addr = (BASE + i * 4) & 0xffffffff
705:        hit = seen.get(addr)
706:        if hit is None:
707:            word_bad += 1
708:            mn_bad += 1
709:            bad_lines.append("  BAD  0x%08x  no disassembly line" % addr)
710:            continue
711:        gotw, gotmn = hit
712:        norm = " ".join(gotmn.replace("\t", " ").split())
713:        want_norm = " ".join(want_mn.split())
714:        if gotw == "%08x" % w:
715:            word_ok += 1
716:        else:
717:            word_bad += 1
718:            bad_lines.append("  BADWORD 0x%08x  %s vs %08x" % (addr, gotw, w))
719:        if norm.startswith(want_norm):
720:            mn_ok += 1
721:        else:
722:            mn_bad += 1
723:            bad_lines.append("  MNEMONIC 0x%08x  %r vs want %r" % (addr, norm, want_norm))
724:    print("  CONTROL 0  words %d of %d ; mnemonics %d of %d agree with the"
725:          " emulator's disassembler" % (word_ok, len(prog), mn_ok, len(prog)))
726:    for l in bad_lines[:14]:
727:        print(l)
728:
729:    pc0 = reg(emu, "pc")
730:    print("  pc at entry = %s (want 0x%016x)"
731:          % (("0x%016x" % pc0) if pc0 is not None else "UNREADABLE", BASE))
732:
733:    emu.send("breakpoint add 0x%x" % HALT_ADDR, wait=0.5)
734:    t = time.time()
735:    emu.send("continue", wait=1.0)
736:    deadline = time.time() + 300
737:    hit = False
738:    while time.time() < deadline:
739:        emu.drain(0.5)
740:        tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
741:        #  *** MATCH THE HIT LINE, NOT THE BARE WORD. ***  This read
742:        #  `if "BREAKPOINT" in <tail>.upper():` until 2026-08-30, and the
743:        #  transcript contains the probe's OWN echoed setup command,
744:        #  `breakpoint add 0x...`.  The check matched its own input and could
745:        #  never return False.  It was right by accident in every run where the
746:        #  guest parked, and silently wrong in the first run where it did not:
747:        #  a mutant returning 0 from the device handler raises EXCEPTION_DBE, the
748:        #  guest re-executes the faulting store forever, and the probe still
749:        #  reported `breakpoint reached: True` with every register reading ??.
750:        #  That was scored as a KILL -- a failed run counted as a table result.
751:        #  The emulator prints `BREAKPOINT: pc = 0x...` on a real hit.
752:        if "BREAKPOINT: PC" in tail.upper():
753:            hit = True
754:            break
755:    elapsed = time.time() - t
756:    if not hit:
757:        print("  *** BREAKPOINT NOT REACHED within 300 s"
758:              " -- rows below are NOT a measurement")
759:
760:    got = {}
761:    for nm in REGS:
762:        v = reg(emu, nm)
763:        got[nm] = None if v is None else (v & 0xff)
764:
765:    whole = bytes(emu.buf).decode("latin1", "replace")
766:    diags = {n: whole.count(n) for n in
767:             ("wdc inbuf overrun", "write to DATA, but not", "reading too much",
768:              "ATAPI command rejected", "DATA OUT")}
769:    emu.close(os.path.join(LOGDIR, "transcript_%s.log" % tag))
770:    return got, elapsed, hit, diags
771:
772:
773:def main():
774:    os.makedirs(LOGDIR, exist_ok=True)
775:    with open(RAWBIN, "wb") as f:
776:        for w, _ in prog:
777:            f.write(bytes([w & 0xff, (w >> 8) & 0xff,
778:                           (w >> 16) & 0xff, (w >> 24) & 0xff]))
779:
780:    print("=" * 94)
781:    print("wdcaddtoinbufbound -- RUNG-3 WITNESS on unmodified `evbmips -e malta`")
782:    print("=" * 94)
783:    print("machine   evbmips -e malta  5Kc, little endian, 128 MB (machine desc UNMODIFIED)")
784:    print("wdc       physical 0x180001f0 via bus_pci piix4_ide; KSEG1 0xffffffffb80001f0")
785:    print("media     -d ciR:%s  (CD-ROM, IDE, read-only)" % CD)
786:    print("program   %d guest instructions at 0x%016x, parks at 0x%016x"
787:          % (len(prog), BASE, HALT_ADDR))
788:    print("transfer  READ(10) LBA 0 x %d blocks of 512 = %d B; chunk 1 = 32768"
789:          % (READ_BLOCKS, READ_BLOCKS * 512))
790:    print("inject    ONE 2-byte store of 0x%04x while atapi_phase == PHASE_DATAIN" % INJECT)
791:    print()
792:
793:    print("-" * 94)
794:    #  *** PRINT THE BINARY YOU WERE HANDED, NOT A FROZEN CLAIM ABOUT WHICH REVISION
795:    #  IT CAME FROM.  This line read "source-identical to GXEMUL-SEC at HEAD c125450"
796:    #  -- an assertion about an INPUT the probe cannot see, and FALSE in all thirteen
797:    #  of wdcatapistswap's own preserved logs, whose base leg was pinned to a
798:    #  different revision entirely. ***
799:    #
800:    #  Behaviourally immaterial there -- the difference was comment-only, and the
801:    #  driver `cmp`-pins its source honestly -- but it is this file's own header
802:    #  lesson, one screen below the paragraph that teaches it: a frozen claim goes
803:    #  false the first time anyone touches the thing it names, and nothing re-reads a
804:    #  print statement.  Found by the fable5 regress review.
805:    print("LEG 1 -- SHIPPED build: %s" % SHIPPED_BIN)
806:    print("-" * 94)
807:    ship, t_ship, hit_s, dg_s = run_one(SHIPPED_BIN, "shipped")
808:    print("  elapsed %.2f s   breakpoint reached: %s" % (t_ship, hit_s))
809:    print("  diagnostics seen: %s" % dg_s)
810:    print()
811:
812:    print("-" * 94)
813:    print("LEG 2 -- %s build, SAME guest program, SAME image" % FIXTAG)
814:    print("-" * 94)
815:    fix, t_fix, hit_f, dg_f = run_one(FIXED_BIN, FIXTAG)
816:    print("  elapsed %.2f s   breakpoint reached: %s" % (t_fix, hit_f))
817:    print("  diagnostics seen: %s" % dg_f)
818:    print()
819:
820:    print("-" * 94)
821:    print("RESULTS -- every value below was produced by a GUEST LOAD through real decode")
822:    print("-" * 94)
823:    print("  %-52s %-4s %-16s %-16s" % ("", "reg", "SHIPPED", FIXTAG.upper()))
824:    npass = nfail = 0
825:    changed = []
826:    for label, rn, wship, wfix, kind in ROWS:
827:        gs, gf = ship.get(rn), fix.get(rn)
828:        oks, okf = (gs == wship), (gf == wfix)
829:        npass += oks + okf
830:        nfail += (not oks) + (not okf)
831:        if wship != wfix:
832:            changed.append((label, rn, wship, wfix, gs, gf))
833:        print("  %-52s %-4s want %02x got %-4s want %02x got %-4s  %s"
834:              % (label, rn, wship, ("%02x" % gs) if gs is not None else "??",
835:                 wfix, ("%02x" % gf) if gf is not None else "??",
836:                 ("ok" if (oks and okf) else "FAIL")))
837:    print()
838:    print("  %d of %d predictions correct across both legs" % (npass, npass + nfail))
839:    print()
840:
841:    print("-" * 94)
842:    print("THE DIFFERENTIAL -- the rows the defect owns, same script, opposite colour")
843:    print("-" * 94)
844:    for label, rn, wship, wfix, gs, gf in changed:
845:        print("  %-52s %-4s  %02x -> %02x   %s"
846:              % (label, rn, gs if gs is not None else 0, gf if gf is not None else 0,
847:                 "AS PREDICTED" if (gs == wship and gf == wfix) else "MISMATCH"))
848:    print()
849:    print("-" * 94)
850:    print("WHY THIS IS THE DEVICE AND NOT RAM  (device-signature control)")
851:    print("-" * 94)
852:    print("  s0/s1 read the SAME address twice and returned 0x%02x then 0x%02x."
853:          % (ship.get("s0") or 0, ship.get("s1") or 0))
854:    print("  A memory cell returns the last value written to BOTH reads (a5,a5).")
855:    print("  Push order (5a,a5) can only come from a FIFO -- the wdc inbuf ring.")
856:    print("  And row D returned 0x%02x, the poisoned CD image byte at offset 0,"
857:          % (ship.get("s3") or 0))
858:    print("  so the ring demonstrably holds real DISK data, not device scratch.")
859:    print()
860:    print("ADDTOINBUF_RUNG3_DONE")
861:
862:
863:main()

