584:    ("B  DEVICE SIGNATURE 2nd read -- a FIFO, not a cell", "s1", 0xa5, 0xa5, "control"),
585:    ("C  LIVENESS         status with chunk 1 queued", "s2", ST_DATAIN, ST_DATAIN, "control"),
586:    ("D  DISK CONTENT     chunk 1 byte 0 (image[0])", "s3", 0xC0, 0xC0, "control"),
587:    ("F  DISK CONTENT     chunk 1 LAST byte (image[32767])", "s4", 0xC1, 0xC1, "control"),
588:    ("G  *** DEFECT ***   1st byte after re-arm", "s5", 0xa5, 0xC2, "defect"),
589:    ("H  *** DEFECT ***   2nd byte after re-arm", "s6", 0x5a, 0xC3, "defect"),
590:    ("I  *** DEFECT ***   3rd byte after re-arm", "s7", 0xC2, 0xC4, "defect"),
591:    ("   drain loop counter reached zero", "t9", 0x00, 0x00, "control"),
592:    #  THE M5 ROW.  Its want-SHIPPED value is RECORDED FROM THE FIRST RUN, not
593:    #  predicted: on the pre-fix build the FIRST injection also landed, so the
594:    #  ring state at this point is a consequence of two injections rather than
595:    #  one, and predicting it would have been a guess dressed as an oracle.  The
596:    #  FIXED value IS predicted: both injections refused, chunk 2 drains exactly,
597:    #  ring empty, so DRQ clear.
598:    ("L  *** DEFECT ***   status after a store in PHASE_COMPLETED",
599:     "t1", ST_DATAIN, ST_IDLE, "defect"),
600:
601:    #  M -- THE ACCEPT SIDE.  Both legs want the SAME value, which is the point: a
602:    #  LEGAL write must be unaffected by the fix.  These rows are green on every
603:    #  shipped binary and redden only under a mutant that over-refuses -- the swap
604:    #  `atapi_st != NULL` (which is permanently true once a packet command has run)
605:    #  and the flag-conjunct deletion (which leaves `phase != PHASE_CMDOUT`, and
606:    #  PHASE_CMDOUT is nonzero while the post-RECAL phase is 0).
607:    ("M  ACCEPT           ordinary write after RECAL, 1st byte",
608:     "t7", 0x5a, 0x5a, "accept"),
609:    ("M  ACCEPT           ordinary write after RECAL, 2nd byte",
610:     "v0", 0xa5, 0xa5, "accept"),
611:
612:    #  N -- the SAME assertion through a DIFFERENT no-fill opcode.  Not redundancy:
613:    #  with only the M rows, `&& d->cur_command != WDCC_RECAL` re-opens the hole for
614:    #  every other command while sweeping every row.  One conjunct cannot exempt two
615:    #  opcodes.
616:    ("N  ACCEPT           ordinary write after SOFT_RESET, 1st byte",
617:     "v1", 0x5a, 0x5a, "accept"),
618:    ("N  ACCEPT           ordinary write after SOFT_RESET, 2nd byte",
619:     "a0", 0xa5, 0xa5, "accept"),
620:]
