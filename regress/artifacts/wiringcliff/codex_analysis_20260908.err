tools/pipeline/check_probe_wiring.py:693:                         "oracle-correction order proof, preserved as evidence"),
tools/pipeline/check_probe_wiring.py:694:
tools/pipeline/check_probe_wiring.py:695:    #  sgirebufuninit's two census scanners, preserved beside the brief that cites their OUTPUT.  They
tools/pipeline/check_probe_wiring.py:696:    #  are ANALYSIS tools, not detectors: neither has an oracle and neither is wired to anything.  They
tools/pipeline/check_probe_wiring.py:697:    #  are kept because the brief makes a claim about the whole device tree -- that only dev_sgi_re.c
tools/pipeline/check_probe_wiring.py:698:    #  carries this defect -- and a reader must be able to re-run the search rather than trust the count.
tools/pipeline/check_probe_wiring.py:699:    "artifacts/sgirebufuninit/scan_len.py":
tools/pipeline/check_probe_wiring.py:700:        (CLASS_RESEARCH, "sgirebufuninit: scans src/devices for memory_rw calls whose transfer LENGTH "
tools/pipeline/check_probe_wiring.py:701:                         "is not pinned to the stack buffer (6 sites). Blind by construction to a "
tools/pipeline/check_probe_wiring.py:702:                         "partially-filled buffer passed as sizeof(buf) -- which is what scan_fill.py "
tools/pipeline/check_probe_wiring.py:703:                         "exists to cover"),
tools/pipeline/check_probe_wiring.py:704:    "artifacts/sgirebufuninit/scan_fill.py":
tools/pipeline/check_probe_wiring.py:705:        (CLASS_RESEARCH, "sgirebufuninit: the companion scan -- every memory_rw that WRITES a stack "
tools/pipeline/check_probe_wiring.py:706:                         "byte-buffer into guest-visible memory, with whether the buffer is ever "
tools/pipeline/check_probe_wiring.py:707:                         "initialised wholesale (5 sites). Found dev_scc.c:305, which scan_len.py "
tools/pipeline/check_probe_wiring.py:708:                         "excludes by construction. NOTE its known defect, recorded because it nearly "
tools/pipeline/check_probe_wiring.py:709:                         "produced a wrong conclusion: the declaration map is keyed by NAME file-wide, "
tools/pipeline/check_probe_wiring.py:710:                         "so two functions declaring the same buffer at different sizes collapse to the "
tools/pipeline/check_probe_wiring.py:711:                         "last one parsed -- its `size' column reported 32 for a data[8]"),
tools/pipeline/check_probe_wiring.py:712:    #  #499 pass 4's FROZEN MUTATOR, preserved because the E0/E0W measurement is cited in
tools/pipeline/check_probe_wiring.py:713:    #  the round record and a citation into a session temp dir is not a citation.  It builds
tools/pipeline/check_probe_wiring.py:714:    #  the announce-then-exit(0) mutants; it is EVIDENCE, not a detector the battery owes a
tools/pipeline/check_probe_wiring.py:715:    #  run -- same disposition as the repin2 frozen copy below.
tools/pipeline/check_probe_wiring.py:716:    #
tools/pipeline/check_probe_wiring.py:717:    #  It also carries a lesson worth keeping next to the code: its FIRST version anchored on
tools/pipeline/check_probe_wiring.py:718:    #  the handler's common tail, and `memory_writemax64(cpu, data, len, odata);' occurs FIVE
tools/pipeline/check_probe_wiring.py:719:    #  times across FOUR handlers in dev_sgi_re.c.  The anchor matched twice and the run
tools/pipeline/check_probe_wiring.py:720:    #  aborted.  This version anchors on SGIRE_W_UNMAP_* text and REFUSES unless the match
tools/pipeline/check_probe_wiring.py:721:    #  count is exactly 1, so a wrong-handler mutation is impossible rather than unlikely.
tools/pipeline/check_probe_wiring.py:722:    "artifacts/sgireunmapped/killtable_20260831/pass4/e0_mut.py":
tools/pipeline/check_probe_wiring.py:723:        (CLASS_RESEARCH, "#499 pass 4 -- the frozen mutator for E0/E0W, the announce-then-exit(0) pair that measured the write-side floor breach.  Evidence, not a detector"),
