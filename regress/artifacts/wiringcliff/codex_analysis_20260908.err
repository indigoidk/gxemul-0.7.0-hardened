tools/pipeline/check_probe_wiring.py:1498:        #  one level would report a genuinely gated probe as unwired -- and a false red is
tools/pipeline/check_probe_wiring.py:1499:        #  how a rule gets switched off.
tools/pipeline/check_probe_wiring.py:1500:        varmap = {}
tools/pipeline/check_probe_wiring.py:1501:        for ln in lines:
