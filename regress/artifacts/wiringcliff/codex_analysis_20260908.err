tools/pipeline/check_probe_wiring.py:1466:def gate_list(regress):
tools/pipeline/check_probe_wiring.py:1467:    """The battery's OWN array is the authority on which scripts run.
tools/pipeline/check_probe_wiring.py:1468:
tools/pipeline/check_probe_wiring.py:1469:    Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
tools/pipeline/check_probe_wiring.py:1470:    second-order property worth having: a gate script that exists but was dropped out of
tools/pipeline/check_probe_wiring.py:1471:    GATES does not run, so every probe it owned becomes unwired here and this goes RED.
tools/pipeline/check_probe_wiring.py:1472:    A glob would have called those probes gated forever.
tools/pipeline/check_probe_wiring.py:1473:    """
tools/pipeline/check_probe_wiring.py:1474:    run = os.path.join(regress, "run.sh")
tools/pipeline/check_probe_wiring.py:1475:    if not os.path.isfile(run):
tools/pipeline/check_probe_wiring.py:1476:        return None, "regress/run.sh is missing -- cannot tell which gates run"
tools/pipeline/check_probe_wiring.py:1477:    m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
tools/pipeline/check_probe_wiring.py:1478:    if not m:
tools/pipeline/check_probe_wiring.py:1479:        return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
tools/pipeline/check_probe_wiring.py:1480:    return [n + ".sh" for n in m.group(1).split()], None
