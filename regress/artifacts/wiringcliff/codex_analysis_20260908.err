179:def available_handlers(out):
180:    """The list the aborting process prints between its header and 'Aborting.'"""
181:    m = re.search(r"Available handler paths are:\n(.*?)\nAborting\.", out, re.S)
182:    if not m:
183:        return None
184:    return [ln.strip() for ln in m.group(1).splitlines() if ln.strip()]
