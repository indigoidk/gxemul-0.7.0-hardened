tools/pipeline/check_probe_wiring.py:545:
tools/pipeline/check_probe_wiring.py:546:    #  wdcaltoffset PASS 1, 2026-08-30.  Four instruments from the measuring seat's
tools/pipeline/check_probe_wiring.py:547:    #  six-binary table.  CLASS_RESEARCH on the precedent two entries down: they are
tools/pipeline/check_probe_wiring.py:548:    #  EVIDENCE preserved so the numbers can be re-run rather than believed.
tools/pipeline/check_probe_wiring.py:549:    #
tools/pipeline/check_probe_wiring.py:550:    #  `table_a.py` is worth a note because it is the reason the table is credible:
tools/pipeline/check_probe_wiring.py:551:    #  it IMPORTS witness_20260829/wdcaltoff_rung3_probe.py rather than
tools/pipeline/check_probe_wiring.py:552:    #  re-implementing the encoder, so it cannot measure a fix of its own invention.
tools/pipeline/check_probe_wiring.py:553:    #  Its fix leg was checked byte-identical to mkfixleg.py's output AND to the
tools/pipeline/check_probe_wiring.py:554:    #  preserved fixleg.diff before any mutant was built.
tools/pipeline/check_probe_wiring.py:555:    #  #494 PASS 2, the opus5 seat.  Instruments preserved so its measured floor
tools/pipeline/check_probe_wiring.py:556:    #  breach can be re-run rather than believed.  `PROPOSED_...` is kept as the
tools/pipeline/check_probe_wiring.py:557:    #  PROVENANCE of what the seat proposed: the shipped detector differs from it
tools/pipeline/check_probe_wiring.py:558:    #  only by an added clause-(e) contract, and keeping both makes that checkable.
tools/pipeline/check_probe_wiring.py:559:    #  wdcaddtoinbufbound RUNG-3 WITNESS, 2026-08-30.  The probe is the INSTRUMENT of
tools/pipeline/check_probe_wiring.py:560:    #  a 20/20 two-leg measurement and is preserved so the numbers can be re-run
tools/pipeline/check_probe_wiring.py:561:    #  rather than believed.  `frozen_wave_*` is the FROZEN COPY the run actually
tools/pipeline/check_probe_wiring.py:562:    #  executed -- kept beside the live probe on purpose, because a comparison run
tools/pipeline/check_probe_wiring.py:563:    #  owes ONE instrument and the frozen copy is the proof of which one it was.
tools/pipeline/check_probe_wiring.py:564:    #  #497 widthkillclass, 2026-08-30.  The measuring seat's TWO-TABLE instrument set,
tools/pipeline/check_probe_wiring.py:565:    #  preserved so a 22-mutant result can be RE-RUN rather than believed.  CLASS_RESEARCH
tools/pipeline/check_probe_wiring.py:566:    #  on the precedent immediately below: these are EVIDENCE, not detectors the battery
tools/pipeline/check_probe_wiring.py:567:    #  owes a run.
tools/pipeline/check_probe_wiring.py:568:    #
tools/pipeline/check_probe_wiring.py:569:    #  `sgi_re_width_probe.py` is the 35-row detector ITSELF, and it is filed here as
tools/pipeline/check_probe_wiring.py:570:    #  research on purpose: the round's shipping copy will live in regress/ and be gated or
tools/pipeline/check_probe_wiring.py:571:    #  dated-exempt.  Two copies with two classes is correct rather than untidy -- the
tools/pipeline/check_probe_wiring.py:572:    #  artifacts one is the instrument that produced THESE numbers and must never change,
tools/pipeline/check_probe_wiring.py:573:    #  while the regress/ one is live and will.
tools/pipeline/check_probe_wiring.py:574:    #
tools/pipeline/check_probe_wiring.py:575:    #  `mutate497.py` and `mutate497_v2.py` are BOTH kept, and the pair is the point: v1
tools/pipeline/check_probe_wiring.py:576:    #  was re-read from the live scratchpad per mutant, which is the frozen-copy hole the
tools/pipeline/check_probe_wiring.py:577:    #  seat caught before it bit.  v2 freezes the mutator and hard-exits if it is missing.
tools/pipeline/check_probe_wiring.py:578:    #  Keeping only v2 would erase the evidence that table 1 and table 2 ran different
tools/pipeline/check_probe_wiring.py:579:    #  drivers -- which is exactly what a reader comparing the two tables needs to know.
tools/pipeline/check_probe_wiring.py:580:    "artifacts/widthkillclass/opus_impl_20260830/apply_fix497.py":
tools/pipeline/check_probe_wiring.py:581:        (CLASS_RESEARCH, "#497 applies the six-site fix to a clone, preserved as evidence"),
tools/pipeline/check_probe_wiring.py:582:    "artifacts/widthkillclass/opus_impl_20260830/move_warned.py":
tools/pipeline/check_probe_wiring.py:583:        (CLASS_RESEARCH, "#497 moves the latch field last -- the edit that stopped the over-run aliasing the latch"),
tools/pipeline/check_probe_wiring.py:584:    "artifacts/widthkillclass/opus_impl_20260830/mutate497.py":
tools/pipeline/check_probe_wiring.py:585:        (CLASS_RESEARCH, "#497 table-1 mutator, kept to show v1 re-read itself per mutant"),
tools/pipeline/check_probe_wiring.py:586:    "artifacts/widthkillclass/opus_impl_20260830/mutate497_v2.py":
tools/pipeline/check_probe_wiring.py:587:        (CLASS_RESEARCH, "#497 table-2 mutator, frozen and hard-exiting if absent"),
tools/pipeline/check_probe_wiring.py:588:    "artifacts/widthkillclass/opus_impl_20260830/sgi_re_width_probe.py":
tools/pipeline/check_probe_wiring.py:589:        (CLASS_RESEARCH, "#497 the 35-row detector AS MEASURED -- the shipping copy is separate and gated"),
tools/pipeline/check_probe_wiring.py:590:    #  #500 pass 6: the NEGATIVE CONTROL's mutated probe, frozen as evidence.  It is
tools/pipeline/check_probe_wiring.py:591:    #  a MUTANT of the shipping detector, deliberately run by no gate -- its whole
tools/pipeline/check_probe_wiring.py:592:    #  purpose is to reproduce a RED.  A seat built the mutant it carries; the
tools/pipeline/check_probe_wiring.py:593:    #  control proved both that the hole existed and that the repair closes it.
