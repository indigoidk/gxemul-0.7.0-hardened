tools/pipeline/check_probe_wiring.py:1858:    def case(name, want_rc, want_text, chk, rg, extra=(), forbid=None):
tools/pipeline/check_probe_wiring.py:1859:        p = subprocess.run([sys.executable, chk, "--regress", rg] + list(extra),
tools/pipeline/check_probe_wiring.py:1860:                           capture_output=True, text=True)
tools/pipeline/check_probe_wiring.py:1861:        out = p.stdout + p.stderr
tools/pipeline/check_probe_wiring.py:1862:        ok = (p.returncode == want_rc) and (want_text in out)
