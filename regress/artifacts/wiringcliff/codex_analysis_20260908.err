702:    #  PRESERVE, since dev_vr41xx_init used to win by running last.
703:    #
704:    #  It cannot be caught behaviourally here: THIS PROBE NEVER EXERCISES X11,
705:    #  and a headless run cannot.  A pass-2 seat named that gap independently
706:    #  before naming the mutant.  So this is a source-text row like S1 and S4,
707:    #  and it is labelled one.
708:    #
709:    #  It pins the GUARDED SHAPE rather than an exact block, because the three
710:    #  arms indent differently and an exact-text match would break on
711:    #  reformatting alone -- the failure mode S4 accepts deliberately is not
712:    #  worth accepting twice.
713:    guard_bad = []
714:    for const, info in sorted(arms.items(), key=lambda kv: kv[1]["case_line"]):
715:        prim = (const_aliases.get(const) or [None])[0]
716:        if prim is None or not info["device_add_lines"]:
717:            continue
718:        code = info["code"]
719:        if "main_console_handle" not in code:
720:            continue                      # an arm that never claims the console
721:        if not re.search(r"if\s*\(\s*!\s*machine->x11_md\.in_use\s*\)\s*"
722:                         r"machine->main_console_handle", code, re.S):
723:            guard_bad.append((prim, "main_console_handle assigned without the "
724:                                    "!x11_md.in_use guard"))
725:    row("S5 the console handle is claimed only when X11 is not in use",
726:        not guard_bad, sorted(guard_bad), [])
727:    row("S2 no arm calls device_add BEFORE dev_vr41xx_init",
728:        not unordered, sorted(unordered), [])
729:    row("S3 no arm passes a non-path irq argument", not bad_irq,
