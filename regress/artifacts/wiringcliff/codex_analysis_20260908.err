tools/pipeline/check_probe_wiring.py:1417:#  A python interpreter token.  Bare python/python3, or the $PY-style indirections other
tools/pipeline/check_probe_wiring.py:1418:#  harnesses in this tree use.  Anchored so python3.12 and mypython do not match.
tools/pipeline/check_probe_wiring.py:1419:#  *** THE TRAILING BOUNDARY IS LOAD-BEARING AND THE FIRST VERSION LACKED IT. ***  A
tools/pipeline/check_probe_wiring.py:1420:#  flagship review MEASURED that `"$PYLINT" probe.py` scored as WIRING: the alternation
tools/pipeline/check_probe_wiring.py:1421:#  had no boundary after the group, so ANY $PY-prefixed variable read as an interpreter
tools/pipeline/check_probe_wiring.py:1422:#  and a linter invocation would have marked a probe wired.  That is the FALSE ACCEPT
tools/pipeline/check_probe_wiring.py:1423:#  direction -- the one that silently stops demanding a gate.  Latent rather than live:
tools/pipeline/check_probe_wiring.py:1424:#  no such variable exists in the battery today.  `$PYTHON` and `$PY` still match;
tools/pipeline/check_probe_wiring.py:1425:#  `$PYLINT` and `$PYTEST` no longer do.
tools/pipeline/check_probe_wiring.py:1426:INTERP_RE = re.compile(
tools/pipeline/check_probe_wiring.py:1427:    r'"?\$\{?(?:PY|PY3|PYTHON|PYTHON3)\}?"?(?![A-Za-z0-9_])'
tools/pipeline/check_probe_wiring.py:1428:    r'|(?<![\w./-])python3?(?![\w.-])'
tools/pipeline/check_probe_wiring.py:1429:)
tools/pipeline/check_probe_wiring.py:1430:
tools/pipeline/check_probe_wiring.py:1431:#  COMMAND POSITION -- the whole defence against "a mention counts as wiring".  Everything
tools/pipeline/check_probe_wiring.py:1432:#  before the interpreter must be shell scaffolding: leading space, an assignment opening a
tools/pipeline/check_probe_wiring.py:1433:#  command substitution (out=$( ), control keywords, and environment-variable prefixes.
tools/pipeline/check_probe_wiring.py:1434:#
tools/pipeline/check_probe_wiring.py:1435:#  THE LINE THIS WAS BUILT AGAINST IS REAL AND LIVE, not invented:
tools/pipeline/check_probe_wiring.py:1436:#      gate_hygiene.sh:331   note "diag_div_sweep.py or python3 missing -- class ratchet NOT run"
tools/pipeline/check_probe_wiring.py:1437:#  It carries a probe basename AND the token python3 on one non-comment line, and it is a
tools/pipeline/check_probe_wiring.py:1438:#  message saying the probe DID NOT RUN.  A two-sided "name near python" regex scores it as
tools/pipeline/check_probe_wiring.py:1439:#  execution.  Here the interpreter's prefix is `note "diag_div_sweep.py or `, which is not
tools/pipeline/check_probe_wiring.py:1440:#  scaffolding, so the line is rejected.
tools/pipeline/check_probe_wiring.py:1441:CMDPOS_RE = re.compile(
tools/pipeline/check_probe_wiring.py:1442:    r"""^\s*
tools/pipeline/check_probe_wiring.py:1443:        (?: [A-Za-z_]\w* = (?:\$\()? \s* )?
tools/pipeline/check_probe_wiring.py:1444:        (?: (?: if | then | else | elif | while | until | do | ! | \$\( | \( ) \s* )*
tools/pipeline/check_probe_wiring.py:1445:        (?: [A-Za-z_]\w* = (?: "[^"]*" | '[^']*' | \S* ) \s+ )*
tools/pipeline/check_probe_wiring.py:1446:        $""",
tools/pipeline/check_probe_wiring.py:1447:    re.X,
tools/pipeline/check_probe_wiring.py:1448:)
tools/pipeline/check_probe_wiring.py:1449:
tools/pipeline/check_probe_wiring.py:1450:VAR_RE = re.compile(r"^\$\{?([A-Za-z_]\w*)\}?$")
tools/pipeline/check_probe_wiring.py:1451:ASSIGN_RE = re.compile(r"^\s*([A-Za-z_]\w*)=(\S+)")
tools/pipeline/check_probe_wiring.py:1452:
tools/pipeline/check_probe_wiring.py:1453:
tools/pipeline/check_probe_wiring.py:1454:def read(path):
tools/pipeline/check_probe_wiring.py:1455:    with open(path, "r", encoding="utf-8", errors="replace") as fh:
tools/pipeline/check_probe_wiring.py:1456:        return fh.read()
