tools/pipeline/check_probe_wiring.py:1807:    src_regress = DEFAULT_REGRESS
tools/pipeline/check_probe_wiring.py:1808:    me = os.path.abspath(__file__)
tools/pipeline/check_probe_wiring.py:1809:    root = tempfile.mkdtemp(prefix="probewiring_selftest_")
