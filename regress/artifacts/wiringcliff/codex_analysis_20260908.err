tools/pipeline/check_probe_wiring.py:1508:        #  flagship review MEASURED it: an invocation-shaped line inside a
tools/pipeline/check_probe_wiring.py:1509:        #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
tools/pipeline/check_probe_wiring.py:1510:        #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
tools/pipeline/check_probe_wiring.py:1511:        #  its own invocation is an entirely natural shape.  Latent rather than live -- every
tools/pipeline/check_probe_wiring.py:1512:        #  `<<` site in the battery today is a data table or a python program body, none
tools/pipeline/check_probe_wiring.py:1513:        #  carrying an interpreter plus a probe in body position -- but this is the
tools/pipeline/check_probe_wiring.py:1514:        #  dangerous direction: it does not fail loudly, it stops demanding a gate.
tools/pipeline/check_probe_wiring.py:1515:        #
tools/pipeline/check_probe_wiring.py:1516:        #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
tools/pipeline/check_probe_wiring.py:1517:        #  that GENERATES a script the gate then runs is genuine wiring one level away, and
tools/pipeline/check_probe_wiring.py:1518:        #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
tools/pipeline/check_probe_wiring.py:1519:        #  That is the right error to make.
tools/pipeline/check_probe_wiring.py:1520:        body = set()
tools/pipeline/check_probe_wiring.py:1521:        pend = None
tools/pipeline/check_probe_wiring.py:1522:        for no, ln in enumerate(lines, 1):
tools/pipeline/check_probe_wiring.py:1523:            if pend is not None:
tools/pipeline/check_probe_wiring.py:1524:                body.add(no)
tools/pipeline/check_probe_wiring.py:1525:                if ln.strip() == pend:
tools/pipeline/check_probe_wiring.py:1526:                    pend = None
tools/pipeline/check_probe_wiring.py:1527:                continue
tools/pipeline/check_probe_wiring.py:1528:            h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
tools/pipeline/check_probe_wiring.py:1529:            if h and not ln.lstrip().startswith("#"):
tools/pipeline/check_probe_wiring.py:1530:                pend = h.group(1)
tools/pipeline/check_probe_wiring.py:1531:
tools/pipeline/check_probe_wiring.py:1532:        for no, ln in enumerate(lines, 1):
