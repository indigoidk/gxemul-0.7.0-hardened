regress/run.sh:1:#!/bin/bash
regress/run.sh:2:# Run the regression gates. `./run.sh` runs all of them; `./run.sh 2 4` runs a subset.
regress/run.sh:3:#
regress/run.sh:4:# Order matters: the build gate produces the binaries the rest test, and the hygiene gate
regress/run.sh:5:# reads the logs the MIPS gate produces.
regress/run.sh:6:set -u
regress/run.sh:7:HERE=$(cd "$(dirname "$0")" && pwd)
regress/run.sh:8:. "$HERE/lib.sh"
regress/run.sh:9:
regress/run.sh:10:GATES=(gate_build gate_offline selftest_mutation gate_mips gate_crossfamily gate_hygiene gate_ab gate_upstream gate_asan_sweep gate_sh_rounding gate_m88k_rounding gate_mips_rounding gate_ppc gate_arm gate_ppc_halt gate_mips_folds)
regress/run.sh:11:
regress/run.sh:12:#  How many gates this battery is supposed to have.  Every round ends with a claim of
regress/run.sh:13:#  the form "the battery is green", and until now NOTHING checked how many gates that
regress/run.sh:14:#  covered -- so a gate silently dropped from the array above would have looked exactly
regress/run.sh:15:#  like a battery that was always this size.  The count was also wrong in three places
regress/run.sh:16:#  at once: this README said "all six", the top-level README stopped at 13, and the
regress/run.sh:17:#  working notes had said both 15 and 17.  A number nobody checks is not a fact.
regress/run.sh:18:#
regress/run.sh:19:#  Adding a gate means editing BOTH lines, deliberately.  That is the point.
regress/run.sh:20:GATE_MANIFEST=16
regress/run.sh:21:if [ "${#GATES[@]}" -ne "$GATE_MANIFEST" ]; then
regress/run.sh:22:    echo "GATE MANIFEST MISMATCH: array has ${#GATES[@]}, manifest says $GATE_MANIFEST"
regress/run.sh:23:    echo "  a gate was added or removed without updating GATE_MANIFEST -- refusing to run,"
regress/run.sh:24:    echo "  because 'the battery is green' means nothing if the battery changed size."
regress/run.sh:25:    exit 2
regress/run.sh:26:fi
regress/run.sh:27:
regress/run.sh:28:#  #399: AND EACH SCRIPT MUST AGREE WITH ITS OWN POSITION. The count above proves the
regress/run.sh:29:#  battery did not change SIZE; it says nothing about whether the scripts know which
regress/run.sh:30:#  gate they are. Four of them did not: selftest_mutation was inserted at position 3 and
regress/run.sh:31:#  gate_mips, gate_crossfamily, gate_hygiene and gate_ab were never renumbered, so each
regress/run.sh:32:#  self-labelled one low while gate_upstream onward stayed correct.
regress/run.sh:33:#
regress/run.sh:34:#  That is not cosmetic. A shipped commit message cited "gate 5" for gate_hygiene because
regress/run.sh:35:#  it read the number out of a comment, and the comment was wrong -- the project's rule is
regress/run.sh:36:#  READ THE LINE BEFORE CITING IT, and the line itself lied. A self-label with nothing
regress/run.sh:37:#  behind it is a fact-shaped string.
regress/run.sh:38:#
regress/run.sh:39:#  NAMED MUTANT, and it is why this compares the NUMBER rather than looking for a header:
regress/run.sh:40:#  a check that merely greps for the EXISTENCE of a "GATE n" line passes on all four of
regress/run.sh:41:#  the wrong files. A missing header is also a failure, not a pass -- selftest_mutation
regress/run.sh:42:#  gained one in #399 rather than being exempted, because an exemption is a hole.
regress/run.sh:43:_i=0
regress/run.sh:44:for _g in "${GATES[@]}"; do
regress/run.sh:45:    _i=$((_i+1))
regress/run.sh:46:    _lbl=$(sed -n 's/^# GATE \([0-9][0-9]*\).*/\1/p' "$HERE/$_g.sh" | head -1)
regress/run.sh:47:    if [ -z "$_lbl" ]; then
regress/run.sh:48:        echo "GATE LABEL MISSING: $_g.sh has no '# GATE n' header (expected $_i)"
regress/run.sh:49:        echo "  every gate must declare which gate it is, so a citation taken from its"
regress/run.sh:50:        echo "  own comments is checkable. Refusing to run."
regress/run.sh:51:        exit 2
regress/run.sh:52:    fi
regress/run.sh:53:    if [ "$_lbl" != "$_i" ]; then
regress/run.sh:54:        echo "GATE LABEL MISMATCH: $_g.sh calls itself GATE $_lbl but is position $_i"
regress/run.sh:55:        echo "  the array is the authority. A stale self-label has already put a wrong"
regress/run.sh:56:        echo "  gate number into a shipped record. Refusing to run."
regress/run.sh:57:        exit 2
regress/run.sh:58:    fi
regress/run.sh:59:done
regress/run.sh:60:
regress/run.sh:61:# Validate selectors up front. Without this, `./run.sh 99` matched nothing, ran zero
regress/run.sh:62:# gates, and printed REGRESS_PASS -- one mistyped digit produced a green push.
regress/run.sh:63:for i in "$@"; do
regress/run.sh:64:    case "$i" in
regress/run.sh:65:        ''|*[!0-9]*) echo "bad gate selector '$i' (want 1..${#GATES[@]})"; exit 2 ;;
regress/run.sh:66:    esac
regress/run.sh:67:    if [ "$i" -lt 1 ] || [ "$i" -gt ${#GATES[@]} ]; then
regress/run.sh:68:        echo "gate selector '$i' out of range (want 1..${#GATES[@]})"; exit 2
regress/run.sh:69:    fi
regress/run.sh:70:done
regress/run.sh:71:
regress/run.sh:72:want=("$@")
regress/run.sh:73:run_this() {
regress/run.sh:74:    [ ${#want[@]} -eq 0 ] && return 0
regress/run.sh:75:    local i
regress/run.sh:76:    for i in "${want[@]}"; do [ "$i" = "$1" ] && return 0; done
regress/run.sh:77:    return 1
regress/run.sh:78:}
regress/run.sh:79:
regress/run.sh:80:declare -a RESULTS
regress/run.sh:81:n=0
regress/run.sh:82:for g in "${GATES[@]}"; do
regress/run.sh:83:    n=$((n+1))
regress/run.sh:84:    run_this "$n" || continue
regress/run.sh:85:    bash "$HERE/$g.sh"
regress/run.sh:86:    rc=$?
regress/run.sh:87:    # Only the explicit skip code counts as SKIP. bash exits 2 on a SYNTAX ERROR, so
regress/run.sh:88:    # mapping 2 to SKIP turned a broken gate script into a "coverage gap" and still
regress/run.sh:89:    # exited 0 overall.
regress/run.sh:90:    case $rc in
regress/run.sh:91:        0)            RESULTS+=("$n $g PASS") ;;
regress/run.sh:92:        "$EXIT_SKIP") RESULTS+=("$n $g SKIP") ;;
regress/run.sh:93:        *)            RESULTS+=("$n $g FAIL") ;;
regress/run.sh:94:    esac
regress/run.sh:95:    echo
regress/run.sh:96:done
regress/run.sh:97:
regress/run.sh:98:echo "############################################################"
regress/run.sh:99:echo "## SUMMARY"
regress/run.sh:100:echo "############################################################"
regress/run.sh:101:pass=0; fail=0; skip=0
regress/run.sh:102:for r in "${RESULTS[@]}"; do
regress/run.sh:103:    set -- $r
regress/run.sh:104:    case "$3" in
regress/run.sh:105:        PASS) printf "  ${C_OK}%-4s${C_OFF} %s. %s\n" PASS "$1" "$2"; pass=$((pass+1)) ;;
regress/run.sh:106:        SKIP) printf "  ${C_SKIP}%-4s${C_OFF} %s. %s\n" SKIP "$1" "$2"; skip=$((skip+1)) ;;
regress/run.sh:107:        *)    printf "  ${C_BAD}%-4s${C_OFF} %s. %s\n" FAIL "$1" "$2"; fail=$((fail+1)) ;;
regress/run.sh:108:    esac
regress/run.sh:109:done
regress/run.sh:110:echo
regress/run.sh:111:echo "  passed $pass   failed $fail   skipped $skip"
regress/run.sh:112:#  Say what was actually covered.  A bare "passed N" invites the reader to assume N is
regress/run.sh:113:#  the whole battery; when a subset was selected it is not, and that distinction is
regress/run.sh:114:#  exactly what an auditor of a green push needs.
regress/run.sh:115:if [ ${#want[@]} -eq 0 ]; then
regress/run.sh:116:    echo "  GATE_COVERAGE=$((pass+fail+skip))/$GATE_MANIFEST (full battery)"
regress/run.sh:117:else
regress/run.sh:118:    echo "  GATE_COVERAGE=$((pass+fail+skip))/$GATE_MANIFEST (SUBSET: ${want[*]})"
regress/run.sh:119:fi
regress/run.sh:120:echo
regress/run.sh:121:# A skip is NEVER a pass. It means a gate could not run, which is a gap in coverage, not
regress/run.sh:122:# evidence of correctness -- so the overall verdict says so out loud.
regress/run.sh:123:if [ $((pass+fail+skip)) -eq 0 ]; then
regress/run.sh:124:    echo "${C_BAD}REGRESS_NOTHING_RAN${C_OFF}"; exit 1
regress/run.sh:125:elif [ "$fail" -gt 0 ]; then
regress/run.sh:126:    echo "${C_BAD}REGRESS_FAIL${C_OFF}"; exit 1
regress/run.sh:127:elif [ "$skip" -gt 0 ]; then
regress/run.sh:128:    # EXIT 3, NOT 0. Automation reads the exit status, not the colour: exiting 0 here made
regress/run.sh:129:    # a run where every gate skipped indistinguishable from a run where every gate passed,
regress/run.sh:130:    # which contradicts this harness's own rule that a skip is never a pass.
regress/run.sh:131:    echo "${C_SKIP}REGRESS_PASS_WITH_GAPS${C_OFF} ($skip gate(s) could not run; exit 3)"
regress/run.sh:132:    exit 3
regress/run.sh:133:else
regress/run.sh:134:    echo "${C_OK}REGRESS_PASS${C_OFF}"; exit 0
regress/run.sh:135:fi
