tools/pipeline/check_probe_wiring.py:674:        (CLASS_DETECTOR, "#504 sgirandompixel -- horrible_getputpixel's unimplemented-mode arm is a "
tools/pipeline/check_probe_wiring.py:675:                         "latched decline; 8 rows, wired into gate_arm.sh in the same commit as the "
tools/pipeline/check_probe_wiring.py:676:                         "fix. It is BOTH the rung-3 witness and the detector. The `lin_b diag once' "
tools/pipeline/check_probe_wiring.py:677:                         "row requires the probe's 1x4 rectangle: with a single pixel an UNLATCHED "
tools/pipeline/check_probe_wiring.py:678:                         "announce also fires exactly once, the latch channel cannot vary, and "
tools/pipeline/check_probe_wiring.py:679:                         "M_NOLATCH escaped 8/8 -- height not width, because LIN_A addressing is "
tools/pipeline/check_probe_wiring.py:680:                         "`ofs = x & 4095' so y is ignored and four rows rewrite one byte, leaving "
tools/pipeline/check_probe_wiring.py:681:                         "the value oracle intact"),
tools/pipeline/check_probe_wiring.py:682:
tools/pipeline/check_probe_wiring.py:683:    #  #504's frozen evidence.  The killtable copy is the instrument the five-mutant table ran; the
