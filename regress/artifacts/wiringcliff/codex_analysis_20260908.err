tools/pipeline/check_probe_wiring.py:1811:
tools/pipeline/check_probe_wiring.py:1812:    #  *** THE BASELINE MUST BE GREEN BY CONSTRUCTION, AND THE FIRST VERSION WAS NOT. ***
tools/pipeline/check_probe_wiring.py:1813:    #  fresh() copied EVERY .py from the live tree, so when a concurrent round dropped an
tools/pipeline/check_probe_wiring.py:1814:    #  unclassified probe into regress/, M0/M2b/M5a all went red and the selftest announced
tools/pipeline/check_probe_wiring.py:1815:    #  "THE CHECKER CAN NO LONGER BE SHOWN TO FAIL".  Right colour, WRONG DIAGNOSIS: it
tools/pipeline/check_probe_wiring.py:1816:    #  blamed the checker for an APPARATUS state -- gate_offline's F5 shape, and the
tools/pipeline/check_probe_wiring.py:1817:    #  dangerous one, because it points the reader at the wrong file.
tools/pipeline/check_probe_wiring.py:1818:    #
tools/pipeline/check_probe_wiring.py:1819:    #  So the baseline copies exactly the MANIFEST set.  Live-tree content can no longer
tools/pipeline/check_probe_wiring.py:1820:    #  perturb a mutant, and M6 still tests the unclassified-arrival path by ADDING one.
tools/pipeline/check_probe_wiring.py:1821:    #  A MANIFEST entry with no source file is a SETUP FAULT here, never a mutant result --
tools/pipeline/check_probe_wiring.py:1822:    #  absorb_census.py's rule that a crash is a fault and never a detection.
tools/pipeline/check_probe_wiring.py:1823:    def fresh():
tools/pipeline/check_probe_wiring.py:1824:        work = tempfile.mkdtemp(dir=root)
tools/pipeline/check_probe_wiring.py:1825:        rg = os.path.join(work, "regress")
tools/pipeline/check_probe_wiring.py:1826:        os.makedirs(rg)
tools/pipeline/check_probe_wiring.py:1827:        #  #471: THE COPY MUST MIRROR THE TREE, NOT FLATTEN IT.  This loop was
tools/pipeline/check_probe_wiring.py:1828:        #  `os.listdir`, so once the checker could see nested detectors the selftest
tools/pipeline/check_probe_wiring.py:1829:        #  copy still could not -- and every nested MANIFEST entry became a GHOST in
tools/pipeline/check_probe_wiring.py:1830:        #  the copy, reddening the unmutated M0 control.
tools/pipeline/check_probe_wiring.py:1831:        #
tools/pipeline/check_probe_wiring.py:1832:        #  That is the SAME blind spot one level up, inside the harness that tests
tools/pipeline/check_probe_wiring.py:1833:        #  for it: a flat copy cannot exercise a recursive scan.
tools/pipeline/check_probe_wiring.py:1834:        for f in os.listdir(src_regress):
tools/pipeline/check_probe_wiring.py:1835:            if f.endswith(".sh"):
tools/pipeline/check_probe_wiring.py:1836:                shutil.copyfile(os.path.join(src_regress, f), os.path.join(rg, f))
tools/pipeline/check_probe_wiring.py:1837:        for rel in MANIFEST:
tools/pipeline/check_probe_wiring.py:1838:            if not rel.endswith(".py"):
tools/pipeline/check_probe_wiring.py:1839:                continue
tools/pipeline/check_probe_wiring.py:1840:            src = os.path.join(src_regress, rel.replace("/", os.sep))
tools/pipeline/check_probe_wiring.py:1841:            if not os.path.isfile(src):
tools/pipeline/check_probe_wiring.py:1842:                continue
tools/pipeline/check_probe_wiring.py:1843:            dst = os.path.join(rg, rel.replace("/", os.sep))
tools/pipeline/check_probe_wiring.py:1844:            os.makedirs(os.path.dirname(dst), exist_ok=True)
tools/pipeline/check_probe_wiring.py:1845:            shutil.copyfile(src, dst)
tools/pipeline/check_probe_wiring.py:1846:        chk = os.path.join(work, "check_probe_wiring.py")
tools/pipeline/check_probe_wiring.py:1847:        shutil.copyfile(me, chk)
tools/pipeline/check_probe_wiring.py:1848:        return rg, chk
tools/pipeline/check_probe_wiring.py:1849:
tools/pipeline/check_probe_wiring.py:1850:    absent = [f for f in sorted(MANIFEST) if not os.path.isfile(os.path.join(src_regress, f))]
tools/pipeline/check_probe_wiring.py:1851:    if absent:
tools/pipeline/check_probe_wiring.py:1852:        print("PROBEWIRING_SELFTEST_SETUP  the MANIFEST names files regress/ does not have:")
tools/pipeline/check_probe_wiring.py:1853:        for f in absent:
tools/pipeline/check_probe_wiring.py:1854:            print("    %s" % f)
tools/pipeline/check_probe_wiring.py:1855:        print("  fix the manifest first; a selftest on a broken baseline proves nothing.")
tools/pipeline/check_probe_wiring.py:1856:        return 2
