1466:def gate_list(regress):
1467:    """The battery's OWN array is the authority on which scripts run.
1468:
1469:    Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
1470:    second-order property worth having: a gate script that exists but was dropped out of
1471:    GATES does not run, so every probe it owned becomes unwired here and this goes RED.
1472:    A glob would have called those probes gated forever.
1473:    """
1474:    run = os.path.join(regress, "run.sh")
1475:    if not os.path.isfile(run):
1476:        return None, "regress/run.sh is missing -- cannot tell which gates run"
1477:    m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
1478:    if not m:
1479:        return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
1480:    return [n + ".sh" for n in m.group(1).split()], None
