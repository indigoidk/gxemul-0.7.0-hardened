1631:def self_label(path):
1632:    """The file's OWN summary line, for the SELFLABEL advisory only.  Never a verdict."""
1633:    try:
1634:        head = read(path).splitlines()[:6]
1635:    except OSError:
1636:        return None
1637:    for ln in head:
1638:        has_w, has_d = bool(_LBL_W.search(ln)), bool(_LBL_D.search(ln))
1639:        if has_w and not has_d:
1640:            return CLASS_WITNESS
1641:        if has_d and not has_w:
1642:            return CLASS_DETECTOR
1643:        if has_w and has_d:
1644:            return None
1645:    return None
