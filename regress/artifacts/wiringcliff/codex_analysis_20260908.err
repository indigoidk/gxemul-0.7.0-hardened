tools/pipeline/check_probe_wiring.py:614:    #  #498's SHIPPING detector -- gate-wired in gate_arm.sh, 25 rows, sentinel
tools/pipeline/check_probe_wiring.py:615:    #  OPUS498T_DONE.  CLASS_DETECTOR rather than research: the battery owes it a run.
tools/pipeline/check_probe_wiring.py:616:    #  Self-contained by deliberate choice -- every committed probe in this tree rolls its
tools/pipeline/check_probe_wiring.py:617:    #  own pty rather than importing the untracked _scratchpad/gxprobe.py, and following
tools/pipeline/check_probe_wiring.py:618:    #  that precedent avoids making a committed file depend on one outside the repo.
tools/pipeline/check_probe_wiring.py:619:    "sgi_de_width_probe.py":
tools/pipeline/check_probe_wiring.py:620:        (CLASS_DETECTOR, "#498 sgidewidth -- 25 rows, gate_arm.sh, every row from a measured mutant kill"),
tools/pipeline/check_probe_wiring.py:621:
tools/pipeline/check_probe_wiring.py:622:    #  sgireunmapped #499: the SHIPPED detector.  Gate-run by gate_arm.sh -- invocation,
tools/pipeline/check_probe_wiring.py:623:    #  OPUS499T_DONE sentinel check, controls by name, EVERY row named individually, and
tools/pipeline/check_probe_wiring.py:624:    #  a SUMMED denominator that separates a LOST row from a FAILING one.
tools/pipeline/check_probe_wiring.py:625:    #
tools/pipeline/check_probe_wiring.py:626:    #  *** THE ROW COUNT IS NOT WRITTEN HERE.  It went 28 -> 34 -> 36 -> 48 across four
tools/pipeline/check_probe_wiring.py:627:    #  passes in one day and this comment said 28 for all of them.  Derive it: ***
tools/pipeline/check_probe_wiring.py:628:    #
tools/pipeline/check_probe_wiring.py:629:    #      awk '/for v in "live"/{l=$0; getline n;
tools/pipeline/check_probe_wiring.py:630:    #           if (n ~ /UNMLOG/) {print gsub(/"[^"]*"/,"",l)}}' regress/gate_arm.sh
tools/pipeline/check_probe_wiring.py:631:    #
tools/pipeline/check_probe_wiring.py:632:    #  The `getline'/UNMLOG pair is load-bearing and is not defensive clutter: several
tools/pipeline/check_probe_wiring.py:633:    #  sections of gate_arm.sh open with the same `for v in "live" "devsig"' names, so
tools/pipeline/check_probe_wiring.py:634:    #  the FIRST match is a different probe's list.  The log variable on the NEXT line
tools/pipeline/check_probe_wiring.py:635:    #  is the only thing that identifies which section a row list belongs to.  (A first
tools/pipeline/check_probe_wiring.py:636:    #  attempt here counted `check "sgi_re unmapped row:"' lines and returned 1 -- the
tools/pipeline/check_probe_wiring.py:637:    #  rows are named in a LOOP, so there is one such line however many rows exist.
tools/pipeline/check_probe_wiring.py:638:    #  It was caught by running it, which is the whole reason a deriver is written down
tools/pipeline/check_probe_wiring.py:639:    #  instead of a number.)
tools/pipeline/check_probe_wiring.py:640:    #
tools/pipeline/check_probe_wiring.py:641:    #  (Demoted literals, kept as the record of what was measured and never as current
tools/pipeline/check_probe_wiring.py:642:    #  claims: 18/28 pre-fix and 28/28 on the fix, the test-first evidence in this row's
tools/pipeline/check_probe_wiring.py:643:    #  own artifacts dir; 30/34 and 33/34 for the two pass-2 mutants against the 34-row
tools/pipeline/check_probe_wiring.py:644:    #  repair, where the 28-row version had scored both 28/28.)
tools/pipeline/check_probe_wiring.py:645:    #  #500 sgideprimop: the SHIPPED detector.  Gate-run by gate_arm.sh -- invocation,
tools/pipeline/check_probe_wiring.py:646:    #  OPUS500_DONE sentinel check, every row named individually, and a SUMMED denominator
tools/pipeline/check_probe_wiring.py:647:    #  that separates a LOST row from a FAILING one.
tools/pipeline/check_probe_wiring.py:648:    #
tools/pipeline/check_probe_wiring.py:649:    #  ROW COUNT NOT WRITTEN HERE.  The sibling entry below said "28 rows" through four
tools/pipeline/check_probe_wiring.py:650:    #  passes that took it to 50.  Derive it:
tools/pipeline/check_probe_wiring.py:651:    #
tools/pipeline/check_probe_wiring.py:652:    #      awk '/for v in "live"/{l=$0; getline n;
tools/pipeline/check_probe_wiring.py:653:    #           if (n ~ /PRIMLOG/) {print gsub(/"[^"]*"/,"",l)}}' regress/gate_arm.sh
