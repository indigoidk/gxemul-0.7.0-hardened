1574:#  advisory that cries wolf is an advisory nobody reads.  MEASURED: with the hyphen guard
1575:#  the noise line disappears and pit8253's real disagreement still fires.
1576:_LBL_W = re.compile(r"(?<![\w-])witness(?![\w-])", re.I)
