tools/pipeline/check_probe_wiring.py:1098:
tools/pipeline/check_probe_wiring.py:1099:    #  gdromcondlies RUNG-3 WITNESS, 2026-08-30.  CLASS_WITNESS on the toclen precedent
tools/pipeline/check_probe_wiring.py:1100:    #  three entries up, and for the identical reason: its two kill rows INVERT the day
