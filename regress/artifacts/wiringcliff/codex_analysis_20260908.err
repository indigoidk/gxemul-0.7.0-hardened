tools/pipeline/check_probe_wiring.py:1458:
tools/pipeline/check_probe_wiring.py:1459:def unquote(tok):
tools/pipeline/check_probe_wiring.py:1460:    tok = tok.strip().rstrip(");,")
tools/pipeline/check_probe_wiring.py:1461:    if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in "\"'":
tools/pipeline/check_probe_wiring.py:1462:        tok = tok[1:-1]
tools/pipeline/check_probe_wiring.py:1463:    return tok.strip("\"'")
