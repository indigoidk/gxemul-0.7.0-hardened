tools/pipeline/check_probe_wiring.py:245:        (CLASS_DETECTOR, "#495 wdc ATAPI data-port write during DATA-IN -- rung-3"),
tools/pipeline/check_probe_wiring.py:246:
tools/pipeline/check_probe_wiring.py:247:    #  m88kexcdeliver (#502) and lunaabsentcpu (#503), 2026-09-06: every .py these rounds preserved under
tools/pipeline/check_probe_wiring.py:248:    #  regress/artifacts/ is EVIDENCE -- frozen instruments beside their kill tables, the frozen mutant
tools/pipeline/check_probe_wiring.py:249:    #  generators and fix scripts, and the two measuring seats' own drivers.  Generated from this checker's
tools/pipeline/check_probe_wiring.py:250:    #  own UNCLASSIFIED list; one line per file, deliberately, as the pcc2 block above does.  The SHIPPED
tools/pipeline/check_probe_wiring.py:251:    #  detector m88k_exc_probe.py is the one entry here that is NOT evidence and is classified as a detector,
tools/pipeline/check_probe_wiring.py:252:    #  because the checker's own header warns that a detector misfiled as anything else silences the
tools/pipeline/check_probe_wiring.py:253:    #  requirement; its gate wiring is DERIVED below, not asserted here.
tools/pipeline/check_probe_wiring.py:254:    #  lcairqstubkill (2026-09-08): a WITNESS ATTEMPT, and it did NOT fire.  It is classified as
tools/pipeline/check_probe_wiring.py:255:    #  evidence rather than as a detector because that is what it is -- three controls green, the
tools/pipeline/check_probe_wiring.py:256:    #  assertion never reached the stub, and the round records it as an ATTEMPT rather than as a
tools/pipeline/check_probe_wiring.py:257:    #  negative result, because whether a debugger `put' reaches DEVICE_ACCESS(ns16550) at all is
tools/pipeline/check_probe_wiring.py:258:    #  still open.  A file that pins nothing must not be wired into a gate: it would be a green
tools/pipeline/check_probe_wiring.py:259:    #  row that means nothing, which is the vacuity this whole layer exists to refuse.
tools/pipeline/check_probe_wiring.py:260:    #  Not a probe of the emulator at all: it exercises the SHIPPED regex of
tools/pipeline/check_probe_wiring.py:261:    #  alpha_swpctx_v0_probe.py -- extracted from that file, not retyped -- against the three
tools/pipeline/check_probe_wiring.py:262:    #  synthetic transcripts a pass-3 seat used to measure three parser escapes.  Evidence that
tools/pipeline/check_probe_wiring.py:263:    #  the repair works, which is why it is preserved; it runs no emulator and gates nothing.
tools/pipeline/check_probe_wiring.py:264:    #  The ORDER half of the same evidence: anchoring fixed a response's SHAPE and could not fix
tools/pipeline/check_probe_wiring.py:265:    #  its ORDER, so a pass-4 seat reported two variants that still swept.  This exercises the
tools/pipeline/check_probe_wiring.py:266:    #  shipped `response_after' against both, and additionally shows the OLD count rule passing
tools/pipeline/check_probe_wiring.py:267:    #  them -- which is what makes it evidence rather than a green row.
tools/pipeline/check_probe_wiring.py:268:    #  The FULL escape corpus: all four variants reported across passes 4 and 5, run against the
tools/pipeline/check_probe_wiring.py:269:    #  shipped composed rule.  It exists because neither the positional nor the binding rule alone
tools/pipeline/check_probe_wiring.py:270:    #  was sufficient -- each let the other's escapes through -- so a test of either alone would
tools/pipeline/check_probe_wiring.py:271:    #  have been the green row that means nothing.
tools/pipeline/check_probe_wiring.py:272:    "artifacts/alphaswpctxreg/full_corpus.asrun.py":
tools/pipeline/check_probe_wiring.py:273:        (CLASS_RESEARCH, "alphaswpctxreg (#514) pass 5: all four reported escapes plus the genuine shape, against the SHIPPED composed rule -- 5/5, each rejection naming its own reason"),
tools/pipeline/check_probe_wiring.py:274:    "artifacts/alphaswpctxreg/order_attack.asrun.py":
tools/pipeline/check_probe_wiring.py:275:        (CLASS_RESEARCH, "alphaswpctxreg (#514) pass 4: the two ORDER variants (read moved before the step; first response replayed as the second) re-run against the shipped step-binding -- 3/3, both rejected, and the old count rule shown passing both"),
tools/pipeline/check_probe_wiring.py:276:    "artifacts/alphaswpctxreg/attack_parser.asrun.py":
tools/pipeline/check_probe_wiring.py:277:        (CLASS_RESEARCH, "alphaswpctxreg (#514) pass 3: the seat's three synthetic parser attacks re-run against the SHIPPED regex -- 5/5, all rejected, both genuine shapes still parsed"),
tools/pipeline/check_probe_wiring.py:278:    "artifacts/lcairqstubkill/lcairq_probe.asrun.py":
tools/pipeline/check_probe_wiring.py:279:        (CLASS_RESEARCH, "lcairqstubkill: the as-run witness ATTEMPT, preserved as evidence -- it did NOT fire, and it is not a detector"),
