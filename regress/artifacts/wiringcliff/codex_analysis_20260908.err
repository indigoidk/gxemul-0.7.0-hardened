1483:def exec_sites(regress, scripts):
1484:    """Return (hits, ignored, missing).
1485:
1486:    hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
1487:    ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
1488:    """
1489:    hits, ignored, missing = {}, [], []
1490:    for script in scripts:
1491:        path = os.path.join(regress, script)
1492:        if not os.path.isfile(path):
1493:            missing.append(script)
1494:            continue
1495:        lines = read(path).splitlines()
1496:        #  One-level variable map, from this file only.  gate_hygiene really does write
1497:        #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
1498:        #  one level would report a genuinely gated probe as unwired -- and a false red is
1499:        #  how a rule gets switched off.
1500:        varmap = {}
1501:        for ln in lines:
1502:            if ln.lstrip().startswith("#"):
1503:                continue
1504:            a = ASSIGN_RE.match(ln)
1505:            if a and ".py" in a.group(2):
1506:                varmap[a.group(1)] = unquote(a.group(2))
1507:        #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
1508:        #  flagship review MEASURED it: an invocation-shaped line inside a
1509:        #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
1510:        #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
1511:        #  its own invocation is an entirely natural shape.  Latent rather than live -- every
1512:        #  `<<` site in the battery today is a data table or a python program body, none
1513:        #  carrying an interpreter plus a probe in body position -- but this is the
1514:        #  dangerous direction: it does not fail loudly, it stops demanding a gate.
1515:        #
1516:        #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
1517:        #  that GENERATES a script the gate then runs is genuine wiring one level away, and
1518:        #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
1519:        #  That is the right error to make.
1520:        body = set()
1521:        pend = None
1522:        for no, ln in enumerate(lines, 1):
1523:            if pend is not None:
1524:                body.add(no)
1525:                if ln.strip() == pend:
1526:                    pend = None
1527:                continue
1528:            h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
1529:            if h and not ln.lstrip().startswith("#"):
1530:                pend = h.group(1)
1531:
1532:        for no, ln in enumerate(lines, 1):
1533:            if ln.lstrip().startswith("#") or no in body:
1534:                continue
1535:            for m in INTERP_RE.finditer(ln):
1536:                if not CMDPOS_RE.match(ln[: m.start()]):
1537:                    continue
1538:                toks = ln[m.end():].split()
1539:                if toks and toks[0].startswith("-c"):
1540:                    continue          # an inline program, not a script invocation
1541:                for tok in toks:
