regress/gate_crossfamily.sh:164:    # A budget of literal 0 means "deliberately none" -- landisk, whose instruction count
regress/gate_crossfamily.sh:168:    # false-FAIL the moment anyone calibrates landisk -- a bound derived from one rig is not
regress/gate_crossfamily.sh:169:    # a bound on another, and landisk's own numbers are an order of magnitude lower.
regress/gate_crossfamily.sh:190:        landisk) want=absent ;;
