tools/pipeline/check_probe_wiring.py:237:    #  shipped 128-row offline detector scores ZERO failures with the defect LIVE,
tools/pipeline/check_probe_wiring.py:238:    #  so vacuity-floor clause (a) is unsatisfiable from any existing row.  This is
tools/pipeline/check_probe_wiring.py:239:    #  the only instrument that observes the defect at all, and it is COMPLEMENTARY
tools/pipeline/check_probe_wiring.py:240:    #  to diff_wdc_identify.c rather than a replacement -- each catches mutants the
tools/pipeline/check_probe_wiring.py:241:    #  other misses, measured.
tools/pipeline/check_probe_wiring.py:242:    "sgi_re_width_probe.py":
tools/pipeline/check_probe_wiring.py:243:        (CLASS_DETECTOR, "#497 sgi_re six-site width decline -- 35 rows, wired into gate_arm.sh"),
