1580:def domain(regress):
1581:    """The .py artefacts this check governs, and (mode, why) describing how it decided.
1582:
1583:    *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
1584:    first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
1585:    round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
1586:    check went red -- correctly identifying a real unwired detector, but firing at a
1587:    file its author had not yet offered for commit, in someone else's working tree.
1588:
1589:    `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
1590:    add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
1591:    precisely when the author is present to classify it.  A scratch probe that is never
1592:    staged defends nothing in a fresh clone either, so it is honestly out of scope.
1593:
1594:    FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
1595:    git cannot answer, and a fallback that quietly changes what a check governs is the
1596:    kind of silent scope change this harness keeps being bitten by.  So the mode is
1597:    printed on the summary line.
1598:    """
1599:    try:
1600:        p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
1601:                           capture_output=True, text=True)
1602:        if p.returncode == 0:
1603:            #  #471: NO `"/" not in f` FILTER.  Its docstring always claimed "every
1604:            #  committed DETECTOR under regress/", and the filter made that false --
1605:            #  the checker could not see below top level, which is exactly where
1606:            #  #465 shipped a detector that no gate ran.
1607:            #
1608:            #  `git ls-files` yields paths RELATIVE to regress/, so a top-level file
1609:            #  still arrives as a bare basename and every existing MANIFEST key keeps
1610:            #  matching unchanged.  Only nested files gain a path key.
1611:            files = sorted(f for f in p.stdout.split()
1612:                           if f.endswith(".py")
1613:                           and os.path.isfile(os.path.join(regress, f)))
1614:            if files:
1615:                return files, "tracked-or-staged"
1616:    except OSError:
1617:        pass
1618:    #  #471: the FALLBACK must descend too.  Leaving it flat would re-create the blind
1619:    #  spot on any machine where git cannot answer -- a check whose coverage depends
1620:    #  on which branch it took is the shape this file exists to refuse.
1621:    found = []
1622:    for dirpath, dirnames, filenames in os.walk(regress):
1623:        dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
1624:        for f in filenames:
1625:            if f.endswith(".py"):
1626:                rel = os.path.relpath(os.path.join(dirpath, f), regress)
1627:                found.append(rel.replace(os.sep, "/"))
1628:    return sorted(found), "on-disk (git could not answer)"
