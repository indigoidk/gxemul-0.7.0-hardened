751:    print()
752:    print("HPCMIPS_CTOR_RESULT=%d/%d" % (len(_rows) - fails, len(_rows)))
753:    print("HPCMIPS_CTOR_PASS" if fails == 0 else "HPCMIPS_CTOR_FAIL")
