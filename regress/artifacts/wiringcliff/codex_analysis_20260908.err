187:# ---------------------------------------------------------------------------
188:def _run(argv, tmo, feed=b"quit\n"):
189:    """Returns (rc, out).  rc is an int (negative => killed by that signal),
190:    the string "timeout", or None if the run could not be started at all."""
191:    try:
192:        p = subprocess.run(argv, input=feed, stdout=subprocess.PIPE,
193:                           stderr=subprocess.STDOUT, timeout=tmo)
194:        return p.returncode, p.stdout.decode("utf-8", "replace")
195:    except subprocess.TimeoutExpired as e:
196:        return "timeout", (e.stdout or b"").decode("utf-8", "replace")
197:    except OSError as e:
198:        print("  !! could not start %r: %s" % (argv, e))
199:        return None, ""
