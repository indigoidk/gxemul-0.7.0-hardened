tools/pipeline/check_probe_wiring.py:761:        (CLASS_RESEARCH, "sgireunmapped #499 REPIN2 -- the in-situ scorer that produced the 35-emitted / 35-green / 0-red denominators, i.e. the evidence that the repair FOLDS INTO the existing row rather than adding one"),
tools/pipeline/check_probe_wiring.py:762:
tools/pipeline/check_probe_wiring.py:763:    #  sgireunmapped #499 KILL TABLE, 2026-08-31.  The table that discharged the three
tools/pipeline/check_probe_wiring.py:764:    #  undischarged accept rows (accept tlba/tlbb/tlbc) by MEASURED KILL -- M1/M2/M3 each
tools/pipeline/check_probe_wiring.py:765:    #  reddening exactly its own row -- and that found an L2 floor breach (M5) plus a
tools/pipeline/check_probe_wiring.py:766:    #  duplicate latch-bit defect #498 had silently introduced into the 08-30 generator.
tools/pipeline/check_probe_wiring.py:767:    #  CLASS_RESEARCH: evidence for a round, not detectors the battery owes a run.
tools/pipeline/check_probe_wiring.py:768:    #
tools/pipeline/check_probe_wiring.py:769:    #  *** `mkvariant499.py' REPLACES `opus_witness_20260830/mkvariant.py' AND THE REASON
tools/pipeline/check_probe_wiring.py:770:    #  MUST NOT BE PRUNED. ***  The older generator inserts `SGIRE_W_UNMAP_WR = 1 << 6',
tools/pipeline/check_probe_wiring.py:771:    #  and #498/cb28a6f added `SGIRE_W_DE_LEN = 1 << 6' to that same enum.  A duplicate
tools/pipeline/check_probe_wiring.py:772:    #  enumerator is legal C and silent, and DEVICE_ACCESS(sgi_de) casts the same struct,
tools/pipeline/check_probe_wiring.py:773:    #  so d->warned is SHARED -- measured as a 14/14 total escape.  This one uses 1<<7/1<<8
tools/pipeline/check_probe_wiring.py:774:    #  and hard-fails on duplicates.
tools/pipeline/check_probe_wiring.py:775:    #
tools/pipeline/check_probe_wiring.py:776:    #  `base_slot_probe.py' is the CONTROL for M5 and is what makes it a result rather than
tools/pipeline/check_probe_wiring.py:777:    #  a claim: it stores at the window BASE, reds on the mutant, and is serviced normally
tools/pipeline/check_probe_wiring.py:778:    #  on the fix.  Without it, `accept lina' staying green is merely a green row.
tools/pipeline/check_probe_wiring.py:779:    "artifacts/sgireunmapped/killtable_20260831/extra_rows.py":
tools/pipeline/check_probe_wiring.py:780:        (CLASS_RESEARCH, "sgireunmapped #499 -- the four rows the shipped detector lacks: the M4 latch-collision kill (two NARROW accesses in one emu) and the fix6 duplicate-bit kill, each with its own green control"),
tools/pipeline/check_probe_wiring.py:781:    "artifacts/sgireunmapped/killtable_20260831/base_slot_probe.py":
tools/pipeline/check_probe_wiring.py:782:        (CLASS_RESEARCH, "sgireunmapped #499 -- the window-BASE control that proves M5's near-bound blindness is real and not an artifact of the oracle"),
