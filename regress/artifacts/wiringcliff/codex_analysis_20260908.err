tools/pipeline/check_probe_wiring.py:810:
tools/pipeline/check_probe_wiring.py:811:    #  sgidewidth, 2026-08-31.  The measuring seat's rung-3 witness, attribution probe and
tools/pipeline/check_probe_wiring.py:812:    #  25-row / nine-build kill table, preserved because the seat reported them VOLATILE.
tools/pipeline/check_probe_wiring.py:813:    #  CLASS_RESEARCH on the #497 precedent: EVIDENCE, not detectors the battery owes a run.
tools/pipeline/check_probe_wiring.py:814:    #
tools/pipeline/check_probe_wiring.py:815:    #  *** EVERY DRIVER HERE IS A `_frozen` COPY, AND THE NAMING IS THE POINT. ***  The
tools/pipeline/check_probe_wiring.py:816:    #  carrier mandates a frozen copy for a comparison run -- editing a script a job is
tools/pipeline/check_probe_wiring.py:817:    #  reading corrupts that run in bash, and re-reads it between runs in python.  These
tools/pipeline/check_probe_wiring.py:818:    #  filenames make the obedience auditable rather than asserted.
tools/pipeline/check_probe_wiring.py:819:    #
tools/pipeline/check_probe_wiring.py:820:    #  `gxdew_mz_frozen.py` and `gxdew_mzp_frozen.py` are kept as a PAIR and must not be
tools/pipeline/check_probe_wiring.py:821:    #  pruned to one: they differ only in the byte `#95` fills (0x00 vs 0xa5), and the pair
tools/pipeline/check_probe_wiring.py:822:    #  is the control that showed a declined read returns a DETERMINISTIC value tracking
tools/pipeline/check_probe_wiring.py:823:    #  that byte.  That is what retracted my claim that the early-return mutant's observable
tools/pipeline/check_probe_wiring.py:824:    #  is nondeterministic -- keeping only one erases the attribution.
tools/pipeline/check_probe_wiring.py:825:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_probe_frozen.py":
tools/pipeline/check_probe_wiring.py:826:        (CLASS_RESEARCH, "sgidewidth rung-3 WITNESS as measured -- 4/4 kills, liveness + device-signature controls"),
tools/pipeline/check_probe_wiring.py:827:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_probe2_frozen.py":
tools/pipeline/check_probe_wiring.py:828:        (CLASS_RESEARCH, "sgidewidth attribution probe -- 24/24, offsets differing ONLY in bit 0x800"),
tools/pipeline/check_probe_wiring.py:829:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_kill_frozen.py":
tools/pipeline/check_probe_wiring.py:830:        (CLASS_RESEARCH, "sgidewidth table-1 driver, frozen for the duration of the run"),
tools/pipeline/check_probe_wiring.py:831:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_kill2_frozen.py":
tools/pipeline/check_probe_wiring.py:832:        (CLASS_RESEARCH, "sgidewidth table-2 driver (25 rows, 9 builds), frozen"),
tools/pipeline/check_probe_wiring.py:833:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_mutate2_frozen.py":
tools/pipeline/check_probe_wiring.py:834:        (CLASS_RESEARCH, "sgidewidth mutator, frozen so a re-run cannot silently differ"),
tools/pipeline/check_probe_wiring.py:835:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_mr_frozen.py":
tools/pipeline/check_probe_wiring.py:836:        (CLASS_RESEARCH, "sgidewidth mR variant builder -- the goto-to-common-exit shape, 25/25"),
tools/pipeline/check_probe_wiring.py:837:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_mz_frozen.py":
tools/pipeline/check_probe_wiring.py:838:        (CLASS_RESEARCH, "sgidewidth #95 attribution builder -- fill 0x00, the control that refuted my retraction"),
tools/pipeline/check_probe_wiring.py:839:    "artifacts/sgidewidth/opus_witness_20260831/gxdew_mzp_frozen.py":
tools/pipeline/check_probe_wiring.py:840:        (CLASS_RESEARCH, "sgidewidth #95 attribution builder -- fill 0xa5, the paired control"),
tools/pipeline/check_probe_wiring.py:841:
tools/pipeline/check_probe_wiring.py:842:    #  sgireunmapped, 2026-08-31.  The measuring seat's RUNG-3 WITNESS set, preserved
tools/pipeline/check_probe_wiring.py:843:    #  because the seat reported its artifacts were in VOLATILE SCRATCH and would be lost.
tools/pipeline/check_probe_wiring.py:844:    #  CLASS_RESEARCH on the #497 precedent above: EVIDENCE, not detectors the battery owes
tools/pipeline/check_probe_wiring.py:845:    #  a run.
tools/pipeline/check_probe_wiring.py:846:    #
tools/pipeline/check_probe_wiring.py:847:    #  `sgi_re_unmapped_probe.py` is the WITNESS that licensed the fix -- 32/32 on an
tools/pipeline/check_probe_wiring.py:848:    #  unmodified `-E sgi -e ip32`, with liveness, device-signature, neighbour-device and
tools/pipeline/check_probe_wiring.py:849:    #  negative controls.  A witness exists BEFORE the edit and is graded by the witness
tools/pipeline/check_probe_wiring.py:850:    #  clauses; a detector defends the fix afterwards and is graded by the vacuity floor.
tools/pipeline/check_probe_wiring.py:851:    #  Filing this as research keeps that distinction rather than asking a gate to run a
tools/pipeline/check_probe_wiring.py:852:    #  reproduction of a defect the round is about to remove.
tools/pipeline/check_probe_wiring.py:853:    #
tools/pipeline/check_probe_wiring.py:854:    #  `detector.py` is the seat's 14-row instrument AS MEASURED, and it is deliberately
tools/pipeline/check_probe_wiring.py:855:    #  NOT the shipping detector: the round's own copy will live in regress/ and be gated.
tools/pipeline/check_probe_wiring.py:856:    #  It is kept because a 9-variant table is worth nothing if the instrument that
tools/pipeline/check_probe_wiring.py:857:    #  produced it can change underneath the numbers.
tools/pipeline/check_probe_wiring.py:858:    #
tools/pipeline/check_probe_wiring.py:859:    #  *** AND IT IS KEPT FOR A SECOND REASON THAT IS THE ROUND'S MOST TRANSFERABLE
tools/pipeline/check_probe_wiring.py:860:    #  FINDING: this instrument contained a row that COULD NOT FAIL. ***  A latch mutant
tools/pipeline/check_probe_wiring.py:861:    #  swept 14/14 against the row written to catch it, because gxprobe cached `pc` across
tools/pipeline/check_probe_wiring.py:862:    #  `step` and the row's second access executed a nop.  The file as preserved is the
tools/pipeline/check_probe_wiring.py:863:    #  BEFORE state, and `INSTRUMENT_FINDING.md` beside it is the diagnosis.  Deleting it
tools/pipeline/check_probe_wiring.py:864:    #  would erase the only evidence of a vacuous row that eight of nine variants scored
tools/pipeline/check_probe_wiring.py:865:    #  plausibly around.
tools/pipeline/check_probe_wiring.py:866:    "artifacts/sgireunmapped/opus_witness_20260830/sgi_re_unmapped_probe.py":
tools/pipeline/check_probe_wiring.py:867:        (CLASS_RESEARCH, "sgireunmapped RUNG-3 WITNESS as measured, 32/32 -- reproduction, not detector"),
tools/pipeline/check_probe_wiring.py:868:    "artifacts/sgireunmapped/opus_witness_20260830/detector.py":
tools/pipeline/check_probe_wiring.py:869:        (CLASS_RESEARCH, "sgireunmapped 14-row instrument AS MEASURED, incl. the row that could not fail"),
