tools/pipeline/check_probe_wiring.py:1787:def _st_apply(path, old, new, want=1):
tools/pipeline/check_probe_wiring.py:1788:    src = read(path)
tools/pipeline/check_probe_wiring.py:1789:    n = src.count(old)
tools/pipeline/check_probe_wiring.py:1790:    if n != want:
