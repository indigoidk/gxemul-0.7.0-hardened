155:        % (w_ok, len(W.prog)))
156:    cd = emu.send("print cpu", wait=0.4)
157:    emu.send("breakpoint add 0x%x" % W.HALT_ADDR, wait=0.5)
158:    emu.send("continue", wait=1.0)
159:    import time as _t
160:    deadline = _t.time() + 60
161:    parked = False
162:    while _t.time() < deadline:
163:        emu.drain(0.5)
