802:    #  lesson, one screen below the paragraph that teaches it: a frozen claim goes
803:    #  false the first time anyone touches the thing it names, and nothing re-reads a
804:    #  print statement.  Found by the fable5 regress review.
805:    print("LEG 1 -- SHIPPED build: %s" % SHIPPED_BIN)
806:    print("-" * 94)
807:    ship, t_ship, hit_s, dg_s = run_one(SHIPPED_BIN, "shipped")
