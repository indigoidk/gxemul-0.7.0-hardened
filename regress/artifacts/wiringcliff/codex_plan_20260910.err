1:#!/bin/bash
2:# GATE 7 -- three-way A/B against pristine 0.7.0 and the pre-batch fork.
3:#
4:#   pristine   39748e3   unmodified upstream GXemul 0.7.0
5:#   prebatch   2ffc91e   the fork immediately before the current batch
6:#   HEAD                 what is being shipped
7:#
8:# TWO DIFFERENT QUESTIONS. Conflating them is the trap this gate exists to avoid:
9:#
10:#   vs PRISTINE  = CAPABILITY PRESERVATION. The fork carries ~290 deliberate corrections,
11:#                  so differences are EXPECTED and are not regressions. The only thing
12:#                  that counts against us is a machine that ran under upstream and no
13:#                  longer runs.
14:#
15:#   vs PREBATCH  = CHANGE-SET VERIFICATION. Everything not touched by the batch should be
16:#                  identical, and anything that moved must be attributable to a specific
17:#                  correction.
18:#
19:# `gate_ab.sh --build` (re)creates the two baselines first; without it they are reused.
20:#
21:# METHOD NOTES, both learned the hard way:
22:#
23:#  * Every run goes through run_emu_progress() (#419; run_emu() no longer has any caller),
24:#    which forces stdbuf -o0. On a pipe, gxemul's stdout
25:#    is 4 KB block-buffered and `timeout`'s SIGTERM discards a partial block -- so a guest
26:#    that produced 3 KB of good output scores ZERO. An earlier version of this comparison
27:#    reported a "capability regression" on luna88k that was entirely a lost buffer.
28:#  * Comparison is on SEMANTIC MARKERS, never on byte counts. Under a wall-clock timeout a
29:#    byte count measures how fast the host happened to be, not what the guest did.
30:set -u
31:HERE=$(cd "$(dirname "$0")" && pwd)
32:. "$HERE/lib.sh"
33:
34:SEC=$ROOT/GXEMUL-SEC
35:PRISTINE_DIR=/tmp/gx-pristine
36:PREBATCH_DIR=/tmp/gx-prebatch
37:PRISTINE_REF=39748e3
38:PREBATCH_REF=2ffc91e
39:
40:build_baseline() {   # ref, dir, label
41:    local ref=$1 dir=$2 lab=$3
42:    echo "  building $lab ($ref) -> $dir"
43:    rm -rf "$dir"; mkdir -p "$dir"
44:    ( cd "$SEC" && git archive "$ref" ) | tar -x -C "$dir"
45:    # The repo does not track the exec bit (index mode 100644), so a tree produced by
46:    # `git archive` has a non-executable configure: it fails rc=126 and the generator
47:    # scripts die with make-level "Error 127". Note that greping the log for 'error:'
48:    # MISSES that, because make spells it "Error 127" -- the object count is the real tell.
49:    chmod +x "$dir/configure" 2>/dev/null
50:    find "$dir" -name '*.sh' -exec chmod +x {} + 2>/dev/null
51:    ( cd "$dir" && sh ./configure > configure.log 2>&1 && make -j12 > build.log 2>&1 )
52:    local objs; objs=$(find "$dir/src" -name '*.o' 2>/dev/null | wc -l)
53:    echo "    objects=$objs  binary=$([ -x "$dir/gxemul" ] && stat -c%s "$dir/gxemul" || echo NONE)"
54:    [ -x "$dir/gxemul" ] || { echo "    BUILD FAILED:"
55:        grep -E "Error [0-9]+|No rule|undefined reference" "$dir/build.log" | head -8; }
56:}
57:
58:if [ "${1:-}" = "--build" ]; then
59:    echo "## building baselines"
60:    build_baseline "$PRISTINE_REF" "$PRISTINE_DIR" pristine
61:    build_baseline "$PREBATCH_REF" "$PREBATCH_DIR" prebatch
62:    echo
63:fi
