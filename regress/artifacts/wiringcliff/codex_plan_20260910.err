   check "hpcmips: probe exit" "$hpc_rc" 0
   check "hpcmips: complete, correct 28-row result" \
       "$(grep -a '^HPCMIPS_CTOR_RESULT=' "$HPCLOG")" \
       "HPCMIPS_CTOR_RESULT=28/28"
   check "hpcmips: PASS marker" \
       "$(count "$HPCLOG" '^HPCMIPS_CTOR_PASS$')" 1
