115:W.e_store(0x66, W.R_CYL_HI, t0)
116:W.e_lbu(s0, W.R_CYL_LO, t0)        # want 14 on EVERY leg
117:W.e_lbu(s1, W.R_CYL_HI, t0)        # want eb on EVERY leg
