275:
276:DRAIN_ENTRY = CODE + 0x70
277:PROLOGUE_N = 21          # 0x00 .. 0x50 inclusive
278:
279:
280:# ------------------------------------------------------------------ session
281:class Session:
282:    def __init__(self):
283:        self.buf, self.dead = "", False
284:        self.pid, self.fd = pty.fork()
285:        if self.pid == 0:
286:            os.execvp(BIN, [BIN, "-V", "-T", "-E", "cats", "-M", "32",
287:                            "0x%x:%s" % (CODE, STUB)])
288:            os._exit(127)
289:
290:    def rd(self, t=0.4):
291:        r, _, _ = select.select([self.fd], [], [], t)
292:        if self.fd not in r:
293:            return True
294:        try:
295:            d = os.read(self.fd, 65536)
296:        except OSError:
297:            self.dead = True
298:            return False
299:        if not d:
300:            self.dead = True
301:            return False
302:        self.buf += d.decode("latin1", "replace")
303:        return True
304:
305:    #  #467: an INACTIVITY deadline, not a total-time one.  This used to read
306:    #  `t = time.time()` once and loop `while time.time() - t < timeout`, so a boot
307:    #  that normally takes 40 s and took 90 s on a LOADED HOST failed -- while bytes
308:    #  were arriving the whole time.  Slow was indistinguishable from stuck, and the
309:    #  battery could only be trusted on an idle machine.
310:    #
311:    #  `rd()` cannot report progress: it returns True both when data arrives and when
312:    #  its select() times out quietly.  So progress is `len(self.buf)` changing.
313:    #
314:    #  STRICTLY MORE PERMISSIVE for a run that produces output, IDENTICAL for one that
315:    #  does not -- it cannot turn a passing run into a failing one.  `timeout` now
316:    #  means SILENCE, which is the thing actually worth failing on.
317:    def wait(self, mark=0, echo=None, timeout=60):
318:        t = time.time()
319:        seen = len(self.buf)
320:        while time.time() - t < timeout:
321:            if not self.rd():
322:                return False
323:            if len(self.buf) != seen:
324:                seen = len(self.buf)
325:                t = time.time()
326:            resp = self.buf[mark:]
327:            if echo is not None and echo not in resp:
328:                continue
329:            if len(self.buf) > mark and resp.rstrip().endswith("GXemul>"):
330:                return True
331:        return False
332:
333:    def send(self, x, timeout=60):
334:        b = (x + "\n").encode("latin1")
335:        #  `_mark`, not `mark`: gate 6's fresh-mark census keys on that exact spelling.
336:        #  Every other pty probe in the tree writes it that way, so a probe spelling it
337:        #  `mark` has the guard PRESENT and UNCOUNTED -- two of the three counts move and
338:        #  the third does not, a signature that reads like a defect and is not one.
339:        _mark, n = len(self.buf), 0
340:        try:
341:            while n < len(b):
342:                n += os.write(self.fd, b[n:])
343:        except OSError:
344:            self.dead = True
345:            return False
346:        return self.wait(mark=_mark, echo=x if x else None, timeout=timeout)
347:
348:    def free_run(self, seconds):
349:        mark = len(self.buf)
350:        b, n = b"continue\n", 0
351:        try:
352:            while n < len(b):
353:                n += os.write(self.fd, b[n:])
354:        except OSError:
355:            self.dead = True
356:            return False, 0.0
357:        t0 = time.time()
358:        while time.time() - t0 < seconds:
359:            if not self.rd(0.25):
360:                return False, time.time() - t0
361:        try:
362:            os.kill(self.pid, signal.SIGINT)
363:        except OSError:
364:            self.dead = True
365:            return False, time.time() - t0
366:        ok = self.wait(mark=mark, timeout=20)
367:        t1 = time.time()
368:        if not ok and not self.dead:
369:            try:
370:                os.kill(self.pid, signal.SIGINT)
371:            except OSError:
372:                pass
373:            ok = self.wait(mark=mark, timeout=20)
374:            t1 = time.time()
375:        return ok, t1 - t0
376:
377:    def read_words(self, addr, n):
378:        mark = len(self.buf)
379:        if not self.send("dump 0x%08x 0x%08x" % (addr, addr + 4 * n)):
380:            return None
381:        out = {}
382:        for line in self.buf[mark:].splitlines():
383:            m = re.match(r"\s*0x([0-9a-f]{8})\s+((?:[0-9a-f]{8}\s+){1,4})", line)
384:            if not m:
385:                continue
386:            base = int(m.group(1), 16)
387:            for i, w in enumerate(m.group(2).split()):
388:                out[base + 4 * i] = struct.unpack("<I", struct.pack(">I", int(w, 16)))[0]
389:        vals = [out.get(addr + 4 * i) for i in range(n)]
390:        return None if any(v is None for v in vals) else vals
391:
392:    def regs(self, which=(3, 5, 6, 7)):
393:        mark = len(self.buf)
394:        if not self.send("reg", timeout=30) or self.dead:
395:            return {}
396:        seg, got = self.buf[mark:], {}
397:        for k in which:
398:            m = re.search(r"\br%d\s*=\s*0x([0-9a-fA-F]+)" % k, seg)
399:            if m:
400:                got[k] = int(m.group(1), 16)
401:        return got
402:
403:    def close(self):
404:        for f in (lambda: os.write(self.fd, b"quit\n"), lambda: time.sleep(0.3),
405:                  lambda: os.close(self.fd), lambda: os.waitpid(self.pid, 0)):
406:            try:
407:                f()
408:            except Exception:
409:                pass
410:
411:
412:def plant(s, prog):
413:    for off, v in CONSTS.items():
414:        s.send("put w 0x%08x, 0x%08x" % (DATA + off, v))
415:    for off in OUTS:
416:        s.send("put w 0x%08x, 0x%08x" % (DATA + off, POISON))
417:    for off, word, _t, _c in prog:
418:        s.send("put w 0x%08x, 0x%08x" % (CODE + off, word))
419:    s.send("pc=0x%08x" % CODE)
420:
421:
422:def spell_ok(expected, got):
423:    """The emulator's own spelling differs cosmetically from the generator's:
424:    it prints `ldr r5,[r4]` for a zero offset and `#0` rather than `#0x0`.  Those
425:    are FORMAT differences, not encoding differences -- the WORD is compared
426:    separately and exactly.  Normalise both sides so the check keeps its teeth
427:    (a wrong register or a wrong offset still fails) without red rows for
428:    punctuation."""
429:    def norm(t):
430:        t = re.sub(r"\s+", "", t.lower())
431:        t = re.sub(r",#0\]", "]", t)                      # [r4,#0]  -> [r4]
432:        t = re.sub(r"#0x([0-9a-f]+)",
433:                   lambda m: "#" + str(int(m.group(1), 16)), t)   # #0x100 -> #256
434:        return t
435:    return norm(expected) == norm(got)
436:
437:
438:def step_and_check(s, prog, n):
439:    planted = {CODE + off: (w, t) for off, w, t, _ in prog}
440:    bad, covered, ex = [], set(), []
441:    for _ in range(n):
442:        mark = len(s.buf)
443:        if not s.send("step 1", timeout=30) or s.dead:
444:            bad.append("host died / no prompt at step %d" % (len(ex) + 1))
445:            break
446:        m = re.search(r"([0-9a-f]{8}):\s+([0-9a-f]{8})\s+([^\r\n<]+)", s.buf[mark:])
447:        if not m:
448:            bad.append("no step line at step %d" % (len(ex) + 1))
449:            break
450:        addr, word = int(m.group(1), 16), int(m.group(2), 16)
451:        got = re.sub(r"\s+", " ", m.group(3)).strip()
452:        ex.append((addr, word, got))
453:        if addr not in planted:
454:            bad.append("stepped 0x%08x, never planted" % addr)
455:            continue
456:        pw, pt = planted[addr]
457:        covered.add(addr)
458:        if word != pw:
459:            bad.append("0x%08x read back 0x%08x, planted 0x%08x" % (addr, word, pw))
460:        if pt is not None and not spell_ok(pt, got):
461:            bad.append("0x%08x %08x -> %r, expected %r" % (addr, word, got, pt))
462:    return bad, covered, ex
463:
464:
465:def run_arm(label, mmu_on=False, disable=False, accrue=None, max_drain_s=30.0):
466:    accrue = ACCRUE_S if accrue is None else accrue
467:    prog = build(mmu_on=mmu_on, disable_during_accrual=disable)
468:    s = Session()
469:    if not s.wait(timeout=120):
470:        s.close()
471:        return dict(label=label, status="NO-PROMPT")
472:    plant(s, prog)
473:    bad, cov, ex = step_and_check(s, prog, PROLOGUE_N)
474:    #  ACCRUAL.  The SIGALRM timer is stopped at the debugger prompt
475:    #  (debugger.c:800) and restarted on `continue` (:840), so only free-run
476:    #  seconds accrue -- which is what makes rate*T predictable at all.
477:    ok, dt = s.free_run(accrue)
478:    accrued = dt
479:    mid = s.read_words(DATA + O_DRAIN, 5) if ok and not s.dead else None
480:    #  PHASE CHANGE: the harness, not a guest clock, decides when accrual ends.
481:    if ok and not s.dead:
482:        s.send("pc=0x%08x" % DRAIN_ENTRY)
483:    #  DRAIN, in slices, until PHASE says done.
484:    t0, phase, out = time.time(), None, None
485:    while ok and not s.dead and time.time() - t0 < max_drain_s:
486:        ok, _ = s.free_run(0.5)
487:        if not ok or s.dead:
488:            break
489:        out = s.read_words(DATA + O_DRAIN, 5)
490:        if out is None:
491:            break
492:        phase = out[4]
493:        if phase in (3, 4):
494:            break
495:    r = s.regs()
496:    status = "HOST-DIED" if s.dead else ("SURVIVED" if ok else "INTERRUPT-LOST")
497:    s.close()
498:    return dict(label=label, status=status, regs=r, badis=bad, executed=ex,
499:                covered=cov, want={CODE + o for o, *_ in prog},
500:                accrued=accrued, mid=mid, out=out, phase=phase,
501:                drain_s=time.time() - t0)
502:
503:
504:#  Arm E walks the drain body in SEGMENTS, each entered by setting pc directly.
505:#
506:#  WHY SEGMENTS AND NOT ONE WALK, stated because the first draft did the obvious
507:#  thing and got 7 offsets of silent non-coverage: under `step 1` the emulated CPU
508:#  advances ONE cycle per command, and DEVICE_TICK is driven by the dyntrans cycle
509:#  counter at one call per 1 << DEV_FOOTBRIDGE_TICK_SHIFT == 16384 cycles.  So a
510:#  single-stepped SPIN loop can never see a delivered tick inside a few dozen steps
511:#  and the TICKSEEN arm is unreachable by stepping, however large the backlog is.
512:#
513:#  This check is about DECODE, not about control flow: it asks whether the emulator
514:#  reads back each planted word as the instruction the assembler above meant.  That
515:#  question is answered wherever the word executes, so entering a segment at its head
516:#  is legitimate here -- and it is NOT a substitute for the behavioural evidence,
517:#  which is separate: reaching phase 3 with a non-zero drained count is only possible
518:#  if 0xac..0xc4 and 0xc8..0xd4 executed for real, in order, during arms D and X.
519:E_SEGMENTS = ((0x70, 12),        # re-enable NOPs, freeze, PHASE=1, DLOOP, SPIN head
520:              (0xa0, 2),         # subs fp / bne SPIN
521:              (0xa8, 1),         # b DONE -- the budget-expiry arm
522:              (0xac, 7),         # TICKSEEN .. b DLOOP
523:              (0xc8, 5),         # DONE .. HALT
524:              (0xdc, 2),         # OVER
525:              (0xe4, 1))         # b HALT
526:
527:
528:def run_drainenc():
529:    """Arm E: every word of the drain body stepped as it EXECUTES."""
530:    prog = build()
531:    s = Session()
532:    if not s.wait(timeout=120):
533:        s.close()
534:        return dict(status="NO-PROMPT", badis=[], covered=set(), nsteps=0, executed=[])
535:    plant(s, prog)
536:    bad, cov, ex = step_and_check(s, prog, PROLOGUE_N)
537:    for head, n in E_SEGMENTS:
538:        if s.dead:
539:            break
540:        s.send("pc=0x%08x" % (CODE + head))
541:        b2, c2, e2 = step_and_check(s, prog, n)
542:        bad += b2
543:        cov |= c2
544:        ex += e2
545:    status = "HOST-DIED" if s.dead else "SURVIVED"
546:    s.close()
547:    return dict(status=status, badis=bad, covered=cov, nsteps=len(ex), executed=ex)
548:
549:
550:def run_kill():
551:    prog = build(kill=True)
552:    s = Session()
553:    if not s.wait(timeout=120):
554:        s.close()
555:        return dict(status="NO-PROMPT", saw=False)
556:    plant(s, prog)
557:    step_and_check(s, prog, PROLOGUE_N + 3)
558:    died = s.dead
559:    if not died:
560:        s.send("reg", timeout=10)
561:        died = s.dead
562:    saw = "ENABLE SET" in s.buf
563:    s.close()
564:    return dict(status="HOST-DIED" if died else "SURVIVED", saw=saw)
565:
566:
567:def main():
568:    t0 = time.time()
569:    print("=" * 78)
570:    print("fbpending DRAIN PROBE -- %s" % BIN)
571:    print("  TIMER %d (index %d, base 0x%x): FCLK_256, load %d -> %.2f Hz.  accrual %.1f s"
572:          % (TIMER_NR + 1, TIMER_NR, TBASE, LOAD_RUN, RATE, ACCRUE_S))
573:    print("  UNCAPPED prediction: backlog = %.0f" % (RATE * ACCRUE_S))
574:    print("=" * 78)
575:
576:    skip = dict(label="(not run)", status="SKIPPED", regs={}, badis=[],
577:                covered=set(), executed=[], out=None, mid=None, phase=None)
578:    K = run_kill() if not ONLY else dict(status="SKIPPED", saw=False)
579:    E = run_drainenc() if not ONLY else dict(status="SKIPPED", badis=[],
580:                                             covered=set(), nsteps=0, executed=[])
581:    T = (run_arm("T (MMU ON, negative control)", mmu_on=True, accrue=1.0,
582:                 max_drain_s=4.0) if not ONLY else dict(skip, label="T"))
583:    D = (run_arm("D (enabled throughout)") if ONLY != "X" else dict(skip, label="D"))
584:    X = (run_arm("X (DISABLED during accrual)", disable=True)
585:         if ONLY != "D" else dict(skip, label="X"))
586:
587:    for A in (D, X, T):
588:        print("\n--- arm %s ---" % A["label"])
589:        print("    status %s  accrued %.2f s  drain wall %.1f s  phase %s"
590:              % (A["status"], A.get("accrued", 0), A.get("drain_s", 0),
591:                 A.get("phase")))
592:        if A.get("badis"):
593:            print("    *** ENCODING / READBACK MISMATCH ***")
594:            for b in A["badis"]:
595:                print("        " + b)
596:        if LEARN:
597:            for a, w, t in A.get("executed", []):
598:                print("      0x%08x  %08x  %s" % (a, w, t))
599:        rr = A.get("regs", {})
600:        print("    regs " + ", ".join("r%d=0x%x" % (k, v) for k, v in sorted(rr.items())))
601:        mid, out = A.get("mid"), A.get("out")
602:        if mid:
603:            print("    at end of accrual : drained=%-10s iters=%-12s lastv=0x%08x "
604:                  "vendor=0x%08x phase=%s"
605:                  % (mid[0], mid[1], mid[2], mid[3], mid[4]))
606:        if out:
607:            print("    after the drain   : drained=%-10s iters=%-12s lastv=0x%08x "
608:                  "vendor=0x%08x phase=%s"
609:                  % (out[0], out[1], out[2], out[3], out[4]))
610:
611:    print("\n--- arm E (drain body, stepped as it EXECUTES) ---")
612:    print("    status %s, %d steps, %d distinct offsets covered"
613:          % (E["status"], E["nsteps"], len(E["covered"])))
614:    for b in E["badis"]:
615:        print("        " + b)
616:    if LEARN:
617:        for a, w, t in E["executed"]:
618:            print("      0x%08x  %08x  %s" % (a, w, t))
619:
620:    print("\n--- arm K (failability) ---")
621:    print("    status %s, saw the device's own complaint: %s" % (K["status"], K["saw"]))
622:
623:    print("\n" + "=" * 78)
624:    print("CONTROLS")
625:    print("=" * 78)
626:    ok = True
627:
628:    def row(tag, good, detail):
629:        nonlocal ok
630:        ok &= bool(good)
631:        print("  %-4s %-46s %s" % ("ok" if good else "FAIL", tag, detail))
632:
633:    rD, rX, rT = D.get("regs", {}), X.get("regs", {}), T.get("regs", {})
634:    ranD = D["status"] == "SURVIVED" and D.get("out") is not None
635:    ranX = X["status"] == "SURVIVED" and X.get("out") is not None
636:    row("R0 every arm produced data",
637:        ranD and ranX and T["status"] != "NO-PROMPT" and K["status"] != "NO-PROMPT",
638:        "D=%s X=%s T=%s K=%s" % (D["status"], X["status"], T["status"], K["status"]))
639:    row("C1 liveness: RAM through the same decode",
640:        rD.get(5) == 0x11223344 and rX.get(5) == 0x11223344,
641:        "D r5=0x%x  X r5=0x%x" % (rD.get(5, -1), rX.get(5, -1)))
642:    row("C2 the MMU is OFF in the device arms",
643:        (rD.get(3, 1) & 1) == 0 and (rX.get(3, 1) & 1) == 0,
644:        "CP15 c1: D=0x%x X=0x%x" % (rD.get(3, -1), rX.get(3, -1)))
645:    row("A1 device signature VENDOR_ID",
646:        rD.get(6) == VENDOR and rX.get(6) == VENDOR,
647:        "D r6=0x%x X r6=0x%x (expect 0x%x)" % (rD.get(6, -1), rX.get(6, -1), VENDOR))
648:    row("A2 device signature: the handler's own 24-bit mask",
649:        rD.get(7) == LOADBACK and rX.get(7) == LOADBACK,
650:        "wrote 0x12345678, read D=0x%08x X=0x%08x" % (rD.get(7, -1), rX.get(7, -1)))
651:    drain_words = {CODE + o for o in range(0x70, 0xe8, 4)}
652:    row("E  encodings: prologue AND drain body, as EXECUTED",
653:        not D.get("badis") and not X.get("badis") and not E["badis"]
654:        and not (drain_words - E["covered"]),
655:        "%d mismatches; drain offsets not stepped: %s"
656:        % (len(D.get("badis", [])) + len(X.get("badis", [])) + len(E["badis"]),
657:           " ".join("0x%x" % a for a in sorted(drain_words - E["covered"])) or "none"))
658:    row("K  failability: the kill instruction really kills",
659:        K["status"] == "HOST-DIED" and D["status"] == "SURVIVED",
660:        "K=%s (complaint seen: %s)" % (K["status"], K["saw"]))
661:    row("T  the MMU-ON control cannot see the device",
662:        rT.get(6) != VENDOR and rT.get(7) != LOADBACK,
663:        "T r6=0x%x r7=0x%x" % (rT.get(6, -1), rT.get(7, -1)))
664:    row("L1 the guest ran during the accrual",
665:        ranD and D["out"][1] not in (None, POISON) and D["out"][1] > 1000,
666:        "arm D accrual iterations = %s" % (D["out"][1] if ranD else "n/a"))
667:    row("L2 the device answered a fresh read after the drain",
668:        ranD and D["out"][3] == VENDOR,
669:        "arm D final VENDOR_ID = 0x%08x" % (D["out"][3] if ranD else -1))
670:    row("P  the drain terminated normally (phase 3, not the limit)",
671:        ranD and D["phase"] == 3 and ranX and X["phase"] == 3,
672:        "D phase=%s X phase=%s (4 == drain limit %d hit)"
673:        % (D.get("phase"), X.get("phase"), LIMIT))
674:
675:    print("\n" + "=" * 78)
676:    print("MEASURED")
677:    print("=" * 78)
678:    predicted = RATE * D.get("accrued", 0)
679:
