1549:def exec_sites(regress, scripts):
1550:    """Return (hits, ignored, missing).
1551:
1552:    hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
1553:    ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
1554:    """
1555:    hits, ignored, missing = {}, [], []
1556:    for script in scripts:
1557:        path = os.path.join(regress, script)
1558:        if not os.path.isfile(path):
1559:            missing.append(script)
1560:            continue
1561:        lines = read(path).splitlines()
1562:        #  One-level variable map, from this file only.  gate_hygiene really does write
1563:        #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
1564:        #  one level would report a genuinely gated probe as unwired -- and a false red is
1565:        #  how a rule gets switched off.
1566:        varmap = {}
1567:        for ln in lines:
1568:            if ln.lstrip().startswith("#"):
1569:                continue
1570:            a = ASSIGN_RE.match(ln)
1571:            if a and ".py" in a.group(2):
1572:                varmap[a.group(1)] = unquote(a.group(2))
1573:        #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
1574:        #  flagship review MEASURED it: an invocation-shaped line inside a
1575:        #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
1576:        #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
1577:        #  its own invocation is an entirely natural shape.  Latent rather than live -- every
1578:        #  `<<` site in the battery today is a data table or a python program body, none
1579:        #  carrying an interpreter plus a probe in body position -- but this is the
1580:        #  dangerous direction: it does not fail loudly, it stops demanding a gate.
1581:        #
1582:        #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
1583:        #  that GENERATES a script the gate then runs is genuine wiring one level away, and
1584:        #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
1585:        #  That is the right error to make.
1586:        body = set()
1587:        pend = None
1588:        for no, ln in enumerate(lines, 1):
1589:            if pend is not None:
1590:                body.add(no)
1591:                if ln.strip() == pend:
1592:                    pend = None
1593:                continue
1594:            h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
1595:            if h and not ln.lstrip().startswith("#"):
1596:                pend = h.group(1)
1597:
1598:        for no, ln in enumerate(lines, 1):
1599:            if ln.lstrip().startswith("#") or no in body:
1600:                continue
1601:            for m in INTERP_RE.finditer(ln):
1602:                if not CMDPOS_RE.match(ln[: m.start()]):
1603:                    continue
1604:                toks = ln[m.end():].split()
1605:                if toks and toks[0].startswith("-c"):
1606:                    continue          # an inline program, not a script invocation
1607:                for tok in toks:
1608:                    t = unquote(tok)
1609:                    v = VAR_RE.match(t)
1610:                    if v:
1611:                        t = varmap.get(v.group(1), "")
1612:                    if not t.endswith(".py"):
1613:                        continue
1614:                    d, b = os.path.split(t)
1615:                    if d in HERE_DIRS:
1616:                        hits.setdefault(b, []).append("%s:%d" % (script, no))
1617:                    else:
1618:                        #  #471: a NESTED invocation is keyed by its RELATIVE PATH, not
1619:                        #  its basename.  Before this, a gate invoking
1620:                        #  `artifacts/.../gdrom_pio_null_probe.py` was filed as an
1621:                        #  EXTERNAL reference and IGNORED -- so the detector #465 wired
1622:                        #  by hand still reported UNWIRED once the scan could see it.
1623:                        #
1624:                        #  Path keys are also what makes the re-key SAFE: two detectors
1625:                        #  sharing a basename in different directories stay distinct,
1626:                        #  where basename keys would mark BOTH gated when only one is.
1627:                        rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
1628:                        if os.path.isfile(os.path.join(regress, rel)):
1629:                            hits.setdefault(rel, []).append("%s:%d" % (script, no))
1630:                        else:
1631:                            ignored.append("%s:%d  %s" % (script, no, t))
1632:                    break             # the first .py argument is the script
1633:    return hits, ignored, missing
