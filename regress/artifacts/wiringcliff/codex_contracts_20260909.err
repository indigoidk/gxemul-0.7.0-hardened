 569: 
 570:     out("=" * 94)
 571:     out("wdcaltoffset -- RUNG-3 WITNESS + DETECTOR on unmodified `evbmips -e malta`")
 572:     out("=" * 94)
 573:     out("date      %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
 574:     out("machine   evbmips -e malta   5Kc, LITTLE endian   (machine desc UNMODIFIED)")
 575:     out("wdc       physical 0x180001f0 via bus_pci piix4_ide; KSEG1 0xffffffffb80001f0")
 576:     out("altstat   physical 0x180003f6 len 2; offset 1 = 0x180003f7 = the READ-ONLY")
