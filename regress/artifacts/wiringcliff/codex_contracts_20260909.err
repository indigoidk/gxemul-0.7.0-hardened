 548:              ("write to DATA, but not", "reading too much", "wdc inbuf overrun",
 549:               "wdc inbuf full", "write to ALT. CTRL", "DRIVE ADDRESS")}
 550:     emu.close(os.path.join(OUTDIR, "transcript_%s.log" % tag))
