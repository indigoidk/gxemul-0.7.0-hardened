 676: def reg(emu, name):
 677:     for _ in range(5):
 678:         out = emu.send("print %s" % name, wait=0.35)
 679:         m = re.findall(r"0x[0-9a-fA-F]+", out)
 680:         if m:
 681:             return int(m[-1], 16)
 682:         emu.drain(0.25)
 683:     return None
