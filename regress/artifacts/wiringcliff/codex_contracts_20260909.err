 198: DATA_HI, DATA_LO = 0xb800, 0x01f0  # wdc data port, KSEG1 (physical 0x180001f0)
 199: CMD_OFF = 7                        # wd_command (W) / wd_status (R)
 200: RAM_HI = 0x8020                    # KSEG0 scratch for the RAM liveness control
 201: 
 202: DRDY, DSC, DRQ, ERR = 0x40, 0x10, 0x08, 0x01
 203: ST_DATAIN = DRDY | DSC | DRQ       # 0x58 -- ERR cleared by wdc_command()
 204: #  0x50.  In PHASE_COMPLETED the phase carries no WDCS_DRQ, so DRQ here reflects
 205: #  ring occupancy alone: this is the byte an EMPTY ring produces.
 206: ST_IDLE = DRDY | DSC               # 0x50 -- DRQ clear, nothing queued
 207: 
 208: ATAPI_PKT_CMD = 0xa0
 209: #  WDCC_RECAL: the M arm's clearing command.  Chosen because its whole case body is
 210: #  `d->int_assert = 1; break;` -- it pushes nothing into the ring, so the arm starts
 211: #  from a known-empty ring rather than from a drain.
 212: #
 213: #  *** NOT WDCC_IDENTIFY, AND THE REASON IS NOT OBVIOUS FROM THE COMMAND TABLE. ***
 214: #  wdc_command() takes an early return, BEFORE its switch, when the drive is a CDROM
 215: #  and the command is WDCC_IDENTIFY.  This probe attaches a CD image (`-d ciR:`), so
 216: #  IDENTIFY would never reach its case here.  The flag would still clear -- the early
 217: #  returns sit after wdc_new_command_reset() -- but for a reason no reader of the
 218: #  switch would see.  Found by a packet-fed panel seat that noticed the brief had
 219: #  inlined the switch without the function's two early returns.
 220: WDCC_RECAL = 0x10
 221: #  The SECOND no-fill vehicle, and it is not redundancy -- see the N arm.  Same case
 222: #  shape as RECAL (`debug(); d->int_assert = 1; break;`), different opcode.
 223: ATAPI_SOFT_RESET = 0x08
 224: # READ(10): opcode, flags, LBA[4] big-endian, reserved, len[2] big-endian, control
 225: #
 226: # *** THE BLOCK COUNT IS 128, NOT THE 32 THE ROUND'S SKETCH ASSUMED, AND THE
 227: #     DIFFERENCE IS THE WHOLE WITNESS.  MEASURED, then explained: ***
 228: # The sketch said "32 blocks on a CD-ROM", which reads as 32 x 2048 = 65536.
 229: # In THIS tree a CD-ROM's logical_block_size is 512, not 2048 --
 230: # diskimage.c:1984-1990 wraps the pmax/2048 choice in `#if 0` and assigns 512
 231: # unconditionally, with a comment recording that OpenBSD/arc requires 512.
 232: # diskimage_scsicmd.c:766 then computes size = retlen * logical_block_size.
 233: # So 32 blocks is 16384 bytes -- BELOW the 32768 chunk clamp, so the whole
 234: # transfer fits in chunk 1, atapi_received reaches data_in_len exactly, the
 235: # re-arm takes its `else` branch to PHASE_COMPLETED, and NO SECOND CHUNK IS
 236: # EVER FETCHED.  The defect cannot be exhibited at 32 blocks.
 237: # MEASURED at 32 blocks: row F returned a5 (the injected byte) with the ring
 238: # holding only the injection, and the over-read latch fired -- the signature of
 239: # a transfer that ended early, not of the defect.
 240: # 128 blocks x 512 = 65536 -> chunk 1 = 32768, chunk 2 = 32768, which is the
 241: # two-chunk shape the defect needs.  ofs = LBA * 512 = 0, so data_in[j] is
 242: # still image[j] and the poisoned offsets are unchanged.
 243: READ_BLOCKS = 128
 244: CDB = [0x28, 0, 0, 0, 0, 0, 0,
 245:        (READ_BLOCKS >> 8) & 0xff, READ_BLOCKS & 0xff, 0, 0, 0]
 246: 
 247: DRAIN_AFTER_FIRST = 32766          # 1 (row D) + 32766 = 32767 pops -> atapi_len == 1
 248: #  Rows G/H/I take three bytes of chunk 2; this drains the rest so the transfer
 249: #  COMPLETES and atapi_phase leaves DATA-IN.  32768 - 3 = 32765.
 250: DRAIN_CHUNK2 = 32765
 251: INJECT = 0x5aa5                    # -> pushes 0xa5 then 0x5a
 252: 
 253: zero, t0, t1, t2, t3, t4, t5, t6 = 0, 8, 9, 10, 11, 12, 13, 14
 254: s0, s1, s2, s3, s4, s5, s6, s7 = 16, 17, 18, 19, 20, 21, 22, 23
 255: t8, t9 = 24, 25
 256: #  t7/v0 carry the M arm's readbacks and v1/a0 the N arm's.  Each arm deliberately
 257: #  uses its OWN output registers for its scratch stores too, so neither touches a
 258: #  register any other arm uses -- see the note above the M arm.
 259: t7, v0, v1, a0 = 15, 2, 3, 4
 260: 
 261: 
 262: def R(op, rs, rt, rd, sa, fn):
 263:     return (op << 26) | (rs << 21) | (rt << 16) | (rd << 11) | (sa << 6) | fn
 264: 
 265: 
 266: def I(op, rs, rt, imm):
 267:     return (op << 26) | (rs << 21) | (rt << 16) | (imm & 0xffff)
 268: 
 269: 
 270: def lui(rt, imm):
 271:     return I(0x0F, 0, rt, imm)
 272: 
 273: 
 274: def ori(rt, rs, imm):
 275:     return I(0x0D, rs, rt, imm)
 276: 
 277: 
 278: def addiu(rt, rs, imm):
 279:     return I(0x09, rs, rt, imm)
 280: 
 281: 
 282: def sb(rt, off, base):
 283:     return I(0x28, base, rt, off)
 284: 
 285: 
 286: def sh(rt, off, base):
 287:     return I(0x29, base, rt, off)
 288: 
 289: 
 290: def sw(rt, off, base):
 291:     #  Added by `wdcatapistswap` after a measuring seat found the probe had NO 4-byte
 292:     #  access emitter at all -- no `sw`, no `lw` -- so `case 4:` on both endian arms,
 293:     #  were unexercised on every leg of every run this detector had ever made.
 294:     #
 295:     #  *** THIS SENTENCE ALSO CLAIMED THE `sw` EXERCISES `consumed = len == 4 ? 4 :
 296:     #  ...`.  IT CANNOT, AND A SEAT CHECKED THE SCOPE RATHER THAN THE NAME. ***
 297:     #  `consumed` lives inside `if (writeflag == MEM_READ)`, so no STORE reaches it;
 298:     #  it needs a 4-byte LOAD, and this probe's only load emitter is `lbu`.  So
 299:     #  `consumed` has only ever taken its `: 1` branch, before this round and after.
 300:     #  The BE push arms are likewise unexecuted -- the guest is little-endian -- and

exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$lineNumber = 0; Get-Content -LiteralPath '"'C:/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/regress/wdc_addtoinbuf_probe.py' | ForEach-Object { "'$lineNumber++; if ($lineNumber -ge 301 -and $lineNumber -le 580) { '"'{0,4}: {1}' -f "'$lineNumber, $_ } }' in C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC
 succeeded in 1429ms:
 301:     #  `-e maltabe` is a registered in-tree subtype, so a BE leg is a one-word argv
 302:     #  change rather than a machine edit (`wdcprobeendian`).
 303:     return I(0x2b, base, rt, off)
 304: 
 305: 
 306: def lbu(rt, off, base):
 307:     return I(0x24, base, rt, off)
 308: 
 309: 
 310: def bne(rs, rt, off):
 311:     return I(0x05, rs, rt, off)
 312: 
 313: 
 314: def beq(rs, rt, off):
 315:     return I(0x04, rs, rt, off)
 316: 
 317: 
 318: def or_(rd, rs, rt):
 319:     return R(0, rs, rt, rd, 0, 0x25)
 320: 
 321: 
 322: NOP = 0
 323: prog = []
 324: 
 325: 
 326: def emit(word, want_mnemonic):
 327:     prog.append((word, want_mnemonic))
 328: 
 329: 
 330: emit(lui(t0, DATA_HI), "lui t0,0xb800")
 331: emit(ori(t0, t0, DATA_LO), "ori t0,t0,0x01f0")
 332: emit(lui(t4, RAM_HI), "lui t4,0x8020")
 333: 
 334: # A -- RAM LIVENESS, identical instruction shapes, plain RAM.
 335: emit(addiu(t3, zero, 0x55), "addiu t3,zr,85")
 336: emit(sb(t3, 0, t4), "sb t3,0(t4)")
 337: emit(lbu(t8, 0, t4), "lbu t8,0(t4)")
 338: 
 339: # B -- DEVICE SIGNATURE.  Two pushes, then two reads of the SAME address.
 340: emit(addiu(t3, zero, 0x5a), "addiu t3,zr,90")
 341: emit(sb(t3, 0, t0), "sb t3,0(t0)")
 342: emit(addiu(t3, zero, 0xa5), "addiu t3,zr,165")
 343: emit(sb(t3, 0, t0), "sb t3,0(t0)")
 344: emit(lbu(s0, 0, t0), "lbu s0,0(t0)")
 345: emit(lbu(s1, 0, t0), "lbu s1,0(t0)")
 346: # ring is empty again here: head == tail == 2.
 347: 
 348: # ARM the packet command.
 349: emit(addiu(t3, zero, ATAPI_PKT_CMD), "addiu t3,zr,160")
 350: emit(sb(t3, CMD_OFF, t0), "sb t3,7(t0)")
 351: 
 352: # Send the 12-byte CDB.  t3 is reloaded only when the value changes.
 353: last = None
 354: for b in CDB:
 355:     if b != last:
 356:         emit(addiu(t3, zero, b), "addiu t3,zr,%d" % b)
 357:         last = b
 358:     emit(sb(t3, 0, t0), "sb t3,0(t0)")
 359: # On the 12th byte the dispatch fires and 32768 bytes are pushed.
 360: 
 361: # C -- status with the DATA-IN chunk queued.
 362: emit(lbu(s2, CMD_OFF, t0), "lbu s2,7(t0)")
 363: 
 364: # D -- first DATA-IN byte: the poisoned image byte 0xC0 (disk-content control).
 365: emit(lbu(s3, 0, t0), "lbu s3,0(t0)")
 366: 
 367: # drain the rest of chunk 1 but ONE byte.
 368: emit(ori(t2, zero, DRAIN_AFTER_FIRST), "ori t2,zr,0x7ffe")
 369: emit(lbu(t5, 0, t0), "lbu t5,0(t0)")
 370: emit(addiu(t2, t2, -1), "addiu t2,t2,-1")
 371: emit(bne(t2, zero, -3), "bne zr,t2,")
 372: emit(NOP, "nop")
 373: 
 374: # E -- THE INJECTION.  One 2-byte store while atapi_phase == PHASE_DATAIN.
 375: emit(ori(t6, zero, INJECT), "ori t6,zr,0x5aa5")
 376: emit(sh(t6, 0, t0), "sh t6,0(t0)")
 377: 
 378: # F -- the last chunk-1 byte.  THIS read takes atapi_len to 0 and fires the
 379: #      re-arm, which refills chunk 2 onto a ring still holding the injected bytes.
 380: emit(lbu(s4, 0, t0), "lbu s4,0(t0)")
 381: 
 382: # G/H/I -- what the guest is handed as "chunk 2".
 383: emit(lbu(s5, 0, t0), "lbu s5,0(t0)")
 384: emit(lbu(s6, 0, t0), "lbu s6,0(t0)")
 385: emit(lbu(s7, 0, t0), "lbu s7,0(t0)")
 386: 
 387: #  ---- J/K/L: THE PHASE-COMPLETED ARM.  Added after mutant M5 escaped at 20/20. ----
 388: #
 389: #  M5 narrows the guard from `!= PHASE_CMDOUT` to `== PHASE_DATAIN`.  Every row above
 390: #  injects during DATA-IN, where BOTH forms refuse, so M5 passed all twenty.  It lets
 391: #  stores through in PHASE_COMPLETED, which the shipped guard refuses.
 392: #
 393: #  J -- drain the rest of chunk 2 so the transfer completes and the phase moves on.
 394: emit(ori(t2, zero, DRAIN_CHUNK2), "ori t2,zr,0x7ffd")
 395: emit(lbu(t5, 0, t0), "lbu t5,0(t0)")
 396: emit(addiu(t2, t2, -1), "addiu t2,t2,-1")
 397: emit(bne(t2, zero, -3), "bne zr,t2,")
 398: emit(NOP, "nop")
 399: 
 400: #  K -- THE SECOND INJECTION: a different PHASE *and* a different WIDTH.
 401: #
 402: #  *** THE WIDTH IS LOAD-BEARING AND WAS NOT, WHICH COST A FLOOR BREACH. ***  Both
 403: #  injections used to be 2-byte stores, so a guard qualified `&& len == 2` refused
 404: #  BOTH and swept all 22 rows clean -- MEASURED escaping, the mirror of the
 405: #  `&& len == 1` mutant the round DID build.  The table had measured the inert
 406: #  member of the family and concluded the family was covered.
 407: #
 408: #  A SINGLE-BYTE store here closes the EQUALITY family with one instruction: `len == 1`
 409: #  now lets the 2-byte DATA-IN injection through (rows G/H/I red), and `len == 2` lets
 410: #  this one through (row L red).
 411: #
 412: #  *** THE SENTENCE THAT ENDED THIS PARAGRAPH WAS A FALSE UNIVERSAL, AND IT SAT TWO
 413: #  LINES BELOW ITS OWN REFUTATION. ***  It read "No single width qualifier can refuse
 414: #  both."  True of EQUALITY qualifiers, FALSE of the inequality: `&& len != 4` refuses
 415: #  a 1-byte store AND a 2-byte store, so it left every row green while re-opening the
 416: #  defect BYTE-FOR-BYTE.  Measured by a seat at 30/30 -- rows G/H/I returned the
 417: #  injected a5/5a/00, which is what the PRE-FIX build returns, against the fix's real
 418: #  disk content c2/c3/c4.
 419: #
 420: #  THE CLOSURE CONDITION, and it needs TWO clauses rather than one -- the first draft
 421: #  of this comment ran them together and a seat took the sentence apart:
 422: #
 423: #    a qualifier `&& P(len)` ESCAPES THE DETECTOR    iff P is TRUE on every width
 424: #                                                        this probe INJECTS;
 425: #    it escapes AND RE-OPENS THE DEFECT              iff ADDITIONALLY P is FALSE
 426: #                                                        on some width that PUSHES.
 427: #
 428: #  The widths that push are exactly 1, 2 and 4.  The 3- and 8-byte cases fall to
 429: #  `default:` and push NOTHING, so a qualifier that stops refusing there changes no
 430: #  observable: it is an EQUIVALENT MUTANT.  Injecting all three pushing widths means
 431: #  no P can be true on every injected width and false on a pushing one, so **the
 432: #  family of HARMFUL escapes is closed** -- {1,2} left `!= 4` open, {2,4} leaves
 433: #  `!= 1`, {1,4} leaves `!= 2`, and only {1,2,4} closes it.
 434: #
 435: #  *** EQUIVALENT MUTANTS SURVIVE AND ALWAYS WILL: `&& len != 8`, `&& len != 3`,
 436: #  `&& len <= 4` all leave every row green. ***  That is not a coverage hole -- none
 437: #  of them lets a byte reach the ring -- and no row can or should kill them.  Two
 438: #  seats disagreed about this and BOTH were partly right: one showed the survivors
 439: #  exist, the other that they are inert.  The sentence, not the substance, was wrong.
 440: #
 441: #  *** AND THE INERTNESS IS MEASURED, NOT READ.  This is the argument's weakest link
 442: #  and a seat named it as such: `case 3` and `case 8` pushing nothing is a claim ABOUT
 443: #  CODE, and the closure rests entirely on it. ***  A measuring seat then built
 444: #  `&& len != 3` as a deliberate NEGATIVE control and scored it **30/30 ESCAPED** --
 445: #  which is the CORRECT result, not a hole.  An equivalent mutant must escape; if it
 446: #  had been killed, some row would be reading a channel it has no business reading.
 447: #
 448: #  So the two halves of the closure are now evidenced differently and deliberately:
 449: #  the HARMFUL family is closed by a measured KILL (E4, 29/30), and the INERT family
 450: #  is confirmed by a measured ESCAPE (`len != 3`, 30/30).  A detector that could not
 451: #  produce the second measurement would be over-fitted rather than complete.
 452: emit(ori(t6, zero, INJECT), "ori t6,zr,0x5aa5")
 453: emit(sb(t6, 0, t0), "sb t6,0(t0)")
 454: 
 455: #  K2 -- THE 4-BYTE INJECTION.  The third width, and the third leg of the proof above.
 456: #
 457: #  One instruction, NO new row and NO re-pinning: on the fixed leg it is refused like
 458: #  its neighbours, so the ring stays empty and row L still reads ST_IDLE; on the base
 459: #  leg it lands like its neighbours, so DRQ is set and row L still reads ST_DATAIN.
 460: #  It kills the `len != 4` escape and it kills M3 and M6 at the same time.
 461: #
 462: #  It is also the ONLY access in this probe that reaches the device's `case 4:` WRITE
 463: #  arm, which no leg of any run had executed before.
 464: #
 465: #  *** SAY `case 4:` WRITE ARM AND NOTHING MORE.  An earlier draft added "and the
 466: #  whole `consumed = ...` accounting" -- FALSE: `consumed` is in the MEM_READ arm and
 467: #  a store cannot reach it.  Closing a WRITE-side gap buys nothing on the READ side,
 468: #  and a claim that reaches across is the CLAIM->ROW check's own quarry. ***
 469: emit(sw(t6, 0, t0), "sw t6,0(t0)")
 470: 
 471: #  L -- the status byte, and here it is a SHARP control rather than a weak one.
 472: #  status_byte() ORs DRQ from three conditions: ring occupancy, write_in_progress,
 473: #  and `atapi_cmd_in_progress && (atapi_phase & WDCS_DRQ)`.  During DATA-IN the third
 474: #  is true, which is why row C pins nothing about the ring.  PHASE_COMPLETED is
 475: #  (WDCI_IN | WDCI_CMD) and carries NO WDCS_DRQ, so here DRQ comes from ring
 476: #  occupancy alone: DRQ set means the injected bytes landed.
 477: emit(lbu(t1, CMD_OFF, t0), "lbu t1,7(t0)")
 478: 
 479: emit(or_(t9, t2, zero), "or t9,t2,zr")
 480: 
 481: #  ---- M: THE ACCEPT ROW.  Added by `wdcatapistswap` after an operand swap escaped
 482: #  ---- all 22 rows of the table above.
 483: #
 484: #  The swap is `d->atapi_cmd_in_progress` -> `d->atapi_st != NULL` in the #495 guard.
 485: #  It is not a contrived edit: dev_wdc.c's own comment records that the flag
 486: #  CONFLATES TWO ROLES and files exactly this refactor, so a future round separating
 487: #  them could write the swap believing it a simplification.
 488: #
 489: #  *** WHY A COMMAND MUST BE ISSUED FIRST, WHICH IS THE WHOLE DESIGN. ***  The obvious
 490: #  form -- push and pop straight after the packet transfer completes -- is VACUOUS, and
 491: #  a panel seat proved it from the source rather than by running it.  atapi_cmd_in_progress
 492: #  has exactly TWO write sites: cleared in wdc_new_command_reset(), set at the packet
 493: #  dispatch.  NO COMPLETION PATH CLEARS IT.  So post-transfer the flag is still 1, the
 494: #  shipped guard refuses too, both legs read ff, and the row pins nothing.
 495: #
 496: #  The states where shipped and swapped DIFFER are exactly `flag == 0 && atapi_st != NULL`,
 497: #  and only a command can produce them: wdc_new_command_reset() is the sole writer of
 498: #  flag = 0, while atapi_st has ONE write site (the alloc) and NO clear site anywhere,
 499: #  so once allocated the disagreement is permanent.  The RECAL is therefore load-bearing,
 500: #  not scene-setting.
 501: #
 502: #  A second seat objected that RECAL leaves phase == 0 whereas "the real hole" would
 503: #  leave PHASE_COMPLETED, so a mutant keying on the phase would tell them apart.  That
 504: #  state does not exist: wdc_new_command_reset() zeroes flag and phase in the same three
 505: #  lines, and every site that sets a nonzero phase lies on a path where the flag is 1.
 506: #  **flag == 0 implies phase == 0**, so RECAL reaches the hole itself, not a stand-in.
 507: #
 508: #  *** POSITION IS LOAD-BEARING: THIS ARM MUST STAY AFTER THE PACKET ARMS. ***  Its
 509: #  E2 kill exists only because a packet command has already allocated atapi_st.  Before
 510: #  that, atapi_st is NULL -- devinit does `memset(d, 0, sizeof(struct wdc_data))` -- so
 511: #  the swapped guard is FALSE, the pushes land, and both rows go green.  A future tidy-up
 512: #  that groups the accept rows with the controls at the top would leave them permanently
 513: #  green under E2 **with no visible change to the file**: same rows, same values, same
 514: #  count, zero kill.  Named by the fable5 seat; the arm stated the disagreement state it
 515: #  needs but never stated the ordering as a constraint.
 516: #
 517: #  REGISTER DISCIPLINE: this arm uses t7 and v0 for its scratch stores as well as for
 518: #  its two readbacks, so it touches no register any earlier arm uses.  An earlier draft
 519: #  used t3; a seat pointed out it could not tell from the packet whether t3 was read
 520: #  back, and the sidestep costs the same eight instructions.
 521: emit(addiu(t7, zero, WDCC_RECAL), "addiu t7,zr,16")
 522: emit(sb(t7, CMD_OFF, t0), "sb t7,7(t0)")
 523: emit(addiu(t7, zero, 0x5a), "addiu t7,zr,90")
 524: emit(sb(t7, 0, t0), "sb t7,0(t0)")
 525: emit(addiu(v0, zero, 0xa5), "addiu v0,zr,165")
 526: emit(sb(v0, 0, t0), "sb v0,0(t0)")
 527: 
 528: #  The two readbacks.  Under the swap both pushes were refused, so these pop an EMPTY
 529: #  ring and wdc_get_inbuf() returns its -1 sentinel: 5a,a5 -> ff,ff.
 530: #
 531: #  CROSS-DEPENDENCY, named here because neither file says it otherwise: the SECOND
 532: #  readback's oracle rests on that `return` sitting OUTSIDE the overread latch.  That
 533: #  is #464's finding and it is pinned by the `overread -1` row in another probe -- move
 534: #  the return inside the latch and this row's second value changes meaning.  A latch
 535: #  already burned by an earlier arm does not weaken either oracle, because the latch
 536: #  gates the MESSAGE and not the return value.
 537: emit(lbu(t7, 0, t0), "lbu t7,0(t0)")
 538: emit(lbu(v0, 0, t0), "lbu v0,0(t0)")
 539: 
 540: #  ---- N: THE SECOND VEHICLE.  A DIFFERENT no-fill opcode, and it closes an axis the
 541: #  ---- M arm holds fixed.
 542: #
 543: #  *** THIS IS THE M5/M6 LESSON ON A NEW AXIS, AND A SEAT FOUND IT BEFORE THE TABLE RAN
 544: #  RATHER THAN AFTER. ***  With only the M arm, the smallest edit that re-opens the hole
 545: #  and still sweeps every row is ONE conjunct naming this arm's own opcode:
 546: #
 547: #      if (d->atapi_st != NULL &&
 548: #          d->atapi_phase != PHASE_CMDOUT &&
 549: #          d->cur_command != WDCC_RECAL) {
 550: #
 551: #  After RECAL `cur_command` is 0x10, so the M pushes land and row M stays GREEN.  During
 552: #  DATA-IN and PHASE_COMPLETED `cur_command` is still ATAPI_PKT_CMD, so G/H/I and L match
 553: #  the fix.  **And after any OTHER no-fill command the ordinary writes are refused again**
 554: #  -- the hole is fully re-opened, and a detector with one vehicle cannot see it.
 555: #
 556: #  A detector built from one scenario is blind along the axis that scenario holds fixed.
 557: #  #495 learned this twice in one round -- M5 on the PHASE axis, M6 on the WIDTH axis --
 558: #  and the axis here is WHICH no-fill opcode cleared the flag.
 559: #
 560: #  ONE CONJUNCT CANNOT EXEMPT TWO OPCODES.  RECAL is 0x10, ATAPI_SOFT_RESET is 0x08, and
 561: #  both reach their case bodies on this CD-backed drive (neither is IDENTIFY, so neither
 562: #  takes wdc_command()'s CDROM early return).  Exempting one leaves the other red.
 563: emit(addiu(v1, zero, ATAPI_SOFT_RESET), "addiu v1,zr,8")
 564: emit(sb(v1, CMD_OFF, t0), "sb v1,7(t0)")
 565: emit(addiu(v1, zero, 0x5a), "addiu v1,zr,90")
 566: emit(sb(v1, 0, t0), "sb v1,0(t0)")
 567: emit(addiu(a0, zero, 0xa5), "addiu a0,zr,165")
 568: emit(sb(a0, 0, t0), "sb a0,0(t0)")
 569: emit(lbu(v1, 0, t0), "lbu v1,0(t0)")
 570: emit(lbu(a0, 0, t0), "lbu a0,0(t0)")
 571: 
 572: HALT = len(prog)
 573: emit(beq(zero, zero, -1), "b 0x")
 574: emit(NOP, "nop")
 575: 
 576: HALT_ADDR = BASE + HALT * 4
 577: REGS = ("t8", "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "t9", "t1",
 578:         "t7", "v0", "v1", "a0")
 579: 
