 589:     out("-" * 94)
 590:     b_got, b_w, b_m, b_hit, b_dg = run_one(BASE_BIN, "base", out)
 591:     out()
 592: 
 593:     out("-" * 94)
 594:     out("LEG 2 -- FIX LEG (the handler decodes relative_addr; 0x3f7 declines the write)")
 595:     out("-" * 94)
 596:     f_got, f_w, f_m, f_hit, f_dg = run_one(FIX_BIN, "fix", out)
 597:     out()
 598: 
 599:     out("-" * 94)
 600:     out("RESULTS -- every value below was produced by a GUEST LOAD through real decode")
 601:     out("-" * 94)
 602:     out("  %-56s %-4s %-14s %-14s" % ("", "reg", "COMMITTED", "FIX LEG"))
 603:     npass = nfail = 0
 604:     fails = []
 605:     changed = []
 606:     for label, rn, wb, wf, kind in ROWS:
 607:         gb, gf = b_got.get(rn), f_got.get(rn)
 608:         okb, okf = (gb == wb), (gf == wf)
 609:         npass += okb + okf
 610:         nfail += (not okb) + (not okf)
 611:         if not (okb and okf):
 612:             fails.append(label)
 613:         if wb != wf:
 614:             changed.append((label, rn, wb, wf, gb, gf))
 615:         out("  %-56s %-4s want %02x got %-5s want %02x got %-5s  %s"
 616:             % (label, rn, wb, ("%02x" % gb) if gb is not None else "??",
 617:                wf, ("%02x" % gf) if gf is not None else "??",
 618:                "ok" if (okb and okf) else "FAIL"))
 619:     out()
 620:     out("  %d of %d predictions correct across both legs" % (npass, npass + nfail))
 621:     for l in fails:
 622:         out("  FAIL  %s" % l)
 623:     out()
 624: 
 625:     out("-" * 94)
 626:     out("THE DIFFERENTIAL -- the rows the defect owns.  Same script, opposite colour.")
 627:     out("-" * 94)
 628:     for label, rn, wb, wf, gb, gf in changed:
 629:         out("  %-56s %-4s  %02x -> %02x   %s"
 630:             % (label, rn, gb if gb is not None else 0, gf if gf is not None else 0,
 631:                "AS PREDICTED" if (gb == wb and gf == wf) else "MISMATCH"))
 632:     out()
 633: 
 634:     def hx(d, k):
 635:         return ("%02x" % d[k]) if d.get(k) is not None else "??"
 636: 
 637:     out("  On the COMMITTED build phase 1 and phase 2 are BYTE-IDENTICAL:")
 638:     out("    0x3f6 -> status %s, data %s   (the Device Control register)"
 639:         % (hx(b_got, "s1"), hx(b_got, "s2")))
 640:     out("    0x3f7 -> status %s, data %s   <-- a register the guest may not write"
 641:         % (hx(b_got, "s4"), hx(b_got, "s5")))
 642:     out("  On the FIX LEG they separate:")
 643:     out("    0x3f6 -> status %s, data %s   (UNCHANGED -- the accept row)"
 644:         % (hx(f_got, "s1"), hx(f_got, "s2")))
 645:     out("    0x3f7 -> status %s, data %s   (the write is declined)"
 646:         % (hx(f_got, "s4"), hx(f_got, "s5")))
 647:     out()
 648: 
 649:     out("-" * 94)
 650:     out("WHY THIS IS THE DEVICE AND NOT RAM  (device-signature controls)")
 651:     out("-" * 94)
 652:     out("  The data port was read TWICE at the SAME address and returned 0x%s then 0x%s."
 653:         % (hx(b_got, "a1"), hx(b_got, "a2")))
 654:     out("  A memory cell returns the last value written (0xa5) both times; only a FIFO")
 655:     out("  returns them in push order.  This is the wdc input ring, not a memory word.")
 656:     out("  The status byte at +7 read 0x%s at power-on and 0x%s armed.  DRDY|DSC = 0x50"
 657:         % (hx(b_got, "a3"), hx(b_got, "s0")))
 658:     out("  is computed by status_byte() out of diskimage_exist(), the ERR bit out of the")
 659:     out("  d->error that dev_wdc_init sets, and DRQ out of d->write_in_progress.  The")
 660:     out("  guest wrote none of those three, and RAM would return what was stored.")
 661:     out("  RAM liveness (0x%s) and register liveness (0x%s%s -- #481's 0x6655 idiom)"
 662:         % (hx(b_got, "v0"), hx(b_got, "a0"), hx(b_got, "v1")))
 663:     out("  prove the sb/lbu shapes and the wdc decode both work, so a device row")
 664:     out("  reading 0x00 could not have been blamed on a bad encoding.")
 665:     out()
 666: 
 667:     out("-" * 94)
 668:     out("EMULATOR DIAGNOSTICS DURING EACH RUN -- INFORMATIONAL, NOT EVIDENCE")
 669:     out("-" * 94)
 670:     out("  debug() RETURNS SILENTLY WHEN FREE-RUNNING at default verbosity (it subtracts")
 671:     out("  1 from verbose while emul_executing and returns on v < 0), and this probe")
 672:     out("  breakpoints and continues rather than stepping.  So every debug()-only line")
 673:     out("  below reads 0 on BOTH legs and a zero here means nothing; only fatal() lines")
 674:     out("  can appear.  The rows above are the measurement.")
 675:     for n in sorted(set(list(b_dg) + list(f_dg))):
 676:         out("  %-28s committed x%d   fix x%d" % (n, b_dg.get(n, 0), f_dg.get(n, 0)))
 677:     out()
 678:     out("  transcripts: %s/transcript_base.log , transcript_fix.log" % OUTDIR)
 679:     out("  raw guest program: %s (%d bytes)" % (RAWBIN, 4 * len(prog)))
 680:     out()
 681: 
 682:     ok = (nfail == 0 and b_hit and f_hit
 683:           and b_w == len(prog) and f_w == len(prog))
 684:     out("VERDICT   %s"
 685:         % ("WITNESS CONFIRMED -- the committed build treats 0x3f7 as 0x3f6 and the fix"
 686:            " leg separates them" if ok else
 687:            "*** SOMETHING DID NOT HOLD -- read the FAIL lines above ***"))
 688:     out("          %d of %d row predictions; encodings %d/%d and %d/%d; both legs"
 689:         " parked: %s" % (npass, npass + nfail, b_w, len(prog), f_w, len(prog),
 690:                          b_hit and f_hit))
 691:     out("ALTOFF_DET_DONE")
 692: 
 693:     with open(os.path.join(OUTDIR, "RESULTS.txt"), "w") as f:
 694:         f.write("\n".join(lines) + "\n")
