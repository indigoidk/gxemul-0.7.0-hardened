 695:     seen = {}
 696:     for line in dis.splitlines():
 697:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
 698:         if m:
 699:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
 700: 
 701:     word_ok = word_bad = mn_ok = mn_bad = 0
