 623: class Emu(object):
 624:     def __init__(self, argv, boot_wait=5.0):
 625:         self.buf = bytearray()
 626:         self.pid, self.fd = pty.fork()
 627:         if self.pid == 0:
 628:             try:
 629:                 os.execvp(argv[0], argv)
 630:             finally:
 631:                 os._exit(127)
 632:         self.drain(boot_wait)
 633: 
 634:     def drain(self, seconds):
 635:         end = time.time() + seconds
 636:         while time.time() < end:
 637:             r, _, _ = select.select([self.fd], [], [], 0.05)
 638:             if self.fd in r:
 639:                 try:
 640:                     d = os.read(self.fd, 65536)
 641:                 except OSError:
 642:                     return
 643:                 if not d:
 644:                     return
 645:                 self.buf.extend(d)
 646: 
 647:     def send(self, cmd, wait=0.4):
 648:         start = len(self.buf)
 649:         data = (cmd + "\n").encode()
 650:         view = memoryview(data)
 651:         while len(view):
 652:             n = os.write(self.fd, view)
 653:             view = view[n:]
 654:             if len(view):
 655:                 self.drain(0.05)
 656:         self.drain(wait)
 657:         return bytes(self.buf[start:]).decode("latin1", "replace")
 658: 
 659:     def close(self, log):
 660:         try:
 661:             os.write(self.fd, b"quit\n")
 662:             self.drain(0.4)
 663:         except OSError:
 664:             pass
 665:         for fn in (lambda: os.close(self.fd),
 666:                    lambda: os.kill(self.pid, 9),
 667:                    lambda: os.waitpid(self.pid, 0)):
 668:             try:
 669:                 fn()
 670:             except OSError:
 671:                 pass
 672:         with open(log, "w") as f:
 673:             f.write(bytes(self.buf).decode("latin1", "replace"))
 674: 
