 407: class Emu(object):
 408:     def __init__(self, argv, boot_wait=5.0):
 409:         self.buf = bytearray()
 410:         self.pid, self.fd = pty.fork()
 411:         if self.pid == 0:
 412:             try:
 413:                 os.execvp(argv[0], argv)
 414:             finally:
 415:                 os._exit(127)
 416:         self.drain(boot_wait)
 417: 
 418:     def drain(self, seconds):
 419:         end = time.time() + seconds
 420:         while time.time() < end:
 421:             r, _, _ = select.select([self.fd], [], [], 0.05)
 422:             if self.fd in r:
 423:                 try:
 424:                     d = os.read(self.fd, 65536)
 425:                 except OSError:
 426:                     return
 427:                 if not d:
 428:                     return
 429:                 self.buf.extend(d)
 430: 
 431:     def send(self, cmd, wait=0.4):
 432:         start = len(self.buf)
 433:         data = (cmd + "\n").encode()
 434:         view = memoryview(data)
 435:         while len(view):
 436:             n = os.write(self.fd, view)
 437:             view = view[n:]
 438:             if len(view):
 439:                 self.drain(0.05)
 440:         self.drain(wait)
 441:         return bytes(self.buf[start:]).decode("latin1", "replace")
 442: 
 443:     def close(self, log):
 444:         try:
 445:             os.write(self.fd, b"quit\n")
 446:             self.drain(0.4)
 447:         except OSError:
 448:             pass
 449:         for fn in (lambda: os.close(self.fd),
 450:                    lambda: os.kill(self.pid, 9),
 451:                    lambda: os.waitpid(self.pid, 0)):
 452:             try:
 453:                 fn()
 454:             except OSError:
 455:                 pass
 456:         with open(log, "w") as f:
 457:             f.write(bytes(self.buf).decode("latin1", "replace"))
 458: 
 459: 
 460: def reg(emu, name):
 461:     for _ in range(5):
 462:         out = emu.send("print %s" % name, wait=0.35)
 463:         m = re.findall(r"0x[0-9a-fA-F]+", out)
 464:         if m:
 465:             return int(m[-1], 16)
 466:         emu.drain(0.25)
 467:     return None
 468: 
 469: 
 470: def run_one(binary, tag, out):
 471:     argv = [binary, "-V", "-E", "evbmips", "-e", "malta",
 472:             "-d", DISK_PREFIX + DISK, "0x%x:%s" % (BASE, RAWBIN)]
 473:     out("  command   " + " ".join(argv))
 474:     emu = Emu(argv)
 475: 
 476:     #  CONTROL 0 -- every hand-encoded word checked against the emulator's own
 477:     #  disassembler.  Addresses are printed WITHOUT an 0x prefix.  The WORD is the
 478:     #  authoritative check; the mnemonic is a rendering and is counted separately so a
 479:     #  spelling this file guessed wrong cannot masquerade as a bad encoding.
 480:     dis = emu.send("unassemble 0x%x 0x%x" % (BASE, BASE + len(prog) * 4), wait=3.0)
 481:     seen = {}
 482:     for line in dis.splitlines():
 483:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
 484:         if m:
 485:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
 486: 
 487:     w_ok = m_ok = 0
 488:     bad = []
 489:     for i, (w, want_mn) in enumerate(prog):
 490:         addr = (BASE + i * 4) & 0xffffffff
 491:         hit = seen.get(addr)
 492:         if hit is None:
 493:             bad.append("  BAD  0x%08x  no disassembly line" % addr)
 494:             continue
 495:         gotw, gotmn = hit
 496:         norm = " ".join(gotmn.replace("\t", " ").split())
 497:         if gotw == "%08x" % w:
 498:             w_ok += 1
 499:         else:
 500:             bad.append("  BAD  0x%08x  word %s vs %08x" % (addr, gotw, w))
 501:         if norm.startswith(" ".join(want_mn.split())):
 502:             m_ok += 1
 503:         else:
 504:             bad.append("  MNEMONIC 0x%08x  got %r want %r" % (addr, norm, want_mn))
 505:     out("  CONTROL 0 encodings: %d of %d WORDS and %d of %d mnemonics agree with the"
 506:         " emulator's own disassembler" % (w_ok, len(prog), m_ok, len(prog)))
 507:     for l in bad:
 508:         out(l)
 509: 
 510:     pc0 = reg(emu, "pc")
 511:     out("  pc at entry = %s (want 0x%016x)"
 512:         % (("0x%016x" % pc0) if pc0 is not None else "UNREADABLE", BASE))
 513: 
 514:     emu.send("breakpoint add 0x%x" % HALT_ADDR, wait=0.5)
 515:     t = time.time()
 516:     emu.send("continue", wait=1.0)
 517:     deadline = time.time() + 120
 518:     hit = False
 519:     while time.time() < deadline:
 520:         emu.drain(0.5)
 521:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
 522:         #  *** MATCH THE HIT LINE, NOT THE BARE WORD. ***  This read
 523:         #  `if "BREAKPOINT" in <tail>.upper():` until 2026-08-30, and the
 524:         #  transcript contains the probe's OWN echoed setup command,
 525:         #  `breakpoint add 0x...`.  The check matched its own input and could
 526:         #  never return False.  It was right by accident in every run where the
 527:         #  guest parked, and silently wrong in the first run where it did not:
 528:         #  a mutant returning 0 from the device handler raises EXCEPTION_DBE, the
 529:         #  guest re-executes the faulting store forever, and the probe still
 530:         #  reported `breakpoint reached: True` with every register reading ??.
 531:         #  That was scored as a KILL -- a failed run counted as a table result.
 532:         #  The emulator prints `BREAKPOINT: pc = 0x...` on a real hit.
 533:         if "BREAKPOINT: PC" in tail.upper():
 534:             hit = True
 535:             break
 536:     elapsed = time.time() - t
 537:     out("  parked at the halt breakpoint: %s   (%.2f s)"
 538:         % ("yes" if hit else
 539:            "*** NO -- the guest never reached 0x%016x ***" % HALT_ADDR, elapsed))
 540: 
 541:     got = {}
 542:     for nm in REGS:
 543:         v = reg(emu, nm)
 544:         got[nm] = None if v is None else (v & 0xff)
 545: 
 546:     whole = bytes(emu.buf).decode("latin1", "replace")
 547:     diags = {n: whole.count(n) for n in
 548:              ("write to DATA, but not", "reading too much", "wdc inbuf overrun",
 549:               "wdc inbuf full", "write to ALT. CTRL", "DRIVE ADDRESS")}
 550:     emu.close(os.path.join(OUTDIR, "transcript_%s.log" % tag))
 551:     return got, w_ok, m_ok, hit, diags
 552: 
