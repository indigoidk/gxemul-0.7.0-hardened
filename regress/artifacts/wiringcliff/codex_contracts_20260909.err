 329: 
 330: emit(lui(t0, DATA_HI), "lui t0,0xb800")
 331: emit(ori(t0, t0, DATA_LO), "ori t0,t0,0x01f0")
 332: emit(lui(t4, RAM_HI), "lui t4,0x8020")
