   1: #!/bin/bash
   2: # Run the regression gates. `./run.sh` runs all of them; `./run.sh 2 4` runs a subset.
   3: #
   4: # Order matters: the build gate produces the binaries the rest test, and the hygiene gate
   5: # reads the logs the MIPS gate produces.
   6: set -u
   7: HERE=$(cd "$(dirname "$0")" && pwd)
   8: . "$HERE/lib.sh"
   9: 
  10: GATES=(gate_build gate_offline selftest_mutation gate_mips gate_crossfamily gate_hygiene gate_ab gate_upstream gate_asan_sweep gate_sh_rounding gate_m88k_rounding gate_mips_rounding gate_ppc gate_arm gate_ppc_halt gate_mips_folds)
  11: 
  12: #  How many gates this battery is supposed to have.  Every round ends with a claim of
  13: #  the form "the battery is green", and until now NOTHING checked how many gates that
  14: #  covered -- so a gate silently dropped from the array above would have looked exactly
  15: #  like a battery that was always this size.  The count was also wrong in three places
  16: #  at once: this README said "all six", the top-level README stopped at 13, and the
  17: #  working notes had said both 15 and 17.  A number nobody checks is not a fact.
  18: #
  19: #  Adding a gate means editing BOTH lines, deliberately.  That is the point.
  20: GATE_MANIFEST=16
  21: if [ "${#GATES[@]}" -ne "$GATE_MANIFEST" ]; then
  22:     echo "GATE MANIFEST MISMATCH: array has ${#GATES[@]}, manifest says $GATE_MANIFEST"
  23:     echo "  a gate was added or removed without updating GATE_MANIFEST -- refusing to run,"
  24:     echo "  because 'the battery is green' means nothing if the battery changed size."
 105:         PASS) printf "  ${C_OK}%-4s${C_OFF} %s. %s\n" PASS "$1" "$2"; pass=$((pass+1)) ;;
 106:         SKIP) printf "  ${C_SKIP}%-4s${C_OFF} %s. %s\n" SKIP "$1" "$2"; skip=$((skip+1)) ;;
 107:         *)    printf "  ${C_BAD}%-4s${C_OFF} %s. %s\n" FAIL "$1" "$2"; fail=$((fail+1)) ;;
 108:     esac
 109: done
 110: echo
 111: echo "  passed $pass   failed $fail   skipped $skip"
 112: #  Say what was actually covered.  A bare "passed N" invites the reader to assume N is
 113: #  the whole battery; when a subset was selected it is not, and that distinction is
 114: #  exactly what an auditor of a green push needs.
 115: if [ ${#want[@]} -eq 0 ]; then
 116:     echo "  GATE_COVERAGE=$((pass+fail+skip))/$GATE_MANIFEST (full battery)"
 117: else
 118:     echo "  GATE_COVERAGE=$((pass+fail+skip))/$GATE_MANIFEST (SUBSET: ${want[*]})"
 119: fi
 120: echo
 121: # A skip is NEVER a pass. It means a gate could not run, which is a gap in coverage, not
 122: # evidence of correctness -- so the overall verdict says so out loud.
 123: if [ $((pass+fail+skip)) -eq 0 ]; then
 124:     echo "${C_BAD}REGRESS_NOTHING_RAN${C_OFF}"; exit 1
 125: elif [ "$fail" -gt 0 ]; then
 126:     echo "${C_BAD}REGRESS_FAIL${C_OFF}"; exit 1
 127: elif [ "$skip" -gt 0 ]; then
 128:     # EXIT 3, NOT 0. Automation reads the exit status, not the colour: exiting 0 here made
 129:     # a run where every gate skipped indistinguishable from a run where every gate passed,
 130:     # which contradicts this harness's own rule that a skip is never a pass.
 131:     echo "${C_SKIP}REGRESS_PASS_WITH_GAPS${C_OFF} ($skip gate(s) could not run; exit 3)"
 132:     exit 3
 133: else
 134:     echo "${C_OK}REGRESS_PASS${C_OFF}"; exit 0
 135: fi

