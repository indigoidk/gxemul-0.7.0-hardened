 164:     (0x18, 0xE5945000, "ldr r5,[r4]",           "C1 liveness: plain RAM, expect 0x11223344"),
 165:     (0x1c, 0xE5906000, "ldr r6,[r0]",           "A1: VENDOR_ID, expect 0x1011 (RAM/absent: 0)"),
 166:     (0x20, 0xE5942004, "ldr r2,[r4,#4]",        "0x12345678 out of RAM"),
 167:     (0x24, 0xE5802300, "str r2,[r0,#768]",      "TIMER_1_LOAD <- 0x12345678"),
 168:     (0x28, 0xE5907300, "ldr r7,[r0,#768]",      "A2: expect 0x00345678 -- the handler's own mask"),
 169:     (0x2c, 0xE3A01080, "mov r1,#0x80",          "TIMER_ENABLE (dc21285reg.h:367)"),
