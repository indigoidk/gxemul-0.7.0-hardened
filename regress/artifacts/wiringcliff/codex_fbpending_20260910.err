 899:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_mutate2_frozen.py":
 900:         (CLASS_RESEARCH, "sgidewidth mutator, frozen so a re-run cannot silently differ"),
 901:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_mr_frozen.py":
 902:         (CLASS_RESEARCH, "sgidewidth mR variant builder -- the goto-to-common-exit shape, 25/25"),
