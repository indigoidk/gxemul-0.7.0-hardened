 404: #  Name the offender rather than only the count -- a bare number tells nobody
 405: #  WHICH file, and the whole point of the denominator is attribution.
 406: _new=$(comm -13 <(printf '%s' "$GRANDFATHERED_PROMPTLESS" | tr ' ' '
 407: ' | grep . | sort)                 <(printf '%s' "$_promptless" | grep . | sort) 2>/dev/null)
 408: if [ -n "$_new" ]; then
 409:         echo "  NEW PROMPTLESS PTY PROBE(S) -- add prompt detection, or grandfather"
 410:         echo "  deliberately by editing GRANDFATHERED_PROMPTLESS above:"
 411:         printf '    %s
 412: ' $_new
 413: fi
