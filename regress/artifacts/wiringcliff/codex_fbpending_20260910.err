 770:     "artifacts/sgirebufuninit/scan_fill.py":
 771:         (CLASS_RESEARCH, "sgirebufuninit: the companion scan -- every memory_rw that WRITES a stack "
 772:                          "byte-buffer into guest-visible memory, with whether the buffer is ever "
 773:                          "initialised wholesale (5 sites). Found dev_scc.c:305, which scan_len.py "
 774:                          "excludes by construction. NOTE its known defect, recorded because it nearly "
 775:                          "produced a wrong conclusion: the declaration map is keyed by NAME file-wide, "
 776:                          "so two functions declaring the same buffer at different sizes collapse to the "
