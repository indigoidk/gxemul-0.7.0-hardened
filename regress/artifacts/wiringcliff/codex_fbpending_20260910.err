 877:     #  sgidewidth, 2026-08-31.  The measuring seat's rung-3 witness, attribution probe and
 878:     #  25-row / nine-build kill table, preserved because the seat reported them VOLATILE.
 879:     #  CLASS_RESEARCH on the #497 precedent: EVIDENCE, not detectors the battery owes a run.
 880:     #
 881:     #  *** EVERY DRIVER HERE IS A `_frozen` COPY, AND THE NAMING IS THE POINT. ***  The
 882:     #  carrier mandates a frozen copy for a comparison run -- editing a script a job is
 883:     #  reading corrupts that run in bash, and re-reads it between runs in python.  These
 884:     #  filenames make the obedience auditable rather than asserted.
 885:     #
 886:     #  `gxdew_mz_frozen.py` and `gxdew_mzp_frozen.py` are kept as a PAIR and must not be
 887:     #  pruned to one: they differ only in the byte `#95` fills (0x00 vs 0xa5), and the pair
 888:     #  is the control that showed a declined read returns a DETERMINISTIC value tracking
 889:     #  that byte.  That is what retracted my claim that the early-return mutant's observable
 890:     #  is nondeterministic -- keeping only one erases the attribution.
 891:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_probe_frozen.py":
 892:         (CLASS_RESEARCH, "sgidewidth rung-3 WITNESS as measured -- 4/4 kills, liveness + device-signature controls"),
 893:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_probe2_frozen.py":
 894:         (CLASS_RESEARCH, "sgidewidth attribution probe -- 24/24, offsets differing ONLY in bit 0x800"),
 895:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_kill_frozen.py":
 896:         (CLASS_RESEARCH, "sgidewidth table-1 driver, frozen for the duration of the run"),
 897:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_kill2_frozen.py":
 898:         (CLASS_RESEARCH, "sgidewidth table-2 driver (25 rows, 9 builds), frozen"),
 899:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_mutate2_frozen.py":
 900:         (CLASS_RESEARCH, "sgidewidth mutator, frozen so a re-run cannot silently differ"),
 901:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_mr_frozen.py":
 902:         (CLASS_RESEARCH, "sgidewidth mR variant builder -- the goto-to-common-exit shape, 25/25"),
 903:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_mz_frozen.py":
 904:         (CLASS_RESEARCH, "sgidewidth #95 attribution builder -- fill 0x00, the control that refuted my retraction"),
 905:     "artifacts/sgidewidth/opus_witness_20260831/gxdew_mzp_frozen.py":
 906:         (CLASS_RESEARCH, "sgidewidth #95 attribution builder -- fill 0xa5, the paired control"),
 907: 
 908:     #  sgireunmapped, 2026-08-31.  The measuring seat's RUNG-3 WITNESS set, preserved
 909:     #  because the seat reported its artifacts were in VOLATILE SCRATCH and would be lost.
 910:     #  CLASS_RESEARCH on the #497 precedent above: EVIDENCE, not detectors the battery owes
 911:     #  a run.
 912:     #
 913:     #  `sgi_re_unmapped_probe.py` is the WITNESS that licensed the fix -- 32/32 on an
 914:     #  unmodified `-E sgi -e ip32`, with liveness, device-signature, neighbour-device and
 915:     #  negative controls.  A witness exists BEFORE the edit and is graded by the witness
 916:     #  clauses; a detector defends the fix afterwards and is graded by the vacuity floor.
 917:     #  Filing this as research keeps that distinction rather than asking a gate to run a
 918:     #  reproduction of a defect the round is about to remove.
 919:     #
 920:     #  `detector.py` is the seat's 14-row instrument AS MEASURED, and it is deliberately
 921:     #  NOT the shipping detector: the round's own copy will live in regress/ and be gated.
 922:     #  It is kept because a 9-variant table is worth nothing if the instrument that
 923:     #  produced it can change underneath the numbers.
 924:     #
 925:     #  *** AND IT IS KEPT FOR A SECOND REASON THAT IS THE ROUND'S MOST TRANSFERABLE
 926:     #  FINDING: this instrument contained a row that COULD NOT FAIL. ***  A latch mutant
 927:     #  swept 14/14 against the row written to catch it, because gxprobe cached `pc` across
 928:     #  `step` and the row's second access executed a nop.  The file as preserved is the
 929:     #  BEFORE state, and `INSTRUMENT_FINDING.md` beside it is the diagnosis.  Deleting it
 930:     #  would erase the only evidence of a vacuous row that eight of nine variants scored
 931:     #  plausibly around.
 932:     "artifacts/sgireunmapped/opus_witness_20260830/sgi_re_unmapped_probe.py":
