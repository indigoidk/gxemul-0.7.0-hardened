 765:     "artifacts/sgirebufuninit/scan_len.py":
 766:         (CLASS_RESEARCH, "sgirebufuninit: scans src/devices for memory_rw calls whose transfer LENGTH "
 767:                          "is not pinned to the stack buffer (6 sites). Blind by construction to a "
