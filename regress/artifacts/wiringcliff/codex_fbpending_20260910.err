import runpy, posixpath, os, pathlib, re
p = pathlib.Path('tools/pipeline/check_probe_wiring.py').resolve()
s = runpy.run_path(str(p), run_name='probe_wiring_readonly')
print('witness manifest:', s['MANIFEST'].get('fbpending_witness.py'))
print('witness exemption:', s['EXEMPT'].get('fbpending_witness.py'))
print('drain exemption:', s['EXEMPT'].get('fbpending_drain_probe.py'))
# Feed proposed shell text to the actual scanner in memory; no files are written.
fn = s['exec_sites']
g = fn.__globals__
orig_read, orig_path = g['read'], g['os'].path
regress = pathlib.Path('regress').resolve().as_posix()
forms = [
    '    python3 \""'$HERE/fbpending_witness.py" "$ROOT/build/gxemul" "$FBPENDING_STUB" > "$FBPENDING_LOG" 2>&1 || FBPENDING_RC=$?'"',
    '# python3 \""'$HERE/fbpending_witness.py"'"',
    'note \"python3 "'$HERE/fbpending_witness.py did not run"'"',
    \"cat <<'USAGE'\\npython3 \\\""'$HERE/fbpending_witness.py'"\\\"\\nUSAGE\",
    'if false; then\\n    python3 \""'$HERE/fbpending_witness.py"'"\\nfi',
]
try:
    # The gates run on POSIX. Use the standard POSIX path semantics for this scan.
    g['os'].path = posixpath
    for form in forms:
        def read_mem(path, form=form):
            return form if path.endswith('/gate_ab.sh') else orig_read(path)
        g['read'] = read_mem
        hits, ignored, missing = fn(regress, ['gate_ab.sh'])
        print('scan:', repr(form), '=>', hits, 'ignored:', ignored, 'missing:', missing)
finally:
    g['read'], g['os'].path = orig_read, orig_path
