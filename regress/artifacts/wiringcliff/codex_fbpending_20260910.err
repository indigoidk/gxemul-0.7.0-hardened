 605:     "artifacts/pcc2widthkills/pass9_seats_20260904/opus/cmp_names.py":
 606:         (CLASS_RESEARCH, "pcc2widthkills: a measuring seat's own script (mutant driver / discriminator / check), preserved as evidence"),
 607:     "artifacts/pcc2widthkills/pass9_seats_20260904/opus/frozen_probe.py":
 608:         (CLASS_RESEARCH, "pcc2widthkills: the frozen instrument a kill table measured, preserved beside its logs"),
 609:     "artifacts/pcc2widthkills/pass9_seats_20260904/opus/mutate.py":
 610:         (CLASS_RESEARCH, "pcc2widthkills: a measuring seat's own script (mutant driver / discriminator / check), preserved as evidence"),
 611: 
 612:     #  wdcaltoffset PASS 1, 2026-08-30.  Four instruments from the measuring seat's
 613:     #  six-binary table.  CLASS_RESEARCH on the precedent two entries down: they are
 614:     #  EVIDENCE preserved so the numbers can be re-run rather than believed.
 615:     #
 616:     #  `table_a.py` is worth a note because it is the reason the table is credible:
 617:     #  it IMPORTS witness_20260829/wdcaltoff_rung3_probe.py rather than
 618:     #  re-implementing the encoder, so it cannot measure a fix of its own invention.
 619:     #  Its fix leg was checked byte-identical to mkfixleg.py's output AND to the
 620:     #  preserved fixleg.diff before any mutant was built.
 621:     #  #494 PASS 2, the opus5 seat.  Instruments preserved so its measured floor
 622:     #  breach can be re-run rather than believed.  `PROPOSED_...` is kept as the
 623:     #  PROVENANCE of what the seat proposed: the shipped detector differs from it
 624:     #  only by an added clause-(e) contract, and keeping both makes that checkable.
 625:     #  wdcaddtoinbufbound RUNG-3 WITNESS, 2026-08-30.  The probe is the INSTRUMENT of
 626:     #  a 20/20 two-leg measurement and is preserved so the numbers can be re-run
 627:     #  rather than believed.  `frozen_wave_*` is the FROZEN COPY the run actually
 628:     #  executed -- kept beside the live probe on purpose, because a comparison run
 629:     #  owes ONE instrument and the frozen copy is the proof of which one it was.
 630:     #  #497 widthkillclass, 2026-08-30.  The measuring seat's TWO-TABLE instrument set,
 631:     #  preserved so a 22-mutant result can be RE-RUN rather than believed.  CLASS_RESEARCH
 632:     #  on the precedent immediately below: these are EVIDENCE, not detectors the battery
 633:     #  owes a run.
 634:     #
 635:     #  `sgi_re_width_probe.py` is the 35-row detector ITSELF, and it is filed here as
 636:     #  research on purpose: the round's shipping copy will live in regress/ and be gated or
 637:     #  dated-exempt.  Two copies with two classes is correct rather than untidy -- the
 638:     #  artifacts one is the instrument that produced THESE numbers and must never change,
 639:     #  while the regress/ one is live and will.
 640:     #
 641:     #  `mutate497.py` and `mutate497_v2.py` are BOTH kept, and the pair is the point: v1
 642:     #  was re-read from the live scratchpad per mutant, which is the frozen-copy hole the
 643:     #  seat caught before it bit.  v2 freezes the mutator and hard-exits if it is missing.
 644:     #  Keeping only v2 would erase the evidence that table 1 and table 2 ran different
 645:     #  drivers -- which is exactly what a reader comparing the two tables needs to know.
 646:     "artifacts/widthkillclass/opus_impl_20260830/apply_fix497.py":
 647:         (CLASS_RESEARCH, "#497 applies the six-site fix to a clone, preserved as evidence"),
 648:     "artifacts/widthkillclass/opus_impl_20260830/move_warned.py":
 649:         (CLASS_RESEARCH, "#497 moves the latch field last -- the edit that stopped the over-run aliasing the latch"),
 650:     "artifacts/widthkillclass/opus_impl_20260830/mutate497.py":
 651:         (CLASS_RESEARCH, "#497 table-1 mutator, kept to show v1 re-read itself per mutant"),
 652:     "artifacts/widthkillclass/opus_impl_20260830/mutate497_v2.py":
 653:         (CLASS_RESEARCH, "#497 table-2 mutator, frozen and hard-exiting if absent"),
 654:     "artifacts/widthkillclass/opus_impl_20260830/sgi_re_width_probe.py":
 655:         (CLASS_RESEARCH, "#497 the 35-row detector AS MEASURED -- the shipping copy is separate and gated"),
 656:     #  #500 pass 6: the NEGATIVE CONTROL's mutated probe, frozen as evidence.  It is
 657:     #  a MUTANT of the shipping detector, deliberately run by no gate -- its whole
 658:     #  purpose is to reproduce a RED.  A seat built the mutant it carries; the
 659:     #  control proved both that the hole existed and that the repair closes it.
 660:     "artifacts/sgideprimop/killtable_20260902_table4/negctl_n25_rectset_probe.py":
 661:         (CLASS_RESEARCH, "#500 the negative control AS RUN -- drawmode store neutered; reds n25 rectset alone, 38/39"),
 662:     #  #500 pass 12: the FROZEN INSTRUMENT of the class-closure table.  A comparison
 663:     #  run owes ONE instrument, so the driver copies the probe once and every cell
 664:     #  scores against that copy -- a driver that re-reads the live probe between
 665:     #  cells gives run 1 and run 2 different tools, which this project has measured
 666:     #  (a 39/40 against a table of /39).  It is EVIDENCE, deliberately run by no gate;
 667:     #  the shipping copy is regress/sgi_de_primop_probe.py and gate_arm.sh runs that.
