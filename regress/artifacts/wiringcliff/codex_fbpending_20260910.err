1426: DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
1427: 
1428: 
1429: #  *** A PYTHON DICT LITERAL ACCEPTS A DUPLICATE KEY IN SILENCE, AND THE LAST ONE WINS.
1430: #  MEASURED ON THIS FILE, HOURS AFTER IT WAS WRITTEN. ***
1431: #
1432: #  Two rounds added `sgi_eaddr_probe.py` to MANIFEST independently -- the author of this
1433: #  checker, and the #446 round whose probe it was.  Both landed, four lines apart, and
1434: #  `len(MANIFEST)` reported ONE entry.  Nothing complained, because nothing can: by the
1435: #  time the module object exists the earlier entry is already gone.  Here the two agreed
1436: #  on CLASS, so the behaviour was identical and the only damage was a stale line.  Had
1437: #  they disagreed -- one DETECTOR, one TOOL -- the file would have carried a visible,
1438: #  reviewed, *tracked* classification that the checker silently did not use, and the
1439: #  filename tooth that refuses `*_probe.py` in class `tool` would have been reading the
1440: #  wrong entry while looking correct in the diff.
1441: #
1442: #  It has to be caught by re-reading THIS FILE'S SOURCE TEXT, because the data structure
1443: #  cannot represent the fault it suffers from.  A duplicate is a SETUP FAULT, not a
1444: #  finding: it exits before any wiring is derived, so it can never be confused with a
1445: #  probe that is genuinely unwired.
1446: #  The open() is INLINE rather than a call to read() below: this guard runs at import time,
1447: #  fifty lines before read() is defined, and the first draft died with a NameError proving it.
1448: #  It failed loudly, which is luck -- a guard placed in a branch would have failed silently.
1449: def _refuse_duplicate_keys():
1450:     with open(os.path.abspath(__file__), "r", encoding="utf-8", errors="replace") as fh:
1451:         src = fh.read()
1452:     #  *** AN ANCHOR THAT NO LONGER MATCHES IS ITSELF A SETUP FAULT, NOT A REASON TO SKIP,
1453:     #  AND THE FIRST VERSION OF THIS GUARD DID `continue`. ***  A flagship review MEASURED
1454:     #  the consequence: `MANIFEST =  {` -- one extra space, valid Python, invisible to a
1455:     #  reader -- makes a literal find() miss, the guard skips, and a planted duplicate key
1456:     #  runs GREEN.  That is this file's own thesis turned on itself: a fault in a guard does
1457:     #  not fail loudly, it stops guarding.  The regex tolerates whitespace, and a miss is
1458:     #  now reported rather than shrugged at.
1459:     for name in ("MANIFEST", "EXEMPT"):
1460:         m = re.search(r"^%s\s*=\s*\{" % re.escape(name), src, re.M)
1461:         if m is None:
1462:             print("PROBEWIRING_SETUP_FAULT  the %s literal could not be located in this"
1463:                   " file's own source." % name)
1464:             print("  The duplicate-key guard cannot run, and a duplicate would pass"
1465:                   " UNSEEN.  Fix the anchor, do not delete the check.")
1466:             sys.exit(2)
1467:         i = m.start()
1468:         j = src.find("\n}", i)
1469:         seen, dupes = set(), []
1470:         for k in re.findall(r'^\s*"([^"]+)"\s*:', src[i:j], re.M):
1471:             (dupes.append(k) if k in seen else None)
1472:             seen.add(k)
1473:         if dupes:
1474:             print("PROBEWIRING_SETUP_FAULT  %s names the same key twice; a dict literal" % name)
1475:             print("  keeps only the LAST and says nothing.  Delete the stale line(s):")
1476:             for k in sorted(set(dupes)):
1477:                 print("    %s" % k)
1478:             sys.exit(2)
1479: 
1480: 
1481: _refuse_duplicate_keys()
1482: 
1483: #  A python interpreter token.  Bare python/python3, or the $PY-style indirections other
1484: #  harnesses in this tree use.  Anchored so python3.12 and mypython do not match.
1485: #  *** THE TRAILING BOUNDARY IS LOAD-BEARING AND THE FIRST VERSION LACKED IT. ***  A
1486: #  flagship review MEASURED that `"$PYLINT" probe.py` scored as WIRING: the alternation
1487: #  had no boundary after the group, so ANY $PY-prefixed variable read as an interpreter
1488: #  and a linter invocation would have marked a probe wired.  That is the FALSE ACCEPT
1489: #  direction -- the one that silently stops demanding a gate.  Latent rather than live:
1490: #  no such variable exists in the battery today.  `$PYTHON` and `$PY` still match;
1491: #  `$PYLINT` and `$PYTEST` no longer do.
1492: INTERP_RE = re.compile(
1493:     r'"?\$\{?(?:PY|PY3|PYTHON|PYTHON3)\}?"?(?![A-Za-z0-9_])'
1494:     r'|(?<![\w./-])python3?(?![\w.-])'
1495: )
1496: 
1497: #  COMMAND POSITION -- the whole defence against "a mention counts as wiring".  Everything
1498: #  before the interpreter must be shell scaffolding: leading space, an assignment opening a
1499: #  command substitution (out=$( ), control keywords, and environment-variable prefixes.
1500: #
1501: #  THE LINE THIS WAS BUILT AGAINST IS REAL AND LIVE, not invented:
1502: #      gate_hygiene.sh:331   note "diag_div_sweep.py or python3 missing -- class ratchet NOT run"
1503: #  It carries a probe basename AND the token python3 on one non-comment line, and it is a
1504: #  message saying the probe DID NOT RUN.  A two-sided "name near python" regex scores it as
1505: #  execution.  Here the interpreter's prefix is `note "diag_div_sweep.py or `, which is not
1506: #  scaffolding, so the line is rejected.
1507: CMDPOS_RE = re.compile(
1508:     r"""^\s*
1509:         (?: [A-Za-z_]\w* = (?:\$\()? \s* )?
1510:         (?: (?: if | then | else | elif | while | until | do | ! | \$\( | \( ) \s* )*
1511:         (?: [A-Za-z_]\w* = (?: "[^"]*" | '[^']*' | \S* ) \s+ )*
1512:         $""",
1513:     re.X,
1514: )
1515: 
1516: VAR_RE = re.compile(r"^\$\{?([A-Za-z_]\w*)\}?$")
1517: ASSIGN_RE = re.compile(r"^\s*([A-Za-z_]\w*)=(\S+)")
1518: 
1519: 
1520: def read(path):
1521:     with open(path, "r", encoding="utf-8", errors="replace") as fh:
1522:         return fh.read()
1523: 
1524: 
1525: def unquote(tok):
1526:     tok = tok.strip().rstrip(");,")
1527:     if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in "\"'":
1528:         tok = tok[1:-1]
1529:     return tok.strip("\"'")
1530: 
1531: 
1532: def gate_list(regress):
1533:     """The battery's OWN array is the authority on which scripts run.
1534: 
1535:     Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
1536:     second-order property worth having: a gate script that exists but was dropped out of
1537:     GATES does not run, so every probe it owned becomes unwired here and this goes RED.
1538:     A glob would have called those probes gated forever.
1539:     """
1540:     run = os.path.join(regress, "run.sh")
1541:     if not os.path.isfile(run):
1542:         return None, "regress/run.sh is missing -- cannot tell which gates run"
1543:     m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
1544:     if not m:
1545:         return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
1546:     return [n + ".sh" for n in m.group(1).split()], None
1547: 
1548: 
1549: def exec_sites(regress, scripts):
1550:     """Return (hits, ignored, missing).
1551: 
1552:     hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
1553:     ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
1554:     """
1555:     hits, ignored, missing = {}, [], []
1556:     for script in scripts:
1557:         path = os.path.join(regress, script)
1558:         if not os.path.isfile(path):
1559:             missing.append(script)
1560:             continue
1561:         lines = read(path).splitlines()
1562:         #  One-level variable map, from this file only.  gate_hygiene really does write
1563:         #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
1564:         #  one level would report a genuinely gated probe as unwired -- and a false red is
1565:         #  how a rule gets switched off.
1566:         varmap = {}
1567:         for ln in lines:
1568:             if ln.lstrip().startswith("#"):
1569:                 continue
1570:             a = ASSIGN_RE.match(ln)
1571:             if a and ".py" in a.group(2):
1572:                 varmap[a.group(1)] = unquote(a.group(2))
1573:         #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
1574:         #  flagship review MEASURED it: an invocation-shaped line inside a
1575:         #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
1576:         #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
1577:         #  its own invocation is an entirely natural shape.  Latent rather than live -- every
1578:         #  `<<` site in the battery today is a data table or a python program body, none
1579:         #  carrying an interpreter plus a probe in body position -- but this is the
1580:         #  dangerous direction: it does not fail loudly, it stops demanding a gate.
1581:         #
1582:         #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
1583:         #  that GENERATES a script the gate then runs is genuine wiring one level away, and
1584:         #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
1585:         #  That is the right error to make.
1586:         body = set()
1587:         pend = None
1588:         for no, ln in enumerate(lines, 1):
1589:             if pend is not None:
1590:                 body.add(no)
1591:                 if ln.strip() == pend:
1592:                     pend = None
1593:                 continue
1594:             h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
1595:             if h and not ln.lstrip().startswith("#"):
1596:                 pend = h.group(1)
1597: 
1598:         for no, ln in enumerate(lines, 1):
1599:             if ln.lstrip().startswith("#") or no in body:
1600:                 continue
1601:             for m in INTERP_RE.finditer(ln):
1602:                 if not CMDPOS_RE.match(ln[: m.start()]):
1603:                     continue
1604:                 toks = ln[m.end():].split()
1605:                 if toks and toks[0].startswith("-c"):
1606:                     continue          # an inline program, not a script invocation
1607:                 for tok in toks:
1608:                     t = unquote(tok)
1609:                     v = VAR_RE.match(t)
1610:                     if v:
1611:                         t = varmap.get(v.group(1), "")
1612:                     if not t.endswith(".py"):
1613:                         continue
1614:                     d, b = os.path.split(t)
1615:                     if d in HERE_DIRS:
1616:                         hits.setdefault(b, []).append("%s:%d" % (script, no))
1617:                     else:
1618:                         #  #471: a NESTED invocation is keyed by its RELATIVE PATH, not
1619:                         #  its basename.  Before this, a gate invoking
1620:                         #  `artifacts/.../gdrom_pio_null_probe.py` was filed as an
1621:                         #  EXTERNAL reference and IGNORED -- so the detector #465 wired
1622:                         #  by hand still reported UNWIRED once the scan could see it.
1623:                         #
1624:                         #  Path keys are also what makes the re-key SAFE: two detectors
1625:                         #  sharing a basename in different directories stay distinct,
1626:                         #  where basename keys would mark BOTH gated when only one is.
1627:                         rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
1628:                         if os.path.isfile(os.path.join(regress, rel)):
1629:                             hits.setdefault(rel, []).append("%s:%d" % (script, no))
1630:                         else:
1631:                             ignored.append("%s:%d  %s" % (script, no, t))
1632:                     break             # the first .py argument is the script
1633:     return hits, ignored, missing
1634: 
1635: 
1636: #  STANDALONE WORDS ONLY.  The first draft used a plain substring and reported
1637: #  mips_fold_probe.py as self-labelled "witness" -- its summary line reads "the MIPS
1638: #  fold-witness COUNTERS", where the word names a counter, not the artefact.  That is the
1639: #  substring trap in the one place in this file that was allowed to be a heuristic, and an
1640: #  advisory that cries wolf is an advisory nobody reads.  MEASURED: with the hyphen guard
1641: #  the noise line disappears and pit8253's real disagreement still fires.
1642: _LBL_W = re.compile(r"(?<![\w-])witness(?![\w-])", re.I)
1643: _LBL_D = re.compile(r"(?<![\w-])detector(?![\w-])", re.I)
1644: 
1645: 
1646: def domain(regress):
1647:     """The .py artefacts this check governs, and (mode, why) describing how it decided.
1648: 
1649:     *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
1650:     first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
1651:     round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
1652:     check went red -- correctly identifying a real unwired detector, but firing at a
1653:     file its author had not yet offered for commit, in someone else's working tree.
1654: 
1655:     `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
1656:     add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
1657:     precisely when the author is present to classify it.  A scratch probe that is never
1658:     staged defends nothing in a fresh clone either, so it is honestly out of scope.
1659: 
1660:     FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
1661:     git cannot answer, and a fallback that quietly changes what a check governs is the
1662:     kind of silent scope change this harness keeps being bitten by.  So the mode is
1663:     printed on the summary line.
1664:     """
1665:     try:
1666:         p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
1667:                            capture_output=True, text=True)
1668:         if p.returncode == 0:
1669:             #  #471: NO `"/" not in f` FILTER.  Its docstring always claimed "every
1670:             #  committed DETECTOR under regress/", and the filter made that false --
1671:             #  the checker could not see below top level, which is exactly where
1672:             #  #465 shipped a detector that no gate ran.
1673:             #
1674:             #  `git ls-files` yields paths RELATIVE to regress/, so a top-level file
1675:             #  still arrives as a bare basename and every existing MANIFEST key keeps
1676:             #  matching unchanged.  Only nested files gain a path key.
1677:             files = sorted(f for f in p.stdout.split()
1678:                            if f.endswith(".py")
1679:                            and os.path.isfile(os.path.join(regress, f)))
1680:             if files:
1681:                 return files, "tracked-or-staged"
1682:     except OSError:
1683:         pass
1684:     #  #471: the FALLBACK must descend too.  Leaving it flat would re-create the blind
1685:     #  spot on any machine where git cannot answer -- a check whose coverage depends
1686:     #  on which branch it took is the shape this file exists to refuse.
1687:     found = []
1688:     for dirpath, dirnames, filenames in os.walk(regress):
1689:         dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
1690:         for f in filenames:
1691:             if f.endswith(".py"):
1692:                 rel = os.path.relpath(os.path.join(dirpath, f), regress)
1693:                 found.append(rel.replace(os.sep, "/"))
1694:     return sorted(found), "on-disk (git could not answer)"
1695: 
1696: 
1697: def self_label(path):
1698:     """The file's OWN summary line, for the SELFLABEL advisory only.  Never a verdict."""
1699:     try:
1700:         head = read(path).splitlines()[:6]
1701:     except OSError:
1702:         return None
1703:     for ln in head:
1704:         has_w, has_d = bool(_LBL_W.search(ln)), bool(_LBL_D.search(ln))
1705:         if has_w and not has_d:
1706:             return CLASS_WITNESS
1707:         if has_d and not has_w:
1708:             return CLASS_DETECTOR
1709:         if has_w and has_d:
1710:             return None
1711:     return None
1712: 
1713: 
1714: #  =======================================================================================
1715: #  SELFTEST.  Mutants are applied to COPIES in a temp dir; nothing in the repository is
1716: #  touched, so no .MUTANT sentinel is needed.  EXIT STATUS IS TAKEN FROM THE PROCESS: this
1717: #  project lost a whole battery result to `cmd | tail`, which reports tail's status, so a
1718: #  KILLED run read as exit 0.  subprocess.run(...).returncode cannot make that mistake.
1719: #
1720: #  A CHECKER-SOURCE MUTANT THAT DOES NOT APPLY EXACTLY ONCE IS A FAULT, NEVER A PASS --
1721: #  absorb_census.py's rule, and it is what keeps this selftest from silently going vacuous
1722: #  after someone reformats the manifest below.
1723: #
1724: #  *** AND IT FIRED ON ITS OWN AUTHOR, FIRST RUN. ***  The mutants below started life as
1725: #  plain string literals, which meant the text they searched for existed TWICE in this file:
1726: #  once in the manifest and once in the selftest.  _st_apply refused ("x2 ... want 1") rather
1727: #  than mutating both, which would have silently mutated the selftest instead of the subject.
1728: #  So every mutant target is BUILT from its parts and never written out whole.
1729: def _lit(*parts):
1730:     """Join fragments, so the assembled search string appears nowhere in this source."""
1731:     return "".join(parts)
1732: 
1733: 
1734: def _exline(key):
1735:     """The EXEMPT entry for `key` AS IT APPEARS IN THE SOURCE, whole, however many lines.
1736: 
1737:     *** THIS USED TO REBUILD A ONE-LINE ENTRY FROM THE TABLE, AND THAT WAS WRONG FOR EVERY
1738:     ENTRY THAT WRAPS. ***  Measured 2026-08-30, the day the second exemption was discharged:
1739:     of the six then remaining, the reconstruction matched **zero** -- all six are written
1740:     across two or more lines.  So the selftest's four exemption mutants had nothing to bite
1741:     on and its SKIP arm fired, dropping 4 of 21 mutants.
1742: 
1743:     **That is the worse failure of the two, because the SKIP arm reads as "the EXEMPT table
1744:     is empty, nothing to test" when the truth was "the reconstruction is too narrow".**  A
1745:     check quietly getting weaker while reporting PASS is the shape this project names first,
1746:     and here it would have arrived wearing the clothes of progress.
1747: 
1748:     Extracting the REAL text instead of rebuilding an idealised one removes the whole class:
1749:     it cannot disagree with the source, because it IS the source.  Scans from the key to the
1750:     line that closes the tuple, so single-line and wrapped entries are handled identically.
1751:     *** AND THE SEARCH IS ANCHORED INSIDE THE EXEMPT BLOCK, WHICH IS NOT A DETAIL. ***
1752:     `    "<name>":` appears in BOTH tables -- MANIFEST first, EXEMPT second -- so a bare
1753:     `find()` returns the MANIFEST entry and the mutant deletes the wrong one.  Measured: M1
1754:     and M2 then reported `UNCLASSIFIED ... is not in the MANIFEST` and `ORPHAN EXEMPTION`
1755:     instead of the `UNWIRED DETECTOR` they exist to prove, i.e. the mutant reddened for a
1756:     reason unrelated to the rule under test -- which would have looked like a working check.
1757: 
1758:     This is the wrong-section trap this project already records for gate row lists: anchor on
1759:     something that identifies the SECTION, never on a pattern several sections share.
1760:     """
1761:     src = src_of_self()
1762:     block = src.find("EXEMPT = {")
1763:     if block < 0:
1764:         raise RuntimeError("_exline: no EXEMPT block")
1765:     start = src.find('    "%s":' % key, block)
1766:     if start < 0:
1767:         raise RuntimeError("_exline: %r not in EXEMPT" % key)
1768:     i = start
1769:     while i < len(src):
1770:         nl = src.find("\n", i)
1771:         if nl < 0:
1772:             return ""
1773:         line = src[i:nl + 1]
1774:         if line.rstrip().endswith("),"):
1775:             return src[start:nl + 1]
1776:         i = nl + 1
1777:     raise RuntimeError("_exline: unterminated entry for %r" % key)
1778: 
1779: 
1780: def src_of_self():
1781:     with open(__file__, encoding="utf-8", newline="") as _f:
1782:         return _f.read()
1783: 
1784: 
1785: def _pick_exempt_detector():
1786:     """The selftest's exemplar is DERIVED, never hardcoded.
1787: 
1788:     *** THIS FUNCTION EXISTS BECAUSE THE SELFTEST BROKE THE DAY AN EXEMPTION WAS
1789:     DISCHARGED, WHICH IS THE ONE EVENT IT SHOULD HAVE BEEN CELEBRATING. ***  Four of its
1790:     mutants named `pit8253_latch_probe.py` literally.  When that probe was wired into
1791:     gate_arm.sh and its exemption deleted -- exactly the outcome the EXEMPT table exists
1792:     to drive toward -- three mutants raised KeyError on the missing entry and the fourth
1793:     had its premise inverted.  `precommit_check.sh` reported THE PROBE-WIRING CHECKER CAN
1794:     NO LONGER BE SHOWN TO FAIL, correctly.
1795: 
1796:     So the harness punished progress: doing the right thing to the tree broke the tool
1797:     that asks for it.  A hardcoded exemplar is a frozen claim about a table designed to
1798:     empty, and swapping in another name would only move the tripwire to the next
1799:     discharge.
1800: 
1801:     Any exempt DETECTOR serves: exempt means unwired, which is the precondition all four
1802:     mutants need.  Sorted for determinism, so a failure names the same probe twice.
1803: 
1804:     *** AND THE PICK IS VERIFIED, NOT MERELY CHOSEN -- BUT NOT FOR THE REASON THIS
1805:     PARAGRAPH GAVE UNTIL 2026-08-30. ***  It said `_exline()` "reconstructs a ONE-LINE
1806:     entry from the table", so entries wrapped across two source lines matched nothing.
1807:     `_exline()` EXTRACTS the real source text now, however many lines it spans, and its
1808:     own docstring says so -- so the two halves of one file contradicted each other, the
1809:     stale half sitting in the function that consumes the fresh one.  Found by the pass-2
1810:     seat reviewing the commit that made the change.
1811: 
1812:     **The `count == 1` guard is still load-bearing and its warrant has MOVED.**  It no
1813:     longer defends against a formatting mismatch -- extraction cannot have one.  It
1814:     defends the SELF-MATCH case: a doc comment in this file quoting an EXEMPT line makes
1815:     the extracted text appear twice.  **The MECHANISM stated here was wrong until the
1816:     adjudicating seat built the case: `_st_apply` does NOT silently edit the comment
1817:     instead of the table -- it COUNTS and RAISES**, `MUTANT DID NOT APPLY: '...' x2
1818:     (want 1)`.  So the guard prevents a selftest CRASH, not a silent wrong-edit, and
1819:     `_st_apply`'s own raise is a second line of defence behind it.
1820: 
1821:     Two facts the seat measured that belong here: injecting a verbatim copy of one
1822:     EXEMPT entry makes `src.count()` return 2, the guard skips that name and returns
1823:     the next candidate -- so it is genuinely load-bearing.  And **it never fires
1824:     today**: all six counts are 1.  It is a LATENT defence, which is worth saying
1825:     plainly, because a guard that has never fired is the one most likely to be
1826:     deleted as dead by someone who does not know what it is for.
1827: 
1828:     *A guard whose stated reason expires but whose behaviour is still needed is the
1829:     hardest kind to audit: deleting it looks safe, because the case it cites is gone.*
1830:     """
1831:     src = src_of_self()
1832:     for name in sorted(EXEMPT):
1833:         cls = MANIFEST.get(name, (None,))[0]
1834:         if cls != CLASS_DETECTOR:
1835:             continue
1836:         if src.count(_exline(name)) == 1:
1837:             return name
1838:     return None
1839: 
1840: 
1841: PIT_RUN = '\npython3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PLOG" 2>&1 || true\n'
1842: #  Four shapes of MENTION, none of which is an invocation.  The third is the live
1843: #  gate_hygiene.sh:331 shape: one non-comment line carrying the basename AND `python3`,
1844: #  whose message is that the probe did NOT run.
1845: PIT_MENTIONS = (
1846:     '\n#python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PLOG" 2>&1 || true\n'
1847:     '#  TODO: wire pit8253_latch_probe.py in\n'
1848:     'note "pit8253_latch_probe.py or python3 missing -- PIT rows NOT run"\n'
1849:     'echo "see pit8253_latch_probe.py"\n'
1850: )
1851: 
1852: 
1853: def _st_apply(path, old, new, want=1):
1854:     src = read(path)
1855:     n = src.count(old)
1856:     if n != want:
1857:         raise RuntimeError("MUTANT DID NOT APPLY: %r x%d in %s (want %d)"
1858:                            % (old[:56], n, os.path.basename(path), want))
1859:     with open(path, "w", encoding="utf-8", newline="\n") as fh:
1860:         fh.write(src.replace(old, new))
1861: 
1862: 
1863: def _st_append(path, text):
1864:     with open(path, "a", encoding="utf-8", newline="\n") as fh:
1865:         fh.write(text)
1866: 
1867: 
1868: def selftest(verbose=False):
1869:     import shutil
1870:     import subprocess
1871:     import tempfile
1872: 
1873:     src_regress = DEFAULT_REGRESS
1874:     me = os.path.abspath(__file__)
1875:     root = tempfile.mkdtemp(prefix="probewiring_selftest_")
1876:     results = []
1877: 
1878:     #  *** THE BASELINE MUST BE GREEN BY CONSTRUCTION, AND THE FIRST VERSION WAS NOT. ***
1879:     #  fresh() copied EVERY .py from the live tree, so when a concurrent round dropped an
1880:     #  unclassified probe into regress/, M0/M2b/M5a all went red and the selftest announced
1881:     #  "THE CHECKER CAN NO LONGER BE SHOWN TO FAIL".  Right colour, WRONG DIAGNOSIS: it
1882:     #  blamed the checker for an APPARATUS state -- gate_offline's F5 shape, and the
1883:     #  dangerous one, because it points the reader at the wrong file.
1884:     #
1885:     #  So the baseline copies exactly the MANIFEST set.  Live-tree content can no longer
1886:     #  perturb a mutant, and M6 still tests the unclassified-arrival path by ADDING one.
1887:     #  A MANIFEST entry with no source file is a SETUP FAULT here, never a mutant result --
1888:     #  absorb_census.py's rule that a crash is a fault and never a detection.
1889:     def fresh():
1890:         work = tempfile.mkdtemp(dir=root)
1891:         rg = os.path.join(work, "regress")
1892:         os.makedirs(rg)
1893:         #  #471: THE COPY MUST MIRROR THE TREE, NOT FLATTEN IT.  This loop was
1894:         #  `os.listdir`, so once the checker could see nested detectors the selftest
1895:         #  copy still could not -- and every nested MANIFEST entry became a GHOST in
1896:         #  the copy, reddening the unmutated M0 control.
1897:         #
1898:         #  That is the SAME blind spot one level up, inside the harness that tests
1899:         #  for it: a flat copy cannot exercise a recursive scan.
1900:         for f in os.listdir(src_regress):
1901:             if f.endswith(".sh"):
1902:                 shutil.copyfile(os.path.join(src_regress, f), os.path.join(rg, f))
1903:         for rel in MANIFEST:
1904:             if not rel.endswith(".py"):
1905:                 continue
1906:             src = os.path.join(src_regress, rel.replace("/", os.sep))
1907:             if not os.path.isfile(src):
1908:                 continue
1909:             dst = os.path.join(rg, rel.replace("/", os.sep))
1910:             os.makedirs(os.path.dirname(dst), exist_ok=True)
1911:             shutil.copyfile(src, dst)
1912:         chk = os.path.join(work, "check_probe_wiring.py")
1913:         shutil.copyfile(me, chk)
1914:         return rg, chk
1915: 
1916:     absent = [f for f in sorted(MANIFEST) if not os.path.isfile(os.path.join(src_regress, f))]
1917:     if absent:
1918:         print("PROBEWIRING_SELFTEST_SETUP  the MANIFEST names files regress/ does not have:")
1919:         for f in absent:
1920:             print("    %s" % f)
1921:         print("  fix the manifest first; a selftest on a broken baseline proves nothing.")
1922:         return 2
1923: 
1924:     def case(name, want_rc, want_text, chk, rg, extra=(), forbid=None):
1925:         p = subprocess.run([sys.executable, chk, "--regress", rg] + list(extra),
1926:                            capture_output=True, text=True)
1927:         out = p.stdout + p.stderr
1928:         ok = (p.returncode == want_rc) and (want_text in out)
1929:         if forbid is not None and forbid in out:
1930:             ok = False
1931:         results.append(ok)
1932:         print("  %s  %-48s rc=%d want=%d" % ("ok  " if ok else "FAIL", name,
1933:                                              p.returncode, want_rc))
1934:         if verbose or not ok:
1935:             for l in out.splitlines():
1936:                 if want_text in l or l.startswith("PROBEWIRING"):
1937:                     print("          %s" % l.strip()[:160])
1938:         if not ok:
1939:             print("      --- full output ---\n%s" % out)
1940: 
1941:     print("=" * 96)
1942:     print("  check_probe_wiring --selftest   (mutants on copies; the repo is not touched)")
1943:     print("=" * 96)
1944: 
1945:     rg, chk = fresh()
1946:     case("M0  unmutated copy is GREEN", 0, "PROBEWIRING_PASS", chk, rg)
1947: 
1948:     #  THE EXEMPLAR IS DERIVED.  See _pick_exempt_detector(): naming one literally is what
1949:     #  broke this selftest the day an exemption was discharged.
1950:     EX = _pick_exempt_detector()
1951:     if EX is None:
1952:         #  *** A SKIPPED MUTATION IS A FAILURE.  The first version of this arm PRINTED
1953:         #  A SKIP AND LET THE SELFTEST PASS, and a seat refuted it with a
1954:         #  one-character proof: change the `== 1` in _pick_exempt_detector to `== 2`
1955:         #  and no candidate matches, four cases vanish, and the run reports
1956:         #  PROBEWIRING_SELFTEST_PASS 17/17.  **A check getting quietly weaker while
1957:         #  still reporting PASS** -- the exact shape this project names first, and it
1958:         #  was introduced BY the repair for a different instance of it. ***
1959:         #
1960:         #  The denominator is what makes the weakening visible, so the denominator is
1961:         #  not allowed to move: a missing exemplar reds and says why.
1962:         #  FOUR False results, so the DENOMINATOR STAYS 21 and the run FAILS.  Keeping
1963:         #  the denominator is the whole point: it is what makes a shrinking check
1964:         #  visible.  A skip that reduced 21 to 17 and still said PASS is the defect
1965:         #  this arm now refuses to have.
1966:         results.extend([False, False, False, False])
1967:         print("  FAIL  M1/M2/M2b/M3 -- no exempt DETECTOR could be extracted.")
1968:         print("        NOT the EXEMPT table doing its job.  Either _exline() cannot")
1969:         print("        extract any entry, or every exemption is discharged -- and in")
1970:         print("        both cases the checker is no longer shown to fail on these four")
1971:         print("        rules.  Supply a synthetic fixture; do not let the count shrink.")
1972:     else:
1973:         _nl = chr(10)
1974:         EX_RUN = ('%spython3 %s "$PMAX" "$STUB" > "$SELFTEST_LOG" 2>&1 || true%s'
1975:                   % (_nl, EX, _nl))
1976:         EX_MENTIONS = PIT_MENTIONS.replace("pit8253_latch_probe.py", EX)
1977: 
1978:         rg, chk = fresh(); _st_apply(chk, _exline(EX), "")
1979:         case("M1  an unwired detector is NAMED", 1,
1980:              "UNWIRED DETECTOR  %s" % EX, chk, rg)
1981: 
1982:         rg, chk = fresh(); _st_apply(chk, _exline(EX), "")
1983:         _st_append(os.path.join(rg, "gate_arm.sh"), EX_MENTIONS)
1984:         case("M2  4 MENTIONS do not count as wiring", 1,
1985:              "UNWIRED DETECTOR  %s" % EX, chk, rg)
1986: 
1987:         rg, chk = fresh(); _st_apply(chk, _exline(EX), "")
1988:         _st_append(os.path.join(rg, "gate_arm.sh"), EX_RUN)
1989:         case("M2b SATISFIABLE: a real invocation turns it green", 0, "PROBEWIRING_PASS",
1990:              chk, rg, forbid="UNWIRED")
1991: 
1992:         rg, chk = fresh(); _st_append(os.path.join(rg, "gate_arm.sh"), EX_RUN)
1993:         case("M3  wired AND still exempt -> STALE EXEMPTION", 1,
1994:              "STALE EXEMPTION  %s" % EX, chk, rg)
1995: 
1996:     rg, chk = fresh()
1997:     _st_append(os.path.join(rg, "gate_sh_rounding.sh"),
1998:                '\npython3 sh4pcic_witness.py "$PMAX" "$KERNEL" > "$WLOG" 2>&1 || true\n')
1999:     case("M4  a WITNESS wired into a gate reddens", 1,
2000:          "GATED WITNESS  sh4pcic_witness.py", chk, rg)
2001: 
2002:     rg, chk = fresh()
2003:     case("M5a a live exemption is GREEN the day before", 0, "PROBEWIRING_PASS", chk, rg,
2004:          extra=("--today", "2026-09-19"))
2005:     case("M5b the same tree is RED the day after", 1, "EXPIRED EXEMPTION", chk, rg,
2006:          extra=("--today", "2026-09-21"))
2007: 
2008:     for tag, bad in (("M5c unpadded (the ieee_store shape)", '"2026-9-20"'),
2009:                      ("M5d empty", '""'),
2010:                      ("M5e not a date at all", '"soon"')):
2011:         if EX is None:
2012:             #  NOT `continue`.  A bare continue drops the case from `results` and the
2013:             #  DENOMINATOR SHRINKS -- which is the very defect this arm exists to
2014:             #  refuse, surviving one level down from where it was first repaired.
2015:             #  Measured: with the four M1-M3 cases fixed and this one still using
