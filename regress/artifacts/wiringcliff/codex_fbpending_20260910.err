 succeeded in 470ms:
 734:     note "diag_div_sweep.py or python3 missing -- class ratchet NOT run"
 735: fi
 736: 
 737: PLOG=$LOGDIR/pmax.ptylog
 738: ALOG=$LOGDIR/arc.ptylog
 739: [ -f "$PLOG" ] && [ -f "$ALOG" ] || \
 740:     gate_skip "no logs from this run -- gate 4 must run first (it publishes them here)"
 741: 
 742: # ---- positive control --------------------------------------------------
 743: # Without this the gate cannot tell "nothing went wrong" from "nothing happened".
 744: # The floor is MEASURED, not guessed. A healthy run produces about 4,600 bytes on pmax
 745: # (a plain serial console) and about 1,195,000 on arc (a VGA text console that repaints
 746: # differentially, so it re-emits the screen constantly). An earlier draft used a single
 747: # 20,000-byte floor for both and failed pmax on a perfectly good boot -- a false red, which
 748: # is how gates get switched off. 2,000 is comfortably below the smaller rig and still far
 749: # above the "empty or truncated file" case this control exists to catch.
 750: for pair in "pmax:$PLOG" "arc:$ALOG"; do
 751:     lab=${pair%%:*}; f=${pair##*:}
 752:     check_min "$lab: log is substantial"   "$(wc -c < "$f")" 2000
 753: done
 754: # pmax sets the 8th bit on every console character; arc repaints differentially. Strip the
 755: # high bit for pmax and accept either the raw arc log or gate 4's screen rebuild.
 756: check "pmax: log proves a real boot (uid=0)" \
 757:       "$(tr '\200-\377' '\000-\177' < "$PLOG" | grep -qa 'uid=0(root)' && echo yes || echo no)" "yes"
 758: check "arc: log proves a real boot (uid=0)" \
 759:       "$( { grep -qa 'uid=0(root)' "$ALOG" || grep -qa 'uid=0(root)' "$LOGDIR/arc.screen" 2>/dev/null; } && echo yes || echo no)" "yes"
 760: echo
 761: 
 762: # ---- markers that must be ZERO -----------------------------------------
 763: # Every pattern below was verified to exist as an emittable string in src/. Three did NOT
 764: # survive that check and were removed rather than left in place looking like coverage:
 765: #   'FIFO underrun'        -- 0 sites. The real string is 'FIFO overrun' (4 sites).
 766: #   'INSTR: unimplemented' -- 0 sites. The token 'INSTR:' is in no format string at all;
 767: #                             the real dyntrans marker is 'could not find physical'.
 768: #   '{ asc: data in'       -- exists, but is NOT distress. See the bounded list below.
 769: PATTERNS='panic
 770: FATAL
 771: zero-length
 772: FIFO overrun
 773: short DATA_IN DMA
 774: short DATA_OUT DMA
 775: unimplemented format
 776: could not find physical'
 777: 
 778: printf "  %-28s %8s %8s\n" "marker" "pmax" "arc"
 779: while IFS= read -r pat; do
 780:     [ -n "$pat" ] || continue
 781:     p=$(count "$PLOG" "$pat")
 782:     a=$(count "$ALOG" "$pat")
 783:     printf "  %-28s %8s %8s\n" "$pat" "$p" "$a"
 784:     check "pmax clean: $pat" "$p" "0"
 785:     check "arc  clean: $pat" "$a" "0"
 786: done <<EOF
 787: $PATTERNS
 788: EOF
 789: echo
 790: 
 791: # ---- the OTHER rigs' logs ----------------------------------------------
 792: # This gate used to read only the two MIPS pty logs, so a panic in the m88k or SuperH
 793: # guest left it green while the README claimed "any boot log". Gate 5's logs are scanned
 794: # here too when they exist -- they are the newer, less-exercised rigs, which is exactly
 795: # where a distress marker is most likely to be informative.
 796: for rig in luna88k landisk; do
 797:     rlog=$LOGDIR/drive_$rig.log
 798:     [ -f "$rlog" ] || { note "$rig: no log from this run (gate 5 did not run it)"; continue; }
 799:     while IFS= read -r pat; do
 800:         [ -n "$pat" ] || continue
 801:         c=$(count "$rlog" "$pat")
 802:         [ "$c" != 0 ] && printf "  %-20s %-28s %s\n" "$rig" "$pat" "$c"
 803:         check "$rig clean: $pat" "$c" "0"
 804:     done <<EOF
 805: $PATTERNS
 806: EOF
 807: done
 808: echo
 809: 
 810: # ---- markers with a KNOWN NON-ZERO baseline ----------------------------
 811: # '{ asc: data in, lenIn=.. lenIn2=.. }' (dev_asc.c:417) fires whenever a SCSI target has
 812: # fewer bytes ready than the guest asked for. That is an ordinary occurrence -- measured
 813: # at 1 on pmax and 5 on arc across a healthy OpenBSD 2.2 boot -- so demanding zero was
 814: # simply wrong, and this gate failed on it the first time it ran.
 815: #
 816: # It is still worth watching, because the failure mode that matters is a FLOOD: round 40
 817: # found #265's own diagnostic firing on every healthy boot, and that showed up only as a
 818: # marker count. So the assertion is a CEILING rather than an equality -- generous enough
 819: # that ordinary boot-to-boot variation cannot trip it, tight enough that a per-transfer
 820: # flood will.
 821: printf "  %-28s %8s %8s   %s\n" "bounded marker" "pmax" "arc" "ceiling"
 822: BOUNDED_CEILING=50
 823: for pat in '{ asc: data in'; do
 824:     p=$(count "$PLOG" "$pat")
 825:     a=$(count "$ALOG" "$pat")
 826:     printf "  %-28s %8s %8s   %s\n" "$pat" "$p" "$a" "$BOUNDED_CEILING"
 827:     check "pmax not flooding: $pat" "$([ "$p" -le "$BOUNDED_CEILING" ] && echo ok || echo FLOOD)" "ok"
 828:     check "arc  not flooding: $pat" "$([ "$a" -le "$BOUNDED_CEILING" ] && echo ok || echo FLOOD)" "ok"
 829: done
 830: 
 831: gate_end
 832: exit $?

