1532: def gate_list(regress):
1533:     """The battery's OWN array is the authority on which scripts run.
1534: 
1535:     Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
1536:     second-order property worth having: a gate script that exists but was dropped out of
1537:     GATES does not run, so every probe it owned becomes unwired here and this goes RED.
1538:     A glob would have called those probes gated forever.
1539:     """
1540:     run = os.path.join(regress, "run.sh")
1541:     if not os.path.isfile(run):
1542:         return None, "regress/run.sh is missing -- cannot tell which gates run"
1543:     m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
1544:     if not m:
1545:         return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
1546:     return [n + ".sh" for n in m.group(1).split()], None
1547: 
