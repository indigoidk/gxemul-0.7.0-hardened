 205: class Session:
 206:     """One emulator process on a cold debugger."""
 207: 
 208:     def __init__(self):
 209:         self.buf = ""
 210:         self.dead = False
 211:         self.pid, self.fd = pty.fork()
 212:         if self.pid == 0:
 213:             #  EXPLICIT PATH.  os.execvp on a bare name searches PATH; every arm then
 214:             #  reports dead, which looks exactly like a wedged session rather than a
 215:             #  bad invocation.
 216:             os.execvp(BIN, [BIN, "-V", "-T", "-E", "cats", "-M", "32",
 217:                             "0x%x:%s" % (CODE, STUB)])
 218:             os._exit(127)
 219: 
 220:     def rd(self, t=0.4):
 221:         r, _, _ = select.select([self.fd], [], [], t)
 222:         if self.fd not in r:
 223:             return True
 224:         try:
 225:             d = os.read(self.fd, 65536)
 226:         except OSError:
 227:             self.dead = True
 228:             return False
 229:         if not d:
 230:             self.dead = True
 231:             return False
 232:         self.buf += d.decode("latin1", "replace")
 233:         return True
 234: 
 235:     #  #467: an INACTIVITY deadline, not a total-time one.  This used to read
 236:     #  `t = time.time()` once and loop `while time.time() - t < timeout`, so a boot
 237:     #  that normally takes 40 s and took 90 s on a LOADED HOST failed -- while bytes
 238:     #  were arriving the whole time.  Slow was indistinguishable from stuck, and the
 239:     #  battery could only be trusted on an idle machine.
 240:     #
 241:     #  `rd()` cannot report progress: it returns True both when data arrives and when
 242:     #  its select() times out quietly.  So progress is `len(self.buf)` changing.
 243:     #
 244:     #  STRICTLY MORE PERMISSIVE for a run that produces output, IDENTICAL for one that
 245:     #  does not -- it cannot turn a passing run into a failing one.  `timeout` now
 246:     #  means SILENCE, which is the thing actually worth failing on.
 247:     def wait(self, mark=0, echo=None, timeout=60):
 248:         t = time.time()
 249:         seen = len(self.buf)
 250:         while time.time() - t < timeout:
 251:             if not self.rd():
 252:                 return False
 253:             if len(self.buf) != seen:
 254:                 seen = len(self.buf)
 255:                 t = time.time()
 259:             if len(self.buf) > mark and resp.rstrip().endswith("GXemul>"):
 260:                 return True
 261:         return False
 262: 
 263:     def send(self, x, timeout=60):
 264:         b = (x + "\n").encode("latin1")
 265:         _mark = len(self.buf)
 266:         n = 0
 267:         try:
 268:             while n < len(b):
 269:                 n += os.write(self.fd, b[n:])
 270:         except OSError:
 271:             self.dead = True
 272:             return False
 273:         return self.wait(mark=_mark, echo=x if x else None, timeout=timeout)
 274: 
 275:     def free_run(self, seconds):
 276:         """`continue`, drain for `seconds`, then SIGINT back to the prompt.
 277: 
 278:         Returns (ok, measured_free_run_seconds).  The pty is DRAINED throughout: a full
 279:         pty buffer blocks the emulator, which would look like a device that stopped
 280:         ticking -- the exact conclusion this probe is trying to reach, so it must not be
 281:         manufacturable by the harness."""
 282:         mark = len(self.buf)
 283:         b, n = b"continue\n", 0
 284:         try:
 285:             while n < len(b):
 286:                 n += os.write(self.fd, b[n:])
 287:         except OSError:
 288:             self.dead = True
 289:             return False, 0.0
 290:         t0 = time.time()
 291:         while time.time() - t0 < seconds:
 292:             if not self.rd(0.25):
 293:                 return False, time.time() - t0
 294:         try:
 295:             os.kill(self.pid, signal.SIGINT)
 296:         except OSError:
 297:             self.dead = True
 298:             return False, time.time() - t0
 299:         ok = self.wait(mark=mark, timeout=20)
 300:         t1 = time.time()
 301:         if not ok and not self.dead:
 302:             try:
 303:                 os.kill(self.pid, signal.SIGINT)
 304:             except OSError:
 305:                 pass
 306:             ok = self.wait(mark=mark, timeout=20)
 307:             t1 = time.time()
 308:         return ok, t1 - t0
 309: 
 310:     def read_words(self, addr, n):
 311:         """Read n consecutive words out of RAM.  `dump` prints the raw little-endian
 312:         bytes, so a guest word 0x11223344 comes back as `44332211` and MUST be swapped."""
 313:         mark = len(self.buf)
 314:         if not self.send("dump 0x%08x 0x%08x" % (addr, addr + 4 * n)):
 315:             return None
 316:         out = {}
 317:         for line in self.buf[mark:].splitlines():
 318:             m = re.match(r"\s*0x([0-9a-f]{8})\s+((?:[0-9a-f]{8}\s+){1,4})", line)
 319:             if not m:
 320:                 continue
 321:             base = int(m.group(1), 16)
 322:             for i, w in enumerate(m.group(2).split()):
 323:                 raw = int(w, 16)
 324:                 out[base + 4 * i] = struct.unpack("<I", struct.pack(">I", raw))[0]
 325:         vals = [out.get(addr + 4 * i) for i in range(n)]
 326:         return None if any(v is None for v in vals) else vals
 327: 
 328:     def regs(self, which=(0, 1, 3, 5, 6, 7, 8, 9)):
 329:         mark = len(self.buf)
 330:         if not self.send("reg", timeout=30) or self.dead:
 331:             return {}
 332:         seg = self.buf[mark:]
 333:         names = {10: "sl", 11: "fp", 12: "ip", 13: "sp", 14: "lr"}
 334:         got = {}
 335:         for k in which:
 336:             nm = names.get(k, "r%d" % k)
 337:             m = re.search(r"\b%s\s*=\s*0x([0-9a-fA-F]+)" % nm, seg)
 338:             if m:
 339:                 got[k] = int(m.group(1), 16)
 340:         return got
 341: 
 342:     def close(self):
 343:         try:
 344:             os.write(self.fd, b"quit\n")
 345:             time.sleep(0.3)
 346:         except OSError:
 347:             pass
 348:         try:
 349:             os.close(self.fd)
 350:         except OSError:
 351:             pass
 352:         try:
 353:             os.waitpid(self.pid, 0)
 354:         except Exception:
 355:             pass
 356: 
 357: 
 358: def plant(s, prog):
 359:     s.send("put w 0x%08x, 0x%08x" % (LIVE, 0x11223344))
 360:     s.send("put w 0x%08x, 0x%08x" % (SRC, 0x12345678))
 361:     for a in (CLOB, ITER, LASTV, LASTID):
 362:         s.send("put w 0x%08x, 0x%08x" % (a, POISON))
 363:     for off, word, _t, _c in prog:
 364:         s.send("put w 0x%08x, 0x%08x" % (CODE + off, word))
 365:     s.send("pc=0x%08x" % CODE)
 366: 
 367: 
 368: def step_and_check(s, prog, n):
 369:     """`step 1` n times; check every EXECUTED word against what was planted at that
 370:     address AND its disassembly against the emulator's own spelling.  Returns
 371:     (mismatches, covered_addresses, executed)."""
 372:     planted = {CODE + off: (word, text) for off, word, text, _ in prog}
 373:     bad, covered, executed = [], set(), []
 374:     for _ in range(n):
 375:         mark = len(s.buf)
 376:         if not s.send("step 1", timeout=30) or s.dead:
 377:             bad.append("host died or no prompt during step %d" % (len(executed) + 1))
 378:             break
 379:         seg = s.buf[mark:]
 380:         m = re.search(r"([0-9a-f]{8}):\s+([0-9a-f]{8})\s+([^\r\n<]+)", seg)
 381:         if not m:
 382:             bad.append("no step line at step %d" % (len(executed) + 1))
 383:             break
 384:         addr, word = int(m.group(1), 16), int(m.group(2), 16)
 385:         got = re.sub(r"\s+", " ", m.group(3)).strip()
 386:         executed.append((addr, word, got))
 387:         if addr not in planted:
 388:             bad.append("stepped 0x%08x, which was never planted" % addr)
 389:             continue
 390:         pw, pt = planted[addr]
 391:         covered.add(addr)
 392:         if word != pw:
 393:             bad.append("0x%08x read back 0x%08x, planted 0x%08x" % (addr, word, pw))
 394:         if pt is not None and got != pt:
 395:             bad.append("0x%08x 0x%08x -> %r, expected %r" % (addr, word, got, pt))
 396:     return bad, covered, executed
 397: 
 398: 
 399: def run_witness(head, sentinel, slices, slice_s, label):
 400:     prog = head + prologue(sentinel[0], sentinel[1]) + LOOP + [LANDING]
 401:     s = Session()
 402:     if not s.wait(timeout=120):
 403:         s.close()
 404:         return dict(status="NO-PROMPT", label=label, samples=[], regs={}, badis=[], catchup=0)
 405:     plant(s, prog)
 406:     bad, _, _ = step_and_check(s, prog, PROLOGUE_N)
 407:     r = s.regs()
 408:     samples, t_cum, lost = [], 0.0, False
 409:     for _ in range(slices):
 410:         ok, dt = s.free_run(slice_s)
 411:         t_cum += dt
 412:         if not ok or s.dead:
 413:             lost = True
 414:             break
 415:         w = s.read_words(CLOB, 4)
 416:         if w is None:
 417:             lost = True
 418:             break
 419:         samples.append(dict(t=t_cum, clob=w[0], iters=w[1], lastv=w[2], lastid=w[3]))
 420:     if s.dead:
 421:         status = "HOST-DIED"
 422:     elif lost:
 423:         status = "INTERRUPT-LOST"
 424:     else:
 425:         status = "SURVIVED"
 426:     catchup = s.buf.count(TIMERMSG)
 427:     s.close()
 428:     return dict(status=status, label=label, regs=r, badis=bad,
 429:                 samples=samples, catchup=catchup)
 430: 
 431: 
 432: def run_kill():
 433:     prog = MMU_OFF + prologue(*SENT_A) + [KILL, (0x4c, NOP, NOPTXT, "")]
 434:     s = Session()
 435:     if not s.wait(timeout=120):
 436:         s.close()
 437:         return dict(status="NO-PROMPT", saw_fatal=False, badis=[], nsteps=0)
 438:     plant(s, prog)
 439:     bad, _, ex = step_and_check(s, prog, PROLOGUE_N + 1)
 440:     died = s.dead
 441:     if not died:
 442:         #  The exit may land between the write and our read; one more poke settles it.
 443:         s.send("reg", timeout=10)
 444:         died = s.dead
 445:     seen = "ENABLE SET" in s.buf
 446:     s.close()
 447:     return dict(status="HOST-DIED" if died else "SURVIVED", saw_fatal=seen,
 448:                 badis=bad, nsteps=len(ex))
 449: 
 450: 
 451: def run_encodings():
 452:     """Arm E: sentinel 0 makes the poll compare EQUAL, so `step 1` walks BOTH loop
 453:     bodies and every planted word is checked as it EXECUTES."""
 454:     prog = MMU_OFF + prologue(*SENT_E) + LOOP + [LANDING]
 455:     s = Session()
 456:     if not s.wait(timeout=120):
 457:         s.close()
 458:         return dict(status="NO-PROMPT", regs={}, badis=[], covered=set(), want=set(),
 459:                     nsteps=0, executed=[])
 460:     plant(s, prog)
 461:     bad, covered, ex = step_and_check(s, prog, PROLOGUE_N + 2 * len(LOOP))
 462:     r = s.regs()
 463:     want = {CODE + off for off, *_ in prog if off != LANDING[0]}
 464:     status = "HOST-DIED" if s.dead else "SURVIVED"
 465:     s.close()
 466:     return dict(status=status, regs=r, badis=bad, covered=covered, want=want,
 467:                 nsteps=len(ex), executed=ex)
 468: 
