   1: #!/bin/bash
   2: # GATE 7 -- three-way A/B against pristine 0.7.0 and the pre-batch fork.
   3: #
   4: #   pristine   39748e3   unmodified upstream GXemul 0.7.0
   5: #   prebatch   2ffc91e   the fork immediately before the current batch
   6: #   HEAD                 what is being shipped
   7: #
   8: # TWO DIFFERENT QUESTIONS. Conflating them is the trap this gate exists to avoid:
   9: #
  10: #   vs PRISTINE  = CAPABILITY PRESERVATION. The fork carries ~290 deliberate corrections,
  11: #                  so differences are EXPECTED and are not regressions. The only thing
  12: #                  that counts against us is a machine that ran under upstream and no
  13: #                  longer runs.
  14: #
  15: #   vs PREBATCH  = CHANGE-SET VERIFICATION. Everything not touched by the batch should be
  16: #                  identical, and anything that moved must be attributable to a specific
  17: #                  correction.
  18: #
  19: # `gate_ab.sh --build` (re)creates the two baselines first; without it they are reused.
  20: #
  21: # METHOD NOTES, both learned the hard way:
  22: #
  23: #  * Every run goes through run_emu_progress() (#419; run_emu() no longer has any caller),
  24: #    which forces stdbuf -o0. On a pipe, gxemul's stdout
  25: #    is 4 KB block-buffered and `timeout`'s SIGTERM discards a partial block -- so a guest
  26: #    that produced 3 KB of good output scores ZERO. An earlier version of this comparison
  27: #    reported a "capability regression" on luna88k that was entirely a lost buffer.
  28: #  * Comparison is on SEMANTIC MARKERS, never on byte counts. Under a wall-clock timeout a
  29: #    byte count measures how fast the host happened to be, not what the guest did.
  30: set -u
  31: HERE=$(cd "$(dirname "$0")" && pwd)
  32: . "$HERE/lib.sh"
  33: 
  34: SEC=$ROOT/GXEMUL-SEC
  35: PRISTINE_DIR=/tmp/gx-pristine
  36: PREBATCH_DIR=/tmp/gx-prebatch
  37: PRISTINE_REF=39748e3
  38: PREBATCH_REF=2ffc91e
  39: 
  40: build_baseline() {   # ref, dir, label
  41:     local ref=$1 dir=$2 lab=$3
  42:     echo "  building $lab ($ref) -> $dir"
  43:     rm -rf "$dir"; mkdir -p "$dir"
  44:     ( cd "$SEC" && git archive "$ref" ) | tar -x -C "$dir"
  45:     # The repo does not track the exec bit (index mode 100644), so a tree produced by
  46:     # `git archive` has a non-executable configure: it fails rc=126 and the generator
  47:     # scripts die with make-level "Error 127". Note that greping the log for 'error:'
  48:     # MISSES that, because make spells it "Error 127" -- the object count is the real tell.
  49:     chmod +x "$dir/configure" 2>/dev/null
  50:     find "$dir" -name '*.sh' -exec chmod +x {} + 2>/dev/null
  51:     ( cd "$dir" && sh ./configure > configure.log 2>&1 && make -j12 > build.log 2>&1 )
  52:     local objs; objs=$(find "$dir/src" -name '*.o' 2>/dev/null | wc -l)
  53:     echo "    objects=$objs  binary=$([ -x "$dir/gxemul" ] && stat -c%s "$dir/gxemul" || echo NONE)"
  54:     [ -x "$dir/gxemul" ] || { echo "    BUILD FAILED:"
  55:         grep -E "Error [0-9]+|No rule|undefined reference" "$dir/build.log" | head -8; }
  56: }
  57: 
  58: if [ "${1:-}" = "--build" ]; then
  59:     echo "## building baselines"
  60:     build_baseline "$PRISTINE_REF" "$PRISTINE_DIR" pristine
  61:     build_baseline "$PREBATCH_REF" "$PREBATCH_DIR" prebatch
  62:     echo
  63: fi
  64: 
  65: gate_begin "a-b-baselines"
  66: need_exec "$PRISTINE_DIR/gxemul" "$PREBATCH_DIR/gxemul" "$ROOT/build/gxemul"
  67: 
  68: # probe <label> <binary> <logfile> <args...>  -> prints "marker=N ..." for the rig
  69: # NOTE THE R: PREFIX. It opens the base image read-only and routes every guest write into
  70: # a temporary overlay that is discarded when the run ends.
  71: #
  72: # Without it this function booted THREE DIFFERENT BUILDS SEQUENTIALLY AGAINST ONE SHARED,
  73: # WRITABLE 2 GB IMAGE, so the runs were not independent: each build inherited whatever
  74: # filesystem state the previous one left behind, including an unclean unmount when the
  75: # 300 s timeout killed a guest that had reached its login prompt. The symptom was a
  76: # non-deterministic FAIL -- HEAD came back 1:1:0 having passed 1:1:1 twice at the same
  77: # commit with no code change. The image's mtime confirmed it: it tracked the most recent
  78: # boot, not the download.
  79: #
  80: # Timing was ruled out separately by measurement: both builds reach `login:` in about
  81: # 100 s against a 300 s budget, so this was never a marginal timeout.
  82: LUNA_IMG="R:$IMAGES/liveimage-luna88k-raw-20250518.img"
  83: 
  84: # #419: the 300 s wall budget above was replaced by a budget of GUEST WORK. See
  85: # run_emu_progress() in lib.sh for the measurements. Three constants, each measured:
  86: #
  87: #   LUNA_BUDGET 12 G   Observed instructions-to-login spans 7.316-7.786 G over eleven boots.
  88: #                      12 G is +54 % over the observed max. It bounds ONLY the failure path --
  89: #                      a healthy boot stops at the MARKER long before it -- so over-provisioning
  90: #                      costs nothing on the success path and removes per-host recalibration.
  91: #                      8.5 G was rejected: it sits only ~5 % above the theoretical ceiling a
  92: #                      maximally-precise usleep host would reach (~8.06 G).
  93: #   LUNA_STALL  120 s  At the SLOWEST rate measured here (9.9 M instr/s -- 7,349,301,148
  94: #                      instructions in 742 s, host saturated) one -N record arrives every
  95: #                      3.4 s. That is a HANG, not a slow host -- but the claim is empirical,
  96: #                      not absolute: this detector still reads `date +%s`, so a host that
  97: #                      SUSPENDS or starves the process for two minutes looks identical.
  98: #                      *** THE MULTIPLIER WAS OVERSTATED AS 35x. 3.4 s is a MEAN derived from
  99: #                      total instructions over total wall time; the WORST observed gap is what
 100: #                      matters, and measured directly on the pty path under saturation it is
 101: #                      7.06 s (n=219: min 0.47, median 3.86, p90 5.54, p99 6.23). So the
 102: #                      honest multiplier is 17x, not 35x. Still ample -- but a mean is not a
 103: #                      worst case, and quoting one as the other is how a margin gets believed
 104: #                      to be twice its real size. ***
 105: #   LUNA_BACKSTOP 1800 s  2.4x the worst boot ever measured here (742 s, 8 busy loops on 8
 106: #                      cores, which still reached login 1:1:1).
 107: LUNA_BUDGET=12000000000
 108: LUNA_STALL=120
 109: LUNA_BACKSTOP=1800
 110: 
 111: # *** THE CONSTANTS NEEDED THEIR OWN ROWS.  Measured in pass 2: multiplying LUNA_BUDGET by
 112: # 1000, or LUNA_BACKSTOP by 4000, or disabling LUNA_STALL entirely, left ALL FOURTEEN CHECKS
 113: # GREEN.  The selftest below exercises run_emu_progress() with LITERAL arguments, so it proves
 114: # the function works while proving nothing about the values this gate actually passes it --
 115: # the rows guard a different instance of the thing they appear to guard.
 116: #
 117: # These bounds are derived, not taste: the observed maximum instructions-to-login is
 118: # 7,785,570,754, so a budget below ~1.05x that would false-FAIL a healthy boot and one above
 119: # ~2x stops bounding anything.  The stall threshold must exceed several -N record intervals
 120: # (~3.4 s at the slowest rate measured) and stay far below the backstop.  The backstop must
 121: # exceed the worst boot measured (742 s) with margin.  A static check costs no boot. ***
 122: LUNA_OBSERVED_MAX=7785570754
 123: check_min "budget is above the observed max instructions-to-login" \
 124:           "$LUNA_BUDGET" "$(( LUNA_OBSERVED_MAX * 105 / 100 ))"
 125: check     "budget still bounds something (<= 2x observed max)" \
 126:           "$([ "$LUNA_BUDGET" -le "$(( LUNA_OBSERVED_MAX * 2 ))" ] && echo yes || echo "no: $LUNA_BUDGET")" yes
 127: check     "stall threshold is many -N intervals but well under the backstop" \
 128:           "$([ "$LUNA_STALL" -ge 30 ] && [ "$LUNA_STALL" -le $(( LUNA_BACKSTOP / 4 )) ] && echo yes || echo "no: $LUNA_STALL")" yes
 129: check     "backstop exceeds the worst boot measured (742 s) with margin" \
 130:           "$([ "$LUNA_BACKSTOP" -ge 1200 ] && [ "$LUNA_BACKSTOP" -le 3600 ] && echo yes || echo "no: $LUNA_BACKSTOP")" yes
 131: 
 132: # #419 SELFTEST. The classifier decides whether a row is a regression, a hang, a harness fault
 133: # or merely a slow host, so it needs its own rows -- and they must NOT need the rig, or they
 134: # would cost 15 minutes and never be run. Fake "emulators" drive every reason in seconds.
 135: #
 136: # WHY THIS IS NOT OPTIONAL: the BUDGET and STALLED branches are ONLY EVER ENTERED BY A FAILING
 137: # RUN, because a healthy boot stops at MARKER long before either. So nothing on a green run
 138: # exercises them, and a mutation that breaks them is invisible to every capability row here.
 139: #
 140: # *** AND THE HARDEST CASE IS THE ONE THAT LOOKS HEALTHY. Remove `-N` and the guest still
 141: # boots, still prints every marker, and still classifies as MARKER -- there is nothing wrong
 142: # with the boot. What is wrong is that the budget and stall protections were never armed, and
 143: # the ONLY observable difference is that the instruction count stayed at zero. Pass 2 caught
 144: # this surviving: the fake originally written for it never printed `login:`, so it had been
 145: # built to match the guard rather than the threat. ***
 146: selftest_progress() {
 147:     local d=$LOGDIR/r419fake; mkdir -p "$d"
 148: 
 149:     # Prints instruction records, then the marker. -> MARKER
 150:     printf '#!/bin/sh\nfor i in 1 2 3; do echo "[ $((i*100000000)) instrs; i/s=1 avg=1]"; sleep 0.2; done\necho "login: "\nsleep 30\n' > "$d/f_marker"
 151:     # Prints ever-advancing records and never the marker. -> BUDGET (with a tiny budget)
 152:     printf '#!/bin/sh\ni=1\nwhile :; do echo "[ $((i*100000000)) instrs; i/s=1 avg=1]"; i=$((i+1)); sleep 0.2; done\n' > "$d/f_budget"
 153:     # One record, then silence while staying alive. -> STALLED
 154:     printf '#!/bin/sh\necho "[ 100000000 instrs; i/s=1 avg=1]"\nsleep 60\n' > "$d/f_stall"
 155:     # Prints two markers but NO instruction record, and never reaches the milestone. -> ABSENT
 156:     printf '#!/bin/sh\necho "LUNA-88K BOOT"\necho "M88100"\nsleep 60\n' > "$d/f_absent"
 157:     # *** THE ONE THAT MATTERS: a guest that BOOTS PERFECTLY with no instruction stream --
 158:     # exactly what removing `-N` produces. It reaches the milestone, so `reason` is MARKER and
 159:     # every reason-based check passes; only the instruction COUNT reveals that the budget and
 160:     # stall protections were never armed. Pass 2 found this surviving; the fake above had been
 161:     # written to match the guard rather than the threat, because it never printed `login:`. ***
 162:     printf '#!/bin/sh\necho "LUNA-88K BOOT"\necho "M88100"\necho "login: "\nsleep 30\n' > "$d/f_nostream"
 163:     chmod +x "$d"/f_*
 164: 
 165:     local o r n
 166:     o=$(run_emu_progress 20 500000000 5 'login:' "$d/o_marker.log" "$d/f_marker")
 167:     r=${o#reason=}; r=${r%% *}
 168:     check "progress selftest: marker stops the run" "$r" "MARKER"
 169: 
 170:     o=$(run_emu_progress 20 500000000 5 'login:' "$d/o_budget.log" "$d/f_budget")
 171:     r=${o#reason=}; r=${r%% *}
 172:     check "progress selftest: instruction budget stops the run" "$r" "BUDGET"
 173: 
 174:     o=$(run_emu_progress 20 500000000 3 'login:' "$d/o_stall.log" "$d/f_stall")
 175:     r=${o#reason=}; r=${r%% *}
 176:     check "progress selftest: a stalled guest is STALLED, not slow" "$r" "STALLED"
 177: 
 178:     # If this row ever reads MARKER or BACKSTOP, a broken -N would score as an ordinary
 179:     # timeout and the gate would go quietly green while measuring nothing.
 180:     o=$(run_emu_progress 8 500000000 30 'login:' "$d/o_absent.log" "$d/f_absent")
 181:     r=${o#reason=}; r=${r%% *}
 182:     check "progress selftest: markers without an instruction stream are ABSENT" "$r" "ABSENT"
 183: 
 184:     # A guest that BOOTS with no instruction stream is the dropped-`-N` shape, and its reason
 185:     # is legitimately MARKER -- there is nothing wrong with the boot. The only signal that the
 186:     # oracle was never armed is that the count stayed at zero, so THAT is what the real rows
 187:     # assert. This row exists to keep the two facts nailed together: reason MARKER, count 0.
 188:     o=$(run_emu_progress 20 500000000 10 'login:' "$d/o_nostream.log" "$d/f_nostream")
 189:     r=${o#reason=}; r=${r%% *}
 190:     n=${o#*ninstrs=}; n=${n%% *}
 191:     check "progress selftest: a boot with no -N stream still reads MARKER" "$r" "MARKER"
 192:     check "progress selftest: ...and is caught only by a zero instruction count" "$n" "0"
 193: 
 194:     # A CRASH IS NOT A TIMEOUT. Measured on the previously shipped code: a fake emitting one
 195:     # record then exiting 3 reported BACKSTOP -- putting a dead build into the single reason
 196:     # a caller is allowed to excuse as host load. timeout(1) returns 124 if and only if IT
 197:     # fired, so the exit status is what separates the two.
 198:     printf '#!/bin/sh\necho "[ 100000000 instrs; i/s=1 avg=1]"\nexit 3\n' > "$d/f_crash"
 199:     chmod +x "$d/f_crash"
 200:     o=$(run_emu_progress 20 500000000 10 'login:' "$d/o_crash.log" "$d/f_crash")
 201:     r=${o#reason=}; r=${r%% *}
 202:     check "progress selftest: a crashed emulator is EXITED, not BACKSTOP" "$r" "EXITED"
 203: }
 204: selftest_progress
 205: 
 206: # Sets R_REASON / R_INSTRS / R_MARKERS. Globals rather than a return value because the
 207: # caller needs all three to score a row, and the reason is the whole point of #419.
 208: luna_run() {   # binary, tag
 209:     local log=$LOGDIR/ab_luna_$2.log out
 210:     out=$(run_emu_progress "$LUNA_BACKSTOP" "$LUNA_BUDGET" "$LUNA_STALL" 'login:' \
 211:               "$log" "$1" -N -e luna-88k -d "$LUNA_IMG" boot)
 212:     R_REASON=${out#reason=}; R_REASON=${R_REASON%% *}
 213:     R_INSTRS=${out#*ninstrs=}; R_INSTRS=${R_INSTRS%% *}
 214:     R_MARKERS="$(count "$log" 'LUNA-88K BOOT'):$(count "$log" 'M88100'):$(count "$log" 'login:')"
 215:     printf "       %-10s %-9s instrs=%-14s %s\n" "$2" "$R_REASON" "$R_INSTRS" "$R_MARKERS"
 216: }
 217: 
 218: if [ ! -f "$IMAGES/liveimage-luna88k-raw-20250518.img" ]; then
 219:     degrade "luna88k image absent -- the only cross-build behavioural comparison did not run"
 220: else
 221:     note "luna88k (m88k): stop reason + 'LUNA-88K BOOT':'M88100':'login:' marker counts"
 222:     luna_run "$PRISTINE_DIR/gxemul" pristine; PRI=$R_MARKERS; PRI_R=$R_REASON; PRI_N=$R_INSTRS
 223:     luna_run "$PREBATCH_DIR/gxemul" prebatch; PRE=$R_MARKERS; PRE_R=$R_REASON; PRE_N=$R_INSTRS
 224:     luna_run "$ROOT/build/gxemul"   head;     HD=$R_MARKERS;  HD_R=$R_REASON;  HD_N=$R_INSTRS
 225: 
 226:     # #419 SCORING. The defect was that a load-induced timeout could not be told apart from a
 227:     # capability regression. The naive cure -- calling every timeout INCONCLUSIVE -- was
 228:     # MEASURED to be strictly worse: `degrade` and `gate_skip` both exit 77 -> SKIP ->
 229:     # REGRESS_PASS_WITH_GAPS (exit 3), so a HEAD that hangs before login would turn today's
 230:     # hard REGRESS_FAIL (exit 1) into a green-ish result. Green is what gets read. So the
 231:     # reasons are scored individually and only ONE of them is ever inconclusive.
 232:     #
 233:     # ROW-SCOPED END CONDITIONS, and this is the subtle part: the signal that means "hung" for
 234:     # HEAD is the EXPECTED state for pristine. Upstream 0.7.0 emits ZERO -N records on luna88k
 235:     # (measured, five runs, 768-byte logs), so it can never complete an instruction budget --
 236:     # scoring it by budget would turn a long-standing PASS into a permanent not-run.
 237:     check "pristine 0.7.0 does not boot luna88k (expected)" "$PRI" "0:0:0"
 238:     # #419 pass 2: assert the COUNT, not the reason. Scoring this by reason accepted STALLED
 239:     # too, so "one instruction record followed by silence" would have passed a row whose name
 240:     # claims there is no instruction stream at all. The row now says what it means.
 241:     check "pristine emits no instruction records at all" "$PRI_N" "0"
 242:     # PRI_R was assigned and never read after pass 2 removed its only consumer -- a seat
 243:     # caught the dead variable. It is worth asserting rather than deleting: ABSENT proves
 244:     # the no-stream path classified it, whereas BACKSTOP would mean the run sat for the full
 245:     # 1800 s and nothing noticed.
 246:     check "pristine is classified by the absent-stream path, not the backstop" "$PRI_R" "ABSENT"
 247: 
 248:     # An absent stream from a build that is supposed to RUN is a harness fault -- the `-N`
 249:     # argument or the extraction broke -- and a harness fault must be red, never inconclusive.
 250:     #
 251:     # *** #419 pass 2: THIS ASSERTS THE COUNT BECAUSE ASSERTING THE REASON DID NOT WORK.
 252:     # `reason` is only ABSENT when the run did NOT reach the marker, so a build that boots
 253:     # normally with `-N` removed classifies as MARKER and sailed straight through the previous
 254:     # spelling of this check. Dropping `-N`, or breaking the extraction by one character, would
 255:     # then leave every capability row green while the budget and stall protections this round
 256:     # exists for were silently gone. A seat found it; the selftest had missed it because the
 257:     # fake built for this case omitted `login:` -- it was written to match the guard rather
 258:     # than the threat. ***
 259:     for pair in "prebatch:$PRE_N" "HEAD:$HD_N"; do
 260:         if [ "${pair#*:}" -gt 0 ] 2>/dev/null; then
 261:             check "${pair%%:*}: -N instruction stream was actually observed" present present
 262:         else
 263:             check "${pair%%:*}: -N instruction stream was actually observed" "0 records" present
 264:         fi
 265:     done
 266: 
 267:     # BUDGET means the guest was given a full allowance of WORK and still never booted. Host
 268:     # load cannot produce that, so it is a real negative and stays a hard failure.
 269:     # STALLED means the guest stopped executing entirely -- a hang, not a slow host.
 270:     for pair in "prebatch:$PRE_R" "HEAD:$HD_R"; do
 271:         case "${pair#*:}" in
 272:         BUDGET|STALLED)
 273:             check "${pair%%:*}: stopped for a reason load cannot cause" "${pair#*:}" MARKER ;;
 274:         esac
 275:     done
 276: 
 277:     # The ONLY load-ambiguous outcome: wall clock expired while instructions were still
 278:     # advancing. Even here it is inconclusive ONLY if prebatch was hit too -- gate_ab already
 279:     # boots all three builds, so the load signal is free. If prebatch reached its marker the
 280:     # host was demonstrably fine, and HEAD alone failing is a REGRESSION, not a casualty.
 281:     if [ "$HD_R" = BACKSTOP ]; then
 282:         if [ "$PRE_R" = MARKER ]; then
 283:             check "HEAD hit the wall backstop while prebatch booted (regression, not load)" \
 284:                   "BACKSTOP@$HD_N" "MARKER"
 285:         else
 286:             degrade "both HEAD and prebatch hit the ${LUNA_BACKSTOP}s backstop with instructions still advancing (HEAD $HD_N, prebatch $PRE_N) -- host too slow to decide; NOT a pass"
 287:         fi
 288:     fi
 289: 
 290:     check "HEAD matches pre-batch on luna88k"               "$HD"  "$PRE"
 291:     check "HEAD boots luna88k to a login prompt"            "$HD"  "1:1:1"
 292: 
 293:     # Upstream 0.7.0 does NOT boot OpenBSD/luna88k -- measured, unbuffered: it emits its
 294:     # banner -- 768 bytes of log, measured across five runs -- and no guest output whatsoever.
 295:     # That is the expected baseline, so it is
 296:     # asserted rather than treated as a failure. If it ever starts booting, the check above
 297:     # fires and this note needs revisiting.
 298:     #
 299:     # #419 measured WHY, and it matters for the scoring above: pristine does not exit and does
 300:     # not idle -- it SPINS, burning 100 % of one core, emitting fewer than 33,554,432
 301:     # instructions in 300 s (< 111,848 instr/s). So "the process is still alive" carries no
 302:     # information here, and an instruction budget could never complete: 12 G would take over
 303:     # 29 hours. The stall detector catches it in LUNA_STALL seconds (120) instead -- a
 304:     # prototype used 30 s and this note claimed that figure for months longer than it was
 305:     # true; the shipped gate uses one constant for all three legs.
 306: fi
 307: echo
 308: 
 309: # CAPABILITY PRESERVATION: every machine alias UPSTREAM advertises must still be
 310: # advertised by HEAD.
 311: #
 312: # This replaces an alias check that could not fail. The old one harvested the alias list
 313: # from HEAD's own -H and then grepped each machine's output for "Unknown machine" -- a
 314: # string that appears NOWHERE in src/ (verified: 0 occurrences; the real message is
 315: # "Unknown subtype", capitalised, so the lower-case pattern missed it too). `unknown` was
 316: # therefore 0 for every possible input. Worse, harvesting from HEAD meant a dropped
 317: # machine was absent from the list and never probed, so the one thing it claimed to detect
 318: # was the one thing it structurally could not.
 319: #
 320: # Comparing the two advertised lists is a genuine assertion, needs no media, and is fast.
 321: note "machine-alias capability: upstream's list must still be advertised by HEAD"
 322: alias_list() { "$1" -H 2>&1 | grep -oE '"[a-z0-9_.-]+"' | tr -d '"' | sort -u; }
 323: alias_list "$PRISTINE_DIR/gxemul" > "$LOGDIR/alias_pristine.txt"
 324: alias_list "$ROOT/build/gxemul"   > "$LOGDIR/alias_head.txt"
 325: n_pri=$(wc -l < "$LOGDIR/alias_pristine.txt")
 326: n_head=$(wc -l < "$LOGDIR/alias_head.txt")
 327: comm -23 "$LOGDIR/alias_pristine.txt" "$LOGDIR/alias_head.txt" > "$LOGDIR/alias_lost.txt"
 328: comm -13 "$LOGDIR/alias_pristine.txt" "$LOGDIR/alias_head.txt" > "$LOGDIR/alias_gained.txt"
 329: n_lost=$(wc -l < "$LOGDIR/alias_lost.txt")
 330: n_gained=$(wc -l < "$LOGDIR/alias_gained.txt")
 331: note "upstream advertises $n_pri, HEAD advertises $n_head"
 332: [ "$n_gained" -gt 0 ] && note "added by the fork (expected, not a regression): $(tr '\n' ' ' < "$LOGDIR/alias_gained.txt")"
 333: [ "$n_lost"   -gt 0 ] && note "MISSING FROM HEAD: $(tr '\n' ' ' < "$LOGDIR/alias_lost.txt")"
 334: # A floor, so a broken -H or a broken regex cannot pass by yielding an empty list.
 335: check_min "upstream alias list is non-trivial"   "$n_pri" 40
 336: check     "machines upstream had that HEAD lost" "$n_lost" "0"
 337: 
 338: gate_end
 339: exit $?

