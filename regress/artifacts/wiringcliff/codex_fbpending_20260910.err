1120:     "artifacts/shortread/round_20260827/shortread_witness.py": (CLASS_WITNESS,
1121:                                     "#488 rung-3 on unmodified landisk: a guest READ SECTORS "
1122:                                     "reads 0x0000 where the disk holds 'B','B' on the committed "
1123:                                     "build AND on the rejected alternative, 0x4242 on the fix.  "
1124:                                     "Not gated: it needs a hand-built truncated overlay (a "
1125:                                     "200-byte data file plus a claiming .map) that no gate "
1126:                                     "constructs, and a witness is checked for the ABSENCE of a "
1127:                                     "gate call by design.  Preserved with all three transcripts."),
1128:     "gdrom_toclen_probe.py":       (CLASS_DETECTOR,
1129:                                     "#489 case 0x14 TOC length: a guest-supplied cnt is "
1130:                                     "DECLINED with a latched (once) diagnostic instead of "
1131:                                     "ending the host.  19 rows, gated in gate_sh_rounding.sh "
1132:                                     "with a literal denominator pin.  Every value the guard "
1133:                                     "refuses carries a DECLINE-CHANNEL row (bad/zero/over "
1134:                                     "cond) and so does the latched STATE (latch cond) -- four "
1135:                                     "measured escapes across three earlier row sets all had "
1136:                                     "the same shape: a survive-only row is vacuous here."),
1137:     "artifacts/wdcnoirq/witness_20260827/wdcnoirq_rung3_probe.py": (CLASS_WITNESS,
1138:                                     "#485 rung-3 witness, PRESERVED INTO THE REPO 2026-08-28.  "
1139:                                     "The ledger's witness field cited _scratchpad/witness485/ -- a "
1140:                                     "volatile path -- and the files were still there, so this is a "
1141:                                     "copy of a live witness rather than a reconstruction.  Its "
1142:                                     "pre/post rows and transcripts sit beside it.  Ungated by "
1143:                                     "design: a witness licenses a fix and is not a standing "
1144:                                     "detector; #485's standing coverage is its kill table."),
1145:     "artifacts/gdromexitsix/gdrom_toclen_witness.py": (CLASS_WITNESS,
1146:                                     "gdromexitsix rung-3 on the unmodified dreamcast machine: "
1147:                                     "nine guest accesses, cnt=407 and cnt=0 each end the host at "
1148:                                     "the case 0x14 TOC length guard (exit1), while cnt=408 "
1149:                                     "synthesizes a real TOC and survives.  MEASURED RED 8/8 on "
1150:                                     "the committed build before any edit to the site.  Not "
1151:                                     "gated, and a witness is checked for the ABSENCE of a gate "
1152:                                     "call by design -- its badlen/zerolen rows INVERT the day "
1153:                                     "the fix lands, so gating it manufactures a regression.  "
1154:                                     "Preserved under artifacts/ because this row's previous TWO "
