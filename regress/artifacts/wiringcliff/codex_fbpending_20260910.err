 211:     #  #493: the wdcaltoffset rung-3 witness.  A DURABLE, RE-RUNNABLE artifact for a
 212:     #  live sev-high defect whose two prior measurements could NOT be re-run -- #481
 213:     #  preserved 201 bytes of OUTPUT with no driver, and a later /tmp run was deleted
 214:     #  by its own script.  Preserved as EVIDENCE: it drives a real guest and is not
 215:     #  wired into a gate, so it is CLASS_RESEARCH rather than a detector owing one.
 216:     #  #494 ships TWO committed detectors.  The second is not a duplicate of the
 217:     #  first: the main probe observes DRQ and the input ring, and a mutant that
 218:     #  guards only the destructive call -- leaving `cur_command` clobbered --
 219:     #  passes all 18 of its rows.  The SIGNATURE probe reads the ATAPI signature
 220:     #  through cyl_lo/cyl_hi on a CD-ROM rig and is the ONLY instrument that sees
 221:     #  it.  Measured: m3 scored 0 red on the main detector and DEFECT PRESENT on
 222:     #  the signature one.
 223:     "wdc_altoffset_probe.py":
 224:         (CLASS_DETECTOR, "#494 wdc alt-ctrl offset decode -- DRQ/ring channels"),
 225:     "wdc_altoffset_sig_probe.py":
 226:         (CLASS_DETECTOR, "#494 wdc alt-ctrl offset decode -- ATAPI signature channel"),
 227:     #  The THIRD is not redundant either, and it was added to repair a MEASURED
 228:     #  floor breach found on pass 2.  The other two use only 0x06, 0x02 and 0x04 at
 229:     #  offset 1 -- all three with WDCTL_4BIT clear -- so every offset-1 row they
 230:     #  carry sits in ONE bit-3 equivalence class, and a guard reading
 231:     #  `!(idata & WDCTL_4BIT)` escaped BOTH at 36/36 and declined.  That bit is
 232:     #  libata's steady-state ap->ctl, so a mask guard re-opens the defect at exactly
 233:     #  the values the commonest driver writes.
 234:     "wdc_altoffset_4bit_probe.py":
 235:         (CLASS_DETECTOR, "#494 wdc alt-ctrl -- the WDCTL_4BIT mask-guard escape"),
 236:     #  #495.  THE FLOOR FORCED THIS ONE TO BE A DETECTOR RATHER THAN EVIDENCE: the
 237:     #  shipped 128-row offline detector scores ZERO failures with the defect LIVE,
 238:     #  so vacuity-floor clause (a) is unsatisfiable from any existing row.  This is
 239:     #  the only instrument that observes the defect at all, and it is COMPLEMENTARY
 240:     #  to diff_wdc_identify.c rather than a replacement -- each catches mutants the
 241:     #  other misses, measured.
 242:     "sgi_re_width_probe.py":
 243:         (CLASS_DETECTOR, "#497 sgi_re six-site width decline -- 35 rows, wired into gate_arm.sh"),
 244:     "wdc_addtoinbuf_probe.py":
 245:         (CLASS_DETECTOR, "#495 wdc ATAPI data-port write during DATA-IN -- rung-3"),
 246: 
 247:     #  m88kexcdeliver (#502) and lunaabsentcpu (#503), 2026-09-06: every .py these rounds preserved under
 248:     #  regress/artifacts/ is EVIDENCE -- frozen instruments beside their kill tables, the frozen mutant
 249:     #  generators and fix scripts, and the two measuring seats' own drivers.  Generated from this checker's
 250:     #  own UNCLASSIFIED list; one line per file, deliberately, as the pcc2 block above does.  The SHIPPED
 251:     #  detector m88k_exc_probe.py is the one entry here that is NOT evidence and is classified as a detector,
 252:     #  because the checker's own header warns that a detector misfiled as anything else silences the
 253:     #  requirement; its gate wiring is DERIVED below, not asserted here.
 254:     #  lcairqstubkill (2026-09-08): a WITNESS ATTEMPT, and it did NOT fire.  It is classified as
 255:     #  evidence rather than as a detector because that is what it is -- three controls green, the
 256:     #  assertion never reached the stub, and the round records it as an ATTEMPT rather than as a
 257:     #  negative result, because whether a debugger `put' reaches DEVICE_ACCESS(ns16550) at all is
 258:     #  still open.  A file that pins nothing must not be wired into a gate: it would be a green
 259:     #  row that means nothing, which is the vacuity this whole layer exists to refuse.
 260:     #  Not a probe of the emulator at all: it exercises the SHIPPED regex of
 261:     #  alpha_swpctx_v0_probe.py -- extracted from that file, not retyped -- against the three
 262:     #  synthetic transcripts a pass-3 seat used to measure three parser escapes.  Evidence that
 263:     #  the repair works, which is why it is preserved; it runs no emulator and gates nothing.
 264:     #  The ORDER half of the same evidence: anchoring fixed a response's SHAPE and could not fix
 265:     #  its ORDER, so a pass-4 seat reported two variants that still swept.  This exercises the
 266:     #  shipped `response_after' against both, and additionally shows the OLD count rule passing
 267:     #  them -- which is what makes it evidence rather than a green row.
 268:     #  The FULL escape corpus: all four variants reported across passes 4 and 5, run against the
 269:     #  shipped composed rule.  It exists because neither the positional nor the binding rule alone
 270:     #  was sufficient -- each let the other's escapes through -- so a test of either alone would
 271:     #  have been the green row that means nothing.
 272:     "artifacts/alphaswpctxreg/full_corpus.asrun.py":
 273:         (CLASS_RESEARCH, "alphaswpctxreg (#514) pass 5: all four reported escapes plus the genuine shape, against the SHIPPED composed rule -- 5/5, each rejection naming its own reason"),
