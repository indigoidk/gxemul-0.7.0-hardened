selfmutant_one diff_fbpending_bound.c src/devices/dev_footbridge.c fbpending_bound "R4 every case bounded" "-std=gnu99 -I../src/devices -Wl,--no-gc-sections $FBSMOBJS -L/usr/X11R6/lib -lX11"
