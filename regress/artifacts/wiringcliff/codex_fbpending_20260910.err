1128:     "gdrom_toclen_probe.py":       (CLASS_DETECTOR,
1129:                                     "#489 case 0x14 TOC length: a guest-supplied cnt is "
1130:                                     "DECLINED with a latched (once) diagnostic instead of "
1131:                                     "ending the host.  19 rows, gated in gate_sh_rounding.sh "
1132:                                     "with a literal denominator pin.  Every value the guard "
1133:                                     "refuses carries a DECLINE-CHANNEL row (bad/zero/over "
1134:                                     "cond) and so does the latched STATE (latch cond) -- four "
1135:                                     "measured escapes across three earlier row sets all had "
1136:                                     "the same shape: a survive-only row is vacuous here."),
1137:     "artifacts/wdcnoirq/witness_20260827/wdcnoirq_rung3_probe.py": (CLASS_WITNESS,
1138:                                     "#485 rung-3 witness, PRESERVED INTO THE REPO 2026-08-28.  "
1139:                                     "The ledger's witness field cited _scratchpad/witness485/ -- a "
