2879:/*
2880: *  Load linked / store conditional:
2881: *
2882: *  A Load-linked instruction initiates a RMW (read-modify-write) sequence.
2883: *  COP0_LLADDR is updated for diagnostic purposes, except for CPUs in the
2884: *  R10000 family.
2885: *
2886: *  A Store-conditional instruction ends the sequence.
2887: *
2888: *  arg[0] = ptr to rt
2889: *  arg[1] = ptr to rs
2890: *  arg[2] = int32_t imm
2891: */
2892:X(ll)
2893:{
2894:	MODE_int_t addr = reg(ic->arg[1]) + (int32_t)ic->arg[2];
2895:	int low_pc;
2896:	uint8_t word[sizeof(uint32_t)];
2897:
2898:	/*  Synch. PC and load using slow memory_rw():  */
2899:	low_pc = ((size_t)ic - (size_t)cpu->cd.mips.cur_ic_page)
2900:	    / sizeof(struct mips_instr_call);
2901:	cpu->pc &= ~((MIPS_IC_ENTRIES_PER_PAGE-1)
2902:	    << MIPS_INSTR_ALIGNMENT_SHIFT);
2903:	cpu->pc += (low_pc << MIPS_INSTR_ALIGNMENT_SHIFT);
2904:
2905:	if (addr & (sizeof(word)-1)) {
2906:		/*  #212: (Codex/Fable) an unaligned LL/LLD must raise AdEL, not
2907:		    exit() the host (PC already synced above).  */
2908:		mips_cpu_exception(cpu, EXCEPTION_ADEL, 0, addr, 0, 0, 0, 0);
2909:		return;
2910:	}
2911:
2912:	if (!cpu->memory_rw(cpu, cpu->mem, addr, word,
2913:	    sizeof(word), MEM_READ, CACHE_DATA)) {
2914:		/*  An exception occurred.  */
2915:		return;
2916:	}
2917:
2918:	cpu->cd.mips.rmw = 1;
2919:	cpu->cd.mips.rmw_addr = addr;
2920:	cpu->cd.mips.rmw_len = sizeof(word);
2921:	if (cpu->cd.mips.cpu_type.exc_model != MMU10K)
2922:		cpu->cd.mips.coproc[0]->reg[COP0_LLADDR] =
2923:		    (addr >> 4) & 0xffffffffULL;
2924:
2925:	if (cpu->byte_order == EMUL_LITTLE_ENDIAN)
2926:		reg(ic->arg[0]) = (int32_t) (word[0] + (word[1] << 8)
2927:		    + (word[2] << 16) + (word[3] << 24));
2928:	else
2929:		reg(ic->arg[0]) = (int32_t) (word[3] + (word[2] << 8)
2930:		    + (word[1] << 16) + (word[0] << 24));
2931:}
