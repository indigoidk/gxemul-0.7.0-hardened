2526:/*
2527: *  cop1_bc:  Floating point conditional branch.
2528: *
2529: *  arg[0] = cc
2530: *  arg[1] = nd (=2) and tf (=1) bits
2531: *  arg[2] = offset (relative to start of this page)
2532: */
2533:X(cop1_bc)
2534:{
2535:	MODE_int_t old_pc = cpu->pc;
2536:	int x, cc = ic->arg[0];
2537:
2538:	COPROC_AVAILABILITY_CHECK(1);
2539:
2540:	/*  Get the correct condition code bit:  */
2541:	if (cc == 0)
2542:		x = (cpu->cd.mips.coproc[1]->fcr[MIPS_FPU_FCSR]
2543:		    >> MIPS_FCSR_FCC0_SHIFT) & 1;
2544:	else
2545:		x = (cpu->cd.mips.coproc[1]->fcr[MIPS_FPU_FCSR]
2546:		    >> (MIPS_FCSR_FCC1_SHIFT + cc-1)) & 1;
2547:
2548:	/*  Branch on false? Then invert the truth value.  */
2549:	if (!(ic->arg[1] & 1))
2550:		x ^= 1;
2551:
2552:	/*  Execute the delay slot (except if it is nullified):  */
2553:	if (cpu->delay_slot & TO_BE_DELAYED) {
2554:		/*  This (delayed) branch is itself in another branch's delay slot
2555:		    (architecturally unpredictable on MIPS). Don't run it as a
2556:		    nested branch -- that corrupts next_ic; flag the outer branch
2557:		    so it does not apply its branch, and let the main loop re-run
2558:		    this instruction normally afterwards.  */
2559:		cpu->delay_slot |= EXCEPTION_IN_DELAY_SLOT;
2560:		return;
2561:	}
2562:	cpu->delay_slot = TO_BE_DELAYED;
2563:	if (x || !(ic->arg[1] & 2))
2564:		ic[1].f(cpu, ic+1);
2565:	cpu->n_translated_instrs ++;
2566:
2567:	if (!(cpu->delay_slot & EXCEPTION_IN_DELAY_SLOT)) {
2568:		/*  Note: Must be non-delayed when jumping to the new pc:  */
2569:		cpu->delay_slot = NOT_DELAYED;
2570:		if (x) {
2571:			old_pc &= ~((MIPS_IC_ENTRIES_PER_PAGE-1) <<
2572:			    MIPS_INSTR_ALIGNMENT_SHIFT);
2573:			cpu->pc = old_pc + (int32_t)ic->arg[2];
2574:			quick_pc_to_pointers(cpu);
2575:		} else
2583: *  cop1_slow:  Fallback to legacy cop1 code. (Slow, but it should work.)
2584: */
2585:X(cop1_slow)
