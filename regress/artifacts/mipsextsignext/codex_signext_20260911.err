116: *  invalid:  For catching bugs.
117: */
118:X(invalid)
119:{
120:	fatal("FATAL ERROR: An internal error occured in the MIPS"
121:	    " dyntrans code. Please contact the author with detailed"
122:	    " repro steps on how to trigger this bug.\n");
123:	exit(1);
124:}
