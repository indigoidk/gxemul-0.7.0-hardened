 616: #ifdef DYNTRANS_PC_TO_POINTERS_FUNC
 617: /*
 618:  *  XXX_pc_to_pointers_generic():
 619:  *
 620:  *  Generic case. See DYNTRANS_PC_TO_POINTERS_FUNC below.
 621:  */
 622: void DYNTRANS_PC_TO_POINTERS_GENERIC(struct cpu *cpu)
 623: {
 624: #ifdef MODE32
 625: 	uint32_t
 626: #else
 627: 	uint64_t
 628: #endif
 629: 	    cached_pc = cpu->pc, physaddr = 0;
 630: 	uint32_t physpage_ofs;
 631: 	int ok, pagenr, table_index;
 632: 	uint32_t *physpage_entryp;
 633: 	struct DYNTRANS_TC_PHYSPAGE *ppp;
 634: 
 635: #ifdef MODE32
 636: 	int index = DYNTRANS_ADDR_TO_PAGENR(cached_pc);
 637: #else
 638: 	const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
 639: 	const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
 640: 	const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
 641: 	uint32_t x1, x2, x3;
 642: 	struct DYNTRANS_L2_64_TABLE *l2;
 643: 	struct DYNTRANS_L3_64_TABLE *l3;
 644: 
 645: 	x1 = (cached_pc >> (64-DYNTRANS_L1N)) & mask1;
 646: 	x2 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
 647: 	x3 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N-DYNTRANS_L3N)) & mask3;
 648: 	/*  fatal("X3: cached_pc=%016" PRIx64" x1=%x x2=%x x3=%x\n",
 649: 	    (uint64_t)cached_pc, (int)x1, (int)x2, (int)x3);  */
 650: 	l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
 651: 	/*  fatal("  l2 = %p\n", l2);  */
 652: 	l3 = l2->l3[x2];
 653: 	/*  fatal("  l3 = %p\n", l3);  */
 654: #endif
 655: 
 656: 	/*  Virtual to physical address translation:  */
 657: 	ok = 0;
 658: #ifdef MODE32
 659: 	if (cpu->cd.DYNTRANS_ARCH.host_load[index] != NULL) {
 660: 		physaddr = cpu->cd.DYNTRANS_ARCH.phys_addr[index];
 661: 		ok = 1;
 662: 	}
 663: #else
 664: 	if (l3->host_load[x3] != NULL) {
 665: 		physaddr = l3->phys_addr[x3];
 666: 		ok = 1;
 667: 	}
 668: #endif
 669: 
 670: 	if (!ok) {
 671: 		uint64_t paddr;
 672: 		if (cpu->translate_v2p != NULL) {
 673: 			uint64_t vaddr =
 674: #if defined(MODE32) && defined(DYNTRANS_MIPS)
 675: 			/*  32-bit MIPS is _sign_ extend, not zero.  */
 676: 			    (int32_t)
 677: #endif
 678: 			    cached_pc;
 679: 			ok = cpu->translate_v2p(
 680: 			    cpu, vaddr, &paddr, FLAG_INSTR);
 681: 		} else {
 682: 			paddr = cached_pc;
 683: 			ok = 1;
 684: 		}
 685: 		if (!ok) {
 686: 			/*
 687: 			 *  The PC is now set to the exception handler.
 688: 			 *  Try to find the paddr in the translation arrays,
 689: 			 *  or if that fails, call translate_v2p for the
 690: 			 *  exception handler.
 691: 			 */
 692: 			/*  fatal("TODO: instruction vaddr=>paddr translation "
 693: 			    "failed. vaddr=0x%" PRIx64"\n", (uint64_t)cached_pc);
 694: 			fatal("!! cpu->pc=0x%" PRIx64"\n", (uint64_t)cpu->pc); */
 695: 
 696: 			/*  If there was an exception, the PC has changed.
 697: 			    Update cached_pc:  */
 698: 			cached_pc = cpu->pc;
 699: 
 700: #ifdef MODE32
 701: 			index = DYNTRANS_ADDR_TO_PAGENR(cached_pc);
 702: 			if (cpu->cd.DYNTRANS_ARCH.host_load[index] != NULL) {
 703: 				paddr = cpu->cd.DYNTRANS_ARCH.phys_addr[index];
 704: 				ok = 1;
 705: 			}
 706: #else
 707: 			x1 = (cached_pc >> (64-DYNTRANS_L1N)) & mask1;
 708: 			x2 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N))
 709: 			    & mask2;
 710: 			x3 = (cached_pc >> (64-DYNTRANS_L1N-DYNTRANS_L2N
 711: 			    - DYNTRANS_L3N)) & mask3;
 712: 			l2 = cpu->cd.DYNTRANS_ARCH.l1_64[x1];
 713: 			l3 = l2->l3[x2];
 714: 			if (l3->host_load[x3] != NULL) {
 715: 				paddr = l3->phys_addr[x3];
 716: 				ok = 1;
 717: 			}
 718: #endif
 719: 
 720: 			if (!ok) {
 721: 				ok = cpu->translate_v2p(cpu, cpu->pc, &paddr,
 722: 				    FLAG_INSTR);
 723: 			}
 724: 
 725: 			/*  printf("EXCEPTION HANDLER: vaddr = 0x%x ==> "
 726: 			    "paddr = 0x%x\n", (int)cpu->pc, (int)paddr);
 727: 			fatal("!? cpu->pc=0x%" PRIx64"\n", (uint64_t)cpu->pc); */
 728: 
 729: 			if (!ok) {
 730: 				fatal("FATAL: could not find physical"
 731: 				    " address of the exception handler?");
 732: 				exit(1);
 733: 			}
 734: 		}
 735: 
 736: 		physaddr = paddr;
 737: 	}
 738: 
 739: 	physaddr &= ~(DYNTRANS_PAGESIZE - 1);
 740: 
 741: #ifdef MODE32
 742: 	if (cpu->cd.DYNTRANS_ARCH.host_load[index] == NULL) {
 743: #else
 744: 	if (l3->host_load[x3] == NULL) {
 745: #endif
 746: 		int q = DYNTRANS_PAGESIZE - 1;
 747: 		unsigned char *host_page = memory_paddr_to_hostaddr(cpu->mem,
 748: 		    physaddr, MEM_READ);
 749: 		if (host_page != NULL) {
 750: 			cpu->update_translation_table(cpu, cached_pc & ~q,
 751: 			    host_page, 0, physaddr);
 752: 		}
 753: 	}
 754: 
 755: 	if (cpu->translation_cache_cur_ofs >= dyntrans_cache_size) {
 756: 		debugmsg(SUBSYS_CPU, "dyntrans", VERBOSITY_INFO,
 757: 		    "resetting the translation cache");
 758: 
 759: 		cpu_create_or_reset_tc(cpu);
 760: 	}
 761: 
 762: 	pagenr = DYNTRANS_ADDR_TO_PAGENR(physaddr);
 763: 	table_index = PAGENR_TO_TABLE_INDEX(pagenr);
 764: 
 765: 	physpage_entryp = &(((uint32_t *)cpu->translation_cache)[table_index]);
 766: 	physpage_ofs = *physpage_entryp;
 767: 	ppp = NULL;
 768: 
 769: 	/*  Traverse the physical page chain:  */
 770: 	while (physpage_ofs != 0) {
 771: 		ppp = (struct DYNTRANS_TC_PHYSPAGE *)(cpu->translation_cache
 772: 		    + physpage_ofs);
 773: 
 774: 		/*  If we found the page in the cache, then we're done:  */
 775: 		if (ppp->physaddr == physaddr)
 776: 			break;
 777: 
 778: 		/*  Try the next page in the chain:  */
 779: 		physpage_ofs = ppp->next_ofs;
 780: 	}
 781: 
 782: 	/*
 783: 	 *  If the offset is 0, then no translation exists yet for this
 784: 	 *  physical address. Let's create a new page, and add it first in
 785: 	 *  the chain.
 786: 	 */
 787: 	if (physpage_ofs == 0) {
 788: 		uint32_t previous_first_page_in_chain;
 789: 
 790: 		/*  fatal("CREATING page %lli (physaddr 0x%" PRIx64"), table "
 791: 		    "index %i\n", (long long)pagenr, (uint64_t)physaddr,
 792: 		    (int)table_index);  */
 793: 
 794: 		previous_first_page_in_chain = *physpage_entryp;
 795: 
 796: 		/*  Insert the new page first in the chain:  */
 797: 		*physpage_entryp = physpage_ofs =
 798: 		    cpu->translation_cache_cur_ofs;
 799: 
 800: 		/*  Allocate a default page, with to_be_translated entries:  */
 801: 		DYNTRANS_TC_ALLOCATE(cpu, physaddr);
 802: 
 803: 		ppp = (struct DYNTRANS_TC_PHYSPAGE *)(cpu->translation_cache
 804: 		    + physpage_ofs);
 805: 
 806: 		/*  Point to the other pages in the same chain:  */
 807: 		ppp->next_ofs = previous_first_page_in_chain;
 808: 	}
 809: 
 810: 	/*  Here, ppp points to a valid physical page struct.  */
 811: 
 812: #ifdef MODE32
 813: 	if (cpu->cd.DYNTRANS_ARCH.host_load[index] != NULL)
 814: 		cpu->cd.DYNTRANS_ARCH.phys_page[index] = ppp;
 815: #else
 816: 	if (l3->host_load[x3] != NULL)
 817: 		l3->phys_page[x3] = ppp;
 818: #endif
 819: 
 820: 	/*
 821: 	 *  If there are no translations yet on this page, then mark it
 822: 	 *  as non-writable. If there are already translations, then it
 823: 	 *  should already have been marked as non-writable.
 824: 	 */
 825: 	if (ppp->translations_bitmap == 0) {
 826: 		cpu->invalidate_translation_caches(cpu, physaddr,
 827: 		    JUST_MARK_AS_NON_WRITABLE | INVALIDATE_PADDR);
 828: 	}
 829: 
 830: 	cpu->cd.DYNTRANS_ARCH.cur_ic_page = &ppp->ics[0];
 831: 
 832: 	cpu->cd.DYNTRANS_ARCH.next_ic = cpu->cd.DYNTRANS_ARCH.cur_ic_page +
 833: 	    DYNTRANS_PC_TO_IC_ENTRY(cached_pc);
 834: 
 835: 	/*  printf("cached_pc=0x%016" PRIx64"  pagenr=%lli  table_index=%lli, "
 836: 	    "physpage_ofs=0x%016" PRIx64"\n", (uint64_t)cached_pc, (long long)
 837: 	    pagenr, (long long)table_index, (uint64_t)physpage_ofs);  */
 838: }
