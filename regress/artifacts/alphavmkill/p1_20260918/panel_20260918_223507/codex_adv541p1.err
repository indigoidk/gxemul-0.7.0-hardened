 586: /*
 587:  *  XXX_tc_allocate_default_page():
 588:  *
 589:  *  Create a default page (with just pointers to instr(to_be_translated)
 590:  *  at cpu->translation_cache_cur_ofs.
 591:  */
 592: static void DYNTRANS_TC_ALLOCATE_DEFAULT_PAGE_DEF(struct cpu *cpu,
 593: 	uint64_t physaddr)
 594: { 
 595: 	struct DYNTRANS_TC_PHYSPAGE *ppp;
 596: 
 597: 	ppp = (struct DYNTRANS_TC_PHYSPAGE *)(cpu->translation_cache
 598: 	    + cpu->translation_cache_cur_ofs);
 599: 
 600: 	/*  Copy the entire template page first:  */
 601: 	memcpy(ppp, cpu->cd.DYNTRANS_ARCH.physpage_template, sizeof(
 602: 	    struct DYNTRANS_TC_PHYSPAGE));
 603: 
 604: 	ppp->physaddr = physaddr & ~(DYNTRANS_PAGESIZE - 1);
 605: 
 606: 	cpu->translation_cache_cur_ofs += sizeof(struct DYNTRANS_TC_PHYSPAGE);
 607: 
 608: 	cpu->translation_cache_cur_ofs --;
 609: 	cpu->translation_cache_cur_ofs |= 63;
 610: 	cpu->translation_cache_cur_ofs ++;
 611: }
 612: #endif	/*  DYNTRANS_TC_ALLOCATE_DEFAULT_PAGE_DEF  */
