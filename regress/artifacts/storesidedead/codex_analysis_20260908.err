648:          "r1=0x%x" % (SH4_PCIC + 0x014), "r5=0x%x" % (SH4_PCIC + 0x015),
649:          "r3=0x%x" % DEST]
650:         + poke([0x2102, 0x2540, 0x2540, 0x6212, 0x2322]) + ["pc=0x%x" % CODE],
