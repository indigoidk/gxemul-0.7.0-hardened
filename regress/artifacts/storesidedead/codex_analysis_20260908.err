        | CHCR_TS_4BYTE | CHCR_TD,
        0x300 | CHCR_DM_INCREMENTED | CHCR_SM_INCREMENTED | CHCR_TS_4BYTE | CHCR_TD,
        SH4_CHCR0, "L2")
    d = diags(buf)
