220:     reached the debugger prompt ALSO reports alive=False, and scoring that as
221:     "the guest access killed the host" would let a broken invocation -- missing
222:     binary, missing image, host out of memory -- masquerade as a measurement.
223:     P0 requires started of every session this run ever opened.
224:     """
225:     pid, fd = pty.fork()
226:     if pid == 0:
227:         argv = [binary, "-V", "-E", "landisk", "-M", "64"] + (extra or []) \
228:                + [kernel]
229:         try:
230:             os.execvp(binary, argv)
231:         except Exception:
232:             pass
233:         os._exit(127)
234:     buf = ""
235:     died = [False]
236: 
237:     def rd(t=0.4):
238:         nonlocal buf
239:         r, _, _ = select.select([fd], [], [], t)
240:         if fd not in r:
241:             return True
242:         try:
243:             d = os.read(fd, 65536)
244:         except OSError:
245:             died[0] = True
246:             return False
247:         if not d:
248:             died[0] = True
249:             return False
250:         buf += d.decode("latin1", "replace")
251:         return True
252: 
253:     def wait(mark=0, echo=None, timeout=timeout):
254:         t = time.time()
255:         while time.time() - t < timeout:
256:             if not rd():
257:                 return False
258:             resp = buf[mark:]
259:             if echo is not None and echo not in resp:
260:                 continue
261:             if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
262:                 return True
263:         return False
264: 
265:     def send(s):
266:         #  `_mark`, not `mark`: gate 6's fresh-mark census keys on that exact
267:         #  spelling, and every other pty probe in the tree writes it that way.
268:         b = (s + "\n").encode("latin1")
269:         _mark = len(buf)
270:         n = 0
271:         while n < len(b):
272:             try:
273:                 n += os.write(fd, b[n:])
274:             except OSError:
275:                 died[0] = True
276:                 return False
277:         return wait(mark=_mark, echo=s if s else None)
278: 
279:     started = wait(timeout=120)
280:     STARTS.append((label, started))
281:     if not started:
282:         for fn in (lambda: os.kill(pid, 9), lambda: os.waitpid(pid, 0)):
283:             try:
284:                 fn()
285:             except Exception:
286:                 pass
287:         return buf, False, False
288: 
289:     for c in cmds:
290:         send(c)
291: 
292:     if disasm_upto:
293:         _m = len(buf)
294:         send("unassemble 0x%x 0x%x" % (CODE, CODE + disasm_upto))
295:         for w, txt in re.findall(
296:                 r"^[0-9a-f]{8}:\s+([0-9a-f]{4})\s+(?:<-\s+)?(\S.*?)\s*$",
297:                 buf[_m:].replace("\r", ""), re.M):
298:             DISASM.setdefault(int(w, 16),
299:                               re.sub(r"\s+", " ", txt.split(";")[0]).strip())
300: 
301:     if nstep:
302:         send("step %d" % nstep)
303: 
304:     #  Liveness of the SESSION after the step: a dump that answers proves the
305:     #  host process is alive; no answer plus a closed pty proves it is not.
306:     alive = False
307:     for _ in range(3):
308:         _m = len(buf)
309:         if send("dump 0x%x 0x%x" % (DEST, DEST + 16)):
310:             if re.search(r"0x0*[0-9a-f]+\s+[0-9a-f]{8}", buf[_m:]):
311:                 alive = True
312:                 break
313:         if died[0]:
314:             break
315:         time.sleep(0.3)
316:         rd(0.3)
317:     try:
318:         os.write(fd, b"quit\n")
319:     except OSError:
320:         pass
321:     t = time.time()
322:     while time.time() - t < 4 and rd(0.3):
323:         pass
324:     for fn in (lambda: os.kill(pid, 9), lambda: os.waitpid(pid, 0)):
325:         try:
326:             fn()
327:         except Exception:
328:             pass
329:     return buf, alive, True
