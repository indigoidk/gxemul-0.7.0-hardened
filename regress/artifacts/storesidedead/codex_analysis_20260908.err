622:     sw1 = sweep(1)
623:     bad16 = armbad(sw1)
624:     row("P16 ALL %d guarded arms: ONE rejected write does not persist"
625:         % len(RESTORE_ARMS),
626:         bad16 == [],
627:         "failed=%d %s" % (len(bad16), bad16[:3]),
628:         "every arm reads its own accepted value back through the guest -- P3 "
629:         "covered ONE of the ten restores and P3b a second")
630: 
631:     sw2 = sweep(2)
632:     bad17 = armbad(sw2)
633:     noisy = sorted(RESTORE_ARMS[o][0] for o in sorted(RESTORE_ARMS)
634:                    if sw2.get(o, (0, 0, 0, 0))[3] != 1)
635:     row("P17 ALL %d guarded arms: a SECOND rejected write does not persist "
636:         "either" % len(RESTORE_ARMS),
637:         bad17 == [],
638:         "failed=%d %s (latched-lines != 1 at %s)"
639:         % (len(bad17), bad17[:3], noisy),
640:         "the restore is OUTSIDE the latch.  Braced inside it the first offence "
641:         "is still restored and every later one is not")
