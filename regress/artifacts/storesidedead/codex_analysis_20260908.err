    print("  %d sessions, elapsed %.0f s" % (n_ses, time.time() - t_all))
    print("SH4_VAL_RESULT=%d/%d" % (len(rows) - fails, len(rows)))
    print("SH4_VAL_PASS" if fails == 0 else "SH4_VAL_FAIL")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())


