    + ["r1=0x%x" % (DMA + 0x18), "r2=0"]
    + run([MOV_L_AT_R1_R2], CODE + 0x180)
    + ["r1=0x%x" % SYSASIC_PEND, "r3=0"]
    + run([MOV_L_AT_R1_R3], CODE + 0x1a0)
