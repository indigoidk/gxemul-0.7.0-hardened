    return [LDRD_R0_PC_40, SPIN]


def swp_prog():
    return BUILD_R1_5567 + [MOV_R0_COLD, SWP_R2_R1_R0] + list(LDRB) + [SPIN]


def swpb_prog():
    return BUILD_R1_5567 + [MOV_R0_COLD, SWPB_R2_R1_R0, LDRB[0]] + [SPIN]


def swp_unal_prog():
