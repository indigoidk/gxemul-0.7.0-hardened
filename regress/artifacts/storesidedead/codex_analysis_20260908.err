FILE pcc2_default_probe.py
117: Usage: python3 pcc2_default_probe.py <gxemul> <label>      Sentinel: PCC2D_PROBE_DONE
118: The pty session helper is the width probe's own (extracted at run time), never hand-rolled: a first
119: draft of the witness hand-rolled it and read every host kill as "survived".
120: """
121: import io, os, pty, re, select, sys, time
122: BIN = sys.argv[1] if len(sys.argv) > 1 else "build/gxemul"
123: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
124: DUMMY = "/tmp/pcc2_dummy.bin"
125: if not os.path.exists(DUMMY):
126:     open(DUMMY, "wb").write(b"\0" * 4096)
127: HERE = os.path.dirname(os.path.abspath(__file__))
128: _w = io.open(os.path.join(HERE, "pcc2_width_probe.py"), encoding="utf-8").read()
129: exec(_w[_w.index("def session("):_w.index("\ndef printed")])     # session(cmds) -> (transcript, alive, how)
131: CODE, SCRATCH, PCC2, SENTINEL = 0x00010000, 0x00020000, 0xfff42000, 0xdeadbeef
132: CHIPID, GENCTL, T1CMP, SCCERR = 0x00, 0x02, 0x04, 0x1c
133: IEERR, IEICR, IEBERR, SCCTXIACK, PRTICR = 0x28, 0x2a, 0x2b, 0x25, 0x30
134: NAMED18 = [0x14, 0x18, 0x19, 0x23, 0x25, 0x28, 0x2a, 0x2b, 0x2c, 0x30, 0x31, 0x32, 0x33, 0x34, 0x36, 0x37, 0x38, 0x3a]
135: INWORD = [0x05, 0x06, 0x07, 0x09, 0x0a, 0x0b, 0x0d, 0x0e, 0x0f, 0x11, 0x12, 0x13]   # all 12 counter interiors
136: UNNAMED = [0x20, 0x21, 0x22, 0x24, 0x26, 0x29, 0x2d, 0x2e, 0x35, 0x39, 0x3b, 0x3c, 0x3d]   # all 13 the fork header leaves unnamed
137: assert len(NAMED18) + len(INWORD) + len(UNNAMED) == 43 and len(set(NAMED18 + INWORD + UNNAMED)) == 43
138: MSG = "pcc2: unimplemented"
139: def enc(op26, rd, rs1, imm): return (op26 << 26) | (rd << 21) | (rs1 << 16) | (imm & 0xffff)
140: def LD_BU(rd, off): return enc(0x03, rd, 2, off)
141: def LD_W(rd, off): return enc(0x05, rd, 2, off)
142: def ST_B(rs, off): return enc(0x0b, rs, 2, off)
143: def ST_W(rs, off): return enc(0x09, rs, 2, off)
144: def LD_HU(rd, off): return enc(0x02, rd, 2, off)   # pass 3: a len-2 default read
145: def ST_H(rs, off): return enc(0x0a, rs, 2, off)    # pass 3: a len-2 default write
146: I_ST_SCR = enc(0x09, 5, 3, 0); I_LD_SCR = enc(0x05, 4, 3, 0); I_BR_SELF = 0xc0000000
147: def program(insns, at=CODE):
148:     words = list(insns) + [I_BR_SELF, 0]
149:     return ["put w 0x%x, 0x%08x" % (at + 4 * k, w) for k, w in enumerate(words)] + ["pc=0x%x" % at, "step %d" % len(insns)]
150: def setup(r5="0x5a5a5a5a"):
151:     return ["r2=0x%x" % PCC2, "r3=0x%x" % SCRATCH, "r5=%s" % r5, "r4=0x%x" % SENTINEL]
152: def printed(t, reg="r4"):
153:     m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
154:     return "0x%x" % int(m.group(1), 16) if m else "absent"
155: def fate(alive, how): return "survived" if alive else "host " + how
156: def val(t, alive, how): return printed(t) if alive else fate(alive, how)
157: rows, bad = [], []
158: def row(name, got, want, why):
159:     ok = str(got) == str(want)
160:     rows.append(name); (None if ok else bad.append(name))
