        def one(spec):
            off, wr = spec
            if wr:
                _b, al, st = write_arm(SH4_PCIC + off, 0xdeadbeef,
                                       "cw%03x" % off, kw)
            else:
                _b, al, st = read_arm(SH4_PCIC + off, "cr%03x" % off, kw)
            return (off, wr, al, st)

        specs = [(o, w) for w in (0, 1) for o in offs]
        t0 = time.time()
