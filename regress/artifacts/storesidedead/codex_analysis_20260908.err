529:     #  Nothing on that path may write ANY dma state: SAR, DAR, DMATCR and CHCR are all
530:     #  read-only there, checked line by line.
531:     for nm, addr, want in [("CHCR", SH4_CHCR0, x),
532:                            ("DMATCR", SH4_DMATCR0, 0x00000042),
533:                            ("SAR", SH4_SAR0, 0x0c001000),
534:                            ("DAR", SH4_DAR0, 0x0c002000)]:
535:         b2, a2, s2 = arm_then_read(x, addr, "X2" + nm, kw)
536:         got = P.dumped(b2)
537:         row("X2 %s still holds the value the guest armed it with (0x%08x)" % (nm, want),
538:             s2 and a2 and got == P.le(want),
539:             "%s readback=%s want=%s" % (nm, got, P.le(want)),
540:             "the declined path writes NOTHING -- SAR, DAR, DMATCR and CHCR are all "
541:             "read-only there.  Each is armed with a DISTINCT NON-RESET value first, "
542:             "because an earlier draft checked for 0 and a mutant that zeroes them passed "
543:             "at 24/24: 0 is also the reset value, so the row could not fail")
544: 
545:     #  ---- X3: the same request TWICE -- the latch, and the third round to need this ----
546:     #  X1 stores once, so an UNLATCHED fatal() is invisible to it: one store, one line,
547:     #  either way.  MEASURED as a survivor at 24/24 before this row existed.  #451 and
548:     #  #452 each learned the same thing about their own detectors; a latched diagnostic
549:     #  needs a repeat row or the latch is untested.
550:     buf3, alive3, st3 = two_stores(x, x, SH4_CHCR0, "X3")
551:     d3 = IE_RE.findall(buf3 or "")
552:     row("X3 the SAME declined request twice -- ONE line, still naming channel 0",
553:         st3 and alive3 and d3 == ["0"],
554:         "alive=%s lines=%d %s" % (alive3, len(d3), d3),
555:         "one line for two identical requests.  Two means the guard is gone and a guest "
556:         "looping on a legal DMA draws an unsilenceable line per store, which fatal() "
557:         "cannot be quieted out of")
