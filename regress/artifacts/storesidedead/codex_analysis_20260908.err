        ("A cclean2 tail r0", _t2[0] if _t2 else None, 0x9140, "PIN"),
        ("A cclean2 tail r1", _t2[1] if _t2 else None, 0xfffffff0, "PIN"),
        ("A cclean2 tail V", (_tv[4] & 0xf0000000) if _tv else None,
