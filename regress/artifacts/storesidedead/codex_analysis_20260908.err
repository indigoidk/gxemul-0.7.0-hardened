_g2, _g2buf = run_cc2("genuine", seed=CMP_R9_HI)
_b2, _ = run_cc2("wrongbase")
_n2, _ = run_cc2("wrongcnt")
_t2, _ = run_cc2("borrow", seed=CMP_R9_1)
_tv, _ = run_cc2("borrow", seed=CMP_R9_HI)
_z2, _ = run_cc2("zero", seed=CMP_R9_1)
