v0, v1, a0, a1, a2, a3 = W.v0, W.v1, W.a0, W.a1, W.a2, W.a3
s0, s1, s2, s3 = W.s0, W.s1, W.s2, W.s3

W.emit(W.lui(t0, W.WDC_HI), "lui t0,0xb800")
