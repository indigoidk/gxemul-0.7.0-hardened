  wd_command(7) <- 0xa0   wdc_command() ATAPI_PKT_CMD arm: sets
                          atapi_cmd_in_progress=1, atapi_phase=PHASE_CMDOUT.
  wd_data(0)   <- 12 CDB bytes (READ(10), LBA 0, 128 blocks -- see READ_BLOCKS
