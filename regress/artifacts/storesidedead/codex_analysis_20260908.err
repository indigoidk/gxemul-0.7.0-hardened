        if any(not is_path_like(v) for _, v in info["irqs"]):
            bad_irq.append(prim)
        if da:
            adders.append(prim)
            if siu_form(info["code"]) != "plain":
                no_siu.append((prim, siu_form(info["code"])))
            if vr and min(da) < min(vr):
