         "r0=0x%x" % RTCSR_CMIE, "r1=0x%x" % SH4_RTCSR, "r3=0x%x" % P.DEST]
        + P.poke([0x2101, 0x6211, 0x2322, 0x0009]) + ["pc=0x%x" % P.CODE],
