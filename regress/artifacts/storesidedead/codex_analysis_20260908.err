145: def build(base):
146:     """The identical sequence, parameterised only by the DESTINATION base."""
147:     p  = load_const(T0, SCRATCH)
148:     p += [LDQ(T1, 0, T0), LDQ(T2, 8, T0), LDQ(T3, 16, T0)]
149:     p += [LDA(T4, IER_ETXRDY),  STB(T4, 0, T1)]     # IER  = enable tx-empty interrupt
150:     p += [LDA(T4, MCR_IENABLE), STB(T4, 0, T2)]     # MCR  = OUT2, gates the assert
151:     p += [LDA(T4, ANY_BYTE),    STB(T4, 0, T3)]     # THR  -> sets IIR_TXRDY
152:     p += [SELFBR]                                    # free-run so DEVICE_TICK is reached
153:     setup = ["put d 0x%x, 0x%x" % (SCRATCH + 0,  k0(base + 1)),   # IER
154:              "put d 0x%x, 0x%x" % (SCRATCH + 8,  k0(base + 4)),   # MCR
155:              "put d 0x%x, 0x%x" % (SCRATCH + 16, k0(base + 0))]   # THR
156:     cmds = setup + ["put w 0x%x, 0x%08x" % (k0(CODE) + 4 * i, op)
157:                     for i, op in enumerate(p)]
158:     return cmds + ["pc=0x%x" % k0(CODE), "continue"]
