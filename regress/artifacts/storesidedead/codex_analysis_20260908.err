524: 
525:     # ================================================== P3  THE CENTRAL ROW
526:     #  Accept 0xac000000 (dev_sh4.c:931), then offer 0x12345678, then READ THE
527:     #  REGISTER BACK through the guest.  The store at dev_sh4.c:877 has already
528:     #  happened by the time the guard runs, so without the restore at :937 the
529:     #  guest reads its own rejected value back and the device has told it a lie
530:     #  it will act on.  A "fix" that only deletes exit(1) fails HERE and
531:     #  nowhere else in this file.
532:     buf, alive, st = session(
533:         ["put w 0x%x, 0x%08x" % (DEST, POISON), "r0=0xac000000",
534:          "r4=0x12345678", "r1=0x%x" % (SH4_PCIC + 0x014), "r3=0x%x" % DEST]
535:         + poke([0x2102, 0x2142, 0x6212, 0x2322]) + ["pc=0x%x" % CODE], 4,
536:         "P3", disasm_upto=8, **kw)
537:     p3 = dumped(buf)
538:     p3msg = buf or ""
539:     row("P3 *** A REJECTED WRITE DOES NOT PERSIST *** (PCICONF5, read back "
540:         "through the guest)",
541:         st and alive and p3 == le(0xac000000),
542:         "started=%s alive=%s val=%s" % (st, alive, p3),
543:         "val=%s -- the accepted value survives.  Deleting exit(1) alone gives "
544:         "%s: silent state corruption, strictly worse than the host kill it "
545:         "replaced" % (le(0xac000000), le(0x12345678)))
546:     row("P3a the rejection was DIAGNOSED (a silent drop is not the fix either)",
547:         "SH4_PCICONF5 unknown value 0x12345678" in p3msg and LATCHED in p3msg,
548:         "msg=%s latched=%s"
549:         % ("SH4_PCICONF5 unknown value 0x12345678" in p3msg, LATCHED in p3msg),
550:         "both True")
551: 
552:     #  P3b: the same property in the `default:` arm, where it is otherwise
553:     #  invisible -- see the module docstring.  A BYTE store to 0xfe200015 hits
554:     #  `default:` and clobbers PCICONF5's whole word on the way in; only the
555:     #  restore at dev_sh4.c:1060 puts it back.
556:     buf, alive, st = session(
557:         ["put w 0x%x, 0x%08x" % (DEST, POISON), "r0=0xac000000", "r4=0xff",
558:          "r1=0x%x" % (SH4_PCIC + 0x014), "r5=0x%x" % (SH4_PCIC + 0x015),
559:          "r3=0x%x" % DEST]
560:         + poke([0x2102, 0x2540, 0x6212, 0x2322]) + ["pc=0x%x" % CODE], 4,
561:         "P3b", disasm_upto=8, **kw)
562:     p3b = dumped(buf)
563:     p3bmsg = buf or ""
564:     row("P3b a dropped `default:` write does not persist either (byte alias "
565:         "0xfe200015 into PCICONF5's slot)",
566:         st and alive and p3b == le(0xac000000)
567:         and "write to unimplemented addr 0xfe200015: 0xff" in p3bmsg,
568:         "started=%s alive=%s val=%s msg=%s"
569:         % (st, alive, p3b,
570:            "write to unimplemented addr 0xfe200015: 0xff" in p3bmsg),
571:         "val=%s -- without the restore the byte store leaves %s in PCICONF5"
572:         % (le(0xac000000), le(0xff)))
573: 
574:     # ================================= P16 / P17  EVERY RESTORE, BOTH OFFENCES
575:     #  Ten arms restore `pcic_old`; until P16 this file observed exactly TWO of
576:     #  them (P3 = PCICONF5, P3b = `default:`), so deleting any one of the other
577:     #  eight was MEASURED to pass all 29 rows -- PCIMBR among them, where the
578:     #  guest then reads its own rejected 0x12345678 back out of a register the
579:     #  round claims is pinned to 0xfd000000.
580:     #
581:     #  P17 is the other half, and it is a DIFFERENT defect rather than more of
582:     #  the same one.  The restore has to sit OUTSIDE the `sh4_pcic_first()`
583:     #  latch.  Bracing it inside is a BRACE SLIP -- the shape a later tidy-up
584:     #  produces -- and it still restores the FIRST offence, so it passes P3,
585:     #  P3b and P16 while re-opening silent corruption on every offence after
586:     #  that.  MEASURED at 29/29 against the previous file, all ten arms.
587:     def offence(off, ntimes):
588:         good = RESTORE_ARMS[off][1]
589:         body = [0x2102] + [0x2142] * ntimes + [0x6212, 0x2322]
590:         b, al, s = session(
591:             ["put w 0x%x, 0x%08x" % (DEST, POISON), "r0=0x%08x" % good,
592:              "r4=0x%08x" % REJECT, "r1=0x%x" % (SH4_PCIC + off),
593:              "r3=0x%x" % DEST]
594:             + poke(body) + ["pc=0x%x" % CODE], len(body),
595:             "o%d%03x" % (ntimes, off), disasm_upto=2 * len(body), **kw)
596:         return off, al, s, dumped(b), (b or "").count(LATCHED)
597: 
598:     def sweep(ntimes):
599:         out = {}
600:         with ThreadPoolExecutor(max_workers=max(1, a.jobs)) as ex:
601:             for off, al, s, v, nl in ex.map(lambda o: offence(o, ntimes),
602:                                             sorted(RESTORE_ARMS)):
603:                 out[off] = (al, s, v, nl)
604:         return out
605: 
606:     def armbad(d):
607:         """The arms that did NOT read their own accepted value back.
608: 
609:         `.get(..., (False, ...))` defaults to DEAD, so a MISSING measurement
610:         can only ever turn the row red: absent data must not be able to
611:         manufacture a survivor.
612:         """
613:         bad = []
614:         for o in sorted(RESTORE_ARMS):
615:             al, s, v, _ = d.get(o, (False, False, None, 0))
616:             if not (s and al and v == le(RESTORE_ARMS[o][1])):
617:                 bad.append("%s(0x%03x) started=%s alive=%s val=%s want=%s"
618:                            % (RESTORE_ARMS[o][0], o, s, al, v,
619:                               le(RESTORE_ARMS[o][1])))
620:         return bad
