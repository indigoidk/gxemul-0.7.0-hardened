    c += store(A, DE_XVERTEX_1,  0x00000003)           # (x2,y2) = (0,3): 4 pixels, all at ofs 0
    c += store(A, DE_PRIM_START, PRIM_RECT)            # PRIMITIVE|START fires the draw
    return c

