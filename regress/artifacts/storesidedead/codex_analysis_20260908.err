     ["fpscr=0x00140001", "r1=0x%x" % DEST, "fr0=0x11111111", "fr1=0x22222222",
      "put w 0x%x, 0xdeadbeef" % DEST, "put w 0x%x, 0xdeadbeef" % (DEST + 4),
      "put h 0x%x, 0xf10a" % CODE, "pc=0x%x" % CODE, "step 1"],
