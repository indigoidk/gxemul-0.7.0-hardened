import os
import sys
import time

OUTDIR = sys.argv[1]
DISK = sys.argv[2]
LEGS = [a.split("=", 1) for a in sys.argv[3:]]

HERE = os.path.dirname(os.path.abspath(__file__))
WIT = HERE                       # the COMMITTED detector, not the frozen witness copy
