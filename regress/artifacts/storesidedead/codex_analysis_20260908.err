    + run([MOV_L_R8_AT_R7], CODE + 0x100)
    + ["r7=0x%x" % (DMA + 0x0c), "r8=1"]
    + run([MOV_L_R8_AT_R7], CODE + 0x120)
    + ["r7=0x%x" % (DMA + 0x14), "r8=1"]
    + run([MOV_L_R8_AT_R7], CODE + 0x140)
