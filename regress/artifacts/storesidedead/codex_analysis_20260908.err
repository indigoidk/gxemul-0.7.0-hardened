#  only the write arm passes every write-side row.
buf, alive = session(
    ["r0=0x3ffd", "r1=0x%x" % BCR2, "r3=0x%x" % DEST,
     "put w 0x%x, 0x11111111" % DEST]
    + poke(CODE, [MOV_W_R0_AT_R1, MOV_L_AT_R1_R2, MOV_L_R2_AT_R3]), 3)
d2 = dumped(buf)
