278: def testsh_deliver(imask):
279:     """Free-run one IPI store with SR.IMASK set, and see whether the vector is reached.
281:     `imask` is what brackets the priority.  Delivery needs `IMASK < int_level`
282:     (cpu_dyntrans.c), so a line at level 1 is admitted at IMASK 0 and refused at
283:     IMASK 1.  Running BOTH pins the level to exactly 1 -- which is the whole point,
284:     because a witness that only asks "did something deliver" is passed by any of
285:     IRQ0..IRQ13.  That mutant was built and measured escaping before these rows
286:     existed.
287:     """
288:     return ["put h 0x%x, 0x0009" % TESTSH_HANDLER,          # nop, so the fetch works
289:             "put h 0x%x, 0xaffe" % (TESTSH_HANDLER + 2),    # bra .
290:             "put h 0x%x, 0x0009" % (TESTSH_HANDLER + 4),    # nop (delay slot)
291:             "r0=0x00000000", "r1=0x%x" % IPI,
292:             "put h 0x%x, 0x%04x" % (CODE, MOV_L_R0_AT_R1),  # mov.l r0,@r1  (the IPI)
293:             "put h 0x%x, 0xaffe" % (CODE + 2),              # bra .  -- park here if
294:             "put h 0x%x, 0x0009" % (CODE + 4),              # nothing is delivered
295:             "pc=0x%x" % CODE,
296:             "sr=0x%08x" % (0x40000000 | (imask << 4)),      # MD=1, BL=0, IMASK=imask
297:             "vbr=0x%x" % TESTSH_VBR,
298:             "breakpoint add 0x%x" % TESTSH_HANDLER]
