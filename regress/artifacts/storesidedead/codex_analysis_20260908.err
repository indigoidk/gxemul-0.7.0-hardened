t, alive, how = session(stage_toc(A, 408) +
                        ["r1=0x%x" % GDROM_DATA, "r2=0", "r3=0"] +
                        run([MOVW_LD(2, 1), MOVW_LD(3, 1)], A.take()) +
                        ["print r2", "print r3"])
