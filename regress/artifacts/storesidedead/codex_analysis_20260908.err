            for i, w in enumerate(m.group(2).split()):
                out[base + 4 * i] = struct.unpack("<I", struct.pack(">I", int(w, 16)))[0]
        vals = [out.get(addr + 4 * i) for i in range(n)]
        return None if any(v is None for v in vals) else vals

