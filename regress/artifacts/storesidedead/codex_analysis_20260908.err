             "put h 0x%x, 0x%04x" % (CODE + 0, 0x6212),
             "put h 0x%x, 0x%04x" % (CODE + 2, 0x2322),
             "r1=0x%x" % (SH4_PCIC + 0x00c), "r3=0x%x" % DEST,
             "sr=0x00000000", "pc=0x%x" % CODE], 2, "C7", disasm_upto=4, **kw)
        c7 = dumped(buf)
