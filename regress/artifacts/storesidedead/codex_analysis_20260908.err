20: a repaired access from one that merely stopped faulting: replacing exit(1) with `return 1`
21: while dropping the write-back would leave the guest with garbage and the row green.  So the
22: first row READS CMMU_IDR back into r4 and asserts 0x00a90000 -- the 88200 rev-9 id seeded by
23: dev_luna88k.c:901, a value that can only have come through this device.
24: 
25: Cold debugger on luna-88k, no boot.  r5 = 0xFFF06000 = CMMU_D0 (luna88k_board.h:163).
26: 
27: Encodings read off the disassembler, not memory (cpu_m88k.c:991-1019):
28:     ld rD,rS1,IMM16  op26 = 0x05   iw = 0x05<<26 | d<<21 | s1<<16 | imm16
29:     st rD,rS1,IMM16  op26 = 0x09   iw = 0x09<<26 | d<<21 | s1<<16 | imm16
30: EVERY ROW DISASSEMBLES THE PLANTED WORD AND CHECKS THE TEXT BEFORE STEPPING IT -- this
31: project has a recorded incident where a wrong register field made a gate row measure the
32: wrong thing for months, and a row expecting a small nonzero value is the defence.
33: """
34: import os, pty, re, select, sys, time
35: 
36: BIN = sys.argv[1]
37: IMAGES = sys.argv[2]
38: IMG = IMAGES + "/liveimage-luna88k-raw-20250518.img"
39: CODE = 0x00010000
40: CMMU_D0 = 0xFFF06000
41: 
42: 
43: def run_row(name, is_store, imm16, r4val, note):
44:     op26 = 0x09 if is_store else 0x05
45:     word = (op26 << 26) | (4 << 21) | (5 << 16) | imm16
46:     want = "%s\tr4,r5,0x%x" % ("st" if is_store else "ld", imm16)
47:     pid, fd = pty.fork()
48:     if pid == 0:
49:         os.chdir(IMAGES)
50:         os.execvp(BIN, [BIN, "-V", "-e", "luna-88k", "-d", "R:" + IMG, "boot"])
51:         os._exit(127)
52:     buf = ""
53:     dead = [False]
54: 
55:     def rd(t=0.4):
56:         nonlocal buf
57:         r, _, _ = select.select([fd], [], [], t)
58:         if fd not in r:
59:             return True
60:         try:
61:             d = os.read(fd, 65536)
62:         except OSError:
63:             dead[0] = True
64:             return False
65:         if not d:
66:             dead[0] = True
67:             return False
68:         buf += d.decode("latin1", "replace")
69:         return True
70: 
71:     #  Signature order is not free choice: gate_hygiene.sh pins the CANONICAL
72:     #  #392 call form as a literal `return wait(mark=_mark, echo=<x> if <x>
73:     #  else None)`, deliberately tightened three times because every looser
74:     #  prefix was a substring of the broken form too.  Written any other way,
75:     #  a probe is simply not covered by that ratchet -- which is worse than
76:     #  failing it.  So timeout goes last, and send() ends on the pinned form.
77:     def wait(mark=0, echo=None, timeout=60):
78:         t = time.time()
79:         while time.time() - t < timeout:
80:             if not rd():
81:                 return False
82:             resp = buf[mark:]
83:             if echo is not None and echo not in resp:
84:                 continue
85:             if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
86:                 return True
87:         return False
88: 
89:     def send(x, timeout=60):
90:         b = (x + "\n").encode("latin1")
91:         _mark = len(buf)
92:         n = 0
93:         try:
94:             while n < len(b):
95:                 n += os.write(fd, b[n:])
96:         except OSError:
97:             dead[0] = True
98:             return False
99:         return wait(mark=_mark, echo=x if x else None)
100: 
101:     status, dis, fatal, r4got = "?", "", "", None
102:     #  KEYWORD, and this is not style.  Reordering wait()'s parameters to the
103:     #  pinned #392 form silently turned this positional 120 into mark=120 --
104:     #  the probe would have waited on a slice of an empty buffer with a 60 s
105:     #  budget instead of 120 s for the cold prompt.  A conversion done for a
106:     #  detector's benefit is still a code change.
107:     if not wait(timeout=120):
108:         status = "NO-PROMPT"
109:     else:
110:         send("r5=0x%08x" % CMMU_D0)
111:         send("r4=0x%08x" % r4val)
112:         send("put w 0x%08x, 0x%08x" % (CODE, word))
113:         mark = len(buf)
114:         send("unassemble 0x%08x" % CODE)
115:         m = re.search(r"((?:ld|st)[\w.]*\s+r\d+,r\d+,0x[0-9a-f]+)", buf[mark:])
116:         dis = m.group(1) if m else "(none)"
117:         send("pc=0x%08x" % CODE)
118:         mark = len(buf)
119:         ok = send("step 1", timeout=30)
120:         if dead[0] or not ok:
121:             status = "HOST-DIED"
122:         elif send("reg", timeout=30):
123:             status = "SURVIVED"
124:             mm = re.search(r"r4\s*=\s*0x([0-9a-fA-F]+)", buf[mark:])
125:             if mm:
126:                 r4got = int(mm.group(1), 16)
127:         else:
128:             status = "HOST-DIED" if dead[0] else "NO-REG"
129:     ms = re.findall(r"(m8820x\w*:[^\r\n]*)", buf)
130:     ms = [x for x in ms if "Copyright" not in x]
131:     if ms:
132:         fatal = ms[-1].strip()
133:     try:
134:         os.write(fd, b"quit\n")
135:         time.sleep(0.3)
136:         os.kill(pid, 9)
137:         os.waitpid(pid, 0)
138:     except Exception:
139:         pass
140:     print("%-34s word=0x%08x dis_ok=%-5s %-9s r4=%s %s"
141:           % (name, word, str(want in dis), status,
142:              ("0x%08x" % r4got) if r4got is not None else "-", note))
143:     if fatal:
144:         print("      emulator said: %s" % fatal)
145:     return status
146: 
147: 
148: print("BINARY=%s" % BIN)
149: t0 = time.time()
150: #  name, is_store, imm16, r4 seed, note
151: ROWS = [
152:     ("VALUE ld CMMU_IDR -> 0x00a90000", False, 0x000, 0x00000000, "the seeded 88200 rev-9 id; VALUE not survival"),
153:     ("CONTROL st CMMU_SAR   (handled)", True,  0x00c, 0x00000000, "must survive"),
154:     ("CONTROL st SCR cmd 0x35 (handled)", True, 0x004, 0x00000035, "FLUSH_SUPER_PAGE; guest issues it 158664x"),
155:     ("site 2: ld CMMU_SCR",            False, 0x004, 0x00000000, "read of a write-only reg"),
156:     ("site 1: st CMMU_IDR",            True,  0x000, 0x00000001, "write to the read-only ID reg"),
157:     ("site 3: st CMMU_SSR",            True,  0x008, 0x00000001, "write to the status reg"),
158:     ("site 4: st SCR cmd 0x34",        True,  0x004, 0x00000034, "FLUSH_SUPER_LINE: DEFINED in m8820x.h:112, unhandled"),
159:     ("site 4: st SCR cmd 0x24",        True,  0x004, 0x00000024, "PROBE_SUPER: DEFINED in m8820x.h:107, unhandled"),
160:     ("site 0: st CMMU_CTP0",           True,  0x840, 0x00000000, "cache tag port, DEFINED in m8820x.h:82"),
161: ]
162: results = [run_row(*r) for r in ROWS]
163: print("SURVIVED=%d of %d" % (results.count("SURVIVED"), len(results)))
164: print("M8820X_SITES_%s" % ("PASS" if results.count("SURVIVED") == len(results) else "FAIL"))
165: print("PROBE_WALL=%.1fs for %d rows" % (time.time() - t0, len(ROWS)))

