                   + ["r7=0x%x" % GDROM_COND, "r8=0xa0"] + run([MOV_W_R8_AT_R7], CODE + 0x40)
                   + ["r7=0x%x" % GDROM_DATA, "r8=0x0014"]
                   + run([MOV_W_R8_AT_R7] * 6, CODE + 0x60)
                   + ["r1=0x%x" % GDROM_DATA, "r2=0", "r3=0"]
                   + run([MOV_W_AT_R1_R2, MOV_W_AT_R1_R3], CODE + 0x100)
