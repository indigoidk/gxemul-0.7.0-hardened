The count assertions need the ordering check you called out: a first access can supply the required message while a later access remains unproved. I’m also checking where the candidate entries expand into several labelled rows, so the assessment names those rows explicitly.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import ast
from pathlib import Path
for name in ('pcc2_width_probe.py','pcc2_default_probe.py','sgi_de_width_probe.py','asic_badaddr_probe.py','gdrom_default_probe.py','arm_flags_probe.py'):
    tree = ast.parse(Path('regress', name).read_text(encoding='utf-8'))
    found = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == 'row':
            ix = 3 if name == 'arm_flags_probe.py' else 2
            if len(node.args) > ix and isinstance(node.args[ix], ast.Constant) and node.args[ix].value in (0, 'survived', 'absent', 'unchanged', 'none'):
                found.append((node.lineno, ast.unparse(node.args[0]), node.args[ix].value))
    print(name, len(found))
    for line, label, value in sorted(found):
        print(f'{line}: {label} => {value"'!r}'"')
