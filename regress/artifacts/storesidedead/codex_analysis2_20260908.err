464: def row(name, got, want, note=""):
465:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
466:     assert len(name) <= 15, name    # load-bearing for gate_arm.sh: `%-16s' plus a literal space keep its `^$v  .*ok$' pattern satisfiable (pass 9, Opus)
467:     ok = (got == want)
468:     rows.append((name, ok))
469:     print("%-16s %-12s %-12s %-46s %s" % (name, str(got), str(want), note,
470:                                           "ok" if ok else "FAIL"))
471:     return ok
