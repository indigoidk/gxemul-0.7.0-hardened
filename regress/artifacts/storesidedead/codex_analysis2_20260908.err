225: def run_ops(ops, at):
226:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
227:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
228:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
229:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
