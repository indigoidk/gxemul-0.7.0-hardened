131: def session(cmds, settle=1.5, spin=1.2):
132:     pid, fd = pty.fork()
133:     if pid == 0:
134:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
135:                        "0x80001000:" + DUMMY])
136:         os._exit(127)
137:     buf = ""
138: 
139:     def rd(t):
140:         nonlocal buf
141:         end = time.time() + t
142:         while time.time() < end:
143:             r, _, _ = select.select([fd], [], [], 0.1)
144:             if not r:
145:                 continue
146:             try:
147:                 d = os.read(fd, 65536)
148:                 if not d:
149:                     return False
150:                 buf += d.decode("latin-1", "replace")
151:             except OSError:
152:                 return False
153:         return True
154: 
155:     alive = rd(settle)
156:     for i, c in enumerate(cmds):
157:         try:
158:             os.write(fd, (c + "\n").encode("latin-1"))
159:         except OSError:
160:             alive = False
161:             break
162:         if not rd(spin if i == len(cmds) - 1 else 0.25):
163:             alive = False
164:             break
165:     try:
166:         os.write(fd, b"quit\n")
167:         rd(0.4)
168:     except OSError:
169:         pass
170:     try:
171:         os.close(fd)
172:     except OSError:
173:         pass
174:     how = "nostatus"
175:     try:
176:         _, stat = os.waitpid(pid, 0)
177:         if os.WIFSIGNALED(stat):
178:             how = "sig%d" % os.WTERMSIG(stat)
179:         elif os.WIFEXITED(stat):
180:             how = "exit%d" % os.WEXITSTATUS(stat)
181:     except OSError:
182:         pass
183:     return buf.replace("\r", ""), alive, how
