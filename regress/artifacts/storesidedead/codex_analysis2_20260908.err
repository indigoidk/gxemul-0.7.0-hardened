196: def run_flags(iw, rn, rm, cin):
197:     """Preset the carry, run one flag-setting instruction, publish cpsr and rd.
198: 
199:     Returns (cpsr, rd) or (None, None) if the session died."""
200:     r6, r7 = (1, 0) if cin else (0, 1)      # 1-0 => no borrow => C=1
201:     w, _ = session([
202:         "r1=0x%x" % rn, "r2=0x%x" % rm,
203:         "r6=0x%x" % r6, "r7=0x%x" % r7,
204:         "r4=0x%x" % DEST, "r5=0x%x" % (DEST + 4),
205:         "put w 0x%x, 0xdeadbeef" % DEST,
206:         "put w 0x%x, 0xdeadbeef" % (DEST + 4),
207:         "put w 0x%x, 0x%08x" % (CODE,      SUBS_R6_R6_R7),
208:         "put w 0x%x, 0x%08x" % (CODE + 4,  iw),
209:         "put w 0x%x, 0x%08x" % (CODE + 8,  MRS_R3_CPSR),
210:         "put w 0x%x, 0x%08x" % (CODE + 12, STR_R3_R4),
211:         "put w 0x%x, 0x%08x" % (CODE + 16, STR_R0_R5),
212:         "pc=0x%x" % CODE, "step 5"], 2)
213:     if w is None:
214:         return None, None
215:     return sw(w[0]), sw(w[1])
