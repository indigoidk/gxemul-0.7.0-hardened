215: def session(cmds, settle=8.0, spin=2.0):
216:     pid, fd = pty.fork()
217:     if pid == 0:
218:         os.execv(BIN, [BIN, "-V", "-x", "-E", "dreamcast", "-M", "64", KERNEL])
219:         os._exit(127)
