474: def session(cmds, settle=1.5, spin=1.2):
475:     pid, fd = pty.fork()
476:     if pid == 0:
477:         os.execv(BIN, [BIN, "-V", "-x", "-E", "mvme88k", "-e", "mvme187", "-M", "64",
478:                        "0x10000:" + DUMMY])
479:         os._exit(127)
480:     buf = ""
481: 
482:     def rd(t, until=None):
483:         #  drain the pty for t seconds; with `until', return as soon as that text has
484:         #  arrived (pass 7: a fixed drain after `continue' could send the next command to a
485:         #  guest that had not reached its breakpoint yet).
486:         nonlocal buf
487:         end = time.time() + t
488:         while time.time() < end:
489:             if until is not None and until in buf:
490:                 return True
491:             r, _, _ = select.select([fd], [], [], 0.1)
492:             if not r:
493:                 continue
494:             try:
495:                 d = os.read(fd, 65536)
496:                 if not d:
497:                     return False
498:                 buf += d.decode("latin-1", "replace")
499:             except OSError:
500:                 return False
501:         if until is not None and until in buf:    # pass 9 (codex): the token may land in the last read
502:             return True
503:         return "timeout" if until is not None else True
504: 
505:     alive = rd(settle)
506:     how = "nostatus"
507:     for i, c in enumerate(cmds):
508:         w = spin if i == len(cmds) - 1 else 0.25
509:         until = None
510:         if isinstance(c, tuple):    # (cmd, wait[, until]): `continue' waits for its breakpoint
511:             until = c[2] if len(c) > 2 else None    # read the tuple BEFORE unpacking it
512:             c, w = c[0], c[1]
513:         try:
514:             #  the one unbounded call left (pass 9, Opus): it blocks only if the pty input buffer fills
515:             #  while the guest free-runs -- tens of bytes per command against a kilobyte buffer.
516:             os.write(fd, (c + "\n").encode("latin-1"))
517:         except OSError:
518:             alive = False
519:             break
520:         r = rd(w, until)
521:         if r is False:
522:             alive = False
523:             break
524:         if r == "timeout":
525:             #  pass 8 (codex, grok): the guest never reached its breakpoint -- send it nothing
526:             #  more, and let every row of this session say so through cval().
527:             how = "no-breakpoint"
528:             break
529:     try:
530:         os.write(fd, b"quit\n")
531:         rd(0.4)
532:     except OSError:
533:         pass
534:     try:
535:         os.close(fd)
536:     except OSError:
537:         pass
538:     how = how if how == "no-breakpoint" else "nostatus"
539:     #  pass 7: a guest still running (no breakpoint reached) would block waitpid forever;
540:     #  give it a moment after the pty closed, then kill it -- the row says so, the gate
541:     #  does not hang.
542:     stat = None
543:     reaped = False
544:     for _ in range(30):
545:         try:
546:             p, stat = os.waitpid(pid, os.WNOHANG)
547:         except OSError:
548:             p, stat = pid, None
549:         if p:
550:             reaped = True
551:             break
552:         time.sleep(0.1)
553:     if not reaped:
554:         try:
555:             os.kill(pid, 9)
556:         except OSError:
557:             pass
558:         how = how if how == "no-breakpoint" else "killed"
559:         for _ in range(30):    # pass 8 (Opus F2): reap the killed child, bounded
560:             try:
561:                 p, stat = os.waitpid(pid, os.WNOHANG)
562:             except OSError:
563:                 p, stat = pid, None
564:             if p:
565:                 reaped = True
566:                 break
567:             time.sleep(0.1)
568:         if not reaped:
569:             how = how if how == "no-breakpoint" else "unreaped"
570:     try:
571:         if stat is None or not reaped or how in ("no-breakpoint", "unreaped", "killed"):
572:             pass
573:         elif os.WIFSIGNALED(stat):
574:             how = "sig%d" % os.WTERMSIG(stat)
575:         elif os.WIFEXITED(stat):
576:             how = "exit%d" % os.WEXITSTATUS(stat)
577:     except OSError:
578:         pass
579:     return buf.replace("\r", ""), alive, how
