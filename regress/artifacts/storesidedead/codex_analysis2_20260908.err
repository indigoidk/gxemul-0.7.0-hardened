441: 
442: #  r2 = PCC2 base, r3 = scratch, r4 = load target, r5 = store source, r6 = second source
443: #  ld.b / ld.h (0x07 / 0x06) SIGN-EXTEND: 0x82 would print as 0xffffff82.  Every row that
444: #  asserts a VALUE uses the unsigned forms ld.bu / ld.hu (0x03 / 0x02); the survival rows
445: #  only check exit status and keep the signed forms.
446: def LD_B(rd, off): return enc(0x07, rd, 2, off)
447: def LD_H(rd, off): return enc(0x06, rd, 2, off)
448: def LD_BU(rd, off): return enc(0x03, rd, 2, off)
449: def LD_HU(rd, off): return enc(0x02, rd, 2, off)
450: def LD_W(rd, off): return enc(0x05, rd, 2, off)
451: def ST_B(rs, off): return enc(0x0b, rs, 2, off)
452: def ST_H(rs, off): return enc(0x0a, rs, 2, off)
453: def ST_W(rs, off): return enc(0x09, rs, 2, off)
