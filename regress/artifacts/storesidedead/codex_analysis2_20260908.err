284:     print("%-14s %-12s %-12s %-34s %s" % (name, got, want, note,
285:                                           "ok" if ok else "FAIL"))
286:     return ok
289: def session(cmds, settle=8.0, spin=2.0):
290:     pid, fd = pty.fork()
291:     if pid == 0:
292:         os.execv(BIN, [BIN, "-V", "-x", "-E", "dreamcast", "-M", "64", KERNEL])
293:         os._exit(127)
294:     buf = ""
296:     def rd(t):
297:         nonlocal buf
298:         end = time.time() + t
299:         while time.time() < end:
300:             r, _, _ = select.select([fd], [], [], 0.25)
301:             if not r:
302:                 continue
303:             try:
304:                 d = os.read(fd, 65536)
305:             except OSError:
306:                 return False
307:             if not d:
308:                 return False
309:             buf += d.decode("latin-1", "replace")
310:         return True
312:     alive = rd(settle)
313:     for i, c in enumerate(cmds):
314:         try:
315:             os.write(fd, (c + "\n").encode("latin-1"))
316:         except OSError:
317:             alive = False
318:             break
319:         if not rd(spin if i == len(cmds) - 1 else 0.35):
320:             alive = False
321:             break
322:     try:
323:         os.write(fd, b"quit\n")
324:         rd(0.6)
325:     except OSError:
326:         pass
327:     try:
328:         os.close(fd)
329:     except OSError:
330:         pass
341:     how = "nostatus"
342:     try:
343:         _, stat = os.waitpid(pid, 0)
344:         if os.WIFSIGNALED(stat):
345:             how = "sig%d" % os.WTERMSIG(stat)
346:         elif os.WIFEXITED(stat):
347:             how = "exit%d" % os.WEXITSTATUS(stat)
348:     except OSError:
349:         pass
350:     return buf, alive, how
353: def printed(t, reg):
354:     m = re.search(r"print\s+%s\s*\r?\n\s*(0x[0-9a-f]+)" % reg, t)
355:     return m.group(1) if m else "absent"
358: def run(steps, at=CODE):
359:     """Plant a run of instructions, then a self-branch, and step them all."""
360:     put = ["put h 0x%x, 0x%04x" % (at + 2 * i, op) for i, op in enumerate(steps)]
361:     put += ["put h 0x%x, 0x%04x" % (at + 2 * len(steps), BRA_SELF),
362:             "put h 0x%x, 0x%04x" % (at + 2 * len(steps) + 2, NOP)]
363:     return put + ["pc=0x%x" % at, "step %d" % len(steps)]
366: def ld(reg):
367:     return ["r1=0x%x" % reg, "r2=0"]
370: def pair(setup, ops):
371:     """Plant SEVERAL accesses contiguously and step them all.
373:     *** USE THIS FOR EVERY MULTI-ACCESS ROW. ***  Calling run() twice does NOT
374:     work: each call emits its own `pc=`/`step`, so the second overrides the
375:     first and only ONE access ever executes.  #460 hit exactly this and it
376:     made four latch rows vacuous -- they read a count of 1 whether the latch
377:     worked or not.  Here it turned a CONTROL red instead, which is the loud
378:     direction, and one measurement found it.
379:     """
380:     return setup + run(ops)
383: def st(reg, val):
384:     return ["r7=0x%x" % reg, "r8=0x%08x" % val]
