1054:         #  the debugger sets cpsr but not the separate `flags` field the
1055:         #  handlers actually read, so a written carry would preset nothing.
1056:         r6, r7 = (1, 0) if cin else (0, 1)
1057:         cmds = ["r6=%d" % r6, "r7=%d" % r7] + cmds
1058:         code = [SUBS_PRESET] + code
1059:     cmds += ["r4=0x%x" % DEST, "put w 0x%x, 0xdeadbeef" % DEST]
1060:     for i, w in enumerate(code):
1061:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
1062:     cmds += ["pc=0x%x" % CODE, "step %d" % len(code)]
1063:     w, _ = session(cmds, 1)
1064:     if w is None:
1065:         return None
1066:     v = sw(w[0])
1067:     return ((v >> 29) & 1) if read_flag else v
1068: 
1069: 
1070: rows = []
1071: 
1072: 
1073: def row(name, kind, got, want):
1074:     #  The name column is 30 wide, and that is load-bearing: gate_arm.sh
1075:     #  matches each named row with TWO spaces after the name, to stop a name that
1076:     #  is a prefix of a longer one from matching both. A name as long as the
1077:     #  column gets NO padding and only the format's single separator space, so
1078:     #  its check can never match anything -- the mirror image of the double-count
1079:     #  trap, and it silently made two checks unsatisfiable until a diff-review
1080:     #  seat found them. It was 26 through #347; round 99's review widened it to
1081:     #  30 for headroom after a proposed name came out at exactly 26 characters.
1082:     #  30 leaves >= 2 spaces for every name here; the longest is 24. Keep this
1083:     #  wider than the longest row name plus two if any are added.
1084:     ok = (got == want)
1085:     rows.append(ok)
1086:     print("%-30s %-12s %-12s %s %s"
1087:           % (name,
1088:              ("0x%08x" % got) if isinstance(got, int) else str(got),
1089:              ("0x%08x" % want) if isinstance(want, int) else str(want),
1090:              kind, "ok" if ok else "FAIL"))
1091: 
1092: 
1093: def cflag(cpsr):
1094:     return None if cpsr is None else (cpsr >> 29) & 1
1095: 
1096: 
1097: def nzcv(cpsr):
1098:     return None if cpsr is None else (cpsr >> 28) & 0xf
1099: 
1100: 
1101: #  ---- control -------------------------------------------------------------
1102: #  Nothing below may be believed unless the rig executes guest code at all.
1103: #  This harness has been bitten by a probe that reported a defect off sentinel
1104: #  reads while its guest code had never run.
1105: cpsr, rd = run_flags(SUBS, 5, 3, 1)
1106: control = "OK" if (cpsr is not None and rd == 2) else "DEAD"
1107: 
1108: print("ARM_FLAGS_CONTROL=%s" % control)
1109: if control != "OK":
1110:     print("ARM_FLAGS_RESULT=0/0")
1111:     sys.exit(0)
1112: 
1113: #  ---- DISC: the SBC/RSC borrow-in defect ----------------------------------
1114: #  Wrong exactly when a == b with carry-in clear, so all three equal-operand
1115: #  rows below are the defect and the unequal ones are pins. Three different
1116: #  equal values, because a fix that special-cased one constant would pass a
1117: #  single row.
1118: for nm, iw, a, b in [("sbcs eq C=0", SBCS, 5, 5),
1119:                      ("sbcs eq0 C=0", SBCS, 0, 0),
1120:                      ("sbcs eqmax C=0", SBCS, 0xffffffff, 0xffffffff),
1121:                      ("rscs eq C=0", RSCS, 5, 5)]:
1122:     cpsr, rd = run_flags(iw, a, b, 0)
1123:     row(nm + " C", "DISC", cflag(cpsr), 0)
1124:     #  The value was ALWAYS right; assert it so a "fix" that repaired the flag
1125:     #  by breaking the arithmetic cannot pass.
1126:     row(nm + " rd", "PIN", rd, 0xffffffff)
1127: 
1128: #  ---- PIN: the same two instructions where they were already correct ------
1129: for nm, iw, a, b, cin, wc, wrd in [
1130:         ("sbcs eq C=1",  SBCS, 5, 5, 1, 1, 0x00000000),
1131:         ("sbcs gt C=0",  SBCS, 5, 4, 0, 1, 0x00000000),
1132:         ("sbcs lt C=0",  SBCS, 4, 5, 0, 0, 0xfffffffe),
1133:         ("sbcs lt C=1",  SBCS, 4, 5, 1, 0, 0xffffffff),
1134:         ("rscs gt C=0",  RSCS, 4, 5, 0, 1, 0x00000000),
1135:         ("rscs lt C=0",  RSCS, 5, 4, 0, 0, 0xfffffffe)]:
1136:     cpsr, rd = run_flags(iw, a, b, cin)
1137:     row(nm + " C", "PIN", cflag(cpsr), wc)
1138:     row(nm + " rd", "PIN", rd, wrd)
1139: 
1140: #  ---- PIN: SUB/RSB/CMP, the three the fix must NOT disturb ----------------
1141: #  These share the rewritten line. `a >= b` and `c32 == c64` agree for them,
1142: #  which is exactly the claim these rows check rather than assume.
1143: for nm, iw, a, b, wc, wrd in [
1144:         ("subs eq", SUBS, 5, 5, 1, 0x00000000),
1145:         ("subs lt", SUBS, 3, 5, 0, 0xfffffffe),
1146:         ("subs gt", SUBS, 5, 3, 1, 0x00000002),
1147:         ("subs zerominus", SUBS, 0, 1, 0, 0xffffffff),
1148:         ("rsbs gt", RSBS, 3, 5, 1, 0x00000002),
1149:         ("rsbs lt", RSBS, 5, 3, 0, 0xfffffffe)]:
1150:     cpsr, rd = run_flags(iw, a, b, 1)
1151:     row(nm + " C", "PIN", cflag(cpsr), wc)
1152:     row(nm + " rd", "PIN", rd, wrd)
1153: 
1154: #  The A__PC template variant compiles its OWN copy of the changed line, and it
1155: #  is the one operand path that is not plainly a 32-bit register read: when Rn
1156: #  is PC the template recomputes the operand as page_base + slot*4 + 8 in 64-bit
1157: #  arithmetic, which passes 2^32 for the last two instruction slots of the
1158: #  address space. Three panel seats raised it and one classified it as a
1159: #  regression this round would otherwise introduce, so #311 truncates that
1160: #  operand back to 32 bits -- correct on its own terms, since ARM's PC is 32
1161: #  bits and reading it must wrap.
1162: #
1163: #  These two rows CANNOT reach the top-of-space case: it needs RAM mapped at
1164: #  0xfffff000 and this machine has not got any. What they do prove is that the
1165: #  truncation left the reachable A__PC path alone, which is the part that is
1166: #  measurable. The corner itself is reasoned, not measured, and the round notes
1167: #  say so rather than implying the gate covers it.
1168: #  The instruction sits at CODE+4, so ARM's PC reads CODE+12 and rd = CODE+8.
1169: cpsr, rd = run_flags(SUBS_PC_4, 0, 0, 1)
1170: row("subs rn=pc rd", "PIN", rd, CODE + 8)
1171: row("subs rn=pc C", "PIN", cflag(cpsr), 1)
1172: 
1173: #  CMP writes no rd, so only its flags are meaningful. Full NZCV, because CMP
1174: #  exists only for its flags and a carry-only check would miss a clobbered Z.
1175: for nm, a, b, wnzcv in [("cmp eq", 5, 5, 0x6),        # Z=1 C=1
1176:                         ("cmp lt", 3, 5, 0x8),        # N=1
1177:                         ("cmp gt", 5, 3, 0x2)]:       # C=1
1178:     cpsr, rd = run_flags(CMPS, a, b, 1)
1179:     row(nm + " NZCV", "PIN", nzcv(cpsr), wnzcv)
1180: 
1181: #  ---- PIN: the ADD side of the same #if, which must stay on c32 != c64 ----
1182: for nm, iw, a, b, cin, wc in [
1183:         ("adds carry-out", ADDS, 0xffffffff, 1, 1, 1),
1184:         ("adds no-carry",  ADDS, 1, 1, 1, 0),
1185:         ("adcs carry-out", ADCS, 0xffffffff, 0, 1, 1),
1186:         ("adcs no-carry",  ADCS, 1, 1, 0, 0)]:
1187:     cpsr, rd = run_flags(iw, a, b, cin)
1188:     row(nm + " C", "PIN", cflag(cpsr), wc)
1189: 
1190: #  ---- DISC: #313, ADC is the one opcode with no V formula -----------------
1191: #  ADC appears in the OUTER #if that clears and recomputes V, but matches
1192: #  neither inner arm (ADD||CMN, nor SUB||RSB||CMP||RSC||SBC), so `v` stays 0
1193: #  and ADCS could only ever CLEAR V. Found by a panel seat reading the #if
1194: #  nesting, then reproduced here. The paired ADDS rows are what make these
1195: #  rows a statement about ADC specifically rather than about V in general:
1196: #  the identical overflow through ADDS was already correct.
1197: for nm, iw, a, b, cin, wv, kind in [
1198:         ("adcs V pos-ovf",  ADCS, 0x7fffffff, 0, 1, 1, "DISC"),
1199:         ("adcs V pos-ovf2", ADCS, 0x7ffffffe, 1, 1, 1, "DISC"),
1200:         ("adcs V neg-ovf",  ADCS, 0x80000000, 0xffffffff, 0, 1, "DISC"),
1201:         ("adcs V none",     ADCS, 1, 1, 1, 0, "PIN"),
1202:         ("adds V pos-ovf",  ADDS, 0x7fffffff, 1, 1, 1, "PIN"),
1203:         ("adds V none",     ADDS, 1, 1, 1, 0, "PIN"),
1204:         ("sbcs V ovf",      SBCS, 0x80000000, 1, 0, 1, "PIN")]:
1205:     cpsr, rd = run_flags(iw, a, b, cin)
1206:     row(nm, kind, None if cpsr is None else (cpsr >> 28) & 1, wv)
1207: 
1208: #  ---- DISC: permanently-undefined routing ---------------------------------
1209: #  Committed: the emulator STOPS, so every witness keeps its sentinel. The
1210: #  marker proves the handler ran; the mode and lr prove it was reached as an
1211: #  exception and not merely branched to.
1212: for nm, iw, at in [("udf", UDF, CODE),
1213:                    ("udf gdb-form", UDF_GDB, CODE),
1214:                    ("udf page-end", UDF, PAGE_END)]:
1215:     mode, lr, marker = run_und(iw, at)
1216:     row(nm + " handler ran", "DISC", marker, 0x0000005a)
1217:     row(nm + " UND32 mode", "DISC",
1218:         None if mode is None else mode & 0x1f, ARM_MODE_UND32)
1219:     row(nm + " lr=pc+4", "DISC", lr, at + 4)
1220: 
1221: #  A conditional UDF whose condition FAILS. The committed build fails this
1222: #  because `goto bad` runs at DECODE time -- the guest never had to execute the
1223: #  instruction for the emulator to stop, which is the strongest statement of
1224: #  reachability in this table.
1225: #
1226: #  The two halves are ONE row on purpose. Asserting "the handler did not run"
1227: #  separately would pass on the committed build for the wrong reason: nothing
1228: #  ran at all there, so the sentinel survives and a dead emulator scores a
1229: #  point. Only the conjunction -- execution continued AND no exception was
1230: #  raised -- distinguishes correct silence from a stopped machine.
1231: fall, handler = run_und_condfailed(UDF_EQ)
1232: row("udf cond-failed nop", "DISC",
1233:     "ran=0x%08x handler=0x%08x" % (fall, handler)
1234:     if fall is not None else "dead",
1235:     "ran=0x0000005a handler=0xdeadbeef")
1236: 
1237: for name, pre, iw, want, cin, rf in R78:
1238:     got = run78(pre, iw, cin, rf)
1239:     row(name, "PIN" if name in ("uxtab ROR 0", "rot0 movs C", "mvn S-clear",
1240:                                 "rot0 pc src C", "rotc pc gt255",
1241:                                 "rotc bound 256") else "DISC", got, want)
1242: 
1243: 
1244: #  ---------------------------------------------------------------------------
1245: #  #328: THUMB. Everything above drives ARM-mode encodings; the Thumb
1246: #  interpreter is a completely separate implementation (cpu_arm.c,
1247: #  arm_cpu_interpret_thumb_SLOW) and #311 never touched it.

codex
The ARM lead is identifiable: `run_flags()` and `run78()` reduce a dumped word to one flag bit without rejecting the sentinel first. Some expected bits match that sentinel. I’m separating rows with an asserted result from the same session from rows that discard it.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$probeLines = Get-Content -LiteralPath '"'regress/arm_flags_probe.py'
for ("'$probeIndex = 407; $probeIndex -lt 555; $probeIndex++) { '"'{0}: {1}' -f ("'$probeIndex + 1), $probeLines[$probeIndex] }
for ($probeIndex = 812; $probeIndex -lt 921; $probeIndex++) { '"'{0}: {1}' -f ("'$probeIndex + 1), $probeLines[$probeIndex] }' in C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$probeLines = Get-Content -LiteralPath '"'regress/arm_flags_probe.py'
for ("'$probeIndex = 1533; $probeIndex -lt $probeLines.Length; $probeIndex++) { '"'{0}: {1}' -f ("'$probeIndex + 1), $probeLines[$probeIndex] }' in C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC
 succeeded in 250ms:
1534: 
1535: #  #340: the instruction COMBINER changes observable flags.
1536: #
1537: #  A data-processing immediate with S set updates C from the shifter carry-out;
1538: #  this tree approximates that as "encoded immediate > 255 means it was rotated,
1539: #  so C := its bit 31" (cpu_arm_instr_dpi.c:121-140). The standalone teqs/tsts
1540: #  do it. The *_samepage handlers that a teq/tst-followed-by-branch folds into
1541: #  do not touch C at all, and the teqs combiner has NO operand guard while the
1542: #  tsts one guards only bit 31 -- which is about N (with the top bit clear,
1543: #  a & b cannot be negative), not about C.
1544: #
1545: #  0x0000FF00 is `0xFF ror 24`: rotated, > 255, bit 31 CLEAR, so the owed answer
1546: #  is C := 0. C is preset to 1 so "did nothing" is distinguishable from
1547: #  "cleared correctly".
1548: #
1549: #  The STANDALONE rows are the control and are what attributes a difference to
1550: #  the COMBINER rather than to the instruction: identical encoding, identical
1551: #  operands, no following branch, and they must read C0 on both builds.
1552: TEQ_ROT = teq_imm(12, 0xFF)     # teq r1, #0x0000FF00
1553: TST_ROT = tst_imm(12, 0xFF)     # tst r1, #0x0000FF00
1554: 
1555: COMBINE_ROWS = [
1556:     ("A teq rot C combined", run_combined(TEQ_ROT, 0x00000001, 1), 0, "DISC"),
1557:     ("A tst rot C combined", run_combined(TST_ROT, 0x0000FF00, 1), 0, "DISC"),
1558:     ("A teq rot C standalone", run_flags(TEQ_ROT, 0x00000001, 0, 1)[0], 0,
1559:      "PIN"),
1560:     ("A tst rot C standalone", run_flags(TST_ROT, 0x0000FF00, 0, 1)[0], 0,
1561:      "PIN"),
1562:     #  unrotated (<= 255): C is PRESERVED by the ISA on both paths. Catches a
1563:     #  fix that starts clobbering C where it must be left alone.
1564:     ("A teq flat C preserved", run_combined(teq_imm(0, 0x01), 0x00000010, 1),
1565:      1, "PIN"),
1566: ]
1567: for nm, cpsr, want_c, cls in COMBINE_ROWS:
1568:     row(nm, cls, "C%d" % cflag(cpsr) if cpsr is not None else "dead",
1569:         "C%d" % want_c)
1570: 
1571: #  #342: the XOR-swap fold had no a != b guard.
1572: #
1573: #  DISC: three  each ZERO r0; X(xchg) exchanges r0 with itself and
1574: #  leaves it alone. 0x5a is the row own proof that the fold happened, since no
1575: #  standalone EOR triplet can leave a nonzero value.
1576: #
1577: #  PIN: the distinct-register swap, in the shape the matcher actually accepts
1578: #  (Rm == Rd). It exercises the FOLDED handler on pass 2 and pins that the swap
1579: #  it performs is correct -- so a broken X(xchg) fails here -- but it cannot by
1580: #  itself distinguish folded-and-correct from not-folded-and-correct, which is
1581: #  exactly why it is a PIN and not a second discriminator.
1582: XCHG_ROWS = []
1583: _d = run_xchg(True)
1584: XCHG_ROWS.append(("A xchg same-reg zeroes", _d[0] if _d else None,
1585:                   0x00000000, "DISC"))
1586: XCHG_ROWS.append(("A xchg same-reg r1 pin", _d[1] if _d else None,
1587:                   0x000000a5, "PIN"))
1588: _s = run_xchg(False)
1589: XCHG_ROWS.append(("A xchg swap r0", _s[0] if _s else None, 0x000000a5, "PIN"))
1590: XCHG_ROWS.append(("A xchg swap r1", _s[1] if _s else None, 0x0000005a, "PIN"))
1591: for nm, got, want, cls in XCHG_ROWS:
1592:     row(nm, cls, "%08x" % got if got is not None else "dead", "%08x" % want)
1593: 
1594: #  #345: the cache-clean fold clobbered r0/r1 for a loop that used neither.
1595: #  #346: and it fired on any post-index immediate, so a 4-byte stride advanced
1596: #  the base by 32. #348 made the fold write the loop's exit flags; #349 gave
1597: #  it a DEBUG-gated fold-fired marker; #350 made a non-multiple counter fall
1598: #  back to the real loop instead of terminating a loop that architecturally
1599: #  never exits. See run_cacheclean / run_cc_nonmult for what each variant
1600: #  isolates. "still folds" (stale r2) remains a fold detector independent of
1601: #  the marker, because the skipped load is deliberately unfixed.
1602: _cc, _ = run_cacheclean("wrongregs")
1603: _cg, _ = run_cacheclean("genuine")
1604: _ci, _ = run_cacheclean("imm4")
1605: _cd, _ = run_cacheclean("wrongdest")
1606: #  The #348 rows ride the 0x40 counter -- at 0x20 a fix that skipped the r1
1607: #  preload would be invisible (see the docstring). The quiet row shares the
1608: #  default-verbosity session: the marker must be absent from a plain run.
1609: #  NB debugmsg's verbosity gate is bypassed under single_step, so the quiet
1610: #  rows are valid only for breakpoint+continue sessions like these -- do not
1611: #  rewrite them to drive the loop with `step`.
1612: _cf, _cfbuf = run_cacheclean("genuine40", seed=CMP_R9_HI)
1613: _, _cvbuf = run_cacheclean("genuine40", seed=CMP_R9_HI, verbose=True)
1614: _, _cwbuf = run_cacheclean("wrongregs", verbose=True)
1615: _cn = run_cc_nonmult()
1616: for _nm, _got, _want, _cls in (
1617:         ("A cacheclean r0 intact", _cc[0] if _cc else None, 0x11, "DISC"),
1618:         ("A cacheclean r1 intact", _cc[1] if _cc else None, 0x22, "DISC"),
1619:         ("A cacheclean still folds", _cg[2] if _cg else None, 0x77, "PIN"),
1620:         ("A cacheclean fold r0", _cg[0] if _cg else None, 0x9120, "PIN"),
1621:         ("A cacheclean imm4 r0", _ci[0] if _ci else None, 0x9104, "DISC"),
1622:         ("A cacheclean imm4 r2", _ci[2] if _ci else None, CC_MEM, "DISC"),
1623:         ("A cacheclean wrong Rd", _cd[3] if _cd else None, CC_MEM, "DISC"),
1624:         ("A cacheclean flags", (_cf[4] & 0xf0000000) if _cf else None,
1625:          0x60000000, "DISC"),
1626:         ("A cacheclean fold r1", _cf[1] if _cf else None, 0x00000000, "PIN")):
1627:     row(_nm, _cls, "%08x" % _got if _got is not None else "dead",
1628:         "%08x" % _want)
1629: #  The #350 verdict is a state word, not a register value: "fold" = the fold
1630: #  consumed the 0x21 counter (prompt reached unaided, r0 odd), "live" = the
1631: #  guard held and the architectural infinite loop was observed running
1632: #  (^C-interrupted; r1 mod 32 == 1 and r0 even, the loop's two invariants).
1633: row("A cacheclean nonmult", "DISC", _cn if _cn else "dead", "live")
1634: #  Marker rows. The fires rows demand BOTH the marker and the echoed
1635: #  "3: DEBUG" -- a session whose verbosity silently failed to rise reports
1636: #  no-verb and fails, instead of passing an absence check for the wrong
1637: #  reason. fires ctrl proves matcher selectivity under the SAME raised
1638: #  verbosity whose effectiveness the fires row just proved.
1639: _f1 = ("yes" if marker_count(_cvbuf, MARK1) >= 1 else "no") \
1640:     if verb_took(_cvbuf) else "no-verb"
1641: _x1 = ("absent" if marker_count(_cwbuf, MARK1) == 0 else "present") \
1642:     if verb_took(_cwbuf) else "no-verb"
1643: row("A cacheclean quiet", "PIN", "%d" % marker_count(_cfbuf, MARK1), "0")
1644: row("A cacheclean fires", "DISC", _f1, "yes")
1645: row("A cacheclean fires ctrl", "PIN", _x1, "absent")
1646: #  #350's r1 == 0 arm: no register or flag can assert the honest n -- a
1647: #  formula reverted to `r1 >> 5` reproduces every stored value -- so the
1648: #  count is read off the #349 marker itself (see run_cc_zero_n).
1649: _zn = run_cc_zero_n()
1650: row("A cacheclean zero n", "DISC", _zn if _zn else "dead", "134217728")
1651: 
1652: #  #347: the SECOND cache-clean fold had BOTH halves wrong -- unguarded
1653: #  registers AND no register update whatsoever. #348 added the exit flags by
1654: #  delegating the final subs to the real dpi handler (zero exit owes Z|C,
1655: #  borrow exit owes N; V is structurally 0, since before_last lies in
1656: #  [0, 0x20] for every uint32 counter). The old `A cclean2 still fold`
1657: #  control row ASSERTED the missing flags and died with the defect it was
1658: #  built on -- #349's marker rows below are its replacement, decided and
1659: #  re-authored in the same change, as the OUTSTANDING_BUGS entry required.
1660: _g2, _g2buf = run_cc2("genuine", seed=CMP_R9_HI)
1661: _b2, _ = run_cc2("wrongbase")
1662: _n2, _ = run_cc2("wrongcnt")
1663: _t2, _ = run_cc2("borrow", seed=CMP_R9_1)
1664: _tv, _ = run_cc2("borrow", seed=CMP_R9_HI)
1665: _z2, _ = run_cc2("zero", seed=CMP_R9_1)
1666: _, _f2buf = run_cc2("genuine", seed=CMP_R9_HI, verbose=True)
1667: _, _w2buf = run_cc2("wrongbase", verbose=True)
1668: for _nm, _got, _want, _cls in (
1669:         ("A cclean2 fold r0", _g2[0] if _g2 else None, 0x9140, "DISC"),
1670:         ("A cclean2 fold r1", _g2[1] if _g2 else None, 0x00000000, "DISC"),
1671:         ("A cclean2 flags", (_g2[4] & 0xf0000000) if _g2 else None,
1672:          0x60000000, "DISC"),
1673:         ("A cclean2 base r5", _b2[2] if _b2 else None, 0x9140, "DISC"),
1674:         ("A cclean2 base r1", _b2[1] if _b2 else None, 0x00000000, "DISC"),
1675:         ("A cclean2 base r0", _b2[0] if _b2 else None, 0x11, "PIN"),
1676:         ("A cclean2 cnt r6", _n2[3] if _n2 else None, 0x00000000, "DISC"),
1677:         ("A cclean2 cnt r1", _n2[1] if _n2 else None, 0x22, "PIN"),
1678:         ("A cclean2 tail flags", (_t2[4] & 0xf0000000) if _t2 else None,
1679:          0x80000000, "DISC"),
1680:         ("A cclean2 tail r0", _t2[0] if _t2 else None, 0x9140, "PIN"),
1681:         ("A cclean2 tail r1", _t2[1] if _t2 else None, 0xfffffff0, "PIN"),
