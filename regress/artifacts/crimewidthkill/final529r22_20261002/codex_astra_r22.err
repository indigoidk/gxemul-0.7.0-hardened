   1: #!/usr/bin/env python3
   2: """manifest529.py -- the check_probe_wiring.py MANIFEST lines #529's commit owes: one per .py file under
   3: regress/artifacts/crimewidthkill/ that no line names yet (derived from the tree, never listed by hand), plus the
   4: detector entry's stale description (141 rows / killtable8 / pin 141) corrected to the shipped probe.
   5: 
   6: usage: manifest529.py <checker.py> [--write]      (prints the plan; --write edits the named file in place)
   7: 
   8: CLASS: a FROZEN instrument or a measuring seat's script is RESEARCH (preserved evidence, #471's class; #501's precedent
   9: for a seat's witnesses and mutators); a main-loop mutator, scorer or builder is TOOL, as the existing #529 lines class
  10: them.  The checker refuses *_probe.py / *_witness.py as TOOL, so those are RESEARCH whatever their role.  The
  11: description is the file's own docstring (first sentence), so it cannot drift from what the file says it is."""
  12: import io, os, re, sys
  13: 
  14: SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
  15: REG = os.path.join(SEC, "regress")
  16: ROOT = "artifacts/crimewidthkill/"
  17: SEAT_DIRS = ("opus_", "opus_adj_work/", "opus_pass1_work/", "/opus_f2/")
  18: TOOL_NAMES = re.compile(r"^(mutants[\w.]*|check[\w]*|mk_[\w]*|build_[\w.]*|nameorder|rowexpand|regcensus)\.py$")
  19: 
  20: 
  21: def doc(path):
  22:     s = io.open(path, encoding="utf-8", errors="replace").read()
  23:     m = re.search(r'[rR]?"""(.*?)"""', s, re.S)
  24:     t = (m.group(1) if m else "").strip()
  25:     t = " ".join(t.split())
  26:     t = re.split(r"(?<=[.!?])\s", t, 1)[0] if t else "(no docstring)"
  27:     return t.replace('"', "'")[:150]
  28: 
  29: 
  30: def plan(checker_text):
  31:     out = []
  32:     for d, _, files in os.walk(os.path.join(REG, *ROOT.rstrip("/").split("/"))):
  33:         for f in sorted(files):
  34:             if not f.endswith(".py"):
  35:                 continue
  36:             rel = os.path.relpath(os.path.join(d, f), REG).replace(os.sep, "/")
  37:             if '"%s"' % rel in checker_text:
  38:                 continue
  39:             base = os.path.basename(rel)
  40:             seat = any(s in rel for s in SEAT_DIRS)
  41:             frozen = ".frozen" in base or base.startswith("crime_width_probe.")
  42:             is_tool = (not seat and not frozen and TOOL_NAMES.match(base)
  43:                        and not base.endswith(("_probe.py", "_witness.py")))
  44:             cls = "CLASS_TOOL" if is_tool else "CLASS_RESEARCH"
  45:             who = "the Opus measuring seat's" if seat else ("the frozen instrument a table or base leg ran" if frozen else "the main loop's")
  46:             out.append((rel, cls, "#529 %s %s: %s" % (rel.split("/")[2], who, doc(os.path.join(d, f)))))
  47:     return sorted(out)
  48: 
  49: 
  50: def main():
  51:     if len(sys.argv) < 2:
  52:         sys.exit(__doc__)
  53:     p = sys.argv[1]
  54:     s = io.open(p, encoding="utf-8", newline="").read()
  55:     rows = plan(s)
