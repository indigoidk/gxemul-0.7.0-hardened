    c += ["print cause"]
    x, _ = ld(A, "lb", CRIME + off, "a0"); c += x
    c += ["print cause"]
    x, _ = st(A, "sb", CRIME + off, 0xff); c += x
    c += ["print cause"]
    x, _ = ld(A, "lh", CRIME + off, "a1"); c += x
