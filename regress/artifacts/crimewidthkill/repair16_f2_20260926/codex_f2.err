        x, _ = st(A, op, CRIME + 0x08, 0x800)
        c += x
    c += roundtrip(A)
    t, clean = session(c)
    return (pr(t, "v1"), (t.count("-- declined.") if clean else "unclean"),
            count(t, "CRIME_CONTROL: unimplemented", clean))


