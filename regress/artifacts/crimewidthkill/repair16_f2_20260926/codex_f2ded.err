329: **E6 -- every session holding an accepted 0x800 write before repair 16** (`sw08 halts', and `rst 4w'/`rst 8w' via `rst_session'):
330: 
331: ```python
332: x, _ = st(A, "sw", CRIME + 0x08, 0x0800)
333: t, clean = session(x + AFTER + roundtrip(A))
334: row("sw08 halts", pr(t, "v1"), "0x%x" % SENT, "CONTROL: sw 0x800 +0x08 stops CPUs (crimectllane)")
335: 
336: ...
337: def rst_session(op):
338:     """a refused lb sets the latch; then an accepted `op' of 0x800 at CONTROL stops every CPU (or does not).  #529
339:     repair 16: an accepted `op' of 0x0001 runs FIRST, with the latch CLEAR -- one CONTROL text, the text channel's
340:     in-session liveness half -- and the CONTROL-text count is returned: the 0x800 write's residue, latch SET."""
341:     A = Addr(CODE)
342:     c = []
343:     if op is not None:
344:         x, _ = st(A, op, CRIME + 0x08, 0x0001)
345:         c += x
346:     x, _ = ld(A, "lb", CRIME + 0x07, "v0")
347:     c += x
348:     if op is not None:
349:         x, _ = st(A, op, CRIME + 0x08, 0x800)
350:         c += x
351:     c += roundtrip(A)
352:     t, clean = session(c)
353:     return (pr(t, "v1"), (t.count("-- declined.") if clean else "unclean"),
354:             count(t, "CRIME_CONTROL: unimplemented", clean))
355: 
356: 
357: _rv, _rn, _rm = rst_session(None)
358: row("rst alive", _rv, "0x%x" % LIVE_VAL,
359:     "CONTROL: with NO 0x800 write the RAM round trip completes -- the halt oracle is live, not stuck")
360: row("rst alive once", _rn, 1, "CONTROL: the control session refused exactly once")
361: for _op, _w in (("sw", 4), ("sd", 8)):
362:     _rv, _rn, _rm = rst_session(_op)
363:     row("rst %dw" % _w, _rv, "0x%x" % SENT,
364:         "*** accepted %s 0x800 at CONTROL with the latch SET stops every CPU: the round trip after it does "
365:         "not run, so v1 keeps the SENTINEL (absent would mean the HOST died -- a different outcome) ***"
366: ```
