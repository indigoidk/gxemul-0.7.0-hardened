419: import os, pty, re, select, signal, sys, time
420: 
421: BIN = sys.argv[1]
422: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
423: DUMMY = "/tmp/dummy_crimep.bin"
424: if not os.path.exists(DUMMY):
425:     with open(DUMMY, "wb") as f:
426:         f.write(b"\0" * 16)
427: 
428: CODE = 0x80001000
429: SCRATCH_RAM = 0xa0001800
430: LIVE_VAL = 0x12345678
431: CRIME = 0xb4000000
432: SENT = 0xdeadbeef
433: RA = 0x80004000
434: PROBE_PC = 0xbfc05180           # inside the CRIME_REV hack's window, (pc & 0xffffff00) == 0xbfc05100
435: 
436: R = {"zero": 0, "at": 1, "v0": 2, "v1": 3, "a0": 4, "a1": 5, "a2": 6, "a3": 7, "t0": 8, "t1": 9,
437:      "s0": 16, "s1": 17, "s2": 18, "s3": 19, "s4": 20, "ra": 31}
438: OPC = {"lb": 0x20, "lh": 0x21, "lw": 0x23, "lbu": 0x24, "lhu": 0x25, "ld": 0x37,
439:        "sb": 0x28, "sh": 0x29, "sw": 0x2b, "sd": 0x3f}
440: OP_B_SELF = 0x1000ffff
441: OP_NOP = 0
442: 
443: 
444: def enc(op, rs, rt, imm=0):
445:     return (OPC[op] << 26) | (R[rs] << 21) | (R[rt] << 16) | (imm & 0xffff)
446: 
447: 
448: #  hand-assembled encodings checked against the committed witness's constants (a wrong register field reads 0, which
449: #  a decline's own answer would accept by accident -- so the accept rows carry nonzero wants)
450: assert enc("lb", "at", "v0") == 0x80220000 and enc("lhu", "at", "v0") == 0x94220000
451: assert enc("sb", "a3", "t0") == 0xa0e80000 and enc("sh", "a3", "t0") == 0xa4e80000
452: assert enc("sw", "a3", "t0") == 0xace80000 and enc("lw", "at", "v0") == 0x8c220000
453: #  #529 repair 14 (L1 fix): s4 is register 20 and was added for the CONTROL-pair rows, whose first form read
454: #  a3 -- the register st() uses to hold its ADDRESS -- so six later stores clobbered it and the base leg
455: #  scored 202/204.  A wrong register field reads 0, and 0 is what a DECLINE answers, so the encoding is
456: #  pinned here rather than trusted.
457: assert enc("lw", "at", "s4") == 0x8c340000
458: 
459: rows = []
460: 
461: 
462: def row(name, got, want, note=""):
463:     ok = (got == want)
464:     rows.append((name, ok))
465:     print("%-16s %-20s %-20s %-40s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
466:     sys.stdout.flush()
467: 
468: 
469: def session(cmds, settle=1.5, spin=1.2):
470:     """one emulator, read to the pty's EOF after `quit'.  Returns (text, clean): clean = EOF reached AND exit 0."""
471:     pid, fd = pty.fork()
472:     if pid == 0:
473:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64", "0x80001000:" + DUMMY])
474:         os._exit(127)
475:     buf = ""
476: 
477:     def rd(t):
478:         nonlocal buf
479:         end = time.time() + t
480:         while time.time() < end:
481:             r, _, _ = select.select([fd], [], [], 0.1)
482:             if not r:
483:                 continue
484:             try:
485:                 d = os.read(fd, 65536)
486:             except OSError:
487:                 return False
488:             if not d:
489:                 return False
490:             buf += d.decode("latin-1", "replace")
491:         return True
492: 
493:     rd(settle)
494:     for i, c in enumerate(cmds):
495:         try:
496:             if c == "<RUN>":        # free-run: `continue', let the guest run, then break back in with CTRL-C
497:                 os.write(fd, b"continue\n")
498:                 ok = rd(2.0)
499:                 os.write(fd, b"\x03")
500:                 ok = ok and rd(1.5)
501:             else:
502:                 os.write(fd, (c + "\n").encode("latin-1"))
503:                 ok = rd(spin if i == len(cmds) - 1 else 0.25)
504:         except OSError:
505:             break
506:         if not ok:
507:             break
508:     eof = True                      # a process already gone before `quit' has closed the pty; its status says how
509:     try:
510:         os.write(fd, b"quit\n")
511:         eof = not rd(10.0)          # to EOF, so anything printed on the way out is in the transcript
512:     except OSError:
513:         pass
514:     if not eof:
515:         try:
1207: #  is outside the de-escalation class (the deleted exit(1) would not have announced it either) and is DISCLOSED by class
1208: #  in item 6; these VALUE rows carry the cells where such a bypass is GUEST-VISIBLE, derived per cell from the switch and
1209: #  the width arm (the flagship ruling: from the enumeration, never from the mutants that happened to be built):
1210: #    REV window 4W/8W/8R, CONTROL 8R/8W, INTSTAT 8W/8R/4W, INTMASK 4W, TIME 8W, the default arm's 4W/4R at +0x40.
1211: #  The other ACCEPTS cells are either pinned elsewhere or EQUIVALENT when bypassed (item 6).
1212: #  REV window: CHANNEL = the PROM-probe redirect (pc = ra), which only an ACCEPTED access reaches.
1213: A = Addr(CODE)
1214: c = ["ra=0x%x" % RA]
1215: x, _ = st(A, "sw", CRIME + 0, 0, at=PROBE_PC); c += x + ["print pc"]
1216: x, _ = st(A, "sd", CRIME + 0, 0, at=PROBE_PC); c += x + ["print pc"]
1217: x, _ = ld(A, "ld", CRIME + 0, "s0", at=PROBE_PC); c += x + ["print pc"]
1218: t, clean = session(c)
1219: for i, k in enumerate(("sw", "sd", "ld")):
1220:     v = nth(t, "pc", i)
