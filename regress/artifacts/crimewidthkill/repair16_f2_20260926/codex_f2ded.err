elif name == "L_rstclr":
    sub(RST_CLEAR,
        ("\t\t\t\t\tcpu->machine->cpus[j]->running = 0;\n"
         "\n"
         "\t\t\t\tif (!(d->warned & CRIME_W_LEN))\n"
         "\t\t\t\t\tidata &= ~CRIME_CONTROL_HARD_RESET;\n"
