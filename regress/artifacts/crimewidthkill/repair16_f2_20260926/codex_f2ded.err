166: 		if (writeflag == MEM_WRITE) {
167: 			/*
168: 			 *  0x200 = watchdog timer (according to NetBSD)
169: 			 *  0x800 = "reboot" used by the IP32 PROM
170: 			 */
171: 			if (idata & CRIME_CONTROL_DOG_ENABLE) {
172: 				idata &= ~CRIME_CONTROL_DOG_ENABLE;
173: 			}
174: 			if (idata & CRIME_CONTROL_HARD_RESET) {
175: 				int j;
176: 
177: 				/*  This is used by the IP32 PROM's
178: 				    "reboot" command:  */
179: 				for (j=0; j<cpu->machine->ncpus; j++)
180: 					cpu->machine->cpus[j]->running = 0;
181: 
182: 				idata &= ~CRIME_CONTROL_HARD_RESET;
183: 			}
184: 
185: 			idata &= ~CRIME_CONTROL_ENDIANESS;
186: 
187: 			if (idata != 0)
188: 				fatal("[ CRIME_CONTROL: unimplemented "
189: 				    "control 0x%016llx ]\n", (long long)idata);
190: 		}
191: 		break;
192: 
193: ```
194: 
195: **E2 -- the INTSTAT/INTMASK session and its first four rows** (every 1-byte read at +0x10/+0x18 in the probe is the `lb' here -- the session's FIRST refusal -- or a free-running announce session's only refusal):
196: 
197: ```python
198: for lbl, off in (("imask", 0x18), ("istat", 0x10)):
199:     A = Addr(CODE)
200:     c = []
201:     x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x
202:     x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
203:     c += ["print cause"]
204:     x, _ = ld(A, "lb", CRIME + off, "a0"); c += x
205:     c += ["print cause"]
206:     x, _ = st(A, "sb", CRIME + off, 0xff); c += x
207:     c += ["print cause"]
208:     x, _ = ld(A, "lh", CRIME + off, "a1"); c += x
209:     c += ["print cause"]
210:     x, _ = st(A, "sh", CRIME + off, 0xffff); c += x
211:     c += ["print cause"]
212:     x, _ = ld(A, "lw", CRIME + off, "v0"); c += x
213:     c += ["print cause", "print a0", "print a1"]
214:     #  INTMASK read back by an accepted ld after the refused stores (kimi CLI, second closing pass: a landing that ORs
215:     #  into INTMASK keeps bit 28, so the reassert rows cannot see it), then a follow-up refusal at ANOTHER label (codex:
216:     #  a latch keyed on this one label is invisible to a session that refuses only here)
217:     x, _ = ld(A, "ld", CRIME + 0x18, "s2"); c += x
218:     x, _ = ld(A, "lb", CRIME + 0x07, "t1"); c += x
219:     c += ["print s2"]
220:     t, clean = session(c)
221:     row("%s pre" % lbl, ip2(nth(t, "cause", 0)), "clear", "IP2 low after SOFTINT's default-arm store")
222:     row("%s lb" % lbl, ip2(nth(t, "cause", 1)), "clear", "refused lb +0x%x: no reassert" % off)
223:     row("%s sb" % lbl, ip2(nth(t, "cause", 2)), "clear", "refused sb +0x%x: no reassert" % off)
224:     row("%s lh" % lbl, ip2(nth(t, "cause", 3)), "clear", "refused lh +0x%x: no reassert" % off)
225: ```
226: 
227: **E3 -- ACCEPTS, the re-arm session (each accepted entry followed by a refusal -- so entries after the first run with the latch SET), and the latch session (every entry BEFORE the first refusal -- latch CLEAR)**:
228: 
229: ```python
230: ACCEPTS = (("sd", 0x00, 0), ("ld", 0x00, 0), ("sw", 0x00, 0), ("lw", 0x00, 0),
231:            ("lwP", 0x00, 0), ("swP", 0x00, 0), ("sdP", 0x00, 0),
232:            ("lw", 0x08, 0), ("ld", 0x08, 0),
233:            ("sw", 0x08, 0x0201), ("sw", 0x08, 0x0001), ("sw", 0x08, 0), ("sw", 0x08, 0x0200),
234:            ("sd", 0x08, 0x0201), ("sd", 0x08, 0x0001), ("sd", 0x08, 0), ("sd", 0x08, 0x0200),
235:            ("sd", 0x10, 0), ("ld", 0x10, 0), ("sw", 0x10, 0), ("lw", 0x10, 0),
236:            ("sd", 0x18, 0), ("ld", 0x18, 0), ("sw", 0x18, 0), ("lw", 0x18, 0),
237:            ("sd", 0x30, 0), ("ld", 0x30, 0), ("sw", 0x30, 0), ("lw", 0x30, 0),
238:            ("sd", 0x38, 0), ("ld", 0x38, 0), ("sw", 0x38, 0), ("lw", 0x38, 0),
239:            ("sd", 0x40, 0), ("ld", 0x40, 0), ("sw", 0x40, 0), ("lw", 0x40, 0),
240:            ("sw", 0x34, 0x0badcafe), ("lw", 0x34, 0), ("sw", 0x04, 0), ("lw", 0x04, 0),
241:            ("ldP", 0x00, 0), ("sw", 0x08, 0x0100), ("sd", 0x08, 0x0100),
242:            ("sd", 0x278, 0), ("ld", 0x278, 0))
243: KINDS = ACCEPTS
244: 
245: ...
246: for op, off, val in KINDS:
247:     c += accept(A, op, off, val)
248:     x, _ = ld(A, "lb", CRIME + 0x06, "v0"); c += x
249: t, clean = session(c + roundtrip(A))
250: row("rearm once", count(t, "-- declined.", clean), 1, "%d refusals, %d accepted kinds between: one notice"
251:     % (len(KINDS) + 1, len(KINDS)))
252: row("rearm surv", pr(t, "v1"), "0x%x" % LIVE_VAL, "the whole interleave completes (a RAM trip)")
253: 
254: ...
255: # ---- the latch: five refused accesses, one session, exactly one announce ----
256: A = Addr(CODE)
257: c = ["ra=0x%x" % RA]
258: #  PROLOGUE (the Opus closing seat): accepted accesses BEFORE the first refusal -- a notice PRE-SILENCED by an accepted
259: #  access (`d->warned |= CRIME_W_LEN;' in an accept arm, `pre4') shows as zero notices; and an accepted CONTROL write
260: #  whose unmodelled bit prints the CONTROL text, so a future second latch on THAT message reusing bit 0 (`ctl_collide')
261: #  shows the same way.  CLOSED OVER EVERY ARM AND EVERY BRANCH an accepted access can take and come back from (glm,
262: #  second closing pass: the REV arm; codex, grok, kimi, third closing pass: CONTROL's DOG_ENABLE branch -- the 0x01 write
263: #  here skipped it -- the REV redirect branch, and the INTSTAT case alone -- each reached only AFTER some session's
264: #  first refusal, where a pre-set is invisible):
265: #      CONTROL  sw 0x0201 (DOG set, leftover nonzero), sw 0x0001 (DOG clear, leftover nonzero), sw 0 (DOG clear,
266: #               leftover zero), lw (CONTROL's read side) -- the Opus third-closing seat, measured: a pre-set on the
267: #               read side, and (by reading) on the zero-leftover side, passed; HARD_RESET is disclosed (it stops the CPUs)
268: #      REV      lw from the PROM-probe window (the redirect branch) AND from ordinary code (the branch not taken)
269: #      INTSTAT, INTMASK   lw +0x10, lw +0x18        DOG  ld +0x30        TIME  ld +0x38
270: #      default  sw/lw +0x34 (4-byte, low lane), sd +0x278 (8-byte, far block)
271: #  *** Since the fourth closing pass the prologue IS the re-arm list, ACCEPTS (the kind x label cross): the Opus seat
272: #  measured a pre-set on an accepted 8-byte WRITE at +0x10, and one on CONTROL's 0x0200 cell, each 131/131. ***
273: for op, off, val in ACCEPTS:
274:     c += accept(A, op, off, val, reg="a2")
275: #  lh FIRST (Opus seat, F2): a latch whose bit is taken from the access -- `d->warned |= len' or `|= relative_addr' --
276: #  sets bit 0 only for a 1-byte access or an odd address, so the lh at +0x06 would leave it clear and the lb after it
277: #  would announce again.  With lb first, both shapes passed.
278: for op, off in (("lh", 6), ("lb", 7), ("lbu", 0x3f)):
279:     x, _ = ld(A, op, CRIME + off, "v0"); c += x
280: for op, off, val in (("sb", 0x37, 0xab), ("sh", 0x36, 0xabcd)):
281:     x, _ = st(A, op, CRIME + off, val); c += x
282: #  and refusals at CRIME_REV and CRIME_TIME AFTER the latch is set (the Opus third-closing seat, measured: a latch TEST
283: #  that lets one label through -- `|| relative_addr == CRIME_REV' -- passed, because REV and TIME were each refused only
284: #  once per session, first; every other label is refused again after the latch is set somewhere)
285: for off in (0x00, 0x38):
286:     x, _ = ld(A, "lb", CRIME + off, "v0"); c += x
287: t, clean = session(c + roundtrip(A))
288: row("latch x5", count(t, "-- declined.", clean), 1, "5 refused accesses, then +0x00, +0x38 -> one (once)")
289: row("latch surv", pr(t, "v1"), "0x%x" % LIVE_VAL, "host survives all five")
290: ```
291: 
292: **E4 -- `said()`**:
293: 
294: ```python
295: def said(t, ln, off, clean):
296:     """the whole announce, `(once)' marker included -- a reworded or unmarked announce reads 0"""
297:     return count(t, "unimplemented len=%d at 0x%x -- declined.  (once) ]" % (ln, off), clean)
298: 
299: 
300: ```
