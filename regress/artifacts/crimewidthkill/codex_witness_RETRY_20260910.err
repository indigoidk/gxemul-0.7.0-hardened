   27:  *
   28:  *  Functions for handling the memory of an emulated machine.
   29:  */
   30: 
   31: #include <stdio.h>
   32: #include <stdlib.h>
   33: #include <string.h>
   34: #include <sys/types.h>
   35: #include <sys/mman.h>
   36: 
   37: #include "cpu.h"
   38: #include "machine.h"
   39: #include "memory.h"
   40: #include "misc.h"
   41: 
   42: 
   43: extern int verbose;
   44: extern int quiet_mode;
   45: 
   46: 
   47: /*
   48:  *  memory_readmax64():
   49:  *
   50:  *  Read at most 64 bits of data from a buffer.  Length is given by
   51:  *  len, and the byte order by cpu->byte_order.
   52:  *
   53:  *  This function should not be called with cpu == NULL.
   54:  */
   55: uint64_t memory_readmax64(struct cpu *cpu, unsigned char *buf, int len)
   56: {
   57: 	int i, byte_order = cpu->byte_order;
   58: 	uint64_t x = 0;
   59: 
   60: 	if (len & MEM_PCI_LITTLE_ENDIAN) {
   61: 		len &= ~MEM_PCI_LITTLE_ENDIAN;
   62: 		byte_order = EMUL_LITTLE_ENDIAN;
   63: 	}
   64: 
   65: 	/*  Switch byte order for incoming data, if necessary:  */
   66: 	if (byte_order == EMUL_BIG_ENDIAN)
   67: 		for (i=0; i<len; i++) {
   68: 			x <<= 8;
   69: 			x |= buf[i];
   70: 		}
   71: 	else
   72: 		for (i=len-1; i>=0; i--) {
   73: 			x <<= 8;
   74: 			x |= buf[i];
   75: 		}
   76: 
   77: 	return x;
   78: }
   79: 
   80: 
   81: /*
   82:  *  memory_writemax64():
   83:  *
   84:  *  Write at most 64 bits of data to a buffer.  Length is given by
   85:  *  len, and the byte order by cpu->byte_order.
   86:  *
   87:  *  This function should not be called with cpu == NULL.
   88:  */
   89: void memory_writemax64(struct cpu *cpu, unsigned char *buf, int len,
   90: 	uint64_t data)
   91: {
   92: 	int i, byte_order = cpu->byte_order;
   93: 
   94: 	if (len & MEM_PCI_LITTLE_ENDIAN) {
   95: 		len &= ~MEM_PCI_LITTLE_ENDIAN;
   96: 		byte_order = EMUL_LITTLE_ENDIAN;
   97: 	}
   98: 
   99: 	if (byte_order == EMUL_LITTLE_ENDIAN)
  100: 		for (i=0; i<len; i++) {
  101: 			buf[i] = data & 255;
  102: 			data >>= 8;
  103: 		}
  104: 	else
  105: 		for (i=0; i<len; i++) {
  106: 			buf[len - 1 - i] = data & 255;
  107: 			data >>= 8;
  108: 		}
  109: }
  110: 
  111: 
  112: /*
  113:  *  zeroed_alloc():
  114:  *
  115:  *  Allocates a block of memory using mmap(), and if that fails, try
  116:  *  malloc() + memset(). The returned memory block contains only zeroes.
  117:  */
  118: void *zeroed_alloc(size_t s)
  119: {
  120: 	void *p = mmap(NULL, s, PROT_READ | PROT_WRITE,
  121: 	    MAP_ANON | MAP_PRIVATE, -1, 0);
  122: 
  123: 	/*  #175: (Codex/Fable) mmap failure is MAP_FAILED, not NULL  */
  124: 	if (p == MAP_FAILED) {
  125: #if 1
  126: 		fprintf(stderr, "zeroed_alloc(): mmap() failed. This should"
  127: 		    " not usually happen. If you can reproduce this, then"
  128: 		    " please contact me with details about your run-time"
  129: 		    " environment.\n");
  130: 		exit(1);
  131: #else
  132: 		CHECK_ALLOCATION(p = malloc(s));
  133: 		memset(p, 0, s);
  134: #endif
  135: 	}
  136: 
  137: 	return p;
  138: }
  139: 
  140: 
  141: /*
  142:  *  memory_new():
  143:  *
  144:  *  This function creates a new memory object. An emulated machine needs one
  145:  *  of these.
  146:  */
  147: struct memory *memory_new(uint64_t physical_max)
  148: {
  149: 	struct memory *mem;
  150: 	int bits_per_pagetable = BITS_PER_PAGETABLE;
  151: 	int bits_per_memblock = BITS_PER_MEMBLOCK;
  152: 	int entries_per_pagetable = 1 << BITS_PER_PAGETABLE;
  153: 	int max_bits = MAX_BITS;
  154: 	size_t s;
  155: 
  156: 	CHECK_ALLOCATION(mem = (struct memory *) malloc(sizeof(struct memory)));
  157: 	memset(mem, 0, sizeof(struct memory));
  158: 
  159: 	/*  Check bits_per_pagetable and bits_per_memblock for sanity:  */
  160: 	if (bits_per_pagetable + bits_per_memblock != max_bits) {
  161: 		fprintf(stderr, "memory_new(): bits_per_pagetable and "
  162: 		    "bits_per_memblock mismatch\n");
  163: 		exit(1);
  164: 	}
  165: 
  166: 	mem->physical_max = physical_max;
  167: 	mem->dev_dyntrans_alignment = 4095;
  168: 
  169: 	s = entries_per_pagetable * sizeof(void *);
  170: 
  171: 	mem->pagetable = (unsigned char *) mmap(NULL, s,
  172: 	    PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
  173: 	/*  #175: (Codex/Fable) mmap failure is MAP_FAILED, not NULL  */
  174: 	if (mem->pagetable == MAP_FAILED) {
  175: 		CHECK_ALLOCATION(mem->pagetable = malloc(s));
  176: 		memset(mem->pagetable, 0, s);
  177: 	}
  178: 
  179: 	mem->mmap_dev_minaddr = 0xffffffffffffffffULL;
  180: 	mem->mmap_dev_maxaddr = 0;
  181: 
  182: 	return mem;
  183: }
  184: 
  185: 
  186: /*
  187:  *  memory_points_to_string():
  188:  *
  189:  *  Returns 1 if there's something string-like in emulated memory at address
  190:  *  addr, otherwise 0.
  191:  */
  192: int memory_points_to_string(struct cpu *cpu, struct memory *mem, uint64_t addr,
  193: 	int min_string_length)
  194: {
  195: 	int cur_length = 0;
  196: 	unsigned char c;
  197: 
  198: 	for (;;) {
  199: 		c = '\0';
  200: 		cpu->memory_rw(cpu, mem, addr+cur_length,
  201: 		    &c, sizeof(c), MEM_READ, CACHE_NONE | NO_EXCEPTIONS);
  202: 		if (c=='\n' || c=='\t' || c=='\r' || (c>=' ' && c<127)) {
  203: 			cur_length ++;
  204: 			if (cur_length >= min_string_length)
  205: 				return 1;
  206: 		} else {
  207: 			if (cur_length >= min_string_length)
  208: 				return 1;
  209: 			else
  210: 				return 0;
  211: 		}
  212: 	}
  213: }
  214: 
  215: 
  216: /*
  217:  *  memory_conv_to_string():
  218:  *
  219:  *  Convert emulated memory contents to a string, placing it in a buffer
  220:  *  provided by the caller.
  221:  */
  222: char *memory_conv_to_string(struct cpu *cpu, struct memory *mem, uint64_t addr,
  223: 	char *buf, int bufsize)
  224: {
  225: 	int len = 0;
  226: 	int output_index = 0;
  227: 	unsigned char c, p='\0';
  228: 
  229: 	while (output_index < bufsize-1) {
  230: 		c = '\0';
  231: 		cpu->memory_rw(cpu, mem, addr+len, &c, sizeof(c), MEM_READ,
  232: 		    CACHE_NONE | NO_EXCEPTIONS);
  233: 		buf[output_index] = c;
  234: 		if (c>=' ' && c<127) {
  235: 			len ++;
  236: 			output_index ++;
  237: 		} else if (c=='\n' || c=='\r' || c=='\t') {
  238: 			len ++;
  239: 			buf[output_index] = '\\';
  240: 			output_index ++;
  241: 			switch (c) {
  242: 			case '\n':	p = 'n'; break;
  243: 			case '\r':	p = 'r'; break;
  244: 			case '\t':	p = 't'; break;
  245: 			}
  246: 			if (output_index < bufsize-1) {
  247: 				buf[output_index] = p;
  248: 				output_index ++;
  249: 			}
  250: 		} else {
  251: 			buf[output_index] = '\0';
  252: 			return buf;
  253: 		}
  254: 	}
  255: 
  256: 	buf[bufsize-1] = '\0';
  257: 	return buf;
  258: }
  259: 
  260: 
  261: /*
  262:  *  memory_device_dyntrans_access():
  263:  *
  264:  *  Get the lowest and highest dyntrans access since last time.
  265:  */
  266: void memory_device_dyntrans_access(struct cpu *cpu, struct memory *mem,
  267: 	void *extra, uint64_t *low, uint64_t *high)
  268: {
  269: 	size_t s;
  270: 	int i, need_inval = 0;
  271: 
  272: 	/*  TODO: This is O(n), so it might be good to rewrite it some day.
  273: 	    For now, it will be enough, as long as this function is not
  274: 	    called too often.  */
  275: 
  276: 	for (i=0; i<mem->n_mmapped_devices; i++) {
  277: 		if (mem->devices[i].extra == extra &&
  278: 		    mem->devices[i].flags & DM_DYNTRANS_WRITE_OK &&
  279: 		    mem->devices[i].dyntrans_data != NULL) {
  280: 			if (mem->devices[i].dyntrans_write_low != (uint64_t) -1)
  281: 				need_inval = 1;
  282: 			if (low != NULL)
  283: 				*low = mem->devices[i].dyntrans_write_low;
  284: 			mem->devices[i].dyntrans_write_low = (uint64_t) -1;
  285: 
  286: 			if (high != NULL)
  287: 				*high = mem->devices[i].dyntrans_write_high;
  288: 			mem->devices[i].dyntrans_write_high = 0;
  289: 
  290: 			if (!need_inval)
  291: 				return;
  292: 
  293: 			/*  Invalidate any pages of this device that might
  294: 			    be in the dyntrans load/store cache, by marking
  295: 			    the pages read-only.  */
  296: 			if (cpu->invalidate_translation_caches != NULL) {
  297: 				for (s = *low; s <= *high;
  298: 				    s += cpu->machine->arch_pagesize)
  299: 					cpu->invalidate_translation_caches
  300: 					    (cpu, mem->devices[i].baseaddr + s,
  301: 					    JUST_MARK_AS_NON_WRITABLE
  302: 					    | INVALIDATE_PADDR);
  303: 			}
  304: 
  305: 			return;
  306: 		}
  307: 	}
  308: }
  309: 
  310: 
  311: /*
  312:  *  memory_device_update_data():
  313:  *
  314:  *  Update a device' dyntrans data pointer.
  315:  *
  316:  *  SUPER-IMPORTANT NOTE: Anyone who changes a dyntrans data pointer while
  317:  *  things are running also needs to invalidate all CPUs' address translation
  318:  *  caches!  Otherwise, these may contain old pointers to the old data.
  319:  */
  320: void memory_device_update_data(struct memory *mem, void *extra,
  321: 	unsigned char *data)
  322: {
  323: 	int i;
  324: 
  325: 	for (i=0; i<mem->n_mmapped_devices; i++) {
  326: 		if (mem->devices[i].extra != extra)
  327: 			continue;
  328: 
  329: 		mem->devices[i].dyntrans_data = data;
  330: 		mem->devices[i].dyntrans_write_low = (uint64_t)-1;
  331: 		mem->devices[i].dyntrans_write_high = 0;
  332: 	}
  333: }
  334: 
  335: 
  336: /*
  337:  *  memory_device_update_length():
  338:  *
  339:  *  #182: (Codex/Fable) Update a memory-mapped device's registered length
  340:  *  (and endaddr) when its backing buffer is resized at runtime, e.g. a
  341:  *  guest-driven framebuffer shrink via dev_fb_resize().
  342:  *
  343:  *  memory_device_update_data() only swaps the data pointer. Without also
  344:  *  shrinking the registered length, the dyntrans fast-map gate in
  345:  *  memory_rw.c still trusts the ORIGINAL (larger) length and installs a
  346:  *  writable host mapping past the end of the new, smaller allocation -->
  347:  *  guest-controlled out-of-bounds host access (CRITICAL). This is latent in
  348:  *  pristine upstream GXemul too.
  349:  *
  350:  *  SUPER-IMPORTANT NOTE: like memory_device_update_data(), the caller must
  351:  *  invalidate all CPUs' address translation caches afterwards, otherwise
  352:  *  stale fast-path host pointers derived from the old length may survive.
  353:  */
  354: void memory_device_update_length(struct memory *mem, void *extra,
  355: 	uint64_t newlength)
  356: {
  357: 	int i;
  358: 
  359: 	for (i=0; i<mem->n_mmapped_devices; i++) {
  360: 		uint64_t baseaddr;
  361: 		if (mem->devices[i].extra != extra)
  362: 			continue;
  363: 
  364: 		baseaddr = mem->devices[i].endaddr - mem->devices[i].length;
  365: 		mem->devices[i].length = newlength;
  366: 		mem->devices[i].endaddr = baseaddr + newlength;
  367: 
  368: 		/*  Mirror memory_device_register()'s fast-path bound update so
  369: 		    that a grow stays reachable through the dyntrans window:  */
  370: 		if (baseaddr + newlength > mem->mmap_dev_maxaddr)
  371: 			mem->mmap_dev_maxaddr =
  372: 			    (((baseaddr + newlength) - 1) |
  373: 			    mem->dev_dyntrans_alignment) + 1;
  374: 	}
  375: }
  376: 
  377: 
  378: /*
  379:  *  memory_device_register():
  380:  *
  381:  *  Register a memory mapped device.
  382:  */
  383: void memory_device_register(struct memory *mem, const char *device_name,
  384: 	uint64_t baseaddr, uint64_t len,
  385: 	int (*f)(struct cpu *,struct memory *,uint64_t,unsigned char *,
  386: 		size_t,int,void *),
  387: 	void *extra, int flags, unsigned char *dyntrans_data)
  388: {
  389: 	int i, newi = 0;
  390: 
  391: 	/*
  392: 	 *  Figure out at which index to insert this device, and simultaneously
  393: 	 *  check for collisions:
  394: 	 */
  395: 	newi = -1;
  396: 	for (i=0; i<mem->n_mmapped_devices; i++) {
  397: 		if (i == 0 && baseaddr + len <= mem->devices[i].baseaddr)
  398: 			newi = i;
  399: 		if (i > 0 && baseaddr + len <= mem->devices[i].baseaddr &&
  400: 		    baseaddr >= mem->devices[i-1].endaddr)
  401: 			newi = i;
  402: 		if (i == mem->n_mmapped_devices - 1 &&
  403: 		    baseaddr >= mem->devices[i].endaddr)
  404: 			newi = i + 1;
  405: 
  406: 		/*  If this is not colliding with device i, then continue:  */
  407: 		if (baseaddr + len <= mem->devices[i].baseaddr)
  408: 			continue;
  409: 		if (baseaddr >= mem->devices[i].endaddr)
  410: 			continue;
  411: 
  412: 		fatal("\nERROR! \"%s\" collides with device %i (\"%s\")!\n",
  413: 		    device_name, i, mem->devices[i].name);
  414: 		exit(1);
  415: 	}
  416: 	if (mem->n_mmapped_devices == 0)
  417: 		newi = 0;
  418: 	if (newi == -1) {
  419: 		fatal("INTERNAL ERROR\n");
  420: 		exit(1);
  421: 	}
  422: 
  423: 	if (verbose >= 2) {
  424: 		/*  (40 bits of physical address is displayed)  */
  425: 		debug("device at 0x%010" PRIx64": %s", (uint64_t) baseaddr,
  426: 		    device_name);
  427: 
  428: 		if (flags & (DM_DYNTRANS_OK | DM_DYNTRANS_WRITE_OK)
  429: 		    && (baseaddr & mem->dev_dyntrans_alignment) != 0) {
  430: 			fatal("\nWARNING: Device dyntrans access, but unaligned"
  431: 			    " baseaddr 0x%" PRIx64".\n", (uint64_t) baseaddr);
  432: 		}
  433: 
  434: 		if (flags & (DM_DYNTRANS_OK | DM_DYNTRANS_WRITE_OK)) {
  435: 			debug(" (dyntrans %s)",
  436: 			    (flags & DM_DYNTRANS_WRITE_OK)? "R/W" : "R");
  437: 		}
  438: 		debug("\n");
  439: 	}
  440: 
  441: 	for (i=0; i<mem->n_mmapped_devices; i++) {
  442: 		if (dyntrans_data == mem->devices[i].dyntrans_data &&
  443: 		    mem->devices[i].flags&(DM_DYNTRANS_OK|DM_DYNTRANS_WRITE_OK)
  444: 		    && flags & (DM_DYNTRANS_OK | DM_DYNTRANS_WRITE_OK)) {
  445: 			fatal("ERROR: the data pointer used for dyntrans "
  446: 			    "accesses must only be used once!\n");
  447: 			fatal("(%p cannot be used by '%s'; already in use by '"
  448: 			    "%s')\n", dyntrans_data, device_name,
  449: 			    mem->devices[i].name);
  450: 			exit(1);
  451: 		}
  452: 	}
  453: 
  454: 	mem->n_mmapped_devices++;
  455: 
  456: 	CHECK_ALLOCATION(mem->devices = (struct memory_device *) realloc(mem->devices,
  457: 	    sizeof(struct memory_device) * mem->n_mmapped_devices));
  458: 
  459: 	/*  Make space for the new entry:  */
  460: 	if (newi + 1 != mem->n_mmapped_devices)
  461: 		memmove(&mem->devices[newi+1], &mem->devices[newi],
  462: 		    sizeof(struct memory_device)
  463: 		    * (mem->n_mmapped_devices - newi - 1));
  464: 
  465: 	CHECK_ALLOCATION(mem->devices[newi].name = strdup(device_name));
  466: 	mem->devices[newi].baseaddr = baseaddr;
  467: 	mem->devices[newi].endaddr = baseaddr + len;
  468: 	mem->devices[newi].length = len;
  469: 	mem->devices[newi].flags = flags;
  470: 	mem->devices[newi].dyntrans_data = dyntrans_data;
  471: 
  472: 	if (flags & (DM_DYNTRANS_OK | DM_DYNTRANS_WRITE_OK)
  473: 	    && !(flags & DM_EMULATED_RAM) && dyntrans_data == NULL) {
  474: 		fatal("\nERROR: Device dyntrans access, but dyntrans_data"
  475: 		    " = NULL!\n");
  476: 		exit(1);
  477: 	}
  478: 
  479: 	if ((size_t)dyntrans_data & (sizeof(void *) - 1)) {
  480: 		fprintf(stderr, "memory_device_register():"
  481: 		    " dyntrans_data not aligned correctly (%p)\n",
  482: 		    dyntrans_data);
  483: 		abort();
  484: 	}
  485: 
  486: 	mem->devices[newi].dyntrans_write_low = (uint64_t)-1;
  487: 	mem->devices[newi].dyntrans_write_high = 0;
  488: 	mem->devices[newi].f = f;
  489: 	mem->devices[newi].extra = extra;
  490: 
  491: 	if (baseaddr < mem->mmap_dev_minaddr)
  492: 		mem->mmap_dev_minaddr = baseaddr & ~mem->dev_dyntrans_alignment;
  493: 	if (baseaddr + len > mem->mmap_dev_maxaddr)
  494: 		mem->mmap_dev_maxaddr = (((baseaddr + len) - 1) |
  495: 		    mem->dev_dyntrans_alignment) + 1;
  496: 
  497: 	if (newi < mem->last_accessed_device)
  498: 		mem->last_accessed_device ++;
  499: }
  500: 
  501: 
  502: /*
  503:  *  memory_device_remove():
  504:  *
  505:  *  Unregister a memory mapped device from a memory object.
  506:  */
  507: void memory_device_remove(struct memory *mem, int i)
  508: {
  509: 	if (i < 0 || i >= mem->n_mmapped_devices) {
  510: 		fatal("memory_device_remove(): invalid device number %i\n", i);
  511: 		exit(1);
  512: 	}
  513: 
  514: 	mem->n_mmapped_devices --;
  515: 
  516: 	if (i == mem->n_mmapped_devices)
  517: 		return;
  518: 
  519: 	memmove(&mem->devices[i], &mem->devices[i+1],
  520: 	    sizeof(struct memory_device) * (mem->n_mmapped_devices - i));
  521: 
  522: 	if (i <= mem->last_accessed_device)
  523: 		mem->last_accessed_device --;
  524: 	if (mem->last_accessed_device < 0)
  525: 		mem->last_accessed_device = 0;
  526: }
  527: 
  528: 
  529: /*
  530:  *  memory_paddr_to_hostaddr():
  531:  *
  532:  *  Translate a physical address into a host address. The usual way to call
  533:  *  this function is to make sure that paddr is page aligned, which will result
  534:  *  in the host _page_ corresponding to that address.
  535:  *
  536:  *  Return value is a pointer to the address in the host, or NULL on failure.
  537:  *  On reads, a NULL return value should be interpreted as reading all zeroes.
  538:  */
  539: unsigned char *memory_paddr_to_hostaddr(struct memory *mem,
  540: 	uint64_t paddr, int writeflag)
  541: {
  542: 	void **table;
  543: 	int entry;
  544: 	const int mask = (1 << BITS_PER_PAGETABLE) - 1;
  545: 	const int shrcount = MAX_BITS - BITS_PER_PAGETABLE;
  546: 	unsigned char *hostptr;
  547: 
  548: 	table = (void **) mem->pagetable;
  549: 	entry = (paddr >> shrcount) & mask;
  550: 
  551: 	/*  printf("memory_paddr_to_hostaddr(): p=%16" PRIx64
  552: 	    " w=%i => entry=0x%x\n", (uint64_t) paddr, writeflag, entry);  */
  553: 
  554: 	if (table[entry] == NULL) {
  555: 		size_t alloclen;
  556: 
  557: 		/*
  558: 		 *  Special case:  reading from a nonexistant memblock
  559: 		 *  returns all zeroes, and doesn't allocate anything.
  560: 		 *  (If any intermediate pagetable is nonexistant, then
  561: 		 *  the same thing happens):
  562: 		 */
  563: 		if (writeflag == MEM_READ)
  564: 			return NULL;
  565: 
  566: 		/*  Allocate a memblock:  */
  567: 		alloclen = 1 << BITS_PER_MEMBLOCK;
  568: 
  569: 		/*  printf("  allocating for entry %i, len=%i\n",
  570: 		    entry, alloclen);  */
  571: 
  572: 		/*  Anonymous mmap() should return zero-filled memory,
  573: 		    try malloc + memset if mmap failed.  */
  574: 		table[entry] = (void *) mmap(NULL, alloclen,
  575: 		    PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
  576: 		/*  #175: (Codex/Fable) mmap failure is MAP_FAILED, not NULL  */
  577: 		if (table[entry] == MAP_FAILED) {
  578: 			CHECK_ALLOCATION(table[entry] = malloc(alloclen));
  579: 			memset(table[entry], 0, alloclen);
  580: 		}
  581: 	}
  582: 
  583: 	hostptr = (unsigned char *) table[entry];
  584: 
  585: 	if (hostptr != NULL)
  586: 		hostptr += (paddr & ((1 << BITS_PER_MEMBLOCK) - 1));
  587: 
  588: 	return hostptr;
  589: }
  590: 
  591: 
  592: /*
  593:  *  memory_warn_about_unimplemented_addr():
  594:  *
  595:  *  Called from memory_rw whenever memory outside of the physical address space
  596:  *  is accessed.
  597:  */
  598: bool memory_warn_about_unimplemented_addr(struct cpu *cpu, struct memory *mem,
  599: 	int writeflag, uint64_t paddr, size_t len)
  600: {
  601: 	/*
  602: 	 *  HACK: This allows guest OS kernels to probe memory a few KBs past
  603: 	 *  the end of memory, without giving too many warnings.
  604: 	 */
  605: 	if (paddr < mem->physical_max + 0x40000)
  606: 		return false;
  607: 
  608: 	int verbosity = VERBOSITY_WARNING;
  609: 	if (cpu->machine->halt_on_nonexistant_memaccess)
  610: 		verbosity = VERBOSITY_ERROR;
  611: 
  612: 	// ERROR is always "enough", so we will print in that case.
  613: 	if (!ENOUGH_VERBOSITY(SUBSYS_MEMORY, verbosity))
  614: 		return false;
  615: 
  616: 	uint64_t offset;
  617: 	char* symbol = get_symbol_name(&cpu->machine->symbol_context, cpu->pc, &offset);
  618: 
  619: 	// Not the prettiest, but should work fine.
  620: 	if (cpu->is_32bit)
  621: 		debugmsg_cpu(cpu, SUBSYS_MEMORY,
  622: 		    writeflag ? "WRITE" : "READ",
  623: 		    verbosity, "%s non-existant "
  624: 			"paddr=0x%08" PRIx32 " len=%i pc=0x%08" PRIx32 "%s%s%s",
  625: 		    writeflag ? "to" : "from",
  626: 		    (uint32_t) paddr,
  627: 		    len,
  628: 		    (uint32_t) cpu->pc,
  629: 		    symbol ? " <" : "",
  630: 		    symbol ? symbol : "",
  631: 		    symbol ? ">" : "");
  632: 	else
  633: 		debugmsg_cpu(cpu, SUBSYS_MEMORY,
  634: 		    writeflag ? "WRITE" : "READ",
  635: 		    verbosity, "%s non-existant "
  636: 			"paddr=0x%016" PRIx64 " len=%i pc=0x%016" PRIx64 "%s%s%s",
  637: 		    writeflag ? "to" : "from",
  638: 		    (uint64_t) paddr,
  639: 		    len,
  640: 		    (uint64_t) cpu->pc,
  641: 		    symbol ? " <" : "",
  642: 		    symbol ? symbol : "",
  643: 		    symbol ? ">" : "");
  644: 
  645: 	if (cpu->machine->halt_on_nonexistant_memaccess) {
  646: 		// Halt all CPUs, even though the bad memory access was on
  647: 		// just one of them.
  648: 		for (int i = 0; i < cpu->machine->ncpus; ++i)
  649: 			cpu->machine->cpus[i]->running = 0;
  650: 
  651: 		return true;
  652: 	}
  653: 
  654: 	return false;
  655: }
  656: 
  657: 
  658: /*
  659:  *  dump_mem_string():
  660:  *
  661:  *  Dump the contents of emulated RAM as readable text.  Bytes that aren't
  662:  *  readable are dumped in [xx] notation, where xx is in hexadecimal.
  663:  *  Dumping ends after DUMP_MEM_STRING_MAX bytes, or when a terminating
  664:  *  zero byte is found.
  665:  */
  666: #define DUMP_MEM_STRING_MAX	45
  667: void dump_mem_string(struct cpu *cpu, uint64_t addr)
  668: {
  669: 	int i;
  670: 	for (i=0; i<DUMP_MEM_STRING_MAX; i++) {
  671: 		unsigned char ch = '\0';
  672: 
  673: 		cpu->memory_rw(cpu, cpu->mem, addr + i, &ch, sizeof(ch),
  674: 		    MEM_READ, CACHE_DATA | NO_EXCEPTIONS);
  675: 		if (ch == '\0')
  676: 			return;
  677: 		if (ch >= ' ' && ch < 126)
  678: 			debug("%c", ch);  
  679: 		else
  680: 			debug("[%02x]", ch);
  681: 	}
  682: }
  683: 
  684: 
  685: /*
  686:  *  store_byte():
  687:  *
  688:  *  Stores a byte in emulated ram. (Helper function.)
  689:  */
  690: void store_byte(struct cpu *cpu, uint64_t addr, uint8_t data)
  691: {
  692: 	if ((addr >> 32) == 0)
  693: 		addr = (int64_t)(int32_t)addr;
  694: 	cpu->memory_rw(cpu, cpu->mem,
  695: 	    addr, &data, sizeof(data), MEM_WRITE, CACHE_DATA);
  696: }
  697: 
  698: 
  699: /*
  700:  *  store_string():
  701:  *
  702:  *  Stores chars into emulated RAM until a zero byte (string terminating
  703:  *  character) is found. The zero byte is also copied.
  704:  *  (strcpy()-like helper function, host-RAM-to-emulated-RAM.)
  705:  */
  706: void store_string(struct cpu *cpu, uint64_t addr, const char *s)
  707: {
  708: 	do {
  709: 		store_byte(cpu, addr++, *s);
  710: 	} while (*s++);
  711: }
  712: 
  713: 
  714: /*
  715:  *  add_environment_string():
  716:  *
  717:  *  Like store_string(), but advances the pointer afterwards. The most
  718:  *  obvious use is to place a number of strings (such as environment variable
  719:  *  strings) after one-another in emulated memory.
  720:  */
  721: void add_environment_string(struct cpu *cpu, const char *s, uint64_t *addr)
  722: {
  723: 	store_string(cpu, *addr, s);
  724: 	(*addr) += strlen(s) + 1;
  725: }
  726: 
  727: 
  728: /*
  729:  *  add_environment_string_dual():
  730:  *
  731:  *  Add "dual" environment strings, one for the variable name and one for the
  732:  *  value, and update pointers afterwards.
  733:  */
  734: void add_environment_string_dual(struct cpu *cpu,
  735: 	uint64_t *ptrp, uint64_t *addrp, const char *s1, const char *s2)
  736: {
  737: 	uint64_t ptr = *ptrp, addr = *addrp;
  738: 
  739: 	store_32bit_word(cpu, ptr, addr);
  740: 	ptr += sizeof(uint32_t);
  741: 	if (addr != 0) {
  742: 		store_string(cpu, addr, s1);
  743: 		addr += strlen(s1) + 1;
  744: 	}
  745: 	store_32bit_word(cpu, ptr, addr);
  746: 	ptr += sizeof(uint32_t);
  747: 	if (addr != 0) {
  748: 		store_string(cpu, addr, s2);
  749: 		addr += strlen(s2) + 1;
  750: 	}
  751: 
  752: 	*ptrp = ptr;
  753: 	*addrp = addr;
  754: }
  755: 
  756: 
  757: /*
  758:  *  store_64bit_word():
  759:  *
  760:  *  Stores a 64-bit word in emulated RAM.  Byte order is taken into account.
  761:  *  Helper function.
  762:  */
  763: int store_64bit_word(struct cpu *cpu, uint64_t addr, uint64_t data64)
  764: {
  765: 	unsigned char data[8];
  766: 	if ((addr >> 32) == 0)
  767: 		addr = (int64_t)(int32_t)addr;
  768: 	data[0] = (data64 >> 56) & 255;
  769: 	data[1] = (data64 >> 48) & 255;
  770: 	data[2] = (data64 >> 40) & 255;
  771: 	data[3] = (data64 >> 32) & 255;
  772: 	data[4] = (data64 >> 24) & 255;
  773: 	data[5] = (data64 >> 16) & 255;
  774: 	data[6] = (data64 >> 8) & 255;
  775: 	data[7] = (data64) & 255;
  776: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  777: 		int tmp = data[0]; data[0] = data[7]; data[7] = tmp;
  778: 		tmp = data[1]; data[1] = data[6]; data[6] = tmp;
  779: 		tmp = data[2]; data[2] = data[5]; data[5] = tmp;
  780: 		tmp = data[3]; data[3] = data[4]; data[4] = tmp;
  781: 	}
  782: 	return cpu->memory_rw(cpu, cpu->mem,
  783: 	    addr, data, sizeof(data), MEM_WRITE, CACHE_DATA);
  784: }
  785: 
  786: 
  787: /*
  788:  *  store_32bit_word():
  789:  *
  790:  *  Stores a 32-bit word in emulated RAM.  Byte order is taken into account.
  791:  *  (This function takes a 64-bit word as argument, to suppress some
  792:  *  warnings, but only the lowest 32 bits are used.)
  793:  */
  794: int store_32bit_word(struct cpu *cpu, uint64_t addr, uint64_t data32)
  795: {
  796: 	unsigned char data[4];
  797: 
  798: 	data[0] = (data32 >> 24) & 255;
  799: 	data[1] = (data32 >> 16) & 255;
  800: 	data[2] = (data32 >> 8) & 255;
  801: 	data[3] = (data32) & 255;
  802: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  803: 		int tmp = data[0]; data[0] = data[3]; data[3] = tmp;
  804: 		tmp = data[1]; data[1] = data[2]; data[2] = tmp;
  805: 	}
  806: 	return cpu->memory_rw(cpu, cpu->mem,
  807: 	    addr, data, sizeof(data), MEM_WRITE, CACHE_DATA);
  808: }
  809: 
  810: 
  811: /*
  812:  *  store_16bit_word():
  813:  *
  814:  *  Stores a 16-bit word in emulated RAM.  Byte order is taken into account.
  815:  *  (This function takes a 64-bit word as argument, to suppress some
  816:  *  warnings, but only the lowest 16 bits are used.)
  817:  */
  818: int store_16bit_word(struct cpu *cpu, uint64_t addr, uint64_t data16)
  819: {
  820: 	unsigned char data[2];
  821: 
  822: 	data[0] = (data16 >> 8) & 255;
  823: 	data[1] = (data16) & 255;
  824: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  825: 		int tmp = data[0]; data[0] = data[1]; data[1] = tmp;
  826: 	}
  827: 	return cpu->memory_rw(cpu, cpu->mem,
  828: 	    addr, data, sizeof(data), MEM_WRITE, CACHE_DATA);
  829: }
  830: 
  831: 
  832: /*
  833:  *  store_buf():
  834:  *
  835:  *  memcpy()-like helper function, from host RAM to emulated RAM.
  836:  */
  837: void store_buf(struct cpu *cpu, uint64_t addr, const char *s, size_t len)
  838: {
  839: 	size_t psize = 1024;	/*  1024 256 64 16 4 1  */
  840: 
  841: 	while (len != 0) {
  842: 		if ((addr & (psize-1)) == 0) {
  843: 			while (len >= psize) {
  844: 				cpu->memory_rw(cpu, cpu->mem, addr,
  845: 				    (unsigned char *)s, psize, MEM_WRITE,
  846: 				    CACHE_DATA);
  847: 				addr += psize;
  848: 				s += psize;
  849: 				len -= psize;
  850: 			}
  851: 		}
  852: 		psize >>= 2;
  853: 	}
  854: 
  855: 	while (len-- != 0)
  856: 		store_byte(cpu, addr++, *s++);
  857: }
  858: 
  859: 
  860: /*
  861:  *  store_pointer_and_advance():
  862:  *
  863:  *  Stores a 32-bit or 64-bit pointer in emulated RAM, and advances the
  864:  *  target address. (Useful for e.g. ARCBIOS environment initialization.)
  865:  */
  866: void store_pointer_and_advance(struct cpu *cpu, uint64_t *addrp,
  867: 	uint64_t data, int flag64)
  868: {
  869: 	uint64_t addr = *addrp;
  870: 	if (flag64) {
  871: 		store_64bit_word(cpu, addr, data);
  872: 		addr += 8;
  873: 	} else {
  874: 		store_32bit_word(cpu, addr, data);
  875: 		addr += 4;
  876: 	}
  877: 	*addrp = addr;
  878: }
  879: 
  880: 
  881: /*
  882:  *  load_64bit_word():
  883:  *
  884:  *  Helper function. Emulated byte order is taken into account.
  885:  */
  886: uint64_t load_64bit_word(struct cpu *cpu, uint64_t addr)
  887: {
  888: 	unsigned char data[8];
  889: 
  890: 	cpu->memory_rw(cpu, cpu->mem,
  891: 	    addr, data, sizeof(data), MEM_READ, CACHE_DATA);
  893: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  894: 		int tmp = data[0]; data[0] = data[7]; data[7] = tmp;
  895: 		tmp = data[1]; data[1] = data[6]; data[6] = tmp;
  896: 		tmp = data[2]; data[2] = data[5]; data[5] = tmp;
  897: 		tmp = data[3]; data[3] = data[4]; data[4] = tmp;
  898: 	}
  899: 
  900: 	return
  901: 	    ((uint64_t)data[0] << 56) + ((uint64_t)data[1] << 48) +
  902: 	    ((uint64_t)data[2] << 40) + ((uint64_t)data[3] << 32) +
  903: 	    ((uint64_t)data[4] << 24) + ((uint64_t)data[5] << 16) +
  904: 	    ((uint64_t)data[6] << 8) + (uint64_t)data[7];
  905: }
  906: 
  907: 
  908: /*
  909:  *  load_32bit_word():
  910:  *
  911:  *  Helper function. Emulated byte order is taken into account.
  912:  */
  913: uint32_t load_32bit_word(struct cpu *cpu, uint64_t addr)
  914: {
  915: 	unsigned char data[4];
  916: 
  917: 	cpu->memory_rw(cpu, cpu->mem,
  918: 	    addr, data, sizeof(data), MEM_READ, CACHE_DATA);
  919: 
  920: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  921: 		int tmp = data[0]; data[0] = data[3]; data[3] = tmp;
  922: 		tmp = data[1]; data[1] = data[2]; data[2] = tmp;
  923: 	}
  924: 
  925: 	return (data[0] << 24) + (data[1] << 16) + (data[2] << 8) + data[3];
  926: }
  927: 
  928: 
  929: /*
  930:  *  load_16bit_word():
  931:  *
  932:  *  Helper function. Emulated byte order is taken into account.
  933:  */
  934: uint16_t load_16bit_word(struct cpu *cpu, uint64_t addr)
  935: {
  936: 	unsigned char data[2];
  937: 
  938: 	cpu->memory_rw(cpu, cpu->mem,
  939: 	    addr, data, sizeof(data), MEM_READ, CACHE_DATA);
  940: 
  941: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  942: 		int tmp = data[0]; data[0] = data[1]; data[1] = tmp;
  943: 	}
  944: 
  945: 	return (data[0] << 8) + data[1];
  946: }
  947: 
  948: 
  949: /*
  950:  *  store_64bit_word_in_host():
  951:  *
  952:  *  Stores a 64-bit word in the _host's_ RAM.  Emulated byte order is taken
  953:  *  into account.  This is useful when building structs in the host's RAM
  954:  *  which will later be copied into emulated RAM.
  955:  */
  956: void store_64bit_word_in_host(struct cpu *cpu,
  957: 	unsigned char *data, uint64_t data64)
  958: {
  959: 	data[0] = (data64 >> 56) & 255;
  960: 	data[1] = (data64 >> 48) & 255;
  961: 	data[2] = (data64 >> 40) & 255;
  962: 	data[3] = (data64 >> 32) & 255;
  963: 	data[4] = (data64 >> 24) & 255;
  964: 	data[5] = (data64 >> 16) & 255;
  965: 	data[6] = (data64 >> 8) & 255;
  966: 	data[7] = (data64) & 255;
  967: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  968: 		int tmp = data[0]; data[0] = data[7]; data[7] = tmp;
  969: 		tmp = data[1]; data[1] = data[6]; data[6] = tmp;
  970: 		tmp = data[2]; data[2] = data[5]; data[5] = tmp;
  971: 		tmp = data[3]; data[3] = data[4]; data[4] = tmp;
  972: 	}
  973: }
  974: 
  975: 
  976: /*
  977:  *  store_32bit_word_in_host():
  978:  *
  979:  *  See comment for store_64bit_word_in_host().
  980:  *
  981:  *  (Note:  The data32 parameter is a uint64_t. This is done to suppress
  982:  *  some warnings.)
  983:  */
  984: void store_32bit_word_in_host(struct cpu *cpu,
  985: 	unsigned char *data, uint64_t data32)
  986: {
  987: 	data[0] = (data32 >> 24) & 255;
  988: 	data[1] = (data32 >> 16) & 255;
  989: 	data[2] = (data32 >> 8) & 255;
  990: 	data[3] = (data32) & 255;
  991: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
  992: 		int tmp = data[0]; data[0] = data[3]; data[3] = tmp;
  993: 		tmp = data[1]; data[1] = data[2]; data[2] = tmp;
  994: 	}
  995: }
  996: 
  997: 
  998: /*
  999:  *  store_16bit_word_in_host():
 1000:  *
 1001:  *  See comment for store_64bit_word_in_host().
 1002:  */
 1003: void store_16bit_word_in_host(struct cpu *cpu,
 1004: 	unsigned char *data, uint16_t data16)
 1005: {
 1006: 	data[0] = (data16 >> 8) & 255;
 1007: 	data[1] = (data16) & 255;
 1008: 	if (cpu->byte_order == EMUL_LITTLE_ENDIAN) {
 1009: 		int tmp = data[0]; data[0] = data[1]; data[1] = tmp;
 1010: 	}
 1011: }
