  420: 				memset(buf, 0xff, xsize*ysize);
  421: 				y = 0;
  422: 			}
  423: 		}
  424: 		
  425: 		// Make sure the access is not put into quick lookup tables:
  426: 		ok |= MEMORY_NOT_FULL_PAGE;
