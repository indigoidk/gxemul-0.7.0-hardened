  349: 		(paddr >= 0x0c000000 && paddr < 0x0d000000)))
  350: 	{
  351: 		int64_t xsize = 1920, ysize = 1080;
  352: 		static int y = 0;
  353: 		static int count = 0;
  354: 		static uint8_t* buf = NULL;
  355: 
  356: 		if (buf == NULL)
  357: 		{
  358: 			buf = (uint8_t*)malloc(xsize * ysize*3);
  359: 			memset(buf, 0xff, xsize * ysize*3);
  360: 		}
  361: 
  362: 		uint64_t paddr2 = paddr - 0x0c000000;
  363: 		
  364: 		if (paddr < 0x200000)
  365: 			paddr2 = paddr + 16*1048576;
  366: 
  367: 		int64_t max = 16*1048576 + (2*1048576);
  368: 
  369: 		int64_t x = xsize * paddr2 / max;
  370: 
  371: 		if (x >= 0 && x < xsize)
  372: 		{
  373: 			if (writeflag)
  374: 			{
  375: 				int c = buf[(x+y*xsize)*3+0];
  376: 				if (c == 255)
  377: 					c = 128;
  378: 				else if (c > 0)
  379: 				{
  380: 					c = c - 8;
  381: 				}
  382: 
  383: 				buf[(x+y*xsize)*3+1] = c;
  384: 				buf[(x+y*xsize)*3+2] = c;
  385: 			}
  386: 			else
  387: 			{
  388: 				int c = buf[(x+y*xsize)*3+1];
  389: 				if (c == 255)
  390: 					c = 128;
  391: 				else if (c > 0)
  392: 				{
  393: 					c = c - 8;
  394: 				}
  395: 
  396: 				buf[(x+y*xsize)*3+0] = c;
  397: 				buf[(x+y*xsize)*3+2] = c;
  398: 			}
  399: 		}
  400: 		
  401: 		for (int meg = 0; meg < 18; ++meg)
  402: 			buf[((xsize * (meg * 0x100000LL) / max) +y*xsize)*3+1] = 64;
  403: 
  404: 		count ++;
  405: 		if (count >= 8192)
  406: 		{
  407: 			count = 0;
  408: 			y ++;
  409: 			
  410: 			if (y >= ysize)
  411: 			{
  412: 				static int n = 0;
  413: 				char name[40];
  414: 				snprintf(name, sizeof(name), "memory_%05i.ppm", n++);
