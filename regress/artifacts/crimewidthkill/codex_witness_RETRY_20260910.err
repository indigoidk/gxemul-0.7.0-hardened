  394: 		machine->main_console_handle = (size_t)device_add(machine,
  395: 		    "z8530 addr=0x1fbd9830 irq=0 addr_mult=4");
  396: 		break;
  397: 
  398: 	case 28:
  399: 		/*  NOTE:  Special case for arc_wordlen:  */
  400: 		arc_wordlen = sizeof(uint64_t);
  401: 		strlcat(machineName, " (Impact Indigo2 ?)", MACHINE_NAME_MAXBUF);
  402: 
  403: 		device_add(machine, "random addr=0x1fbe0000, len=1");
  404: 
  405: 		/*  Something at paddr 0x1880fb0000.  */
  406: 
  407: 		break;
  408: 
  409: 	case 30:
  410: 		/*  NOTE:  Special case for arc_wordlen:  */
  411: 		arc_wordlen = sizeof(uint64_t);
  412: 		strlcat(machineName, " (Octane)",
  413: 		    MACHINE_NAME_MAXBUF);
  414: 
  415: 		// TODO: Interrupts!
  416: 		snprintf(tmpstr, sizeof(tmpstr),
  417: 		    "sgi_ip30 addr=0x0ff00000");
  418: 		device_add(machine, tmpstr);
  419: 
  420: 		dev_ram_init(machine, 0xa0000000ULL, 128 * 1048576,
  421: 		    DEV_RAM_MIRROR | DEV_RAM_MIGHT_POINT_TO_DEVICES,
  422: 		    0x00000000, NULL);
  423: 
  424: 		dev_ram_init(machine,    0x80000000ULL,
  425: 		    32 * 1048576, DEV_RAM_RAM, 0x00000000, NULL);
  426: 
  427: 		/*
  428: 		 *  Something at paddr=1f022004: TODO
  429: 		 *  Something at paddr=813f0510 - paddr=813f0570 ?
  430: 		 *  Something at paddr=813f04b8
  431: 		 *  Something at paddr=f8000003c  used by Linux/Octane
  432: 		 *
  433: 		 *  16550 serial port at paddr=1f620178, addr mul 1
  434: 		 *  (Error messages are printed to this serial port by
  435: 		 *  the PROM.)
  436: 		 *
  437: 		 *  There seems to also be a serial port at 1f620170. The
  438: 		 *  "symmon" program dumps something there, but it doesn't
  439: 		 *  look like readable text.  (TODO)
  440: 		 */
  441: 
  442: 		/*  TODO: irq!  */
  443: 		snprintf(tmpstr, sizeof(tmpstr), "ns16550 irq=%s.cpu[%i].2 addr="
  444: 		    "0x1f620170 name2=tty0 in_use=%i",
  445: 		    machine->path, machine->bootstrap_cpu,
  446: 		    machine->x11_md.in_use? 0 : 1);
  447: 		machine->main_console_handle = (size_t)device_add(machine,
  448: 		    tmpstr);
  449: 		snprintf(tmpstr, sizeof(tmpstr), "ns16550 irq=%s.cpu[%i].2 addr="
  450: 		    "0x1f620178 name2=tty1 in_use=0",
  451: 		    machine->path, machine->bootstrap_cpu);
  452: 		device_add(machine, tmpstr);
  453: 
  454: 		/*  MardiGras graphics:  */
  455: 		device_add(machine, "sgi_mardigras addr=0x1c000000");
  456: 
  457: 		break;
  458: 
  459: 	case 32:
  460: 		strlcat(machineName, " (O2)", MACHINE_NAME_MAXBUF);
  461: 
  462: 		/*
  463: 		 *  The IP32 prom probes "bank 0" with the following
  464: 		 *  TLB entries:
  465: 		 *
  466: 		 *  00: vaddr=0000000000000000 (global):  p0=0x040000000 D p1=0x041000000 D (16MB)
  467: 		 *  01: vaddr=0000000002000000 (global):  p0=0x042000000 D p1=0x043000000 D (16MB)
  468: 		 *  02: vaddr=0000000004000000 (global):  p0=0x044000000 D p1=0x045000000 D (16MB)
  469: 		 *  03: vaddr=0000000006000000 (global):  p0=0x046000000 D p1=0x047000000 D (16MB)
  470: 		 *
  471: 		 *  In other words, it uses real memory at 0x40000000 and up.
  472: 		 *  However, it is _also_ accessible at physical address 0x0.
  473: 		 *
  474: 		 *  Max amount of RAM in an O2 is 1 GB. However, devices start at
  475: 		 *  0x14000000 (or below that), so 256 MB is the most that the legacy GXemul
  476: 		 *  framework can handle. Memory above that must be accessed from 0x40000000 and up.
  477:  		 */
  478: 
  479: 		if (machine->physical_ram_in_mb > 1024) {
  480: 			fatal("SGI O2 cannot have more than 1 GB of RAM.\n");
  481: 			exit(1);
  482: 		}
  483: 
  484: 		/*  In the new framework, this would be the other way around :-), i.e.
  485: 		    actual memory at 0x40000000 and the first 256 MB would be mirrored
  486: 		    to address 0.  */
  487: 		{
  488: 			int mirrorInMB = machine->physical_ram_in_mb < 256 ? machine->physical_ram_in_mb : 256;
  489: 			dev_ram_init(machine, 0x40000000ULL, mirrorInMB * 1048576, DEV_RAM_MIRROR, 0, NULL);
  490: 			if (machine->physical_ram_in_mb > 256)
  491: 				dev_ram_init(machine, 0x50000000ULL, (machine->physical_ram_in_mb - 256) * 1048576, DEV_RAM_RAM, 0, NULL);
  492: 		}
  493: 		
  494: 		/*  Connect CRIME (Interrupt Controller) to MIPS irq 2:  */
  495: 		snprintf(tmpstr, sizeof(tmpstr), "%s.cpu[%i].2",
  496: 		    machine->path, machine->bootstrap_cpu);
  497: 		dev_crime_init(machine, mem, 0x14000000, tmpstr, machine->x11_md.in_use);
  498: 
  499: 		/*  Rendering Engine  */
  500: 		dev_sgi_re_init(machine, mem, 0x15000000);
  501: 
  502: 		/*  Graphics Back End  */
  503: 		dev_sgi_gbe_init(machine, mem, 0x16000000);
  504: 
  505: 		/*
  506: 		 *  A combination of NetBSD and Linux info:
  507: 		 *
  508: 		 *	14000000	crime (interrupt/memory controller?)
  509: 		 *	15000000	drawing engine, memory transfer engine, rendering engine
  510: 		 *	16000000	gbe (graphics), crm framebuffer control
  511: 		 *      17000000	vice (Video Image Compression Engine)
  512: 		 *	18000000	pci (?)
  513: 		 *	1f000000	mace
  514: 		 *	1f080000	macepci
  515: 		 *	1f100000	vin1
  516: 		 *	1f180000	vin2
  517: 		 *	1f200000	vout
  518: 		 *	1f280000	enet (mec0, MAC-110 Ethernet)
  519: 		 *	1f300000	perif:
  520: 		 *	  1f300000	  audio ("a3"?)
  521: 		 *	  1f310000	  isa
  522: 		 *	    1f318000	    (unknown, accessed by Irix' pciio_pio_write64 and by the PROM during bootup)
  523: 		 *	    1f31c000	    (unknown, accessed by the PROM during bootup)
  524: 		 *	  1f320000	  kbdms
  525: 		 *	  1f330000	  i2c
  526: 		 *	  1f340000	  ust
  527: 		 *	1f380000	isa ext
  528: 		 * 	  1f390000	  com0 (serial)
  529: 		 * 	  1f398000	  com1 (serial)
  530: 		 * 	  1f3a0000	  mcclock0
  531: 		 */
  532: 
  533: 		/*
  534: 		 *  IRQ mapping is really ugly.  TODO: fix
  535: 		 *
  536: 		 *  com0 at mace0 offset 0x390000 intr 4 intrmask
  537: 		 *	0x3f00000: ns16550a, working fifo
  538: 		 *  com1 at mace0 offset 0x398000 intr 4 intrmask
  539: 		 *	0xfc000000: ns16550a, working fifo
  540: 		 *  pckbc0 at mace0 offset 0x320000 intr 5 intrmask 0x0
  541: 		 *  mcclock0 at mace0 offset 0x3a0000 intrmask 0x0
  542: 		 *  macepci0 at mace0 offset 0x80000 intr 7 intrmask 0x0: rev 1
  543: 		 *
  544: 		 *  intr 4 = CRIME_INT_PERIPH_SERIAL
  545: 		 *  intr 5 = CRIME_INT_PERIPH_MISC
  546: 		 *  intr 7 = CRIME_INT_PCI_BRIDGE
  547: 		 */
  548: 
  549: 		snprintf(eaddr_string, ETHERNET_STRING_MAXLEN,
  550: 		    "%02x:%02x:%02x:%02x:%02x:%02x",
  551: 		    macaddr[0], macaddr[1], macaddr[2],
  552: 		    macaddr[3], macaddr[4], macaddr[5]);
  553: 
  554: 		snprintf(tmpstr, sizeof(tmpstr), "%s.cpu[%i].2.crime.0x%x",
  555: 		    machine->path, machine->bootstrap_cpu, CRIME_INT_ETHERNET);
  556: 		dev_sgi_mec_init(machine, mem, 0x1f280000,
  557: 		    tmpstr, macaddr);
  558: 
  559: 		dev_sgi_ust_init(mem, 0x1f340000);  /*  ust?  */
  560: 
  561: 		snprintf(tmpstr, sizeof(tmpstr),
  562: 		    "ns16550 irq=%s.cpu[%i].2.crime.0x%x.mace.%i addr="
  563: 		    "0x1f390000 addr_mult=0x100 in_use=%i name2=tty0",
  564: 		    machine->path, machine->bootstrap_cpu,
  565: 		    CRIME_INT_PERIPH_SERIAL, 20, machine->x11_md.in_use? 0 : 1);
  566: 		j = (size_t)device_add(machine, tmpstr);
  567: 		snprintf(tmpstr, sizeof(tmpstr),
  568: 		    "ns16550 irq=%s.cpu[%i].2.crime.0x%x.mace.%i addr="
  569: 		    "0x1f398000 addr_mult=0x100 in_use=%i name2=tty1",
  570: 		    machine->path, machine->bootstrap_cpu,
  571: 		    CRIME_INT_PERIPH_SERIAL, 26, 0);
  572: 		device_add(machine, tmpstr);
  573: 
  574: 		machine->main_console_handle = j;
  575: 
  576: 		{
  577: 			/*  keyb+mouse (mace irq numbers)  */
  578: 			char tmpstr1[1000];
  579: 			char tmpstr2[1000];
  580: 			snprintf(tmpstr1, sizeof(tmpstr1),
  581: 			    "%s.cpu[%i].2.crime.0x%x.mace.%i",
  582: 			    machine->path, machine->bootstrap_cpu,
  583: 			    CRIME_INT_PERIPH_MISC, 9);
  584: 
  585: 			snprintf(tmpstr2, sizeof(tmpstr2),
  586: 			    "%s.cpu[%i].2.crime.0x%x.mace.%i",
  587: 			    machine->path, machine->bootstrap_cpu,
  588: 			    CRIME_INT_PERIPH_MISC, 11);
  589: 
  590: 			i = dev_pckbc_init(machine, mem, 0x1f320000,
  591: 			    PCKBC_8242, tmpstr1,
  592: 			    tmpstr2, machine->x11_md.in_use,
  593: 			    0);
  594: 
  595: 			if (machine->x11_md.in_use)
  596: 				machine->main_console_handle = i;
  597: 		}
  598: 
  599: 		snprintf(tmpstr, sizeof(tmpstr),
  600: 		    "%s.cpu[%i].2.crime.0x%x.mace.%i",
  601: 		    machine->path, machine->bootstrap_cpu,
  602: 		    CRIME_INT_PERIPH_MISC, 8);
  603: 		dev_mc146818_init(machine, mem, 0x1f3a0000, tmpstr,
  604: 		    MC146818_SGI, 0x40);  /*  mcclock0  */
  605: 
  606: 		/*
  607: 		 *  PCI devices:   (according to NetBSD's GENERIC
  608: 		 *  config file for sgimips)
  609: 		 *
  610: 		 *	ne*             at pci? dev ? function ?
  611: 		 *	ahc0            at pci0 dev 1 function ?
  612: 		 *	ahc1            at pci0 dev 2 function ?
  613: 		 */
  614: 
  615: 		snprintf(tmpstr, sizeof(tmpstr),
  616: 		    "%s.cpu[%i].2.crime.0x%x", machine->path,
  617: 		    machine->bootstrap_cpu, CRIME_INT_PCI_BRIDGE);
  618: 		pci_data = dev_macepci_init(machine, mem, 0x1f080000,
  619: 		    tmpstr);		/*  macepci0  */
  620: 		/*  bus_pci_add(machine, pci_data, mem, 0, 0, 0,
  621: 		    "ne2000");  TODO  */
  622: 
  623: 		/*
  624: 		 *  OpenBSD accesses the SCSI controller at paddr=0x2800010xx.
  625: 		 *  Note that the 2 is above 32-bit range.
  626: 		 *
  627: 		 *  TODO: Investigate what this actually means. Possibly
  628: 		 *  a bug in GXemul's 64-bit instructions? Or perhaps it really
  629: 		 *  is correct.
  630: 		 */
  631: 		dev_ram_init(machine, 0x280000000ULL, 0x01000000, DEV_RAM_MIRROR, 0x18000000, NULL);
  632: 
  633: 
  634: 		// ahc0:
  635: 		/*  TODO: Make it possible to add the controller, regardless of
  636: 			the existence of disks!  */
  637: 		if (diskimage_exist(machine, 0, DISKIMAGE_SCSI) ||
  638: 		    diskimage_exist(machine, 1, DISKIMAGE_SCSI) ||
  639: 		    diskimage_exist(machine, 2, DISKIMAGE_SCSI) ||
  640: 		    diskimage_exist(machine, 3, DISKIMAGE_SCSI) ||
  641: 		    diskimage_exist(machine, 4, DISKIMAGE_SCSI) ||
  642: 		    diskimage_exist(machine, 5, DISKIMAGE_SCSI) ||
  643: 		    diskimage_exist(machine, 6, DISKIMAGE_SCSI) ||
  644: 		    diskimage_exist(machine, 7, DISKIMAGE_SCSI))
  645: 			bus_pci_add(machine, pci_data, mem, 0, 1, 0, "ahc");
  646: 
  647: 		// ahc1:
  648: 		// bus_pci_add(machine, pci_data, mem, 0, 2, 0, "ahc");
  649: 
  650: 		break;
  651: 
  652: 	case 35:
  653: 		strlcat(machineName, " (Origin 3000)", MACHINE_NAME_MAXBUF);
  654: 		/*  4 cpus per node  */
  655: 
  656: 		// TODO: Correct Interrupt!
  657: 		snprintf(tmpstr, sizeof(tmpstr), "z8530 addr=0x1fbd9830 irq=%s.cpu[%i].2",
  658: 		    machine->path, machine->bootstrap_cpu);
  659: 		machine->main_console_handle = (size_t)device_add(machine, tmpstr);
  660: 
  661: 		break;
  662: 
  663: 	case 53:
  664: 		strlcat(machineName, " (Origin 350)",
  665: 		    MACHINE_NAME_MAXBUF);
  666: 
  667: 		/*
  668: 		 *  According to http://kumba.drachentekh.net/xml/myguide.html
  669: 		 *  Origin 350, Tezro IP53 R16000
  670: 		 */
  671: 		break;
  672: 
  673: 	default:
  674: 		fatal("unimplemented SGI machine type IP%i\n",
  675: 		    machine->machine_subtype);
  676: 		exit(1);
  677: 	}
  678: 
  679: 	if (!machine->prom_emulation)
  680: 		return;
  681: 
  682: 	arcbios_init(machine, arc_wordlen == sizeof(uint64_t), sgi_ram_offset,
  683: 	    eaddr_string, macaddr);
  684: }
  685: 
  686: 
  687: MACHINE_DEFAULT_CPU(sgi)
  688: {
  689: 	if (machine->machine_subtype <= 12)
  690: 	        machine->cpu_name = strdup("R3000");
  691: 	if (machine->cpu_name == NULL && machine->machine_subtype == 35)
  692: 	        machine->cpu_name = strdup("R12000");
  693: 	if (machine->cpu_name == NULL && (machine->machine_subtype == 25 ||
  694: 	    machine->machine_subtype == 27 || machine->machine_subtype == 28 ||
  695: 	    machine->machine_subtype == 30 || machine->machine_subtype == 32))
  696: 	        machine->cpu_name = strdup("R10000");
  697: 	if (machine->cpu_name == NULL && (machine->machine_subtype == 21 ||
  698: 	    machine->machine_subtype == 26))
  699: 	        machine->cpu_name = strdup("R8000");
  700: 	if (machine->cpu_name == NULL && machine->machine_subtype == 24)
  701: 	        machine->cpu_name = strdup("R5000");
  702:                         
  703: 	/*  Other SGIs should probably work with
  704: 	    R4000, R4400 or R5000 or similar:  */
  705: 	if (machine->cpu_name == NULL)
  706: 	        machine->cpu_name = strdup("R4400");
  707: }
  708: 
  709: 
  710: MACHINE_DEFAULT_RAM(sgi)
  711: {
  712: 	// Self-compilation fails with OpenBSD/sgi 6.3 with as low as 128 MB
  713: 	// RAM, so 256 would be better. But my O2 has 128 MB, so this is kept
  714: 	// as 128 to simplify comparison between the real machine and the
  715: 	// emulator.
  716: 	machine->physical_ram_in_mb = 128;
  717: }
  718: 
  719: 
  720: MACHINE_REGISTER(sgi)
  721: {
  722: 	MR_DEFAULT(sgi, "SGI", MACHINE_SGI);
  723: 
  724: 	me->set_default_ram = machine_default_ram_sgi;
  725: 
  726: 	machine_entry_add_alias(me, "silicon graphics");
  727: 	machine_entry_add_alias(me, "sgi");
  728: 
  729: 	machine_entry_add_subtype(me, "IP12", 12, "ip12", NULL);
  730: 
  731: 	machine_entry_add_subtype(me, "IP19", 19, "ip19", NULL);
  732: 
  733: 	machine_entry_add_subtype(me, "IP20", 20, "ip20", NULL);
  734: 
  735: 	machine_entry_add_subtype(me, "IP22", 22, "ip22", "indy", NULL);
  736: 
  737: 	machine_entry_add_subtype(me, "IP24", 24, "ip24", NULL);
  738: 
  739: 	machine_entry_add_subtype(me, "IP27", 27,
  740: 	    "ip27", "origin 200", "origin 2000", NULL);
  741: 
  742: 	machine_entry_add_subtype(me, "IP28", 28, "ip28", NULL);
  743: 
  744: 	machine_entry_add_subtype(me, "IP30", 30, "ip30", "octane", NULL);
  745: 
  746: 	machine_entry_add_subtype(me, "IP32", 32, "ip32", "o2", NULL); 
  747: 
  748: 	machine_entry_add_subtype(me, "IP35", 35, "ip35", NULL); 
  749: }
