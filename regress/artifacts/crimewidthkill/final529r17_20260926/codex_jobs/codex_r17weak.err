 303: /*
 304:  *  debugmsg():
 305:  *
 306:  *  The main routine to call, when something should be printed.
 307:  */
 308: void debugmsg(int subsystem, const char *name,
 309: 	int verbosity_required, const char *fmt, ...)
 310: {
 311: 	va_list argp;
 312: 
 313: 	va_start(argp, fmt);
 314: 	debugmsg_va(NULL, subsystem, name, verbosity_required, argp, fmt);
 315: 	va_end(argp);
 316: }
 317: 
 318: 
 319: /*
 320:  *  debugmsg():
 321:  *
 322:  *  The main routine to call, when something should be printed and we are
 323:  *  in the context of a specific CPU.
 324:  */
 325: void debugmsg_cpu(struct cpu* cpu, int subsystem, const char *name,
 326: 	int verbosity_required, const char *fmt, ...)
 327: {
 328: 	va_list argp;
 329: 
 330: 	va_start(argp, fmt);
 331: 	debugmsg_va(cpu, subsystem, name, verbosity_required, argp, fmt);
 332: 	va_end(argp);
 333: }
 334: 
 335: 
 336: /*
 337:  *  debug_indentation():
 338:  *
 339:  *  Modify the debug indentation. diff should be +1 to increase, and -1 to
 340:  *  decrease after printing something.
 341:  *
 342:  *  This affects both the older debug() and fatal() functions, and the new
 343:  *  debugmsg/debugmsg_cpu() functions.
 344:  */
 345: void debug_indentation(int diff)
 346: {
 347: 	debug_indent += diff;
 348: 
 349: 	if ((ssize_t)debug_indent < 0) {
 350: 		fprintf(stderr, "WARNING: debug_indent too low!\n");
 351: 		debug_indent = 0;
 352: 	}
 353: }
 354: 
 355: 
 356: /*
 357:  *  debug() and fatal():
 358:  *
 359:  *  These are here because of all the legacy code that uses them. Basically,
 360:  *  debug() is mapped to something that is only displayed with verbosity
 361:  *  at the default level, and fatal() is used to always print stuff. With some
 362:  *  hacks to make it work reasonable with -q and when executing normally or
 363:  *  when executing single-stepping.
 364:  */
 365: void debug(const char *fmt, ...)
 366: {
 367: 	va_list argp;
 368: 	bool ss = single_step || about_to_enter_single_step;
 369: 	int v = verbose;
 370: 	if (emul_executing)
 371: 		v--;
 372: 	if (ss)
 373: 		v++;
 374: 
 375: 	if ((quiet_mode && !ss) || v < 0)
 376: 		return;
 377: 
 378: 	va_start(argp, fmt);
 379: 	va_debug(argp, fmt);
 380: 	va_end(argp);
 381: }
 382: 
 383: 
 384: void fatal(const char *fmt, ...)
 385: {
 386: 	va_list argp;
 387: 
 388: 	va_start(argp, fmt);
 389: 	va_debug(argp, fmt);
 390: 	va_end(argp);
 391: }
