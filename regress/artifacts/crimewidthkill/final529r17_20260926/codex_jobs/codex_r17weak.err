1365: #  in item 6; these VALUE rows carry the cells where such a bypass is GUEST-VISIBLE, derived per cell from the switch and
1366: #  the width arm (the flagship ruling: from the enumeration, never from the mutants that happened to be built):
1367: #    REV window 4W/8W/8R, CONTROL 8R/8W, INTSTAT 8W/8R/4W, INTMASK 4W, TIME 8W, the default arm's 4W/4R at +0x40.
1368: #  The other ACCEPTS cells are either pinned elsewhere or EQUIVALENT when bypassed (item 6).
1369: #  REV window: CHANNEL = the PROM-probe redirect (pc = ra), which only an ACCEPTED access reaches.
1370: A = Addr(CODE)
1371: c = ["ra=0x%x" % RA]
1372: x, _ = st(A, "sw", CRIME + 0, 0, at=PROBE_PC); c += x + ["print pc"]
1373: x, _ = st(A, "sd", CRIME + 0, 0, at=PROBE_PC); c += x + ["print pc"]
1374: x, _ = ld(A, "ld", CRIME + 0, "s0", at=PROBE_PC); c += x + ["print pc"]
1375: t, clean = session(c)
1376: for i, k in enumerate(("sw", "sd", "ld")):
1377:     v = nth(t, "pc", i)
1378:     row("revP %s pc" % k, "absent" if v is None else "0x%x" % v, "0x%x" % RA,
1379:         "accepted %s CRIME_REV from 0xbfc05180: pc = ra" % k)
1380: #  CONTROL 8R: CHANNEL = its value, 0x100 (the prelude's ENDIANESS; a declined read answers 0).  INTSTAT 8R: its value
1381: #  SOFTINT | HARDINT, recomputed by every access's tail.  INTMASK 4W: the high half lands (ld +0x18).  TIME 8W: an ODD
1382: #  seed stays odd (every update adds a multiple of 66), and the register is even before it -- so parity says whether
1383: #  the store landed, whatever the host clock added.  Default arm +0x40 4W (the high lane) and 4R: the value round trip.
1384: #  CONTROL 8W: its arm prints the unimplemented-control text for a leftover bit (0x01), which a declined store cannot.
1385: A = Addr(CODE)
1386: c = []
1387: x, _ = ld(A, "ld", CRIME + 0x08, "s0"); c += x
1388: x, _ = ld(A, "lw", CRIME + 0x08, "a0"); c += x                     # #529 repair 14: CONTROL 4R, HIGH lane (0 -- pairs with +0x0c)
1389: x, _ = ld(A, "lw", CRIME + 0x0c, "s4"); c += x                     # #529 repair 14: CONTROL 4R, LOW lane (0x100 -- the discriminating half)
1390: x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
1391: x, _ = ld(A, "ld", CRIME + 0x10, "s1"); c += x
1392: x, _ = ld(A, "lw", CRIME + 0x10, "v1"); c += x                     # #529 repair 14: ACCEPTS entry 21, the 4-BYTE twin
1393: x, _ = st(A, "sw", CRIME + 0x18, 0x10000000); c += x
1394: x, _ = ld(A, "ld", CRIME + 0x18, "s2"); c += x
1395: x, _ = st(A, "sd", CRIME + 0x38, 0x11111111); c += x
1396: x, _ = ld(A, "ld", CRIME + 0x38, "s3"); c += x
1397: x, _ = st(A, "sd", CRIME + 0x40, 0); c += x
1398: x, _ = st(A, "sw", CRIME + 0x40, 0x0a0b0c0d); c += x
1399: x, _ = ld(A, "lw", CRIME + 0x40, "a1"); c += x
1400: x, _ = ld(A, "ld", CRIME + 0x40, "a2"); c += x
1401: x, _ = st(A, "sd", CRIME + 0x08, 0x01); c += x
1402: t, clean = session(c + ["print s0", "print s1", "print s2", "print s3", "print a1", "print a2", "print v1",
1403:                         "print a0", "print s4"])
1404: tv = nth(t, "s3", 0)
1405: row("acc ctl ld", pr(t, "s0"), "0x100", "accepted ld +0x08 answers CONTROL (0x100)")
1406: row("acc ctl4r", pr(t, "a0"), "0x0",
1407:     "accepted lw +0x08: CONTROL's HIGH lane is 0 -- VACUOUS ALONE, paired with acc ctl0c below")
1408: row("acc ctl0c", pr(t, "s4"), "0x100",
1409:     "accepted lw +0x0c: the LOW lane is 0x100 -- the half that discriminates, latch CLEAR")
1410: row("acc istat ld", pr(t, "s1"), "0x%x" % BIT, "accepted ld +0x10 answers INTSTAT = SOFTINT")
1411: row("acc istat lw", pr(t, "v1"), "0x%x" % (BIT >> 32),
1412:     "accepted lw +0x10 answers INTSTAT's HIGH lane -- ACCEPTS entry 21, latch CLEAR")
1413: row("acc imask sw", pr(t, "s2"), "0x1000000000000000", "accepted sw +0x18 lands in the high half")
1414: row("acc time sd", "absent" if tv is None else ("odd" if tv & 1 else "even"), "odd",
1415:     "accepted sd +0x38 of an odd seed: TIME stays odd (raw %s)" % tv)
1416: row("acc 40 lw", pr(t, "a1"), "0xa0b0c0d", "accepted lw +0x40 answers the high half the sw stored")
1417: row("acc 40 sw", pr(t, "a2"), "0xa0b0c0d00000000", "accepted sw +0x40 lands in the high half (ld)")
1418: row("acc ctl sd", count(t, "CRIME_CONTROL: unimplemented", clean), 1, "accepted sd 0x01 +0x08 prints the text")
1419: #  INTSTAT 8W and 4W: CHANNEL = cause.IP2.  With INTMASK = SOFTINT = BIT and the line low (SOFTINT's store goes to the
1420: #  default arm, which does not reassert), an ACCEPTED store at +0x10 reasserts and raises IP2; a declined one reaches the
1421: #  tail, which recomputes INTSTAT but does NOT touch the line.  Between the two, SOFTINT = 0 and an INTMASK store lower it.
1422: A = Addr(CODE)
1423: c = []
1424: x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x
1425: x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
1426: c += ["print cause"]
1427: x, _ = st(A, "sd", CRIME + 0x10, 0); c += x
1428: c += ["print cause"]
1429: x, _ = st(A, "sd", CRIME + 0x20, 0); c += x
1430: x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x
1431: x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
1432: c += ["print cause"]                                # immediately before the sw, as `pre' is before the sd
1433: x, _ = st(A, "sw", CRIME + 0x10, 0); c += x
1434: c += ["print cause"]
1435: t, clean = session(c)
1436: row("istw pre", ip2(nth(t, "cause", 0)), "clear", "CONTROL: IP2 low after SOFTINT's default-arm store")
1437: row("istw sd", ip2(nth(t, "cause", 1)), "set", "accepted sd +0x10 reasserts: IP2 set")
1438: row("istw mid", ip2(nth(t, "cause", 2)), "clear", "CONTROL: lowered again (SOFTINT 0, INTMASK store), SOFTINT set")
1439: row("istw sw", ip2(nth(t, "cause", 3)), "set", "accepted sw +0x10 reasserts: IP2 set")
1440: 
1441: # ============================================================================================
1442: #  REPAIR 13 -- APPLIED 2026-09-16, 157 -> 188 rows, measured 188/188 CONTROL=OK on the committed
1443: #  build (killtable11_20260916/probe_repair13_fix.out) and verified by kill table 11.
1444: #  *** THIS HEADER READ "DRAFT -- NOT APPLIED" IN THE SHIPPED PROBE UNTIL 2026-09-16 19:5x, WHEN
1445: #  THE GROK SEAT READ THE FILE AND SAID SO.  It was true of the scratchpad draft and false the
1446: #  moment the block was spliced -- a wrong record sitting in product-adjacent code, of exactly
1447: #  the class this project grades L4.  Corrected in place. ***  Every session below is owed: they
1448: #  are the rows that catch the K-class at the cells the close-7 seat MEASURED, in the shapes it
1449: #  measured them in (opus_close7_20260915/scripts2/post7.py, post7c.py -- base 29/29, K1 28/29,
1450: #  K2 27/29, K3 28/29, four negative controls 29/29).  What Fable's answer changes is how many
1451: #  MORE cells the closure product adds, not whether these belong.
1452: #
1453: #  THE ONE STRUCTURAL IDEA, and it is the whole repair: every existing value row is measured
1454: #  with `d->warned & CRIME_W_LEN' CLEAR, so a guard grown with a conjunct on that latch is
1455: #  invisible to all of them.  `POST()' below opens each session with a REFUSED lb at +0x07, so
1456: #  every access after it is measured with the LATCH SET.  New sessions only -- the targeting
1457: #  rule therefore selects no earlier kill for re-running (no existing session's command list
1458: #  changes).
1459: #
1460: #  CHANNEL lines: each row names its mutant and the observable, and EVERY ONE WAS CHECKED
1461: #  AGAINST ITS MUTANT rather than merely written -- the seat's first two TIME shapes were
1462: #  measured VACUOUS and one gave a FALSE RED on a control, which is this block's own evidence
1463: #  for why the PRETABLE CHANNEL line has to be run, not asserted.
1464: # ============================================================================================
1465: 
1466: 
1467: def POST(A):
1468:     """A refused lb at +0x07 sets d->warned & CRIME_W_LEN before anything else in the session."""
1469:     x, _ = ld(A, "lb", CRIME + 0x07, "v0")
1470:     return x
1471: 
1472: 
1473: # ---- P1: the REV PROM-probe window, POST.  CHANNEL: pc = ra, which only an ACCEPTED access
1474: #      reaches.  KILLS K2 (the REV 4-byte cell conjoined with the latch). ----
1475: A = Addr(CODE)
1476: c = ["ra=0x%x" % RA] + POST(A)
1477: for op in ("sw", "sd", "ld", "lw"):
1478:     if op[0] == "s":
1479:         x, _ = st(A, op, CRIME + 0, 0, at=PROBE_PC)
1480:     else:
1481:         x, _ = ld(A, op, CRIME + 0, "s0", at=PROBE_PC)
1482:     c += x + ["print pc"]
1483: t, clean = session(c)
1484: for i, k in enumerate(("sw", "sd", "ld", "lw")):
1485:     v = nth(t, "pc", i)
1486:     row("p revP %s pc" % k, "absent" if v is None else "0x%x" % v, "0x%x" % RA,
1487:         "POST: accepted %s CRIME_REV from the window -> ra" % k)
1488: row("p revP once", count(t, "-- declined.", clean), 1, "CONTROL: the session refused exactly once (the lb)")
1489: 
1490: # ---- P2: the twelve-cell value session, POST.  KILLS K1 (INTMASK 4W) and K3 (CONTROL 8R).
1491: #      The two CONTROL writes at the end drive the clause-(e) 0x0001 and 0x0201 cells into the
1492: #      `unimplemented' count row, so one count row covers three accesses. ----
1493: A = Addr(CODE)
1494: c = POST(A)
1495: x, _ = ld(A, "ld", CRIME + 0x08, "s0"); c += x
1496: x, _ = ld(A, "lw", CRIME + 0x08, "a0"); c += x                     # #529 repair 14: CONTROL 4R, HIGH lane (0 -- pairs with +0x0c)
1497: x, _ = ld(A, "lw", CRIME + 0x0c, "s4"); c += x                     # #529 repair 14: CONTROL 4R, LOW lane (0x100 -- the discriminating half)
1498: x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
1499: x, _ = ld(A, "ld", CRIME + 0x10, "s1"); c += x
1500: x, _ = ld(A, "lw", CRIME + 0x10, "v1"); c += x                     # #529 repair 14: ACCEPTS entry 21, the 4-BYTE twin
1501: x, _ = st(A, "sw", CRIME + 0x18, 0x10000000); c += x
1502: x, _ = ld(A, "ld", CRIME + 0x18, "s2"); c += x
