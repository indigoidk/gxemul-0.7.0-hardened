 554: /*
 555:  *  debugmsg_set_breakpoint():
 556:  *
 557:  *  Sets (level = VERBOSITY_ERROR .. VERBOSITY_DEBUG) or clears (level < 0)
 558:  *  a breakpoint on messages from a subsystem. When a message which is at
 559:  *  least as severe as the given level is printed for that subsystem, the
 560:  *  emulator enters the interactive debugger. E.g. level = VERBOSITY_WARNING
 561:  *  breaks on warnings and errors, but not on info/debug messages.
 562:  *
 563:  *  The subsystem name "ALL" (case insensitive) affects all subsystems.
 564:  *
 565:  *  Returns 1 if the subsystem name matched, 0 otherwise.
 566:  */
 567: int debugmsg_set_breakpoint(const char *subsystem_name, int level)
 568: {
 569: 	int n = 0;
 570: 
 571: 	if (level < 0)
 572: 		level = -1;
 573: 
 574: 	/*
 575: 	 *  #261: the "ALL" pseudo-subsystem also (dis)arms the global
 576: 	 *  break-on-ERROR toggle: `... all error` arms it, `... all off`
 577: 	 *  (level < 0) clears it. Only ERROR arms; warning/info/debug do not.
 578: 	 */
 579: 	if (strcasecmp("ALL", subsystem_name) == 0)
 580: 		debugmsg_break_on_error = (level == VERBOSITY_ERROR) ? 1 : 0;
 581: 
 582: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i) {
 583: 		if (strcasecmp("ALL", subsystem_name) != 0) {
 584: 			if (strcmp(subsystem_name, debugmsg_subsystem_name[i]) != 0)
 585: 				continue;
 586: 		}
 587: 
 588: 		if (debugmsg_breakpoint_level[i] < 0 && level >= 0)
 589: 			debugmsg_n_breakpoints ++;
 590: 		if (debugmsg_breakpoint_level[i] >= 0 && level < 0)
 591: 			debugmsg_n_breakpoints --;
 592: 
 593: 		debugmsg_breakpoint_level[i] = level;
 594: 
 595: 		++n;
 596: 	}
 597: 
 598: 	return n > 0;
 599: }
 600: 
 601: 
 602: /*
 603:  *  debugmsg_print_breakpoints():
 604:  *
 605:  *  Prints all subsystems which have a breakpoint on messages set.
 606:  */
 607: void debugmsg_print_breakpoints(void)
 608: {
 609: 	int n = 0;
 610: 
 611: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i) {
 612: 		if (debugmsg_breakpoint_level[i] < 0)
 613: 			continue;
 614: 
 615: 		const char* name = debugmsg_subsystem_name[i];
 616: 		if (i == SUBSYS_STARTUP)
 617: 			name = "(startup related)";
 618: 
 619: 		char buf[100];
 620: 		switch (debugmsg_breakpoint_level[i]) {
 621: 		case VERBOSITY_ERROR:
 622: 			snprintf(buf, sizeof(buf), "0: ERROR");
 623: 			break;
 624: 		case VERBOSITY_WARNING:
 625: 			snprintf(buf, sizeof(buf), "1: WARNING");
 626: 			break;
 627: 		case VERBOSITY_INFO:
 628: 			snprintf(buf, sizeof(buf), "2: INFO");
 629: 			break;
 630: 		case VERBOSITY_DEBUG:
 631: 			snprintf(buf, sizeof(buf), "3: DEBUG");
 632: 			break;
 633: 		default:
 634: 			snprintf(buf, sizeof(buf), "%i",
 635: 			    debugmsg_breakpoint_level[i]);
 636: 			break;
 637: 		}
 638: 
 639: 		if (n == 0)
 640: 			printf("Subsystem:          Break on messages at level:\n");
 641: 
 642: 		printf("%17s   %s\n", name, buf);
 643: 
 644: 		++n;
 645: 	}
 646: 
 647: 	/*
 648: 	 *  #270: the #261 global break-on-ERROR toggle is state SEPARATE from
 649: 	 *  the per-subsystem levels above: `breakpoint subsystem all error`
 650: 	 *  arms it, and a later `breakpoint subsystem <name> off` clears only
 651: 	 *  that subsystem's level, NOT the global. Without this line the
 652: 	 *  listing shows such a subsystem as unarmed while an ERROR-level
 653: 	 *  message from it still enters the debugger. Display only -- the
 654: 	 *  override itself is unchanged, and is now stated rather than hidden.
 655: 	 */
 656: 	if (debugmsg_break_on_error)
 657: 		printf("Also breaking on ERROR-level messages from ALL"
 658: 		    " subsystems, including subsystems with no breakpoint of"
 659: 		    " their own. (Armed by \"breakpoint subsystem all error\","
 660: 		    " cleared by \"breakpoint subsystem all off\".)\n");
 661: 
 662: 	if (n == 0 && !debugmsg_break_on_error)
 663: 		printf("No breakpoints on subsystem messages set.\n");
 664: }
