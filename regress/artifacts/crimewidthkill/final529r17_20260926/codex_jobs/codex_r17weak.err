1508: x, _ = ld(A, "ld", CRIME + 0x40, "a2"); c += x
1509: x, _ = st(A, "sd", CRIME + 0x08, 0x01); c += x
1510: x, _ = st(A, "sw", CRIME + 0x08, 0x0001); c += x          # EXTRA: CONTROL 4W 0x0001

