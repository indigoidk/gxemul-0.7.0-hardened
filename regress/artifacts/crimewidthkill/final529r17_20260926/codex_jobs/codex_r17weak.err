 625: def run_ops(ops, at):
 626:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
 627:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
 628:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
 629:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
