 876: for off, val in ((0x10, 0x01), (0x18, 0x01)):
 877:     x, _ = st(A, "sd", MACE + off, val); c += x
 878: x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x
 879: x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
 880: x, _ = ld(A, "lw", CRIME + 0x18, "a0"); c += x
 881: x, _ = ld(A, "ld", CRIME + 0x28, "s2"); c += x
 882: c += ["print s2", "print cause"]
 883: #  refused READS while HARDINT is nonzero (kimi-k3:cloud, fourth closing pass; the Opus seat measured it: a decline
 884: #  answering `d->reg[CRIME_HARDINT / 8]' scored 131/131 -- HARDINT is nonzero ONLY in this session, which read no refused
 885: #  answer; it answered 0x20 at both widths here).  The one answer SOURCE every other session left at 0.
 886: x, _ = ld(A, "lb", CRIME + 0x08, "t1"); c += x
 887: x, _ = ld(A, "lh", CRIME + 0x08, "s3"); c += x
 888: x, _ = st(A, "sh", CRIME + 0x08, 0x0800); c += x
 889: t, clean = session(c + ["print t1", "print s3"] + roundtrip(A))
 890: hint = nth(t, "s2", 0)
 891: row("gate hardint", "set" if hint else ("absent" if hint is None else "clear"), "set",
 892:     "CONTROL: two MACE stores latch HARDINT (raw %s)" % hint)
 893: row("gate line", ip2(nth(t, "cause", 0)), "set", "CONTROL: the CRIME line is asserted")
 894: row("gate run", pr(t, "v1"), "0x%x" % LIVE_VAL, "refused sh 0x800 +0x08 with an irq latched: CPUs run")
 895: row("gate lb v0", pr(t, "t1"), "0x0", "refused lb +0x08 with HARDINT nonzero answers 0")
 896: row("gate lh v0", pr(t, "s3"), "0x0", "refused lh +0x08 with HARDINT nonzero answers 0")
 897: 
 898: # ---- the TIME label: an accepted read returns the value of the PREVIOUS update, then updates -- so a refused access
 899: #  that reached crime_update_crime_time() would show in the NEXT read.  The first `ld' latches last_microseconds; on the
 900: #  fixed build the only other update before the next `ld' is the device tick's FIRST firing -- ticks_till_next starts at
 901: #  0, so it fires right after the session's first `ld' (the Opus closing seat; this said "nothing else updates TIME"
 902: #  until then), and it adds the few microseconds since the latch: the 66-990 the rows print (measured across 52 cells
 903: #  against SMALL = 6.6e6).  Later ticks are 2^14 cycles apart and a session steps a few dozen instructions; a fall-through at 0x38
 904: #  makes it the wall-clock interval of the intervening debugger commands, ~1e8.  The third `ld' is the CONTROL that the
 905: #  channel moves.  (Opus pass 2, E3; the tick-spacing wording corrected by the kimi CLI seat on the F2 pass.)
 906: #  ASSUMPTION, disclosed: after that FIRST tick, no further tick falls between the first `ld' and the `ld' that samples
 907: #  s1 (codex, closing pass: the window runs THROUGH the sampling read, not only to the refused access; deepseek and
 908: #  codex, second closing pass: this sentence said "no tick boundary" while the one above names the first tick).  The IRQ rows carry the same assumption:
 909: #  dev_crime_tick also calls crime_interrupt_reassert(), so a tick inside a session could raise IP2 on the fixed build
 910: #  (kimi CLI, closing pass) -- a false red, never a false green; measured stable so far.
 911: SMALL = 66 * 100000
 912: 
 913: 
 914: def mag(v):
 915:     return "absent" if v is None else ("small" if v < SMALL else "large")
 916: 
 917: 
 918: for op in ("lb", "sb", "lh", "sh"):
 919:     A = Addr(CODE)
 920:     c = []
 921:     x, _ = ld(A, "ld", CRIME + 0x38, "s0"); c += x
 922:     if op in ("lb", "lh"):
 923:         x, _ = ld(A, op, CRIME + 0x38, "v0"); c += x
 924:     else:
 925:         x, _ = st(A, op, CRIME + 0x38, 0xff if op == "sb" else 0xffff); c += x
 926:     x, _ = ld(A, "ld", CRIME + 0x38, "s1"); c += x
 927:     x, _ = ld(A, "ld", CRIME + 0x38, "s2"); c += x
 928:     if op == "lb":                                  # a second refusal: the TIME-first latch cell
 929:         x, _ = ld(A, "lb", CRIME + 0x07, "v1"); c += x
 930:     t, clean = session(c + ["print s1", "print s2", "print v0"])
 931:     s1, s2 = nth(t, "s1", 0), nth(t, "s2", 0)
 932:     row("time %s" % op, mag(s1), "small", "after refused %s +0x38 (raw %s)" % (op, s1))
 933:     row("time %s ctl" % op, mag(s2), "large", "CONTROL: accepted ld moved TIME (raw %s)" % s2)
 934:     if op in ("lb", "lh"):
 935:         row("time %s v0" % op, pr(t, "v0"), "0x0", "refused %s +0x38 answers 0" % op)
 936:     if op == "lb":
 937:         row("time once", count(t, "-- declined.", clean), 1, "first refusal at CRIME_TIME, then +0x07: one notice")
 938:         row("time said", said(t, 1, 0x38, clean), 1, "lb +0x38 (first refusal): its own announce")
 939: 
 940: # ---- #529 REPAIR 15: THE DECLINE HOLDS WITH THE LATCH ALREADY SET, at the two labels whose leak no row saw ----
 941: #  The `time' and `rev' sessions above refuse at TIME/REV FIRST, so the width latch is still CLEAR there -- and a
 942: #  `goto' conditioned on the SET latch plus the label (M3_timelatch, M5_revlatch; repair14_20260916/, table 12)
 943: #  never leaks in them.  (The `latch x5' session below refuses at +0x00 and +0x38 with the latch SET, but from CODE
 944: #  -- REV's redirect needs the PROM window -- and with no TIME sample after, so neither leak had a channel there.)
 945: #  Here the FIRST refusal is at +0x07 (the default arm; it sets the latch), and only THEN the refusal at the label.
 946: #  CHANNELS: TIME -- crime_update_crime_time() at the refused access moves the next sample by the wall-clock since
 947: #  the last update (large vs SMALL: the `time' rows' channel, and their disclosed tick assumption; the extra +0x07
 948: #  access adds debugger steps, never a TIME update, on a fix build); REV -- the arm's PROM-window hack redirects the
 949: #  pc to ra (the `rev pc' rows' channel).  All four narrow ops at each label because repair 14's ruling C asked for
 950: #  them -- a STRENGTHENING over the floor, which is {label} x {latch SET}: the decline block tests neither width
 951: #  within the narrow class nor direction.  (INTSTAT and INTMASK do not have all four in both latch states: see the
 952: #  contract block.  This said "the four are the width x direction cells a leak keyed on either could use" --
 953: #  repair 15's pass 2, four seats.)
 954: for op in ("lb", "sb", "lh", "sh"):
 955:     A = Addr(CODE)
 956:     c = []
 957:     x, _ = ld(A, "ld", CRIME + 0x38, "s0"); c += x
 958:     x, _ = ld(A, "lb", CRIME + 0x07, "v1"); c += x          # the FIRST refusal: sets the latch
 959:     if op in ("lb", "lh"):
 960:         x, _ = ld(A, op, CRIME + 0x38, "v0"); c += x
 961:     else:
 962:         x, _ = st(A, op, CRIME + 0x38, 0xff if op == "sb" else 0xffff); c += x
 963:     x, _ = ld(A, "ld", CRIME + 0x38, "s1"); c += x
 964:     x, _ = ld(A, "ld", CRIME + 0x38, "s2"); c += x
 965:     t, clean = session(c + ["print s1", "print s2"])
 966:     s1, s2 = nth(t, "s1", 0), nth(t, "s2", 0)
 967:     row("tl %s" % op, mag(s1), "small", "latch SET, refused %s +0x38: no clock step (raw %s)" % (op, s1))
 968:     row("tl %s ctl" % op, mag(s2), "large", "CONTROL: accepted ld moved TIME (raw %s)" % s2)
 969: 
 970: for op in ("lb", "lh", "sb", "sh"):
 971:     A = Addr(CODE)
 972:     y, _ = ld(A, "lb", CRIME + 0x07, "v1")                 # the FIRST refusal, from CODE: sets the latch
 973:     if op in ("lb", "lh"):
 974:         x, _ = ld(A, op, CRIME + 0, "v0", at=PROBE_PC)
 975:     else:
 976:         x, _ = st(A, op, CRIME + 0, 0xa5 if op == "sb" else 0xa5a5, at=PROBE_PC)
 977:     t, clean = session(["ra=0x%x" % RA] + y + x + AFTER)
 978:     row("rl %s pc" % op, pr(t, "pc"), "0x%x" % (PROBE_PC + 4),
 979:         "latch SET, refused %s at CRIME_REV from 0xbfc05180: pc NOT ra" % op)
 980: 
 981: # ---- #529 REPAIR 15: ACCEPTS entries 13/17, CONTROL's DOG-only writes (FABLE_RULING_20260917.md B) ----
 982: #  `sw'/`sd +0x08 = 0x0200': the arm clears DOG, the residue is 0 and nothing prints, and the prelude re-forces
 983: #  CONTROL at every access -- so the CONTROL text COUNT is the cell's one observable, and no session holding a
 984: #  0x0200 write read it (the ACCEPTS sessions count `-- declined.'; `p acc ctl msg' writes 0x01, 0x0001 and
 985: #  0x0201).  MUTANT: D_nodogclear, the DOG branch's `idata &= ~CRIME_CONTROL_DOG_ENABLE;' deleted -- the arm's own
 986: #  tested bit with its repair nulled -- prints for 0x0200.  Each width is one session: the 0x0200 write, then its
 987: #  0x0201 twin, the in-session LIVENESS half of the pair (a bare count of 0 is green under a dead channel or a
 988: #  declined write).  CHANNEL: fix ONE text, the twin's; D_nodogclear TWO.  A silent decline of the 0x0200 write
 989: #  still reads ONE -- EQUIVALENT, since no access can see the cell (disclosed in the contract).
 990: for op in ("sw", "sd"):
 991:     A = Addr(CODE)
 992:     x, _ = st(A, op, CRIME + 0x08, 0x0200)
 993:     y, _ = st(A, op, CRIME + 0x08, 0x0201)
 994:     t, clean = session(x + y)
 995:     row("ctldog %s msg" % op, count(t, "CRIME_CONTROL: unimplemented", clean), 1,
 996:         "%s 0x0200 then 0x0201 +0x08: ONE CONTROL text (the count; the value is not read -- see the contract)" % op)
 997: 
 998: # ---- #529 REPAIR 16: HARD_RESET's residue with the latch CLEAR (repair 15's pass 2) ----
 999: #  An accepted `sw'/`sd +0x08 = 0x0800' stops every CPU, and because the branch clears HARD_RESET before the residue
1000: #  test it prints nothing.  No row counted the CONTROL text in a session holding an accepted 0x0800 write, so a build
1001: #  that skipped that clear passed every row while the CPUs still stopped (table15a_20260926/).  The halt ends the
1002: #  guest's work, so the twin comes FIRST: 0x0001 (residue 0x1, one text), then 0x0800 as the session's last store.
1003: #  CHANNELS: the text count -- ONE on the fixed build, TWO if the clear is skipped -- and the halt: v1 left at the
1004: #  sentinel by the RAM trip that cannot run, which shows a write stopped the CPUs; that it was the 0x0800 rests on
1005: #  the twin not halting, which `rearm surv'/`latch surv' pin (T_halttwin reads identically here:
1006: #  repair16_f2_20260926/opus_f2/pc_ctlrst.out).
1007: #  KILLS: `ctlrst sw halt' <- S_rst4clr (CONTROL=FAIL because `sw08 halts' is a CONTROL row -- a detection, not an
1008: #  apparatus failure: repair16_f2_20260926/opus_f2/runs/probe_S_rst4clr.raw); `ctlrst sd halt' <- S_rst8clr
1009: #  (table16_20260926/).
1010: for op in ("sw", "sd"):
1011:     A = Addr(CODE)
1012:     x, _ = st(A, op, CRIME + 0x08, 0x0001)
1013:     y, _ = st(A, op, CRIME + 0x08, 0x0800)
1014:     t, clean = session(x + y + AFTER + roundtrip(A))
1015:     row("ctlrst %s msg" % op, count(t, "CRIME_CONTROL: unimplemented", clean), 1,
1016:         "%s 0x0001 then 0x0800 +0x08: ONE CONTROL text (the count; the value is not read -- see the contract)" % op)
1017:     row("ctlrst %s halt" % op, pr(t, "v1"), "0x%x" % SENT, "%s 0x0800 +0x08 after the twin: CPUs stopped" % op)
1018: 
1019: # ---- a refused store leaves the register it names untouched (CRIME_DOG seeded by an accepted sd) ----
1020: A = Addr(CODE)
1021: c = []
1022: x, _ = st(A, "sd", CRIME + 0x30, 0x0123456789abcdef); c += x
1023: x, _ = st(A, "sb", CRIME + 0x37, 0xa5); c += x
1024: x, _ = ld(A, "ld", CRIME + 0x30, "a0"); c += x
1025: x, _ = st(A, "sh", CRIME + 0x30, 0x5a5a); c += x
1026: x, _ = ld(A, "ld", CRIME + 0x30, "a1"); c += x
1027: #  the codex seat, F2: every other refused read runs in a COLD session, so an `odata' that survived from the previous
1028: #  call (`static uint64_t idata = 0, odata = 0;') answered 0 there by luck.  Here a refused lbu follows accepted reads
1029: #  of a nonzero register; and the announce count across refused-accepted-refused catches a latch re-armed by an
1030: #  accepted access (`d->warned = 0;' in an accept arm), which `latch x5' -- no accepted access -- cannot.
1031: x, _ = ld(A, "lbu", CRIME + 0x07, "v0"); c += x
1032: #  a SEEDED slot with address bit 4 CLEAR (the Opus third-closing seat, measured: every refused store the rows read back
1033: #  had bit 4 set, so a landing keyed on bit 4 clear passed); +0x40 reaches the default arm
1034: x, _ = st(A, "sd", CRIME + 0x40, 0x0123456789abcdef); c += x
1035: x, _ = st(A, "sb", CRIME + 0x47, 0xff); c += x
1036: x, _ = st(A, "sh", CRIME + 0x44, 0xffff); c += x
1037: #  and a refused HALFWORD with address bit 1 SET (codex, fourth closing pass; the Opus seat measured it: every read-back
1038: #  refused 2-byte store cleared bit 1 -- +0x18, +0x30, +0x44, +0x1fc, +0x27c -- so a 2W landing keyed on bit 1 scored
1039: #  131/131).  +0x42 / 8 is the +0x40 slot, which `lo keeps' reads back.
1040: x, _ = st(A, "sh", CRIME + 0x42, 0xffff); c += x

