 150: 
 151: 	/*
 152: 	 *  #261: opt-in global break on any ERROR-level message (covers every
 153: 	 *  subsystem, incl. ones registered after a per-subsystem breakpoint
 154: 	 *  was set). Default off = single false test = no-op.
 155: 	 */
 156: 	bool do_bp = (debugmsg_n_breakpoints > 0 &&
 157: 	    debugmsg_breakpoint_level[subsystem] >= 0 &&
 158: 	    verbosity <= debugmsg_breakpoint_level[subsystem]);
 159: 	if (debugmsg_break_on_error && verbosity <= VERBOSITY_ERROR)
 160: 		do_bp = true;
 161: 
 162: 	if (do_bp) {
 163: 		/*
 164: 		 *  This message triggers a breakpoint on subsystem messages:
 165: 		 *  make sure the message itself is shown (even if the current
 166: 		 *  verbosity setting would have suppressed it), and request
 167: 		 *  entry into the interactive debugger. The debugger is
 168: 		 *  entered after the current instruction batch, using the
 169: 		 *  same mechanism as normal breakpoints.
 170: 		 */
 171: 		subsystem_breakpoint = true;
 172: 
 173: 		if (!single_step && !about_to_enter_single_step) {
 174: 			fatal("[ subsystem breakpoint: %s ]\n",
 175: 			    debugmsg_subsystem_name[subsystem][0] != '\0'
 176: 			    ? debugmsg_subsystem_name[subsystem] : "(startup)");
 177: 			about_to_enter_single_step = true;
 178: 		}
 179: 	}
 180: 
 181: 	if (!subsystem_breakpoint && !single_step &&
 182: 	    !ENOUGH_VERBOSITY(subsystem, verbosity))
 183: 		return;
 184: 
 185: 	char buf[DEBUG_BUFSIZE];
 186: 
 187: 	buf[0] = buf[DEBUG_BUFSIZE - 1] = 0;
 188: 	vsnprintf(buf, DEBUG_BUFSIZE, fmt, argp);
 189: 
 190: 	char* s = buf;
 191: 	bool ss = single_step || about_to_enter_single_step;
 192: 	bool debug_currently_at_start_of_line = true;
 193: 	bool show_decorations = emul_executing && !ss;
 194: 
 195: 	if (console_are_slaves_allowed())
 196: 		show_decorations = false;
 197: 
 198: 	while (true) {
 199: 		if (debug_currently_at_start_of_line) {
 200: 			if (show_decorations) {
 201: 				color_normal();
 202: 				printf("[ ");
 203: 			} else {
 204: 				for (size_t i = 0; i < debug_indent * DEBUG_INDENTATION; ++i)
 205: 					printf(" ");
 206: 			}
 207: 
 208: 			bool print_subsystem_name =
 209: 			    debugmsg_subsystem_name[subsystem][0] != '\0' &&
 210: 			    (debug_indent == 0 || (name == NULL || name[0] == '\0'));
 211: 			bool print_colon = false;
 212: 
 213: 			if (cpu != NULL) {
 214: 				// With multiple machines being emulated in the
 215: 				// same emulation instance, print both the machine
 216: 				// name and cpu id. If it is just one machine,
 217: 				// only print the cpu id if there are multiple
 218: 				// CPUs in order to not clutter the output
 219: 				// needlessly.
 220: 				struct emul* emul = cpu->machine->emul;
 221: 				if (emul->n_machines > 1) {
 222: 					printf("machine \"%s\" cpu%i: ",
 223: 					    cpu->machine->name ? cpu->machine->name : "(no name)",
 224: 					    cpu->cpu_id);
 225: 					if (subsystem == SUBSYS_CPU)
 226: 						print_subsystem_name = false;
 227: 				} else if (cpu->machine->ncpus > 1) {
 228: 					printf("cpu%i: ", cpu->cpu_id);
 229: 					if (subsystem == SUBSYS_CPU)
 230: 						print_subsystem_name = false;
 231: 				}
 232: 			}
 233: 
 234: 			if (verbosity == VERBOSITY_ERROR)
 235: 				color_error(false);
 236: 			else
 237: 				color_debugmsg_subsystem();
 238: 
 239: 			if (print_subsystem_name) {
 240: 				printf("%s", debugmsg_subsystem_name[subsystem]);
 241: 				print_colon = true;
 242: 			}
 243: 
 244: 			if (name != NULL && name[0] != '\0') {
 245: 				if (print_subsystem_name)
 246: 					printf(" ");
 247: 
 248: 				if (verbosity != VERBOSITY_ERROR)
 249: 					color_debugmsg_name();
 250: 
 251: 				printf("%s", name);
 252: 
 253: 				print_colon = true;
 254: 			}
 255: 
 256: 			if (print_colon)
 257: 				printf(": ");
 258: 
 259: 			if (show_decorations) {
 260: 				for (size_t i = 0; i < debug_indent * DEBUG_INDENTATION; ++i)
 261: 					printf(" ");
 262: 			}
 263: 
 264: 			if (verbosity == VERBOSITY_ERROR)
 265: 				color_error(true);
 266: 			else
 267: 				color_normal();
 268: 		}
 269: 
 270: 		debug_currently_at_start_of_line = false;
 271: 
 272: 		if (!*s)
 273: 			break;
 274: 
 275: 		switch (*s) {
 276: 		case '\n':
 277: 			color_normal();
 278: 			if (show_decorations) {
 279: 				printf(" ]");
 280: 			}
 281: 
 282: 			debug_currently_at_start_of_line = true;
 283: 			printf("\n");
 284: 			break;
 285: 
 286: 		default:
 287: 			printf("%c", *s);
 288: 		}
 289: 
 290: 		s++;
 291: 	}
 292: 
 293: 	color_normal();
 294: 
 295: 	if (show_decorations)
 296: 		printf(" ]");
 297: 
 298: 	if (!debug_currently_at_start_of_line)
 299: 		printf("\n");
 300: }
