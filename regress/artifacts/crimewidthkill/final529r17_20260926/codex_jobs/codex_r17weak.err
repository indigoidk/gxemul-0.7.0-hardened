 667: /*
 668:  *  debugmsg_init():
 669:  *
 670:  *  Initializes the debugmsg functionality.
 671:  */
 672: void debugmsg_init()
 673: {
 674: 	debugmsg_nr_of_subsystems = 11;
 675: 	debugmsg_subsystem_name = malloc(sizeof(char*) * debugmsg_nr_of_subsystems);
 676: 	debugmsg_current_verbosity = malloc(sizeof(int) * debugmsg_nr_of_subsystems);;
 677: 	debugmsg_breakpoint_level = malloc(sizeof(int) * debugmsg_nr_of_subsystems);
 678: 
 679: 	// No breakpoints on subsystem messages initially.
 680: 	for (size_t i = 0; i < debugmsg_nr_of_subsystems; ++i)
 681: 		debugmsg_breakpoint_level[i] = -1;
 682: 
 683: 	debugmsg_subsystem_name[SUBSYS_STARTUP]   = "";
 684: 	debugmsg_subsystem_name[SUBSYS_EMUL]      = "emul";
 685: 	debugmsg_subsystem_name[SUBSYS_DISK]      = "disk";
 686: 	debugmsg_subsystem_name[SUBSYS_NET]       = "net";
 687: 	debugmsg_subsystem_name[SUBSYS_MACHINE]   = "machine";
 688: 	debugmsg_subsystem_name[SUBSYS_DEVICE]    = "device";
 689: 	debugmsg_subsystem_name[SUBSYS_CPU]       = "cpu";
 690: 	debugmsg_subsystem_name[SUBSYS_MEMORY]    = "memory";
 691: 	debugmsg_subsystem_name[SUBSYS_EXCEPTION] = "exception";
 692: 	debugmsg_subsystem_name[SUBSYS_PROMEMUL]  = "promemul";
 693: 	debugmsg_subsystem_name[SUBSYS_X11]       = "X11";
 694: 
 695: 	// Default verbosity levels.
 696: 	debugmsg_set_verbosity_level(SUBSYS_ALL, default_verbosity);
 697: }
