  530: def row(name, got, want, note=""):
  531:     ok = (got == want)
  532:     rows.append((name, ok))
  533:     print("%-16s %-20s %-20s %-40s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
  534:     sys.stdout.flush()
