for i,(op,off,val) in enumerate(accepts,1):
    print(f'{i:2}: {op:3} +0x{off:03x} value=0x{val:04x}')

def value(n,env):
    if isinstance(n,ast.Constant): return n.value
    if isinstance(n,ast.Name): return env[n.id]
    if isinstance(n,(ast.Tuple,ast.List)): return [value(x,env) for x in n.elts]
    if isinstance(n,ast.BinOp) and isinstance(n.op,ast.Mod):
        rhs=value(n.right,env)
        return value(n.left,env) % (tuple(rhs) if isinstance(rhs,list) else rhs)
    if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='enumerate': return list(enumerate(value(n.args[0],env)))
    if isinstance(n,ast.Compare) and len(n.ops)==1:
        a,b=value(n.left,env),value(n.comparators[0],env)
        if isinstance(n.ops[0],ast.Eq): return a==b
        if isinstance(n.ops[0],ast.In): return a in b
    raise ValueError(ast.dump(n))

def bind(target,v,env):
    if isinstance(target,ast.Name): env[target.id]=v
    else:
        for x,y in zip(target.elts,v): bind(x,y,env)

def contains_row(n):
    return any(isinstance(x,ast.Call) and isinstance(x.func,ast.Name) and x.func.id=='row' for x in ast.walk(n))

rows=[]
def walk(body,env):
    for n in body:
        if isinstance(n,(ast.FunctionDef,ast.ClassDef)): continue
        if isinstance(n,ast.Expr) and isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id=='row': rows.append((value(n.value.args[0],env),n.lineno))
        elif isinstance(n,ast.For) and contains_row(n):
            for v in value(n.iter,env):
                local=dict(env);bind(n.target,v,local);walk(n.body,local)
        elif isinstance(n,ast.If) and contains_row(n): walk(n.body if value(n.test,env) else n.orelse,env)
walk(t.body,{})
