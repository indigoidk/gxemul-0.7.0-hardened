import ast
from pathlib import Path
p=Path(r'GXEMUL-SEC\\regress\\artifacts\\crimewidthkill\\final529r17_20260926\\crime_width_probe.r17.py')
t=ast.parse(p.read_text(encoding='utf-8'))
accepts=next(ast.literal_eval(n.value) for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='ACCEPTS' for x in n.targets))
