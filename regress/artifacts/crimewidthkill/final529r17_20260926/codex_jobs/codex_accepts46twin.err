  615: class Addr(object):
  616:     def __init__(self, base):
  617:         self.a = base
  618: 
  619:     def take(self, n):
  620:         got = self.a
  621:         self.a += 4 * (n + 2) + 0x20
  622:         return got
  623: 
  624: 
  625: def run_ops(ops, at):
  626:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
  627:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
  628:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
  629:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
  630: 
  631: 
  632: def ld(A, op, addr, rt, at=None):
  633:     """one load `op rt, 0(at)', rt seeded with SENT; returns (cmds, code address)"""
  634:     here = A.take(1) if at is None else at
  635:     return ["at=0x%x" % addr, "%s=0x%x" % (rt, SENT)] + run_ops([enc(op, "at", rt)], here), here
  636: 
  637: 
  638: def st(A, op, addr, val, at=None):
  639:     here = A.take(1) if at is None else at
  640:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([enc(op, "a3", "t0")], here), here
  641: 
  642: 
  643: AFTER = ["print pc", "print cause"]
  644: 
  645: 
  646: def roundtrip(A):
  647:     """a RAM round trip printed in v1: absent if the host died, the sentinel if the CPU was stopped"""
  648:     c1, _ = st(A, "sw", SCRATCH_RAM, LIVE_VAL)
  649:     c2, _ = ld(A, "lw", SCRATCH_RAM, "v1")
  650:     return c1 + c2 + ["print v1"]
  651: 
  652: 
  653: def said(t, ln, off, clean):
  654:     """the whole announce, `(once)' marker included -- a reworded or unmarked announce reads 0"""
  655:     return count(t, "unimplemented len=%d at 0x%x -- declined.  (once) ]" % (ln, off), clean)
  656: 
  657: 
  658: def dflt(t, clean, off, write):
  659:     """the register switch's default-arm debug() line FOR THIS REFUSED ACCESS -- `[ crime: read from 0xOFF,' or
  660:     `[ crime: write to 0xOFF:' -- printed while stepping, so a refused access that falls into the switch at an
  661:     unlabelled offset says so here.  Keyed on the access's own offset and direction, because an ACCEPTED access at a
  662:     default-arm offset in the same session prints the same kind of line (hi keeps' ld +0x278 does)."""
  663:     if not clean:
  664:         return "unclean"
  665:     return t.count(("[ crime: write to 0x%x:" if write else "[ crime: read from 0x%x,") % off)
  666: 
  667: 
  668: print("CRIME WIDTH PROBE (#529) -- rung 3, unmodified -E sgi -e ip32   binary=%s  label=%s" % (BIN, LABEL))
  669: print("%-16s %-20s %-20s %-40s %s" % ("row", "got", "want", "note", ""))
  670: 
  671: # ---- CONTROLS: liveness + device signature, one session ----
  672: A = Addr(CODE)
  673: c = roundtrip(A)
  674: x, _ = ld(A, "lw", CRIME + 4, "s1"); c += x
  675: x, _ = ld(A, "lw", CRIME + 0, "s2"); c += x
  676: x, _ = ld(A, "ld", CRIME + 0, "s3"); c += x
  677: t, clean = session(c + ["print s1", "print s2", "print s3"])
  678: row("live", pr(t, "v1"), "0x%x" % LIVE_VAL, "LIVENESS: RAM round trip, same apparatus")
  679: row("devsig", pr(t, "s1"), "0x11", "CRIME_REV low half = rev 0x11: a device")
  680: row("devsig hi", pr(t, "s2"), "0x0", "CRIME_REV high half reads 0")
  681: row("dflt ctl", count(t, "[ crime: read from 0x4,", clean), 1, "CONTROL: default-arm text prints when stepped")
  682: #  grok, closing pass: the NEAR end of the 8-byte accept window is +0x00, not CRIME_DOG -- `len == 8 && relative_addr
  683: #  != 0' passed the 85-row version.  Anchored: the prelude writes CRIME_REV's revision on every access, so an 8R there
  684: #  reads 0x11 from a channel outside the decode (an 8W round trip there is impossible for the same reason: disclosed).
  685: row("acc8 near", pr(t, "s3"), "0x11", "8R at +0x00 (the window's first slot): CRIME_REV")
  686: 
  687: # ---- the switch channels are LIVE on an accepted width (else rows 3.x could not vary) ----
  688: A = Addr(CODE)
  689: x, _ = ld(A, "lw", CRIME + 0, "v0", at=PROBE_PC)
  690: t, clean = session(["ra=0x%x" % RA] + x + AFTER)
  691: row("rev pc ctl", pr(t, "pc"), "0x%x" % RA, "CONTROL: lw CRIME_REV from 0xbfc051xx -> ra")
  692: 
  693: A = Addr(CODE)
  694: x, _ = st(A, "sw", CRIME + 0x08, 0x0800)
  695: t, clean = session(x + AFTER + roundtrip(A))
  696: row("sw08 halts", pr(t, "v1"), "0x%x" % SENT, "CONTROL: sw 0x800 +0x08 stops CPUs (crimectllane)")
  697: 
  698: A = Addr(CODE)
  699: x, _ = st(A, "sw", CRIME + 0x08, 0x01)
  700: t, clean = session(x + AFTER + roundtrip(A))
  701: row("sw08 msg ctl", count(t, "CRIME_CONTROL: unimplemented", clean), 1, "CONTROL: sw 0x01 +0x08 prints the text")
  702: 
  703: # ---- ACCEPT cells on CRIME_DOG (0x030): 8W, 8R, 4R hi/lo, 4W lo/hi -- nonzero wants ----
  704: A = Addr(CODE)
  705: c = []
  706: x, _ = st(A, "sd", CRIME + 0x30, 0x1122334455667788); c += x   # 8W
  707: x, _ = ld(A, "ld", CRIME + 0x30, "a0"); c += x                  # 8R
  708: x, _ = ld(A, "lw", CRIME + 0x30, "a1"); c += x                  # 4R high half
  709: x, _ = ld(A, "lw", CRIME + 0x34, "a2"); c += x                  # 4R low half
  710: x, _ = st(A, "sw", CRIME + 0x34, 0x0badcafe); c += x            # 4W low half
  711: x, _ = ld(A, "ld", CRIME + 0x30, "s0"); c += x
  712: x, _ = st(A, "sw", CRIME + 0x30, 0x0defaced); c += x            # 4W high half
  713: x, _ = ld(A, "ld", CRIME + 0x30, "s3"); c += x
  714: t, clean = session(c + ["print a0", "print a1", "print a2", "print s0", "print s3"])
  715: row("acc8 st+ld", pr(t, "a0"), "0x1122334455667788", "8W then 8R at CRIME_DOG")
  716: row("acc4 rhi", pr(t, "a1"), "0x11223344", "4R of the high half (+0x30)")
  717: row("acc4 rlo", pr(t, "a2"), "0x55667788", "4R of the low half (+0x34)")
  718: row("acc4 wlo", pr(t, "s0"), "0x112233440badcafe", "4W low half lands, high half kept")
  719: row("acc4 whi", pr(t, "s3"), "0xdefaced0badcafe", "4W high half lands, low half kept")
  720: 
  721: # ---- REFUSED widths, one session each: value, pc, exccode, survival, own announce ----
  722: for op, off, full in (("lb", 7, True), ("lh", 6, True), ("lbu", 7, False), ("lhu", 6, False)):
  723:     A = Addr(CODE)
  724:     x, here = ld(A, op, CRIME + off, "v0")
  725:     t, clean = session(x + AFTER + ["print v0"] + roundtrip(A))
  726:     ln = 1 if op in ("lb", "lbu") else 2
  727:     row("%s v0" % op, pr(t, "v0"), "0x0", "declined read answers 0 (dest seeded 0x%x)" % SENT)
  728:     if full:
  729:         row("%s pc" % op, pr(t, "pc"), "0x%x" % (here + 4), "pc advances, no vector")
  730:         row("%s exc" % op, exc(t), "0", "cause.ExcCode 0 (a bus error is 7)")
  731:         row("%s said" % op, said(t, ln, off, clean), 1, "own announce, len=%d at 0x%x, once" % (ln, off))
  732:         row("%s nodflt" % op, dflt(t, clean, off, False), 0, "switch default arm NOT reached at 0x%x" % off)
  733:     row("%s surv" % op, pr(t, "v1"), "0x%x" % LIVE_VAL, "host survives, then a RAM trip")
  734: 
  735: for op, off, val in (("sb", 0x1f, 0xff), ("sh", 0x1e, 0xffff)):
  736:     A = Addr(CODE)
  737:     x, here = st(A, op, CRIME + off, val)
  738:     t, clean = session(x + AFTER + roundtrip(A))
  739:     ln = 1 if op == "sb" else 2
  740:     row("%s pc" % op, pr(t, "pc"), "0x%x" % (here + 4), "pc advances, no vector")
  741:     row("%s exc" % op, exc(t), "0", "cause.ExcCode 0 (a bus error is 7)")
  742:     row("%s said" % op, said(t, ln, off, clean), 1, "own announce, len=%d at 0x%x, once" % (ln, off))
  743:     row("%s nodflt" % op, dflt(t, clean, off, True), 0, "switch default arm NOT reached at 0x%x" % off)
  744:     row("%s surv" % op, pr(t, "v1"), "0x%x" % LIVE_VAL, "host survives, then a RAM trip")
  745: 
  746: # ---- the switch is NOT entered by a refused width, per cell (contract 3) ----
  747: A = Addr(CODE)
  748: x, here = st(A, "sh", CRIME + 0x08, 0x0800)
  749: t, clean = session(x + AFTER + roundtrip(A))
  750: row("sh08 pc", pr(t, "pc"), "0x%x" % (here + 4), "2W sh 0x800 +0x08: pc advances")
  751: row("sh08 run", pr(t, "v1"), "0x%x" % LIVE_VAL, "2W: CPUs NOT stopped (RAM trip runs)")
  752: 
  753: A = Addr(CODE)
  754: x, here = st(A, "sb", CRIME + 0x08, 0x01)
  755: f, _ = st(A, "sb", CRIME + 0x08, 0xff)          # all-ones (kimi CLI, closing pass): a fall-through keyed on ANY bit
  756: t, clean = session(x + f + AFTER + roundtrip(A))
  757: row("sb08 msg", count(t, "CRIME_CONTROL: unimplemented", clean), 0, "1W sb 0x01, 0xff +0x08: no CONTROL text")
  758: row("sb08 run", pr(t, "v1"), "0x%x" % LIVE_VAL, "1W: the session completes (a RAM trip)")
  759: 
  760: #  THE CONTROL ARM TESTS BITS OF idata, so the 2-byte write cell owes each tested bit written both clear and set (the
  761: #  generating-set clause; the Opus seat, F2: `relative_addr != CRIME_CONTROL || !(idata & CRIME_CONTROL_DOG_ENABLE)'
  762: #  passed the 71-row version because no refused row carried DOG_ENABLE).  sh08 above writes HARD_RESET set / DOG clear;
  763: #  here 0x0201 writes HARD_RESET clear / DOG set / bit 0 (the arm would print its unimplemented-control text) and 0x0a00
  764: #  writes both set (the arm would stop every CPU).  A 1-byte write cannot carry either bit.
  765: A = Addr(CODE)
  766: x, _ = st(A, "sh", CRIME + 0x08, 0x0201)
  767: e, _ = st(A, "sh", CRIME + 0x08, 0x0900)       # glm, closing pass: ENDIANESS (0x0100) -- CLEARED by the arm, never
  768:                                                # branched on (this said "the arm's third tested bit" until repair 12)
  769: y, _ = st(A, "sh", CRIME + 0x08, 0x0a00)
  770: f, _ = st(A, "sh", CRIME + 0x08, 0xffff)        # all-ones: every bit a data-keyed narrowing could key on, set
  771: #  and a follow-up refusal at ANOTHER label (the codex seat, second closing pass: a latch whose bit is keyed on one label,
  772: #  `CRIME_W_LEN << (relative_addr == L)', is invisible to a session that refuses only at L)
  773: g, _ = ld(A, "lb", CRIME + 0x07, "t1")
  774: t, clean = session(x + e + y + f + AFTER + roundtrip(A) + g)
  775: row("sh08b msg", count(t, "CRIME_CONTROL: unimplemented", clean), 0, "2W sh 0x0201 +0x08 (DOG set): no CONTROL text")
  776: row("sh08b run", pr(t, "v1"), "0x%x" % LIVE_VAL, "2W sh 0x0900, 0x0a00 +0x08 (E/DOG+RESET): CPUs NOT stopped")
  777: row("sh08b once", count(t, "-- declined.", clean), 1, "4 refusals at CONTROL, then +0x07: one notice")
  778: #  the FIRST refusal's own text (codex, third closing pass: a notice suppressed at one label -- or at one address-bit
  779: #  value -- and printed instead by the +0x07 follow-up still counts one; every said row sat at an offset with bit 1 set)
  780: row("sh08b said", said(t, 2, 0x8, clean), 1, "sh +0x08 (first refusal): its own announce")
  781: 
  782: for op in ("lb", "lh"):
  783:     A = Addr(CODE)
  784:     x, _ = ld(A, op, CRIME + 0, "v0", at=PROBE_PC)
  785:     more = ld(A, "lb", CRIME + 0x07, "v1")[0] if op == "lb" else []     # a second refusal: the REV-first latch cell
  786:     t, clean = session(["ra=0x%x" % RA] + x + AFTER + ["print v0"] + more)
  787:     row("%s rev pc" % op, pr(t, "pc"), "0x%x" % (PROBE_PC + 4), "%dR at CRIME_REV from 0xbfc05180: pc NOT ra"
  788:         % (1 if op == "lb" else 2))
  789:     row("%s rev v0" % op, pr(t, "v0"), "0x0", "refused %s at CRIME_REV answers 0" % op)
  790:     if op == "lb":
  791:         row("rev once", count(t, "-- declined.", clean), 1, "first refusal at CRIME_REV, then +0x07: one notice")
  792:         row("rev said", said(t, 1, 0x0, clean), 1, "lb +0x00 (first refusal, every address bit clear): its own announce")
  793: 
  794: #  the CRIME_REV arm's PROM-probe hack does not test writeflag, so the WRITE cells at +0 are side-effect cells too
  795: for op, val in (("sb", 0xa5), ("sh", 0xa5a5)):
  796:     A = Addr(CODE)
  797:     x, _ = st(A, op, CRIME + 0, val, at=PROBE_PC)
  798:     t, clean = session(["ra=0x%x" % RA] + x + AFTER)
  799:     row("%s rev pc" % op, pr(t, "pc"), "0x%x" % (PROBE_PC + 4), "%dW at CRIME_REV from 0xbfc05180: pc NOT ra"
  800:         % (1 if op == "sb" else 2))
  801: 
  802: # ---- the INTSTAT / INTMASK labels: their arm calls crime_interrupt_reassert(), which is NOT idempotent -- ----
  803: #  INTMASK = bit 28 and SOFTINT = bit 28 are stored with 8-byte writes; SOFTINT's store goes to the default arm and does
  804: #  NOT reassert, so the CPU's IP2 (cause bit 0x400) stays low until something reasserts.  A refused access at the label
  805: #  must leave it low; the accepted `lw' that follows is the CONTROL that the arm reasserts at once.  (Measured by the
  806: #  pass-2 Opus seat, opus_pass2_20260913/scripts/crime_p2_escape.py E1/E2: a fall-through at the label sets IP2.)
  807: #  BIT carries bit 0 as well (the kimi CLI seat, second closing pass): a refused read answers the low bytes of whatever
  808: #  the decline hands the tail, so with a register whose low bytes were 0 a decline that answered THE REGISTER
  809: #  (`odata = d->reg[relative_addr / 8]' at INTSTAT or INTMASK) read back 0 and passed.  AND in its TOP lanes (the Opus
  810: #  second-closing seat, measured 121/121 on the 0x10000001 seed): a decline that answers the bytes the ADDRESS names --
  811: #  `odata = d->reg[relative_addr / 8] >> (8 * (8 - len - (relative_addr & 7)))', the lane the model's own 4-byte read
  812: #  path uses -- reads bytes 0-1 at the label, which the 0x10000001 seed left 0.  So the seed is nonzero in byte 0, byte 1
  813: #  and the low byte; INTSTAT = SOFTINT | HARDINT and INTMASK both carry it; the reassert still sees bit 28.
  814: #  And glm (third closing pass) found a THIRD byte selection -- the 4-byte path's half, `reg >> 32' -- whose low bytes
  815: #  that seed left 0.  So the seed is now nonzero in EVERY byte: no selection of the register's bytes can answer 0.  (DOG,
  816: #  the far slot and the middle slot are seeded every-byte-nonzero already.)
  817: BIT = 0x0101010111010101
  818: 
  819: 
  820: def nth(t, reg, n):
  821:     ms = re.findall(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  822:     return int(ms[n], 16) if len(ms) > n else None
  823: 
  824: 
  825: def ip2(v):
  826:     return "absent" if v is None else ("set" if v & 0x400 else "clear")
  827: 
  828: 
  829: for lbl, off in (("imask", 0x18), ("istat", 0x10)):
  830:     A = Addr(CODE)
  831:     c = []
  832:     x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x
  833:     x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
  834:     c += ["print cause"]
  835:     x, _ = ld(A, "lb", CRIME + off, "a0"); c += x
  836:     c += ["print cause"]
  837:     x, _ = st(A, "sb", CRIME + off, 0xff); c += x
  838:     c += ["print cause"]
  839:     x, _ = ld(A, "lh", CRIME + off, "a1"); c += x
  840:     c += ["print cause"]
  841:     x, _ = st(A, "sh", CRIME + off, 0xffff); c += x
  842:     c += ["print cause"]
  843:     x, _ = ld(A, "lw", CRIME + off, "v0"); c += x
  844:     c += ["print cause", "print a0", "print a1"]
  845:     #  INTMASK read back by an accepted ld after the refused stores (kimi CLI, second closing pass: a landing that ORs
  846:     #  into INTMASK keeps bit 28, so the reassert rows cannot see it), then a follow-up refusal at ANOTHER label (codex:
  847:     #  a latch keyed on this one label is invisible to a session that refuses only here)
  848:     x, _ = ld(A, "ld", CRIME + 0x18, "s2"); c += x
  849:     x, _ = ld(A, "lb", CRIME + 0x07, "t1"); c += x
  850:     c += ["print s2"]
  851:     t, clean = session(c)
  852:     row("%s pre" % lbl, ip2(nth(t, "cause", 0)), "clear", "IP2 low after SOFTINT's default-arm store")
  853:     row("%s lb" % lbl, ip2(nth(t, "cause", 1)), "clear", "refused lb +0x%x: no reassert" % off)
  854:     row("%s sb" % lbl, ip2(nth(t, "cause", 2)), "clear", "refused sb +0x%x: no reassert" % off)
  855:     row("%s lh" % lbl, ip2(nth(t, "cause", 3)), "clear", "refused lh +0x%x: no reassert" % off)
  856:     row("%s sh" % lbl, ip2(nth(t, "cause", 4)), "clear", "refused sh +0x%x: no reassert" % off)
  857:     row("%s ctl" % lbl, ip2(nth(t, "cause", 5)), "set", "CONTROL: accepted lw +0x%x reasserts" % off)
  858:     row("%s once" % lbl, count(t, "-- declined.", clean), 1, "4 refusals at +0x%x, then +0x07: one notice" % off)
  859:     row("%s said" % lbl, said(t, 1, off, clean), 1, "lb +0x%x (first refusal): its own announce" % off)
  860:     row("%s lb v0" % lbl, pr(t, "a0"), "0x0", "refused lb +0x%x answers 0 (register 0x0101..01)" % off)
  861:     row("%s lh v0" % lbl, pr(t, "a1"), "0x0", "refused lh +0x%x answers 0 (register 0x0101..01)" % off)
  862:     if lbl == "imask":
  863:         row("imask keeps", pr(t, "s2"), "0x%x" % BIT, "refused sb/sh +0x18 leave INTMASK as stored (ld +0x18)")
  864: 
  865: # ---- THE DECLINE HOLDS WHILE AN INTERRUPT IS LATCHED (the Opus closing seat: `if (!d->reg[CRIME_HARDINT / 8]) goto
  866: #  crime_declined;' passed the 85-row version -- every refusal in it ran with HARDINT == 0, and the tail the goto jumps
  867: #  to READS HARDINT, so the field is a DEPENDS-ON operand; `if (!d->prev_asserted)' passed too).  The guest latches a
  868: #  hardware interrupt by two MACE stores (ISA interrupt status, then mask -> crime_interrupt_assert -> HARDINT), and
  869: #  -- INDEPENDENTLY, not as a consequence (grok, second closing pass: HARDINT's bit is not in the mask used here) --
  870: #  asserts the CRIME line (INTMASK and SOFTINT = BIT, reasserted by an accepted lw), then a refused sh 0x0800 at
  871: #  CRIME_CONTROL: falling into the switch there would stop every CPU.  Both states are rowed as controls: HARDINT reads
  872: #  nonzero, and IP2 is set.
  873: MACE = 0xbf310000                                   # KSEG1 of the `mace addr=0x1f310000' device (dev_sgi_ip32.c)
  874: A = Addr(CODE)
  875: c = []
  876: for off, val in ((0x10, 0x01), (0x18, 0x01)):
  877:     x, _ = st(A, "sd", MACE + off, val); c += x
  878: x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x
  879: x, _ = st(A, "sd", CRIME + 0x20, BIT); c += x
  880: x, _ = ld(A, "lw", CRIME + 0x18, "a0"); c += x
  881: x, _ = ld(A, "ld", CRIME + 0x28, "s2"); c += x
  882: c += ["print s2", "print cause"]
  883: #  refused READS while HARDINT is nonzero (kimi-k3:cloud, fourth closing pass; the Opus seat measured it: a decline
  884: #  answering `d->reg[CRIME_HARDINT / 8]' scored 131/131 -- HARDINT is nonzero ONLY in this session, which read no refused
  885: #  answer; it answered 0x20 at both widths here).  The one answer SOURCE every other session left at 0.
  886: x, _ = ld(A, "lb", CRIME + 0x08, "t1"); c += x
  887: x, _ = ld(A, "lh", CRIME + 0x08, "s3"); c += x
  888: x, _ = st(A, "sh", CRIME + 0x08, 0x0800); c += x
  889: t, clean = session(c + ["print t1", "print s3"] + roundtrip(A))
  890: hint = nth(t, "s2", 0)
  891: row("gate hardint", "set" if hint else ("absent" if hint is None else "clear"), "set",
  892:     "CONTROL: two MACE stores latch HARDINT (raw %s)" % hint)
  893: row("gate line", ip2(nth(t, "cause", 0)), "set", "CONTROL: the CRIME line is asserted")
  894: row("gate run", pr(t, "v1"), "0x%x" % LIVE_VAL, "refused sh 0x800 +0x08 with an irq latched: CPUs run")
  895: row("gate lb v0", pr(t, "t1"), "0x0", "refused lb +0x08 with HARDINT nonzero answers 0")
  896: row("gate lh v0", pr(t, "s3"), "0x0", "refused lh +0x08 with HARDINT nonzero answers 0")
  897: 
  898: # ---- the TIME label: an accepted read returns the value of the PREVIOUS update, then updates -- so a refused access
  899: #  that reached crime_update_crime_time() would show in the NEXT read.  The first `ld' latches last_microseconds; on the
  900: #  fixed build the only other update before the next `ld' is the device tick's FIRST firing -- ticks_till_next starts at
  901: #  0, so it fires right after the session's first `ld' (the Opus closing seat; this said "nothing else updates TIME"
  902: #  until then), and it adds the few microseconds since the latch: the 66-990 the rows print (measured across 52 cells
  903: #  against SMALL = 6.6e6).  Later ticks are 2^14 cycles apart and a session steps a few dozen instructions; a fall-through at 0x38
  904: #  makes it the wall-clock interval of the intervening debugger commands, ~1e8.  The third `ld' is the CONTROL that the
  905: #  channel moves.  (Opus pass 2, E3; the tick-spacing wording corrected by the kimi CLI seat on the F2 pass.)
  906: #  ASSUMPTION, disclosed: after that FIRST tick, no further tick falls between the first `ld' and the `ld' that samples
  907: #  s1 (codex, closing pass: the window runs THROUGH the sampling read, not only to the refused access; deepseek and
  908: #  codex, second closing pass: this sentence said "no tick boundary" while the one above names the first tick).  The IRQ rows carry the same assumption:
  909: #  dev_crime_tick also calls crime_interrupt_reassert(), so a tick inside a session could raise IP2 on the fixed build
  910: #  (kimi CLI, closing pass) -- a false red, never a false green; measured stable so far.
  911: SMALL = 66 * 100000
  912: 
  913: 
  914: def mag(v):
  915:     return "absent" if v is None else ("small" if v < SMALL else "large")
  916: 
  917: 
  918: for op in ("lb", "sb", "lh", "sh"):
  919:     A = Addr(CODE)
  920:     c = []
  921:     x, _ = ld(A, "ld", CRIME + 0x38, "s0"); c += x
  922:     if op in ("lb", "lh"):
  923:         x, _ = ld(A, op, CRIME + 0x38, "v0"); c += x
  924:     else:
  925:         x, _ = st(A, op, CRIME + 0x38, 0xff if op == "sb" else 0xffff); c += x
  926:     x, _ = ld(A, "ld", CRIME + 0x38, "s1"); c += x
  927:     x, _ = ld(A, "ld", CRIME + 0x38, "s2"); c += x
  928:     if op == "lb":                                  # a second refusal: the TIME-first latch cell
  929:         x, _ = ld(A, "lb", CRIME + 0x07, "v1"); c += x
