 1716: x, _ = ld(A, "lw", CRIME + 0x30, "a0"); c += x                      # DOG 4R high
 1717: x, _ = ld(A, "lw", CRIME + 0x34, "a1"); c += x                      # DOG 4R low
 1718: x, _ = st(A, "sw", CRIME + 0x34, 0x0badcafe); c += x                # DOG 4W low
 1719: x, _ = ld(A, "ld", CRIME + 0x30, "s3"); c += x
 1720: x, _ = st(A, "sw", CRIME + 0x30, 0x0feedbac); c += x                # EXTRA: DOG 4W HIGH
 1721: x, _ = ld(A, "ld", CRIME + 0x30, "ra"); c += x
 1722: x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x                       # INTMASK 8W
 1723: x, _ = ld(A, "ld", CRIME + 0x18, "a2"); c += x                      # INTMASK 8R
 1724: x, _ = st(A, "sd", CRIME + 0x278, 0x0102030405060708); c += x       # far block 8W
 1725: x, _ = ld(A, "ld", CRIME + 0x278, "t1"); c += x
 1726: t, clean = session(c + ["print s0", "print s1", "print s2", "print a0", "print a1", "print s3",
 1727:                         "print ra", "print a2", "print t1"] + roundtrip(A))
 1728: row("p rev ld", pr(t, "s0"), "0x11", "POST: accepted ld +0x00 answers CRIME_REV")
 1729: row("p rev lw4", pr(t, "s1"), "0x11", "POST: accepted lw +0x04 answers REV low lane")
 1730: row("p dog st+ld", pr(t, "s2"), "0x1122334455667788", "POST: 8W then 8R at CRIME_DOG")
 1731: row("p dog rhi", pr(t, "a0"), "0x11223344", "POST: 4R of the high half (+0x30)")
 1732: row("p dog rlo", pr(t, "a1"), "0x55667788", "POST: 4R of the low half (+0x34)")
 1733: row("p dog wlo", pr(t, "s3"), "0x112233440badcafe", "POST: 4W low half lands, high half kept")
 1734: row("p dog whi", pr(t, "ra"), "0xfeedbac0badcafe", "POST: 4W HIGH half lands, low half kept")
 1735: row("p imask st+ld", pr(t, "a2"), "0x%x" % BIT, "POST: 8W then 8R at CRIME_INTMASK")
 1736: row("p top st+ld", pr(t, "t1"), "0x102030405060708", "POST: 8W then 8R at +0x278")
 1737: row("p resid once", count(t, "-- declined.", clean), 1, "CONTROL: exactly one refusal (the lb)")
 1738: row("p resid surv", pr(t, "v1"), "0x%x" % LIVE_VAL, "CONTROL: the host survives (a RAM trip)")
 1739: 
 1740: #  *** REGISTER COLLISION, CAUGHT WHILE DRAFTING AND RECORDED RATHER THAN SILENTLY FIXED: the
 1741: #  prototype's residual-survival row reads `v1', which roundtrip() writes.  The DOG 4W-high
 1742: #  readback added here therefore CANNOT use v1 -- it would make one of the two rows read the
 1743: #  other's register and go green for the wrong reason, which is exactly the vacuity this repair
 1744: #  exists to close.  It is parked in `ra' above.  *** THIS NOTE SAID `t2' UNTIL 2026-09-16 20:0x, AND THE CODE SAID
 1745: #  `ra' -- I repointed the CODE when the first run died on `KeyError: t2' (t2 is not in this probe's fifteen-name
 1746: #  register map) and left the PROSE describing the register I had abandoned.  The glm seat read the two against each
 1747: #  other and caught it.  Worse than untidy: the note's own liveness checklist (a3/t0, at, t1) does not cover `ra', so
 1748: #  the audit AS WRITTEN could not discharge the collision it exists to catch. ***  `ra' IS free in this session --
 1749: #  P1 sets it, P6 does not, and the deriver that found it is recorded: the only R-map names absent from the P6 block
 1750: #  are `ra' and `v0', and `v0' is a FALSE POSITIVE because POST() writes it through a CALL the block's text never
 1751: #  shows.  The row does vary (base green; C_dog4w reds it), so the ROW is sound and it was the RECORD that was wrong.
 1752: 
 1753: 
 1754: npass = sum(1 for _, ok in rows if ok)
 1755: st_ = dict(rows)
 1756: control = all(st_.get(n, False) for n in ("live", "devsig", "devsig hi", "dflt ctl", "rev pc ctl", "sw08 halts",
 1757:                                           "gate hardint", "gate line",
 1758:                                           "sw08 msg ctl", "imask pre", "imask ctl", "istat pre", "istat ctl",
 1759:                                           "time lb ctl", "time sb ctl", "time lh ctl", "time sh ctl",
 1760:                                           "tl lb ctl", "tl sb ctl", "tl lh ctl", "tl sh ctl"))
 1761: print("")
 1762: print("FAILING: " + ", ".join(n for n, ok in rows if not ok))
 1763: print("CRIMEP_RESULT=%d/%d" % (npass, len(rows)))
 1764: print("CRIMEP_CONTROL=%s" % ("OK" if control else "FAIL"))
 1765: print("CRIMEP_DONE")

