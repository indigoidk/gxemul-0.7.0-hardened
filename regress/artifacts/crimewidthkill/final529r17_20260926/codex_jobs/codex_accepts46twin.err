  537: def session(cmds, settle=1.5, spin=1.2):
  538:     """one emulator, read to the pty's EOF after `quit'.  Returns (text, clean): clean = EOF reached AND exit 0."""
  539:     pid, fd = pty.fork()
  540:     if pid == 0:
  541:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64", "0x80001000:" + DUMMY])
  542:         os._exit(127)
  543:     buf = ""
  544: 
  545:     def rd(t):
  546:         nonlocal buf
  547:         end = time.time() + t
  548:         while time.time() < end:
  549:             r, _, _ = select.select([fd], [], [], 0.1)
  550:             if not r:
  551:                 continue
  552:             try:
  553:                 d = os.read(fd, 65536)
  554:             except OSError:
  555:                 return False
  556:             if not d:
  557:                 return False
  558:             buf += d.decode("latin-1", "replace")
  559:         return True
  560: 
  561:     rd(settle)
  562:     for i, c in enumerate(cmds):
  563:         try:
  564:             if c == "<RUN>":        # free-run: `continue', let the guest run, then break back in with CTRL-C
  565:                 os.write(fd, b"continue\n")
  566:                 ok = rd(2.0)
  567:                 os.write(fd, b"\x03")
  568:                 ok = ok and rd(1.5)
  569:             else:
  570:                 os.write(fd, (c + "\n").encode("latin-1"))
  571:                 ok = rd(spin if i == len(cmds) - 1 else 0.25)
  572:         except OSError:
  573:             break
  574:         if not ok:
  575:             break
  576:     eof = True                      # a process already gone before `quit' has closed the pty; its status says how
  577:     try:
  578:         os.write(fd, b"quit\n")
  579:         eof = not rd(10.0)          # to EOF, so anything printed on the way out is in the transcript
  580:     except OSError:
  581:         pass
  582:     if not eof:
  583:         try:
  584:             os.kill(pid, signal.SIGKILL)    # a session that never reached EOF is ended, never waited on forever
  585:         except OSError:
  586:             pass
  587:     try:
  588:         os.close(fd)
  589:     except OSError:
  590:         pass
  591:     how = "nostatus"
  592:     try:
  593:         _, stat = os.waitpid(pid, 0)
  594:         how = ("sig%d" % os.WTERMSIG(stat)) if os.WIFSIGNALED(stat) else ("exit%d" % os.WEXITSTATUS(stat))
  595:     except OSError:
  596:         pass
  597:     return buf.replace("\r", ""), (eof and how == "exit0")
  598: 
  599: 
  600: def pr(t, reg):
  601:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  602:     return ("0x%x" % int(m.group(1), 16)) if m else "absent"
  603: 
  604: 
  605: def exc(t):
  606:     c = pr(t, "cause")
  607:     return ("%d" % ((int(c, 16) >> 2) & 0x1f)) if c != "absent" else "absent"
  608: 
  609: 
  610: def count(t, s, clean):
  611:     """a text count is evidence only from a whole transcript: an unclean session reads `unclean', never a number"""
  612:     return t.count(s) if clean else "unclean"
  613: 
