1585: # ---- P4/P5: THE TIME 4-BYTE CELLS, POST, IN THE **GAPPED** SHAPE.  *** THE TWO OBVIOUS SHAPES
1586: #      WERE MEASURED VACUOUS (post7b.py) and one gave a FALSE RED on a control; only this one
1587: #      discriminates, at ~13,000x (base 0x13414f8 vs the bypass's 0x5ee). ***  The gap is the
1588: #      debugger's own pause BETWEEN steps: host time passes, so an update that is performed
1589: #      arrives before the final 8R and one that is skipped arrives after it.  CHANNEL: a read
1590: #      takes odata BEFORE its own crime_update_crime_time(). ----
1591: def gapped_post(kind):
1592:     ops = [enc("lb", "a3", "t1"),                                            # REFUSED lb -- sets the latch
1593:            enc("ld", "at", "v1"),                                            # TIME 8R, TIME still ~0
1594:            enc("sw", "at", "t0") if kind == "w" else enc("lw", "at", "a0"),  # the cell under test
1595:            enc("ld", "at", "v0")]                                            # what it left behind
1596:     c = ["at=0x%x" % (CRIME + 0x38), "a3=0x%x" % (CRIME + 0x07), "t0=0x0a0b0c0d",
1597:          "v0=0x%x" % SENT, "v1=0x%x" % SENT, "a0=0x%x" % SENT, "t1=0x%x" % SENT]
1598:     for i, op in enumerate(ops):
1599:         c.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, op))
1600:     c += ["put w 0x%x, 0x%08x" % (CODE + 4 * len(ops), OP_B_SELF),
1601:           "put w 0x%x, 0x%08x" % (CODE + 4 * len(ops) + 4, OP_NOP), "pc=0x%x" % CODE]
1602:     c += ["step 2", "step 1", "step 1", "print v0", "print v1"]
1603:     t, clean = session(c)
1604:     return nth(t, "v0", 0), nth(t, "v1", 0), (t.count("-- declined.") if clean else "unclean")
1605: 
1606: 
1607: _gapnote = []
1608: for kind in ("w", "r"):
1609:     v0, v1, n = gapped_post(kind)
1610:     _gapnote.append(n)
1611:     row("p t4%s gap" % kind, mag(v0), "large",
1612:         "step2[lb,ld] step1[%s] step1[ld] (raw %s, first ld %s)"
1613:         % ("sw" if kind == "w" else "lw", None if v0 is None else hex(v0), None if v1 is None else hex(v1)))
1614: row("p t gap once", _gapnote, [1, 1], "CONTROL: each gapped session announced its one refusal")
1615: 
1616: # ---- #529 REPAIR 14: THE SAME TWO TIME CELLS WITH THE LATCH **CLEAR** -- ACCEPTS entries 32 and 33. ----
1617: #  *** WHY THIS EXISTS: every row repair 13 added opens with POST(), a REFUSED lb that sets the latch before
1618: #  anything else in the session.  So the whole latch-CLEAR half of the product was driven by session 40
1619: #  (`latch x5') ALONE, whose only three rows are two announce COUNTS and a RAM round trip -- all blind to a
1620: #  silent decline.  BUCKETS8_rerun.out names the eight entries in that state; 32 and 33 are two of them, and
1621: #  `G_glm_tim4clear' (the latch-CLEAR bypass at TIME) scored 188/188 against the shipped probe. ***
1622: #  THE SHAPE IS NOT NEW AND THAT IS DELIBERATE: it is gapped_post() MINUS the opening refusal, built and
1623: #  MEASURED by the closing-pass-8 seat as artifacts/crimewidthkill/opus_close8_20260916/scripts/t4clear.py --
1624: #  3/5 against G_glm_tim4clear (both gap rows red) and 5/5 against three OFF-CELL mutants, so it
1625: #  discriminates rather than sweeping.  Transplanted rather than re-derived.
1626: #  CHANNEL: identical to the POST twin -- the gap is the debugger's own pause BETWEEN steps, so an update
1627: #  that is performed lands before the final 8-byte read and one that is skipped arrives after it.
1628: #  *** AND THE CONTROL ROW IS THE OPPOSITE OF ITS TWIN'S: `c t gap once' wants [0, 0], because a session
1629: #  that announces ANYTHING has set the latch and is no longer testing the CLEAR state at all. ***
1630: def gapped_clear(kind):
1631:     ops = [enc("ld", "at", "v1"),                                            # TIME 8R, TIME still ~0
1632:            enc("sw", "at", "t0") if kind == "w" else enc("lw", "at", "a0"),  # the cell under test
1633:            enc("ld", "at", "v0")]                                            # what it left behind
1634:     c = ["at=0x%x" % (CRIME + 0x38), "t0=0x0a0b0c0d",
1635:          "v0=0x%x" % SENT, "v1=0x%x" % SENT, "a0=0x%x" % SENT]
1636:     for i, op in enumerate(ops):
1637:         c.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, op))
1638:     c += ["put w 0x%x, 0x%08x" % (CODE + 4 * len(ops), OP_B_SELF),
1639:           "put w 0x%x, 0x%08x" % (CODE + 4 * len(ops) + 4, OP_NOP), "pc=0x%x" % CODE]
1640:     c += ["step 1", "step 1", "step 1", "print v0", "print v1", "print a0"]
1641:     t, clean = session(c)
1642:     return nth(t, "v0", 0), nth(t, "v1", 0), nth(t, "a0", 0), (t.count("-- declined.") if clean else "unclean")
1643: 
1644: 
1645: _clearnote = []
1646: for kind in ("w", "r"):
1647:     v0, v1, a0, n = gapped_clear(kind)
1648:     _clearnote.append(n)
1649:     row("c t4%s gap" % kind, mag(v0), "large",
1650:         "step1[ld] step1[%s] step1[ld] LATCH CLEAR (raw %s, first ld %s, cell %s)"
1651:         % ("sw" if kind == "w" else "lw", None if v0 is None else hex(v0),
1652:            None if v1 is None else hex(v1), None if a0 is None else hex(a0)))
1653: row("c t gap once", _clearnote, [0, 0],
1654:     "CONTROL: NEITHER session announced -- the latch stayed CLEAR, so these two rows really test that state")
1655: 
1656: # ---- #529 REPAIR 14, Fable item B: THE HARD_RESET GENERATING-SET CELLS. ----
1657: #  *** THE 2026-09-04 CLAUSE: at each floor cell, every idata bit the guarded body TESTS is written both
1658: #  CLEAR and SET.  The CONTROL arm tests DOG 0x200 and HARD_RESET 0x800 -- and EVERY accepted CONTROL write
1659: #  in this probe carried 0x800 CLEAR (0x01, 0x0001, 0x0201), so the (HARD_RESET set x post-latch) cell was
1660: #  driven by nothing.  K_ctl4w_reset_post and K_ctl8w_reset_post both score 188/188. ***
1661: #  *** FOUND BY WRITING THE PRE-TABLE CHECK FOR REPAIR 14'S OWN TABLE, not by measuring: listing the
1662: #  predicted red rows showed nothing written so far moves under either K mutant.  That is what the
1663: #  pre-table block is for -- a detector arriving with visible holes wastes the one ask-again. ***
1664: #  CHANNEL: THE HALT ITSELF.  An accepted 0x800 at CONTROL runs :364-373 and clears `running' on every CPU,
1665: #  so the write MUST BE THE SESSION'S LAST ACCESS -- Fable named that cost in advance -- and the oracle is a
1666: #  RAM round trip placed AFTER it.
1667: #  *** AND THE TWO OUTCOMES ARE NOT THE SAME, WHICH IS THE WHOLE POINT OF THIS ROUND: roundtrip()'s own
1668: #  docstring distinguishes them -- ABSENT if the HOST DIED, the SENTINEL if the CPU WAS STOPPED.  These rows
1669: #  want the SENTINEL.  A row wanting `absent' would assert that the host died, which is the defect #529
1670: #  REMOVED, and it would go green exactly when the fix was reverted. ***
1671: #  MEASURED BEFORE TRANSPLANTING (opus_close8_20260916/scripts/ctlreset.py): base 6/6; K_ctl4w_reset_post
1672: #  5/6 on its 4-byte row; K_ctl8w_reset_post 5/6 on its 8-byte row; G_glm_tim4clear 6/6 OFF-CELL.
1673: def rst_session(op):
1674:     """a refused lb sets the latch; then an accepted `op' of 0x800 at CONTROL stops every CPU (or does not).  #529
1675:     repair 16: an accepted `op' of 0x0001 runs FIRST, with the latch CLEAR -- one CONTROL text, the text channel's
1676:     in-session liveness half -- and the CONTROL-text count is returned: the 0x800 write's residue, latch SET."""
1677:     A = Addr(CODE)
1678:     c = []
1679:     if op is not None:
1680:         x, _ = st(A, op, CRIME + 0x08, 0x0001)
1681:         c += x
1682:     x, _ = ld(A, "lb", CRIME + 0x07, "v0")
1683:     c += x
1684:     if op is not None:
1685:         x, _ = st(A, op, CRIME + 0x08, 0x800)
1686:         c += x
1687:     c += roundtrip(A)
1688:     t, clean = session(c)
1689:     return (pr(t, "v1"), (t.count("-- declined.") if clean else "unclean"),
1690:             count(t, "CRIME_CONTROL: unimplemented", clean))
1691: 
1692: 
1693: _rv, _rn, _rm = rst_session(None)
1694: row("rst alive", _rv, "0x%x" % LIVE_VAL,
1695:     "CONTROL: with NO 0x800 write the RAM round trip completes -- the halt oracle is live, not stuck")
1696: row("rst alive once", _rn, 1, "CONTROL: the control session refused exactly once")
1697: for _op, _w in (("sw", 4), ("sd", 8)):
1698:     _rv, _rn, _rm = rst_session(_op)
1699:     row("rst %dw" % _w, _rv, "0x%x" % SENT,
1700:         "*** accepted %s 0x800 at CONTROL with the latch SET stops every CPU: the round trip after it does "
1701:         "not run, so v1 keeps the SENTINEL (absent would mean the HOST died -- a different outcome) ***"
1702:         % _op)
1703:     row("rst %dw once" % _w, _rn, 1, "CONTROL: exactly one refusal announced in this session")
1704:     row("rst %dw msg" % _w, _rm, 1,
1705:         "twin 0x0001 then, latch SET, 0x800: ONE CONTROL text (the count; the value is not read -- see the contract)")
1706: 
1707: # ---- P6: the remaining post-latch ACCEPT cells that carry a value, plus the two EXTRA accesses
1708: #      (DOG 4W high, the +0x04 write line). ----
1709: A = Addr(CODE)
1710: c = POST(A)
1711: x, _ = ld(A, "ld", CRIME + 0x00, "s0"); c += x                      # REV 8R from CODE
1712: x, _ = ld(A, "lw", CRIME + 0x04, "s1"); c += x                      # REV 4R low lane (devsig cell)
1713: x, _ = st(A, "sw", CRIME + 0x04, 0x0c0ffee0); c += x                # EXTRA: the +0x04 WRITE line
1714: x, _ = st(A, "sd", CRIME + 0x30, 0x1122334455667788); c += x        # DOG 8W
1715: x, _ = ld(A, "ld", CRIME + 0x30, "s2"); c += x                      # DOG 8R
1716: x, _ = ld(A, "lw", CRIME + 0x30, "a0"); c += x                      # DOG 4R high
1717: x, _ = ld(A, "lw", CRIME + 0x34, "a1"); c += x                      # DOG 4R low
1718: x, _ = st(A, "sw", CRIME + 0x34, 0x0badcafe); c += x                # DOG 4W low
1719: x, _ = ld(A, "ld", CRIME + 0x30, "s3"); c += x
1720: x, _ = st(A, "sw", CRIME + 0x30, 0x0feedbac); c += x                # EXTRA: DOG 4W HIGH
1721: x, _ = ld(A, "ld", CRIME + 0x30, "ra"); c += x
1722: x, _ = st(A, "sd", CRIME + 0x18, BIT); c += x                       # INTMASK 8W
1723: x, _ = ld(A, "ld", CRIME + 0x18, "a2"); c += x                      # INTMASK 8R
1724: x, _ = st(A, "sd", CRIME + 0x278, 0x0102030405060708); c += x       # far block 8W
1725: x, _ = ld(A, "ld", CRIME + 0x278, "t1"); c += x
1726: t, clean = session(c + ["print s0", "print s1", "print s2", "print a0", "print a1", "print s3",
1727:                         "print ra", "print a2", "print t1"] + roundtrip(A))
1728: row("p rev ld", pr(t, "s0"), "0x11", "POST: accepted ld +0x00 answers CRIME_REV")
1729: row("p rev lw4", pr(t, "s1"), "0x11", "POST: accepted lw +0x04 answers REV low lane")
1730: row("p dog st+ld", pr(t, "s2"), "0x1122334455667788", "POST: 8W then 8R at CRIME_DOG")
1731: row("p dog rhi", pr(t, "a0"), "0x11223344", "POST: 4R of the high half (+0x30)")
1732: row("p dog rlo", pr(t, "a1"), "0x55667788", "POST: 4R of the low half (+0x34)")
1733: row("p dog wlo", pr(t, "s3"), "0x112233440badcafe", "POST: 4W low half lands, high half kept")
1734: row("p dog whi", pr(t, "ra"), "0xfeedbac0badcafe", "POST: 4W HIGH half lands, low half kept")
1735: row("p imask st+ld", pr(t, "a2"), "0x%x" % BIT, "POST: 8W then 8R at CRIME_INTMASK")
1736: row("p top st+ld", pr(t, "t1"), "0x102030405060708", "POST: 8W then 8R at +0x278")
1737: row("p resid once", count(t, "-- declined.", clean), 1, "CONTROL: exactly one refusal (the lb)")
1738: row("p resid surv", pr(t, "v1"), "0x%x" % LIVE_VAL, "CONTROL: the host survives (a RAM trip)")
1739: 
1740: #  *** REGISTER COLLISION, CAUGHT WHILE DRAFTING AND RECORDED RATHER THAN SILENTLY FIXED: the
1741: #  prototype's residual-survival row reads `v1', which roundtrip() writes.  The DOG 4W-high
1742: #  readback added here therefore CANNOT use v1 -- it would make one of the two rows read the
1743: #  other's register and go green for the wrong reason, which is exactly the vacuity this repair
1744: #  exists to close.  It is parked in `ra' above.  *** THIS NOTE SAID `t2' UNTIL 2026-09-16 20:0x, AND THE CODE SAID
1745: #  `ra' -- I repointed the CODE when the first run died on `KeyError: t2' (t2 is not in this probe's fifteen-name
1746: #  register map) and left the PROSE describing the register I had abandoned.  The glm seat read the two against each
1747: #  other and caught it.  Worse than untidy: the note's own liveness checklist (a3/t0, at, t1) does not cover `ra', so
1748: #  the audit AS WRITTEN could not discharge the collision it exists to catch. ***  `ra' IS free in this session --
1749: #  P1 sets it, P6 does not, and the deriver that found it is recorded: the only R-map names absent from the P6 block
1750: #  are `ra' and `v0', and `v0' is a FALSE POSITIVE because POST() writes it through a CALL the block's text never
1751: #  shows.  The row does vary (base green; C_dog4w reds it), so the ROW is sound and it was the RECORD that was wrong.
1752: 
1753: 
1754: npass = sum(1 for _, ok in rows if ok)
1755: st_ = dict(rows)
1756: control = all(st_.get(n, False) for n in ("live", "devsig", "devsig hi", "dflt ctl", "rev pc ctl", "sw08 halts",
1757:                                           "gate hardint", "gate line",
1758:                                           "sw08 msg ctl", "imask pre", "imask ctl", "istat pre", "istat ctl",
1759:                                           "time lb ctl", "time sb ctl", "time lh ctl", "time sh ctl",
1760:                                           "tl lb ctl", "tl sb ctl", "tl lh ctl", "tl sh ctl"))
1761: print("")
1762: print("FAILING: " + ", ".join(n for n, ok in rows if not ok))
1763: print("CRIMEP_RESULT=%d/%d" % (npass, len(rows)))
1764: print("CRIMEP_CONTROL=%s" % ("OK" if control else "FAIL"))
1765: print("CRIMEP_DONE")

