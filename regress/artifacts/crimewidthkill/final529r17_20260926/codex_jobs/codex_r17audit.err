import ast,re
from pathlib import Path
p=Path('regress/artifacts/crimewidthkill/final529r17_20260926/crime_width_probe.r17.py'); t=ast.parse(p.read_text(encoding='utf-8'))
rows=[]
def hasrow(n):
 return any(isinstance(x,ast.Call) and isinstance(x.func,ast.Name) and x.func.id=='row' for x in ast.walk(n))
def value(n,e):
 return eval(compile(ast.Expression(n),'row-name-only','eval'),{'__builtins__':{},'enumerate':enumerate},e)
def bind(n,v,e):
 if isinstance(n,ast.Name):e[n.id]=v
 else:
  for a,b in zip(n.elts,v):bind(a,b,e)
def scan(seq,e):
 for n in seq:
  if isinstance(n,(ast.FunctionDef,ast.ClassDef,ast.AsyncFunctionDef)):continue
  if isinstance(n,ast.For) and hasrow(n):
   for v in value(n.iter,e):
    ee=dict(e);bind(n.target,v,ee);scan(n.body,ee)
  elif isinstance(n,ast.If) and hasrow(n):scan(n.body if value(n.test,e) else n.orelse,e)
  elif isinstance(n,ast.Expr) and isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id=='row':
   rows.append((n.lineno,value(n.value.args[0],e),not isinstance(n.value.args[0],ast.Constant)))
scan(t.body,{})
raw=Path('regress/artifacts/crimewidthkill/table16_20260926/logs/probe_base.raw').read_text(encoding='utf-8').splitlines()
logged=[re.split(r'\\s{2,}',line.strip())[0] for line in raw if re.search(r'\\s(?:ok|FAIL)"'$'"',line)]
print('EXPANDED_ROWS',len(rows),'UNIQUE',len(set(n for _,n,_ in rows)),'SAME_NAMES_AND_ORDER_AS_TABLE16_BASE',logged==[n for _,n,_ in rows])
byline={}
for line,name,dyn in rows:
 if dyn:byline.setdefault(line,[]).append(name)
for line,names in byline.items():print(f'{line}: '+', '.join(names))
