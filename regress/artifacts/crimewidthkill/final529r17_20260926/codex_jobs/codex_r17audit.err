1: #!/usr/bin/env python3
2: """session_map2.py -- #529 closing pass 7 (Opus, finishing seat).  As session_map.py, plus the ROW NAMES each
3: session feeds, so `which rows can observe a post-latch accepted access' is DERIVED from the shipped probe rather
4: than asserted.  Does not run the emulator.  Sentinel: SESSIONMAP_DONE."""
5: import io, re, sys, contextlib
6: 
7: SRC = sys.argv[1] if len(sys.argv) > 1 else "/mnt/c/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/regress/crime_width_probe.py"
8: src = open(SRC).read()
9: src = src.replace("t, clean = session(", "t, clean = _rec(")
10: assert "t, clean = session(" not in src
11: src = re.sub(r"(?m)^(\s*)row\(", lambda m: m.group(1) + "_row(", src)
12: assert re.search(r"(?m)^\s*row\(", src) is None
13: 
14: OPC = {0x20: ("lb", 1, "R"), 0x21: ("lh", 2, "R"), 0x23: ("lw", 4, "R"), 0x24: ("lbu", 1, "R"),
15:        0x25: ("lhu", 2, "R"), 0x37: ("ld", 8, "R"), 0x28: ("sb", 1, "W"), 0x29: ("sh", 2, "W"),
16:        0x2b: ("sw", 4, "W"), 0x3f: ("sd", 8, "W")}
17: CRIME = 0xb4000000
18: SESSIONS = []
19: PEND = []
20: 
21: 
22: def _row(name, got, want, note=""):
23:     PEND.append(name)
24: 
25: 
26: def _rec(cmds, settle=1.5, spin=1.2):
27:     regs, acc, pc = {}, [], None
28:     for c in cmds:
29:         m = re.match(r"^([a-z0-9]+)=0x([0-9a-f]+)$", c)
30:         if m:
31:             if m.group(1) == "pc":
32:                 pc = int(m.group(2), 16)
33:             else:
34:                 regs[m.group(1)] = int(m.group(2), 16)
35:             continue
36:         m = re.match(r"^put w 0x([0-9a-f]+), 0x([0-9a-f]{8})$", c)
37:         if m:
38:             w = int(m.group(2), 16)
39:             op, rs = w >> 26, (w >> 21) & 0x1f
40:             if op in OPC and rs in (1, 7):
41:                 base = regs.get("at" if rs == 1 else "a3")
42:                 if base is not None:
43:                     acc.append((OPC[op], base, int(m.group(1), 16)))
44:     SESSIONS.append([acc, list(PEND)])          # rows of the PREVIOUS session, flushed here
45:     del PEND[:]
46:     return "", True
47: 
48: 
49: sys.argv = ["crime_width_probe.py", "/nonexistent-binary", "map"]
50: buf = io.StringIO()
51: try:
52:     with contextlib.redirect_stdout(buf):
53:         exec(compile(src, SRC, "exec"), {"__name__": "__main__", "_rec": _rec, "_row": _row})
54: except SystemExit:
55:     pass
56: SESSIONS.append([[], list(PEND)])               # the last session's rows
57: 
58: print("SESSIONS=%d" % (len(SESSIONS) - 1))
59: tot = 0
60: for i in range(len(SESSIONS) - 1):
61:     acc = SESSIONS[i][0]
62:     myrows = SESSIONS[i + 1][1]
63:     ref = None
64:     for j, ((op, ln, d), base, where) in enumerate(acc):
65:         if ln in (1, 2):
66:             ref = j
67:             break
68:     post = []
69:     if ref is not None:
70:         for (op, ln, d), base, where in acc[ref + 1:]:
71:             if ln in (4, 8) and (base & ~0xfff) == CRIME:
72:                 post.append("%s%s+0x%x" % (op, "P" if (where & 0xffffff00) == 0xbfc05100 else "", base - CRIME))
73:     tot += len(post)
74:     if post:
75:         print("#%-3d acc=%-3d firstRefusal=%-4s POST=%d  %s" % (i, len(acc), ref, len(post), " ".join(post)))
76:         print("      rows: %s" % ", ".join(myrows))
77: print("TOTAL post-latch accepted CRIME accesses: %d" % tot)
78: print("SESSIONMAP_DONE")
