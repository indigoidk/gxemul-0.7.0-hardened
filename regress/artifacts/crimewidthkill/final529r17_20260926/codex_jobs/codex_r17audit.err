1: #!/usr/bin/env python3
2: """
3: crime_width_witness_20260913.py -- RUNG-3 WITNESS for `crimewidthkill' on UNMODIFIED `-E sgi -e ip32'.
4: 
5: src/devices/dev_sgi_ip32.c, DEVICE_ACCESS(crime): an access whose length is neither 8 nor 4 falls to
6: 
7:         } else {
8:                 fatal("crime access len = %i!\n", len);
9:                 exit(1);
10:         }
11: 
12: so one guest byte or halfword load or store to the IP32 CRIME (physical 0x14000000, KSEG1 0xb4000000) ends the
13: emulator.  This witness drives a real MIPS guest instruction through real address decode and memory_rw on the
14: unmodified machine, and asks only what EVERY candidate fix must change: does the HOST PROCESS SURVIVE the access?
15: It does not assert what the guest sees (a value, a declined 0, a bus error) -- that is the fix design's question.
16: 
17: Each width row runs the access in its OWN session, then a RAM round trip through the same apparatus: if the host
18: died at the access the round trip never prints; if it survived (whatever the guest saw -- a bus error vectors the
19: PC away, but the round trip sets its own PC) it prints the stored value.  `<op> says' counts whether the kill's own
20: text appeared -- the attribution control that the death, if any, is THIS kill.
21: 
22: CONTROLS: `live' (a RAM round trip), `devsig' (a 4-byte read of CRIME_REV's low half at 0xb4000004 returns the
23: model's revision 0x11 -- RAM would not), `devsig hi' (its high half at 0xb4000000 reads 0).  Committed build:
24: controls green, every `<op> surv' row RED with `<op> says' present.  A fixed build: every row green.
25: 
26: Sentinel: CRIMEW_DONE (plus CRIMEW_RESULT=n/N and CRIMEW_CONTROL=OK|FAIL).
27: """
28: import os, pty, re, select, sys, time
29: 
30: BIN = sys.argv[1]
31: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
32: DUMMY = "/tmp/dummy_crimew.bin"
33: if not os.path.exists(DUMMY):
34:     with open(DUMMY, "wb") as f:
35:         f.write(b"\0" * 16)
36: 
37: CODE = 0x80001000
38: SCRATCH_RAM = 0xa0001800
39: LIVE_VAL = 0x12345678
40: CRIME = 0xb4000000
41: SENTINEL = 0xdeadbeef
42: 
43: OP_NOP = 0x00000000
44: OP_B_SELF = 0x1000ffff
45: OP_SW_T0_A3 = 0xace80000          # sw   $t0, 0($a3)
46: OP_SH_T0_A3 = 0xa4e80000          # sh   $t0, 0($a3)
47: OP_SB_T0_A3 = 0xa0e80000          # sb   $t0, 0($a3)
48: OP_LW_V0_AT = 0x8c220000          # lw   $v0, 0($at)
49: OP_LH_V0_AT = 0x84220000          # lh   $v0, 0($at)
50: OP_LHU_V0_AT = 0x94220000         # lhu  $v0, 0($at)
51: OP_LB_V0_AT = 0x80220000          # lb   $v0, 0($at)
52: OP_LBU_V0_AT = 0x90220000         # lbu  $v0, 0($at)
53: 
54: rows = []
55: 
56: 
57: def row(name, got, want, note=""):
58:     ok = (got == want)
59:     rows.append((name, ok))
60:     print("%-16s %-12s %-12s %-46s %s" % (name, str(got), str(want), note, "ok" if ok else "FAIL"))
61:     sys.stdout.flush()
62: 
63: 
64: def session(cmds, settle=1.5, spin=1.2):
65:     pid, fd = pty.fork()
66:     if pid == 0:
67:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64", "0x80001000:" + DUMMY])
68:         os._exit(127)
69:     buf = ""
70: 
71:     def rd(t):
72:         nonlocal buf
73:         end = time.time() + t
74:         while time.time() < end:
75:             r, _, _ = select.select([fd], [], [], 0.1)
76:             if not r:
77:                 continue
78:             try:
79:                 d = os.read(fd, 65536)
80:                 if not d:
81:                     return False
82:                 buf += d.decode("latin-1", "replace")
83:             except OSError:
84:                 return False
85:         return True
86: 
87:     rd(settle)
88:     for i, c in enumerate(cmds):
89:         try:
90:             os.write(fd, (c + "\n").encode("latin-1"))
91:         except OSError:
92:             break
93:         if not rd(spin if i == len(cmds) - 1 else 0.25):
94:             break
95:     try:
96:         os.write(fd, b"quit\n")
97:         rd(2.0)
98:     except OSError:
99:         pass
100:     try:
101:         os.close(fd)
102:     except OSError:
103:         pass
104:     how = "nostatus"
105:     try:
106:         _, stat = os.waitpid(pid, 0)
107:         how = ("sig%d" % os.WTERMSIG(stat)) if os.WIFSIGNALED(stat) else ("exit%d" % os.WEXITSTATUS(stat))
108:     except OSError:
109:         pass
110:     return buf.replace("\r", ""), how
111: 
112: 
113: def printed(t, reg):
114:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
115:     return ("0x%x" % int(m.group(1), 16)) if m else "absent"
116: 
117: 
118: class Addr(object):
119:     def __init__(self, base):
120:         self.a = base
121: 
122:     def take(self, n):
123:         got = self.a
124:         self.a += 4 * (n + 2) + 0x20
125:         return got
126: 
127: 
128: def run_ops(ops, at):
129:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
130:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
131:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
132:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
133: 
134: 
135: def store(A, addr, op=OP_SW_T0_A3, val=LIVE_VAL):
136:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([op], A.take(1))
137: 
138: 
139: def load(A, addr, op=OP_LW_V0_AT):
140:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
141: 
142: 
143: def roundtrip(A):
144:     """a RAM round trip, printed in v1 so it cannot be confused with the access's own destination"""
145:     return (store(A, SCRATCH_RAM) + ["at=0x%x" % SCRATCH_RAM, "v1=0x%x" % SENTINEL]
146:             + run_ops([0x8c230000], A.take(1)) + ["print v1"])          # lw $v1, 0($at)
147: 
148: 
149: print("CRIME WIDTH WITNESS -- rung 3, unmodified -E sgi -e ip32   binary=%s  label=%s" % (BIN, LABEL))
150: print("%-16s %-12s %-12s %-46s %s" % ("row", "got", "want", "note", ""))
151: 
152: A = Addr(CODE)
153: t, how = session(roundtrip(A))
154: row("live", printed(t, "v1"), "0x%x" % LIVE_VAL, "LIVENESS: RAM round trip, same apparatus")
155: A = Addr(CODE)
156: t, how = session(load(A, CRIME + 4) + ["print v0"])
157: row("devsig", printed(t, "v0"), "0x11", "CRIME_REV low half (no framebuffer): a device")
158: A = Addr(CODE)
159: t, how = session(load(A, CRIME) + ["print v0"])
160: row("devsig hi", printed(t, "v0"), "0x0", "CRIME_REV high half reads 0")
161: 
162: WIDTH = (("lb", load, OP_LB_V0_AT, CRIME + 7), ("lbu", load, OP_LBU_V0_AT, CRIME + 7),
163:          ("lh", load, OP_LH_V0_AT, CRIME + 6), ("lhu", load, OP_LHU_V0_AT, CRIME + 6),
164:          ("sb", store, OP_SB_T0_A3, CRIME + 0x1f), ("sh", store, OP_SH_T0_A3, CRIME + 0x1e))
165: for name, fn, op, addr in WIDTH:
166:     A = Addr(CODE)
167:     t, how = session(fn(A, addr, op) + roundtrip(A))
168:     row("%s surv" % name, printed(t, "v1"), "0x%x" % LIVE_VAL, "host survives a %s to CRIME, then a RAM trip" % name)
169:     row("%s says" % name, "yes" if "crime access len" in t else "no", "no",
170:         "the kill's own text absent (%s)" % how)
171: 
172: npass = sum(1 for _, ok in rows if ok)
173: st = dict(rows)
174: control = all(st.get(n, False) for n in ("live", "devsig", "devsig hi"))
175: print("")
176: print("FAILING: " + ", ".join(n for n, ok in rows if not ok))
177: print("CRIMEW_RESULT=%d/%d" % (npass, len(rows)))
178: print("CRIMEW_CONTROL=%s" % ("OK" if control else "FAIL"))
179: print("CRIMEW_DONE")
