from pathlib import Path
import re
b=Path('regress/artifacts/crimewidthkill')
ds=['killtable_20260913']+[f'killtable{i}_'+('20260913' if i<=7 else '20260914' if i<=9 else '20260915' if i==10 else '20260916') for i in range(2,12)]+['repair14_20260916','ctl0c_discharge_20260917','table13a_20260925','table14_20260926','table15a_20260926','table16_20260926']
for d in ds:
 p=b/d
 print('\\nDIRECTORY',d)
 for patt in ['PRETABLE*.out','POSTTABLE*.out','check*.out']:
  files=list(p.glob(patt))
  if not files: print('  MISSING',patt)
  for f in files:
   lines=f.read_text(encoding='utf-8',errors='replace').splitlines()
   print(f.name, len(lines),'lines')
   if patt.startswith('check'):
    print('\\n'.join(f'{i}: {s}' for i,s in enumerate(lines,1) if re.search(r'MISMATCH|MISS|PASS|FAIL|TOTAL|exact|escape|surviv|mismatch',s,re.I)))
 logs=list((p/'logs').glob('probe_*.raw'))
 scores={}; problems=[]
 for f in logs:
  lines=f.read_text(encoding='utf-8',errors='replace').splitlines()
  rs=[(i,s) for i,s in enumerate(lines,1) if s.startswith('CRIMEP_RESULT=')]
  if len(rs)"'!=1: problems.append((f.name,'"'RESULT_count',len(rs))); continue
  i,s=rs[0]; n,N=map(int,s.split('=')[1].split('/'))
  score=f'{n}/{N}'; scores.setdefault(N,[]).append((f.stem.removeprefix('probe_'),score,i))
  if not any(s=='CRIMEP_DONE' for s in lines): problems.append((f.name,'NO_DONE'))
  rows=[s for s in lines if re.search(r' (ok|FAIL)"'$'"',s)]
  failures=[s for s in rows if s.endswith(' FAIL')]
  if len(rows)"'!=N or len(failures)!=N-n: problems.append((f.name,'"'COUNT_MISMATCH',len(rows),len(failures),score))
 print('RAW_LOGS',len(logs),'DENOMINATORS',{N:len(v) for N,v in scores.items()},'PROBLEMS',problems)
 print('BASE/SURVIVORS',[(leg,sc,ln) for N,vs in scores.items() for leg,sc,ln in vs if sc==f'{N}/{N}' or leg in ['base','HEAD']])
