631: 
632: def ld(A, op, addr, rt, at=None):
633:     """one load `op rt, 0(at)', rt seeded with SENT; returns (cmds, code address)"""
634:     here = A.take(1) if at is None else at
635:     return ["at=0x%x" % addr, "%s=0x%x" % (rt, SENT)] + run_ops([enc(op, "at", rt)], here), here
636: 
637: 
638: def st(A, op, addr, val, at=None):
639:     here = A.take(1) if at is None else at
640:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([enc(op, "a3", "t0")], here), here
