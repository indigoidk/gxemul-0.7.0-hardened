653: def said(t, ln, off, clean):
654:     """the whole announce, `(once)' marker included -- a reworded or unmarked announce reads 0"""
655:     return count(t, "unimplemented len=%d at 0x%x -- declined.  (once) ]" % (ln, off), clean)
656: 
657: 
658: def dflt(t, clean, off, write):
659:     """the register switch's default-arm debug() line FOR THIS REFUSED ACCESS -- `[ crime: read from 0xOFF,' or
660:     `[ crime: write to 0xOFF:' -- printed while stepping, so a refused access that falls into the switch at an
661:     unlabelled offset says so here.  Keyed on the access's own offset and direction, because an ACCEPTED access at a
662:     default-arm offset in the same session prints the same kind of line (hi keeps' ld +0x278 does)."""
663:     if not clean:
664:         return "unclean"
665:     return t.count(("[ crime: write to 0x%x:" if write else "[ crime: read from 0x%x,") % off)
