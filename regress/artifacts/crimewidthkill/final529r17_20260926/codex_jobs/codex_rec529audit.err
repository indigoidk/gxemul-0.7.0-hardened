16: 
17: 
18: def rep(s, old, new, what):
19:     n = s.count(old)
20:     if n != 1:
21:         sys.exit("%s: TEXT NOT UNIQUE (%d): %r" % (what, n, old[:80]))
22:     return s.replace(old, new)
