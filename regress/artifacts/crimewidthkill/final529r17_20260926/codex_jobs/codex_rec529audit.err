  16: REC = os.path.join(SPD, "records")
  17: R17 = os.path.join(SPD, "p529", "r17")
  18: ST = os.path.join(REC, "stage529")
  19: FIN = os.path.join(SEC, "regress", "artifacts", "crimewidthkill", "final529r17_20260926")
  20: PINNED = {  # repo path -> (source, md5); FILL the two md5s when the text is final
  21:     "regress/crime_width_probe.py": (os.path.join(FIN, "crime_width_probe.r17.py"), "<R17_MD5>"),
  22:     "regress/gate_arm.sh": (os.path.join(R17, "gate_arm_529.sh"), "<GATE_MD5>"),
  23: }
  24: WORKING = {  # repo path -> md5 of the working file this commit takes whole
  25:     "src/devices/dev_sgi_ip32.c": "8c1d1545",
  26:     "tools/pipeline/check_score_claims.py": "8687fcea",
  27:     "regress/artifacts/lcaisalane/FABLE_C3_RULING_20260914.md": "f1995aaf",
  28:     "regress/artifacts/lcaisalane/FABLE_C5_RULING_20260915.md": "f115dafb",
  29: }
  30: RUNG3 = ("artifacts/wdcnullxfer/rung3_20260913/wdcnullxfer_rung3_probe.py",
  31:          "artifacts/wdcnullxfer/rung3_20260913/mkvariants_wdc.py",
  32:          "artifacts/wdcrearmzero/rung3_20260913/wdcrearmzero_rung3_probe.py",
