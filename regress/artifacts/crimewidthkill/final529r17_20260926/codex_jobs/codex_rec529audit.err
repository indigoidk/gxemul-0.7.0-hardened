#!/usr/bin/env python3
"""agent_models.py -- WHICH MODEL ACTUALLY WROTE EACH AGENT-TOOL SEAT ANSWER.

Measured 2026-09-19: the Agent tool silently FALLS BACK from the requested model (fable -> claude-fable-5-1,
opus -> claude-opus-5) to claude-opus-4-8 partway through a run, and the fallback model reads the same system prompt,
so a seat's self-reported "exact model id" line names the REQUESTED model whatever wrote the answer.  The identity line
is therefore a check that cannot fail.  The per-message `model' field in the subagent transcript is the only witness.

Usage: agent_models.py [session-id]      (default: the newest session dir under the project)
Prints, per agent: requested model, the runs of models that answered, and every Write/Edit with the model that issued
it.  Keyed on a model CHANGE inside one agent, not on a fixed id (peer review 2026-09-19: August's claude-fable-5
answers are the pre-5.1 Fable, not fallbacks, and a != fable-5-1 test scored 157 agents compromised):
  FALLBACK   a later assistant turn came from a different model than the agent's FIRST turn (e.g. fable-5-1 -> opus-4-8)
  MISROUTED  the first turn is not in the requested family (a "fable" agent whose first turn is an Opus model)
  FAILED     the final turn is a <synthetic> API error: a seat failure, not a silent degrade
  clean      one model throughout, in the requested family
THE CAUSE, MEASURED the same day on all five switches: the requested model ended a turn with stop_reason "refusal"
(its output was cut off -- a refusal, not a quota wall), a `thinking_drop' attachment followed naming
claude-opus-4-8, and the harness RE-RAN that turn and the rest of the run on claude-opus-4-8.  So a REFUSAL line is
printed per agent, with the timestamp, and a refused-then-finished answer is not the requested model's answer."""
import glob, io, json, os, sys

PROJ = r"C:\Users\User00\.claude\projects\C--DocumentNoSnc-CC-GXEMUL"
FAMILY = {"fable": "fable", "opus": "opus"}

sess = sys.argv[1] if len(sys.argv) > 1 else None
if sess:
    sub = os.path.join(PROJ, sess, "subagents")
else:
    dirs = [d for d in glob.glob(os.path.join(PROJ, "*", "subagents"))]
    sub = max(dirs, key=os.path.getmtime)
bad = 0
for jl in sorted(glob.glob(os.path.join(sub, "*.jsonl")), key=os.path.getmtime):
    aid = os.path.basename(jl)[:-6]
    try:
        meta = json.load(io.open(jl[:-6] + ".meta.json", encoding="utf-8"))
    except Exception:
        meta = {}
    req = meta.get("model", "?")
    runs, writes, final, refusals = [], [], None, []
    for ln in io.open(jl, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(ln)
        except Exception:
            continue
        msg = o.get("message")
        att = o.get("attachment")
        if isinstance(att, dict) and att.get("type") == "thinking_drop":
            refusals.append("%s thinking_drop -> %s" % (o.get("timestamp", "")[11:19], att.get("model")))
        if not isinstance(msg, dict) or msg.get("role") != "assistant":
            continue
        m = msg.get("model", "?")
        ts = o.get("timestamp", "")[11:19]
        if msg.get("stop_reason") == "refusal":
            refusals.append("%s REFUSAL by %s" % (ts, m))
        if runs and runs[-1][0] == m:
            runs[-1][2] += 1
        else:
            runs.append([m, ts, 1])
        for c in msg.get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") in ("Write", "Edit"):
                writes.append((ts, m, c["input"].get("file_path", "?")))
            if isinstance(c, dict) and c.get("type") == "text" and c.get("text", "").strip():
                final = (ts, m)
    real = [r for r in runs if r[0] != "<synthetic>"]
    want = real[0][0] if real else None                        # the agent's PRIMARY model: its first real turn
    fam = FAMILY.get(req)
    if not real:
        flag = "FAILED"
    elif fam and fam not in want:
        flag = "MISROUTED"
    elif any(r[0] != want for r in real):
        flag = "FALLBACK"
    elif runs and runs[-1][0] == "<synthetic>":
        flag = "FAILED"
    else:
        flag = "clean"
    bad += flag in ("FALLBACK", "MISROUTED")
    print("%s  %-6s %-9s %s" % (aid, req, flag, meta.get("description", "")))
    print("    runs: " + " | ".join("%s x%d @%s" % (r[0].replace("claude-", ""), r[2], r[1]) for r in runs))
    for e in refusals:
        print("    " + e)
    for ts, m, f in writes:
        mark = "" if (not want or m == want) else "   <-- NOT " + want
        print("    %s %-16s %s%s" % (ts, m, f, mark))
    if final:
        print("    final text @%s by %s%s" % (final[0], final[1], "" if (not want or final[1] == want) else "   <-- NOT " + want))
print("AGENT_MODELS: %d agent(s) FALLBACK or MISROUTED (FAILED is a seat failure and is counted separately)" % bad)
