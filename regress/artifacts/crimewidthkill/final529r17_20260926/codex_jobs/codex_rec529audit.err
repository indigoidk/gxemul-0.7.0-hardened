 138:     put("CHANGELOG.md", (blk.rstrip("\n") + "\n\n" + git("show", "HEAD:CHANGELOG.md")).encode("utf-8"))
 139:     ob = git("show", "HEAD:OUTSTANDING_BUGS.md")
 140:     ob = rep(ob, "### `crimewidthkill` (HIGH) -- filed 2026-09-10\n",
