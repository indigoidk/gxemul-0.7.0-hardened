 204:         subprocess.run(["date", "+%F %T"], capture_output=True, text=True).stdout.strip(), head, "  (DRY)" if dry else ""))
 205:     io.open(os.path.join(ST, "MANIFEST.txt"), "w", encoding="utf-8", newline="\n").write("\n".join(man) + "\n")
 206:     print("\n".join(man))
