 109: def panel(p, date, label, verdicts, kimi_note):
 110:     """one entry per scriptable transport, from the durable panel copy."""
 111:     E = []
 112:     E.append(ent("review", "codex", date, "WALLED (seat failure)", p + "codex.txt",
 113:                  "%s (%s).  codex (FILE-READING, GPT-6 Astra max, %d bytes): the CLI's usage-limit notice (reset 2026-09-26 "
 114:                  "07:01) -- a SEAT FAILURE, not agreement; %s.  Dispositions: %s."
 115:                  % (label, p.rstrip("/").split("/")[-1], size(p + "codex.txt"), verdicts["codex"], DISP)))
 116:     desc = {"agy": "agy (FILE-READING, gemini-3.8-flash-high)", "grok": "grok (FILE-READING, grok-4.7 xhigh, plan mode)",
 117:             "glm": "glm (PACKET-FED, glm-5.3:cloud)", "deepseek": "deepseek (PACKET-FED, deepseek-v4-pro:cloud)",
 118:             "minimax": "minimax (PACKET-FED, minimax-m3:cloud)"}
 119:     files = {"agy": "agy.txt", "grok": "grok.txt", "glm": "ollama_glm.txt", "deepseek": "ollama_deepseek.txt",
 120:              "minimax": "ollama_minimax.txt"}
 121:     for seat in ("agy", "grok", "glm", "deepseek", "minimax"):
 122:         v = verdicts[seat]
 123:         E.append(ent("review", seat, date, v[:60], p + files[seat],
 124:                      "%s.  %s, %d bytes.  Its verdict, verbatim: %s  Dispositions: %s."
 125:                      % (label, desc[seat], size(p + files[seat]), v, DISP)))
 126:     E.append(ent("review", "kimi", date, verdicts["kimi"][:60], p + "ollama_kimi.txt",
 127:                  "%s.  kimi (PACKET-FED, kimi-k3:cloud, %d bytes) -- %s.  Its verdict, verbatim: %s  Dispositions: %s."
 128:                  % (label, size(p + "ollama_kimi.txt"), kimi_note, verdicts["kimi"], DISP)))
 129:     return E
