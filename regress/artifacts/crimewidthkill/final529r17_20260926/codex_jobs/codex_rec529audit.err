 108:     cpw = put("tools/pipeline/check_probe_wiring.py", "\n".join(out).encode("utf-8"))
 109:     r = subprocess.run([sys.executable, os.path.join(R17, "manifest529.py"), cpw, "--write"], capture_output=True, text=True)
 110:     if r.returncode:
