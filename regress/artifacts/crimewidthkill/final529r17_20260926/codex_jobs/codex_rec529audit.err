  35: 
  36: 
  37: def git(*a, binary=False):
  38:     r = subprocess.run(["git", "-C", SEC] + list(a), capture_output=True)
  39:     if r.returncode:
  40:         sys.exit("REFUSED: git %s: %s" % (" ".join(a), r.stderr.decode("utf-8", "replace")))
  41:     return r.stdout if binary else r.stdout.decode("utf-8")
  42: 
  43: 
  44: def md5(b):
  45:     return hashlib.md5(b).hexdigest()[:8]
  46: 
  47: 
  48: def put(rel, data):
  49:     p = os.path.join(ST, *rel.split("/"))
  50:     os.makedirs(os.path.dirname(p), exist_ok=True)
  51:     open(p, "wb").write(data)
  52:     return p
  53: 
  54: 
  55: def rep(s, old, new, what):
  56:     if s.count(old) != 1:
  57:         sys.exit("REFUSED: %s: text found %d times" % (what, s.count(old)))
  58:     return s.replace(old, new)
  59: 
  60: 
  61: def main():
  62:     dry = sys.argv[1:] == ["--dry"]
  63:     if not dry and len(sys.argv) != 5:
  64:         sys.exit(__doc__)
  65:     head = git("rev-parse", "--short=8", "HEAD").strip()
  66:     subj = git("log", "-1", "--format=%s", "HEAD").strip()
  67:     if not re.match(r"^#(549|553) ", subj) and not dry:
