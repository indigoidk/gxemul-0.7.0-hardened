 198:             dd = list(difflib.unified_diff(old.decode("utf-8", "replace").splitlines(),
 199:                                            new.decode("utf-8", "replace").splitlines(), lineterm="", n=0))
 200:             plus = sum(1 for l in dd if l.startswith("+") and not l.startswith("+++"))
 201:             minus = sum(1 for l in dd if l.startswith("-") and not l.startswith("---"))
