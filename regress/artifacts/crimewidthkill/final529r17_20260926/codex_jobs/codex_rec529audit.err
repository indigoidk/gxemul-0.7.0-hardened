FILE ledger_529.py
   1: #!/usr/bin/env python3
   2: """Ledger records for #529 (crimewidthkill: the row CLOSES) and its three filings.
   3: 
   4: Modes (LEDGER_PATH names the file; default the working tree's):
   5:   records               the provenance corrections the flagship's 09-25 re-ruling ordered (entries crediting three
   6:                         opus-4-8 fallback files to fable5 -> [NOT A SEAT ANSWER]); the re-ruling and GPT-6 Astra's
   7:                         confirmation of it; tables 13a/14/15a/16 (main-loop measurement records); every seat entry of
   8:                         repair 15's pass 2 (panel_20260926_021621) and repair 16's F2 pass (panel_20260926_053828),
   9:                         the dedicated jobs, the Opus measuring seat and the flagship; the state_note; the closure;
  10:                         the filed rows.  REFUSES if the row already cites panel_20260926_021621.
  11:   opus <grade> <ev>     the Opus seat's ACCEPTS-46 enumeration (after it lands).
  12:   astra <verdict> <ev>  GPT-6 Astra's confirmation of the F2 ruling and the final text.
  13:   sha <sha>             crimewidthkill.commits (and scorehyphenfp's, whose fix ships in the same commit).
  14:   setcommits <row> <sha>  another row's commits (the previous round's pending record).
  15: CRLF on disk, json.dumps(indent=1, ensure_ascii=False), no trailing newline -- round-trip verified before any write.
  16: """
  17: import io
  18: import json
  19: import os
  20: import re
  21: import subprocess
  22: import sys
  23: 
  24: P = os.environ.get("LEDGER_PATH", r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC\tools\pipeline\ledger.json")
  25: SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
  26: A = "regress/artifacts/crimewidthkill/"
  27: R15 = A + "repair15_pass2_20260926/"
  28: R16 = A + "repair16_f2_20260926/"
  29: P15 = R15 + "panels/panel_20260926_021621/"
  30: P16 = R16 + "panels/panel_20260926_053828/"
  31: RR = A + "rerule_20260925/"
  32: DISP = "CHANGELOG #529 and regress/artifacts/crimewidthkill/repair16_f2_20260926/ (the F2 packet and the flagship ruling)"
  33: 
  34: 
  35: def load():
  36:     raw = open(P, "rb").read()
  37:     L = json.loads(raw.decode("utf-8"))
  38:     if dump(L) != raw:
  39:         sys.exit("REFUSED: the ledger does not round-trip byte-identical; its format changed")
  40:     return L
  41: 
  42: 
  43: def dump(L):
  44:     return json.dumps(L, indent=1, ensure_ascii=False).replace("\n", "\r\n").encode("utf-8")
  45: 
  46: 
  47: def save(L):
  48:     open(P, "wb").write(dump(L))
  49: 
  50: 
  51: def row(L, rid):
  52:     r = [x for x in L["rows"] if x["id"] == rid]
  53:     if len(r) != 1:
  54:         sys.exit("REFUSED: row %s found %d times" % (rid, len(r)))
  55:     return r[0]
  56: 
  57: 
  58: def ent(phase, seat, date, grade, ev, note):
  59:     return {"phase": phase, "seat": seat, "date": date, "grade": grade, "grader": "", "ev": ev, "note": note}
  60: 
  61: 
  62: def size(rel):
  63:     return os.path.getsize(os.path.join(SEC, *rel.split("/")))
  64: 
  65: 
  66: #  The three fallback files, read with _scratchpad/agent_models.py (p529/resume_dossier.md section 2e).
  67: FALLBACKS = [
  68:     ("FABLE_C3_RULING_20260914.md", "ae169fa9758283eaf", "2026-09-14T16:22:26Z", "16:29:48Z", "OPUS-4-8 READING"),
  69:     ("FABLE_C5_RULING_20260915.md", "a06935485cd6d5125", "2026-09-16T19:35:00Z", "19:50:12Z", "OPUS-4-8 READING"),
  70:     ("repair14_20260916/FABLE_RULING_20260917.md", "a2bba4bc2896433b4", "2026-09-17T06:17:21Z", "06:25:19Z", None),
  71: ]
  72: REANCHOR = (RR + "fable5_rerule_529_20260925.md (the first-hand fable5 ruling of 2026-09-25, entered below; it "
  73:             "re-anchors C3, D7, Q3 and STOP)")
  74: 
  75: 
  76: def tag_fallbacks(r):
  77:     n = 0
  78:     for e in r["entries"]:
  79:         if e.get("seat") != "fable5" or (e.get("note") or "").startswith("[NOT A SEAT ANSWER]"):
  80:             continue
  81:         for fname, agent, refused, wrote, grade in FALLBACKS:
  82:             if fname in (e.get("ev") or "") or ("FABLE_RULING_20260917.md" in fname and
  83:                                                  "FABLE_RULING_20260917.md" in (e.get("ev") or "")):
  84:                 verif = "SEAT VERIFIED AS FABLE" in (e.get("note") or "")
  85:                 if verif:
  86:                     pre = ("[NOT A SEAT ANSWER] *** WRONG RECORD, corrected 2026-09-26: this verification rested on the "
  87:                            "answer's own `MODEL: claude-fable-5-1' line -- a SELF-REPORT, a check that cannot fail.  The "
  88:                            "subagent transcript (per-message `model' and `stop_reason'; _scratchpad/agent_models.py) shows "
  89:                            "the file was WRITTEN BY claude-opus-4-8 at %s (agent %s), after claude-fable-5-1 ended a turn "
  90:                            "with stop_reason \"refusal\" at %s.  The first-hand ruling is %s. ***  "
  91:                            % (wrote, agent, refused, REANCHOR))
  92:                     e["grade"] = "WRONG RECORD"
  93:                 else:
  94:                     pre = ("[NOT A SEAT ANSWER] *** WRONG RECORD, corrected 2026-09-26: MEASURED from the subagent "
  95:                            "transcript (per-message `model' and `stop_reason'; _scratchpad/agent_models.py), the answer "
  96:                            "this entry credits to fable5 was WRITTEN BY claude-opus-4-8 at %s (agent %s) -- "
  97:                            "claude-fable-5-1 ended a turn with stop_reason \"refusal\" at %s and the Agent tool re-ran the "
  98:                            "rest on opus-4-8, keeping the seat's identity line.  Kept as an opus-4-8 READING, not a fable5 "
  99:                            "answer; the file carries a dated provenance note since 2026-09-26; the first-hand ruling is "
 100:                            "%s. ***  " % (wrote, agent, refused, REANCHOR))
 101:                     e["grade"] = grade or "OPUS-4-8 READING"
 102:                 e["note"] = pre + (e.get("note") or "")
 103:                 n += 1
 104:                 break
 105:     if n != 4:
 106:         sys.exit("REFUSED: expected 4 fallback-credited entries, tagged %d" % n)
