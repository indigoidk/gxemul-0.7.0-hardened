from pathlib import Path
import json,re,ast
read=lambda p:Path(p).read_text(encoding='utf-8',errors='replace')
L=json.loads(read('tools/pipeline/ledger.json'))
r=next(r for r in L['rows'] if r['id']=='fbctrlportkill')
for i,e in enumerate(r['entries']):
 if '[NOT A SEAT ANSWER]' in (e.get('note') or '') and re.search('fallback|opus-4-8',str(e),re.I):print('FB FALLBACK ENTRY',i,e['ev'],e['note'][:550])
for i,l in enumerate(read('CHANGELOG.md').splitlines()[:180],1):
 if re.search('fallback|clearance|21:59|control-A|v6c|ten quoted|five|297|26 checks',l,re.I):print('CHANGELOG',i,l)
rec=Path(r'C:\\Users\\User00\\AppData\\Local\\Temp\\claude\\C--DocumentNoSnc-cc-GXEMUL\\8e474f41-4d47-4c99-bf11-3406a84c4fcd\\scratchpad\\records')
lt=ast.parse(read(rec/'ledger_529.py'));fns={n.name:n for n in lt.body if isinstance(n,ast.FunctionDef)}
def n_appends(n):
