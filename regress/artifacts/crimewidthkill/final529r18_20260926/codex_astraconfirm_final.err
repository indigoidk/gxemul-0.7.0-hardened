271: 
272: 
273: def load():
274:     raw = open(P, "rb").read()
275:     L = json.loads(raw.decode("utf-8"))
276:     if dump(L) != raw:
277:         sys.exit("REFUSED: the ledger does not round-trip byte-identical; its format changed")
278:     return L
279: 
280: 
281: def dump(L):
282:     return json.dumps(L, indent=1, ensure_ascii=False).replace("\n", "\r\n").encode("utf-8")
283: 
284: 
285: def save(L):
286:     open(P, "wb").write(dump(L))
287: 
288: 
289: def row(L, rid):
290:     r = [x for x in L["rows"] if x["id"] == rid]
291:     if len(r) != 1:
292:         sys.exit("REFUSED: row %s found %d times" % (rid, len(r)))
293:     return r[0]
