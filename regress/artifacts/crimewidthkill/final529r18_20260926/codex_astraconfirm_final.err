35:     sys.exit("REFUSED: r19's AST minus its docstring differs from r18's")
36: io.open(OUT, "w", encoding="utf-8", newline="").write(r19)
37: print("r19 %s  (r18 %s)  %s" % (md5(r19), md5(s), OUT))
