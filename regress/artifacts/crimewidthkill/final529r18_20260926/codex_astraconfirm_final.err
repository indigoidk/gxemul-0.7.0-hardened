239: #!/usr/bin/env python3
240: """Ledger records for #529 (crimewidthkill: the row CLOSES) and its three filings.
241: 
242: Modes (LEDGER_PATH names the file; default the working tree's):
243:   records               the provenance corrections the flagship's 09-25 re-ruling ordered (entries crediting three
244:                         opus-4-8 fallback files to fable5 -> [NOT A SEAT ANSWER]); the re-ruling and GPT-6 Astra's
245:                         confirmation of it; tables 13a/14/15a/16 (main-loop measurement records); every seat entry of
246:                         repair 15's pass 2 (panel_20260926_021621) and repair 16's F2 pass (panel_20260926_053828),
247:                         the dedicated jobs, the Opus measuring seat and the flagship; the state_note; the closure;
248:                         the filed rows.  REFUSES if the row already cites panel_20260926_021621.
249:   opus <grade> <ev>     the Opus seat's ACCEPTS-46 enumeration (after it lands).
250:   astra <verdict> <ev>  GPT-6 Astra's confirmation of the F2 ruling and the final text.
251:   sha <sha>             crimewidthkill.commits (and scorehyphenfp's, whose fix ships in the same commit).
252:   setcommits <row> <sha>  another row's commits (the previous round's pending record).
253: CRLF on disk, json.dumps(indent=1, ensure_ascii=False), no trailing newline -- round-trip verified before any write.
254: """
255: import io
256: import json
257: import os
258: import re
259: import subprocess
260: import sys
261: 
262: P = os.environ.get("LEDGER_PATH", r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC\tools\pipeline\ledger.json")
263: SEC = r"C:\DocumentNoSnc\cc\GXEMUL\GXEMUL-SEC"
264: A = "regress/artifacts/crimewidthkill/"
265: R15 = A + "repair15_pass2_20260926/"
266: R16 = A + "repair16_f2_20260926/"
