 368:     c += ["print cause"]
 369:     x, _ = st(A, "sb", CRIME + off, 0); c += x
 370:     c += ["print cause"]
 371:     x, _ = ld(A, "lw", CRIME + off, "v0"); c += x
 372:     c += ["print cause"]
 373:     t, clean = session(c)
 374:     row("%s pre" % lbl, ip2(nth(t, "cause", 0)), "clear", "IP2 low after SOFTINT's default-arm store")
 375:     row("%s lb" % lbl, ip2(nth(t, "cause", 1)), "clear", "refused lb +0x%x: no reassert" % off)
 376:     row("%s sb" % lbl, ip2(nth(t, "cause", 2)), "clear", "refused sb +0x%x: no reassert" % off)
 377:     row("%s ctl" % lbl, ip2(nth(t, "cause", 3)), "set", "CONTROL: accepted lw +0x%x reasserts" % off)
