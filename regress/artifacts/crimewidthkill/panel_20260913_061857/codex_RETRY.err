 177: def pr(t, reg):
 178:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
 179:     return ("0x%x" % int(m.group(1), 16)) if m else "absent"
 180: 
 181: 
 182: def exc(t):
 183:     c = pr(t, "cause")
 184:     return ("%d" % ((int(c, 16) >> 2) & 0x1f)) if c != "absent" else "absent"
 185: 
 186: 
 187: def count(t, s, clean):
 188:     """a text count is evidence only from a whole transcript: an unclean session reads `unclean', never a number"""
 189:     return t.count(s) if clean else "unclean"
