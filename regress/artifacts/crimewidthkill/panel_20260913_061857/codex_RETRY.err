 208: 
 209: def ld(A, op, addr, rt, at=None):
 210:     """one load `op rt, 0(at)', rt seeded with SENT; returns (cmds, code address)"""
 211:     here = A.take(1) if at is None else at
 212:     return ["at=0x%x" % addr, "%s=0x%x" % (rt, SENT)] + run_ops([enc(op, "at", rt)], here), here
 213: 
 214: 
 215: def st(A, op, addr, val, at=None):
 216:     here = A.take(1) if at is None else at
 217:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([enc(op, "a3", "t0")], here), here
