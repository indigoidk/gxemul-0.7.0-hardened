        if ln == 8:
            reset8_latch = 0
        elif ln not in (4, 8):
            if not original_latch:
                original_count += 1
                original_latch = 1
            if not reset8_latch:
                reset8_count += 1
                reset8_latch = 1
    if original_count "'!= reset8_count or '"'latch x5' in trace['rows']:
