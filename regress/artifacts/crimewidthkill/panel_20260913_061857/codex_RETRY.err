        rs = inverse[(word >> 21) & 31]
        imm = word & 0xffff
        if imm & 0x8000:
            imm -= 0x10000
        address = registers[rs] + imm
        if ns['CRIME'] <= address < ns['CRIME'] + 0x280:
            accesses.append((op, address - ns['CRIME']))
