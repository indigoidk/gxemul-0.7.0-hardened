    pc, prior_read = 0, None
    for cmd in t['cmds']:
        match = re.fullmatch(r'(\\w+)=0x([0-9a-f]+)', cmd)
        if match:
            regs[match[1]] = int(match[2], 16)
            if match[1] == 'pc':
                pc = regs['pc']
