 114: def session(cmds, settle=1.5, spin=1.2):
 115:     """one emulator, read to the pty's EOF after `quit'.  Returns (text, clean): clean = EOF reached AND exit 0."""
 116:     pid, fd = pty.fork()
 117:     if pid == 0:
 118:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64", "0x80001000:" + DUMMY])
 119:         os._exit(127)
 120:     buf = ""
 121: 
 122:     def rd(t):
 123:         nonlocal buf
 124:         end = time.time() + t
 125:         while time.time() < end:
 126:             r, _, _ = select.select([fd], [], [], 0.1)
 127:             if not r:
 128:                 continue
 129:             try:
 130:                 d = os.read(fd, 65536)
 131:             except OSError:
 132:                 return False
 133:             if not d:
 134:                 return False
 135:             buf += d.decode("latin-1", "replace")
 136:         return True
 137: 
 138:     rd(settle)
 139:     for i, c in enumerate(cmds):
 140:         try:
 141:             if c == "<RUN>":        # free-run: `continue', let the guest run, then break back in with CTRL-C
 142:                 os.write(fd, b"continue\n")
 143:                 ok = rd(2.0)
 144:                 os.write(fd, b"\x03")
 145:                 ok = ok and rd(1.5)
 146:             else:
 147:                 os.write(fd, (c + "\n").encode("latin-1"))
 148:                 ok = rd(spin if i == len(cmds) - 1 else 0.25)
 149:         except OSError:
 150:             break
 151:         if not ok:
 152:             break
 153:     eof = True                      # a process already gone before `quit' has closed the pty; its status says how
 154:     try:
 155:         os.write(fd, b"quit\n")
 156:         eof = not rd(10.0)          # to EOF, so anything printed on the way out is in the transcript
 157:     except OSError:
 158:         pass
 159:     if not eof:
 160:         try:
 161:             os.kill(pid, signal.SIGKILL)    # a session that never reached EOF is ended, never waited on forever
 162:         except OSError:
 163:             pass
 164:     try:
 165:         os.close(fd)
 166:     except OSError:
 167:         pass
 168:     how = "nostatus"
 169:     try:
 170:         _, stat = os.waitpid(pid, 0)
 171:         how = ("sig%d" % os.WTERMSIG(stat)) if os.WIFSIGNALED(stat) else ("exit%d" % os.WEXITSTATUS(stat))
 172:     except OSError:
 173:         pass
 174:     return buf.replace("\r", ""), (eof and how == "exit0")
