 244: 	 *  0x14000100..0x1400017f is the same as 0x14000000..0x1400007f.
 245: 	 *  0x14000180..0x140001ff is the same as 0x14000000..0x1400007f.
 246: 	 *
 247: 	 *  (I assume that real code will never access the above "mirrors",
 248: 	 *  but it would be trivial to add redirection so that such code
 249: 	 *  would work too.)
 250: 	 *
 251: 	 *  Memory control then starts at 0x14000200.
 252: 	 */
 253: 	struct crime_data *d = (struct crime_data *) extra;
 254: 	uint64_t idata = 0, odata = 0;
