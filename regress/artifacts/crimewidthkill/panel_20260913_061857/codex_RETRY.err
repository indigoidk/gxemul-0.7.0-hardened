 344: # ---- the INTSTAT / INTMASK labels: their arm calls crime_interrupt_reassert(), which is NOT idempotent -- ----
 345: #  INTMASK = bit 28 and SOFTINT = bit 28 are stored with 8-byte writes; SOFTINT's store goes to the default arm and does
 346: #  NOT reassert, so the CPU's IP2 (cause bit 0x400) stays low until something reasserts.  A refused access at the label
 347: #  must leave it low; the accepted `lw' that follows is the CONTROL that the arm reasserts at once.  (Measured by the
 348: #  pass-2 Opus seat, opus_pass2_20260913/scripts/crime_p2_escape.py E1/E2: a fall-through at the label sets IP2.)
 349: BIT = 0x10000000
 350: 
 351: 
 352: def nth(t, reg, n):
 353:     ms = re.findall(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
 354:     return int(ms[n], 16) if len(ms) > n else None
