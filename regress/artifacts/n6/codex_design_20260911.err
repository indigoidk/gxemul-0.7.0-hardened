  965: # ---------------------------------------------------------------------------
  966: #  #432: THE FOOTBRIDGE'S FIRST REACHABILITY WITNESS OF ANY KIND.
  967: #
  968: #  Recorded before this probe existed: R6 was the ONLY code round in this tree with no
  969: #  reachability witness -- no rig boots a footbridge machine and there is no m8online analog.
  970: #  regress/diff_footbridge.c calls the device functions DIRECTLY, so it proves BEHAVIOUR and
  971: #  would stay green under a change that unmapped the device entirely.  This drives real guest
  972: #  ldr/str through the real address decode and the real memory_rw plumbing on a COLD DEBUGGER:
  973: #  measured 1.9 s for three arms, against a rig boot this tree does not have at all.
  974: #
  975: #  IT LIVES HERE, in the ARM gate, for the same reason m8820x_sites_probe.py lives in
  976: #  gate_m88k_rounding.sh: `cats` is an ARM machine and this gate already writes the four-byte
  977: #  raw stub that makes such a machine construct.  A new gate script would move GATE_MANIFEST,
  978: #  which is a bigger claim than one probe is worth.
  979: #
  980: #  THE TRAP IT GUARDS, and it nearly produced a confident wrong answer.  machine_cats.c:131
  981: #  maps only the low 256 MB and the footbridge is at PA 0x42000000, so under the boot-time MMU
  982: #  every device row reads 0x0 WITH A RAM LIVENESS ROW STILL GREEN -- which is exactly what an
  983: #  absent device looks like.  The probe's arm T runs the same program with the MMU-disable
  984: #  instructions replaced by nops and requires that it CANNOT produce the device's answer; arm L
  985: #  reads CP15 c1 back and requires bit 0 clear.  Negative-controlled in both directions.
  986: FBLOG=$LOGDIR/footbridge_sites.log
  987: python3 footbridge_sites_probe.py "$PMAX" "$STUB" > "$FBLOG" 2>&1 || true
  988: grep -E "^(  arm |C[0-9]|A[0-9]|I1|K1|D1)" "$FBLOG" | sed 's/^/       /'
  989: 
  990: if ! grep -q "FOOTBRIDGE_SITES_" "$FBLOG"; then
  991:     note "footbridge probe produced no verdict; last lines follow"
  992:     tail -5 "$FBLOG" | sed 's/^/       /'
  993:     check "footbridge probe completed" "no" "yes"
  994: else
  995:     #  THE CONTROL FIRST, and separately from the verdict.  A probe whose controls failed has
  996:     #  measured NOTHING, and this one has a control that a liveness row cannot substitute for.
  997:     check "footbridge: controls prove the probe measures" \
  998:           "$(grep -c 'FOOTBRIDGE_SITES_CONTROL=OK' "$FBLOG")" "1"
  999:     check "footbridge: every row green" \
 1000:           "$(grep -c 'FOOTBRIDGE_SITES_PASS' "$FBLOG")" "1"
 1001:     #  VALUES, NOT SURVIVAL.  0x1011 is DC21285_VENDOR_ID (dev_footbridge.c:423) and can only
 1002:     #  have come back through this device; an unmapped read survives too, it just returns 0.
 1003:     check "footbridge: VENDOR_ID 0x1011 through a real guest ldr" \
 1004:           "$(grep -cE '^A1 .*got=0x00001011 .*ok$' "$FBLOG")" "1"
 1005:     #  The vanishing top byte IS the handler's signature: :548 stores idata & TIMER_MAX_VAL.
 1006:     #  RAM, or any decode that merely absorbed the store, returns 0x12345678 unchanged.
 1007:     check "footbridge: TIMER_1_LOAD masked to 24 bits by the handler" \
 1008:           "$(grep -cE '^A2 .*got=0x00345678 .*ok$' "$FBLOG")" "1"
 1009:     #  THE PROBE'S OWN FAILABILITY CONTROL.  Arms L and K differ by ONE instruction; K reads
 1010:     #  IRQ_ENABLE_SET, an UNFIXED fatal()+exit(1) at :495-497.  Without it, "SURVIVED" on every
 1011:     #  row is satisfied by a probe whose guest code never reached the device at all.
 1012:     check "footbridge: the one-instruction kill arm still dies" \
 1013:           "$(grep -cE '^K1 .*ok$' "$FBLOG")" "1"
 1014:     #  The defence against the hand-assembled-encoding trap: every planted word is compared
 1015:     #  against the disassembly the emulator printed AS IT STEPPED IT.
 1016:     check "footbridge: no planted word failed its disassembly check" \
 1017:           "$(grep -c 'DISASSEMBLY MISMATCH' "$FBLOG")" "0"
 1018: fi
