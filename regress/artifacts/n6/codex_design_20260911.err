C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1435-PCC2DLOG=$LOGDIR/pcc2_default.log
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1436-python3 -u pcc2_default_probe.py "$PMAX" gate > "$PCC2DLOG" 2>&1 || true
