C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh:1458:python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PITLOG" 2>&1 || true
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1459-
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1460-#  A PRESERVED LOG IS VERIFIED BY ITS COMPLETION SENTINEL, NOT BY ITS EXISTENCE.  The probe
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh:1461:#  gained PIT8253_LATCH_DONE specifically so this row could be written correctly the first
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1462-#  time -- before it, the last line was a bare "PASS", a word that occurs in dozens of other
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1463-#  contexts and cannot distinguish a COMPLETED run from a TRUNCATED one.
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh:1464:if ! grep -q "PIT8253_LATCH_DONE" "$PITLOG"; then
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1465-    note "pit8253 probe did not reach its completion sentinel; last lines follow"
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1466-    tail -5 "$PITLOG" | sed 's/^/       /'
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1467-    check "pit8253 probe completed" "no" "yes"
--
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1475-              "$(grep -c "^  ok   $c" "$PITLOG")" "1"
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1476-    done
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1477-
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh:1478:    #  Per-row presence.  A row that silently stops being tested is the padded-column class,
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1479-    #  so each is checked individually rather than by a total.  Eighteen rows: 4 controls +
C:\DocumentNoSnc\CC\GXEMUL\GXEMUL-SEC\regress\gate_arm.sh-1480-    #  E/A2 apparatus + R0..R11.
