  106: 
  107: def run_arm(label, prog):
  108:     """Plant `prog`, step it one instruction at a time, report registers and liveness."""
  109:     pid, fd = pty.fork()
  110:     if pid == 0:
  111:         os.execvp(BIN, [BIN, "-V", "-T", "-E", "cats", "-M", "32",
  112:                         "0x%x:%s" % (CODE, STUB)])
  113:         os._exit(127)
  114:     buf = ""
  115:     dead = [False]
  116: 
  117:     def rd(t=0.4):
  118:         nonlocal buf
  119:         r, _, _ = select.select([fd], [], [], t)
  120:         if fd not in r:
  121:             return True
  122:         try:
  123:             d = os.read(fd, 65536)
  124:         except OSError:
  125:             dead[0] = True
  126:             return False
  127:         if not d:
  128:             dead[0] = True
  129:             return False
  130:         buf += d.decode("latin1", "replace")
  131:         return True
  132: 
  133:     #  Signature order is not free choice: gate_hygiene.sh pins the CANONICAL #392 call form
  134:     #  as a literal `return wait(mark=_mark, echo=<x> if <x> else None)`, tightened three
  135:     #  times because every looser prefix was a substring of the broken form too.  Written any
  136:     #  other way, a probe is simply not covered by that ratchet -- which is worse than failing
  137:     #  it.  So timeout goes last, and send() ends on the pinned form.
  138:     def wait(mark=0, echo=None, timeout=60):
  139:         t = time.time()
  140:         while time.time() - t < timeout:
  141:             if not rd():
  142:                 return False
  143:             resp = buf[mark:]
  144:             if echo is not None and echo not in resp:
  145:                 continue
  146:             if len(buf) > mark and resp.rstrip().endswith("GXemul>"):
  147:                 return True
  148:         return False
  149: 
  150:     def send(x, timeout=60):
  151:         b = (x + "\n").encode("latin1")
  152:         _mark = len(buf)
  153:         n = 0
  154:         try:
  155:             while n < len(b):
  156:                 n += os.write(fd, b[n:])
  157:         except OSError:
  158:             dead[0] = True
  159:             return False
  160:         return wait(mark=_mark, echo=x if x else None)
  161: 
  162:     status, regs, badis = "?", {}, []
  163:     #  KEYWORD, and this is not style.  A positional wait(120) silently becomes mark=120 under
  164:     #  the pinned parameter order -- a real behaviour change, and the exact mistake the
  165:     #  m8820x probe's conversion had to fix in the same commit.
  166:     if not wait(timeout=120):
  167:         status = "NO-PROMPT"
  168:     else:
  169:         send("put w 0x%08x, 0x%08x" % (DATA, 0x11223344))
  170:         send("put w 0x%08x, 0x%08x" % (DATA + 4, 0x12345678))
  171:         for off, word, _t, _c in prog:
  172:             send("put w 0x%08x, 0x%08x" % (CODE + off, word))
  173:         send("pc=0x%08x" % CODE)
  174:         status = "SURVIVED"
  175:         for off, word, text, _c in prog[:-1]:      # the landing pad is never stepped
  176:             mark = len(buf)
  177:             if not send("step 1", timeout=30) or dead[0]:
  178:                 status = "HOST-DIED"
  179:                 break
  180:             seg = buf[mark:]
  181:             #  Match the emulator's own step line for THIS address and compare the mnemonic
  182:             #  it printed against what this table says was planted.
  183:             m = re.search(r"%08x:\s+%08x\s+([^\r\n<]+)" % (CODE + off, word), seg)
  184:             got = re.sub(r"\s+", " ", m.group(1)).strip() if m else "(no step line)"
  185:             if got != text:
  186:                 badis.append("0x%02x planted 0x%08x -> %r, expected %r"
  187:                              % (off, word, got, text))
  188:         if status == "SURVIVED":
  189:             mark = len(buf)
  190:             if send("reg", timeout=30) and not dead[0]:
  191:                 for n in (0, 1, 2, 3, 5, 6, 7):
  192:                     mm = re.search(r"\br%d\s*=\s*0x([0-9a-fA-F]+)" % n, buf[mark:])
  193:                     if mm:
  194:                         regs[n] = int(mm.group(1), 16)
  195:             else:
  196:                 status = "HOST-DIED" if dead[0] else "NO-REG"
  197:     fatals = re.findall(r"(\[[^\r\n\]]*footbridge[^\r\n\]]*\])", buf)
  198:     try:
  199:         os.write(fd, b"quit\n")
  200:         time.sleep(0.3)
  201:     except OSError:
  202:         pass
  203:     try:
  204:         os.close(fd)
  205:     except OSError:
  206:         pass
  207:     try:
  208:         _, st = os.waitpid(pid, 0)
  209:     except Exception:
  210:         st = None
  211:     code = os.WEXITSTATUS(st) if st is not None and os.WIFEXITED(st) else None
  212:     sig = os.WTERMSIG(st) if st is not None and os.WIFSIGNALED(st) else None
  213:     print("  arm %-36s %-9s exit=%-5s signal=%s" % (label, status, code, sig))
  214:     for b in badis:
  215:         print("      DISASSEMBLY MISMATCH: %s" % b)
  216:     return {"status": status, "regs": regs, "exit": code, "signal": sig,
  217:             "fatals": fatals, "badis": badis}
  218: 
  219: 
  220: def hexs(v):
  221:     return "-" if v is None else "0x%08x" % v
  222: 
  223: 
  224: def row(tag, note, got, want):
  225:     ok = got == want
  226:     print("%-4s %-40s got=%-12s want=%-12s %s"
  227:           % (tag, note, hexs(got), hexs(want), "ok" if ok else "FAIL"))
  228:     return ok
