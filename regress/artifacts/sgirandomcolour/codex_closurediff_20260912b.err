NEW:
```python
# ================================================================ #519 bounded closure
# Ten fresh first-decline sessions, one primed repeat session, and the M28-family row.
# Each table entry contributes ONE assertion: its readbacks and announce count.
# The RGBA control uses four initialized bytes, including for depth-eight declines.
# A fresh session has BADCOLOR clear; the RGBA control leaves it clear.
CL519_CASES = (
    ("tA d2 first",   0x01f0, KS_A,       False, "FIRST_A2_ZERO"),
    ("tA d8 first",   0x03f0, KS_A,       False, "FIRST_A8_ZERO"),
    ("tB d2 first",   0x05f0, KS_B,       False, "FIRST_B2_ZERO"),
    ("tB d4 first",   0x06f0, KS_B,       False, "FIRST_B4_ZERO"),
    ("tB d8 first",   0x07f0, KS_B,       False, "FIRST_B8_ZERO"),
    ("tC d2 first",   0x09f0, KS_C,       False, "FIRST_C2_ZERO"),
    ("tC d4 first",   0x0af0, KS_C,       False, "FIRST_C4_ZERO"),
    ("tC d8 first",   0x0bf0, KS_C,       False, "FIRST_C8_ZERO"),
    ("lin d2 first",  0x11f0, DST_KSEG1,  False, "FIRST_L2_ZERO"),
    ("lin d8 first",  0x13f0, DST_KSEG1,  False, "FIRST_L8_ZERO"),
    ("lin d1 repeat", 0x10f0, DST_KSEG1,  True,  "REPEAT_L1_ZERO"),
    ("M28 nib60",     0x1260, DST_KSEG1,  False, "NIB_OTHER_ZERO"),
)
for _name, _mode, _ks, _repeat, _control in CL519_CASES:
    A = Addr(CODE)
    _cmds = tiled_prologue(A)
    _cmds += store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)
    _modes = [(_mode & 0x1c00) | 0x0220]
    _want = ["0x%08x" % FG_VAL]
    if _repeat:
        # This first decline is itself read before the target cell repaints.
        _modes.append(MODE_YCRCB)
        _want.append(cell_want(MODE_YCRCB))
    _modes.append(_mode)
    _want.append(cell_want(_mode))
    for _m in _modes:
        _cmds += cell_op(A, _m, _ks)
    _t, _alive = session(_cmds, spin=3.0)
    _got = printed_seq(_t, _modes) if _alive else []
    row(_name, (tuple(_got), _t.count(ANN)) if _alive else "died",
        (tuple(_want), 1),
        "readbacks in operation order; one announce; control=" + _control)

ok = sum(1 for _, o in rows if o)
```

**Exact negative controls and what varies**

These are **alternative test mutations**, applied individually to [dev_sgi_re.c](C:/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/src/devices/dev_sgi_re.c:364). They are not production changes. The following Python string literals specify the exact old and new text; `\t` denotes a literal tab.

Initializing the default-arm buffer makes these controls deterministic without copying uninitialized storage. Their predicates run **before** the warning block sets BADCOLOR. Testing the clear state at the later `if (ok)` would be too late.

```python
OLD = "\t\t\tok = 0;"

NEW_BY_MUTANT = {
    "FIRST_A2_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 0 && bufdepth == 2 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_A8_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 0 && bufdepth == 8 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_B2_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 1 && bufdepth == 2 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_B4_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 1 && bufdepth == 4 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_B8_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 1 && bufdepth == 8 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_C2_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 2 && bufdepth == 2 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_C4_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 2 && bufdepth == 4 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_C8_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 2 && bufdepth == 8 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_L2_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 4 && bufdepth == 2 && !(d->warned & SGIRE_W_BADCOLOR));",
    "FIRST_L8_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 4 && bufdepth == 8 && !(d->warned & SGIRE_W_BADCOLOR));",
    "REPEAT_L1_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (tlb_mode == 4 && bufdepth == 1 && (d->warned & SGIRE_W_BADCOLOR) != 0);",
    "NIB_OTHER_ZERO":
        "\t\t\tmemset(buf, 0, sizeof(buf)); ok = (color_mode != 0xf0 && color_mode != 0x50);",
    "TAIL8_ZERO":
        "\t\t\tok = 0; if (bufdepth == 8) { memset(buf, 0, sizeof(buf)); cpu->memory_rw(cpu, cpu->mem, tileptr + ofs + 4, buf, 4, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL); }",
}
```

