[{\"label\":\"header\",\"old\":\"#  CONTRACT (vacuity-floor clause (e)) -- what this witness catches and what it does NOT:\\n#    CATCHES   the default arm assigning random() and storing it: "'`ycrcb put'"' and "'`reserved put'"'\\n#              expect the destination to remain unchanged (post-fix honest decline); on HEAD they\\n#              fail because host random() bytes overwrite the pre-painted sentinel.\\n#    DOES NOT  implement YCRCB colour space conversion or other colour modes; it witnesses the defect\\n#              on unhandled modes under ordinary bounds-correctness engineering.\",\"new\":\"#  CONTRACT -- #519 closure design, 2026-09-12.  This is the controlling coverage\\n#  contract; older CONTRACT/CLOSED/COMPLETE claims below are historical and are\\n#  superseded wherever they claim a larger domain or describe missing coverage.\\n#\\n#  The declined-PUT input projection is\\n#      {TLB_A, TLB_B, TLB_C, LIN_A} x {bufdepth 1, 2, 4, 8 bytes}\\n#      x {SGIRE_W_BADCOLOR clear, set ON ENTRY to the colour default arm}.\\n#  Its 32 cells concern PUTs that reach that arm with eligible coordinates and\\n#  a valid selected mapping.  Earlier bounds, mapping and BADMODE returns are\\n#  outside this projection.  The added fixtures use solid 1x1 DE rectangles at\\n#  (0,0); their supported RGBA/4-byte controls verify the selected destination.\\n#  At (0,0), the index and offset are zero at every tested depth.\\n#\\n#  The design occupies every cell of this projection.  This exhausts its input\\n#  tuples for a default-store permission predicate depending ONLY on these\\n#  three axes.  It is not full closure over arbitrary predicates on all function\\n#  inputs, nor a claim that each cell independently tests every warning property.\\n#  Readbacks cover every attempted transfer byte, including both words at depth\\n#  eight.  Each declined operation is observed before another repaint or PUT.\\n#  Preserved bytes do not prove that no write occurred: a write of identical\\n#  bytes remains invisible.  Zero-initialized negative controls have exact,\\n#  differing readbacks; kills of uninitialized-buffer mutants need measurement.\\n#\\n#  OUTSIDE: exhaustive coordinates, tile indices, descriptor payloads, raw mode\\n#  bits, foreground values, other device/CPU/memory state and their interactions.\\n#  The twelve default nibbles are sampled by existing rows, not crossed with\\n#  this entire projection.  GET, accepted-type width semantics, invalid-input\\n#  paths, per-instance/reset behavior and cold/warm memory paths are not closed.\\n#  Existing acceptance, nibble, coordinate and latch-independence rows retain\\n#  their individual assertions without enlarging the projection.\\n#\\n#  M28 nib60 adds a fresh LIN_A/depth-4/type-0x60 decline at FG_VAL.  It targets\\n#  the reported other-nibble permission family.  The exact historical M28/M28r\\n#  edit is absent from the permitted records; NIB_OTHER_ZERO is a newly specified\\n#  deterministic control, not an identification of that historical mutant.\\n#  Every score for this design is a PREDICTION until built and measured.\"},{\"label\":\"cell helper and parser\",\"old\":\"def cell_op(A, mode, ks):\\n    \\\"\\\"\\\"One cell: repaint, then "'`sw MODE_DST; sw PRIM_START; lw'"' in ONE stepped block.  The\\n    primitive fires synchronously inside the second store, so the load that follows it in the\\n    same block reads the destination after that operation and before anything else.\\\"\\\"\\\"\\n    return ([\\\"put w 0x%x, 0x%08x\\\" % (ks, DST_PAINT),\\n             \\\"a3=0x%x\\\" % DE_MODE_DST,   \\\"t0=0x%x\\\" % mode,\\n             \\\"a2=0x%x\\\" % DE_PRIM_START, \\\"t1=0x%x\\\" % PRIM_RECT,\\n             \\\"at=0x%x\\\" % ks,            \\\"v0=0x%x\\\" % SENTINEL]\\n            + run_ops([OP_SW_T0_A3, OP_SW_T1_A2, OP_LW_V0_AT], A.take(3))\\n            + [\\\"print v0\\\"])\\n\\ndef printed_seq(t):\\n    return [\\\"0x%08x\\\" % (int(v, 16) & 0xffffffff)\\n            for v in re.findall(r\\\"print\\\\s+v0\\\\s*\\\\n\\\\s*(0x[0-9a-f]+)\\\", t)]\\n\",\"new\":\"DST_PAINT_TAIL = 0x55667788\\n\\ndef cell_want(mode):\\n    return (\\\"0x%08x%08x\\\" % (DST_PAINT, DST_PAINT_TAIL)\\n            if ((mode >> 8) & 3) == 3 else \\\"0x%08x\\\" % DST_PAINT)\\n\\ndef cell_op(A, mode, ks):\\n    \\\"\\\"\\\"Repaint, fire one synchronous PUT, then read its whole transfer span.\\\"\\\"\\\"\\n    depth8 = ((mode >> 8) & 3) == 3\\n    paint = [\\\"put w 0x%x, 0x%08x\\\" % (ks, DST_PAINT)]\\n    if depth8:\\n        paint += [\\\"put w 0x%x, 0x%08x\\\" % (ks + 4, DST_PAINT_TAIL)]\\n    return (paint\\n            + [\\\"a3=0x%x\\\" % DE_MODE_DST,   \\\"t0=0x%x\\\" % mode,\\n               \\\"a2=0x%x\\\" % DE_PRIM_START, \\\"t1=0x%x\\\" % PRIM_RECT,\\n               \\\"at=0x%x\\\" % ks,            \\\"v0=0x%x\\\" % SENTINEL]\\n            + run_ops([OP_SW_T0_A3, OP_SW_T1_A2,\\n                       OP_LD_V0_AT if depth8 else OP_LW_V0_AT], A.take(3))\\n            + [\\\"print v0\\\"])\\n\\ndef printed_seq(t, modes=None):\\n    raw = re.findall(r\\\"print\\\\s+v0\\\\s*\\\\n\\\\s*(0x[0-9a-f]+)\\\", t)\\n    if modes is None:\\n        return [\\\"0x%08x\\\" % (int(v, 16) & 0xffffffff) for v in raw]\\n    if len(raw) "'!= len(modes):'"\\n        return []\\n    return [(\\\"0x%016x\\\" % (int(v, 16) & 0xffffffffffffffff)\\n             if ((mode >> 8) & 3) == 3\\n             else \\\"0x%08x\\\" % (int(v, 16) & 0xffffffff))\\n            for v, mode in zip(raw, modes)]\\n\"},{\"label\":\"tiled parse\",\"old\":\"    _v = printed_seq(_t) if _alive else []\",\"new\":\"    _modes = [m for _, m, _ in _acc] + [m for _, m in _dec] + [_rpt]\\n    _v = printed_seq(_t, _modes) if _alive else []\"},{\"label\":\"tiled expected\",\"old\":\"        row(\\\"%s ycrcb %s\\\" % (_tag, _n), _cell(len(_acc) + _j) if _alive else \\\"died\\\", want_sentinel,\",\"new\":\"        row(\\\"%s ycrcb %s\\\" % (_tag, _n), _cell(len(_acc) + _j) if _alive else \\\"died\\\", cell_want(_m),\"},{\"label\":\"linear parse\",\"old\":\"_vl = printed_seq(t_lin) if alive_lin else []\",\"new\":\"_vl = printed_seq(t_lin, (0x10f0, 0x11f0, 0x13f0)) if alive_lin else []\"},{\"label\":\"linear expected\",\"old\":\"    row(\\\"lin ycrcb %s\\\" % _n, (_vl[_i] if _i < len(_vl) else \\\"absent\\\") if alive_lin else \\\"died\\\",\\n        want_sentinel,\",\"new\":\"    row(\\\"lin ycrcb %s\\\" % _n, (_vl[_i] if _i < len(_vl) else \\\"absent\\\") if alive_lin else \\\"died\\\",\\n        cell_want(_m),\"},{\"label\":\"add closure cases\",\"old\":\"ok = sum(1 for _, o in rows if o)\",\"new\":\"# ================================================================ #519 bounded closure\\n# Ten fresh first-decline sessions, one primed repeat session, and the M28-family row.\\n# Each table entry contributes ONE assertion: its readbacks and announce count.\\n# The RGBA control uses four initialized bytes, including for depth-eight declines.\\n# A fresh session has BADCOLOR clear; the RGBA control leaves it clear.\\nCL519_CASES = (\\n    (\\\"tA d2 first\\\",   0x01f0, KS_A,       False, \\\"FIRST_A2_ZERO\\\"),\\n    (\\\"tA d8 first\\\",   0x03f0, KS_A,       False, \\\"FIRST_A8_ZERO\\\"),\\n    (\\\"tB d2 first\\\",   0x05f0, KS_B,       False, \\\"FIRST_B2_ZERO\\\"),\\n    (\\\"tB d4 first\\\",   0x06f0, KS_B,       False, \\\"FIRST_B4_ZERO\\\"),\\n    (\\\"tB d8 first\\\",   0x07f0, KS_B,       False, \\\"FIRST_B8_ZERO\\\"),\\n    (\\\"tC d2 first\\\",   0x09f0, KS_C,       False, \\\"FIRST_C2_ZERO\\\"),\\n    (\\\"tC d4 first\\\",   0x0af0, KS_C,       False, \\\"FIRST_C4_ZERO\\\"),\\n    (\\\"tC d8 first\\\",   0x0bf0, KS_C,       False, \\\"FIRST_C8_ZERO\\\"),\\n    (\\\"lin d2 first\\\",  0x11f0, DST_KSEG1,  False, \\\"FIRST_L2_ZERO\\\"),\\n    (\\\"lin d8 first\\\",  0x13f0, DST_KSEG1,  False, \\\"FIRST_L8_ZERO\\\"),\\n    (\\\"lin d1 repeat\\\", 0x10f0, DST_KSEG1,  True,  \\\"REPEAT_L1_ZERO\\\"),\\n    (\\\"M28 nib60\\\",     0x1260, DST_KSEG1,  False, \\\"NIB_OTHER_ZERO\\\"),\\n)\\nfor _name, _mode, _ks, _repeat, _control in CL519_CASES:\\n    A = Addr(CODE)\\n    _cmds = tiled_prologue(A)\\n    _cmds += store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)\\n    _modes = [(_mode & 0x1c00) | 0x0220]\\n    _want = [\\\"0x%08x\\\" % FG_VAL]\\n    if _repeat:\\n        # This first decline is itself read before the target cell repaints.\\n        _modes.append(MODE_YCRCB)\\n        _want.append(cell_want(MODE_YCRCB))\\n    _modes.append(_mode)\\n    _want.append(cell_want(_mode))\\n    for _m in _modes:\\n        _cmds += cell_op(A, _m, _ks)\\n    _t, _alive = session(_cmds, spin=3.0)\\n    _got = printed_seq(_t, _modes) if _alive else []\\n    row(_name, (tuple(_got), _t.count(ANN)) if _alive else \\\"died\\\",\\n        (tuple(_want), 1),\\n        \\\"readbacks in operation order; one announce; control=\\\" + _control)\\n\\nok = sum(1 for _, o in rows if o)\"}]
'@
"'$cl519Check = @'"'
import ast, json, re, sys
edits = json.load(sys.stdin)
path = \"C:/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/regress/sgi_re_colourdefault_probe.py\"
with open(path, encoding=\"utf-8\") as f:
    current = f.read()
proposed = current
for e in edits:
    assert proposed.count(e[\"old\"]) == 1, e[\"label\"]
    proposed = proposed.replace(e[\"old\"], e[\"new\"])
def collect(source):
    tree = ast.parse(source)
    compile(tree, \"<probe-design>\", \"exec\")
    sessions = []
    class StubSys:
        argv = [\"probe\", \"not-executed\", \"static\"]
        @staticmethod
        def exit(code): pass
    def fake_session(cmds, **kw):
        sessions.append(list(cmds))
        return \"\", True
    body = []
    for node in tree.body:
        if isinstance(node, (ast.Import, ast.ImportFrom)): continue
        if isinstance(node, ast.FunctionDef) and node.name == \"session\": continue
        if isinstance(node, ast.If) and \"os.path.exists\" in ast.unparse(node.test): continue
        body.append(node)
    tree.body = body
    ns = {\"sys\": StubSys, \"session\": fake_session, \"re\": re, \"print\": lambda *a, **k: None}
    exec(compile(tree, \"<command-generation-only>\", \"exec\"), ns)
    return sessions, ns
def trace(cmds):
    regs, code, de, maps = {}, {}, {}, {}
    pc, warned, cells = 0, False, []
    def write(addr, val, size):
        nonlocal warned
        if addr in (0xb5001000, 0xb5001200, 0xb5001400, 0xb5001020) and size == 8:
            bank = 0 if addr == 0xb5001020 else (addr - 0xb5001000) // 0x200
            base = 16 if addr == 0xb5001020 else 0
            for i in range(4): maps[bank, base+i] = (val >> (48-16*i)) & 0xffff
        elif 0xb5002000 <= addr < 0xb5003000 and size in (4,8):
            de[addr & ~0x800] = val & 0xffffffff
            if addr & 0x800 and val == 0x03020000:
                mode, vertex = de.get(0xb5002008,0), de.get(0xb5002070,0)
                x, y = (vertex >> 16) & 0x7ff, vertex & 0x7ff
                bank, depth, nib = (mode >> 10) & 7, 1 << ((mode >> 8) & 3), mode & 0xf0
                index = x >> 12 if bank == 4 else (y >> 7)*16 + x // (512 // depth)
                valid = (bank == 4 and index < 32) or (bank in (0,1,2) and index < 256 and maps.get((bank,index),0) & 0x8000)
                if valid and nib not in (0,0x10,0x20,0x30):
                    cells.append((bank,depth,int(warned),\"0x%04x\" % mode,x,y))
                    warned = True
    for cmd in cmds:
        m = re.fullmatch(r\"put w (0x[0-9a-f]+), (0x[0-9a-f]+)\",cmd)
        if m:
            code[int(m[1],16)] = int(m[2],16)
            continue
        m = re.fullmatch(r\"([a-z][a-z0-9]*)=(0x[0-9a-f]+)\",cmd)
        if m:
            if m[1] == \"pc\": pc = int(m[2],16)
            else: regs[m[1]] = int(m[2],16)
            continue
        if cmd.startswith(\"step \"):
            for i in range(int(cmd.split()[1])):
                op = code[pc+4*i]
                rs, rt = (op >> 21)&31, (op >> 16)&31
                names = {1:\"at\",2:\"v0\",5:\"a1\",6:\"a2\",7:\"a3\",8:\"t0\",9:\"t1\"}
                addr = regs.get(names.get(rs,\"?\"),0) + (op & 0xffff)
                size = {0x28:1,0x2b:4,0x3f:8}.get(op >> 26)
                if size: write(addr,regs.get(names.get(rt,\"?\"),0),size)
    return cells
for label, source in ((\"current\",current),(\"proposed\",proposed)):
    sessions, ns = collect(source)
    traced = [trace(c) for c in sessions]
    covered = sorted(set(c[:3] for seq in traced for c in seq))
    missing = [(b,d,w) for b in (0,1,2,4) for d in (1,2,4,8) for w in (0,1) if (b,d,w) not in covered]
    print(json.dumps({\"version\":label,\"sessions\":len(sessions),\"assertions\":len(ns[\"rows\"]),\"covered\":covered,\"empty\":missing}))
    print(json.dumps({\"session_declines\":traced if label == \"current\" else traced[-12:]}))
    if label == \"proposed\":
        checks = [
            ns[\"printed_seq\"](\"print v0\\n0xffffffffaabbccdd\\nprint v0\\n0x1122334455667788\\n\",[0x0220,0x03f0]) == [\"0xaabbccdd\",\"0x1122334455667788\"],
            ns[\"printed_seq\"](\"print v0\\n0x11223344\\n\",[0x0220,0x03f0]) == [],
            ns[\"cell_want\"](0x03f0) == \"0x1122334455667788\",
            ns[\"cell_want\"](0x01f0) == \"0x11223344\",
        ]
        assert all(checks)
        print(json.dumps({\"parser_checks\":checks,\"new_session_command_counts\":[len(c) for c in sessions[-12:]]}))

