			}
		} else if (writeflag == MEM_WRITE) {
			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
				d->re_tlb_c[tlbi] = data[hwi]*256 + data[hwi+1];
				debug("d->re_tlb_c[%i] = 0x%04x\n", tlbi, d->re_tlb_c[tlbi]);
