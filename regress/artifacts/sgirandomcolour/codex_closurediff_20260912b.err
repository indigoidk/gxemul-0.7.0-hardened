		break;

	case CRIME_DE_NULL:
		debug("[ sgi_de: %s CRIME_DE_NULL: 0x%016llx ]\n",
		    writeflag == MEM_WRITE ? "write to" : "read from",
		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
		break;

	case CRIME_DE_FLUSH:
		debug("[ sgi_de: %s CRIME_DE_FLUSH: 0x%016llx ]\n",
		    writeflag == MEM_WRITE ? "write to" : "read from",
		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
