"'$cl519Check = @'"'
import ast, json, re, sys
edits = json.load(sys.stdin)
path = \"C:/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/regress/sgi_re_colourdefault_probe.py\"
with open(path, encoding=\"utf-8\") as f:
    current = f.read()
proposed = current
for e in edits:
    assert proposed.count(e[\"old\"]) == 1, e[\"label\"]
    proposed = proposed.replace(e[\"old\"], e[\"new\"])
def collect(source):
    tree = ast.parse(source)
    compile(tree, \"<probe-design>\", \"exec\")
    sessions = []
    class StubSys:
        argv = [\"probe\", \"not-executed\", \"static\"]
        @staticmethod
        def exit(code): pass
    def fake_session(cmds, **kw):
        sessions.append(list(cmds))
        return \"\", True
    body = []
    for node in tree.body:
        if isinstance(node, (ast.Import, ast.ImportFrom)): continue
        if isinstance(node, ast.FunctionDef) and node.name == \"session\": continue
        if isinstance(node, ast.If) and \"os.path.exists\" in ast.unparse(node.test): continue
        body.append(node)
    tree.body = body
    ns = {\"sys\": StubSys, \"session\": fake_session, \"re\": re, \"print\": lambda *a, **k: None}
    exec(compile(tree, \"<command-generation-only>\", \"exec\"), ns)
    return sessions, ns
def trace(cmds):
    regs, code, de, maps = {}, {}, {}, {}
    pc, warned, cells = 0, False, []
    def write(addr, val, size):
        nonlocal warned
        if addr in (0xb5001000, 0xb5001200, 0xb5001400, 0xb5001020) and size == 8:
            bank = 0 if addr == 0xb5001020 else (addr - 0xb5001000) // 0x200
            base = 16 if addr == 0xb5001020 else 0
            for i in range(4): maps[bank, base+i] = (val >> (48-16*i)) & 0xffff
        elif 0xb5002000 <= addr < 0xb5003000 and size in (4,8):
            de[addr & ~0x800] = val & 0xffffffff
            if addr & 0x800 and val == 0x03020000:
                mode, vertex = de.get(0xb5002008,0), de.get(0xb5002070,0)
                x, y = (vertex >> 16) & 0x7ff, vertex & 0x7ff
                bank, depth, nib = (mode >> 10) & 7, 1 << ((mode >> 8) & 3), mode & 0xf0
                index = x >> 12 if bank == 4 else (y >> 7)*16 + x // (512 // depth)
                valid = (bank == 4 and index < 32) or (bank in (0,1,2) and index < 256 and maps.get((bank,index),0) & 0x8000)
                if valid and nib not in (0,0x10,0x20,0x30):
                    cells.append((bank,depth,int(warned),\"0x%04x\" % mode,x,y))
                    warned = True
    for cmd in cmds:
        m = re.fullmatch(r\"put w (0x[0-9a-f]+), (0x[0-9a-f]+)\",cmd)
        if m:
            code[int(m[1],16)] = int(m[2],16)
            continue
        m = re.fullmatch(r\"([a-z][a-z0-9]*)=(0x[0-9a-f]+)\",cmd)
        if m:
            if m[1] == \"pc\": pc = int(m[2],16)
            else: regs[m[1]] = int(m[2],16)
            continue
        if cmd.startswith(\"step \"):
            for i in range(int(cmd.split()[1])):
                op = code[pc+4*i]
                rs, rt = (op >> 21)&31, (op >> 16)&31
                names = {1:\"at\",2:\"v0\",5:\"a1\",6:\"a2\",7:\"a3\",8:\"t0\",9:\"t1\"}
                addr = regs.get(names.get(rs,\"?\"),0) + (op & 0xffff)
                size = {0x28:1,0x2b:4,0x3f:8}.get(op >> 26)
                if size: write(addr,regs.get(names.get(rt,\"?\"),0),size)
    return cells
for label, source in ((\"current\",current),(\"proposed\",proposed)):
    sessions, ns = collect(source)
    traced = [trace(c) for c in sessions]
    covered = sorted(set(c[:3] for seq in traced for c in seq))
    missing = [(b,d,w) for b in (0,1,2,4) for d in (1,2,4,8) for w in (0,1) if (b,d,w) not in covered]
    print(json.dumps({\"version\":label,\"sessions\":len(sessions),\"assertions\":len(ns[\"rows\"]),\"covered\":covered,\"empty\":missing}))
    print(json.dumps({\"session_declines\":traced if label == \"current\" else traced[-12:]}))
    if label == \"proposed\":
        checks = [
            ns[\"printed_seq\"](\"print v0\\n0xffffffffaabbccdd\\nprint v0\\n0x1122334455667788\\n\",[0x0220,0x03f0]) == [\"0xaabbccdd\",\"0x1122334455667788\"],
            ns[\"printed_seq\"](\"print v0\\n0x11223344\\n\",[0x0220,0x03f0]) == [],
            ns[\"cell_want\"](0x03f0) == \"0x1122334455667788\",
            ns[\"cell_want\"](0x01f0) == \"0x11223344\",
        ]
        assert all(checks)
        print(json.dumps({\"parser_checks\":checks,\"new_session_command_counts\":[len(c) for c in sessions[-12:]]}))

