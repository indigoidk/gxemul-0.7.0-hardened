 982: DEVICE_ACCESS(sgi_de)
 983: {
 984: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
 985: 	uint64_t idata = 0, odata = 0;
 986: 	int regnr;
 987: 	int startFlag = relative_addr & CRIME_DE_START;
 988: 
 989: 	relative_addr &= ~CRIME_DE_START;
 990: 
 991: 	idata = memory_readmax64(cpu, data, len);
 992: 	regnr = relative_addr / sizeof(uint32_t);
 993: 
 994: 	relative_addr += 0x2000;
 995: 
 996: 	/*
 997: 	 *  Treat all registers as read/write, by default.  Sometimes these
 998: 	 *  are accessed as 32-bit words, sometimes as 64-bit words to access
 999: 	 *  two adjacent registers in one operation.
1000: 	 */
1001: 	if (len == 8) {
1002: 		if (writeflag == MEM_WRITE) {
1003: 			d->de_reg[regnr] = idata >> 32ULL;
1004: 			d->de_reg[regnr+1] = idata;
1005: 		} else
1006: 			odata = ((uint64_t)d->de_reg[regnr] << 32ULL) +
1007: 			    d->de_reg[regnr+1];
1008: 	} else if (len == 4) {
1009: 		if (writeflag == MEM_WRITE)
1010: 			d->de_reg[regnr] = idata;
1011: 		else
1012: 			odata = d->de_reg[regnr];
1013: 	} else {
1014: 		/*
1015: 		 *  #498: THIS USED TO END THE HOST PROCESS.  A guest choosing an
1016: 		 *  access width is not an emulator error -- one `sb' anywhere in
1017: 		 *  this 4 KB window did it.  Witnessed at rung 3 on an unmodified
1018: 		 *  -E sgi -e ip32: sb, sh, lbu and lhu each gave exactly one
1019: 		 *  "len = N not implemented" and exit(1), 4/4.
1020: 		 *
1021: 		 *  *** THE SHAPE IS NOT #497's SPLICE, AND THE DIFFERENCE IS
1022: 		 *  MEASURED, NOT STYLISTIC. ***  #497's tail only answered a read.
1023: 		 *  THIS function's tail also calls draw_primitive() when the guest
1024: 		 *  set CRIME_DE_START, so falling through would run a rendering
1025: 		 *  primitive for an access we just refused.
1026: 		 *
1027: 		 *  Clearing startFlag and falling through -- the obvious repair --
1028: 		 *  scores 24/25: the declined access still reaches the switch
1029: 		 *  below, which announces e.g. "TODO: non-zero CRIME_DE_SCISSOR"
1030: 		 *  about a write THAT NEVER HAPPENED, from an idata this arm
1031: 		 *  discarded.  Shipping a wrong record inside a diagnostic is the
1032: 		 *  same class the ACCEPT member of the option set was found
1033: 		 *  through.  The goto form scores 25/25.
1034: 		 *
1035: 		 *  `goto <label>' to a common exit is house idiom, not an
1036: 		 *  invention: 10 device files use goto and 8 of those use it
1037: 		 *  inside a DEVICE_ACCESS body (dc7085, i80321, le, mk48txx,
1038: 		 *  ne2000, pvr, vr41xx, wdc).
1039: 		 *
1040: 		 *  It is not an early `return' either.  Control still reaches the
1041: 		 *  common exit, so a declined READ is answered with odata (0) via
1042: 		 *  memory_writemax64 and the function still returns 1.  `return 0'
1043: 		 *  would be coerced to -1 by cpus/memory_rw.c and raise
1044: 		 *  EXCEPTION_DBE -- turning a refusal into a guest bus error.
1045: 		 */
1046: 		if (!(d->warned & SGIRE_W_DE_LEN)) {
1047: 			d->warned |= SGIRE_W_DE_LEN;
1048: 			fatal("[ sgi_de: unimplemented len=%i -- declined."
1049: 			    "  (once) ]\n", (int) len);
1050: 		}
1051: 		goto de_declined;
1052: 	}
1053: 
1054: 	switch (relative_addr) {
1055: 
1056: 	case CRIME_DE_MODE_SRC:
1057: 		debug("[ sgi_de: %s CRIME_DE_MODE_SRC: 0x%016llx ]\n",
1058: 		    writeflag == MEM_WRITE ? "write to" : "read from",
1059: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1060: 		break;
1061: 
1062: 	case CRIME_DE_MODE_DST:
1063: 		debug("[ sgi_de: %s CRIME_DE_MODE_DST: 0x%016llx ]\n",
1064: 		    writeflag == MEM_WRITE ? "write to" : "read from",
1065: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1066: 		break;
1067: 
1068: 	case CRIME_DE_CLIPMODE:
1069: 		debug("[ sgi_de: %s CRIME_DE_CLIPMODE: 0x%016llx ]\n",
1070: 		    writeflag == MEM_WRITE ? "write to" : "read from",
1071: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1072: 		if (writeflag == MEM_WRITE && idata != 0)
1073: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_CLIPMODE: 0x%016llx ]\n", idata);
1074: 		break;
1075: 
1076: 	case CRIME_DE_DRAWMODE:
1077: 		debug("[ sgi_de: %s CRIME_DE_DRAWMODE: 0x%016llx ]\n",
1078: 		    writeflag == MEM_WRITE ? "write to" : "read from",
1079: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1080: 		break;
1081: 
1082: 	case CRIME_DE_SCRMASK0:
1083: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK0: 0x%016llx ]\n",
1084: 		    writeflag == MEM_WRITE ? "write to" : "read from",
1085: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);

