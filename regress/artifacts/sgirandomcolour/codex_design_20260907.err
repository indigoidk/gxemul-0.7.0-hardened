1695:  */
1696: void dev_sgi_de_status_init(struct memory *mem, uint64_t baseaddr, struct sgi_re_data *d)
1697: {
1698: 	memory_device_register(mem, "sgi_de_status", baseaddr, DEV_SGI_DE_STATUS_LENGTH,
1699: 	    dev_sgi_de_status_access, (void *)d, DM_DEFAULT, NULL);
1700: }
