1490: 			}
1491: 
1492: 			fill_addr += fill_len;
1493: 			dstlen -= (uint32_t)fill_len;	/* OB-23: subtract bytes actually filled */
1494: 		}
1495: 		break;
1496: 	default:
1497: 		fatal("[ sgi_mte: TODO! unimplemented dst_tlb 0x%x ]", dst_tlb);
1498: 	}
