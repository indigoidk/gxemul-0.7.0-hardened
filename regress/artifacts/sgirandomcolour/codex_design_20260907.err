1644: /****************************************************************************/
1645: 
1646: /*
1647:  *  SGI "de_status".
1648:  */
1649: 
1650: DEVICE_ACCESS(sgi_de_status)
1651: {
1652: 	// struct sgi_re_data *d = (struct sgi_re_data *) extra;
1653: 	uint64_t idata = 0, odata = 0;
1654: 
1655: 	idata = memory_readmax64(cpu, data, len);
1656: 
1657: 	relative_addr += 0x4000;
1658: 
1659: 	switch (relative_addr) {
1660: 
1661: 	case CRIME_DE_STATUS:	// 0x4000
1662: 		odata = CRIME_DE_IDLE |
1663: 			CRIME_DE_SETUP_IDLE |
1664: 			CRIME_DE_PIXPIPE_IDLE |
1665: 			CRIME_DE_MTE_IDLE;
1666: 
1667: 		/*
1668: 		 *  TODO: Actually simulate pipeline of a number of commands?
1669: 		 */
1670: 		break;
1671: 
1672: 	case 0x4008:
1673: 		/*  Unknown. Ignore for now.  */
1674: 		break;
1675: 
1676: 	default:
1677: 		if (writeflag == MEM_WRITE)
1678: 			debug("[ sgi_de_status: unimplemented write to "
1679: 			    "address 0x%llx, data=0x%016llx ]\n",
1680: 			    (long long)relative_addr, (long long)idata);
1681: 		else
1682: 			debug("[ sgi_de_status: unimplemented read from address"
1683: 			    " 0x%llx ]\n", (long long)relative_addr);
1684: 	}
1685: 
1686: 	if (writeflag == MEM_READ)
1687: 		memory_writemax64(cpu, data, len, odata);
1688: 
1689: 	return 1;
1690: }
1691: 
