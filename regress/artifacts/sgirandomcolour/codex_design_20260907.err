 299: #define CRIME_DE_XFER_STRD_SRC	0x20a4
 300: #define CRIME_DE_XFER_STEP_X	0x20a8
 301: #define CRIME_DE_XFER_STEP_Y	0x20ac
 302: #define CRIME_DE_XFER_ADDR_DST	0x20b0
 303: #define CRIME_DE_XFER_STRD_DST	0x20b4
