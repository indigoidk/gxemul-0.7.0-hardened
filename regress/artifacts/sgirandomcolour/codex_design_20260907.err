 285: #define CRIME_DE_SCISSOR	0x2048
 286: #define CRIME_DE_WINOFFSET_SRC	0x2050	/* x in upper, y in lower 16 bit */
 287: #define CRIME_DE_WINOFFSET_DST	0x2058
 288: #define CRIME_DE_PRIMITIVE	0x2060
