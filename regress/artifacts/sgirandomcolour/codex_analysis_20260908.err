		device_add(machine, "random addr=0x418000200, len=0x20000");

		break;

	case 22:
	case 24:
		if (machine->machine_subtype == 22) {
			strlcat(machineName,
			    " (Indy, Indigo2, Challenge S; Full-house)",
			    MACHINE_NAME_MAXBUF);
fatal("TODO: SGI legacy interrupt system rewrite!\n");
abort();
//			machine->md_int.sgi_ip22_data =
