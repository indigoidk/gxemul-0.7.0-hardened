154:## THE DETECTOR ROWS APPENDED TO regress/sgi_re_colourdefault_probe.py (verbatim; the five witness rows above them are unchanged)
155:```python
156:# ================================================================ #519 DETECTOR ROWS
157:#  The five rows above are the WITNESS (2/5 on HEAD 1ce8296 -- both unsupported-type PUTs landed host
158:#  PRNG bytes -- and 5/5 on the fix with the same script).  The rows below DEFEND the fix.
159:#
160:#  CONTRACT (clause (e)).  Designed to catch: (b) the verbatim arm reinstated (random fills + an
161:#  unlatched fatal, the store still taken -- `ycrcb put', `reserved put', `announce text'); (d) the
162:#  `ok' guard REMOVED (the store taken with an unassigned buf -- `ycrcb put'); the decline turned
163:#  into a ZERO FILL and a store (`ycrcb put' reads 0); `ok = 0' MOVED INSIDE THE LATCH so only the
164:#  first declined PUT skips its store (`two declined'); the latch REMOVED (`once' reads 2); the latch
165:#  SHARED with SGIRE_W_BADMODE (`latch indep' reads 0 after a bad TLB mode fired that bit); the
166:#  announce SILENCED (`announce text' reads 0); a supported type dropped from the switch (its accept
167:#  row); the accept side announcing (`live silent').  NOT rowed, disclosed: the GET default arm (a
168:#  separate row, sgirebufuninit); 16-bit depth (the PUT arms assign four bytes and a 16-bit store
169:#  takes two -- the same row's question); `x`/`y` in the announce (format only); per-instance latching
170:#  (one RE instance exists); the YCRCB/reserved values other than 0xf0/0x50 (twelve nibbles reach the
171:#  arm; two are driven, and the arm does not read the nibble's value).
172:#
173:#  The destination word is read big-endian (ip32): byte 0 of the tile is the word's top byte.
174:
175:ANN = "unimplemented colour type in horrible_getputpixel"     # the post-fix announce, distinctive part
176:DECL = "store declined (once)"
177:MODE_CI8  = 0x1000            # LIN_A | BUFDEPTH_8  | TYPE_CI   -- one byte stored
178:MODE_RGB  = 0x1210            # LIN_A | BUFDEPTH_32 | TYPE_RGB
179:MODE_ABGR = 0x1230            # LIN_A | BUFDEPTH_32 | TYPE_ABGR
180:MODE_LINB_RGBA = 0x1620       # LIN_B | BUFDEPTH_32 | TYPE_RGBA -- the TLB/mode switch's own default (BADMODE)
181:
182:#  ---- accept rows: the other three supported types land their packing (de-escalation) -----------
183:A = Addr(CODE)
184:t_ci, alive_ci = session(setup_put(A, MODE_CI8) + load(A, DST_KSEG1) + ["print v0"])
185:row("ci8 put", printed(t_ci, "v0") if alive_ci else "died", "0xdd223344",
186:    "CI at 8 bpp stores ONE byte (fg & 0xff) over the paint's top byte")
187:A = Addr(CODE)
188:t_rgb, alive_rgb = session(setup_put(A, MODE_RGB) + load(A, DST_KSEG1) + ["print v0"])
189:row("rgb put", printed(t_rgb, "v0") if alive_rgb else "died", "0xaabbcc00",
190:    "RGB stores [R,G,B,pad]: three channels and a zero pad (#505's authoritative arm)")
191:A = Addr(CODE)
192:t_abgr, alive_abgr = session(setup_put(A, MODE_ABGR) + load(A, DST_KSEG1) + ["print v0"])
193:row("abgr put", printed(t_abgr, "v0") if alive_abgr else "died", "0xddccbbaa",
194:    "ABGR stores the register word byte-reversed")
195:row("live silent", t_live.count(ANN) if alive_live else "died", 0,
196:    "the RGBA accept session carries NO colour-type announce (the accept side stays silent)")
197:
198:#  ---- the announce: present once, with the post-fix text, in the witness's ycrcb session --------
199:row("announce text", t_ycrcb1.count(DECL) if alive_ycrcb1 else "died", 1,
200:    "the declined PUT announces with the post-fix text ONCE (a reinstated arm or a silenced decline reads 0)")
201:
202:#  ---- two declined PUTs in ONE process: the second also skips its store, and one announce -------
203:A = Addr(CODE)
204:t_two, alive_two = session(setup_put(A, MODE_YCRCB) + setup_put(A, MODE_RESERVED)
205:                           + load(A, DST_KSEG1) + ["print v0"])
206:row("two declined", printed(t_two, "v0") if alive_two else "died", "0x%08x" % DST_PAINT,
207:    "YCRCB then RESERVED in one process: the SECOND declined PUT leaves the paint too (`ok = 0' inside the latch would store)")
208:row("once", t_two.count(ANN) if alive_two else "died", 1,
209:    "two declined PUTs announce EXACTLY ONCE -- the (once) latch")
210:
211:#  ---- the latch bit is its own: a BADMODE decline first, then a colour decline still announces --
212:A = Addr(CODE)
213:t_ind, alive_ind = session(setup_put(A, MODE_LINB_RGBA) + setup_put(A, MODE_YCRCB)
214:                           + load(A, DST_KSEG1) + ["print v0"])
215:row("latch indep", t_ind.count(ANN) if alive_ind else "died", 1,
216:    "LIN_B fires SGIRE_W_BADMODE first; the colour decline still announces once (a shared bit reads 0)")
217:row("indep paint", printed(t_ind, "v0") if alive_ind else "died", "0x%08x" % DST_PAINT,
218:    "and neither declined PUT stored (LIN_B returns before the store; YCRCB skips it)")
219:
220:```
