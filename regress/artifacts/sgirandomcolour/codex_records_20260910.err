172: struct sgi_re_data {
173: 	// Rendering engine registers:
174: 	uint16_t	re_tlb_a[256];
175: 	uint16_t	re_tlb_b[256];
176: 	uint16_t	re_tlb_c[256];
177: 	uint16_t	re_tex[112];
178: 	// todo: clip_ids registers.
179: 	uint32_t	re_linear_a[32];
180: 	uint32_t	re_linear_b[32];
181: 
182: 	// Drawing engine registers:
183: 	uint32_t	de_reg[DEV_SGI_DE_LENGTH / sizeof(uint32_t)];
184: 
185: 	// Memory transfer engine registers:
186: 	uint32_t	mte_reg[DEV_SGI_MTE_LENGTH / sizeof(uint32_t)];
187: 
188: 	/*
189: 	 *  #497: width-guard decline latches; see the enum above.
190: 	 *
191: 	 *  PLACED LAST, DELIBERATELY, AND THE ORDER IS LOAD-BEARING.
192: 	 *  re_linear_a/b are written at [tlbi] AND [tlbi+1] with tlbi able to
193: 	 *  reach 31, so index 32 of either array lands on whichever field
194: 	 *  FOLLOWS it.  An earlier draft of this change put `warned' between
195: 	 *  re_linear_b and de_reg; measured with offsetof, that made
196: 	 *  re_linear_b[32] alias `warned' rather than de_reg[0] -- which both
197: 	 *  falsified the adjacency the two LINEAR site comments cite, and made
198: 	 *  an over-run SET WARNING LATCH BITS and silence this device's own
199: 	 *  diagnostics.  Keeping the latch after mte_reg restores the
200: 	 *  documented adjacency: re_linear_a[32] is re_linear_b[0] and
201: 	 *  re_linear_b[32] is de_reg[0].
202: 	 */
203: 	uint32_t	warned;
204: };
205: 
206: 
207: /*
208:  *  horrible_getputpixel():
209:  *
210:  *  This routine gets/puts a pixel in one of the tiles, from the perspective of
211:  *  the rendering/drawing engine. Given x and y, it figures out which tile
212:  *  number it is, and then finally does a slow read/write to get/put the pixel
213:  *  at the correct sub-coordinates within the tile.
214:  *
215:  *  Tiles are always 512 _bytes_ wide, and 128 pixels high. For 32-bit color
216:  *  modes, for example, that means 128 x 128 pixels.
217:  *
218:  *  For "linear" modes, y is ignored and x is an offset to select which linear
219:  *  TLB entry to use.
220:  */
221: void horrible_getputpixel(int put, struct cpu* cpu, struct sgi_re_data* d,
222: 	int x, int y, uint32_t* color, int mode)
223: {
224: 	uint32_t color_mode = mode & DE_MODE_TYPE_MASK;
225: 	int bufdepth = 1 << ((mode >> 8) & 3); 
226: 
227: 	// dst_mode (see NetBSD's crmfbreg.h):
228: 	// #define DE_MODE_TLB_A           0x00000000
229: 	// #define DE_MODE_TLB_B           0x00000400
230: 	// #define DE_MODE_TLB_C           0x00000800
231: 	// #define DE_MODE_LIN_A           0x00001000
232: 	// #define DE_MODE_LIN_B           0x00001400
233: 	uint32_t tlb_mode = (mode >> 10) & 0x7;
234: 	int linear = tlb_mode > 3;
235: 
236: 	if (!linear && (x < 0 || y < 0 || x >= 2048 || y >= 2048))
237: 		return;
238: 
239: 	int tilewidth_in_pixels = 512 / bufdepth;
240: 	
241: 	int tile_nr_x = x / tilewidth_in_pixels;
242: 	int tile_nr_y = y >> 7;
243: 
244: 	unsigned int tile_nr = tile_nr_y * 16 + tile_nr_x;
245: 
246: 	y &= 127;
247: 	int xofs = (x % tilewidth_in_pixels) * bufdepth;
248: 	int ofs = 512 * y + xofs;
249: 
250: 	uint32_t tileptr = 0;
251: 
252: 	/*  #100: cases 0-2 index re_tlb_[abc][256] with a guest-derived
253: 	    tile_nr = (y>>7)*16 + x/tilewidth; bound it (case 4 self-checks).  */
254: 	if (tlb_mode <= 2 && tile_nr >= 256)
255: 		return;
256: 
257: 	switch (tlb_mode) {
258: 	case 0:	tileptr = d->re_tlb_a[tile_nr] << 16;
259: 		break;
260: 	case 1:	tileptr = d->re_tlb_b[tile_nr] << 16;
261: 		break;
262: 	case 2:	tileptr = d->re_tlb_c[tile_nr] << 16;
263: 		break;
264: 	case 4:	tile_nr = x >> 12;
265: 		if (tile_nr >= 32)
266: 			return;
267: 		tileptr = 0x80000000 | (d->re_linear_a[tile_nr] << 12);
268: 		ofs = x & 4095;
269: 		// TODO... probably not correct!
270: 		// printf("tileptr = %08x x = %i y = %i tile_nr = %i ofs = %i\n", tileptr, x, y, tile_nr, ofs);
271: 		break;
272: 	default:/*  sgirandompixel: this arm used to assign `*color = random()' -- with
273: 		    its exit(1) commented out -- so a failed GET handed the CALLER a
274: 		    random value, and draw_primitive() then wrote it to the destination
275: 		    in the same loop iteration, since `color' is shared by the XFER GET
276: 		    and the PUT.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes
277: 		    crmfbreg.h documents and extracts to tlb_mode 5, so this was
278: 		    reachable with a DOCUMENTED mode, not only with a junk one.
279: 		    MEASURED, rung 3: the destination received 0x4b1763a1, 0x2ee4b4df
280: 		    and 0x7433cdc1 on successive runs of
281: 		    regress/sgi_re_randompixel_probe.py.
282: 
283: 		    NOW DECLINED: `*color' is left alone, so the caller's own
284: 		    `uint32_t color = fg' stands and what lands is at least
285: 		    DETERMINISTIC.  The announce is latched because this helper is
286: 		    per-pixel.
287: 
288: 		    WHAT THIS DOES NOT DO, filed rather than silently omitted: the
289: 		    caller STILL PERFORMS its dependent PUT, so a declined GET still
290: 		    writes fg (row sgirandomskipput -- suppressing it needs a return
291: 		    value and every GET site changed, which is more than one site);
292: 		    LIN_B is still not implemented, and the panel refused to endorse
293: 		    implementing it as LIN_A-with-the-other-array on symmetry alone
294: 		    (row sgirelinb); and the COLOUR-mode switch below carries the same
295: 		    random() shape at its own default (row sgirandomcolour).  */
296: 		if (!(d->warned & SGIRE_W_BADMODE)) {
297: 			d->warned |= SGIRE_W_BADMODE;
298: 			/*  `dst_mode' is kept from the original text although the
299: 			    parameter is also passed as src_mode on a GET: the probe
300: 			    anchors on this literal, and rewording it here would be
301: 			    scope creep AND would move an oracle anchor mid-round,
302: 			    which is the laundering shape whatever the intent.
303: 			    Filed as sgirenamedstmode.  */
304: 			fatal("[ sgi_re: unimplemented dst_mode %i for "
305: 			    "horrible_getputpixel (%s), x=%i y=%i; declined "
306: 			    "(once) ]\n", mode, put ? "put" : "get", x, y);
307: 		}
308: 		return;
309: 	}
310: 
311: 	// The highest bit seems to be set for a "valid" tile pointer.
312: 	if (!(tileptr & 0x80000000)) {
313: 		//printf("dst_mode %i, tile_nr = %i,  tileptr = 0x%llx\n", dst_mode, tile_nr, (long long)tileptr);
314: 		//fatal("sgi gbe horrible_getputpixel: unexpected non-set high bit of tileptr?\n");
315: 		//exit(1);
316: 		return;
317: 	}
318: 	
319: 	tileptr &= ~0x80000000;
320: 
321: 	uint8_t buf[8];		/* #100: bufdepth can be 8 = 1<<((mode>>8)&3) */
322: 	if (put) {
323: 		int ok = 1;	/*  #519: cleared by the default arm below  */
324: 		switch (color_mode) {
325: 		case DE_MODE_TYPE_CI:
326: 			buf[0] = *color;
327: 			break;
328: 		case DE_MODE_TYPE_RGB:
329: 			buf[0] = *color >> 24;
330: 			buf[1] = *color >> 16;
331: 			buf[2] = *color >> 8;
332: 			buf[3] = 0;
333: 			break;
334: 		case DE_MODE_TYPE_RGBA:
335: 			buf[0] = *color >> 24;
336: 			buf[1] = *color >> 16;
337: 			buf[2] = *color >> 8;
338: 			buf[3] = *color;
339: 			break;
340: 		case DE_MODE_TYPE_ABGR:
341: 			buf[0] = *color;
342: 			buf[1] = *color >> 8;
343: 			buf[2] = *color >> 16;
344: 			buf[3] = *color >> 24;
345: 			break;
346: 		default:/*  #519 (sgirandomcolour): this arm was `buf[0..3] = random()'
347: 			    and an UNLATCHED per-pixel fatal(), after which the common
348: 			    store below wrote four HOST-PRNG bytes into guest memory.
349: 			    Twelve of the sixteen type nibbles reach here, the documented
350: 			    DE_MODE_TYPE_YCRCB among them.  MEASURED at rung 3
351: 			    (regress/sgi_re_colourdefault_probe.py): a destination
352: 			    pre-painted 0x11223344 read 0x56e8857a and 0x38abc4e1 on two
353: 			    runs -- neither the paint nor any packing of the colour, and
354: 			    different each run because main.c seeds random() per process.
355: 
356: 			    NOW DECLINED, member 3: the STORE IS SKIPPED, so the
357: 			    destination keeps what the guest had -- not a zero fill, which
358: 			    would publish a colour the guest never asked for (random() with
359: 			    the entropy stripped) -- and the announce is latched on its own
360: 			    bit because this helper is per-pixel.  The old literal is kept
361: 			    as the prefix: the witness attributes on it.  A declined PUT
362: 			    never reads buf, so the width question (sgirebufuninit) is a
363: 			    separate row, and the GET default below is untouched.  */
364: 			ok = 0;
365: 			if (!(d->warned & SGIRE_W_BADCOLOR)) {
366: 				d->warned |= SGIRE_W_BADCOLOR;
367: 				fatal("[ put: color mode = 0x%x ] [ sgi_re: unimplemented "
368: 				    "colour type in horrible_getputpixel, x=%i y=%i; store "
369: 				    "declined (once) ]\n", color_mode, x, y);
370: 			}
371: 		}
372: 
373: 		if (ok)	/*  #519: a declined type stores nothing  */
374: 			cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
375: 			    buf, bufdepth, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
376: 	} else {
377: 		cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
378: 		    buf, bufdepth, MEM_READ, NO_EXCEPTIONS | PHYSICAL);
379: 
380: 		switch (color_mode) {
381: 		case DE_MODE_TYPE_CI:
382: 			*color = buf[0];
383: 			break;
384: 		case DE_MODE_TYPE_RGB:
385: 			/*  #505: this read buf[1..3] while the PUT arm above
386: 			    writes the three channels at buf[0..2] and an
387: 			    explicit pad at buf[3] -- so an RGB pixel did not
388: 			    survive its own round trip, shifting one byte left
389: 			    with a zero fill on every RGB source read.
390: 
391: 			    The PUT arm is the authoritative one, and the
392: 			    warrant is OUTSIDE this function: dev_sgi_gbe.c's
393: 			    scanout reads the same tile memory back for display
394: 			    as (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3],
395: 			    then CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
396: 			    31..24, 23..16 and 15..8 -- byte 0 is R and byte 3
397: 			    is UNUSED.  So the pad sits at buf[3] because the
398: 			    consumer ignores buf[3], not because PUT writes a
399: 			    zero there; that is what makes this non-circular.
400: 			    The RGBA and ABGR PUT arms independently agree --
401: 			    both lay [R,G,B,x] in memory despite opposite
402: 			    register word orders -- which leaves this GET the
403: 			    lone container outlier among the 32-bit arms.
404: 
405: 			    The low byte stays ZERO on purpose: RGB carries
406: 			    three channels, so a corrected read of 0xaabbccdd
407: 			    yields 0xaabbcc00, NOT the source word.  */
408: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
409: 			break;
410: 		case DE_MODE_TYPE_RGBA:
411: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
412: 			break;
413: 		case DE_MODE_TYPE_ABGR:
414: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
415: 			break;
416: 		default:// Read "raw" 32-bit value:
417: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
418: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
419: 		}
420: 	}
421: }

