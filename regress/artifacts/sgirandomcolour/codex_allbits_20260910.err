 712: 			 *  #513: ACCEPT -- the inverse of the fixed-arity write
 713: 			 *  directly above.  See CRIME_RE_TLB_A for the odata note.
 714: 			 *
 715: 			 *  The [tlbi+1] here has the SAME exposure as the write's
 716: 			 *  [tlbi+1] and no more, which is `sgilinearoob'.
 717: 			 *
 718: 			 *  *** AN EARLIER WORDING OF THIS SENTENCE SAID THE TWO ARE
 719: 			 *  "bounded only by the len == 8 guard keeping tlbi even".
 720: 			 *  THAT IS FALSE: WIDTH DOES NOT IMPLY ALIGNMENT.  The guard
 721: 			 *  tests LENGTH.  What keeps tlbi even is the CPU-side
 722: 			 *  alignment described at the write arm above -- ld/sd raise
 723: 			 *  ADES/ADEL before memory_rw, and the unaligned helper masks
 724: 			 *  the address itself.  Corrected on this round's pass 2;
 725: 			 *  the older surrounding comment had it right and my new one
 726: 			 *  did not. ***  This fix
 727: 			 *  deliberately does NOT add a clamp -- an unlicensed addition
 728: 			 *  here would change the index behaviour that sgilinearoob is
 729: 			 *  filed to fix across all five arms with ONE design.
 730: 			 */
 731: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
 732: 			odata = ((uint64_t) d->re_linear_a[tlbi] << 32)
 733: 			    | d->re_linear_a[tlbi+1];
 734: 		}
 735: 	} else if (relative_addr >= CRIME_RE_LINEAR_B && relative_addr < CRIME_RE_LINEAR_B + 0x80) {
 736: 		if (len != 8) {
 737: 			/*
 738: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
 739: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
 740: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
 741: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
 742: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
 743: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
 744: 			 *  alignment is supplied by two independent mechanisms, and both
 745: 			 *  were checked rather than assumed:
 746: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
 747: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
 748: 			 *      (cpus/cpu_mips_instr_loadstore.c);
 749: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
 750: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
 751: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
 752: 			 *      three of its memory_rw calls, so it cannot deliver an
 753: 			 *      unaligned len == 8 either.
 754: 			 *  Narrower accesses carry len != 8 and are declined above, and
 755: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
 756: 			 *  so no other CPU family reaches this handler.
 757: 			 *
 758: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
 759: 			 *  `put d' prints "WARNING: address isn't aligned" and then
 760: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
 761: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
 762: 			 *  the invariant above is stated for GUEST paths only.  It also
 763: 			 *  means `put d' must NOT be used to "witness" the over-run:
 764: 			 *  it bypasses the guest instruction path, so a reproduction
 765: 			 *  built on it would be laundering rather than witnessing.
 766: 			 *  The over-run itself stays filed as sgilinearoob, and it is
 767: 			 *  NOT guest-reachable while this guard stands.
 768: 			 *
 769: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
 770: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
 771: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
 772: 			 *  behaviour and a SILENT clobber of the adjacent register array,
 773: 			 *  reaching a DRAWING-engine register from a rendering-engine
 774: 			 *  write -- not a wild write outside the allocation, and not
 775: 			 *  something plain ASAN would flag.  Declining keeps it shut.
 776: 			 */
 777: 			if (!(d->warned & SGIRE_W_LINB_LEN)) {
 778: 				d->warned |= SGIRE_W_LINB_LEN;
 779: 				fatal("[ sgi_re: unimplemented len=%i for "
 780: 				    "CRIME_RE_LINEAR_B -- declined.  (once) ]\n",
 781: 				    (int) len);
 782: 			}
 783: 		} else if (writeflag == MEM_WRITE) {
 784: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
 785: 			d->re_linear_b[tlbi] = idata >> 32ULL;
 786: 			d->re_linear_b[tlbi+1] = idata;
 787: 			debug("[ d->re_linear_b[%i] = 0x%08x, [%i] = 0x%08x ]\n",
 788: 				tlbi, d->re_linear_b[tlbi], tlbi+1, d->re_linear_b[tlbi+1]);
 789: 		} else {
 790: 			/*
 791: 			 *  #513: ACCEPT -- the inverse of the fixed-arity write
 792: 			 *  directly above.  See CRIME_RE_TLB_A for the odata note.
 793: 			 *
 794: 			 *  The [tlbi+1] here has the SAME exposure as the write's
 795: 			 *  [tlbi+1] and no more, which is `sgilinearoob'.
 796: 			 *
 797: 			 *  *** AN EARLIER WORDING OF THIS SENTENCE SAID THE TWO ARE
 798: 			 *  "bounded only by the len == 8 guard keeping tlbi even".
 799: 			 *  THAT IS FALSE: WIDTH DOES NOT IMPLY ALIGNMENT.  The guard
 800: 			 *  tests LENGTH.  What keeps tlbi even is the CPU-side
 801: 			 *  alignment described at the write arm above -- ld/sd raise
 802: 			 *  ADES/ADEL before memory_rw, and the unaligned helper masks
 803: 			 *  the address itself.  Corrected on this round's pass 2;
 804: 			 *  the older surrounding comment had it right and my new one
 805: 			 *  did not. ***  This fix
 806: 			 *  deliberately does NOT add a clamp -- an unlicensed addition
 807: 			 *  here would change the index behaviour that sgilinearoob is
 808: 			 *  filed to fix across all five arms with ONE design.
 809: 			 */
 810: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
