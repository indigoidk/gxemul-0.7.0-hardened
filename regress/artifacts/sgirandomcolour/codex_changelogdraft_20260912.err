252: 	/*  #100: cases 0-2 index re_tlb_[abc][256] with a guest-derived
253: 	    tile_nr = (y>>7)*16 + x/tilewidth; bound it (case 4 self-checks).  */
254: 	if (tlb_mode <= 2 && tile_nr >= 256)
255: 		return;
