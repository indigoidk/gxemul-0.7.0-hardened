  118:         os.write(fd, b"quit\n"); rd(0.4)
  119:     except OSError:
  120:         pass
  121:     try:
  122:         os.close(fd)
  123:     except OSError:
  124:         pass
  125:     return buf.replace("\r", ""), alive
  126: 
  127: def printed(t, reg):
  128:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  129:     return "absent" if not m else "0x%08x" % (int(m.group(1), 16) & 0xffffffff)
  130: 
  131: class Addr(object):
  132:     def __init__(self, base): self.a = base
  133:     def take(self, n):
  134:         got = self.a; self.a += 4 * (n + 2) + 0x20; return got
  135: 
  136: def run_ops(ops, at):
  137:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
  138:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
  139:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
  140:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
  141: 
  142: def store(A, addr, val, op=OP_SW_T0_A3):
  143:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([op], A.take(1))
  144: 
  145: SENTINEL = 0xdeadbeef
  146: def load(A, addr):
  147:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT], A.take(1))
  148: def loadop(A, addr, op):
  149:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
  150: 
  151: def setup_put(A, dst_mode, fg=FG_VAL, paint=DST_PAINT, vertex=0x00000000):
  152:     """Program the engine, paint destination with sentinel, then fire one pixel PUT.
  153:     vertex packs (x << 16) | y for XVERTEX_0/1 (draw_primitive: `>> 16) & 0x7ff' / `& 0x7ff'); the
  154:     default is (0,0).  Added on pass 2 (grok): every PUT sat at (0,0), so a guard qualified
  155:     `if (ok || x)' kept every row green.  The second-word paint is emitted ONLY for a non-origin
  156:     vertex, so every pre-existing session's command stream is unchanged by this parameter."""
  157:     c  = store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)  # re_linear_a[0] = 0x10 -> phys 0x10000
  158:     c += store(A, DST_KSEG1, paint)
  159:     if vertex:
  160:         c += store(A, DST_KSEG1 + 4, paint)            # the word a (4,y) PUT reaches: linear ofs = x & 4095
  161:     c += store(A, DE_MODE_DST, dst_mode)
  162:     c += store(A, DE_DRAWMODE, DRAWMODE_SOLID)
  163:     c += store(A, DE_FG, fg)
  164:     c += store(A, DE_XVERTEX_0, vertex)
  165:     c += store(A, DE_XVERTEX_1, vertex)
  166:     c += store(A, DE_PRIM_START, PRIM_RECT)
  167:     return c
  168: 
  169: print("sgirandomcolour RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
  170: print("%-16s %-14s %-16s %-52s %s" % ("row", "got", "want", "note", ""))
  171: 
  172: # ---------------------------------------------------------------- row 1: live
  173: A = Addr(CODE)
  174: t_live, alive_live = session(setup_put(A, MODE_RGBA) + load(A, DST_KSEG1) + ["print v0"])
  175: got_live = printed(t_live, "v0") if alive_live else "died"
  176: row("live", got_live, "0x%08x" % FG_VAL,
  177:     "LIVENESS: supported RGBA DE PUT lands known colour in destination")
  178: 
  179: # ---------------------------------------------------------------- row 2: ycrcb put
  180: A = Addr(CODE)
  181: t_ycrcb1, alive_ycrcb1 = session(setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"])
  182: got_ycrcb1 = printed(t_ycrcb1, "v0") if alive_ycrcb1 else "died"
  183: want_sentinel = "0x%08x" % DST_PAINT
  184: row("ycrcb put", got_ycrcb1, want_sentinel,
  185:     "DEFECT: YCRCB (0xf0) PUT must leave sentinel unchanged; on HEAD clobbered")
  186: 
  187: # ---------------------------------------------------------------- row 3: ycrcb attrib
  188: diag_ycrcb = "[ put: color mode = 0xf0 ]" in t_ycrcb1
  189: row("ycrcb attrib", "yes" if diag_ycrcb else "no", "yes",
  190:     "ATTRIBUTION: transcript carries `[ put: color mode = 0xf0 ]`")
  191: 
  192: # ---------------------------------------------------------------- row 4: reserved put
  193: A = Addr(CODE)
  194: t_resv, alive_resv = session(setup_put(A, MODE_RESERVED) + load(A, DST_KSEG1) + ["print v0"])
  195: got_resv = printed(t_resv, "v0") if alive_resv else "died"
  196: row("reserved put", got_resv, want_sentinel,
  197:     "RESERVED: unsupported 0x50 PUT must leave sentinel unchanged; on HEAD clobbered")
  198: 
  199: # ---------------------------------------------------------------- row 5: determinism
  200: A = Addr(CODE)
  201: t_ycrcb2, alive_ycrcb2 = session(setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"])
  202: got_ycrcb2 = printed(t_ycrcb2, "v0") if alive_ycrcb2 else "died"
  203: identical = (got_ycrcb1 == got_ycrcb2 and got_ycrcb1 != "died")
  204: got_det = "identical" if identical else "differ"
  205: row("determinism", got_det, "identical",
  206:     "DETERMINISM: repeat YCRCB put; post-fix identical (sentinel), pre-fix differs across runs")
  207: 
  208: # ================================================================ #519 DETECTOR ROWS
  209: #  The five rows above are the WITNESS (2/5 on HEAD 1ce8296 -- both unsupported-type PUTs landed host
  210: #  PRNG bytes -- and 5/5 on the fix with the same script).  The rows below DEFEND the fix.
  211: #
  212: #  CONTRACT (clause (e)).  Designed to catch: (b) the verbatim arm reinstated (random fills + an
  213: #  unlatched fatal, the store still taken -- `ycrcb put', `reserved put', `announce text'); (d) the
  214: #  `ok' guard REMOVED (the store taken with an unassigned buf -- `ycrcb put'); the decline turned
  215: #  into a ZERO FILL and a store (`ycrcb put' reads 0); `ok = 0' MOVED INSIDE THE LATCH so only the
  216: #  first declined PUT skips its store (`two declined'); the latch REMOVED (`once' reads 2); the latch
  217: #  SHARED with SGIRE_W_BADMODE (`latch indep' reads 0 after a bad TLB mode fired that bit); the
  218: #  announce SILENCED (`announce text' reads 0); a supported type dropped from the switch (its accept
  219: #  row); the accept side announcing (`live silent').  NOT rowed, disclosed: the GET default arm (a
  220: #  separate row, sgirebufuninit); 16-bit depth (the three 32-bit-type PUT arms assign four bytes, CI
  221: #  one, and a 16-bit store takes two -- the same row's question); `x`/`y` in the announce (the (4,1)
  222: #  row pins them once; other vertices are format only); per-instance latching
  223: #  (one RE instance exists); the YCRCB/reserved values other than 0xf0/0x50 (twelve nibbles reach the
  224: #  arm; two are driven, and the arm's DECISION does not depend on the nibble's value -- the announce
  225: #  prints it, which is the only read); the latch's independence is ROWED against ALL TWELVE other bits in
  226: #  ONE session (`allbits announce', with `allbits primed' proving every priming announce fired -- the
  227: #  class closure sgi_re_width_probe.py's `tex xbit' row established; a first cut of this contract
  228: #  DISCLOSED the eleven non-BADMODE bits as unrowed on a cost premise codex refuted: the cost is one
  229: #  session, not one per bit); a bit added to the enum AFTER this probe cannot be primed here and is the
  230: #  enum's own last-enumerator convention's business;
  231: #  and `two declined' does NOT distinguish the skipped store from an early `return' -- after the PUT
  232: #  switch the guarded store is the only statement, so the two are observationally identical (grok,
  233: #  minimax); the guard form is a readability choice, not an observable one.
  234: #
  235: #
  236: #  CONTRACT, EXTENDED BY THE PASS-3 CLOSURE (the rows above this point are unchanged).  The two
  237: #  clause-(d) mutants `M13_widthdecline' and `M14_lineardecline' were MEASURED TOTAL ESCAPES of the
  238: #  19-row instrument, so the (d) enumeration was reopened over the two lvalues the guarded store
  239: #  actually reads.  NOW CAUGHT, and caught over a DOMAIN rather than a mutant list: all sixteen
  240: #  cells of {tlb_mode in TLB_A, TLB_B, TLB_C, LIN_A} x {bufdepth in 1, 2, 4, 8} are driven with an
  241: #  unsupported colour type and a readback, so no predicate over tlb_mode and bufdepth alone can be
  242: #  false at every declined cell.  Also caught: a decode that sends one window's PUT to another
  243: #  window's array (the three tiles are distinct, and each window has its own four accept cells);
  244: #  a latch or an announce conditioned on the addressing mode (each window has its own silent /
  245: #  first-announce / cumulative-one triple).
  246: #  *** DISCLOSURES (i), (ii) AND (iii) BELOW WERE MEASURED TO BE FLOOR BREACHES, NOT DEBT, AND
  247: #  ARE NOW CLOSED BY THE PASS-4 BLOCK AT THE END OF THIS FILE.  The text is kept because it is
  248: #  the record being corrected, and because its REASON was wrong in a way worth not repeating. ***
  249: #
  250: #  (i) said `color_mode' "does not flow into any lvalue the guarded body reads".  THAT IS FALSE:
  251: #  color_mode selects among four arms every one of which writes `buf', and `buf' is the store's
  252: #  DATA operand.  The correct reason M28 was survivable is different and narrower -- the body's
  253: #  own tests partition color_mode into five LABELS and all five were driven, so M28 sliced WITHIN
  254: #  a label.  The wrong reason mattered: applied consistently it also excluded `tile_nr', which
  255: #  flows into `tileptr' -- the ADDRESS operand -- at least as directly as tlb_mode does.
  256: #  (ii) and (iii) were disclosed honestly but classified as debt.  Pass 2 measured SIX mutants at
  257: #  59/59 on this instrument, each writing uninitialised host stack into guest memory:
  258: #  M30/M31/M32 (tile index), M33 (tiled y), M28 (nibble), M37 (foreground value).  The smallest
  259: #  was ELEVEN CHARACTERS -- `if (ok)' -> `if (ok || tile_nr)'.  See
  260: #  regress/artifacts/sgirandomcolour/pass2_20260911/.
  261: #
  262: #  NOW CLOSED, over the COMPLETE free input set of the guarded store rather than a mutant list:
  263: #  { bufdepth, tlb_mode } by the sixteen cells above; { color_mode, *color } by the ten-nibble
  264: #  session at a second foreground colour; { x, y } -- and with them every derived coordinate,
  265: #  since tile_nr, tile_nr_x, tile_nr_y, xofs and ofs are pure functions of them -- by the four
  266: #  coordinate cells.  The bound that makes this finite is stated at the pass-4 block.
  267: #  STILL DISCLOSED:  (a) a predicate ENUMERATING the driven cell set by value, which no finite
  268: #  row set excludes;  (b) coordinate cells are driven at one bufdepth and one label, so a
  269: #  coordinate-joined-to-width or -label mutant is debt;  (c) within-class slices (a particular
  270: #  tile_nr, a third fg);  (iv) what a permitted store WRITES is uninitialised stack, so a cell's
  271: #  kill depends on those bytes differing from the paint: measured for every cell in
  272: #  killtable3_20260910/PRETABLE.out, never assumed, and re-measured in pass 2 (0x7063....).
  273: #  The destination word is read big-endian (ip32): byte 0 of the tile is the word's top byte.
  274: 
  275: ANN = "unimplemented colour type in horrible_getputpixel"     # the post-fix announce, distinctive part
  276: DECL = "store declined (once)"
  277: MODE_CI8  = 0x1000            # LIN_A | BUFDEPTH_8  | TYPE_CI   -- one byte stored
  278: MODE_RGB  = 0x1210            # LIN_A | BUFDEPTH_32 | TYPE_RGB
  279: MODE_ABGR = 0x1230            # LIN_A | BUFDEPTH_32 | TYPE_ABGR
  280: MODE_LINB_RGBA = 0x1620       # LIN_B | BUFDEPTH_32 | TYPE_RGBA -- the TLB/mode switch's own default (BADMODE)
  281: 
  282: #  ---- accept rows: the other three supported types land their packing (de-escalation) -----------
  283: A = Addr(CODE)
  284: t_ci, alive_ci = session(setup_put(A, MODE_CI8) + load(A, DST_KSEG1) + ["print v0"])
  285: row("ci8 put", printed(t_ci, "v0") if alive_ci else "died", "0xdd223344",
  286:     "CI at 8 bpp stores ONE byte (fg & 0xff) over the paint's top byte")
  287: A = Addr(CODE)
  288: t_rgb, alive_rgb = session(setup_put(A, MODE_RGB) + load(A, DST_KSEG1) + ["print v0"])
  289: row("rgb put", printed(t_rgb, "v0") if alive_rgb else "died", "0xaabbcc00",
  290:     "RGB stores [R,G,B,pad]: three channels and a zero pad (#505's authoritative arm)")
  291: A = Addr(CODE)
  292: t_abgr, alive_abgr = session(setup_put(A, MODE_ABGR) + load(A, DST_KSEG1) + ["print v0"])
  293: row("abgr put", printed(t_abgr, "v0") if alive_abgr else "died", "0xddccbbaa",
  294:     "ABGR stores the register word byte-reversed")
  295: row("live silent", t_live.count(ANN) if alive_live else "died", 0,
  296:     "the RGBA accept session carries NO colour-type announce (the accept side stays silent)")
  297: 
  298: #  ---- the announce: present once, with the post-fix text, in the witness's ycrcb session --------
  299: row("announce text", t_ycrcb1.count(DECL) if alive_ycrcb1 else "died", 1,
  300:     "the declined PUT announces with the post-fix text ONCE (a reinstated arm or a silenced decline reads 0)")
  301: 
  302: #  ---- two declined PUTs in ONE process: the second also skips its store, and one announce -------
  303: A = Addr(CODE)
  304: t_two, alive_two = session(setup_put(A, MODE_YCRCB) + setup_put(A, MODE_RESERVED)
  305:                            + load(A, DST_KSEG1) + ["print v0"])
  306: row("two declined", printed(t_two, "v0") if alive_two else "died", "0x%08x" % DST_PAINT,
  307:     "YCRCB then RESERVED in one process: the SECOND declined PUT leaves the paint too (`ok = 0' inside the latch would store)")
  308: row("once", t_two.count(ANN) if alive_two else "died", 1,
  309:     "two declined PUTs announce EXACTLY ONCE -- the (once) latch")
  310: 
  311: #  ---- a declined PUT away from the origin (pass 2, grok): the guard qualified on the vertex ---------
  312: #  Every other PUT is at (0,0), so `if (ok || x)' (or `|| y') is invisible to them.  In the LINEAR
  313: #  path (tlb_mode 4) horrible_getputpixel computes `ofs = x & 4095' -- a BYTE offset, y ignored -- so
  314: #  this PUT at (4,1) would land whole on the second pre-painted word (ofs 4) if it stored; both
  315: #  coordinates are non-zero so either one-token qualifier lets the store through.  A first cut of
  316: #  this row used (1,0) and claimed `ofs = 1 * bufdepth': wrong for the linear path (byte 1, straddling
  317: #  two words) -- corrected before any table ran on it.
  318: A = Addr(CODE)
  319: VTX41 = (4 << 16) | 1
  320: t_x1, alive_x1 = session(setup_put(A, MODE_YCRCB, vertex=VTX41) + load(A, DST_KSEG1 + 4) + ["print v0"])
  321: row("ycrcb x4y1", printed(t_x1, "v0") if alive_x1 else "died", "0x%08x" % DST_PAINT,
  322:     "a declined PUT at (4,1) leaves the second word (linear ofs = x & 4095): kills `if (ok || x)' and `|| y'")
  323: row("x4y1 announce", t_x1.count("horrible_getputpixel, x=4 y=1") if alive_x1 else "died", 1,
  324:     "and the one announce names that vertex in its own text (x=4 y=1)")
  325: 
  326: #  ---- CLASS CLOSURE on the latch-collision axis: every other bit set FIRST, then the colour decline -----
  327: #  sgi_re_width_probe.py's `tex xbit' row proved this priming sequence fires bits 0-10 (bits 0-5 by a byte
  328: #  store to each RE window; 6 a byte store to the DE window; 7/8 a store to and a load from the straggler
  329: #  offset 0x1800; 9 an unimplemented drawing op; 10 a LIN_B rectangle) and its `tex rd lat1' row that a
  330: #  64-bit read of CRIME_RE_TEX fires bit 11.  With bits 0-11 all set, a BADCOLOR latch that SHARES any of
  331: #  them is already silenced when the YCRCB PUT arrives and `allbits announce' reads 0.  `allbits primed'
  332: #  counts the twelve priming announces so a priming access that silently stops firing reds the row
  333: #  instead of leaving a hole (the width probe's own repair for the same vacuity).  One session; the
  334: #  paint row is the decline control.  Added on the pass-2 repair chain at codex's finding.  LOAD
  335: #  SENSITIVITY (codex, by reading session()): 197 commands at fixed 0.22 s windows and a 4.0 s final
  336: #  spin -- a delayed-but-healthy emulator can leave `print v0' unread and the paint row reads `absent'.
  337: #  That is a loud false RED on the fix, never a false green; re-run alone before believing it.
  338: A = Addr(CODE)
  339: RE_WINDOWS = (0xb5001000, 0xb5001200, 0xb5001400, 0xb5001600, 0xb5001700, 0xb5001780)  # TLB_A..LINEAR_B
  340: DE_BASE   = 0xb5002000            # DEVICE_ACCESS(sgi_de): a byte access fires SGIRE_W_DE_LEN
  341: OUTSIDE   = 0xb5001800            # past LINEAR_B: the straggler arm (UNMAP_WR / UNMAP_RD)
  342: PRIM_BAD  = 0x05020000            # an UNIMPLEMENTED drawing op (only LINE and RECTANGLE exist)
  343: TEX_BASE  = 0xb5001600
  344: prime = []
  345: for _w in RE_WINDOWS:
  346:     prime += store(A, _w, 0x1, op=OP_SB_T0_A3)             # bits 0-5
  347: prime += store(A, DE_BASE, 0x1, op=OP_SB_T0_A3)            # bit 6
  348: prime += store(A, OUTSIDE, 0x1, op=OP_SB_T0_A3)            # bit 7
  349: prime += loadop(A, OUTSIDE, OP_LW_V0_AT)                   # bit 8
  350: prime += setup_put(A, MODE_LINB_RGBA)                      # bit 10 (a real 1x1 rectangle into LIN_B)
  351: prime += store(A, DE_PRIM_START, PRIM_BAD)                 # bit 9
  352: prime += loadop(A, TEX_BASE, OP_LD_V0_AT)                  # bit 11
  353: PRIME_LIT = ["for CRIME_RE_%s -- declined." % _n for _n in ("TLB_A", "TLB_B", "TLB_C", "TEX", "LINEAR_A", "LINEAR_B")] + [
  354:     "[ sgi_de: unimplemented len=",                       # bit 6  DE_LEN
  355:     "unimplemented write to address 0x1800",              # bit 7  UNMAP_WR
  356:     "unimplemented read from address 0x1800",             # bit 8  UNMAP_RD
  357:     "UNIMPLEMENTED drawing op",                           # bit 9  PRIM_OP
  358:     "unimplemented dst_mode",                             # bit 10 BADMODE
  359:     "unimplemented read from CRIME_RE_TEX -- declined."]  # bit 11 TEX_RD
  360: t_all, alive_all = session(prime + setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"], spin=4.0)
  361: fired_all = sum(1 for _lit in PRIME_LIT if _lit in t_all)
  362: row("allbits primed", "%i/%i" % (fired_all, len(PRIME_LIT)) if alive_all else "died", "%i/%i" % (len(PRIME_LIT), len(PRIME_LIT)),
  363:     "all twelve other latches PROVEN fired before the colour decline (the row proves its own setup)")
  364: row("allbits announce", t_all.count(ANN) if alive_all else "died", 1,
  365:     "with every other bit set, the colour decline still announces once: a latch sharing ANY bit reads 0")
  366: row("allbits paint", printed(t_all, "v0") if alive_all else "died", "0x%08x" % DST_PAINT,
  367:     "and the declined PUT stored nothing (control)")
  368: 
  369: #  ---- the latch bit is its own: a BADMODE decline first, then a colour decline still announces --
  370: A = Addr(CODE)
  371: t_ind, alive_ind = session(setup_put(A, MODE_LINB_RGBA) + setup_put(A, MODE_YCRCB)
  372:                            + load(A, DST_KSEG1) + ["print v0"])
  373: row("latch indep", t_ind.count(ANN) if alive_ind else "died", 1,
  374:     "LIN_B fires SGIRE_W_BADMODE first; the colour decline still announces once (a shared bit reads 0)")
  375: row("indep paint", printed(t_ind, "v0") if alive_ind else "died", "0x%08x" % DST_PAINT,
  376:     "the YCRCB PUT after the LIN_B decline stored nothing (the LIN_B half is re-painted over and NOT observed here -- grok)")
  377: 
  378: 
  379: # ================================================================ #519 CLOSURE -- THE TILED WINDOWS
  380: #  WHY THESE SESSIONS EXIST.  `M13_widthdecline' (ok = 0 -> if (bufdepth == 4) ok = 0;) and
  381: #  `M14_lineardecline' (-> if (linear) ok = 0;) were MEASURED TOTAL ESCAPES of the 14-row and the
  382: #  19-row instruments (killtable_20260910/M13_widthdecline.raw, M14l_lineardecline_vs19.raw).  They
  383: #  are UNDER-declining mutants: where the added condition is false the unsupported type is PERMITTED
  384: #  and the store below runs -- and because #519 deleted the random() fill, a permitted store writes
  385: #  UNINITIALISED buf.  They escaped because EVERY declined row above drives MODE_YCRCB 0x12f0 or
  386: #  MODE_RESERVED 0x1250, i.e. BUFDEPTH_32 on LIN_A, so both conditions are TRUE at every declined
  387: #  cell and neither mutant is ever exercised where it differs.
  388: #
  389: #  THE CLOSURE, and it is a CLASS closure rather than a cell repair (two passes had found the same
  390: #  shape twice).  The guarded body is the one statement
  391: #      cpu->memory_rw(cpu, cpu->mem, tileptr + ofs, buf, bufdepth, MEM_WRITE, ...)
  392: #  and it reads exactly two lvalues the mode word controls:
  393: #      tlb_mode = (mode >> 10) & 7        -- selects the switch arm that ASSIGNS tileptr
  394: #      bufdepth = 1 << ((mode >> 8) & 3)  -- the store's own LENGTH, and ofs via tilewidth
  395: #  tlb_mode's reachable-to-the-store partition is {0 TLB_A, 1 TLB_B, 2 TLB_C, 4 LIN_A}: 3 and 5-7
  396: #  take the BADMODE default, which RETURNS before the store, and >= 8 is impossible after `& 0x7'.
  397: #  bufdepth's domain is exactly {1, 2, 4, 8}.  The rows above hold ONE of those sixteen cells,
  398: #  (LIN_A, 4).  These sessions drive the OTHER FIFTEEN, declined.  With all sixteen present in the
  399: #  declined set, NO predicate over tlb_mode and bufdepth alone can be false at every declined cell,
  400: #  whatever its shape -- which is why the closure is stated over the DOMAIN and not over a list of
  401: #  mutant forms.  MEASURED, not reasoned: table 3's M20..M27 are that claim's negative controls.
  402: #
  403: #  THE THREE TILES ARE DISTINCT ON PURPOSE (clause (f)).  re_tlb_a[0]/b[0]/c[0] are 0x8001/0x8002/
  404: #  0x8003, so the destinations are physical 0x10000/0x20000/0x30000.  An accept cell therefore pins
  405: #  WHICH array the mode word selected, not merely that something was written somewhere; a decode
  406: #  that sent TLB_B's PUT to re_tlb_a would leave this window's paint intact and RED its accept cell.
  407: #  Bit 15 of the stored halfword is the tileptr's bit 31 -- the "valid" bit horrible_getputpixel
  408: #  tests -- so 0x8001 is not decoration: 0x0001 returns without writing.
  409: #
  410: #  READ IMMEDIATELY AFTER EACH OPERATION.  Every cell repaints its own destination, fires one 1x1
  411: #  rectangle and loads the word back inside ONE stepped instruction block, so a cell's oracle
  412: #  observes its own operation and nothing else.
  413: RE_TLB_A_W = 0xb5001000       # CRIME_RE_TLB_A: one 8-byte store fills re_tlb_a[0..3], big-endian halfwords
  414: RE_TLB_B_W = 0xb5001200
  415: RE_TLB_C_W = 0xb5001400
  416: TILE_A     = 0x8001           # tileptr = re_tlb_a[0] << 16 = 0x80010000 -> phys 0x10000
  417: TILE_B     = 0x8002           # -> phys 0x20000
  418: TILE_C     = 0x8003           # -> phys 0x30000
  419: KS_A, KS_B, KS_C = 0xa0010000, 0xa0020000, 0xa0030000
  420: MARK1, MARK2 = "0x519519", "0x519520"     # a register echo used ONLY to split the transcript
  421: OP_SW_T1_A2 = 0xacc90000      # sw $t1, 0($a2)  -- opcode 0x2b, rs=$6 (a2), rt=$9 (t1)
  422: 
  423: def tiled_prologue(A):
  424:     """The three TLB windows and the DE state that does not change between operations."""
  425:     c  = store(A, RE_TLB_A_W, TILE_A << 48, op=OP_SD_T0_A3)
  426:     c += store(A, RE_TLB_B_W, TILE_B << 48, op=OP_SD_T0_A3)
  427:     c += store(A, RE_TLB_C_W, TILE_C << 48, op=OP_SD_T0_A3)
  428:     c += store(A, DE_DRAWMODE, DRAWMODE_SOLID)
  429:     c += store(A, DE_FG, FG_VAL)
  430:     c += store(A, DE_XVERTEX_0, 0x00000000)
  431:     c += store(A, DE_XVERTEX_1, 0x00000000)
  432:     return c
  433: 
  434: def cell_op(A, mode, ks):
  435:     """One cell: repaint, then `sw MODE_DST; sw PRIM_START; lw' in ONE stepped block.  The
  436:     primitive fires synchronously inside the second store, so the load that follows it in the
  437:     same block reads the destination after that operation and before anything else."""
  438:     return (["put w 0x%x, 0x%08x" % (ks, DST_PAINT),
  439:              "a3=0x%x" % DE_MODE_DST,   "t0=0x%x" % mode,
  440:              "a2=0x%x" % DE_PRIM_START, "t1=0x%x" % PRIM_RECT,
  441:              "at=0x%x" % ks,            "v0=0x%x" % SENTINEL]
  442:             + run_ops([OP_SW_T0_A3, OP_SW_T1_A2, OP_LW_V0_AT], A.take(3))
  443:             + ["print v0"])
  444: 
  445: def printed_seq(t):
  446:     return ["0x%08x" % (int(v, 16) & 0xffffffff)
  447:             for v in re.findall(r"print\s+v0\s*\n\s*(0x[0-9a-f]+)", t)]
  448: 
  449: #  window tag, destination, four ACCEPT cells (name, mode, expected word), four DECLINED cells
  450: #  (name, mode) spanning the whole bufdepth domain, and the mode repeated once with the latch set.
  451: for _tag, _ks, _acc, _dec, _rpt in (
  452:     ("tA", KS_A, (("ci8", 0x0000, "0xdd223344"), ("rgb",  0x0210, "0xaabbcc00"),
  453:                   ("rgba", 0x0220, "0xaabbccdd"), ("abgr", 0x0230, "0xddccbbaa")),
  454:                  (("d1", 0x00f0), ("d2", 0x01f0), ("d4", 0x02f0), ("d8", 0x03f0)), 0x00f0),
  455:     ("tB", KS_B, (("ci8", 0x0400, "0xdd223344"), ("rgb",  0x0610, "0xaabbcc00"),
  456:                   ("rgba", 0x0620, "0xaabbccdd"), ("abgr", 0x0630, "0xddccbbaa")),
  457:                  (("d1", 0x04f0), ("d2", 0x05f0), ("d4", 0x06f0), ("d8", 0x07f0)), 0x04f0),
  458:     ("tC", KS_C, (("ci8", 0x0800, "0xdd223344"), ("rgb",  0x0a10, "0xaabbcc00"),
  459:                   ("rgba", 0x0a20, "0xaabbccdd"), ("abgr", 0x0a30, "0xddccbbaa")),
  460:                  (("d1", 0x08f0), ("d2", 0x09f0), ("d4", 0x0af0), ("d8", 0x0bf0)), 0x08f0)):
  461:     A = Addr(CODE)
  462:     _cmds = tiled_prologue(A)
  463:     for _n, _m, _w in _acc:
  464:         _cmds += cell_op(A, _m, _ks)
  465:     _cmds += ["t9=%s" % MARK1, "print t9"]
  466:     for _n, _m in _dec:
  467:         _cmds += cell_op(A, _m, _ks)
  468:     _cmds += ["t9=%s" % MARK2, "print t9"]
  469:     _cmds += cell_op(A, _rpt, _ks)
  470:     _t, _alive = session(_cmds, spin=3.0)
  471:     _v = printed_seq(_t) if _alive else []
  472:     def _cell(i):
  473:         return _v[i] if i < len(_v) else "absent"
  474:     for _i, (_n, _m, _w) in enumerate(_acc):
  475:         row("%s %s" % (_tag, _n), _cell(_i) if _alive else "died", _w,
  477:     for _j, (_n, _m) in enumerate(_dec):  509:         "DECLINED 0x%04x: LINEAR, bufdepth %i -- the label the tiled cells cannot reach"  510:         % (_m, 1 << ((_m >> 8) & 3)))
  511: #  #519 pass-3: `lin ann cum' DELETED here for the same measured reason as the three per-window
  512: #  `ann cum' rows above -- kill set a strict subset of `once'/`ann1', no kill of its own.
  513: 
  514: 
  515: # ================================================================ #519 PASS-4 -- THE CLASS CLOSURE
  516: #  WHY THIS BLOCK EXISTS.  Pass 2 measured SIX mutants scoring 59/59 on the instrument as it
  517: #  stood -- zero red rows, six times -- each one writing uninitialised host stack into guest
  518: #  memory (regress/artifacts/sgirandomcolour/pass2_20260911/).  They were three passes of ONE
  519: #  shape: a decline conditioned on an input the rows hold at a SINGLE VALUE.  M13/M14 were that
  520: #  shape on bufdepth and tlb_mode; M28 on color_mode; M30/M31/M32 on the tile index, M33 on y,
  521: #  M37 on the foreground colour.  The rule forbids buying another cell, so this closes the CLASS.
  522: #
  523: #  THE ENUMERATION, from the function's own inputs rather than from a list of mutant forms.
  524: #  The guarded store reads exactly four lvalues -- tileptr, ofs, buf, bufdepth -- and their
  525: #  inputs, walked up only to the enclosing function boundary, are:
  526: #      bufdepth    <- (mode>>8)&3                  domain {1,2,4,8}   CLOSED by the 16 cells
  527: #      tileptr     <- tlb_mode, tile_nr, array     tlb_mode {0,1,2,4} CLOSED by the 16 cells
  528: #      ofs         <- x, y, bufdepth, tlb_mode
  529: #      buf         <- color_mode (arm), *color (value)
  530: #
  531: #  THE BOUND: tile_nr, tile_nr_x, tile_nr_y, xofs and ofs are NOT independent axes.  Each is a
  532: #  pure function of (x, y, bufdepth, tlb_mode).  So "close every derived coordinate" IS "close
  533: #  the pair (x, y)" -- two free variables, not an open-ended demand.
  534: #
  535: #  *** AND THE WORD "COMPLETE" DOES NOT BELONG HERE.  An earlier draft of this block said "the
  536: #  complete free input set is therefore { x, y, *color, color_mode-within-default }" and that
  537: #  claim is FALSE in two ways, both found by a read-only audit seat and both checked here. ***
  538: #
  539: #  EXHAUSTED -- every value in the reachable domain is driven, so no predicate over these alone
  540: #  can be false at every declined cell, whatever its shape:
  541: #      tlb_mode    {0,1,2,4}     4 of 4      (the other four return before the store)
  542: #      bufdepth    {1,2,4,8}     4 of 4
  543: #      color_mode  16 nibbles    16 of 16    (4 accepting arms + 12 reaching `default:')
  544: #
  545: #  SAMPLED -- driven at more than one value, which kills the measured single-value family, but
  546: #  NOT exhausted, so a slice WITHIN a driven class can still escape:
  547: #      x           {0, 4, 132} of 2048          y  {0,1} masked, of 128
  548: #      *color      2 values of 2^32
  549: #      tileptr     {0x10000,0x20000,0x30000,0x40000,0x50000} -- the TLB ARRAY CONTENTS, which
  550: #                  the line above lists as an input to tileptr and which the superseded
  551: #                  sentence then silently dropped.  This one matters most: tileptr IS the
  552: #                  store's address operand, so by the 2026-09-09 flow test the array VALUE is
  553: #                  as much a floor axis as the array CHOICE (tlb_mode) already is.
  554: #      mode        the raw parameter.  Bits 0-3 and 13-31 are read by NOTHING in this function,
  555: #                  and every mode word any row drives has low nibble 0.
  556: #
  557: #  WHAT THAT COSTS, stated rather than glossed: `if (ok || (tileptr & 0xfff00000))',
  558: #  `if (ok || (mode & 1))', `if (ok || (x & 1))' and `if (ok || (y & 2))' are each predicted to
  559: #  score 77/77 and each is reachable by one ordinary guest store.  They are DERIVED, not
  560: #  measured -- no table has run them.  They are filed in killtable4_20260911/RESIDUALS.md.
  561: #
  562: #  WHY THEY ARE NOT REPAIRED HERE, and this is the honest boundary rather than a dodge: a slice
  563: #  within an already-driven class is not closable by any finite row set -- for any cells you
  564: #  drive, a predicate false on exactly those cells exists.  That is the same species the
  565: #  2026-09-04 ruling files as clause-(e) debt, and it is the species this round already accepted
  566: #  for M28 (a value slice inside a driven label).  The tileptr/array-contents axis is the one
  567: #  exception that is genuinely FLOOR-shaped, because the value flows into the address operand;
  568: #  it is filed as owed rather than fixed in this diff, because a repair made in response to a
  569: #  review owes its own pass and this block has not had one.
  570: #
  571: #  STILL DISCLOSED rather than rowed, and named so a later escape is inside or outside the
  572: #  contract by inspection: (a) a predicate that ENUMERATES this cell set by value
  573: #  (`x == 0 || x == 132 || ...'), which no finite row set can exclude and which the floor rules
  574: #  do not demand -- rows are owed per enumerated mutant, never per refusing state; (b) the
  575: #  coordinate cells are driven at ONE bufdepth (4) and ONE label (TLB_A), so a mutant joining a
  576: #  coordinate to a width or a label is coverage debt; (c) tile_nr values beyond {0,1,16,17} and
  577: #  fg values beyond the two driven -- within-class slices, clause (e) by the 2026-09-04 ruling.
  578: 
  579: FG_ALT = 0x5a3c691e           # a SECOND foreground colour.  See the note below -- this exists
  580:                               # because every one of the rows above draws in FG_VAL.
  581: 
  582: #  ---- AXIS 1: the colour nibble, and the foreground value, closed in ONE session -------------
  583: #  `ycrcb put' (0xf0) and `reserved put' (0x50) already drive two of the TWELVE nibbles that
  584: #  reach the default arm, both at LIN_A/bufdepth 4/(0,0).  These are the other TEN at that same
  585: #  already-rowed cell, which is why the closure costs ten rows and not twelve.
  586: #
  587: #  AND THE SESSION DRAWS IN FG_ALT, NOT FG_VAL -- which closes the *color axis for free.
  588: #  My own pass-2 CONTROL set DE_FG to the same 0xaabbccdd the instrument uses and therefore
  589: #  scored M37_fgvalue 10/10, reproducing the exact blind spot it was built to expose.  A control
  590: #  must not bake in a constant the thing under test also uses; that is the same failure one
  591: #  level up.  With these ten cells at FG_ALT, `if (*color == 0xaabbccdd) ok = 0;' declines at
  592: #  every older row and PERMITS at all ten of these.
  593: NIB_OTHER = (0x40, 0x60, 0x70, 0x80, 0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0)
  594: A = Addr(CODE)
  595: _cmds = store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)
  596: _cmds += store(A, DE_DRAWMODE, DRAWMODE_SOLID) + store(A, DE_FG, FG_ALT)
  597: _cmds += store(A, DE_XVERTEX_0, 0x00000000) + store(A, DE_XVERTEX_1, 0x00000000)
  598: _cmds += cell_op(A, 0x1220, DST_KSEG1)                      # RGBA accept, at FG_ALT
  599: for _nb in NIB_OTHER:
  600:     _cmds += cell_op(A, 0x1200 | _nb, DST_KSEG1)            # LIN_A | BUFDEPTH_32 | nibble
  601: t_nib, alive_nib = session(_cmds, spin=3.5)
  602: _vn = printed_seq(t_nib) if alive_nib else []
  603: row("nib accept alt", (_vn[0] if _vn else "absent") if alive_nib else "died",
  604:     "0x%08x" % FG_ALT,
  605:     "LIVENESS + fg ACCEPT: an RGBA PUT drawn in a SECOND colour lands whole")
  606: for _i, _nb in enumerate(NIB_OTHER):
  607:     row("nib %02x" % _nb, (_vn[_i + 1] if _i + 1 < len(_vn) else "absent") if alive_nib else "died",
  608:         want_sentinel,
  609:         "DECLINED type 0x%02x at FG_ALT: one of the ten reaching nibbles no row drove" % _nb)
  610: row("nib ann", t_nib.count(ANN) if alive_nib else "died", 1,
  611:     "ten declined nibbles in one process announce ONCE -- the latch spans the nibble axis")
  612: 
  613: #  ---- AXIS 2: the coordinate pair (x, y), and every quantity derived from it ------------------
  614: #  Every one of the rows above drives vertex (0,0) except `ycrcb x4y1' at (4,1), which is
  615: #  LINEAR -- and on the linear path tile_nr is x>>12, so 4>>12 == 0.  A TILED (4,1) would not
  616: #  have helped either: 4/tilewidth_in_pixels is 0 at every bufdepth.  So EVERY row above holds
  617: #  tile_nr, tile_nr_x and tile_nr_y at ZERO, and `if (ok || tile_nr)' -- eleven characters --
  618: #  swept the 59-row instrument clean while corrupting every tile but the first.
  619: #
  620: #  *** THIS SENTENCE ALSO NAMED `xofs' AND THAT WAS A WRONG RECORD.  Corrected. ***  `xofs' is
  621: #  computed at dev_sgi_re.c:247, BEFORE the switch on tlb_mode, so at `ycrcb x4y1' -- LINEAR
  622: #  (4,1), bufdepth 4 -- it is (4 % 128) * 4 = 16, NOT zero.  The linear arm overrides `ofs' with
  623: #  `x & 4095' and never recomputes `xofs'.  MEASURED: killtable4_20260911's M39_xofsguard
  624: #  (`if (xofs == 0) ok = 0;') reds THREE rows and the third is `ycrcb x4y1' -- a row predating
  625: #  this block.  Found twice independently, by that table and by a read-only audit seat reading
  626: #  this comment against the source.
  627: #
  628: #  THE CELLS, tiled TLB_A at bufdepth 4 so tilewidth_in_pixels is 128:
  629: #      C1 (132,  0)  tile_nr_x 1  tile_nr_y 0  tile_nr  1  y 0  xofs 16  ofs  16 -> tile  1
  630: #      C2 (  0,  1)  tile_nr_x 0  tile_nr_y 0  tile_nr  0  y 1  xofs  0  ofs 512 -> tile  0
  631: #      C3 (  0,128)  tile_nr_x 0  tile_nr_y 1  tile_nr 16  y 0  xofs  0  ofs   0 -> tile 16
  632: #      C4 (132,129)  tile_nr_x 1  tile_nr_y 1  tile_nr 17  y 1  xofs 16  ofs 528 -> tile 17
  633: #  against the existing (0,0), where all seven of those are ZERO.
  634: #
  635: #  x IS 132 AND NOT 128 ON PURPOSE: it makes tile_nr_x AND xofs non-zero in ONE cell, which is
  636: #  what lets C4 be non-zero on all seven derived quantities at once.  (The first version of this
  637: #  note justified 132 by claiming `if (xofs == 0) ok = 0;' would otherwise sweep the table.  That
  638: #  is FALSE -- `ycrcb x4y1' already carries xofs 16, so that mutant was caught before this block
  639: #  existed, and M39 measures it at 76/77 territory rather than a sweep.  The CHOICE is right and
  640: #  the REASON was wrong; corrected rather than left, because a wrong reason gets reused.)
  641: #  y IS 129 AND NOT 128 IN C4 because `y &= 127' runs BEFORE the colour switch, so 128 masks to
  642: #  zero and would leave the in-scope `y' pinned.
  643: #
  644: #  C4 IS THE JOINT CELL and it is not decoration: a corner-free design is swept by the pairwise
  645: #  disjunctions.  `tile_nr == 0 || y == 0' is TRUE at (0,0), C1, C2 and C3 and false only at C4.
  646: #
  647: #  EACH CELL HAS ITS OWN TILE, SO EACH ACCEPT IS AN ANCHOR (clause (f)): re_tlb_a[0/1/16/17] are
  648: #  0x8001/0x8002/0x8004/0x8005, i.e. physical 0x10000/0x20000/0x40000/0x50000.  An accept row
  649: #  pins WHICH tile and WHICH offset the decode chose, not merely that something was written; and
  650: #  `xy anchor t0' re-reads tile 0's own word afterwards, so an access that silently collapsed to
  651: #  tile 0 reddens even though its own cell looks untouched.
  652: RE_TLB_A_16 = 0xb5001020      # re_tlb_a[16..19]: tlbi = ((0x1020 & 0x1ff) >> 1) & 0xff = 16
  653: TILE_16, TILE_17 = 0x8004, 0x8005
  654: XY_CELLS = (("c1 x132y0",   (132 << 16) | 0,   0xa0020010),   # tile  1, ofs  16
  655:             ("c2 x0y1",     (  0 << 16) | 1,   0xa0010200),   # tile  0, ofs 512
  656:             ("c3 x0y128",   (  0 << 16) | 128, 0xa0040000),   # tile 16, ofs   0
  657:             ("c4 x132y129", (132 << 16) | 129, 0xa0050210))   # tile 17, ofs 528
  658: 
  659: def xy_prologue(A):
  660:     c  = store(A, RE_TLB_A_W,  (TILE_A << 48) | (TILE_B << 32), op=OP_SD_T0_A3)
  661:     c += store(A, RE_TLB_A_16, (TILE_16 << 48) | (TILE_17 << 32), op=OP_SD_T0_A3)
  662:     c += store(A, DE_DRAWMODE, DRAWMODE_SOLID)
  663:     c += store(A, DE_FG, FG_VAL)
  664:     #  tile 0's OWN word at ofs 0 is painted here and by nothing else: no cell in this session
  665:     #  writes it (C2 lives at ofs 512), so it is a clean attribution target for `xy anchor t0'.
  666:     c += store(A, 0xa0010000, DST_PAINT)
  667:     return c
  668: 
  669: def xy_cell(A, mode, vertex, ks):
  670:     """One coordinate cell: repaint its own destination, set the vertex, fire, read back."""
  671:     return (["put w 0x%x, 0x%08x" % (ks, DST_PAINT),
  672:              "a3=0x%x" % DE_XVERTEX_0, "t0=0x%x" % vertex]
  673:             + run_ops([OP_SW_T0_A3], A.take(1))
  674:             + ["a3=0x%x" % DE_XVERTEX_1, "t0=0x%x" % vertex]
  675:             + run_ops([OP_SW_T0_A3], A.take(1))
  676:             + ["a3=0x%x" % DE_MODE_DST,   "t0=0x%x" % mode,
  677:                "a2=0x%x" % DE_PRIM_START, "t1=0x%x" % PRIM_RECT,
  678:                "at=0x%x" % ks,            "v0=0x%x" % SENTINEL]
  679:             + run_ops([OP_SW_T0_A3, OP_SW_T1_A2, OP_LW_V0_AT], A.take(3))
  680:             + ["print v0"])
  681: 
  682: A = Addr(CODE)
  683: _cmds = xy_prologue(A)
  684: for _n, _vtx, _ks in XY_CELLS:                       # four ACCEPTS, each into its own tile
  685:     _cmds += xy_cell(A, 0x0220, _vtx, _ks)
  686: for _n, _vtx, _ks in XY_CELLS:                       # then the same four cells, DECLINED
  687:     _cmds += xy_cell(A, 0x02f0, _vtx, _ks)
  688: _cmds += ["at=0x%x" % 0xa0010000, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT], A.take(1)) + ["print v0"]
  689: t_xy, alive_xy = session(_cmds, spin=4.0)
  690: _vx = printed_seq(t_xy) if alive_xy else []
  691: def _xy(i):
  692:     return (_vx[i] if i < len(_vx) else "absent") if alive_xy else "died"
  693: for _i, (_n, _vtx, _ks) in enumerate(XY_CELLS):
  694:     row("xy acc %s" % _n.split()[0], _xy(_i), "0x%08x" % FG_VAL,
  695:         "ACCEPT ANCHOR: lands in THIS cell's own tile at its own offset (0x%08x)" % _ks)
  696: for _i, (_n, _vtx, _ks) in enumerate(XY_CELLS):
  697:     row("xy dec %s" % _n.split()[0], _xy(len(XY_CELLS) + _i), want_sentinel,
  698:         "DECLINED at %s: a cell where a coordinate-derived guard would PERMIT" % _n.split()[1])
  699: row("xy anchor t0", _xy(2 * len(XY_CELLS)), "0x%08x" % DST_PAINT,
  700:     "ATTRIBUTION: tile 0's own word survives, so no cell silently collapsed onto it")
  701: row("xy ann", t_xy.count(ANN) if alive_xy else "died", 1,
  702:     "four declined PUTs across four tiles announce ONCE, and the four ACCEPTS are silent")
  703: 
  704: ok = sum(1 for _, o in rows if o)
  705: print()
  706: print("SGICOLOUR_RESULT=%d/%d" % (ok, len(rows)))
  707: print("SGICOLOUR_DONE")
  708: sys.exit(0 if ok == len(rows) else 1)

