   34:  *	0x15001000	rendering engine (TLBs)
   35:  *	0x15002000	drawing engine
   36:  *	0x15003000	memory transfer engine
   37:  *	0x15004000	status registers for drawing engine
   38:  *
   39:  *  dev_sgi_gbe.cc:
   40:  *	0x16000000	crm (or GBE) framebuffer control / video output
   41:  */
   42: 
   43: #include <stdio.h>
   44: #include <stdlib.h>
   45: #include <string.h>
   46: 
   47: #include "console.h"
   48: #include "cpu.h"
   49: #include "devices.h"
   50: #include "machine.h"
   51: #include "memory.h"
   52: #include "misc.h"
   53: 
   54: #include "thirdparty/crmfbreg.h"
   55: #include "thirdparty/sgi_gl.h"
   56: 
   57: 
   58: /*
   59:  *  #497: one latch bit per WIDTH-guard site in DEVICE_ACCESS(sgi_re).
   60:  *
   61:  *  SIX FLAGS, NOT ONE.  dev_wdc.c's own comment adjudicates this: sharing a
   62:  *  latch is licensed only across sites that are MUTUALLY EXCLUSIVE at
   63:  *  runtime.  These six are six different address windows, and any driver
   64:  *  bringing up the rendering engine walks all of them in ONE session, so a
   65:  *  shared latch would report the first odd-width access and silence the
   66:  *  other five.
   67:  */
   68: enum {
   69: 	SGIRE_W_TLBA_LEN  = 1 << 0,
   70: 	SGIRE_W_TLBB_LEN  = 1 << 1,
   71: 	SGIRE_W_TLBC_LEN  = 1 << 2,
   72: 	SGIRE_W_TEX_LEN   = 1 << 3,
   73: 	SGIRE_W_LINA_LEN  = 1 << 4,
   74: 	SGIRE_W_LINB_LEN  = 1 << 5,
   75: 
   76: 	/*  #498: sgi_de's width decline.  ONE bit, not six: the six above are one
   77: 	    per SITE because six windows with six distinct message texts are walked
   78: 	    in a single bring-up session, and one latch would report the first and
   79: 	    silence five.  sgi_de has ONE guard and ONE message text, so the house
   80: 	    per-message-site rule gives one bit.  Measured cost: `sb' then `sh' at
   81: 	    one offset announces len=1 and never len=2 -- accepted, and small,
   82: 	    because the message already prints the width.
   83: 
   84: 	    It must be its OWN bit.  Reusing SGIRE_W_TLBA_LEN scored 23/25: the
   85: 	    four handlers share one malloc'd struct, so any odd-width access to
   86: 	    sgi_re's TLB_A window would silence sgi_de's decline entirely.  */
   87: 	SGIRE_W_DE_LEN    = 1 << 6,
   88: 
   89: 	/*  #499: the unmatched-address catch-all.  TWO bits, one per DIRECTION:
   90: 	    a driver probing an unmapped window commonly reads and writes it in
   91: 	    one pass, and one bit would announce the first and silence the other.
   92: 
   93: 	    PLACED AFTER SGIRE_W_DE_LEN ON PURPOSE.  An earlier draft inserted
   94: 	    these two after SGIRE_W_LINB_LEN (1 << 5), which left the enum ending
   95: 	    at 1 << 6 -- so a maintainer scanning to the LAST enumerator for the
   96: 	    next free bit would take 1 << 7, WHICH THESE TWO LINES BELOW ALREADY
   97: 	    USE.  A duplicate enumerator is legal C and silent, and all four
   98: 	    handlers share one malloc'd struct, so the collision crosses devices.
   99: 
  100: 	    (Wording sharpened after a pass-2 seat read "which is already used"
  101: 	    as a standalone claim about 1 << 7 and reported the comment as
  102: 	    self-contradictory against the code three lines down.  The claim was
  103: 	    right and the sentence did not say BY WHAT.)  */
  104: 	SGIRE_W_UNMAP_WR  = 1 << 7,
  105: 	SGIRE_W_UNMAP_RD  = 1 << 8,
  106: 
  107: 	/*  #500: draw_primitive()'s unimplemented drawing op.  ITS OWN BIT,
  108: 	    for the reason #498 measured on SGIRE_W_DE_LEN: a latch shared with
  109: 	    another site is silenced by that site's ordinary traffic, so the
  110: 	    announce this fix exists to make would never fire.
  111: 
  112: 	    (This comment used to end "The next free bit is 1 << 10; the enum
  113: 	    ends HERE on purpose so that a maintainer scanning to the last
  114: 	    enumerator finds it."  BOTH HALVES WENT FALSE when sgirandompixel
  115: 	    added SGIRE_W_BADMODE = 1 << 10 BELOW this line.  Demoted rather
  116: 	    than deleted, because the REASONING is still why the convention
  117: 	    exists -- and leaving it live would have pointed the next reader at
  118: 	    a taken bit, which is the duplicate-enumerator collision #499
  119: 	    already paid for and warns about four lines up.  The live
  120: 	    next-free claim is on the LAST enumerator, where it belongs.)  */
  121: 	SGIRE_W_PRIM_OP   = 1 << 9,
  122: 
  123: 	/*  sgirandompixel: horrible_getputpixel()'s unimplemented-mode arm.  ITS
  124: 	    OWN BIT, for the reason #498 measured and #500 repeated -- the four
  125: 	    handlers share one malloc'd struct, so a latch shared with another
  126: 	    site is silenced by that site's ordinary traffic and the announce
  127: 	    never fires.  This one matters more than most: the helper is
  128: 	    PER-PIXEL, called inside line, rectangle and tiled-MTE loops, so an
  129: 	    UNLATCHED announce is a per-pixel flood rather than a diagnostic.
  130: 
  131: 	    (This comment used to end "The next free bit is 1 << 11; the enum
  132: 	    ends HERE on purpose, as above."  BOTH HALVES WENT FALSE when #513
  133: 	    added SGIRE_W_TEX_RD = 1 << 11 BELOW this line -- the SAME failure,
  134: 	    in the SAME enum, that the comment ten lines up already records
  135: 	    happening to SGIRE_W_PRIM_OP.  Demoted rather than deleted, for that
  136: 	    comment's own reason: the REASONING is still why the convention
  137: 	    exists, and leaving the claim live would point the next reader at a
  138: 	    TAKEN bit.  The live next-free claim is on the LAST enumerator.)  */
  139: 	SGIRE_W_BADMODE   = 1 << 10,
  140: 
  141: 	/*
  142: 	    #513: THE TEX READ DECLINE GETS ITS OWN BIT, not SGIRE_W_TEX_LEN.
  143: 	    Sharing one was measured at 23/25 for SGIRE_W_DE_LEN in #498: an
  144: 	    ordinary narrow write fires the width latch, and the read decline is
  145: 	    then silently suppressed for the life of the instance.  The detector
  146: 	    has a row for exactly this (`tex xbit', which fires all six width
  147: 	    latches before reading).
  148: 
  149: 	    (This comment used to end "THE NEXT FREE BIT IS 1 << 12, AND THIS
  150: 	    IS THE LAST ENUMERATOR".  #519 added SGIRE_W_BADCOLOR = 1 << 12
  151: 	    BELOW this line and moved the sentence with it, as this comment
  152: 	    itself instructed.  Demoted, not deleted, for the same reason as
  153: 	    the two demotions above it.)
  154: 	 */
  155: 	SGIRE_W_TEX_RD    = 1 << 11,
  156: 
  157: 	/*  #519 (sgirandomcolour): the colour-type PUT decline in
  158: 	    horrible_getputpixel() gets its OWN bit, per the rule every entry
  159: 	    above records: the helper is per-pixel, the struct is shared by
  160: 	    four handlers, and a latch shared with any other site is silenced
  161: 	    by that site's ordinary traffic.  SGIRE_W_BADMODE (1 << 10) is the
  162: 	    TLB/mode switch's decline in the same function and is a different
  163: 	    event with a different text; sharing it would collapse the two.
  164: 
  165: 	    THE NEXT FREE BIT IS 1 << 13, AND THIS IS THE LAST ENUMERATOR --
  166: 	    which is where that claim belongs, per the convention above.  A
  167: 	    maintainer adding a bit BELOW this line must move this sentence
  168: 	    with it and demote the copy here.  */
  169: 	SGIRE_W_BADCOLOR  = 1 << 12,
  170: };
  171: 
  172: struct sgi_re_data {
  173: 	// Rendering engine registers:
  174: 	uint16_t	re_tlb_a[256];
  175: 	uint16_t	re_tlb_b[256];
  176: 	uint16_t	re_tlb_c[256];
  177: 	uint16_t	re_tex[112];
  178: 	// todo: clip_ids registers.
  179: 	uint32_t	re_linear_a[32];
  180: 	uint32_t	re_linear_b[32];
  181: 
  182: 	// Drawing engine registers:
  183: 	uint32_t	de_reg[DEV_SGI_DE_LENGTH / sizeof(uint32_t)];
  184: 
  185: 	// Memory transfer engine registers:
  186: 	uint32_t	mte_reg[DEV_SGI_MTE_LENGTH / sizeof(uint32_t)];
  187: 
  188: 	/*
  189: 	 *  #497: width-guard decline latches; see the enum above.
  190: 	 *
  191: 	 *  PLACED LAST, DELIBERATELY, AND THE ORDER IS LOAD-BEARING.
  192: 	 *  re_linear_a/b are written at [tlbi] AND [tlbi+1] with tlbi able to
  193: 	 *  reach 31, so index 32 of either array lands on whichever field
  194: 	 *  FOLLOWS it.  An earlier draft of this change put `warned' between
  195: 	 *  re_linear_b and de_reg; measured with offsetof, that made
  196: 	 *  re_linear_b[32] alias `warned' rather than de_reg[0] -- which both
  197: 	 *  falsified the adjacency the two LINEAR site comments cite, and made
  198: 	 *  an over-run SET WARNING LATCH BITS and silence this device's own
  199: 	 *  diagnostics.  Keeping the latch after mte_reg restores the
  200: 	 *  documented adjacency: re_linear_a[32] is re_linear_b[0] and
  201: 	 *  re_linear_b[32] is de_reg[0].
  202: 	 */
  203: 	uint32_t	warned;
  204: };
  205: 
  206: 
  207: /*
  208:  *  horrible_getputpixel():
  209:  *
  210:  *  This routine gets/puts a pixel in one of the tiles, from the perspective of
  211:  *  the rendering/drawing engine. Given x and y, it figures out which tile
  212:  *  number it is, and then finally does a slow read/write to get/put the pixel
  213:  *  at the correct sub-coordinates within the tile.
  214:  *
  215:  *  Tiles are always 512 _bytes_ wide, and 128 pixels high. For 32-bit color
  216:  *  modes, for example, that means 128 x 128 pixels.
  217:  *
  218:  *  For "linear" modes, y is ignored and x is an offset to select which linear
  219:  *  TLB entry to use.
  220:  */
  221: void horrible_getputpixel(int put, struct cpu* cpu, struct sgi_re_data* d,
  222: 	int x, int y, uint32_t* color, int mode)
  223: {
  224: 	uint32_t color_mode = mode & DE_MODE_TYPE_MASK;
  225: 	int bufdepth = 1 << ((mode >> 8) & 3); 
  226: 
  227: 	// dst_mode (see NetBSD's crmfbreg.h):
  228: 	// #define DE_MODE_TLB_A           0x00000000
  229: 	// #define DE_MODE_TLB_B           0x00000400
  230: 	// #define DE_MODE_TLB_C           0x00000800
  231: 	// #define DE_MODE_LIN_A           0x00001000
  232: 	// #define DE_MODE_LIN_B           0x00001400
  233: 	uint32_t tlb_mode = (mode >> 10) & 0x7;
  234: 	int linear = tlb_mode > 3;
  235: 
  236: 	if (!linear && (x < 0 || y < 0 || x >= 2048 || y >= 2048))
  237: 		return;
  238: 
  239: 	int tilewidth_in_pixels = 512 / bufdepth;
  240: 	
  241: 	int tile_nr_x = x / tilewidth_in_pixels;
  242: 	int tile_nr_y = y >> 7;
  243: 
  244: 	unsigned int tile_nr = tile_nr_y * 16 + tile_nr_x;
  245: 
  246: 	y &= 127;
  247: 	int xofs = (x % tilewidth_in_pixels) * bufdepth;
  248: 	int ofs = 512 * y + xofs;
  249: 
  250: 	uint32_t tileptr = 0;
  251: 
  252: 	/*  #100: cases 0-2 index re_tlb_[abc][256] with a guest-derived
  253: 	    tile_nr = (y>>7)*16 + x/tilewidth; bound it (case 4 self-checks).  */
  254: 	if (tlb_mode <= 2 && tile_nr >= 256)
  255: 		return;
  256: 
  257: 	switch (tlb_mode) {
  258: 	case 0:	tileptr = d->re_tlb_a[tile_nr] << 16;
  259: 		break;
  260: 	case 1:	tileptr = d->re_tlb_b[tile_nr] << 16;
  261: 		break;
  262: 	case 2:	tileptr = d->re_tlb_c[tile_nr] << 16;
  263: 		break;
  264: 	case 4:	tile_nr = x >> 12;
  265: 		if (tile_nr >= 32)
  266: 			return;
  267: 		tileptr = 0x80000000 | (d->re_linear_a[tile_nr] << 12);
  268: 		ofs = x & 4095;
  269: 		// TODO... probably not correct!
  270: 		// printf("tileptr = %08x x = %i y = %i tile_nr = %i ofs = %i\n", tileptr, x, y, tile_nr, ofs);
  271: 		break;
  272: 	default:/*  sgirandompixel: this arm used to assign `*color = random()' -- with
  273: 		    its exit(1) commented out -- so a failed GET handed the CALLER a
  274: 		    random value, and draw_primitive() then wrote it to the destination
  275: 		    in the same loop iteration, since `color' is shared by the XFER GET
  276: 		    and the PUT.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes
  277: 		    crmfbreg.h documents and extracts to tlb_mode 5, so this was
  278: 		    reachable with a DOCUMENTED mode, not only with a junk one.
  279: 		    MEASURED, rung 3: the destination received 0x4b1763a1, 0x2ee4b4df
  280: 		    and 0x7433cdc1 on successive runs of
  281: 		    regress/sgi_re_randompixel_probe.py.
  282: 
  283: 		    NOW DECLINED: `*color' is left alone, so the caller's own
  284: 		    `uint32_t color = fg' stands and what lands is at least
  285: 		    DETERMINISTIC.  The announce is latched because this helper is
  286: 		    per-pixel.
  287: 
  288: 		    WHAT THIS DOES NOT DO, filed rather than silently omitted: the
  289: 		    caller STILL PERFORMS its dependent PUT, so a declined GET still
  290: 		    writes fg (row sgirandomskipput -- suppressing it needs a return
  291: 		    value and every GET site changed, which is more than one site);
  292: 		    LIN_B is still not implemented, and the panel refused to endorse
  293: 		    implementing it as LIN_A-with-the-other-array on symmetry alone
  294: 		    (row sgirelinb); and the COLOUR-mode switch below carries the same
  295: 		    random() shape at its own default (row sgirandomcolour).  */
  296: 		if (!(d->warned & SGIRE_W_BADMODE)) {
  297: 			d->warned |= SGIRE_W_BADMODE;
  298: 			/*  `dst_mode' is kept from the original text although the
  299: 			    parameter is also passed as src_mode on a GET: the probe
  300: 			    anchors on this literal, and rewording it here would be
  301: 			    scope creep AND would move an oracle anchor mid-round,
  302: 			    which is the laundering shape whatever the intent.
  303: 			    Filed as sgirenamedstmode.  */
  304: 			fatal("[ sgi_re: unimplemented dst_mode %i for "
  305: 			    "horrible_getputpixel (%s), x=%i y=%i; declined "
  306: 			    "(once) ]\n", mode, put ? "put" : "get", x, y);
  307: 		}
  308: 		return;
  309: 	}
  310: 
  311: 	// The highest bit seems to be set for a "valid" tile pointer.
  312: 	if (!(tileptr & 0x80000000)) {
  313: 		//printf("dst_mode %i, tile_nr = %i,  tileptr = 0x%llx\n", dst_mode, tile_nr, (long long)tileptr);
  314: 		//fatal("sgi gbe horrible_getputpixel: unexpected non-set high bit of tileptr?\n");
  315: 		//exit(1);
  316: 		return;
  317: 	}
  318: 	
  319: 	tileptr &= ~0x80000000;
  320: 
  321: 	uint8_t buf[8];		/* #100: bufdepth can be 8 = 1<<((mode>>8)&3) */
  322: 	if (put) {
  323: 		int ok = 1;	/*  #519: cleared by the default arm below  */
  324: 		switch (color_mode) {
  325: 		case DE_MODE_TYPE_CI:
  326: 			buf[0] = *color;
  327: 			break;
  328: 		case DE_MODE_TYPE_RGB:
  329: 			buf[0] = *color >> 24;
  330: 			buf[1] = *color >> 16;
  331: 			buf[2] = *color >> 8;
  332: 			buf[3] = 0;
  333: 			break;
  334: 		case DE_MODE_TYPE_RGBA:
  335: 			buf[0] = *color >> 24;
  336: 			buf[1] = *color >> 16;
  337: 			buf[2] = *color >> 8;
  338: 			buf[3] = *color;
  339: 			break;
  340: 		case DE_MODE_TYPE_ABGR:
  341: 			buf[0] = *color;
  342: 			buf[1] = *color >> 8;
  343: 			buf[2] = *color >> 16;
  344: 			buf[3] = *color >> 24;
  345: 			break;
  346: 		default:/*  #519 (sgirandomcolour): this arm was `buf[0..3] = random()'
  347: 			    and an UNLATCHED per-pixel fatal(), after which the common
  348: 			    store below wrote four HOST-PRNG bytes into guest memory.
  349: 			    Twelve of the sixteen type nibbles reach here, the documented
  350: 			    DE_MODE_TYPE_YCRCB among them.  MEASURED at rung 3
  351: 			    (regress/sgi_re_colourdefault_probe.py): a destination
  352: 			    pre-painted 0x11223344 read 0x56e8857a and 0x38abc4e1 on two
  353: 			    runs -- neither the paint nor any packing of the colour, and
  354: 			    different each run because main.c seeds random() per process.
  355: 
  356: 			    NOW DECLINED, member 3: the STORE IS SKIPPED, so the
  357: 			    destination keeps what the guest had -- not a zero fill, which
  358: 			    would publish a colour the guest never asked for (random() with
  359: 			    the entropy stripped) -- and the announce is latched on its own
  360: 			    bit because this helper is per-pixel.  The old literal is kept
  361: 			    as the prefix: the witness attributes on it.  A declined PUT
  362: 			    never reads buf, so the width question (sgirebufuninit) is a
  363: 			    separate row, and the GET default below is untouched.  */
  364: 			ok = 0;
  365: 			if (!(d->warned & SGIRE_W_BADCOLOR)) {
  366: 				d->warned |= SGIRE_W_BADCOLOR;
  367: 				fatal("[ put: color mode = 0x%x ] [ sgi_re: unimplemented "
  368: 				    "colour type in horrible_getputpixel, x=%i y=%i; store "
  370: 			}  403: 			    lone container outlier among the 32-bit arms.  404: 
  405: 			    The low byte stays ZERO on purpose: RGB carries
  406: 			    three channels, so a corrected read of 0xaabbccdd
  407: 			    yields 0xaabbcc00, NOT the source word.  */
  408: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
  409: 			break;
  410: 		case DE_MODE_TYPE_RGBA:
  411: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
  412: 			break;
  413: 		case DE_MODE_TYPE_ABGR:
  414: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
  415: 			break;
  416: 		default:// Read "raw" 32-bit value:
  417: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
  418: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
  419: 		}
  420: 	}
  421: }
  422: 
  423: 
  424: /*
  425:  *  SGI "re", NetBSD sources describes it as a "rendering engine".
  426:  */
  427: 
  428: DEVICE_ACCESS(sgi_re)
  429: {
  430: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
  431: 	uint64_t idata = 0, odata = 0;
  432: 
  433: 	idata = memory_readmax64(cpu, data, len);
  434: 
  435: 	relative_addr += 0x1000;
  436: 
  437: 	/*
  438: 	 *  #497: THE SIX WIDTH GUARDS BELOW USED TO END THE HOST PROCESS.
  439: 	 *
  440: 	 *  A guest choosing an access width is not an emulator error, so each
  441: 	 *  `len != 8' arm now DECLINES the access and announces itself once.
  442: 	 *  Three properties of the shape are load-bearing:
  443: 	 *
  444: 	 *  1. It is an `else if' SPLICE, not an early return.  A `return' here
  445: 	 *     would skip this function's common tail, and `return 0' would be
  446: 	 *     coerced to -1 by cpus/memory_rw.c and raise EXCEPTION_DBE in the
  447: 	 *     guest -- turning a declined access into a guest bus error.
  448: 	 *
  449: 	 *  2. Control therefore reaches the tail, which answers a declined READ
  450: 	 *     with odata (0).
  451: 	 *
  452: 	 *     *** THIS PARAGRAPH ONCE CALLED THAT TAIL DEAD CODE -- "every read arm
  453: 	 *     below still exit(1)s, so odata is never assigned today".  #499 MADE IT
  454: 	 *     LIVE: the unmatched-address catch-all no longer exits, so a declined
  455: 	 *     read now runs the tail and lands a defined 0, and the shipped detector's
  456: 	 *     `rd sent' row exists to pin exactly that.  The six `TODO: read from'
  457: 	 *     arms below DO still exit(1) -- that half is unchanged and is sgirekills. ***
  458: 	 *
  459: 	 *     *** AND THAT HALF IS NOW GONE TOO: #513 REMOVED ALL SIX.  The tail is
  460: 	 *     reached by more than declines now -- five of the six arms ASSIGN odata
  461: 	 *     and let the tail deliver it, so the tail is the ACCEPT path as well as
  462: 	 *     the decline path.  The sentence above is #499's and was true when
  463: 	 *     written; it stands with its correction, as #499's own does. ***
  464: 	 *
  465: 	 *  3. The guards are NOT redundant.  For TLB_A/B/C and TEX the store is a
  466: 	 *     `for (hwi = 0; hwi < len; ...)' loop, so a narrower access simply
  467: 	 *     runs fewer iterations and stays in bounds -- there the guard is
  468: 	 *     modelling fidelity only.  For LINEAR_A and LINEAR_B it is not; see
  469: 	 *     the note at those two sites.
  470: 	 *
  471: 	 *  Only the WIDTH kills change HERE, IN #497.  The six `TODO: read from ...'
  472: 	 *  kills are still untouched.
  473: 	 *
  474: 	 *  *** UNTRUE SINCE #513, WHICH IS THE ROUND THAT TOOK THEM.  Five became
  475: 	 *  ACCEPTs (the read returns what the write stored) and CRIME_RE_TEX became a
  476: 	 *  latched decline.  #497's sentence was accurate for #497 and is kept for the
  477: 	 *  same reason the catch-all correction below is kept: a reader arriving from
  478: 	 *  #497's records has to be able to see which half moved and when. ***
  479: 	 *
  480: 	 *  *** THE CATCH-ALL IS NO LONGER UNTOUCHED: #499 DE-FATALISED IT and that row
  481: 	 *  is CLOSED.  The sentence is #497's and was true when written; it is left
  482: 	 *  standing with its correction rather than rewritten, because a reader
  483: 	 *  arriving from #497's records needs to see which half moved. ***  The READ
  484: 	 *  arms are
  485: 	 *  `sgirekills`, the CATCH-ALL is `sgireunmapped` (two different rows: one is a
  486: 	 *  direction, the other an unmatched address with no width predicate at all), as is
  487: 	 *  DEVICE_ACCESS(sgi_de)'s own width kill, whose accept set is {4,8}
  488: 	 *  rather than {8} (sgidewidth).
  489: 	 */
  490: 	if (relative_addr >= CRIME_RE_TLB_A && relative_addr < CRIME_RE_TLB_B) {
  491: 		if (len != 8) {
  492: 			if (!(d->warned & SGIRE_W_TLBA_LEN)) {
  493: 				d->warned |= SGIRE_W_TLBA_LEN;
  494: 				fatal("[ sgi_re: unimplemented len=%i for "
  495: 				    "CRIME_RE_TLB_A -- declined.  (once) ]\n",
  496: 				    (int) len);
  497: 			}
  498: 		} else if (writeflag == MEM_WRITE) {
  499: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  500: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  501: 				d->re_tlb_a[tlbi] = data[hwi]*256 + data[hwi+1];
  502: 				debug("d->re_tlb_a[%i] = 0x%04x\n", tlbi, d->re_tlb_a[tlbi]);
  503: 				tlbi++;
  504: 			}
  505: 		} else {
  506: 			/*
  507: 			 *  #513: ACCEPT.  A guest read of a len == 8 TLB slot ended
  508: 			 *  the host.  The write arm directly above already computes
  509: 			 *  and stores the value, so the disposition is member 4 of
  510: 			 *  the option set -- delete the kill and RETURN THE VALUE --
  511: 			 *  rather than a decline: nothing is unimplemented here.
  512: 			 *  This loop is the exact inverse of the write loop, cell for
  513: 			 *  cell and shift for shift.
  514: 			 *
  515: 			 *  *** IT MUST WRITE odata, NOT data[]. ***  The function's
  516: 			 *  common tail is
  517: 			 *      if (writeflag == MEM_READ)
  518: 			 *              memory_writemax64(cpu, data, len, odata);
  519: 			 *  so anything stored into data[] here is overwritten before
  520: 			 *  it reaches the guest.  A first draft of this fix filled
  521: 			 *  data[] and would have returned zeroes while looking right.
  522: 			 */
  523: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  524: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  525: 				odata = (odata << 16) | d->re_tlb_a[tlbi];
  526: 				tlbi++;
  527: 			}
  528: 		}
  529: 	} else if (relative_addr >= CRIME_RE_TLB_B && relative_addr < CRIME_RE_TLB_C) {
  530: 		if (len != 8) {
  531: 			if (!(d->warned & SGIRE_W_TLBB_LEN)) {
  532: 				d->warned |= SGIRE_W_TLBB_LEN;
  533: 				fatal("[ sgi_re: unimplemented len=%i for "
  534: 				    "CRIME_RE_TLB_B -- declined.  (once) ]\n",
  535: 				    (int) len);
  536: 			}
  537: 		} else if (writeflag == MEM_WRITE) {
  538: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  539: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  540: 				d->re_tlb_b[tlbi] = data[hwi]*256 + data[hwi+1];
  541: 				debug("d->re_tlb_b[%i] = 0x%04x\n", tlbi, d->re_tlb_b[tlbi]);
  542: 				tlbi++;
  543: 			}
  544: 		} else {
  545: 			/*  #513: ACCEPT -- the inverse of the write loop.  See the
  546: 			    CRIME_RE_TLB_A arm for why this sets odata, not data[].  */
  547: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  548: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  549: 				odata = (odata << 16) | d->re_tlb_b[tlbi];
  550: 				tlbi++;
  551: 			}
  552: 		}
  553: 	} else if (relative_addr >= CRIME_RE_TLB_C && relative_addr < CRIME_RE_TLB_C + 0x200) {
  554: 		if (len != 8) {
  555: 			if (!(d->warned & SGIRE_W_TLBC_LEN)) {
  556: 				d->warned |= SGIRE_W_TLBC_LEN;
  557: 				fatal("[ sgi_re: unimplemented len=%i for "
  558: 				    "CRIME_RE_TLB_C -- declined.  (once) ]\n",
  559: 				    (int) len);
  560: 			}
  561: 		} else if (writeflag == MEM_WRITE) {
  562: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  563: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  564: 				d->re_tlb_c[tlbi] = data[hwi]*256 + data[hwi+1];
  565: 				debug("d->re_tlb_c[%i] = 0x%04x\n", tlbi, d->re_tlb_c[tlbi]);
  566: 				tlbi++;
  567: 			}
  568: 		} else {
  569: 			/*  #513: ACCEPT -- the inverse of the write loop.  See the
  570: 			    CRIME_RE_TLB_A arm for why this sets odata, not data[].  */
  571: 			int tlbi = ((relative_addr & 0x1ff) >> 1) & 0xff;
  572: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  573: 				odata = (odata << 16) | d->re_tlb_c[tlbi];
  574: 				tlbi++;
  575: 			}
  576: 		}
  577: 	} else if (relative_addr >= CRIME_RE_TEX && relative_addr < CRIME_RE_TEX + 0xe0) {
  578: 		if (len != 8) {
  579: 			if (!(d->warned & SGIRE_W_TEX_LEN)) {
  580: 				d->warned |= SGIRE_W_TEX_LEN;
  581: 				fatal("[ sgi_re: unimplemented len=%i for "
  582: 				    "CRIME_RE_TEX -- declined.  (once) ]\n",
  583: 				    (int) len);
  584: 			}
  585: 		} else if (writeflag == MEM_WRITE) {
  586: 			int tlbi = ((relative_addr & 0xff) >> 3) & 0xff;
  587: 			for (size_t hwi = 0; hwi < len; hwi += sizeof(uint16_t)) {
  588: 				d->re_tex[tlbi] = data[hwi]*256 + data[hwi+1];
  589: 				debug("d->re_tex[%i] = 0x%04x\n", tlbi, d->re_tex[tlbi]);
  590: 				tlbi++;
  591: 			}
  592: 		} else {
  593: 			/*
  594: 			 *  #513: DECLINE + LATCHED ANNOUNCE -- and TEX is the ONE arm
  595: 			 *  of the six that is NOT an accept.  The warrant is specific
  596: 			 *  and is recorded as `sgitexindex':
  597: 			 *
  598: 			 *    - the write arm's index is `>> 3' where a flat
  599: 			 *      uint16_t[112] incremented once per halfword needs the
  600: 			 *      register number times four.  The SGI CRIME specification
  601: 			 *      lists TLB.tex[28] as 28 separate 64-bit registers, so
  602: 			 *      `>> 3' is the REGISTER number and the missing factor of
  603: 			 *      four is the defect;
  604: 			 *    - consequently only 31 of the 112 cells are reachable and
  605: 			 *      consecutive registers overlap by three;
  606: 			 *    - `re_tex' has NO consumer anywhere in this file -- it is
  607: 			 *      written and debug-printed, never read back.
  608: 			 *
  609: 			 *  Accepting the read would therefore publish a mapping the
  610: 			 *  project has already recorded as wrong, and turn a future
  611: 			 *  sgitexindex fix into a breaking change to a shipped oracle.
  612: 			 *  Declining costs nothing today (no consumer) and leaves that
  613: 			 *  round free.  sgitexindex carries a standing do-not-code
  614: 			 *  ruling, so this round does not touch the shift.
  615: 			 */
  616: 			if (!(d->warned & SGIRE_W_TEX_RD)) {
  617: 				d->warned |= SGIRE_W_TEX_RD;
  618: 				fatal("[ sgi_re: unimplemented read from "
  619: 				    "CRIME_RE_TEX -- declined.  (once) ]\n");
  620: 			}
  621: 		}
  622: 	} else if (relative_addr >= CRIME_RE_LINEAR_A && relative_addr < CRIME_RE_LINEAR_A + 0x80) {
  623: 		if (len != 8) {
  624: 			/*
  625: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  626: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  627: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  628: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  629: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  630: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  631: 			 *  alignment is supplied by two independent mechanisms, and both
  632: 			 *  were checked rather than assumed:
  633: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  634: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  635: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  636: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  637: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  638: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
  639: 			 *      three of its memory_rw calls, so it cannot deliver an
  640: 			 *      unaligned len == 8 either.
  641: 			 *  Narrower accesses carry len != 8 and are declined above, and
  642: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  643: 			 *  so no other CPU family reaches this handler.
  644: 			 *
  645: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  646: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  647: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  648: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  649: 			 *  the invariant above is stated for GUEST paths only.  It also
  650: 			 *  means `put d' must NOT be used to "witness" the over-run:
  651: 			 *  it bypasses the guest instruction path, so a reproduction
  652: 			 *  built on it would be laundering rather than witnessing.
  653: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  654: 			 *  NOT guest-reachable while this guard stands.
  655: 			 *
  656: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  657: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  658: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  659: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  660: 			 *  reaching a DRAWING-engine register from a rendering-engine
  661: 			 *  write -- not a wild write outside the allocation, and not
  662: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  663: 			 */
  664: 			if (!(d->warned & SGIRE_W_LINA_LEN)) {
  665: 				d->warned |= SGIRE_W_LINA_LEN;
  666: 				fatal("[ sgi_re: unimplemented len=%i for "
  667: 				    "CRIME_RE_LINEAR_A -- declined.  (once) ]\n",
  668: 				    (int) len);
  669: 			}
  670: 		} else if (writeflag == MEM_WRITE) {
  671: 			/*
  672: 			 *  Very interesting. NetBSD writes stuff such as:
  673: 			 *
  674: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173080001731
  675: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173280001733
  676: 			 *  CRIME_RE_LINEAR_A IDATA = 8000173480001735
  677: 			 *  ...
  678: 			 *
  679: 			 *  but the PROM writes something which looks like wrongly
  680: 			 *  32-bit sign-extended words:
  681: 			 *
  682: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040001
  683: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040003
  684: 			 *  CRIME_RE_LINEAR_A IDATA = ffffffff80040005
  685: 			 *  ...
  686: 			 *
  687: 			 *  followed by
  688: 			 *  [ sgi_mte: STARTING TRANSFER: mode=0x00000011
  689: 			 *    dst0=0x0000000040000000, dst1=0x0000000040007fff
  690: 			 *    (length 0x8000), dst_y_step=0 bg=0x0, bytemask=0xffffffff ]
  691: 			 *
  692: 			 *  indicating that it really meant to put both 0x80040000
  693: 			 *  and 0x80040001 into the first LINEAR_A entry.
  694: 			 *
  695: 			 *  The first guess would be a bug in the implementation of
  696: 			 *  one or more instructions in the emulator while coming up
  697: 			 *  with those values, but debugging the PROM so far has NOT
  698: 			 *  revealed any such bug. It may even be that the PROM code
  699: 			 *  is buggy (?) and never really set the LINEAR entries
  700: 			 *  correctly. Perhaps the hardware simply ignores the
  701: 			 *  weird values and does not fill it (using the MTE)
  702: 			 *  when asked to.
  703: 			 */
  704: 			// printf("CRIME_RE_LINEAR_A IDATA = %016llx\n", (long long)idata);
  705: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  706: 			d->re_linear_a[tlbi] = idata >> 32ULL;
  707: 			d->re_linear_a[tlbi+1] = idata;
  708: 			debug("[ d->re_linear_a[%i] = 0x%08x, [%i] = 0x%08x ]\n",
  709: 				tlbi, d->re_linear_a[tlbi], tlbi+1, d->re_linear_a[tlbi+1]);
  710: 		} else {
  711: 			/*
  712: 			 *  #513: ACCEPT -- the inverse of the fixed-arity write
  713: 			 *  directly above.  See CRIME_RE_TLB_A for the odata note.
  714: 			 *
  715: 			 *  The [tlbi+1] here has the SAME exposure as the write's
  716: 			 *  [tlbi+1] and no more, which is `sgilinearoob'.
  717: 			 *
  718: 			 *  *** AN EARLIER WORDING OF THIS SENTENCE SAID THE TWO ARE
  719: 			 *  "bounded only by the len == 8 guard keeping tlbi even".
  720: 			 *  THAT IS FALSE: WIDTH DOES NOT IMPLY ALIGNMENT.  The guard
  721: 			 *  tests LENGTH.  What keeps tlbi even is the CPU-side
  722: 			 *  alignment described at the write arm above -- ld/sd raise
  723: 			 *  ADES/ADEL before memory_rw, and the unaligned helper masks
  724: 			 *  the address itself.  Corrected on this round's pass 2;
  725: 			 *  the older surrounding comment had it right and my new one
  726: 			 *  did not. ***  This fix
  727: 			 *  deliberately does NOT add a clamp -- an unlicensed addition
  728: 			 *  here would change the index behaviour that sgilinearoob is
  729: 			 *  filed to fix across all five arms with ONE design.
  730: 			 */
  731: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  732: 			odata = ((uint64_t) d->re_linear_a[tlbi] << 32)
  733: 			    | d->re_linear_a[tlbi+1];
  734: 		}
  735: 	} else if (relative_addr >= CRIME_RE_LINEAR_B && relative_addr < CRIME_RE_LINEAR_B + 0x80) {
  736: 		if (len != 8) {
  737: 			/*
  738: 			 *  #497: THIS GUARD IS ALSO THE ONLY BOUNDS CHECK.  Unlike the
  739: 			 *  TLB/TEX arms, the store below is FIXED ARITY -- it ignores len
  740: 			 *  and always writes [tlbi] and [tlbi+1].  tlbi is
  741: 			 *  ((relative_addr & 0x7f) >> 2) & 0x1f, so it reaches 31 and
  742: 			 *  [tlbi+1] indexes 32 of a [32] array.  Only 8-byte ALIGNMENT
  743: 			 *  keeps tlbi even and thus <= 30.  On the GUEST paths that
  744: 			 *  alignment is supplied by two independent mechanisms, and both
  745: 			 *  were checked rather than assumed:
  746: 			 *    - an ordinary ld/sd tests addr & (LS_SIZE-1) and raises
  747: 			 *      ADES/ADEL WITHOUT calling memory_rw at all
  748: 			 *      (cpus/cpu_mips_instr_loadstore.c);
  749: 			 *    - the unaligned ldl/ldr/sdl/sdr helper masks the address
  750: 			 *      itself -- cpus/cpu_mips_instr_unaligned.c computes
  751: 			 *      aligned_addr = addr & ~(wlen-1) and passes THAT to all
  752: 			 *      three of its memory_rw calls, so it cannot deliver an
  753: 			 *      unaligned len == 8 either.
  754: 			 *  Narrower accesses carry len != 8 and are declined above, and
  755: 			 *  dev_sgi_re_init is called only from machines/machine_sgi.c,
  756: 			 *  so no other CPU family reaches this handler.
  757: 			 *
  758: 			 *  ONE EXCEPTION, AND IT IS NOT A GUEST PATH: the host debugger's
  759: 			 *  `put d' prints "WARNING: address isn't aligned" and then
  760: 			 *  PROCEEDS -- the warning is a printf, not a guard -- so it can
  761: 			 *  hand an unaligned len == 8 straight to memory_rw.  That is why
  762: 			 *  the invariant above is stated for GUEST paths only.  It also
  763: 			 *  means `put d' must NOT be used to "witness" the over-run:
  764: 			 *  it bypasses the guest instruction path, so a reproduction
  765: 			 *  built on it would be laundering rather than witnessing.
  766: 			 *  The over-run itself stays filed as sgilinearoob, and it is
  767: 			 *  NOT guest-reachable while this guard stands.
  768: 			 *
  769: 			 *  Measured, not assumed: the over-run stays INSIDE the struct --
  770: 			 *  re_linear_a[32] IS re_linear_b[0] and re_linear_b[32] IS
  771: 			 *  de_reg[0] (offsetof: 1760/1888/2016).  So this is undefined
  772: 			 *  behaviour and a SILENT clobber of the adjacent register array,
  773: 			 *  reaching a DRAWING-engine register from a rendering-engine
  774: 			 *  write -- not a wild write outside the allocation, and not
  775: 			 *  something plain ASAN would flag.  Declining keeps it shut.
  776: 			 */
  777: 			if (!(d->warned & SGIRE_W_LINB_LEN)) {
  778: 				d->warned |= SGIRE_W_LINB_LEN;
  779: 				fatal("[ sgi_re: unimplemented len=%i for "
  780: 				    "CRIME_RE_LINEAR_B -- declined.  (once) ]\n",
  781: 				    (int) len);
  782: 			}
  783: 		} else if (writeflag == MEM_WRITE) {
  784: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  785: 			d->re_linear_b[tlbi] = idata >> 32ULL;
  786: 			d->re_linear_b[tlbi+1] = idata;
  787: 			debug("[ d->re_linear_b[%i] = 0x%08x, [%i] = 0x%08x ]\n",
  788: 				tlbi, d->re_linear_b[tlbi], tlbi+1, d->re_linear_b[tlbi+1]);
  789: 		} else {
  790: 			/*
  791: 			 *  #513: ACCEPT -- the inverse of the fixed-arity write
  792: 			 *  directly above.  See CRIME_RE_TLB_A for the odata note.
  793: 			 *
  794: 			 *  The [tlbi+1] here has the SAME exposure as the write's
  795: 			 *  [tlbi+1] and no more, which is `sgilinearoob'.
  796: 			 *
  797: 			 *  *** AN EARLIER WORDING OF THIS SENTENCE SAID THE TWO ARE
  798: 			 *  "bounded only by the len == 8 guard keeping tlbi even".
  799: 			 *  THAT IS FALSE: WIDTH DOES NOT IMPLY ALIGNMENT.  The guard
  800: 			 *  tests LENGTH.  What keeps tlbi even is the CPU-side
  801: 			 *  alignment described at the write arm above -- ld/sd raise
  802: 			 *  ADES/ADEL before memory_rw, and the unaligned helper masks
  803: 			 *  the address itself.  Corrected on this round's pass 2;
  804: 			 *  the older surrounding comment had it right and my new one
  805: 			 *  did not. ***  This fix
  806: 			 *  deliberately does NOT add a clamp -- an unlicensed addition
  807: 			 *  here would change the index behaviour that sgilinearoob is
  808: 			 *  filed to fix across all five arms with ONE design.
  809: 			 */
  810: 			int tlbi = ((relative_addr & 0x7f) >> 2) & 0x1f;
  811: 			odata = ((uint64_t) d->re_linear_b[tlbi] << 32)
  812: 			    | d->re_linear_b[tlbi+1];
  813: 		}
  814: 	} else {
  815: 		if (writeflag == MEM_WRITE) {
  816: 			if (!(d->warned & SGIRE_W_UNMAP_WR)) {
  817: 				d->warned |= SGIRE_W_UNMAP_WR;
  818: 				fatal("[ sgi_re: unimplemented write to "
  819: 				    "address 0x%llx, data=0x%016llx -- "
  820: 				    "declined.  (once) ]\n",
  821: 				    (long long)relative_addr, (long long)idata);
  822: 			}
  823: 		} else {
  824: 			if (!(d->warned & SGIRE_W_UNMAP_RD)) {
  825: 				d->warned |= SGIRE_W_UNMAP_RD;
  826: 				fatal("[ sgi_re: unimplemented read from address"
  827: 				    " 0x%llx -- declined.  (once) ]\n",
  828: 				    (long long)relative_addr);
  829: 			}
  830: 		}
  831: 	}
  832: 
  833: 	if (writeflag == MEM_READ)
  834: 		memory_writemax64(cpu, data, len, odata);
  835: 
  836: 	return 1;
  837: }
  838: 
  839: 
  840: /*
  841:  *  dev_sgi_re_init():
  842:  */
  843: void dev_sgi_re_init(struct machine *machine, struct memory *mem, uint64_t baseaddr)
  844: {
  845: 	struct sgi_re_data *d;
  846: 
  847: 	CHECK_ALLOCATION(d = (struct sgi_re_data *) malloc(sizeof(struct sgi_re_data)));
  848: 	memset(d, 0, sizeof(struct sgi_re_data));
  849: 
  850: 	memory_device_register(mem, "sgi_re", baseaddr + 0x1000, DEV_SGI_RE_LENGTH,
  851: 	    dev_sgi_re_access, d, DM_DEFAULT, NULL);
  852: 
  853: 	dev_sgi_de_init(mem, baseaddr + 0x2000, d);
  854: 	dev_sgi_mte_init(mem, baseaddr + 0x3000, d);
  855: 	dev_sgi_de_status_init(mem, baseaddr + 0x4000, d);
  856: }
  857: 
  858: 
  859: 
  860: /****************************************************************************/
  861: 
  862: /*
  863:  *  SGI "de", NetBSD sources describes it as a "drawing engine".
  864:  */
  865: 
  866: void draw_primitive(struct cpu* cpu, struct sgi_re_data *d)
  867: {
  868: 	uint32_t op = d->de_reg[(CRIME_DE_PRIMITIVE - 0x2000) / sizeof(uint32_t)];
  869: 	uint32_t drawmode = d->de_reg[(CRIME_DE_DRAWMODE - 0x2000) / sizeof(uint32_t)];
  870: 	uint32_t dst_mode = d->de_reg[(CRIME_DE_MODE_DST - 0x2000) / sizeof(uint32_t)];
  871: 	uint32_t src_mode = d->de_reg[(CRIME_DE_MODE_SRC - 0x2000) / sizeof(uint32_t)];
  872: 	uint32_t fg = d->de_reg[(CRIME_DE_FG - 0x2000) / sizeof(uint32_t)];
  873: 	uint32_t bg = d->de_reg[(CRIME_DE_BG - 0x2000) / sizeof(uint32_t)];
  874: 	uint32_t rop = d->de_reg[(CRIME_DE_ROP - 0x2000) / sizeof(uint32_t)];
  875: 
  876: 	uint32_t stipple_mode = d->de_reg[(CRIME_DE_STIPPLE_MODE - 0x2000) / sizeof(uint32_t)];
  877: 	uint32_t pattern = d->de_reg[(CRIME_DE_STIPPLE_PAT - 0x2000) / sizeof(uint32_t)];  889: 	uint32_t x1 = (d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;  908: 		uint32_t addr_src = d->de_reg[(CRIME_DE_XFER_ADDR_SRC - 0x2000) / sizeof(uint32_t)];  909: 		uint32_t strd_src = d->de_reg[(CRIME_DE_XFER_STRD_SRC - 0x2000) / sizeof(uint32_t)];
  910: 		step_x = d->de_reg[(CRIME_DE_XFER_STEP_X - 0x2000) / sizeof(uint32_t)];
  911: 		int32_t step_y = d->de_reg[(CRIME_DE_XFER_STEP_Y - 0x2000) / sizeof(uint32_t)];
  912: 		uint32_t addr_dst = d->de_reg[(CRIME_DE_XFER_ADDR_DST - 0x2000) / sizeof(uint32_t)];
  913: 		uint32_t strd_dst = d->de_reg[(CRIME_DE_XFER_STRD_DST - 0x2000) / sizeof(uint32_t)];
  914: 
  915: 		src_is_linear = ((src_mode & 0x00001c00) >> 10) > 3;
  916: 
  917: 		if (src_is_linear) {
  918: 			src_x = addr_src;
  919: 			src_y = 0;
  920: 		} else {
  921: 			src_x = (addr_src >> 16) & 0x7ff;
  922: 			src_y = addr_src & 0x7ff;
  923: 		}
  924: 
  925: 		if (step_x != src_bufdepth || (step_y != 0 && step_y != 1)) {
  926: 			fatal("[ sgi_de: unimplemented XFER addr_src=0x%x src_bufdepth=%i "
  927: 				"strd_src=0x%x step_x=0x%x step_y=0x%x "
  928: 				"addr_dst=0x%x strd_dst=0x%x ]\n",
  929: 				addr_src, src_bufdepth, strd_src, step_x, step_y, addr_dst, strd_dst);
  930: 
  931: 			// exit(1);
  932: 		}
  933: 	}
  934: 
  935: 	if (!(drawmode & DE_DRAWMODE_PLANEMASK)) {
  936: 		printf("!DE_DRAWMODE_PLANEMASK: TODO\n");
  937: 	}
  938: 	
  939: 	if ((drawmode & DE_DRAWMODE_BYTEMASK) != DE_DRAWMODE_BYTEMASK) {
  940: 		printf("not all DE_DRAWMODE_BYTEMASK set: TODO\n");
  941: 	}
  942: 	
  943: 	// primitive rendering direction (not for Lines? and presumably
  944: 	// not for Points either :-)
  945: 	int dx = op & DE_PRIM_RL ? -1 :  1;
  946: 	int dy = op & DE_PRIM_TB ?  1 : -1;
  947: 
  948: 	uint16_t saved_src_x = src_x;
  949: 
  950: 	/*
  951: 	 *  Drawing is limited to 2048 x 2048 pixel space.
  952: 	 *
  953: 	 *  TODO: MAYBE it is really -2048 to 2027, i.e. 12 bits of
  954: 	 *  pixel space. Perhaps it is possible to figure out
  955: 	 *  experimentally some day, e.g. by drawing lines from
  956: 	 *  -10,10 to 500,20 and see whether the real hardware
  957: 	 *  interprets -10 as -10 or 0x800 - 10.
  958: 	 */
  959: 	uint16_t endx = (x2 + dx) & 0x7ff;
  960: 	uint16_t endy = (y2 + dy) & 0x7ff;
  961: 
  962: 	int lx = abs((int)(x2 - x1)), ly = abs((int)(y2 - y1));
  963: 	int linelen = lx > ly ? lx : ly;
  964: 
  965: 	switch (op & 0xff000000) {
  966: 	case DE_PRIM_LINE:
  967: 		if (drawmode & DE_DRAWMODE_XFER_EN)
  968: 			fatal("[ sgi_de: XFER_EN for LINE op? ]\n");
  969: 
  970: 		// The PROM uses width 32, but NetBSD documents it as "half pixels".
  971: 		// if ((op & DE_PRIM_LINE_WIDTH_MASK) != 2)
  972: 		//	fatal("[ sgi_de: LINE_WIDTH_MASK = %i ]\n", op & DE_PRIM_LINE_WIDTH_MASK);
  973: 
  974: 		if (linelen == 0)
  975: 			linelen ++;
  976: 
  977: 		for (int i = 0; i < ((op & DE_PRIM_LINE_SKIP_END)? linelen : linelen+1); ++i) {
  978: 			x = (x2 * i + x1 * (linelen-i)) / linelen;
  979: 			y = (y2 * i + y1 * (linelen-i)) / linelen;
  980: 
  981: 			uint32_t color = fg;
  982: 			uint32_t oldcolor = fg;
  983: 
  984: 			if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
  985: 				horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
  986: 
  987: 			int draw = 1;
  988: 			if (drawmode & DE_DRAWMODE_LINE_STIP) {
  989: 				if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
  990: 					color = (pattern & 0x80000000UL) ? fg : bg;
  991: 				else
  992: 					draw = (pattern & 0x80000000UL)? 1 : 0;
  993: 			}
  994: 
  995: 			// Raster-OP.
  996: 			// TODO: Other ops.
  997: 			// TODO: Should this be before or after other things?
  998: 			if (drawmode & DE_DRAWMODE_ROP) {
  999: 				switch (rop) {
 1000: 				case OPENGL_LOGIC_OP_COPY:
 1001: 					// color = color;
 1002: 					break;
 1003: 				case OPENGL_LOGIC_OP_XOR:
 1004: 					color = oldcolor ^ color;
 1005: 					break;
 1006: 				case OPENGL_LOGIC_OP_COPY_INVERTED:
 1007: 					color = 0xffffffff - oldcolor;
 1008: 					break;
 1009: 				default:{
 1010: 						static char rop_used[256];
 1011: 						static int first = 1;
 1012: 
 1013: 						if (first) {
 1014: 							memset(rop_used, 0, sizeof(rop_used));
 1015: 							first = 0;
 1016: 						}
 1017: 
 1018: 						if (!rop_used[rop & 255]) {
 1019: 							rop_used[rop & 255] = 1;
 1020: 							fatal("[ sgi_de: LINE: rop[0x%02x] used! ]\n", rop & 255);
 1021: 						}
 1022: 
 1023: 						if (rop >> 8) {
 1024: 							fatal("[ sgi_de: LINE: rop > 255: 0x%08x ]\n", rop);
 1025: 						}
 1026: 					}
 1027: 				}
 1028: 			}
 1029: 
 1030: 			if (draw)
 1031: 				horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
 1032: 
 1033: 			// Rotate the stipple pattern:
 1034: 			pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
 1035: 		}
 1036: 		break;
 1037: 
 1038: 	case DE_PRIM_RECTANGLE:
 1039: 		for (y = y1; y != endy; y = (y + dy) & 0x7ff) {
 1040: 			src_x = saved_src_x;
 1041: 			for (x = x1; x != endx; x = (x + dx) & 0x7ff) {
 1042: 				uint32_t color = fg;
 1043: 				uint32_t oldcolor = fg;
 1044: 
 1045: 				if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
 1046: 					horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
 1047: 
 1048: 				// Pixel colors copied from another source.
 1049: 				// (OpenBSD draws characters using this mechanism.)
 1050: 				if (drawmode & DE_DRAWMODE_XFER_EN)
 1051: 					horrible_getputpixel(0, cpu, d,	src_x, src_y, &color, src_mode);
 1052: 
 1053: 				int draw = 1;
 1054: 				if (drawmode & DE_DRAWMODE_POLY_STIP) {
 1055: 					if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
 1056: 						color = (pattern & 0x80000000UL) ? fg : bg;
 1057: 					else
 1058: 						draw = (pattern & 0x80000000UL)? 1 : 0;
 1059: 				}
 1060: 
 1061: 				// Raster-OP.
 1062: 				// TODO: Other ops.
 1063: 				// TODO: Should this be before or after other things?
 1064: 				if (drawmode & DE_DRAWMODE_ROP) {
 1065: 					switch (rop) {
 1066: 					case OPENGL_LOGIC_OP_COPY:
 1067: 						// color = color;
 1068: 						break;
 1069: 					case OPENGL_LOGIC_OP_XOR:
 1070: 						color = oldcolor ^ color;
 1071: 						break;
 1072: 					case OPENGL_LOGIC_OP_COPY_INVERTED:
 1073: 						color = 0xffffffff - oldcolor;
 1074: 						break;
 1075: 					default:{
 1076: 							static char rop_used[256];
 1077: 							static int first = 1;
 1078: 
 1079: 							if (first) {
 1080: 								memset(rop_used, 0, sizeof(rop_used));
 1081: 								first = 0;
 1082: 							}
 1083: 
 1084: 							if (!rop_used[rop & 255]) {
 1085: 								rop_used[rop & 255] = 1;
 1086: 								fatal("[ sgi_de: RECT: rop[0x%02x] used! ]\n", rop & 255);
 1087: 							}
 1088: 
 1089: 							if (rop >> 8) {
 1090: 								fatal("[ sgi_de: RECT: rop > 255: 0x%08x ]\n", rop);
 1091: 							}
 1092: 						}
 1093: 					}
 1094: 				}
 1095: 
 1096: 				if (draw)
 1097: 					horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
 1098: 
 1099: 				// Rotate the stipple pattern:
 1100: 				pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
 1101: 
 1102: 				if (src_is_linear)
 1103: 					src_x += step_x;
 1104: 				else
 1105: 					src_x = (src_x + dx) & 0x7ff;
 1106: 			}
 1107: 			
 1108: 			src_y = (src_y + dy) & 0x7ff;
 1109: 		}
 1110: 		break;
 1111: 
 1112: 	default:
 1113: 		/*  #500: a GUEST-WRITTEN drawing op ended the host process.
 1114: 		    The switch discriminates on the TOP BYTE only, so the domain
 1115: 		    is 256 values and only two are implemented -- DE_PRIM_LINE
 1116: 		    (0x01) and DE_PRIM_RECTANGLE (0x03).
 1117: 
 1118: 		    *** THE TWO KILLERS THAT MATTER ARE NOT EXOTIC VALUES: THEY
 1119: 		    ARE NAMED PRIMITIVES, AND ONE OF THEM IS THE RESET STATE. ***
 1120: 		    crmfbreg.h defines them as FULL 32-BIT VALUES, not top-byte
 1121: 		    indices: DE_PRIM_POINT 0x00000000, LINE 0x01000000,
 1122: 		    TRIANGLE 0x02000000, RECTANGLE 0x03000000.  Writing them
 1123: 		    as "0x01" invites a `case 0x02:' that can NEVER match,
 1124: 		    since the switch compares `op & 0xff000000'.  POINT and
 1125: 		    TRIANGLE land
 1126: 		    here.  And dev_sgi_re_init memsets the whole device struct,
 1127: 		    so CRIME_DE_PRIMITIVE reads 0 -- which IS POINT -- until a
 1128: 		    guest writes it.  A guest that sets the START bit having
 1129: 		    never written the primitive register at all therefore died
 1130: 		    here.  It need not choose a bad value; it need only omit a
 1131: 		    good one.
 1132: 
 1133: 		    Now a LATCHED DECLINE that falls out of the switch and
 1134: 		    returns.  The diagnostic is kept in full -- it names the op
 1135: 		    and the vertices, which is what a maintainer implementing
 1136: 		    the primitive would want -- and gains `-- declined.  (once)'
 1137: 		    so it cannot be mistaken for the old host kill and cannot
 1138: 		    flood a guest loop.  */
 1139: 		if (!(d->warned & SGIRE_W_PRIM_OP)) {
 1140: 			d->warned |= SGIRE_W_PRIM_OP;
 1141: 			fatal("[ sgi_de: UNIMPLEMENTED drawing op = 0x%08x,"
 1142: 			    " x1=%i y1=%i x2=%i y2=%i fg=0x%x bg=0x%x"
 1143: 			    " pattern=0x%08x -- declined.  (once) ]\n",
 1144: 			    op, x1, y1, x2, y2, fg, bg, pattern);
 1145: 		}
 1146: 		break;
 1147: 	}
 1148: }
 1149: 
 1150: DEVICE_ACCESS(sgi_de)
 1151: {
 1152: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
 1153: 	uint64_t idata = 0, odata = 0;
 1154: 	int regnr;
 1155: 	int startFlag = relative_addr & CRIME_DE_START;
 1156: 
 1157: 	relative_addr &= ~CRIME_DE_START;
 1158: 
 1159: 	idata = memory_readmax64(cpu, data, len);
 1160: 	regnr = relative_addr / sizeof(uint32_t);
 1161: 
 1162: 	relative_addr += 0x2000;
 1163: 
 1164: 	/*
 1165: 	 *  Treat all registers as read/write, by default.  Sometimes these
 1166: 	 *  are accessed as 32-bit words, sometimes as 64-bit words to access
 1167: 	 *  two adjacent registers in one operation.
 1168: 	 */
 1169: 	if (len == 8) {
 1170: 		if (writeflag == MEM_WRITE) {
 1171: 			d->de_reg[regnr] = idata >> 32ULL;
 1172: 			d->de_reg[regnr+1] = idata;
 1173: 		} else
 1174: 			odata = ((uint64_t)d->de_reg[regnr] << 32ULL) +
 1175: 			    d->de_reg[regnr+1];
 1176: 	} else if (len == 4) {
 1177: 		if (writeflag == MEM_WRITE)
 1178: 			d->de_reg[regnr] = idata;
 1179: 		else
 1180: 			odata = d->de_reg[regnr];
 1181: 	} else {
 1182: 		/*
 1183: 		 *  #498: THIS USED TO END THE HOST PROCESS.  A guest choosing an
 1184: 		 *  access width is not an emulator error -- one `sb' anywhere in
 1185: 		 *  this 4 KB window did it.  Witnessed at rung 3 on an unmodified
 1186: 		 *  -E sgi -e ip32: sb, sh, lbu and lhu each gave exactly one
 1187: 		 *  "len = N not implemented" and exit(1), 4/4.
 1188: 		 *
 1189: 		 *  *** THE SHAPE IS NOT #497's SPLICE, AND THE DIFFERENCE IS
 1190: 		 *  MEASURED, NOT STYLISTIC. ***  #497's tail only answered a read.
 1191: 		 *  THIS function's tail also calls draw_primitive() when the guest
 1192: 		 *  set CRIME_DE_START, so falling through would run a rendering
 1193: 		 *  primitive for an access we just refused.
 1194: 		 *
 1195: 		 *  Clearing startFlag and falling through -- the obvious repair --
 1196: 		 *  scores 24/25: the declined access still reaches the switch
 1197: 		 *  below, which announces e.g. "TODO: non-zero CRIME_DE_SCISSOR"
 1198: 		 *  about a write THAT NEVER HAPPENED, from an idata this arm
 1199: 		 *  discarded.  Shipping a wrong record inside a diagnostic is the
 1200: 		 *  same class the ACCEPT member of the option set was found
 1201: 		 *  through.  The goto form scores 25/25.
 1202: 		 *
 1203: 		 *  `goto <label>' to a common exit is house idiom, not an
 1204: 		 *  invention: 10 device files use goto and 8 of those use it
 1205: 		 *  inside a DEVICE_ACCESS body (dc7085, i80321, le, mk48txx,
 1206: 		 *  ne2000, pvr, vr41xx, wdc).
 1207: 		 *
 1208: 		 *  It is not an early `return' either.  Control still reaches the
 1209: 		 *  common exit, so a declined READ is answered with odata (0) via
 1210: 		 *  memory_writemax64 and the function still returns 1.  `return 0'
 1211: 		 *  would be coerced to -1 by cpus/memory_rw.c and raise
 1212: 		 *  EXCEPTION_DBE -- turning a refusal into a guest bus error.
 1213: 		 */
 1214: 		if (!(d->warned & SGIRE_W_DE_LEN)) {
 1215: 			d->warned |= SGIRE_W_DE_LEN;
 1216: 			fatal("[ sgi_de: unimplemented len=%i -- declined."
 1217: 			    "  (once) ]\n", (int) len);
 1218: 		}
 1219: 		goto de_declined;
 1220: 	}
 1221: 
 1222: 	switch (relative_addr) {
 1223: 
 1224: 	case CRIME_DE_MODE_SRC:
 1225: 		debug("[ sgi_de: %s CRIME_DE_MODE_SRC: 0x%016llx ]\n",
 1226: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1227: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1228: 		break;
 1229: 
 1230: 	case CRIME_DE_MODE_DST:
 1231: 		debug("[ sgi_de: %s CRIME_DE_MODE_DST: 0x%016llx ]\n",
 1232: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1233: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1234: 		break;
 1235: 
 1236: 	case CRIME_DE_CLIPMODE:
 1237: 		debug("[ sgi_de: %s CRIME_DE_CLIPMODE: 0x%016llx ]\n",
 1238: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1239: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1240: 		if (writeflag == MEM_WRITE && idata != 0)
 1241: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_CLIPMODE: 0x%016llx ]\n", idata);
 1242: 		break;
 1243: 
 1244: 	case CRIME_DE_DRAWMODE:
 1245: 		debug("[ sgi_de: %s CRIME_DE_DRAWMODE: 0x%016llx ]\n",
 1246: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1247: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1248: 		break;
 1249: 
 1250: 	case CRIME_DE_SCRMASK0:
 1251: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK0: 0x%016llx ]\n",
 1252: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1253: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1254: 		if (writeflag == MEM_WRITE && idata != 0)
 1255: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK0: 0x%016llx ]\n", idata);
 1256: 		break;
 1257: 
 1258: 	case CRIME_DE_SCRMASK1:
 1259: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK1: 0x%016llx ]\n",
 1260: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1261: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1262: 		if (writeflag == MEM_WRITE && idata != 0)
 1263: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK1: 0x%016llx ]\n", idata);
 1264: 		break;
 1265: 
 1266: 	case CRIME_DE_SCRMASK2:
 1267: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK2: 0x%016llx ]\n",
 1268: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1269: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1270: 		if (writeflag == MEM_WRITE && idata != 0)
 1271: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK2: 0x%016llx ]\n", idata);
 1272: 		break;
 1273: 
 1274: 	case CRIME_DE_SCRMASK3:
 1275: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK3: 0x%016llx ]\n",
 1276: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1277: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1278: 		if (writeflag == MEM_WRITE && idata != 0)
 1279: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK3: 0x%016llx ]\n", idata);
 1280: 		break;
 1281: 
 1282: 	case CRIME_DE_SCRMASK4:
 1283: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK4: 0x%016llx ]\n",
 1284: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1285: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1286: 		if (writeflag == MEM_WRITE && idata != 0)
 1287: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK4: 0x%016llx ]\n", idata);
 1288: 		break;
 1289: 
 1290: 	case CRIME_DE_SCISSOR:
 1291: 		debug("[ sgi_de: %s CRIME_DE_SCISSOR: 0x%016llx ]\n",
 1292: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1293: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1294: 		if (writeflag == MEM_WRITE && idata != 0)
 1295: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCISSOR: 0x%016llx ]\n", idata);
 1296: 		break;
 1297: 
 1298: 	case CRIME_DE_SCISSOR + 4:
 1299: 		// NetBSD writes 0x3fff3fff here. "High" part of SCISSOR register?
 1300: 		debug("[ sgi_de: %s CRIME_DE_SCISSOR+4: 0x%016llx ]\n",
 1301: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1302: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1303: 		if (writeflag == MEM_WRITE && idata != 0x3fff3fff)
 1304: 			fatal("[ sgi_de: TODO: CRIME_DE_SCISSOR+4: 0x%016llx ]\n", idata);
 1305: 		break;
 1306: 
 1307: 	case CRIME_DE_PRIMITIVE:
 1308: 		debug("[ sgi_de: %s CRIME_DE_PRIMITIVE: 0x%016llx ]\n",
 1309: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1310: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1311: 		break;
 1312: 
 1313: 	case CRIME_DE_WINOFFSET_SRC:
 1314: 		debug("[ sgi_de: %s CRIME_DE_WINOFFSET_SRC: 0x%016llx ]\n",
 1315: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1316: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1317: 		if (writeflag == MEM_WRITE && idata != 0)
 1318: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_WINOFFSET_SRC: 0x%016llx ]\n", idata);
 1319: 		break;
 1320: 
 1321: 	case CRIME_DE_WINOFFSET_DST:
 1322: 		debug("[ sgi_de: %s CRIME_DE_WINOFFSET_DST: 0x%016llx ]\n",
 1323: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1324: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1325: 		if (writeflag == MEM_WRITE && idata != 0)
 1326: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_WINOFFSET_DST: 0x%016llx ]\n", idata);
 1327: 		break;
 1328: 
 1329: 	case CRIME_DE_X_VERTEX_0:
 1330: 		debug("[ sgi_de: %s CRIME_DE_X_VERTEX_0: 0x%016llx ]\n",
 1331: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1332: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1333: 		break;
 1334: 
 1335: 	case CRIME_DE_X_VERTEX_1:
 1336: 		debug("[ sgi_de: %s CRIME_DE_X_VERTEX_1: 0x%016llx ]\n",
 1337: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1338: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1339: 		break;
 1340: 
 1341: 	case CRIME_DE_XFER_ADDR_SRC:
 1342: 		debug("[ sgi_de: %s CRIME_DE_XFER_ADDR_SRC: 0x%016llx ]\n",
 1343: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1344: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1345: 		break;
 1346: 
 1347: 	case CRIME_DE_XFER_STRD_SRC:
 1348: 		debug("[ sgi_de: %s CRIME_DE_XFER_STRD_SRC: 0x%016llx ]\n",
 1349: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1350: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1351: 		break;
 1352: 
 1353: 	case CRIME_DE_XFER_STEP_X:
 1354: 		debug("[ sgi_de: %s CRIME_DE_XFER_STEP_X: 0x%016llx ]\n",
 1355: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1356: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1357: 		break;
 1358: 
 1359: 	case CRIME_DE_XFER_STEP_Y:
 1360: 		debug("[ sgi_de: %s CRIME_DE_XFER_STEP_Y: 0x%016llx ]\n",
 1361: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1362: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1363: 		break;
 1364: 
 1365: 	case CRIME_DE_XFER_ADDR_DST:
 1366: 		debug("[ sgi_de: %s CRIME_DE_XFER_ADDR_DST: 0x%016llx ]\n",
 1367: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1368: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1369: 		break;
 1370: 
 1371: 	case CRIME_DE_XFER_STRD_DST:
 1372: 		debug("[ sgi_de: %s CRIME_DE_XFER_STRD_DST: 0x%016llx ]\n",
 1373: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1374: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1375: 		break;
 1376: 
 1377: 	case CRIME_DE_STIPPLE_MODE:
 1378: 		debug("[ sgi_de: %s CRIME_DE_STIPPLE_MODE: 0x%016llx ]\n",
 1379: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1380: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1381: 		break;
 1382: 
 1383: 	case CRIME_DE_STIPPLE_PAT:
 1384: 		debug("[ sgi_de: %s CRIME_DE_STIPPLE_PAT: 0x%016llx ]\n",
 1385: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1386: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1387: 		break;
 1388: 
 1389: 	case CRIME_DE_FG:
 1390: 		debug("[ sgi_de: %s CRIME_DE_FG: 0x%016llx ]\n",
 1391: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1392: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1393: 		break;
 1394: 
 1395: 	case CRIME_DE_BG:
 1396: 		debug("[ sgi_de: %s CRIME_DE_BG: 0x%016llx ]\n",
 1397: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1398: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1399: 		break;
 1400: 
 1401: 	case CRIME_DE_ROP:
 1402: 		debug("[ sgi_de: %s CRIME_DE_ROP: 0x%016llx ]\n",
 1403: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1404: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1405: 		break;
 1406: 
 1407: 	case CRIME_DE_PLANEMASK:
 1408: 		debug("[ sgi_de: %s CRIME_DE_PLANEMASK: 0x%016llx ]\n",
 1409: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1410: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1411: 		break;
 1412: 
 1413: 	case CRIME_DE_NULL:
 1414: 		debug("[ sgi_de: %s CRIME_DE_NULL: 0x%016llx ]\n",
 1415: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1416: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1417: 		break;
 1418: 
 1419: 	case CRIME_DE_FLUSH:
 1420: 		debug("[ sgi_de: %s CRIME_DE_FLUSH: 0x%016llx ]\n",
 1421: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1422: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1423: 		break;
 1424: 
 1425: 	default:
 1426: 		if (writeflag == MEM_WRITE)
 1427: 			fatal("[ sgi_de: unimplemented write to "
 1428: 			    "address 0x%llx, data=0x%016llx ]\n",
 1429: 			    (long long)relative_addr, (long long)idata);
 1430: 		else
 1431: 			fatal("[ sgi_de: unimplemented read from address"
 1432: 			    " 0x%llx ]\n", (long long)relative_addr);
 1433: 	}
 1434: 
 1435: 	if (startFlag)
 1436: 		draw_primitive(cpu, d);
 1437: 
 1438:  de_declined:
 1439: 	/*  #498: a declined access jumps here, skipping BOTH the register
 1440: 	    switch and draw_primitive(), and is still answered.  */
 1441: 	if (writeflag == MEM_READ)
 1442: 		memory_writemax64(cpu, data, len, odata);
 1443: 
 1444: 	return 1;
 1445: }
 1446: 
 1447: 
 1448: /*
 1449:  *  dev_sgi_de_init():
 1450:  */
 1451: void dev_sgi_de_init(struct memory *mem, uint64_t baseaddr, struct sgi_re_data *d)
 1452: {
 1453: 	memory_device_register(mem, "sgi_de", baseaddr, DEV_SGI_DE_LENGTH,
 1454: 	    dev_sgi_de_access, (void *)d, DM_DEFAULT, NULL);
 1455: }
 1456: 
 1457: 
 1458: /****************************************************************************/
 1459: 
 1460: /*
 1461:  *  SGI "mte", NetBSD sources describes it as a "memory transfer engine".
 1462:  *
 1463:  *  If the relative address has the 0x0800 (CRIME_DE_START) flag set, it means
 1464:  *  "go ahead with the transfer". Otherwise, it is just reads and writes of the
 1465:  *  registers.
 1466:  */
 1467: 
 1468: void do_mte_transfer(struct cpu* cpu, struct sgi_re_data *d)
 1469: {
 1470: 	uint32_t mode = d->mte_reg[(CRIME_MTE_MODE - 0x3000) / sizeof(uint32_t)];
 1471: 	uint32_t src0 = d->mte_reg[(CRIME_MTE_SRC0 - 0x3000) / sizeof(uint32_t)];
 1472: 	uint32_t src1 = d->mte_reg[(CRIME_MTE_SRC1 - 0x3000) / sizeof(uint32_t)];
 1473: 	uint32_t dst0 = d->mte_reg[(CRIME_MTE_DST0 - 0x3000) / sizeof(uint32_t)];
 1474: 	uint32_t dst1 = d->mte_reg[(CRIME_MTE_DST1 - 0x3000) / sizeof(uint32_t)];
 1475: 	int32_t src_y_step = d->mte_reg[(CRIME_MTE_SRC_Y_STEP - 0x3000) / sizeof(uint32_t)];
 1476: 	int32_t dst_y_step = d->mte_reg[(CRIME_MTE_DST_Y_STEP - 0x3000) / sizeof(uint32_t)];
 1477: 	uint32_t dstlen = dst1 - dst0 + 1, fill_addr;
 1478: 	unsigned char zerobuf[4096];
 1479: 	int depth = 8 << ((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT);
 1480: 	int src = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
 1481: 	uint32_t bytemask = d->mte_reg[(CRIME_MTE_BYTEMASK - 0x3000) / sizeof(uint32_t)];
 1482: 	uint32_t bg = d->mte_reg[(CRIME_MTE_BG - 0x3000) / sizeof(uint32_t)];
 1483: 
 1484: 	debug("[ sgi_mte: STARTING: mode=0x%08x src0=0x%08x src1=0x%08x src_y_step=%i dst0=0x%08x,"
 1485: 	    " dst1=0x%08x dst_y_step=%i bg=0x%x bytemask=0x%x ]\n",
 1486: 	    mode,
 1487: 	    src0, src1, src_y_step,
 1488: 	    dst0, dst1, dst_y_step,
 1489: 	    bg, bytemask);
 1490: 
 1491: 	if (dst_y_step != 0 && dst_y_step != 1 && dst_y_step != -1) {
 1492: 		fatal("[ sgi_mte: TODO! unimplemented dst_y_step %i ]", dst_y_step);
 1493: 		// exit(1);
 1494: 	}
 1495: 
 1496: 	if (mode & MTE_MODE_STIPPLE) {
 1497: 		fatal("[ sgi_mte: unimplemented MTE_MODE_STIPPLE ]");
 1498: 		exit(1);
 1499: 	}
 1500: 
 1501: 	int src_tlb = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
 1502: 	int dst_tlb = (mode & MTE_MODE_DST_BUF_MASK) >> MTE_DST_TLB_SHIFT;
 1503: 	
 1504: 	if (src > MTE_TLB_C) {
 1505: 		fatal("[ sgi_mte: unimplemented SRC ]");
 1506: 		exit(1);
 1507: 	}
 1508: 
 1509: 	switch (dst_tlb) {
 1510: 	case MTE_TLB_A:
 1511: 	case MTE_TLB_B:
 1512: 	case MTE_TLB_C:
 1513: 		// Used by NetBSD's crmfb_fill_rect. It puts graphical
 1514: 		// coordinates in dst0 and dst1.
 1515: 		{
 1516: 			int x1 = (dst0 >> 16) & 0xfff;
 1517: 			int y1 = dst0 & 0xfff;
 1518: 			int x2 = (dst1 >> 16) & 0xfff;
 1519: 			int y2 = dst1 & 0xfff;
 1520: 			x1 /= (depth / 8);
 1521: 			x2 /= (depth / 8);
 1522: 
 1523: 			int src_x1 = (src0 >> 16) & 0xfff;
 1524: 			int src_y1 = src0 & 0xfff;
 1525: 			// int src_x2 = (src1 >> 16) & 0xfff;
 1526: 			// int src_y2 = src1 & 0xfff;
 1527: 			src_x1 /= (depth / 8);
 1528: 			// src_x2 /= (depth / 8);
 1529: 
 1530: 			int dx = x1 > x2 ? -1 : 1;
 1531: 			int dy = y1 > y2 ? -1 : 1;
 1532: 			
 1533: 			uint32_t src_mode = (src_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
 1534: 			uint32_t dst_mode = (dst_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
 1535: 
 1536: 			// Hack. The MTE perhaps doesn't deal with colors per se,
 1537: 			// but this makes sure that we copy 32 bits when doing 32-bit
 1538: 			// transfers.
 1539: 			/*  #509: was `depth == 4' -- UNREACHABLE.  `depth' is
 1540: 			    a count of BITS (8 << a two-bit field, so 8/16/32/64
 1541: 			    only); 4 is the corresponding BYTE count, which the
 1542: 			    author used correctly in the `/ (depth / 8)' lines
 1543: 			    just above.  So both assignments were dead, every
 1544: 			    tiled transfer took the CI arm, and at 32 bits CI
 1545: 			    assigns buf[0] alone while memory_rw copies four --
 1546: 			    publishing three bytes of host stack into guest
 1547: 			    memory.  The comment above states the intended
 1548: 			    condition in words: 32-bit transfers.
 1549: 
 1550: 			    This repairs the 32-bit cell ONLY.  The 16-bit and
 1551: 			    reserved-encoding-3 cells assign fewer bytes than
 1552: 			    they copy for the same reason and are NOT closed
 1553: 			    here -- see the uninitialised-buffer sibling.  */
 1554: 			if (depth == 32) {	/*  #509  */
 1555: 				src_mode |= DE_MODE_TYPE_RGBA;
 1556: 				dst_mode |= DE_MODE_TYPE_RGBA;
 1557: 			}
 1558: 
 1559: 			int src_y = src_y1;
 1560: 			for (int y = y1; y != y2+dy; y += dy) {
 1561: 				int src_x = src_x1;
 1562: 				
 1563: 				for  (int x = x1; x != x2+dx; x += dx) {
 1564: 					if (mode & MTE_MODE_COPY) {
 1565: 						horrible_getputpixel(0, cpu, d,
 1566: 							src_x, src_y, &bg, src_mode);
 1567: 						src_x += dx;
 1568: 					}
 1569: 
 1570: 					horrible_getputpixel(1, cpu, d, x, y, &bg, dst_mode);
 1571: 				}
 1572: 				
 1573: 				src_y += dy;
 1574: 			}
 1575: 		}
 1576: 		break;
 1577: 	case MTE_TLB_LIN_A:
 1578: 	case MTE_TLB_LIN_B:
 1579: 		// Used by the PROM to zero-fill memory (?).
 1580: 		if (mode & MTE_MODE_COPY) {
 1581: 			fatal("[ sgi_mte: unimplemented MTE_MODE_COPY ]");
 1582: 			exit(1);
 1583: 		}
 1584: 
 1585: 		if (depth != 8) {
 1586: 			fatal("[ sgi_mte: unimplemented MTE_DEPTH_x ]");
 1587: 			exit(1);
 1588: 		}
 1589: 
 1590: 		debug("[ sgi_mte: LINEAR TRANSFER: mode=0x%08x dst0=0x%016llx,"
 1591: 		    " dst1=0x%016llx (length 0x%llx), dst_y_step=%i bg=0x%x, bytemask=0x%x ]\n",
 1592: 		    mode,
 1593: 		    (long long)dst0, (long long)dst1,
 1594: 		    (long long)dstlen, dst_y_step, (int)bg, (int)bytemask);
 1595: 
 1596: 		if (bytemask != 0xffffffff) {
 1597: 			fatal("unimplemented MTE bytemask 0x%08x\n", (int)bytemask);
 1598: 			exit(1);
 1599: 		}
 1600: 
 1601: 		/*
 1602: 		 *  Horrible hack:
 1603: 		 *
 1604: 		 *  During bootup, the PROM fills memory at 0x40000000 and
 1605: 		 *  forward. This corresponds to the lowest possible RAM address.
 1606: 		 *  However, these fills are not going via the CPU's cache,
 1607: 		 *  which contains things such as the return address on the
 1608: 		 *  stack. If we _really_ write this data in the emulator (which
 1609: 		 *  doesn't emulate the cache), it would overwrite the stack.
 1610: 		 *
 1611: 		 *  So let's not.
 1612: 		 *
 1613: 		 *  (If some guest OS or firmware variant actually depends on
 1614: 		 *  the ability to write to the start of memory this way,
 1615: 		 *  it would not work in the emulator.)
 1616: 		 */
 1617: 		// if (dst0 >= 0x40000000 && dst0 < 0x40004000 && dst1 > 0x40004000) {
 1618: 		//	dst0 += 0x4000;
 1619: 		//	dstlen -= 0x4000;
 1620: 		// }
 1621: 
 1622: 		/*
 1623: 		 *  HUH?
 1624: 		 *
 1625: 		 *  Note that due to a bug (?) in the PROM firmware when it
 1626: 		 *  is setting up the TLB entries, only every _second_ page is
 1627: 		 *  actually put correctly in the TLB. This means that even
 1628: 		 *  though it then tries to fill 0x40000000 .. 0x40007fff with
 1629: 		 *  zeroes, it only fills 0x40001000 .. 0x40001fff,
 1630: 		 *  0x40003000 .. 0x40003fff and so on!
 1631: 		 *
 1632: 		 *  So the Horrible hack above is not needed.
 1633: 		 *
 1634: 		 *  Ironic.
 1635: 		 */
 1636: 
 1637: 		memset(zerobuf, bg, dstlen < sizeof(zerobuf) ? dstlen : sizeof(zerobuf));
 1638: 		fill_addr = dst0;
 1639: 		while (dstlen != 0) {
 1640: 			uint64_t fill_len;
 1641: 			if (dstlen > sizeof(zerobuf))
 1642: 				fill_len = sizeof(zerobuf);
 1643: 			else
 1644: 				fill_len = dstlen;
 1645: 
 1646: 			uint64_t starting_page = fill_addr & ~0xfff;
 1647: 			uint64_t ending_page = (fill_addr + fill_len - 1) & ~0xfff;
 1648: 			if (starting_page != ending_page) {
 1649: 				fill_len = starting_page + 4096 - fill_addr;
 1650: 			}
 1651: 
 1652: 			// Find starting_page in the TLB in question.
 1653: 			starting_page >>= 12;
 1654: 			uint32_t *tlb = dst_tlb == MTE_TLB_LIN_A ? d->re_linear_a : d->re_linear_b;
 1655: 			int match = 0;
 1656: 			for (int i = 0; i < 32; ++i) {
 1657: 				uint32_t entry = tlb[i];
 1658: 				if (entry & 0x80000000) {
 1659: 					entry &= ~0x80000000;
 1660: 					if (entry == starting_page) {
 1661: 						match = 1;
 1662: 						break;
 1663: 					}
 1664: 				}
 1665: 			}
 1666: 			
 1667: 			if (match) {
 1668: 				cpu->memory_rw(cpu, cpu->mem, fill_addr, zerobuf, fill_len,
 1669: 					MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
 1670: 			} else {
 1671: 				debug("[ sgi_mte: WARNING: address 0x%x not found in TLB? Ignoring fill. ]\n",
 1672: 					(long long)fill_addr);
 1673: 			}
 1674: 
 1675: 			fill_addr += fill_len;
 1676: 			dstlen -= (uint32_t)fill_len;	/* OB-23: subtract bytes actually filled */
 1677: 		}
 1678: 		break;
 1679: 	default:
 1680: 		fatal("[ sgi_mte: TODO! unimplemented dst_tlb 0x%x ]", dst_tlb);
 1681: 	}
 1682: }
 1683: 
 1684: DEVICE_ACCESS(sgi_mte)
 1685: {
 1686: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
 1687: 	uint64_t idata = 0, odata = 0;
 1688: 	int regnr;
 1689: 	int startFlag = relative_addr & CRIME_DE_START;
 1690: 
 1691: 	relative_addr &= ~CRIME_DE_START;
 1692: 
 1693: 	idata = memory_readmax64(cpu, data, len);
 1694: 	regnr = relative_addr / sizeof(uint32_t);
 1695: 
 1696: 	relative_addr += 0x3000;
 1697: 
 1698: 	/*
 1699: 	 *  Treat all registers as read/write, by default.  Sometimes these
 1700: 	 *  are accessed as 32-bit words, sometimes as 64-bit words.
 1701: 	 *
 1702: 	 *  NOTE: The lowest bits are internally stored in the "low" (+0)
 1703: 	 *  register, and the higher bits are stored in the "+1" word.
 1704: 	 */
 1705: 	if (len == 4) {
 1706: 		if (writeflag == MEM_WRITE)
 1707: 			d->mte_reg[regnr] = idata;
 1708: 		else
 1709: 			odata = d->mte_reg[regnr];
 1710: 	} else if (len != 4) {
 1711: 		if (writeflag == MEM_WRITE) {
 1712: 			d->mte_reg[regnr+1] = idata >> 32;
 1713: 			d->mte_reg[regnr] = idata;
 1714: 		} else {
 1715: 			odata = ((uint64_t)d->mte_reg[regnr+1] << 32) +
 1716: 			    d->mte_reg[regnr];
 1717: 		}
 1718: 	} else {
 1719: 		fatal("[ sgi_mte: UNIMPLEMENTED read/write len %i ]\n", len);
 1720: 		exit(1);
 1721: 	}
 1722: 
 1723: 	switch (relative_addr) {
 1724: 
 1725: 	case CRIME_MTE_MODE:
 1726: 		debug("[ sgi_mte: %s CRIME_MTE_MODE: 0x%016llx ]\n",
 1727: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1728: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1729: 		break;
 1730: 
 1731: 	case CRIME_MTE_BYTEMASK:
 1732: 		debug("[ sgi_mte: %s CRIME_MTE_BYTEMASK: 0x%016llx ]\n",
 1733: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1734: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1735: 		break;
 1736: 
 1737: 	case CRIME_MTE_STIPPLEMASK:
 1738: 		fatal("[ sgi_mte: %s CRIME_MTE_STIPPLEMASK: 0x%016llx ]\n",
 1739: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1740: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1741: 		break;
 1742: 
 1743: 	case CRIME_MTE_BG:
 1744: 		debug("[ sgi_mte: %s CRIME_MTE_BG: 0x%016llx ]\n",
 1745: 		    writeflag == MEM_WRITE ? "write to" : "read from",
 1746: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
 1747: 		break;
 1748: 
