               "at=0x%x" % ks,            "v0=0x%x" % SENTINEL]
            + run_ops([OP_SW_T0_A3, OP_SW_T1_A2, OP_LW_V0_AT], A.take(3))
            + ["print v0"])

A = Addr(CODE)
