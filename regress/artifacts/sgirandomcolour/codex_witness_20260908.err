src/machines/machine_sgi.c:491: 				dev_ram_init(machine, 0x50000000ULL, (machine->physical_ram_in_mb - 256) * 1048576, DEV_RAM_RAM, 0, NULL);
src/machines/machine_sgi.c:492: 		}
