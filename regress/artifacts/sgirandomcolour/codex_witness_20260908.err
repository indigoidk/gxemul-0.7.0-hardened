src/devices/dev_sgi_re.c:1796:  */
src/devices/dev_sgi_re.c:1797: 
src/devices/dev_sgi_re.c:1798: DEVICE_ACCESS(sgi_de_status)
src/devices/dev_sgi_re.c:1799: {
src/devices/dev_sgi_re.c:1800: 	// struct sgi_re_data *d = (struct sgi_re_data *) extra;
src/devices/dev_sgi_re.c:1801: 	uint64_t idata = 0, odata = 0;
src/devices/dev_sgi_re.c:1802: 
src/devices/dev_sgi_re.c:1803: 	idata = memory_readmax64(cpu, data, len);
src/devices/dev_sgi_re.c:1804: 
src/devices/dev_sgi_re.c:1805: 	relative_addr += 0x4000;
src/devices/dev_sgi_re.c:1806: 
src/devices/dev_sgi_re.c:1807: 	switch (relative_addr) {
src/devices/dev_sgi_re.c:1808: 
src/devices/dev_sgi_re.c:1809: 	case CRIME_DE_STATUS:	// 0x4000
src/devices/dev_sgi_re.c:1810: 		odata = CRIME_DE_IDLE |
src/devices/dev_sgi_re.c:1811: 			CRIME_DE_SETUP_IDLE |
src/devices/dev_sgi_re.c:1812: 			CRIME_DE_PIXPIPE_IDLE |
src/devices/dev_sgi_re.c:1813: 			CRIME_DE_MTE_IDLE;
src/devices/dev_sgi_re.c:1814: 
src/devices/dev_sgi_re.c:1815: 		/*
src/devices/dev_sgi_re.c:1816: 		 *  TODO: Actually simulate pipeline of a number of commands?
src/devices/dev_sgi_re.c:1817: 		 */
src/devices/dev_sgi_re.c:1818: 		break;
src/devices/dev_sgi_re.c:1819: 
src/devices/dev_sgi_re.c:1820: 	case 0x4008:
src/devices/dev_sgi_re.c:1821: 		/*  Unknown. Ignore for now.  */
src/devices/dev_sgi_re.c:1822: 		break;
src/devices/dev_sgi_re.c:1823: 
src/devices/dev_sgi_re.c:1824: 	default:
src/devices/dev_sgi_re.c:1825: 		if (writeflag == MEM_WRITE)
src/devices/dev_sgi_re.c:1826: 			debug("[ sgi_de_status: unimplemented write to "
src/devices/dev_sgi_re.c:1827: 			    "address 0x%llx, data=0x%016llx ]\n",
src/devices/dev_sgi_re.c:1828: 			    (long long)relative_addr, (long long)idata);
src/devices/dev_sgi_re.c:1829: 		else
src/devices/dev_sgi_re.c:1830: 			debug("[ sgi_de_status: unimplemented read from address"
src/devices/dev_sgi_re.c:1831: 			    " 0x%llx ]\n", (long long)relative_addr);
