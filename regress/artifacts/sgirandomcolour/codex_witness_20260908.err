src/devices/dev_sgi_re.c:1115: DEVICE_ACCESS(sgi_de)
src/devices/dev_sgi_re.c:1116: {
src/devices/dev_sgi_re.c:1117: 	struct sgi_re_data *d = (struct sgi_re_data *) extra;
src/devices/dev_sgi_re.c:1118: 	uint64_t idata = 0, odata = 0;
src/devices/dev_sgi_re.c:1119: 	int regnr;
src/devices/dev_sgi_re.c:1120: 	int startFlag = relative_addr & CRIME_DE_START;
src/devices/dev_sgi_re.c:1121: 
src/devices/dev_sgi_re.c:1122: 	relative_addr &= ~CRIME_DE_START;
src/devices/dev_sgi_re.c:1123: 
src/devices/dev_sgi_re.c:1124: 	idata = memory_readmax64(cpu, data, len);
src/devices/dev_sgi_re.c:1125: 	regnr = relative_addr / sizeof(uint32_t);
src/devices/dev_sgi_re.c:1126: 
src/devices/dev_sgi_re.c:1127: 	relative_addr += 0x2000;
src/devices/dev_sgi_re.c:1128: 
src/devices/dev_sgi_re.c:1129: 	/*
src/devices/dev_sgi_re.c:1130: 	 *  Treat all registers as read/write, by default.  Sometimes these
src/devices/dev_sgi_re.c:1131: 	 *  are accessed as 32-bit words, sometimes as 64-bit words to access
src/devices/dev_sgi_re.c:1132: 	 *  two adjacent registers in one operation.
src/devices/dev_sgi_re.c:1133: 	 */
src/devices/dev_sgi_re.c:1134: 	if (len == 8) {
src/devices/dev_sgi_re.c:1135: 		if (writeflag == MEM_WRITE) {
src/devices/dev_sgi_re.c:1136: 			d->de_reg[regnr] = idata >> 32ULL;
src/devices/dev_sgi_re.c:1137: 			d->de_reg[regnr+1] = idata;
src/devices/dev_sgi_re.c:1138: 		} else
src/devices/dev_sgi_re.c:1139: 			odata = ((uint64_t)d->de_reg[regnr] << 32ULL) +
src/devices/dev_sgi_re.c:1140: 			    d->de_reg[regnr+1];
src/devices/dev_sgi_re.c:1141: 	} else if (len == 4) {
src/devices/dev_sgi_re.c:1142: 		if (writeflag == MEM_WRITE)
src/devices/dev_sgi_re.c:1143: 			d->de_reg[regnr] = idata;
src/devices/dev_sgi_re.c:1144: 		else
src/devices/dev_sgi_re.c:1145: 			odata = d->de_reg[regnr];
src/devices/dev_sgi_re.c:1146: 	} else {
src/devices/dev_sgi_re.c:1147: 		/*
src/devices/dev_sgi_re.c:1148: 		 *  #498: THIS USED TO END THE HOST PROCESS.  A guest choosing an
src/devices/dev_sgi_re.c:1149: 		 *  access width is not an emulator error -- one `sb' anywhere in
src/devices/dev_sgi_re.c:1150: 		 *  this 4 KB window did it.  Witnessed at rung 3 on an unmodified
src/devices/dev_sgi_re.c:1151: 		 *  -E sgi -e ip32: sb, sh, lbu and lhu each gave exactly one
src/devices/dev_sgi_re.c:1152: 		 *  "len = N not implemented" and exit(1), 4/4.
src/devices/dev_sgi_re.c:1153: 		 *
src/devices/dev_sgi_re.c:1154: 		 *  *** THE SHAPE IS NOT #497's SPLICE, AND THE DIFFERENCE IS
src/devices/dev_sgi_re.c:1155: 		 *  MEASURED, NOT STYLISTIC. ***  #497's tail only answered a read.
src/devices/dev_sgi_re.c:1156: 		 *  THIS function's tail also calls draw_primitive() when the guest
src/devices/dev_sgi_re.c:1157: 		 *  set CRIME_DE_START, so falling through would run a rendering
src/devices/dev_sgi_re.c:1158: 		 *  primitive for an access we just refused.
src/devices/dev_sgi_re.c:1159: 		 *
src/devices/dev_sgi_re.c:1160: 		 *  Clearing startFlag and falling through -- the obvious repair --
src/devices/dev_sgi_re.c:1161: 		 *  scores 24/25: the declined access still reaches the switch
src/devices/dev_sgi_re.c:1162: 		 *  below, which announces e.g. "TODO: non-zero CRIME_DE_SCISSOR"
src/devices/dev_sgi_re.c:1163: 		 *  about a write THAT NEVER HAPPENED, from an idata this arm
src/devices/dev_sgi_re.c:1164: 		 *  discarded.  Shipping a wrong record inside a diagnostic is the
src/devices/dev_sgi_re.c:1165: 		 *  same class the ACCEPT member of the option set was found
src/devices/dev_sgi_re.c:1166: 		 *  through.  The goto form scores 25/25.
src/devices/dev_sgi_re.c:1167: 		 *
src/devices/dev_sgi_re.c:1168: 		 *  `goto <label>' to a common exit is house idiom, not an
src/devices/dev_sgi_re.c:1169: 		 *  invention: 10 device files use goto and 8 of those use it
src/devices/dev_sgi_re.c:1170: 		 *  inside a DEVICE_ACCESS body (dc7085, i80321, le, mk48txx,
src/devices/dev_sgi_re.c:1171: 		 *  ne2000, pvr, vr41xx, wdc).
src/devices/dev_sgi_re.c:1172: 		 *
src/devices/dev_sgi_re.c:1173: 		 *  It is not an early `return' either.  Control still reaches the
src/devices/dev_sgi_re.c:1174: 		 *  common exit, so a declined READ is answered with odata (0) via
src/devices/dev_sgi_re.c:1175: 		 *  memory_writemax64 and the function still returns 1.  `return 0'
src/devices/dev_sgi_re.c:1176: 		 *  would be coerced to -1 by cpus/memory_rw.c and raise
src/devices/dev_sgi_re.c:1177: 		 *  EXCEPTION_DBE -- turning a refusal into a guest bus error.
src/devices/dev_sgi_re.c:1178: 		 */
src/devices/dev_sgi_re.c:1179: 		if (!(d->warned & SGIRE_W_DE_LEN)) {
src/devices/dev_sgi_re.c:1180: 			d->warned |= SGIRE_W_DE_LEN;
src/devices/dev_sgi_re.c:1181: 			fatal("[ sgi_de: unimplemented len=%i -- declined."
src/devices/dev_sgi_re.c:1182: 			    "  (once) ]\n", (int) len);
src/devices/dev_sgi_re.c:1183: 		}
src/devices/dev_sgi_re.c:1184: 		goto de_declined;
src/devices/dev_sgi_re.c:1185: 	}
src/devices/dev_sgi_re.c:1186: 
src/devices/dev_sgi_re.c:1187: 	switch (relative_addr) {
src/devices/dev_sgi_re.c:1188: 
src/devices/dev_sgi_re.c:1189: 	case CRIME_DE_MODE_SRC:
src/devices/dev_sgi_re.c:1190: 		debug("[ sgi_de: %s CRIME_DE_MODE_SRC: 0x%016llx ]\n",
src/devices/dev_sgi_re.c:1191: 		    writeflag == MEM_WRITE ? "write to" : "read from",
src/devices/dev_sgi_re.c:1192: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
src/devices/dev_sgi_re.c:1193: 		break;
src/devices/dev_sgi_re.c:1194: 
src/devices/dev_sgi_re.c:1195: 	case CRIME_DE_MODE_DST:
src/devices/dev_sgi_re.c:1196: 		debug("[ sgi_de: %s CRIME_DE_MODE_DST: 0x%016llx ]\n",
src/devices/dev_sgi_re.c:1197: 		    writeflag == MEM_WRITE ? "write to" : "read from",
src/devices/dev_sgi_re.c:1198: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
src/devices/dev_sgi_re.c:1199: 		break;
src/devices/dev_sgi_re.c:1200: 
src/devices/dev_sgi_re.c:1201: 	case CRIME_DE_CLIPMODE:
src/devices/dev_sgi_re.c:1202: 		debug("[ sgi_de: %s CRIME_DE_CLIPMODE: 0x%016llx ]\n",
src/devices/dev_sgi_re.c:1203: 		    writeflag == MEM_WRITE ? "write to" : "read from",
src/devices/dev_sgi_re.c:1204: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
src/devices/dev_sgi_re.c:1205: 		if (writeflag == MEM_WRITE && idata != 0)
src/devices/dev_sgi_re.c:1206: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_CLIPMODE: 0x%016llx ]\n", idata);
src/devices/dev_sgi_re.c:1207: 		break;
src/devices/dev_sgi_re.c:1208: 
src/devices/dev_sgi_re.c:1209: 	case CRIME_DE_DRAWMODE:
src/devices/dev_sgi_re.c:1210: 		debug("[ sgi_de: %s CRIME_DE_DRAWMODE: 0x%016llx ]\n",
src/devices/dev_sgi_re.c:1211: 		    writeflag == MEM_WRITE ? "write to" : "read from",
src/devices/dev_sgi_re.c:1212: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
src/devices/dev_sgi_re.c:1213: 		break;
src/devices/dev_sgi_re.c:1214: 
src/devices/dev_sgi_re.c:1215: 	case CRIME_DE_SCRMASK0:
src/devices/dev_sgi_re.c:1216: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK0: 0x%016llx ]\n",
src/devices/dev_sgi_re.c:1217: 		    writeflag == MEM_WRITE ? "write to" : "read from",
src/devices/dev_sgi_re.c:1218: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
src/devices/dev_sgi_re.c:1219: 		if (writeflag == MEM_WRITE && idata != 0)
src/devices/dev_sgi_re.c:1220: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK0: 0x%016llx ]\n", idata);
src/devices/dev_sgi_re.c:1221: 		break;
src/devices/dev_sgi_re.c:1222: 
src/devices/dev_sgi_re.c:1223: 	case CRIME_DE_SCRMASK1:
src/devices/dev_sgi_re.c:1224: 		debug("[ sgi_de: %s CRIME_DE_SCRMASK1: 0x%016llx ]\n",
src/devices/dev_sgi_re.c:1225: 		    writeflag == MEM_WRITE ? "write to" : "read from",
src/devices/dev_sgi_re.c:1226: 		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
src/devices/dev_sgi_re.c:1227: 		if (writeflag == MEM_WRITE && idata != 0)
src/devices/dev_sgi_re.c:1228: 			fatal("[ sgi_de: TODO: non-zero CRIME_DE_SCRMASK1: 0x%016llx ]\n", idata);
src/devices/dev_sgi_re.c:1229: 		break;
