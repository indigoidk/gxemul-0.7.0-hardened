src/machines/machine_sgi.c:462: 		/*
src/machines/machine_sgi.c:463: 		 *  The IP32 prom probes "bank 0" with the following
src/machines/machine_sgi.c:464: 		 *  TLB entries:
src/machines/machine_sgi.c:465: 		 *
src/machines/machine_sgi.c:466: 		 *  00: vaddr=0000000000000000 (global):  p0=0x040000000 D p1=0x041000000 D (16MB)
src/machines/machine_sgi.c:467: 		 *  01: vaddr=0000000002000000 (global):  p0=0x042000000 D p1=0x043000000 D (16MB)
src/machines/machine_sgi.c:468: 		 *  02: vaddr=0000000004000000 (global):  p0=0x044000000 D p1=0x045000000 D (16MB)
src/machines/machine_sgi.c:469: 		 *  03: vaddr=0000000006000000 (global):  p0=0x046000000 D p1=0x047000000 D (16MB)
src/machines/machine_sgi.c:470: 		 *
src/machines/machine_sgi.c:471: 		 *  In other words, it uses real memory at 0x40000000 and up.
src/machines/machine_sgi.c:472: 		 *  However, it is _also_ accessible at physical address 0x0.
src/machines/machine_sgi.c:473: 		 *
src/machines/machine_sgi.c:474: 		 *  Max amount of RAM in an O2 is 1 GB. However, devices start at
src/machines/machine_sgi.c:475: 		 *  0x14000000 (or below that), so 256 MB is the most that the legacy GXemul
src/machines/machine_sgi.c:476: 		 *  framework can handle. Memory above that must be accessed from 0x40000000 and up.
src/machines/machine_sgi.c:477:  		 */
src/machines/machine_sgi.c:478: 
src/machines/machine_sgi.c:479: 		if (machine->physical_ram_in_mb > 1024) {
src/machines/machine_sgi.c:480: 			fatal("SGI O2 cannot have more than 1 GB of RAM.\n");
src/machines/machine_sgi.c:481: 			exit(1);
src/machines/machine_sgi.c:482: 		}
src/machines/machine_sgi.c:483: 
src/machines/machine_sgi.c:484: 		/*  In the new framework, this would be the other way around :-), i.e.
src/machines/machine_sgi.c:485: 		    actual memory at 0x40000000 and the first 256 MB would be mirrored
src/machines/machine_sgi.c:486: 		    to address 0.  */
src/machines/machine_sgi.c:487: 		{
src/machines/machine_sgi.c:488: 			int mirrorInMB = machine->physical_ram_in_mb < 256 ? machine->physical_ram_in_mb : 256;
src/machines/machine_sgi.c:489: 			dev_ram_init(machine, 0x40000000ULL, mirrorInMB * 1048576, DEV_RAM_MIRROR, 0, NULL);
