src/devices/dev_sgi_re.c:359: 			    as (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3],
src/devices/dev_sgi_re.c:360: 			    then CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
src/devices/dev_sgi_re.c:361: 			    31..24, 23..16 and 15..8 -- byte 0 is R and byte 3
src/devices/dev_sgi_re.c:362: 			    is UNUSED.  So the pad sits at buf[3] because the
src/devices/dev_sgi_re.c:363: 			    consumer ignores buf[3], not because PUT writes a
src/devices/dev_sgi_re.c:364: 			    zero there; that is what makes this non-circular.
src/devices/dev_sgi_re.c:365: 			    The RGBA and ABGR PUT arms independently agree --
src/devices/dev_sgi_re.c:366: 			    both lay [R,G,B,x] in memory despite opposite
src/devices/dev_sgi_re.c:367: 			    register word orders -- which leaves this GET the
src/devices/dev_sgi_re.c:368: 			    lone container outlier among the 32-bit arms.
src/devices/dev_sgi_re.c:369: 
src/devices/dev_sgi_re.c:370: 			    The low byte stays ZERO on purpose: RGB carries
src/devices/dev_sgi_re.c:371: 			    three channels, so a corrected read of 0xaabbccdd
src/devices/dev_sgi_re.c:372: 			    yields 0xaabbcc00, NOT the source word.  */
src/devices/dev_sgi_re.c:373: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
src/devices/dev_sgi_re.c:374: 			break;
src/devices/dev_sgi_re.c:375: 		case DE_MODE_TYPE_RGBA:
src/devices/dev_sgi_re.c:376: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
src/devices/dev_sgi_re.c:377: 			break;
src/devices/dev_sgi_re.c:378: 		case DE_MODE_TYPE_ABGR:
src/devices/dev_sgi_re.c:379: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
src/devices/dev_sgi_re.c:380: 			break;
src/devices/dev_sgi_re.c:381: 		default:// Read "raw" 32-bit value:
src/devices/dev_sgi_re.c:382: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
src/devices/dev_sgi_re.c:383: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
src/devices/dev_sgi_re.c:384: 		}
src/devices/dev_sgi_re.c:385: 	}
src/devices/dev_sgi_re.c:386: }
