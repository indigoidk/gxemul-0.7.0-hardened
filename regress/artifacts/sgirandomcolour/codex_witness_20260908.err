src/devices/dev_sgi_re.c:1425: /*
src/devices/dev_sgi_re.c:1426:  *  SGI "mte", NetBSD sources describes it as a "memory transfer engine".
src/devices/dev_sgi_re.c:1427:  *
src/devices/dev_sgi_re.c:1428:  *  If the relative address has the 0x0800 (CRIME_DE_START) flag set, it means
src/devices/dev_sgi_re.c:1429:  *  "go ahead with the transfer". Otherwise, it is just reads and writes of the
src/devices/dev_sgi_re.c:1430:  *  registers.
src/devices/dev_sgi_re.c:1433: void do_mte_transfer(struct cpu* cpu, struct sgi_re_data *d)
src/devices/dev_sgi_re.c:1434: {
src/devices/dev_sgi_re.c:1435: 	uint32_t mode = d->mte_reg[(CRIME_MTE_MODE - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1436: 	uint32_t src0 = d->mte_reg[(CRIME_MTE_SRC0 - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1437: 	uint32_t src1 = d->mte_reg[(CRIME_MTE_SRC1 - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1438: 	uint32_t dst0 = d->mte_reg[(CRIME_MTE_DST0 - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1439: 	uint32_t dst1 = d->mte_reg[(CRIME_MTE_DST1 - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1440: 	int32_t src_y_step = d->mte_reg[(CRIME_MTE_SRC_Y_STEP - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1441: 	int32_t dst_y_step = d->mte_reg[(CRIME_MTE_DST_Y_STEP - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1442: 	uint32_t dstlen = dst1 - dst0 + 1, fill_addr;
src/devices/dev_sgi_re.c:1443: 	unsigned char zerobuf[4096];
src/devices/dev_sgi_re.c:1444: 	int depth = 8 << ((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT);
src/devices/dev_sgi_re.c:1445: 	int src = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
src/devices/dev_sgi_re.c:1446: 	uint32_t bytemask = d->mte_reg[(CRIME_MTE_BYTEMASK - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1447: 	uint32_t bg = d->mte_reg[(CRIME_MTE_BG - 0x3000) / sizeof(uint32_t)];
src/devices/dev_sgi_re.c:1448: 
src/devices/dev_sgi_re.c:1449: 	debug("[ sgi_mte: STARTING: mode=0x%08x src0=0x%08x src1=0x%08x src_y_step=%i dst0=0x%08x,"
src/devices/dev_sgi_re.c:1450: 	    " dst1=0x%08x dst_y_step=%i bg=0x%x bytemask=0x%x ]\n",
src/devices/dev_sgi_re.c:1451: 	    mode,
src/devices/dev_sgi_re.c:1452: 	    src0, src1, src_y_step,
src/devices/dev_sgi_re.c:1453: 	    dst0, dst1, dst_y_step,
src/devices/dev_sgi_re.c:1454: 	    bg, bytemask);
src/devices/dev_sgi_re.c:1455: 
src/devices/dev_sgi_re.c:1456: 	if (dst_y_step != 0 && dst_y_step != 1 && dst_y_step != -1) {
src/devices/dev_sgi_re.c:1457: 		fatal("[ sgi_mte: TODO! unimplemented dst_y_step %i ]", dst_y_step);
src/devices/dev_sgi_re.c:1458: 		// exit(1);
src/devices/dev_sgi_re.c:1459: 	}
src/devices/dev_sgi_re.c:1460: 
src/devices/dev_sgi_re.c:1461: 	if (mode & MTE_MODE_STIPPLE) {
src/devices/dev_sgi_re.c:1462: 		fatal("[ sgi_mte: unimplemented MTE_MODE_STIPPLE ]");
src/devices/dev_sgi_re.c:1463: 		exit(1);
src/devices/dev_sgi_re.c:1464: 	}
src/devices/dev_sgi_re.c:1465: 
src/devices/dev_sgi_re.c:1466: 	int src_tlb = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
src/devices/dev_sgi_re.c:1467: 	int dst_tlb = (mode & MTE_MODE_DST_BUF_MASK) >> MTE_DST_TLB_SHIFT;
src/devices/dev_sgi_re.c:1468: 	
src/devices/dev_sgi_re.c:1469: 	if (src > MTE_TLB_C) {
src/devices/dev_sgi_re.c:1470: 		fatal("[ sgi_mte: unimplemented SRC ]");
src/devices/dev_sgi_re.c:1471: 		exit(1);
src/devices/dev_sgi_re.c:1472: 	}
src/devices/dev_sgi_re.c:1473: 
src/devices/dev_sgi_re.c:1474: 	switch (dst_tlb) {
src/devices/dev_sgi_re.c:1475: 	case MTE_TLB_A:
src/devices/dev_sgi_re.c:1476: 	case MTE_TLB_B:
src/devices/dev_sgi_re.c:1477: 	case MTE_TLB_C:
src/devices/dev_sgi_re.c:1478: 		// Used by NetBSD's crmfb_fill_rect. It puts graphical
src/devices/dev_sgi_re.c:1479: 		// coordinates in dst0 and dst1.
src/devices/dev_sgi_re.c:1480: 		{
src/devices/dev_sgi_re.c:1481: 			int x1 = (dst0 >> 16) & 0xfff;
src/devices/dev_sgi_re.c:1482: 			int y1 = dst0 & 0xfff;
src/devices/dev_sgi_re.c:1483: 			int x2 = (dst1 >> 16) & 0xfff;
src/devices/dev_sgi_re.c:1484: 			int y2 = dst1 & 0xfff;
src/devices/dev_sgi_re.c:1485: 			x1 /= (depth / 8);
src/devices/dev_sgi_re.c:1486: 			x2 /= (depth / 8);
src/devices/dev_sgi_re.c:1487: 
src/devices/dev_sgi_re.c:1488: 			int src_x1 = (src0 >> 16) & 0xfff;
src/devices/dev_sgi_re.c:1489: 			int src_y1 = src0 & 0xfff;
src/devices/dev_sgi_re.c:1490: 			// int src_x2 = (src1 >> 16) & 0xfff;
src/devices/dev_sgi_re.c:1491: 			// int src_y2 = src1 & 0xfff;
src/devices/dev_sgi_re.c:1492: 			src_x1 /= (depth / 8);
src/devices/dev_sgi_re.c:1493: 			// src_x2 /= (depth / 8);
src/devices/dev_sgi_re.c:1494: 
src/devices/dev_sgi_re.c:1495: 			int dx = x1 > x2 ? -1 : 1;
src/devices/dev_sgi_re.c:1496: 			int dy = y1 > y2 ? -1 : 1;
src/devices/dev_sgi_re.c:1497: 			
src/devices/dev_sgi_re.c:1498: 			uint32_t src_mode = (src_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
src/devices/dev_sgi_re.c:1499: 			uint32_t dst_mode = (dst_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
src/devices/dev_sgi_re.c:1500: 
src/devices/dev_sgi_re.c:1501: 			// Hack. The MTE perhaps doesn't deal with colors per se,
src/devices/dev_sgi_re.c:1502: 			// but this makes sure that we copy 32 bits when doing 32-bit
src/devices/dev_sgi_re.c:1503: 			// transfers.
src/devices/dev_sgi_re.c:1504: 			/*  #509: was `depth == 4' -- UNREACHABLE.  `depth' is
src/devices/dev_sgi_re.c:1505: 			    a count of BITS (8 << a two-bit field, so 8/16/32/64
src/devices/dev_sgi_re.c:1506: 			    only); 4 is the corresponding BYTE count, which the
src/devices/dev_sgi_re.c:1507: 			    author used correctly in the `/ (depth / 8)' lines
src/devices/dev_sgi_re.c:1508: 			    just above.  So both assignments were dead, every
src/devices/dev_sgi_re.c:1509: 			    tiled transfer took the CI arm, and at 32 bits CI
src/devices/dev_sgi_re.c:1510: 			    assigns buf[0] alone while memory_rw copies four --
src/devices/dev_sgi_re.c:1511: 			    publishing three bytes of host stack into guest
src/devices/dev_sgi_re.c:1512: 			    memory.  The comment above states the intended
src/devices/dev_sgi_re.c:1513: 			    condition in words: 32-bit transfers.
src/devices/dev_sgi_re.c:1514: 
src/devices/dev_sgi_re.c:1515: 			    This repairs the 32-bit cell ONLY.  The 16-bit and
src/devices/dev_sgi_re.c:1516: 			    reserved-encoding-3 cells assign fewer bytes than
src/devices/dev_sgi_re.c:1517: 			    they copy for the same reason and are NOT closed
src/devices/dev_sgi_re.c:1518: 			    here -- see the uninitialised-buffer sibling.  */
src/devices/dev_sgi_re.c:1519: 			if (depth == 32) {	/*  #509  */
src/devices/dev_sgi_re.c:1520: 				src_mode |= DE_MODE_TYPE_RGBA;
src/devices/dev_sgi_re.c:1521: 				dst_mode |= DE_MODE_TYPE_RGBA;
src/devices/dev_sgi_re.c:1522: 			}
src/devices/dev_sgi_re.c:1523: 
src/devices/dev_sgi_re.c:1524: 			int src_y = src_y1;
src/devices/dev_sgi_re.c:1525: 			for (int y = y1; y != y2+dy; y += dy) {
src/devices/dev_sgi_re.c:1526: 				int src_x = src_x1;
src/devices/dev_sgi_re.c:1527: 				
src/devices/dev_sgi_re.c:1528: 				for  (int x = x1; x != x2+dx; x += dx) {
src/devices/dev_sgi_re.c:1529: 					if (mode & MTE_MODE_COPY) {
src/devices/dev_sgi_re.c:1530: 						horrible_getputpixel(0, cpu, d,
src/devices/dev_sgi_re.c:1531: 							src_x, src_y, &bg, src_mode);
src/devices/dev_sgi_re.c:1532: 						src_x += dx;
src/devices/dev_sgi_re.c:1533: 					}
src/devices/dev_sgi_re.c:1534: 
src/devices/dev_sgi_re.c:1535: 					horrible_getputpixel(1, cpu, d, x, y, &bg, dst_mode);
src/devices/dev_sgi_re.c:1536: 				}
src/devices/dev_sgi_re.c:1537: 				
src/devices/dev_sgi_re.c:1538: 				src_y += dy;
src/devices/dev_sgi_re.c:1539: 			}
src/devices/dev_sgi_re.c:1540: 		}
src/devices/dev_sgi_re.c:1541: 		break;
src/devices/dev_sgi_re.c:1542: 	case MTE_TLB_LIN_A:
src/devices/dev_sgi_re.c:1543: 	case MTE_TLB_LIN_B:
src/devices/dev_sgi_re.c:1790: 
src/devices/dev_sgi_re.c:1791: 
src/devices/dev_sgi_re.c:1792: /****************************************************************************/
