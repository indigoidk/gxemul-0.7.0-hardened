1283: void dev_sgi_de_init(struct memory *mem, uint64_t baseaddr, struct sgi_re_data *d)
1284: {
1285: 	memory_device_register(mem, "sgi_de", baseaddr, DEV_SGI_DE_LENGTH,
1286: 	    dev_sgi_de_access, (void *)d, DM_DEFAULT, NULL);
