1399: 			exit(1);
1400: 		}
1401: 
1402: 		if (depth != 8) {
1403: 			fatal("[ sgi_mte: unimplemented MTE_DEPTH_x ]");
1404: 			exit(1);
1405: 		}
1406: 
1407: 		debug("[ sgi_mte: LINEAR TRANSFER: mode=0x%08x dst0=0x%016llx,"
1408: 		    " dst1=0x%016llx (length 0x%llx), dst_y_step=%i bg=0x%x, bytemask=0x%x ]\n",
1409: 		    mode,
1410: 		    (long long)dst0, (long long)dst1,
1411: 		    (long long)dstlen, dst_y_step, (int)bg, (int)bytemask);
1412: 
1413: 		if (bytemask != 0xffffffff) {
1414: 			fatal("unimplemented MTE bytemask 0x%08x\n", (int)bytemask);
1415: 			exit(1);
1416: 		}
1417: 
1418: 		/*
1419: 		 *  Horrible hack:
1420: 		 *
1421: 		 *  During bootup, the PROM fills memory at 0x40000000 and
1422: 		 *  forward. This corresponds to the lowest possible RAM address.
1423: 		 *  However, these fills are not going via the CPU's cache,
1424: 		 *  which contains things such as the return address on the
1425: 		 *  stack. If we _really_ write this data in the emulator (which
1426: 		 *  doesn't emulate the cache), it would overwrite the stack.
1427: 		 *
1428: 		 *  So let's not.
1429: 		 *
1430: 		 *  (If some guest OS or firmware variant actually depends on
1431: 		 *  the ability to write to the start of memory this way,
1432: 		 *  it would not work in the emulator.)
1433: 		 */
1434: 		// if (dst0 >= 0x40000000 && dst0 < 0x40004000 && dst1 > 0x40004000) {
1435: 		//	dst0 += 0x4000;
1436: 		//	dstlen -= 0x4000;
1437: 		// }
1438: 
1439: 		/*
1440: 		 *  HUH?
1441: 		 *
1442: 		 *  Note that due to a bug (?) in the PROM firmware when it
1443: 		 *  is setting up the TLB entries, only every _second_ page is
1444: 		 *  actually put correctly in the TLB. This means that even
1445: 		 *  though it then tries to fill 0x40000000 .. 0x40007fff with
1446: 		 *  zeroes, it only fills 0x40001000 .. 0x40001fff,
1447: 		 *  0x40003000 .. 0x40003fff and so on!
1448: 		 *
1449: 		 *  So the Horrible hack above is not needed.
1450: 		 *
1451: 		 *  Ironic.
1452: 		 */
1453: 
1454: 		memset(zerobuf, bg, dstlen < sizeof(zerobuf) ? dstlen : sizeof(zerobuf));
1455: 		fill_addr = dst0;
1456: 		while (dstlen != 0) {
1457: 			uint64_t fill_len;
1458: 			if (dstlen > sizeof(zerobuf))
1459: 				fill_len = sizeof(zerobuf);
1460: 			else
1461: 				fill_len = dstlen;
1462: 
1463: 			uint64_t starting_page = fill_addr & ~0xfff;
1464: 			uint64_t ending_page = (fill_addr + fill_len - 1) & ~0xfff;
1465: 			if (starting_page != ending_page) {
1466: 				fill_len = starting_page + 4096 - fill_addr;
1467: 			}
1468: 
1469: 			// Find starting_page in the TLB in question.
1470: 			starting_page >>= 12;
1471: 			uint32_t *tlb = dst_tlb == MTE_TLB_LIN_A ? d->re_linear_a : d->re_linear_b;
1472: 			int match = 0;
1473: 			for (int i = 0; i < 32; ++i) {
1474: 				uint32_t entry = tlb[i];
1475: 				if (entry & 0x80000000) {
1476: 					entry &= ~0x80000000;
1477: 					if (entry == starting_page) {
1478: 						match = 1;
1479: 						break;
1480: 					}
1481: 				}
1482: 			}
1483: 			
1484: 			if (match) {
1485: 				cpu->memory_rw(cpu, cpu->mem, fill_addr, zerobuf, fill_len,
1486: 					MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
1487: 			} else {
1488: 				debug("[ sgi_mte: WARNING: address 0x%x not found in TLB? Ignoring fill. ]\n",
1489: 					(long long)fill_addr);
1490: 			}

