800:			fatal("[ sgi_de: XFER_EN for LINE op? ]\n");
801:
802:		// The PROM uses width 32, but NetBSD documents it as "half pixels".
803:		// if ((op & DE_PRIM_LINE_WIDTH_MASK) != 2)
804:		//	fatal("[ sgi_de: LINE_WIDTH_MASK = %i ]\n", op & DE_PRIM_LINE_WIDTH_MASK);
805:
806:		if (linelen == 0)
807:			linelen ++;
808:
809:		for (int i = 0; i < ((op & DE_PRIM_LINE_SKIP_END)? linelen : linelen+1); ++i) {
810:			x = (x2 * i + x1 * (linelen-i)) / linelen;
811:			y = (y2 * i + y1 * (linelen-i)) / linelen;
812:
813:			uint32_t color = fg;
814:			uint32_t oldcolor = fg;
815:
816:			if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
817:				horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
818:
819:			int draw = 1;
820:			if (drawmode & DE_DRAWMODE_LINE_STIP) {
821:				if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
822:					color = (pattern & 0x80000000UL) ? fg : bg;
823:				else
824:					draw = (pattern & 0x80000000UL)? 1 : 0;
825:			}
826:
827:			// Raster-OP.
828:			// TODO: Other ops.
829:			// TODO: Should this be before or after other things?
830:			if (drawmode & DE_DRAWMODE_ROP) {
831:				switch (rop) {
832:				case OPENGL_LOGIC_OP_COPY:
833:					// color = color;
834:					break;
835:				case OPENGL_LOGIC_OP_XOR:
836:					color = oldcolor ^ color;
837:					break;
838:				case OPENGL_LOGIC_OP_COPY_INVERTED:
839:					color = 0xffffffff - oldcolor;
840:					break;
841:				default:{
842:						static char rop_used[256];
843:						static int first = 1;
844:
845:						if (first) {
846:							memset(rop_used, 0, sizeof(rop_used));
847:							first = 0;
848:						}
849:
850:						if (!rop_used[rop & 255]) {
851:							rop_used[rop & 255] = 1;
852:							fatal("[ sgi_de: LINE: rop[0x%02x] used! ]\n", rop & 255);
853:						}
854:
855:						if (rop >> 8) {
856:							fatal("[ sgi_de: LINE: rop > 255: 0x%08x ]\n", rop);
857:						}
858:					}
859:				}
860:			}
861:
862:			if (draw)
863:				horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
864:
865:			// Rotate the stipple pattern:
866:			pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
867:		}
868:		break;
869:
870:	case DE_PRIM_RECTANGLE:
871:		for (y = y1; y != endy; y = (y + dy) & 0x7ff) {
872:			src_x = saved_src_x;
873:			for (x = x1; x != endx; x = (x + dx) & 0x7ff) {
874:				uint32_t color = fg;
875:				uint32_t oldcolor = fg;
876:
877:				if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
878:					horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
879:
880:				// Pixel colors copied from another source.
881:				// (OpenBSD draws characters using this mechanism.)
882:				if (drawmode & DE_DRAWMODE_XFER_EN)
883:					horrible_getputpixel(0, cpu, d,	src_x, src_y, &color, src_mode);
884:
885:				int draw = 1;
886:				if (drawmode & DE_DRAWMODE_POLY_STIP) {
887:					if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
888:						color = (pattern & 0x80000000UL) ? fg : bg;
889:					else
890:						draw = (pattern & 0x80000000UL)? 1 : 0;
891:				}
892:
893:				// Raster-OP.
894:				// TODO: Other ops.
895:				// TODO: Should this be before or after other things?
896:				if (drawmode & DE_DRAWMODE_ROP) {
897:					switch (rop) {
898:					case OPENGL_LOGIC_OP_COPY:
899:						// color = color;
900:						break;
901:					case OPENGL_LOGIC_OP_XOR:
902:						color = oldcolor ^ color;
903:						break;
904:					case OPENGL_LOGIC_OP_COPY_INVERTED:
905:						color = 0xffffffff - oldcolor;
906:						break;
907:					default:{
908:							static char rop_used[256];
909:							static int first = 1;
910:
911:							if (first) {
912:								memset(rop_used, 0, sizeof(rop_used));
913:								first = 0;
914:							}
915:
916:							if (!rop_used[rop & 255]) {
917:								rop_used[rop & 255] = 1;
918:								fatal("[ sgi_de: RECT: rop[0x%02x] used! ]\n", rop & 255);
919:							}
920:
921:							if (rop >> 8) {
922:								fatal("[ sgi_de: RECT: rop > 255: 0x%08x ]\n", rop);
923:							}
924:						}
925:					}
926:				}
927:
928:				if (draw)
929:					horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
930:
931:				// Rotate the stipple pattern:
932:				pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
933:
934:				if (src_is_linear)
935:					src_x += step_x;
936:				else
937:					src_x = (src_x + dx) & 0x7ff;
938:			}
939:			
940:			src_y = (src_y + dy) & 0x7ff;
941:		}
942:		break;
943:
944:	default:
945:		/*  #500: a GUEST-WRITTEN drawing op ended the host process.
946:		    The switch discriminates on the TOP BYTE only, so the domain
947:		    is 256 values and only two are implemented -- DE_PRIM_LINE
948:		    (0x01) and DE_PRIM_RECTANGLE (0x03).
949:
950:		    *** THE TWO KILLERS THAT MATTER ARE NOT EXOTIC VALUES: THEY
951:		    ARE NAMED PRIMITIVES, AND ONE OF THEM IS THE RESET STATE. ***
952:		    crmfbreg.h defines them as FULL 32-BIT VALUES, not top-byte
953:		    indices: DE_PRIM_POINT 0x00000000, LINE 0x01000000,
954:		    TRIANGLE 0x02000000, RECTANGLE 0x03000000.  Writing them
955:		    as "0x01" invites a `case 0x02:' that can NEVER match,
956:		    since the switch compares `op & 0xff000000'.  POINT and
957:		    TRIANGLE land
958:		    here.  And dev_sgi_re_init memsets the whole device struct,
959:		    so CRIME_DE_PRIMITIVE reads 0 -- which IS POINT -- until a
960:		    guest writes it.  A guest that sets the START bit having
961:		    never written the primitive register at all therefore died
962:		    here.  It need not choose a bad value; it need only omit a
963:		    good one.
964:
965:		    Now a LATCHED DECLINE that falls out of the switch and
966:		    returns.  The diagnostic is kept in full -- it names the op
967:		    and the vertices, which is what a maintainer implementing
968:		    the primitive would want -- and gains `-- declined.  (once)'
969:		    so it cannot be mistaken for the old host kill and cannot
970:		    flood a guest loop.  */
971:		if (!(d->warned & SGIRE_W_PRIM_OP)) {
972:			d->warned |= SGIRE_W_PRIM_OP;
973:			fatal("[ sgi_de: UNIMPLEMENTED drawing op = 0x%08x,"
974:			    " x1=%i y1=%i x2=%i y2=%i fg=0x%x bg=0x%x"
975:			    " pattern=0x%08x -- declined.  (once) ]\n",
976:			    op, x1, y1, x2, y2, fg, bg, pattern);
977:		}
978:		break;
979:	}
980:}
980:}
