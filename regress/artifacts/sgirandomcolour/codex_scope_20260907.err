1292:/*
1293: *  SGI "mte", NetBSD sources describes it as a "memory transfer engine".
1294: *
1295: *  If the relative address has the 0x0800 (CRIME_DE_START) flag set, it means
1296: *  "go ahead with the transfer". Otherwise, it is just reads and writes of the
1297: *  registers.
1298: */
1299:
1300:void do_mte_transfer(struct cpu* cpu, struct sgi_re_data *d)
1301:{
1302:	uint32_t mode = d->mte_reg[(CRIME_MTE_MODE - 0x3000) / sizeof(uint32_t)];
1303:	uint32_t src0 = d->mte_reg[(CRIME_MTE_SRC0 - 0x3000) / sizeof(uint32_t)];
1304:	uint32_t src1 = d->mte_reg[(CRIME_MTE_SRC1 - 0x3000) / sizeof(uint32_t)];
1305:	uint32_t dst0 = d->mte_reg[(CRIME_MTE_DST0 - 0x3000) / sizeof(uint32_t)];
1306:	uint32_t dst1 = d->mte_reg[(CRIME_MTE_DST1 - 0x3000) / sizeof(uint32_t)];
1307:	int32_t src_y_step = d->mte_reg[(CRIME_MTE_SRC_Y_STEP - 0x3000) / sizeof(uint32_t)];
1308:	int32_t dst_y_step = d->mte_reg[(CRIME_MTE_DST_Y_STEP - 0x3000) / sizeof(uint32_t)];
1309:	uint32_t dstlen = dst1 - dst0 + 1, fill_addr;
1310:	unsigned char zerobuf[4096];
1311:	int depth = 8 << ((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT);
1312:	int src = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
1313:	uint32_t bytemask = d->mte_reg[(CRIME_MTE_BYTEMASK - 0x3000) / sizeof(uint32_t)];
1314:	uint32_t bg = d->mte_reg[(CRIME_MTE_BG - 0x3000) / sizeof(uint32_t)];
1315:
1316:	debug("[ sgi_mte: STARTING: mode=0x%08x src0=0x%08x src1=0x%08x src_y_step=%i dst0=0x%08x,"
1317:	    " dst1=0x%08x dst_y_step=%i bg=0x%x bytemask=0x%x ]\n",
1318:	    mode,
1319:	    src0, src1, src_y_step,
1320:	    dst0, dst1, dst_y_step,
1321:	    bg, bytemask);
1322:
1323:	if (dst_y_step != 0 && dst_y_step != 1 && dst_y_step != -1) {
1324:		fatal("[ sgi_mte: TODO! unimplemented dst_y_step %i ]", dst_y_step);
1325:		// exit(1);
1326:	}
1327:
1328:	if (mode & MTE_MODE_STIPPLE) {
1329:		fatal("[ sgi_mte: unimplemented MTE_MODE_STIPPLE ]");
1330:		exit(1);
1331:	}
1332:
1333:	int src_tlb = (mode & MTE_MODE_SRC_BUF_MASK) >> MTE_SRC_TLB_SHIFT;
1334:	int dst_tlb = (mode & MTE_MODE_DST_BUF_MASK) >> MTE_DST_TLB_SHIFT;
1335:	
1336:	if (src > MTE_TLB_C) {
1337:		fatal("[ sgi_mte: unimplemented SRC ]");
1338:		exit(1);
1339:	}
1340:
1341:	switch (dst_tlb) {
1342:	case MTE_TLB_A:
1343:	case MTE_TLB_B:
1344:	case MTE_TLB_C:
1345:		// Used by NetBSD's crmfb_fill_rect. It puts graphical
1346:		// coordinates in dst0 and dst1.
1347:		{
1348:			int x1 = (dst0 >> 16) & 0xfff;
1349:			int y1 = dst0 & 0xfff;
1350:			int x2 = (dst1 >> 16) & 0xfff;
1351:			int y2 = dst1 & 0xfff;
1352:			x1 /= (depth / 8);
1353:			x2 /= (depth / 8);
1354:
1355:			int src_x1 = (src0 >> 16) & 0xfff;
1356:			int src_y1 = src0 & 0xfff;
1357:			// int src_x2 = (src1 >> 16) & 0xfff;
1358:			// int src_y2 = src1 & 0xfff;
1359:			src_x1 /= (depth / 8);
1360:			// src_x2 /= (depth / 8);
1361:
1362:			int dx = x1 > x2 ? -1 : 1;
1363:			int dy = y1 > y2 ? -1 : 1;
1364:			
1365:			uint32_t src_mode = (src_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
1366:			uint32_t dst_mode = (dst_tlb << 10) + (((mode & MTE_MODE_DEPTH_MASK) >> MTE_DEPTH_SHIFT) << 8);
1367:
1368:			// Hack. The MTE perhaps doesn't deal with colors per se,
1369:			// but this makes sure that we copy 32 bits when doing 32-bit
1370:			// transfers.
1371:			/*  #509: was `depth == 4' -- UNREACHABLE.  `depth' is
1372:			    a count of BITS (8 << a two-bit field, so 8/16/32/64
1373:			    only); 4 is the corresponding BYTE count, which the
1374:			    author used correctly in the `/ (depth / 8)' lines
1375:			    just above.  So both assignments were dead, every
1376:			    tiled transfer took the CI arm, and at 32 bits CI
1377:			    assigns buf[0] alone while memory_rw copies four --
1378:			    publishing three bytes of host stack into guest
1379:			    memory.  The comment above states the intended
1380:			    condition in words: 32-bit transfers.
1381:
1382:			    This repairs the 32-bit cell ONLY.  The 16-bit and
1383:			    reserved-encoding-3 cells assign fewer bytes than
1384:			    they copy for the same reason and are NOT closed
1385:			    here -- see the uninitialised-buffer sibling.  */
1386:			if (depth == 32) {	/*  #509  */
1387:				src_mode |= DE_MODE_TYPE_RGBA;
1388:				dst_mode |= DE_MODE_TYPE_RGBA;
1389:			}
1390:
1391:			int src_y = src_y1;
1392:			for (int y = y1; y != y2+dy; y += dy) {
1393:				int src_x = src_x1;
1394:				
1395:				for  (int x = x1; x != x2+dx; x += dx) {
1396:					if (mode & MTE_MODE_COPY) {
1397:						horrible_getputpixel(0, cpu, d,
1398:							src_x, src_y, &bg, src_mode);
1399:						src_x += dx;
1400:					}
1401:
1402:					horrible_getputpixel(1, cpu, d, x, y, &bg, dst_mode);
1403:				}
1404:				
1405:				src_y += dy;
1406:			}
1407:		}
1408:		break;
1409:	case MTE_TLB_LIN_A:
1410:	case MTE_TLB_LIN_B:
1411:		// Used by the PROM to zero-fill memory (?).
1412:		if (mode & MTE_MODE_COPY) {
1413:			fatal("[ sgi_mte: unimplemented MTE_MODE_COPY ]");
1414:			exit(1);
1415:		}
1416:
1417:		if (depth != 8) {
1418:			fatal("[ sgi_mte: unimplemented MTE_DEPTH_x ]");
1419:			exit(1);
1420:		}
1421:
1422:		debug("[ sgi_mte: LINEAR TRANSFER: mode=0x%08x dst0=0x%016llx,"
1423:		    " dst1=0x%016llx (length 0x%llx), dst_y_step=%i bg=0x%x, bytemask=0x%x ]\n",
1424:		    mode,
1425:		    (long long)dst0, (long long)dst1,
1426:		    (long long)dstlen, dst_y_step, (int)bg, (int)bytemask);
1427:
1428:		if (bytemask != 0xffffffff) {
1429:			fatal("unimplemented MTE bytemask 0x%08x\n", (int)bytemask);
1430:			exit(1);
1640:		do_mte_transfer(cpu, d);
1641:
1642:	if (writeflag == MEM_READ)
1643:		memory_writemax64(cpu, data, len, odata);
1644:
1645:	return 1;
1646:}
