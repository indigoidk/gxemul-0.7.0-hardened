146:static void debugmsg_va(struct cpu* cpu, int subsystem,
147:	const char *name, int verbosity, va_list argp, const char *fmt)
148:{
149:	bool subsystem_breakpoint = false;
150:
350:		fprintf(stderr, "WARNING: debug_indent too low!\n");
