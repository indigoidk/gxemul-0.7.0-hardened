467:		 *  01: vaddr=0000000002000000 (global):  p0=0x042000000 D p1=0x043000000 D (16MB)
468:		 *  02: vaddr=0000000004000000 (global):  p0=0x044000000 D p1=0x045000000 D (16MB)
469:		 *  03: vaddr=0000000006000000 (global):  p0=0x046000000 D p1=0x047000000 D (16MB)
470:		 *
471:		 *  In other words, it uses real memory at 0x40000000 and up.
472:		 *  However, it is _also_ accessible at physical address 0x0.
473:		 *
474:		 *  Max amount of RAM in an O2 is 1 GB. However, devices start at
475:		 *  0x14000000 (or below that), so 256 MB is the most that the legacy GXemul
476:		 *  framework can handle. Memory above that must be accessed from 0x40000000 and up.
477: 		 */
478:
479:		if (machine->physical_ram_in_mb > 1024) {
480:			fatal("SGI O2 cannot have more than 1 GB of RAM.\n");
481:			exit(1);
482:		}
483:
484:		/*  In the new framework, this would be the other way around :-), i.e.
485:		    actual memory at 0x40000000 and the first 256 MB would be mirrored
486:		    to address 0.  */
487:		{
488:			int mirrorInMB = machine->physical_ram_in_mb < 256 ? machine->physical_ram_in_mb : 256;
489:			dev_ram_init(machine, 0x40000000ULL, mirrorInMB * 1048576, DEV_RAM_MIRROR, 0, NULL);
490:			if (machine->physical_ram_in_mb > 256)
491:				dev_ram_init(machine, 0x50000000ULL, (machine->physical_ram_in_mb - 256) * 1048576, DEV_RAM_RAM, 0, NULL);
492:		}
493:		
494:		/*  Connect CRIME (Interrupt Controller) to MIPS irq 2:  */
495:		snprintf(tmpstr, sizeof(tmpstr), "%s.cpu[%i].2",
496:		    machine->path, machine->bootstrap_cpu);
497:		dev_crime_init(machine, mem, 0x14000000, tmpstr, machine->x11_md.in_use);
498:
499:		/*  Rendering Engine  */
500:		dev_sgi_re_init(machine, mem, 0x15000000);
501:
502:		/*  Graphics Back End  */
503:		dev_sgi_gbe_init(machine, mem, 0x16000000);
504:
505:		/*
506:		 *  A combination of NetBSD and Linux info:
507:		 *
508:		 *	14000000	crime (interrupt/memory controller?)
509:		 *	15000000	drawing engine, memory transfer engine, rendering engine
510:		 *	16000000	gbe (graphics), crm framebuffer control
655:
656:		// TODO: Correct Interrupt!
657:		snprintf(tmpstr, sizeof(tmpstr), "z8530 addr=0x1fbd9830 irq=%s.cpu[%i].2",
658:		    machine->path, machine->bootstrap_cpu);
659:		machine->main_console_handle = (size_t)device_add(machine, tmpstr);
660:
661:		break;
662:
663:	case 53:
664:		strlcat(machineName, " (Origin 350)",
665:		    MACHINE_NAME_MAXBUF);
666:
667:		/*
668:		 *  According to http://kumba.drachentekh.net/xml/myguide.html
669:		 *  Origin 350, Tezro IP53 R16000
670:		 */
671:		break;
672:
673:	default:
674:		fatal("unimplemented SGI machine type IP%i\n",
675:		    machine->machine_subtype);
676:		exit(1);
677:	}
678:
679:	if (!machine->prom_emulation)
680:		return;
681:
682:	arcbios_init(machine, arc_wordlen == sizeof(uint64_t), sgi_ram_offset,
683:	    eaddr_string, macaddr);
684:}
