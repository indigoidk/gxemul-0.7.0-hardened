113:/*
114: *  va_debug():
115: *
116: *  Used internally by the old debug() and fatal() functions.
117: */
118:static void va_debug(va_list argp, const char *fmt)
119:{
120:	char buf[DEBUG_BUFSIZE + 1];
121:	buf[0] = buf[DEBUG_BUFSIZE] = 0;
122:	vsnprintf(buf, DEBUG_BUFSIZE, fmt, argp);
123:
124:	char* s = buf;
125:	while (*s) {
126:		if (debug_old_currently_at_start_of_line) {
127:			for (size_t i = 0; i < debug_indent * DEBUG_INDENTATION; i++)
128:				printf(" ");
129:		}
130:
131:		printf("%c", *s);
132:
133:		debug_old_currently_at_start_of_line = false;
134:		if (*s == '\n' || *s == '\r')
135:			debug_old_currently_at_start_of_line = true;
136:		s++;
137:	}
138:}
