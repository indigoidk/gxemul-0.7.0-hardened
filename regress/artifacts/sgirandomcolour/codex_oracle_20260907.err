317:static void debugger_cmd_watchpoint(struct machine *m, char *args)
318:{
319:	static const char *subcmd_name[] = { "add", "delete", "show" };
320:	const int SUBCMD_ADD = 0, SUBCMD_DELETE = 1, SUBCMD_SHOW = 2;
321:	const int n_subcmds = 3;
322:	int i, res, subcmd = -1, n_matches = 0;
323:	size_t wordlen;
324:	char *rest;
325:
326:	while (args[0] == ' ')
327:		args ++;
328:
329:	if (args[0] == '\0') {
330:		printf("syntax: watchpoint subcmd [args...]\n");
331:		printf("Available subcmds (and args) are:\n");
332:		printf("  add addr[, len]  break on a guest write to the len-byte"
333:		    " range at addr\n");
334:		printf("                   (len defaults to 4)\n");
335:		printf("  delete x         delete watchpoint nr x\n");
336:		printf("  show             show current watchpoints\n");
337:		printf("Subcmds may be abbreviated to any unambiguous prefix.\n");
338:		return;
339:	}
340:
341:	wordlen = 0;
342:	while (args[wordlen] != '\0' && args[wordlen] != ' ')
343:		wordlen ++;
344:
345:	for (i=0; i<n_subcmds; i++)
346:		if (strncasecmp(args, subcmd_name[i], wordlen) == 0) {
347:			subcmd = i;
348:			n_matches ++;
349:		}
350:
351:	if (n_matches == 0) {
352:		printf("Unknown watchpoint subcommand.\n");
353:		return;
354:	}
355:	if (n_matches > 1) {
356:		printf("Ambiguous watchpoint subcommand '%.*s'.\n",
357:		    (int) wordlen, args);
358:		return;
359:	}
360:
361:	rest = args + wordlen;
362:	while (rest[0] == ' ')
363:		rest ++;
364:
365:	if (subcmd == SUBCMD_SHOW) {
366:		if (m->watchpoints.n == 0)
367:			printf("No watchpoints set.\n");
368:		for (i=0; i<m->watchpoints.n; i++) {
369:			printf("%3i: paddr 0x", i);
370:			if (m->cpus[0]->is_32bit)
371:				printf("%08" PRIx32,
372:				    (uint32_t) m->watchpoints.addr[i]);
373:			else
374:				printf("%016" PRIx64,
375:				    (uint64_t) m->watchpoints.addr[i]);
376:			printf(", %" PRIi64 " byte(s)",
377:			    (int64_t) m->watchpoints.len[i]);
378:			if (m->watchpoints.string[i] != NULL)
379:				printf(" (%s)", m->watchpoints.string[i]);
380:			printf("\n");
381:		}
382:		return;
383:	}
384:
385:	if (subcmd == SUBCMD_DELETE) {
386:		int x;
387:
388:		if (rest[0] == '\0') {
389:			printf("syntax: watchpoint delete x\n");
390:			return;
391:		}
392:
393:		x = atoi(rest);
394:
395:		if (m->watchpoints.n == 0) {
396:			printf("No watchpoints set.\n");
397:			return;
398:		}
399:		if (x < 0 || x >= m->watchpoints.n) {
400:			printf("Invalid watchpoint nr %i. Use 'watchpoint "
401:			    "show' to see the current watchpoints.\n", x);
402:			return;
403:		}
404:
405:		free(m->watchpoints.string[x]);
406:
407:		for (i=x; i<m->watchpoints.n-1; i++) {
408:			m->watchpoints.addr[i]   = m->watchpoints.addr[i+1];
409:			m->watchpoints.len[i]    = m->watchpoints.len[i+1];
410:			m->watchpoints.string[i] = m->watchpoints.string[i+1];
411:		}
412:		m->watchpoints.n --;
413:
414:		/*  Invalidate ALL translations (incl. the host_store data map)
415:		    so the fast-store suppression is recomputed on remap.  */
416:		for (i=0; i<m->ncpus; i++)
417:			if (m->cpus[i]->invalidate_translation_caches != NULL)
418:				m->cpus[i]->invalidate_translation_caches(
419:				    m->cpus[i], 0, INVALIDATE_ALL);
420:		return;
421:	}
422:
423:	if (subcmd == SUBCMD_ADD) {
424:		uint64_t addr, paddr, len = 4;
425:		size_t buflen;
426:		char *comma;
427:		struct cpu *c;
428:
429:		if (rest[0] == '\0') {
430:			printf("syntax: watchpoint add addr[, len]\n");
431:			return;
432:		}
433:
434:		/*  Optional ", len" tail; expressions never contain a comma.  */
435:		comma = strchr(rest, ',');
436:		if (comma != NULL) {
437:			*comma = '\0';
438:			len = strtoull(comma + 1, NULL, 0);
439:			if (len < 1)
440:				len = 1;
441:			while (comma > rest && comma[-1] == ' ')
442:				*(--comma) = '\0';
443:		}
444:
445:		res = debugger_parse_expression(m, rest, 0, &addr);
446:		if (!res) {
447:			printf("Couldn't parse '%s'\n", rest);
448:			return;
449:		}
450:
451:		/*
452:		 *  #250: watchpoints are matched on PHYSICAL addresses, so a
453:		 *  write via any virtual alias (e.g. cached kseg0 vs uncached
454:		 *  kseg1 on MIPS) is caught and 32-bit sign-extension is a
455:		 *  non-issue. Translate the (virtual) address the user typed to
456:		 *  physical; if that fails (e.g. an unmapped mapped-segment
457:		 *  address), assume the value was already physical.
458:		 */
459:		c = m->cpus[m->bootstrap_cpu];
460:		paddr = addr;
461:		if (c != NULL && c->translate_v2p != NULL &&
462:		    !c->translate_v2p(c, addr, &paddr, FLAG_NOEXCEPTIONS)) {
463:			printf("(warning: couldn't translate 0x%" PRIx64 " to a "
464:			    "physical address; treating it as physical)\n",
465:			    (uint64_t) addr);
466:			paddr = addr;
467:		}
468:
469:		i = m->watchpoints.n;
470:
471:		CHECK_ALLOCATION(m->watchpoints.string = (char **) realloc(
472:		    m->watchpoints.string, sizeof(char *) * (i + 1)));
473:		CHECK_ALLOCATION(m->watchpoints.addr = (uint64_t *) realloc(
474:		    m->watchpoints.addr, sizeof(uint64_t) * (i + 1)));
475:		CHECK_ALLOCATION(m->watchpoints.len = (uint64_t *) realloc(
476:		    m->watchpoints.len, sizeof(uint64_t) * (i + 1)));
477:
478:		buflen = strlen(rest) + 1;
479:		CHECK_ALLOCATION(m->watchpoints.string[i] = (char *)
480:		    malloc(buflen));
481:		strlcpy(m->watchpoints.string[i], rest, buflen);
482:		m->watchpoints.addr[i] = paddr;
483:		m->watchpoints.len[i] = len;
484:		m->watchpoints.n ++;
485:
486:		/*  Invalidate ALL translations (incl. the host_store data map)
487:		    so the newly-watched page leaves the fast-store map and every
488:		    write to it now traps to memory_rw.  */
489:		for (i=0; i<m->ncpus; i++)
490:			if (m->cpus[i]->invalidate_translation_caches != NULL)
491:				m->cpus[i]->invalidate_translation_caches(
492:				    m->cpus[i], 0, INVALIDATE_ALL);
493:
494:		printf("watchpoint %i: paddr 0x%" PRIx64 ", %" PRIi64
495:		    " byte(s) (%s)\n", m->watchpoints.n - 1, (uint64_t) paddr,
496:		    (int64_t) len, m->watchpoints.string[m->watchpoints.n - 1]);
497:		return;
498:	}
499:}
