694:/*
695: *  SGI "de", NetBSD sources describes it as a "drawing engine".
696: */
697:
698:void draw_primitive(struct cpu* cpu, struct sgi_re_data *d)
699:{
700:	uint32_t op = d->de_reg[(CRIME_DE_PRIMITIVE - 0x2000) / sizeof(uint32_t)];
701:	uint32_t drawmode = d->de_reg[(CRIME_DE_DRAWMODE - 0x2000) / sizeof(uint32_t)];
702:	uint32_t dst_mode = d->de_reg[(CRIME_DE_MODE_DST - 0x2000) / sizeof(uint32_t)];
703:	uint32_t src_mode = d->de_reg[(CRIME_DE_MODE_SRC - 0x2000) / sizeof(uint32_t)];
704:	uint32_t fg = d->de_reg[(CRIME_DE_FG - 0x2000) / sizeof(uint32_t)];
705:	uint32_t bg = d->de_reg[(CRIME_DE_BG - 0x2000) / sizeof(uint32_t)];
706:	uint32_t rop = d->de_reg[(CRIME_DE_ROP - 0x2000) / sizeof(uint32_t)];
707:
708:	uint32_t stipple_mode = d->de_reg[(CRIME_DE_STIPPLE_MODE - 0x2000) / sizeof(uint32_t)];
709:	uint32_t pattern = d->de_reg[(CRIME_DE_STIPPLE_PAT - 0x2000) / sizeof(uint32_t)];
710:	int nr_of_bits_to_strip_to_the_left = (stipple_mode >> DE_STIP_STRTIDX_SHIFT) & 31;
711:	int nr_of_bits_to_strip_to_the_right = 31 - ((stipple_mode >> DE_STIP_MAXIDX_SHIFT) & 31);
712:	pattern >>= nr_of_bits_to_strip_to_the_right;
713:	pattern <<= nr_of_bits_to_strip_to_the_right;
714:	pattern <<= nr_of_bits_to_strip_to_the_left;
715:
716:	int nr_of_bits_in_the_middle = 32 - nr_of_bits_to_strip_to_the_left - nr_of_bits_to_strip_to_the_right;
717:
718:	if (stipple_mode & 0xe0e0ffff)
719:		fatal("[ sgi_de: UNIMPLEMENTED stipple_mode bits: 0x%08x ]\n", stipple_mode);
720:
721:	uint32_t x1 = (d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;
722:	uint32_t y1 = d->de_reg[(CRIME_DE_X_VERTEX_0 - 0x2000) / sizeof(uint32_t)]& 0x7ff;
723:	uint32_t x2 = (d->de_reg[(CRIME_DE_X_VERTEX_1 - 0x2000) / sizeof(uint32_t)] >> 16) & 0x7ff;
724:	uint32_t y2 = d->de_reg[(CRIME_DE_X_VERTEX_1 - 0x2000) / sizeof(uint32_t)]& 0x7ff;
725:	size_t x, y;
726:
727:	debug("[ sgi_de: STARTING DRAWING COMMAND: op = 0x%08x,"
728:	    " drawmode=0x%x src_mode=0x%x dst_mode=0x%x x1=%i y1=%i"
729:	    " x2=%i y2=%i fg=0x%x bg=0x%x pattern=0x%08x ]\n",
730:	    op, drawmode, src_mode, dst_mode, x1, y1, x2, y2, fg, bg, pattern);
731:
732:	// bufdepth = 1, 2, or 4.
733:	// int dst_bufdepth = 1 << ((dst_mode >> 8) & 3);
734:	int src_bufdepth = 1 << ((src_mode >> 8) & 3);
735:
736:	int src_is_linear = 0;
737:	int src_x = -1, src_y = -1;
738:	int32_t step_x = 0;
739:	if (drawmode & DE_DRAWMODE_XFER_EN) {
740:		uint32_t addr_src = d->de_reg[(CRIME_DE_XFER_ADDR_SRC - 0x2000) / sizeof(uint32_t)];
741:		uint32_t strd_src = d->de_reg[(CRIME_DE_XFER_STRD_SRC - 0x2000) / sizeof(uint32_t)];
742:		step_x = d->de_reg[(CRIME_DE_XFER_STEP_X - 0x2000) / sizeof(uint32_t)];
743:		int32_t step_y = d->de_reg[(CRIME_DE_XFER_STEP_Y - 0x2000) / sizeof(uint32_t)];
744:		uint32_t addr_dst = d->de_reg[(CRIME_DE_XFER_ADDR_DST - 0x2000) / sizeof(uint32_t)];
745:		uint32_t strd_dst = d->de_reg[(CRIME_DE_XFER_STRD_DST - 0x2000) / sizeof(uint32_t)];
746:
747:		src_is_linear = ((src_mode & 0x00001c00) >> 10) > 3;
748:
749:		if (src_is_linear) {
750:			src_x = addr_src;
751:			src_y = 0;
752:		} else {
753:			src_x = (addr_src >> 16) & 0x7ff;
754:			src_y = addr_src & 0x7ff;
755:		}
756:
757:		if (step_x != src_bufdepth || (step_y != 0 && step_y != 1)) {
758:			fatal("[ sgi_de: unimplemented XFER addr_src=0x%x src_bufdepth=%i "
759:				"strd_src=0x%x step_x=0x%x step_y=0x%x "
760:				"addr_dst=0x%x strd_dst=0x%x ]\n",
761:				addr_src, src_bufdepth, strd_src, step_x, step_y, addr_dst, strd_dst);
762:
763:			// exit(1);
764:		}
765:	}
766:
767:	if (!(drawmode & DE_DRAWMODE_PLANEMASK)) {
768:		printf("!DE_DRAWMODE_PLANEMASK: TODO\n");
769:	}
770:	
771:	if ((drawmode & DE_DRAWMODE_BYTEMASK) != DE_DRAWMODE_BYTEMASK) {
772:		printf("not all DE_DRAWMODE_BYTEMASK set: TODO\n");
773:	}
774:	
775:	// primitive rendering direction (not for Lines? and presumably
776:	// not for Points either :-)
777:	int dx = op & DE_PRIM_RL ? -1 :  1;
778:	int dy = op & DE_PRIM_TB ?  1 : -1;
779:
780:	uint16_t saved_src_x = src_x;
781:
782:	/*
783:	 *  Drawing is limited to 2048 x 2048 pixel space.
784:	 *
785:	 *  TODO: MAYBE it is really -2048 to 2027, i.e. 12 bits of
786:	 *  pixel space. Perhaps it is possible to figure out
861:
862:			if (draw)
863:				horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
864:
865:			// Rotate the stipple pattern:
866:			pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
867:		}
868:		break;
869:
870:	case DE_PRIM_RECTANGLE:
871:		for (y = y1; y != endy; y = (y + dy) & 0x7ff) {
872:			src_x = saved_src_x;
873:			for (x = x1; x != endx; x = (x + dx) & 0x7ff) {
874:				uint32_t color = fg;
875:				uint32_t oldcolor = fg;
876:
877:				if (drawmode & DE_DRAWMODE_ROP && rop != OPENGL_LOGIC_OP_COPY)
878:					horrible_getputpixel(0, cpu, d, x, y, &oldcolor, dst_mode);
879:
880:				// Pixel colors copied from another source.
881:				// (OpenBSD draws characters using this mechanism.)
882:				if (drawmode & DE_DRAWMODE_XFER_EN)
883:					horrible_getputpixel(0, cpu, d,	src_x, src_y, &color, src_mode);
884:
885:				int draw = 1;
886:				if (drawmode & DE_DRAWMODE_POLY_STIP) {
887:					if (drawmode & DE_DRAWMODE_OPAQUE_STIP)
888:						color = (pattern & 0x80000000UL) ? fg : bg;
889:					else
890:						draw = (pattern & 0x80000000UL)? 1 : 0;
891:				}
892:
893:				// Raster-OP.
894:				// TODO: Other ops.
895:				// TODO: Should this be before or after other things?
896:				if (drawmode & DE_DRAWMODE_ROP) {
897:					switch (rop) {
898:					case OPENGL_LOGIC_OP_COPY:
899:						// color = color;
900:						break;
901:					case OPENGL_LOGIC_OP_XOR:
902:						color = oldcolor ^ color;
903:						break;
904:					case OPENGL_LOGIC_OP_COPY_INVERTED:
905:						color = 0xffffffff - oldcolor;
906:						break;
907:					default:{
908:							static char rop_used[256];
909:							static int first = 1;
910:
911:							if (first) {
912:								memset(rop_used, 0, sizeof(rop_used));
913:								first = 0;
914:							}
915:
916:							if (!rop_used[rop & 255]) {
917:								rop_used[rop & 255] = 1;
918:								fatal("[ sgi_de: RECT: rop[0x%02x] used! ]\n", rop & 255);
919:							}
920:
921:							if (rop >> 8) {
922:								fatal("[ sgi_de: RECT: rop > 255: 0x%08x ]\n", rop);
923:							}
924:						}
925:					}
926:				}
927:
928:				if (draw)
929:					horrible_getputpixel(1, cpu, d, x, y, &color, dst_mode);
930:
931:				// Rotate the stipple pattern:
932:				pattern = (pattern << 1) | (pattern >> (nr_of_bits_in_the_middle-1));
933:
934:				if (src_is_linear)
935:					src_x += step_x;
936:				else
937:					src_x = (src_x + dx) & 0x7ff;
938:			}
939:			
940:			src_y = (src_y + dy) & 0x7ff;
941:		}
942:		break;
943:
944:	default:
945:		/*  #500: a GUEST-WRITTEN drawing op ended the host process.
946:		    The switch discriminates on the TOP BYTE only, so the domain
947:		    is 256 values and only two are implemented -- DE_PRIM_LINE
948:		    (0x01) and DE_PRIM_RECTANGLE (0x03).
949:
950:		    *** THE TWO KILLERS THAT MATTER ARE NOT EXOTIC VALUES: THEY
951:		    ARE NAMED PRIMITIVES, AND ONE OF THEM IS THE RESET STATE. ***
952:		    crmfbreg.h defines them as FULL 32-BIT VALUES, not top-byte
953:		    indices: DE_PRIM_POINT 0x00000000, LINE 0x01000000,
954:		    TRIANGLE 0x02000000, RECTANGLE 0x03000000.  Writing them
955:		    as "0x01" invites a `case 0x02:' that can NEVER match,
956:		    since the switch compares `op & 0xff000000'.  POINT and
957:		    TRIANGLE land
958:		    here.  And dev_sgi_re_init memsets the whole device struct,
959:		    so CRIME_DE_PRIMITIVE reads 0 -- which IS POINT -- until a
960:		    guest writes it.  A guest that sets the START bit having
961:		    never written the primitive register at all therefore died
1611:		    writeflag == MEM_WRITE ? (long long)idata : (long long)odata);
1612:		break;
1613:
1614:	default:
1615:		if (writeflag == MEM_WRITE)
1616:			fatal("[ sgi_mte: unimplemented write to "
1617:			    "address 0x%llx, data=0x%016llx ]\n",
1618:			    (long long)relative_addr, (long long)idata);
1619:		else
1620:			fatal("[ sgi_mte: unimplemented read from address"
1621:			    " 0x%llx ]\n", (long long)relative_addr);
1622:	}
1623:
