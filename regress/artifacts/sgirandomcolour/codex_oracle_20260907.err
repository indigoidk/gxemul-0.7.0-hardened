764:		    boundary (e.g. large DMA transfers) at the boundary,
765:		    instead of exiting the whole emulator.  */
766:		size_t len_head = (size_t) ((1<<BITS_PER_MEMBLOCK) -
767:		    (paddr & ((1<<BITS_PER_MEMBLOCK)-1)));
