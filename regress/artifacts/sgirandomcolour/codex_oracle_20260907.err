102:def session(cmds, settle=1.5, spin=1.6):
103:    pid, fd = pty.fork()
104:    if pid == 0:
105:        os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
106:                       "0x80001000:" + DUMMY])
107:        os._exit(127)
108:    buf = ""
109:    def rd(t):
110:        nonlocal buf
111:        end = time.time() + t
112:        while time.time() < end:
113:            r, _, _ = select.select([fd], [], [], 0.1)
114:            if not r:
115:                continue
116:            try:
117:                d = os.read(fd, 65536)
118:                if not d:
119:                    return False
120:                buf += d.decode("latin-1", "replace")
121:            except OSError:
122:                return False
123:        return True
124:    alive = rd(settle)
125:    for i, c in enumerate(cmds):
126:        try:
127:            os.write(fd, (c + "\n").encode("latin-1"))
128:        except OSError:
129:            alive = False
130:            break
131:        if not rd(spin if i == len(cmds) - 1 else 0.22):
132:            alive = False
133:            break
134:    try:
135:        os.write(fd, b"quit\n"); rd(0.4)
136:    except OSError:
137:        pass
138:    try:
139:        os.close(fd)
140:    except OSError:
141:        pass
142:    return buf.replace("\r", ""), alive
