				d->warned |= SGIRE_W_BADCOLOR;
				fatal("[ put: color mode = 0x%x ] sgi_re: unimplemented "
				    "colour type in horrible_getputpixel, x=%i y=%i; store "
				    "declined (once) ]\n", color_mode, x, y);
			}
