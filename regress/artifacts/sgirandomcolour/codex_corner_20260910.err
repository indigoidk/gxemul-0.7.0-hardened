146:def load(A, addr):
147:    return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT], A.take(1))
148:def loadop(A, addr, op):
149:    return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
150:
151:def setup_put(A, dst_mode, fg=FG_VAL, paint=DST_PAINT, vertex=0x00000000):
152:    """Program the engine, paint destination with sentinel, then fire one pixel PUT.
153:    vertex packs (x << 16) | y for XVERTEX_0/1 (draw_primitive: `>> 16) & 0x7ff' / `& 0x7ff'); the
154:    default is (0,0).  Added on pass 2 (grok): every PUT sat at (0,0), so a guard qualified
155:    `if (ok || x)' kept every row green.  The second-word paint is emitted ONLY for a non-origin
156:    vertex, so every pre-existing session's command stream is unchanged by this parameter."""
157:    c  = store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)  # re_linear_a[0] = 0x10 -> phys 0x10000
158:    c += store(A, DST_KSEG1, paint)
159:    if vertex:
160:        c += store(A, DST_KSEG1 + 4, paint)            # the word a (4,y) PUT reaches: linear ofs = x & 4095
161:    c += store(A, DE_MODE_DST, dst_mode)
162:    c += store(A, DE_DRAWMODE, DRAWMODE_SOLID)
163:    c += store(A, DE_FG, fg)
164:    c += store(A, DE_XVERTEX_0, vertex)
165:    c += store(A, DE_XVERTEX_1, vertex)
166:    c += store(A, DE_PRIM_START, PRIM_RECT)
167:    return c
