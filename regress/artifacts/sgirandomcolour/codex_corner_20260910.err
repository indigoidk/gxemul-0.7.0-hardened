1:#!/usr/bin/env python3
2:#  #519 kill table 1 -- the MEASURING SEAT'S OWN mutants (M13, M14), written from the (d) DEPENDS-ON
3:#  enumeration rather than from PRETABLE section 5.  Separate file from mut519.py ON PURPOSE: mut519.py
4:#  is re-read by the driver between mutants, and editing a script a run keeps re-reading changes the
5:#  instrument mid-table.
6:#  Usage: mut519b.py <path-to-clone-dev_sgi_re.c> <mutant>     exit 9 = MUTANT-TEXT-NOT-FOUND
7:import io, sys
8:P, m = sys.argv[1], sys.argv[2]
9:T = '\t'
10:OK0 = T*3 + "ok = 0;\n"
11:M = {
12: #  M13: the repair CONDITIONED on the store's own width.  `bufdepth' is a body-read lvalue -- the
13: #  guarded memory_rw() reads it as the store length -- so this is the clause-(d) operand-swap form.
14: #  Every declined row in the instrument drives BUFDEPTH_32 (mode 0x12f0 / 0x1250), so the cell
15: #  {declined type} x {bufdepth != 4} is EMPTY.  At bufdepth 1/2/8 an unhandled type stores again.
16: 'M13_widthdecline': (OK0, T*3 + "if (bufdepth == 4)\n" + T*4 + "ok = 0;\n"),
17: #  M14: the repair CONDITIONED on the addressing mode.  `tileptr'/`ofs' are body-read lvalues and
18: #  both are computed from tlb_mode; `linear' is the switch's own partition of it.  Every row drives
19: #  LIN_A (or LIN_B, which returns earlier), so the cell {declined type} x {tiled} is EMPTY.
20: 'M14_lineardecline': (OK0, T*3 + "if (linear)\n" + T*4 + "ok = 0;\n"),
21:}
22:if m not in M:
23:    print('unknown mutant', m); sys.exit(9)
24:s = io.open(P, encoding='utf-8', newline='').read()
25:old, new = M[m]
26:c = s.count(old)
27:if c != 1:
28:    print('MUTANT-TEXT-NOT-FOUND: %s matched %d times' % (m, c)); sys.exit(9)
29:io.open(P, 'w', encoding='utf-8', newline='').write(s.replace(old, new))
30:print('applied', m)
