    1: #!/usr/bin/env python3
    2: #
    3: #  sgirandomcolour -- RUNG-3 WITNESS for dev_sgi_re.c horrible_getputpixel() colour-mode default.
    4: #
    5: #  THE DEFECT.  horrible_getputpixel() extracts `color_mode = mode & DE_MODE_TYPE_MASK' (mask 0xf0)
    6: #  and switches on it during a PUT.  Four cases are implemented:
    7: #    case DE_MODE_TYPE_CI:   buf[0] = *color;
    8: #    case DE_MODE_TYPE_RGB:  buf[0] = *color >> 24; buf[1] = *color >> 16; buf[2] = *color >> 8; buf[3] = 0;
    9: #    case DE_MODE_TYPE_RGBA: buf[0] = *color >> 24; buf[1] = *color >> 16; buf[2] = *color >> 8; buf[3] = *color;
   10: #    case DE_MODE_TYPE_ABGR: buf[0] = *color; buf[1] = *color >> 8; buf[2] = *color >> 16; buf[3] = *color >> 24;
   11: #  The `default:' arm executes:
   12: #    buf[0] = random(); buf[1] = random(); buf[2] = random(); buf[3] = random();
   13: #    fatal("[ put: color mode = 0x%x ]\n", color_mode);
   14: #  and then allows the common tail to execute:
   15: #    cpu->memory_rw(cpu, cpu->mem, tileptr + ofs, buf, bufdepth, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
   16: #  which writes bufdepth bytes of that buffer to guest memory -- the four random() fills at 32 bpp, one
   17: #  of them at 8 bpp, and at bufdepth 8 those four plus an uninitialised tail (sgirebufuninit).  fatal()
   18: #  does not exit.
   19: #
   20: #  REACHABILITY: 12 of the 16 nibbles reach default:, including the documented DE_MODE_TYPE_YCRCB
   21: #  (0x000000f0 per crmfbreg.h) and reserved encodings such as 0x50.
   22: #
   23: #  POST-FIX BEHAVIOUR: an unhandled / unimplemented colour mode during a PUT declines and skips
   24: #  writing to memory, leaving the destination pre-paint intact.
   25: #
   26: #  CONTRACT (vacuity-floor clause (e)) -- what this witness catches and what it does NOT:
   27: #    CATCHES   the default arm assigning random() and storing it: `ycrcb put' and `reserved put'
   28: #              expect the destination to remain unchanged (post-fix honest decline); on HEAD they
   29: #              fail because host random() bytes overwrite the pre-painted sentinel.
   30: #    DOES NOT  implement YCRCB colour space conversion or other colour modes; it witnesses the defect
   31: #              on unhandled modes under ordinary bounds-correctness engineering.
   32: #
   33: #  usage: sgi_re_colourdefault_probe.py <gxemul-binary> [label]
   34: import os, pty, re, select, sys, time
   35: 
   36: BIN   = sys.argv[1]
   37: LABEL = sys.argv[2] if len(sys.argv) > 2 else "?"
   38: DUMMY = "/tmp/dummy_sgirand.bin"
   39: if not os.path.exists(DUMMY):
   40:     with open(DUMMY, "wb") as f:
   41:         f.write(b"\0" * 16)
   42: 
   43: CODE      = 0x80001000
   44: SCRATCH   = 0xa0001800
   45: LIVE_VAL  = 0x5a5a5a5a
   46: 
   47: RE_LINEAR_A   = 0xb5001700
   48: DE_MODE_SRC   = 0xb5002000
   49: DE_MODE_DST   = 0xb5002008
   50: DE_DRAWMODE   = 0xb5002018
   51: DE_XVERTEX_0  = 0xb5002070
   52: DE_XVERTEX_1  = 0xb5002074
   53: DE_XFER_ADDR  = 0xb50020a0
   54: DE_FG         = 0xb50020d0
   55: DE_XFER_STEPX = 0xb50020a8
   56: DE_PRIM_START = 0xb5002860
   57: 
   58: MODE_RGBA     = 0x1220        # LIN_A 0x1000 | BUFDEPTH_32 0x200 | TYPE_RGBA  0x20
   59: MODE_YCRCB    = 0x12f0        # LIN_A 0x1000 | BUFDEPTH_32 0x200 | TYPE_YCRCB 0xf0
   60: MODE_RESERVED = 0x1250        # LIN_A 0x1000 | BUFDEPTH_32 0x200 | TYPE_RESV  0x50
   61: DRAWMODE_SOLID = 0x000000f8   # PLANEMASK 0x80 | BYTEMASK 0x78 (solid fill, no XFER/ROP/STIP)
   62: PRIM_RECT     = 0x03020000    # DE_PRIM_RECTANGLE 0x03000000 | DE_PRIM_TB 0x00020000
   63: 
   64: TILE_PHYS     = 0x10000       # re_linear_a[0] = 0x10 -> physical 0x10000
   65: DST_KSEG1     = 0xa0000000 + TILE_PHYS
   66: FG_VAL        = 0xaabbccdd    # distinctive foreground colour
   67: DST_PAINT     = 0x11223344    # sentinel pattern: distinct from FG_VAL and random values
   68: 
   69: OP_NOP        = 0x00000000
   70: OP_B_SELF     = 0x1000ffff
   71: OP_SW_T0_A3   = 0xace80000    # sw $t0, 0($a3)
   72: OP_SD_T0_A3   = 0xfce80000    # sd $t0, 0($a3)
   73: OP_LW_V0_AT   = 0x8c220000    # lw $v0, 0($at)
   74: OP_SB_T0_A3   = 0xa0e80000    # sb $t0, 0($a3)   -- a NARROW store: fires a *_LEN / DE_LEN latch
   75: OP_LD_V0_AT   = 0xdc220000    # ld $v0, 0($at)   -- a 64-bit read: the TEX read decline (#513)
   76: 
   77: rows = []
   78: def row(name, got, want, note="", negate=False):
   79:     ok = (got != want) if negate else (got == want)
   80:     rows.append((name, ok))
   81:     shown = ("NOT " + str(want)) if negate else str(want)
   82:     print("%-16s %-14s %-16s %-52s %s" % (name, str(got), shown, note, "ok" if ok else "FAIL"))
   83:     return ok
   84: 
   85: def session(cmds, settle=1.5, spin=1.6):
   86:     pid, fd = pty.fork()
   87:     if pid == 0:
   88:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
   89:                        "0x80001000:" + DUMMY])
   90:         os._exit(127)
   91:     buf = ""
   92:     def rd(t):
   93:         nonlocal buf
   94:         end = time.time() + t
   95:         while time.time() < end:
   96:             r, _, _ = select.select([fd], [], [], 0.1)
   97:             if not r:
   98:                 continue
   99:             try:
  100:                 d = os.read(fd, 65536)
  101:                 if not d:
  102:                     return False
  103:                 buf += d.decode("latin-1", "replace")
  104:             except OSError:
  105:                 return False
  106:         return True
  107:     alive = rd(settle)
  108:     for i, c in enumerate(cmds):
  109:         try:
  110:             os.write(fd, (c + "\n").encode("latin-1"))
  111:         except OSError:
  112:             alive = False
  113:             break
  114:         if not rd(spin if i == len(cmds) - 1 else 0.22):
  115:             alive = False
  116:             break
  117:     try:
  118:         os.write(fd, b"quit\n"); rd(0.4)
  119:     except OSError:
  120:         pass
  121:     try:
  122:         os.close(fd)
  123:     except OSError:
  124:         pass
  125:     return buf.replace("\r", ""), alive
  126: 
  127: def printed(t, reg):
  128:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
  129:     return "absent" if not m else "0x%08x" % (int(m.group(1), 16) & 0xffffffff)
  130: 
  131: class Addr(object):
  132:     def __init__(self, base): self.a = base
  133:     def take(self, n):
  134:         got = self.a; self.a += 4 * (n + 2) + 0x20; return got
  135: 
  136: def run_ops(ops, at):
  137:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
  138:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
  139:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
  140:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
  141: 
  142: def store(A, addr, val, op=OP_SW_T0_A3):
  143:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([op], A.take(1))
  144: 
  145: SENTINEL = 0xdeadbeef
  146: def load(A, addr):
  147:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT], A.take(1))
  148: def loadop(A, addr, op):
  149:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
  150: 
  151: def setup_put(A, dst_mode, fg=FG_VAL, paint=DST_PAINT, vertex=0x00000000):
  152:     """Program the engine, paint destination with sentinel, then fire one pixel PUT.
  153:     vertex packs (x << 16) | y for XVERTEX_0/1 (draw_primitive: `>> 16) & 0x7ff' / `& 0x7ff'); the
  154:     default is (0,0).  Added on pass 2 (grok): every PUT sat at (0,0), so a guard qualified
  155:     `if (ok || x)' kept every row green.  The second-word paint is emitted ONLY for a non-origin
  156:     vertex, so every pre-existing session's command stream is unchanged by this parameter."""
  157:     c  = store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)  # re_linear_a[0] = 0x10 -> phys 0x10000
  158:     c += store(A, DST_KSEG1, paint)
  159:     if vertex:
  160:         c += store(A, DST_KSEG1 + 4, paint)            # the word a (4,y) PUT reaches: linear ofs = x & 4095
  161:     c += store(A, DE_MODE_DST, dst_mode)
  162:     c += store(A, DE_DRAWMODE, DRAWMODE_SOLID)
  163:     c += store(A, DE_FG, fg)
  164:     c += store(A, DE_XVERTEX_0, vertex)
  165:     c += store(A, DE_XVERTEX_1, vertex)
  166:     c += store(A, DE_PRIM_START, PRIM_RECT)
  167:     return c
  168: 
  169: print("sgirandomcolour RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
  170: print("%-16s %-14s %-16s %-52s %s" % ("row", "got", "want", "note", ""))
  171: 
  172: # ---------------------------------------------------------------- row 1: live
  173: A = Addr(CODE)
  174: t_live, alive_live = session(setup_put(A, MODE_RGBA) + load(A, DST_KSEG1) + ["print v0"])
  175: got_live = printed(t_live, "v0") if alive_live else "died"
  176: row("live", got_live, "0x%08x" % FG_VAL,
  177:     "LIVENESS: supported RGBA DE PUT lands known colour in destination")
  178: 
  179: # ---------------------------------------------------------------- row 2: ycrcb put
  180: A = Addr(CODE)
  181: t_ycrcb1, alive_ycrcb1 = session(setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"])
  182: got_ycrcb1 = printed(t_ycrcb1, "v0") if alive_ycrcb1 else "died"
  183: want_sentinel = "0x%08x" % DST_PAINT
  184: row("ycrcb put", got_ycrcb1, want_sentinel,
  185:     "DEFECT: YCRCB (0xf0) PUT must leave sentinel unchanged; on HEAD clobbered")
  186: 
  187: # ---------------------------------------------------------------- row 3: ycrcb attrib
  188: diag_ycrcb = "[ put: color mode = 0xf0 ]" in t_ycrcb1
  189: row("ycrcb attrib", "yes" if diag_ycrcb else "no", "yes",
  190:     "ATTRIBUTION: transcript carries `[ put: color mode = 0xf0 ]`")
  191: 
  192: # ---------------------------------------------------------------- row 4: reserved put
  193: A = Addr(CODE)
  194: t_resv, alive_resv = session(setup_put(A, MODE_RESERVED) + load(A, DST_KSEG1) + ["print v0"])
  195: got_resv = printed(t_resv, "v0") if alive_resv else "died"
  196: row("reserved put", got_resv, want_sentinel,
  197:     "RESERVED: unsupported 0x50 PUT must leave sentinel unchanged; on HEAD clobbered")
  198: 
  199: # ---------------------------------------------------------------- row 5: determinism
  200: A = Addr(CODE)
  201: t_ycrcb2, alive_ycrcb2 = session(setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"])
  202: got_ycrcb2 = printed(t_ycrcb2, "v0") if alive_ycrcb2 else "died"
  203: identical = (got_ycrcb1 == got_ycrcb2 and got_ycrcb1 != "died")
  204: got_det = "identical" if identical else "differ"
  205: row("determinism", got_det, "identical",
  206:     "DETERMINISM: repeat YCRCB put; post-fix identical (sentinel), pre-fix differs across runs")
  207: 
  208: # ================================================================ #519 DETECTOR ROWS
  209: #  The five rows above are the WITNESS (2/5 on HEAD 1ce8296 -- both unsupported-type PUTs landed host
  210: #  PRNG bytes -- and 5/5 on the fix with the same script).  The rows below DEFEND the fix.
  211: #
  212: #  CONTRACT (clause (e)).  Designed to catch: (b) the verbatim arm reinstated (random fills + an
  213: #  unlatched fatal, the store still taken -- `ycrcb put', `reserved put', `announce text'); (d) the
  214: #  `ok' guard REMOVED (the store taken with an unassigned buf -- `ycrcb put'); the decline turned
  215: #  into a ZERO FILL and a store (`ycrcb put' reads 0); `ok = 0' MOVED INSIDE THE LATCH so only the
  216: #  first declined PUT skips its store (`two declined'); the latch REMOVED (`once' reads 2); the latch
  217: #  SHARED with SGIRE_W_BADMODE (`latch indep' reads 0 after a bad TLB mode fired that bit); the
  218: #  announce SILENCED (`announce text' reads 0); a supported type dropped from the switch (its accept
  219: #  row); the accept side announcing (`live silent').  NOT rowed, disclosed: the GET default arm (a
  220: #  separate row, sgirebufuninit); 16-bit depth (the three 32-bit-type PUT arms assign four bytes, CI
  221: #  one, and a 16-bit store takes two -- the same row's question); `x`/`y` in the announce (the (4,1)
  222: #  row pins them once; other vertices are format only); per-instance latching
  223: #  (one RE instance exists); the YCRCB/reserved values other than 0xf0/0x50 (twelve nibbles reach the
  224: #  arm; two are driven, and the arm's DECISION does not depend on the nibble's value -- the announce
  225: #  prints it, which is the only read); the latch's independence is ROWED against ALL TWELVE other bits in
  226: #  ONE session (`allbits announce', with `allbits primed' proving every priming announce fired -- the
  227: #  class closure sgi_re_width_probe.py's `tex xbit' row established; a first cut of this contract
  228: #  DISCLOSED the eleven non-BADMODE bits as unrowed on a cost premise codex refuted: the cost is one
  229: #  session, not one per bit); a bit added to the enum AFTER this probe cannot be primed here and is the
  230: #  enum's own last-enumerator convention's business;
  231: #  and `two declined' does NOT distinguish the skipped store from an early `return' -- after the PUT
  232: #  switch the guarded store is the only statement, so the two are observationally identical (grok,
  233: #  minimax); the guard form is a readability choice, not an observable one.
  234: #
  235: #  The destination word is read big-endian (ip32): byte 0 of the tile is the word's top byte.
  236: 
  237: ANN = "unimplemented colour type in horrible_getputpixel"     # the post-fix announce, distinctive part
  238: DECL = "store declined (once)"
  239: MODE_CI8  = 0x1000            # LIN_A | BUFDEPTH_8  | TYPE_CI   -- one byte stored
  240: MODE_RGB  = 0x1210            # LIN_A | BUFDEPTH_32 | TYPE_RGB
  241: MODE_ABGR = 0x1230            # LIN_A | BUFDEPTH_32 | TYPE_ABGR
  242: MODE_LINB_RGBA = 0x1620       # LIN_B | BUFDEPTH_32 | TYPE_RGBA -- the TLB/mode switch's own default (BADMODE)
  243: 
  244: #  ---- accept rows: the other three supported types land their packing (de-escalation) -----------
  245: A = Addr(CODE)
  246: t_ci, alive_ci = session(setup_put(A, MODE_CI8) + load(A, DST_KSEG1) + ["print v0"])
  247: row("ci8 put", printed(t_ci, "v0") if alive_ci else "died", "0xdd223344",
  248:     "CI at 8 bpp stores ONE byte (fg & 0xff) over the paint's top byte")
  249: A = Addr(CODE)
  250: t_rgb, alive_rgb = session(setup_put(A, MODE_RGB) + load(A, DST_KSEG1) + ["print v0"])
  251: row("rgb put", printed(t_rgb, "v0") if alive_rgb else "died", "0xaabbcc00",
  252:     "RGB stores [R,G,B,pad]: three channels and a zero pad (#505's authoritative arm)")
  253: A = Addr(CODE)
  254: t_abgr, alive_abgr = session(setup_put(A, MODE_ABGR) + load(A, DST_KSEG1) + ["print v0"])
  255: row("abgr put", printed(t_abgr, "v0") if alive_abgr else "died", "0xddccbbaa",
  256:     "ABGR stores the register word byte-reversed")
  257: row("live silent", t_live.count(ANN) if alive_live else "died", 0,
  258:     "the RGBA accept session carries NO colour-type announce (the accept side stays silent)")
  259: 
  260: #  ---- the announce: present once, with the post-fix text, in the witness's ycrcb session --------
  261: row("announce text", t_ycrcb1.count(DECL) if alive_ycrcb1 else "died", 1,
  262:     "the declined PUT announces with the post-fix text ONCE (a reinstated arm or a silenced decline reads 0)")
  263: 
  264: #  ---- two declined PUTs in ONE process: the second also skips its store, and one announce -------
  265: A = Addr(CODE)
  266: t_two, alive_two = session(setup_put(A, MODE_YCRCB) + setup_put(A, MODE_RESERVED)
  267:                            + load(A, DST_KSEG1) + ["print v0"])
  268: row("two declined", printed(t_two, "v0") if alive_two else "died", "0x%08x" % DST_PAINT,
  269:     "YCRCB then RESERVED in one process: the SECOND declined PUT leaves the paint too (`ok = 0' inside the latch would store)")
  270: row("once", t_two.count(ANN) if alive_two else "died", 1,
  271:     "two declined PUTs announce EXACTLY ONCE -- the (once) latch")
  272: 
  273: #  ---- a declined PUT away from the origin (pass 2, grok): the guard qualified on the vertex ---------
  274: #  Every other PUT is at (0,0), so `if (ok || x)' (or `|| y') is invisible to them.  In the LINEAR
  275: #  path (tlb_mode 4) horrible_getputpixel computes `ofs = x & 4095' -- a BYTE offset, y ignored -- so
  276: #  this PUT at (4,1) would land whole on the second pre-painted word (ofs 4) if it stored; both
  277: #  coordinates are non-zero so either one-token qualifier lets the store through.  A first cut of
  278: #  this row used (1,0) and claimed `ofs = 1 * bufdepth': wrong for the linear path (byte 1, straddling
  279: #  two words) -- corrected before any table ran on it.
  280: A = Addr(CODE)
  281: VTX41 = (4 << 16) | 1
  282: t_x1, alive_x1 = session(setup_put(A, MODE_YCRCB, vertex=VTX41) + load(A, DST_KSEG1 + 4) + ["print v0"])
  283: row("ycrcb x4y1", printed(t_x1, "v0") if alive_x1 else "died", "0x%08x" % DST_PAINT,
  284:     "a declined PUT at (4,1) leaves the second word (linear ofs = x & 4095): kills `if (ok || x)' and `|| y'")
  285: row("x4y1 announce", t_x1.count("horrible_getputpixel, x=4 y=1") if alive_x1 else "died", 1,
  286:     "and the one announce names that vertex in its own text (x=4 y=1)")
  287: 
  288: #  ---- CLASS CLOSURE on the latch-collision axis: every other bit set FIRST, then the colour decline -----
  289: #  sgi_re_width_probe.py's `tex xbit' row proved this priming sequence fires bits 0-10 (bits 0-5 by a byte
  290: #  store to each RE window; 6 a byte store to the DE window; 7/8 a store to and a load from the straggler
  291: #  offset 0x1800; 9 an unimplemented drawing op; 10 a LIN_B rectangle) and its `tex rd lat1' row that a
  292: #  64-bit read of CRIME_RE_TEX fires bit 11.  With bits 0-11 all set, a BADCOLOR latch that SHARES any of
  293: #  them is already silenced when the YCRCB PUT arrives and `allbits announce' reads 0.  `allbits primed'
  294: #  counts the twelve priming announces so a priming access that silently stops firing reds the row
  295: #  instead of leaving a hole (the width probe's own repair for the same vacuity).  One session; the
  296: #  paint row is the decline control.  Added on the pass-2 repair chain at codex's finding.  LOAD
  297: #  SENSITIVITY (codex, by reading session()): 197 commands at fixed 0.22 s windows and a 4.0 s final
  298: #  spin -- a delayed-but-healthy emulator can leave `print v0' unread and the paint row reads `absent'.
  299: #  That is a loud false RED on the fix, never a false green; re-run alone before believing it.
  300: A = Addr(CODE)
  301: RE_WINDOWS = (0xb5001000, 0xb5001200, 0xb5001400, 0xb5001600, 0xb5001700, 0xb5001780)  # TLB_A..LINEAR_B
  302: DE_BASE   = 0xb5002000            # DEVICE_ACCESS(sgi_de): a byte access fires SGIRE_W_DE_LEN
  303: OUTSIDE   = 0xb5001800            # past LINEAR_B: the straggler arm (UNMAP_WR / UNMAP_RD)
  304: PRIM_BAD  = 0x05020000            # an UNIMPLEMENTED drawing op (only LINE and RECTANGLE exist)
  305: TEX_BASE  = 0xb5001600
  306: prime = []
  307: for _w in RE_WINDOWS:
  308:     prime += store(A, _w, 0x1, op=OP_SB_T0_A3)             # bits 0-5
  309: prime += store(A, DE_BASE, 0x1, op=OP_SB_T0_A3)            # bit 6
  310: prime += store(A, OUTSIDE, 0x1, op=OP_SB_T0_A3)            # bit 7
  311: prime += loadop(A, OUTSIDE, OP_LW_V0_AT)                   # bit 8
  312: prime += setup_put(A, MODE_LINB_RGBA)                      # bit 10 (a real 1x1 rectangle into LIN_B)
  313: prime += store(A, DE_PRIM_START, PRIM_BAD)                 # bit 9
  314: prime += loadop(A, TEX_BASE, OP_LD_V0_AT)                  # bit 11
  315: PRIME_LIT = ["for CRIME_RE_%s -- declined." % _n for _n in ("TLB_A", "TLB_B", "TLB_C", "TEX", "LINEAR_A", "LINEAR_B")] + [
  316:     "[ sgi_de: unimplemented len=",                       # bit 6  DE_LEN
  317:     "unimplemented write to address 0x1800",              # bit 7  UNMAP_WR
  318:     "unimplemented read from address 0x1800",             # bit 8  UNMAP_RD
  319:     "UNIMPLEMENTED drawing op",                           # bit 9  PRIM_OP
  320:     "unimplemented dst_mode",                             # bit 10 BADMODE
  321:     "unimplemented read from CRIME_RE_TEX -- declined."]  # bit 11 TEX_RD
  322: t_all, alive_all = session(prime + setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"], spin=4.0)
  323: fired_all = sum(1 for _lit in PRIME_LIT if _lit in t_all)
  324: row("allbits primed", "%i/%i" % (fired_all, len(PRIME_LIT)) if alive_all else "died", "%i/%i" % (len(PRIME_LIT), len(PRIME_LIT)),
  325:     "all twelve other latches PROVEN fired before the colour decline (the row proves its own setup)")
  326: row("allbits announce", t_all.count(ANN) if alive_all else "died", 1,
  327:     "with every other bit set, the colour decline still announces once: a latch sharing ANY bit reads 0")
  328: row("allbits paint", printed(t_all, "v0") if alive_all else "died", "0x%08x" % DST_PAINT,
  329:     "and the declined PUT stored nothing (control)")
  330: 
  331: #  ---- the latch bit is its own: a BADMODE decline first, then a colour decline still announces --
  332: A = Addr(CODE)
  333: t_ind, alive_ind = session(setup_put(A, MODE_LINB_RGBA) + setup_put(A, MODE_YCRCB)
  334:                            + load(A, DST_KSEG1) + ["print v0"])
  335: row("latch indep", t_ind.count(ANN) if alive_ind else "died", 1,
  336:     "LIN_B fires SGIRE_W_BADMODE first; the colour decline still announces once (a shared bit reads 0)")
  337: row("indep paint", printed(t_ind, "v0") if alive_ind else "died", "0x%08x" % DST_PAINT,
  338:     "the YCRCB PUT after the LIN_B decline stored nothing (the LIN_B half is re-painted over and NOT observed here -- grok)")
  339: 
  340: 
  341: ok = sum(1 for _, o in rows if o)
  342: print()
  343: print("SGICOLOUR_RESULT=%d/%d" % (ok, len(rows)))
  344: print("SGICOLOUR_DONE")
  345: sys.exit(0 if ok == len(rows) else 1)

