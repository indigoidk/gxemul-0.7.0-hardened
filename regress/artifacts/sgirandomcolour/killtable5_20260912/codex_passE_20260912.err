1: #!/usr/bin/env python3
2: """#519 kill table 5 mutator.  usage: mutate519k5.py <SEC dev_sgi_re.c> <out path> <LEG>
3: 
4: Every leg is ONE replacement of the unique line `\t\t\tok = 0;`, text exactly as specified in
5: regress/artifacts/sgirandomcolour/codex_closurediff_20260912b.txt.  A find-text that does not
6: occur EXACTLY ONCE is a hard failure (exit 3): a leg that silently measured the unmutated tree
7: would read as a surviving mutant.  BASE copies the source unchanged."""
8: import io, sys
9: 
10: OLD = "\t\t\tok = 0;\n"
11: PRE = "\t\t\tmemset(buf, 0, sizeof(buf)); ok = "
12: 
13: def first(tm, depth):
14:     return PRE + "(tlb_mode == %d && bufdepth == %d && !(d->warned & SGIRE_W_BADCOLOR));\n" % (tm, depth)
15: 
16: LEGS = {
17:     "FIRST_A2_ZERO":  first(0, 2),
18:     "FIRST_A8_ZERO":  first(0, 8),
19:     "FIRST_B2_ZERO":  first(1, 2),
20:     "FIRST_B4_ZERO":  first(1, 4),
21:     "FIRST_B8_ZERO":  first(1, 8),
22:     "FIRST_C2_ZERO":  first(2, 2),
23:     "FIRST_C4_ZERO":  first(2, 4),
24:     "FIRST_C8_ZERO":  first(2, 8),
25:     "FIRST_L2_ZERO":  first(4, 2),
26:     "FIRST_L8_ZERO":  first(4, 8),
27:     "REPEAT_L1_ZERO": PRE + "(tlb_mode == 4 && bufdepth == 1 && (d->warned & SGIRE_W_BADCOLOR) != 0);\n",
28:     "NIB_OTHER_ZERO": PRE + "(color_mode != 0xf0 && color_mode != 0x50);\n",
29:     "TAIL8_ZERO":     "\t\t\tok = 0; if (bufdepth == 8) { memset(buf, 0, sizeof(buf)); cpu->memory_rw(cpu, "
30:                       "cpu->mem, tileptr + ofs + 4, buf, 4, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL); }\n",
31: }
32: 
33: src, dst, leg = sys.argv[1:4]
34: t = io.open(src, encoding="utf-8").read()
35: if leg != "BASE":
36:     if leg not in LEGS:
37:         sys.exit("unknown leg %s" % leg)
38:     n = t.count(OLD)
39:     if n != 1:
40:         sys.stderr.write("FIND-TEXT occurs %d times, not 1 -- REFUSING\n" % n)
41:         sys.exit(3)
42:     t = t.replace(OLD, LEGS[leg])
43: io.open(dst, "w", encoding="utf-8", newline="\n").write(t)
44: print("MUTATED %s" % leg)

