752: # ================================================================ #519 bounded closure
753: # Ten fresh first-decline sessions, one primed repeat session, and the M28-family row.
754: # Each table entry contributes ONE assertion: its readbacks and announce count.
755: # The RGBA control uses four initialized bytes, including for depth-eight declines.
756: # A fresh session has BADCOLOR clear; the RGBA control leaves it clear.
757: CL519_CASES = (
758:     ("tA d2 first",   0x01f0, KS_A,       False, "FIRST_A2_ZERO"),
759:     ("tA d8 first",   0x03f0, KS_A,       False, "FIRST_A8_ZERO"),
760:     ("tB d2 first",   0x05f0, KS_B,       False, "FIRST_B2_ZERO"),
761:     ("tB d4 first",   0x06f0, KS_B,       False, "FIRST_B4_ZERO"),
762:     ("tB d8 first",   0x07f0, KS_B,       False, "FIRST_B8_ZERO"),
763:     ("tC d2 first",   0x09f0, KS_C,       False, "FIRST_C2_ZERO"),
764:     ("tC d4 first",   0x0af0, KS_C,       False, "FIRST_C4_ZERO"),
765:     ("tC d8 first",   0x0bf0, KS_C,       False, "FIRST_C8_ZERO"),
766:     ("lin d2 first",  0x11f0, DST_KSEG1,  False, "FIRST_L2_ZERO"),
767:     ("lin d8 first",  0x13f0, DST_KSEG1,  False, "FIRST_L8_ZERO"),
768:     ("lin d1 repeat", 0x10f0, DST_KSEG1,  True,  "REPEAT_L1_ZERO"),
769:     ("M28 nib60",     0x1260, DST_KSEG1,  False, "NIB_OTHER_ZERO"),
770: )
771: for _name, _mode, _ks, _repeat, _control in CL519_CASES:
772:     A = Addr(CODE)
773:     _cmds = tiled_prologue(A)
774:     _cmds += store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)
775:     _modes = [(_mode & 0x1c00) | 0x0220]
776:     _want = ["0x%08x" % FG_VAL]
777:     if _repeat:
778:         # This first decline is itself read before the target cell repaints.
779:         _modes.append(MODE_YCRCB)
780:         _want.append(cell_want(MODE_YCRCB))
781:     _modes.append(_mode)
782:     _want.append(cell_want(_mode))
783:     for _m in _modes:
