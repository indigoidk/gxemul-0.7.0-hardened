496: #  window tag, destination, four ACCEPT cells (name, mode, expected word), four DECLINED cells
497: #  (name, mode) spanning the whole bufdepth domain, and the mode repeated once with the latch set.
498: for _tag, _ks, _acc, _dec, _rpt in (
499:     ("tA", KS_A, (("ci8", 0x0000, "0xdd223344"), ("rgb",  0x0210, "0xaabbcc00"),
500:                   ("rgba", 0x0220, "0xaabbccdd"), ("abgr", 0x0230, "0xddccbbaa")),
501:                  (("d1", 0x00f0), ("d2", 0x01f0), ("d4", 0x02f0), ("d8", 0x03f0)), 0x00f0),
