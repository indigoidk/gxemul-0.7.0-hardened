116: def session(cmds, settle=1.5, spin=1.6):
117:     pid, fd = pty.fork()
118:     if pid == 0:
119:         os.execv(BIN, [BIN, "-V", "-x", "-E", "sgi", "-e", "ip32", "-M", "64",
120:                        "0x80001000:" + DUMMY])
121:         os._exit(127)
122:     buf = ""
123:     def rd(t):
124:         nonlocal buf
125:         end = time.time() + t
126:         while time.time() < end:
127:             r, _, _ = select.select([fd], [], [], 0.1)
128:             if not r:
129:                 continue
130:             try:
131:                 d = os.read(fd, 65536)
132:                 if not d:
133:                     return False
134:                 buf += d.decode("latin-1", "replace")
135:             except OSError:
136:                 return False
137:         return True
138:     alive = rd(settle)
139:     for i, c in enumerate(cmds):
140:         try:
141:             os.write(fd, (c + "\n").encode("latin-1"))
142:         except OSError:
143:             alive = False
144:             break
145:         if not rd(spin if i == len(cmds) - 1 else 0.22):
146:             alive = False
147:             break
148:     try:
149:         os.write(fd, b"quit\n"); rd(0.4)
150:     except OSError:
151:         pass
152:     try:
153:         os.close(fd)
154:     except OSError:
155:         pass
156:     return buf.replace("\r", ""), alive
157: 
158: def printed(t, reg):
159:     m = re.search(r"print\s+%s\s*\n\s*(0x[0-9a-f]+)" % reg, t)
160:     return "absent" if not m else "0x%08x" % (int(m.group(1), 16) & 0xffffffff)
161: 
162: class Addr(object):
163:     def __init__(self, base): self.a = base
164:     def take(self, n):
165:         got = self.a; self.a += 4 * (n + 2) + 0x20; return got
166: 
167: def run_ops(ops, at):
168:     put = ["put w 0x%x, 0x%08x" % (at + 4 * i, op) for i, op in enumerate(ops)]
169:     put += ["put w 0x%x, 0x%08x" % (at + 4 * len(ops), OP_B_SELF),
170:             "put w 0x%x, 0x%08x" % (at + 4 * len(ops) + 4, OP_NOP)]
171:     return put + ["pc=0x%x" % at, "step %d" % len(ops)]
172: 
173: def store(A, addr, val, op=OP_SW_T0_A3):
174:     return ["a3=0x%x" % addr, "t0=0x%x" % val] + run_ops([op], A.take(1))
175: 
176: SENTINEL = 0xdeadbeef
177: def load(A, addr):
178:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([OP_LW_V0_AT], A.take(1))
179: def loadop(A, addr, op):
180:     return ["at=0x%x" % addr, "v0=0x%x" % SENTINEL] + run_ops([op], A.take(1))
181: 
182: def setup_put(A, dst_mode, fg=FG_VAL, paint=DST_PAINT, vertex=0x00000000):
183:     """Program the engine, paint destination with sentinel, then fire one pixel PUT.
184:     vertex packs (x << 16) | y for XVERTEX_0/1 (draw_primitive: `>> 16) & 0x7ff' / `& 0x7ff'); the
185:     default is (0,0).  Added on pass 2 (grok): every PUT sat at (0,0), so a guard qualified
186:     `if (ok || x)' kept every row green.  The second-word paint is emitted ONLY for a non-origin
187:     vertex, so every pre-existing session's command stream is unchanged by this parameter."""
188:     c  = store(A, RE_LINEAR_A, 0x0000001000000000, op=OP_SD_T0_A3)  # re_linear_a[0] = 0x10 -> phys 0x10000
189:     c += store(A, DST_KSEG1, paint)
190:     if vertex:
191:         c += store(A, DST_KSEG1 + 4, paint)            # the word a (4,y) PUT reaches: linear ofs = x & 4095
192:     c += store(A, DE_MODE_DST, dst_mode)
193:     c += store(A, DE_DRAWMODE, DRAWMODE_SOLID)
194:     c += store(A, DE_FG, fg)
195:     c += store(A, DE_XVERTEX_0, vertex)
196:     c += store(A, DE_XVERTEX_1, vertex)
197:     c += store(A, DE_PRIM_START, PRIM_RECT)
198:     return c
199: 
200: print("sgirandomcolour RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
201: print("%-16s %-14s %-16s %-52s %s" % ("row", "got", "want", "note", ""))
202: 
203: # ---------------------------------------------------------------- row 1: live
204: A = Addr(CODE)
205: t_live, alive_live = session(setup_put(A, MODE_RGBA) + load(A, DST_KSEG1) + ["print v0"])
206: got_live = printed(t_live, "v0") if alive_live else "died"
207: row("live", got_live, "0x%08x" % FG_VAL,
208:     "LIVENESS: supported RGBA DE PUT lands known colour in destination")
209: 
210: # ---------------------------------------------------------------- row 2: ycrcb put
211: A = Addr(CODE)
212: t_ycrcb1, alive_ycrcb1 = session(setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"])
213: got_ycrcb1 = printed(t_ycrcb1, "v0") if alive_ycrcb1 else "died"
214: want_sentinel = "0x%08x" % DST_PAINT
215: row("ycrcb put", got_ycrcb1, want_sentinel,
216:     "DEFECT: YCRCB (0xf0) PUT must leave sentinel unchanged; on HEAD clobbered")
217: 
218: # ---------------------------------------------------------------- row 3: ycrcb attrib
219: diag_ycrcb = "[ put: color mode = 0xf0 ]" in t_ycrcb1
220: row("ycrcb attrib", "yes" if diag_ycrcb else "no", "yes",
221:     "ATTRIBUTION: transcript carries `[ put: color mode = 0xf0 ]`")
222: 
223: # ---------------------------------------------------------------- row 4: reserved put
224: A = Addr(CODE)
225: t_resv, alive_resv = session(setup_put(A, MODE_RESERVED) + load(A, DST_KSEG1) + ["print v0"])
226: got_resv = printed(t_resv, "v0") if alive_resv else "died"
227: row("reserved put", got_resv, want_sentinel,
228:     "RESERVED: unsupported 0x50 PUT must leave sentinel unchanged; on HEAD clobbered")
229: 
230: # ---------------------------------------------------------------- row 5: determinism
231: A = Addr(CODE)
232: t_ycrcb2, alive_ycrcb2 = session(setup_put(A, MODE_YCRCB) + load(A, DST_KSEG1) + ["print v0"])
233: got_ycrcb2 = printed(t_ycrcb2, "v0") if alive_ycrcb2 else "died"
234: identical = (got_ycrcb1 == got_ycrcb2 and got_ycrcb1 != "died")
235: got_det = "identical" if identical else "differ"
236: row("determinism", got_det, "identical",
237:     "DETERMINISM: repeat YCRCB put; post-fix identical (sentinel), pre-fix differs across runs")
238: 
239: # ================================================================ #519 DETECTOR ROWS
240: #  The five rows above are the WITNESS (2/5 on HEAD 1ce8296 -- both unsupported-type PUTs landed host
241: #  PRNG bytes -- and 5/5 on the fix with the same script).  The rows below DEFEND the fix.
242: #
243: #  CONTRACT (clause (e)).  Designed to catch: (b) the verbatim arm reinstated (random fills + an
244: #  unlatched fatal, the store still taken -- `ycrcb put', `reserved put', `announce text'); (d) the
245: #  `ok' guard REMOVED (the store taken with an unassigned buf -- `ycrcb put'); the decline turned
246: #  into a ZERO FILL and a store (`ycrcb put' reads 0); `ok = 0' MOVED INSIDE THE LATCH so only the
247: #  first declined PUT skips its store (`two declined'); the latch REMOVED (`once' reads 2); the latch
248: #  SHARED with SGIRE_W_BADMODE (`latch indep' reads 0 after a bad TLB mode fired that bit); the
249: #  announce SILENCED (`announce text' reads 0); a supported type dropped from the switch (its accept
250: #  row); the accept side announcing (`live silent').  NOT rowed, disclosed: the GET default arm (a
251: #  separate row, sgirebufuninit); 16-bit depth (the three 32-bit-type PUT arms assign four bytes, CI
252: #  one, and a 16-bit store takes two -- the same row's question); `x`/`y` in the announce (the (4,1)
253: #  row pins them once; other vertices are format only); per-instance latching
254: #  (one RE instance exists); the YCRCB/reserved values other than 0xf0/0x50 (twelve nibbles reach the
255: #  arm; two are driven, and the arm's DECISION does not depend on the nibble's value -- the announce
256: #  prints it, which is the only read); the latch's independence is ROWED against ALL TWELVE other bits in
257: #  ONE session (`allbits announce', with `allbits primed' proving every priming announce fired -- the
258: #  class closure sgi_re_width_probe.py's `tex xbit' row established; a first cut of this contract
259: #  DISCLOSED the eleven non-BADMODE bits as unrowed on a cost premise codex refuted: the cost is one
260: #  session, not one per bit); a bit added to the enum AFTER this probe cannot be primed here and is the
261: #  enum's own last-enumerator convention's business;
262: #  and `two declined' does NOT distinguish the skipped store from an early `return' -- after the PUT
263: #  switch the guarded store is the only statement, so the two are observationally identical (grok,
264: #  minimax); the guard form is a readability choice, not an observable one.
265: #
266: #
267: #  CONTRACT, EXTENDED BY THE PASS-3 CLOSURE (the rows above this point are unchanged).  The two
268: #  clause-(d) mutants `M13_widthdecline' and `M14_lineardecline' were MEASURED TOTAL ESCAPES of the
269: #  19-row instrument, so the (d) enumeration was reopened over the two lvalues the guarded store
270: #  actually reads.  NOW CAUGHT, and caught over a DOMAIN rather than a mutant list: all sixteen
271: #  cells of {tlb_mode in TLB_A, TLB_B, TLB_C, LIN_A} x {bufdepth in 1, 2, 4, 8} are driven with an
272: #  unsupported colour type and a readback, so no predicate over tlb_mode and bufdepth alone can be
273: #  false at every declined cell.  Also caught: a decode that sends one window's PUT to another
274: #  window's array (the three tiles are distinct, and each window has its own four accept cells);
275: #  a latch or an announce conditioned on the addressing mode (each window has its own silent /
276: #  first-announce / cumulative-one triple).
277: #  *** DISCLOSURES (i), (ii) AND (iii) BELOW WERE MEASURED TO BE FLOOR BREACHES, NOT DEBT, AND
278: #  ARE NOW CLOSED BY THE PASS-4 BLOCK AT THE END OF THIS FILE.  The text is kept because it is
279: #  the record being corrected, and because its REASON was wrong in a way worth not repeating. ***
280: #

 succeeded in 165ms:
220:  */
221: void horrible_getputpixel(int put, struct cpu* cpu, struct sgi_re_data* d,
222: 	int x, int y, uint32_t* color, int mode)
223: {
224: 	uint32_t color_mode = mode & DE_MODE_TYPE_MASK;
225: 	int bufdepth = 1 << ((mode >> 8) & 3); 
226: 
227: 	// dst_mode (see NetBSD's crmfbreg.h):
228: 	// #define DE_MODE_TLB_A           0x00000000
229: 	// #define DE_MODE_TLB_B           0x00000400
230: 	// #define DE_MODE_TLB_C           0x00000800
231: 	// #define DE_MODE_LIN_A           0x00001000
232: 	// #define DE_MODE_LIN_B           0x00001400
233: 	uint32_t tlb_mode = (mode >> 10) & 0x7;
234: 	int linear = tlb_mode > 3;
235: 
236: 	if (!linear && (x < 0 || y < 0 || x >= 2048 || y >= 2048))
237: 		return;
238: 
239: 	int tilewidth_in_pixels = 512 / bufdepth;
240: 	
241: 	int tile_nr_x = x / tilewidth_in_pixels;
242: 	int tile_nr_y = y >> 7;
243: 
244: 	unsigned int tile_nr = tile_nr_y * 16 + tile_nr_x;
245: 
246: 	y &= 127;
247: 	int xofs = (x % tilewidth_in_pixels) * bufdepth;
248: 	int ofs = 512 * y + xofs;
249: 
250: 	uint32_t tileptr = 0;
251: 
252: 	/*  #100: cases 0-2 index re_tlb_[abc][256] with a guest-derived
253: 	    tile_nr = (y>>7)*16 + x/tilewidth; bound it (case 4 self-checks).  */
254: 	if (tlb_mode <= 2 && tile_nr >= 256)
255: 		return;
256: 
257: 	switch (tlb_mode) {
258: 	case 0:	tileptr = d->re_tlb_a[tile_nr] << 16;
259: 		break;
260: 	case 1:	tileptr = d->re_tlb_b[tile_nr] << 16;
261: 		break;
262: 	case 2:	tileptr = d->re_tlb_c[tile_nr] << 16;
263: 		break;
264: 	case 4:	tile_nr = x >> 12;
265: 		if (tile_nr >= 32)
266: 			return;
267: 		tileptr = 0x80000000 | (d->re_linear_a[tile_nr] << 12);
268: 		ofs = x & 4095;
269: 		// TODO... probably not correct!
270: 		// printf("tileptr = %08x x = %i y = %i tile_nr = %i ofs = %i\n", tileptr, x, y, tile_nr, ofs);
271: 		break;
272: 	default:/*  sgirandompixel: this arm used to assign `*color = random()' -- with
273: 		    its exit(1) commented out -- so a failed GET handed the CALLER a
274: 		    random value, and draw_primitive() then wrote it to the destination
275: 		    in the same loop iteration, since `color' is shared by the XFER GET
276: 		    and the PUT.  DE_MODE_LIN_B (0x1400) is one of the FIVE modes
277: 		    crmfbreg.h documents and extracts to tlb_mode 5, so this was
278: 		    reachable with a DOCUMENTED mode, not only with a junk one.
279: 		    MEASURED, rung 3: the destination received 0x4b1763a1, 0x2ee4b4df
280: 		    and 0x7433cdc1 on successive runs of
281: 		    regress/sgi_re_randompixel_probe.py.
282: 
283: 		    NOW DECLINED: `*color' is left alone, so the caller's own
284: 		    `uint32_t color = fg' stands and what lands is at least
285: 		    DETERMINISTIC.  The announce is latched because this helper is
286: 		    per-pixel.
287: 
288: 		    WHAT THIS DOES NOT DO, filed rather than silently omitted: the
289: 		    caller STILL PERFORMS its dependent PUT, so a declined GET still
290: 		    writes fg (row sgirandomskipput -- suppressing it needs a return
291: 		    value and every GET site changed, which is more than one site);
292: 		    LIN_B is still not implemented, and the panel refused to endorse
293: 		    implementing it as LIN_A-with-the-other-array on symmetry alone
294: 		    (row sgirelinb); and the COLOUR-mode switch below carries the same
295: 		    random() shape at its own default (row sgirandomcolour).  */
296: 		if (!(d->warned & SGIRE_W_BADMODE)) {
297: 			d->warned |= SGIRE_W_BADMODE;
298: 			/*  `dst_mode' is kept from the original text although the
299: 			    parameter is also passed as src_mode on a GET: the probe
300: 			    anchors on this literal, and rewording it here would be
301: 			    scope creep AND would move an oracle anchor mid-round,
302: 			    which is the laundering shape whatever the intent.
303: 			    Filed as sgirenamedstmode.  */
304: 			fatal("[ sgi_re: unimplemented dst_mode %i for "
305: 			    "horrible_getputpixel (%s), x=%i y=%i; declined "
306: 			    "(once) ]\n", mode, put ? "put" : "get", x, y);
307: 		}
308: 		return;
309: 	}
310: 
311: 	// The highest bit seems to be set for a "valid" tile pointer.
312: 	if (!(tileptr & 0x80000000)) {
313: 		//printf("dst_mode %i, tile_nr = %i,  tileptr = 0x%llx\n", dst_mode, tile_nr, (long long)tileptr);
314: 		//fatal("sgi gbe horrible_getputpixel: unexpected non-set high bit of tileptr?\n");
315: 		//exit(1);
316: 		return;
317: 	}
318: 	
319: 	tileptr &= ~0x80000000;
320: 
321: 	uint8_t buf[8];		/* #100: bufdepth can be 8 = 1<<((mode>>8)&3) */
322: 	if (put) {
323: 		int ok = 1;	/*  #519: cleared by the default arm below  */
324: 		switch (color_mode) {
325: 		case DE_MODE_TYPE_CI:
326: 			buf[0] = *color;
327: 			break;
328: 		case DE_MODE_TYPE_RGB:
329: 			buf[0] = *color >> 24;
330: 			buf[1] = *color >> 16;
331: 			buf[2] = *color >> 8;
332: 			buf[3] = 0;
333: 			break;
334: 		case DE_MODE_TYPE_RGBA:
335: 			buf[0] = *color >> 24;
336: 			buf[1] = *color >> 16;
337: 			buf[2] = *color >> 8;
338: 			buf[3] = *color;
339: 			break;
340: 		case DE_MODE_TYPE_ABGR:
341: 			buf[0] = *color;
342: 			buf[1] = *color >> 8;
343: 			buf[2] = *color >> 16;
344: 			buf[3] = *color >> 24;
345: 			break;
346: 		default:/*  #519 (sgirandomcolour): this arm was `buf[0..3] = random()'
347: 			    and an UNLATCHED per-pixel fatal(), after which the common
348: 			    store below wrote four HOST-PRNG bytes into guest memory.
349: 			    Twelve of the sixteen type nibbles reach here, the documented
350: 			    DE_MODE_TYPE_YCRCB among them.  MEASURED at rung 3
351: 			    (regress/sgi_re_colourdefault_probe.py): a destination
352: 			    pre-painted 0x11223344 read 0x56e8857a and 0x38abc4e1 on two
353: 			    runs -- neither the paint nor any packing of the colour, and
354: 			    different each run because main.c seeds random() per process.
355: 
356: 			    NOW DECLINED, member 3: the STORE IS SKIPPED, so the
357: 			    destination keeps what the guest had -- not a zero fill, which
358: 			    would publish a colour the guest never asked for (random() with
359: 			    the entropy stripped) -- and the announce is latched on its own
360: 			    bit because this helper is per-pixel.  The old literal is kept
361: 			    as the prefix: the witness attributes on it.  A declined PUT
362: 			    never reads buf, so the width question (sgirebufuninit) is a
363: 			    separate row, and the GET default below is untouched.  */
364: 			ok = 0;
365: 			if (!(d->warned & SGIRE_W_BADCOLOR)) {
366: 				d->warned |= SGIRE_W_BADCOLOR;
367: 				fatal("[ put: color mode = 0x%x ] [ sgi_re: unimplemented "
368: 				    "colour type in horrible_getputpixel, x=%i y=%i; store "
369: 				    "declined (once) ]\n", color_mode, x, y);
370: 			}
371: 		}
372: 
373: 		if (ok)	/*  #519: a declined type stores nothing  */
374: 			cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
375: 			    buf, bufdepth, MEM_WRITE, NO_EXCEPTIONS | PHYSICAL);
376: 	} else {
377: 		cpu->memory_rw(cpu, cpu->mem, tileptr + ofs,
378: 		    buf, bufdepth, MEM_READ, NO_EXCEPTIONS | PHYSICAL);
379: 
380: 		switch (color_mode) {
381: 		case DE_MODE_TYPE_CI:
382: 			*color = buf[0];
383: 			break;
384: 		case DE_MODE_TYPE_RGB:
385: 			/*  #505: this read buf[1..3] while the PUT arm above
386: 			    writes the three channels at buf[0..2] and an
387: 			    explicit pad at buf[3] -- so an RGB pixel did not
388: 			    survive its own round trip, shifting one byte left
389: 			    with a zero fill on every RGB source read.
390: 
391: 			    The PUT arm is the authoritative one, and the
392: 			    warrant is OUTSIDE this function: dev_sgi_gbe.c's
393: 			    scanout reads the same tile memory back for display
394: 			    as (buf[0]<<24)+(buf[1]<<16)+(buf[2]<<8)+buf[3],
395: 			    then CRMFB_MODE_TYP_RGB8 takes R,G,B from bits
396: 			    31..24, 23..16 and 15..8 -- byte 0 is R and byte 3
397: 			    is UNUSED.  So the pad sits at buf[3] because the
398: 			    consumer ignores buf[3], not because PUT writes a
399: 			    zero there; that is what makes this non-circular.
400: 			    The RGBA and ABGR PUT arms independently agree --
401: 			    both lay [R,G,B,x] in memory despite opposite
402: 			    register word orders -- which leaves this GET the
403: 			    lone container outlier among the 32-bit arms.
404: 
405: 			    The low byte stays ZERO on purpose: RGB carries
406: 			    three channels, so a corrected read of 0xaabbccdd
407: 			    yields 0xaabbcc00, NOT the source word.  */
408: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8);
409: 			break;
410: 		case DE_MODE_TYPE_RGBA:
411: 			*color = (buf[0] << 24) + (buf[1] << 16) + (buf[2] << 8) + buf[3];
412: 			break;
413: 		case DE_MODE_TYPE_ABGR:
414: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
415: 			break;
416: 		default:// Read "raw" 32-bit value:
417: 			*color = (buf[3] << 24) + (buf[2] << 16) + (buf[1] << 8) + buf[0];
418: 			fatal("[ get: color mode = 0x%x ]\n", color_mode);
419: 		}
420: 	}
421: }
