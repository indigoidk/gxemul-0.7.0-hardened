465: DST_PAINT_TAIL = 0x55667788
466: 
467: def cell_want(mode):
468:     return ("0x%08x%08x" % (DST_PAINT, DST_PAINT_TAIL)
469:             if ((mode >> 8) & 3) == 3 else "0x%08x" % DST_PAINT)
