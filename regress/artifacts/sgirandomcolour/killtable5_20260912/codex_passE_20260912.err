791: ok = sum(1 for _, o in rows if o)
792: print()
793: print("SGICOLOUR_RESULT=%d/%d" % (ok, len(rows)))
794: print("SGICOLOUR_DONE")
795: sys.exit(0 if ok == len(rows) else 1)

codex
