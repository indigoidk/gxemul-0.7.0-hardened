675: #
676: #  THE CELLS, tiled TLB_A at bufdepth 4 so tilewidth_in_pixels is 128:
677: #      C1 (132,  0)  tile_nr_x 1  tile_nr_y 0  tile_nr  1  y 0  xofs 16  ofs  16 -> tile  1
678: #      C2 (  0,  1)  tile_nr_x 0  tile_nr_y 0  tile_nr  0  y 1  xofs  0  ofs 512 -> tile  0
679: #      C3 (  0,128)  tile_nr_x 0  tile_nr_y 1  tile_nr 16  y 0  xofs  0  ofs   0 -> tile 16
680: #      C4 (132,129)  tile_nr_x 1  tile_nr_y 1  tile_nr 17  y 1  xofs 16  ofs 528 -> tile 17
681: #  against the existing (0,0), where all seven of those are ZERO.
682: #
683: #  x IS 132 AND NOT 128 ON PURPOSE: it makes tile_nr_x AND xofs non-zero in ONE cell, which is
