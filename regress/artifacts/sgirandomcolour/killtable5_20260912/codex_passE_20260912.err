785:     _t, _alive = session(_cmds, spin=3.0)
786:     _got = printed_seq(_t, _modes) if _alive else []
787:     row(_name, (tuple(_got), _t.count(ANN)) if _alive else "died",
788:         (tuple(_want), 1),
789:         "readbacks in operation order; one announce; control=" + _control)
