471: def cell_op(A, mode, ks):
472:     """Repaint, fire one synchronous PUT, then read its whole transfer span."""
473:     depth8 = ((mode >> 8) & 3) == 3
474:     paint = ["put w 0x%x, 0x%08x" % (ks, DST_PAINT)]
475:     if depth8:
476:         paint += ["put w 0x%x, 0x%08x" % (ks + 4, DST_PAINT_TAIL)]
477:     return (paint
478:             + ["a3=0x%x" % DE_MODE_DST,   "t0=0x%x" % mode,
479:                "a2=0x%x" % DE_PRIM_START, "t1=0x%x" % PRIM_RECT,
480:                "at=0x%x" % ks,            "v0=0x%x" % SENTINEL]
481:             + run_ops([OP_SW_T0_A3, OP_SW_T1_A2,
482:                        OP_LD_V0_AT if depth8 else OP_LW_V0_AT], A.take(3))
483:             + ["print v0"])
