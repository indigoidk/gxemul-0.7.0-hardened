485: def printed_seq(t, modes=None):
486:     raw = re.findall(r"print\s+v0\s*\n\s*(0x[0-9a-f]+)", t)
487:     if modes is None:
488:         return ["0x%08x" % (int(v, 16) & 0xffffffff) for v in raw]
489:     if len(raw) != len(modes):
490:         return []
491:     return [("0x%016x" % (int(v, 16) & 0xffffffffffffffff)
492:              if ((mode >> 8) & 3) == 3
493:              else "0x%08x" % (int(v, 16) & 0xffffffff))
494:             for v, mode in zip(raw, modes)]
