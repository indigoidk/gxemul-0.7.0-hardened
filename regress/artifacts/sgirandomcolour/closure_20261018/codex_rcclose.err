253: 	if (!linear && (x < 0 || y < 0 || x >= 2048 || y >= 2048))
254: 		return;
255: 
256: 	int tilewidth_in_pixels = 512 / bufdepth;
257: 	
258: 	int tile_nr_x = x / tilewidth_in_pixels;
259: 	int tile_nr_y = y >> 7;
260: 
261: 	unsigned int tile_nr = tile_nr_y * 16 + tile_nr_x;
