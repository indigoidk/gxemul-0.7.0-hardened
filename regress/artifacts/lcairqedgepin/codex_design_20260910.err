64-	    d->pic2->irr, d->pic1->irr, d->pic2->ier, d->pic1->ier);  */
65-
66-	new_isa_assert = d->pic1->irr & ~d->pic1->ier;
67-
68-	if (old_isa_assert == new_isa_assert)
69-		return;
70-
71-	if (!new_isa_assert) {
72-		INTERRUPT_DEASSERT(d->irq);
