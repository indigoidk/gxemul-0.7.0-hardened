    old = ast.parse((root/witness).read_text(encoding='utf-8'))
    new = ast.parse((root/('ppc_'+kind+'_probe.py')).read_text(encoding='utf-8'))
    olddefs = {n.name: ast.dump(n, include_attributes=False) for n in old.body if isinstance(n, ast.FunctionDef)}
    newdefs = {n.name: ast.dump(n, include_attributes=False) for n in new.body if isinstance(n, ast.FunctionDef)}
    print(kind, 'all function ASTs identical:', olddefs == newdefs)
    def rowcalls(tree):
        return [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == 'row']
    ar, br = rowcalls(old), rowcalls(new)
    print(kind, 'row call count:', len(br), 'changed calls:', [b.args[0].value for a,b in zip(ar,br) if ast.dump(a) "'!= ast.dump(b)])
    start = next(i for i,n in enumerate(new.body) if isinstance(n, ast.Assign) and any(isinstance(t,ast.Name) and t.id=='"'census_combos' for t in n.targets))
    stop = next(i for i,n in enumerate(new.body) if isinstance(n, ast.Assign) and any(isinstance(t,ast.Name) and t.id=='census_fail' for t in n.targets))
    ns = {}
    exec(compile(ast.Module(body=new.body[start:stop], type_ignores=[]), '<pure census enumeration>', 'exec'), ns)
    print(kind, 'distinct census cells:', len(ns['uniq_census']))
    ns = {'rows': []}
    rowdef = next(n for n in new.body if isinstance(n, ast.FunctionDef) and n.name == 'row')
    exec(compile(ast.Module(body=[rowdef], type_ignores=[]), '<row formatter>', 'exec'), ns)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        for call in br:
            ns['row'](ast.literal_eval(call.args[0]), '0xdeadbeefcafef00d', '0x0', ast.literal_eval(call.args[3]))
    emitted = buf.getvalue().splitlines()
    p = subprocess.run([r'C:\\Program Files\\Git\\usr\\bin\\bash.exe', '--noprofile', '--norc', '-c', 'grep -Ec \" ok"'$| FAIL$"'"'], input=buf.getvalue(), text=True, capture_output=True)
    print(kind, 'actual grep row-display matches:', p.stdout.strip(), 'emitted:', len(emitted), 'rc:', p.returncode)
    controls = next(n.value for n in new.body if isinstance(n, ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONTROL_ROWS' for t in n.targets))
    controls = ast.literal_eval(controls)
    names = [ast.literal_eval(n.args[0]) for n in br]
