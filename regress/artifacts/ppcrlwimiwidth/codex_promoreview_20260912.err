import ast, contextlib, io, pathlib, re, time
root = pathlib.Path('C:/DocumentNoSnc/CC/GXEMUL/GXEMUL-SEC/regress')
for kind in ('rlwimi','rldimi'):
    tree = ast.parse((root/('ppc_'+kind+'_probe.py')).read_text(encoding='utf-8'))
    def assigns(node, name):
        return isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in node.targets)
    begin = next(i for i,n in enumerate(tree.body) if assigns(n,'CODE'))
    end = next(i for i,n in enumerate(tree.body) if assigns(n,'npass'))
    nodes = [n for n in tree.body[begin:end] if not (isinstance(n,ast.FunctionDef) and n.name=='session')]
    controls = ast.literal_eval(next(n.value for n in tree.body if assigns(n,'CONTROL_ROWS')))
    for model in ('documented committed defect', 'target no-op'):
        ns = {'BIN':'MODEL ONLY', 'LABEL':model, 'time':time}
        def session(setup, insns, timeout=90, machine='bareppc', cpu=None):
            if machine=='nosuchmachine':
                return {}, [], '', 'exit1'
            width = 32 if cpu=='PPC603' else 64
            wm = (1<<width)-1
            regs = {'cr':0}
            for command in setup:
                key,val = command.split('=')
                regs[int(key[1:])] = int(val,16) & wm
            dis, out = [], ''
            for iw in insns:
                op,rs,ra = iw>>26, (iw>>21)&31, (iw>>16)&31
                if op==14:
                    val = iw&65535
                    val = val-65536 if val&32768 else val
                    regs[rs]=val&wm
                    dis.append((iw,'li','r%d,%d'%(rs,val)))
                elif op==24:
                    regs[ra]=(regs.get(rs,0)|(iw&65535))&wm
                    dis.append((iw,'nop',''))
                elif op in (20,21):
                    sh,mb,me=(iw>>11)&31,(iw>>6)&31,(iw>>1)&31
                    dis.append((iw,'rlwimi' if op==20 else 'rlwinm','r%d,r%d,%d,%d,%d'%(ra,rs,sh,mb,me)))
                    if op==21:
                        regs[ra]=ns['want_rlwinm'](regs[rs],sh,mb,me)&wm
                    elif model"'!='"'target no-op':
                        src=regs[rs]
                        tmp=((src<<sh)|(src>>(32-sh)))&wm if sh else src
                        mask=0
                        bit=mb
                        while True:
                            mask|=1<<(31-bit)
                            if bit==me: break
                            bit=(bit+1)&31
                        regs[ra]=((regs[ra]&~mask)|(tmp&mask))&wm
                elif op==30:
                    xo=(iw>>2)&7
                    sh=((iw>>11)&31)|((iw&2)<<4)
                    mb=((iw>>6)&31)|(iw&32)
                    name={0:'rldicl',1:'rldicr',3:'rldimi'}[xo]
                    dis.append((iw,name,'r%d,r%d,%d,%d'%(ra,rs,sh,mb)))
                    if width==32:
                        out='TODO: rld'
                        break
                    if xo==0:
                        regs[ra]=ns['want_rldicl'](regs[rs],sh,mb)
                    elif xo==1:
                        regs[ra]=ns['want_rldicr'](regs[rs],sh,mb)
                    elif model"'!='"'target no-op':
                        mask=ns['mask_b_63'](mb)
                        regs[ra]=(ns['rotl64'](regs[rs],sh)&mask)|(regs[ra]&~mask)
                else:
                    raise AssertionError(iw)
            return regs, dis, out, 'exit0'
        ns['session']=session
        buf=io.StringIO()
        with contextlib.redirect_stdout(buf):
            exec(compile(ast.Module(body=nodes,type_ignores=[]), '<in-memory instruction model; no emulator>', 'exec'),ns)
        status=dict(ns['rows'])
        print('PREDICTION', kind, model, 'score=%d/%d'%(sum(status.values()),len(status)), 'CONTROL='+('OK' if all(status[n] for n in controls) else 'FAIL'))
        print('PREDICTION green rows outside CONTROL:', [n for n,ok in ns['rows'] if ok and n not in controls])
        print('PREDICTION red rows:', [n for n,ok in ns['rows'] if not ok])
        row_lines=buf.getvalue().splitlines()[4:]
        print('In-memory emitted row lines:', len(row_lines), 'match equivalent regex:', all(re.search(r' ok"'$| FAIL$'"',line) for line in row_lines))
