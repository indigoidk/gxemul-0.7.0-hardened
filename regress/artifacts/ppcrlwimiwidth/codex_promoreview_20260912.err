1669: DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
1670: 
1671: 
1672: #  *** A PYTHON DICT LITERAL ACCEPTS A DUPLICATE KEY IN SILENCE, AND THE LAST ONE WINS.
1673: #  MEASURED ON THIS FILE, HOURS AFTER IT WAS WRITTEN. ***
1674: #
1675: #  Two rounds added `sgi_eaddr_probe.py` to MANIFEST independently -- the author of this
1676: #  checker, and the #446 round whose probe it was.  Both landed, four lines apart, and
1677: #  `len(MANIFEST)` reported ONE entry.  Nothing complained, because nothing can: by the
1678: #  time the module object exists the earlier entry is already gone.  Here the two agreed
1679: #  on CLASS, so the behaviour was identical and the only damage was a stale line.  Had
1680: #  they disagreed -- one DETECTOR, one TOOL -- the file would have carried a visible,
1681: #  reviewed, *tracked* classification that the checker silently did not use, and the
1682: #  filename tooth that refuses `*_probe.py` in class `tool` would have been reading the
1683: #  wrong entry while looking correct in the diff.
1684: #
1685: #  It has to be caught by re-reading THIS FILE'S SOURCE TEXT, because the data structure
1686: #  cannot represent the fault it suffers from.  A duplicate is a SETUP FAULT, not a
1687: #  finding: it exits before any wiring is derived, so it can never be confused with a
1688: #  probe that is genuinely unwired.
1689: #  The open() is INLINE rather than a call to read() below: this guard runs at import time,
1690: #  fifty lines before read() is defined, and the first draft died with a NameError proving it.
1691: #  It failed loudly, which is luck -- a guard placed in a branch would have failed silently.
1692: def _refuse_duplicate_keys():
1693:     with open(os.path.abspath(__file__), "r", encoding="utf-8", errors="replace") as fh:
1694:         src = fh.read()
1695:     #  *** AN ANCHOR THAT NO LONGER MATCHES IS ITSELF A SETUP FAULT, NOT A REASON TO SKIP,
1696:     #  AND THE FIRST VERSION OF THIS GUARD DID `continue`. ***  A flagship review MEASURED
1697:     #  the consequence: `MANIFEST =  {` -- one extra space, valid Python, invisible to a
1698:     #  reader -- makes a literal find() miss, the guard skips, and a planted duplicate key
1699:     #  runs GREEN.  That is this file's own thesis turned on itself: a fault in a guard does
1700:     #  not fail loudly, it stops guarding.  The regex tolerates whitespace, and a miss is
1701:     #  now reported rather than shrugged at.
1702:     for name in ("MANIFEST", "EXEMPT"):
1703:         m = re.search(r"^%s\s*=\s*\{" % re.escape(name), src, re.M)
1704:         if m is None:
1705:             print("PROBEWIRING_SETUP_FAULT  the %s literal could not be located in this"
1706:                   " file's own source." % name)
1707:             print("  The duplicate-key guard cannot run, and a duplicate would pass"
1708:                   " UNSEEN.  Fix the anchor, do not delete the check.")
1709:             sys.exit(2)
1710:         i = m.start()
1711:         j = src.find("\n}", i)
1712:         seen, dupes = set(), []
1713:         for k in re.findall(r'^\s*"([^"]+)"\s*:', src[i:j], re.M):
1714:             (dupes.append(k) if k in seen else None)
1715:             seen.add(k)
1716:         if dupes:
1717:             print("PROBEWIRING_SETUP_FAULT  %s names the same key twice; a dict literal" % name)
1718:             print("  keeps only the LAST and says nothing.  Delete the stale line(s):")
1719:             for k in sorted(set(dupes)):
1720:                 print("    %s" % k)
1721:             sys.exit(2)
1722: 
1723: 
1724: _refuse_duplicate_keys()
1725: 
1726: #  A python interpreter token.  Bare python/python3, or the $PY-style indirections other
1727: #  harnesses in this tree use.  Anchored so python3.12 and mypython do not match.
1728: #  *** THE TRAILING BOUNDARY IS LOAD-BEARING AND THE FIRST VERSION LACKED IT. ***  A
1729: #  flagship review MEASURED that `"$PYLINT" probe.py` scored as WIRING: the alternation
1730: #  had no boundary after the group, so ANY $PY-prefixed variable read as an interpreter
1731: #  and a linter invocation would have marked a probe wired.  That is the FALSE ACCEPT
1732: #  direction -- the one that silently stops demanding a gate.  Latent rather than live:
1733: #  no such variable exists in the battery today.  `$PYTHON` and `$PY` still match;
1734: #  `$PYLINT` and `$PYTEST` no longer do.
1735: INTERP_RE = re.compile(
1736:     r'"?\$\{?(?:PY|PY3|PYTHON|PYTHON3)\}?"?(?![A-Za-z0-9_])'
1737:     r'|(?<![\w./-])python3?(?![\w.-])'
1738: )
1739: 
1740: #  COMMAND POSITION -- the whole defence against "a mention counts as wiring".  Everything
1741: #  before the interpreter must be shell scaffolding: leading space, an assignment opening a
1742: #  command substitution (out=$( ), control keywords, and environment-variable prefixes.
1743: #
1744: #  THE LINE THIS WAS BUILT AGAINST IS REAL AND LIVE, not invented:
1745: #      gate_hygiene.sh:331   note "diag_div_sweep.py or python3 missing -- class ratchet NOT run"
1746: #  It carries a probe basename AND the token python3 on one non-comment line, and it is a
1747: #  message saying the probe DID NOT RUN.  A two-sided "name near python" regex scores it as
1748: #  execution.  Here the interpreter's prefix is `note "diag_div_sweep.py or `, which is not
1749: #  scaffolding, so the line is rejected.
1750: CMDPOS_RE = re.compile(
1751:     r"""^\s*
1752:         (?: [A-Za-z_]\w* = (?:\$\()? \s* )?
1753:         (?: (?: if | then | else | elif | while | until | do | ! | \$\( | \( ) \s* )*
1754:         (?: [A-Za-z_]\w* = (?: "[^"]*" | '[^']*' | \S* ) \s+ )*
1755:         $""",
1756:     re.X,
1757: )
1758: 
1759: VAR_RE = re.compile(r"^\$\{?([A-Za-z_]\w*)\}?$")
1760: ASSIGN_RE = re.compile(r"^\s*([A-Za-z_]\w*)=(\S+)")
1761: 
1762: 
1763: def read(path):
1764:     with open(path, "r", encoding="utf-8", errors="replace") as fh:
1765:         return fh.read()
1766: 
1767: 
1768: def unquote(tok):
1769:     tok = tok.strip().rstrip(");,")
1770:     if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in "\"'":
1771:         tok = tok[1:-1]
1772:     return tok.strip("\"'")
1773: 
1774: 
1775: def gate_list(regress):
1776:     """The battery's OWN array is the authority on which scripts run.
1777: 
1778:     Deriving from run.sh rather than from a gate_*.sh glob is deliberate, and carries a
1779:     second-order property worth having: a gate script that exists but was dropped out of
1780:     GATES does not run, so every probe it owned becomes unwired here and this goes RED.
1781:     A glob would have called those probes gated forever.
1782:     """
1783:     run = os.path.join(regress, "run.sh")
1784:     if not os.path.isfile(run):
1785:         return None, "regress/run.sh is missing -- cannot tell which gates run"
1786:     m = re.search(r"^GATES=\(([^)]*)\)", read(run), re.M)
1787:     if not m:
1788:         return None, "regress/run.sh has no GATES=( ... ) array -- cannot derive the battery"
1789:     return [n + ".sh" for n in m.group(1).split()], None
1790: 
1791: 
1792: def exec_sites(regress, scripts):
1793:     """Return (hits, ignored, missing).
1794: 
1795:     hits[basename] = ["gate_arm.sh:97", ...]  -- a real invocation of the regress copy
1796:     ignored        = ["gate_offline.sh:153  $ACDIR/selftest_absorb.py", ...]
1797:     """
1798:     hits, ignored, missing = {}, [], []
1799:     for script in scripts:
1800:         path = os.path.join(regress, script)
1801:         if not os.path.isfile(path):
1802:             missing.append(script)
1803:             continue
1804:         lines = read(path).splitlines()
1805:         #  One-level variable map, from this file only.  gate_hygiene really does write
1806:         #  DIVSWEEP=$HERE/diag_div_sweep.py and then run "$DIVSWEEP", so refusing to resolve
1807:         #  one level would report a genuinely gated probe as unwired -- and a false red is
1808:         #  how a rule gets switched off.
1809:         varmap = {}
1810:         for ln in lines:
1811:             if ln.lstrip().startswith("#"):
1812:                 continue
1813:             a = ASSIGN_RE.match(ln)
1814:             if a and ".py" in a.group(2):
1815:                 varmap[a.group(1)] = unquote(a.group(2))
1816:         #  *** HEREDOC BODIES ARE NOT CODE, AND COUNTING THEM IS A FALSE ACCEPT. ***  A
1817:         #  flagship review MEASURED it: an invocation-shaped line inside a
1818:         #  `cat <<'USAGE' ... USAGE` body scored as WIRING, so with the exemption removed
1819:         #  the checker printed GREEN over a genuinely unwired detector.  Usage text quoting
1820:         #  its own invocation is an entirely natural shape.  Latent rather than live -- every
1821:         #  `<<` site in the battery today is a data table or a python program body, none
1822:         #  carrying an interpreter plus a probe in body position -- but this is the
1823:         #  dangerous direction: it does not fail loudly, it stops demanding a gate.
1824:         #
1825:         #  Skipping is the CONSERVATIVE choice and it has a cost worth naming: a heredoc
1826:         #  that GENERATES a script the gate then runs is genuine wiring one level away, and
1827:         #  skipping the body reports it UNWIRED -- a false red, which a human then reads.
1828:         #  That is the right error to make.
1829:         body = set()
1830:         pend = None
1831:         for no, ln in enumerate(lines, 1):
1832:             if pend is not None:
1833:                 body.add(no)
1834:                 if ln.strip() == pend:
1835:                     pend = None
1836:                 continue
1837:             h = re.search(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?", ln)
1838:             if h and not ln.lstrip().startswith("#"):
1839:                 pend = h.group(1)
1840: 
1841:         for no, ln in enumerate(lines, 1):
1842:             if ln.lstrip().startswith("#") or no in body:
1843:                 continue
1844:             for m in INTERP_RE.finditer(ln):
1845:                 if not CMDPOS_RE.match(ln[: m.start()]):
1846:                     continue
1847:                 toks = ln[m.end():].split()
1848:                 if toks and toks[0].startswith("-c"):
1849:                     continue          # an inline program, not a script invocation
1850:                 for tok in toks:
1851:                     t = unquote(tok)
1852:                     v = VAR_RE.match(t)
1853:                     if v:
1854:                         t = varmap.get(v.group(1), "")
1855:                     if not t.endswith(".py"):
1856:                         continue
1857:                     d, b = os.path.split(t)
1858:                     if d in HERE_DIRS:
1859:                         hits.setdefault(b, []).append("%s:%d" % (script, no))
1860:                     else:
1861:                         #  #471: a NESTED invocation is keyed by its RELATIVE PATH, not
1862:                         #  its basename.  Before this, a gate invoking
1863:                         #  `artifacts/.../gdrom_pio_null_probe.py` was filed as an
1864:                         #  EXTERNAL reference and IGNORED -- so the detector #465 wired
1865:                         #  by hand still reported UNWIRED once the scan could see it.
1866:                         #
1867:                         #  Path keys are also what makes the re-key SAFE: two detectors
1868:                         #  sharing a basename in different directories stay distinct,
1869:                         #  where basename keys would mark BOTH gated when only one is.
1870:                         rel = os.path.normpath(os.path.join(d, b)).replace(os.sep, "/")
1871:                         if os.path.isfile(os.path.join(regress, rel)):
1872:                             hits.setdefault(rel, []).append("%s:%d" % (script, no))
1873:                         else:
1874:                             ignored.append("%s:%d  %s" % (script, no, t))
1875:                     break             # the first .py argument is the script
1876:     return hits, ignored, missing
1877: 
1878: 
1879: #  STANDALONE WORDS ONLY.  The first draft used a plain substring and reported
1880: #  mips_fold_probe.py as self-labelled "witness" -- its summary line reads "the MIPS
1881: #  fold-witness COUNTERS", where the word names a counter, not the artefact.  That is the
1882: #  substring trap in the one place in this file that was allowed to be a heuristic, and an
1883: #  advisory that cries wolf is an advisory nobody reads.  MEASURED: with the hyphen guard
1884: #  the noise line disappears and pit8253's real disagreement still fires.
1885: _LBL_W = re.compile(r"(?<![\w-])witness(?![\w-])", re.I)
1886: _LBL_D = re.compile(r"(?<![\w-])detector(?![\w-])", re.I)
1887: 
1888: 
1889: def domain(regress):
1890:     """The .py artefacts this check governs, and (mode, why) describing how it decided.
1891: 
1892:     *** COMMITTED-OR-STAGED, NOT "ON DISK", AND THE FIRST VERSION HAD IT WRONG. ***  The
1893:     first draft enumerated the directory, and MINUTES AFTER IT WAS WRITTEN a concurrent
1894:     round dropped `sgi_eaddr_probe.py` into regress/ as untracked in-flight work.  This
1895:     check went red -- correctly identifying a real unwired detector, but firing at a
1896:     file its author had not yet offered for commit, in someone else's working tree.
1897: 
1898:     `git ls-files` reads the INDEX, so a probe enters the domain the moment it is `git
1899:     add`ed -- which is precisely when "every COMMITTED detector" starts to apply, and
1900:     precisely when the author is present to classify it.  A scratch probe that is never
1901:     staged defends nothing in a fresh clone either, so it is honestly out of scope.
1902: 
1903:     FALLBACK IS ANNOUNCED, NEVER SILENT.  Outside a work tree (the --selftest copies)
1904:     git cannot answer, and a fallback that quietly changes what a check governs is the
1905:     kind of silent scope change this harness keeps being bitten by.  So the mode is
1906:     printed on the summary line.
1907:     """
1908:     try:
1909:         p = subprocess.run(["git", "ls-files", "--", "*.py"], cwd=regress,
1910:                            capture_output=True, text=True)
1911:         if p.returncode == 0:
1912:             #  #471: NO `"/" not in f` FILTER.  Its docstring always claimed "every
1913:             #  committed DETECTOR under regress/", and the filter made that false --
1914:             #  the checker could not see below top level, which is exactly where
1915:             #  #465 shipped a detector that no gate ran.
1916:             #
1917:             #  `git ls-files` yields paths RELATIVE to regress/, so a top-level file
1918:             #  still arrives as a bare basename and every existing MANIFEST key keeps
1919:             #  matching unchanged.  Only nested files gain a path key.
1920:             files = sorted(f for f in p.stdout.split()
1921:                            if f.endswith(".py")
1922:                            and os.path.isfile(os.path.join(regress, f)))
1923:             if files:
1924:                 return files, "tracked-or-staged"
1925:     except OSError:
1926:         pass
1927:     #  #471: the FALLBACK must descend too.  Leaving it flat would re-create the blind
1928:     #  spot on any machine where git cannot answer -- a check whose coverage depends
1929:     #  on which branch it took is the shape this file exists to refuse.
1930:     found = []
1931:     for dirpath, dirnames, filenames in os.walk(regress):
1932:         dirnames[:] = [d for d in dirnames if d not in (".git", "__pycache__")]
1933:         for f in filenames:
1934:             if f.endswith(".py"):
1935:                 rel = os.path.relpath(os.path.join(dirpath, f), regress)
1936:                 found.append(rel.replace(os.sep, "/"))
1937:     return sorted(found), "on-disk (git could not answer)"
1938: 
1939: 
1940: def self_label(path):
1941:     """The file's OWN summary line, for the SELFLABEL advisory only.  Never a verdict."""
1942:     try:
1943:         head = read(path).splitlines()[:6]
1944:     except OSError:
1945:         return None
1946:     for ln in head:
1947:         has_w, has_d = bool(_LBL_W.search(ln)), bool(_LBL_D.search(ln))
1948:         if has_w and not has_d:
1949:             return CLASS_WITNESS
1950:         if has_d and not has_w:
1951:             return CLASS_DETECTOR
1952:         if has_w and has_d:
1953:             return None
1954:     return None
1955: 
1956: 
1957: #  =======================================================================================
1958: #  SELFTEST.  Mutants are applied to COPIES in a temp dir; nothing in the repository is
1959: #  touched, so no .MUTANT sentinel is needed.  EXIT STATUS IS TAKEN FROM THE PROCESS: this
1960: #  project lost a whole battery result to `cmd | tail`, which reports tail's status, so a
1961: #  KILLED run read as exit 0.  subprocess.run(...).returncode cannot make that mistake.
1962: #
1963: #  A CHECKER-SOURCE MUTANT THAT DOES NOT APPLY EXACTLY ONCE IS A FAULT, NEVER A PASS --
1964: #  absorb_census.py's rule, and it is what keeps this selftest from silently going vacuous
1965: #  after someone reformats the manifest below.
1966: #
1967: #  *** AND IT FIRED ON ITS OWN AUTHOR, FIRST RUN. ***  The mutants below started life as
1968: #  plain string literals, which meant the text they searched for existed TWICE in this file:
1969: #  once in the manifest and once in the selftest.  _st_apply refused ("x2 ... want 1") rather
1970: #  than mutating both, which would have silently mutated the selftest instead of the subject.
1971: #  So every mutant target is BUILT from its parts and never written out whole.
1972: def _lit(*parts):
1973:     """Join fragments, so the assembled search string appears nowhere in this source."""
1974:     return "".join(parts)
1975: 
1976: 
1977: def _exline(key):
1978:     """The EXEMPT entry for `key` AS IT APPEARS IN THE SOURCE, whole, however many lines.
1979: 
1980:     *** THIS USED TO REBUILD A ONE-LINE ENTRY FROM THE TABLE, AND THAT WAS WRONG FOR EVERY
1981:     ENTRY THAT WRAPS. ***  Measured 2026-08-30, the day the second exemption was discharged:
1982:     of the six then remaining, the reconstruction matched **zero** -- all six are written
1983:     across two or more lines.  So the selftest's four exemption mutants had nothing to bite
1984:     on and its SKIP arm fired, dropping 4 of 21 mutants.
1985: 
1986:     **That is the worse failure of the two, because the SKIP arm reads as "the EXEMPT table
1987:     is empty, nothing to test" when the truth was "the reconstruction is too narrow".**  A
1988:     check quietly getting weaker while reporting PASS is the shape this project names first,
1989:     and here it would have arrived wearing the clothes of progress.
1990: 
1991:     Extracting the REAL text instead of rebuilding an idealised one removes the whole class:
1992:     it cannot disagree with the source, because it IS the source.  Scans from the key to the
1993:     line that closes the tuple, so single-line and wrapped entries are handled identically.
1994:     *** AND THE SEARCH IS ANCHORED INSIDE THE EXEMPT BLOCK, WHICH IS NOT A DETAIL. ***
1995:     `    "<name>":` appears in BOTH tables -- MANIFEST first, EXEMPT second -- so a bare
1996:     `find()` returns the MANIFEST entry and the mutant deletes the wrong one.  Measured: M1
1997:     and M2 then reported `UNCLASSIFIED ... is not in the MANIFEST` and `ORPHAN EXEMPTION`
1998:     instead of the `UNWIRED DETECTOR` they exist to prove, i.e. the mutant reddened for a
1999:     reason unrelated to the rule under test -- which would have looked like a working check.
2000: 
2001:     This is the wrong-section trap this project already records for gate row lists: anchor on
2002:     something that identifies the SECTION, never on a pattern several sections share.
2003:     """
2004:     src = src_of_self()
2005:     block = src.find("EXEMPT = {")
2006:     if block < 0:
2007:         raise RuntimeError("_exline: no EXEMPT block")
2008:     start = src.find('    "%s":' % key, block)
2009:     if start < 0:
2010:         raise RuntimeError("_exline: %r not in EXEMPT" % key)
2011:     i = start
2012:     while i < len(src):
2013:         nl = src.find("\n", i)
2014:         if nl < 0:
2015:             return ""
2016:         line = src[i:nl + 1]
2017:         if line.rstrip().endswith("),"):
2018:             return src[start:nl + 1]
2019:         i = nl + 1
2020:     raise RuntimeError("_exline: unterminated entry for %r" % key)
2021: 
2022: 
2023: def src_of_self():
2024:     with open(__file__, encoding="utf-8", newline="") as _f:
2025:         return _f.read()
2026: 
2027: 
2028: def _pick_exempt_detector():
2029:     """The selftest's exemplar is DERIVED, never hardcoded.
2030: 
2031:     *** THIS FUNCTION EXISTS BECAUSE THE SELFTEST BROKE THE DAY AN EXEMPTION WAS
2032:     DISCHARGED, WHICH IS THE ONE EVENT IT SHOULD HAVE BEEN CELEBRATING. ***  Four of its
2033:     mutants named `pit8253_latch_probe.py` literally.  When that probe was wired into
2034:     gate_arm.sh and its exemption deleted -- exactly the outcome the EXEMPT table exists
2035:     to drive toward -- three mutants raised KeyError on the missing entry and the fourth
2036:     had its premise inverted.  `precommit_check.sh` reported THE PROBE-WIRING CHECKER CAN
2037:     NO LONGER BE SHOWN TO FAIL, correctly.
2038: 
2039:     So the harness punished progress: doing the right thing to the tree broke the tool
2040:     that asks for it.  A hardcoded exemplar is a frozen claim about a table designed to
2041:     empty, and swapping in another name would only move the tripwire to the next
2042:     discharge.
2043: 
2044:     Any exempt DETECTOR serves: exempt means unwired, which is the precondition all four
2045:     mutants need.  Sorted for determinism, so a failure names the same probe twice.
2046: 
2047:     *** AND THE PICK IS VERIFIED, NOT MERELY CHOSEN -- BUT NOT FOR THE REASON THIS
2048:     PARAGRAPH GAVE UNTIL 2026-08-30. ***  It said `_exline()` "reconstructs a ONE-LINE
2049:     entry from the table", so entries wrapped across two source lines matched nothing.
2050:     `_exline()` EXTRACTS the real source text now, however many lines it spans, and its
2051:     own docstring says so -- so the two halves of one file contradicted each other, the
2052:     stale half sitting in the function that consumes the fresh one.  Found by the pass-2
2053:     seat reviewing the commit that made the change.
2054: 
2055:     **The `count == 1` guard is still load-bearing and its warrant has MOVED.**  It no
2056:     longer defends against a formatting mismatch -- extraction cannot have one.  It
2057:     defends the SELF-MATCH case: a doc comment in this file quoting an EXEMPT line makes
2058:     the extracted text appear twice.  **The MECHANISM stated here was wrong until the
2059:     adjudicating seat built the case: `_st_apply` does NOT silently edit the comment
2060:     instead of the table -- it COUNTS and RAISES**, `MUTANT DID NOT APPLY: '...' x2
2061:     (want 1)`.  So the guard prevents a selftest CRASH, not a silent wrong-edit, and
2062:     `_st_apply`'s own raise is a second line of defence behind it.
2063: 
2064:     Two facts the seat measured that belong here: injecting a verbatim copy of one
2065:     EXEMPT entry makes `src.count()` return 2, the guard skips that name and returns
2066:     the next candidate -- so it is genuinely load-bearing.  And **it never fires
2067:     today**: all six counts are 1.  It is a LATENT defence, which is worth saying
2068:     plainly, because a guard that has never fired is the one most likely to be
2069:     deleted as dead by someone who does not know what it is for.
2070: 
2071:     *A guard whose stated reason expires but whose behaviour is still needed is the
2072:     hardest kind to audit: deleting it looks safe, because the case it cites is gone.*
2073:     """
2074:     src = src_of_self()
2075:     for name in sorted(EXEMPT):
2076:         cls = MANIFEST.get(name, (None,))[0]
2077:         if cls != CLASS_DETECTOR:
2078:             continue
2079:         if src.count(_exline(name)) == 1:
2080:             return name
2081:     return None
2082: 
2083: 
2084: PIT_RUN = '\npython3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PLOG" 2>&1 || true\n'
2085: #  Four shapes of MENTION, none of which is an invocation.  The third is the live
2086: #  gate_hygiene.sh:331 shape: one non-comment line carrying the basename AND `python3`,
2087: #  whose message is that the probe did NOT run.
2088: PIT_MENTIONS = (
2089:     '\n#python3 pit8253_latch_probe.py "$PMAX" "$STUB" > "$PLOG" 2>&1 || true\n'
2090:     '#  TODO: wire pit8253_latch_probe.py in\n'
2091:     'note "pit8253_latch_probe.py or python3 missing -- PIT rows NOT run"\n'
2092:     'echo "see pit8253_latch_probe.py"\n'
2093: )
2094: 
2095: 
2096: def _st_apply(path, old, new, want=1):
2097:     src = read(path)
2098:     n = src.count(old)
2099:     if n != want:
2100:         raise RuntimeError("MUTANT DID NOT APPLY: %r x%d in %s (want %d)"
2101:                            % (old[:56], n, os.path.basename(path), want))
2102:     with open(path, "w", encoding="utf-8", newline="\n") as fh:
2103:         fh.write(src.replace(old, new))
2104: 
2105: 
2106: def _st_append(path, text):
2107:     with open(path, "a", encoding="utf-8", newline="\n") as fh:
2108:         fh.write(text)
2109: 
2110: 
2111: def selftest(verbose=False):
2112:     import shutil
2113:     import subprocess
2114:     import tempfile
2115: 
2116:     src_regress = DEFAULT_REGRESS
2117:     me = os.path.abspath(__file__)
2118:     root = tempfile.mkdtemp(prefix="probewiring_selftest_")
2119:     results = []
2120: 
2121:     #  *** THE BASELINE MUST BE GREEN BY CONSTRUCTION, AND THE FIRST VERSION WAS NOT. ***
2122:     #  fresh() copied EVERY .py from the live tree, so when a concurrent round dropped an
2123:     #  unclassified probe into regress/, M0/M2b/M5a all went red and the selftest announced
2124:     #  "THE CHECKER CAN NO LONGER BE SHOWN TO FAIL".  Right colour, WRONG DIAGNOSIS: it
2125:     #  blamed the checker for an APPARATUS state -- gate_offline's F5 shape, and the
2126:     #  dangerous one, because it points the reader at the wrong file.
2127:     #
2128:     #  So the baseline copies exactly the MANIFEST set.  Live-tree content can no longer
2129:     #  perturb a mutant, and M6 still tests the unclassified-arrival path by ADDING one.
2130:     #  A MANIFEST entry with no source file is a SETUP FAULT here, never a mutant result --
2131:     #  absorb_census.py's rule that a crash is a fault and never a detection.
2132:     def fresh():
2133:         work = tempfile.mkdtemp(dir=root)
2134:         rg = os.path.join(work, "regress")
2135:         os.makedirs(rg)
2136:         #  #471: THE COPY MUST MIRROR THE TREE, NOT FLATTEN IT.  This loop was
2137:         #  `os.listdir`, so once the checker could see nested detectors the selftest
2138:         #  copy still could not -- and every nested MANIFEST entry became a GHOST in
2139:         #  the copy, reddening the unmutated M0 control.
2140:         #
2141:         #  That is the SAME blind spot one level up, inside the harness that tests
2142:         #  for it: a flat copy cannot exercise a recursive scan.
2143:         for f in os.listdir(src_regress):
2144:             if f.endswith(".sh"):
2145:                 shutil.copyfile(os.path.join(src_regress, f), os.path.join(rg, f))
2146:         for rel in MANIFEST:
2147:             if not rel.endswith(".py"):
2148:                 continue
2149:             src = os.path.join(src_regress, rel.replace("/", os.sep))
2150:             if not os.path.isfile(src):
2151:                 continue
2152:             dst = os.path.join(rg, rel.replace("/", os.sep))
2153:             os.makedirs(os.path.dirname(dst), exist_ok=True)
2154:             shutil.copyfile(src, dst)
2155:         chk = os.path.join(work, "check_probe_wiring.py")
2156:         shutil.copyfile(me, chk)
2157:         return rg, chk
2158: 
2159:     absent = [f for f in sorted(MANIFEST) if not os.path.isfile(os.path.join(src_regress, f))]
2160:     if absent:
2161:         print("PROBEWIRING_SELFTEST_SETUP  the MANIFEST names files regress/ does not have:")
2162:         for f in absent:
2163:             print("    %s" % f)
2164:         print("  fix the manifest first; a selftest on a broken baseline proves nothing.")
2165:         return 2
2166: 
2167:     def case(name, want_rc, want_text, chk, rg, extra=(), forbid=None):
2168:         p = subprocess.run([sys.executable, chk, "--regress", rg] + list(extra),
2169:                            capture_output=True, text=True)
2170:         out = p.stdout + p.stderr
2171:         ok = (p.returncode == want_rc) and (want_text in out)
2172:         if forbid is not None and forbid in out:
2173:             ok = False
2174:         results.append(ok)
2175:         print("  %s  %-48s rc=%d want=%d" % ("ok  " if ok else "FAIL", name,
2176:                                              p.returncode, want_rc))
2177:         if verbose or not ok:
2178:             for l in out.splitlines():
2179:                 if want_text in l or l.startswith("PROBEWIRING"):
2180:                     print("          %s" % l.strip()[:160])
2181:         if not ok:
2182:             print("      --- full output ---\n%s" % out)
2183: 
2184:     print("=" * 96)
2185:     print("  check_probe_wiring --selftest   (mutants on copies; the repo is not touched)")
2186:     print("=" * 96)
2187: 
2188:     rg, chk = fresh()
2189:     case("M0  unmutated copy is GREEN", 0, "PROBEWIRING_PASS", chk, rg)
2190: 
2191:     #  THE EXEMPLAR IS DERIVED.  See _pick_exempt_detector(): naming one literally is what
2192:     #  broke this selftest the day an exemption was discharged.
2193:     EX = _pick_exempt_detector()
2194:     if EX is None:
2195:         #  *** A SKIPPED MUTATION IS A FAILURE.  The first version of this arm PRINTED
2196:         #  A SKIP AND LET THE SELFTEST PASS, and a seat refuted it with a
2197:         #  one-character proof: change the `== 1` in _pick_exempt_detector to `== 2`
2198:         #  and no candidate matches, four cases vanish, and the run reports
2199:         #  PROBEWIRING_SELFTEST_PASS 17/17.  **A check getting quietly weaker while
2200:         #  still reporting PASS** -- the exact shape this project names first, and it
2201:         #  was introduced BY the repair for a different instance of it. ***
2202:         #
2203:         #  The denominator is what makes the weakening visible, so the denominator is
2204:         #  not allowed to move: a missing exemplar reds and says why.
2205:         #  FOUR False results, so the DENOMINATOR STAYS 21 and the run FAILS.  Keeping
2206:         #  the denominator is the whole point: it is what makes a shrinking check
2207:         #  visible.  A skip that reduced 21 to 17 and still said PASS is the defect
2208:         #  this arm now refuses to have.
2209:         results.extend([False, False, False, False])
2210:         print("  FAIL  M1/M2/M2b/M3 -- no exempt DETECTOR could be extracted.")
2211:         print("        NOT the EXEMPT table doing its job.  Either _exline() cannot")
2212:         print("        extract any entry, or every exemption is discharged -- and in")
2213:         print("        both cases the checker is no longer shown to fail on these four")
2214:         print("        rules.  Supply a synthetic fixture; do not let the count shrink.")
2215:     else:
2216:         _nl = chr(10)
2217:         EX_RUN = ('%spython3 %s "$PMAX" "$STUB" > "$SELFTEST_LOG" 2>&1 || true%s'
2218:                   % (_nl, EX, _nl))
2219:         EX_MENTIONS = PIT_MENTIONS.replace("pit8253_latch_probe.py", EX)
2220: 
2221:         rg, chk = fresh(); _st_apply(chk, _exline(EX), "")
2222:         case("M1  an unwired detector is NAMED", 1,
2223:              "UNWIRED DETECTOR  %s" % EX, chk, rg)
2224: 
2225:         rg, chk = fresh(); _st_apply(chk, _exline(EX), "")
2226:         _st_append(os.path.join(rg, "gate_arm.sh"), EX_MENTIONS)
2227:         case("M2  4 MENTIONS do not count as wiring", 1,
2228:              "UNWIRED DETECTOR  %s" % EX, chk, rg)
2229: 
2230:         rg, chk = fresh(); _st_apply(chk, _exline(EX), "")
2231:         _st_append(os.path.join(rg, "gate_arm.sh"), EX_RUN)
2232:         case("M2b SATISFIABLE: a real invocation turns it green", 0, "PROBEWIRING_PASS",
2233:              chk, rg, forbid="UNWIRED")
2234: 
2235:         rg, chk = fresh(); _st_append(os.path.join(rg, "gate_arm.sh"), EX_RUN)
2236:         case("M3  wired AND still exempt -> STALE EXEMPTION", 1,
2237:              "STALE EXEMPTION  %s" % EX, chk, rg)
2238: 
2239:     rg, chk = fresh()
2240:     _st_append(os.path.join(rg, "gate_sh_rounding.sh"),
2241:                '\npython3 sh4pcic_witness.py "$PMAX" "$KERNEL" > "$WLOG" 2>&1 || true\n')
2242:     case("M4  a WITNESS wired into a gate reddens", 1,
2243:          "GATED WITNESS  sh4pcic_witness.py", chk, rg)
2244: 
2245:     rg, chk = fresh()
2246:     case("M5a a live exemption is GREEN the day before", 0, "PROBEWIRING_PASS", chk, rg,
2247:          extra=("--today", "2026-09-19"))
2248:     case("M5b the same tree is RED the day after", 1, "EXPIRED EXEMPTION", chk, rg,
2249:          extra=("--today", "2026-09-21"))
2250: 
2251:     for tag, bad in (("M5c unpadded (the ieee_store shape)", '"2026-9-20"'),
2252:                      ("M5d empty", '""'),
2253:                      ("M5e not a date at all", '"soon"')):
2254:         if EX is None:
2255:             #  NOT `continue`.  A bare continue drops the case from `results` and the
2256:             #  DENOMINATOR SHRINKS -- which is the very defect this arm exists to
2257:             #  refuse, surviving one level down from where it was first repaired.
2258:             #  Measured: with the four M1-M3 cases fixed and this one still using
2259:             #  `continue`, the run reported 13/18 rather than 13/21.
2260:             results.append(False)
2261:             print("  FAIL  %-44s -- no exempt DETECTOR (see above)." % tag)
2262:             continue
2263:         rg, chk = fresh()
2264:         #  DERIVED, for the same reason M1-M3 are: this named a probe literally and
2265:         #  broke the day that probe's exemption was discharged -- the SECOND time in
2266:         #  one session, in a mutant group the first repair had not looked at.
2267:         _st_apply(chk, _exline(EX), '    "%s":   (%s, "x"),\n' % (EX, bad))
2268:         case("%-44s is RED, not unexpired" % tag, 1,
2269:              "MALFORMED EXEMPTION  %s" % EX, chk, rg,
2270:              extra=("--today", "2026-08-21"))
2271: 
2272:     #  ---------------------------------------------------------------- M5f
2273:     #  *** THE DEFAULT CLOCK WAS COVERED BY NOTHING.  Measured 2026-08-30 by the pass-2
2274:     #  seat, which asked the standing question -- what is the smallest edit that breaks
2275:     #  this and still passes? -- and answered it in ONE LINE: ***
2276:     #
2277:     #      today = datetime.date.today().isoformat()   ->   today = "2020-01-01"
2278:     #
2279:     #  Production: PROBEWIRING_PASS, rc=0.  Selftest: SELFTEST_PASS 21/21, rc=0.  And it
2280:     #  makes EVERY DATED EXEMPTION IMMORTAL -- the one thing the table exists to prevent.
2281:     #
2282:     #  **The blindness was structural, not an oversight about one line.**  M5a-M5e each
2283:     #  pass `--today` EXPLICITLY, so between them they test the COMPARISON exhaustively
2284:     #  and the CLOCK IT READS not at all.  The only mutant on the default path was M0,
2285:     #  whose want is PASS -- so a frozen clock satisfies it.  *A parameter added to make
2286:     #  a test deterministic removed the last coverage of the value it replaces.*
2287:     #
2288:     #  This row runs on the REAL clock, with one exemption dated YESTERDAY -- computed,
2289:     #  never a literal, or the row rots into a permanent red the day it is written.
2290:     #  Clean checker: rc=1, EXPIRED EXEMPTION.  Frozen clock: rc=0, PROBEWIRING_PASS.
2291:     if EX is None:
2292:         results.append(False)
2293:         print("  FAIL  M5f -- no exempt DETECTOR (see above).")
2294:     else:
2295:         import datetime as _dt
2296:         _yest = (_dt.date.today() - _dt.timedelta(days=1)).isoformat()
2297:         rg, chk = fresh()
