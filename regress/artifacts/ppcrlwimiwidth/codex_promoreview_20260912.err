 196: # ---------------------------------------------------------------------- sessions
 197: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
 198:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs."""
 199:     cmds = list(setup)
 200:     for i, w in enumerate(insns):
 201:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
 202:     if insns:
 203:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
 204:     cmds.append("pc=0x%x" % CODE)
 205:     if insns:
 206:         cmds.append("step %d" % len(insns))
 207:     cmds.append("reg")
 208:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
 209:     if cpu:
 210:         argv += ["-C", cpu]
 211:     argv += ["0x%x:%s" % (CODE, DUMMY)]
 212:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
 213:     try:
 214:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
 215:                            stderr=subprocess.STDOUT, timeout=timeout)
 216:     except subprocess.TimeoutExpired as e:
 217:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
 218:         return {}, [], out, "TIMEOUT"
 219:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
 220:     rc = p.returncode
 221:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
 222:     idx = t.rfind("GXemul> reg")
 223:     regs = {}
 224:     if idx >= 0:
 225:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
 226:             regs[int(m.group(1))] = int(m.group(2), 16)
 227:         m_cr = re.search(r"\bcr\s*=\s*(0x[0-9a-fA-F]+)", t[idx:])
 228:         if m_cr:
 229:             regs["cr"] = int(m_cr.group(1), 16)
 230:     dis = []
 231:     di = t.find("GXemul> unassemble")
 232:     if di >= 0:
 233:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
 234:                 else len(t)]
 235:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
 236:                              r"(?:\t(\S+))?", seg, re.M):
 237:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
 238:     return regs, dis, t, how
