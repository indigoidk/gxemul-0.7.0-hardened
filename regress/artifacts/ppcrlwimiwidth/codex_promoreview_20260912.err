 184: 
 185: def LI(rd, simm):
 186:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
 187: 
 188: 
 189: def ORI(ra, rs, imm):
 190:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
 191: 
 192: 
 193: NOP = ORI(0, 0, 0)
