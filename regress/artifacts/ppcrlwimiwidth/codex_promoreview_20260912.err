  77: if len(sys.argv) < 2:
  78:     sys.stderr.write("usage: ppc_rldimi_probe.py <gxemul> [label]\n")
  79:     sys.exit(2)
  80: 
  81: BIN = sys.argv[1]
  82: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
  83: #  The loader needs a 4-byte stub; it is private to this run (the witnesses shared one /tmp path).
  84: _TMPDIR = tempfile.mkdtemp(prefix="ppc_rldimi_")
  85: DUMMY = os.path.join(_TMPDIR, "dummy.bin")
  86: open(DUMMY, "wb").write(b"\x00\x00\x00\x00")
  87: 
  88: CODE = 0x10000
  89: M64 = (1 << 64) - 1
  90: SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into destination registers
  91: RS_ONES = M64                    # all-ones source: makes every mask window observable
  92: RS_VAL = 0xDEADBEEFCAFEF00D      # pattern source
  93: SRC = 3                          # rS is always r3; r3 is never a destination
  94: DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session
