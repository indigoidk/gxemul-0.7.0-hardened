 143: 
 144: need_file "$IMAGES/netbsd401-macppc-GENERIC"
 145: 
 146: note "binary : $PMAX"
 147: note "machine: macppc/G4, NetBSD kernel loaded so the machine constructs; never executed"
 148: note "cold debugger; big-endian (dump renders value order); msr=0x2000 required for FP"
