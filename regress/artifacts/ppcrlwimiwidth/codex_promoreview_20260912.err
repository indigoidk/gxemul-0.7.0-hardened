 109: # ----------------------------------------------------------------- architecture
 110: def rotl64(x, n):
 111:     n &= 63
 112:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
 113: 
 114: 
 115: def mask_b_63(b):
 116:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
 117:     assert 0 <= b <= 63
 118:     return (1 << (64 - b)) - 1
 119: 
 120: 
 121: def mask_0_e(e):
 122:     """MASK(0,e), big-endian = the high (e+1) bits."""
 123:     assert 0 <= e <= 63
 124:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
 125: 
 126: 
 127: def mask_range(b, e):
 128:     """MASK(b,e), the architecture's own wrapping mask generator (Book I:578, PEM:6879)."""
 129:     assert 0 <= b <= 63 and 0 <= e <= 63
 130:     m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
 131:     assert m != 0, "MASK(%d,%d) came out all-zero, which architecture forbids" % (b, e)
 132:     return m
 133: 
 134: 
 135: def want_rldimi(rs_val, ra_val, sh, mb):
 136:     """Architectural rldimi result per Book I:4315."""
 137:     m = mask_range(mb, (63 - sh) & 63)
 138:     return (rotl64(rs_val, sh) & m) | (ra_val & (~m & M64))
 139: 
 140: 
 141: def want_rldicl(rs_val, sh, mb):
 142:     return rotl64(rs_val, sh) & mask_b_63(mb)
 143: 
 144: 
 145: def want_rldicr(rs_val, sh, me):
 146:     return rotl64(rs_val, sh) & mask_0_e(me)
 147: 
