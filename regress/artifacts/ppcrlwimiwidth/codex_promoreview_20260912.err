  90: gate_begin "gate 13: PowerPC FP conversion + FPSCR (#304/#305/#324-#330) + rlwimi/rldimi"
  91: 
  92: PMAX=${PMAX:-$ROOT/build/gxemul}
  93: LOG=$LOGDIR/gate_ppc.log
  94: 
  95: need_exec "$PMAX"
  96: command -v python3 >/dev/null || gate_skip "python3 not available"
  97: 
  98: # ---- ppcrlwimiwidth: X(rlwimi) at 32-bit width + the wrapping mask's high half --------
  99: # BEFORE the NetBSD prerequisite ON PURPOSE.  These rows are register-to-register on
 100: # `-E bareppc -M 64` and need no image; behind need_file a missing image would turn a
 101: # red detector into a silent SKIP.  Placed here, a red row is recorded first, and #371's
 102: # gate_skip then reports FAIL rather than absorbing it.  PARSE BEFORE SCORE: gates grep
 103: # the result line, never the exit status, and a missing or DUPLICATED protocol line is a
 104: # FAIL.  Both halves of the score are pinned to a literal so a shrunk table cannot pass.
 105: RLWLOG=$LOGDIR/ppc_rlwimi.log
 106: python3 ppc_rlwimi_probe.py "$PMAX" gate > "$RLWLOG" 2>&1 || true
 107: rlwres=$(grep -c '^PPC_RLWIMI_RESULT=[0-9]*/[0-9]*$' "$RLWLOG")
