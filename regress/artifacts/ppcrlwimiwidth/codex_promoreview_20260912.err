 362: # ==================================================== COMPREHENSIVE CENSUS =====
 363: # Sweep structured combinations across the full (SH, MB) space:
 364: # - MB sweeps at fixed SH in {0, 8, 40, 63} (4 x 64 = 256)
 365: # - SH sweeps at fixed MB in {0, 40} (2 x 64 = 128)
 366: # - Diagonal (k, k) for k in 0..63 (64)
 367: # - Anti-diagonal (k, 63-k) for k in 0..63 (64)
 368: census_combos = []
 369: for sh_val in [0, 8, 40, 63]:
 370:     for mb_val in range(64):
 371:         census_combos.append((sh_val, mb_val))
 372: for mb_val in [0, 40]:
 373:     for sh_val in range(64):
 374:         census_combos.append((sh_val, mb_val))
 375: for k in range(64):
 376:     census_combos.append((k, k))
 377:     census_combos.append((k, (63 - k) & 63))
 378: 
 379: seen = set()
 380: uniq_census = []
 381: for c in census_combos:
 382:     if c not in seen:
 383:         seen.add(c)
 384:         uniq_census.append(c)
 385: 
 386: census_fail = 0
 387: census_zero = 0
 388: census_run = 0
 389: 
 390: for base in range(0, len(uniq_census), len(DESTS)):
 391:     chunk = uniq_census[base:base + len(DESTS)]
 392:     insns = [RLDIMI(DESTS[i], SRC, sh, mb) for i, (sh, mb) in enumerate(chunk)]
 393:     st = seed([(SRC, RS_ONES)] + [(r, 0) for r in DESTS])
 394:     cregs, cdis, cT, chow = session(st, insns)
 395:     if chow != "exit0":
