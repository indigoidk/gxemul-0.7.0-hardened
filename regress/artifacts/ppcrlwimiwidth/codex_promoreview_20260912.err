 400:         if i < len(cdis) and cdis[i][1] == "rldimi" and \
 401:            cdis[i][2] == "r%d,r%d,%d,%d" % (DESTS[i], SRC, sh, mb):
 402:             disasm_ok += 1
 403:     for i, (sh, mb) in enumerate(chunk):
 404:         census_run += 1
 405:         got = cregs.get(DESTS[i], None)
 406:         exp = want_rldimi(RS_ONES, 0, sh, mb)
 407:         if got != exp:
 408:             census_fail += 1
 409:         if got == 0:
 410:             census_zero += 1
 411: 
 412: row("disasm total", "%d/%d" % (disasm_ok, disasm_checked),
 413:     "%d/%d" % (disasm_checked, disasm_checked),
 414:     "every placed word re-read by disassembler")
 415: row("census run", census_run, len(uniq_census),
 416:     "(SH,MB) cells driven across sweeps and diagonals")
 417: row("census wrong", census_fail, 0,
 418:     "cells differing from architectural result (0 after fix)")
 419: row("census zero", census_zero, 0,
 420:     "cells returning zero (0 after fix)")
 421: 
 422: # ================================================================ SCORE + DONE
 423: npass = sum(1 for _, ok in rows if ok)
 424: print("")
 425: print("SCORE %d/%d  elapsed=%.1fs  binary=%s  label=%s"
