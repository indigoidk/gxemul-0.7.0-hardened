 181: # ---------------------------------------------------------------------- sessions
 182: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
 183:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs."""
 184:     cmds = list(setup)
 185:     for i, w in enumerate(insns):
 186:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
 187:     if insns:
 188:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
 189:     cmds.append("pc=0x%x" % CODE)
 190:     if insns:
 191:         cmds.append("step %d" % len(insns))
 192:     cmds.append("reg")
 193:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
 194:     if cpu:
 195:         argv += ["-C", cpu]
 196:     argv += ["0x%x:%s" % (CODE, DUMMY)]
 197:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
 198:     try:
 199:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
 200:                            stderr=subprocess.STDOUT, timeout=timeout)
 201:     except subprocess.TimeoutExpired as e:
 202:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
 203:         return {}, [], out, "TIMEOUT"
 204:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
 205:     rc = p.returncode
 206:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
 207:     idx = t.rfind("GXemul> reg")
 208:     regs = {}
 209:     if idx >= 0:
 210:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
 211:             regs[int(m.group(1))] = int(m.group(2), 16)
 212:         m_cr = re.search(r"\bcr\s*=\s*(0x[0-9a-fA-F]+)", t[idx:])
 213:         if m_cr:
 214:             regs["cr"] = int(m_cr.group(1), 16)
 215:     dis = []
 216:     di = t.find("GXemul> unassemble")
 217:     if di >= 0:
 218:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
 219:                 else len(t)]
 220:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
 221:                              r"(?:\t(\S+))?", seg, re.M):
 222:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
 223:     return regs, dis, t, how
