 149: # -------------------------------------------------------------------- encodings
 150: def enc_md(xo, rs, ra, sh, mbe, rc=0):
 151:     """opcode 30 (rldicl/rldicr/rldimi). Book I format MD."""
 152:     assert 0 <= sh <= 63 and 0 <= mbe <= 63 and 0 <= xo <= 7
 153:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
 154:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
 155:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
 156: 
 157: 
 158: def RLDICL(ra, rs, sh, mb, rc=0):
 159:     return enc_md(0, rs, ra, sh, mb, rc)
 160: 
 161: 
 162: def RLDICR(ra, rs, sh, me, rc=0):
 163:     return enc_md(1, rs, ra, sh, me, rc)
 164: 
 165: 
 166: def RLDIMI(ra, rs, sh, mb, rc=0):
 167:     return enc_md(3, rs, ra, sh, mb, rc)
