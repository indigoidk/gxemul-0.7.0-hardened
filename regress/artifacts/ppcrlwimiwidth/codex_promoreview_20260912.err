 114:     check "rlwimi controls prove the probe measures" \
 115:           "$(grep '^PPC_RLWIMI_CONTROL=' "$RLWLOG" | cut -d= -f2)" "OK"
 116:     check "rlwimi rows run"     "${rlw#*/}" 28
 117:     check "rlwimi rows correct" "${rlw%/*}" 28
 118: else
 119:     note "rlwimi: protocol lines missing or duplicated (result=$rlwres control=$rlwctl done=$rlwdone)"
 120:     tail -5 "$RLWLOG" | sed 's/^/       /'
 121:     check "rlwimi protocol parsed" "no" "yes"
 122: fi
