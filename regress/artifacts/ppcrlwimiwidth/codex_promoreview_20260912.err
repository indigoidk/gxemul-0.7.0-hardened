 158: grep -E " ok$| FAIL$" "$LOG" | sed 's/^/       /'
 159: 
 160: # A probe whose control row failed has measured NOTHING, and no other row may be
 161: # believed -- this harness has been bitten by a probe that reported a defect off
 162: # sentinel reads while its guest code had never run.
 163: ctrl=$(grep -o "PPC_CONV_CONTROL=[A-Z]*" "$LOG" | tail -1 | cut -d= -f2)
 164: check "control rows prove the probe measures" "${ctrl:-missing}" "OK"
 165: 
 166: # The rounding-mode WRITE channel is proven once per mode, in its own sessions, by
 167: # reading FPSCR back through the guest's own mffs. Both numbers are asserted, because
 168: # "0 bad" is also what a probe reports when it never read FPSCR at all: the first
 169: # version parsed the debugger's plain `reg`, which does not print FPSCR on this CPU,
 170: # so the check passed vacuously on every run until a diff-review seat predicted the
 171: # hole and the rewrite measured it (43 rows of "unparsed").
 172: modebad=$(grep -o "PPC_CONV_MODEWRITES_BAD=[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
 173: modereads=$(grep -o "PPC_CONV_MODEREADS=[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
 174: check "every rounding-mode write took"    "${modebad:-missing}"   "0"
 175: check "all four modes read back by guest" "${modereads:-0}"       "4"
 176: 
 177: res=$(grep -o "PPC_CONV_RESULT=[0-9]*/[0-9]*" "$LOG" | tail -1 | cut -d= -f2)
 178: got=${res%/*}; want=${res#*/}
 179: check "rows run"     "$want" 138
 180: check "rows correct" "$got"  "$want"
 181: 
 182: # The table must keep enough of each class to be worth running: a gate whose rows are
 183: # all pins cannot detect a reverted fix, and one with no pins cannot detect collateral
 184: # damage. Both counts are asserted rather than trusted.
 185: disc=$(grep -c " DISC " "$LOG")
 186: pins=$(grep -c " PIN " "$LOG")
 187: # Both floors are set to the ACTUAL counts, not below them. They had drifted to 47/26
 188: # against real counts of 50/36, which means a whole class could have lost rows without
 189: # the floor noticing -- the same "a check that cannot fail" species this gate's header
 190: # warns about twice. The two numbers must also sum to the asserted `rows run` above
 191: # (94 + 44 = 138); if they stop summing, a row lost its class rather than the table
 192: # losing a row.
 193: # #335 added two DISC (fmadd/fmsub fusion) and one PIN (the 2by3+1 control that
 194: # proves the hand-assembled A-form register fields land where intended).
 195: check_min "discriminating rows present" "$disc" 94
 196: check_min "pinned rows present"         "$pins" 44
 197: 
 198: # The one row that records a divergence this round deliberately does NOT fix.
 199: div=$(grep -c " DIV " "$LOG")
 200: # #325 retired the one DIV row this gate carried: fctiwz of a NaN answered zero,
 201: # and now answers the most negative value the ISA owes. The count is asserted at
 202: # zero rather than the check being deleted -- a gate that stops counting a class
 203: # stops noticing when a member of it reappears.
 204: check "divergence rows recorded" "$div" 0
 205: 
 206: # Named rows, one per contract, so a single site reverting cannot hide behind a total.
 207: #
 208: # The pattern demands TWO spaces after the name, not one: the probe pads names to a
 209: # fixed column, so a name that is a PREFIX of another ("frsp qNaN" of "frsp qNaN
 210: # payload") matched both rows and the check counted 2 where it wanted 1. A check that
 211: # counts the wrong rows is the same species as a check that cannot fail -- it was
 212: # passing for the wrong reason the moment the table grew a longer name.
 213: for v in "frsp qNaN" "frsp sNaN" "frsp 1+3ulp/2 RZ" "frsp band RP" "frsp band- RM" \
 214:          "frsp tiny RP" "frsp 2^128 RZ" "frsp carry-up RZ" \
 215:          "stfs 2^-127" "stfs band tail" "stfs band-" "stfsx 2^-127" \
 216:          "stfs qNaN payload" "stfs sNaN passthrough" "stfsx qNaN payload" \
 217:          "lfs qNaN-" "composed frsp->stfs NaN" "lfsx qNaN-" "VXSNAN sticky" \
 218:          "fctiwz qNaN" "fctiwz -qNaN" "fctiwz 1.0 control" \
 219:          "fctiwz +Inf" "fctiwz -Inf" "fctiwz 2^31" "fctiwz -(2^31+1)" \
 220:          "fctiwz 1.9 RTZ" "fctiwz -1.9 RTZ" \
 221:          "VXISI fadd Inf-Inf" "VXIDI fdiv Inf/Inf" "VXZDZ fdiv 0/0" \
