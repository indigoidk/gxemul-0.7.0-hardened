 162: def LI(rd, simm):
 163:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
 164: 
 165: 
 166: def ORI(ra, rs, imm):
 167:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
