 168: # -------------------------------------------------------------------- encodings
 169: def enc_m(op, rs, ra, sh, mb, me, rc=0):
 170:     """Opcode 20 (rlwimi) / 21 (rlwinm) / 23 (rlwnm). Book I format M."""
 171:     assert 0 <= op <= 63 and 0 <= rs <= 31 and 0 <= ra <= 31
 172:     assert 0 <= sh <= 31 and 0 <= mb <= 31 and 0 <= me <= 31 and 0 <= rc <= 1
 173:     return ((op << 26) | (rs << 21) | (ra << 16) | (sh << 11)
 174:             | (mb << 6) | (me << 1) | rc) & 0xFFFFFFFF
 175: 
 176: 
 177: def RLWIMI(ra, rs, sh, mb, me, rc=0):
 178:     return enc_m(20, rs, ra, sh, mb, me, rc)
 179: 
 180: 
 181: def RLWINM(ra, rs, sh, mb, me, rc=0):
 182:     return enc_m(21, rs, ra, sh, mb, me, rc)
