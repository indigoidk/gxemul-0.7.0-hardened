 248: # The pins that record a DELIBERATE divergence from the letter of the ISA.
 249: for v in "stfs 2^129 policy" "stfs 3\*2^128 policy" "frsp 2^128 RN"; do
 250:     n=$(count "$LOG" "^$v .*ok$")
 251:     check "  policy pin: $v" "$n" 1
 252: done
 253: 
 254: gate_end

