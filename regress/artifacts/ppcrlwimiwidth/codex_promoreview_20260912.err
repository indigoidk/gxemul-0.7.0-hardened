   1: #!/usr/bin/env python3
   2: """ppcrlwimiwidth -- RUNG-3 DETECTOR for X(rlwimi) width contamination and high-half insertion defects.
   3: 
   4: DEFECT.  src/cpus/cpu_ppc_instr.c, X(rlwimi):
   5: 
   6:     MODE_uint_t tmp = reg(ic->arg[0]), ra = reg(ic->arg[1]);
   7:     uint32_t iword = ic->arg[2];
   8:     int sh = (iword >> 11) & 31;
   9:     int mb = (iword >> 6) & 31;
  10:     int me = (iword >> 1) & 31;
  11:     int rc = iword & 1;
  12: 
  13:     tmp = sh ? ((tmp << sh) | (tmp >> (32-sh))) : tmp;
  14: 
  15:     for (;;) {
  16:         uint64_t mask;
  17:         mask = (uint64_t)1 << (31-mb);
  18:         ra &= ~mask;
  19:         ra |= (tmp & mask);
  20:         if (mb == me)
  21:             break;
  22:         mb ++;
  23:         if (mb == 32)
  24:             mb = 0;
  25:     }
  26:     reg(ic->arg[1]) = ra;
  27:     if (rc)
  28:         update_cr0(cpu, ra);
  29: 
  30: THE DEFECT HAS TWO PARTS:
  31:   (1) WIDTH CONTAMINATION:
  32:       In 64-bit compilation, MODE_uint_t is uint64_t. When 1 <= SH <= 31,
  33:       `tmp >> (32-sh)` performs a 64-bit right shift, pulling high-half source
  34:       bits down into positions 0..31 of tmp, contaminating the rotated word.
  35:       Siblings rlwinm and rlwnm cast to uint32_t first; rlwimi failed to do so.
  36:   (2) MISSING HIGH-HALF INSERTION:
  37:       ROTL32 rotates the low word duplicated into both halves (positions 0:31
  38:       and 32:63). The architectural mask is MASK(MB+32, ME+32). When MB > ME,
  39:       the mask wraps from bit 63 to bit 0, covering every bit position in 0..31
  40:       (the entire high half). Therefore, when MB > ME, RA's high 32 bits MUST
  41:       be replaced with the rotated low-word data. The unpatched code left the
  42:       high half of RA untouched.
  43: 
  44: THE TWO-PART REPAIR:
  45:   1. Narrow tmp on read:
  46:      uint32_t tmp = (uint32_t)reg(ic->arg[0]);
  47:   2. High-half replacement before the walk loop:
  48:      if (mb > me)
  49:          ra = (ra & 0xffffffffULL) | ((uint64_t)tmp << 32);
  50: 
  51:   *** THE CONDITIONAL MUST PRECEDE THE LOOP. *** The loop walks mb around to me,
  52:   so after it mb == me and the guard would never fire.
  53: 
  54: ARCHITECTURE, PowerPC Book I v2.01:4310-4327 (rlwimi RTL and prose):
  55:   n  <- SH
  56:   r  <- ROTL32((RS)[32:63], n)
  57:   m  <- MASK(MB+32, ME+32)
  58:   RA <- (r & m) | ((RA) & ~m)
  59: 
  60:   MASK(x, y) is defined at Book I:578 as "1s in positions x through y (wrapping if x > y)".
  61:   ROTL32 is defined at Book I:4008 / 4126 as rotating bits 32:63 duplicated into both halves.
  62: 
  63: CLAUSE (e) DISCLOSURE (what this instrument cannot see):
  64:   (1) Model width vs mode width: the probe runs on `-E bareppc -M 64` (PPC970, 64-bit
  65:       model, MSR[SF]=1). It cannot observe a 64-bit CPU operating in 32-bit mode (MSR[SF]=0),
  66:       where `update_cr0` branching on `cpu->cd.ppc.bits == 64` compares 64 bits instead of
  67:       32 bits (filed separately as ppccr0modewidth).
  68:   (2) 32-bit CPU high-half truncation: on 32-bit CPUs (PPC603), registers are 32 bits, so
  69:       high-half insertion is discarded by 32-bit register truncation.
  70:   (3) Full OS boot rigs: no 64-bit PowerPC guest OS boot image exists in the tree; rung 3
  71:       unmodified machine guest execution is the highest achievable rung.
  72: 
  73: Sentinel: PPC_RLWIMI_PROBE_DONE (plus PPC_RLWIMI_RESULT=n/N, PPC_RLWIMI_CONTROL=OK|FAIL)
  74: """
  75: 
  76: import os
  77: import re
  78: import subprocess
  79: import sys
  80: import tempfile
  81: import time
  82: 
  83: if len(sys.argv) < 2:
  84:     sys.stderr.write("usage: ppc_rlwimi_probe.py <gxemul> [label]\n")
  85:     sys.exit(2)
  86: 
  87: BIN = sys.argv[1]
  88: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
  89: #  The loader needs a 4-byte stub; it is private to this run (the witness shared
  90: #  /tmp/ppc_rldimi_dummy.bin with the rldimi witness, so two concurrent runs raced on it).
  91: _TMPDIR = tempfile.mkdtemp(prefix="ppc_rlwimi_")
  92: DUMMY = os.path.join(_TMPDIR, "dummy.bin")
  93: open(DUMMY, "wb").write(b"\x00\x00\x00\x00")
  94: 
  95: CODE = 0x10000
  96: M64 = (1 << 64) - 1
  97: SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into destination registers
  98: RS_ONES = M64                    # all-ones source
  99: RS_VAL = 0xDEADBEEFCAFEF00D      # pattern source with differing halves
 100: SRC = 3                          # rS is always r3; r3 is never a destination
 101: DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session
 102: 
 103: rows = []
 104: 
 105: 
 106: def row(name, got, want, note=""):
 107:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
 108:     assert len(name) <= 18, name
 109:     ok = (got == want)
 110:     rows.append((name, ok))
 111:     print("%-19s %-20s %-20s %-46s %s" % (name, str(got), str(want), note,
 112:                                           "ok" if ok else "FAIL"))
 113:     return ok
