  84: 
  85: BIN = sys.argv[1]
  86: LABEL = sys.argv[2] if len(sys.argv) > 2 else "local"
  87: DUMMY = "/tmp/ppc_rldimi_dummy.bin"
  88: open(DUMMY, "wb").write(b"\x00\x00\x00\x00")
  89: 
  90: CODE = 0x10000
  91: M64 = (1 << 64) - 1
  92: SENT = 0x5A5A5A5A5A5A5A5A        # sentinel pre-seeded into destination registers
  93: RS_ONES = M64                    # all-ones source
  94: RS_VAL = 0xDEADBEEFCAFEF00D      # pattern source with differing halves
  95: SRC = 3                          # rS is always r3; r3 is never a destination
  96: DESTS = list(range(4, 30))       # r4..r29 -- 26 destinations per session
  97: 
  98: rows = []
  99: 
 100: 
 101: def row(name, got, want, note=""):
 102:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
 103:     assert len(name) <= 18, name
 104:     ok = (got == want)
 105:     rows.append((name, ok))
 106:     print("%-19s %-20s %-20s %-46s %s" % (name, str(got), str(want), note,
 107:                                           "ok" if ok else "FAIL"))
 108:     return ok
 109: 
 110: 
 111: # ----------------------------------------------------------------- architecture
 112: def rotl64(x, n):
 113:     n &= 63
 114:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
 115: 
 116: 
 117: def mask_b_63(b):
 118:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
 119:     assert 0 <= b <= 63
 120:     return (1 << (64 - b)) - 1
 121: 
 122: 
 123: def mask_0_e(e):
 124:     """MASK(0,e), big-endian = the high (e+1) bits."""
 125:     assert 0 <= e <= 63
 126:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
 127: 
 128: 
 129: def mask_range(b, e):
 130:     """MASK(b,e), the architecture's own wrapping mask generator (Book I:578, PEM:6879)."""
 131:     assert 0 <= b <= 63 and 0 <= e <= 63
 132:     m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
 133:     assert m != 0, "MASK(%d,%d) came out all-zero, which architecture forbids" % (b, e)
 134:     return m
 135: 
 136: 
 137: def rotl32(x, n):
 138:     """ROTL[32] per Book I:4008 -- two copies of (RS)[32:63], then rotate."""
 139:     lo = x & 0xFFFFFFFF
 140:     n &= 31
 141:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
 142:     return (r32 << 32) | r32
 143: 
 144: 
 145: def mask32(mb, me):
 146:     """MASK(MB+32, ME+32) at 64 bits (Book I:4125, 4310)."""
 147:     assert 0 <= mb <= 31 and 0 <= me <= 31
 148:     return mask_range(mb + 32, me + 32)
 149: 
 150: 
 151: def want_rlwimi(rs_val, ra_val, sh, mb, me):
 152:     """Architectural rlwimi result per Book I:4310."""
 153:     m = mask32(mb, me)
 154:     return (rotl32(rs_val, sh) & m) | (ra_val & (~m & M64))
 155: 
 156: 
 157: def want_rlwinm(rs_val, sh, mb, me):
 158:     """Architectural rlwinm result per Book I:4125."""
 159:     m = mask32(mb, me)
 160:     return rotl32(rs_val, sh) & m
 161: 
 162: 
 163: # -------------------------------------------------------------------- encodings
 164: def enc_m(op, rs, ra, sh, mb, me, rc=0):
 165:     """Opcode 20 (rlwimi) / 21 (rlwinm) / 23 (rlwnm). Book I format M."""
 166:     assert 0 <= op <= 63 and 0 <= rs <= 31 and 0 <= ra <= 31
 167:     assert 0 <= sh <= 31 and 0 <= mb <= 31 and 0 <= me <= 31 and 0 <= rc <= 1
 168:     return ((op << 26) | (rs << 21) | (ra << 16) | (sh << 11)
 169:             | (mb << 6) | (me << 1) | rc) & 0xFFFFFFFF
 170: 
 171: 
 172: def RLWIMI(ra, rs, sh, mb, me, rc=0):
 173:     return enc_m(20, rs, ra, sh, mb, me, rc)
 174: 
 175: 
 176: def RLWINM(ra, rs, sh, mb, me, rc=0):
 177:     return enc_m(21, rs, ra, sh, mb, me, rc)
 178: 
 179: 
 180: def LI(rd, simm):
 181:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
 182: 
 183: 
 184: def ORI(ra, rs, imm):
 185:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
 186: 
 187: 
 188: NOP = ORI(0, 0, 0)
 189: 
 190: 
 191: # ---------------------------------------------------------------------- sessions
 192: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
 193:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs."""
 194:     cmds = list(setup)
 195:     for i, w in enumerate(insns):
 196:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
 197:     if insns:
 198:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
 199:     cmds.append("pc=0x%x" % CODE)
 200:     if insns:
 201:         cmds.append("step %d" % len(insns))
 202:     cmds.append("reg")
 203:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
 204:     if cpu:
 205:         argv += ["-C", cpu]
 206:     argv += ["0x%x:%s" % (CODE, DUMMY)]
 207:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
 208:     try:
 209:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
 210:                            stderr=subprocess.STDOUT, timeout=timeout)
 211:     except subprocess.TimeoutExpired as e:
 212:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
 213:         return {}, [], out, "TIMEOUT"
 214:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
 215:     rc = p.returncode
 216:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
 217:     idx = t.rfind("GXemul> reg")
 218:     regs = {}
 219:     if idx >= 0:
 220:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
 221:             regs[int(m.group(1))] = int(m.group(2), 16)
 222:         m_cr = re.search(r"\bcr\s*=\s*(0x[0-9a-fA-F]+)", t[idx:])
 223:         if m_cr:
 224:             regs["cr"] = int(m_cr.group(1), 16)
 225:     dis = []
 226:     di = t.find("GXemul> unassemble")
 227:     if di >= 0:
 228:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
 229:                 else len(t)]
 230:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
 231:                              r"(?:\t(\S+))?", seg, re.M):
 232:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
 233:     return regs, dis, t, how
 234: 
 235: 
 236: def seed(pairs):
 237:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
 238: 
 239: 
 240: print("ppcrlwimiwidth RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
 241: print("machine: -E bareppc -M 64 (UNMODIFIED in-tree; MACHINE_DEFAULT_CPU=PPC970, 64-bit)")
 242: print("wants derived from PowerPC Book I v2.01:4310 (rlwimi)")
 243: print("%-19s %-20s %-20s %-46s %s" % ("row", "got", "want", "note", ""))
 244: t0 = time.time()
 245: disasm_checked = 0
 246: disasm_ok = 0
 247: 
 248: # ============================================================ CONTROL SESSION ==
 249: ctl_insns = [
 250:     LI(9, 0x1234),                       # liveness
 251:     NOP,                                 # seed-holds probe steps over this
 252:     RLWINM(4, SRC, 0, 0, 31),            # rlwinm r4,r3,0,0,31 -- sibling control
 253: ]
 254: ctl_setup = seed([(SRC, RS_VAL), (30, SENT)] + [(r, SENT) for r in DESTS])
 255: regs, dis, T, how = session(ctl_setup, ctl_insns)
 256: 
 257: row("session", how, "exit0", "the control session ran to `quit'")
 258: row("live", hex(regs.get(9, -1)), hex(0x1234),
 259:     "li r9,0x1234 -- guest executes and readback works")
 260: row("seed holds", hex(regs.get(30, -1)), hex(SENT),
 261:     "r30 seeded, never destination: proves write is real")
 262: row("src intact", hex(regs.get(SRC, -1)), hex(RS_VAL),
 263:     "rS is unchanged by instructions")
 264: 
 265: want_dis = ["li", "nop", "rlwinm"]
 266: want_ops = ["r9,4660", "", "r4,r3,0,0,31"]
 267: got_pairs = [(m, o) for _, m, o in dis]
 268: disasm_checked += len(want_dis)
 269: disasm_ok += sum(1 for i, (m, o) in enumerate(got_pairs[:len(want_dis)])
 270:                  if m == want_dis[i] and o == want_ops[i])
 271: row("disasm xcheck", "%d/%d" % (disasm_ok, disasm_checked), "3/3",
 272:     "tree's disassembler agrees with encoder")
 273: row("ctl rlwinm", hex(regs.get(4, -1)), hex(want_rlwinm(RS_VAL, 0, 0, 31)),
 274:     "sibling control: rlwinm low word extract")
 275: 
 276: # ================================================ NEGATIVE APPARATUS CONTROL ==
 277: nregs, _, nT, nhow = session(seed([(9, SENT)]), [LI(9, 0x1234)],
 278:                              machine="nosuchmachine", timeout=60)
 279: row("neg apparatus", "%s/%s" % (nhow, hex(nregs.get(9, -1))), "exit1/-0x1",
 280:     "bogus machine -> no guest -> live fails")
 281: 
 282: # ============================================ REACHABILITY CONTROL (32-bit) ===
 283: b32regs, _, b32T, b32how = session(
 284:     seed([(SRC, RS_VAL), (4, SENT), (9, SENT)]),
 285:     [LI(9, 0x1234), RLWIMI(4, SRC, 8, 0, 31)], timeout=60, machine="bareppc",
 286:     cpu="PPC603")
 287: row("bits32 live", hex(b32regs.get(9, -1)), hex(0x1234),
 288:     "PPC603 (32-bit): guest still runs li")
 289: # On 32-bit CPU, rlwimi is a valid instruction (does not trap to bad)
 290: row("bits32 rlwimi", hex(b32regs.get(4, -1) & 0xFFFFFFFF),
 291:     hex(want_rlwimi(RS_VAL, SENT, 8, 0, 31) & 0xFFFFFFFF),
 292:     "PPC603 (32-bit): rlwimi executes cleanly")
 293: 
 294: # ==================================================== CORE DIRECTION PROBES ===
 295: # Session 1: Non-wrapping encodings (MB <= ME), rS has differing halves
 296: # Defect 1 symptom: width contamination when SH > 0 (drags RS high-half bits down)
 297: s1_setup = seed([(SRC, RS_VAL)] + [(r, 0) for r in DESTS])
 298: s1_insns = [
 299:     RLWIMI(4, SRC, 0, 0, 31),    # SH=0, MB=0, ME=31 (full word; passes pre-fix because SH=0)
 300:     RLWIMI(5, SRC, 8, 0, 15),    # SH=8, MB=0, ME=15 (width contamination into top 16 bits of word)
 301:     RLWIMI(6, SRC, 16, 8, 23),   # SH=16, MB=8, ME=23 (width contamination into middle bits)
 302:     RLWIMI(7, SRC, 4, 16, 31),   # SH=4, MB=16, ME=31 (width contamination into lower bits)
 303: ]
 304: s1_regs, s1_dis, s1_T, s1_how = session(s1_setup, s1_insns)
 305: want_s1_dis = ["rlwimi", "rlwimi", "rlwimi", "rlwimi"]
 306: want_s1_ops = ["r4,r3,0,0,31", "r5,r3,8,0,15", "r6,r3,16,8,23", "r7,r3,4,16,31"]
 307: disasm_checked += len(want_s1_dis)
 308: disasm_ok += sum(1 for i, (_, m, o) in enumerate(s1_dis[:len(want_s1_dis)])
 309:                  if m == want_s1_dis[i] and o == want_s1_ops[i])
 310: 
 311: row("nowrap sh0", hex(s1_regs.get(4, -1)), hex(want_rlwimi(RS_VAL, 0, 0, 0, 31)),
 312:     "SH=0, MB<=ME: full 32-bit word, unaffected by shift")
 313: row("nowrap sh8 mb0", hex(s1_regs.get(5, -1)), hex(want_rlwimi(RS_VAL, 0, 8, 0, 15)),
 314:     "SH=8, MB<=ME: width contamination corrupts low word")
 315: row("nowrap sh16 mb8", hex(s1_regs.get(6, -1)), hex(want_rlwimi(RS_VAL, 0, 16, 8, 23)),
 316:     "SH=16, MB<=ME: width contamination into middle bits")
 317: row("nowrap sh4 mb16", hex(s1_regs.get(7, -1)), hex(want_rlwimi(RS_VAL, 0, 4, 16, 31)),
 318:     "SH=4, MB<=ME: width contamination into low bits")
 319: 
 320: # Session 2: Wrapping encodings (MB > ME)
 321: # Defect 2 symptom: high-half replacement omitted (leaves RA high half untouched)
 322: # Subcase A: The mutant from brief: r3=0xaaaaaaaa0000000f, r4=0x5a5a5a5a5a5a5a5a, sh=0, mb=31, me=0
 323: # rlwimi r4,r3,0,31,0 -> want 0x0000000f5a5a5a5b, mutant 0x5a5a5a5a5a5a5a5b
 324: MUT_RS = 0xAAAAAAAA0000000F
 325: s2_setup = seed([(SRC, MUT_RS), (4, SENT), (5, SENT), (6, SENT), (7, SENT)])
 326: s2_insns = [
 327:     RLWIMI(4, SRC, 0, 31, 0),    # Brief mutant: SH=0, MB=31, ME=0 (word 0x506407c0)
 328:     RLWIMI(5, SRC, 0, 24, 8),    # SH=0, MB=24, ME=8 (wrapping, SH=0)
 329:     RLWIMI(6, SRC, 8, 20, 10),   # SH=8, MB=20, ME=10 (wrapping, SH>0: both defects active!)
 330:     RLWIMI(7, SRC, 16, 28, 4),   # SH=16, MB=28, ME=4 (wrapping, SH>0: both defects active!)
 331: ]
 332: s2_regs, s2_dis, s2_T, s2_how = session(s2_setup, s2_insns)
 333: want_s2_dis = ["rlwimi", "rlwimi", "rlwimi", "rlwimi"]
 334: want_s2_ops = ["r4,r3,0,31,0", "r5,r3,0,24,8", "r6,r3,8,20,10", "r7,r3,16,28,4"]
 335: disasm_checked += len(want_s2_dis)
 336: disasm_ok += sum(1 for i, (_, m, o) in enumerate(s2_dis[:len(want_s2_dis)])
 337:                  if m == want_s2_dis[i] and o == want_s2_ops[i])
 338: 
 339: row("wrap mutant", hex(s2_regs.get(4, -1)), hex(want_rlwimi(MUT_RS, SENT, 0, 31, 0)),
 340:     "brief mutant: rlwimi r4,r3,0,31,0 -> high word 0x0000000f")
 341: row("wrap sh0 mb24", hex(s2_regs.get(5, -1)), hex(want_rlwimi(MUT_RS, SENT, 0, 24, 8)),
 342:     "SH=0, MB>ME: high half must be replaced with rotated low word")
 343: row("wrap sh8 mb20", hex(s2_regs.get(6, -1)), hex(want_rlwimi(MUT_RS, SENT, 8, 20, 10)),
 344:     "SH=8, MB>ME: both defects active (width contam + high half)")
 345: row("wrap sh16 mb28", hex(s2_regs.get(7, -1)), hex(want_rlwimi(MUT_RS, SENT, 16, 28, 4)),
 346:     "SH=16, MB>ME: both defects active (width contam + high half)")
 347: 
 348: # Session 3: Destination preservation with structured data and seeded rA
 349: s3_setup = seed([(SRC, RS_VAL)] + [(r, SENT) for r in DESTS])
 350: s3_insns = [
 351:     RLWIMI(4, SRC, 8, 0, 15),    # nowrap: preserve low 16 bits of low word + all high half
 352:     RLWIMI(5, SRC, 0, 24, 8),    # wrap: preserve unmasked bits 9..23 of low word, replace high half
 353:     RLWIMI(6, SRC, 0, 1, 0),     # wrap: full word boundary wrap (bits 1..31 and 0)
 354: ]
 355: s3_regs, s3_dis, s3_T, s3_how = session(s3_setup, s3_insns)
 356: want_s3_dis = ["rlwimi", "rlwimi", "rlwimi"]
 357: want_s3_ops = ["r4,r3,8,0,15", "r5,r3,0,24,8", "r6,r3,0,1,0"]
 358: disasm_checked += len(want_s3_dis)
 359: disasm_ok += sum(1 for i, (_, m, o) in enumerate(s3_dis[:len(want_s3_dis)])
 360:                  if m == want_s3_dis[i] and o == want_s3_ops[i])
 361: 
 362: row("pres nowrap", hex(s3_regs.get(4, -1)), hex(want_rlwimi(RS_VAL, SENT, 8, 0, 15)),
 363:     "preserve unmasked destination bits in low and high words")
 364: row("pres wrap", hex(s3_regs.get(5, -1)), hex(want_rlwimi(RS_VAL, SENT, 0, 24, 8)),
 365:     "preserve unmasked bits in low word, replace high half")
 366: row("wrap fullword", hex(s3_regs.get(6, -1)), hex(want_rlwimi(RS_VAL, SENT, 0, 1, 0)),
 367:     "wrap fullword boundary: replace entire high half + 31 bits low")
 368: 
 369: # Session 4: Register Aliasing (RA == RS)
 370: # Test Question 2: Does RA == RS behave differently?
 371: # r4 initialized to RS_VAL (differing halves: 0xDEADBEEFCAFEF00D).
 372: # When RA == RS, r4 is both source and destination.
 373: s4_setup = seed([(4, RS_VAL), (5, RS_VAL), (6, RS_VAL)])
 374: s4_insns = [
 375:     RLWIMI(4, 4, 8, 0, 15),     # alias nowrap: SH=8, MB<=ME -> width contamination on self
 376:     RLWIMI(5, 5, 0, 31, 0),     # alias wrap: SH=0, MB>ME -> high half replacement on self
 377:     RLWIMI(6, 6, 4, 20, 10),    # alias both: SH=4, MB>ME -> both defects on self
 378: ]
 379: s4_regs, s4_dis, s4_T, s4_how = session(s4_setup, s4_insns)
 380: want_s4_dis = ["rlwimi", "rlwimi", "rlwimi"]
 381: want_s4_ops = ["r4,r4,8,0,15", "r5,r5,0,31,0", "r6,r6,4,20,10"]
 382: disasm_checked += len(want_s4_dis)
 383: disasm_ok += sum(1 for i, (_, m, o) in enumerate(s4_dis[:len(want_s4_dis)])
 384:                  if m == want_s4_dis[i] and o == want_s4_ops[i])
 385: 
 386: row("alias nowrap", hex(s4_regs.get(4, -1)), hex(want_rlwimi(RS_VAL, RS_VAL, 8, 0, 15)),
 387:     "RA==RS nowrap: self-insertion with SH=8")
 388: row("alias wrap", hex(s4_regs.get(5, -1)), hex(want_rlwimi(RS_VAL, RS_VAL, 0, 31, 0)),
 389:     "RA==RS wrap: self-insertion replacing high half")
 390: row("alias both", hex(s4_regs.get(6, -1)), hex(want_rlwimi(RS_VAL, RS_VAL, 4, 20, 10)),
 391:     "RA==RS both: self-insertion with SH=4, MB>ME")
 392: 
 393: # ========================================================= CR0 RECORD FORM =====
 394: # rlwimi. with Rc=1
 395: cr_setup = seed([(SRC, RS_VAL), (4, SENT)])
 396: cr_insns = [
 397:     RLWIMI(4, SRC, 8, 0, 15, rc=1),
 398: ]
 399: cr_regs, cr_dis, cr_T, cr_how = session(cr_setup, cr_insns)
 400: row("cr0 record form", "exit0" if "cr" in cr_regs else "no-cr", "exit0",
 401:     "rlwimi. executes with Rc=1 and dumps CR")
 402: 
 403: # ==================================================== COMPREHENSIVE CENSUS =====
 404: # Sweep structured combinations across (SH, MB, ME) space:
 405: # - Quadrant 1: SH=0, MB<=ME (non-wrapping, zero shift)
 406: # - Quadrant 2: SH in {1, 8, 16, 31}, MB<=ME (non-wrapping, shift > 0: width contamination)
 407: # - Quadrant 3: SH=0, MB>ME (wrapping, zero shift: missing high-half)
 408: # - Quadrant 4: SH in {1, 8, 16, 31}, MB>ME (wrapping, shift > 0: both defects)
 409: census_combos = []
 410: # Fixed representative (MB, ME) pairs:
 411: mb_me_nowrap = [(0, 31), (0, 15), (8, 23), (16, 31), (10, 20), (0, 0), (31, 31)]
 412: mb_me_wrap = [(31, 0), (24, 8), (20, 10), (28, 4), (1, 0), (31, 30), (16, 8)]
 413: 
 414: for sh_val in [0, 1, 8, 16, 31]:
 415:     for mb, me in mb_me_nowrap:
 416:         census_combos.append((sh_val, mb, me))
 417:     for mb, me in mb_me_wrap:
 418:         census_combos.append((sh_val, mb, me))
 419: 
 420: # Add diagonal and boundary sweeps:
 421: for k in range(32):
 422:     census_combos.append((k, k, (31 - k)))
 423:     census_combos.append((k, (31 - k), k))
 424: 
 425: seen = set()
 426: uniq_census = []
 427: for c in census_combos:
 428:     if c not in seen:
 429:         seen.add(c)
 430:         uniq_census.append(c)
 431: 
 432: census_fail = 0
 433: census_zero = 0
 434: census_run = 0
 435: 
 436: for base in range(0, len(uniq_census), len(DESTS)):
 437:     chunk = uniq_census[base:base + len(DESTS)]
 438:     insns = [RLWIMI(DESTS[i], SRC, sh, mb, me) for i, (sh, mb, me) in enumerate(chunk)]
 439:     st = seed([(SRC, RS_VAL)] + [(r, SENT) for r in DESTS])
 440:     cregs, cdis, cT, chow = session(st, insns)
 441:     if chow != "exit0":
 442:         print("CENSUS SESSION ABORTED how=%s at base=%d" % (chow, base))
 443:         break
 444:     for i, (sh, mb, me) in enumerate(chunk):
 445:         disasm_checked += 1
 446:         if i < len(cdis) and cdis[i][1] == "rlwimi" and \
 447:            cdis[i][2] == "r%d,r%d,%d,%d,%d" % (DESTS[i], SRC, sh, mb, me):
 448:             disasm_ok += 1
 449:     for i, (sh, mb, me) in enumerate(chunk):
 450:         census_run += 1
 451:         got = cregs.get(DESTS[i], None)
 452:         exp = want_rlwimi(RS_VAL, SENT, sh, mb, me)
 453:         if got != exp:
 454:             census_fail += 1
 455:         if got == 0:
 456:             census_zero += 1
 457: 
 458: row("disasm total", "%d/%d" % (disasm_ok, disasm_checked),
 459:     "%d/%d" % (disasm_checked, disasm_checked),
 460:     "every placed word re-read by disassembler")
 461: row("census run", census_run, len(uniq_census),
 462:     "(SH,MB,ME) cells driven across sweeps and diagonals")
 463: row("census wrong", census_fail, 0,
 464:     "cells differing from architectural result (0 after fix)")
 465: row("census zero", census_zero, 0,
 466:     "cells returning zero (0 after fix)")
 467: 
 468: # ================================================================ SCORE + DONE
 469: npass = sum(1 for _, ok in rows if ok)
 470: print("")
 471: print("SCORE %d/%d  elapsed=%.1fs  binary=%s  label=%s"
