 223:          "VXSNAN fcmpu sNaN" "VXCVI fctiwz sNaN" "VXCVI fctiwz qNaN" \
 224:          "clean fadd qNaN" "clean fadd Inf+Inf" "clean fdiv Inf/0" \
 225:          "mtfsf FM=0xff" "mtfsf FM=0x80" "mtfsf FM=0x01" "mtfsf FM=0x0f" \
 226:          "mtfsf FM=0x40" "mtfsf clears" \
 227:          "VX falls on last clear" "VX rises on cause" \
 228:          "FEX rises on enable" "FEX falls with its cause" \
 229:          "FEX order: enable first" "FEX order: cause first" \
 230:          "FX latches once only" \
