  96: rows = []
  97: 
  98: 
  99: def row(name, got, want, note=""):
 100:     assert name not in [n for n, _ in rows], "DUPLICATE ROW NAME %r" % name
 101:     assert len(name) <= 18, name
 102:     ok = (got == want)
 103:     rows.append((name, ok))
 104:     print("%-19s %-20s %-20s %-46s %s" % (name, str(got), str(want), note,
 105:                                           "ok" if ok else "FAIL"))
 106:     return ok
