    node = next(n.value for n in manifest.body if isinstance(n, ast.Assign) and any(isinstance(t,ast.Name) and t.id==block for t in n.targets))
    keys = [ast.literal_eval(k) for k in node.keys]
    dupes = sorted({k for k in keys if keys.count(k)>1})
    print(block, 'duplicate keys:', dupes)
