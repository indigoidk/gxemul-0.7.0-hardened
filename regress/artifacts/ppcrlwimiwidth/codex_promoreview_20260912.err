 169: 
 170: def LI(rd, simm):
 171:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
 172: 
 173: 
 174: def ORI(ra, rs, imm):
 175:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
 176: 
 177: 
 178: NOP = ORI(0, 0, 0)
