 125: RLDLOG=$LOGDIR/ppc_rldimi.log
 126: python3 ppc_rldimi_probe.py "$PMAX" gate > "$RLDLOG" 2>&1 || true
 127: rldres=$(grep -c '^PPC_RLDIMI_RESULT=[0-9]*/[0-9]*$' "$RLDLOG")
 128: rldctl=$(grep -c '^PPC_RLDIMI_CONTROL=[A-Z]*$' "$RLDLOG")
