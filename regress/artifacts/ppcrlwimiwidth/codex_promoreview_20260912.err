import re
for kind,n in [('RLWIMI',28),('RLDIMI',27)]:
    prefix='PPC_'+kind
    good=[prefix+'_RESULT=%d/%d'%(n,n),prefix+'_CONTROL=OK',prefix+'_PROBE_DONE']
    cases={
        'valid':good,
        'empty numbers':[prefix+'_RESULT=/']+good[1:],
        'duplicate valid result':good+[good[0]],
        'extra malformed empty result':good+[prefix+'_RESULT='],
        'extra malformed control':good+[prefix+'_CONTROL==JUNK'],
    }
    for label,lines in cases.items():
        counts=[sum(bool(re.fullmatch(prefix+pattern,line)) for line in lines) for pattern in ('_RESULT=[0-9]*/[0-9]*','_CONTROL=[A-Z]*','_PROBE_DONE')]
        def extract(name):
            values=[line.split('=')[1] for line in lines if line.startswith(prefix+'_'+name+'=')]
            return '\\n'.join(values).rstrip('\\n')
        result=extract('RESULT')
        ctl=extract('CONTROL')
        denom=result.split('/',1)[1] if '/' in result else result
        numer=result.rsplit('/',1)[0] if '/' in result else result
        passed=counts==[1,1,1] and ctl=='OK' and denom==str(n) and numer==str(n)
        print('IN-MEMORY SHELL-SEMANTICS MODEL',kind,label,'counts=',counts,'parse=',counts==[1,1,1],'section_pass=',passed)
