 116: # ----------------------------------------------------------------- architecture
 117: def rotl64(x, n):
 118:     n &= 63
 119:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
 120: 
 121: 
 122: def mask_b_63(b):
 123:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
 124:     assert 0 <= b <= 63
 125:     return (1 << (64 - b)) - 1
 126: 
 127: 
 128: def mask_0_e(e):
 129:     """MASK(0,e), big-endian = the high (e+1) bits."""
 130:     assert 0 <= e <= 63
 131:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
 132: 
 133: 
 134: def mask_range(b, e):
 135:     """MASK(b,e), the architecture's own wrapping mask generator (Book I:578, PEM:6879)."""
 136:     assert 0 <= b <= 63 and 0 <= e <= 63
 137:     m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
 138:     assert m != 0, "MASK(%d,%d) came out all-zero, which architecture forbids" % (b, e)
 139:     return m
 140: 
 141: 
 142: def rotl32(x, n):
 143:     """ROTL[32] per Book I:4008 -- two copies of (RS)[32:63], then rotate."""
 144:     lo = x & 0xFFFFFFFF
 145:     n &= 31
 146:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
 147:     return (r32 << 32) | r32
 148: 
 149: 
 150: def mask32(mb, me):
 151:     """MASK(MB+32, ME+32) at 64 bits (Book I:4125, 4310)."""
 152:     assert 0 <= mb <= 31 and 0 <= me <= 31
 153:     return mask_range(mb + 32, me + 32)
 154: 
 155: 
 156: def want_rlwimi(rs_val, ra_val, sh, mb, me):
 157:     """Architectural rlwimi result per Book I:4310."""
 158:     m = mask32(mb, me)
 159:     return (rotl32(rs_val, sh) & m) | (ra_val & (~m & M64))
 160: 
 161: 
 162: def want_rlwinm(rs_val, sh, mb, me):
 163:     """Architectural rlwinm result per Book I:4125."""
 164:     m = mask32(mb, me)
 165:     return rotl32(rs_val, sh) & m
