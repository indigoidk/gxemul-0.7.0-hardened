 829: 
 830:     #  wdcaltoffset PASS 1, 2026-08-30.  Four instruments from the measuring seat's
 831:     #  six-binary table.  CLASS_RESEARCH on the precedent two entries down: they are
 832:     #  EVIDENCE preserved so the numbers can be re-run rather than believed.
 833:     #
 834:     #  `table_a.py` is worth a note because it is the reason the table is credible:
 835:     #  it IMPORTS witness_20260829/wdcaltoff_rung3_probe.py rather than
 836:     #  re-implementing the encoder, so it cannot measure a fix of its own invention.
 837:     #  Its fix leg was checked byte-identical to mkfixleg.py's output AND to the
 838:     #  preserved fixleg.diff before any mutant was built.
 839:     #  #494 PASS 2, the opus5 seat.  Instruments preserved so its measured floor
 840:     #  breach can be re-run rather than believed.  `PROPOSED_...` is kept as the
 841:     #  PROVENANCE of what the seat proposed: the shipped detector differs from it
 842:     #  only by an added clause-(e) contract, and keeping both makes that checkable.
 843:     #  wdcaddtoinbufbound RUNG-3 WITNESS, 2026-08-30.  The probe is the INSTRUMENT of
 844:     #  a 20/20 two-leg measurement and is preserved so the numbers can be re-run
 845:     #  rather than believed.  `frozen_wave_*` is the FROZEN COPY the run actually
 846:     #  executed -- kept beside the live probe on purpose, because a comparison run
 847:     #  owes ONE instrument and the frozen copy is the proof of which one it was.
 848:     #  #497 widthkillclass, 2026-08-30.  The measuring seat's TWO-TABLE instrument set,
 849:     #  preserved so a 22-mutant result can be RE-RUN rather than believed.  CLASS_RESEARCH
 850:     #  on the precedent immediately below: these are EVIDENCE, not detectors the battery
 851:     #  owes a run.
 852:     #
 853:     #  `sgi_re_width_probe.py` is the 35-row detector ITSELF, and it is filed here as
 854:     #  research on purpose: the round's shipping copy will live in regress/ and be gated or
 855:     #  dated-exempt.  Two copies with two classes is correct rather than untidy -- the
 856:     #  artifacts one is the instrument that produced THESE numbers and must never change,
 857:     #  while the regress/ one is live and will.
 858:     #
 859:     #  `mutate497.py` and `mutate497_v2.py` are BOTH kept, and the pair is the point: v1
 860:     #  was re-read from the live scratchpad per mutant, which is the frozen-copy hole the
 861:     #  seat caught before it bit.  v2 freezes the mutator and hard-exits if it is missing.
 862:     #  Keeping only v2 would erase the evidence that table 1 and table 2 ran different
 863:     #  drivers -- which is exactly what a reader comparing the two tables needs to know.
 864:     "artifacts/widthkillclass/opus_impl_20260830/apply_fix497.py":
 865:         (CLASS_RESEARCH, "#497 applies the six-site fix to a clone, preserved as evidence"),
 866:     "artifacts/widthkillclass/opus_impl_20260830/move_warned.py":
 867:         (CLASS_RESEARCH, "#497 moves the latch field last -- the edit that stopped the over-run aliasing the latch"),
 868:     "artifacts/widthkillclass/opus_impl_20260830/mutate497.py":
 869:         (CLASS_RESEARCH, "#497 table-1 mutator, kept to show v1 re-read itself per mutant"),
 870:     "artifacts/widthkillclass/opus_impl_20260830/mutate497_v2.py":
 871:         (CLASS_RESEARCH, "#497 table-2 mutator, frozen and hard-exiting if absent"),
 872:     "artifacts/widthkillclass/opus_impl_20260830/sgi_re_width_probe.py":
 873:         (CLASS_RESEARCH, "#497 the 35-row detector AS MEASURED -- the shipping copy is separate and gated"),
 874:     #  #500 pass 6: the NEGATIVE CONTROL's mutated probe, frozen as evidence.  It is
 875:     #  a MUTANT of the shipping detector, deliberately run by no gate -- its whole
 876:     #  purpose is to reproduce a RED.  A seat built the mutant it carries; the
 877:     #  control proved both that the hole existed and that the repair closes it.
 878:     "artifacts/sgideprimop/killtable_20260902_table4/negctl_n25_rectset_probe.py":
 879:         (CLASS_RESEARCH, "#500 the negative control AS RUN -- drawmode store neutered; reds n25 rectset alone, 38/39"),
 880:     #  #500 pass 12: the FROZEN INSTRUMENT of the class-closure table.  A comparison
 881:     #  run owes ONE instrument, so the driver copies the probe once and every cell
 882:     #  scores against that copy -- a driver that re-reads the live probe between
 883:     #  cells gives run 1 and run 2 different tools, which this project has measured
 884:     #  (a 39/40 against a table of /39).  It is EVIDENCE, deliberately run by no gate;
 885:     #  the shipping copy is regress/sgi_de_primop_probe.py and gate_arm.sh runs that.
 886:     "artifacts/sgideprimop/killtable_20260903_table13_xfer/frozen_probe.py":
 887:         (CLASS_RESEARCH, "#500 pass 15 frozen instrument for the eleven-register closure table (51 rows; six XFER cells closed, two declared limits measured)"),
 888:     "artifacts/sgideprimop/gapB_20260903/frozen_probe.py":
 889:         (CLASS_RESEARCH, "#500 pass 15 the 50-row instrument AS MEASURED against || step_x -- the gap, 50/50, before the repair"),
 890:     "artifacts/sgideprimop/killtable_20260903_table12_regs/frozen_probe.py":
 891:         (CLASS_RESEARCH, "#500 pass 14 frozen instrument for the register-family closure table (50 rows, dec regs set at want=1 -- the corrected live probe wants 2)"),
 892:     "artifacts/sgideprimop/killtable_20260902_table11_closure/frozen_probe.py":
 893:         (CLASS_RESEARCH, "#500 pass 12 frozen instrument for the class-closure table -- the 47-row probe AS MEASURED across B24/B27-B31 plus the B25/B26 controls"),
 894: 
 895:     "artifacts/widthkillclass/opus_impl_20260830/strengthen_comment.py":
 896:         (CLASS_RESEARCH, "#497 applies the measured memory-safety wording at the two LINEAR sites only"),
 897: 
 898:     #  #498's SHIPPING detector -- gate-wired in gate_arm.sh, 25 rows, sentinel
 899:     #  OPUS498T_DONE.  CLASS_DETECTOR rather than research: the battery owes it a run.
 900:     #  Self-contained by deliberate choice -- every committed probe in this tree rolls its
 901:     #  own pty rather than importing the untracked _scratchpad/gxprobe.py, and following
 902:     #  that precedent avoids making a committed file depend on one outside the repo.
 903:     "sgi_de_width_probe.py":
 904:         (CLASS_DETECTOR, "#498 sgidewidth -- 25 rows, gate_arm.sh, every row from a measured mutant kill"),
 905: 
 906:     #  sgireunmapped #499: the SHIPPED detector.  Gate-run by gate_arm.sh -- invocation,
 907:     #  OPUS499T_DONE sentinel check, controls by name, EVERY row named individually, and
 908:     #  a SUMMED denominator that separates a LOST row from a FAILING one.
 909:     #
 910:     #  *** THE ROW COUNT IS NOT WRITTEN HERE.  It went 28 -> 34 -> 36 -> 48 across four
 911:     #  passes in one day and this comment said 28 for all of them.  Derive it: ***
 912:     #
 913:     #      awk '/for v in "live"/{l=$0; getline n;
 914:     #           if (n ~ /UNMLOG/) {print gsub(/"[^"]*"/,"",l)}}' regress/gate_arm.sh
 915:     #
 916:     #  The `getline'/UNMLOG pair is load-bearing and is not defensive clutter: several
 917:     #  sections of gate_arm.sh open with the same `for v in "live" "devsig"' names, so
 918:     #  the FIRST match is a different probe's list.  The log variable on the NEXT line
 919:     #  is the only thing that identifies which section a row list belongs to.  (A first
 920:     #  attempt here counted `check "sgi_re unmapped row:"' lines and returned 1 -- the
 921:     #  rows are named in a LOOP, so there is one such line however many rows exist.
 922:     #  It was caught by running it, which is the whole reason a deriver is written down
 923:     #  instead of a number.)
 924:     #
 925:     #  (Demoted literals, kept as the record of what was measured and never as current
 926:     #  claims: 18/28 pre-fix and 28/28 on the fix, the test-first evidence in this row's
 927:     #  own artifacts dir; 30/34 and 33/34 for the two pass-2 mutants against the 34-row
 928:     #  repair, where the 28-row version had scored both 28/28.)
 929:     #  #500 sgideprimop: the SHIPPED detector.  Gate-run by gate_arm.sh -- invocation,
 930:     #  OPUS500_DONE sentinel check, every row named individually, and a SUMMED denominator
 931:     #  that separates a LOST row from a FAILING one.
 932:     #
 933:     #  ROW COUNT NOT WRITTEN HERE.  The sibling entry below said "28 rows" through four
 934:     #  passes that took it to 50.  Derive it:
 935:     #
 936:     #      awk '/for v in "live"/{l=$0; getline n;
 937:     #           if (n ~ /PRIMLOG/) {print gsub(/"[^"]*"/,"",l)}}' regress/gate_arm.sh
 938:     #  pcc2widthkills: the WITNESS (rung 3, 4/10 on the committed build, preserved with its
 939:     #  run under artifacts/pcc2widthkills/) and the DETECTOR it grew into.  The witness is
 940:     #  deliberately run by no gate: its job was to exist BEFORE the edit.
 941:     "artifacts/pcc2widthkills/pcc2_width_witness.asrun.py":
 942:         (CLASS_RESEARCH, "pcc2widthkills the witness AS RUN for its 4/10 pre-fix measurement (before the docstring correction)"),
 943:     "artifacts/pcc2widthkills/pcc2_operator_reach.asrun.py":
 944:         (CLASS_RESEARCH, "pcc2widthkills the three-session probe that MEASURED the debugger reaching an odd-offset arm (put h 0xfff42003 -> exit1)"),
