1656:                                     "gate_ppc.sh now executes -M 64 (rlwimi/rldimi); this "
1657:                                     "probe lacks the RESULT/CONTROL protocol a gate parses "
1658:                                     "-- that instrument change is filed to wiringcliff"),
1659:     "mk48_nvram_probe.py":         ("2026-09-20",
1660:                                     "no gate drives mvme88k/mvme187; gate_m88k_rounding.sh "
1661:                                     "is the named home and giving it an mvme187 leg is a "
1662:                                     "harness round, filed to wiringcliff"),
1663:     "alpha_tbi_probe.py":          ("2026-09-20",
1664:                                     "no gate runs an Alpha machine; gate_crossfamily.sh "
