2431:X(rldicl)
2432-{
2433-	int rs = (ic->arg[0] >> 21) & 31;
2434-	int ra = (ic->arg[0] >> 16) & 31;
2435-	int sh = ((ic->arg[0] >> 11) & 31) | ((ic->arg[0] & 2) << 4);
2436-	int mb = ((ic->arg[0] >> 6) & 31) | (ic->arg[0] & 0x20);
2437-	int rc = ic->arg[0] & 1;
2438-	uint64_t tmp = cpu->cd.ppc.gpr[rs], tmp2;
2439-	/*  TODO: Fix this, its performance is awful:  */
2440-	while (sh-- != 0) {
2441-		int b = (tmp >> 63) & 1;
2442-		tmp = (tmp << 1) | b;
2443-	}
2444-	tmp2 = 0;
2445-	while (mb <= 63) {
2446-		/*  #522 (ppcrldiclzero): this was `tmp |=', so the MASK was
2447-		    accumulated into the ROTATED VALUE and `tmp2' -- assigned 0
2448-		    just above and never assigned again -- was still 0 at the AND
2449-		    below.  THE DESTINATION WAS THEREFORE SET TO ZERO ON EVERY
2450-		    EXECUTION, for every source, rotate amount and mask begin.
2451-		    The `|=' also destroyed the rotated data by forcing every mask
2452-		    bit to 1, which is moot only because the result was ANDed with
2453-		    zero.  `rldicl' is the canonical 64-bit masking and zero-extend
2454-		    instruction (`rldicl rA,rS,0,32' is the standard 32-bit
2455-		    zero-extend), so this was wrong on the ordinary path for
2456-		    ordinary compiler output.
2457-
2458-		    MEASURED at rung 3 BEFORE this edit, on unmodified -E bareppc:
2459-		        artifacts/ppcrldiclzero/opus_ppc_rldicl_witness_20260910.py
2460-		        witness_committed.out  -- 19/27, 190 of 190 census cells
2461-		                                  wrong and all 190 returning zero
2462-		        witness_fix.out        -- 24/27, 0 of 190 wrong
2463-		    AND ON TWO MORE MACHINES, in a SEPARATE log -- an earlier draft
2464-		    of this comment named all three here while citing only the
2465-		    one-machine files above, which a pass-2 seat caught and then
2466-		    re-measured rather than merely reporting:
2467-		        pass2_20260910/opus_threemachine.log -- bareppc, testppc
2468-		        and macppc -e g5 (the Power Mac G5, a PPC970 and therefore
2469-		        64-bit), all three zero pre-fix and architectural post-fix
2470-		    The wants come from the rldiclx RTL in the architecture manual,
2471-		    not from this tree; the encodings were re-read by the tree's own
2472-		    disassembler, a different code path from this handler.
2473-
2474-		    *** TWO EDITS TO THIS LINE PAIR ARE MEASURED WRONG, AND THEY
2475-		    ARE WRONG IN DIFFERENT WAYS.  BOTH ARE TEMPTING. ***
2476-		      * REPLACING the `&' with `|' ships ROTL64(rS,SH) |
2477-		        MASK(MB,63) -- an OR where the architecture says AND -- and
2478-		        gets 126 of 190 cells wrong.  Built and measured as the
2479-		        M_NAIVE leg of killtable_20260910.
--
2486-		    Either is worse than the original defect in one specific way:
2487-		    it removes the always-zero signature that makes this easy to
2488-		    spot while leaving the value wrong.
2489-
2490-		    The sibling `rldicr' below is correct and shows the other
2491-		    shape: it CLEARS bits in `tmp' and assigns `tmp' directly.
2492-		    `rldimi' and `rlwimi' have their own separate defects, both
2493-		    measured -- see the ppcrldimimask and ppcrlwimiwidth rows.  */
2494-		tmp2 |= ((uint64_t)1 << (63-mb));
2495-		mb ++;
2496-	}
2497-	cpu->cd.ppc.gpr[ra] = tmp & tmp2;
