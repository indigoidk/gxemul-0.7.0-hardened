  135: def mask_range(b, e):
  136:     """MASK(b,e) -- the architecture's own mask generator, INCLUSIVE and WRAPPING.
  137: 
  138:        PowerPC Book I v2.01, _scratchpad/ppc_uisa_book1_v201.txt:
  139:          :578     "Mask having 1s in positions x through y (WRAPPING IF x > y)"
  140:          :4015    "The mask is 64 bits long"
  141:          :4022-29  if mstart <= mstop: mask[mstart..mstop] = ones
  142:                    else:               mask[mstart..63] = ones ; mask[0..mstop] = ones
