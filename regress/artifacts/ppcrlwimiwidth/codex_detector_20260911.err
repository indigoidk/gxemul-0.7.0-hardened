 2618: 	tmp = sh ? ((tmp << sh) | (tmp >> (32-sh))) : tmp;
 2619: 
 2620: 	/*  A wrapping 64-bit MASK(MB+32, ME+32) selects the DUPLICATED high
 2621: 	    word (Book I :578 -- MASK wraps when x > y).  Assignment to a
 2622: 	    32-bit MODE_uint_t retains only the low word, which is a sound
 2623: 	    representation argument by defined unsigned-conversion semantics
 2624: 	    and NOT an accident: the shift is performed at 64-bit width and
 2625: 	    the loop below then does the low-word insertion.
 2626: 
 2627: 	    IT IS NOT A CLAIM THAT ARCHITECTURAL 32-BIT MODE REMOVES HALF THE
 2628: 	    REGISTER, and the earlier one-line wording here invited that
 2629: 	    reading.  Book I S1.2 (:342) says both execution modes affect all
 2630: 	    64 bits when an instruction sets a 64-bit register and the result
 2631: 	    is mode-independent, and :1989 describes every GPR as 64 bits --
 2632: 	    so a 64-bit processor running in 32-bit MODE still owes this
 2633: 	    write.  Whether any such implementation compiles the narrow
 2634: 	    variant is NOT established here; if one does, it loses the
 2635: 	    architectural high word and that is a defect.  Filed rather than
 2636: 	    guessed.  (This file's idiom is MODE32 with #else -- see extsb /
 2637: 	    extsh -- and carries no MODE64 conditional, so a future guard
 2638: 	    would be #ifndef MODE32.)  */
