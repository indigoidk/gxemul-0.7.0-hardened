4063-/*
4064- *  ppc_instr_to_be_translated():
4065- *
4066- *  Translate an instruction word into a ppc_instr_call. ic is filled in with
4067- *  valid data for the translated instruction, or a "nothing" instruction if
4068- *  there was a translation failure. The newly translated instruction is then
4069- *  executed.
4070- */
4071-X(to_be_translated)
4072-{
4073-	uint64_t addr, low_pc, tmp_addr;
4074-	uint32_t iword, mask;
4075-	unsigned char *page;
4076-	unsigned char ib[4];
4077-	int main_opcode, rt, rs, ra, rb, rc, aa_bit, l_bit, lk_bit, spr, sh,
4078-	    xo, imm, load, size, update, zero, bf, bo, bi, bh, oe_bit, n64=0,
4079-	    bfa, fp, byterev, nb, mb, me;
4080-	void (*samepage_function)(struct cpu *, struct ppc_instr_call *);
4081-	void (*rc_f)(struct cpu *, struct ppc_instr_call *);
4082-
4083-	/*  Figure out the (virtual) address of the instruction:  */
4084-	low_pc = ((size_t)ic - (size_t)cpu->cd.ppc.cur_ic_page)
4085-	    / sizeof(struct ppc_instr_call);
4086-	addr = cpu->pc & ~((PPC_IC_ENTRIES_PER_PAGE-1)
4087-	    << PPC_INSTR_ALIGNMENT_SHIFT);
4088-	addr += (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);
4089-	cpu->pc = addr;
4090-	addr &= ~((1 << PPC_INSTR_ALIGNMENT_SHIFT) - 1);
4091-
4092-	/*  Read the instruction word from memory:  */
4093:#ifdef MODE32
4094-	page = cpu->cd.ppc.host_load[((uint32_t)addr) >> 12];
4095-#else
4096-	{
4097-		const uint32_t mask1 = (1 << DYNTRANS_L1N) - 1;
4098-		const uint32_t mask2 = (1 << DYNTRANS_L2N) - 1;
4099-		const uint32_t mask3 = (1 << DYNTRANS_L3N) - 1;
4100-		uint32_t x1 = (addr >> (64-DYNTRANS_L1N)) & mask1;
4101-		uint32_t x2 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N)) & mask2;
4102-		uint32_t x3 = (addr >> (64-DYNTRANS_L1N-DYNTRANS_L2N-
4103-		    DYNTRANS_L3N)) & mask3;
4104-		struct DYNTRANS_L2_64_TABLE *l2 = cpu->cd.ppc.l1_64[x1];
4105-		struct DYNTRANS_L3_64_TABLE *l3 = l2->l3[x2];
4106-		page = l3->host_load[x3];
4107-	}
4108-#endif
4109-
4110-	if (page != NULL) {
4111-		/*  fatal("TRANSLATION HIT!\n");  */
4112-		memcpy(ib, page + (addr & 0xfff), sizeof(ib));
4113-	} else {
4114-		/*  fatal("TRANSLATION MISS!\n");  */
4115-		if (!cpu->memory_rw(cpu, cpu->mem, addr, ib,
4116-		    sizeof(ib), MEM_READ, CACHE_INSTRUCTION)) {
4117-			fatal("PPC to_be_translated(): "
4118-			    "read failed: TODO\n");
4119-			exit(1);
4120-			/*  goto bad;  */
4121-		}
4122-	}
4123-
4124-	{
4125-		uint32_t *p = (uint32_t *) ib;
4126-		iword = *p;
4127-		iword = BE32_TO_HOST(iword);
4128-	}
4129-
4130-#define DYNTRANS_TO_BE_TRANSLATED_HEAD
4131-#include "cpu_dyntrans.c"
4132-#undef  DYNTRANS_TO_BE_TRANSLATED_HEAD
4133-
4134-
4135-	/*
4136-	 *  Translate the instruction:
4137-	 */
4138-
4139-	main_opcode = iword >> 26;
4140-
4141-	switch (main_opcode) {
--
4282-	case PPC_HI6_STB:
4283-	case PPC_HI6_STBU:
4284-	case PPC_HI6_STH:
4285-	case PPC_HI6_STHU:
4286-	case PPC_HI6_STW:
4287-	case PPC_HI6_STWU:
4288-	case PPC_HI6_STD:
4289-	case PPC_HI6_STFD:
4290-	case PPC_HI6_STFDU:	/*  #310  */
4291-	case PPC_HI6_STFS:
4292-	case PPC_HI6_STFSU:	/*  #310  */
4293-		rs = (iword >> 21) & 31;
4294-		ra = (iword >> 16) & 31;
4295-		imm = (int16_t)iword;
4296-		load = 0; zero = 1; size = 0; update = 0; fp = 0;
4297-		ic->f = NULL;
4298-		switch (main_opcode) {
4299-		case PPC_HI6_LBZ:  load=1; break;
4300-		case PPC_HI6_LBZU: load=1; update=1; break;
4301-		case PPC_HI6_LHA:  load=1; size=1; zero=0; break;
4302-		case PPC_HI6_LHAU: load=1; size=1; zero=0; update=1; break;
4303-		case PPC_HI6_LHZ:  load=1; size=1; break;
4304-		case PPC_HI6_LHZU: load=1; size=1; update=1; break;
4305-		case PPC_HI6_LWZ:  load=1; size=2; break;
4306-		case PPC_HI6_LWZU: load=1; size=2; update=1; break;
4307-		case PPC_HI6_LD:   load=1; size=3; break;
4308-		case PPC_HI6_LFD:  load=1; size=3; fp=1;ic->f=instr(lfd);break;
4309-		case PPC_HI6_LFDU: load=1; size=3; fp=1; update=1;
4310-				   ic->f=instr(lfdu); break;	/*  #310  */
4311-		case PPC_HI6_LFS:  load=1; size=2; fp=1;ic->f=instr(lfs);break;
4312-		case PPC_HI6_LFSU: load=1; size=2; fp=1; update=1;
4313-				   ic->f=instr(lfsu); break;	/*  #310  */
4314-		case PPC_HI6_STB:  break;
4315-		case PPC_HI6_STBU: update=1; break;
4316-		case PPC_HI6_STH:  size=1; break;
4317-		case PPC_HI6_STHU: size=1; update=1; break;
4318-		case PPC_HI6_STW:  size=2; break;
4319-		case PPC_HI6_STWU: size=2; update=1; break;
4320-		case PPC_HI6_STD:  size=3; break;
4321-		case PPC_HI6_STFD: size=3; fp=1; ic->f = instr(stfd); break;
4322-		case PPC_HI6_STFDU: size=3; fp=1; update=1;
