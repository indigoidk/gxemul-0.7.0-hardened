3446-#ifndef PPC_STFS_EXTRACT_INCLUDED
3447-#define PPC_STFS_EXTRACT_INCLUDED
3448-/*
3449- *  ppc_stfs_extract():  #304/#305 -- the two classes where the shared store
3450- *  cannot spell what the ISA's SINGLE() extraction owes.  Returns 1 and fills
3451- *  *out when it handled the value; 0 when the legacy path is already right.
3452- *
3453- *  Book I gives SINGLE() three cases on the operand's biased exponent E:
3454- *
3455- *    E > 896            splice sign, exponent and the top 23 fraction bits --
3456- *                       truncation, mode-independent, never rounding.  The
3457- *                       shared store already reproduces this bit for bit for
3458- *                       finite values (measured), so it keeps that path.
3459- *    874 <= E <= 896    DENORMALIZE: restore the implicit 1 and shift right
3460- *                       until the exponent reaches the single's minimum,
3461- *                       truncating what falls off.  The shared store flushes
3462- *                       this whole band to signed zero instead (its #287/#292
3463- *                       policy), which is the defect #304 fixes here.
3464- *    E < 874            WORD is architecturally UNDEFINED; the flush stands as
3465- *                       this fork's policy, and the gate pins it.
3466- *
3467- *  The NaN class is #305's: exponent all-ones is part of the splice case, so a
3468- *  NaN's sign and top-23 payload must survive.  The shared store canonicalizes
3469- *  every NaN to 0x7fffffff instead -- sign and payload both lost (measured).
3470- *  Note what the letter does here and this code faithfully repeats: a NaN whose
3471- *  payload lives entirely in the discarded low bits splices to the INFINITY
3472- *  pattern.  That is the extraction working as specified, not a case to repair,
3473- *  and there is a gate row asserting exactly that byte.  Quieting belongs to
--
3501-
3502-/*
3503- *  #310: the eight UPDATE forms of the single/double float loads and stores.
3504- *
3505- *  lfsu/lfdu/stfsu/stfdu (primary opcodes 0x31/0x33/0x35/0x37) and their
3506- *  indexed twins lfsux/lfdux/stfsux/stfdux (opcode 31, extended 567/631/
3507- *  695/759) were not defined in opcodes_ppc.h and not decoded anywhere -- the
3508- *  header even had blank lines where the four primary opcodes belong.  Every
3509- *  one of them reached `goto bad`, which stops the emulator, and all eight
3510- *  were measured doing exactly that on the macppc probe path before this fix
3511- *  (their non-update twins ran, as controls).
3512- *
3513- *  The round originally scoped four; a panel seat demanded the indexed twins
3514- *  be checked first, on the principle #306 established -- a compiler emits
3515- *  both from the same loops, so fixing half a family leaves the other half
3516- *  stopping the machine.  It was right, though not about which extended
3517- *  opcodes they are: 599 and 663 are lfdx and stfsx, which this tree already
3518- *  decodes.  The update forms are 567/631/695/759, and none appeared here.
3519- *
3520- *  Each is its non-update sibling plus "rA receives the effective address",
3521- *  which the generic load/store table already implements (the +32 index term
3522- *  writes the address back through arg[1]).  So these bodies differ from
3523- *  lfs/lfd/stfs/stfd by one array index, and the format conversion -- the
3524- *  part #304 and #305 corrected -- is shared unchanged.
3525- *
3526- *  rA = 0 is an invalid form for every update instruction, and the decoder
3527- *  rejects it before reaching here, exactly as it already does for the
3528- *  integer update forms.
3529- *
3530- *  The two dispatch tables are NOT the same shape: the D-form table has a
3531- *  zero-displacement dimension and encodes update at +32, while the
3532- *  indexed table has no displacement at all and encodes it at +16 in only
3533- *  32 entries.  Using the D-form's term for the indexed handlers reads
3534- *  past the end of the array; the compiler caught that here as an
3535- *  out-of-bounds subscript, which is the only reason it did not become a
3536- *  call through whatever happened to follow the table.
3537- */
3538-X(lfsu)
3539-{
3540-	uint64_t old_pc, low_pc = ((size_t)ic - (size_t)
3541-	    cpu->cd.ppc.cur_ic_page) / sizeof(struct ppc_instr_call);
3542-	old_pc = cpu->pc = (cpu->pc & ~((PPC_IC_ENTRIES_PER_PAGE-1) <<
3543-	    PPC_INSTR_ALIGNMENT_SHIFT)) + (low_pc << PPC_INSTR_ALIGNMENT_SHIFT);
3544-	if (!(cpu->cd.ppc.msr & PPC_MSR_FP)) {
3545-		ppc_exception(cpu, PPC_EXCEPTION_FPU);
3546-		return;
3547-	}
