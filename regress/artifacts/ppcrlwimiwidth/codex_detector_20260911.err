2671-	cpu->cd.ppc.spr[SPR_XER] &= ~PPC_XER_CA;
2672-	if (tmp & 0x80000000)
2673-		i = 1;
2674-	while (sh-- > 0) {
2675-		if (tmp & 1)
2676-			j ++;
2677-		tmp >>= 1;
2678-		if (tmp & 0x40000000)
2679-			tmp |= 0x80000000;
2680-	}
2681-	if (i && j>0)
2682-		cpu->cd.ppc.spr[SPR_XER] |= PPC_XER_CA;
2683-	reg(ic->arg[1]) = (int64_t)(int32_t)tmp;
2684-}
2685-DOT1(srawi)
