ledger=json.loads(head('tools/pipeline/ledger.json'))
gen=runpy.run_path(str(root/'tools/pipeline/gen_codex_wall.py'),run_name='review_only')
with patch('json.load',return_value=ledger):
    before=gen['held_rows']()
    before_block=gen['block']()
