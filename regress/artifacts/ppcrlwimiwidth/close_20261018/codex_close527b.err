1:#!/bin/bash
2:#  Negative controls for gate_ppc.sh's rlwimi/rldimi section (#527).  The section is EXTRACTED from the gate
3:#  itself (between its `# ---- ppcrlwimiwidth' header and the NetBSD need_file), its two probe invocations are
4:#  replaced by copies of a fixture log, and it runs under stub check/note functions that count failures.
5:#  Fixtures are derived from kill table 3's real BASE logs.  Every doctored case must produce >= 1 FAIL and the
6:#  untouched case must produce 0 -- otherwise the section's parse-before-score guard is not doing its job.
7:cd "$(dirname "$0")/../.." || exit 9          # regress/
8:G=gate_ppc.sh
9:K=artifacts/ppcrlwimiwidth/killtable3_20260912
10:T=$(mktemp -d)
11:awk '/^# ---- ppcrlwimiwidth:/{on=1} on&&/^need_file "\$IMAGES\/netbsd401-macppc-GENERIC"/{exit} on{print}' "$G" > "$T/section.sh"
12:n=$(grep -c 'python3 ppc_rl[wd]imi_probe.py' "$T/section.sh")
13:[ "$n" = 2 ] || { echo "EXTRACT FAILED: $n probe invocations found (want 2)"; exit 9; }
14:sed -i 's#^python3 ppc_rlwimi_probe.py .*#cp "$FIX_W" "$RLWLOG"#; s#^python3 ppc_rldimi_probe.py .*#cp "$FIX_D" "$RLDLOG"#' "$T/section.sh"
15:cat > "$T/stubs.sh" <<'EOF'
16:FAILS=0
17:check() { if [ "$2" = "$3" ]; then :; else FAILS=$((FAILS+1)); echo "      FAIL $1 got=$2 want=$3"; fi; }
18:note() { :; }
19:EOF
20:run() {   # $1 label, $2 rlwimi fixture, $3 rldimi fixture, $4 expect (PASS|FAIL)
21:    ( LOGDIR="$T/logs_$1"; mkdir -p "$LOGDIR"; FIX_W="$2"; FIX_D="$3"
22:      . "$T/stubs.sh"; . "$T/section.sh" > "$T/out_$1" 2>&1
23:      got=PASS; [ "$FAILS" -gt 0 ] && got=FAIL
24:      verdict=WRONG; [ "$got" = "$4" ] && verdict=ok
25:      printf '%-28s fails=%-3s got=%-4s want=%-4s %s\n' "$1" "$FAILS" "$got" "$4" "$verdict"
26:      grep ' FAIL ' "$T/out_$1" | head -3 )
27:}
28:W=$K/probe_rlwimi_BASE.raw; D=$K/probe_rldimi_BASE.raw
29:mk() { sed "$2" "$1" > "$T/$3"; echo "$T/$3"; }
30:run GOOD                   "$W" "$D" PASS
31:run W_SHRUNK_27of27        "$(mk "$W" 's#^PPC_RLWIMI_RESULT=.*#PPC_RLWIMI_RESULT=27/27#' w1)" "$D" FAIL
32:run D_SHRUNK_28of28        "$W" "$(mk "$D" 's#^PPC_RLDIMI_RESULT=.*#PPC_RLDIMI_RESULT=28/28#' d1)" FAIL
33:run W_ONE_RED_27of28       "$(mk "$W" 's#^PPC_RLWIMI_RESULT=.*#PPC_RLWIMI_RESULT=27/28#' w2)" "$D" FAIL
34:run W_DUPLICATE_RESULT     "$(mk "$W" '/^PPC_RLWIMI_RESULT=/p' w3)" "$D" FAIL
35:run D_MALFORMED_EXTRA      "$W" "$(mk "$D" '/^PPC_RLDIMI_RESULT=/a PPC_RLDIMI_RESULT=29/29x' d2)" FAIL
36:run W_MISSING_DONE         "$(mk "$W" '/^PPC_RLWIMI_PROBE_DONE/d' w4)" "$D" FAIL
37:run D_MISSING_RESULT       "$W" "$(mk "$D" '/^PPC_RLDIMI_RESULT=/d' d3)" FAIL
38:run W_CONTROL_FAIL         "$(mk "$W" 's#^PPC_RLWIMI_CONTROL=OK#PPC_RLWIMI_CONTROL=FAIL#' w5)" "$D" FAIL
39:run D_DUPLICATE_CONTROL    "$W" "$(mk "$D" '/^PPC_RLDIMI_CONTROL=/p' d4)" FAIL
40:run D_EMPTY_LOG            "$W" /dev/null FAIL
41:rm -rf "$T"
42:echo NEGCTL_DONE
123:#  #371: gate_skip() exits with the SKIP code, which run.sh maps to
124:#  REGRESS_PASS_WITH_GAPS -- a green-ish verdict. It never consulted the running
125:#  failure counter, so a gate that had ALREADY recorded red checks and then hit a
126:#  gate_skip (a probe that produced no result line, a missing rig image) reported
127:#  those reds as a skip and they vanished from the battery. Measured on a
128:#  synthetic gate: one FAIL then gate_skip exited 77, PASS_WITH_GAPS. This is the
129:#  same "a green row means nothing" class the gate rows themselves guard against,
130:#  in the harness's own control flow.
131:#
132:#  So a gate_skip AFTER failures is a FAIL, not a skip: the skip cannot un-record
133:#  what already failed. A gate_skip with a clean slate stays a genuine skip (a
134:#  preflight that could not run at all -- need_file/need_exec). degrade() was
135:#  already correct: gate_end() tests _fails before _degraded, so a degraded gate
136:#  with recorded failures already reports FAIL. Nothing there to change.
137:gate_skip() {
138:    echo
139:    if [ "${_fails:-0}" != 0 ]; then
140:        echo "${C_BAD}$GATE_NAME: FAIL${C_OFF} ($_fails of $_checks checks failed" \
141:             "before this section could not run: $*)"
142:        exit 1
143:    fi
144:    echo "${C_SKIP}$GATE_NAME: SKIP${C_OFF} -- $*"; exit $EXIT_SKIP
145:}
146:
147:need_file() {
148:    for f in "$@"; do
149:        [ -e "$f" ] || gate_skip "missing required input: $f"
150:    done
151:}
152:
153:need_exec() {
154:    for f in "$@"; do
155:        [ -x "$f" ] || gate_skip "missing or non-executable binary: $f"
156:    done
157:}

