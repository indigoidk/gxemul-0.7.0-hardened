220:# believed -- this harness has been bitten by a probe that reported a defect off
221:# sentinel reads while its guest code had never run.
222:ctrl=$(grep -o "PPC_CONV_CONTROL=[A-Z]*" "$LOG" | tail -1 | cut -d= -f2)
223:check "control rows prove the probe measures" "${ctrl:-missing}" "OK"
