82: /*
83:  *  The invalid-operation cause owed by a two-operand arithmetic instruction,
84:  *  as a mask for ppc_fpscr_raise(). Detection is from the OPERANDS, never from
85:  *  the host result: for an fmadd whose product overflows the host, the host
86:  *  computes a NaN while the ISA's unrounded intermediate is an infinity and no
87:  *  exception is owed at all, so a result-driven test would invent one.
88:  *
89:  *  A signalling operand takes precedence and is the only cause in that case
90:  *  for add/sub/mul; the class-specific causes apply to numerically invalid
91:  *  combinations of non-signalling operands.
92:  */
93: static uint32_t ppc_invalid_cause(uint64_t a, uint64_t b, int op)
94: {
95: 	if (ppc_is_snan(a) || ppc_is_snan(b))
96: 		return PPC_FPSCR_VXNAN;
97: 
98: 	/*  A quiet NaN operand propagates and raises nothing.  */
99: 	if (ppc_is_nan(a) || ppc_is_nan(b))
100: 		return 0;
101: 
102: 	switch (op) {
103: 	case PPC_INVOP_ADD:	/*  Inf + (-Inf)  */
104: 		if (ppc_is_inf(a) && ppc_is_inf(b)
105: 		    && ((a ^ b) >> 63) != 0)
106: 			return PPC_FPSCR_VXISI;
107: 		break;
108: 	case PPC_INVOP_SUB:	/*  Inf - Inf, same sign  */
109: 		if (ppc_is_inf(a) && ppc_is_inf(b)
110: 		    && ((a ^ b) >> 63) == 0)
111: 			return PPC_FPSCR_VXISI;
112: 		break;
113: 	case PPC_INVOP_MUL:	/*  Inf * 0, either order  */
114: 		if ((ppc_is_inf(a) && ppc_is_zero(b))
115: 		    || (ppc_is_zero(a) && ppc_is_inf(b)))
116: 			return PPC_FPSCR_VXIMZ;
117: 		break;
118: 	case PPC_INVOP_DIV:
119: 		if (ppc_is_inf(a) && ppc_is_inf(b))
120: 			return PPC_FPSCR_VXIDI;
121: 		if (ppc_is_zero(a) && ppc_is_zero(b))
122: 			return PPC_FPSCR_VXZDZ;
123: 		break;
124: 	}
125: 
126: 	return 0;
127: }
128: /*
129:  *  ppc_invalid_cause_fma():  #343
130:  *
131:  *  An FMA computes (frA x frC) +/- frB and can owe MORE THAN ONE invalid
132:  *  cause at once, which is why it cannot reuse ppc_invalid_cause(): that one
133:  *  returns a single cause and, correctly for a two-operand instruction,
134:  *  abandons the operation-specific test the moment it sees any NaN.
135:  *
136:  *  The three conditions are independent:
137:  *
138:  *    VXNAN   any of frA, frC, frB is a signalling NaN.
139:  *    VXIMZ   the MULTIPLY is Inf x 0, either order. This depends only on frA
140:  *            and frC, so a NaN ADDEND does not suppress it -- Inf*0 with an
141:  *            sNaN addend owes VXIMZ | VXNAN, the case cpu_ppc.c already
142:  *            documents and the reason this function exists at all.
143:  *    VXISI   the product is infinite AND the addend is an infinity that
144:  *            cancels it. Inf x 0 is excluded first: there is no product for an
145:  *            addend to disagree with.
146:  *
147:  *  fmsub subtracts frB, so its addend's effective sign is inverted -- the same
148:  *  operands that make fmadd invalid make fmsub clean, and the gate rows are a
149:  *  2x2 on exactly that.
150:  */
151: static uint32_t ppc_invalid_cause_fma(uint64_t a, uint64_t c, uint64_t b,
152: 	int subtract)
153: {
154: 	uint32_t cause = 0;
155: 	int prodneg, addneg;
156: 
157: 	if (ppc_is_snan(a) || ppc_is_snan(c) || ppc_is_snan(b))
158: 		cause |= PPC_FPSCR_VXNAN;
159: 
160: 	/*  VXIMZ: the multiply operands alone decide it.  */
161: 	if (!ppc_is_nan(a) && !ppc_is_nan(c) &&
162: 	    ((ppc_is_inf(a) && ppc_is_zero(c)) ||
163: 	     (ppc_is_zero(a) && ppc_is_inf(c))))
164: 		return cause | PPC_FPSCR_VXIMZ;
165: 
166: 	/*  Beyond this point a NaN anywhere means there is no infinite product
167: 	    to cancel, and a NaN addend cannot cancel one.  */
168: 	if (ppc_is_nan(a) || ppc_is_nan(c) || ppc_is_nan(b))
169: 		return cause;
170: 
171: 	if ((ppc_is_inf(a) || ppc_is_inf(c)) && ppc_is_inf(b)) {
172: 		prodneg = (int) (((a ^ c) >> 63) & 1);
173: 		addneg = (int) ((b >> 63) & 1);
174: 		if (subtract)
175: 			addneg = !addneg;
176: 		if (prodneg != addneg)
177: 			cause |= PPC_FPSCR_VXISI;
178: 	}
179: 
180: 	return cause;
