2827: 	uint64_t tmp, mask = 0x800000000000ff73ULL;
2828: 
2829: 	reg_access_msr(cpu, &tmp, 0, 0);
2830: 	tmp &= ~mask;
2831: 	tmp |= (cpu->cd.ppc.spr[SPR_SRR1] & mask);
