363: # --- disassembler cross-check (different code path from the execute handler)
364: want_dis = ["li", "nop", "rldicl", "rldicr", "rldicl", "rldicr"]
365: want_ops = ["r9,4660", "", "r4,r3,0,32", "r5,r3,0,31", "r6,r3,8,0",
366:             "r7,r3,8,63"]
367: got_pairs = [(m, o) for _, m, o in dis]
368: disasm_checked += len(want_dis)
369: disasm_ok += sum(1 for i, (m, o) in enumerate(got_pairs[:len(want_dis)])
370:                  if m == want_dis[i] and o == want_ops[i])
371: row("disasm xcheck", "%d/%d" % (disasm_ok, disasm_checked), "6/6",
372:     "tree's OWN disassembler agrees with the encoder, operand for operand")
373: 
374: # --- the defect, and its discriminating sibling, in ONE session
375: row("zx32 rldicl", hex(regs.get(4, -1)), hex(want_rldicl(RS_VAL, 0, 32)),
376:     "clrldi r4,r3,32 -- the 32-bit zero-extend compilers emit constantly")
377: row("zx32 rldicr", hex(regs.get(5, -1)), hex(want_rldicr(RS_VAL, 0, 31)),
378:     "DISCRIMINATING: the sibling, same session, same rotate, same encoder")
379: row("rot8 rldicl", hex(regs.get(6, -1)), hex(want_rldicl(RS_VAL, 8, 0)),
380:     "rotldi r6,r3,8 -- mask is all-ones, so this is a PURE rotate")
381: row("rot8 rldicr", hex(regs.get(7, -1)), hex(want_rldicr(RS_VAL, 8, 63)),
382:     "DISCRIMINATING: the same pure rotate through the good sibling")
383: 
384: # --- what the NAIVE repair would produce, stated as a measurable prediction
385: # DERIVED, not measured here: what the "obvious" repair would produce.
386: _naive = rotl64(RS_VAL, 0) | mask_b_63(32)
387: row("naive fix wrong", "differs" if _naive != want_rldicl(RS_VAL, 0, 32) else "same",
388:     "differs",
389:     "DERIVED, arithmetic only: `&'->`|' ships OR-not-AND (0x%x).  Deleting the AND on the FIXED code ships ROTL alone -- see M_NOMASK" % _naive)
390: 
391: # ================================================ NEGATIVE APPARATUS CONTROL ==
392: # Prove `live' CAN go red.  A bogus machine name means no machine is built, so a
393: # green `live' would be a check that cannot fail.
394: nregs, _, nT, nhow = session(seed([(9, SENT)]), [LI(9, 0x1234)],
395:                              machine="nosuchmachine", timeout=60)
396: row("neg apparatus", "%s/%s" % (nhow, hex(nregs.get(9, -1))), "exit1/-0x1",
397:     "bogus machine -> no guest -> `live' MUST fail; the oracle is failable")
398: 
399: # ============================================ REACHABILITY CONTROL (32-bit) ===
400: # The decoder sends rld* to `bad' when bits == 32.  Same session, same encoding,
401: # a 32-bit CPU: the instruction must NOT execute as rldicl.
402: b32regs, _, b32T, b32how = session(
403:     seed([(SRC, RS_VAL), (4, SENT), (9, SENT)]),
404:     [LI(9, 0x1234), RLDICL(4, SRC, 0, 32)], timeout=60, machine="bareppc",
405:     cpu="PPC603")
406: open("/tmp/ppc_rldicl_32.txt", "w").write(b32T)
407: row("bits32 live", hex(b32regs.get(9, -1)), hex(0x1234),
408:     "PPC603 (32-bit): the guest still runs -- li executes")
409: row("bits32 rld bad", "TODO" if "TODO: rld" in b32T else "no-msg", "TODO",
410:     "decoder prints `TODO: rld* in 32-bit mode?' and goes to bad -- unreachable")
411: 
412: # ===================================================== VACUITY (question 3) ===
413: # A cell where the ARCHITECTURAL answer is itself zero: a detector row placed
414: # here could never fail, whatever the handler does.
415: RS_VAC = 0xFFFFFFFF00000000
416: vregs, _, vT, vhow = session(seed([(SRC, RS_VAC)] + [(r, SENT) for r in DESTS]),
417:                              [RLDICL(4, SRC, 0, 32), RLDICL(5, SRC, 0, 0)])
418: row("vacuous cell", hex(vregs.get(4, -1)), hex(want_rldicl(RS_VAC, 0, 32)),
419:     "rS=0xffffffff00000000, SH=0, MB=32: correct answer IS 0 -- GREEN on a")
420: row("vac neighbour", hex(vregs.get(5, -1)), hex(want_rldicl(RS_VAC, 0, 0)),
421:     "  broken build.  Its MB=0 neighbour on the same rS is not vacuous.")
422: 
423: # ============================================================ THE (SH,MB) CENSUS
424: # rS = all-ones, so ROTL64(rS,SH) = all-ones for every SH and the architectural
425: # answer is exactly MASK(MB,63), which is NONZERO for every MB in 0..63.  Every
426: # cell of this census is therefore provably non-vacuous by construction.
427: combos = []
428: for mb in range(64):
429:     combos.append((0, mb))                      # MB sweep at SH=0
430: for sh in range(1, 64):
431:     combos.append((sh, 0))                      # SH sweep at MB=0
432: for k in range(1, 64):
433:     combos.append((k, k))                       # the diagonal
434: seen = set()
435: uniq = []
436: for c in combos:
437:     if c not in seen:
438:         seen.add(c)
439:         uniq.append(c)
440: 
441: census_fail = 0
442: census_zero = 0
443: census_run = 0
444: for base in range(0, len(uniq), len(DESTS)):
445:     chunk = uniq[base:base + len(DESTS)]
446:     insns = [RLDICL(DESTS[i], SRC, sh, mb) for i, (sh, mb) in enumerate(chunk)]
447:     st = seed([(SRC, RS_ONES)] + [(r, SENT) for r in DESTS])
448:     cregs, cdis, cT, chow = session(st, insns)
449:     if chow != "exit0":
450:         print("CENSUS SESSION ABORTED how=%s at base=%d" % (chow, base))
451:         break
452:     # disassembler cross-check on every census word too
453:     for i, (sh, mb) in enumerate(chunk):
454:         disasm_checked += 1
455:         if i < len(cdis) and cdis[i][1] == "rldicl" and \
456:            cdis[i][2] == "r%d,r%d,%d,%d" % (DESTS[i], SRC, sh, mb):
457:             disasm_ok += 1
458:     for i, (sh, mb) in enumerate(chunk):
459:         census_run += 1
460:         got = cregs.get(DESTS[i], None)
461:         exp = want_rldicl(RS_ONES, sh, mb)
462:         if got != exp:
463:             census_fail += 1
464:         if got == 0:
465:             census_zero += 1
466: 
467: row("census run", census_run, len(uniq),
468:     "(SH,MB) cells driven: MB sweep + SH sweep + diagonal, rS=all-ones")
469: row("census wrong", census_fail, 0,
470:     "cells whose result differs from MASK(MB,63) -- want 0 after a fix")
471: row("census zero", census_zero, 0,
472:     "cells that returned EXACTLY ZERO -- want 0 after a fix")
473: row("disasm total", "%d/%d" % (disasm_ok, disasm_checked),
474:     "%d/%d" % (disasm_checked, disasm_checked),
475:     "every placed word re-read by the tree's own disassembler")
476: 
477: # ================================ WHY THE SIBLING ROWS ARE NOT HERE =============
478: #
479: #  The witness this file is derived from is a FAMILY instrument: it also rows
480: #  X(rldimi) and X(rlwimi), which carry their OWN measured defects (ppcrldimimask,
481: #  ppcrlwimiwidth) that #522 does not touch and must not touch.  Shipping those rows
482: #  in a DETECTOR would make it PERMANENTLY RED until two unrelated rounds land --
483: #  a detector that cannot be green is a different fault from the one it was written
484: #  to catch, and a gate row over it would have to be ignored, which is how a gate
485: #  stops being read at all.
486: #
487: #  So this detector is scoped to X(rldicl).  The three sibling rows stay in the
488: #  witness at regress/artifacts/ppcrldiclzero/, which is the EVIDENCE for those two
489: #  filed rows and is correctly red there.  When either is fixed, its rows move here
490: #  or into a detector of its own -- that is a decision for those rounds, not this one.
491: #
492: #  MEASURED: witness 19/27 committed and 24/27 fixed, the five flipped rows being
493: #  exactly the ones kept below.  **THIS FILE HAS 19 ROWS, NOT 24** -- an earlier draft
494: #  of this note carried the witness's own post-fix count straight across, which a
495: #  pass-2 seat caught.  It is 19/19 on the fix and 14/19 pre-fix
496: #  (killtable_20260910/SCORES.txt).
497: 
498: # ================== ROWS ADDED BY PASS 2, WHICH FOUND TWO TOTAL ESCAPES =========
499: #
500: #  The 19-row instrument scored 19/19 against BOTH of these mutants -- total escapes,
501: #  MEASURED by the pass-2 measuring seat, not predicted:
502: #
503: #    M_SH5   drop the `sh5' bit from the SH decode.  Every rldicl with SH >= 32 then
504: #            rotates by SH-32.  *** THE INSTRUMENT WAS BLIND BY CONSTRUCTION: the
505: #            census uses an ALL-ONES source, and ROTL64(all-ones, n) is all-ones for
506: #            every n, so all 126 SH-varying cells compute the same value whatever the
507: #            rotate amount.  The only rotate-sensitive rows were zx32 (SH=0) and rot8
508: #            (SH=8) -- BOTH BELOW 32, so the sh5 bit was never load-bearing anywhere. ***
509: #            And it matters: the manual's simplified mnemonics make `srdi rA,rS,n' EQUAL
510: #            to `rldicl rA,rS,64-n,n', so EVERY logical right shift by 1..32 has SH >= 32.
511: #            Measured: under M_SH5 `clrldi' stays CORRECT while `srdi r5,r3,1' is wrong.
512: #            The one form the old instrument pinned is the one the mutant gets right.
513: #
514: #    M_CR0   feed update_cr0 the UNMASKED rotated value.  *** THIS IS NOT AN INVENTED
515: #            MUTANT: it is the token X(rldicr) ships, CORRECTLY, ten lines below -- there
516: #            `tmp' IS the destination.  A future editor harmonising the two handlers
517: #            writes exactly this. ***  The old instrument could not see it because it
518: #            emitted rc=0 on every encoding, leaving the whole record-form path unrun.
519: #
520: #  CR0 is a THREE-valued channel here and each candidate lands in a different value:
521: #    the fix -> GT (0x40000000) | the defect -> EQ (0x20000000) | M_CR0 -> LT (0x80000000)
522: #  so one row separates all three states.  These rows also redden under M_ORIG, so they
523: #  satisfy floor (a)/(b) as well as killing the (d)-shaped mutant.
524: #
525: #  In their OWN session, so the control session's disasm cross-check lists are untouched.
526: xregs, _, xT, xhow = session(
527:     seed([(SRC, RS_VAL)] + [(r, SENT) for r in DESTS]),
528:     [RLDICL(8, SRC, 63, 0),            # rotldi r8,r3,63 -- SH=63 NEEDS the sh5 bit
529:      RLDICL(11, SRC, 32, 32),          # high-word extract -- SH=32 NEEDS the sh5 bit
530:      enc_md(0, SRC, 10, 0, 32, rc=1)]) # rldicl. r10,r3,0,32 -- THE RECORD FORM
531: _cr = re.findall(r"cr[ \t]+= (0x[0-9a-fA-F]+)", xT)
532: _crv = int(_cr[-1], 16) if _cr else -1
533: row("cand session", xhow, "exit0", "the candidate-row session ran to `quit'")
534: row("cr parsed", "yes" if _cr else "no", "yes",
535:     "NEGATIVE CONTROL on the apparatus: the cr regex must MATCH something")
536: row("sh63 rldicl", hex(xregs.get(8, -1)), hex(want_rldicl(RS_VAL, 63, 0)),
537:     "SH=63: pins the sh5 bit of the SH decode")
538: row("sh32 rldicl", hex(xregs.get(11, -1)), hex(want_rldicl(RS_VAL, 32, 32)),
539:     "SH=32,MB=32 high-word extract: pins the sh5 bit again, on a masked cell")
540: row("rc cr0", hex(_crv), hex(0x40000000),
541:     "rldicl. -> CR0=GT.  defect gives EQ(0x2...), update_cr0(cpu,tmp) gives LT(0x8...)")
542: 
543: # ================================ WHY THE SIBLING ROWS ARE NOT HERE =============
544: #
545: #  The witness this file is derived from is a FAMILY instrument: it also rows
546: #  X(rldimi) and X(rlwimi), which carry their OWN measured defects (ppcrldimimask,
547: #  ppcrlwimiwidth) that #522 does not touch and must not touch.  Shipping those rows
548: #  in a DETECTOR would make it PERMANENTLY RED until two unrelated rounds land --
549: #  a detector that cannot be green is a different fault from the one it was written
550: #  to catch, and a gate row over it would have to be ignored, which is how a gate
551: #  stops being read at all.
552: #
553: #  So this detector is scoped to X(rldicl).  The three sibling rows stay in the
554: #  witness at regress/artifacts/ppcrldiclzero/, which is the EVIDENCE for those two
555: #  filed rows and is correctly red there.  When either is fixed, its rows move here
556: #  or into a detector of its own -- that is a decision for those rounds, not this one.
557: #
558: #  MEASURED: witness 19/27 committed and 24/27 fixed, the five flipped rows being
559: #  exactly the ones kept below.  **THIS FILE HAS 19 ROWS, NOT 24** -- an earlier draft
560: #  of this note carried the witness's own post-fix count straight across, which a
561: #  pass-2 seat caught.  It is 19/19 on the fix and 14/19 pre-fix
562: #  (killtable_20260910/SCORES.txt).
563: 
564: #  =============================== CONTRACT (clause (e)) =========================
565: #
566: #  WHAT THIS DETECTOR IS DESIGNED TO CATCH, and what it is NOT.  The boundary below
567: #  is MEASURED -- every entry was established by a mutant that was built and scored,
568: #  not by reasoning about the row set.
569: #
570: #  CAUGHT:  the mask variable; the mask bit positions; the mask end bound; `&' -> `|';
571: #           the mask ignored entirely; the `mb'-field decode INCLUDING its high bit;
572: #           rotate-versus-shift (the census sees SHL(all-ones,n) != all-ones); the
573: #           rotate AMOUNT at SH=0, 8, 32 and 63; the destination width; the `ra'-field
574: #           decode for ra >= 16; and the record form's CR0 result.
575: #
576: #  NOT CAUGHT, disclosed rather than left to be discovered:
577: #    * `rs'-field edits that are the identity on r3.  EVERY rldicl this file executes
578: #      reads rS = r3, so `(iw >> 21) & 31' -> `& 15' escapes.  Low plausibility, named
579: #      because it is a real property of the design rather than an oversight.
580: #    * edits conditioned on `ra == 0'.
581: #    * rotate-amount edits that are the identity at ALL FOUR rowed SH values.
582: #
583: #  *** AND THE 190-CELL CENSUS IS NARROWER THAN ITS HEADLINE NUMBER SUGGESTS. ***  It
584: #  drives an ALL-ONES source deliberately, so that every mask window is non-empty and
585: #  "190 of 190" means something.  The same choice makes ROTL64 the IDENTITY, so the
586: #  census is a function of MB ALONE: the 63 cells of its SH sweep are 63 copies of the
587: #  same mask case.  **The census pins MASK(MB,63).  It does not pin the rotate.**  The
588: #  rotate is pinned by the value rows -- zx32, rot8, sh32 and sh63 -- and a genuine
589: #  two-axis census would need a second source value.  This was found by a pass-2 seat
590: #  after the round's own PRETABLE claimed the census "walks the cross-product"; it does
591: #  not, and the corrected sentence is the one that belongs in a contract.
592: 
593: # ================================================================ SCORE + DONE
594: npass = sum(1 for _, ok in rows if ok)
595: print("")
596: print("SCORE %d/%d  elapsed=%.1fs  binary=%s  label=%s"
597:       % (npass, len(rows), time.time() - t0, BIN, LABEL))
598: print("FAILING: " + ", ".join(n for n, ok in rows if not ok))
599: print("PPC_RLDICL_PROBE_DONE")

