116: 
117: # ----------------------------------------------------------------- architecture
118: def rotl64(x, n):
119:     n &= 63
120:     return ((x << n) | (x >> (64 - n))) & M64 if n else x & M64
121: 
122: 
123: def mask_b_63(b):
124:     """MASK(b,63), big-endian bit numbering = the low (64-b) bits."""
125:     assert 0 <= b <= 63
126:     return (1 << (64 - b)) - 1
127: 
128: 
129: def mask_0_e(e):
130:     """MASK(0,e), big-endian = the high (e+1) bits."""
131:     assert 0 <= e <= 63
132:     return (((1 << (e + 1)) - 1) << (63 - e)) & M64
133: 
134: 
135: def mask_range(b, e):
136:     """MASK(b,e) -- the architecture's own mask generator, INCLUSIVE and WRAPPING.
137: 
138:        PowerPC Book I v2.01, _scratchpad/ppc_uisa_book1_v201.txt:
139:          :578     "Mask having 1s in positions x through y (WRAPPING IF x > y)"
140:          :4015    "The mask is 64 bits long"
141:          :4022-29  if mstart <= mstop: mask[mstart..mstop] = ones
142:                    else:               mask[mstart..63] = ones ; mask[0..mstop] = ones
143:          :4031    "There is no way to specify an all-zero mask."   <-- the assert below
144: 
145:        *** THE WRAPPING BRANCH IS A UNION.  An INTERSECTION is EMPTY whenever b > e,
146:        which is exactly the all-zero mask :4031 says cannot exist -- and that was this
147:        file's want_rldimi for 2016 of 4096 (MB, SH) pairs.  See
148:        regress/artifacts/ppcwitnessmaskoracle/ENUMERATION_20260911.txt. ***"""
149:     assert 0 <= b <= 63 and 0 <= e <= 63
150:     m = (mask_b_63(b) & mask_0_e(e)) if b <= e else (mask_b_63(b) | mask_0_e(e))
151:     assert m != 0, "MASK(%d,%d) came out all-zero, which the architecture forbids" % (b, e)
152:     return m
153: 
154: 
155: def want_rldicl(rs_val, sh, mb):
156:     return rotl64(rs_val, sh) & mask_b_63(mb)
157: 
158: 
159: def want_rldicr(rs_val, sh, me):
160:     return rotl64(rs_val, sh) & mask_0_e(me)
161: 
162: 
163: def want_rldimi(rs_val, ra_val, sh, mb):
164:     """Book I :4319 -- m <- MASK(b, not n), i.e. MASK(MB, 63-SH): INCLUSIVE and WRAPPING.
165: 
166:        *** CORRECTED 2026-09-11.  This computed `mask_b_63(mb) & mask_0_e(63-sh)' -- the
167:        INTERSECTION -- which is EMPTY for every wrapping encoding: 2016 of 4096 (MB, SH)
168:        pairs, 49.2% of the space, produced the all-zero mask Book I :4031 forbids.  The
169:        oracle then returned the untouched destination and would have AGREED with any
170:        implementation that also omitted the wrap. ***
171: 
172:        The prose at :4323-4324 ("1 bits from bit MB through bit 63-SH") describes the
173:        NON-WRAPPING reading, and quoting it beside the formula is how the error got in;
174:        :4022-4029 is the definition that governs.  The PEM citation the old docstring
175:        carried (:29908) is superseded: PEM :302 names Book I as the defining manual."""
176:     m = mask_range(mb, (63 - sh) & 63)
177:     return (rotl64(rs_val, sh) & m) | (ra_val & (~m & M64))
178: 
179: 
180: def rotl32(x, n):
181:     """ROTL[32] per manual :6878 -- two copies of rS[32-63], then rotate."""
182:     lo = x & 0xFFFFFFFF
183:     n &= 31
184:     r32 = ((lo << n) | (lo >> (32 - n))) & 0xFFFFFFFF if n else lo
185:     return (r32 << 32) | r32
186: 
187: 
188: def mask32(mb, me):
189:     """MASK(MB+32, ME+32) at SIXTY-FOUR bits -- NOT confined to the low word.
190: 
191:        *** CORRECTED 2026-09-11.  This was a low-32-confined loop, so want_rlwinm ANDed
192:        away the duplication rotl32 correctly produces, and want_rlwimi preserved ALL of
193:        RA's high half.  Measured against the SHIPPED X(rlwinm), the old helper agreed on
194:        131072 of 131072 cells -- not "usually green" but INCAPABLE of red, against a
195:        defect this project has filed as ppcrlwhighhalf. ***
196: 
197:        Book I gives rlwinm at :4126-4128 and rlwimi at :4316-4318 with the IDENTICAL mask
198:        term, and ROTL32 (:501-504) produces the low word DUPLICATED into both halves.
199:        MB, ME are 5-bit, so mstart/mstop lie in 32..63; when MB > ME the mask covers
200:        MB+32..63 AND 0..ME+32, and that second range contains every position 0..31 -- the
201:        whole high half -- so the rotated word lands there.
202: 
203:        *** :4033-4035 IS NOT A COUNTER-TEXT, THOUGH IT READS LIKE ONE. ***  It says the
204:        mask "start and stop POSITIONS are always in the low-order 32 bits" -- true, they
205:        are 32..63 -- and says nothing about where the 1-bits reach.  :4015 says the mask
206:        is 64 bits long and :4026-4028 gives the wrap explicitly.
207: 
208:        BOOK I'S CLEARING SENTENCES ARE SCOPED; THE PEM'S IS UNCONDITIONAL.  Book I has
209:        TWO, at :4195-4196 (rlwinm) and :4291-4292 (rlwnm), each inside a Programming Note
210:        and each qualified "for all the uses given above" -- and every enumerated use fixes
211:        a NON-WRAPPING (MB, ME).  The 2005 PEM carries the qualified form at :30074 AND an
212:        unconditional one at :30065; it is the unconditional claim that Book I lacks.
213:        **Book I states no clearing for rlwimi at all** -- its entry (:4304-4358) is RTL only.
214: 
215:        ONE SHARED HELPER FEEDS BOTH want_rlwinm AND want_rlwimi, DELIBERATELY: the manual
216:        gives them the same mask term, and a per-instruction split is how an oracle gets
217:        fitted to one implementation.  Enumeration: 528 non-wrapping pairs IDENTICAL under
218:        old and new, 496 wrapping pairs differing in exactly the high 32 bits.  See
219:        regress/artifacts/ppcwitnessmaskoracle/ENUMERATION_20260911.txt."""
220:     assert 0 <= mb <= 31 and 0 <= me <= 31
221:     return mask_range(mb + 32, me + 32)
222: 
223: 
224: def want_rlwinm(rs_val, sh, mb, me):
225:     return rotl32(rs_val, sh) & mask32(mb, me)
226: 
227: 
228: def want_rlwimi(rs_val, ra_val, sh, mb, me):
229:     m = mask32(mb, me)
230:     return (rotl32(rs_val, sh) & m) | (ra_val & (~m & M64))
231: 
232: 
233: # -------------------------------------------------------------------- encodings
234: def enc_md(xo, rs, ra, sh, mbe, rc=0):
235:     """opcode 30 (rldicl/rldicr/rldimi).  Field placement derived from the manual's
236:        own instruction-format diagram at :29706-29734:
237:          0-5 opcode | 6-10 S | 11-15 A | 16-20 sh[0-4] | 21-26 mb[5]||mb[0-4]
238:          | 27-29 XO | 30 sh[5] | 31 Rc      (all big-endian bit numbers)"""
239:     assert 0 <= sh <= 63 and 0 <= mbe <= 63 and 0 <= xo <= 7
240:     return ((30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11)
241:             | ((mbe & 31) << 6) | (((mbe >> 5) & 1) << 5) | (xo << 2)
242:             | (((sh >> 5) & 1) << 1) | rc) & 0xFFFFFFFF
243: 
244: 
245: def RLDICL(ra, rs, sh, mb):
246:     return enc_md(0, rs, ra, sh, mb)
247: 
248: 
249: def RLDICR(ra, rs, sh, me):
250:     return enc_md(1, rs, ra, sh, me)
251: 
252: 
253: def RLDIMI(ra, rs, sh, mb):
254:     return enc_md(3, rs, ra, sh, mb)
255: 
256: 
257: def enc_m(op, rs, ra, sh, mb, me, rc=0):
258:     """opcode 20/21 (rlwimi/rlwinm): 0-5 op | 6-10 S | 11-15 A | 16-20 SH
259:        | 21-25 MB | 26-30 ME | 31 Rc."""
260:     return ((op << 26) | (rs << 21) | (ra << 16) | (sh << 11) | (mb << 6)
261:             | (me << 1) | rc) & 0xFFFFFFFF
262: 
263: 
264: def RLWINM(ra, rs, sh, mb, me):
265:     return enc_m(21, rs, ra, sh, mb, me)
266: 
267: 
268: def RLWIMI(ra, rs, sh, mb, me):
269:     return enc_m(20, rs, ra, sh, mb, me)
270: 
271: 
272: def LI(rd, simm):
273:     return ((14 << 26) | (rd << 21) | (0 << 16) | (simm & 0xFFFF)) & 0xFFFFFFFF
274: 
275: 
276: def ORI(ra, rs, imm):
277:     return ((24 << 26) | (rs << 21) | (ra << 16) | (imm & 0xFFFF)) & 0xFFFFFFFF
278: 
279: 
280: NOP = ORI(0, 0, 0)               # ori r0,r0,0 -- writes r0 only
281: 
282: 
283: # ---------------------------------------------------------------------- sessions
284: def session(setup, insns, timeout=90, machine="bareppc", cpu=None):
285:     """Place `insns' at CODE, seed registers, step exactly len(insns), dump regs.
286:        Returns (regs dict, disasm list, transcript, how)."""
287:     cmds = list(setup)
288:     for i, w in enumerate(insns):
289:         cmds.append("put w 0x%x, 0x%08x" % (CODE + 4 * i, w))
290:     if insns:
291:         cmds.append("unassemble 0x%x 0x%x" % (CODE, CODE + 4 * len(insns)))
292:     cmds.append("pc=0x%x" % CODE)
293:     if insns:
294:         cmds.append("step %d" % len(insns))
295:     cmds.append("reg")
296:     argv = [BIN, "-V", "-x", "-E", machine, "-M", "64"]
297:     if cpu:
298:         argv += ["-C", cpu]
299:     argv += ["0x%x:%s" % (CODE, DUMMY)]
300:     inp = ("\n".join(cmds + ["quit"]) + "\n").encode("latin-1")
301:     try:
302:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE,
303:                            stderr=subprocess.STDOUT, timeout=timeout)
304:     except subprocess.TimeoutExpired as e:
305:         out = (e.output or b"").decode("latin-1", "replace").replace("\r", "")
306:         return {}, [], out, "TIMEOUT"
307:     t = p.stdout.decode("latin-1", "replace").replace("\r", "")
308:     rc = p.returncode
309:     how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
310:     # the LAST `reg' dump in the transcript
311:     idx = t.rfind("GXemul> reg")
312:     regs = {}
313:     if idx >= 0:
314:         for m in re.finditer(r"\br(\d\d) = (0x[0-9a-fA-F]+)", t[idx:]):
315:             regs[int(m.group(1))] = int(m.group(2), 16)
316:     dis = []
317:     di = t.find("GXemul> unassemble")
318:     if di >= 0:
319:         seg = t[di:t.find("GXemul> pc=", di) if t.find("GXemul> pc=", di) > 0
320:                 else len(t)]
321:         for m in re.finditer(r"^[0-9a-f]{16}: ([0-9a-f]{8})\s*(?:<- )?(\S+)"
322:                              r"(?:\t(\S+))?", seg, re.M):
323:             dis.append((int(m.group(1), 16), m.group(2), m.group(3) or ""))
324:     return regs, dis, t, how
325: 
326: 
327: def seed(pairs):
328:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
329: 
330: 
331: print("ppcrldiclzero RUNG-3 WITNESS -- binary=%s label=%s" % (BIN, LABEL))
332: print("machine: -E bareppc -M 64 (UNMODIFIED in-tree; MACHINE_DEFAULT_CPU=PPC970,"
333:       " 64-bit)")
334: print("wants derived from _scratchpad/ppc_pem_32and64_2005.txt:29736 (rldiclx),"
335:       " :6878 (ROTL32)")
336: print("%-18s %-20s %-20s %-48s %s" % ("row", "got", "want", "note", ""))
337: t0 = time.time()
338: disasm_checked = 0
339: disasm_ok = 0
340: 
341: # ============================================================ CONTROL SESSION ==
342: ctl_insns = [
343:     LI(9, 0x1234),                       # liveness
344:     NOP,                                 # seed-holds probe steps over this
345:     RLDICL(4, SRC, 0, 32),               # clrldi r4,r3,32 -- the canonical case
346:     RLDICR(5, SRC, 0, 31),               # DISCRIMINATING control: correct sibling
347:     RLDICL(6, SRC, 8, 0),                # pure rotate, mask = all ones
348:     RLDICR(7, SRC, 8, 63),               # same rotate through the good sibling
349: ]
350: ctl_setup = seed([(SRC, RS_VAL), (30, SENT)] + [(r, SENT) for r in DESTS])
351: regs, dis, T, how = session(ctl_setup, ctl_insns)
352: 
353: open("/tmp/ppc_rldicl_ctl.txt", "w").write(T)
354: 
355: row("session", how, "exit0", "the control session ran to `quit'")
356: row("live", hex(regs.get(9, -1)), hex(0x1234),
357:     "li r9,0x1234 -- the guest executes and readback works")
358: row("seed holds", hex(regs.get(30, -1)), hex(SENT),
359:     "r30 seeded, never a destination: a 0 readback means SOMETHING wrote it")
360: row("src intact", hex(regs.get(SRC, -1)), hex(RS_VAL),
361:     "rS is unchanged by any of these instructions")
