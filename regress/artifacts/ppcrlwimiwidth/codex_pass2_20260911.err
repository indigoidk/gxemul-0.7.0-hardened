2815: 	uint64_t tmp;
2816: 
2817: 	reg_access_msr(cpu, &tmp, 0, 0);
2818: 	tmp &= ~0xffff;
2819: 	tmp |= (cpu->cd.ppc.spr[SPR_SRR1] & 0xffff);
