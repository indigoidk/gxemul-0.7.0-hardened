 1916: #  ------------------------------------------------------------ m88kbuserrregs (#570)
 1917: #  A REFUSED m88k device access -- a device CLAIMS it and returns 0 with the cpu still running -- now records its
 1918: #  bus error in the faulting side's CMMU (memory_rw.c's refused-device arm: PFSR = BERROR << 16, PFAR = the physical
 1919: #  address), and luna-88k's 0x3ffffff0 probe case is refused through that arm instead of being served 0.  The
 1920: #  rung-3 witness (regress/artifacts/m88kbuserrregs/witness_20261023/, 16/24 on HEAD) is NOT run here; this is its
 1921: #  detector: 31 rows, the witness's 24 plus the instruction label (ifetch x4), a NO_EXCEPTIONS caller (dbg noexc)
 1922: #  and a CMMU-less cpu (null surv, null route; mvme187 -n 2).  Needs only the binary: mvme187 -M 64 [-n 2] and
 1923: #  luna-88k, each with a 4-byte dummy image at 0x10000 -- no PROM, no rig image.  Kill table:
 1924: #  regress/artifacts/m88kbuserrregs/table1_20261023/ (SCORES.txt).  Like #568's block above, it runs only if none
 1925: #  of this gate's eleven earlier skip points fired (the probe header names them).
 1926: M88KBELOG=$LOGDIR/m88k_buserr.log
 1927: python3 -u m88k_buserr_probe.py "$PMAX" gate > "$M88KBELOG" 2>&1 || true
 1928: if ! grep -q "M88K_BUSERR_PROBE_DONE" "$M88KBELOG"; then
 1929:     check "m88k buserr probe completed" "no" "yes"
 1930: else
 1931:     check "m88k buserr probe completed" "yes" "yes"
 1932:     check "m88k buserr sentinel once" "$(grep -c '^M88K_BUSERR_PROBE_DONE$' "$M88KBELOG")" "1"
 1933:     mbres=$(sed -n 's/^M88K_BUSERR_RESULT=//p' "$M88KBELOG")
 1934:     check "m88k_buserr rows run"     "${mbres#*/}" 31
 1935:     check "m88k_buserr rows correct" "${mbres%/*}" "31"
 1936:     check "m88k buserr controls" "$(grep -c '^M88K_BUSERR_CONTROL=OK$' "$M88KBELOG")" "1"
 1937:     check "m88k buserr symptom absent" "$(grep -c '^M88K_BUSERR_SYMPTOM=ABSENT$' "$M88KBELOG")" "1"
 1938:     for v in "neg apparatus" "mv devsig" "mv cmmu rt" "ok route" "ok regs" "uld route" "uld pfsr" "uld pfar" "uld icmmu" "ust route" "ust pfsr" "ust pfar" "ust icmmu" "vme route" "vme pfsr" "vme pfar" "vme icmmu" "luna devsig" "luna cmmu rt" "luna route" "luna pfsr" "luna pfar" "luna icmmu" "ifetch route" "ifetch pfsr" "ifetch pfar" "ifetch dcmmu" "dbg noexc" "null surv" "null route" "unasm"; do
 1939:         check "m88k buserr row: $v" "$(count "$M88KBELOG" "^$v  .*ok$")" "1"
 1940:     done
