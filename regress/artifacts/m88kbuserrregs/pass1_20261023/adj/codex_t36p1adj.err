314: def seeds(pairs):
315:     return ["r%d=0x%x" % (r, v) for r, v in pairs]
316: 
317: 
318: def place(blocks):
319:     """blocks: [(addr, [Ins])] -> (debugger commands, [(addr, Ins)]).  Every block is re-read with
320:        `unassemble' (end-exclusive) right after it is written."""
321:     cmds, placed = [], []
322:     for at, insns in blocks:
323:         for i, ins in enumerate(insns):
324:             a = at + 4 * i
325:             if ins.ops is None:
326:                 ins = Ins(ins.word, ins.mnem, "0x%08x" % a)
327:             cmds.append("put w 0x%x, 0x%08x" % (a, ins.word))
328:             placed.append((a, ins))
329:         cmds.append("unassemble 0x%x 0x%x" % (at, at + 4 * len(insns)))
330:     return cmds, placed
