80: PMAX=${PMAX:-$ROOT/build/gxemul}
81: LOG=$LOGDIR/gate_arm.log
82: STUB=$LOGDIR/arm_stub.bin
83: 
84: need_exec "$PMAX"
85: command -v python3 >/dev/null || gate_skip "python3 not available"
86: 
87: # `testarm` prints usage and exits without a file argument, so a four-byte raw
88: # stub is loaded purely to make the machine construct. Every row overwrites it
89: # before anything executes; it is scaffolding, not code under test.
90: python3 -c "
91: import struct, sys
92: open(sys.argv[1], 'wb').write(struct.pack('<I', 0xe1a00000))
93: " "$STUB" || gate_skip "could not write the load stub"
94: 
95: note "binary : $PMAX"
96: note "machine: testarm/SA1110, cold debugger, RAM at 0"
97: note "little-endian; every word read is byte-swapped back by the probe"
98: note "flags read by the guest's own mrs r3,cpsr -- not a debugger register print"
99: 
100: python3 arm_flags_probe.py "$PMAX" "$STUB" > "$LOG" 2>&1 || true
101: 
102: if ! grep -q "ARM_FLAGS_RESULT=" "$LOG"; then
103:     note "probe produced no result line; last lines follow"
104:     tail -5 "$LOG" | sed 's/^/       /'
105:     gate_skip "probe did not complete"
106: fi
