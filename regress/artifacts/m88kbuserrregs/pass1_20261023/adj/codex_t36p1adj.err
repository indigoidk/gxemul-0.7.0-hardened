360: 
361: def analyse(text, how, placed):
362:     """Split the transcript at the prompts; parse every unassemble, the last `reg' and the last `reg 0,0'."""
363:     r = Res()
364:     r.how, r.text, r.placed = how, text, placed
365:     r.dis, r.regs, r.pc, r.cr = {}, None, None, None
366:     for part in text.split(PROMPT)[1:]:
367:         cmd, _, out = part.partition("\n")
368:         cmd = cmd.strip()
369:         if cmd.startswith("unassemble"):
370:             for m in DIS_RE.finditer(out):
371:                 r.dis[int(m.group(1), 16)] = (int(m.group(2), 16), m.group(3), m.group(4) or "")
372:         elif cmd == "reg":
373:             m = PC_RE.search(out)
374:             if m:
375:                 r.regs = {int(g.group(1)): int(g.group(2), 16) for g in GPR_RE.finditer(out)}
376:                 r.pc = int(m.group(1), 16)
377:         elif cmd == "reg 0,0":
378:             cr = {g.group(1): int(g.group(2), 16) for g in CR_RE.finditer(out)}
379:             if cr:
380:                 r.cr = cr
381:     return r
