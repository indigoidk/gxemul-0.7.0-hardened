333: def run_piped(machine, cmds, tag, timeout=90):
334:     argv, cwd = argv_for(machine)
335:     inp = ("\n".join(list(cmds) + ["quit"]) + "\n").encode("latin-1")
336:     try:
337:         p = subprocess.run(argv, input=inp, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout,
338:                            cwd=cwd)
339:         text = p.stdout.decode("latin-1", "replace").replace("\r", "")
340:         rc = p.returncode
341:         how = ("sig%d" % -rc) if rc < 0 else ("exit%d" % rc)
342:     except subprocess.TimeoutExpired as e:
343:         text, how = (e.output or b"").decode("latin-1", "replace").replace("\r", ""), "TIMEOUT"
344:     if DUMP:
345:         with open(os.path.join(DUMP, "%s.txt" % tag), "w") as f:
346:             f.write("# argv: %s\n# cwd: %s\n# how: %s\n" % (" ".join(argv), cwd, how))
347:             f.write(text)
348:     return text, how
