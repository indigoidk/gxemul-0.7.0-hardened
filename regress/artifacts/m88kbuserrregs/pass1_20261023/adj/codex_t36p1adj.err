301: def argv_for(machine):
302:     if machine == "mvme187":
303:         return [BIN, "-V", "-x", "-E", "mvme88k", "-e", "mvme187", "-M", "64", "0x%x:%s" % (CODE, DUMMY)], None
304:     if machine == "187":            # the apparatus negative control: no such subtype
305:         return [BIN, "-V", "-x", "-E", "mvme88k", "-e", "187", "-M", "64", "0x%x:%s" % (CODE, DUMMY)], None
306:     if machine == "luna-88k":
307:         if IMAGES:
308:             return ([BIN, "-V", "-x", "-e", "luna-88k", "-d", "R:" + os.path.join(IMAGES, RIG_IMG), "boot"],
309:                     IMAGES)
