73: 
74: /*
75:  *  #433: the shared complain-once helper for an access the model does not implement.
76:  *
77:  *  Every site that used to call exit(1) calls this instead.  Terminating the HOST process is
78:  *  not a behaviour the emulated machine can have, and MEASURED, 1007 of 1024 word offsets in
79:  *  this device's window did exactly that on a plain READ -- reachable by one supervisor-mode
80:  *  instruction on luna88k, which boots in this tree.
81:  *
82:  *  Why complain-and-continue rather than cpu->running = 0: the tree already assigns those two
83:  *  shapes to two MEANINGS, and #220 is the precedent for both -- dev_footbridge.c:348 halts
84:  *  because THE GUEST ASKED THE MACHINE TO HALT, while :379 complains and continues for an
85:  *  out-of-range PCI bus, which is a model gap.  Every site here is the second kind.  A guest
86:  *  probing an unimplemented register should not forfeit its session.
87:  */
88: static void m8820x_unimplemented(struct m8820x_data *d, const char *what)
89: {
90: 	if (!d->reported_offset) {
91: 		d->reported_offset = 1;
92: 		fatal("[ m8820x: cpu%i cmmu%i: unimplemented %s; ignored "
93: 		    "(reported once) ]\n", d->cpu_nr, d->cmmu_nr, what);
94: 	} else {
95: 		debug("[ m8820x: cpu%i cmmu%i: unimplemented %s; ignored ]\n",
96: 		    d->cpu_nr, d->cmmu_nr, what);
97: 	}
98: }
99: 
100: 
101: /*
102:  *  m8820x_command():
103:  *
104:  *  Handle M8820x commands written to the System Command Register.
105:  */
106: static void m8820x_command(struct cpu *cpu, struct m8820x_data *d)
107: {
108: 	uint32_t *regs = cpu->cd.m88k.cmmu[d->cmmu_nr]->reg;
109: 	int cmd = regs[CMMU_SCR];
110: 	uint32_t sar = regs[CMMU_SAR];
111: 	size_t i;
112: 	uint32_t super, all;
113: 
114: 	switch (cmd) {
115: 
116: 	case CMMU_FLUSH_CACHE_CB_LINE:
117: 	case CMMU_FLUSH_CACHE_CB_PAGE:
118: 	case CMMU_FLUSH_CACHE_CB_SEGMENT:	/*  #433  */
119: 	case CMMU_FLUSH_CACHE_CB_ALL:		/*  #433  */
120: 	case CMMU_FLUSH_CACHE_INV_LINE:
121: 	case CMMU_FLUSH_CACHE_INV_PAGE:
122: 	case CMMU_FLUSH_CACHE_INV_SEGMENT:	/*  #433  */
123: 	case CMMU_FLUSH_CACHE_INV_ALL:
124: 	case CMMU_FLUSH_CACHE_CBI_LINE:
125: 	case CMMU_FLUSH_CACHE_CBI_PAGE:
126: 	case CMMU_FLUSH_CACHE_CBI_SEGMENT:
127: 	case CMMU_FLUSH_CACHE_CBI_ALL:
128: 		/*  TODO: this model has no cache, so every cache command is a no-op.  #433
129: 		    added the three SEGMENT/ALL variants that were falling through to the
130: 		    default arm and killing the host; they are no-ops for exactly the same
131: 		    reason as the nine that were already here.  */
132: 		break;
133: 
134: 	case CMMU_FLUSH_USER_LINE:		/*  #433  */
135: 	case CMMU_FLUSH_USER_PAGE:
136: 	case CMMU_FLUSH_USER_SEGMENT:		/*  #433  */
137: 	case CMMU_FLUSH_USER_ALL:
138: 	case CMMU_FLUSH_SUPER_LINE:		/*  #433  */
139: 	case CMMU_FLUSH_SUPER_PAGE:
140: 	case CMMU_FLUSH_SUPER_SEGMENT:		/*  #433  */
141: 	case CMMU_FLUSH_SUPER_ALL:
142: 		/*
143: 		 *  #433: THE FOUR LINE/SEGMENT VARIANTS ARE FOLDED IN HERE, AND THAT FOLD IS
144: 		 *  WHY THE REST OF THIS ROUND IS SAFE TO MAKE AT ALL.
145: 		 *
146: 		 *  These are PATC (TLB) flushes.  Before this round an unimplemented
147: 		 *  0x30/0x32/0x34/0x36 died LOUDLY, so no silent path existed.  Converting the
148: 		 *  default arm to complain-and-drop -- which is the rest of this round -- would
149: 		 *  have turned FLUSH_SUPER_LINE into a SILENTLY IGNORED TLB FLUSH.  That is not
150: 		 *  a cosmetic gap: memory_m88k.c:190-234 is the translation fast path, and a
151: 		 *  valid matching PATC entry SHORT-CIRCUITS the table walk and returns the
152: 		 *  cached physical address, so a guest that edited a PTE and issued
153: 		 *  FLUSH_SUPER_LINE would keep translating through the torn-down mapping.
154: 		 *  The fix and the fold are ONE change: without the fold, the fix would
155: 		 *  introduce a defect worse than the crash it removes.  0x34 is also ONE BIT
156: 		 *  from 0x35, which a measured boot issues 158,664 times.
157: 		 *
158: 		 *  LINE takes PAGE's settings and SEGMENT takes ALL's.  A line lies within a
159: 		 *  page and the PATC is page-granular, so LINE is exactly PAGE here; SEGMENT
160: 		 *  over-invalidates, which is the SAFE DIRECTION in a model that re-walks the
226: 		 *  valid answer that could steer the guest's paging.  Real probe semantics need
227: 		 *  the translation walk and are FILED, not invented here.
228: 		 */
229: 		if (!d->reported_command) {
230: 			d->reported_command = 1;
231: 			fatal("[ m8820x: cpu%i cmmu%i: unimplemented command "
232: 			    "0x%02x; ignored (reported once) ]\n",
233: 			    d->cpu_nr, d->cmmu_nr, cmd);
234: 		} else {
235: 			debug("[ m8820x: cpu%i cmmu%i: unimplemented command "
236: 			    "0x%02x; ignored ]\n", d->cpu_nr, d->cmmu_nr, cmd);
237: 		}
238: 		break;
239: 	}
240: }
