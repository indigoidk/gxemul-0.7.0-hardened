387: def check_unasm(r, scored=True):
388:     ok = n = 0
389:     for a, ins in r.placed:
390:         n += 1
391:         d = r.dis.get(a)
392:         if d is not None and d == (ins.word, ins.mnem, ins.ops):
393:             ok += 1
394:         elif scored:
395:             UNASM["bad"].append("0x%x:%08x %s %s -> %r" % (a, ins.word, ins.mnem, ins.ops, d))
396:     if scored:
397:         UNASM["ok"] += ok
398:         UNASM["n"] += n
399:     return ok, n
