509: # ================================================================ generic arm: three refused accesses (mvme187)
510: def refused(tag, access, extra, addr, load, what):
511:     r = session(tag, "mvme187", MV_DCMMU, MV_ICMMU, access, extra)
512:     bad = prereq_bad(r)
513:     w_route = "v3/%s/%s" % (hx(SXIP_DATA), hx(addr & ~3))
514:     g_route = bad if bad else route(r, load)
515:     g_pfsr = bad if bad else hx(g(r, 13))
516:     g_pfar = bad if bad else hx(g(r, 14))
517:     row(tag + " route", g_route, w_route, "%s: vector 3, SXIP, DMA0 -- the exception is THIS access" % what)
518:     row(tag + " pfsr", g_pfsr, hx(BERROR), "data CMMU PFSR after the fault (seeded %s)" % hx(D_PFSR_SEED))
519:     row(tag + " pfar", g_pfar, hx(addr), "data CMMU PFAR after the fault (seeded %s)" % hx(D_PFAR_SEED))
520:     row(tag + " icmmu", bad if bad else kept_i(r), "kept", "instruction CMMU PFSR/PFAR keep their seeds")
521:     symptom(tag + " pfsr", g_pfsr, hx(BERROR), hx(D_PFSR_SEED))
522:     symptom(tag + " pfar", g_pfar, hx(addr), hx(D_PFAR_SEED))
523:     return r
