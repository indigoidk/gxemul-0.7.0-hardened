554: #  Measured so the round has the number; NOT a row.  Stepped, the debugger's own disassembly pre-read raises vector 2
555: #  (an artifact: free-running halts at `bad:' instead -- see NOT CLAIMED).  The extra transcript markers say which.
556: ri = session("info_ifetch", "mvme187", MV_DCMMU, MV_ICMMU, JMP(5), [(5, UNREAD)], scored=False)
557: cri = ri.cr or {}
558: print("INFO ifetch      jmp (r5) to 0xfff46010: how=%s path=%s SXIP=%s iPFSR=%s iPFAR=%s dPFSR=%s dPFAR=%s "
559:       "pre-read-msg=%d halt-msg=%d unasm=%d/%d"
560:       % (ri.how, path_of(ri) if ri.regs else "absent", hx(cri.get("SXIP")), hx(g(ri, 15)), hx(g(ri, 16)),
561:          hx(g(ri, 13)), hx(g(ri, 14)), ri.text.count("could not read the instruction"),
562:          ri.text.count("UNIMPLEMENTED instruction"), *check_unasm(ri, scored=False)))
563: #  An UNCLAIMED physical address never reaches the refused-access arm (the premise correction in the header).
564: ru = session("info_unclaimed", "mvme187", MV_DCMMU, MV_ICMMU, LD(4, 5, 0), [(5, UNCLAIMED)], scored=False)
565: cru = ru.cr or {}
566: print("INFO unclaimed   ld 0x%08x (no device, past RAM): how=%s path=%s r4=%s SXIP=%s dPFSR=%s dPFAR=%s "
567:       "iPFSR=%s iPFAR=%s non-existant-msg=%d unasm=%d/%d"
568:       % (UNCLAIMED, ru.how, path_of(ru) if ru.regs else "absent", hx(g(ru, 4)), hx(cru.get("SXIP")),
569:          hx(g(ru, 13)), hx(g(ru, 14)), hx(g(ru, 15)), hx(g(ru, 16)), ru.text.count("non-existant"),
570:          *check_unasm(ru, scored=False)))
571: 
572: # ================================================================ disassembly cross-check
573: #  LITERAL want, derived by hand BEFORE the first run: each scored session places 23 words (vectors 2 + 2, CODE 13,
574: #  handler 6); the scored sessions are ok, uld, ust, vme, luna = 5 x 23 = 115.  The apparatus session and the two
575: #  INFO sessions are not counted.  Computing it from the session list would let a shrunk list pass its own count.
576: row("unasm", "%d/%d" % (UNASM["ok"], UNASM["n"]), "115/115", "every placed word re-read by the disassembler")
577: for b in UNASM["bad"][:8]:
578:     print("  unasm mismatch: %s" % b)
579: 
580: # ================================================================ score + done
581: npass = sum(1 for _, ok in rows if ok)
582: print("SCORE %d/%d" % (npass, len(rows)))
583: CONTROL_ROWS = ("neg apparatus", "mv devsig", "mv cmmu rt", "luna devsig", "luna cmmu rt", "unasm")
584: _status = dict(rows)
585: control_ok = all(_status.get(n, False) for n in CONTROL_ROWS)    # a renamed control fails loudly
586: assert len(SYMPTOM) == 8, SYMPTOM
587: _cls = [c for _, c in SYMPTOM]
588: if all(c == "STALE" for c in _cls):
589:     sym = "PRESENT %d/8" % len(_cls)
590: elif all(c == "FIXED" for c in _cls):
591:     sym = "ABSENT"
592: else:
593:     sym = "MIXED " + ",".join("%s=%s" % (n, c) for n, c in SYMPTOM)
594: print("M88K_BUSERR_RESULT=%d/%d" % (npass, len(rows)))
595: print("M88K_BUSERR_CONTROL=%s" % ("OK" if control_ok else "FAIL"))
596: print("M88K_BUSERR_SYMPTOM=%s" % sym)
597: print("M88K_BUSERR_LABEL=%s" % LABEL)
598: print("M88K_BUSERR_ELAPSED=%.3fs" % (time.time() - t0))
599: red = [n for n, ok in rows if not ok]
600: if red:
601:     print("M88K_BUSERR_RED=%s" % ",".join(red))
602: shutil.rmtree(_TMPDIR, ignore_errors=True)
603: print("M88K_BUSERR_PROBE_DONE")
604: sys.stdout.flush()
605: sys.exit(0 if control_ok and npass == len(rows) else 1)

