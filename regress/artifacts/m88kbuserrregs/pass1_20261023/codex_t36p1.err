  243| DEVICE_ACCESS(m8820x)
  244| {
  245| 	// NOTE:
  246| 	//	cpu is the struct cpu* of the processor doing the device access.
  247| 	//	c   is the struct cpu* where the M88200 CMMU is located.
  248| 	uint64_t idata = 0, odata = 0;
