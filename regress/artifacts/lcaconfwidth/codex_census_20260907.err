44:  *
45:  * The MK48T02 has 2KB of non-volatile memory. The time-of-day clock
46:  * registers start at offset 0x7f8.
47:  *
48:  * The MK48T08 and MK48T18 have 8KB of non-volatile memory
49:  *
50:  * The MK48T59 also has 8KB of non-volatile memory but in addition it
51:  * has a battery low detection bit and a power supply wakeup alarm for
52:  * power management.  It's at offset 0x1ff0 in the NVRAM.
53:  */
54: 
55: /*
56:  * Mostek MK48TXX register definitions
57:  */
58: 
59: /*
60:  * The first bank of eight registers at offset (nvramsz - 16) is
61:  * available only on more recent (which??) MK48Txx models.
62:  */
63: #define MK48TXX_IFLAGS	0	/* flags */
64: /*			1	   unused on MK48T59 */
65: #define MK48TXX_IASEC	2	/* alarm seconds (0..59; BCD) */
66: #define MK48TXX_IAMIN	3	/* alarm minutes (0..59; BCD) */
67: #define MK48TXX_IAHOUR	4	/* alarm hour (0..23; BCD) */
68: #define MK48TXX_IADAY	5	/* alarm day (1..31; BCD) */
69: #define MK48TXX_IINTR	6	/* interrupts */
70: #define MK48TXX_IWDOG	7	/* watchdog */
71: #define MK48TXX_ICSR	8	/* control register */
72: #define MK48TXX_ISEC	9	/* seconds (0..59; BCD) */
73: #define MK48TXX_IMIN	10	/* minutes (0..59; BCD) */
74: #define MK48TXX_IHOUR	11	/* hour (0..23; BCD) */
75: #define MK48TXX_IWDAY	12	/* weekday (1..7) */
76: #define MK48TXX_IDAY	13	/* day in month (1..31; BCD) */
77: #define MK48TXX_IMON	14	/* month (1..12; BCD) */
78: #define MK48TXX_IYEAR	15	/* year (0..99; BCD) */
79: 
80: /* Bits in the flags register */
