82: DEVICE_ACCESS(mb8696x)
83: {
84: 	struct mb8696x_data *d = (struct mb8696x_data *) extra;
85: 	uint64_t idata = 0, odata = 0;
86: 	uint8_t *reg_ptr;
87: 
88: 	if (writeflag == MEM_WRITE)
89: 		idata = memory_readmax64(cpu, data, len);
90: 
91: 	relative_addr /= d->addr_mult;
92: 
93: 	/*
94: 	 *  Default result on reads:  (Note special treatment of banked regs.)
95: 	 */
96: 	reg_ptr = &d->reg[relative_addr];
97: 	if (relative_addr >= 8 && relative_addr <= 15 &&
98: 	    (d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_MAR)
99: 		reg_ptr = &d->mar_8_15[relative_addr - 8];
100: 	if (relative_addr >= 8 && relative_addr <= 15 &&
101: 	    (d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_BMPR)
102: 		reg_ptr = &d->bmpr_8_15[relative_addr - 8];
103: 
104: 	odata = *reg_ptr;
105: 
106: 
107: 	switch (relative_addr) {
108: 
109: 	case FE_DLCR0:	/*  TX interrupt status  */
110: 	case FE_DLCR1:	/*  RX interrupt status  */
111: 		/*  Write-1-to-clear:  */
112: 		if (writeflag == MEM_WRITE)
113: 			(*reg_ptr) &= ~idata;
114: 
115: /*  TODO: reassert interrupts  */
116: 
117: 		break;
118: 
119: 	case FE_DLCR2:	/*  TX interrupt control  */
120: 	case FE_DLCR3:	/*  RX interrupt control  */
121: 		if (writeflag == MEM_WRITE)
122: 			(*reg_ptr) = idata;
123: 
124: /*  TODO: reassert interrupts  */
