src/devices/dev_mb8696x.c
35:  *  (TODO: "Reverse engineer" more of NetBSD's mb86960.c to implement this.)
36:  */
37: 
38: #include <stdio.h>
39: #include <stdlib.h>
40: #include <string.h>
41: #include <sys/time.h>
42: 
43: #include "cpu.h"
44: #include "device.h"
45: #include "machine.h"
46: #include "memory.h"
47: #include "misc.h"
48: #include "net.h"
49: 
50: #include "thirdparty/mb86960reg.h"
51: 
52: 
53: struct mb8696x_data {
54: 	int		addr_mult;
55: 
56: 	/*
57: 	 *  Registers:
58: 	 *
59: 	 *  reg contains 32 registers. However, registers 8..15 are bank-
60: 	 *  switched, based on a setting in FE_DLCR7. mar_8_15 are "multicast
61: 	 *  address registers", and bmpr_8_15 are "buffer memory port
62: 	 *  registers".
63: 	 */
64: 	uint8_t		reg[MB8696X_NREGS];
65: 	uint8_t		mar_8_15[8];
66: 	uint8_t		bmpr_8_15[8];
67: 
68: 	/*  EEPROM contents and internal state during a read operation:  */
69: 	uint8_t		eeprom[FE_EEPROM_SIZE];
70: 	int		eeprom_state;
71: 	uint8_t		eeprom_bit_count;
72: 	uint8_t		eeprom_command;
73: 	uint16_t	eeprom_data;
74: };
75: 
76: #define	EEPROM_STATE_NOTHING	0
77: #define	EEPROM_STATE_READY	1	/*  Waiting for start bit  */
78: #define	EEPROM_STATE_COMMAND	2	/*  Waiting for 8 command bits  */
79: #define	EEPROM_STATE_READ	3
80: 
81: 
82: DEVICE_ACCESS(mb8696x)
83: {
84: 	struct mb8696x_data *d = (struct mb8696x_data *) extra;
85: 	uint64_t idata = 0, odata = 0;
86: 	uint8_t *reg_ptr;
87: 
88: 	if (writeflag == MEM_WRITE)
89: 		idata = memory_readmax64(cpu, data, len);
90: 
91: 	relative_addr /= d->addr_mult;
92: 
93: 	/*
94: 	 *  Default result on reads:  (Note special treatment of banked regs.)
95: 	 */
96: 	reg_ptr = &d->reg[relative_addr];
97: 	if (relative_addr >= 8 && relative_addr <= 15 &&
98: 	    (d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_MAR)
99: 		reg_ptr = &d->mar_8_15[relative_addr - 8];
100: 	if (relative_addr >= 8 && relative_addr <= 15 &&
101: 	    (d->reg[FE_DLCR7] & FE_D7_RBS) == FE_D7_RBS_BMPR)
102: 		reg_ptr = &d->bmpr_8_15[relative_addr - 8];
103: 
104: 	odata = *reg_ptr;
105: 
106: 
107: 	switch (relative_addr) {
108: 
109: 	case FE_DLCR0:	/*  TX interrupt status  */
110: 	case FE_DLCR1:	/*  RX interrupt status  */
111: 		/*  Write-1-to-clear:  */
112: 		if (writeflag == MEM_WRITE)
113: 			(*reg_ptr) &= ~idata;
114: 
115: /*  TODO: reassert interrupts  */
116: 
117: 		break;
118: 
119: 	case FE_DLCR2:	/*  TX interrupt control  */
120: 	case FE_DLCR3:	/*  RX interrupt control  */
121: 		if (writeflag == MEM_WRITE)
122: 			(*reg_ptr) = idata;
123: 
124: /*  TODO: reassert interrupts  */
125: 
126: 		break;
127: 
128: 	case FE_DLCR6:
129: 	case FE_DLCR8:	/*  Ethernet addr byte 0  */
130: 	case FE_DLCR9:	/*  Ethernet addr byte 1  */
131: 	case FE_DLCR10:	/*  Ethernet addr byte 2  */
132: 	case FE_DLCR11:	/*  Ethernet addr byte 3  */
133: 	case FE_DLCR12:	/*  Ethernet addr byte 4  */
134: 	case FE_DLCR13:	/*  Ethernet addr byte 5  */
135: 		if (writeflag == MEM_WRITE)
136: 			(*reg_ptr) = idata;
137: 		break;
138: 
139: 	case FE_DLCR7:
140: 		if (writeflag == MEM_WRITE) {
141: 			/*  Identification cannot be overwritten:  */
142: 			(*reg_ptr) &= FE_D7_IDENT;
143: 			(*reg_ptr) |= (idata & ~FE_D7_IDENT);
144: 		}
145: 		break;
146: 
147: 	case FE_BMPR16:
148: 		/*  EEPROM control  */
149: 		if (writeflag == MEM_WRITE) {
150: 			if (idata & ~(FE_B16_DOUT | FE_B16_DIN |
151: 			    FE_B16_SELECT | FE_B16_CLOCK)) {
152: 				fatal("mb8696x: UNIMPLEMENTED bits when "
153: 				    "writing to FE_BMPR16: 0x%02x\n",
154: 				    (int)idata);
155: 				exit(1);

src/devices/dev_mvme187.c
25:  *  SUCH DAMAGE.
26:  *
27:  *
28:  *  COMMENT: MVME187-specific devices and control registers
29:  */
30: 
31: #include <stdio.h>
32: #include <stdlib.h>
33: #include <string.h>
34: 
35: #include "cpu.h"
36: #include "device.h"
37: #include "emul.h"
38: #include "machine.h"
39: #include "memory.h"
40: #include "misc.h"
41: 
42: #include "thirdparty/mvme187.h"
43: #include "thirdparty/mvme_memcreg.h"
44: #include "thirdparty/m8820x.h"
45: 
46: 
47: struct mvme187_data {
48: 	struct memcreg		memcreg;
49: };
50: 
51: 
52: DEVICE_ACCESS(mvme187_memc)
53: {
54: 	uint64_t idata = 0, odata = 0;
55: 	struct mvme187_data *d = (struct mvme187_data *) extra;
56: 
57: 	// TODO: not used yet
58: 	int controller = 0;
59: 
60: 	if (writeflag == MEM_WRITE)
61: 		idata = memory_readmax64(cpu, data, len);
62: 
63: 	if (relative_addr & 0x100) {
64: 		controller = 1;
65: 		relative_addr &= ~0x100;
66: 	}
67: 
68: 	odata = ((uint8_t*)&d->memcreg)[relative_addr];
69: 
70: 	switch (relative_addr) {
71: 
72: 	case 0x00:	/* chipid */
73: 	case 0x04:	/* chiprev */
74: 		break;
75: 
76: 	case 0x08:	/*  memconf  */
77: 		if (writeflag == MEM_WRITE) {
78: 			fatal("mvme187_memc: Write to relative_addr %i (controller %i) not yet"
79: 			    " implemented!\n", (int)relative_addr, controller);
80: 			exit(1);
81: 		}
82: 		break;
83: 
84: 	default:fatal("[ mvme187_memc: unimplemented %s offset 0x%x",
85: 		    writeflag == MEM_WRITE? "write to" : "read from",
86: 		    (int) relative_addr);
87: 		if (writeflag == MEM_WRITE)
88: 			fatal(": 0x%x", (int)idata);
89: 		fatal(" ]\n");
90: 		exit(1);
91: 	}
92: 
93: 	if (writeflag == MEM_READ)
94: 		memory_writemax64(cpu, data, len, odata);
95: 
96: 	return 1;
97: }
98: 
99: 
100: DEVINIT(mvme187)
101: {
102: 	struct mvme187_data *d;
103: 	char tmpstr[300];
104: 	struct m8820x_cmmu *cmmu;
105: 	int size_per_memc, r;
106: 
107: 	CHECK_ALLOCATION(d = (struct mvme187_data *) malloc(sizeof(struct mvme187_data)));
108: 	memset(d, 0, sizeof(struct mvme187_data));
109: 
110: 
111: 	/*
112: 	 *  Two memory controllers per MVME187 machine:
113: 	 */
114: 
115: 	size_per_memc = devinit->machine->physical_ram_in_mb / 2 * 1048576;
116: 	for (r=0; ; r++) {
117: 		if (MEMC_MEMCONF_RTOB(r) > size_per_memc) {
118: 			r--;
119: 			break;
120: 		}
121: 	}
122: 
123: 	d->memcreg.memc_chipid = MEMC_CHIPID;
124: 	d->memcreg.memc_chiprev = 1;
125: 	d->memcreg.memc_memconf = r;
126: 
127: 	memory_device_register(devinit->machine->memory, devinit->name,
128: 	    MVME187_MEM_CTLR, 0x200, dev_mvme187_memc_access, (void *)d,
129: 	    DM_DEFAULT, NULL);
130: 
131: 
132: 	/*  Instruction CMMU:  */
133: 	CHECK_ALLOCATION(cmmu = (struct m8820x_cmmu *) malloc(sizeof(struct m8820x_cmmu)));
134: 	memset(cmmu, 0, sizeof(struct m8820x_cmmu));
135: 
136: 	devinit->machine->cpus[devinit->machine->bootstrap_cpu]->
137: 	    cd.m88k.cmmu[0] = cmmu;
138: 	/*  This is a 88200, revision 9:  */
139: 	cmmu->reg[CMMU_IDR] = (M88200_ID << 21) | (9 << 16);
140: 	snprintf(tmpstr, sizeof(tmpstr),
141: 	    "m8820x addr=0x%x addr2=0", MVME187_SBC_CMMU_I);
142: 	device_add(devinit->machine, tmpstr);
143: 
144: 	/*  ... and data CMMU:  */
145: 	CHECK_ALLOCATION(cmmu = (struct m8820x_cmmu *) malloc(sizeof(struct m8820x_cmmu)));

