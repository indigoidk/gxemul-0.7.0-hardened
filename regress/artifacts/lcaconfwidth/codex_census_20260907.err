from pathlib import Path
import re
base=Path('GXEMUL-SEC/src/devices')
files=sorted(base.glob('*.c'))
counts={s:[] for s in ['(int)idata','(uint32_t)idata','(long)idata','(int32_t)idata','(unsigned int)idata']}
near=[]
for p in files:
    ls=p.read_text(errors='replace').splitlines()
    exits=[i for i,s in enumerate(ls) if re.search(r'\\bexit\\s*\\(\\s*1\\s*\\)',s)]
    for i,s in enumerate(ls):
        for k,v in counts.items():
            if k in s: v.append((str(p),i+1,s))
        if '(int)idata' in s and any(abs(i-j)<=3 for j in exits): near.append((p,i,ls))
for k,v in counts.items(): print(k, 'lines=',len(v),'files=',len(set(t[0] for t in v)))
print('NEARBY EXIT SITES',len(near))
for p,i,ls in near:
    print('\\n'+str(p)+':'+str(i+1))
    for j in range(max(0,i-7),min(len(ls),i+8)): print(f'{j+1:4}: {ls[j]}')
