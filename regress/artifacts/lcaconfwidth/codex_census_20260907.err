242: DEVICE_ACCESS(dreamcast_g2_misc)
243: {
244: 	struct dreamcast_g2_data *d = (struct dreamcast_g2_data *) extra;
245: 	uint64_t idata = 0, odata = 0;
246: 
247: 	if (writeflag == MEM_WRITE)
248: 		idata = memory_readmax64(cpu, data, len);
249: 
250: 	/*  Default read:  */
251: 	if (writeflag == MEM_READ)
252: 		odata = d->misc_reg[relative_addr / sizeof(uint32_t)];
253: 
254: 	switch (relative_addr) {
255: 
256: 	case 0x64:
257: 		/*  Writing 0x1fffff to 0x5f74e4 resets a disabled GD-ROM drive?  */
258: 		if (writeflag != MEM_WRITE || idata != 0x1fffff) {
259: 			fatal("[ dreamcast_g2_misc: unimplemented 0xe4 ]\n");
260: 			exit(1);
261: 		}
262: 		break;
263: 
264: 	default:if (writeflag == MEM_READ) {
265: 			debug("[ dreamcast_g2_misc: read from addr 0x%x ]\n",
266: 			    (int)relative_addr);
267: 		} else {
268: 			debug("[ dreamcast_g2_misc: write to addr 0x%x: "
269: 			    "0x%x ]\n", (int)relative_addr, (int)idata);
270: 		}
271: 
272: 		/*  exit(1);  */
273: 	}
274: 
275: 	/*  Default write:  */
276: 	if (writeflag == MEM_WRITE)
277: 		d->misc_reg[relative_addr / sizeof(uint32_t)] = idata;
278: 
279: 	if (writeflag == MEM_READ)
280: 		memory_writemax64(cpu, data, len, odata);
281: 
282: 	return 1;
283: }
