57: 
58: /*
59:  *  External DMA:  4 channels
60:  *
61:  *  Note: Addresses and sizes must be 32-byte aligned.
62:  *  DIR is 0 for CPU to External device, 1 for External to CPU.
63:  *  MODE should be 5 for transfers to/from the SPU.
64:  */
65: #define	EXTDMA_CTRL_EXT_ADDR	0x00	/*  EXTDMA_CTRL_* are repeated  */
66: #define	EXTDMA_CTRL_SH4_ADDR	0x04	/*  4 times (once for each channel)  */
67: #define	EXTDMA_CTRL_SIZE	0x08
68: #define	EXTDMA_CTRL_DIR		0x0c
69: #define	EXTDMA_CTRL_MODE	0x10
70: #define	EXTDMA_CTRL_CHAN_ENABLE	0x14	/*  Channel enable  */
71: #define	EXTDMA_CTRL_XFER_ENABLE	0x18	/*  Transfer enable  */
72: #define	EXTDMA_CTRL_STATUS	0x1c	/*  Transfer status  */
73: 
74: #define	EXTDMA_WAITSTATE	0x90
75: #define	EXTDMA_MAGIC		0xbc
76: #define	EXTDMA_MAGIC_VALUE	    0x4659404f
77: #define	EXTDMA_MAGIC_VALUE_ROM	    0x46597f00
78: 
79: #define	EXTDMA_STAT_EXT_ADDR	0xc0	/*  EXTDMA_STAT_* are repeated 4  */
80: #define	EXTDMA_STAT_SH4_ADDR	0xc4	/*  times too  */
81: #define	EXTDMA_STAT_SIZE	0xc8
82: #define	EXTDMA_STAT_STATUS	0xcc
83: 
84: 
85: DEVICE_ACCESS(dreamcast_g2_extdma)
86: {
87: 	struct dreamcast_g2_data *d = (struct dreamcast_g2_data *) extra;
88: 	uint64_t idata = 0, odata = 0;
89: 	int reg = relative_addr, channel = 0;
90: 	int reg_index = (relative_addr & 0x7f) / sizeof(uint32_t);	/* OB-21 */
91: 	uint32_t *reg_array = relative_addr < 0x80 ?
92: 	    d->extdma_reg : d->extdma_high_reg;
93: 
94: 	if (writeflag == MEM_WRITE)
95: 		idata = memory_readmax64(cpu, data, len);
96: 
97: 	/*  Default read:  */
98: 	if (writeflag == MEM_READ)
99: 		odata = reg_array[reg_index];	/* OB-21 */
100: 
101: 	/*
102: 	 *  0x5f7800 .. 1f = DMA channel 0
103: 	 *        20 .. 3f = DMA channel 1
104: 	 *        40 .. 5f = DMA channel 2
105: 	 *        60 .. 7f = DMA channel 3
106: 	 *        80 .. bf = misc magic stuff
107: 	 *        c0 .. cf = DMA channel 0 status
108: 	 *        d0 .. df = DMA channel 1 status
109: 	 *        e0 .. ef = DMA channel 2 status
110: 	 *        f0 .. ff = DMA channel 3 status
111: 	 */
112: 	if (reg < 0x7f) {
113: 		channel = (reg >> 5) & 3;
114: 		reg &= 0x1f;
115: 	}
116: 	if (reg >= 0xc0 && reg < 0xff) {
117: 		channel = (reg >> 4) & 3;
118: 		reg = 0xc0 + (reg & 0xf);
119: 	}
120: 
121: 	switch (reg) {
122: 
123: 	case EXTDMA_CTRL_EXT_ADDR:
124: 		if (writeflag == MEM_WRITE) {
125: 			debug("[ dreamcast_g2_extdma: write to channel %i:"
126: 			    " EXT_ADDR = 0x%08x ]\n", channel, (int) idata);
127: 		}
128: 		break;
129: 
130: 	case EXTDMA_CTRL_SH4_ADDR:
131: 		if (writeflag == MEM_WRITE) {
132: 			debug("[ dreamcast_g2_extdma: write to channel %i:"
133: 			    " SH4_ADDR = 0x%08x ]\n", channel, (int) idata);
134: 		}
135: 		break;
136: 
137: 	case EXTDMA_CTRL_SIZE:
138: 		if (writeflag == MEM_WRITE) {
139: 			debug("[ dreamcast_g2_extdma: write to channel %i:"
140: 			    " SIZE = 0x%08x ]\n", channel, (int) idata);
141: 		}
142: 		break;
143: 
144: 	case EXTDMA_CTRL_DIR:
145: 		if (writeflag == MEM_WRITE) {
146: 			debug("[ dreamcast_g2_extdma: write to channel %i:"
147: 			    " DIR = 0x%08x ]\n", channel, (int) idata);
148: 		}
149: 		break;
