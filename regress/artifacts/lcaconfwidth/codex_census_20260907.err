48: #define	NREGS_EXT_DMA_HIGH	(0x80/sizeof(uint32_t))	/* OB-21 */
49: #define	NREGS_MISC		(0x80/sizeof(uint32_t))
50: 
51: struct dreamcast_g2_data {
52: 	uint32_t	extdma_reg[NREGS_EXT_DMA];
53: 	uint32_t	extdma_high_reg[NREGS_EXT_DMA_HIGH];	/* OB-21 */
54: 	uint32_t	misc_reg[NREGS_MISC];
