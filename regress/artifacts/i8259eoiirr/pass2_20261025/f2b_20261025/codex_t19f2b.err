42: /*  #define TEST  */
43: 
44: 
45: struct timer {
46: 	struct timer	*next;
47: 
48: 	double		freq;
49: 	void		(*timer_tick)(struct timer *timer, void *extra);
50: 	void		*extra;
51: 
52: 	double		interval;
53: 	double		next_tick_at;
54: };
55: 
56: static struct timer *first_timer = NULL;
57: struct timeval timer_start_tv;
58: static double timer_freq;
59: static int timer_countdown_to_next_gettimeofday;
60: static double timer_current_time;
61: static double timer_current_time_step;
62: 
63: static int timer_is_running;
64: 
65: /*  #427: set when the catch-up bound is reached.  A sig_atomic_t because the SIGALRM
66:     handler writes it; it is REPORTED FROM timer_stop(), never from the handler.  */
67: static volatile sig_atomic_t timer_catchup_hit;
68: 
69: /*
70:  *  timer_clamp_freq():
71:  *
72:  *  Bring a requested frequency into [TIMER_MIN_FREQUENCY, TIMER_MAX_FREQUENCY].
73:  *
74:  *  *** THE TESTS ARE NEGATED ON PURPOSE. ***  `f < MIN` is FALSE for a NaN, so a plain
75:  *  comparison lets a NaN through; the interval then becomes NaN, the catch-up condition is
76:  *  false for ever, and the timer SILENTLY NEVER FIRES -- the worst failure shape there is.
77:  *  Negating the test that has to exist anyway catches NaN, negative and zero at no extra
78:  *  cost, and the FLOOR is tested FIRST so a NaN lands SLOW rather than fast.
79:  *
80:  *  Precisely, because a mutation census measured it: THE FLOOR'S NEGATION IS THE ONE THAT
81:  *  CATCHES NaN.  With the floor negated, a NaN never reaches the ceiling test at all, so
82:  *  writing the ceiling as a plain `f > MAX` survives every row.  The ceiling is negated
83:  *  anyway, for two reasons worth stating rather than assuming: the two clamps then read as
84:  *  one idiom, and neither can be reordered later into a hole.
85:  *
86:  *  Callers are device-access and devinit code, never the signal handler, so complaining
87:  *  here is safe.  The complaint is the caller's business: this returns whether it clamped
88:  *  at the top, and the caller reports once per CHANGE rather than once per write.
89:  *
90:  *  CORRECTION (review of 2026-08-16): this said "once per timer", which a seat MEASURED to
91:  *  be false -- 1000 alternating INFINITY/1000 Hz updates produce 1000 complaints, because
92:  *  the guard that suppresses them is the `t->freq == new_freq` early-out, not a per-timer
93:  *  latch.  A guest that alternates two rates therefore drives an unbounded stderr write,
94:  *  the same class as #265's flood.  dev_rtc is immune because it pre-clamps; dev_footbridge
95:  *  is not.  Filed as its own item; only the wrong sentence is corrected here.
96:  */
97: static double timer_clamp_freq(double f, int *was_clamped)
98: {
99: 	*was_clamped = 0;
100: 
101: 	if (!(f >= TIMER_MIN_FREQUENCY))
102: 		f = TIMER_MIN_FREQUENCY;
103: 
104: 	if (!(f <= TIMER_MAX_FREQUENCY)) {
105: 		f = TIMER_MAX_FREQUENCY;
106: 		*was_clamped = 1;
107: 	}
108: 
109: 	return f;
110: }
111: 
112: #define	SECONDS_BETWEEN_GETTIMEOFDAY_SYNCH	1.65
113: 
114: 
115: /*
116:  *  timer_add():
117:  *
118:  *  Adds a virtual timer to the list of timers.
119:  *
120:  *  Return value is a pointer to a timer struct.
121:  */
122: struct timer *timer_add(double freq, void (*timer_tick)(struct timer *timer,
123: 	void *extra), void *extra)
124: {
125: 	struct timer *newtimer;
126: 	int clamped;
127: 
128: 	CHECK_ALLOCATION(newtimer = (struct timer *) malloc(sizeof(struct timer)));
129: 
130: 	/*  #427: clamp before anything is stored, so freq and interval agree.  */
131: 	freq = timer_clamp_freq(freq, &clamped);
132: 	if (clamped)
133: 		fatal("[ timer: requested rate is above %f Hz; clamped ]\n",
134: 		    (double) TIMER_MAX_FREQUENCY);
135: 
136: 	newtimer->freq = freq;
137: 	newtimer->timer_tick = timer_tick;
138: 	newtimer->extra = extra;
139: 
140: 	newtimer->interval = 1.0 / freq;
141: 	newtimer->next_tick_at = timer_current_time + newtimer->interval;
142: 
143: 	newtimer->next = first_timer;
144: 	first_timer = newtimer;
145: 
146: 	return newtimer;
147: }
