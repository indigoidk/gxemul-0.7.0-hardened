367: def build_masked():
368:     """Line 4 masked: the poll byte (mask-blind on HEAD), then -- with the request still pending under the mask -- a
369:     SECOND read of the command port without another OCW3: the one-shot poll returns the IRR (0x10) where a sticky poll
370:     returns the empty poll byte (0x00) and HEAD returns its mask-blind 0x84; IRR under the mask; the un-acknowledged EOI
371:     under the mask."""
372:     begin()
373:     e_uart_level_on()
374:     e_delay()
375:     e_ocw3_read(v1, OCW3_IRR)
376:     e_in(a2, PIC1_CMD)
377:     e_out(PIC1_IMR, 0x10)
378:     e_in(a0, PIC1_IMR)
379:     e_ocw3_read(a1, OCW3_POLL)
380:     e_in(s1, PIC1_CMD)
381:     e_ocw3_read(a3, OCW3_IRR)
382:     e_li(t5, OCW3_IRR)
383:     e_li(t6, 0x64)
384:     emit(sb(t6, PIC1_CMD, t0), "sb t6,%d(t0)" % PIC1_CMD)
385:     emit(sb(t5, PIC1_CMD, t0), "sb t5,%d(t0)" % PIC1_CMD)
386:     e_in(s0, PIC1_CMD)
387:     e_out(PIC1_IMR, 0x00)
388:     p, halt = end()
389:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "imr": "a0", "poll": "a1", "once": "s1", "masked": "a3", "masked_eoi": "s0"}, None
390: 
391: 
392: def build_nonspec():
393:     """Both UARTs pending: poll twice (3 then 4), ISR 0x18, the non-specific EOI resets the lowest ISR bit, twice."""
394:     begin()
395:     e_uart_level_on(UART3_IER, UART3_MCR)
396:     e_uart_level_on()
397:     e_delay()
398:     e_ocw3_read(v1, OCW3_IRR)
399:     e_in(a2, PIC1_CMD)
400:     e_ocw3_read(a0, OCW3_POLL)
401:     e_ocw3_read(a1, OCW3_POLL)
402:     e_ocw3_read(a3, OCW3_ISR)
403:     e_out(PIC1_CMD, EOI_NONSPEC)
404:     e_ocw3_read(s0, OCW3_ISR)
405:     e_out(PIC1_CMD, EOI_NONSPEC)
406:     e_ocw3_read(s1, OCW3_ISR)
407:     p, halt = end()
408:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll_a": "a0", "poll_b": "a1", "isr_both": "a3",
409:                      "isr_one": "s0", "isr_none": "s1"}, None
410: 
411: 
412: def build_casc():
413:     """The mc146818 periodic interrupt (IRQ 8, pic2) at 1024 Hz after a long wait: the cascade acknowledge."""
414:     begin()
415:     e_out(CMOS_IDX, 0x0a)
416:     e_out(CMOS_DAT, 0x26)
417:     e_out(CMOS_IDX, 0x0b)
418:     e_out(CMOS_DAT, 0x40)
419:     e_long(); e_long(); e_long()
420:     e_ocw3_read(v1, OCW3_IRR)
421:     e_in(a2, PIC1_CMD)
422:     e_ocw3_read(a0, OCW3_POLL)
423:     e_ocw3_read(a1, OCW3_ISR)
424:     e_ocw3_read(a3, OCW3_POLL, PIC2_CMD)
425:     e_ocw3_read(s0, OCW3_ISR, PIC2_CMD)
426:     e_eoi(0, PIC2_CMD)
427:     e_eoi(2)
428:     e_ocw3_read(s1, OCW3_ISR)
429:     e_ocw3_read(s2, OCW3_ISR, PIC2_CMD)
430:     p, halt = end()
431:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "isr": "a1", "poll2": "a3",
432:                      "isr2": "s0", "isr_eoi": "s1", "isr2_eoi": "s2"}, None
433: 
434: 
435: def build_pit():
436:     """8253 counter 0 at 291 Hz after a long wait: IRR bit 0, the poll byte, IRR bit 0 after the poll."""
437:     begin()
438:     e_pit_291hz()
439:     e_long(); e_long(); e_long()
440:     e_ocw3_read(v1, OCW3_IRR)
441:     e_in(a2, PIC1_CMD)
442:     e_ocw3_read(a0, OCW3_POLL)
443:     e_ocw3_read(a1, OCW3_IRR)
444:     p, halt = end()
445:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "irr_after": "a1"}, None
446: 
447: 
448: def build_gt():
449:     """The GT64120 interrupt-acknowledge read with the UART level on: the value, ISR and IRR after it."""
450:     begin()
451:     e_uart_level_on()
452:     e_delay()
453:     e_ocw3_read(v1, OCW3_IRR)
454:     e_in(a2, PIC1_CMD)
455:     emit(lui(t1, GT_HI), "lui t1,0x%x" % GT_HI)
456:     emit(lw(a0, GT_IACK, t1), "lw a0,%d(t1)" % GT_IACK)
457:     e_ocw3_read(a1, OCW3_ISR)
458:     e_ocw3_read(a3, OCW3_IRR)
459:     p, halt = end()
460:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "iack": "a0", "isr": "a1", "irr_after": "a3"}, None
461: 
462: 
463: def build_gtboth():
464:     """The GT IACK read with BOTH a master line (the UART, IRQ 4) and a slave line (the RTC, IRQ 8) pending: the acknowledge
465:     takes the cascade (line 2 outranks line 4) and then the slave, returning 8; HEAD's last_int -- bus_isa's flat scan,
466:     which skips line 2 -- reads 4.  Pins the returned line, which the single-source rows cannot."""
467:     begin()
468:     e_out(CMOS_IDX, 0x0a)
469:     e_out(CMOS_DAT, 0x26)
470:     e_out(CMOS_IDX, 0x0b)
471:     e_out(CMOS_DAT, 0x40)
472:     e_uart_level_on()
473:     e_long(); e_long(); e_long()
474:     e_ocw3_read(v1, OCW3_IRR)
475:     e_in(a2, PIC1_CMD)
476:     emit(lui(t1, GT_HI), "lui t1,0x%x" % GT_HI)
477:     emit(lw(a0, GT_IACK, t1), "lw a0,%d(t1)" % GT_IACK)
478:     e_ocw3_read(a1, OCW3_ISR)
479:     e_ocw3_read(a3, OCW3_ISR, PIC2_CMD)
480:     p, halt = end()
481:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "iack": "a0", "isr": "a1", "isr2": "a3"}, None
482: 
483: 
484: def build_gtcasc():
485:     """The GT64120 IACK read with the mc146818 periodic interrupt pending on pic2: returns 8 in both columns (HEAD:
486:     last_int); FIX acknowledges the master's cascade line and the slave's line 0 (ISR 0x04 / 0x01)."""
487:     begin()
488:     e_out(CMOS_IDX, 0x0a)
489:     e_out(CMOS_DAT, 0x26)
490:     e_out(CMOS_IDX, 0x0b)
491:     e_out(CMOS_DAT, 0x40)
492:     e_long(); e_long(); e_long()
493:     e_ocw3_read(v1, OCW3_IRR)
494:     e_in(a2, PIC1_CMD)
495:     emit(lui(t1, GT_HI), "lui t1,0x%x" % GT_HI)
496:     emit(lw(a0, GT_IACK, t1), "lw a0,%d(t1)" % GT_IACK)
497:     e_ocw3_read(a1, OCW3_ISR)
498:     e_ocw3_read(a3, OCW3_ISR, PIC2_CMD)
499:     e_eoi(0, PIC2_CMD)
500:     e_eoi(2)
501:     e_ocw3_read(s0, OCW3_ISR)
502:     e_ocw3_read(s1, OCW3_ISR, PIC2_CMD)
503:     p, halt = end()
504:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "iack": "a0", "isr": "a1", "isr2": "a3",
505:                      "isr_eoi": "s0", "isr2_eoi": "s1"}, None
506: 
507: 
508: def build_rate_handler():
509:     """At the general exception vector: poll (OCW3 0x0c + read) into k1, remember it in s3, specific EOI 0x60|(k1&7),
510:     count in s2, eret."""
511:     reset_prog()
512:     emit(lui(k0, ISA_HI), "lui k0,0x%x" % ISA_HI)
513:     emit(ori(k1, zero, OCW3_POLL), "ori k1,zr,0xc")
514:     emit(sb(k1, PIC1_CMD, k0), "sb k1,%d(k0)" % PIC1_CMD)
515:     emit(lbu(k1, PIC1_CMD, k0), "lbu k1,%d(k0)" % PIC1_CMD)
516:     emit(or_(s3, k1, zero), "or s3,k1,zr")
517:     emit(andi(k1, k1, 0x7), "andi k1,k1,0x7")
518:     emit(ori(k1, k1, 0x60), "ori k1,k1,0x60")
519:     emit(sb(k1, PIC1_CMD, k0), "sb k1,%d(k0)" % PIC1_CMD)
520:     emit(addiu(s2, s2, 1), "addiu s2,s2,0x1")
521:     emit(ERET, "eret")
522:     return list(prog)
523: 
524: 
525: def build_rate():
526:     """Count IRQ 0 deliveries: mask all but line 0, counter 0 = 0xffff (18 Hz), Status IE|IM2 with BEV clear, spin
527:     RATE_SPIN iterations, disable, read IRR/IMR back.  The handler is loaded at HANDLER."""
528:     handler = build_rate_handler()
529:     begin()
530:     e_out(PIC1_IMR, 0xfe)
531:     e_out(PIC2_IMR, 0xff)
532:     e_out(PIT_CTL, 0x34)
533:     e_out(PIT_C0, 0xff)
534:     e_out(PIT_C0, 0xff)
535:     emit(ori(s2, zero, 0), "ori s2,zr,0x0")
536:     emit(ori(s3, zero, 0), "ori s3,zr,0x0")
537:     emit(ori(k1, zero, STATUS_IE_IM2), "ori k1,zr,0x401")
538:     emit(mtc0(k1, COP0_STATUS), "mtc0 k1,status")
539:     e_long(RATE_SPIN)
540:     emit(mtc0(zero, COP0_STATUS), "mtc0 zr,status")
541:     e_ocw3_read(a0, OCW3_IRR)
542:     e_in(a1, PIC1_IMR)
543:     p, halt = end()
544:     return p, halt, {"ram": "v0", "count": "s2", "lastpoll": "s3", "irr_after": "a0", "imr": "a1"}, (HANDLER, handler)
545: 
546: 
547: SESSION_ORDER = [("quiet", build_quiet), ("level", build_level), ("ack", build_ack), ("ack3", build_ack3),
548:                  ("masked", build_masked), ("nonspec", build_nonspec), ("casc", build_casc), ("pit", build_pit),
549:                  ("gt", build_gt), ("gtcasc", build_gtcasc), ("gtboth", build_gtboth), ("rate", build_rate)]
550: 
551: 
552: class Emu(object):
553:     def __init__(self, argv, boot_wait=5.0):
554:         self.buf = bytearray()
555:         self.pid, self.fd = pty.fork()
556:         if self.pid == 0:
557:             try:
558:                 os.execvp(argv[0], argv)
559:             finally:
560:                 os._exit(127)
561:         self.drain(boot_wait)
562: 
563:     def drain(self, seconds):
564:         end_t = time.time() + seconds
565:         while time.time() < end_t:
566:             r, _, _ = select.select([self.fd], [], [], 0.05)
567:             if self.fd in r:
568:                 try:
569:                     d = os.read(self.fd, 65536)
570:                 except OSError:
571:                     return
572:                 if not d:
573:                     return
574:                 self.buf.extend(d)
575: 
576:     def send(self, cmd, wait=0.4):
577:         start = len(self.buf)
578:         data = (cmd + "\n").encode()
579:         view = memoryview(data)
580:         while len(view):
581:             try:
582:                 n = os.write(self.fd, view)
583:             except OSError:
584:                 break
585:             view = view[n:]
586:             if len(view):
587:                 self.drain(0.05)
588:         self.drain(wait)
589:         return bytes(self.buf[start:]).decode("latin1", "replace")
590: 
591:     def close(self, log):
592:         try:
593:             os.write(self.fd, b"quit\n")
594:             self.drain(0.4)
595:         except OSError:
596:             pass
597:         for fn in (lambda: os.close(self.fd),
598:                    lambda: os.kill(self.pid, 9),
599:                    lambda: os.waitpid(self.pid, 0)):
600:             try:
601:                 fn()
602:             except OSError:
603:                 pass
604:         with open(log, "w") as f:
605:             f.write(bytes(self.buf).decode("latin1", "replace"))
606: 
607: 
608: def reg(emu, name):
609:     for _ in range(5):
610:         out = emu.send("print %s" % name, wait=0.35)
611:         m = re.findall(r"0x[0-9a-fA-F]+", out)
612:         if m:
613:             return int(m[-1], 16)
614:         emu.drain(0.25)
615:     return None
616: 
617: 
618: def write_bin(path, prog_list):
619:     with open(path, "wb") as f:
620:         for w, _ in prog_list:
621:             f.write(bytes([w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff]))
622: 
623: 
624: def check_words(emu, base, prog_list, label, out):
625:     dis = emu.send("unassemble 0x%x 0x%x" % (base, base + len(prog_list) * 4), wait=max(3.0, len(prog_list) * 0.03))
626:     seen = {}
627:     for line in dis.splitlines():
628:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
629:         if m:
630:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
631:     w_ok = m_ok = 0
632:     bad = []
633:     for i, (w, want_mn) in enumerate(prog_list):
634:         addr = (base + i * 4) & 0xffffffff
635:         hit = seen.get(addr)

 succeeded in 306ms:
636:         if hit is None:
637:             bad.append("      BAD 0x%08x no disassembly line" % addr)
638:             continue
639:         if hit[0] == "%08x" % w:
640:             w_ok += 1
641:         else:
642:             bad.append("      BAD 0x%08x word %s vs %08x" % (addr, hit[0], w))
643:         if " ".join(hit[1].replace("\t", " ").split()).startswith(" ".join(want_mn.split())):
644:             m_ok += 1
645:     out("    encodings (%s): %d/%d words agree with the disassembler (CONTROL); %d/%d mnemonic renderings match "
646:         "(informational)" % (label, w_ok, len(prog_list), m_ok, len(prog_list)))
647:     for l in bad[:8]:
648:         out(l)
649:     return w_ok == len(prog_list)
650: 
651: 
652: def run_session(binary, prog_list, halt_addr, rawbin, regmap, tag, out, extra=None):
653:     """Run one guest program (plus an optional second binary at another address) to its halt breakpoint and read back
654:     the capture regs."""
655:     write_bin(rawbin, prog_list)
656:     files = []
657:     if extra is not None:
658:         eaddr, eprog = extra
659:         ebin = rawbin[:-4] + "_handler.bin"
660:         write_bin(ebin, eprog)
661:         files.append("0x%x:%s" % (eaddr, ebin))
662:     files.append("0x%x:%s" % (BASE, rawbin))
663:     argv = [binary, "-V"] + MACHINE + files
664:     out("    [%s] %s" % (tag, " ".join(argv)))
665:     emu = Emu(argv)
666:     try:
667:         dead = os.waitpid(emu.pid, os.WNOHANG) != (0, 0)
668:     except OSError:
669:         dead = True
670:     if dead:
671:         #  The medium is not an emulator (a null-medium leg, or a binary that will not start): every control row
672:         #  reads ?? and CONTROL fails, without waiting out the park deadline.
673:         out("    [%s] the emulator process exited before the debugger prompt -- no words checked, no park" % tag)
674:         emu.close(os.path.join(RAWDIR, "%s.txt" % tag))
675:         return dict((k, None) for k in regmap), False, False
676:     enc_ok = check_words(emu, BASE, prog_list, "main", out)
677:     if extra is not None:
678:         enc_ok = check_words(emu, extra[0], extra[1], "handler", out) and enc_ok
679:     emu.send("breakpoint add 0x%x" % halt_addr, wait=0.5)
680:     t = time.time()
681:     emu.send("continue", wait=1.0)
682:     deadline = time.time() + 180
683:     hit = False
684:     seen_pc = None
685:     while time.time() < deadline:
686:         emu.drain(0.5)
687:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
688:         m = re.search(r"BREAKPOINT:\s*pc\s*=\s*0x([0-9a-fA-F]+)", tail)
689:         if m:
690:             seen_pc = int(m.group(1), 16) & 0xffffffff
691:             hit = (seen_pc == (halt_addr & 0xffffffff))
692:             break
693:     out("    parked at 0x%016x: %s   (%.2f s)"
694:         % (halt_addr, "yes (pc verified)" if hit else
695:            ("*** NO: stopped at 0x%08x ***" % seen_pc if seen_pc is not None else "*** NO ***"),
696:            time.time() - t))
697:     got = {}
698:     for logical, mips in regmap.items():
699:         v = reg(emu, mips)
700:         got[logical] = None if v is None else (v & 0xffffffff)
701:     emu.close(os.path.join(RAWDIR, "%s.txt" % tag))
702:     return got, enc_ok, hit
703: 
704: 
705: def show(v):
706:     if isinstance(v, tuple):
707:         return "%d..%s" % (v[0], "inf" if v[1] is None else v[1])
708:     return "0x%02x" % v if isinstance(v, int) else ("??" if v is None else str(v))
709: 
710: 
711: def bit(v, n):
712:     return None if v is None else (v >> n) & 1
713: 
714: 
715: def build_rows(sess):
716:     """Rows as (label, kind, got, want_head, want_fix, mode); mode 'eq' or 'band' (want = (lo, hi|None))."""
717:     rows = []
718:     for name, _ in SESSION_ORDER:
719:         g = sess.get(name, {}).get("ram")
720:         rows.append(("ram:%s" % name, "control", g, RAM_MAGIC, RAM_MAGIC, "eq"))
721:     q = sess.get("quiet", {})
722:     rows.append(("quiet irr", "control", q.get("irr"), 0x00, 0x00, "eq"))
723:     rows.append(("quiet isr", "control", q.get("isr"), 0x00, 0x00, "eq"))
724:     rows.append(("quiet poll", "control", q.get("poll"), 0x00, 0x00, "eq"))
725:     rows.append(("quiet imr", "control", q.get("imr"), 0x00, 0x00, "eq"))
726:     lv = sess.get("level", {})
727:     rows.append(("level irr4", "control", bit(lv.get("irr"), 4), 1, 1, "eq"))
728:     rows.append(("level isr", "contract", lv.get("isr"), 0x00, 0x00, "eq"))
729:     rows.append(("eoi noack", "contract", bit(lv.get("noack"), 4), 0, 0, "eq"))
730:     rows.append(("reassert irr4", "control", bit(lv.get("reassert"), 4), 1, 1, "eq"))
731:     rows.append(("eoi noack isr", "contract", lv.get("isr2"), 0x00, 0x00, "eq"))
732:     a = sess.get("ack", {})
733:     rows.append(("ack irr4", "control", bit(a.get("irr"), 4), 1, 1, "eq"))
734:     rows.append(("poll byte", "control", a.get("poll"), 0x84, 0x84, "eq"))
735:     rows.append(("poll isr", "symptom", a.get("isr"), 0x00, 0x10, "eq"))
736:     rows.append(("poll irr4", "symptom", bit(a.get("irr_after"), 4), 1, 0, "eq"))
737:     rows.append(("poll again", "symptom", a.get("once"), 0x84, 0x00, "eq"))
738:     rows.append(("in-service irr4", "control", bit(a.get("reassert"), 4), 1, 1, "eq"))
739:     rows.append(("eoi acked", "symptom", bit(a.get("eoi_acked"), 4), 0, 1, "eq"))
740:     rows.append(("eoi acked isr", "contract", a.get("isr2"), 0x00, 0x00, "eq"))
741:     a3 = sess.get("ack3", {})
742:     rows.append(("ack3 irr3", "control", bit(a3.get("irr"), 3), 1, 1, "eq"))
743:     rows.append(("poll3 byte", "control", a3.get("poll"), 0x83, 0x83, "eq"))
744:     rows.append(("poll3 isr", "symptom", a3.get("isr"), 0x00, 0x08, "eq"))
745:     rows.append(("in-service irr3", "control", bit(a3.get("reassert"), 3), 1, 1, "eq"))
746:     rows.append(("eoi acked3", "symptom", bit(a3.get("eoi_acked"), 3), 0, 1, "eq"))
747:     mk = sess.get("masked", {})
748:     rows.append(("masked irr4", "contract", bit(mk.get("masked"), 4), 1, 1, "eq"))
749:     rows.append(("masked imr", "control", mk.get("imr"), 0x10, 0x10, "eq"))
750:     rows.append(("poll masked", "symptom", mk.get("poll"), 0x84, 0x00, "eq"))
751:     rows.append(("poll once", "symptom", mk.get("once"), 0x84, 0x10, "eq"))
752:     rows.append(("masked eoi", "contract", bit(mk.get("masked_eoi"), 4), 0, 0, "eq"))
753:     ns = sess.get("nonspec", {})
754:     rows.append(("both irr", "control", (None if ns.get("irr") is None else ns.get("irr") & 0x18), 0x18, 0x18, "eq"))
755:     rows.append(("poll first", "control", ns.get("poll_a"), 0x83, 0x83, "eq"))
756:     rows.append(("poll second", "symptom", ns.get("poll_b"), 0x83, 0x84, "eq"))
757:     rows.append(("isr both", "symptom", ns.get("isr_both"), 0x00, 0x18, "eq"))
758:     rows.append(("nonspec lowest", "symptom", ns.get("isr_one"), 0x00, 0x10, "eq"))
759:     rows.append(("nonspec twice", "contract", ns.get("isr_none"), 0x00, 0x00, "eq"))
760:     c = sess.get("casc", {})
761:     rows.append(("casc irr2", "control", bit(c.get("irr"), 2), 1, 1, "eq"))
762:     rows.append(("casc poll", "control", c.get("poll"), 0x82, 0x82, "eq"))
763:     rows.append(("casc isr2", "symptom", c.get("isr"), 0x00, 0x04, "eq"))
764:     rows.append(("casc slave poll", "control", c.get("poll2"), 0x80, 0x80, "eq"))
765:     rows.append(("casc isr8", "symptom", c.get("isr2"), 0x00, 0x01, "eq"))
766:     rows.append(("casc eoi isr", "contract", c.get("isr_eoi"), 0x00, 0x00, "eq"))
767:     rows.append(("casc eoi isr8", "contract", c.get("isr2_eoi"), 0x00, 0x00, "eq"))
768:     pt = sess.get("pit", {})
769:     rows.append(("pit irr0", "control", bit(pt.get("irr"), 0), 1, 1, "eq"))
770:     rows.append(("pit poll", "control", pt.get("poll"), 0x80, 0x80, "eq"))
771:     rows.append(("pit poll irr0", "symptom", bit(pt.get("irr_after"), 0), 1, 0, "eq"))
772:     g = sess.get("gt", {})
773:     rows.append(("gt irr4", "control", bit(g.get("irr"), 4), 1, 1, "eq"))
774:     rows.append(("gt iack", "control", g.get("iack"), 0x04, 0x04, "eq"))
775:     rows.append(("gt isr", "symptom", g.get("isr"), 0x00, 0x10, "eq"))
776:     rows.append(("gt irr4 after", "symptom", bit(g.get("irr_after"), 4), 1, 0, "eq"))
777:     gc = sess.get("gtcasc", {})
778:     rows.append(("gtcasc irr2", "control", bit(gc.get("irr"), 2), 1, 1, "eq"))
779:     rows.append(("gtcasc iack", "control", gc.get("iack"), 0x08, 0x08, "eq"))
780:     rows.append(("gtcasc isr2", "symptom", gc.get("isr"), 0x00, 0x04, "eq"))
781:     rows.append(("gtcasc isr8", "symptom", gc.get("isr2"), 0x00, 0x01, "eq"))
782:     rows.append(("gtcasc eoi isr", "contract", gc.get("isr_eoi"), 0x00, 0x00, "eq"))
783:     rows.append(("gtcasc eoi isr8", "contract", gc.get("isr2_eoi"), 0x00, 0x00, "eq"))
784:     gb = sess.get("gtboth", {})
785:     rows.append(("gtboth irr", "control", (None if gb.get("irr") is None else gb.get("irr") & 0x14), 0x14, 0x14, "eq"))
786:     rows.append(("gtboth iack", "symptom", gb.get("iack"), 0x04, 0x08, "eq"))
787:     rows.append(("gtboth isr2", "symptom", gb.get("isr"), 0x00, 0x04, "eq"))
788:     rows.append(("gtboth isr8", "symptom", gb.get("isr2"), 0x00, 0x01, "eq"))
789:     r = sess.get("rate", {})
790:     rows.append(("rate imr", "control", r.get("imr"), 0xfe, 0xfe, "eq"))
791:     rows.append(("rate delivered", "control", r.get("count"), (1, None), (1, None), "band"))
792:     rows.append(("rate poll byte", "control", r.get("lastpoll"), 0x80, 0x80, "eq"))
793:     rows.append(("rate storm", "symptom", r.get("count"), (5000, None), (1, 1000), "band"))
794:     for name, _ in SESSION_ORDER:
795:         if name == "rate":
796:             continue
797:         s = sess.get(name, {})
798:         first = s.get("irr")
799:         rows.append(("stable:%s" % name, "control", s.get("stable"), first, first, "eq"))
800:     return rows
801: 
802: 
803: def row_ok(mode, got, want):
804:     if got is None or want is None:
805:         return False
806:     if mode == "band":
807:         lo, hi = want
808:         return got >= lo and (hi is None or got <= hi)
809:     return got == want
810: 
811: 
812: def run_leg(leg, binary, column, out):
813:     out("-" * 86)
814:     out("LEG %s -- %s build, judged against the %s column" % (leg, leg, column))
815:     out("-" * 86)
816:     sess = {}
817:     enc_all = hit_all = True
818:     for name, builder in SESSION_ORDER:
819:         prog_list, halt_addr, regmap, extra = builder()
820:         got, enc_ok, hit = run_session(binary, prog_list, halt_addr,
821:                                        os.path.join(RAWDIR, "%s_%s.bin" % (leg, name)),
822:                                        regmap, "%s_%s" % (leg, name), out, extra)
823:         sess[name] = got
824:         out("      raw: " + "  ".join("%s=%s" % (k, show(v)) for k, v in got.items()))
825:         enc_all = enc_all and enc_ok
826:         hit_all = hit_all and hit
827:     out("")
828:     out("  %-16s %-8s %-10s %-10s" % ("row", "got", "head", "fix"))
829:     npass = nfail = 0
830:     ctrl_ok = True
831:     for label, kind, got, wh, wf, mode in build_rows(sess):
832:         want = wh if column == "HEAD" else wf
833:         ok = row_ok(mode, got, want)
834:         npass += ok
835:         nfail += (not ok)
836:         if kind == "control" and not ok:
837:             ctrl_ok = False
838:         if kind == "symptom":
839:             out("  %-16s %-8s head %-8s fix %-8s [%s] %s"
840:                 % (label, show(got), show(wh), show(wf), column, "ok" if ok else "FAIL"))
841:         else:
842:             out("  %-16s %-8s want %-10s %s" % (label, show(got), show(want), "ok" if ok else "FAIL"))
843:     ntot = npass + nfail
844:     leg_ctrl = ctrl_ok and enc_all and hit_all
845:     out("")
846:     out("  %d/%d passed" % (npass, ntot))
847:     out("  CONTROL=%s" % ("PASS" if leg_ctrl else "FAIL"))
848:     leg_pass = (nfail == 0 and leg_ctrl)
849:     out("  LEG %s VERDICT: %s" % (leg, "PASS" if leg_pass else "FAIL"))
850:     out("")
851:     return leg_pass, npass, ntot, leg_ctrl
852: 
853: 
854: def main():
855:     global RAWDIR
856:     assert row_ok("eq", 1, 0) is False and row_ok("eq", None, 0) is False
857:     assert row_ok("band", 7415, (5000, None)) and not row_ok("band", 7415, (1, 1000)) and row_ok("band", 9, (1, 1000))
858:     os.makedirs(OUTDIR, exist_ok=True)
859:     RAWDIR = os.path.join(OUTDIR, "raw")
860:     os.makedirs(RAWDIR, exist_ok=True)
861:     lines = []
862: 
863:     def out(s=""):
864:         lines.append(s)
865:         print(s)
866:         sys.stdout.flush()
867: 
868:     out("=" * 86)
869:     out("i8259eoiirr -- the 8259 acknowledge on unmodified `evbmips -e malta` (ISA 8259 pair, 8253, GT64120 IACK)")
870:     out("=" * 86)
871:     out("date      %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
872:     out("machine   evbmips -e malta   LITTLE endian   (machine desc UNMODIFIED)")
873:     out("isa       I/O physical 0x18000000 (KSEG1 0xffffffffb8000000): PIC1 +0x20/+0x21, PIC2 +0xa0/+0xa1, 8253 +0x40,"
874:         " pccmos +0x70, ns16550 +0x3f8 (IRQ 4) / +0x2f8 (IRQ 3); GT64120 at 0xbbe00000, IACK +0xc34")
875:     out("base bin  %s" % BASE_BIN)
876:     if GATE:
877:         out("mode      GATE -- one leg vs the FIX column")
878:     else:
879:         out("fix bin   %s" % ("(none -- WITNESS run)" if FIX_ARG == "-" else FIX_ARG))
880:     out("")
881:     if GATE:
882:         legs = [("gate", BASE_BIN, "FIX")]
883:     else:
884:         legs = [("base", BASE_BIN, "HEAD")]
885:         if FIX_ARG != "-":
886:             legs.append(("fix", FIX_ARG, "FIX"))
887:     results = []
888:     for leg, binary, column in legs:
889:         leg_pass, npass, ntot, leg_ctrl = run_leg(leg, binary, column, out)
890:         results.append(leg_pass)
891:         if GATE:
892:             out("I8259EOI_CONTROL=%s" % ("OK" if leg_ctrl else "FAIL"))
893:             out("I8259EOI_RESULT=%d/%d" % (npass, ntot))
894:         else:
895:             out("I8259EOI_CONTROL_%s=%s" % (leg, "OK" if leg_ctrl else "FAIL"))
896:             out("I8259EOI_RESULT_%s=%d/%d" % (leg, npass, ntot))
897:     out("=" * 86)
898:     allok = all(results)
899:     out("VERDICT   %s" % ("every leg passed its own column" if allok
900:                           else "*** a leg failed -- read the FAIL lines above ***"))
901:     out("I8259EOI_PROBE_DONE")
902:     with open(os.path.join(OUTDIR, "RESULTS.txt"), "w") as f:
903:         f.write("\n".join(lines) + "\n")
904:     sys.exit(0 if allok else 1)
905: 
906: 
907: if __name__ == "__main__":
908:     main()

