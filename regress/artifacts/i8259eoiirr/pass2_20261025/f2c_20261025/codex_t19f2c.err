364: def build_ack():
365:     """The acknowledge rows on IRQ 4: poll byte, ISR after the poll, IRR after the poll (two instructions), a second
366:     command-port read (one-shot), the re-assert while in service, the EOI after the acknowledge, ISR after it."""
367:     begin()
368:     e_uart_level_on()
369:     e_delay()
370:     e_ocw3_read(v1, OCW3_IRR)
371:     e_in(a2, PIC1_CMD)
372:     e_ocw3_read(a0, OCW3_POLL)
373:     e_ocw3_read(a1, OCW3_ISR)
374:     e_ocw3_read(a3, OCW3_IRR)
375:     e_ocw3_read(s0, OCW3_POLL)
376:     e_in(s1, PIC1_CMD)
377:     e_delay()
378:     e_ocw3_read(s2, OCW3_IRR)
379:     e_li(t5, OCW3_IRR)
380:     e_li(t6, 0x64)
381:     emit(sb(t6, PIC1_CMD, t0), "sb t6,%d(t0)" % PIC1_CMD)
382:     emit(sb(t5, PIC1_CMD, t0), "sb t5,%d(t0)" % PIC1_CMD)
383:     e_in(s3, PIC1_CMD)
384:     e_ocw3_read(s4, OCW3_ISR)
385:     p, halt = end()
386:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "isr": "a1", "irr_after": "a3",
387:                      "poll2": "s0", "once": "s1", "reassert": "s2", "eoi_acked": "s3", "isr2": "s4"}, None
388: 
389: 
390: def build_ack3():
391:     """The same acknowledge on the second UART (IRQ 3): the n != 4 anchor."""
392:     begin()
393:     e_uart_level_on(UART3_IER, UART3_MCR)
394:     e_delay()
395:     e_ocw3_read(v1, OCW3_IRR)
396:     e_in(a2, PIC1_CMD)
397:     e_ocw3_read(a0, OCW3_POLL)
398:     e_ocw3_read(a1, OCW3_ISR)
399:     e_delay()
400:     e_ocw3_read(a3, OCW3_IRR)
401:     e_li(t5, OCW3_IRR)
402:     e_li(t6, 0x63)
403:     emit(sb(t6, PIC1_CMD, t0), "sb t6,%d(t0)" % PIC1_CMD)
404:     emit(sb(t5, PIC1_CMD, t0), "sb t5,%d(t0)" % PIC1_CMD)
405:     e_in(s0, PIC1_CMD)
406:     p, halt = end()
407:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "isr": "a1", "reassert": "a3", "eoi_acked": "s0"}, None
408: 
409: 
410: def build_masked():
411:     """Line 4 masked: the poll byte (mask-blind on HEAD), then -- with the request still pending under the mask -- a
412:     SECOND read of the command port without another OCW3: the one-shot poll returns the IRR (0x10) where a sticky poll
413:     returns the empty poll byte (0x00) and HEAD returns its mask-blind 0x84; IRR under the mask; the un-acknowledged EOI
414:     under the mask."""
415:     begin()
416:     e_uart_level_on()
417:     e_delay()
418:     e_ocw3_read(v1, OCW3_IRR)
419:     e_in(a2, PIC1_CMD)
420:     e_out(PIC1_IMR, 0x10)
421:     e_in(a0, PIC1_IMR)
422:     e_ocw3_read(a1, OCW3_POLL)
423:     e_in(s1, PIC1_CMD)
424:     e_ocw3_read(a3, OCW3_IRR)
425:     e_li(t5, OCW3_IRR)
426:     e_li(t6, 0x64)
427:     emit(sb(t6, PIC1_CMD, t0), "sb t6,%d(t0)" % PIC1_CMD)
428:     emit(sb(t5, PIC1_CMD, t0), "sb t5,%d(t0)" % PIC1_CMD)
429:     e_in(s0, PIC1_CMD)
430:     e_out(PIC1_IMR, 0x00)
431:     p, halt = end()
432:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "imr": "a0", "poll": "a1", "once": "s1", "masked": "a3", "masked_eoi": "s0"}, None
433: 
434: 
435: def build_nonspec():
436:     """Both UARTs pending: poll (acknowledges 3; line 4 still pending), then -- v2e -- CP0 Cause read right after it
437:     (IP2 must still be asserted: the acknowledge's recompute sees line 4) and a command-port read WITHOUT another OCW3
438:     (the one-shot latch after a SUCCESSFUL poll: FIX returns the IRR 0x10, a sticky latch 0x84, HEAD its unconsumed poll
439:     byte 0x83); then poll again (4), ISR 0x18, the non-specific EOI resets the lowest ISR bit, twice."""
440:     begin()
441:     e_uart_level_on(UART3_IER, UART3_MCR)
442:     e_uart_level_on()
443:     e_delay()
444:     e_ocw3_read(v1, OCW3_IRR)
445:     e_in(a2, PIC1_CMD)
446:     e_ocw3_read(a0, OCW3_POLL)
447:     emit(mfc0(s3, COP0_CAUSE), "mfc0 s3,cause")
448:     e_in(s2, PIC1_CMD)
449:     e_ocw3_read(a1, OCW3_POLL)
450:     e_ocw3_read(a3, OCW3_ISR)
451:     e_out(PIC1_CMD, EOI_NONSPEC)
452:     e_ocw3_read(s0, OCW3_ISR)
453:     e_out(PIC1_CMD, EOI_NONSPEC)
454:     e_ocw3_read(s1, OCW3_ISR)
455:     p, halt = end()
456:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll_a": "a0", "cause": "s3", "once2": "s2", "poll_b": "a1",
457:                      "isr_both": "a3", "isr_one": "s0", "isr_none": "s1"}, None
458: 
459: 
460: def build_speceoi():
461:     """v2e (F2b): both UARTs acknowledged (ISR 0x18), then a SPECIFIC EOI of line 3 -- the ISR must lose exactly that bit
462:     (FIX 0x10; a specific EOI clearing the whole ISR reads 0x00, as HEAD does, which never sets ISR); the specific EOI
463:     of line 4 then clears the rest (0x00 both)."""
464:     begin()
465:     e_uart_level_on(UART3_IER, UART3_MCR)
466:     e_uart_level_on()
467:     e_delay()
468:     e_ocw3_read(v1, OCW3_IRR)
469:     e_in(a2, PIC1_CMD)
470:     e_ocw3_read(a0, OCW3_POLL)
471:     e_ocw3_read(a1, OCW3_POLL)
472:     e_ocw3_read(a3, OCW3_ISR)
473:     e_eoi(3)
474:     e_ocw3_read(s0, OCW3_ISR)
475:     e_eoi(4)
476:     e_ocw3_read(s1, OCW3_ISR)
477:     p, halt = end()
478:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll_a": "a0", "poll_b": "a1", "isr_both": "a3",
479:                      "isr_one": "s0", "isr_none": "s1"}, None
480: 
481: 
482: def build_maskeoi():
483:     """v2e (F2b): line 4 acknowledged (in service), THEN masked by OCW1 0x10, then the specific EOI 0x64 -- Linux's
484:     mask-then-EOI order.  The EOI must take the ISR branch (ISR reads 0x00 in both columns: FIX clears the bit, HEAD
485:     never set it); an EOI that takes the legacy branch for a masked line leaves ISR 0x10."""
486:     begin()
487:     e_uart_level_on()
488:     e_delay()
489:     e_ocw3_read(v1, OCW3_IRR)
490:     e_in(a2, PIC1_CMD)
491:     e_ocw3_read(a0, OCW3_POLL)
492:     e_out(PIC1_IMR, 0x10)
493:     e_in(a1, PIC1_IMR)
494:     e_eoi(4)
495:     e_ocw3_read(a3, OCW3_ISR)
496:     e_out(PIC1_IMR, 0x00)
497:     p, halt = end()
498:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "imr": "a1", "isr": "a3"}, None
499: 
500: 
501: def build_casc():
502:     """The mc146818 periodic interrupt (IRQ 8, pic2) at 1024 Hz after a long wait: the cascade acknowledge."""
503:     begin()
504:     e_out(CMOS_IDX, 0x0a)
505:     e_out(CMOS_DAT, 0x26)
506:     e_out(CMOS_IDX, 0x0b)
507:     e_out(CMOS_DAT, 0x40)
508:     e_long(); e_long(); e_long()
509:     e_ocw3_read(v1, OCW3_IRR)
510:     e_in(a2, PIC1_CMD)
511:     e_ocw3_read(a0, OCW3_POLL)
512:     e_ocw3_read(a1, OCW3_ISR)
513:     e_ocw3_read(a3, OCW3_POLL, PIC2_CMD)
514:     e_ocw3_read(s0, OCW3_ISR, PIC2_CMD)
515:     e_eoi(0, PIC2_CMD)
516:     e_eoi(2)
517:     e_ocw3_read(s1, OCW3_ISR)
518:     e_ocw3_read(s2, OCW3_ISR, PIC2_CMD)
519:     p, halt = end()
520:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "isr": "a1", "poll2": "a3",
521:                      "isr2": "s0", "isr_eoi": "s1", "isr2_eoi": "s2"}, None
522: 
523: 
524: def build_pit():
525:     """8253 counter 0 at 291 Hz after a long wait: IRR bit 0, the poll byte, IRR bit 0 after the poll."""
526:     begin()
527:     e_pit_291hz()
528:     e_long(); e_long(); e_long()
529:     e_ocw3_read(v1, OCW3_IRR)
530:     e_in(a2, PIC1_CMD)
531:     e_ocw3_read(a0, OCW3_POLL)
532:     e_ocw3_read(a1, OCW3_IRR)
533:     p, halt = end()
534:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "poll": "a0", "irr_after": "a1"}, None
535: 
536: 
537: def build_gt():
538:     """The GT64120 interrupt-acknowledge register with the UART level on: v2e first WRITES it (a write acknowledges
539:     nothing -- ISR stays 0x00 in both columns; HEAD's write arm is a no-op and the fix's guard is `writeflag ==
540:     MEM_READ`), then the READ: the value, ISR and IRR after it."""
541:     begin()
542:     e_uart_level_on()
543:     e_delay()
544:     e_ocw3_read(v1, OCW3_IRR)
545:     e_in(a2, PIC1_CMD)
546:     emit(lui(t1, GT_HI), "lui t1,0x%x" % GT_HI)
547:     emit(sw(zero, GT_IACK, t1), "sw zr,%d(t1)" % GT_IACK)
548:     e_ocw3_read(s0, OCW3_ISR)
549:     emit(lw(a0, GT_IACK, t1), "lw a0,%d(t1)" % GT_IACK)
550:     e_ocw3_read(a1, OCW3_ISR)
551:     e_ocw3_read(a3, OCW3_IRR)
552:     p, halt = end()
553:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "isr_write": "s0", "iack": "a0", "isr": "a1", "irr_after": "a3"}, None
554: 
555: 
556: def build_gtboth():
557:     """The GT IACK read with BOTH a master line (the UART, IRQ 4) and a slave line (the RTC, IRQ 8) pending: the acknowledge
558:     takes the cascade (line 2 outranks line 4) and then the slave, returning 8; HEAD's last_int -- bus_isa's flat scan,
559:     which skips line 2 -- reads 4.  Pins the returned line, which the single-source rows cannot."""
560:     begin()
561:     e_out(CMOS_IDX, 0x0a)
562:     e_out(CMOS_DAT, 0x26)
563:     e_out(CMOS_IDX, 0x0b)
564:     e_out(CMOS_DAT, 0x40)
565:     e_uart_level_on()
566:     e_long(); e_long(); e_long()
567:     e_ocw3_read(v1, OCW3_IRR)
568:     e_in(a2, PIC1_CMD)
569:     emit(lui(t1, GT_HI), "lui t1,0x%x" % GT_HI)
570:     emit(lw(a0, GT_IACK, t1), "lw a0,%d(t1)" % GT_IACK)
571:     e_ocw3_read(a1, OCW3_ISR)
572:     e_ocw3_read(a3, OCW3_ISR, PIC2_CMD)
573:     p, halt = end()
574:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "iack": "a0", "isr": "a1", "isr2": "a3"}, None
575: 
576: 
577: def build_gtcasc():
578:     """The GT64120 IACK read with the mc146818 periodic interrupt pending on pic2: returns 8 in both columns (HEAD:
579:     last_int); FIX acknowledges the master's cascade line and the slave's line 0 (ISR 0x04 / 0x01)."""
580:     begin()
581:     e_out(CMOS_IDX, 0x0a)
582:     e_out(CMOS_DAT, 0x26)
583:     e_out(CMOS_IDX, 0x0b)
584:     e_out(CMOS_DAT, 0x40)
585:     e_long(); e_long(); e_long()
586:     e_ocw3_read(v1, OCW3_IRR)
587:     e_in(a2, PIC1_CMD)
588:     emit(lui(t1, GT_HI), "lui t1,0x%x" % GT_HI)
589:     emit(lw(a0, GT_IACK, t1), "lw a0,%d(t1)" % GT_IACK)
590:     e_ocw3_read(a1, OCW3_ISR)
591:     e_ocw3_read(a3, OCW3_ISR, PIC2_CMD)
592:     e_eoi(0, PIC2_CMD)
593:     e_eoi(2)
594:     e_ocw3_read(s0, OCW3_ISR)
595:     e_ocw3_read(s1, OCW3_ISR, PIC2_CMD)
596:     p, halt = end()
597:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "iack": "a0", "isr": "a1", "isr2": "a3",
598:                      "isr_eoi": "s0", "isr2_eoi": "s1"}, None
599: 
600: 
601: def build_rate_handler():
602:     """At the general exception vector: poll (OCW3 0x0c + read) into k1, remember it in s3, specific EOI 0x60|(k1&7),
603:     count in s2, eret."""
604:     reset_prog()
605:     emit(lui(k0, ISA_HI), "lui k0,0x%x" % ISA_HI)
606:     emit(ori(k1, zero, OCW3_POLL), "ori k1,zr,0xc")
607:     emit(sb(k1, PIC1_CMD, k0), "sb k1,%d(k0)" % PIC1_CMD)
608:     emit(lbu(k1, PIC1_CMD, k0), "lbu k1,%d(k0)" % PIC1_CMD)
609:     emit(or_(s3, k1, zero), "or s3,k1,zr")
610:     emit(andi(k1, k1, 0x7), "andi k1,k1,0x7")
611:     emit(ori(k1, k1, 0x60), "ori k1,k1,0x60")
612:     emit(sb(k1, PIC1_CMD, k0), "sb k1,%d(k0)" % PIC1_CMD)
613:     emit(addiu(s2, s2, 1), "addiu s2,s2,0x1")
614:     emit(ERET, "eret")
615:     return list(prog)
616: 
617: 
618: def build_rate():
619:     """Count IRQ 0 deliveries: mask all but line 0, counter 0 = 0xffff (18 Hz), Status IE|IM2 with BEV clear, spin
620:     RATE_SPIN iterations, disable, read IRR/IMR back.  The handler is loaded at HANDLER."""
621:     handler = build_rate_handler()
622:     begin()
623:     e_out(PIC1_IMR, 0xfe)
624:     e_out(PIC2_IMR, 0xff)
625:     e_out(PIT_CTL, 0x34)
626:     e_out(PIT_C0, 0xff)
627:     e_out(PIT_C0, 0xff)
628:     emit(ori(s2, zero, 0), "ori s2,zr,0x0")
629:     emit(ori(s3, zero, 0), "ori s3,zr,0x0")
630:     emit(ori(k1, zero, STATUS_IE_IM2), "ori k1,zr,0x401")
631:     emit(mtc0(k1, COP0_STATUS), "mtc0 k1,status")
632:     e_long(RATE_SPIN)
633:     emit(mtc0(zero, COP0_STATUS), "mtc0 zr,status")
634:     e_ocw3_read(a0, OCW3_IRR)
635:     e_in(a1, PIC1_IMR)
636:     p, halt = end()
637:     return p, halt, {"ram": "v0", "count": "s2", "lastpoll": "s3", "irr_after": "a0", "imr": "a1"}, (HANDLER, handler)
638: 
639: 
640: SESSION_ORDER = [("quiet", build_quiet), ("level", build_level), ("ack", build_ack), ("ack3", build_ack3),
641:                  ("masked", build_masked), ("maskeoi", build_maskeoi), ("nonspec", build_nonspec), ("speceoi", build_speceoi),
642:                  ("casc", build_casc), ("pit", build_pit),
643:                  ("gt", build_gt), ("gtcasc", build_gtcasc), ("gtboth", build_gtboth), ("rate", build_rate)]
644: 
645: 
646: class Emu(object):
647:     def __init__(self, argv, boot_wait=5.0):
648:         self.buf = bytearray()
649:         self.pid, self.fd = pty.fork()
650:         if self.pid == 0:
651:             try:
652:                 os.execvp(argv[0], argv)
653:             finally:
654:                 os._exit(127)
655:         self.drain(boot_wait)
656: 
657:     def drain(self, seconds):
658:         end_t = time.time() + seconds
659:         while time.time() < end_t:
660:             r, _, _ = select.select([self.fd], [], [], 0.05)
661:             if self.fd in r:
662:                 try:
663:                     d = os.read(self.fd, 65536)
664:                 except OSError:
665:                     return
666:                 if not d:
667:                     return
668:                 self.buf.extend(d)
669: 
670:     def send(self, cmd, wait=0.4):
671:         start = len(self.buf)
672:         data = (cmd + "\n").encode()
673:         view = memoryview(data)
674:         while len(view):
675:             try:
676:                 n = os.write(self.fd, view)
677:             except OSError:
678:                 break
679:             view = view[n:]
680:             if len(view):
681:                 self.drain(0.05)
682:         self.drain(wait)
683:         return bytes(self.buf[start:]).decode("latin1", "replace")
684: 
685:     def close(self, log):
686:         try:
687:             os.write(self.fd, b"quit\n")
688:             self.drain(0.4)
689:         except OSError:
690:             pass
691:         for fn in (lambda: os.close(self.fd),
692:                    lambda: os.kill(self.pid, 9),
693:                    lambda: os.waitpid(self.pid, 0)):
694:             try:
695:                 fn()
696:             except OSError:
697:                 pass
698:         with open(log, "w") as f:
699:             f.write(bytes(self.buf).decode("latin1", "replace"))
700: 
701: 
702: def reg(emu, name):
703:     for _ in range(5):
704:         out = emu.send("print %s" % name, wait=0.35)
705:         m = re.findall(r"0x[0-9a-fA-F]+", out)
706:         if m:
707:             return int(m[-1], 16)
708:         emu.drain(0.25)
709:     return None
710: 
711: 
712: def write_bin(path, prog_list):
713:     with open(path, "wb") as f:
714:         for w, _ in prog_list:
715:             f.write(bytes([w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff]))
716: 
717: 
718: def check_words(emu, base, prog_list, label, out):
719:     dis = emu.send("unassemble 0x%x 0x%x" % (base, base + len(prog_list) * 4), wait=max(3.0, len(prog_list) * 0.03))
720:     seen = {}
721:     for line in dis.splitlines():
722:         m = re.match(r"^\s*([0-9a-f]{8,16}):\s+([0-9a-f]{8})\s+(?:<-)?\s*(.*)$", line)
723:         if m:
724:             seen[int(m.group(1), 16) & 0xffffffff] = (m.group(2), m.group(3).strip())
725:     w_ok = m_ok = 0
726:     bad = []
727:     for i, (w, want_mn) in enumerate(prog_list):
728:         addr = (base + i * 4) & 0xffffffff
729:         hit = seen.get(addr)
730:         if hit is None:
731:             bad.append("      BAD 0x%08x no disassembly line" % addr)
732:             continue
733:         if hit[0] == "%08x" % w:
734:             w_ok += 1
735:         else:
736:             bad.append("      BAD 0x%08x word %s vs %08x" % (addr, hit[0], w))
737:         if " ".join(hit[1].replace("\t", " ").split()).startswith(" ".join(want_mn.split())):
738:             m_ok += 1
739:     out("    encodings (%s): %d/%d words agree with the disassembler (CONTROL); %d/%d mnemonic renderings match "
740:         "(informational)" % (label, w_ok, len(prog_list), m_ok, len(prog_list)))
741:     for l in bad[:8]:
742:         out(l)
743:     return w_ok == len(prog_list)
744: 
745: 
746: def run_session(binary, prog_list, halt_addr, rawbin, regmap, tag, out, extra=None):
747:     """Run one guest program (plus an optional second binary at another address) to its halt breakpoint and read back
748:     the capture regs."""
749:     write_bin(rawbin, prog_list)
750:     files = []
751:     if extra is not None:
752:         eaddr, eprog = extra
753:         ebin = rawbin[:-4] + "_handler.bin"
754:         write_bin(ebin, eprog)
755:         files.append("0x%x:%s" % (eaddr, ebin))
756:     files.append("0x%x:%s" % (BASE, rawbin))
757:     argv = [binary, "-V"] + MACHINE + files
758:     out("    [%s] %s" % (tag, " ".join(argv)))
759:     emu = Emu(argv)
760:     try:
761:         dead = os.waitpid(emu.pid, os.WNOHANG) != (0, 0)
762:     except OSError:
763:         dead = True
764:     if dead:
765:         #  The medium is not an emulator (a null-medium leg, or a binary that will not start): every control row
766:         #  reads ?? and CONTROL fails, without waiting out the park deadline.
767:         out("    [%s] the emulator process exited before the debugger prompt -- no words checked, no park" % tag)
768:         emu.close(os.path.join(RAWDIR, "%s.txt" % tag))
769:         return dict((k, None) for k in regmap), False, False
770:     enc_ok = check_words(emu, BASE, prog_list, "main", out)
771:     if extra is not None:
772:         enc_ok = check_words(emu, extra[0], extra[1], "handler", out) and enc_ok
773:     emu.send("breakpoint add 0x%x" % halt_addr, wait=0.5)
774:     t = time.time()
775:     emu.send("continue", wait=1.0)
776:     deadline = time.time() + 180
777:     hit = False
778:     seen_pc = None
779:     while time.time() < deadline:
780:         emu.drain(0.5)
781:         tail = bytes(emu.buf[-4000:]).decode("latin1", "replace")
782:         m = re.search(r"BREAKPOINT:\s*pc\s*=\s*0x([0-9a-fA-F]+)", tail)
783:         if m:
784:             seen_pc = int(m.group(1), 16) & 0xffffffff
785:             hit = (seen_pc == (halt_addr & 0xffffffff))
786:             break
787:     out("    parked at 0x%016x: %s   (%.2f s)"
788:         % (halt_addr, "yes (pc verified)" if hit else
789:            ("*** NO: stopped at 0x%08x ***" % seen_pc if seen_pc is not None else "*** NO ***"),
790:            time.time() - t))
791:     got = {}
792:     for logical, mips in regmap.items():
793:         v = reg(emu, mips)
794:         got[logical] = None if v is None else (v & 0xffffffff)
795:     emu.close(os.path.join(RAWDIR, "%s.txt" % tag))
796:     return got, enc_ok, hit
