920: 
921: def run_leg(leg, binary, column, out):
922:     out("-" * 86)
923:     out("LEG %s -- %s build, judged against the %s column" % (leg, leg, column))
924:     out("-" * 86)
925:     sess = {}
926:     enc_all = hit_all = True
927:     for name, builder in SESSION_ORDER:
928:         prog_list, halt_addr, regmap, extra = builder()
929:         got, enc_ok, hit = run_session(binary, prog_list, halt_addr,
930:                                        os.path.join(RAWDIR, "%s_%s.bin" % (leg, name)),
931:                                        regmap, "%s_%s" % (leg, name), out, extra)
932:         sess[name] = got
933:         out("      raw: " + "  ".join("%s=%s" % (k, show(v)) for k, v in got.items()))
934:         enc_all = enc_all and enc_ok
935:         hit_all = hit_all and hit
936:     out("")
937:     out("  %-16s %-8s %-10s %-10s" % ("row", "got", "head", "fix"))
938:     npass = nfail = 0
939:     ctrl_ok = True
940:     for label, kind, got, wh, wf, mode in build_rows(sess):
941:         want = wh if column == "HEAD" else wf
942:         ok = row_ok(mode, got, want)
943:         npass += ok
944:         nfail += (not ok)
945:         if kind == "control" and not ok:
946:             ctrl_ok = False
947:         if kind == "symptom":
948:             out("  %-16s %-8s head %-8s fix %-8s [%s] %s"
949:                 % (label, show(got), show(wh), show(wf), column, "ok" if ok else "FAIL"))
950:         else:
951:             out("  %-16s %-8s want %-10s %s" % (label, show(got), show(want), "ok" if ok else "FAIL"))
952:     ntot = npass + nfail
953:     leg_ctrl = ctrl_ok and enc_all and hit_all
954:     out("")
955:     out("  %d/%d passed" % (npass, ntot))
956:     out("  CONTROL=%s" % ("PASS" if leg_ctrl else "FAIL"))
957:     leg_pass = (nfail == 0 and leg_ctrl)
958:     out("  LEG %s VERDICT: %s" % (leg, "PASS" if leg_pass else "FAIL"))
959:     out("")
960:     return leg_pass, npass, ntot, leg_ctrl
961: 
962: 
963: def main():
964:     global RAWDIR
965:     assert row_ok("eq", 1, 0) is False and row_ok("eq", None, 0) is False
966:     assert row_ok("band", 7415, (5000, None)) and not row_ok("band", 7415, (1, 1000)) and row_ok("band", 9, (1, 1000))
967:     os.makedirs(OUTDIR, exist_ok=True)
968:     RAWDIR = os.path.join(OUTDIR, "raw")
969:     os.makedirs(RAWDIR, exist_ok=True)
970:     lines = []
971: 
972:     def out(s=""):
973:         lines.append(s)
974:         print(s)
975:         sys.stdout.flush()
976: 
977:     out("=" * 86)
978:     out("i8259eoiirr -- the 8259 acknowledge on unmodified `evbmips -e malta` (ISA 8259 pair, 8253, GT64120 IACK)")
979:     out("=" * 86)
980:     out("date      %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
981:     out("machine   evbmips -e malta   LITTLE endian   (machine desc UNMODIFIED)")
982:     out("isa       I/O physical 0x18000000 (KSEG1 0xffffffffb8000000): PIC1 +0x20/+0x21, PIC2 +0xa0/+0xa1, 8253 +0x40,"
983:         " pccmos +0x70, ns16550 +0x3f8 (IRQ 4) / +0x2f8 (IRQ 3); GT64120 at 0xbbe00000, IACK +0xc34")
984:     out("base bin  %s" % BASE_BIN)
985:     if GATE:
986:         out("mode      GATE -- one leg vs the FIX column")
987:     else:
988:         out("fix bin   %s" % ("(none -- WITNESS run)" if FIX_ARG == "-" else FIX_ARG))
989:     out("")
990:     if GATE:
991:         legs = [("gate", BASE_BIN, "FIX")]
992:     else:
993:         legs = [("base", BASE_BIN, "HEAD")]
994:         if FIX_ARG != "-":
995:             legs.append(("fix", FIX_ARG, "FIX"))
996:     results = []
997:     for leg, binary, column in legs:
998:         leg_pass, npass, ntot, leg_ctrl = run_leg(leg, binary, column, out)
999:         results.append(leg_pass)
1000:         if GATE:
1001:             out("I8259EOI_CONTROL=%s" % ("OK" if leg_ctrl else "FAIL"))
1002:             out("I8259EOI_RESULT=%d/%d" % (npass, ntot))
1003:         else:
1004:             out("I8259EOI_CONTROL_%s=%s" % (leg, "OK" if leg_ctrl else "FAIL"))
1005:             out("I8259EOI_RESULT_%s=%d/%d" % (leg, npass, ntot))
1006:     out("=" * 86)
1007:     allok = all(results)
1008:     out("VERDICT   %s" % ("every leg passed its own column" if allok
1009:                           else "*** a leg failed -- read the FAIL lines above ***"))
1010:     out("I8259EOI_PROBE_DONE")
1011:     with open(os.path.join(OUTDIR, "RESULTS.txt"), "w") as f:
1012:         f.write("\n".join(lines) + "\n")
1013:     sys.exit(0 if allok else 1)
1014: 
1015: 
1016: if __name__ == "__main__":
1017:     main()

