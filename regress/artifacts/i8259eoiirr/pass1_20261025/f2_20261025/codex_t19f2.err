 203: 
 204: def build_level():
 205:     """The UART level on IRQ 4, then the specific EOI: IRR with the level -> v1 (again -> a2), ISR -> a0, then the
 206:     specific EOI 0x64 and IRR read two instructions later -> a1; the EOI+read repeated eight more times, bit 4 of
 207:     each read shifted into a3 (0x00 = cleared every time, 0xff = kept every time); ISR after the EOI -> s0."""
 208:     begin()
 209:     e_uart_level_on()
 210:     e_delay()
 211:     e_ocw3_read(v1, OCW3_IRR)
 212:     e_in(a2, PIC1_CMD)
 213:     e_ocw3_read(a0, OCW3_ISR)
 214:     e_li(t5, OCW3_IRR)
 215:     e_li(t6, EOI_SPEC4)
 216:     emit(sb(t6, PIC1_CMD, t0), "sb t6,%d(t0)" % PIC1_CMD)
 217:     emit(sb(t5, PIC1_CMD, t0), "sb t5,%d(t0)" % PIC1_CMD)
 218:     e_in(a1, PIC1_CMD)
 219:     emit(ori(a3, zero, 0), "ori a3,zr,0x0")
 220:     for _ in range(8):
 221:         emit(sb(t6, PIC1_CMD, t0), "sb t6,%d(t0)" % PIC1_CMD)
 222:         emit(sb(t5, PIC1_CMD, t0), "sb t5,%d(t0)" % PIC1_CMD)
 223:         e_in(t7, PIC1_CMD)
 224:         emit(andi(t7, t7, 0x10), "andi t7,t7,0x10")
 225:         emit(srl(t7, t7, 4), "srl t7,t7,0x4")
 226:         emit(sll(a3, a3, 1), "sll a3,a3,0x1")
 227:         emit(or_(a3, a3, t7), "or a3,a3,t7")
 228:     e_ocw3_read(s0, OCW3_ISR)
 229:     p, halt = end()
 230:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "isr": "a0", "after": "a1", "x8": "a3", "isr2": "s0"}
 231: 
 232: 
 233: def build_other():
 234:     """The other arms with the level on: IRR -> v1 (again -> a2); the NON-specific EOI 0x20 then IRR -> a0 (inert
 235:     today: ISR is empty); OCW1 masking line 4 then IRR -> a1 (the mask must not touch IRR); the poll byte -> a3;
 236:     the mask register read back -> s0."""
 237:     begin()
 238:     e_uart_level_on()
 239:     e_delay()
 240:     e_ocw3_read(v1, OCW3_IRR)
 241:     e_in(a2, PIC1_CMD)
 242:     e_out(PIC1_CMD, EOI_NONSPEC)
 243:     e_ocw3_read(a0, OCW3_IRR)
 244:     e_out(PIC1_IMR, 0x10)
 245:     e_ocw3_read(a1, OCW3_IRR)
 246:     e_ocw3_read(a3, OCW3_POLL)
 247:     e_in(s0, PIC1_IMR)
 248:     p, halt = end()
 249:     return p, halt, {"ram": "v0", "irr": "v1", "stable": "a2", "nonspec": "a0", "masked": "a1", "poll": "a3", "imr": "s0"}
 250: 
