 616: 		 *  receive buffer: (Otherwise deassert the interrupt.)
 617: 		 */
 618: 		if (d->head[port_nr] != d->tail[port_nr] && ints_enabled && d->rx_int_enable[port_nr]) {
 619: 			if (!d->currently_asserted[port_nr]) {
 620: 				// fatal("[ pckbc: interrupt port %i ]\n", port_nr);
